public def filterStep (t : π × α → Bool) (p : π) (acc : List α) (a : α) : List α :=
  if t (p, a) then acc ++ [a] else acc

lemma foldl_filterStep (t : π × α → Bool) (p : π) (l acc : List α) :
    l.foldl (filterStep t p) acc = acc ++ l.filter fun a => t (p, a) := by
