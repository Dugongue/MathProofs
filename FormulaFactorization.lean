      embed (tapeEmb i) (tm.runFrom (oneTapeCfg i cfg) n) cfg.workTapes cfg.workTapePos := by
  rw [← embedHom_apply tm, ← runFrom_map, embedHom_apply, embed_oneTapeCfg]

