abbrev Formula (ι : Type) := ArithFormula ι ℚ

/-  Self-delimited binary natural: unary bit-length, a separator, then the bits. -/
def natCode (n : ℕ) : List Bool :=
  List.replicate n.bits.length true ++ false :: n.bits

@[simp] theorem natCode_length (n : ℕ) :
    (natCode n).length = 2 * n.size + 1 := by
  simp [natCode, Nat.size_eq_bits_len]
  omega

/-  Sign bit followed by the numerator magnitude and positive denominator. -/
def ratCode (q : ℚ) : List Bool :=
  decide (q.num < 0) :: (natCode q.num.natAbs ++ natCode q.den)

def ratWeight (q : ℚ) : ℕ := (ratCode q).length

@[simp] theorem ratWeight_eq (q : ℚ) :
    ratWeight q = 3 + 2 * q.num.natAbs.size + 2 * q.den.size := by
  simp [ratWeight, ratCode]
  omega

theorem ratWeight_pos (q : ℚ) : 0 < ratWeight q := by
  rw [ratWeight_eq]
  omega

