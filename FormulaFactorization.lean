  unfold erase coeff
  rw [N0654.coeff_eq_coeff, Raw.coeff, Raw.coeff,
    Array.getD_eq_getD_getElem?, Array.getD_eq_getD_getElem?,
    Array.getElem?_setIfInBounds]
  by_cases hni : i = n
  · rw [if_pos hni.symm, if_pos hni]
    split <;> rfl
  · rw [if_neg hni, if_neg (fun h => hni h.symm)]

