theorem leadingDirection_correct {ι R : Type} [CommRing R] [Algebra ℚ R]
    (env : ι → R) (d : ℕ) (f : N0090.Formula (Option ι)) (hd : d ≤ f.formalDegree) :
    N0090.eval₂ (algebraMap ℚ R) env (leadingDirection d f) =
