theorem diagonal_powerProduct {κ : Type} [DecidableEq κ] (a : κ → ℚ) (s : κ →₀ ℕ) :
    (s.prod fun i e => (C (a i) * X : ℚ[X]) ^ e) =
      C (s.prod fun i e => a i ^ e) * X ^ (s.sum fun _ e => e) := by
  classical
  simp only [Finsupp.prod, Finsupp.sum, mul_pow, Finset.prod_mul_distrib,
    ← Polynomial.C_pow, ← map_prod, Finset.prod_pow_eq_pow_sum]

/-  Exact coefficient of radial scaling, with no assumptions about cancellation or syntactic degree. -/
theorem diagonal_coefficient {κ : Type} [DecidableEq κ] (G : MvPolynomial κ ℚ)
    (a : κ → ℚ) (d : ℕ) :
    (MvPolynomial.eval₂ Polynomial.C (fun i => C (a i) * X) G).coeff d =
      MvPolynomial.eval a (MvPolynomial.homogeneousComponent d G) := by
  classical
  induction G using MvPolynomial.induction_on' with
  | add G H ihG ihH =>
      rw [MvPolynomial.eval₂_add, Polynomial.coeff_add, map_add, map_add, ihG, ihH]
  | monomial s q =>
      rw [MvPolynomial.eval₂_monomial, diagonal_powerProduct]
      rw [MvPolynomial.homogeneousComponent_of_mem (MvPolynomial.isHomogeneous_monomial q rfl)]
      simp only [Polynomial.coeff_C_mul, Polynomial.coeff_X_pow, mul_ite, mul_one, mul_zero]
      by_cases hsd : s.sum (fun _ e => e) = d
      · have hsdeg : s.degree = d := by simpa only [Finsupp.degree_apply, Finsupp.sum] using hsd
        simp only [hsdeg, if_true, MvPolynomial.eval_monomial, hsd, eq_self]
      · have hsdeg : s.degree ≠ d := by simpa only [Finsupp.degree_apply, Finsupp.sum] using hsd
        simp only [hsdeg, Ne.symm hsdeg, hsd, Ne.symm hsd, if_false, map_zero, mul_zero]

theorem leadingDirection_homogeneousComponent {ι : Type} [DecidableEq ι]
    (a : ι → ℚ) (d : ℕ) (f : N0090.Formula (Option ι)) (hd : d ≤ f.formalDegree) :
    N0090.eval₂ (RingHom.id ℚ) a (leadingDirection d f) =
      MvPolynomial.eval (fun v => v.elim 1 a) (MvPolynomial.homogeneousComponent d (polynomial f)) := by
