    N0365.polynomial (transpose P) = Polynomial.Bivariate.swap (N0365.polynomial P) := by
  ext y t
  rw [N0365.polynomial_coeff, ← CPolynomial.coeff_toPoly,
    transpose_coeff, N0319.coeff_swap, N0365.polynomial_coeff,
    ← CPolynomial.coeff_toPoly]

