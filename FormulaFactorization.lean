  · intro hdiv
    obtain ⟨j, hj, hpow⟩ := ((hprime i).dvd_finsetProd_iff (fun j => (g j)^e j)).mp hdiv
    have hdvd := (hprime i).dvd_of_dvd_pow hpow
    by_cases hij : i = j
    · simpa only [hij] using hj
    · exact False.elim (hsep i j hij hdvd)
  · intro hi
    exact (dvd_pow_self (g i) (Nat.ne_of_gt (he i))).trans
      (Finset.dvd_prod_of_mem (fun j => (g j)^e j) hi)

/-  Equal powered fiber products have exactly equal label sets. -/
