    rw [if_neg (by rw [hcond]; simp), hs, hmod]

/-  `addModWord` stays below `m`. -/
theorem addModWord_lt (m a b : UInt64) (hm : 0 < m.toNat) (hmw : m.toNat ≤ UInt64.word)
