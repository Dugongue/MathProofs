  apply of_native_list
  have ht' := (realized_to_native ht).tidy
  rw [wire_prod,wire_bool] at ht'
  exact ComputableTidilyInPolyTime.filterWithInput (to_native_list hxs) ht'

theorem realized_append {ei : Encoding γ} {ea : Encoding α}
    {xs ys : γ → List α} (hx : Realized ei ea.list xs) (hy : Realized ei ea.list ys) :
    Realized ei ea.list (fun x => xs x ++ ys x) :=
  of_native_list (ComputableTidilyInPolyTime.listAppend' (to_native_list hx) (to_native_list hy))

