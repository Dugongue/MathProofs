    N0090.bitCost (N0206.auxiliaryWeight (fun i => variableWeight (some i))) f ≤ (binarySource f).length := by
  rw [binarySource_length]
  apply N0344.bitCost_mono
  intro v
  cases v with
  | none => exact Nat.zero_le _
  | some i => exact le_refl _

/-  This is the actual decoder source, with no formal lift or coefficient dictionary input. -/
def decoderSource {n : ℕ} (a : Fin n → ℚ) (A B : NumericPolynomial) (N : ℕ)
    (f : N0090.Formula (Option (Fin n))) : N0090.Formula (Option (Fin n)) :=
  N0046.radialClusterFormula a A B N f

/-  Polynomial budget from original dense bills, center literals, degrees and original binary input length. -/
def decoderBudget {n : ℕ} (a : Fin n → ℚ) (A B : NumericPolynomial) (N : ℕ)
    (f : N0090.Formula (Option (Fin n))) : ℕ :=
  N0047.uniformOutputBudget A B N (max f.formalDegree (A*B).natDegree)
    (N0046.perturbationBudget (A*B).natDegree (N0046.centerHeight a)
      (N0047.productHeight A B) (binarySource f).length) 1

