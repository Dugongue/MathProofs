      (.assign q.N (.var q.n)))

/-  Every iteration scans P, conditionally cancels its leading term, and
increments the bounded iteration counter. Terminal remainders are retained. -/
def body (q : RNames) : Com :=
  .seq (leadingProgram q)
    (.seq (.ite (.eq (.var q.f) (.lit 1))
      (.ite (.lt (.var q.pv) (plus (.var q.w) (.lit 1))) (cancelBranch q) .skip) .skip)
      (.assign q.c (plus (.var q.c) (.lit 1))))

def setup (q : RNames) : Com :=
  .seq (.assign q.N (.var q.n))
    (.seq (.assign q.u (.lit 1))
      (.seq (leadingProgram q)
        (.seq (.assign q.w (.var q.pv))
          (.seq (.assign q.u (.lit 0)) (.assign q.c (.lit 0))))))

/-  Literal total bounded-loop structure. If Q is zero the unchanged P is
already its remainder; otherwise exactly N bounded iterations suffice. -/
def program (q : RNames) : Com :=
  .seq (setup q)
    (.ite (.eq (.var q.f) (.lit 1))
      (.while (.lt (.var q.c) (.var q.n)) (body q)) .skip)

