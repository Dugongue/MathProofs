def elimCost (M : FieldMacros F r) (q : RNames) (Nv cv : ℕ) : ℕ :=
  50 + M.costInv + (60 + M.costMul + axpyCost M (rowBase q (.var q.w)) (rowBase q (.var q.u)) Nv) *
    cv + 40 + M.costMul + axpyCost M (.lit 5) (rowBase q (.var q.u)) Nv

