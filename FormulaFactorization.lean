  (.seq (.assign tempIN (.get basisN (rectAddress (.var swapI) (.var swapCol))))
    (.seq (.assign tempJS (.get basisS (rectAddress (.var swapJ) (.var swapCol))))
      (.seq (.assign tempJN (.get basisN (rectAddress (.var swapJ) (.var swapCol))))
        (.seq (.store basisS (rectAddress (.var swapI) (.var swapCol)) (.var tempJS))
          (.seq (.store basisN (rectAddress (.var swapI) (.var swapCol)) (.var tempJN))
            (.seq (.store basisS (rectAddress (.var swapJ) (.var swapCol)) (.var tempIS))
              (.seq (.store basisN (rectAddress (.var swapJ) (.var swapCol)) (.var tempIN))
                (.assign swapCol (.add (.var swapCol) (.lit 1))))))))))
def swapLoop : Com := .while (.lt (.var swapCol) (.var dimVar)) swapBody
