/-!
# Exact binary-machine contracts for formula PIT and complete factorization

The intended endpoint is
`formula_pit_implies_formula_factorization : FormulaPITInP → FormulaFactorizationInP`.
This file defines that faithful endpoint; it does not postulate or prove it.
There is no supplied factorizer, cluster compiler, or numerical factoring oracle.

Inputs are ordinary rational formula trees over natural-number variable names.
Their full prefix binary source, including every rational literal, is charged.
No separately supplied numeric degree bound is needed: `Cost` proves that the
syntactic degree is at most the bit cost of this source.
-/

namespace Internal.N0339.N0197

open Internal.N0339.N0005.N0198

abbrev RationalFormula := ArithFormula ℕ ℚ

noncomputable def polynomial (f : RationalFormula) : MvPolynomial ℕ ℚ :=
  N0090.eval₂ (MvPolynomial.C : ℚ →+* MvPolynomial ℕ ℚ) MvPolynomial.X f

/-  Full binary source length, charging variable names and rational literals. -/
def inputSize (f : RationalFormula) : ℕ := (N0090.encode f).length

theorem formalDegree_le_inputSize (f : RationalFormula) :
    f.formalDegree ≤ inputSize f := by
  rw [inputSize, N0090.encode_length]
  exact N0090.formalDegree_le_bitCost _ f

/-  Zero has its own tag. Nonzero output gives a unit and factors with multiplicities. -/
inductive FactorizationOutput where
  | zero
  | factors (unit : ℚ) (entries : List (RationalFormula × ℕ))

/-  Every entry's entire formula tree and multiplicity are serialized. -/
def factorEntriesCode : List (RationalFormula × ℕ) → List Bool
  | [] => []
  | (f, e) :: rest => N0090.encode f ++ N0090.natCode e ++ factorEntriesCode rest

def FactorizationOutput.encode : FactorizationOutput → List Bool
  | .zero => [false]
  | .factors c entries =>
      [true] ++ N0090.ratCode c ++ N0090.natCode entries.length ++ factorEntriesCode entries

@[simp] theorem factorEntriesCode_length (entries : List (RationalFormula × ℕ)) :
    (factorEntriesCode entries).length =
      (entries.map fun t => (N0090.encode t.1).length + (N0090.natCode t.2).length).sum := by
  induction entries with
  | nil => rfl
  | cons t rest ih =>
      rcases t with ⟨f, e⟩
      simp [factorEntriesCode, ih]
      omega

/-  Complete irreducible factorization over Q, not merely a product identity. -/
def CorrectFactorization (f : RationalFormula) : FactorizationOutput → Prop
  | .zero => polynomial f = 0
  | .factors c entries =>
      c ≠ 0 ∧
      (∀ t ∈ entries, 0 < t.2 ∧ Irreducible (polynomial t.1)) ∧
      entries.Pairwise (fun t u => ¬ Associated (polynomial t.1) (polynomial u.1)) ∧
      polynomial f = MvPolynomial.C c *
        (entries.map fun t => polynomial t.1 ^ t.2).prod

/-  A literal finite-control binary multitape machine, fixed before any input. -/
structure BinaryTransducer where
  workTapes : ℕ
  State : Type
  stateFinite : Fintype State
  start : State
  transition : State → (Fin (workTapes + 2) → Option Bool) →
    Option (State × (Fin (workTapes + 2) → Internal.N0339.N0349.Action (Option Bool)))

attribute [instance] BinaryTransducer.stateFinite

namespace BinaryTransducer

/-  Tape 0 is input, tape 1 is output; the remaining tapes are ordinary work tapes. -/
def inputTape (M : BinaryTransducer) : Fin (M.workTapes + 2) := ⟨0, by omega⟩
def outputTape (M : BinaryTransducer) : Fin (M.workTapes + 2) := ⟨1, by omega⟩

def machine (M : BinaryTransducer) :
    Internal.N0339.N0349.Machine (Fin (M.workTapes + 2)) (Option Bool) M.State where
  transition := M.transition

def initial (M : BinaryTransducer) (bits : List Bool) :
    Internal.N0339.N0349.Config (Fin (M.workTapes + 2)) (Option Bool) M.State where
  state := M.start
  tapes i := if i = M.inputTape then Internal.N0339.N0349.stackTape bits
    else Internal.N0339.N0349.stackTape []

