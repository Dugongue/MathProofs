/-!
# Actual existence and line interface for the cluster decoder

Monicity and an actual numeric fiber suffice to construct the unique bounded
Hensel lift. Unknown lifts are not premises of the decoder-existence theorem.
The finite source output is identified with the collapse used in the independently
checked line-specialization results.
-/
namespace Internal.N0339.N0197.N0042

open Polynomial Finset

variable {ι R : Type} [CommRing R] [IsDomain R] [Algebra ℚ R]

/-  A monic polynomial over formal series has no positive t coefficient at or
above its Y degree. -/
theorem monic_positive_degree (P : Polynomial (PowerSeries R)) (hP : P.Monic)
    (n : ℕ) (hn : 0 < n) :
    (PowerSeries.coeff n (N0035.toSeries P)).degree < P.degree := by
  rw [Polynomial.degree_eq_natDegree hP.ne_zero]
  apply (Polynomial.degree_lt_iff_coeff_zero _ _).mpr
  intro j hj
  rw [N0035.bicomponent]
  by_cases heq : j = P.natDegree
  · subst j
    rw [hP.coeff_natDegree]
    simp [Nat.ne_of_gt hn]
  · rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega)]
    simp

/-  Radial substitution has the chosen numeric center as its actual t = 0 fiber. -/
theorem radial_fiber (env : ι → R) (a : ι → ℚ) (f : N0090.Formula (Option ι)) :
    (N0276.auxiliaryPolynomial (N0046.radialEnvironment env a) f).map
      PowerSeries.constantCoeff =
      N0276.auxiliaryPolynomial (fun i => algebraMap ℚ R (a i)) f := by
  induction f with
  | const q =>
      change (C (algebraMap ℚ (PowerSeries R) q)).map PowerSeries.constantCoeff =
        C (algebraMap ℚ R q)
      rw [Polynomial.map_C, PowerSeries.algebraMap_apply]
      simp only [PowerSeries.constantCoeff_C]
  | var v =>
      cases v with
      | none => exact Polynomial.map_X _
      | some i =>
          change (C (N0046.radialEnvironment env a i)).map PowerSeries.constantCoeff =
            C (algebraMap ℚ R (a i))
          rw [Polynomial.map_C]
          simp only [N0046.radialEnvironment, map_add, map_mul, map_sub,
            PowerSeries.constantCoeff_C, PowerSeries.constantCoeff_X, zero_mul, add_zero]
  | add f g hf hg =>
      change Polynomial.map PowerSeries.constantCoeff
        (N0276.auxiliaryPolynomial (N0046.radialEnvironment env a) f +
          N0276.auxiliaryPolynomial (N0046.radialEnvironment env a) g) =
        N0276.auxiliaryPolynomial (fun i => algebraMap ℚ R (a i)) f +
          N0276.auxiliaryPolynomial (fun i => algebraMap ℚ R (a i)) g
      rw [Polynomial.map_add, hf, hg]
  | mul f g hf hg =>
      change Polynomial.map PowerSeries.constantCoeff
        (N0276.auxiliaryPolynomial (N0046.radialEnvironment env a) f *
          N0276.auxiliaryPolynomial (N0046.radialEnvironment env a) g) =
        N0276.auxiliaryPolynomial (fun i => algebraMap ℚ R (a i)) f *
          N0276.auxiliaryPolynomial (fun i => algebraMap ℚ R (a i)) g
      rw [Polynomial.map_mul, hf, hg]

/-  The finite sum used by the source decoder is exactly the proved line-collapse
operation; no infinite power series is evaluated at one. -/
theorem collapse_eq_sum (N : ℕ) (H : PowerSeries R[X]) :
    N0322.collapse N H = ∑ n ∈ range (N+1), PowerSeries.coeff n H := by
  unfold N0322.collapse
  simpa only [Polynomial.eval₂_id, RingHom.id_apply, one_pow, mul_one] using
    (PowerSeries.eval₂_trunc_eq_sum_range (1 : R[X]) (RingHom.id R[X]) (N+1) H)

/-  The actual source constructor is the collapse to which line correctness
applies. The formal factors are proof witnesses, never constructor inputs. -/
theorem radial_decoder_eq_collapse (env : ι → R) (a : ι → ℚ)
    (A B : N0625.NumericPolynomial) (hA : A.toPoly.Monic)
    (hB : B.toPoly ≠ 0) (hAB : IsCoprime A.toPoly B.toPoly)
    (N : ℕ) (hp : 0 < A.natDegree) (hpN : A.natDegree ≤ N)
    (f : N0090.Formula (Option ι)) (H K : PowerSeries R[X])
    (hH0 : PowerSeries.coeff 0 H = N0041.initial A)
    (hK0 : PowerSeries.coeff 0 K = N0041.initial B)
    (hpos : ∀ n > 0, (PowerSeries.coeff n H).degree <
      (N0041.initial (R := R) A).degree)
    (hHK : H*K = N0046.radialSeries env a f) :
    N0276.auxiliaryPolynomial env (N0046.radialClusterFormula a A B N f) =
      N0322.collapse N H := by
  rw [collapse_eq_sum]
  exact N0046.radialClusterFormula_correct env a A B hA hB hAB N hp hpN f
    H K hH0 hK0 hpos hHK

/-  Numeric monic coprime factors of the actual fiber, and monicity of the radial
input, suffice for decoder existence. No lifter, moment source or hidden factor
formula is supplied as a hypothesis. -/
theorem decoder_lift_exists (env : ι → R) (a : ι → ℚ)
    (A B : N0625.NumericPolynomial) (hA : A.toPoly.Monic)
    (hB : B.toPoly.Monic) (hAB : IsCoprime A.toPoly B.toPoly)
    (N : ℕ) (hp : 0 < A.natDegree) (hpN : A.natDegree ≤ N)
    (f : N0090.Formula (Option ι))
    (hmonic : (N0276.auxiliaryPolynomial (N0046.radialEnvironment env a) f).Monic)
    (hfiber : N0276.auxiliaryPolynomial (fun i => algebraMap ℚ R (a i)) f =
      N0041.initial A * N0041.initial B) :
    ∃ H K : PowerSeries R[X],
      PowerSeries.coeff 0 H = N0041.initial A ∧
      PowerSeries.coeff 0 K = N0041.initial B ∧
      (∀ n > 0, (PowerSeries.coeff n H).degree < (N0041.initial (R := R) A).degree) ∧
      (∀ n > 0, (PowerSeries.coeff n K).degree < (N0041.initial (R := R) B).degree) ∧
      H*K = N0046.radialSeries env a f ∧
      N0276.auxiliaryPolynomial env (N0046.radialClusterFormula a A B N f) =
        N0322.collapse N H := by
  let P := N0276.auxiliaryPolynomial (N0046.radialEnvironment env a) f
  have hinit : P.map PowerSeries.constantCoeff =
      N0041.initial (R := R) A * N0041.initial B :=
    (radial_fiber env a f).trans hfiber
  have ha : (N0041.initial (R := R) A).Monic := hA.map _
  have hb : (N0041.initial (R := R) B).Monic := hB.map _
  have hcop : IsCoprime (N0041.initial (R := R) A) (N0041.initial B) := by
    exact hAB.map (Polynomial.mapRingHom (algebraMap ℚ R))
  have hdeg : P.degree = (N0041.initial (R := R) A).degree +
      (N0041.initial (R := R) B).degree := by
    rw [← hmonic.degree_map PowerSeries.constantCoeff, hinit, Polynomial.degree_mul]
  obtain ⟨H, K, hH0, hK0, hHd, hKd, hHK⟩ :=
    N0207.coprime_cluster_lift_exists (N0035.toSeries P) ha hb hcop
      (by rw [← N0035.fiber_toSeries, hinit])
      (fun n hn => (monic_positive_degree P hmonic n hn).trans_eq hdeg)
  exact ⟨H, K, hH0, hK0, hHd, hKd, hHK,
    radial_decoder_eq_collapse env a A B hA hB.ne_zero hAB N hp hpN f H K hH0 hK0 hHd hHK⟩

end Internal.N0339.N0197.N0042

end P25Clean0323
