    have hnρ : ρ.vars nVar=n := (fr.vars nVar (by decide)).trans hn
    have htρ : ρ.vars targetVar=target.val := (fr.vars _ (by decide)).trans ht
    have hkρ : ρ.vars prefixVar=k := (fr.vars _ (by decide)).trans hk
    have hmρ : ρ.vars mixedVar=(if mixed then 1 else 0) := (fr.vars _ (by decide)).trans hm
