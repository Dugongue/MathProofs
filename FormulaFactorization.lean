namespace Internal.N0339.N0197.N0268
open Matrix
open scoped BigOperators
set_option maxHeartbeats 1000000
set_option maxRecDepth 4096
set_option backward.isDefEq.respectTransparency false

def prefixRows {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (k : ℕ) (hk : k≤n) :
    Matrix (Fin k) (Fin m) ℤ := fun i r=>M r ⟨i.val,i.isLt.trans_le hk⟩

def gram {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (k : ℕ) (hk : k≤n) :
    Matrix (Fin k) (Fin k) ℤ := prefixRows M k hk*(prefixRows M k hk).transpose

def prefixDet {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (k : ℕ) (hk : k≤n) : ℤ :=
  N0301.matrixDeterminant (gram M k hk)

def firstSingular {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) : Option (Fin n) :=
  (List.ofFn (fun i : Fin n=>i)).find? (fun j=>decide (prefixDet M (j.val+1) (by omega)=0))

def coordinate {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (j : Fin n) (i : Fin (j.val+1)) : ℤ :=
  (-1)^(j.val+i.val)*N0301.matrixDeterminant
    ((gram M (j.val+1) (by omega)).submatrix (Fin.last j.val).succAbove i.succAbove)

def embed {n k : ℕ} (hk : k≤n) (v : Fin k → ℤ) : Fin n → ℤ :=
  ∑i,v i • Pi.single ⟨i.val,i.isLt.trans_le hk⟩ 1

def candidate {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (j : Fin n) : Fin n → ℤ :=
  embed (by omega : j.val+1≤n) (coordinate M j)

def witness {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) : Option (Fin n → ℤ) :=
  (firstSingular M).map (candidate M)

theorem prefixDet_correct {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (k : ℕ) (hk : k≤n) :
    prefixDet M k hk=(gram M k hk).det :=
  N0301.matrixDeterminant_correct _

theorem firstSingular_spec {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (j : Fin n)
    (hj : firstSingular M=some j) :
    prefixDet M (j.val+1) (by omega)=0 ∧ prefixDet M j.val (by omega)≠0 := by
  have hs := (List.find?_ofFn_eq_some_of_injective
    (f:=fun i : Fin n=>i) Function.injective_id).mp hj
  refine ⟨of_decide_eq_true hs.1,?_⟩
  by_cases hz : j.val=0
  · have hn : 0<n := by omega
    have he : j=(⟨0,hn⟩ : Fin n) := Fin.ext hz
    subst j
    simp [prefixDet,gram,N0301.matrixDeterminant_correct]
  · let i : Fin n := ⟨j.val-1,by omega⟩
    have hi : i<j := by change j.val-1<j.val;omega
    have he := hs.2 i hi
    intro hd
    apply he
    rw [decide_eq_true_eq]
    simpa only [i,show j.val-1+1=j.val by omega] using hd

theorem coordinate_adjugate {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (j : Fin n) :
    coordinate M j=fun i=>(gram M (j.val+1) (by omega)).adjugate i (Fin.last j.val) := by
  funext i
  rw [coordinate,N0301.matrixDeterminant_correct,
    Matrix.adjugate_fin_succ_eq_det_submatrix]
  rfl

theorem gram_minor_last {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (j : Fin n) :
    (gram M (j.val+1) (by omega)).submatrix (Fin.last j.val).succAbove (Fin.last j.val).succAbove=
      gram M j.val (by omega) := by
  ext i l
  simp [gram,prefixRows,Matrix.mul_apply,Matrix.transpose_apply,Fin.succAbove_last]

theorem coordinate_last_nonzero {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (j : Fin n)
    (hj : prefixDet M j.val (by omega)≠0) : coordinate M j (Fin.last j.val)≠0 := by
  rw [coordinate,gram_minor_last]
  exact mul_ne_zero (pow_ne_zero _ (by norm_num)) hj

/-  The elementary ordered-ring sum-of-squares identity needs no real-space
representation and holds even for singular or empty matrices. -/
theorem transpose_mul_self_kernel {m n : ℕ} (A : Matrix (Fin m) (Fin n) ℤ) (v : Fin n → ℤ)
    (h : (A.transpose*A)*ᵥv=0) : A*ᵥv=0 := by
