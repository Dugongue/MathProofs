  ext i
  rw [coeff_toPolynomial, Internal.N0208.DensePoly.coeff_monomial, Polynomial.coeff_monomial]
  by_cases h : i = n
  · simp [h]
  · have h' : n ≠ i := fun heq => h heq.symm
    simp [h, h']
    rfl

/-  {name}`HexPolyTheory.toPolynomial` commutes with polynomial addition. -/
@[simp, grind =]
theorem toPolynomial_add [Semiring R] [DecidableEq R] (p q : Internal.N0208.DensePoly R) :
    toPolynomial (p + q) = toPolynomial p + toPolynomial q := by
  ext n
  rw [coeff_toPolynomial, Polynomial.coeff_add, coeff_toPolynomial, coeff_toPolynomial]
  exact Internal.N0208.DensePoly.coeff_add p q n (by
    show (0 : R) + (0 : R) = 0
