  have hpp' : p.toNat * ctx.p'.toNat % UInt64.word = UInt64.word - 1 := by
    simpa [Nat.mul_comm] using ctx.p'_eq
  simpa [mulMont] using montgomeryReduce_mulFull_repr_word ctx a b hT hpp'

