    apply MvPolynomial.funext
    intro a
    rw [map_zero]
    change MvPolynomial.eval₂ (RingHom.id ℚ) a (N0345.polynomial (finiteFormula f)) = 0
    rw [N0345.polynomial_eval₂, finiteFormula, N0090.eval₂_substitute]
    exact hz (fun i => a i.val)
  · intro hz a
    let ext : ℕ → ℚ := fun i => if hi : i < n then a ⟨i, hi⟩ else 0
    have he := congrArg (MvPolynomial.eval ext) hz
    rw [map_zero] at he
    change MvPolynomial.eval₂ (RingHom.id ℚ) ext (N0345.polynomial (finiteFormula f)) = 0 at he
    rw [N0345.polynomial_eval₂, finiteFormula, N0090.eval₂_substitute] at he
    have ha : (fun i : Fin n => ext i.val) = a := by
      funext i
      simp only [ext, dif_pos i.isLt]
    simpa only [N0090.eval₂, ha] using he

