  have hJ : 0 ≤ (n+1:ℝ)*Phi := by positivity
  have hh := reduceList_target_width (normalizeList B left) i js hC hs (Phi*M+2) hA hb M _ hJ ht he
  rw [fastReduceList_correct]
  intro c
