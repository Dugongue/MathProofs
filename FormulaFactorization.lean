      p.last = rightCfg p₁.last ∧ p.length ≤ p₀.length + p₁.length ∧
      p.space ≤ p₀.space + p₁.space := by
  obtain ⟨p, hh, hl, ht, hmem⟩ := exists_runPath_seq h₀ h₁ hp₁
