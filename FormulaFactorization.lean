open scoped BigOperators

section Monoid

variable {M ι : Type*} [CommMonoidWithZero M] [IsCancelMulZero M]

/-  Prime divisibility detects membership in an actual powered label product. -/
theorem prime_dvd_product_iff_mem (s : Finset ι) (g : ι → M) (e : ι → ℕ)
    (hprime : ∀ i, Prime (g i)) (hsep : ∀ i j, i ≠ j → ¬ g i ∣ g j)
    (he : ∀ i, 0 < e i) (i : ι) :
