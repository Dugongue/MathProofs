theorem cluster_jet_specialization {S T : Type*} [CommRing S] [CommRing T]
    (φ : S →+* T) (H : PowerSeries S) (D : ℕ) :
    (PowerSeries.trunc (D + 1) H).map φ =
      PowerSeries.trunc (D + 1) (PowerSeries.map φ H) :=
  (PowerSeries.trunc_map φ H (D + 1)).symm

