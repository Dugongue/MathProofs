  ((List.finRange m).find? (test A)).map (candidate A)

theorem witness_some (A : Matrix (Fin n) (Fin m) K) (x : Fin m→K)
    (h : witness A=some x) : x≠0 ∧ A.mulVec x=0 := by
  obtain ⟨j,hj,hx⟩:=Option.map_eq_some_iff.mp h
  have hc:=candidate_correct A j (List.find?_some hj)
  subst x
  refine ⟨?_,hc.1⟩
  intro hz
  have he:=congrFun hz j
  rw [hc.2] at he
  exact one_ne_zero he

theorem witness_exists (A : Matrix (Fin n) (Fin m) K) (x : Fin m→K)
    (hx : x≠0) (hA : A.mulVec x=0) : ∃y,witness A=some y := by
  have hj : ∃j,x j≠0 := by
    by_contra h
    apply hx
    funext j
    simpa using not_exists.mp h j
  obtain ⟨j,hj⟩:=hj
  have hn : A.mulVec ((x j)⁻¹ • x)=0 := by rw [Matrix.mulVec_smul,hA,smul_zero]
  have hv : ((x j)⁻¹ • x) j=1 := by simp [hj]
  have ht:=test_complete A j ((x j)⁻¹ • x) hn hv
  cases hf : (List.finRange m).find? (test A) with
  | none =>
    have hh:=List.find?_eq_none.mp hf j (List.mem_finRange j)
    simp [ht] at hh
  | some k => exact ⟨candidate A k,by simp [witness,hf]⟩

theorem witness_none_iff (A : Matrix (Fin n) (Fin m) K) :
    witness A=none ↔ ∀x,A.mulVec x=0 → x=0 := by
  constructor
  · intro hn x hx
    by_contra hz
    obtain ⟨y,hy⟩:=witness_exists A x hz hx
    rw [hn] at hy
    contradiction
  · intro h
    cases hw : witness A with
    | none => rfl
    | some x => exact False.elim ((witness_some A x hw).1 (h x (witness_some A x hw).2))
