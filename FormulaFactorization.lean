  have hjvn : (σ.arrs basisN).getD (d*j.val+c.val) 0=(A j c).magnitude := by simp only [List.getD_eq_getElem?_getD,hjn,Option.getD_some]
  have hia := (rect_address_lt i c).trans hW
  have hja := (rect_address_lt j c).trans hW
  have hnB : n<W := by have hp := c.isLt; nlinarith
  have hdB : d<W := by have hp := i.isLt; nlinarith
