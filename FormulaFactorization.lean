      p.last = wordsCfg input (some (.run tm.q₀)) wsn (out ++ acc) ∧ p.length ≤ n * (t + 1) ∧
      p.InWindow s ∧ P n input wsn acc := by
    intro n hn
    induction n with
    | zero =>
      refine ⟨.singleton _ start, ws, [], rfl, by simp [hstart], by simp, ?_, hP0⟩
      rintro _ ⟨_, rfl⟩ l
      change start.workTapePos l ∈ _
