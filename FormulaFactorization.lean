theorem compiled_producer :
    ∃M : TM2ComputableInPolyTime encodeInput BitstringEncoding.bitEncode (fun i : Input=>outputWords (finalData i.basis)),
      ∀k,Finite (M.tm.Γ k) := by
  apply Internal.N0339.N0572.uniform_root_machine
