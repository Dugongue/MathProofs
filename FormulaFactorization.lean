  induction xs with
  | nil =>
    intro left hsplit σ A hLive hi hval
    have he := congrArg List.length hsplit
    have hln : left.length=n := by simpa using he.symm
    have hb := N0282.arithmetic_widths S n d hn hd
    have hnW : n<N0282.wordBound S := by nlinarith [hb.1]
    have ec := evalB_condLt
      (evalB_var_iff.mpr ⟨hi.symm,by rw [hi,hln]; exact hnW⟩)
      (evalB_var_iff.mpr ⟨hLive.bank.1.symm,by rw [hLive.bank.1]; exact hnW⟩)
