  left : ℕ
  head : ℕ
  right : ℕ
  deriving DecidableEq

def encode (t : Tape (Option Bool)) : Code := ⟨halfCode t.left,symbol t.head,halfCode t.right⟩

def moveCode (m : Move) (c : Code) : Code := match m with
  | .stay => c
  | .left => ⟨c.left/4,c.left%4,c.head+4*c.right⟩
  | .right => ⟨c.head+4*c.left,c.right%4,c.right/4⟩

def actCode (a : Action (Option Bool)) (c : Code) : Code :=
  moveCode a.move {c with head:=match a.write with | none=>c.head | some b=>symbol b}

