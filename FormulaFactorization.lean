    reduceCost M q N n c ≤ 1200 * W * (N + 1) * (c + 1) ^ 2 := by
  have h1 := hW.one
  have s := stepCost_le hW q N n c hn
  have hs : 4 + stepCost M q N n c ≤ 1104 * W * (N + 1) * (c + 1) := by
    have : 1 ≤ W * (N + 1) * (c + 1) := by
      have := Nat.mul_le_mul (Nat.mul_le_mul h1 (Nat.le_add_left 1 N)) (Nat.le_add_left 1 c)
      simpa using this
    nlinarith
  have := Nat.mul_le_mul_right c hs
  have : 1 ≤ W * (N + 1) * (c + 1) ^ 2 := by
    have := Nat.mul_le_mul (Nat.mul_le_mul h1 (Nat.le_add_left 1 N))
      (Nat.one_le_pow 2 (c + 1) (by omega))
    simpa using this
