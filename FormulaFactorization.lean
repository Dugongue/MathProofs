/-  Actual rational arithmetic specialization of a formula into a dense polynomial. -/
def specialize {ι : Type} (env : ι → ℚ) : N0090.Formula (Option ι) → NumericPolynomial
  | .const q => CPolynomial.C q
  | .var none => CPolynomial.X
  | .var (some i) => CPolynomial.C (env i)
  | .add f g => specialize env f + specialize env g
  | .mul f g => specialize env f * specialize env g

theorem specialize_correct {ι : Type} (env : ι → ℚ) (f : N0090.Formula (Option ι)) :
    (specialize env f).toPoly = N0276.auxiliaryPolynomial env f := by
  induction f with
  | const q => simp [specialize, N0276.auxiliaryPolynomial, N0090.eval₂, CPolynomial.C_toPoly]
  | var i => cases i <;> simp [specialize, N0276.auxiliaryPolynomial, N0090.eval₂,
      CPolynomial.C_toPoly, CPolynomial.X_toPoly]
  | add f g ihf ihg =>
      simpa only [specialize, CPolynomial.toPoly_add, ihf, ihg] using
        (show N0276.auxiliaryPolynomial env f + N0276.auxiliaryPolynomial env g =
          N0276.auxiliaryPolynomial env (.add f g) from rfl)
  | mul f g ihf ihg =>
      simpa only [specialize, CPolynomial.toPoly_mul, ihf, ihg] using
        (show N0276.auxiliaryPolynomial env f * N0276.auxiliaryPolynomial env g =
          N0276.auxiliaryPolynomial env (.mul f g) from rfl)

theorem specialize_degree {ι : Type} (env : ι → ℚ) (f : N0090.Formula (Option ι)) :
    (specialize env f).natDegree ≤ f.formalDegree := by
  rw [CPolynomial.natDegree_toPoly, specialize_correct]
  exact N0388.auxiliaryPolynomial_degree env f

