/-  A literal formula coefficient source computes the actual Hensel coefficient at every input.
The only source premise identifies the supplied perturbation formula with F-F(0), not with moments. -/
 theorem reverseCoefficientSource_actual_coeff [IsDomain R]
    (env : ι → R) (A B : NumericPolynomial) (hA : A.toPoly.Monic) (hB : B.toPoly ≠ 0)
    (hAB : IsCoprime A.toPoly B.toPoly) (N d : ℕ) (hp : 0 < A.natDegree)
    (hpN : A.natDegree ≤ N) (E : N0090.Formula (Option (Option ι)))
    (hdegree : (N0276.auxiliaryPolynomial (seriesEnvironment env) E).natDegree ≤ d)
    (H K : PowerSeries R[X]) (hH0 : PowerSeries.coeff 0 H = initial A)
    (hK0 : PowerSeries.coeff 0 K = initial B)
    (hpos : ∀ m > 0, (PowerSeries.coeff m H).degree < (initial (R := R) A).degree)
    (hsource : N0035.toSeries (N0276.auxiliaryPolynomial (seriesEnvironment env) E) =
      H*K-PowerSeries.C (initial A*initial B))
    (k n : ℕ) (hk : k ≤ A.natDegree) (hn : n ≤ N) :
    (N0276.auxiliaryPolynomial env (reverseCoefficientSource A B N d k E)).coeff n =
      (PowerSeries.coeff n H).coeff (A.natDegree-k) := by
  have hkk : k ≤ A.natDegree*A.natDegree := hk.trans (Nat.le_mul_self _)
  have hs := reverseCoefficientSource_series (seriesEnvironment env) A B hA N d k hpN hkk E hdegree
  dsimp only at hs
  rw [hsource, sub_add_cancel] at hs
  have hc := congrArg (PowerSeries.coeff n) hs
  rw [seriesEvaluation_coeff] at hc
  have hb : (initial (R := R) B) ≠ 0 := by
    intro hz
    apply hB
    exact Polynomial.map_injective (algebraMap ℚ R) (algebraMap ℚ R).injective (by simpa only [initial, Polynomial.map_zero] using hz)
  have hJK : ∀ l, inverse (R := R) A B l * (initial B)^l +
      complementaryInverse A B l * (initial A)^l = 1 :=
    fun l => N0625.clusterInverse_map_correct A B hA hAB l
  have hd := N0040.clusterDecode_correct N (initial A) (initial B) (hA.map _) hb
    (by rw [numeric_degree A]; exact hp) (by rw [numeric_degree A]; exact hpN)
    (inverse A B) (complementaryInverse A B) hJK H K hH0 hK0 hpos k n
    (by rw [numeric_degree A]; exact hk) hn
  rw [numeric_degree A] at hd
  exact hc.trans hd

/-  The clipped literal coefficient source equals the complete paid t-jet evaluated at one. -/
 theorem clippedCoefficientSource_actual [IsDomain R]
    (env : ι → R) (A B : NumericPolynomial) (hA : A.toPoly.Monic) (hB : B.toPoly ≠ 0)
    (hAB : IsCoprime A.toPoly B.toPoly) (N d : ℕ) (hp : 0 < A.natDegree)
    (hpN : A.natDegree ≤ N) (E : N0090.Formula (Option (Option ι)))
    (hdegree : (N0276.auxiliaryPolynomial (seriesEnvironment env) E).natDegree ≤ d)
    (H K : PowerSeries R[X]) (hH0 : PowerSeries.coeff 0 H = initial A)
    (hK0 : PowerSeries.coeff 0 K = initial B)
    (hpos : ∀ m > 0, (PowerSeries.coeff m H).degree < (initial (R := R) A).degree)
    (hsource : N0035.toSeries (N0276.auxiliaryPolynomial (seriesEnvironment env) E) =
      H*K-PowerSeries.C (initial A*initial B))
    (k : ℕ) (hk : k ≤ A.natDegree) :
    N0090.eval₂ (algebraMap ℚ R) env (clippedCoefficientSource A B N d k E) =
      ∑ n ∈ range (N+1), (PowerSeries.coeff n H).coeff (A.natDegree-k) := by
  rw [clippedCoefficientSource_correct]
  apply sum_congr rfl
  intro n hn
  exact reverseCoefficientSource_actual_coeff env A B hA hB hAB N d hp hpN E hdegree
    H K hH0 hK0 hpos hsource k n hk (Nat.le_of_lt_succ (mem_range.mp hn))

/-  The final actual formula recovers the whole bounded Hensel jet at all original inputs.
The constructor receives no root, factor formula, moment table, or source for H. -/
 theorem clusterFormula_correct [IsDomain R]
    (env : ι → R) (A B : NumericPolynomial) (hA : A.toPoly.Monic) (hB : B.toPoly ≠ 0)
    (hAB : IsCoprime A.toPoly B.toPoly) (N d : ℕ) (hp : 0 < A.natDegree)
    (hpN : A.natDegree ≤ N) (E : N0090.Formula (Option (Option ι)))
    (hdegree : (N0276.auxiliaryPolynomial (seriesEnvironment env) E).natDegree ≤ d)
    (H K : PowerSeries R[X]) (hH0 : PowerSeries.coeff 0 H = initial A)
    (hK0 : PowerSeries.coeff 0 K = initial B)
    (hpos : ∀ m > 0, (PowerSeries.coeff m H).degree < (initial (R := R) A).degree)
    (hsource : N0035.toSeries (N0276.auxiliaryPolynomial (seriesEnvironment env) E) =
      H*K-PowerSeries.C (initial A*initial B)) :
    N0276.auxiliaryPolynomial env (clusterFormula A B N d E) =
      ∑ n ∈ range (N+1), PowerSeries.coeff n H := by
  rw [clusterFormula, if_neg (Nat.ne_of_gt hp), N0344.tableFormula_polynomial]
  calc
    _ = ∑ j ∈ range (A.natDegree+1),
        C ((∑ n ∈ range (N+1), PowerSeries.coeff n H).coeff j) * X^j := by
      apply sum_congr rfl
      intro j hj
      have hj' : j ≤ A.natDegree := Nat.le_of_lt_succ (mem_range.mp hj)
      rw [clippedCoefficientSource_actual env A B hA hB hAB N d hp hpN E hdegree
        H K hH0 hK0 hpos hsource (A.natDegree-j) (Nat.sub_le _ _), Nat.sub_sub_self hj',
        Polynomial.finsetSum_coeff]
    _ = _ := by
      apply (Polynomial.as_sum_range_C_mul_X_pow' _ _).symm
      apply Nat.lt_succ_of_le
      apply Polynomial.natDegree_sum_le_of_forall_le
      intro n hn
      have h := N0035.hensel_uniform_bound (initial A) H hH0 hpos n
      rw [numeric_degree A] at h
      exact h

end ActualCluster

/-  Degree-zero numeric clusters take the explicit constant-one branch. -/
theorem clusterFormula_degree_zero {ι : Type} (A B : NumericPolynomial) (N d : ℕ)
