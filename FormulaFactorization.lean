/-  One materialized coefficient-vector update, multiplying by a linear Lagrange factor. -/
def denseStep (M i j : ℕ) (v : Vector ℚ (M + 1)) : Vector ℚ (M + 1) :=
  Vector.ofFn fun k => ((i : ℚ) - (j : ℚ))⁻¹ *
    ((if h : k.val = 0 then 0 else v[k.val - 1]'(by omega)) - (j : ℚ) * v[k.val])

/-  Rational dense vectors are materialized after every step; no coefficient oracle occurs. -/
def denseBasis (M i : ℕ) : List ℕ → Vector ℚ (M + 1)
  | [] => Vector.ofFn fun k => if k.val = 0 then 1 else 0
  | j :: js => denseStep M i j (denseBasis M i js)

private theorem denseBasis_eq (M i : ℕ) (js : List ℕ) :
    ∀ k : ℕ, (hk : k < M + 1) →
      (denseBasis M i js)[k]'hk = (basisForList i js).coeff k := by
  induction js with
  | nil =>
      intro k hk
      simp [denseBasis, basisForList, coeff_one]
  | cons j js ih =>
      intro k hk
      simp only [denseBasis, denseStep, Vector.getElem_ofFn]
