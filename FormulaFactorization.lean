      line (K := K) B (x : HahnSeries Γ R).order := by
    rw [leadingCoeff_eq]; exact x.property _
  obtain ⟨u, hu⟩ := line_isUnit (K := K) B hline (leadingCoeff_ne_zero.mpr hx')
