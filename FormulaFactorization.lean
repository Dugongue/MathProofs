  rw [evaluation_as_series, Polynomial.coeff_coe]

noncomputable abbrev initial (A : NumericPolynomial) : R[X] := A.toPoly.map (algebraMap ℚ R)
noncomputable abbrev inverse (A B : NumericPolynomial) (l : ℕ) : R[X] :=
