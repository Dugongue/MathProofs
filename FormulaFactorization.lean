  replace h := congrArg (dotProduct v) h
  rwa [dotProduct_mulVec,dotProduct_zero,vecMul_transpose,dotProduct_self_eq_zero] at h

theorem coordinate_kernel {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (j : Fin n)
    (hj : prefixDet M (j.val+1) (by omega)=0) :
    (prefixRows M (j.val+1) (by omega)).transpose*ᵥcoordinate M j=0 := by
  apply transpose_mul_self_kernel
  have he := congrArg (fun A=>A*ᵥPi.single (Fin.last j.val) 1)
    (Matrix.mul_adjugate (gram M (j.val+1) (by omega)))
  have hc : (gram M (j.val+1) (by omega)).adjugate.col (Fin.last j.val)=
      (fun i=>(gram M (j.val+1) (by omega)).adjugate i (Fin.last j.val)) := by
    funext i
    rfl
  rw [← Matrix.mulVec_mulVec,Matrix.mulVec_single_one,hc,
    ← prefixDet_correct,hj,zero_smul,Matrix.zero_mulVec] at he
  simpa only [gram,Matrix.transpose_transpose,coordinate_adjugate] using he

theorem embed_mulVec {m n k : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (hk : k≤n) (v : Fin k → ℤ) :
    M*ᵥembed hk v=(prefixRows M k hk).transpose*ᵥv := by
  ext r
  simp [embed,Matrix.mulVec,dotProduct,Finset.mul_sum,Finset.sum_comm,Pi.single_apply,prefixRows,mul_comm]

theorem embed_at {n k : ℕ} (hk : k≤n) (v : Fin k → ℤ) (i : Fin k) :
    embed hk v ⟨i.val,i.isLt.trans_le hk⟩=v i := by
  simp only [embed,Finset.sum_apply,Pi.smul_apply,Pi.single_apply,smul_eq_mul]
  rw [Finset.sum_eq_single i]
  · simp
  · intro j hj hji
    have hv : j.val≠i.val := by intro he;exact hji (Fin.ext he)
    simp [Fin.ext_iff,hv,Ne.symm hv]
  · simp

theorem candidate_sound {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (j : Fin n)
    (hj : firstSingular M=some j) : M*ᵥcandidate M j=0 ∧ candidate M j≠0 := by
  have hs := firstSingular_spec M j hj
  refine ⟨?_,?_⟩
  · rw [candidate,embed_mulVec]
    exact coordinate_kernel M j hs.1
  · intro hz
    have he := congrFun hz (⟨j.val,by omega⟩ : Fin n)
    have hvalue := embed_at (by omega : j.val+1≤n) (coordinate M j) (Fin.last j.val)
    have hne := coordinate_last_nonzero M j hs.2
    exact hne (hvalue.symm.trans he)

theorem witness_sound {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (v : Fin n → ℤ)
    (hv : witness M=some v) : M*ᵥv=0 ∧ v≠0 := by
  cases he : firstSingular M with
  | none => simp [witness,he] at hv
  | some j =>
    have hEq : candidate M j=v := by simpa only [witness,he,Option.map_some,Option.some.injEq] using hv
    rw [← hEq]
    exact candidate_sound M j he

theorem full_prefix {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) : prefixRows M n le_rfl=M.transpose := by
  ext i j
  rfl

theorem kernel_forces_full_singular {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ)
    (v : Fin n → ℤ) (hv : M*ᵥv=0) (hn : v≠0) : prefixDet M n le_rfl=0 := by
  by_contra hd
  have hg : gram M n le_rfl*ᵥv=0 := by
    rw [gram,full_prefix,Matrix.transpose_transpose,← Matrix.mulVec_mulVec,hv,Matrix.mulVec_zero]
  have he := congrArg (fun w=>(gram M n le_rfl).adjugate*ᵥw) hg
  rw [Matrix.mulVec_mulVec,Matrix.adjugate_mul,Matrix.smul_mulVec,Matrix.one_mulVec,Matrix.mulVec_zero] at he
  apply hn
  funext i
  have hi := congrFun he i
  have hd' : (gram M n le_rfl).det≠0 := by rwa [← prefixDet_correct]
  exact (mul_eq_zero.mp hi).resolve_left hd'

theorem witness_complete {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ)
    (v : Fin n → ℤ) (hv : M*ᵥv=0) (hn : v≠0) :
    ∃w,witness M=some w ∧ M*ᵥw=0 ∧ w≠0 := by
  cases he : firstSingular M with
  | some j =>
    have hs := candidate_sound M j he
    exact ⟨candidate M j,by simp [witness,he],hs⟩
  | none =>
    have hz := kernel_forces_full_singular M v hv hn
    cases n with
    | zero => exact (hn (by ext i;exact Fin.elim0 i)).elim
    | succ n =>
      have hp := List.find?_eq_none.mp he (Fin.last n)
        (List.mem_ofFn.mpr ⟨Fin.last n,rfl⟩)
      simp only [Fin.val_last,hz,decide_true] at hp
      contradiction
















