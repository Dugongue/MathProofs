    exact (MvPolynomial.degreeOf_le_totalDegree H none).trans hH.totalDegree_le
  intro hz
  have hsum : (∑ j ∈ range (d + 1), P.coeff j) = 0 := by
    have he := Polynomial.eval_eq_sum_range' (p := P) (x := (1 : MvPolynomial ι ℚ)) (Nat.lt_succ_of_le hPd)
    simpa only [one_pow, mul_one] using he.symm.trans hz
  have hcoeff : ∀ i ≤ d, P.coeff i = 0 := by
    intro i hi
    have hcomponent := congrArg (MvPolynomial.homogeneousComponent (d - i)) hsum
    rw [map_sum, map_zero] at hcomponent
    have hs : (∑ j ∈ range (d + 1), MvPolynomial.homogeneousComponent (d - i) (P.coeff j)) = P.coeff i := by
      calc
        _ = ∑ j ∈ range (d + 1), if j = i then P.coeff i else 0 := by
          apply Finset.sum_congr rfl
          intro j hj
          have hjd : j ≤ d := by have h := Finset.mem_range.mp hj; omega
          have hhom : (P.coeff j).IsHomogeneous (d - j) :=
            MvPolynomial.IsHomogeneous.coeff_isHomogeneous_of_optionEquivLeft_symm
