      simp_rw [mul_sum, map_sum, map_mul, sum_mul]
      rw [sum_comm]
      apply sum_congr rfl
      intro i hi
      apply sum_congr rfl
      intro k hk
      ring

/-! Actual source constructors: the auxiliary variable is `none`, original variables are `some`. -/
open Internal.N0339.N0005.N0198

/-  Replace the auxiliary variable by one rational scalar, copying the original tree. -/
def specialize {ι : Type} (i : ℕ) (f : N0090.Formula (Option ι)) : N0090.Formula ι :=
  N0090.substitute (fun v => match v with
    | none => .const (i : ℚ)
    | some j => .var j) f

/-  Actual formula for one coefficient, not a coefficient-operation gate. -/
def coefficientFormula {ι : Type} (M k : ℕ) (f : N0090.Formula (Option ι)) : N0090.Formula ι :=
  N0090.weightedSum ((List.range (M + 1)).map fun i =>
    (coefficientWeight M k i, specialize i f))

/-  Polynomial interpretation in the auxiliary variable over any Q-algebra. -/
noncomputable def auxiliaryPolynomial {ι R : Type} [CommRing R] [Algebra ℚ R]
    (env : ι → R) (f : N0090.Formula (Option ι)) : R[X] :=
  N0090.eval₂ (Polynomial.C.comp (algebraMap ℚ R))
    (fun v => match v with | none => X | some i => C (env i)) f

