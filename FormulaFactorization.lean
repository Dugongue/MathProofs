  have hM : 0≤ sourceNorm B := by unfold sourceNorm;positivity
  apply runWidths_of_bounds B hB k (sourcePhi B) (sourceNorm B) le_rfl hPhi hM hlarge
  intro r
  have hh : ‖N0297.rows B r‖^2≤∑ j : Fin n, ‖N0297.rows B j‖^2 :=
    Finset.single_le_sum (f:=fun j : Fin n => ‖N0297.rows B j‖^2)
      (fun _ _ => sq_nonneg _) (Finset.mem_univ r)
  unfold sourceNorm
  have hp : 0≤(n+1:ℝ)*sourcePhi B := by positivity
  linarith

