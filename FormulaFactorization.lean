def sourceFuel (S : ℕ) := 3*(potentialExponent S+1)

theorem fuel_le_source {n d : ℕ} (B : IntBasis n d) : fuel B ≤ sourceFuel (basisBill B) := by
  simpa only [fuel,fastPotential_correct,sourceFuel] using logarithmic_fuel_bound B

theorem run_more_fuel {n d k : ℕ} (extra : ℕ) (B C : IntBasis n d) (h : run k B=some C) :
    run (k+extra) B=some C := by
  induction k generalizing B with
  | zero => simp [run] at h
  | succ k ih =>
    cases hs : findSwap (N0284.normalize B) with
    | none =>
      have hc : N0284.normalize B=C := by simpa only [run,hs,Option.some.injEq] using h
      simpa only [Nat.succ_add,run,hs,Option.some.injEq] using hc
    | some D =>
      have hd : run k D=some C := by simpa only [run,hs] using h
      simpa only [Nat.succ_add,run,hs] using ih D hd

theorem run_mono {n d k l : ℕ} (B C : IntBasis n d) (hkl : k ≤ l) (h : run k B=some C) : run l B=some C := by
  obtain ⟨extra,he⟩ := Nat.exists_eq_add_of_le hkl
  rw [he]
  exact run_more_fuel extra B C h

/-  The larger polynomial fuel returns exactly the same reduced basis as the
already proved materialized producer, with its full sufficient certificate. -/
theorem polynomial_fuel_producer {n d : ℕ} (B : IntBasis n d) (hB : FullRank B) :
    ∃C,produce B=some C ∧ run (sourceFuel (basisBill B)) B=some C ∧ FullRank C ∧
      SameRowLattice B C ∧ AdjacentStable C ∧ AdjacentSizeReduced C := by
  obtain ⟨C,hC,hfull,hlattice,hstable,hsize⟩ := produce_basis_adjacent B hB
  have hr : run (fuel B) B=some C := hC
  exact ⟨C,hC,run_mono B C (fuel_le_source B) hr,hfull,hlattice,hstable,hsize⟩

theorem sourceFuel_polynomial (S : ℕ) : sourceFuel S ≤ 15*(S+1)^3 := by
  unfold sourceFuel potentialExponent
  nlinarith [Nat.zero_le (S^3)]

theorem sourceFuel_word (S : ℕ) : sourceFuel S < N0282.wordBound S := by
