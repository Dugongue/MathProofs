noncomputable def polynomial {ι : Type} (f : N0090.Formula ι) : MvPolynomial ι ℚ :=
  N0090.eval₂ MvPolynomial.C MvPolynomial.X f

theorem polynomial_eval₂ {ι R : Type} [CommRing R] (c : ℚ →+* R) (env : ι → R) (f : N0090.Formula ι) :
