/-  A zero initial coefficient and a homogeneous ODE through degree N-1 force N+1 zero coefficients. -/
theorem homogeneous_ode_coeff_zero {R : Type*} [CommRing R] [Algebra ℚ R]
    (W B : R[X]) (N : ℕ) (h0 : W.coeff 0 = 0)
    (hode : (X : R[X])^N ∣ (W.derivative - B*W)) :
