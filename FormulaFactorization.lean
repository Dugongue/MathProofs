  have heq:=processed_vars r modArray σ r.e hei hev hek hej
  have hoq:=processed_vars r modArray σ r.outBase hoi hov hok hoj
  have hpq:=processed_vars r modArray σ r.p hpi hpv hpk hpj
  have hl:=processed_layout h
  have hp:σ.vars r.p<B:=by have hw:=h.arithmetic_word; nlinarith
  have hi:=initialize_run h
  have hlo : Run B (.while (.lt (.var r.i) (.var r.e)) (hornerIteration r modArray))
      (initialized r σ) (processed r modArray σ)
      ((3000*(σ.vars r.e+1)+4)*σ.vars r.e+4) := by
    simpa only [processed,hie] using hornerLoop_run (initialized_layout h) (initialized_counter r σ)
  have hf : Run B (storeLoop (finishNames r) (.get r.scratch (.var r.j)))
      (processed r modArray σ) (completed r modArray σ) (100*(σ.vars r.e+1)) := by
    have hrun:=finishAccumulator_run r (processed r modArray σ) hoj hej
      (by rw [heq]; have hs:=h.scratch_fit; have hw:=h.scratch_word; omega)
      (by rw [processed_lengths]; exact h.memory_word)
      (by rw [hoq,heq,processed_lengths]; exact h.output_fit)
      (by rw [heq,processed_lengths]; have hs:=h.scratch_fit; omega)
