/-  The ordinary polynomial derivative, regarded as a Q-linear derivation. -/
def polynomialDerivation {R : Type*} [CommRing R] [Algebra ℚ R] :
    Derivation ℚ R[X] R[X] where
  toLinearMap := (Polynomial.derivative : R[X] →ₗ[R] R[X]).restrictScalars ℚ
