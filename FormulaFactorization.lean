/-  iterate t includes orders zero through t, with product precision t+1. -/
def iterate (P : Poly) (A B : XPoly) : ℕ → Poly × Poly
  | 0 => (CPolynomial.C A,CPolynomial.C B)
  | t+1 => let z := iterate P A B t;step P A B (t+1) z.1 z.2

theorem monomial_image (q : ℕ) (U : XPoly) :
    image (CPolynomial.monomial q U)=Polynomial.monomial q U.toPoly := by
  apply Polynomial.ext
  intro i
  rw [N0365.polynomial_coeff,CPolynomial.coeff_monomial]
  by_cases h : q=i
  · subst i
    simp [Polynomial.coeff_monomial]
  · simp [Polynomial.coeff_monomial,h,Ne.symm h,CPolynomial.toPoly_zero]

theorem residual_image (P H K : Poly) (q : ℕ) :
    (residual P H K q).toPoly=(image P).coeff q-((image H)*(image K)).coeff q := by
  rw [residual,CPolynomial.toPoly_sub,← N0365.polynomial_coeff,
    ← N0365.polynomial_coeff,N0365.polynomial_mul]

