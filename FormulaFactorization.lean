/-  Execute a source-promised loop from its actually packed count/state bytes.
No membership test is computed: the source invariant is used only in the proof
of the uniform polynomial bound, and the actual finite machine is supplied. -/
theorem Realized.iterateOn {α β : Type} (ei : Encoding β) (ea : Encoding α)
    (step : α → α) (hs : Realized ea ea step)
    (count : β → ℕ) (start : β → α)
    (same : ∀ b, N0630.sourceWords ea count start b = ei.encode b)
    (p : Polynomial ℕ)
    (hp : ∀ b i, i ≤ count b → (ea.encode (step^[i] (start b))).length ≤
      p.eval (ei.encode b).length) :
    Realized ei ea (fun b => step^[count b] (start b)) := by
  have hb (b : β) (i : ℕ) (hi : i ≤ count b) :
      (ea.encode (step^[i] (start b))).length ≤
        p.eval ((Encoding.unaryNat.prod ea).encode (count b,start b)).length := by
    change (ea.encode (step^[i] (start b))).length ≤
      p.eval (N0630.sourceWords ea count start b).length
    rw [same b]
    exact hp b i hi
  obtain ⟨M,hM⟩ := N0630.finite_computer ea step hs count start p hb
  refine ⟨{ toTM2ComputableAux := M.toTM2ComputableAux
            time := M.time
            outputsFun := ?_ },hM⟩
  intro b
  rw [←same b]
  exact M.outputsFun b
end
