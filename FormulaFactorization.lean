      ⟨bank_frame fr (by decide) (by decide) hL.bank,hpost,(fr.vars _ (by decide)).trans hL.dimension,
        (fr.len _).trans hL.signLength,(fr.len _).trans hL.magnitudeLength⟩
    refine ⟨τ,hr,⟨l+1,by omega,hLτ,(fr.vars _ (by decide)).trans hI,(fr.vars _ (by decide)).trans hJ,hnext⟩,?_⟩
    simp only [V,hnext,hidx]
    change d-(l+1)<d-l
    omega
  have hI : I σ := ⟨0,by omega,by simpa only [swapPrefix_zero] using hLive,hi,hj,hc⟩
  obtain ⟨τ,hr,⟨l,hl,hL,hIτ,hJτ,hidxτ⟩,ht⟩ := Run.while_count I V 150 hdef hstep hI
  rw [hcond τ l hl hL hidxτ] at ht
  have hld : l=d := by
    have hnot : ¬l<d := by simpa using ht
    omega
  rw [hld] at hL hidxτ
  refine ⟨τ,hr.mono ?_,by simpa only [swapPrefix_full] using hL,hIτ,hJτ,hidxτ⟩
  simp only [V,hc,Cond.size,Expr.size,Nat.sub_zero]
  omega

theorem swapProgram_run {W n d H : ℕ} (σ : Env) (A : RectData n d) (i j : Fin n) (hij : i≠j)
    (hLive : LiveBasis σ A) (hi : σ.vars swapI=i.val) (hj : σ.vars swapJ=j.val)
    (hA : RectBound A H) (hW : n*d<W) (hW3 : 3≤W) (hH : H<W) :
