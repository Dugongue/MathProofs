/-  A literal C(S+1)^k bound with constants independent of S. -/
def PolynomialBound (f : ℕ → ℕ) : Prop := ∃ C k : ℕ, ∀ S, f S ≤ C*(S+1)^k

 theorem polynomial_const (c : ℕ) : PolynomialBound (fun _ => c) := by
  exact ⟨c,0,fun S => by simp⟩

 theorem polynomial_id : PolynomialBound (fun S => S) := by
  exact ⟨1,1,fun S => by simp⟩

 theorem polynomial_add {f g : ℕ → ℕ} (hf : PolynomialBound f) (hg : PolynomialBound g) :
    PolynomialBound (fun S => f S+g S) := by
  obtain ⟨C,k,hf⟩ := hf
  obtain ⟨D,l,hg⟩ := hg
  refine ⟨C+D,k+l,?_⟩
  intro S
  have hfk := (hf S).trans (Nat.mul_le_mul_left C
    (Nat.pow_le_pow_right (by omega : 0 < S+1) (Nat.le_add_right k l)))
  have hgl := (hg S).trans (Nat.mul_le_mul_left D
    (Nat.pow_le_pow_right (by omega : 0 < S+1) (Nat.le_add_left l k)))
  simpa only [Nat.add_mul] using Nat.add_le_add hfk hgl

 theorem polynomial_mul {f g : ℕ → ℕ} (hf : PolynomialBound f) (hg : PolynomialBound g) :
    PolynomialBound (fun S => f S*g S) := by
  obtain ⟨C,k,hf⟩ := hf
  obtain ⟨D,l,hg⟩ := hg
  refine ⟨C*D,k+l,?_⟩
  intro S
  have h := Nat.mul_le_mul (hf S) (hg S)
  simpa only [pow_add, Nat.mul_assoc, Nat.mul_left_comm, Nat.mul_comm] using h

 theorem polynomial_le {f g : ℕ → ℕ} (hg : PolynomialBound g) (hfg : ∀ S, f S ≤ g S) :
    PolynomialBound f := by
  obtain ⟨C,k,hg⟩ := hg
  exact ⟨C,k,fun S => (hfg S).trans (hg S)⟩

