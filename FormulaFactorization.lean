/-  Cauchy plus the positive integer prefix-volume gap bounds every initial ratio. -/
theorem initial_ratio_square {n d} (B : IntBasis n d) (hB : FullRank B) (i j : Fin n) (hji : j < i) :
    (ratio B i j)^2 ≤ (potential B:ℝ)*‖N0297.rows B i‖^2 := by
  have hPhi : 0 ≤ (potential B:ℝ) := by exact_mod_cast (potential_pos B hB).le
  have hg := gsSquare_bounds B hB j
  have hgj : 0 < gsSquare B j := by
    by_contra h
    have hn := mul_nonpos_of_nonneg_of_nonpos hPhi (le_of_not_gt h)
    linarith [hg.2]
  have hinner : ⟪gramSchmidt ℝ (N0297.rows B) j,
      N0297.rows B i⟫_ℝ=ratio B i j*gsSquare B j := by
    rw [ratio_eq_coefficient B hB i j hji]
    unfold N0297.coefficient gsSquare
    exact (div_mul_cancel₀ _ (ne_of_gt hgj)).symm
  have hcs := abs_real_inner_le_norm (gramSchmidt ℝ (N0297.rows B) j)
    (N0297.rows B i)
  have hsq : (ratio B i j*gsSquare B j)^2 ≤
      gsSquare B j*‖N0297.rows B i‖^2 := by
    rw [← hinner]
    have hp := mul_nonneg (sub_nonneg.mpr hcs)
      (add_nonneg (mul_nonneg
        (norm_nonneg (gramSchmidt ℝ (N0297.rows B) j))
        (norm_nonneg (N0297.rows B i)))
        (abs_nonneg ⟪gramSchmidt ℝ (N0297.rows B) j,
          N0297.rows B i⟫_ℝ))
    dsimp only [gsSquare]
    nlinarith [sq_abs ⟪gramSchmidt ℝ (N0297.rows B) j,
      N0297.rows B i⟫_ℝ]
  have hquot : (ratio B i j)^2*gsSquare B j ≤ ‖N0297.rows B i‖^2 := by
    apply (mul_le_mul_iff_right₀ hgj).mp
    nlinarith [hsq]
  have hm := mul_le_mul_of_nonneg_left hquot hPhi
  have hl := mul_nonneg (sq_nonneg (ratio B i j)) (by linarith : 0 ≤ (potential B:ℝ)*gsSquare B j-1)
  nlinarith

theorem initial_ratio_abs {n d} (B : IntBasis n d) (hB : FullRank B) (i j : Fin n) (hji : j < i) :
    |ratio B i j| ≤ (potential B:ℝ)*‖N0297.rows B i‖^2+1 := by
