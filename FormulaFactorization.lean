  have hs : s=0 ∨ s=1 := by omega
  rcases hs with rfl|rfl
  · change ((m/D:ℕ):ℤ)=(m:ℤ)/(D:ℤ)
    rfl
  · cases m with
    | zero => simp [signedDivPos,zval,zero]
    | succ m =>
      change -((m/D+1:ℕ):ℤ)=Int.negSucc m/(D:ℤ)
      rw [Int.negSucc_ediv m (by exact_mod_cast hD)]
      simp only [Int.natCast_add,Int.natCast_one,Int.natCast_ediv] <;> rfl











