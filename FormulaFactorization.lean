      refine ⟨m + 1, by omega, ?_⟩
      rw [hpos m (by omega)]
      refine Fin.addCases (fun i => ?_) (fun i => ?_) l <;>
        simp only [pairIdx_castAdd, pairIdx_natAdd, Fin.append_left, Fin.append_right]
