theorem hornerIteration_run {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulLayout r modArray B σ) (hi : σ.vars r.i<σ.vars r.e) :
    Run B (hornerIteration r modArray) σ (iterEnd r modArray σ) (3000*(σ.vars r.e+1)) := by
