def prefixSum {n : ℕ} (f : Fin n → ℕ) (k : ℕ) := ∑ i : Fin n, if i.val < k then f i else 0

theorem prefixSum_zero {n : ℕ} (f : Fin n → ℕ) : prefixSum f 0=0 := by simp [prefixSum]
theorem prefixSum_full {n : ℕ} (f : Fin n → ℕ) : prefixSum f n=∑ i,f i := by simp [prefixSum]
theorem prefixSum_le {n : ℕ} (f : Fin n → ℕ) (k : ℕ) : prefixSum f k ≤ ∑ i,f i := by
  apply Finset.sum_le_sum
  intro i hi
  split_ifs <;> omega

theorem prefixSum_step {n k : ℕ} (f : Fin n → ℕ) (hk : k < n) :
    prefixSum f (k+1)=prefixSum f k+f ⟨k,hk⟩ := by
  have he (i : Fin n) : (if i.val < k+1 then f i else 0)=(if i.val < k then f i else 0)+(if i=⟨k,hk⟩ then f i else 0) := by
    by_cases hi : i=⟨k,hk⟩
    · subst i; simp
    · have hne : i.val ≠ k := by intro h; exact hi (Fin.ext h)
      by_cases hl : i.val < k <;> simp [hi,hl,show (i.val < k+1) ↔ (i.val < k) by omega]
  simp only [prefixSum,he,Finset.sum_add_distrib]
  simp

def entryBill {n d : ℕ} (A : RectData n d) (i : Fin n) (j : Fin d) := (A i j).magnitude.size+1
def rowsBill {n d : ℕ} (A : RectData n d) (k : ℕ) := prefixSum (fun i=>∑j,entryBill A i j) k
def partialBill {n d : ℕ} (A : RectData n d) (i : Fin n) (k : ℕ) := n+d+1+rowsBill A i.val+prefixSum (entryBill A i) k

theorem rowsBill_full {n d : ℕ} (A : RectData n d) : n+d+1+rowsBill A n=basisBill (rectValue A) := by
  simp only [rowsBill,prefixSum_full,entryBill,magnitude_eq_abs,basisBill,rectValue]

theorem partialBill_bound {n d : ℕ} (A : RectData n d) (i : Fin n) (k : ℕ) : partialBill A i k ≤ basisBill (rectValue A) := by
  have hc := prefixSum_le (entryBill A i) k
  have hs : prefixSum (fun r=>∑j,entryBill A r j) (i.val+1)=prefixSum (fun r=>∑j,entryBill A r j) i.val+∑j,entryBill A i j := prefixSum_step _ i.isLt
  have hr := prefixSum_le (fun r=>∑j,entryBill A r j) (i.val+1)
  have hall := rowsBill_full A
  unfold partialBill rowsBill at *
  rw [prefixSum_full] at hall
  omega

