  have hei:r.e≠r.i:=by tauto
  have hev:r.e≠r.value:=by tauto
  have hek:r.e≠r.k:=by tauto
  have hej:r.e≠r.j:=by tauto
  have hoi:r.outBase≠r.i:=by tauto
  have hov:r.outBase≠r.value:=by tauto
  have hok:r.outBase≠r.k:=by tauto
  have hoj:r.outBase≠r.j:=by tauto
  have hpi:r.p≠r.i:=by tauto
  have hpv:r.p≠r.value:=by tauto
  have hpk:r.p≠r.k:=by tauto
  have hpj:r.p≠r.j:=by tauto
