      (auxiliaryPolynomial env f).eval (algebraMap ℚ R (i : ℚ)) := by
  induction f with
  | const q =>
      change algebraMap ℚ R q =
        (Polynomial.C (algebraMap ℚ R q)).eval (algebraMap ℚ R (i : ℚ))
