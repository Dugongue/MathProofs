theorem pairLoop_run {W n : ℕ} (σ : Env) (w : Fin n → Signed)
    (ha : VectorArrays σ w) (hi : σ.vars writerIndex=0) (hn : σ.vars nVar=n)
    (hnW : n < W) (hW3 : 3 ≤ W) (hmag : ∀q,(w q).magnitude < W) :
    ∃τ,Run W pairLoop σ τ (24*n+4) ∧ τ.out=σ.out++(signedPairs w).flatten := by
  have hlen : (signedPairs w).length=n := List.length_ofFn
  apply wp.run
  refine wp_for_var n 20
    (fun l ρ=>ρ.out=σ.out++((signedPairs w).take l).flatten)
    hnW hi hn (by decide) ?_ ?_ ?_
  · simp
  · intro l hln ρ hout hidx fr
    let q : Fin n := ⟨l,hln⟩
    have hs : (ρ.arrs kernelS)[l]?=some (w q).sign := by
      rw [fr.arrs _ (by decide)]
      exact (ha q).1
    have hm : (ρ.arrs kernelN)[l]?=some (w q).magnitude := by
      rw [fr.arrs _ (by decide)]
      exact (ha q).2
    refine vc_spec (pairBody_run ρ (w q) l hidx hs hm (by omega) (hmag q) hW3) ?_
    rintro τ k ⟨hiτ,hoτ⟩ _ hk
    have hp : (signedPairs w).take (l+1)=
        (signedPairs w).take l++[N0304.pairWords (w q)] := by
      have ht := List.take_concat_get' (signedPairs w) l (by rw [hlen];exact hln)
      simpa only [signedPairs,List.getElem_ofFn] using ht.symm
    refine ⟨?_,hiτ,hk⟩
    rw [hoτ,hout,hp,List.flatten_append]
    simp [List.append_assoc]
  · intro τ k hout hidx fr hk
    refine ⟨hk,?_⟩
    simpa only [←hlen,List.take_length] using hout

theorem someWriter_run {W n : ℕ} (σ : Env) (w : Fin n → Signed)
    (ha : VectorArrays σ w) (hn : σ.vars nVar=n)
    (hnW : n < W) (hW3 : 3 ≤ W) (hmag : ∀q,(w q).magnitude < W) :
    ∃τ,Run W someWriter σ τ (40*(n+1)) ∧
      τ.out=σ.out++([1,n]++(signedPairs w).flatten) := by
  let σ1 : Env := {σ with out:=σ.out++[1]}
  let σ2 : Env := {σ1 with out:=σ1.out++[n]}
  let ρ := σ2.setVar writerIndex 0
  have r1 : Run W (.write (.lit 1)) σ σ1 2 := Run.write (evalB_lit (by omega))
  have r2 : Run W (.write (.var nVar)) σ1 σ2 2 :=
    Run.write (evalB_var_iff.mpr ⟨hn.symm,by change σ.vars nVar < W;rw [hn];exact hnW⟩)
  have r0 : Run W (.assign writerIndex (.lit 0)) σ2 ρ 2 :=
    Run.assign (evalB_lit (by omega))
  have rr := r1.seq (r2.seq r0)
  have fr := Frame.of_run rr
  have haρ : VectorArrays ρ w := by
    intro q
    rw [fr.arrs _ (by decide),fr.arrs _ (by decide)]
    exact ha q
  have hnρ : ρ.vars nVar=n := (fr.vars _ (by decide)).trans hn
  obtain ⟨τ,rl,ho⟩ := pairLoop_run ρ w haρ (by simp [ρ,Env.setVar]) hnρ hnW hW3 hmag
  refine ⟨τ,(r1.seq (r2.seq (r0.seq rl))).mono (by omega),?_⟩
  rw [ho]
  simp [ρ,σ1,σ2,Env.setVar,List.append_assoc]

theorem writer_run {W n : ℕ} (σ : Env) (o : Option (Fin n → ℤ))
    (hn : σ.vars nVar=n) (hr : KernelResult σ o)
    (hnW : n < W) (hW3 : 3 ≤ W)
    (hmag : ∀v,o=some v → ∀q,(v q).natAbs < W) :
    ∃τ,Run W writer σ τ (60*(n+1)) ∧ τ.out=σ.out++resultWords o := by
  cases o with
  | none =>
    have hf : σ.vars kernelFound=0 := hr
    let τ : Env := {σ with out:=σ.out++[0]}
    have ec : (Cond.eq (.var kernelFound) (.lit 0)).evalB W σ=some true := by
      simpa using evalB_condEq
        (evalB_var_iff.mpr ⟨hf.symm,by rw [hf];omega⟩) (evalB_lit (by omega : 0 < W))
    have rw0 : Run W (.write (.lit 0)) σ τ 2 := Run.write (evalB_lit (by omega))
    refine ⟨τ,(Run.ite_true ec rw0).mono ?_,rfl⟩
    simp [Cond.size,Expr.size]
    omega
  | some v =>
    obtain ⟨hf,w,ha,hv⟩ := hr
    have hm : ∀q,(w q).magnitude < W := by
      intro q
      rw [magnitude_eq_abs,congrFun hv q]
      exact hmag v rfl q
    obtain ⟨τ,rw0,ho⟩ := someWriter_run σ w ha hn hnW hW3 hm
    have ec : (Cond.eq (.var kernelFound) (.lit 0)).evalB W σ=some false := by
      simpa using evalB_condEq
        (evalB_var_iff.mpr ⟨hf.symm,by rw [hf];omega⟩) (evalB_lit (by omega : 0 < W))
    refine ⟨τ,(Run.ite_false ec rw0).mono ?_,?_⟩
    · simp only [Cond.size,Expr.size]
      omega
    · rw [ho,signedPairs_value,hv]
      rfl

theorem result_magnitude {n d : ℕ} (A : RectData n d) (v : Fin n → ℤ)
    (hv : result A=some v) (q : Fin n) :
