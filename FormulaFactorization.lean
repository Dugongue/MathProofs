/-! ## Literal PIT/numeric backend adapter

The backend contains actual cut polynomials, actual complete numeric line
factor lists, and atomic exact divisibility decisions. The separate validity
record states polynomial identities and irreducibility of these numeric lists;
it does not assert that such a backend runs in polynomial time. -/

abbrev NumericPolynomial := N0625.NumericPolynomial
abbrev Coefficients := N0088.Coefficients

structure LineData {r : ℕ} (g : Fin r → ℚ[X]) where
  count : ℕ
  factor : Fin count → Polynomial ℚ[X]
  multiplicity : Fin count → ℕ
  atomic : ∀ i j, Decidable (g i ∣ (factor j).coeff 0)

def LineData.labels {r : ℕ} {g : Fin r → ℚ[X]} (data : LineData g) : Labels r :=
  Partition.mergeEdges (N0258.identityLabels r)
    (((List.finRange r).product (List.finRange r)).filter (fun pair =>
      (List.finRange data.count).any (fun j =>
        @decide _ (data.atomic pair.1 j) && @decide _ (data.atomic pair.2 j))))

theorem LineData.labels_eq {r : ℕ} {g : Fin r → ℚ[X]} (data : LineData g) :
    data.labels = @N0258.computedLabels ℚ inferInstance r data.count g
      (fun j => (data.factor j).coeff 0) data.atomic := rfl

