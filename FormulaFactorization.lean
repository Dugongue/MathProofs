theorem height_mono (n M : ℕ) {t u : ℕ} (htu : t≤u) :
    N0287.height n M t≤N0287.height n M u := by
  unfold N0287.height
  exact Nat.mul_le_mul_left M (Nat.pow_le_pow_right (N0287.radix_bounds n M).1 htu)

theorem determinant_magnitude_bound {n M : ℕ} (A : Data n) (hA : DataBound A M) (hM : 1≤M) :
    (determinantSigned A).magnitude≤N0287.height n M n := by
  cases n with
