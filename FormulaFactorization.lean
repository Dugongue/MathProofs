  have hh := N0274.entry_spec e
    (N0387.test (CyclotomicRing.dimension e) N (a.val : CyclotomicRing.R e))
    (integerTest N e (a.val : ℤ) (x 0 : ℤ)) (x 0 : ℤ) (x 1 : ℤ) (x 2 : ℤ)
