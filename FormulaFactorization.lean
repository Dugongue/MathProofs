    simp [τ,σ2,σ1,vars_setVar,show kq.WS≠uw.nR by decide,show kq.WS≠uw.mR by decide]
  refine ⟨τ,hrun,header_of_slots p Sn W τ hslots ?_,?_,?_,hw,fun _=>rfl,rfl,rfl⟩
  · simpa [τ,σ2,σ1,vars_setVar,show nq.WS≠kq.WS by decide,show nq.WS≠uw.nR by decide,show nq.WS≠uw.mR by decide] using hw
  · simp [τ,σ2,σ1,vars_setVar,show uw.nR≠uw.mR by decide]
  · simp [τ,σ2,σ1]

/-  The literal loader, header assignments and genuine Gaussian kernel source. -/
theorem caller_run (p Sn W n : ℕ) [Fact p.Prime]
    (A : Matrix (Fin n) (Fin (n-1)) (ZMod p)) (σ : Env)
    (hs : Slots (presentation p) canonical nq.WS Sn W σ)
    (hn : σ.vars degreeRegister=n) (hpos : 2≤n)
    (hfit : 5+n*(n-1)≤Sn)
    (hbank : n*N0178.bankSize n (n-1)≤Sn)
    (hlen : n*(n-1)≤(σ.arrs matrixArray).length)
    (hlenW : (σ.arrs matrixArray).length<W)
    (hA : ∀t : Fin n,∀i : Fin (n-1),
      (σ.arrs matrixArray).getD (i.val*n+t.val) 0=(A t i).val) :
    ∃τ,Run W callerProgram σ τ
        (100*(n*(n-1)+1)+10+50000000000*(p.size+1)*(n+(n-1)+2)^4) ∧
      Slots (presentation p) canonical kq.WS Sn W τ ∧
      (N0178.output n (n-1) τ=none ↔ ∀x,A.mulVec x=0→x=0) ∧
      (∀v,N0178.output n (n-1) τ=some v →
        v.size=n-1 ∧ N0178.vector p (n-1) v≠0 ∧
        A.mulVec (N0178.vector p (n-1) v)=0) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hcanon : ∀k<n*(n-1),(σ.arrs matrixArray).getD k 0<p := by
    intro k hk
    have hi : k/n<n-1 := (Nat.div_lt_iff_lt_mul (by omega)).mpr (by nlinarith only [hk])
    have ht : k%n<n := Nat.mod_lt _ (by omega)
    have he : (k/n)*n+k%n=k := by simpa only [Nat.mul_comm] using Nat.div_add_mod k n
    rw [←he,hA ⟨k%n,ht⟩ ⟨k/n,hi⟩]
    exact ZMod.val_lt _
  obtain ⟨ξ,hload,hξ,hvalues,hvars,harray,hin,hout⟩ := load_run p Sn W n σ hs hn hpos hfit hlen hlenW hcanon
  have hnξ : ξ.vars degreeRegister=n := (hvars _ (by decide)).trans hn
  have hnW : n<W := by
    have hle : n≤n*(n-1) := Nat.le_mul_of_pos_right _ (by omega)
    omega
  obtain ⟨ζ,hsetup,hheader,hnζ,hmζ,hbase,harr,hins,houts⟩ := setup_run p Sn W n ξ hξ hnξ hnW
  have hmat : ∀t : Fin n,∀i : Fin (n-1),
      memory ζ (ζ.vars kq.WS+5+i.val*n+t.val)=(A t i).val := by
    intro t i
    have hk : i.val*n+t.val<n*(n-1) := by
      calc
        i.val*n+t.val < i.val*n+n := Nat.add_lt_add_left t.isLt _
        _ = (i.val+1)*n := by ring
        _ ≤ (n-1)*n := Nat.mul_le_mul_right n i.isLt
        _ = _ := by ring
    change (ζ.arrs canonical.mem).getD _ 0=_
    rw [harr canonical.mem,hbase,show ξ.vars nq.WS+5+i.val*n+t.val=ξ.vars nq.WS+5+(i.val*n+t.val) by omega]
    exact (hvalues _ hk).trans (hA t i)
  have hfit' : ((n-1)+1)*Internal.N0339.N0524.blockSize n (n-1)≤Sn := by
    have he : n-1+1=n := by omega
    simpa only [he,N0178.bankSize_eq] using hbank
  obtain ⟨τ,hkernel,ht,hnone,hsome,hflag,hbank',hbase',harrays,hi,ho⟩ :=
    N0178.program_run p Sn W n (n-1) A ζ hheader hnζ hmζ hfit' hmat
  refine ⟨τ,?_,ht,hnone,hsome,hi.trans (hins.trans hin),ho.trans (houts.trans hout)⟩
  simpa only [callerProgram,Nat.add_assoc] using hload.seq (hsetup.seq hkernel)

/-  Row reversal is an actual storage convention, with no matrix input oracle. -/
noncomputable def matrix (p n : ℕ) [Fact p.Prime] (f : CPolynomial (ZMod p)) : Matrix (Fin n) (Fin (n-1)) (ZMod p) :=
  fun t i=>(N0177.column f i.val).toPoly.coeff (n-1-t.val)

/-  One fixed program constructs the matrix from original coefficients and
executes the kernel; neither the matrix nor a kernel vector is supplied. -/
def program : Com := .seq N0179.program callerProgram

theorem program_run (p Sn W n M b c r : ℕ) [Fact p.Prime]
    (f : CPolynomial (ZMod p)) (σ : Env)
    (hs : Slots (presentation p) canonical nq.WS Sn W σ) (hparams : Parameters n M b c σ)
    (hr : σ.vars N0179.rawRegister=r)
    (hM : M=p*n+1) (hfdeg : f.natDegree=n) (hpos : 2≤n) (hf : f.toPoly.Monic)
    (hwork : 5+4*M≤Sn) (hbafter : 5+4*M≤b) (hcafter : 5+4*M≤ c)
    (hbfit : b+M≤ c) (hfit : c+M≤ r) (hrawfit : r+(n+1)≤Sn)
    (hkernel : 5+n*(n-1)≤Sn)
    (hbank : n*N0178.bankSize n (n-1)≤Sn)
    (harray : n*(n-1)≤(σ.arrs matrixArray).length) (harrayW : (σ.arrs matrixArray).length<W)
    (hraw : ∀i<n+1,val (presentation p) canonical nq.WS σ (r+i)=f.toPoly.coeff i) :
    ∃τ,Run W program σ τ
        (10000*(M+n+2)+N0180.matrixCost p n M+
          (100*(n*(n-1)+1)+10+50000000000*(p.size+1)*(n+(n-1)+2)^4)) ∧
      Slots (presentation p) canonical kq.WS Sn W τ ∧
      (N0178.output n (n-1) τ=none ↔
        ∀x,(matrix p n f).mulVec x=0→x=0) ∧
      (∀v,N0178.output n (n-1) τ=some v →
        v.size=n-1 ∧ N0178.vector p (n-1) v≠0 ∧
        (matrix p n f).mulVec (N0178.vector p (n-1) v)=0) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  obtain ⟨ξ,hmatrix,hξ,hpar,hvalues,hfkeep,hin,hout⟩ :=
    N0179.program_run p Sn W n M b c r f σ hs hparams hr hM hfdeg hpos hf
      hwork hbafter hcafter hbfit hfit hrawfit harray harrayW hraw
  have hlength := (run_frame hmatrix).2.2.1 matrixArray
  obtain ⟨τ,hcall,ht,hnone,hsome,hi,ho⟩ := caller_run p Sn W n (matrix p n f) ξ hξ hpar.degree hpos hkernel hbank
    (by rw [hlength];exact harray) (by rw [hlength];exact harrayW) (fun t i=>hvalues _ i.isLt _ t.isLt)
  exact ⟨τ,hmatrix.seq hcall,ht,hnone,hsome,hi.trans hin,ho.trans hout⟩

/-  A literal polynomial decoding of the actual natural output coefficient array. -/
def decodedPolynomial (p : ℕ) [Fact p.Prime] (v : Array ℕ) : CPolynomial (ZMod p) :=
  N0177.decode (v.map (fun a : ℕ=>(a : ZMod p)))

theorem decoded_coefficient (p : ℕ) [Fact p.Prime] (f : CPolynomial (ZMod p))
    (hf : f.toPoly.Monic) (v : Array ℕ) (hv : v.size=f.natDegree-1)
    (t : Fin f.natDegree) :
    (N0176.residueLinear f.toPoly (decodedPolynomial p v).toPoly).coeff
        (f.natDegree-1-t.val)=
      (matrix p f.natDegree f).mulVec (N0178.vector p (f.natDegree-1) v) t := by
  rw [decodedPolynomial,N0177.matrix_coefficient f hf _ (by simpa using hv)
    _ (by omega),N0177.dotRow_sum]
  change (∑ j : Fin (f.natDegree-1),_)=_
  simp only [Matrix.mulVec,dotProduct,matrix]
  apply Finset.sum_congr rfl
  intro j _
  rw [N0177.fixedMatrix_get f _ j.val (by omega) j.isLt]
  rw [CPolynomial.coeff_toPoly]
  simp [N0178.vector,Array.getD,show j.val<v.size by omega]

theorem output_fixed (p : ℕ) [Fact p.Prime] (f : CPolynomial (ZMod p))
    (hf : f.toPoly.Monic) (hpos : 0<f.natDegree) (v : Array ℕ)
    (hv : v.size=f.natDegree-1)
    (hne : N0178.vector p (f.natDegree-1) v≠0)
    (hnull : (matrix p f.natDegree f).mulVec (N0178.vector p (f.natDegree-1) v)=0) :
    decodedPolynomial p v≠0 ∧ (decodedPolynomial p v).coeff 0=0 ∧
      (decodedPolynomial p v).toPoly.degree<(f.natDegree : WithBot ℕ) ∧
      f.toPoly∣(decodedPolynomial p v).toPoly^p-(decodedPolynomial p v).toPoly := by
  have hnonzero : Internal.N0048.DenseMatrix.NonzeroVector (v.map (fun a : ℕ=>(a : ZMod p))) := by
    obtain ⟨i,hi⟩ := Function.ne_iff.mp hne
    refine ⟨i.val,by simp [hv,i.isLt],?_⟩
    simpa [N0178.vector,Array.getD,show i.val<v.size by omega] using hi
  refine ⟨N0177.decode_nonzero _ hnonzero,
    N0177.decode_coeff_zero _,
    N0177.decode_degree f _ hpos (by simpa using hv),?_⟩
  apply (N0176.residue_zero_iff _ _ hf).mp
  apply Polynomial.ext
  intro i
  rw [Polynomial.coeff_zero]
  by_cases hi : i<f.natDegree
  · have ht : f.natDegree-1-(f.natDegree-1-i)=i := by omega
    have hh := decoded_coefficient p f hf v hv (⟨f.natDegree-1-i,by omega⟩ : Fin f.natDegree)
    rw [ht,hnull] at hh
    exact hh
  · have hd : (N0176.residueLinear f.toPoly (decodedPolynomial p v).toPoly).degree<
        (f.natDegree : WithBot ℕ) := by
      simpa only [N0176.residueLinear_apply,Polynomial.degree_eq_natDegree hf.ne_zero,
        ← CPolynomial.natDegree_toPoly] using
        Polynomial.degree_modByMonic_lt ((decodedPolynomial p v).toPoly^p-(decodedPolynomial p v).toPoly) hf
    exact (Polynomial.degree_lt_iff_coeff_zero _ _).mp hd i (by omega)

/-  The full caller cost remains polynomial in p VALUE and degree. -/
theorem total_budget (p n M : ℕ) :
    10000*(M+n+2)+N0180.matrixCost p n M+
      (100*(n*(n-1)+1)+10+50000000000*(p.size+1)*(n+(n-1)+2)^4) ≤
        10000000000000000*(p.size+1)*(M+n+2)^4 := by
  let T := M+n+2
  let P := p.size+1
  have hT : 1≤T := by dsimp [T];omega
  have hP : 1≤P := by dsimp [P];omega
  have hn : n≤T := by dsimp [T];omega
  have hsize : n+(n-1)+2≤2*T := by dsimp [T];omega
  have hkernel := Nat.pow_le_pow_left hsize 4
  have hsmall : n*(n-1)≤T^2 := by nlinarith only [Nat.mul_le_mul hn (Nat.sub_le n 1 |>.trans hn)]
  have hpow : T^2≤T^4 := Nat.pow_le_pow_right hT (by decide)
  have hscale : T^4≤P*T^4 := Nat.le_mul_of_pos_left _ hP
  have hunit : 1≤P*T^4 := by
    have hpos : 0<P*T^4 := by positivity
    omega
  have hinput := N0179.total_budget p n M
  change 10000*T+N0180.matrixCost p n M+
    (100*(n*(n-1)+1)+10+50000000000*P*(n+(n-1)+2)^4) ≤ 10000000000000000*P*T^4
