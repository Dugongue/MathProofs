      ∃(τ : Env)(C : RectData n d),
        Run (N0282.wordBound S) normalizeLoop σ τ ((normalizeStepTime n d+4)*xs.length+4) ∧
        LiveBasis τ C ∧ τ.vars shearI=n ∧ rectValue C=normalizeList B (left++xs) := by
