/-  Two macro packages with the same eight programs. -/
structure CodeEq (M₁ : FieldMacros F₁ r) (M₂ : FieldMacros F₂ r) : Prop where
  copy : M₁.copy = M₂.copy
  add : M₁.add = M₂.add
  neg : M₁.neg = M₂.neg
  sub : M₁.sub = M₂.sub
  mul : M₁.mul = M₂.mul
  inv : M₁.inv = M₂.inv
  pow : M₁.pow = M₂.pow
  eq : M₁.eq = M₂.eq

/-  The concrete packages of any two presentations have the same code. -/
theorem fieldMacros_codeEq (F₁ : FieldPresentation K₁) (F₂ : FieldPresentation K₂) :
    CodeEq (fieldMacros F₁) (fieldMacros F₂) :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

