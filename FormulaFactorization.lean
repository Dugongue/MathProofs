lemma coeff_bound (a : ℤ) (w M k j : ℕ) (hw : 1 ≤ w) (ha : |a| ≤ w) (hk : k ≤ M) :
    |(((X + C a) ^ k : ℤ[X]).coeff j)| ≤ (2 * w : ℤ) ^ M := by
  rw [coeff_X_add_C_pow, abs_mul, abs_pow, Int.abs_natCast]
  have hw' : (1 : ℤ) ≤ w := by exact_mod_cast hw
