  have hr : Realized rawEncoding Encoding.bits rawEncoding.encode :=
    Realized.view rawEncoding Encoding.bits rawEncoding.encode (fun _ => rfl)
  have hp := ((Realized.const rawEncoding Encoding.bits (Encoding.frame [])).pair hr).comp
    Realized.raw_append
  have hi := hp.pair (Realized.const rawEncoding Encoding.bits [])
  have hv := (Realized.const rawEncoding Encoding.bits []).pair hi
