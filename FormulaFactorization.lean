    (hU : U.degree<A.degree) (hV : V.degree<B.degree) :
    (U*B+V*A).degree<A.degree+B.degree := by
  apply (Polynomial.degree_add_le _ _).trans_lt
  apply max_lt
  · exact correction_term_degree A B U hA hB hU
  · simpa only [add_comm] using correction_term_degree B A V hB hA hV

