  have hs3 : Slots (presentation p) canonical q.WS Sn W σ3 :=
    Slots.setVar (presentation p) canonical hs2 (by decide) (by decide) _
  have hval : ∀s,val (presentation p) canonical q.WS σ3 s=val (presentation p) canonical q.WS σ s := by
    intro s
    rw [val_setVar (presentation p) canonical (by decide : activeRegister ≠ q.WS),
      val_setVar (presentation p) canonical (by decide : polynomialAddress ≠ q.WS),
      val_setVar (presentation p) canonical (by decide : numeratorAddress ≠ q.WS)]
