def RationalBound (B : ℕ) (q : ℚ) : Prop := q.num.natAbs ≤ 2 ^ B ∧ q.den ≤ 2 ^ B

theorem rationalBound_add (q r : ℚ) (B C : ℕ) (hq : RationalBound B q) (hr : RationalBound C r) :
    RationalBound (B + C + 1) (q + r) := by
  have hd : (q.den : ℤ) * r.den ≠ 0 := mul_ne_zero (by exact_mod_cast q.den_nz) (by exact_mod_cast r.den_nz)
  have hb := N0206.rational_reduction_bounds (q + r) _ _ hd (Rat.add_num_den q r)
  have hnum : (q.num * r.den + q.den * r.num : ℤ).natAbs ≤ 2 ^ (B + C + 1) := by
    calc
      _ ≤ q.num.natAbs * r.den + q.den * r.num.natAbs := by
        simpa only [Int.natAbs_mul, Int.natAbs_natCast] using
          Int.natAbs_add_le (q.num * r.den) (q.den * r.num)
      _ ≤ 2 ^ B * 2 ^ C + 2 ^ B * 2 ^ C :=
        Nat.add_le_add (Nat.mul_le_mul hq.1 hr.2) (Nat.mul_le_mul hq.2 hr.1)
      _ = _ := by rw [pow_add, pow_succ]; ring
  refine ⟨hb.1.trans hnum, hb.2.trans ?_⟩
  simp only [Int.natAbs_mul, Int.natAbs_natCast]
  calc q.den * r.den ≤ 2 ^ B * 2 ^ C := Nat.mul_le_mul hq.2 hr.2
       _ ≤ 2 ^ (B + C + 1) := by rw [← pow_add, pow_succ]; omega

theorem rationalBound_mul (q r : ℚ) (B C : ℕ) (hq : RationalBound B q) (hr : RationalBound C r) :
    RationalBound (B + C) (q * r) := by
  have hd : (q.den : ℤ) * r.den ≠ 0 := mul_ne_zero (by exact_mod_cast q.den_nz) (by exact_mod_cast r.den_nz)
  have he : q * r = Rat.divInt (q.num * r.num) ((q.den : ℤ) * r.den) := by
    rw [Rat.divInt_eq_div]
    push_cast
    rw [← div_mul_div_comm, Rat.num_div_den, Rat.num_div_den]
  have hb := N0206.rational_reduction_bounds (q * r) _ _ hd he
  constructor
  · exact hb.1.trans (by simpa only [Int.natAbs_mul, pow_add] using Nat.mul_le_mul hq.1 hr.1)
  · exact hb.2.trans (by simpa only [Int.natAbs_mul, Int.natAbs_natCast, pow_add] using Nat.mul_le_mul hq.2 hr.2)

