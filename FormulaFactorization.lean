abbrev NumericPolynomial := CPolynomial ℚ

def commonDen (P : NumericPolynomial) : ℕ :=
  ∏ i ∈ Finset.range (P.natDegree+1), (P.coeff i).den

theorem commonDen_pos (P : NumericPolynomial) : 0 < commonDen P := by
  unfold commonDen
  exact Finset.prod_pos (fun i _ => Rat.den_pos _)

theorem coefficient_den_dvd (P : NumericPolynomial) (i : ℕ) :
    (P.coeff i).den ∣ commonDen P := by
  by_cases hi : i ≤ P.natDegree
  · exact Finset.dvd_prod_of_mem (fun i => (P.coeff i).den) (Finset.mem_range.mpr (by omega))
  · have hz : P.coeff i = 0 := by
      rw [CPolynomial.coeff_toPoly]
      exact Polynomial.coeff_eq_zero_of_natDegree_lt
        (by simpa only [CPolynomial.natDegree_toPoly] using Nat.lt_of_not_ge hi)
    simp [hz]

theorem integer_mul_of_den_dvd (q : ℚ) (D : ℕ) (h : q.den ∣ D) :
    ∃ z : ℤ, (z : ℚ) = q*(D : ℚ) := by
  obtain ⟨k,hk⟩ := h
  refine ⟨q.num*k, ?_⟩
  have hq : q*(q.den : ℚ) = (q.num : ℚ) := by
    have hdq : (q.den : ℚ) ≠ 0 := by exact_mod_cast q.den_ne_zero
    calc
      q*(q.den : ℚ) = ((q.num : ℚ)/(q.den : ℚ))*(q.den : ℚ) :=
        congrArg (fun x : ℚ => x*(q.den : ℚ)) q.num_div_den.symm
      _ = _ := div_mul_cancel₀ _ hdq
  rw [hk, Nat.cast_mul, ← mul_assoc, hq]
  simp

theorem scaled_input_lifts (P : NumericPolynomial) (hP : P.toPoly.Monic) :
    ∃ A : ℤ[X], A.Monic ∧ A.map (Int.castRingHom ℚ) =
      P.toPoly.scaleRoots (commonDen P : ℚ) := by
  have hl : P.toPoly.scaleRoots (commonDen P : ℚ) ∈ Polynomial.lifts (Int.castRingHom ℚ) := by
    apply (Polynomial.lifts_iff_coeff_lifts _).mpr
    intro i
    rw [Polynomial.coeff_scaleRoots, ← CPolynomial.coeff_toPoly, ← CPolynomial.natDegree_toPoly]
    by_cases hi : i < P.natDegree
    · obtain ⟨z,hz⟩ := integer_mul_of_den_dvd (P.coeff i) (commonDen P) (coefficient_den_dvd P i)
      refine ⟨z * (commonDen P : ℤ)^(P.natDegree-i-1), ?_⟩
      change ((z * (commonDen P : ℤ)^(P.natDegree-i-1) : ℤ) : ℚ) = _
      rw [Int.cast_mul, Int.cast_pow, Int.cast_natCast, hz, mul_assoc, ← pow_succ']
      congr 2
      omega
    · by_cases heq : i = P.natDegree
      · subst i
        refine ⟨1, ?_⟩
        rw [Nat.sub_self, pow_zero, mul_one, CPolynomial.coeff_toPoly,
          CPolynomial.natDegree_toPoly, hP.coeff_natDegree]
        rfl
      · have hz : P.coeff i = 0 := by
          rw [CPolynomial.coeff_toPoly]
          exact Polynomial.coeff_eq_zero_of_natDegree_lt
            (by rw [← CPolynomial.natDegree_toPoly]; omega)
        refine ⟨0, ?_⟩
        simp [hz]
  obtain ⟨A,hA⟩ := (Polynomial.mem_lifts _).mp hl
  refine ⟨A, Polynomial.monic_of_injective (f := Int.castRingHom ℚ) (by intro x y h; change (x : ℚ) = (y : ℚ) at h; exact_mod_cast h) ?_, hA⟩
  rw [hA]
  exact (Polynomial.monic_scaleRoots_iff _).mpr hP

/-  Gauss's lemma transfers the actual scaled monic divisor to integer coefficients. -/
theorem scaled_divisor_lifts (P : NumericPolynomial) (hP : P.toPoly.Monic)
    (Q : ℚ[X]) (hQ : Q.Monic) (hdiv : Q ∣ P.toPoly) :
    ∃ B : ℤ[X], B.map (Int.castRingHom ℚ) = Q.scaleRoots (commonDen P : ℚ) := by
  obtain ⟨A,hA,hmap⟩ := scaled_input_lifts P hP
  have hd : Q.scaleRoots (commonDen P : ℚ) ∣ A.map (algebraMap ℤ ℚ) := by
    rw [show algebraMap ℤ ℚ = Int.castRingHom ℚ from rfl, hmap]
    exact hdiv.scaleRoots
  obtain ⟨B,hB⟩ := IsIntegrallyClosed.eq_map_mul_C_of_dvd ℚ hA hd
  refine ⟨B, ?_⟩
  change B.map (algebraMap ℤ ℚ) = _
  simpa only [Polynomial.leadingCoeff_scaleRoots, hQ.leadingCoeff, Polynomial.C_1,
    mul_one] using hB

/-  Every denominator of every monic rational divisor is paid by the original
common denominator and divisor degree. Constants and zero coefficients are included. -/
theorem divisor_den_bound (P : NumericPolynomial) (hP : P.toPoly.Monic)
    (Q : ℚ[X]) (hQ : Q.Monic) (hdiv : Q ∣ P.toPoly) (i : ℕ) :
    (Q.coeff i).den ≤ (commonDen P)^Q.natDegree := by
  obtain ⟨B,hB⟩ := scaled_divisor_lifts P hP Q hQ hdiv
  have hc := congrArg (fun A : ℚ[X] => A.coeff i) hB
  rw [Polynomial.coeff_map, Polynomial.coeff_scaleRoots] at hc
  have hn : ((commonDen P : ℕ) : ℚ)^(Q.natDegree-i) ≠ 0 :=
    pow_ne_zero _ (by exact_mod_cast Nat.ne_of_gt (commonDen_pos P))
  have hrat : Q.coeff i = Rat.divInt (B.coeff i) ((commonDen P : ℤ)^(Q.natDegree-i)) := by
    rw [Rat.divInt_eq_div, Int.cast_pow, Int.cast_natCast]
    exact (eq_div_iff hn).mpr hc.symm
  have hb := (N0206.rational_reduction_bounds _ _ _
    (by exact_mod_cast (pow_ne_zero (Q.natDegree-i) (Nat.ne_of_gt (commonDen_pos P)))) hrat).2
  simp only [Int.natAbs_pow, Int.natAbs_natCast] at hb
  exact hb.trans (Nat.pow_le_pow_right (commonDen_pos P) (Nat.sub_le _ _))


