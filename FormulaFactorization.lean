/-! Input-derived bounds for the actual fresh-array Bird determinant, including
partial sums and products. Primitive counters are actual instrumented executions;
no arithmetic-count bound is called a physical machine-time theorem. -/
namespace Internal.N0339.N0197.N0287
open N0301
open scoped BigOperators
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2200000
set_option maxRecDepth 4096

def EntryBound {n : ℕ} (A : PackedMatrix n) (H : ℕ) : Prop :=
  ∀i j : Fin n,(unpack A i j).natAbs ≤ H

theorem get_bound {n H : ℕ} (A : PackedMatrix n) (hA : EntryBound A H)
    (i j : ℕ) (hi : i<n) (hj : j<n) : (BirdDet.get n A.val i j).natAbs ≤ H := by
  have he := congrArg Int.natAbs (get_eq_unpack A ⟨i,hi⟩ ⟨j,hj⟩)
  exact he.le.trans (hA ⟨i,hi⟩ ⟨j,hj⟩)

theorem sumFrom_natAbs (n lo H : ℕ) (f : ℕ → ℤ)
    (hf : ∀k,lo ≤ k → k<n → (f k).natAbs ≤ H) :
    (BirdDet.sumFrom n lo f).natAbs ≤ (n-lo)*H := by
  induction lo using BirdDet.sumFrom_induct n with
  | step lo hlo ih =>
    rw [BirdDet.sumFrom_step _ _ _ hlo]
    have ht := ih (by intro k hk hn; exact hf k (by omega) hn)
    have hh := hf lo le_rfl hlo
    calc
      _  ≤  (f lo).natAbs+(BirdDet.sumFrom n (lo+1) f).natAbs := Int.natAbs_add_le _ _
      _  ≤  H+(n-(lo+1))*H := Nat.add_le_add hh ht
      _ = (n-lo)*H := by
        have he : n-lo=n-(lo+1)+1 := by omega
        rw [he]
        ring
  | stop lo hlo => rw [BirdDet.sumFrom_stop _ _ _ hlo]; simp

theorem stepEntry_natAbs {n M H : ℕ} (A F : PackedMatrix n)
    (hA : EntryBound A M) (hF : EntryBound F H) (i j : Fin n) :
    (BirdDet.stepEntry n A.val (BirdDet.get n F.val) i.val j.val).natAbs ≤ 2*n*M*H := by
  have hd := sumFrom_natAbs n (i.val+1) H (fun k => BirdDet.get n F.val k k)
    (by intro k hk hkn; exact get_bound F hF k k hkn hkn)
  have hr := sumFrom_natAbs n (i.val+1) (H*M)
    (fun k => BirdDet.get n F.val i.val k*BirdDet.get n A.val k j.val)
    (by intro k hk hkn; rw [Int.natAbs_mul]; exact Nat.mul_le_mul (get_bound F hF i k i.isLt hkn) (get_bound A hA k j hkn j.isLt))
  have ha : (BirdDet.get n A.val i.val j.val).natAbs ≤ M := get_bound A hA i j i.isLt j.isLt
  unfold BirdDet.stepEntry
  calc
    _  ≤  (-(BirdDet.sumFrom n (i.val+1) fun k => BirdDet.get n F.val k k)*BirdDet.get n A.val i.val j.val).natAbs+
      (BirdDet.sumFrom n (i.val+1) fun k => BirdDet.get n F.val i.val k*BirdDet.get n A.val k j.val).natAbs := Int.natAbs_add_le _ _
    _  ≤  ((n-(i.val+1))*H)*M+(n-(i.val+1))*(H*M) := by
      rw [Int.natAbs_mul,Int.natAbs_neg]
      exact Nat.add_le_add (Nat.mul_le_mul hd ha) hr
    _  ≤  (n*H)*M+n*(H*M) := Nat.add_le_add
      (Nat.mul_le_mul_right _ (Nat.mul_le_mul_right _ (Nat.sub_le _ _)))
      (Nat.mul_le_mul_right _ (Nat.sub_le _ _))
    _ = _ := by ring

def radix (n M : ℕ) := (n+1)^2*(M+1)
def height (n M t : ℕ) := M*(radix n M)^t

theorem radix_bounds (n M : ℕ) : 1 ≤ radix n M ∧ n+1 ≤ radix n M ∧ M ≤ radix n M ∧ 2*n*M ≤ radix n M := by
  unfold radix
  constructor
  · nlinarith [Nat.zero_le (n*n*M),Nat.zero_le (n*n)]
  constructor
  · nlinarith [Nat.zero_le (n*n*M)]
  constructor
  · nlinarith [Nat.zero_le (n*n*M)]
  · nlinarith [Nat.zero_le (n*n*M),Nat.zero_le (n*n)]

theorem stage_bound {n M H : ℕ} (A F : PackedMatrix n)
    (hA : EntryBound A M) (hF : EntryBound F H) :
    EntryBound (stage A F) (radix n M*H) := by
  intro i j
  rw [← get_eq_unpack,stage_correct]
  exact (stepEntry_natAbs A F hA hF i j).trans
    (by simpa only [Nat.mul_assoc] using Nat.mul_le_mul_right H (radix_bounds n M).2.2.2)

theorem iterate_bound {n M : ℕ} (A : PackedMatrix n) (hA : EntryBound A M) (t : ℕ) :
    EntryBound (iterate A t) (height n M t) := by
  induction t with
  | zero => simpa [height,iterate] using hA
  | succ t ih =>
    have hs := stage_bound A (iterate A t) hA ih
    have he : radix n M*height n M t=height n M (t+1) := by unfold height; rw [pow_succ]; ring
    simpa only [iterate,he] using hs

/-  Both summation tails, every product and the unsigned final-addition budget
are paid by the next materialized stage height. -/
theorem intermediate_bound {n M H : ℕ} (A F : PackedMatrix n)
    (hA : EntryBound A M) (hF : EntryBound F H) (i j : Fin n) (lo : ℕ) :
    (BirdDet.sumFrom n lo fun k => BirdDet.get n F.val k k).natAbs ≤ radix n M*H ∧
    (BirdDet.sumFrom n lo fun k => BirdDet.get n F.val i.val k*BirdDet.get n A.val k j.val).natAbs ≤ radix n M*H ∧
    ((BirdDet.sumFrom n lo fun k => BirdDet.get n F.val k k).natAbs *
      (BirdDet.get n A.val i.val j.val).natAbs +
      (BirdDet.sumFrom n lo fun k => BirdDet.get n F.val i.val k*BirdDet.get n A.val k j.val).natAbs) ≤ radix n M*H := by
  have hd := sumFrom_natAbs n lo H (fun k => BirdDet.get n F.val k k)
    (by intro k hk hkn; exact get_bound F hF k k hkn hkn)
  have hr := sumFrom_natAbs n lo (H*M)
    (fun k => BirdDet.get n F.val i.val k*BirdDet.get n A.val k j.val)
    (by intro k hk hkn; rw [Int.natAbs_mul]; exact Nat.mul_le_mul (get_bound F hF i k i.isLt hkn) (get_bound A hA k j hkn j.isLt))
  have ha : (BirdDet.get n A.val i.val j.val).natAbs ≤ M := get_bound A hA i j i.isLt j.isLt
  have hdn : (BirdDet.sumFrom n lo fun k => BirdDet.get n F.val k k).natAbs ≤ n*H :=
    hd.trans (Nat.mul_le_mul_right H (Nat.sub_le _ _))
  have hrn : (BirdDet.sumFrom n lo fun k => BirdDet.get n F.val i.val k*BirdDet.get n A.val k j.val).natAbs ≤ n*(H*M) :=
    hr.trans (Nat.mul_le_mul_right _ (Nat.sub_le _ _))
  refine ⟨hdn.trans (Nat.mul_le_mul_right H (by have hh:=(radix_bounds n M).2.1; omega)),?_,?_⟩
  · apply hrn.trans
    have hh : n*M ≤ radix n M := by have h:=(radix_bounds n M).2.2.2; nlinarith
    simpa only [Nat.mul_assoc,Nat.mul_left_comm,Nat.mul_comm] using Nat.mul_le_mul_right H hh
  · calc
      _  ≤  n*H*M+n*(H*M) := Nat.add_le_add (Nat.mul_le_mul hdn ha) hrn
      _ = (2*n*M)*H := by ring
      _  ≤  radix n M*H := Nat.mul_le_mul_right H (radix_bounds n M).2.2.2







































































theorem partial_addition_bound {n M H : ℕ} (A F : PackedMatrix n)
    (hA : EntryBound A M) (hF : EntryBound F H) (i j k : Fin n) (lo : ℕ) :
    (BirdDet.sumFrom n lo fun r => BirdDet.get n F.val r r).natAbs +
        (BirdDet.get n F.val k.val k.val).natAbs ≤ radix n M*H ∧
    (BirdDet.sumFrom n lo fun r => BirdDet.get n F.val i.val r*BirdDet.get n A.val r j.val).natAbs +
        (BirdDet.get n F.val i.val k.val*BirdDet.get n A.val k.val j.val).natAbs ≤ radix n M*H := by
  have hd := sumFrom_natAbs n lo H (fun r => BirdDet.get n F.val r r)
    (by intro r hr hrn; exact get_bound F hF r r hrn hrn)
  have hr := sumFrom_natAbs n lo (H*M)
    (fun r => BirdDet.get n F.val i.val r*BirdDet.get n A.val r j.val)
    (by intro r hr hrn; rw [Int.natAbs_mul]; exact Nat.mul_le_mul (get_bound F hF i r i.isLt hrn) (get_bound A hA r j hrn j.isLt))
  have hf := get_bound F hF k k k.isLt k.isLt
  have hm : (BirdDet.get n F.val i.val k.val*BirdDet.get n A.val k.val j.val).natAbs ≤ H*M := by
    rw [Int.natAbs_mul]
    exact Nat.mul_le_mul (get_bound F hF i k i.isLt k.isLt) (get_bound A hA k j k.isLt j.isLt)
  constructor
  · calc
      _ ≤ (n-lo)*H+H := Nat.add_le_add hd hf
      _ ≤ (n+1)*H := by nlinarith [Nat.mul_le_mul_right H (Nat.sub_le n lo)]
      _ ≤ radix n M*H := Nat.mul_le_mul_right H (radix_bounds n M).2.1
  · have hscale : (n+1)*M ≤ radix n M := by unfold radix; nlinarith [Nat.zero_le (n*n*M)]
    calc
      _ ≤ (n-lo)*(H*M)+H*M := Nat.add_le_add hr hm
      _ ≤ ((n+1)*M)*H := by nlinarith [Nat.mul_le_mul_right (H*M) (Nat.sub_le n lo)]
      _ ≤ radix n M*H := Nat.mul_le_mul_right H hscale



















































































