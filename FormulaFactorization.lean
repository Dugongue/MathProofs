  unfold rowStart; ring

theorem rowStart_mono {N u w : ℕ} (h : u ≤ w) : rowStart N u ≤ rowStart N w := by
  unfold rowStart; have := Nat.mul_le_mul_right N h; omega

theorem rowStart_lt {N u w : ℕ} (h : u < w) : rowStart N u + N ≤ rowStart N w := by
  rw [← rowStart_succ]; exact rowStart_mono h

theorem rowStart_ge (N u : ℕ) : 5 + N ≤ rowStart N u := by unfold rowStart; omega

theorem rowE_size (q : RNames) (we pe : Expr) : (rowE q we pe).size = we.size + pe.size + 7 := by
  simp only [rowE, plus, rowBase, Expr.size]; omega

