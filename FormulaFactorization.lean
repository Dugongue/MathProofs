    simp only [Bool.toNat_false, Nat.add_zero]
    rw [hfst, hmod]
    rcases Nat.lt_or_ge (a.toNat + b.toNat) UInt64.word with hlt | hle
    · rw [Nat.mod_eq_of_lt hlt]
      have he : UInt64.word + (a.toNat + b.toNat) - m.toNat
