def signLoop : Com := .while (.lt (.var scanIndex) (.var totalVar)) signBody

def clearBody : Com := .seq
  (.write (.mul (.get numN (.var scanIndex))
    (.div (.var productVar) (.get denN (.var scanIndex)))))
  (.assign scanIndex (.add (.var scanIndex) (.lit 1)))
def clearLoop : Com := .while (.lt (.var scanIndex) (.var totalVar)) clearBody

def writerSetup : Com := .seq (.assign totalVar (.mul (.var nVar) (.var dimVar)))
  (.assign shapeTotal (.add (.var nVar) (.var dimVar)))
def writerHeader : Com := .seq writerSetup (.seq (.write (.var totalVar))
  (.seq (.write (.var nVar)) (.seq (.write (.var dimVar)) (.assign scanIndex (.lit 0)))))
def writer : Com := .seq writerHeader (.seq zeroLoop
  (.seq (.assign scanIndex (.lit 0)) (.seq signLoop
    (.seq (.assign scanIndex (.lit 0)) clearLoop))))

def program : Com := .seq
  (Internal.N0339.N0575.readFields headNames)
  (.seq N0269.shapeLoader (.seq readColumns
    (.seq productProgram writer)))

def lengths (n d : ℕ) (a : String) :=
  if a=N0269.shapeBank then n+d
  else if a=numS ∨ a=numN ∨ a=denN then n*d+1 else 0

theorem raw_dimensions {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) :
    n*d+1≤N A ∧ n≤N A ∧ d≤N A ∧ n+d≤N A := by
  have h := N0318.Encoding.length_le_bitSize (inputWords A)
  have he : (inputWords A).length=3+(n+d)+3*(n*d+1) := by
    simp [inputWords,signs,numerators,denominators];omega
  rw [he] at h
  change _≤N A at h
  omega

theorem raw_components {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) (q : Fin (n*d+1)) :
    (entryQ A q).num.natAbs<2^(N A+1) ∧ (entryQ A q).den<2^(N A+1) := by
  constructor
  · apply N0318.Encoding.mem_lt_two_pow_bitSize_add_one
    have hm : (entryQ A q).num.natAbs∈numerators A := List.mem_ofFn.mpr ⟨q,rfl⟩
    simp only [inputWords,List.mem_append];tauto
  · apply N0318.Encoding.mem_lt_two_pow_bitSize_add_one
    have hm : (entryQ A q).den∈denominators A := List.mem_ofFn.mpr ⟨q,rfl⟩
    simp only [inputWords,List.mem_append];tauto

theorem denominator_bound {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) :
    denominator A≤2^((N A+1)^2) := by
  have h := N0627.clearing_bounds (padded A) (N A+1)
    (fun q=>(raw_components A q).1.le) (fun q=>(raw_components A q).2.le)
  apply h.1.trans
  apply Nat.pow_le_pow_right (by decide)
  have hm := Nat.mul_le_mul_left (N A+1) (raw_dimensions A).1
  nlinarith

theorem prefix_product_bound {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) (l : ℕ) :
    ((denominators A).take l).prod≤denominator A := by
  rw [denominator_eq_prod]
  have hpos : 0<((denominators A).drop l).prod := by
    apply List.prod_pos
    intro a ha
    have hm := List.mem_of_mem_drop ha
    obtain ⟨q,rfl⟩ := List.mem_ofFn.mp hm
    exact Rat.den_pos _
  have he := congrArg List.prod (List.take_append_drop l (denominators A))
  rw [List.prod_append] at he
  exact (Nat.le_mul_of_pos_right _ hpos).trans he.le

theorem productBody_run {W : ℕ} (σ : Env) (l p a : ℕ)
    (hi : σ.vars scanIndex=l) (hp : σ.vars productVar=p)
    (ha : (σ.arrs denN)[l]?=some a)
    (hl : l+1<W) (hpW : p<W) (haW : a<W) (hm : p*a<W) :
    ∃τ,Run W productBody σ τ 12 ∧
      τ.vars scanIndex=l+1 ∧ τ.vars productVar=p*a := by
  have hla := (List.getElem?_eq_some_iff.mp ha).1
  have hva : (σ.arrs denN).getD l 0=a := by
    simp only [List.getD_eq_getElem?_getD,ha,Option.getD_some]
  simp only [scanIndex,productVar] at hi hp
  apply wp.run
  imp_vcgen [productBody,scanIndex,productVar,denN,hi,hp]
  all_goals simp_all [scanIndex,productVar,denN]
  all_goals omega

theorem productProgram_run {W n d : ℕ} (σ : Env) (A : Matrix (Fin n) (Fin d) ℚ)
    (hc : σ.vars inputCount=n*d+1) (ha : σ.arrs denN=denominators A)
    (hl : n*d+1<W) (hD : denominator A<W)
    (haW : ∀q,(entryQ A q).den<W) (hW : 3≤W) :
    ∃τ,Run W productProgram σ τ (30*(n*d+2)) ∧
      τ.vars productVar=denominator A := by
  let σ1 := σ.setVar productVar 1
  let ρ := σ1.setVar scanIndex 0
  have r1 : Run W (.assign productVar (.lit 1)) σ σ1 2 :=
    Run.assign (evalB_lit (by omega))
  have r0 : Run W (.assign scanIndex (.lit 0)) σ1 ρ 2 :=
    Run.assign (evalB_lit (by omega))
  obtain ⟨τ,rl,hp⟩ : ∃τ,Run W productLoop ρ τ (16*(n*d+1)+4) ∧
      τ.vars productVar=denominator A := by
    apply wp.run
    refine wp_for_var (n*d+1) 12
      (fun l ν=>ν.vars productVar=((denominators A).take l).prod)
      hl (by simp [ρ,Env.setVar])
      (by simpa [ρ,σ1,Env.setVar,scanIndex,productVar,inputCount] using hc)
      (by decide) ?_ ?_ ?_
    · simp [ρ,σ1,Env.setVar,productVar,scanIndex]
    · intro l hlt ν hp hidx fr
      let q : Fin (n*d+1) := ⟨l,hlt⟩
      have he : (denominators A).take (l+1)=
          (denominators A).take l++[(entryQ A q).den] := by
        have ht := List.take_concat_get' (denominators A) l (by simpa [denominators] using hlt)
        simpa only [denominators,List.getElem_ofFn] using ht.symm
      have hmul : ((denominators A).take l).prod*(entryQ A q).den<W := by
        have hb := prefix_product_bound A (l+1)
        rw [he,List.prod_append,List.prod_singleton] at hb
        exact hb.trans_lt hD
      have har : (ν.arrs denN)[l]?=some (entryQ A q).den := by
        rw [fr.arrs _ (by decide)]
        change (σ.arrs denN)[l]?=some (entryQ A q).den
        rw [ha]
        simp only [denominators,List.getElem?_ofFn,dif_pos hlt]
        rfl
      refine vc_spec (productBody_run ν l _ _ hidx hp har (by omega)
        ((prefix_product_bound A l).trans_lt hD) (haW q) hmul) ?_
      rintro ζ k ⟨hiζ,hpζ⟩ _ hk
      refine ⟨?_,hiζ,hk⟩
      simpa [he] using hpζ
    · intro τ k hp hi fr hk
      refine ⟨hk,?_⟩
      have hlen : (denominators A).length=n*d+1 := List.length_ofFn
      rw [←hlen,List.take_length,←denominator_eq_prod] at hp
      exact hp
  exact ⟨τ,(r1.seq (r0.seq rl)).mono (by omega),hp⟩

/-  A counted actual writer combinator; all uses below instantiate its body. -/
theorem emit_loop_run {W : ℕ} (σ : Env) (lim : String) (body : Com)
    (xs : List ℕ) (P : ℕ) (hi : σ.vars scanIndex=0) (hc : σ.vars lim=xs.length)
    (hl : xs.length<W) (hw : lim∉scalarWrites body)
    (hb : ∀l (hlt : l<xs.length),∀ρ,ρ.vars scanIndex=l →
      Frame (.while (.lt (.var scanIndex) (.var lim)) body) σ ρ →
      ∃τ,Run W body ρ τ P ∧ τ.vars scanIndex=l+1 ∧
        τ.out=ρ.out++[xs[l]'hlt]) :
    ∃τ,Run W (.while (.lt (.var scanIndex) (.var lim)) body) σ τ
      ((P+4)*xs.length+4) ∧ τ.out=σ.out++xs := by
  apply wp.run
  refine wp_for_var xs.length P (fun l ρ=>ρ.out=σ.out++xs.take l)
    hl hi hc hw (by simp) ?_ ?_
  · intro l hlt ρ hout hidx fr
    refine vc_spec (hb l hlt ρ hidx fr) ?_
    rintro τ k ⟨hiτ,hoτ⟩ _ hk
    refine ⟨?_,hiτ,hk⟩
    rw [hoτ,hout]
    have ht := List.take_concat_get' xs l hlt
    rw [List.append_assoc,ht]
  · intro τ k hout hi fr hk
    exact ⟨hk,by simpa using hout⟩

theorem zeroBody_run {W : ℕ} (σ : Env) (l : ℕ)
    (hi : σ.vars scanIndex=l) (hl : l+1<W) :
    ∃τ,Run W zeroBody σ τ 8 ∧ τ.vars scanIndex=l+1 ∧ τ.out=σ.out++[0] := by
  simp only [scanIndex] at hi
  apply wp.run
  imp_vcgen [zeroBody,scanIndex,hi]
  all_goals simp_all [scanIndex]
  all_goals omega

theorem signBody_run {W : ℕ} (σ : Env) (l a : ℕ)
    (hi : σ.vars scanIndex=l) (ha : (σ.arrs numS)[l]?=some a)
    (hl : l+1<W) (haW : a<W) :
    ∃τ,Run W signBody σ τ 10 ∧ τ.vars scanIndex=l+1 ∧ τ.out=σ.out++[a] := by
  have hla := (List.getElem?_eq_some_iff.mp ha).1
  have hva : (σ.arrs numS).getD l 0=a := by
    simp only [List.getD_eq_getElem?_getD,ha,Option.getD_some]
  simp only [scanIndex] at hi
  apply wp.run
  imp_vcgen [signBody,scanIndex,numS,hi]
  all_goals simp_all [scanIndex,numS]
  all_goals omega

theorem clearBody_run {W : ℕ} (σ : Env) (l a b D : ℕ)
    (hi : σ.vars scanIndex=l) (hD : σ.vars productVar=D)
    (ha : (σ.arrs numN)[l]?=some a) (hb : (σ.arrs denN)[l]?=some b)
    (hl : l+1<W) (haW : a<W) (hbW : b<W) (hDW : D<W)
    (hm : a*(D/b)<W) :
    ∃τ,Run W clearBody σ τ 20 ∧ τ.vars scanIndex=l+1 ∧
      τ.out=σ.out++[a*(D/b)] := by
  have hla := (List.getElem?_eq_some_iff.mp ha).1
  have hlb := (List.getElem?_eq_some_iff.mp hb).1
  have hva : (σ.arrs numN).getD l 0=a := by
    simp only [List.getD_eq_getElem?_getD,ha,Option.getD_some]
  have hvb : (σ.arrs denN).getD l 0=b := by
    simp only [List.getD_eq_getElem?_getD,hb,Option.getD_some]
  have hdiv : D/b<W := (Nat.div_le_self _ _).trans_lt hDW
  simp only [scanIndex,productVar] at hi hD
  apply wp.run
  imp_vcgen [clearBody,scanIndex,numN,denN,productVar,hi,hD]
  all_goals simp_all [scanIndex,numN,denN,productVar]
  all_goals omega

def outputSigns {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) :=
  List.ofFn fun q : Fin (n*d)=>(ofInt (entryQ A q.castSucc).num).sign
def outputMagnitudes {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) :=
  List.ofFn fun q : Fin (n*d)=>
    (entryQ A q.castSucc).num.natAbs*(denominator A/(entryQ A q.castSucc).den)

theorem entryQ_flat {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) (q : Fin (n*d)) :
    entryQ A q.castSucc=A q.divNat q.modNat := by
  have he := at_entry A q.divNat q.modNat
  have heq : Fin.mkDivMod q.divNat q.modNat=q := by
    apply Fin.ext
    change d*(q.val/d)+q.val%d=q.val
    exact Nat.div_add_mod _ _
  rwa [heq] at he

theorem output_payload {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) :
    N0269.inputWords (cleared A)=
      [n*d,n,d]++List.replicate (n+d) 0++outputSigns A++outputMagnitudes A := by
  have hs : N0304.signs (cleared A)=outputSigns A := by
    unfold N0304.signs outputSigns
    congr 1
    funext q
    rw [entryQ_flat]
    rfl
  have hm : N0304.magnitudes (cleared A)=outputMagnitudes A := by
    unfold N0304.magnitudes outputMagnitudes
    congr 1
    funext q
    rw [entryQ_flat]
    rfl
  simp only [N0269.inputWords,hs,hm,List.append_assoc]

theorem writer_run {W n d : ℕ} (σ : Env) (A : Matrix (Fin n) (Fin d) ℚ)
    (hn : σ.vars nVar=n) (hd : σ.vars dimVar=d)
    (hD : σ.vars productVar=denominator A)
    (hs : σ.arrs numS=signs A) (ha : σ.arrs numN=numerators A)
    (hb : σ.arrs denN=denominators A)
    (hshape : n+d<W) (hnd : n*d+1<W) (hW : 3≤W)
    (haW : ∀q,(entryQ A q).num.natAbs<W)
    (hbW : ∀q,(entryQ A q).den<W)
    (hDW : denominator A<W)
    (hmW : ∀q,(entryQ A q).num.natAbs*(denominator A/(entryQ A q).den)<W) :
    ∃τ,Run W writer σ τ (200*(n*d+n+d+1)) ∧
      τ.out=σ.out++N0269.inputWords (cleared A) := by
  let c0 : Com := writerHeader
  obtain ⟨ρ,r0,hnt,hst,hi,ho⟩ : ∃ρ,Run W c0 σ ρ 25 ∧
      ρ.vars totalVar=n*d ∧ ρ.vars shapeTotal=n+d ∧ ρ.vars scanIndex=0 ∧
      ρ.out=σ.out++[n*d,n,d] := by
    have hnW : n<W := by omega
    have hdW : d<W := by omega
    simp only [nVar,dimVar] at hn hd
    apply wp.run
    imp_vcgen [c0,writerHeader,writerSetup,totalVar,shapeTotal,scanIndex,nVar,dimVar,hn,hd]
    all_goals simp_all [totalVar,shapeTotal,scanIndex,nVar,dimVar,List.append_assoc]
    all_goals omega
  have f0 := Frame.of_run r0
  obtain ⟨ν,rz,hoz⟩ := emit_loop_run ρ shapeTotal zeroBody
    (List.replicate (n+d) 0) 8 hi (by simpa using hst) (by simpa using hshape)
    (by decide) (by
      intro l hlt ζ hidx fr
      have hh : l<n+d := by simpa using hlt
      simpa only [List.getElem_replicate] using zeroBody_run ζ l hidx (by omega))
  have fz := Frame.of_run rz
  let ν0 := ν.setVar scanIndex 0
  have ri1 : Run W (.assign scanIndex (.lit 0)) ν ν0 2 :=
    Run.assign (evalB_lit (by omega))
  have fi1 := Frame.of_run ri1
  have hsν : ν0.arrs numS=signs A := by
    rw [fi1.arrs _ (by decide),fz.arrs _ (by decide),f0.arrs _ (by decide),hs]
  have htν : ν0.vars totalVar=n*d :=
    (fi1.vars _ (by decide)).trans ((fz.vars _ (by decide)).trans hnt)
  obtain ⟨ζ,rs,hos⟩ := emit_loop_run ν0 totalVar signBody (outputSigns A) 10
    (by simp [ν0,Env.setVar]) (by simpa [outputSigns] using htν)
    (by simpa [outputSigns] using (show n*d<W by omega)) (by decide) (by
      intro l hlt ρ' hidx fr
      have hl0 : l<n*d := by simpa only [outputSigns,List.length_ofFn] using hlt
      let q : Fin (n*d) := ⟨l,hl0⟩
      have har : (ρ'.arrs numS)[l]?=some (ofInt (entryQ A q.castSucc).num).sign := by
        rw [fr.arrs _ (by decide),hsν]
        simp only [signs,List.getElem?_ofFn,dif_pos (show l<n*d+1 by omega)]
        rfl
      have hget : (outputSigns A)[l]=(ofInt (entryQ A q.castSucc).num).sign := by
        simp only [outputSigns,List.getElem_ofFn]
        rfl
      rw [hget]
      exact signBody_run ρ' l _ hidx har (by omega)
        ((ofInt (entryQ A q.castSucc).num).bit.trans_le (by omega)))
  have fs := Frame.of_run rs
  let ζ0 := ζ.setVar scanIndex 0
  have ri2 : Run W (.assign scanIndex (.lit 0)) ζ ζ0 2 :=
    Run.assign (evalB_lit (by omega))
  have fi2 := Frame.of_run ri2
  have haζ : ζ0.arrs numN=numerators A := by
    rw [fi2.arrs _ (by decide),fs.arrs _ (by decide),fi1.arrs _ (by decide),
      fz.arrs _ (by decide),f0.arrs _ (by decide),ha]
  have hbζ : ζ0.arrs denN=denominators A := by
    rw [fi2.arrs _ (by decide),fs.arrs _ (by decide),fi1.arrs _ (by decide),
      fz.arrs _ (by decide),f0.arrs _ (by decide),hb]
  have hDζ : ζ0.vars productVar=denominator A := by
    rw [fi2.vars _ (by decide),fs.vars _ (by decide),fi1.vars _ (by decide),
      fz.vars _ (by decide),f0.vars _ (by decide),hD]
  have htζ : ζ0.vars totalVar=n*d :=
    (fi2.vars _ (by decide)).trans ((fs.vars _ (by decide)).trans htν)
  obtain ⟨τ,rc,hoc⟩ := emit_loop_run ζ0 totalVar clearBody (outputMagnitudes A) 20
    (by simp [ζ0,Env.setVar]) (by simpa [outputMagnitudes] using htζ)
    (by simpa [outputMagnitudes] using (show n*d<W by omega)) (by decide) (by
      intro l hlt ρ' hidx fr
      have hl0 : l<n*d := by simpa only [outputMagnitudes,List.length_ofFn] using hlt
      let q : Fin (n*d) := ⟨l,hl0⟩
      have har : (ρ'.arrs numN)[l]?=some (entryQ A q.castSucc).num.natAbs := by
        rw [fr.arrs _ (by decide),haζ]
        simp only [numerators,List.getElem?_ofFn,dif_pos (show l<n*d+1 by omega)]
        rfl
      have hbr : (ρ'.arrs denN)[l]?=some (entryQ A q.castSucc).den := by
        rw [fr.arrs _ (by decide),hbζ]
        simp only [denominators,List.getElem?_ofFn,dif_pos (show l<n*d+1 by omega)]
        rfl
      have hDr : ρ'.vars productVar=denominator A :=
        (fr.vars _ (by decide)).trans hDζ
      have hget : (outputMagnitudes A)[l]=
          (entryQ A q.castSucc).num.natAbs*(denominator A/(entryQ A q.castSucc).den) := by
        simp only [outputMagnitudes,List.getElem_ofFn]
        rfl
      rw [hget]
      exact clearBody_run ρ' l _ _ _ hidx hDr har hbr (by omega)
        (haW _) (hbW _) hDW (hmW _))
  have rr := r0.seq (rz.seq (ri1.seq (rs.seq (ri2.seq rc))))
  change Run W writer σ τ _ at rr
  refine ⟨τ,rr.mono ?_,?_⟩
  · simp only [List.length_replicate,outputSigns,outputMagnitudes,List.length_ofFn]
    omega
  have hν0 : ν0.out=ν.out := rfl
  have hζ0 : ζ0.out=ζ.out := rfl
  rw [hoc,hζ0,hos,hν0,hoz,ho,output_payload]
  simp only [List.append_assoc]

theorem readColumns_run {W n d : ℕ} (σ : Env) (A : Matrix (Fin n) (Fin d) ℚ)
    (hc : σ.vars inputCount=n*d+1)
    (hin : σ.inp=signs A++numerators A++denominators A)
    (hbase : σ.vars N0168.loadBase=0)
    (hlen : ∀a∈[numS,numN,denN],(σ.arrs a).length=n*d+1)
    (hl : n*d+1<W) (hW : 3≤W)
    (haW : ∀q,(entryQ A q).num.natAbs<W)
    (hbW : ∀q,(entryQ A q).den<W) :
    ∃τ,Run W readColumns σ τ (80*(n*d+2)) ∧
      τ.arrs numS=signs A ∧ τ.arrs numN=numerators A ∧
      τ.arrs denN=denominators A ∧ τ.inp=[] ∧ τ.out=σ.out := by
  let ρ := σ.setVar count (n*d+1)
  have r0 : Run W (.assign count (.var inputCount)) σ ρ 2 :=
    Run.assign (evalB_var_iff.mpr ⟨hc.symm,by rw [hc];exact hl⟩)
  have f0 := Frame.of_run r0
  have hsL : (signs A).length=n*d+1 := List.length_ofFn
  have hnL : (numerators A).length=n*d+1 := List.length_ofFn
  have hdL : (denominators A).length=n*d+1 := List.length_ofFn
  obtain ⟨ν,rS,hs,haS,hvS,hiS,hoS⟩ := N0168.read_column_run
    numS ρ (signs A) (numerators A++denominators A)
    (by simpa [ρ,Env.setVar,List.append_assoc] using hin)
    (by simp [ρ,Env.setVar,hsL])
    (by simpa [ρ,Env.setVar,count,N0168.loadBase] using hbase)
    (by rw [f0.len _,hlen _ (by simp),hsL]) (by simpa [hsL] using hl)
    (by
      intro a ha
      obtain ⟨q,rfl⟩ := List.mem_ofFn.mp ha
      exact (ofInt (entryQ A q).num).bit.trans_le (by omega))
  have fS := Frame.of_run rS
  obtain ⟨ζ,rN,hn,haN,hvN,hiN,hoN⟩ := N0168.read_column_run
    numN ν (numerators A) (denominators A) hiS
    (by rw [fS.vars _ (by decide)];simp [ρ,Env.setVar,hnL])
    ((hvS _ (by decide) (by decide)).trans ((f0.vars _ (by decide)).trans hbase))
    (by rw [fS.len _,f0.len _,hlen _ (by simp),hnL]) (by simpa [hnL] using hl)
    (by
      intro a ha
      obtain ⟨q,rfl⟩ := List.mem_ofFn.mp ha
      exact haW q)
  have fN := Frame.of_run rN
  obtain ⟨τ,rD,hd,haD,hvD,hiD,hoD⟩ := N0168.read_column_run
    denN ζ (denominators A) [] (by simpa using hiN)
    (by rw [fN.vars _ (by decide),fS.vars _ (by decide)];simp [ρ,Env.setVar,hdL])
    ((hvN _ (by decide) (by decide)).trans
      ((hvS _ (by decide) (by decide)).trans ((f0.vars _ (by decide)).trans hbase)))
    (by rw [fN.len _,fS.len _,f0.len _,hlen _ (by simp),hdL]) (by simpa [hdL] using hl)
    (by
      intro a ha
      obtain ⟨q,rfl⟩ := List.mem_ofFn.mp ha
      exact hbW q)
  refine ⟨τ,(r0.seq (rS.seq (rN.seq rD))).mono (by rw [hsL,hnL,hdL];omega),?_,?_,hd,hiD,?_⟩
  · rw [haD _ (by decide),haN _ (by decide),hs]
  · rw [haD _ (by decide),hn]
  · rw [hoD,hoN,hoS,f0.out (noWrite_of_check (by decide))]

def wordBound {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) :=
  2^(4*(N A+1)^2+4)

theorem raw_capacities {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) :
    n*d+1<wordBound A ∧ n+d<wordBound A ∧ 3≤wordBound A ∧
      denominator A<wordBound A ∧
      ∀q,(entryQ A q).num.natAbs<wordBound A ∧ (entryQ A q).den<wordBound A ∧
        (entryQ A q).num.natAbs*(denominator A/(entryQ A q).den)<wordBound A := by
  let h := N A+1
  have hpos : 1≤h := by dsimp [h];omega
  have he : h≤4*h^2+4 := by nlinarith
