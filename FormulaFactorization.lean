    have h := readFrames_encode ea xs []
    simp only [List.append_nil] at h
    simp [unframe_frame,binaryValue_bits,h]

@[simp] theorem list_encoded_length {α : Type} (ea : Encoding α) (xs : List α) :
    ((list ea).encode xs).length =
      2*xs.length.bits.length+1+2*(xs.map (fun a => (ea.encode a).length)).sum+xs.length := by
  simp only [list,List.length_append,frame_length,frames_length,List.length_map,List.map_map,Function.comp_def]
  omega

theorem list_length_le {α : Type} (ea : Encoding α) (xs : List α) :
    xs.length ≤ ((list ea).encode xs).length := by rw [list_encoded_length];omega

end Encoding
