/-! Drop-in replacement of our OWN generic raw-list wrapper. The mathematical
input/output layouts are retained; every machine certificate uses the new actual
native framing/counting programs. No former mixed-code classifier, substitution
interpreter, oracle alphabet or oracle-cost polynomial is retained. -/
namespace N0169.Computation.N0614
open Turing
noncomputable section

def parse {α : Type} (e : Encoding α) : ℕ → List Bool → Option (List α)
  | 0,bs => if bs=[] then some [] else none
  | n+1,bs => if bs=[] then some [] else do
      let (word,rest) ← Encoding.unframe bs
      let a ← e.decode word
      let tail ← parse e n rest
      return a :: tail

theorem parse_frames {α : Type} (e : Encoding α) (xs : List α) (fuel : ℕ)
    (h : xs.length ≤ fuel) : parse e fuel (Encoding.frames (xs.map e.encode)) = some xs := by
  induction xs generalizing fuel with
  | nil => cases fuel <;> simp [parse,Encoding.frames]
  | cons a xs ih =>
    cases fuel with
    | zero => simp at h
    | succ fuel =>
      have hf : Encoding.frame (e.encode a) ++ Encoding.frames (xs.map e.encode) ≠ [] := by
        intro he
        have hl := congrArg List.length he
        simp only [List.length_append,Encoding.frame_length,List.length_nil] at hl
        omega
      simp only [List.map_cons,Encoding.frames_cons,parse,if_neg hf,Encoding.unframe_frame]
      change (e.decode (e.encode a)).bind (fun aa =>
        (parse e fuel (Encoding.frames (xs.map e.encode))).bind
          (fun tail => some (aa :: tail))) = some (a :: xs)
      rw [e.decode_encode,ih fuel (by simpa using h)]
      rfl

def rawList {α : Type} (e : Encoding α) : Encoding (List α) where
  encode xs := Encoding.frames (xs.map e.encode)
  decode bs := parse e bs.length bs
  decode_encode xs := parse_frames e xs _ (by
    rw [Encoding.frames_length,List.length_map]
    omega)

abbrev Pre := List Bool × (List Bool × (List Bool × List Bool))

def preBase : Encoding Pre := Encoding.bits.prod
  (Encoding.bits.prod (Encoding.bits.prod Encoding.bits))

def preValue {α : Type} (e : Encoding α) (xs : List α) : Pre :=
  ([false],([],(Encoding.frame [] ++ (rawList e).encode xs,[])))

def preEncoding {α : Type} (e : Encoding α) : Encoding (List α) where
  encode xs := preBase.encode (preValue e xs)
  decode bs := (preBase.decode bs).map
    (fun p => ((rawList e).decode (p.2.2.1.drop 1)).getD [])
  decode_encode xs := by
    simp only [preBase.decode_encode,Option.map_some]
    change some (((rawList e).decode ((rawList e).encode xs)).getD []) = some xs
    rw [(rawList e).decode_encode]
    rfl

abbrev Post (α : Type) := List Bool × (List α × List Bool)

def postBase {α : Type} (e : Encoding α) : Encoding (Post α) :=
  Encoding.bits.prod (e.list.prod Encoding.bits)

def postValue {α : Type} (xs : List α) : Post α := ([],(xs,[]))

def postEncoding {α : Type} (e : Encoding α) : Encoding (List α) where
  encode xs := (postBase e).encode (postValue xs)
  decode bs := ((postBase e).decode bs).map (fun p => p.2.1)
  decode_encode xs := by simp only [(postBase e).decode_encode,Option.map_some];rfl

def reheaderComputer {α : Type} (e : Encoding α) :
    TM2ComputableInPolyTime (preEncoding e).encode (postEncoding e).encode (id : List α → List α) :=
  N0615.reheaderComputer e (preEncoding e) (postEncoding e)
    (fun _ => rfl) (fun _ => rfl)

theorem finite_reheader {α : Type} (e : Encoding α) :
    Realized (preEncoding e) (postEncoding e) (id : List α → List α) :=
  ⟨reheaderComputer e,N0615.reheaderComputer_finite e (preEncoding e) (postEncoding e)
    (fun _ => rfl) (fun _ => rfl)⟩

theorem finite_prepare {α : Type} (e : Encoding α) :
    Realized (rawList e) (preEncoding e) (id : List α → List α) := by
  have hr : Realized (rawList e) Encoding.bits (rawList e).encode :=
    Realized.view (rawList e) Encoding.bits (rawList e).encode (fun _ => rfl)
  have hp := ((Realized.const (rawList e) Encoding.bits (Encoding.frame [])).pair hr).comp
    Realized.raw_append
  have hi := hp.pair (Realized.const (rawList e) Encoding.bits [])
  have hv := (Realized.const (rawList e) Encoding.bits []).pair hi
  have hf := (Realized.const (rawList e) Encoding.bits [false]).pair hv
  exact hf.transportOutput (fun _ => rfl)

theorem finite_finish {α : Type} (e : Encoding α) :
    Realized (postEncoding e) e.list (id : List α → List α) := by
  have hv : Realized (postEncoding e) (postBase e) postValue :=
    Realized.view (postEncoding e) (postBase e) postValue (fun _ => rfl)
  exact (hv.comp (Realized.snd Encoding.bits (e.list.prod Encoding.bits))).comp
    (Realized.fst e.list Encoding.bits)

/-  The whole old pre/post detour is unnecessary for this principal public port. -/
theorem finite_raw_to_counted {α : Type} (e : Encoding α) :
    Realized (rawList e) e.list (id : List α → List α) :=
  N0615.realized_raw_to_counted e (rawList e) (fun _ => rfl)

theorem finite_counted_to_raw {α : Type} (e : Encoding α) :
    Realized e.list (rawList e) (id : List α → List α) :=
  N0615.realized_counted_to_raw e (rawList e) (fun _ => rfl)

end
end N0169.Computation.N0614

