      simp only [mapAlphabetStmt, TM2.stepAux, mapAlphabetStacks]
      rw [List.head?_map]
      simp only [Option.map_map]
      have hmap : (stk k).head?.map (decode ∘ encode) = (stk k).head? := by
        cases (stk k).head? <;> simp [hleft]
      rw [hmap]
      exact ih (f v (stk k).head?) stk
