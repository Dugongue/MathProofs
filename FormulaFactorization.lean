    N0090.bitCost (N0206.auxiliaryWeight w) (fiberSource A) ≤
      N0344.tableCostBound A.natDegree (2+fiberHeight A) 0 := by
  apply N0344.tableFormula_bitCost
  intro j hj
  change 2+N0090.ratWeight (A.coeff (A.natDegree-j)) ≤ 2+fiberHeight A
  exact Nat.add_le_add_left (fiberHeight_bound A (A.natDegree-j) (Nat.sub_le _ _)) 2

 theorem clusterCorrectionFormula_bitCost {ι : Type} (w : ι → ℕ)
    (A B : NumericPolynomial) (N d k : ℕ) (hk : k ≤ A.natDegree)
    (E : N0090.Formula (Option ι)) :
    N0090.bitCost w (N0625.clusterCorrectionFormula A B k N d E) ≤
