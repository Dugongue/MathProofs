/- BEGIN CLEAN SOURCE Mathproof.Computability.FactorizationClean.EncodingLaws SHA256 86c0bc2214a205e019281d7a7a349387c3857261aafd0f4ca8a128c18fa45eed -/
section P25Clean0253


namespace N0169.Computation
set_option autoImplicit false

/-  Decoding the same wire word recovers the same mathematical input. -/
theorem Encoding.encode_injective {α : Type} (e : Encoding α) : Function.Injective e.encode := by
  intro a b h
  have hh := congrArg e.decode h
  rw [e.decode_encode,e.decode_encode] at hh
  exact Option.some.inj hh

theorem Realized.congr {α β : Type} {ea : Encoding α} {eb : Encoding β} {f g : α → β}
    (hf : Realized ea eb f) (h : ∀ a, f a = g a) : Realized ea eb g := by
  have he : f = g := funext h
  rw [←he]
  exact hf

/-  Only the literal encoder affects an actual-machine certificate. -/
theorem Realized.encoder_congr {α β : Type} {ea ea' : Encoding α} {eb eb' : Encoding β}
    {f : α → β} (hf : Realized ea eb f)
    (ha : ∀ a, ea.encode a = ea'.encode a) (hb : ∀ b, eb.encode b = eb'.encode b) :
    Realized ea' eb' f := by
  obtain ⟨M,hM⟩ := hf
  refine ⟨{ toTM2ComputableAux := M.toTM2ComputableAux
            time := M.time
            outputsFun := ?_ },hM⟩
  intro a
  rw [←ha a,←hb (f a)]
  exact M.outputsFun a
end N0169.Computation

