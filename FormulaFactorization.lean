    refine ⟨hb,?_⟩
    intro r c
    have hls : d*r.val+c.val<(ρ.arrs basisS).length := by rw [fr.len _,hS]; exact rect_address_lt r c
    have hln : d*r.val+c.val<(ρ.arrs basisN).length := by rw [fr.len _,hN]; exact rect_address_lt r c
