open N0202

def inputNumerator : String := "Formula25.rat.in.n"
def inputDenominator : String := "Formula25.rat.in.d"
def inputSign : String := "Formula25.rat.in.sign"
def outputNumerator : String := "Formula25.rat.out.n"
def outputDenominator : String := "Formula25.rat.out.d"
def outputSign : String := "Formula25.rat.out.sign"

def reducePair : Com :=
  .seq (.assign ga (.var inputNumerator))
    (.seq (.assign gb (.var inputDenominator))
      (.seq gcdIMP
        (.seq (.assign outputNumerator (.bin .div (.var inputNumerator) (.var ga)))
          (.seq (.assign outputDenominator (.bin .div (.var inputDenominator) (.var ga)))
