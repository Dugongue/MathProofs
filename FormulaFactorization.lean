/-  A valid workspace remains valid when only a prefix is exposed. -/
theorem Slots.prefix {WS : String} {S T B : Nat} {σ : Env}
    (hS : Slots F r WS S B σ) (hTS : T ≤ S) : Slots F r WS T B σ := by
  refine ⟨hS.base, hS.ws_reg, ?_, ?_, ?_, ?_⟩
  · exact le_trans (Nat.add_le_add_left (Nat.mul_le_mul_right F.e hTS) _) hS.fit
  · rcases hS.modulus_apart with h | h
    · exact Or.inl h
    · exact Or.inr ((Nat.add_le_add_left (Nat.mul_le_mul_right F.e hTS) _).trans h)
  · intro s hs
    exact hS.canon s (hs.trans_le hTS)
  · exact lt_of_le_of_lt hTS hS.slots_word

/-  The field-macro base predicate depends only on the four layout registers
and the two field arrays. -/
theorem Base.transport {B : Nat} {σ τ : Env} (h : Base F r B σ)
    (he : τ.vars r.e = σ.vars r.e) (hp : τ.vars r.p = σ.vars r.p)
    (hm : τ.vars r.modBase = σ.vars r.modBase) (hx : τ.vars r.exp = σ.vars r.exp)
    (hmem : τ.arrs r.mem = σ.arrs r.mem)
    (hscratch : τ.arrs r.scratch = σ.arrs r.scratch) : Base F r B τ := by
  refine ⟨h.names, ?_, ?_, h.arithmetic_word, h.inverse_word, ?_, ?_, ?_, ?_, ?_, ?_, h.priv⟩
  · rw [he]; exact h.degree
  · rw [hp]; exact h.prime
  · rw [hmem]; exact h.memory_word
  · rw [hscratch]; exact h.scratch_word
  · rw [hscratch]; exact h.scratch_fit
  · rw [hm, hmem]; exact h.modulus_fit
  · intro i
    rw [hmem, hm]
    exact h.modulus_value i
  · rw [hx]; exact h.exp_word

/-  Restoring the field arrays and layout registers restores the complete slot
invariant, including all canonical decoded cells. -/
theorem Slots.transport {WS : String} {S B : Nat} {σ τ : Env}
    (h : Slots F r WS S B σ)
    (he : τ.vars r.e = σ.vars r.e) (hp : τ.vars r.p = σ.vars r.p)
    (hm : τ.vars r.modBase = σ.vars r.modBase) (hx : τ.vars r.exp = σ.vars r.exp)
    (hWS : τ.vars WS = σ.vars WS)
    (hmem : τ.arrs r.mem = σ.arrs r.mem)
    (hscratch : τ.arrs r.scratch = σ.arrs r.scratch) : Slots F r WS S B τ := by
  refine ⟨Base.transport h.base he hp hm hx hmem hscratch, h.ws_reg, ?_, ?_, ?_, h.slots_word⟩
  · rw [hWS, hmem]
    exact h.fit
  · rw [hWS, hm]
    exact h.modulus_apart
  · intro s hs
    unfold Canonical slice
    rw [hmem, hWS]
    exact h.canon s hs


