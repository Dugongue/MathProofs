    evalB_condLt (evalB_var_iff.mpr ⟨hidx.symm,by rw [hidx]; omega⟩)
      (evalB_var_iff.mpr ⟨hL.dimension.symm,by rw [hL.dimension]; exact hdB⟩)
  have hdef : ∀ρ,I ρ → ∃v,(Cond.lt (.var swapCol) (.var dimVar)).evalB W ρ=some v := by
    rintro ρ ⟨l,hl,hL,hI,hJ,hidx⟩
    exact ⟨_,hcond ρ l hl hL hidx⟩
  have hstep : ∀ρ,I ρ → (Cond.lt (.var swapCol) (.var dimVar)).evalB W ρ=some true →
      ∃τ,Run W swapBody ρ τ 150 ∧ I τ ∧ V τ<V ρ := by
