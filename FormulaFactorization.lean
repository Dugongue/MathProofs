theorem mem_support_monomial {n : Nat} {c : R} {i : Nat} :
    i ∈ (monomial n c).support ↔ i = n ∧ c ≠ (0 : R) := by
  by_cases hc : c = (0 : R)
  · simp [hc]
  · simp [hc]

