      rw [hf] at hnext
      cases hnext
    | some middle =>
      have ht := ih middle (by simpa only [hs] using hnext)
      have hc := macrostep_runs M c middle hs
      simpa [Nat.mul_succ, Nat.add_comm] using hc.trans ht

