/-  Materialized factors and Bezout witnesses; all fields are executable arrays. -/
structure State where
  g : Poly
  h : Poly
  s : Poly
  t : Poly

def toNative (r : State) : Internal.N0208.QuadraticLiftResult :=
  ⟨toHex r.g, toHex r.h, toHex r.s, toHex r.t⟩

/-  Actual imported lift, with actual conversions on input and output. -/
def run (m : Nat) (P : Poly) (seed : State) (k : Nat) : State :=
  let r := N0246.lift m (toHex P) (toNative seed) k
  ⟨fromHex r.g, fromHex r.h, fromHex r.s, fromHex r.t⟩

theorem toHex_toPolynomial (P : Poly) :
    N0254.toPolynomial (toHex P) = P.toPoly := by
  ext i
  rw [N0254.coeff_toPolynomial, coeff_toHex, CPolynomial.coeff_toPoly]

theorem fromHex_toPoly (P : Internal.N0208.ZPoly) :
    (fromHex P).toPoly = N0254.toPolynomial P := by
  ext i
  rw [← CPolynomial.coeff_toPoly, coeff_fromHex, N0254.coeff_toPolynomial]

/-  The native coefficient congruence is exactly polynomial equality modulo m. -/
theorem congr_iff_map_eq (m : Nat) (A B : Internal.N0208.ZPoly) :
    Internal.N0208.ZPoly.congr A B m ↔
      (N0254.toPolynomial A).map (Int.castRingHom (ZMod m)) =
        (N0254.toPolynomial B).map (Int.castRingHom (ZMod m)) := by
  constructor
  · intro h
    ext i
    simp only [Polynomial.coeff_map, N0254.coeff_toPolynomial, Int.coe_castRingHom]
    have hz := (ZMod.intCast_zmod_eq_zero_iff_dvd (A.coeff i - B.coeff i) m).mpr
      (Int.dvd_of_emod_eq_zero (h i))
    simpa only [Int.cast_sub, sub_eq_zero] using hz
  · intro h i
    apply Int.emod_eq_zero_of_dvd
    apply (ZMod.intCast_zmod_eq_zero_iff_dvd (A.coeff i - B.coeff i) m).mp
    have hi := congrArg (fun F : Polynomial (ZMod m) => F.coeff i) h
    simp only [Polynomial.coeff_map, N0254.coeff_toPolynomial, Int.coe_castRingHom] at hi
    simpa only [Int.cast_sub, hi, sub_self]

/-  Derive the imported step's complete invariant from the driver's literal
polynomial contracts. No compatible lift is selected or supplied. -/
theorem initial_valid (m : Nat) (P : Poly) (seed : State)
    (hprod : (P.toPoly - seed.g.toPoly * seed.h.toPoly).map
      (Int.castRingHom (ZMod m)) = 0)
    (hbez : (seed.s.toPoly * seed.g.toPoly + seed.t.toPoly * seed.h.toPoly - 1).map
      (Int.castRingHom (ZMod m)) = 0)
    (hmon : seed.g.toPoly.Monic) :
    N0246.Valid (toHex P) m (toNative seed) := by
  constructor
  · apply (congr_iff_map_eq m _ _).mpr
    simp only [toNative, N0254.toPolynomial_mul, toHex_toPolynomial, Polynomial.map_mul]
    rw [Polynomial.map_sub, Polynomial.map_mul] at hprod
    exact (sub_eq_zero.mp hprod).symm
  constructor
  · apply (congr_iff_map_eq m _ _).mpr
    simp only [toNative, N0254.toPolynomial_add,
      N0254.toPolynomial_mul, N0254.toPolynomial_one,
      toHex_toPolynomial, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_one]
    rw [Polynomial.map_sub, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul,
      Polynomial.map_one] at hbez
    exact sub_eq_zero.mp hbez
  · change (toHex seed.g).leadingCoeff = 1
    rw [← N0254.leadingCoeff_toPolynomial, toHex_toPolynomial]
    exact hmon

/-  Sufficient end-to-end functional contract for the actual native driver.
The first conclusion is definitionally the existing
NumericHenselFactorLift.CongruentProduct contract on the actual CompPoly output.
Initialization, all quadratic steps, and representation transport are concrete.
Physical execution and polynomial bit runtime are not asserted here. -/
theorem run_spec (m : Nat) (P : Poly) (seed : State) (k : Nat)
    (hm : 1 < m)
    (hprod : (P.toPoly - seed.g.toPoly * seed.h.toPoly).map
      (Int.castRingHom (ZMod m)) = 0)
    (hbez : (seed.s.toPoly * seed.g.toPoly + seed.t.toPoly * seed.h.toPoly - 1).map
      (Int.castRingHom (ZMod m)) = 0)
    (hmon : seed.g.toPoly.Monic) :
    let r := run m P seed k
    (P.toPoly - r.g.toPoly * r.h.toPoly).map
      (Int.castRingHom (ZMod (m ^ (2 ^ k)))) = 0 ∧
      r.g.toPoly.Monic ∧
      (r.s.toPoly * r.g.toPoly + r.t.toPoly * r.h.toPoly - 1).map
        (Int.castRingHom (ZMod (m ^ (2 ^ k)))) = 0 := by
  let r := N0246.lift m (toHex P) (toNative seed) k
  have hv := N0246.lift_valid m (toHex P) (toNative seed) hm
    (initial_valid m P seed hprod hbez hmon) k
  rw [N0246.modulus_eq_pow] at hv
  obtain ⟨hp,hb,hmr⟩ := hv
  change (_ - (fromHex r.g).toPoly * (fromHex r.h).toPoly).map _ = 0 ∧
    (fromHex r.g).toPoly.Monic ∧
    ((fromHex r.s).toPoly * (fromHex r.g).toPoly +
      (fromHex r.t).toPoly * (fromHex r.h).toPoly - 1).map _ = 0
  constructor
  · have he := (congr_iff_map_eq _ _ _).mp hp
    rw [N0254.toPolynomial_mul, toHex_toPolynomial, Polynomial.map_mul] at he
    rw [fromHex_toPoly, fromHex_toPoly, Polynomial.map_sub, Polynomial.map_mul]
    exact sub_eq_zero.mpr he.symm
  constructor
  · change ((fromHex r.g).toPoly).leadingCoeff = 1
    rw [fromHex_toPoly, N0254.leadingCoeff_toPolynomial]
    exact hmr
  · have he := (congr_iff_map_eq _ _ _).mp hb
    rw [N0254.toPolynomial_add, N0254.toPolynomial_mul,
      N0254.toPolynomial_mul, N0254.toPolynomial_one,
      Polynomial.map_one, Polynomial.map_add, Polynomial.map_mul, Polynomial.map_mul] at he
    simp only [fromHex_toPoly, Polynomial.map_sub, Polynomial.map_add,
      Polynomial.map_mul, Polynomial.map_one]
    exact sub_eq_zero.mpr he

/-  The native loop retains both original seed images, not just their product. -/
theorem native_seed_congr (m : Nat) (P : Internal.N0208.ZPoly) (seed : Internal.N0208.QuadraticLiftResult)
    (hm : 1 < m) (hseed : N0246.Valid P m seed) (k : Nat) :
    Internal.N0208.ZPoly.congr (N0246.lift m P seed k).g seed.g m ∧
      Internal.N0208.ZPoly.congr (N0246.lift m P seed k).h seed.h m := by
  induction k with
  | zero => exact ⟨Internal.N0208.ZPoly.congr_refl _ _, Internal.N0208.ZPoly.congr_refl _ _⟩
  | succ k ih =>
    have hv := N0246.lift_valid m P seed hm hseed k
    have hc := Internal.N0208.ZPoly.quadraticHenselStep_factor_congr_mod_base
      (N0246.modulus m k) P
      (N0246.lift m P seed k).g (N0246.lift m P seed k).h
      (N0246.lift m P seed k).s (N0246.lift m P seed k).t
      (N0246.modulus_gt_one m hm k) hv.1
    have hd : m ∣ N0246.modulus m k := by
      rw [N0246.modulus_eq_pow]
      exact dvd_pow_self m (Nat.ne_of_gt (Nat.pow_pos (by decide : 0 < 2)))
    exact ⟨Internal.N0208.ZPoly.congr_trans _ _ _ m
        (Internal.N0208.ZPoly.congr_of_dvd_modulus _ _ hd hc.1) ih.1,
      Internal.N0208.ZPoly.congr_trans _ _ _ m
        (Internal.N0208.ZPoly.congr_of_dvd_modulus _ _ hd hc.2) ih.2⟩

/-  Exact seed-image preservation on the existing CompPoly carrier. -/
theorem run_seed_images (m : Nat) (P : Poly) (seed : State) (k : Nat)
    (hm : 1 < m)
    (hprod : (P.toPoly - seed.g.toPoly * seed.h.toPoly).map
      (Int.castRingHom (ZMod m)) = 0)
    (hbez : (seed.s.toPoly * seed.g.toPoly + seed.t.toPoly * seed.h.toPoly - 1).map
      (Int.castRingHom (ZMod m)) = 0)
    (hmon : seed.g.toPoly.Monic) :
    (run m P seed k).g.toPoly.map (Int.castRingHom (ZMod m)) =
      seed.g.toPoly.map (Int.castRingHom (ZMod m)) ∧
    (run m P seed k).h.toPoly.map (Int.castRingHom (ZMod m)) =
      seed.h.toPoly.map (Int.castRingHom (ZMod m)) := by
  have hc := native_seed_congr m (toHex P) (toNative seed) hm
    (initial_valid m P seed hprod hbez hmon) k
  have hg := (congr_iff_map_eq _ _ _).mp hc.1
  have hh := (congr_iff_map_eq _ _ _).mp hc.2
  simpa only [run, fromHex_toPoly, toNative, toHex_toPolynomial] using And.intro hg hh

/-  Monicity and preserved seed image give the exact degree required by the
existing p-adic uniqueness and lattice-discovery contracts. -/
theorem run_degree (m : Nat) (P : Poly) (seed : State) (k : Nat)
    (hm : 1 < m)
    (hprod : (P.toPoly - seed.g.toPoly * seed.h.toPoly).map
      (Int.castRingHom (ZMod m)) = 0)
    (hbez : (seed.s.toPoly * seed.g.toPoly + seed.t.toPoly * seed.h.toPoly - 1).map
      (Int.castRingHom (ZMod m)) = 0)
    (hmon : seed.g.toPoly.Monic) :
    (run m P seed k).g.toPoly.natDegree = seed.g.toPoly.natDegree := by
  haveI : Fact (1 < m) := ⟨hm⟩
  have hr := (run_spec m P seed k hm hprod hbez hmon).2.1
  have he := congrArg Polynomial.natDegree
    (run_seed_images m P seed k hm hprod hbez hmon).1
  rw [hr.natDegree_map, hmon.natDegree_map] at he
  exact he

/-  A positive number of doubling stages with linear paid precision growth. -/
def stages (T : Nat) : Nat := T.size + 1

def paidRun (m : Nat) (P : Poly) (seed : State) (T : Nat) : State :=
  run m P seed (stages T)

/-  Requested precision is covered, and no exponential-in-T output precision
is hidden in the schedule: the actual exponent is at most 4(T+1). -/
theorem stages_precision (T : Nat) :
    T + 1 ≤ 2 ^ (stages T) ∧ 2 ^ (stages T) ≤ 4 * (T + 1) := by
  have hlow := Nat.lt_size_self T
  have hupp : 2 ^ T.size ≤ 2 * (T + 1) := by
    cases hs : T.size with
    | zero => simp only [Nat.pow_zero]; omega
    | succ n =>
      have hn : n < T.size := by omega
      have hp := Nat.lt_size.mp hn
      rw [Nat.pow_succ]
      omega
  simp only [stages, Nat.pow_succ]
  constructor <;> omega

