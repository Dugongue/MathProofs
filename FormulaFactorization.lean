def padded {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) :=
  N0591.flatten A
def entryQ {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) (q : Fin (n*d+1)) :=
  N0627.read (padded A) q
def signs {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) :=
  List.ofFn fun q : Fin (n*d+1)=>(ofInt (entryQ A q).num).sign
def numerators {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) :=
  List.ofFn fun q : Fin (n*d+1)=>(entryQ A q).num.natAbs
def denominators {n d : ℕ} (A : Matrix (Fin n) (Fin d) ℚ) :=
  List.ofFn fun q : Fin (n*d+1)=>(entryQ A q).den
