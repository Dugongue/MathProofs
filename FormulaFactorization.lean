theorem correction_term_degree (A B U : R[X]) (hA : A.Monic) (hB : B.Monic)
    (hU : U.degree<A.degree) : (U*B).degree<A.degree+B.degree := by
  by_cases hz : U=0
  · rw [hz,zero_mul,Polynomial.degree_zero,Polynomial.degree_eq_natDegree hA.ne_zero,
      Polynomial.degree_eq_natDegree hB.ne_zero]
    simp
  · rw [hB.degree_mul,Polynomial.degree_eq_natDegree hz,
      Polynomial.degree_eq_natDegree hA.ne_zero,Polynomial.degree_eq_natDegree hB.ne_zero]
    have hn := Polynomial.natDegree_lt_natDegree hz hU
    exact_mod_cast (show U.natDegree+B.natDegree<A.natDegree+B.natDegree by omega)

theorem correction_sum_degree (A B U V : R[X]) (hA : A.Monic) (hB : B.Monic)
    (hU : U.degree<A.degree) (hV : V.degree<B.degree) :
    (U*B+V*A).degree<A.degree+B.degree := by
  apply (Polynomial.degree_add_le _ _).trans_lt
  apply max_lt
  · exact correction_term_degree A B U hA hB hU
  · simpa only [add_comm] using correction_term_degree B A V hB hA hV

def decode (n : ℕ) (v : Fin n → R) : CPolynomial R := CPolynomial.ofArray (Array.ofFn v)

theorem decode_coeff (n : ℕ) (v : Fin n → R) (i : ℕ) :
    (decode n v).coeff i=if h : i<n then v ⟨i,h⟩ else 0 := by
  rw [decode,CPolynomial.coeff_ofArray]
