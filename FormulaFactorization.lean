    beta_reduce
    exact le_mul_succ_p25c0144 (A := 6 * c₁ + c₂) (B := 6 * max k₁ k₂ + 20) (by omega) le_rfl
  · have := Nat.mul_le_mul_left c₂ (by omega : S₂ (g a) + 1 ≤ S₁ a + S₂ (g a) + 1)
    exact (l₂ (g a)).trans (this.trans (Nat.mul_le_mul_right _ (by omega)))

