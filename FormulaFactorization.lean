  have hev:r.e≠r.value:=by tauto
  have hiv:r.i≠r.value:=by tauto
  have hik:r.i≠r.k:=by tauto
  have hij:r.i≠r.j:=by tauto
  have he:σ.vars r.e<B:=by have hs:=h.scratch_fit; have hw:=h.scratch_word; omega
  have hp:σ.vars r.p<B:=by have hw:=h.arithmetic_word; nlinarith
  have hone:1<B:=by have hw:=h.arithmetic_word; nlinarith
  have heval : (Expr.var r.e).evalB B σ=some (σ.vars r.e) := evalB_var he
  have hidx : (Expr.sub (.var r.e) (.lit 1)).evalB B σ=some (σ.vars r.e-1) :=
    evalB_bin (op:=Bop.sub) heval (evalB_lit hone) (by change σ.vars r.e-1<B; omega)
  have hl:=getElem_some_getD (σ.arrs r.scratch) (σ.vars r.e-1)
    (by have hs:=h.scratch_fit; have he0:=h.degree_pos; omega)
  have hc : (σ.arrs r.scratch).getD (σ.vars r.e-1) 0<B :=
    ((h.coefficients _ (by have he0:=h.degree_pos; omega)).2.2.2).trans hp
  have hlead:=Run.assign (x:=r.value) (evalB_get hidx hl hc)
  have hle:(iterLead r σ).vars r.e=σ.vars r.e:=by simp [iterLead,hev]
  have hset : (Expr.var r.e).evalB B (iterLead r σ)=some (σ.vars r.e) := by
    simpa only [hle] using evalB_var (σ:=iterLead r σ) (x:=r.e) (by rw [hle]; exact he)
  have hk:=Run.assign (x:=r.k) hset
  have hmap:=iter_map_run h hi
  have hzero:=Run.assign (σ:=iterNext r modArray σ) (x:=r.k) (evalB_lit (by omega : 0<B))
