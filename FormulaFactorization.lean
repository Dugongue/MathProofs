def VectorArrays {n : ℕ} (σ : Env) (v : Fin n → Signed) : Prop :=
  ∀q,(σ.arrs kernelS)[q.val]?=some (v q).sign ∧ (σ.arrs kernelN)[q.val]?=some (v q).magnitude

def KernelResult {n : ℕ} (σ : Env) : Option (Fin n → ℤ) → Prop
  | none => σ.vars kernelFound=0
  | some v => σ.vars kernelFound=1 ∧ ∃w : Fin n → Signed,
      VectorArrays σ w ∧ (fun q=>zval (w q))=v

def kernelTime (n d : ℕ) : ℕ := 50000*(n+1)^5*(d+1)

theorem budget_arithmetic (n P : ℕ) (hp : 1≤P) :
