    (hn : σ.vars nVar=n) (hc : σ.vars count=n*n)
    (ht : σ.vars targetVar=target.val) (hk : σ.vars prefixVar=k) (hm : σ.vars mixedVar=if mixed then 1 else 0) (hd : σ.vars dimVar=d)
