    (θ : K) (modulus lhs rhs : Nat→Nat) (hp : 0<p) (he : 0<e)
    (hmod : θ^e+weighted θ e (fun j=>(modulus j : K))=0) (t : Nat) (ht : t ≤ e) :
    weighted θ e (fun j=>(hornerCoeffs p e modulus lhs rhs t j : K))=
