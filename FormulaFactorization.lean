 theorem finiteLogFormula_bitCost {ι : Type} (w : ι → ℕ) (N : ℕ) (f : N0090.Formula ι) :
    N0090.bitCost w (N0194.finiteLogFormula N f) ≤ logBudget N (N0090.bitCost w f) := by
  have h := N0090.weightedSum_bitCost_le w
    ((List.range N).map fun j => (N0194.logCoefficient j, N0090.power f (j+1)))
    (2*N+7) (N*(N0090.bitCost w f+2)+(2+N0090.ratWeight 1)) (by
      intro t ht
      obtain ⟨j,hj,rfl⟩ := List.mem_map.mp ht
      have hjN : j+1 ≤ N := Nat.succ_le_of_lt (List.mem_range.mp hj)
