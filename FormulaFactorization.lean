/-  Original Y remains Y, t is some none, and each original input is some (some i). -/
def radialSubstitution {ι : Type} (a : ι → ℚ) : Option ι → N0090.Formula (Option (Option ι))
  | none => .var none
  | some i => .add (.const (a i)) (.mul (.var (some none))
      (.add (.var (some (some i))) (.const (-a i))))

def radialSource {ι : Type} (a : ι → ℚ) (f : N0090.Formula (Option ι)) :
    N0090.Formula (Option (Option ι)) := N0090.substitute (radialSubstitution a) f

/-  Actual dense numeric polynomial source. -/
def numericSource {ι : Type} (D : NumericPolynomial) : N0090.Formula (Option ι) :=
  N0344.tableFormula D.natDegree (fun j => .const (D.coeff j))

/-  The compiler receives only the original source, rational center, and numeric initial factors. -/
def perturbationSource {ι : Type} (a : ι → ℚ) (A B : NumericPolynomial)
    (f : N0090.Formula (Option ι)) : N0090.Formula (Option (Option ι)) :=
  .add (radialSource a f) (N0090.scale (-1) (numericSource (A*B)))

noncomputable def radialEnvironment {ι R : Type} [CommRing R] [Algebra ℚ R]
    (env : ι → R) (a : ι → ℚ) : ι → PowerSeries R := fun i =>
  PowerSeries.C (algebraMap ℚ R (a i)) + PowerSeries.X *
    (PowerSeries.C (env i)-PowerSeries.C (algebraMap ℚ R (a i)))

/-  The actual original formula evaluated on the radial path, before Hensel construction. -/
noncomputable def radialSeries {ι R : Type} [CommRing R] [Algebra ℚ R]
    (env : ι → R) (a : ι → ℚ) (f : N0090.Formula (Option ι)) : PowerSeries R[X] :=
