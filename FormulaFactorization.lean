def bitCost {ι : Type} (variableWeight : ι → ℕ) : Formula ι → ℕ
  | .const q => 2 + ratWeight q
  | .var i => 2 + variableWeight i
  | .add f g => 2 + bitCost variableWeight f + bitCost variableWeight g
  | .mul f g => 2 + bitCost variableWeight f + bitCost variableWeight g

def encode : Formula ℕ → List Bool
  | .const q => [false, false] ++ ratCode q
  | .var i => [false, true] ++ natCode i
  | .add f g => [true, false] ++ encode f ++ encode g
  | .mul f g => [true, true] ++ encode f ++ encode g

