section P25Clean0328






/-!
# Safety of factor ancestry under coefficient specialization

A monic polynomial of positive degree cannot disappear or become a unit under
specialization to a nontrivial domain.  Therefore it cannot divide two factors
whose initial specializations are coprime.  Combining this fact with primality
gives a unique ancestor for a monic positive-degree factor of a product.

The final theorem has two actual coefficient maps: the first creates a line
specialization, and the second evaluates that line at the fixed initial fiber.
No partition-label safety oracle is introduced.
-/

namespace Internal.N0339.N0197.N0173

open Polynomial
open scoped BigOperators

universe u v w z

section MonicSpecialization

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [IsDomain S]

/-  A monic specialization keeps both its leading coefficient and its degree. -/
theorem monic_specialization_preserves (φ : R →+* S) {H : R[X]} (hH : H.Monic) :
    (H.map φ).Monic ∧ (H.map φ).natDegree = H.natDegree ∧
      (H.map φ).degree = H.degree :=
  ⟨hH.map φ, hH.natDegree_map φ, hH.degree_map φ⟩

/-  A positive-degree monic factor remains a nonunit at the initial fiber. -/
theorem monic_specialization_not_isUnit (φ : R →+* S) {H : R[X]}
    (hH : H.Monic) (hdeg : 0 < H.natDegree) : ¬ IsUnit (H.map φ) := by
  apply Polynomial.not_isUnit_of_natDegree_pos
  rw [hH.natDegree_map φ]
  exact hdeg

/-  Coprime initial fibers forbid a common positive-degree monic divisor before
specialization.  Injectivity of the coefficient map is not required. -/
theorem no_common_monic_divisor_of_coprime_specializations (φ : R →+* S)
    {H P Q : R[X]} (hH : H.Monic) (hdeg : 0 < H.natDegree)
    (hcop : IsCoprime (P.map φ) (Q.map φ)) (hP : H ∣ P) (hQ : H ∣ Q) : False := by
  exact monic_specialization_not_isUnit φ hH hdeg
    (hcop.isUnit_of_dvd' (Polynomial.map_dvd φ hP) (Polynomial.map_dvd φ hQ))

variable {ι : Type w}

/-  Pairwise coprime initial factors give uniqueness of a proposed ancestor. -/
theorem ancestor_eq_of_dvd (φ : R →+* S) (s : Finset ι) (F : ι → R[X])
    {H : R[X]} (hH : H.Monic) (hdeg : 0 < H.natDegree)
    (hcop : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → IsCoprime ((F i).map φ) ((F j).map φ))
    {i j : ι} (hi : i ∈ s) (hj : j ∈ s) (hHi : H ∣ F i) (hHj : H ∣ F j) :
    i = j := by
  by_contra hne
  exact no_common_monic_divisor_of_coprime_specializations φ hH hdeg
    (hcop i hi j hj hne) hHi hHj

/-  A prime factor of a product has exactly one ancestor when initial fibers are
pairwise coprime. -/
theorem existsUnique_ancestor (φ : R →+* S) (s : Finset ι) (F : ι → R[X])
    {H : R[X]} (hH : H.Monic) (hdeg : 0 < H.natDegree) (hprime : Prime H)
    (hcop : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → IsCoprime ((F i).map φ) ((F j).map φ))
    (hdiv : H ∣ ∏ i ∈ s, F i) : ∃! i, i ∈ s ∧ H ∣ F i := by
  obtain ⟨i, hi, hHi⟩ := (hprime.dvd_finsetProd_iff F).mp hdiv
  refine ⟨i, ⟨hi, hHi⟩, ?_⟩
  rintro j ⟨hj, hHj⟩
  exact ancestor_eq_of_dvd φ s F hH hdeg hcop hj hi hHj hHi

/-  Multiplicities in the total product do not change the unique ancestor. -/
theorem existsUnique_ancestor_of_dvd_product_powers (φ : R →+* S)
    (s : Finset ι) (F : ι → R[X]) (m : ι → ℕ)
    {H : R[X]} (hH : H.Monic) (hdeg : 0 < H.natDegree) (hprime : Prime H)
    (hcop : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → IsCoprime ((F i).map φ) ((F j).map φ))
    (hdiv : H ∣ ∏ i ∈ s, (F i) ^ m i) : ∃! i, i ∈ s ∧ H ∣ F i := by
  obtain ⟨i, hi, hpow⟩ := (hprime.dvd_finsetProd_iff (fun i => (F i) ^ m i)).mp hdiv
  have hHi := hprime.dvd_of_dvd_pow hpow
  refine ⟨i, ⟨hi, hHi⟩, ?_⟩
  rintro j ⟨hj, hHj⟩
  exact ancestor_eq_of_dvd φ s F hH hdeg hcop hj hi hHj hHi

/-  In a decomposition domain, irreducibility supplies the required primality.
This hypothesis holds in particular for polynomial rings over UFD domains. -/







end MonicSpecialization

section TwoSpecializations

variable {R : Type u} {S : Type v} {K : Type w} {ι : Type z}
variable [CommRing R] [CommRing S] [CommRing K] [IsDomain K]

/-  A monic prime line factor has a unique global ancestor.  Coprimality is
checked at the initial fiber through the composite coefficient specialization. -/
theorem existsUnique_line_ancestor (ψ : R →+* S) (φ : S →+* K)
    (s : Finset ι) (F : ι → R[X]) (m : ι → ℕ)
    {H : S[X]} (hH : H.Monic) (hdeg : 0 < H.natDegree) (hprime : Prime H)
    (hcop : ∀ i ∈ s, ∀ j ∈ s, i ≠ j →
      IsCoprime ((F i).map (φ.comp ψ)) ((F j).map (φ.comp ψ)))
    (hdiv : H ∣ (∏ i ∈ s, (F i) ^ m i).map ψ) :
    ∃! i, i ∈ s ∧ H ∣ (F i).map ψ := by
  apply existsUnique_ancestor_of_dvd_product_powers φ s (fun i => (F i).map ψ) m
    hH hdeg hprime
  · intro i hi j hj hij
    simpa only [Polynomial.map_map] using hcop i hi j hj hij
  · simpa only [Polynomial.map_prod, Polynomial.map_pow] using hdiv

/-  The irreducible form of the line-factor ancestry theorem for a decomposition
coefficient polynomial ring, without assuming irreducible implies prime in every
domain. -/
theorem existsUnique_line_ancestor_of_irreducible [DecompositionMonoid S[X]]
    (ψ : R →+* S) (φ : S →+* K) (s : Finset ι) (F : ι → R[X]) (m : ι → ℕ)
    {H : S[X]} (hH : H.Monic) (hdeg : 0 < H.natDegree) (hirr : Irreducible H)
    (hcop : ∀ i ∈ s, ∀ j ∈ s, i ≠ j →
      IsCoprime ((F i).map (φ.comp ψ)) ((F j).map (φ.comp ψ)))
    (hdiv : H ∣ (∏ i ∈ s, (F i) ^ m i).map ψ) :
    ∃! i, i ∈ s ∧ H ∣ (F i).map ψ :=
  existsUnique_line_ancestor ψ φ s F m hH hdeg hirr.prime hcop hdiv


/-  Divisibility by a line factor descends to divisibility at the initial fiber. -/
theorem initial_divisor_descends (ψ : R →+* S) (φ : S →+* K)
    {H : S[X]} {P : R[X]} {q : K[X]} (hHP : H ∣ P.map ψ) (hq : q ∣ H.map φ) :
    q ∣ P.map (φ.comp ψ) := by
  simpa only [Polynomial.map_map] using hq.trans (Polynomial.map_dvd φ hHP)

/-  A nonunit initial-fiber atom lying below a line factor inherits that factor's
unique global ancestor.  This is the concrete safety statement on polynomial
factors, before any representation by finite partition labels. -/
theorem initial_factor_ancestor_eq (ψ : R →+* S) (φ : S →+* K)
    (s : Finset ι) (F : ι → R[X])
    (hcop : ∀ i ∈ s, ∀ j ∈ s, i ≠ j →
      IsCoprime ((F i).map (φ.comp ψ)) ((F j).map (φ.comp ψ)))
    {i j : ι} (hi : i ∈ s) (hj : j ∈ s) {H : S[X]} {q : K[X]}
    (hHi : H ∣ (F i).map ψ) (hq : ¬ IsUnit q)
    (hqH : q ∣ H.map φ) (hqj : q ∣ (F j).map (φ.comp ψ)) : i = j := by
  by_contra hne
  exact hq ((hcop i hi j hj hne).isUnit_of_dvd'
    (initial_divisor_descends ψ φ hHi hqH) hqj)

/-  Any two nonunit initial-fiber factors grouped by one monic prime line factor
belong to the same true global factor.  This gives the refinement invariant using
actual maps and polynomial divisibility, without a label-safety oracle. -/
theorem same_line_initial_factors_same_ancestor (ψ : R →+* S) (φ : S →+* K)
    (s : Finset ι) (F : ι → R[X]) (m : ι → ℕ)
    {H : S[X]} (hH : H.Monic) (hdeg : 0 < H.natDegree) (hprime : Prime H)
    (hcop : ∀ i ∈ s, ∀ j ∈ s, i ≠ j →
      IsCoprime ((F i).map (φ.comp ψ)) ((F j).map (φ.comp ψ)))
    (hdiv : H ∣ (∏ i ∈ s, (F i) ^ m i).map ψ)
    {j k : ι} (hj : j ∈ s) (hk : k ∈ s) {p q : K[X]}
    (hp : ¬ IsUnit p) (hq : ¬ IsUnit q) (hpH : p ∣ H.map φ) (hqH : q ∣ H.map φ)
    (hpj : p ∣ (F j).map (φ.comp ψ)) (hqk : q ∣ (F k).map (φ.comp ψ)) : j = k := by
  obtain ⟨i, ⟨hi, hHi⟩, _⟩ :=
    existsUnique_line_ancestor ψ φ s F m hH hdeg hprime hcop hdiv
  have hij := initial_factor_ancestor_eq ψ φ s F hcop hi hj hHi hp hpH hpj
  have hik := initial_factor_ancestor_eq ψ φ s F hcop hi hk hHi hq hqH hqk
  exact hij.symm.trans hik

/-  The same concrete refinement statement for irreducible line factors in a
polynomial decomposition domain. -/












end TwoSpecializations

