  refine Fin.addCases (fun j=>?_) (fun j=>?_) j
  · rw [matrix_left_entry]
    simp only [entry,source,axis,List.length_append,List.length_tail,stored_degree,Fin.val_castAdd]
    rw [if_pos j.isLt]
    by_cases h : i.val<j.val
    · rw [if_pos h,if_neg (by omega)]
    · rw [if_neg h,if_pos (by omega)]
      exact (getAt_eq_getD _ _ _).trans (stored_getD B _)
  · refine Fin.lastCases ?_ (fun j=>?_) j
    · change entry ((source D B,D.natDegree+B.natDegree),i.val) =
        matrix (1 : CPolynomial ℚ) D B i (lastIndex D.natDegree B.natDegree)
      rw [matrix_last_entry]
      simp only [entry,source,axis,List.length_append,List.length_tail,stored_degree,
        Fin.val_natAdd,Fin.val_last]
      rw [if_neg (by omega),if_neg (by omega)]
      rw [CPolynomial.coeff_toPoly,CPolynomial.toPoly_one,Polynomial.coeff_one]
      split_ifs <;> simp_all
    · rw [matrix_right_entry]
      simp only [entry,source,axis,List.length_append,List.length_tail,stored_degree,
        Fin.val_natAdd,Fin.val_castSucc]
      rw [if_neg (by omega),if_pos (by have h:=j.isLt; omega),Nat.add_sub_cancel_left]
      by_cases h : i.val<j.val
      · rw [if_pos h,if_neg (by omega)]
      · rw [if_neg h,if_pos (by omega)]
        exact (getAt_eq_getD _ _ _).trans (stored_getD D _)

