section P25Clean0292



/-!
# Existence of bounded coprime formal factor lifts

The coefficient sequence is constructed by strong recursion.  Each step solves
an actual bounded coprime correction equation for the convolution residual.
Classical choice selects witnesses of that proved equation; no lifter is assumed.
This is semantic existence, with no executable formula or running-time claim.
-/

namespace Internal.N0339.N0197.N0207

noncomputable section

open Polynomial
open scoped BigOperators

universe u

variable {R : Type u} [CommRing R] [IsDomain R]

/-  The actual input data for a two-factor monic formal lifting problem. -/
structure Problem (R : Type u) [CommRing R] where
  F : PowerSeries R[X]
  A : R[X]
  B : R[X]
  monicA : A.Monic
  monicB : B.Monic
  coprime : IsCoprime A B
  initial : PowerSeries.coeff 0 F = A * B
  degreeBound : ∀ n > 0, (PowerSeries.coeff n F).degree < A.degree + B.degree

/-  Multiplying two strictly bounded corrections stays below the sum degree. -/
theorem correction_product_degree {A B U V : R[X]} (hA : A.Monic) (hB : B.Monic)
    (hU : U.degree < A.degree) (hV : V.degree < B.degree) :
    (U * V).degree < A.degree + B.degree := by
  have hbot : (⊥ : WithBot ℕ) < A.degree + B.degree := by
    rw [degree_eq_natDegree hA.ne_zero, degree_eq_natDegree hB.ne_zero]
    simp
  by_cases hUz : U = 0
  · simpa [hUz] using hbot
  by_cases hVz : V = 0
  · simpa [hVz] using hbot
  rw [degree_mul, degree_eq_natDegree hUz, degree_eq_natDegree hVz,
    degree_eq_natDegree hA.ne_zero, degree_eq_natDegree hB.ne_zero]
  have hu := natDegree_lt_natDegree hUz hU
  have hv := natDegree_lt_natDegree hVz hV
  exact_mod_cast (show U.natDegree + V.natDegree < A.natDegree + B.natDegree by omega)

/-  A coefficient pair with the required initial value or positive degree bounds. -/
def BoundedPair (D : Problem R) (n : ℕ) :=
  { p : R[X] × R[X] // if n = 0 then p = (D.A, D.B)
    else p.1.degree < D.A.degree ∧ p.2.degree < D.B.degree }

theorem boundedPair_degree (D : Problem R) {n : ℕ} (p : BoundedPair D n) (hn : 0 < n) :
    p.val.1.degree < D.A.degree ∧ p.val.2.degree < D.B.degree := by
  simpa only [if_neg (Nat.ne_of_gt hn)] using p.property

/-  Interior convolution, with both recursive indices provably below n. -/
def interior (D : Problem R) (n : ℕ) (pre : ∀ i, i < n → BoundedPair D i) : R[X] :=
  ∑ i ∈ Finset.range n, if hi : 0 < i ∧ i < n then
    (pre i hi.2).val.1 * (pre (n - i) (by omega)).val.2 else 0

theorem interior_degree (D : Problem R) (n : ℕ)
    (pre : ∀ i, i < n → BoundedPair D i) :
    (interior D n pre).degree < D.A.degree + D.B.degree := by
  have hbot : (⊥ : WithBot ℕ) < D.A.degree + D.B.degree := by
    rw [degree_eq_natDegree D.monicA.ne_zero, degree_eq_natDegree D.monicB.ne_zero]
    simp
  apply (degree_sum_le _ _).trans_lt
  apply (Finset.sup_lt_iff hbot).mpr
  intro i hi
  by_cases h : 0 < i ∧ i < n
  · rw [dif_pos h]
    exact correction_product_degree D.monicA D.monicB
      (boundedPair_degree D (pre i h.2) h.1).1
      (boundedPair_degree D (pre (n - i) (by omega)) (by omega)).2
  · rw [dif_neg h, degree_zero]
    exact hbot

/-  The proved correction system, repackaged as a single pair witness. -/
theorem correction_pair_exists (D : Problem R) (P : R[X])
    (hP : P.degree < D.A.degree + D.B.degree) :
    ∃ p : R[X] × R[X], p.1.degree < D.A.degree ∧ p.2.degree < D.B.degree ∧
      P = p.1 * D.B + p.2 * D.A := by
  obtain ⟨U, V, hU, hV, hid⟩ :=
    exists_coprime_correction D.monicA D.monicB D.coprime hP
  exact ⟨(U, V), hU, hV, hid⟩

noncomputable def correction (D : Problem R) (P : R[X])
    (hP : P.degree < D.A.degree + D.B.degree) : R[X] × R[X] :=
  Classical.choose (correction_pair_exists D P hP)

theorem correction_spec (D : Problem R) (P : R[X])
    (hP : P.degree < D.A.degree + D.B.degree) :
    (correction D P hP).1.degree < D.A.degree ∧
      (correction D P hP).2.degree < D.B.degree ∧
      P = (correction D P hP).1 * D.B + (correction D P hP).2 * D.A :=
  Classical.choose_spec (correction_pair_exists D P hP)

noncomputable def step (D : Problem R) (n : ℕ)
    (pre : ∀ i, i < n → BoundedPair D i) : BoundedPair D n :=
  if hn : n = 0 then ⟨(D.A, D.B), by simp [hn]⟩ else
    let E := PowerSeries.coeff n D.F - interior D n pre
    let hE : E.degree < D.A.degree + D.B.degree :=
      (degree_sub_le _ _).trans_lt
        (max_lt (D.degreeBound n (Nat.pos_of_ne_zero hn)) (interior_degree D n pre))
    ⟨correction D E hE, by
      simpa only [if_neg hn] using ⟨(correction_spec D E hE).1, (correction_spec D E hE).2.1⟩⟩

noncomputable def coefficients (D : Problem R) : ∀ n, BoundedPair D n :=
  Nat.strongRec (step D)

theorem coefficients_eq (D : Problem R) (n : ℕ) :
    coefficients D n = step D n (fun i _ => coefficients D i) := by
  unfold coefficients
  rw [Nat.strongRec_eq]

theorem coefficients_zero (D : Problem R) : (coefficients D 0).val = (D.A, D.B) := by
  rw [coefficients_eq]
  simp [step]

theorem step_residual (D : Problem R) (n : ℕ)
    (pre : ∀ i, i < n → BoundedPair D i) (hn : 0 < n) :
    PowerSeries.coeff n D.F - interior D n pre =
      (step D n pre).val.1 * D.B + (step D n pre).val.2 * D.A := by
  simp only [step, Nat.ne_of_gt hn, ↓reduceDIte]
  exact (correction_spec D _ _).2.2

theorem coefficients_residual (D : Problem R) (n : ℕ) (hn : 0 < n) :
    PowerSeries.coeff n D.F - interior D n (fun i _ => coefficients D i) =
      (coefficients D n).val.1 * D.B + (coefficients D n).val.2 * D.A := by
  simpa only [← coefficients_eq D n] using
    step_residual D n (fun i _ => coefficients D i) hn
/-  An ordinary interior convolution for a complete coefficient sequence. -/
def partialConvolution (p : ℕ → R[X] × R[X]) (n : ℕ) : R[X] :=
  ∑ i ∈ Finset.range n, if 0 < i then (p i).1 * (p (n - i)).2 else 0

theorem interior_eq_partialConvolution (D : Problem R) (n : ℕ) :
    interior D n (fun i _ => coefficients D i) =
      partialConvolution (fun i => (coefficients D i).val) n := by
  apply Finset.sum_congr rfl
  intro i hi
  have hil : i < n := Finset.mem_range.mp hi
  by_cases hip : 0 < i <;> simp [hip, hil]

/-  Separate the two endpoint terms from the actual product convolution. -/
theorem convolution_split (p : ℕ → R[X] × R[X]) (n : ℕ) (hn : 0 < n) :
    (∑ ij ∈ _root_.Finset.HasAntidiagonal.antidiagonal n, (p ij.1).1 * (p ij.2).2) =
      (p 0).1 * (p n).2 + partialConvolution p n + (p n).1 * (p 0).2 := by
  rw [Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk, Finset.sum_range_succ, Nat.sub_self]
  congr 1
  have hsingle : (∑ i ∈ Finset.range n,
      if i = 0 then (p i).1 * (p (n - i)).2 else 0) = (p 0).1 * (p n).2 := by
    rw [Finset.sum_eq_single 0]
    · simp
    · intro i hi hne
      simp [hne]
    · simp [Finset.mem_range, hn]
  calc
    (∑ i ∈ Finset.range n, (p i).1 * (p (n - i)).2) =
        ∑ i ∈ Finset.range n, ((if i = 0 then (p i).1 * (p (n - i)).2 else 0) +
          (if 0 < i then (p i).1 * (p (n - i)).2 else 0)) := by
      apply Finset.sum_congr rfl
      intro i hi
      by_cases hz : i = 0
      · simp [hz]
      · simp [hz, Nat.pos_of_ne_zero hz]
    _ = (p 0).1 * (p n).2 + partialConvolution p n := by
      rw [Finset.sum_add_distrib, hsingle]
      rfl

/-  Every actual input problem has formal factors with constant coefficients A,B
and strict positive-coefficient degree bounds.  Classical witness selection is
semantic existence; no executable formula size or running time is asserted. -/
theorem exists_bounded_coprime_lift (D : Problem R) :
    ∃ H K : PowerSeries R[X], PowerSeries.coeff 0 H = D.A ∧
      PowerSeries.coeff 0 K = D.B ∧
      (∀ n > 0, (PowerSeries.coeff n H).degree < D.A.degree) ∧
      (∀ n > 0, (PowerSeries.coeff n K).degree < D.B.degree) ∧ H * K = D.F := by
  let p : ℕ → R[X] × R[X] := fun n => (coefficients D n).val
  let H : PowerSeries R[X] := PowerSeries.mk (fun n => (p n).1)
  let K : PowerSeries R[X] := PowerSeries.mk (fun n => (p n).2)
  have hp0 : p 0 = (D.A, D.B) := coefficients_zero D
  refine ⟨H, K, ?_, ?_, ?_, ?_, ?_⟩
  · simpa only [H, PowerSeries.coeff_mk] using congrArg Prod.fst hp0
  · simpa only [K, PowerSeries.coeff_mk] using congrArg Prod.snd hp0
  · intro n hn
    simpa only [H, PowerSeries.coeff_mk, p] using
      (boundedPair_degree D (coefficients D n) hn).1
  · intro n hn
    simpa only [K, PowerSeries.coeff_mk, p] using
      (boundedPair_degree D (coefficients D n) hn).2
  · apply PowerSeries.ext
    intro n
    rw [PowerSeries.coeff_mul]
    simp only [H, K, PowerSeries.coeff_mk]
    by_cases hn : n = 0
    · subst n
      simp only [Finset.Nat.antidiagonal_zero, Finset.sum_singleton, hp0]
      exact D.initial.symm
    · rw [convolution_split p n (Nat.pos_of_ne_zero hn), hp0]
      have hres := coefficients_residual D n (Nat.pos_of_ne_zero hn)
      rw [interior_eq_partialConvolution] at hres
      change PowerSeries.coeff n D.F - partialConvolution p n =
        (p n).1 * D.B + (p n).2 * D.A at hres
      linear_combination -hres

/-  Combining the constructed lift with the independently proved correction
uniqueness gives actual unique existence of the bounded factor pair. -/
theorem existsUnique_bounded_coprime_lift (D : Problem R) :
    ∃! p : PowerSeries R[X] × PowerSeries R[X],
      PowerSeries.coeff 0 p.1 = D.A ∧ PowerSeries.coeff 0 p.2 = D.B ∧
      (∀ n > 0, (PowerSeries.coeff n p.1).degree < D.A.degree) ∧
      (∀ n > 0, (PowerSeries.coeff n p.2).degree < D.B.degree) ∧ p.1 * p.2 = D.F := by
  obtain ⟨H, K, hH0, hK0, hHd, hKd, hprod⟩ := exists_bounded_coprime_lift D
  refine ⟨(H, K), ⟨hH0, hK0, hHd, hKd, hprod⟩, ?_⟩
  rintro p ⟨hpH0, hpK0, hpHd, hpKd, hpprod⟩
  obtain ⟨hleft, hright⟩ := coprime_cluster_lift_unique D.monicA D.coprime
    p.1 p.2 H K hpH0 hH0 hpK0 hK0 hpHd hHd (hpprod.trans hprod.symm)
  exact Prod.ext hleft hright

/-  Raw-input form of the formal existence theorem. -/
theorem coprime_cluster_lift_exists (F : PowerSeries R[X]) {A B : R[X]}
    (hA : A.Monic) (hB : B.Monic) (hAB : IsCoprime A B)
    (hF0 : PowerSeries.coeff 0 F = A * B)
