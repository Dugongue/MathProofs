  funext j
  simp only [eliminate_apply, observe_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul, elimVec,
    div_eq_mul_inv]
  try ring

def rowE (q : RNames) (we pe : Expr) : Expr := plus (rowBase q we) pe

def xE (pe : Expr) : Expr := plus (.lit 5) pe

/-  One later row. -/
def rowElimBody (M : FieldMacros F r) (q : RNames) : Com :=
  .seq (mcall r q M.mul (rowE q (.var q.w) (.var q.pv)) (.lit 1) (.lit 2))
    (.seq (axpyLoop M q (rowBase q (.var q.w)) (rowBase q (.var q.u)))
      (.assign q.w (plus (.var q.w) (.lit 1))))

/-  The elimination phase. -/
def elimPhase (M : FieldMacros F r) (q : RNames) : Com :=
  .seq (mcall r q M.inv (rowE q (.var q.u) (.var q.pv)) (rowE q (.var q.u) (.var q.pv)) (.lit 1))
    (.seq (.assign q.w (plus (.var q.u) (.lit 1)))
      (.seq (.while (.lt (.var q.w) (.var q.c)) (rowElimBody M q))
        (.seq (mcall r q M.mul (xE (.var q.pv)) (.lit 1) (.lit 2))
          (axpyLoop M q (.lit 5) (rowBase q (.var q.u))))))

