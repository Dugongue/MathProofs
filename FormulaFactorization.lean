/-  Approximate inverses suffice to clear every finite-log term modulo the given error. -/
theorem clearedLog_inverse_congruence {R : Type*} [CommRing R] [Algebra ℚ R]
    (N : ℕ) (m a x g b : R) (hg : m ∣ a*g-1) (hb : m ∣ a^N*b-1) :
