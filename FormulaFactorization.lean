    (ha : σ.vars ga < W) (hb : σ.vars gb < W) :
    ∃ τ, Run W gcdIMP σ τ (32 * Nat.size (σ.vars gb) + 4) ∧
      τ.vars ga = Nat.gcd (σ.vars ga) (σ.vars gb) ∧ τ.vars gb = 0 ∧
      (∀ x, x ≠ ga → x ≠ gb → x ≠ gr → τ.vars x = σ.vars x) ∧
      τ.arrs = σ.arrs ∧ τ.inp = σ.inp ∧ τ.out = σ.out := by
  let I : Env → Prop := fun ρ => ρ.vars ga < W ∧ ρ.vars gb < W ∧
    Nat.gcd (ρ.vars ga) (ρ.vars gb) = Nat.gcd (σ.vars ga) (σ.vars gb) ∧
    (∀ x, x ≠ ga → x ≠ gb → x ≠ gr → ρ.vars x = σ.vars x) ∧
    ρ.arrs = σ.arrs ∧ ρ.inp = σ.inp ∧ ρ.out = σ.out
  have hw : 0 < W := by omega
  have hdef : ∀ ρ, I ρ → ∃ v, (Cond.lt (.lit 0) (.var gb)).evalB W ρ = some v := by
    intro ρ hρ
    exact ⟨_, evalB_condLt (evalB_lit hw) (evalB_var hρ.2.1)⟩
  have hstep : ∀ ρ, I ρ → (Cond.lt (.lit 0) (.var gb)).evalB W ρ = some true →
      ∃ η, Run W euclidPair ρ η 28 ∧ I η ∧ Nat.size (η.vars gb) < Nat.size (ρ.vars gb) := by
    intro ρ hρ hc
    obtain ⟨haρ, hbρ, hgρ, hfρ, harrρ, hinρ, houtρ⟩ := hρ
    rw [evalB_condLt (evalB_lit hw) (evalB_var hbρ)] at hc
    have hbpos : 0 < ρ.vars gb := by simpa using hc
    obtain ⟨η, rr, hA, hB, hf, harr, hin, hout⟩ := euclidStep_run haρ hbρ
    have haη : η.vars ga < W := by rw [hA]; exact hbρ
    have hbη : η.vars gb < W := by rw [hB]; exact (Nat.mod_le _ _).trans_lt haρ
    have hgη : Nat.gcd (η.vars ga) (η.vars gb) = Nat.gcd (σ.vars ga) (σ.vars gb) := by
      rw [hA, hB, remainder_gcd]; exact hgρ
    by_cases hz : η.vars gb = 0
    · have htest : (Cond.lt (.lit 0) (.var gb)).evalB W η = some false := by
        rw [evalB_condLt (evalB_lit hw) (evalB_var hbη), hz]
