theorem factor_array_bound (D : ℕ) (P Q : NumericBivariate) (hP : Bounded D P)
    (hmP : (Polynomial.Bivariate.swap (N0365.polynomial P)).Monic)
    (hmQ : (Polynomial.Bivariate.swap (N0365.polynomial Q)).Monic)
    (hdiv : N0365.polynomial Q ∣ N0365.polynomial P) :
    (arrayCode D Q).length ≤ factorArrayBudget D (arrayBill D P) := by
  rw [arrayCode_length]
  have hcode : (N0090.natCode D).length ≤ 2*D+3 := by
    rw [N0090.natCode_length]
    have hs : D.size ≤ D+1 := Nat.size_le.mpr ((Nat.lt_succ_self D).trans (Nat.lt_two_pow_self))
