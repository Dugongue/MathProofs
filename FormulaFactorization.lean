/-  Concrete field-macro bounds turn the actual loop count into a polynomial
in matrix dimensions and field-presentation parameters. -/
theorem cost_le (n m : ℕ) : cost F n m ≤ 3000*N0506.macroBudget F*(n+m+2)*(m+1)^3 := by
  let W := N0506.macroBudget F
  let N := (n+1)+m
