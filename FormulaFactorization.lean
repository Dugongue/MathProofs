/-! The source-budget modular integer gcd agrees exactly with rational normalized
Euclid. The executable output uses modular samples and centered CRT, not rational
Euclid; the latter occurs only in the correctness theorem. -/
namespace Internal.N0339.N0197.N0341
open Polynomial Internal.N0048
open scoped BigOperators
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 2400000
set_option maxRecDepth 8192
abbrev IntPolynomial := CPolynomial ℤ
abbrev rationalize := N0595.rationalize

def extract (P Q : IntPolynomial) : CPolynomial ℚ :=
  rationalize (N0362.gcd P Q)

theorem extract_eq (P Q : IntPolynomial) (hP : P.toPoly.Monic) (hQ : Q ≠ 0)
    (hd : Q.natDegree < P.natDegree) : extract P Q=N0595.extract P Q := by
  obtain ⟨A,B,hG,hA,hPA,hQB,hc⟩ := N0362.gcd_spec P Q hP hQ hd
  let G := N0362.gcd P Q
  let φ := Int.castRingHom ℚ
  let p := P.toPoly.map φ
  let q := Q.toPoly.map φ
  let g := G.toPoly.map φ
  let n := normalize (EuclideanDomain.gcd p q)
  have hg : g.Monic := hG.map φ
  have hp : p ≠ 0 := (Polynomial.map_ne_zero_iff N0362.cast_injective).mpr hP.ne_zero
  have hn : n.Monic := by
    apply Polynomial.monic_normalize
    intro hz
    exact hp (EuclideanDomain.gcd_eq_zero_iff.mp hz).1
  have hndp : n ∣ p := normalize_dvd_iff.mpr (EuclideanDomain.gcd_dvd_left _ _)
  have hndq : n ∣ q := normalize_dvd_iff.mpr (EuclideanDomain.gcd_dvd_right _ _)
  have hpa : p=g*(A.toPoly.map φ) := by
    change P.toPoly.map φ=G.toPoly.map φ*_
    rw [hPA,Polynomial.map_mul]
  have hqb : q=g*(B.toPoly.map φ) := by
    change Q.toPoly.map φ=G.toPoly.map φ*_
    rw [hQB,Polynomial.map_mul]
  obtain ⟨u,v,huv⟩ := hc
  have hng : n ∣ g := by
    have he : g=u*p+v*q := by rw [hpa,hqb]; calc
      g = g*1 := (mul_one _).symm
      _ = g*(u*A.toPoly.map φ+v*B.toPoly.map φ) := by rw [huv]
      _ = _ := by ring
    rw [he]
    exact dvd_add (dvd_mul_of_dvd_right hndp _) (dvd_mul_of_dvd_right hndq _)
  have hgn : g ∣ n := dvd_normalize_iff.mpr (EuclideanDomain.dvd_gcd ⟨_,hpa⟩ ⟨_,hqb⟩)
  have he : g=n := Polynomial.eq_of_monic_of_dvd_of_natDegree_le hn hg hng
    (Polynomial.natDegree_le_of_dvd hgn hn.ne_zero)
  apply CPolynomial.toPolyLinearEquiv.injective
  simpa only [CPolynomial.toPolyLinearEquiv_apply,extract,N0595.rationalize_correct,
    N0595.extract,CPolynomial.gcdMonic_toPoly_eq_normalize_gcd] using he

theorem extract_correct (P Q : IntPolynomial) (hP : P.toPoly.Monic) (hQ : Q ≠ 0)
    (hd : Q.natDegree < P.natDegree) (hz : P.toPoly.resultant Q.toPoly=0) :
    (extract P Q).toPoly.Monic ∧ 0<(extract P Q).toPoly.natDegree ∧
      (extract P Q).toPoly.natDegree<(rationalize P).toPoly.natDegree ∧
      (extract P Q).toPoly ∣ (rationalize P).toPoly ∧
      (extract P Q).toPoly ∣ (rationalize Q).toPoly := by
  rw [extract_eq P Q hP hQ hd]
  exact N0595.extract_correct P Q hP hQ hd hz



