theorem actual_source_run {n d : ℕ} (A : RectData n d) (hRank : FullRank (rectValue A)) :
    ∃(ext : String→ℕ)(τ : Env),
      Run (2^(valuePolynomial.eval (N A)+N A+1)) program (initEnv ext ((inputWords A).length::inputWords A)) τ
        (timePolynomial.eval (N A)) ∧ τ.out=outputWords (finalData A) := by
  let E := valuePolynomial.eval (N A)+N A+1
  let W := 2^E
  have hE : N A+2 ≤ E := by
    simp only [E,valuePolynomial,Polynomial.eval_mul,Polynomial.eval_pow,Polynomial.eval_add,Polynomial.eval_X,Polynomial.eval_one,Polynomial.eval_ofNat]
    have hp : 1 ≤ (N A+1)^12 := Nat.one_le_pow _ _ (by omega)
    omega
  have hW3 : 3 ≤ W := by
    have he : 2 ≤ E := by omega
    have hh : 2^2 ≤ W := Nat.pow_le_pow_right (by decide) he
    omega
  cases n with
  | zero =>
    have hdmem : d∈inputWords A := by simp [inputWords]
    have hdM : d < 2^(N A+1) := N0318.Encoding.mem_lt_two_pow_bitSize_add_one hdmem
    have hpW : 2^(N A+1) ≤ W := Nat.pow_le_pow_right (by decide) (show N A+1 ≤ E by omega)
    have hdW : d < W := hdM.trans_le hpW
    obtain ⟨τ,hr,ho⟩ := empty_program_run A hdW hW3
    refine ⟨lengths 0 d,τ,hr.mono ?_,ho⟩
    simp only [timePolynomial,Polynomial.eval_mul,Polynomial.eval_pow,Polynomial.eval_add,Polynomial.eval_X,Polynomial.eval_one,Polynomial.eval_ofNat]
    have hp : 1 ≤ (N A+1)^20 := Nat.one_le_pow _ _ (by omega)
    omega
  | succ m =>
    obtain ⟨τ,hr,ho⟩ := nonempty_program_run A hRank (by omega)
    obtain ⟨k,hk,hbs⟩ := hr
    have hbound := raw_word_capacity A hRank (by omega)
    refine ⟨lengths (m+1) d,τ,⟨k,hk.trans (raw_time_capacity A hRank (by omega)),?_⟩,ho⟩
    exact Internal.N0339.N0347.BigStepB.mono hbound hbs

theorem actual_ram_run {n d : ℕ} (A : RectData n d) (hRank : FullRank (rectValue A)) :
    FitsInWords ((Internal.N0339.N0556.wordBound layout valuePolynomial).eval (N A))
      (((inputWords A).length::inputWords A)++outputWords (finalData A)) ∧
    ∀w,(Internal.N0339.N0556.wordBound layout valuePolynomial).eval (N A) ≤ w →
      ∃t ≤ (Internal.N0339.N0556.timeBound layout timePolynomial).eval (N A),
        N0315.N0587.RunsTo w (compileProgram layout program) ((inputWords A).length::inputWords A) (outputWords (finalData A)) t := by
  exact Internal.N0339.N0556.compileProgram_runs_polynomial
    layout program valuePolynomial timePolynomial program_ok (inputWords A) (outputWords (finalData A)) (actual_source_run A hRank)

