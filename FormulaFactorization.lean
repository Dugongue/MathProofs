/-!
# Concrete arithmetic formula semantics

This is the first non-scaffolding replacement for the earlier paper-abstraction pass.

It defines actual arithmetic formula/circuit-tree syntax, actual evaluation, actual parse-tree
contribution enumeration, and proves the parse-tree expansion theorem by induction on syntax.
No circuit transformation is hidden behind a predicate here.
-/

namespace Internal.N0339.N0005.N0198

/-! ## Syntax and direct evaluation -/

/-  Concrete arithmetic formula syntax over variables `Var` and constants in `K`. -/
inductive ArithFormula (Var K : Type) where
  | const : K -> ArithFormula Var K
  | var : Var -> ArithFormula Var K
  | add : ArithFormula Var K -> ArithFormula Var K -> ArithFormula Var K
  | mul : ArithFormula Var K -> ArithFormula Var K -> ArithFormula Var K
  deriving Repr

namespace ArithFormula

variable {Var K : Type}

/-  Number of gates in the concrete formula tree. -/
def gateCount : ArithFormula Var K -> Nat
  | const _ => 1
  | var _ => 1
  | add left right => gateCount left + gateCount right + 1
  | mul left right => gateCount left + gateCount right + 1

/-  Number of parent-child edges in the concrete formula tree. -/
def edgeCount : ArithFormula Var K -> Nat
  | const _ => 0
  | var _ => 0
  | add left right => edgeCount left + edgeCount right + 2
  | mul left right => edgeCount left + edgeCount right + 2

/-  Depth of the formula tree; inputs/constants have depth zero. -/
def depth : ArithFormula Var K -> Nat
  | const _ => 0
  | var _ => 0
  | add left right => max (depth left) (depth right) + 1
  | mul left right => max (depth left) (depth right) + 1

/-  Syntactic/formal degree of a formula. Constants have formal degree zero. -/
def formalDegree : ArithFormula Var K -> Nat
  | const _ => 0
  | var _ => 1
  | add left right => max (formalDegree left) (formalDegree right)
  | mul left right => formalDegree left + formalDegree right

/-  Syntactic homogeneity of a concrete arithmetic formula at a declared degree. -/
def IsSyntacticallyHomogeneousOfDegree : Nat -> ArithFormula Var K -> Prop
  | degree, const _ => degree = 0
  | degree, var _ => degree = 1
  | degree, add left right =>
      IsSyntacticallyHomogeneousOfDegree degree left /\
        IsSyntacticallyHomogeneousOfDegree degree right
  | degree, mul left right =>
      ∃ leftDegree rightDegree,
        IsSyntacticallyHomogeneousOfDegree leftDegree left /\
          IsSyntacticallyHomogeneousOfDegree rightDegree right /\
          degree = leftDegree + rightDegree

/-  Direct evaluation of a formula in a semiring. -/
def eval [Semiring K] (env : Var -> K) : ArithFormula Var K -> K
  | const c => c
  | var v => env v
  | add left right => eval env left + eval env right
  | mul left right => eval env left * eval env right

/-! ## Parse trees -/

/- 
Values contributed by parse trees.

At an addition gate, a parse tree chooses exactly one child; at a multiplication gate, it keeps
both children and multiplies their contributions.  Thus this list is the concrete finite list of
all parse-tree contributions.
-/
def parseTreeValues [Semiring K] (env : Var -> K) : ArithFormula Var K -> List K
  | const c => [c]
  | var v => [env v]
  | add left right => parseTreeValues env left ++ parseTreeValues env right
  | mul left right =>
      (parseTreeValues env left).flatMap fun leftValue =>
        (parseTreeValues env right).map fun rightValue => leftValue * rightValue

theorem sum_bind_mul [Semiring K] (leftValues rightValues : List K) :
    ((leftValues.flatMap fun leftValue =>
      rightValues.map fun rightValue => leftValue * rightValue).sum) =
      leftValues.sum * rightValues.sum := by
  induction leftValues with
  | nil =>
      simp
  | cons leftValue leftValues ih =>
      have hmap :
          (rightValues.map fun rightValue => leftValue * rightValue).sum =
            leftValue * rightValues.sum := by
        simpa using
          (List.sum_map_mul_left (l := rightValues) (r := leftValue) (f := id))
      simp [hmap, ih, add_mul]

/- 
Parse-tree expansion for concrete arithmetic formulas.

The value computed by the formula is exactly the sum of all parse-tree contributions.
-/
theorem eval_eq_parseTreeValues_sum [Semiring K] (env : Var -> K) :
    ∀ formula : ArithFormula Var K,
      eval env formula = (parseTreeValues env formula).sum
  | const c => by
      simp [eval, parseTreeValues]
  | var v => by
      simp [eval, parseTreeValues]
  | add left right => by
      simp [eval, parseTreeValues,
        eval_eq_parseTreeValues_sum env left,
        eval_eq_parseTreeValues_sum env right]
  | mul left right => by
      simp [eval, parseTreeValues,
        eval_eq_parseTreeValues_sum env left,
        eval_eq_parseTreeValues_sum env right,
        sum_bind_mul]

/-! ## Concrete bookkeeping lemmas -/

theorem gateCount_pos (formula : ArithFormula Var K) :
    0 < gateCount formula := by
  induction formula with
  | const _ =>
      simp [gateCount]
  | var _ =>
      simp [gateCount]
  | add left right ihLeft ihRight =>
      simp [gateCount]
  | mul left right ihLeft ihRight =>
      simp [gateCount]

theorem edgeCount_add (left right : ArithFormula Var K) :
    edgeCount (add left right) = edgeCount left + edgeCount right + 2 := by
  rfl

theorem edgeCount_mul (left right : ArithFormula Var K) :
    edgeCount (mul left right) = edgeCount left + edgeCount right + 2 := by
  rfl

theorem depth_add (left right : ArithFormula Var K) :
    depth (add left right) = max (depth left) (depth right) + 1 := by
  rfl

theorem depth_mul (left right : ArithFormula Var K) :
    depth (mul left right) = max (depth left) (depth right) + 1 := by
  rfl

theorem formalDegree_add_left_le (left right : ArithFormula Var K) :
    formalDegree left <= formalDegree (add left right) := by
  simp [formalDegree, le_max_left]

theorem formalDegree_add_right_le (left right : ArithFormula Var K) :
    formalDegree right <= formalDegree (add left right) := by
  simp [formalDegree, le_max_right]

theorem formalDegree_mul_eq (left right : ArithFormula Var K) :
    formalDegree (mul left right) = formalDegree left + formalDegree right := by
  rfl

theorem formalDegree_eq_of_isSyntacticallyHomogeneous :
    ∀ {degree : Nat} (formula : ArithFormula Var K),
      IsSyntacticallyHomogeneousOfDegree degree formula ->
        formalDegree formula = degree
  | degree, const c, h => by
      simpa [IsSyntacticallyHomogeneousOfDegree, formalDegree] using h.symm
  | degree, var v, h => by
      simpa [IsSyntacticallyHomogeneousOfDegree, formalDegree] using h.symm
  | degree, add left right, h => by
      rcases h with ⟨hleft, hright⟩
      have hleftDegree :=
        formalDegree_eq_of_isSyntacticallyHomogeneous left hleft
      have hrightDegree :=
        formalDegree_eq_of_isSyntacticallyHomogeneous right hright
      simp [formalDegree, hleftDegree, hrightDegree]
  | degree, mul left right, h => by
      rcases h with ⟨leftDegree, rightDegree, hleft, hright, hdegree⟩
      have hleftDegree :=
        formalDegree_eq_of_isSyntacticallyHomogeneous left hleft
      have hrightDegree :=
        formalDegree_eq_of_isSyntacticallyHomogeneous right hright
      simp [formalDegree, hleftDegree, hrightDegree, hdegree]

theorem eval_add [Semiring K] (env : Var -> K) (left right : ArithFormula Var K) :
    eval env (add left right) = eval env left + eval env right := by
  rfl

theorem eval_mul [Semiring K] (env : Var -> K) (left right : ArithFormula Var K) :
    eval env (mul left right) = eval env left * eval env right := by
  rfl

