    have hread (r : Fin n) (houtside : d*r.val+c.val<d*i.val ∨ d*i.val+l≤d*r.val+c.val) :
        (ρ.arrs basisS)[d*r.val+c.val]?=some (A r c).sign ∧
        (ρ.arrs basisN)[d*r.val+c.val]?=some (A r c).magnitude := by
