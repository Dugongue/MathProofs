  | nil => simp [SparseMemory.put, SparseMemory.read]
  | cons bv m ih =>
      rcases bv with ⟨b, u⟩
      by_cases h : a = b
      · subst b
        simp [SparseMemory.put, SparseMemory.read]
      · simp [SparseMemory.put, SparseMemory.read, h, ih]

