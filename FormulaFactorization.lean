def reserveCost {n : ℕ} (K : ℕ) : N0382.Formula n → ℕ
  | .const q => 2 + max K (N0090.ratWeight q)
  | .var _ => 2 + K
  | .add f g => 2 + reserveCost K f + reserveCost K g
  | .mul f g => 2 + reserveCost K f + reserveCost K g

theorem reserveCost_bound {n : ℕ} (K : ℕ) (f : N0382.Formula n) :
    reserveCost K f ≤ (K + 1) * N0090.bitCost (fun _ => 0) f := by
  induction f with
  | const q =>
      simp only [reserveCost, N0090.bitCost]
      rcases le_total K (N0090.ratWeight q) with h | h
      · rw [max_eq_right h]; nlinarith
      · rw [max_eq_left h]; nlinarith
  | var i => simp only [reserveCost, N0090.bitCost]; omega
  | add f g ihf ihg => simp only [reserveCost, N0090.bitCost] at ihf ihg ⊢; nlinarith
  | mul f g ihf ihg => simp only [reserveCost, N0090.bitCost] at ihf ihg ⊢; nlinarith

/-  Repeated grid substitutions never multiply the reserve; every node remains individually paid. -/
theorem headSpecialize_reserve {n : ℕ} (K i : ℕ) (hi : N0090.ratWeight (i : ℚ) ≤ K)
    (f : N0382.Formula (n + 1)) : reserveCost K (N0382.headSpecialize i f) ≤ reserveCost K f := by
  induction f with
  | const q => exact le_refl _
  | var v =>
      refine Fin.cases ?_ (fun j => ?_) v
      · simp only [N0382.headSpecialize, N0090.substitute, Fin.cases_zero, reserveCost, max_eq_left hi, le_refl]
      · simp only [N0382.headSpecialize, N0090.substitute, Fin.cases_succ, reserveCost, le_refl]
  | add f g ihf ihg => simp only [N0382.headSpecialize, N0090.substitute, reserveCost] at ihf ihg ⊢; omega
  | mul f g ihf ihg => simp only [N0382.headSpecialize, N0090.substitute, reserveCost] at ihf ihg ⊢; omega

inductive GridDescendant (D : ℕ) : {n m : ℕ} → N0382.Formula n → N0382.Formula m → Prop
  | same {n} (f : N0382.Formula n) : GridDescendant D f f
  | next {n m} {f : N0382.Formula n} {g : N0382.Formula (m + 1)}
      (h : GridDescendant D f g) (i : ℕ) (hi : i ≤ D) : GridDescendant D f (N0382.headSpecialize i g)

theorem descendant_dimension {D n m : ℕ} {f : N0382.Formula n} {g : N0382.Formula m}
    (h : GridDescendant D f g) : m ≤ n := by
  induction h with
  | same f => exact le_refl _
  | next h i hi ih => omega

theorem descendant_reserve {D n m : ℕ} {f : N0382.Formula n} {g : N0382.Formula m}
    (h : GridDescendant D f g) (K : ℕ) (hK : 2 * D + 5 ≤ K) : reserveCost K g ≤ reserveCost K f := by
  induction h with
  | same f => exact le_refl _
  | next h i hi ih => exact (headSpecialize_reserve K i ((N0206.natLiteral_bit_bound D i hi).trans hK) _).trans ih

def finiteWeight {n : ℕ} (i : Fin n) : ℕ := (N0090.natCode i.val).length

def finiteSource {n : ℕ} (f : N0382.Formula n) : List Bool :=
  N0090.encode (N0090.substitute (fun i => .var i.val) f)

theorem finiteSource_length {n : ℕ} (f : N0382.Formula n) :
    (finiteSource f).length = N0090.bitCost finiteWeight f := by
  rw [finiteSource, N0090.encode_length]
  induction f <;> simp only [N0090.substitute, N0090.bitCost, finiteWeight, *]

theorem finiteWeight_bound {n : ℕ} (i : Fin n) : finiteWeight i ≤ 2 * n + 1 := by
  have hs : i.val.size ≤ n := Nat.size_le.mpr (i.isLt.trans (Nat.lt_two_pow_self (n := n)))
  simp only [finiteWeight, N0090.natCode_length]
  omega

theorem finiteSource_le_reserve {n : ℕ} (K : ℕ) (hK : 2 * n + 1 ≤ K) (f : N0382.Formula n) :
    (finiteSource f).length ≤ reserveCost K f := by
  rw [finiteSource_length]
  induction f with
  | const q => simp only [N0090.bitCost, reserveCost]; omega
  | var i => exact Nat.add_le_add_left ((finiteWeight_bound i).trans hK) 2
  | add f g ihf ihg => simp only [N0090.bitCost, reserveCost] at ihf ihg ⊢; omega
  | mul f g ihf ihg => simp only [N0090.bitCost, reserveCost] at ihf ihg ⊢; omega

/-  Every bounded-grid descendant has a polynomial binary query length, uniformly in the depth. -/
theorem descendant_query_length {D n m : ℕ} {f : N0382.Formula n} {g : N0382.Formula m}
    (h : GridDescendant D f g) :
    (finiteSource g).length ≤ (2 * D + 2 * n + 7) * (finiteSource f).length := by
  have hmn := descendant_dimension h
  let K := 2 * D + 2 * n + 6
  have hleft := finiteSource_le_reserve K (by omega) g
  have hr := descendant_reserve h K (by omega)
  have hb := reserveCost_bound K f
  have hzero : N0090.bitCost (fun _ => 0) f ≤ (finiteSource f).length := by
    rw [finiteSource_length]
    exact N0344.bitCost_mono _ _ (fun _ => Nat.zero_le _) f
  exact hleft.trans (hr.trans (hb.trans (Nat.mul_le_mul_left _ hzero)))


abbrev Query := Σ n, N0382.Formula n

/-  Logical trace of the exact queries made by the existing chooseHead control flow. -/
def chooseQueries (pit : (n : ℕ) → N0382.Formula n → Bool) {n : ℕ}
    (f : N0382.Formula (n + 1)) : List ℕ → List Query
  | [] => []
  | i :: is => ⟨n, N0382.headSpecialize i f⟩ ::
      if pit n (N0382.headSpecialize i f) then chooseQueries pit f is else []










theorem chooseQueries_descendant (pit : (n : ℕ) → N0382.Formula n → Bool)
    {D N n : ℕ} {f : N0382.Formula N} (g : N0382.Formula (n + 1))
    (hfg : GridDescendant D f g) (is : List ℕ) (his : ∀ i ∈ is, i ≤ D)
    (q : Query) (hq : q ∈ chooseQueries pit g is) : GridDescendant D f q.2 := by
  induction is with
  | nil => simp only [chooseQueries, List.not_mem_nil] at hq
  | cons i is ih =>
      simp only [chooseQueries] at hq
      rcases List.mem_cons.mp hq with he | ht
      · subst q
        exact GridDescendant.next hfg i (his i (by simp))
      · by_cases hb : pit n (N0382.headSpecialize i g) = true
        · simp only [hb, ↓reduceIte] at ht
          exact ih (fun j hj => his j (by simp [hj])) ht
        · simp only [hb, Bool.false_eq_true, ↓reduceIte, List.not_mem_nil] at ht

/-  Logical trace mirrors findPoint's actual deterministic branches and existing counter. -/
def pointQueries (pit : (n : ℕ) → N0382.Formula n → Bool) (D : ℕ) :
    (n : ℕ) → N0382.Formula n → List Query
  | 0, _ => []
  | n + 1, f => chooseQueries pit f (List.range (D + 1)) ++
      match (N0382.chooseHead pit f (List.range (D + 1))).1 with
      | none => []
      | some i => pointQueries pit D n (N0382.headSpecialize i f)










theorem pointQueries_descendant (pit : (n : ℕ) → N0382.Formula n → Bool) (D n : ℕ)
    (g : N0382.Formula n) {N : ℕ} {f : N0382.Formula N}
    (hfg : GridDescendant D f g) (q : Query) (hq : q ∈ pointQueries pit D n g) :
    GridDescendant D f q.2 := by
  induction n with
  | zero => simp only [pointQueries, List.not_mem_nil] at hq
  | succ n ih =>
      simp only [pointQueries, List.mem_append] at hq
      rcases hq with hl | hr
      · exact chooseQueries_descendant pit g hfg _ (fun i hi => by
          have hh := List.mem_range.mp hi; omega) q hl
      · cases h : (N0382.chooseHead pit g (List.range (D + 1))).1 with
        | none => simp only [h, List.not_mem_nil] at hr
        | some i =>
            simp only [h] at hr
            have hi := (N0382.chooseHead_sound pit g (List.range (D + 1)) i h).1
            have hiD : i ≤ D := by have hh := List.mem_range.mp hi; omega
            exact ih (N0382.headSpecialize i g) (GridDescendant.next hfg i hiD) hr

/-  Each actual self-reduction PIT query has polynomial full binary length. -/
theorem pointQueries_encodedLength (pit : (n : ℕ) → N0382.Formula n → Bool) (D n : ℕ)
    (f : N0382.Formula n) (q : Query) (hq : q ∈ pointQueries pit D n f) :
    (finiteSource q.2).length ≤ (2 * D + 2 * n + 7) * (finiteSource f).length := by
  exact descendant_query_length (pointQueries_descendant pit D n f (GridDescendant.same f) q hq)


/-  The actual natural-name source sent to the fixed machine in Contracts. -/
def finiteFormula {n : ℕ} (f : N0382.Formula n) : RationalFormula :=
  N0090.substitute (fun i => .var i.val) f

theorem finiteFormula_isZero {n : ℕ} (f : N0382.Formula n) :
    N0382.IsZero f ↔ Internal.N0339.N0197.polynomial (finiteFormula f) = 0 := by
  constructor
