    (a : ι → ℚ) (A B : NumericPolynomial) (N : ℕ) (f : N0090.Formula (Option ι)) :
    N0090.bitCost u (radialClusterFormula a A B N f) ≤
      N0041.outputBudget A.natDegree N (max f.formalDegree (A*B).natDegree)
        (N0041.fiberHeight A)
        (N0041.residueHeight A B N (max f.formalDegree (A*B).natDegree))
        (perturbationBudget (A*B).natDegree (centerHeight a) (N0041.fiberHeight (A*B))
