    (stk : K → List α) : K → List β :=
  fun k => (stk k).map encode

def mapAlphabetCfg {α β K Λ σ : Type} (encode : α → β)
    (c : TM2.Cfg (fun _ : K => α) Λ σ) :
    TM2.Cfg (fun _ : K => β) Λ σ where
  l := c.l
  var := c.var
  stk := mapAlphabetStacks encode c.stk

