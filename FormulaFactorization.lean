private theorem scan_pay (p P : ℕ) (hP : 1 ≤ P) :
    4+((1+3+7000000000000*P)*p+1+3) ≤ 100000000000000*(p+1)*P := by
  have hm := Nat.mul_le_mul_right (p+1) hP
