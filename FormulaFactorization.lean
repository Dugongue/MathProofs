  intro n hn
  rw [PowerSeries.coeff_map, hA.degree_map φ]
  exact Polynomial.degree_map_le.trans_lt (hHdeg n hn)

/-  The specialized formal pair equals the actual polynomial factor pair. The
premises are literal coefficients, degree bounds and a polynomial product. -/
theorem mapped_lift_eq_actual_factors {A B : R[X]} (hA : A.Monic) (hAB : IsCoprime A B)
    (φ : R →+* S) (H K F : PowerSeries R[X]) (U V : Polynomial S[X])
    (hH0 : PowerSeries.coeff 0 H = A) (hK0 : PowerSeries.coeff 0 K = B)
    (hU0 : U.coeff 0 = A.map φ) (hV0 : V.coeff 0 = B.map φ)
    (hHdeg : ∀ n > 0, (PowerSeries.coeff n H).degree < A.degree)
    (hUdeg : ∀ n > 0, (U.coeff n).degree < (A.map φ).degree)
