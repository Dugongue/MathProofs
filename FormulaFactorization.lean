  have hmag : (madd a b c).magnitude<W := by
    exact (N0165.sumNum_le _ _ _ _).trans_lt (by simpa [asRat] using hprod)
  let η1 := η.setVar resultS (madd a b c).sign
  let τ := η1.setVar resultN (madd a b c).magnitude
  have rS : Run W (.assign resultS (.var accS)) η η1 2 :=
    Run.assign (evalB_var_iff.mpr ⟨hresS.symm,by rw [hresS]; exact (madd a b c).bit.trans_le (by omega)⟩)
  have rN : Run W (.assign resultN (.var accN)) η1 τ 2 := by
    apply Run.assign
    have hev : η1.vars accN=(madd a b c).magnitude := by simpa [η1,Env.setVar,accN,resultS] using hresN
    exact evalB_var_iff.mpr ⟨hev.symm,by rw [hev]; exact hmag⟩
  have hr : Run W call σ τ 160 := (hs.seq (hbody.seq (rS.seq rN))).mono (by omega)
  obtain ⟨hv,ha,hi,ho⟩ := call_frames hr
  refine ⟨τ,hr,?_,hv,ha,hi,ho⟩
  simp [CallResult,τ,η1,Env.setVar,resultS,resultN]


abbrev Data (n : ℕ) := Fin n → Fin n → Signed

def packed {n : ℕ} (A : Data n) : N0301.PackedMatrix n :=
  N0301.pack (fun i j => zval (A i j))
def DataBound {n : ℕ} (A : Data n) (H : ℕ) : Prop := ∀i j,(A i j).magnitude≤H

theorem data_get {n : ℕ} (A : Data n) (i j : Fin n) :
    BirdDet.get n (packed A).val i.val j.val=zval (A i j) := by
  rw [N0301.get_eq_unpack]
  exact congrFun (congrFun (N0301.unpack_pack _) i) j

theorem packed_bound {n H : ℕ} (A : Data n) (hA : DataBound A H) :
    N0287.EntryBound (packed A) H := by
  intro i j
  rw [packed,N0301.unpack_pack,← magnitude_eq_abs]
  exact hA i j


@[simp] theorem zero_value : zval zero=0 := rfl
@[simp] theorem one_value : zval one=1 := rfl

/-  Literal descending-loop data states: tail diagonal sum and tail dot product. -/
def tailState {n : ℕ} (A F : Data n) (i j : Fin n) (lo : ℕ) : Signed × Signed :=
  if h : lo<n then
    let r := tailState A F i j (lo+1)
    (madd (F ⟨lo,h⟩ ⟨lo,h⟩) one r.1,madd (F i ⟨lo,h⟩) (A ⟨lo,h⟩ j) r.2)
  else (zero,zero)
termination_by n-lo

theorem partial_correct {n : ℕ} (A F : Data n) (i j : Fin n) (lo : ℕ) :
    zval (tailState A F i j lo).1=BirdDet.sumFrom n lo (fun k => BirdDet.get n (packed F).val k k) ∧
    zval (tailState A F i j lo).2=BirdDet.sumFrom n lo
      (fun k => BirdDet.get n (packed F).val i.val k*BirdDet.get n (packed A).val k j.val) := by
  induction lo using BirdDet.sumFrom_induct n with
  | step lo hlo ih =>
    rw [tailState]
    simp only [hlo,↓reduceDIte]
    rw [BirdDet.sumFrom_step _ _ _ hlo,BirdDet.sumFrom_step _ _ _ hlo]
    rw [data_get F ⟨lo,hlo⟩ ⟨lo,hlo⟩,data_get F i ⟨lo,hlo⟩,data_get A ⟨lo,hlo⟩ j]
    simp only [madd_value,one_value,mul_one,ih.1,ih.2]
    simp
  | stop lo hlo =>
    rw [tailState]
    simp [hlo,BirdDet.sumFrom_stop _ _ _ hlo]

def entryValue {n : ℕ} (A F : Data n) (i j : Fin n) : Signed :=
  let r := tailState A F i j (i.val+1)
  madd (neg r.1) (A i j) r.2

theorem entryValue_correct {n : ℕ} (A F : Data n) (i j : Fin n) :
    zval (entryValue A F i j)=BirdDet.stepEntry n (packed A).val (BirdDet.get n (packed F).val) i.val j.val := by
  simp only [entryValue,madd_value,neg_value]
  rw [(partial_correct A F i j (i.val+1)).1,(partial_correct A F i j (i.val+1)).2]
  unfold BirdDet.stepEntry
  rw [data_get A i j]

theorem partial_bounds {n M H : ℕ} (A F : Data n) (hA : DataBound A M) (hF : DataBound F H)
    (i j : Fin n) (lo : ℕ) :
    (tailState A F i j lo).1.magnitude≤N0287.radix n M*H ∧
    (tailState A F i j lo).2.magnitude≤N0287.radix n M*H := by
  obtain ⟨hd,hr,hs⟩ := N0287.intermediate_bound
    (packed A) (packed F) (packed_bound A hA) (packed_bound F hF) i j lo
  rw [magnitude_eq_abs,(partial_correct A F i j lo).1]
  rw [magnitude_eq_abs,(partial_correct A F i j lo).2]
  exact ⟨hd,hr⟩

theorem transition_bounds {n M H : ℕ} (A F : Data n) (hA : DataBound A M) (hF : DataBound F H)
    (i j k : Fin n) :
    (F k k).magnitude*one.magnitude+(tailState A F i j (k.val+1)).1.magnitude≤N0287.radix n M*H ∧
    (F i k).magnitude*(A k j).magnitude+(tailState A F i j (k.val+1)).2.magnitude≤N0287.radix n M*H := by
  obtain ⟨hd,hr⟩ := N0287.partial_addition_bound
    (packed A) (packed F) (packed_bound A hA) (packed_bound F hF) i j k (k.val+1)
  rw [← (partial_correct A F i j (k.val+1)).1,data_get F k k] at hd
  rw [← (partial_correct A F i j (k.val+1)).2,data_get F i k,data_get A k j] at hr
  constructor
  · simpa only [← magnitude_eq_abs,one,Nat.mul_one,Nat.add_comm] using hd
  · simpa only [Int.natAbs_mul,← magnitude_eq_abs,Nat.add_comm] using hr

theorem finish_bound {n M H : ℕ} (A F : Data n) (hA : DataBound A M) (hF : DataBound F H)
    (i j : Fin n) :
    (neg (tailState A F i j (i.val+1)).1).magnitude*(A i j).magnitude+
      (tailState A F i j (i.val+1)).2.magnitude≤N0287.radix n M*H := by
  have hs := (N0287.intermediate_bound
    (packed A) (packed F) (packed_bound A hA) (packed_bound F hF) i j (i.val+1)).2.2
  rw [← (partial_correct A F i j (i.val+1)).1,← (partial_correct A F i j (i.val+1)).2,data_get A i j] at hs
  simpa only [← magnitude_eq_abs,neg] using hs


def matrixAS : String := "LLL.Bird.matrix.AS"
def matrixAN : String := "LLL.Bird.matrix.AN"
def matrixFS : String := "LLL.Bird.matrix.FS"
def matrixFN : String := "LLL.Bird.matrix.FN"
def matrixGS : String := "LLL.Bird.matrix.GS"
def matrixGN : String := "LLL.Bird.matrix.GN"
def nVar : String := "LLL.Bird.n"
def rowVar : String := "LLL.Bird.row"
def colVar : String := "LLL.Bird.col"
def kVar : String := "LLL.Bird.k"
def diagS : String := "LLL.Bird.diagS"
def diagN : String := "LLL.Bird.diagN"
def dotS : String := "LLL.Bird.dotS"
def dotN : String := "LLL.Bird.dotN"
def linearVar : String := "LLL.Bird.linear"
def stageVar : String := "LLL.Bird.stage"

def addressExpr (r c : Expr) : Expr := .bin .add (.bin .mul (.var nVar) r) c

def diagArgs : Com := .seq (.assign argAS (.get matrixFS (addressExpr (.var kVar) (.var kVar))))
  (.seq (.assign argAN (.get matrixFN (addressExpr (.var kVar) (.var kVar))))
    (.seq (.assign argBS (.lit 0)) (.seq (.assign argBN (.lit 1))
      (.seq (.assign argCS (.var diagS)) (.assign argCN (.var diagN))))))
def dotArgs : Com := .seq (.assign argAS (.get matrixFS (addressExpr (.var rowVar) (.var kVar))))
  (.seq (.assign argAN (.get matrixFN (addressExpr (.var rowVar) (.var kVar))))
    (.seq (.assign argBS (.get matrixAS (addressExpr (.var kVar) (.var colVar))))
      (.seq (.assign argBN (.get matrixAN (addressExpr (.var kVar) (.var colVar))))
        (.seq (.assign argCS (.var dotS)) (.assign argCN (.var dotN))))))
def finishArgs : Com := .seq (.assign argAS (.bin .sub (.lit 1) (.var diagS)))
  (.seq (.assign argAN (.var diagN))
    (.seq (.assign argBS (.get matrixAS (addressExpr (.var rowVar) (.var colVar))))
      (.seq (.assign argBN (.get matrixAN (addressExpr (.var rowVar) (.var colVar))))
        (.seq (.assign argCS (.var dotS)) (.assign argCN (.var dotN))))))
def savePair (s n : String) : Com := .seq (.assign s (.var resultS)) (.assign n (.var resultN))
def entryStep : Com := .seq diagArgs (.seq call (.seq (savePair diagS diagN)
  (.seq dotArgs (.seq call (savePair dotS dotN)))))
def entryBody : Com := .seq (.assign kVar (.bin .sub (.var kVar) (.lit 1))) entryStep
def entryLoop : Com := .while (.lt (.bin .add (.var rowVar) (.lit 1)) (.var kVar)) entryBody

def entryInit : Com := .seq (.assign kVar (.var nVar))
  (.seq (.assign diagS (.lit 0)) (.seq (.assign diagN (.lit 0))
    (.seq (.assign dotS (.lit 0)) (.assign dotN (.lit 0)))))
def entry : Com := .seq entryInit (.seq entryLoop (.seq finishArgs call))

def Arrays {n : ℕ} (σ : Env) (sarr narr : String) (A : Data n) : Prop :=
  ∀i j : Fin n,(σ.arrs sarr)[n*i.val+j.val]?=some (A i j).sign ∧
    (σ.arrs narr)[n*i.val+j.val]?=some (A i j).magnitude

def PairRep (σ : Env) (s v : String) (a : Signed) : Prop := σ.vars s=a.sign ∧ σ.vars v=a.magnitude

def ScratchReady (σ : Env) : Prop :=
  (σ.arrs coeffS).length=1 ∧ (σ.arrs coeffN).length=1 ∧ (σ.arrs coeffD).length=1

theorem row_address_lt {n : ℕ} (i j : Fin n) : n*i.val+j.val<n*n := by
  have hi:=i.isLt
  have hj:=j.isLt
  have hh := Nat.mul_le_mul_left n (show i.val+1≤n by omega)
  nlinarith



























open Internal.N0339.N0256

theorem diagArgs_run {W n : ℕ} (σ : Env) (F : Data n) (k : Fin n) (d : Signed)
    (hF : Arrays σ matrixFS matrixFN F) (hn : σ.vars nVar=n) (hk : σ.vars kVar=k.val)
    (hd : PairRep σ diagS diagN d) (hW : n*n<W) (hW3 : 3≤W)
    (hmag : (F k k).magnitude<W) (hdmag : d.magnitude<W) :
    ∃τ,Run W diagArgs σ τ 30 ∧ CallArgs τ (F k k) one d := by
  have hfs := (hF k k).1
  have hfn := (hF k k).2
  have hls := (List.getElem?_eq_some_iff.mp hfs).1
  have hln := (List.getElem?_eq_some_iff.mp hfn).1
  have hvs : (σ.arrs matrixFS).getD (n*k.val+k.val) 0=(F k k).sign := by
    simp only [List.getD_eq_getElem?_getD,hfs,Option.getD_some]
  have hvn : (σ.arrs matrixFN).getD (n*k.val+k.val) 0=(F k k).magnitude := by
    simp only [List.getD_eq_getElem?_getD,hfn,Option.getD_some]
  have ha := (row_address_lt k k).trans hW
  have hnpos : 0<n := Nat.zero_lt_of_lt k.isLt
  have hnb : n<W := by nlinarith
  have hkb : k.val<W := k.isLt.trans hnb
  have hmul : n*k.val<W := by omega
  have hfsb : (F k k).sign<W := (F k k).bit.trans_le (by omega)
  have hdsb : d.sign<W := d.bit.trans_le (by omega)
  rcases hd with ⟨hds,hdn⟩
  simp only [nVar,kVar,diagS,diagN,matrixFS,matrixFN] at hn hk hds hdn hls hln hvs hvn
  imp_vcgen [diagArgs,addressExpr,CallArgs,one,argAS,argAN,argBS,argBN,argCS,argCN,
    nVar,kVar,diagS,diagN,matrixFS,matrixFN,hn,hk,hds,hdn,hls,hln,hvs,hvn,hnb,hkb,hmul,ha,hfsb,hdsb,hmag,hdmag]
  all_goals simp


theorem madd_magnitude_le (a b c : Signed) : (madd a b c).magnitude≤a.magnitude*b.magnitude+c.magnitude := by
  simpa only [madd,step,asRat,Nat.mul_one] using N0165.sumNum_le
    (N0166.xorSign a.sign b.sign) c.sign (a.magnitude*b.magnitude) c.magnitude

theorem scratchReady_of_run {W K : ℕ} {c : Com} {σ τ : Env} (hr : Run W c σ τ K)
    (h : ScratchReady σ) : ScratchReady τ := by
  have hl := (run_frame hr).2.2.1
  simpa only [ScratchReady,hl] using h

theorem savePair_run {W : ℕ} (σ : Env) (s v : String) (a : Signed)
    (hr : CallResult σ a) (hread : resultN≠s) (hne : s≠v)
    (hW : 2≤W) (hm : a.magnitude<W) :
    ∃τ,Run W (savePair s v) σ τ 4 ∧ PairRep τ s v a := by
  rcases hr with ⟨hs,hn⟩
  let ρ := σ.setVar s a.sign
  let τ := ρ.setVar v a.magnitude
  have r1 : Run W (.assign s (.var resultS)) σ ρ 2 :=
    Run.assign (evalB_var_iff.mpr ⟨hs.symm,by rw [hs]; exact a.bit.trans_le hW⟩)
  have hnρ : ρ.vars resultN=a.magnitude := by simpa [ρ,Env.setVar,hread] using hn
  have r2 : Run W (.assign v (.var resultN)) ρ τ 2 :=
    Run.assign (evalB_var_iff.mpr ⟨hnρ.symm,by rw [hnρ]; exact hm⟩)
  refine ⟨τ,r1.seq r2,?_⟩
  simp [PairRep,τ,ρ,Env.setVar,hne]

theorem dotArgs_run {W n : ℕ} (σ : Env) (A F : Data n) (i j k : Fin n) (d : Signed)
    (hA : Arrays σ matrixAS matrixAN A) (hF : Arrays σ matrixFS matrixFN F)
    (hn : σ.vars nVar=n) (hi : σ.vars rowVar=i.val) (hj : σ.vars colVar=j.val) (hk : σ.vars kVar=k.val)
    (hd : PairRep σ dotS dotN d) (hW : n*n<W) (hW3 : 3≤W)
    (hfmag : (F i k).magnitude<W) (hamag : (A k j).magnitude<W) (hdmag : d.magnitude<W) :
    ∃τ,Run W dotArgs σ τ 40 ∧ CallArgs τ (F i k) (A k j) d := by
  have hfs := (hF i k).1
  have hfn := (hF i k).2
  have has := (hA k j).1
  have han := (hA k j).2
  have hfls := (List.getElem?_eq_some_iff.mp hfs).1
  have hfln := (List.getElem?_eq_some_iff.mp hfn).1
  have hals := (List.getElem?_eq_some_iff.mp has).1
  have haln := (List.getElem?_eq_some_iff.mp han).1
  have hfvs : (σ.arrs matrixFS).getD (n*i.val+k.val) 0=(F i k).sign := by simp only [List.getD_eq_getElem?_getD,hfs,Option.getD_some]
  have hfvn : (σ.arrs matrixFN).getD (n*i.val+k.val) 0=(F i k).magnitude := by simp only [List.getD_eq_getElem?_getD,hfn,Option.getD_some]
  have havs : (σ.arrs matrixAS).getD (n*k.val+j.val) 0=(A k j).sign := by simp only [List.getD_eq_getElem?_getD,has,Option.getD_some]
  have havn : (σ.arrs matrixAN).getD (n*k.val+j.val) 0=(A k j).magnitude := by simp only [List.getD_eq_getElem?_getD,han,Option.getD_some]
  have hfa := (row_address_lt i k).trans hW
  have haa := (row_address_lt k j).trans hW
  have hnpos : 0<n := Nat.zero_lt_of_lt k.isLt
  have hnb : n<W := by nlinarith
  have hib : i.val<W := i.isLt.trans hnb
  have hjb : j.val<W := j.isLt.trans hnb
  have hkb : k.val<W := k.isLt.trans hnb
  have hmi : n*i.val<W := by omega
  have hmk : n*k.val<W := by omega
  have hfsb : (F i k).sign<W := (F i k).bit.trans_le (by omega)
  have hasb : (A k j).sign<W := (A k j).bit.trans_le (by omega)
  have hdsb : d.sign<W := d.bit.trans_le (by omega)
  rcases hd with ⟨hds,hdn⟩
  simp only [nVar,rowVar,colVar,kVar,dotS,dotN,matrixAS,matrixAN,matrixFS,matrixFN] at hn hi hj hk hds hdn hfls hfln hals haln hfvs hfvn havs havn
  imp_vcgen [dotArgs,addressExpr,CallArgs,argAS,argAN,argBS,argBN,argCS,argCN,nVar,rowVar,colVar,kVar,dotS,dotN,
    matrixAS,matrixAN,matrixFS,matrixFN,hn,hi,hj,hk,hds,hdn,hfls,hfln,hals,haln,hfvs,hfvn,havs,havn,hfa,haa,hnb,hib,hjb,hkb,hmi,hmk,hfsb,hasb,hdsb,hfmag,hamag,hdmag]
  all_goals simp

theorem finishArgs_run {W n : ℕ} (σ : Env) (A : Data n) (i j : Fin n) (d e : Signed)
    (hA : Arrays σ matrixAS matrixAN A)
    (hn : σ.vars nVar=n) (hi : σ.vars rowVar=i.val) (hj : σ.vars colVar=j.val)
    (hd : PairRep σ diagS diagN d) (he : PairRep σ dotS dotN e) (hW : n*n<W) (hW3 : 3≤W)
    (hamag : (A i j).magnitude<W) (hdmag : d.magnitude<W) (hemag : e.magnitude<W) :
    ∃τ,Run W finishArgs σ τ 30 ∧ CallArgs τ (neg d) (A i j) e := by
  have has := (hA i j).1
  have han := (hA i j).2
  have hals := (List.getElem?_eq_some_iff.mp has).1
  have haln := (List.getElem?_eq_some_iff.mp han).1
  have havs : (σ.arrs matrixAS).getD (n*i.val+j.val) 0=(A i j).sign := by simp only [List.getD_eq_getElem?_getD,has,Option.getD_some]
  have havn : (σ.arrs matrixAN).getD (n*i.val+j.val) 0=(A i j).magnitude := by simp only [List.getD_eq_getElem?_getD,han,Option.getD_some]
  have haa := (row_address_lt i j).trans hW
  have hnpos : 0<n := Nat.zero_lt_of_lt i.isLt
  have hnb : n<W := by nlinarith
  have hib : i.val<W := i.isLt.trans hnb
  have hjb : j.val<W := j.isLt.trans hnb
  have hmi : n*i.val<W := by omega
  have hasb : (A i j).sign<W := (A i j).bit.trans_le (by omega)
  have hdsb : d.sign<W := d.bit.trans_le (by omega)
  have hesb : e.sign<W := e.bit.trans_le (by omega)
  rcases hd with ⟨hds,hdn⟩
  rcases he with ⟨hes,hen⟩
  simp only [nVar,rowVar,colVar,diagS,diagN,dotS,dotN,matrixAS,matrixAN] at hn hi hj hds hdn hes hen hals haln havs havn
  imp_vcgen [finishArgs,addressExpr,CallArgs,neg,argAS,argAN,argBS,argBN,argCS,argCN,nVar,rowVar,colVar,diagS,diagN,dotS,dotN,
    matrixAS,matrixAN,hn,hi,hj,hds,hdn,hes,hen,hals,haln,havs,havn,haa,hnb,hib,hjb,hmi,hasb,hdsb,hesb,hamag,hdmag,hemag]
  all_goals simp


def Context {n : ℕ} (σ : Env) (A F : Data n) (i j : Fin n) (k : ℕ) : Prop :=
  σ.vars nVar=n ∧ σ.vars rowVar=i.val ∧ σ.vars colVar=j.val ∧ σ.vars kVar=k ∧
    Arrays σ matrixAS matrixAN A ∧ Arrays σ matrixFS matrixFN F ∧ ScratchReady σ

abbrev KeepsContext (c : Com) : Prop :=
  nVar∉scalarWrites c ∧ rowVar∉scalarWrites c ∧ colVar∉scalarWrites c ∧ kVar∉scalarWrites c ∧
    matrixAS∉arrayWrites c ∧ matrixAN∉arrayWrites c ∧ matrixFS∉arrayWrites c ∧ matrixFN∉arrayWrites c

theorem context_frame {n : ℕ} {σ τ : Env} {A F : Data n} {i j : Fin n} {k : ℕ} {c : Com}
    (h : Context σ A F i j k) (hf : Frame c σ τ) (hc : KeepsContext c) : Context τ A F i j k := by
  rcases h with ⟨hn,hi,hj,hk,hA,hF,hready⟩
  rcases hc with ⟨hwn,hwi,hwj,hwk,hAS,hAN,hFS,hFN⟩
  refine ⟨(hf.vars _ hwn).trans hn,(hf.vars _ hwi).trans hi,(hf.vars _ hwj).trans hj,
    (hf.vars _ hwk).trans hk,?_,?_,?_⟩
  · intro r s
    rw [hf.arrs _ hAS,hf.arrs _ hAN]
    exact hA r s
  · intro r s
    rw [hf.arrs _ hFS,hf.arrs _ hFN]
    exact hF r s
  · simpa only [ScratchReady,hf.len] using hready

theorem pair_frame {σ τ : Env} {s v : String} {a : Signed} {c : Com}
    (h : PairRep σ s v a) (hf : Frame c σ τ) (hs : s∉scalarWrites c) (hv : v∉scalarWrites c) :
    PairRep τ s v a := ⟨(hf.vars _ hs).trans h.1,(hf.vars _ hv).trans h.2⟩

/-  Two actual multiply-add calls implement one descending Bird summation step. -/
theorem entryStep_run {W n : ℕ} (σ : Env) (A F : Data n) (i j k : Fin n) (d e : Signed)
    (hctx : Context σ A F i j k.val) (hd : PairRep σ diagS diagN d) (he : PairRep σ dotS dotN e)
    (hW : n*n<W) (hW3 : 3≤W)
    (hff : (F k k).magnitude<W) (hfi : (F i k).magnitude<W) (ha : (A k j).magnitude<W)
    (hdb : d.magnitude<W) (heb : e.magnitude<W)
    (hdprod : (F k k).magnitude*one.magnitude+d.magnitude<W)
    (heprod : (F i k).magnitude*(A k j).magnitude+e.magnitude<W) :
    ∃τ,Run W entryStep σ τ 450 ∧ Context τ A F i j k.val ∧
      PairRep τ diagS diagN (madd (F k k) one d) ∧ PairRep τ dotS dotN (madd (F i k) (A k j) e) := by
  have hdout : (madd (F k k) one d).magnitude<W := (madd_magnitude_le _ _ _).trans_lt hdprod
  have heout : (madd (F i k) (A k j) e).magnitude<W := (madd_magnitude_le _ _ _).trans_lt heprod
  imp_vcgen [entryStep]
  refine vc_spec (diagArgs_run σ F k d hctx.2.2.2.2.2.1 hctx.1 hctx.2.2.2.1 hd hW hW3 hff hdb) ?_
  rintro ρ1 t1 hargs1 fr1 ht1
  have cx1 := context_frame hctx fr1 (by decide)
  have he1 := pair_frame he fr1 (by decide) (by decide)
  refine vc_spec (call_run ρ1 (F k k) one d hargs1 hW3 hff (by simp [one]; omega) hdb hdprod
    cx1.2.2.2.2.2.2.1 cx1.2.2.2.2.2.2.2.1 cx1.2.2.2.2.2.2.2.2) ?_
  rintro ρ2 t2 ⟨hres1,hv1,ha1,hi1,ho1⟩ fr2 ht2
  have cx2 := context_frame cx1 fr2 (by decide)
  have he2 := pair_frame he1 fr2 (by decide) (by decide)
  refine vc_spec (savePair_run ρ2 diagS diagN (madd (F k k) one d) hres1 (by decide) (by decide) (by omega) hdout) ?_
  rintro ρ3 t3 hd3 fr3 ht3
  have cx3 := context_frame cx2 fr3 (by decide)
  have he3 := pair_frame he2 fr3 (by decide) (by decide)
  refine vc_spec (dotArgs_run ρ3 A F i j k e cx3.2.2.2.2.1 cx3.2.2.2.2.2.1
    cx3.1 cx3.2.1 cx3.2.2.1 cx3.2.2.2.1 he3 hW hW3 hfi ha heb) ?_
  rintro ρ4 t4 hargs2 fr4 ht4
  have cx4 := context_frame cx3 fr4 (by decide)
  have hd4 := pair_frame hd3 fr4 (by decide) (by decide)
  refine vc_spec (call_run ρ4 (F i k) (A k j) e hargs2 hW3 hfi ha heb heprod
    cx4.2.2.2.2.2.2.1 cx4.2.2.2.2.2.2.2.1 cx4.2.2.2.2.2.2.2.2) ?_
  rintro ρ5 t5 ⟨hres2,hv2,ha2,hi2,ho2⟩ fr5 ht5
  have cx5 := context_frame cx4 fr5 (by decide)
  have hd5 := pair_frame hd4 fr5 (by decide) (by decide)
  refine vc_spec (savePair_run ρ5 dotS dotN (madd (F i k) (A k j) e) hres2 (by decide) (by decide) (by omega) heout) ?_
  rintro ρ6 t6 he6 fr6 ht6
  have cx6 := context_frame cx5 fr6 (by decide)
  have hd6 := pair_frame hd5 fr6 (by decide) (by decide)
  exact ⟨by omega,fun _ => ⟨cx6,hd6,he6⟩⟩


theorem tailState_step {n : ℕ} (A F : Data n) (i j k : Fin n) :
    tailState A F i j k.val=
      (madd (F k k) one (tailState A F i j (k.val+1)).1,
        madd (F i k) (A k j) (tailState A F i j (k.val+1)).2) := by
  rw [tailState]
  simp only [dif_pos k.isLt]

theorem entryBody_run {W n M H k : ℕ} (σ : Env) (A F : Data n) (i j : Fin n)
    (hctx : Context σ A F i j k)
    (hd : PairRep σ diagS diagN (tailState A F i j k).1)
    (he : PairRep σ dotS dotN (tailState A F i j k).2)
    (hlo : i.val+1<k) (hkn : k≤n) (hA : DataBound A M) (hF : DataBound F H)
    (hW : n*n<W) (hW3 : 3≤W) (hM : M<W) (hH : H<W)
    (hcap : N0287.radix n M*H<W) :
    ∃τ,Run W entryBody σ τ 500 ∧ Context τ A F i j (k-1) ∧
      PairRep τ diagS diagN (tailState A F i j (k-1)).1 ∧
      PairRep τ dotS dotN (tailState A F i j (k-1)).2 := by
  let kk : Fin n := ⟨k-1,by omega⟩
  have hnext : kk.val+1=k := by dsimp [kk]; omega
  let σk := σ.setVar kVar (k-1)
  have hnpos : 0<n := Nat.zero_lt_of_lt i.isLt
  have hnb : n<W := by nlinarith
  have er : (Expr.var kVar).evalB W σ=some k :=
    evalB_var_iff.mpr ⟨hctx.2.2.2.1.symm,by rw [hctx.2.2.2.1]; omega⟩
  have rd : Run W (.assign kVar (.bin .sub (.var kVar) (.lit 1))) σ σk 4 :=
    Run.assign (evalB_bin (op:=.sub) er (evalB_lit (by omega)) (by change k-1<W; omega))
  have fr := Frame.of_run rd
  have cx : Context σk A F i j kk.val := by
    refine ⟨(fr.vars nVar (by decide)).trans hctx.1,(fr.vars rowVar (by decide)).trans hctx.2.1,
      (fr.vars colVar (by decide)).trans hctx.2.2.1,?_,?_,?_,scratchReady_of_run rd hctx.2.2.2.2.2.2⟩
    · simp [σk,Env.setVar,kk]
    · intro r s
      rw [fr.arrs matrixAS (by decide),fr.arrs matrixAN (by decide)]
      exact hctx.2.2.2.2.1 r s
    · intro r s
      rw [fr.arrs matrixFS (by decide),fr.arrs matrixFN (by decide)]
      exact hctx.2.2.2.2.2.1 r s
  have hdk := pair_frame hd fr (by decide) (by decide)
  have hek := pair_frame he fr (by decide) (by decide)
  have hbounds := transition_bounds A F hA hF i j kk
  rw [hnext] at hbounds
  have hparts := partial_bounds A F hA hF i j k
  obtain ⟨τ,hr,hcx,hdτ,heτ⟩ := entryStep_run σk A F i j kk
    (tailState A F i j k).1 (tailState A F i j k).2 cx hdk hek hW hW3
    ((hF kk kk).trans_lt hH) ((hF i kk).trans_lt hH) ((hA kk j).trans_lt hM)
    (hparts.1.trans_lt hcap) (hparts.2.trans_lt hcap)
    (hbounds.1.trans_lt hcap) (hbounds.2.trans_lt hcap)
  have hdval : madd (F kk kk) one (tailState A F i j k).1=(tailState A F i j (k-1)).1 := by
    simpa only [hnext] using (congrArg Prod.fst (tailState_step A F i j kk)).symm
  have heval : madd (F i kk) (A kk j) (tailState A F i j k).2=(tailState A F i j (k-1)).2 := by
    simpa only [hnext] using (congrArg Prod.snd (tailState_step A F i j kk)).symm
  refine ⟨τ,(rd.seq hr).mono (by omega),hcx,?_,?_⟩
  · simpa only [hdval] using hdτ
  · simpa only [heval] using heτ


theorem entryInit_run {W n : ℕ} (σ : Env) (A F : Data n) (i j : Fin n)
    (hn : σ.vars nVar=n) (hi : σ.vars rowVar=i.val) (hj : σ.vars colVar=j.val)
    (hA : Arrays σ matrixAS matrixAN A) (hF : Arrays σ matrixFS matrixFN F) (hready : ScratchReady σ)
    (hnW : n<W) (hW3 : 3≤W) :
    ∃τ,Run W entryInit σ τ 10 ∧ Context τ A F i j n ∧ PairRep τ diagS diagN zero ∧ PairRep τ dotS dotN zero := by
  let σ1 := σ.setVar kVar n
  let σ2 := σ1.setVar diagS 0
  let σ3 := σ2.setVar diagN 0
  let σ4 := σ3.setVar dotS 0
  let τ := σ4.setVar dotN 0
  have r1 : Run W (.assign kVar (.var nVar)) σ σ1 2 :=
    Run.assign (evalB_var_iff.mpr ⟨hn.symm,by rw [hn]; exact hnW⟩)
  have r2 : Run W (.assign diagS (.lit 0)) σ1 σ2 2 := Run.assign (evalB_lit (by omega))
  have r3 : Run W (.assign diagN (.lit 0)) σ2 σ3 2 := Run.assign (evalB_lit (by omega))
  have r4 : Run W (.assign dotS (.lit 0)) σ3 σ4 2 := Run.assign (evalB_lit (by omega))
  have r5 : Run W (.assign dotN (.lit 0)) σ4 τ 2 := Run.assign (evalB_lit (by omega))
  have hr : Run W entryInit σ τ 10 := r1.seq (r2.seq (r3.seq (r4.seq r5)))
  have fr := Frame.of_run hr
  refine ⟨τ,hr,?_,?_,?_⟩
  · refine ⟨(fr.vars nVar (by decide)).trans hn,(fr.vars rowVar (by decide)).trans hi,
      (fr.vars colVar (by decide)).trans hj,?_,?_,?_,scratchReady_of_run hr hready⟩
    · simp [τ,σ4,σ3,σ2,σ1,Env.setVar,kVar,diagS,diagN,dotS,dotN]
    · intro r c
      rw [fr.arrs matrixAS (by decide),fr.arrs matrixAN (by decide)]
      exact hA r c
    · intro r c
      rw [fr.arrs matrixFS (by decide),fr.arrs matrixFN (by decide)]
      exact hF r c
  · simp [PairRep,τ,σ4,σ3,σ2,σ1,Env.setVar,zero,kVar,diagS,diagN,dotS,dotN]
  · simp [PairRep,τ,σ4,σ3,σ2,σ1,Env.setVar,zero,kVar,diagS,diagN,dotS,dotN]

theorem entryLoop_run {W n M H : ℕ} (σ : Env) (A F : Data n) (i j : Fin n)
    (hctx : Context σ A F i j n) (hd : PairRep σ diagS diagN zero) (he : PairRep σ dotS dotN zero)
    (hA : DataBound A M) (hF : DataBound F H) (hW : n*n<W) (hW3 : 3≤W)
    (hM : M<W) (hH : H<W) (hcap : N0287.radix n M*H<W) :
    ∃τ,Run W entryLoop σ τ (600*(n+1)) ∧ Context τ A F i j (i.val+1) ∧
      PairRep τ diagS diagN (tailState A F i j (i.val+1)).1 ∧
      PairRep τ dotS dotN (tailState A F i j (i.val+1)).2 := by
  have hnpos : 0<n := Nat.zero_lt_of_lt i.isLt
  have hnb : n<W := by nlinarith
  let I : Env → Prop := fun ρ => ∃k,i.val+1≤k ∧ k≤n ∧ Context ρ A F i j k ∧
    PairRep ρ diagS diagN (tailState A F i j k).1 ∧ PairRep ρ dotS dotN (tailState A F i j k).2
  let V : Env → ℕ := fun ρ => ρ.vars kVar-(i.val+1)
  have hcond (ρ : Env) (k : ℕ) (hc : Context ρ A F i j k) (hkn : k≤n) :
      (Cond.lt (.bin .add (.var rowVar) (.lit 1)) (.var kVar)).evalB W ρ=some (decide (i.val+1<k)) := by
    have er : (Expr.var rowVar).evalB W ρ=some i.val :=
      evalB_var_iff.mpr ⟨hc.2.1.symm,by rw [hc.2.1]; exact i.isLt.trans hnb⟩
    have ek : (Expr.var kVar).evalB W ρ=some k :=
      evalB_var_iff.mpr ⟨hc.2.2.2.1.symm,by rw [hc.2.2.2.1]; omega⟩
    exact evalB_condLt (evalB_bin (op:=.add) er (evalB_lit (by omega)) (by change i.val+1<W; omega)) ek
  have hdef : ∀ρ,I ρ → ∃v,(Cond.lt (.bin .add (.var rowVar) (.lit 1)) (.var kVar)).evalB W ρ=some v := by
    rintro ρ ⟨k,hlo,hkn,hcx,hdρ,heρ⟩
    exact ⟨_,hcond ρ k hcx hkn⟩
  have hstep : ∀ρ,I ρ → (Cond.lt (.bin .add (.var rowVar) (.lit 1)) (.var kVar)).evalB W ρ=some true →
      ∃τ,Run W entryBody ρ τ 500 ∧ I τ ∧ V τ<V ρ := by
    rintro ρ ⟨k,hlo,hkn,hcx,hdρ,heρ⟩ ht
    rw [hcond ρ k hcx hkn] at ht
    have hklo : i.val+1<k := by simpa using ht
    obtain ⟨τ,hr,hct,hdτ,heτ⟩ := entryBody_run ρ A F i j hcx hdρ heρ hklo hkn hA hF hW hW3 hM hH hcap
    refine ⟨τ,hr,⟨k-1,by omega,by omega,hct,hdτ,heτ⟩,?_⟩
    dsimp [V]
    rw [hct.2.2.2.1,hcx.2.2.2.1]
    omega
  have hzero : tailState A F i j n=(zero,zero) := by rw [tailState]; simp
  have hI : I σ := ⟨n,by omega,le_rfl,hctx,by simpa only [hzero] using hd,by simpa only [hzero] using he⟩
  obtain ⟨τ,hr,⟨k,hlo,hkn,hcx,hdτ,heτ⟩,hf⟩ := Run.while_count I V 500 hdef hstep hI
  rw [hcond τ k hcx hkn] at hf
  have hnot : ¬i.val+1<k := by simpa using hf
  have hk : k=i.val+1 := by omega
  subst k
  refine ⟨τ,hr.mono ?_,hcx,hdτ,heτ⟩
  simp only [V,Cond.size,Expr.size,hctx.2.2.2.1]
  have hh : n-(i.val+1)≤n := Nat.sub_le _ _
  nlinarith

/-  Actual complete Bird-entry source, with its descending array-reading loop,
three real signed multiply-adds and exact integer recurrence result. -/
theorem entry_run {W n M H : ℕ} (σ : Env) (A F : Data n) (i j : Fin n)
    (hn : σ.vars nVar=n) (hi : σ.vars rowVar=i.val) (hj : σ.vars colVar=j.val)
    (hAA : Arrays σ matrixAS matrixAN A) (hFA : Arrays σ matrixFS matrixFN F) (hready : ScratchReady σ)
    (hA : DataBound A M) (hF : DataBound F H) (hW : n*n<W) (hW3 : 3≤W)
    (hM : M<W) (hH : H<W) (hcap : N0287.radix n M*H<W) :
    ∃τ,Run W entry σ τ (1000*(n+1)) ∧ Context τ A F i j (i.val+1) ∧ CallResult τ (entryValue A F i j) := by
  have hnpos : 0<n := Nat.zero_lt_of_lt i.isLt
  have hnb : n<W := by nlinarith
  obtain ⟨σ0,r0,cx0,hd0,he0⟩ := entryInit_run σ A F i j hn hi hj hAA hFA hready hnb hW3
  obtain ⟨σ1,r1,cx1,hd1,he1⟩ := entryLoop_run σ0 A F i j cx0 hd0 he0 hA hF hW hW3 hM hH hcap
  have hparts := partial_bounds A F hA hF i j (i.val+1)
  have hdb := hparts.1.trans_lt hcap
  have heb := hparts.2.trans_lt hcap
  obtain ⟨σ2,r2,hargs⟩ := finishArgs_run σ1 A i j
    (tailState A F i j (i.val+1)).1 (tailState A F i j (i.val+1)).2
    cx1.2.2.2.2.1 cx1.1 cx1.2.1 cx1.2.2.1 hd1 he1 hW hW3 ((hA i j).trans_lt hM) hdb heb
  have cx2 := context_frame cx1 (Frame.of_run r2) (by decide)
  obtain ⟨τ,r3,hres,hv,ha,hinput,hout⟩ := call_run σ2 (neg (tailState A F i j (i.val+1)).1)
    (A i j) (tailState A F i j (i.val+1)).2 hargs hW3 hdb ((hA i j).trans_lt hM) heb
    ((finish_bound A F hA hF i j).trans_lt hcap)
    cx2.2.2.2.2.2.2.1 cx2.2.2.2.2.2.2.2.1 cx2.2.2.2.2.2.2.2.2
  have cx3 := context_frame cx2 (Frame.of_run r3) (by decide)
  refine ⟨τ,(r0.seq (r1.seq (r2.seq r3))).mono (by omega),cx3,?_⟩
  simpa only [entryValue] using hres


def dataStage {n : ℕ} (A F : Data n) : Data n := fun i j => entryValue A F i j

theorem dataStage_packed {n : ℕ} (A F : Data n) :
    packed (dataStage A F)=N0301.stage (packed A) (packed F) := by
  unfold packed dataStage N0301.stage
  apply congrArg N0301.pack
  funext i j
  exact entryValue_correct A F i j

theorem dataStage_bound {n M H : ℕ} (A F : Data n) (hA : DataBound A M) (hF : DataBound F H) :
    DataBound (dataStage A F) (N0287.radix n M*H) := by
  intro i j
  rw [dataStage,magnitude_eq_abs,entryValue_correct]
  exact (N0287.stepEntry_natAbs (packed A) (packed F)
    (packed_bound A hA) (packed_bound F hF) i j).trans
      (Nat.mul_le_mul_right H (N0287.radix_bounds n M).2.2.2)

def cellSign {n : ℕ} (A F : Data n) (l : ℕ) : ℕ :=
  if h : l<n*n then (dataStage A F (⟨l,h⟩ : Fin (n*n)).divNat (⟨l,h⟩ : Fin (n*n)).modNat).sign else 0
def cellMagnitude {n : ℕ} (A F : Data n) (l : ℕ) : ℕ :=
  if h : l<n*n then (dataStage A F (⟨l,h⟩ : Fin (n*n)).divNat (⟨l,h⟩ : Fin (n*n)).modNat).magnitude else 0

theorem cell_address {n : ℕ} (A F : Data n) (i j : Fin n) :
    cellSign A F (n*i.val+j.val)=(dataStage A F i j).sign ∧
      cellMagnitude A F (n*i.val+j.val)=(dataStage A F i j).magnitude := by
  have hk : (⟨n*i.val+j.val,row_address_lt i j⟩ : Fin (n*n))=Fin.mkDivMod i j := by
    apply Fin.ext
    simp [Fin.mkDivMod,Nat.mul_comm]
  simp only [cellSign,cellMagnitude,dif_pos (row_address_lt i j),hk,Fin.divNat_mkDivMod,Fin.modNat_mkDivMod]
  simp

def stageBody : Com := .seq (.assign rowVar (.bin .div (.var linearVar) (.var nVar)))
  (.seq (.assign colVar (Internal.N0339.N0527.modExpr (.var linearVar) (.var nVar)))
    (.seq entry (.seq (.store matrixGS (.var linearVar) (.var resultS))
      (.seq (.store matrixGN (.var linearVar) (.var resultN)) (.assign linearVar (.bin .add (.var linearVar) (.lit 1)))))))
def stageLoop : Com := .while (.lt (.var linearVar) (.var count)) stageBody
def stageProgram : Com := .seq (.assign linearVar (.lit 0)) stageLoop

/-  One actual fresh-array cell materialization, including row/column indexing,
the complete Bird entry source and both actual result stores. -/
theorem stageBody_run {W n M H l : ℕ} (σ : Env) (A F : Data n)
    (hn : σ.vars nVar=n) (hl : σ.vars linearVar=l) (hln : l<n*n)
    (hAA : Arrays σ matrixAS matrixAN A) (hFA : Arrays σ matrixFS matrixFN F) (hready : ScratchReady σ)
    (hGS : (σ.arrs matrixGS).length=n*n) (hGN : (σ.arrs matrixGN).length=n*n)
    (hA : DataBound A M) (hF : DataBound F H) (hW : n*n<W) (hW3 : 3≤W)
    (hM : M<W) (hH : H<W) (hcap : N0287.radix n M*H<W) :
    ∃τ,Run W stageBody σ τ (1100*(n+1)) ∧ τ.vars linearVar=l+1 ∧
      τ.arrs matrixGS=(σ.arrs matrixGS).set l (cellSign A F l) ∧
      τ.arrs matrixGN=(σ.arrs matrixGN).set l (cellMagnitude A F l) := by
  let q : Fin (n*n) := ⟨l,hln⟩
  let i : Fin n := q.divNat
  let j : Fin n := q.modNat
  have hnpos : 0<n := by nlinarith
  have hnb : n<W := by nlinarith
  have hlb : l<W := hln.trans hW
  have hqb : l/n<W := (Nat.div_le_self _ _).trans_lt hlb
  have hmb : (l/n)*n<W := (Nat.div_mul_le_self _ _).trans_lt hlb
  have hrb : l-l/n*n<W := (Nat.sub_le _ _).trans_lt hlb
  have hrval : i.val=l/n := rfl
  have hcval : j.val=l-l/n*n := by change l%n=l-l/n*n; exact Nat.mod_eq_sub_div_mul
  simp only [nVar,linearVar] at hn hl
  imp_vcgen [stageBody,Internal.N0339.N0527.modExpr,nVar,linearVar,rowVar,colVar,hn,hl,hnb,hlb,hqb,hmb,hrb]
  refine vc_spec (entry_run _ A F i j
    (by imp_norm [nVar,linearVar,rowVar,colVar,hn,hl])
    (by imp_norm [nVar,linearVar,rowVar,colVar,hn,hl,hrval])
    (by imp_norm [nVar,linearVar,rowVar,colVar,hn,hl,hcval])
    (by exact hAA) (by exact hFA) (by exact hready)
    hA hF hW hW3 hM hH hcap) ?_
  rintro ρ t ⟨hcx,hres⟩ fr ht
  have hlin : ρ.vars linearVar=l := by
    rw [fr.vars linearVar (by decide)]
    imp_norm [nVar,linearVar,rowVar,colVar,hn,hl]
  have hgs : ρ.arrs matrixGS=σ.arrs matrixGS := by
    rw [fr.arrs matrixGS (by decide)]
    rfl
  have hgn : ρ.arrs matrixGN=σ.arrs matrixGN := by
    rw [fr.arrs matrixGN (by decide)]
    rfl
  have hls : (ρ.arrs matrixGS).length=n*n := by rw [hgs]; exact hGS
  have hln' : (ρ.arrs matrixGN).length=n*n := by rw [hgn]; exact hGN
  have hresS : ρ.vars resultS=(entryValue A F i j).sign := hres.1
  have hresN : ρ.vars resultN=(entryValue A F i j).magnitude := hres.2
  have hsb : (entryValue A F i j).sign<W := (entryValue A F i j).bit.trans_le (by omega)
  have hnb' : (entryValue A F i j).magnitude<W := (dataStage_bound A F hA hF i j).trans_lt hcap
  have hcellS : cellSign A F l=(entryValue A F i j).sign := by simp only [cellSign,dif_pos hln]; rfl
  have hcellN : cellMagnitude A F l=(entryValue A F i j).magnitude := by simp only [cellMagnitude,dif_pos hln]; rfl
  simp only [matrixGS,matrixGN] at hGS hGN
  simp only [linearVar,resultS,resultN,matrixGS,matrixGN] at hlin hgs hgn hls hln' hresS hresN
  imp_vcgen [linearVar,resultS,resultN,matrixGS,matrixGN,hlin,hgs,hgn,hls,hln',hresS,hresN,hsb,hnb',hcellS,hcellN,hGS,hGN,hln]
  all_goals first | omega | simp [hcellS,hcellN]


/-  The complete counted source loop writes every entry of the fresh matrix. -/
theorem stageLoop_run {W n M H : ℕ} (σ : Env) (A F : Data n)
    (hn : σ.vars nVar=n) (hc : σ.vars count=n*n) (hl : σ.vars linearVar=0)
    (hAA : Arrays σ matrixAS matrixAN A) (hFA : Arrays σ matrixFS matrixFN F) (hready : ScratchReady σ)
    (hGS : (σ.arrs matrixGS).length=n*n) (hGN : (σ.arrs matrixGN).length=n*n)
    (hA : DataBound A M) (hF : DataBound F H) (hW : n*n<W) (hW3 : 3≤W)
    (hM : M<W) (hH : H<W) (hcap : N0287.radix n M*H<W) :
    ∃τ,Run W stageLoop σ τ ((1100*(n+1)+4)*(n*n)+4) ∧ Arrays τ matrixGS matrixGN (dataStage A F) := by
  apply wp.run
  refine wp_for_var (n*n) (1100*(n+1)) (fun l ρ =>
    SegInv (σ.arrs matrixGS) (ρ.arrs matrixGS) 0 l (cellSign A F) ∧
    SegInv (σ.arrs matrixGN) (ρ.arrs matrixGN) 0 l (cellMagnitude A F))
    hW hl hc (by decide) ⟨SegInv.zero _ _ _,SegInv.zero _ _ _⟩ ?_ ?_
  · intro l hln ρ hInv hidx fr
    have hnρ : ρ.vars nVar=n := (fr.vars nVar (by decide)).trans hn
    have hAρ : Arrays ρ matrixAS matrixAN A := by
      intro i j
      rw [fr.arrs matrixAS (by decide),fr.arrs matrixAN (by decide)]
      exact hAA i j
    have hFρ : Arrays ρ matrixFS matrixFN F := by
      intro i j
      rw [fr.arrs matrixFS (by decide),fr.arrs matrixFN (by decide)]
      exact hFA i j
    have hreadyρ : ScratchReady ρ := by simpa only [ScratchReady,fr.len] using hready
    have hGSρ : (ρ.arrs matrixGS).length=n*n := (fr.len _).trans hGS
    have hGNρ : (ρ.arrs matrixGN).length=n*n := (fr.len _).trans hGN
    refine vc_spec (stageBody_run ρ A F hnρ hidx hln hAρ hFρ hreadyρ hGSρ hGNρ hA hF hW hW3 hM hH hcap) ?_
    rintro τ k ⟨hidxτ,hgs,hgn⟩ _ hk
    refine ⟨⟨?_,?_⟩,hidxτ,hk⟩
    · rw [hgs]
      simpa only [Nat.zero_add] using SegInv.step hInv.1 (by rw [hGSρ]; simpa using hln) rfl
    · rw [hgn]
      simpa only [Nat.zero_add] using SegInv.step hInv.2 (by rw [hGNρ]; simpa using hln) rfl
  · intro ρ k hInv hidx fr hk
    refine ⟨hk,?_⟩
    intro i j
    have hs := hInv.1.inside (n*i.val+j.val) (row_address_lt i j)
    have hm := hInv.2.inside (n*i.val+j.val) (row_address_lt i j)
    simp only [Nat.zero_add,(cell_address A F i j).1] at hs
    simp only [Nat.zero_add,(cell_address A F i j).2] at hm
    have hls : n*i.val+j.val<(ρ.arrs matrixGS).length := by rw [fr.len _,hGS]; exact row_address_lt i j
    have hln : n*i.val+j.val<(ρ.arrs matrixGN).length := by rw [fr.len _,hGN]; exact row_address_lt i j
    exact ⟨by simpa only [hs] using getElem?_of_lt hls,by simpa only [hm] using getElem?_of_lt hln⟩

theorem stage_run {W n M H : ℕ} (σ : Env) (A F : Data n)
    (hn : σ.vars nVar=n) (hc : σ.vars count=n*n)
    (hAA : Arrays σ matrixAS matrixAN A) (hFA : Arrays σ matrixFS matrixFN F) (hready : ScratchReady σ)
    (hGS : (σ.arrs matrixGS).length=n*n) (hGN : (σ.arrs matrixGN).length=n*n)
    (hA : DataBound A M) (hF : DataBound F H) (hW : n*n<W) (hW3 : 3≤W)
    (hM : M<W) (hH : H<W) (hcap : N0287.radix n M*H<W) :
    ∃τ,Run W stageProgram σ τ (2000*(n+1)^3) ∧ Arrays τ matrixGS matrixGN (dataStage A F) := by
  let σ0 := σ.setVar linearVar 0
  have r0 : Run W (.assign linearVar (.lit 0)) σ σ0 2 := Run.assign (evalB_lit (by omega))
  have fr := Frame.of_run r0
  have hn0 : σ0.vars nVar=n := (fr.vars nVar (by decide)).trans hn
  have hc0 : σ0.vars count=n*n := (fr.vars count (by decide)).trans hc
  obtain ⟨τ,hr,harr⟩ := stageLoop_run σ0 A F hn0 hc0 (by simp [σ0,Env.setVar]) hAA hFA hready hGS hGN hA hF hW hW3 hM hH hcap
  refine ⟨τ,(r0.seq hr).mono ?_,harr⟩
  nlinarith [Nat.zero_le (n^2),Nat.zero_le (n^3)]


def dataIterate {n : ℕ} (A : Data n) : ℕ → Data n
  | 0 => A
  | t+1 => dataStage A (dataIterate A t)

theorem dataIterate_packed {n : ℕ} (A : Data n) (t : ℕ) :
    packed (dataIterate A t)=N0301.iterate (packed A) t := by
  induction t with
  | zero => rfl
  | succ t ih => rw [dataIterate,dataStage_packed,ih,N0301.iterate]

theorem dataIterate_bound {n M : ℕ} (A : Data n) (hA : DataBound A M) (t : ℕ) :
    DataBound (dataIterate A t) (N0287.height n M t) := by
  induction t with
  | zero => simpa [dataIterate,N0287.height] using hA
  | succ t ih =>
    have hs := dataStage_bound A (dataIterate A t) hA ih
    have he : N0287.radix n M*N0287.height n M t=
        N0287.height n M (t+1) := by
      unfold N0287.height
      rw [pow_succ]
      ring
    simpa only [dataIterate,he] using hs

theorem array_values_bound {W n : ℕ} (σ : Env) (sarr narr : String) (A : Data n)
    (ha : Arrays σ sarr narr A) (hs : (σ.arrs sarr).length=n*n) (hn : (σ.arrs narr).length=n*n)
    (hW : 2≤W) (hm : ∀i j,(A i j).magnitude<W) :
    (∀v∈σ.arrs sarr,v<W) ∧ (∀v∈σ.arrs narr,v<W) := by
  have haddr (l : ℕ) (hl : l<n*n) :
      n*(⟨l,hl⟩ : Fin (n*n)).divNat.val+(⟨l,hl⟩ : Fin (n*n)).modNat.val=l := by
    change n*(l/n)+l%n=l
    exact (Nat.add_comm _ _).trans (Nat.mod_add_div l n)
  constructor
  · intro v hv
    obtain ⟨l,hl,rfl⟩ := List.mem_iff_getElem.mp hv
    have hlt : l<n*n := by simpa only [hs] using hl
    let q : Fin (n*n) := ⟨l,hlt⟩
    have hget := (ha q.divNat q.modNat).1
    rw [haddr l hlt] at hget
    have heq := (List.getElem?_eq_some_iff.mp hget).2
    rw [heq]
    exact (A q.divNat q.modNat).bit.trans_le hW
  · intro v hv
    obtain ⟨l,hl,rfl⟩ := List.mem_iff_getElem.mp hv
    have hlt : l<n*n := by simpa only [hn] using hl
    let q : Fin (n*n) := ⟨l,hlt⟩
    have hget := (ha q.divNat q.modNat).2
    rw [haddr l hlt] at hget
    have heq := (List.getElem?_eq_some_iff.mp hget).2
    rw [heq]
    exact hm q.divNat q.modNat

def copyArray (dst src : String) : Com :=
  Internal.N0339.N0372.gcopy dst src (.lit 0) (.lit 0) (.var count)

theorem copyArray_run {W L : ℕ} (σ : Env) (dst src : String) (hne : dst≠src)
    (hc : σ.vars count=L) (hD : (σ.arrs dst).length=L) (hS : (σ.arrs src).length=L)
    (hW : L+1<W) (hv : ∀v∈σ.arrs src,v<W) :
    ∃τ,Run W (copyArray dst src) σ τ (3+20*(L+2)) ∧ τ.arrs dst=σ.arrs src := by
  have h0 : (Expr.lit 0).evalB W σ=some 0 := evalB_lit (by omega)
  have h1 : (Expr.lit 0).evalB W (σ.setVar Internal.N0339.N0372.cdo 0)=some 0 := evalB_lit (by omega)
  have heq : ((σ.setVar Internal.N0339.N0372.cdo 0).setVar Internal.N0339.N0372.cso 0).vars count=L := by
    simpa only [vars_setVar,show count≠Internal.N0339.N0372.cdo by decide,
      show count≠Internal.N0339.N0372.cso by decide,if_false] using hc
  have h2 : (Expr.var count).evalB W ((σ.setVar Internal.N0339.N0372.cdo 0).setVar Internal.N0339.N0372.cso 0)=some L :=
    evalB_var_iff.mpr ⟨heq.symm,by rw [heq]; omega⟩
  obtain ⟨τ,hr,hout,hvars,harrs,hin,houtTape⟩ := Internal.N0339.N0371.gcopy_run dst src hne
    (.lit 0) (.lit 0) (.var count) h0 h1 h2 rfl rfl (by omega) (by omega) (by omega) (by omega) hv
  have ht : (σ.arrs src).take L=σ.arrs src := by rw [←hS]; exact List.take_length
  have hd : (σ.arrs dst).drop L=[] := by rw [←hD]; exact List.drop_length
  refine ⟨τ,by simpa [copyArray,Expr.size] using hr,?_⟩
  simpa only [List.take_zero,List.drop_zero,List.nil_append,Nat.zero_add,ht,hd,List.append_nil] using hout

def sourceS (fromA : Bool) : String := if fromA then matrixAS else matrixGS
def sourceN (fromA : Bool) : String := if fromA then matrixAN else matrixGN
def copyIntoF (fromA : Bool) : Com :=
  .seq (copyArray matrixFS (sourceS fromA)) (copyArray matrixFN (sourceN fromA))

theorem copyIntoF_run {W n : ℕ} (σ : Env) (D : Data n) (fromA : Bool)
    (hc : σ.vars count=n*n) (hdata : Arrays σ (sourceS fromA) (sourceN fromA) D)
    (hSS : (σ.arrs (sourceS fromA)).length=n*n) (hSN : (σ.arrs (sourceN fromA)).length=n*n)
    (hFS : (σ.arrs matrixFS).length=n*n) (hFN : (σ.arrs matrixFN).length=n*n)
    (hW : n*n+1<W) (hW2 : 2≤W) (hv : ∀i j,(D i j).magnitude<W) :
    ∃τ,Run W (copyIntoF fromA) σ τ (100*(n+1)^2) ∧ Arrays τ matrixFS matrixFN D := by
  obtain ⟨hvs,hvn⟩ := array_values_bound σ _ _ D hdata hSS hSN hW2 hv
  obtain ⟨ρ,rS,hS⟩ := copyArray_run σ matrixFS (sourceS fromA) (by cases fromA <;> decide) hc hFS hSS hW hvs
  have frS := Frame.of_run rS
  have hcρ : ρ.vars count=n*n := (frS.vars count (by cases fromA <;> decide)).trans hc
  have hSrcN : ρ.arrs (sourceN fromA)=σ.arrs (sourceN fromA) := frS.arrs _ (by cases fromA <;> decide)
  have hFNρ : (ρ.arrs matrixFN).length=n*n := (frS.len _).trans hFN
  obtain ⟨τ,rN,hN⟩ := copyArray_run ρ matrixFN (sourceN fromA) (by cases fromA <;> decide) hcρ hFNρ
    (by rw [hSrcN]; exact hSN) hW (by simpa only [hSrcN] using hvn)
  have frN := Frame.of_run rN
  refine ⟨τ,(rS.seq rN).mono (by nlinarith),?_⟩
  intro i j
  rw [frN.arrs matrixFS (by cases fromA <;> decide),hS,hN,hSrcN]
  exact hdata i j




def StableBank (σ : Env) (n : ℕ) : Prop :=
  σ.vars nVar=n ∧ σ.vars count=n*n ∧ ScratchReady σ ∧
  ∀a∈[matrixAS,matrixAN,matrixFS,matrixFN,matrixGS,matrixGN],(σ.arrs a).length=n*n

theorem bank_frame {c : Com} {σ τ : Env} {n : ℕ} (fr : Frame c σ τ)
    (hn : nVar∉scalarWrites c) (hc : count∉scalarWrites c) (hb : StableBank σ n) :
    StableBank τ n := by
  refine ⟨(fr.vars _ hn).trans hb.1,(fr.vars _ hc).trans hb.2.1,?_,?_⟩
  · simpa only [ScratchReady,fr.len] using hb.2.2.1
  · intro a ha
    exact (fr.len a).trans (hb.2.2.2 a ha)

theorem arrays_frame {c : Com} {σ τ : Env} {n : ℕ} {sa na : String} {A : Data n}
    (fr : Frame c σ τ) (hs : sa∉arrayWrites c) (hn : na∉arrayWrites c)
    (hA : Arrays σ sa na A) : Arrays τ sa na A := by
  intro i j
  rw [fr.arrs _ hs,fr.arrs _ hn]
  exact hA i j

def iterationBody : Com := .seq stageProgram
  (.seq (copyIntoF false) (.assign stageVar (.add (.var stageVar) (.lit 1))))
def iterationLoop : Com := .while (.lt (.add (.var stageVar) (.lit 1)) (.var nVar)) iterationBody

theorem iterationBody_run {W n M : ℕ} (σ : Env) (A : Data n) (t : ℕ)
    (hb : StableBank σ n) (hAA : Arrays σ matrixAS matrixAN A)
    (hFA : Arrays σ matrixFS matrixFN (dataIterate A t)) (ht : σ.vars stageVar=t)
    (htn : t+1<n) (hA : DataBound A M) (hW : n*n+1<W) (hW3 : 3≤W)
    (hM : M<W) (hH : N0287.height n M t<W)
    (hcap : N0287.radix n M*N0287.height n M t<W) :
    ∃τ,Run W iterationBody σ τ (3000*(n+1)^3) ∧ StableBank τ n ∧
      Arrays τ matrixAS matrixAN A ∧ Arrays τ matrixFS matrixFN (dataIterate A (t+1)) ∧ τ.vars stageVar=t+1 := by
  obtain ⟨ρ,rStage,hG⟩ := stage_run σ A (dataIterate A t) hb.1 hb.2.1 hAA hFA hb.2.2.1
    (hb.2.2.2 _ (by simp)) (hb.2.2.2 _ (by simp)) hA (dataIterate_bound A hA t)
    (by omega) hW3 hM hH hcap
  have fStage := Frame.of_run rStage
  have hbρ := bank_frame fStage (by decide) (by decide) hb
  have hAρ := arrays_frame fStage (by decide) (by decide) hAA
  obtain ⟨ν,rCopy,hF⟩ := copyIntoF_run ρ (dataIterate A (t+1)) false hbρ.2.1 hG
    (hbρ.2.2.2 _ (by simp [sourceS])) (hbρ.2.2.2 _ (by simp [sourceN]))
    (hbρ.2.2.2 _ (by simp)) (hbρ.2.2.2 _ (by simp)) hW (by omega)
    (fun i j => (dataStage_bound A (dataIterate A t) hA (dataIterate_bound A hA t) i j).trans_lt hcap)
  have fCopy := Frame.of_run rCopy
  have hbν := bank_frame fCopy (by decide) (by decide) hbρ
  have hAν := arrays_frame fCopy (by decide) (by decide) hAρ
  have htν : ν.vars stageVar=t := by rw [fCopy.vars _ (by decide),fStage.vars _ (by decide)]; exact ht
  have hnp : n<W := by nlinarith
  let τ := ν.setVar stageVar (t+1)
  have re : Run W (.assign stageVar (.add (.var stageVar) (.lit 1))) ν τ 4 :=
    Run.assign (evalB_bin (op:=.add) (evalB_var_iff.mpr ⟨htν.symm,by omega⟩) (evalB_lit (by omega)) (by change t+1<W; omega))
  have fe := Frame.of_run re
  refine ⟨τ,(rStage.seq (rCopy.seq re)).mono (by nlinarith [Nat.zero_le (n^3)]),
    bank_frame fe (by decide) (by decide) hbν,arrays_frame fe (by decide) (by decide) hAν,?_,?_⟩
  · exact arrays_frame fe (by decide) (by decide) hF
  · simp [τ,Env.setVar]



theorem iterationLoop_run {W n M : ℕ} (σ : Env) (A : Data n)
    (hb : StableBank σ n) (hAA : Arrays σ matrixAS matrixAN A)
    (hFA : Arrays σ matrixFS matrixFN A) (ht : σ.vars stageVar=0) (hnpos : 0<n)
    (hA : DataBound A M) (hW : n*n+1<W) (hW3 : 3≤W) (hM : M<W)
    (hheight : ∀t,t≤n → N0287.height n M t<W) :
    ∃τ,Run W iterationLoop σ τ (4000*(n+1)^4) ∧ StableBank τ n ∧
      Arrays τ matrixAS matrixAN A ∧ Arrays τ matrixFS matrixFN (dataIterate A (n-1)) ∧ τ.vars stageVar=n-1 := by
  have hnW : n+1<W := by nlinarith
  let I : Env → Prop := fun ρ => ∃t,t<n ∧ StableBank ρ n ∧ Arrays ρ matrixAS matrixAN A ∧
    Arrays ρ matrixFS matrixFN (dataIterate A t) ∧ ρ.vars stageVar=t
  let V : Env → ℕ := fun ρ => n-1-ρ.vars stageVar
  have hcond (ρ : Env) (t : ℕ) (hbρ : StableBank ρ n) (htρ : ρ.vars stageVar=t) (htn : t<n) :
      (Cond.lt (.add (.var stageVar) (.lit 1)) (.var nVar)).evalB W ρ=some (decide (t+1<n)) := by
    exact evalB_condLt (evalB_bin (op:=.add) (evalB_var_iff.mpr ⟨htρ.symm,by omega⟩)
      (evalB_lit (by omega)) (by change t+1<W; omega)) (evalB_var_iff.mpr ⟨hbρ.1.symm,by rw [hbρ.1]; omega⟩)
  have hdef : ∀ρ,I ρ → ∃v,(Cond.lt (.add (.var stageVar) (.lit 1)) (.var nVar)).evalB W ρ=some v := by
    rintro ρ ⟨t,htn,hbρ,haρ,hfρ,htρ⟩
    exact ⟨_,hcond ρ t hbρ htρ htn⟩
  have hstep : ∀ρ,I ρ → (Cond.lt (.add (.var stageVar) (.lit 1)) (.var nVar)).evalB W ρ=some true →
      ∃τ,Run W iterationBody ρ τ (3000*(n+1)^3) ∧ I τ ∧ V τ<V ρ := by
    rintro ρ ⟨t,htn,hbρ,haρ,hfρ,htρ⟩ hc
    rw [hcond ρ t hbρ htρ htn] at hc
    have htn' : t+1<n := by simpa using hc
    have hcap : N0287.radix n M*N0287.height n M t<W := by
      have he : N0287.radix n M*N0287.height n M t=
          N0287.height n M (t+1) := by
        unfold N0287.height
        rw [pow_succ]
        ring
      rw [he]
      exact hheight _ (by omega)
    obtain ⟨τ,hr,hbτ,haτ,hfτ,htτ⟩ := iterationBody_run ρ A t hbρ haρ hfρ htρ htn' hA hW hW3 hM
      (hheight _ (by omega)) hcap
    refine ⟨τ,hr,⟨t+1,htn',hbτ,haτ,hfτ,htτ⟩,?_⟩
    simp only [V,htτ,htρ]
    omega
  have hi : I σ := ⟨0,hnpos,hb,hAA,hFA,ht⟩
  obtain ⟨τ,hr,⟨t,htn,hbτ,haτ,hfτ,htτ⟩,hc⟩ := Run.while_count I V (3000*(n+1)^3) hdef hstep hi
  rw [hcond τ t hbτ htτ htn] at hc
  have htfinal : t=n-1 := by
    have hnot : ¬t+1<n := by simpa using hc
    omega
  rw [htfinal] at hfτ htτ
  refine ⟨τ,hr.mono ?_,hbτ,haτ,hfτ,htτ⟩
  simp only [V,ht,Cond.size,Expr.size,Nat.sub_zero]
  have hh := Nat.sub_le n 1
  nlinarith [Nat.zero_le (n^2),Nat.zero_le (n^3),Nat.zero_le (n^4)]

def correctSign (a : Signed) (t : ℕ) : Signed := if t%2=0 then a else neg a

theorem correctSign_value (a : Signed) (t : ℕ) : zval (correctSign a t)=(-1:ℤ)^t*zval a := by
  rw [neg_one_pow_eq_pow_mod_two]
  have ht := Nat.mod_lt t (by omega : 0<2)
  by_cases he : t%2=0
  · simp [correctSign,he]
  · have h1 : t%2=1 := by omega
    simp [correctSign,he,h1,neg_value]

theorem correctSign_magnitude (a : Signed) (t : ℕ) : (correctSign a t).magnitude=a.magnitude := by
  unfold correctSign
  split <;> rfl

def readFinal : Com := .seq (.assign resultS (.get matrixFS (.lit 0)))
  (.seq (.assign resultN (.get matrixFN (.lit 0)))
    (.ite (.eq (Internal.N0339.N0527.modExpr (.var stageVar) (.lit 2)) (.lit 0))
      .skip (.assign resultS (.sub (.lit 1) (.var resultS)))))

theorem readFinal_run {W n : ℕ} (σ : Env) (F : Data n) (hn : 0<n) (t : ℕ)
    (hf : Arrays σ matrixFS matrixFN F) (ht : σ.vars stageVar=t) (htW : t<W) (hW3 : 3≤W)
    (hmag : (F ⟨0,hn⟩ ⟨0,hn⟩).magnitude<W) :
    ∃τ,Run W readFinal σ τ 40 ∧ CallResult τ (correctSign (F ⟨0,hn⟩ ⟨0,hn⟩) t) := by
  let a := F ⟨0,hn⟩ ⟨0,hn⟩
  have hs : (σ.arrs matrixFS)[0]?=some a.sign := by simpa using (hf ⟨0,hn⟩ ⟨0,hn⟩).1
  have hm : (σ.arrs matrixFN)[0]?=some a.magnitude := by simpa using (hf ⟨0,hn⟩ ⟨0,hn⟩).2
  have hsb : a.sign<W := a.bit.trans_le (by omega)
  let σ1 := σ.setVar resultS a.sign
  let ρ := σ1.setVar resultN a.magnitude
  have rS : Run W (.assign resultS (.get matrixFS (.lit 0))) σ σ1 3 :=
    Run.assign (evalB_get_iff.mpr ⟨0,evalB_lit (by omega),hs,hsb⟩)
  have rN : Run W (.assign resultN (.get matrixFN (.lit 0))) σ1 ρ 3 :=
    Run.assign (evalB_get_iff.mpr ⟨0,evalB_lit (by omega),hm,hmag⟩)
  have htρ : ρ.vars stageVar=t := by simpa [ρ,σ1,Env.setVar,stageVar,resultS,resultN] using ht
  have hsρ : ρ.vars resultS=a.sign := by simp [ρ,σ1,Env.setVar,resultS,resultN]
  have hnρ : ρ.vars resultN=a.magnitude := by simp [ρ,Env.setVar]
  have em : (Internal.N0339.N0527.modExpr (.var stageVar) (.lit 2)).evalB W ρ=some (t%2) :=
    Internal.N0339.N0527.modExpr_evalB
      (evalB_var_iff.mpr ⟨htρ.symm,by rw [htρ]; exact htW⟩) (evalB_lit (by omega))
  have ec : (Cond.eq (Internal.N0339.N0527.modExpr (.var stageVar) (.lit 2)) (.lit 0)).evalB W ρ=
      some (decide (t%2=0)) := evalB_condEq em (evalB_lit (by omega))
  by_cases he : t%2=0
  · have rc := Run.ite_true (d:=.assign resultS (.sub (.lit 1) (.var resultS))) (by simpa only [he,decide_true] using ec) (Run.skip (B:=W) (σ:=ρ))
    refine ⟨ρ,(rS.seq (rN.seq rc)).mono (by simp [Cond.size,Expr.size,Internal.N0339.N0527.modExpr]),?_⟩
    simpa only [correctSign,if_pos he,CallResult] using And.intro hsρ hnρ
  · let τ := ρ.setVar resultS (1-a.sign)
    have rn : Run W (.assign resultS (.sub (.lit 1) (.var resultS))) ρ τ 4 :=
      Run.assign (evalB_bin (op:=.sub) (evalB_lit (by omega))
        (evalB_var_iff.mpr ⟨hsρ.symm,by rw [hsρ]; exact hsb⟩) (by change 1-a.sign<W; omega))
    have rc := Run.ite_false (c:=.skip) (by simpa only [he,decide_false] using ec) rn
    refine ⟨τ,(rS.seq (rN.seq rc)).mono (by simp [Cond.size,Expr.size,Internal.N0339.N0527.modExpr]),?_⟩
    simp only [CallResult,correctSign,if_neg he,neg]
    constructor
    · simp [τ,Env.setVar,a]
    · simpa [τ,Env.setVar,resultN,resultS] using hnρ


def core : Com := .seq (copyIntoF true)
  (.seq (.assign stageVar (.lit 0)) (.seq iterationLoop readFinal))

theorem core_run {W n M : ℕ} (σ : Env) (A : Data n)
    (hb : StableBank σ n) (hAA : Arrays σ matrixAS matrixAN A) (hnpos : 0<n)
    (hA : DataBound A M) (hW : n*n+1<W) (hW3 : 3≤W) (hM : M<W)
    (hheight : ∀t,t≤n → N0287.height n M t<W) :
    ∃τ,Run W core σ τ (5000*(n+1)^4) ∧
      CallResult τ (correctSign (dataIterate A (n-1) ⟨0,hnpos⟩ ⟨0,hnpos⟩) (n-1)) := by
  obtain ⟨ρ,rc,hf⟩ := copyIntoF_run σ A true hb.2.1 hAA
    (hb.2.2.2 _ (by simp [sourceS])) (hb.2.2.2 _ (by simp [sourceN]))
    (hb.2.2.2 _ (by simp)) (hb.2.2.2 _ (by simp)) hW (by omega) (fun i j=>(hA i j).trans_lt hM)
  have fc := Frame.of_run rc
  have hbρ := bank_frame fc (by decide) (by decide) hb
  have haρ := arrays_frame fc (by decide) (by decide) hAA
  let ν := ρ.setVar stageVar 0
  have ri : Run W (.assign stageVar (.lit 0)) ρ ν 2 := Run.assign (evalB_lit (by omega))
  have fi := Frame.of_run ri
  obtain ⟨η,rl,hbη,haη,hfη,htη⟩ := iterationLoop_run ν A
    (bank_frame fi (by decide) (by decide) hbρ) (arrays_frame fi (by decide) (by decide) haρ)
    (arrays_frame fi (by decide) (by decide) hf) (by simp [ν,Env.setVar]) hnpos hA hW hW3 hM hheight
  have hnW : n<W := by nlinarith
  obtain ⟨τ,rf,hres⟩ := readFinal_run η (dataIterate A (n-1)) hnpos (n-1) hfη htη (by omega) hW3
    ((dataIterate_bound A hA (n-1) _ _).trans_lt (hheight _ (by omega)))
  refine ⟨τ,(rc.seq (ri.seq (rl.seq rf))).mono (by nlinarith [Nat.zero_le (n^3),Nat.zero_le (n^4)]),hres⟩



def determinantSigned : {n : ℕ} → Data n → Signed
  | 0,_ => one
  | k+1,A => correctSign (dataIterate A k 0 0) k

