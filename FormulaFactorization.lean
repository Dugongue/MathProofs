def residual (P H K : Poly) (q : ℕ) : XPoly := P.coeff q-(H*K).coeff q

def step (P : Poly) (A B : XPoly) (q : ℕ) (H K : Poly) : Poly × Poly :=
  let uv := N0364.correction (residual P H K q) A B
