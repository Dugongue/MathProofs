/-! # The field-macro interface (operational ABI v1.1)

One hypothesis shape for every field macro the geometric solver programs call.  A macro is a
finite concrete `Com` acting on the array `mem`: a field element occupies `e` consecutive cells
holding canonical coefficients below `p`; the arguments are the registers `aBase`, `bBase`,
`outBase` (and `exp` for powering); the output slice is disjoint from the inputs and the modulus.
Each spec says: under the caller obligations `MacroInput`, the macro runs within its cost bound,
writes the canonical coefficients of the intended field value into the output slice, and
disturbs nothing else except the temporaries, the scratch array and (for equality) the flag.

The structure `FieldMacros` packages the eight macros with their specs and their layout
well-formedness.  Generators (agent A's `fixedTestCom`/`childCom`, the lead's control layer) take a
`FieldMacros` as a parameter; an instance is built from the implementing lane's `Run` theorems once
they are released, so nothing here assumes the unproved v1.1 cost ceilings.  Lead module (Claude),
2026-10-02. -/

set_option autoImplicit false

namespace Internal.N0339.N0459
open N0316.Imp N0316.N0616 N0316.N0049
open Internal.N0339.N0513
open Internal.N0339.N0520
open Internal.N0339.N0449

variable {K : Type} [Field K] [Fintype K] (F : FieldPresentation K)

/-! ## Caller obligations -/

/-  The implementing lane's derived temporaries (inner multiplication names and the cardinality
registers of inversion), all derived from `r.i`. -/
def extraNames (r : FieldNames) : List String :=
  Internal.N0339.N0517.callWrites r ++
    [(Internal.N0339.N0517.cardNames r).out,
      (Internal.N0339.N0517.cardNames r).index]

/-  The scalar temporaries a macro may clobber: the six temporaries of the field names and the
implementing lane's derived temporaries. -/
def clobbered (r : FieldNames) : List String :=
  [r.i, r.j, r.k, r.value, r.exponent, r.flag] ++ extraNames r




theorem mem_clobbered_iff (r : FieldNames) (x : String) :
    x ∈ clobbered r ↔ x ∈ [r.i, r.j, r.k, r.value, r.exponent, r.flag] ∨ x ∈ extraNames r := by
  simp only [clobbered, List.mem_append]

/-  What a caller guarantees before invoking a field macro. -/
structure MacroInput (r : FieldNames) (B : Nat) (σ : Env) : Prop where
  names : ValidNames r
  degree : σ.vars r.e = F.e
  prime : σ.vars r.p = F.p
  arithmetic_word : (F.p + 1) ^ 2 < B
  inverse_word : (F.p + 1) ^ (F.e + 1) < B
  memory_word : (σ.arrs r.mem).length < B
  scratch_word : (σ.arrs r.scratch).length < B
  scratch_fit : 16 * (F.e + 1) ≤ (σ.arrs r.scratch).length
  modulus_fit : σ.vars r.modBase + F.e + 1 ≤ (σ.arrs r.mem).length
  modulus_value : ∀ i : Fin F.e, (σ.arrs r.mem).getD (σ.vars r.modBase + i.val) 0 = (F.modulus i).val
  first_fit : σ.vars r.aBase + F.e ≤ (σ.arrs r.mem).length
  second_fit : σ.vars r.bBase + F.e ≤ (σ.arrs r.mem).length
  output_fit : σ.vars r.outBase + F.e ≤ (σ.arrs r.mem).length
  first_disjoint : σ.vars r.outBase + F.e ≤ σ.vars r.aBase ∨ σ.vars r.aBase + F.e ≤ σ.vars r.outBase
  second_disjoint : σ.vars r.outBase + F.e ≤ σ.vars r.bBase ∨ σ.vars r.bBase + F.e ≤ σ.vars r.outBase
  modulus_disjoint : σ.vars r.outBase + F.e ≤ σ.vars r.modBase ∨
    σ.vars r.modBase + F.e + 1 ≤ σ.vars r.outBase
  first_canonical : Canonical F (slice F σ r (σ.vars r.aBase))
  second_canonical : Canonical F (slice F σ r (σ.vars r.bBase))
  exp_word : σ.vars r.exp < B

/-! ## Frames -/

/-  Everything a macro leaves untouched: scalars outside the temporaries, every array other than
`mem` and `scratch`, the lengths of those two, the cells of `mem` outside the output slice, and
both tapes. -/
structure MacroFrame (r : FieldNames) (σ τ : Env) : Prop where
  vars : ∀ x, x ∉ clobbered r → τ.vars x = σ.vars x
  arrays : ∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a
  mem_length : (τ.arrs r.mem).length = (σ.arrs r.mem).length
  scratch_length : (τ.arrs r.scratch).length = (σ.arrs r.scratch).length
  mem_outside : ∀ j < (σ.arrs r.mem).length,
    j < σ.vars r.outBase ∨ σ.vars r.outBase + F.e ≤ j →
      (τ.arrs r.mem).getD j 0 = (σ.arrs r.mem).getD j 0
  inp : τ.inp = σ.inp
  out : τ.out = σ.out

/-  The frame of a read-only macro (equality): no array changes at all. -/
structure ReadFrame (r : FieldNames) (σ τ : Env) : Prop where
  vars : ∀ x, x ∉ clobbered r → τ.vars x = σ.vars x
  arrays : τ.arrs = σ.arrs
  inp : τ.inp = σ.inp
  out : τ.out = σ.out

/-! ## Specifications -/

/-  A macro computing `f a b` into the output slice (unary macros ignore `b`). -/
def BinarySpec (r : FieldNames) (c : Com) (f : K → K → K) (cost : Nat) : Prop :=
  ∀ (B : Nat) (σ : Env), MacroInput F r B σ → ∃ τ : Env, Run B c σ τ cost ∧
    decode F (slice F τ r (σ.vars r.outBase)) =
      f (decode F (slice F σ r (σ.vars r.aBase))) (decode F (slice F σ r (σ.vars r.bBase))) ∧
    Canonical F (slice F τ r (σ.vars r.outBase)) ∧ MacroFrame F r σ τ

/-  Powering by the register `exp`; the cost may depend on the exponent. -/
def PowSpec (r : FieldNames) (c : Com) (cost : Nat → Nat) : Prop :=
  ∀ (B : Nat) (σ : Env), MacroInput F r B σ → ∃ τ : Env, Run B c σ τ (cost (σ.vars r.exp)) ∧
    decode F (slice F τ r (σ.vars r.outBase)) =
      decode F (slice F σ r (σ.vars r.aBase)) ^ σ.vars r.exp ∧
    Canonical F (slice F τ r (σ.vars r.outBase)) ∧ MacroFrame F r σ τ

open Classical in
/-  Equality test writing `flag`. -/
def EqSpec (r : FieldNames) (c : Com) (cost : Nat) : Prop :=
  ∀ (B : Nat) (σ : Env), MacroInput F r B σ → ∃ τ : Env, Run B c σ τ cost ∧
    τ.vars r.flag = (if decode F (slice F σ r (σ.vars r.aBase)) =
      decode F (slice F σ r (σ.vars r.bBase)) then 1 else 0) ∧
    ReadFrame r σ τ

/-! ## The package -/

/-  The eight field macros with their specs and layout well-formedness. -/
structure FieldMacros (r : FieldNames) where
  layout : Layout
  copy : Com
  add : Com
  neg : Com
  sub : Com
  mul : Com
  inv : Com
  pow : Com
  eq : Com
  costPoint : Nat
  costMul : Nat
  costInv : Nat
  costPow : Nat → Nat
  costEq : Nat
  copy_spec : BinarySpec F r copy (fun x _ => x) costPoint
  add_spec : BinarySpec F r add (fun x y => x + y) costPoint
  neg_spec : BinarySpec F r neg (fun x _ => -x) costPoint
  sub_spec : BinarySpec F r sub (fun x y => x - y) costPoint
  mul_spec : BinarySpec F r mul (fun x y => x * y) costMul
  inv_spec : BinarySpec F r inv (fun x _ => x⁻¹) costInv
  pow_spec : PowSpec F r pow costPow
  eq_spec : EqSpec F r eq costEq
  copy_ok : Com.Ok layout copy
  add_ok : Com.Ok layout add
  neg_ok : Com.Ok layout neg
  sub_ok : Com.Ok layout sub
  mul_ok : Com.Ok layout mul
  inv_ok : Com.Ok layout inv
  pow_ok : Com.Ok layout pow
  eq_ok : Com.Ok layout eq
  costPow_mono : ∀ m m', m ≤ m' → costPow m ≤ costPow m'

/-! ## Calling convention -/

/-  Install the three argument registers, then run the body. -/
def call (r : FieldNames) (a b o : Expr) (body : Com) : Com :=
  .seq (.assign r.aBase a) (.seq (.assign r.bBase b) (.seq (.assign r.outBase o) body))

/-  The environment after installing the arguments. -/
def withArgs (r : FieldNames) (σ : Env) (a b o : Nat) : Env :=
  ((σ.setVar r.aBase a).setVar r.bBase b).setVar r.outBase o

theorem withArgs_arrs (r : FieldNames) (σ : Env) (a b o : Nat) :
    (withArgs r σ a b o).arrs = σ.arrs := rfl

theorem withArgs_inp (r : FieldNames) (σ : Env) (a b o : Nat) :
    (withArgs r σ a b o).inp = σ.inp := rfl

theorem withArgs_out (r : FieldNames) (σ : Env) (a b o : Nat) :
    (withArgs r σ a b o).out = σ.out := rfl

theorem slice_withArgs (r : FieldNames) (σ : Env) (a b o base : Nat) :
    slice F (withArgs r σ a b o) r base = slice F σ r base := rfl

theorem call_run (r : FieldNames) (a b o : Expr) (body : Com)
    {B av bv ov cost : Nat} {σ τ : Env}
    (ha : a.evalB B σ = some av)
    (hb : b.evalB B (σ.setVar r.aBase av) = some bv)
    (ho : o.evalB B ((σ.setVar r.aBase av).setVar r.bBase bv) = some ov)
    (hbody : Run B body (withArgs r σ av bv ov) τ cost) :
    Run B (call r a b o body) σ τ (3 + a.size + b.size + o.size + cost) := by
  have hh := (Run.assign (x := r.aBase) ha).seq
    ((Run.assign (x := r.bBase) hb).seq ((Run.assign (x := r.outBase) ho).seq hbody))
  exact hh.mono (by omega)

/-  A binary macro, called with argument expressions: the whole call runs within the macro cost
plus the argument installation, and computes `f` of the decoded input slices. -/
theorem BinarySpec.call (r : FieldNames) {c : Com} {f : K → K → K} {cost : Nat}
    (hspec : BinarySpec F r c f cost) (a b o : Expr) {B av bv ov : Nat} {σ : Env}
    (ha : a.evalB B σ = some av)
    (hb : b.evalB B (σ.setVar r.aBase av) = some bv)
    (ho : o.evalB B ((σ.setVar r.aBase av).setVar r.bBase bv) = some ov)
    (hin : MacroInput F r B (withArgs r σ av bv ov)) :
    ∃ τ : Env, Run B (call r a b o c) σ τ (3 + a.size + b.size + o.size + cost) ∧
      decode F (slice F τ r ov) = f (decode F (slice F σ r av)) (decode F (slice F σ r bv)) ∧
      Canonical F (slice F τ r ov) ∧ MacroFrame F r (withArgs r σ av bv ov) τ := by
  obtain ⟨τ, hrun, hval, hcan, hframe⟩ := hspec B (withArgs r σ av bv ov) hin
  have hsub : [r.aBase, r.bBase, r.outBase].Sublist (scalarNames r) := by
    simp only [scalarNames]
    exact List.Sublist.cons _ (List.Sublist.cons _ (List.Sublist.cons _
      (List.Sublist.cons_cons _ (List.Sublist.cons_cons _ (List.Sublist.cons_cons _ (List.nil_sublist _))))))
  have hnd := hin.names.1.sublist hsub
  simp only [List.nodup_cons, List.mem_cons, List.mem_singleton, not_or, List.not_mem_nil,
    List.nodup_nil, and_true, not_false_eq_true] at hnd
  have h1 : (withArgs r σ av bv ov).vars r.outBase = ov := by simp [withArgs, Env.setVar]
  have h2 : (withArgs r σ av bv ov).vars r.bBase = bv := by simp [withArgs, Env.setVar, hnd.2]
  have h3 : (withArgs r σ av bv ov).vars r.aBase = av := by
    simp [withArgs, Env.setVar, hnd.1.1, hnd.1.2]
  rw [h1, h2, h3] at hval
  rw [h1] at hcan
  exact ⟨τ, call_run r a b o c ha hb ho hrun, hval, hcan, hframe⟩

