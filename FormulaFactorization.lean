  have hfa : fa * UInt64.word % p.toNat = a.toNat := by
    simpa [fa] using fromMont_repr ctx a ha
  have hfb : fb * UInt64.word % p.toNat = b.toNat := by
    simpa [fb] using fromMont_repr ctx b hb
