/- BEGIN CLEAN SOURCE Mathproof.Computability.FactorizationClean.StructuralMachines SHA256 6e0b601fdcaef123a5995a00d00935e8e6037164d79ee9dc77380860261cc3bf -/
section P25Clean0254




/-! Actual structural computers through the licensed native machine model.
The wire identities are proved independently in ListMachines. Only actual
computability certificates are transported; no interpreter, callback execution
or resource oracle is added. -/
namespace N0169.Computation
open Turing MultiTapeTM N0355 N0327
set_option autoImplicit false
set_option maxHeartbeats 1200000
noncomputable section

/-  Identity is executed by the licensed native identity computer. -/
theorem Realized.id {α : Type} (e : Encoding α) : Realized e e (id : α → α) :=
  native_to_realized (ComputableInPolyTime.of_eq (fun _=>rfl))

/-  Identical representation is executed by copying the input word. -/
theorem Realized.view {α β : Type} (ea : Encoding α) (eb : Encoding β)
    (f : α → β) (he : ∀ a,eb.encode (f a)=ea.encode a) : Realized ea eb f := by
  apply native_to_realized
  exact ComputableInPolyTime.of_eq he

/-  Only source words are transformed; a computable inverse is unnecessary. -/
theorem Realized.transportInput {α β γ : Type} {ea : Encoding α} {eb : Encoding β}
    {ec : Encoding γ} {f : α → β} (hf : Realized ea eb f) (p : γ → α)
    (he : ∀ c,ec.encode c=ea.encode (p c)) : Realized ec eb (f ∘ p) :=
  (Realized.view ec ea p (fun c=>(he c).symm)).comp hf

/-  The same physical output word can be interpreted by its target codec. -/
theorem Realized.transportOutput {α β γ : Type} {ea : Encoding α} {eb : Encoding β}
    {ec : Encoding γ} {f : α → β} {g : α → γ} (hf : Realized ea eb f)
    (he : ∀ a,ec.encode (g a)=eb.encode (f a)) : Realized ea ec g := by
  apply native_to_realized
  exact (realized_to_native hf).of_enc_eq he

theorem Realized.encoded {α β : Type} {ea : Encoding α} {eb : Encoding β}
    {f : α → β} (hf : Realized ea eb f) :
    Realized ea Encoding.bits (fun a=>eb.encode (f a)) :=
  hf.transportOutput (fun _=>rfl)

/-  A fixed finite-control lookup machine emits the complete constant word. -/
theorem Realized.const {α β : Type} (ea : Encoding α) (eb : Encoding β) (b : β) :
    Realized ea eb (fun _ : α=>b) :=
  native_to_realized (ComputableInPolyTime.const b)

/-  Every finite domain is implemented by a fixed finite lookup machine. -/
theorem Realized.of_finite {α β : Type} [Finite α] (ea : Encoding α) (eb : Encoding β)
    (f : α → β) : Realized ea eb f :=
  native_to_realized (ComputableInPolyTime.of_finite f)

/-  Both actual computers run on the original input; the pair frame is paid. -/
theorem Realized.pair {α β γ : Type} {ea : Encoding α} {eb : Encoding β} {ec : Encoding γ}
    {f : α → β} {g : α → γ} (hf : Realized ea eb f) (hg : Realized ea ec g) :
    Realized ea (eb.prod ec) (fun a=>(f a,g a)) := by
  apply native_to_realized
  rw [wire_prod]
  exact (realized_to_native hf).prod (realized_to_native hg)

theorem Realized.fst {α β : Type} (ea : Encoding α) (eb : Encoding β) :
    Realized (ea.prod eb) ea (Prod.fst : α × β → α) := by
  apply native_to_realized
  rw [wire_prod]
  exact ComputableInPolyTime.fst (wire ea) (wire eb)

theorem Realized.snd {α β : Type} (ea : Encoding α) (eb : Encoding β) :
    Realized (ea.prod eb) eb (Prod.snd : α × β → β) := by
  apply native_to_realized
  rw [wire_prod]
  exact ComputableInPolyTime.snd (wire ea) (wire eb)

theorem Realized.boolUnary {β : Type} (eb : Encoding β) (f : Bool → β) :
    Realized Encoding.bool eb f := Realized.of_finite _ _ f

theorem Realized.boolBinary {β : Type} (eb : Encoding β) (f : Bool × Bool → β) :
    Realized (Encoding.bool.prod Encoding.bool) eb f := Realized.of_finite _ _ f

/-  This uses the licensed conditional machine and all three actual certificates. -/
theorem Realized.cond {α β : Type} {ea : Encoding α} {eb : Encoding β}
    {test : α → Bool} {yes no : α → β} (ht : Realized ea Encoding.bool test)
    (hy : Realized ea eb yes) (hn : Realized ea eb no) :
    Realized ea eb (fun a=>if test a then yes a else no a) :=
  native_to_realized (ComputableInPolyTime.ite
    (realized_to_native ht) (realized_to_native hy) (realized_to_native hn))

theorem Realized.ite {α β : Type} {ea : Encoding α} {eb : Encoding β}
    (test : α → Prop) [∀ a,Decidable (test a)] {yes no : α → β}
    (ht : Realized ea Encoding.bool (fun a=>decide (test a)))
    (hy : Realized ea eb yes) (hn : Realized ea eb no) :
    Realized ea eb (fun a=>if test a then yes a else no a) := by
  exact (Realized.cond ht hy hn).congr (fun a=>by simp only [decide_eq_true_eq])

theorem Realized.select {α : Type} (ea : Encoding α) :
    Realized (Encoding.bool.prod (ea.prod ea)) ea
      (fun p : Bool × (α × α)=>if p.1 then p.2.1 else p.2.2) := by
  have ht := Realized.fst Encoding.bool (ea.prod ea)
  have hs := Realized.snd Encoding.bool (ea.prod ea)
  exact (Realized.cond ht (hs.comp (Realized.fst ea ea))
    (hs.comp (Realized.snd ea ea))).congr (fun _=>rfl)

/-  The native append primitive computes actual unframed output bytes. -/
theorem Realized.bitsAppend {α : Type} {ea : Encoding α} {left right : α → List Bool}
    (hl : Realized ea Encoding.bits left) (hr : Realized ea Encoding.bits right) :
    Realized ea Encoding.bits (fun a=>left a++right a) := by
  apply native_to_realized
  have hleft := realized_to_native hl
  have hright := realized_to_native hr
  rw [wire_bits] at hleft hright ⊢
  exact ComputableInPolyTime.bitsAppend hleft hright

theorem Realized.raw_append :
    Realized (Encoding.bits.prod Encoding.bits) Encoding.bits
      (fun p : List Bool × List Bool=>p.1++p.2) :=
  Realized.bitsAppend (Realized.fst _ _) (Realized.snd _ _)

end
