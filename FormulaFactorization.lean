/-  Complete actual kernel-discovery source for EVERY integer rectangular
matrix. No kernel, vector, determinant, field or source-execution oracle is input. -/
theorem kernelProgram_run {n d : ℕ} (σ : Env) (A : RectData n d)
    (hb : StableBank σ n) (hd : σ.vars dimVar=d) (harr : RectArrays σ A)
    (hS : (σ.arrs kernelS).length=n) (hN : (σ.arrs kernelN).length=n) :
    ∃τ,Run (N0282.wordBound (sourceBill A)) kernelProgram σ τ (kernelTime n d) ∧
      KernelResult τ (N0268.witness (rectValue A).transpose) := by
  obtain ⟨ρ,rs,hans⟩ := scanProgram_run σ A hb hd harr
  have fs := Frame.of_run rs
  cases hs : N0268.firstSingular (rectValue A).transpose with
  | none =>
    have haρ : ρ.vars scanAnswer=0 := by
      by_contra ha
      simp only [hs,Option.map_none,if_neg ha] at hans
      contradiction
    obtain ⟨τ,rf,hflag⟩ := finish_none_run ρ A haρ
    refine ⟨τ,(rs.seq rf).mono ?_,?_⟩
    · have ht := kernel_time_bound n d
      omega
    · simpa only [N0268.witness,hs,Option.map_none,KernelResult] using hflag
  | some j =>
    have haρ : ρ.vars scanAnswer=j.val+1 := by
      by_cases ha : ρ.vars scanAnswer=0
      · simp only [hs,Option.map_some,if_pos ha] at hans
        contradiction
      · have he : j.val+1=ρ.vars scanAnswer := by
          simpa only [hs,Option.map_some,if_neg ha,Option.some.injEq] using hans
        exact he.symm
    have hbρ := bank_frame fs (by decide) (by decide) hb
    have hdρ : ρ.vars dimVar=d := (fs.vars _ (by decide)).trans hd
    have harrρ : RectArrays ρ A := by
      intro i k
      rw [fs.arrs basisS (by decide),fs.arrs basisN (by decide)]
      exact harr i k
    obtain ⟨τ,rf,hflag,hout⟩ := finish_some_run ρ A j hbρ hdρ harrρ haρ
      ((fs.len _).trans hS) ((fs.len _).trans hN)
    refine ⟨τ,(rs.seq rf).mono (kernel_time_bound n d),?_⟩
    simp only [N0268.witness,hs,Option.map_some,KernelResult]
    exact ⟨hflag,outputWord A j,hout,funext (fun q=>outputWord_value A j q)⟩

