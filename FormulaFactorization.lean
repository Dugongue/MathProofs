section P25Clean0629



/-! Exact-cost reflection of literal absolute-coordinate programs into the relative tape ABI. -/
namespace Internal.N0339.N0197.N0002

open Turing Internal.N0339.N0349


variable {I Γ Q : Type} [Fintype I] [Fintype Γ] [Fintype Q] [Inhabited Γ]

/-  Every absolute action is one literal write and one unit movement on the relative tape. -/
def relativeMachine (P : Internal.N0339.N0349.N0001.Program I Γ Q) : Machine I Γ Q where
  transition q heads := (P.transition q heads).map fun p =>
    (p.1, fun i => ⟨some (p.2 i).1, (p.2 i).2⟩)

@[simp] theorem of_relativeMachine (P : Internal.N0339.N0349.N0001.Program I Γ Q) : Internal.N0339.N0349.N0001.ofMachine (relativeMachine P) = P := by
  cases P with
  | mk tr =>
      unfold Internal.N0339.N0349.N0001.ofMachine relativeMachine
      congr 1
      funext q heads
      cases ht : tr q heads with
      | none => simp only [Internal.N0339.N0349.N0001.ofMachine, relativeMachine, ht, Option.map_none]
      | some p =>
          simp only [Internal.N0339.N0349.N0001.ofMachine, relativeMachine, ht, Option.map_some, Option.getD_some]

/-  A real absolute step from a represented tape configuration has a real relative successor. -/
theorem relative_successor (M : Machine I Γ Q) (c : Config I Γ Q) (heads : I → ℤ)
    (next : Internal.N0339.N0349.N0001.Config I Γ Q) (h : Internal.N0339.N0349.N0001.step (Internal.N0339.N0349.N0001.ofMachine M) (Internal.N0339.N0349.N0001.realize c heads) = some next) :
    ∃ d, step M c = some d := by
  cases hs : step M c with
  | none =>
      have hh := (Internal.N0339.N0349.N0001.halts_iff M c heads).mpr hs
      change Internal.N0339.N0349.N0001.step (Internal.N0339.N0349.N0001.ofMachine M) (Internal.N0339.N0349.N0001.realize c heads) = none at hh
      rw [hh] at h
      cases h
  | some d => exact ⟨d, rfl⟩

/-  Reflection preserves every physical transition count and the exact entire final tape contents. -/
theorem runs_reflect (M : Machine I Γ Q) (n : ℕ) (c : Config I Γ Q) (heads : I → ℤ)
    (final : Internal.N0339.N0349.N0001.Config I Γ Q) (h : Internal.N0339.N0349.N0001.Runs (Internal.N0339.N0349.N0001.ofMachine M) n (Internal.N0339.N0349.N0001.realize c heads) final) :
    ∃ d lastHeads, Runs M n c d ∧ Internal.N0339.N0349.N0001.realize d lastHeads = final := by
  induction n generalizing c heads final with
  | zero =>
      cases h
      exact ⟨c, heads, .refl _, rfl⟩
  | succ n ih =>
      cases h with
      | cons hs hr =>
          obtain ⟨d, hd⟩ := relative_successor M c heads _ hs
          obtain ⟨midHeads, hmid, _⟩ := Internal.N0339.N0349.N0001.step_simulation M hd heads
          have he := Option.some.inj (hmid.symm.trans hs)
          rw [← he] at hr
          obtain ⟨result, lastHeads, hrun, hlast⟩ := ih d midHeads _ hr
          exact ⟨result, lastHeads, .cons hd hrun, hlast⟩

/-  All integer-indexed tape cells determine the genuine finitely supported tape. -/
theorem tape_nth_ext (t s : Tape Γ) (h : ∀ z, t.nth z = s.nth z) : t = s := by
  cases t with
  | mk th tl tr =>
      cases s with
      | mk sh sl sr =>
          have hh : th = sh := h 0
          subst sh
          have hl : tl = sl := ListBlank.ext (fun n => h (Int.negSucc n))
          have hr : tr = sr := ListBlank.ext (fun n => h (Int.ofNat (n + 1)))
          cases hl
          cases hr
          rfl

theorem realize_injective (heads : I → ℤ) : Function.Injective (fun c : Config I Γ Q => Internal.N0339.N0349.N0001.realize c heads) := by
  intro c d he
  cases c with
  | mk q tapes =>
      cases d with
      | mk q' tapes' =>
          have hq : q = q' := congrArg Internal.N0339.N0349.N0001.Config.state he
          subst q'
          congr 1
          funext i
          apply tape_nth_ext
          intro z
          have hc := congrArg (fun cfg : Internal.N0339.N0349.N0001.Config I Γ Q => cfg.cell i (z + heads i)) he
          simpa only [Internal.N0339.N0349.N0001.realize, Internal.N0339.N0349.N0333.absoluteCell, add_sub_cancel_right] using hc

/-  An existing absolute program's exact input/output proof transfers without rebuilding its algorithm. -/
theorem program_runs (P : Internal.N0339.N0349.N0001.Program I Γ Q) (n : ℕ) (c d : Config I Γ Q)
    (heads lastHeads : I → ℤ)
    (h : Internal.N0339.N0349.N0001.Runs P n (Internal.N0339.N0349.N0001.realize c heads) (Internal.N0339.N0349.N0001.realize d lastHeads)) :
    Runs (relativeMachine P) n c d := by
  rw [← of_relativeMachine P] at h
  obtain ⟨result, resultHeads, hr, he⟩ := runs_reflect (relativeMachine P) n c heads _ h
  have hheads : resultHeads = lastHeads := congrArg Internal.N0339.N0349.N0001.Config.head he
  rw [hheads] at he
  have hd : result = d := realize_injective lastHeads he
  exact hd ▸ hr

theorem program_halts (P : Internal.N0339.N0349.N0001.Program I Γ Q) (d : Config I Γ Q) (heads : I → ℤ)
    (h : Internal.N0339.N0349.N0001.Halts P (Internal.N0339.N0349.N0001.realize d heads)) : Halts (relativeMachine P) d := by
  apply (Internal.N0339.N0349.N0001.halts_iff (relativeMachine P) d heads).mp
  rwa [of_relativeMachine]

/-  Completed literal programs retain their actual exact cost and their true halt in the relative ABI. -/
theorem program_completed (P : Internal.N0339.N0349.N0001.Program I Γ Q) (n : ℕ) (c d : Config I Γ Q)
    (heads lastHeads : I → ℤ)
    (hr : Internal.N0339.N0349.N0001.Runs P n (Internal.N0339.N0349.N0001.realize c heads) (Internal.N0339.N0349.N0001.realize d lastHeads))
    (hh : Internal.N0339.N0349.N0001.Halts P (Internal.N0339.N0349.N0001.realize d lastHeads)) :
    Runs (relativeMachine P) n c d ∧ Halts (relativeMachine P) d :=
  ⟨program_runs P n c d heads lastHeads hr, program_halts P d lastHeads hh⟩


section PairedCopy
open Internal.N0339.N0349.N0001.N0385 (PairTape Phase)

def copyInput (as bs : List Bool) : Config PairTape (Option Bool) Phase :=
  ⟨.enter, fun k => match k with
