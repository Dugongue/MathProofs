/-  Actual initialized numeric literal heights. No height bound is a supplied oracle premise. -/
def fiberHeight (A : NumericPolynomial) : ℕ :=
  (range (A.natDegree+1)).sup (fun j => N0090.ratWeight (A.coeff j))

def residueHeight (A B : NumericPolynomial) (N d : ℕ) : ℕ :=
  (range (N+1)).sup (fun l => (range (A.natDegree+1)).sup (fun k =>
    (range (N*d+1)).sup (fun i => N0090.ratWeight
      (N0625.numericWeight (A^l) (N0625.clusterInverse A B l).1
        (A.natDegree*l-1) (i+(k-1))))))

 theorem fiberHeight_bound (A : NumericPolynomial) (j : ℕ) (hj : j ≤ A.natDegree) :
    N0090.ratWeight (A.coeff j) ≤ fiberHeight A := by
  exact Finset.le_sup (f := fun j => N0090.ratWeight (A.coeff j)) (mem_range.mpr (by omega))

