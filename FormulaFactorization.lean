  intro i hi
  simp [h₁ i hi, h₂ i hi]

omit [BEq R] [LawfulBEq R] in
private lemma lowEq.neg {k : Nat} {p q : R[X]} (h : lowEq k p q) :
    lowEq k (-p) (-q) := by
  intro i hi
  simp [h i hi]

omit [BEq R] [LawfulBEq R] in
private lemma lowEq.sub {k : Nat} {p₁ p₂ q₁ q₂ : R[X]}
