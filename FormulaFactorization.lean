    (A B : NumericPolynomial) (N d k : ℕ) (E : N0090.Formula (Option ι)) :
    N0090.bitCost w (reverseCoefficientSource A B N d k E) ≤
      reverseCoefficientBudget A.natDegree N d (fiberHeight A) (residueHeight A B N d)
