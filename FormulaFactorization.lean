    decode n (fun i=>P.coeff i.val)=P := by
  apply CPolynomial.eq_iff_coeff.mpr
  intro i
  rw [decode_coeff]
  split_ifs with hi
  · rfl
  · simpa only [← CPolynomial.coeff_toPoly] using
      (Polynomial.coeff_eq_zero_of_degree_lt
        (hP.trans_le (by exact_mod_cast Nat.le_of_not_gt hi))).symm

noncomputable def decodeLinear (n : ℕ) : (Fin n → ℚ) →ₗ[ℚ] ℚ[X] where
  toFun v := (decode n v).toPoly
  map_add' u v := by
    ext i
    simp only [← CPolynomial.coeff_toPoly,decode_coeff,Polynomial.coeff_add,Pi.add_apply]
    split_ifs <;> simp
  map_smul' c v := by
    ext i
    simp only [← CPolynomial.coeff_toPoly,decode_coeff,Polynomial.coeff_smul,Pi.smul_apply,smul_eq_mul]
    split_ifs <;> simp

abbrev unknowns (a b : ℕ) := a+(b+1)
def leftPart (a b : ℕ) (v : Fin (unknowns a b) → ℚ) : Fin a → ℚ :=
  fun i=>v (Fin.castAdd (b+1) i)
def rightPart (a b : ℕ) (v : Fin (unknowns a b) → ℚ) : Fin b → ℚ :=
  fun i=>v (Fin.natAdd a i.castSucc)
def lastIndex (a b : ℕ) : Fin (unknowns a b) := Fin.natAdd a (Fin.last b)
def lastPart (a b : ℕ) (v : Fin (unknowns a b) → ℚ) : ℚ := v (lastIndex a b)

def U (A B : XPoly) (v : Fin (unknowns A.natDegree B.natDegree) → ℚ) : XPoly :=
  decode A.natDegree (leftPart A.natDegree B.natDegree v)
def V (A B : XPoly) (v : Fin (unknowns A.natDegree B.natDegree) → ℚ) : XPoly :=
  decode B.natDegree (rightPart A.natDegree B.natDegree v)
def relation (E A B : XPoly) (v : Fin (unknowns A.natDegree B.natDegree) → ℚ) : XPoly :=
  U A B v*B+V A B v*A-CPolynomial.C (lastPart A.natDegree B.natDegree v)*E

noncomputable def relationLinear (E A B : XPoly) :
    (Fin (unknowns A.natDegree B.natDegree) → ℚ) →ₗ[ℚ] ℚ[X] where
  toFun v := decodeLinear A.natDegree (leftPart A.natDegree B.natDegree v)*B.toPoly+
    decodeLinear B.natDegree (rightPart A.natDegree B.natDegree v)*A.toPoly-
    Polynomial.C (lastPart A.natDegree B.natDegree v)*E.toPoly
  map_add' u v := by
    change decodeLinear A.natDegree (leftPart _ _ u+leftPart _ _ v)*B.toPoly+
      decodeLinear B.natDegree (rightPart _ _ u+rightPart _ _ v)*A.toPoly-
      Polynomial.C (lastPart _ _ u+lastPart _ _ v)*E.toPoly=_
    rw [map_add,map_add,map_add]
    ring
  map_smul' c v := by
    change decodeLinear A.natDegree (c • leftPart _ _ v)*B.toPoly+
      decodeLinear B.natDegree (c • rightPart _ _ v)*A.toPoly-
      Polynomial.C (c*lastPart _ _ v)*E.toPoly=_
    rw [map_smul,map_smul,map_mul]
    simp only [Polynomial.smul_eq_C_mul,RingHom.id_apply]
    ring

theorem relationLinear_apply (E A B : XPoly) (v : Fin (unknowns A.natDegree B.natDegree) → ℚ) :
    relationLinear E A B v=(relation E A B v).toPoly := by
  simp only [relation,CPolynomial.toPoly_sub,CPolynomial.toPoly_add,CPolynomial.toPoly_mul,
    CPolynomial.C_toPoly]
  rfl

noncomputable def coefficients (n : ℕ) : ℚ[X] →ₗ[ℚ] (Fin n → ℚ) where
  toFun P := fun i=>P.coeff i.val
  map_add' P Q := by ext i;simp
  map_smul' c P := by ext i;simp

def matrix (E A B : XPoly) :
    Matrix (Fin (A.natDegree+B.natDegree)) (Fin (unknowns A.natDegree B.natDegree)) ℚ :=
  fun i j=>(relation E A B (Pi.single j 1)).coeff i.val

theorem matrix_eq (E A B : XPoly) : matrix E A B=
    LinearMap.toMatrix' ((coefficients (A.natDegree+B.natDegree)).comp (relationLinear E A B)) := by
  ext i j
  rw [LinearMap.toMatrix'_apply]
  change _=(relationLinear E A B (Pi.single j 1)).coeff i.val
  rw [relationLinear_apply,← CPolynomial.coeff_toPoly]
  rfl

theorem matrix_mulVec (E A B : XPoly) (v : Fin (unknowns A.natDegree B.natDegree) → ℚ) :
    matrix E A B *ᵥ v=fun i=>(relation E A B v).coeff i.val := by
  rw [matrix_eq,LinearMap.toMatrix'_mulVec]
  change (fun i : Fin (A.natDegree+B.natDegree)=>(relationLinear E A B v).coeff i.val)=_
  rw [relationLinear_apply]
  simp only [CPolynomial.coeff_toPoly]

theorem relation_degree (E A B : XPoly) (hA : A.toPoly.Monic) (hB : B.toPoly.Monic)
    (hE : E.toPoly.degree<A.toPoly.degree+B.toPoly.degree)
    (v : Fin (unknowns A.natDegree B.natDegree) → ℚ) :
    (relation E A B v).toPoly.degree<A.toPoly.degree+B.toPoly.degree := by
  rw [relation,CPolynomial.toPoly_sub,CPolynomial.toPoly_add,CPolynomial.toPoly_mul,
    CPolynomial.toPoly_mul,CPolynomial.toPoly_mul,CPolynomial.C_toPoly]
  apply (Polynomial.degree_sub_le _ _).trans_lt
  apply max_lt
  · apply correction_sum_degree _ _ _ _ hA hB
    · simpa only [U,Polynomial.degree_eq_natDegree hA.ne_zero,CPolynomial.natDegree_toPoly] using
        decode_degree A.natDegree (leftPart A.natDegree B.natDegree v)
    · simpa only [V,Polynomial.degree_eq_natDegree hB.ne_zero,CPolynomial.natDegree_toPoly] using
        decode_degree B.natDegree (rightPart A.natDegree B.natDegree v)
  · apply (Polynomial.degree_mul_le _ _).trans_lt
    calc
      _ ≤ (0 : WithBot ℕ)+E.toPoly.degree := by
        gcongr
        exact Polynomial.degree_C_le
      _ < _ := by simpa only [zero_add] using hE

theorem kernel_iff (E A B : XPoly) (hA : A.toPoly.Monic) (hB : B.toPoly.Monic)
    (hE : E.toPoly.degree<A.toPoly.degree+B.toPoly.degree)
    (v : Fin (unknowns A.natDegree B.natDegree) → ℚ) :
    matrix E A B *ᵥ v=0 ↔ (relation E A B v).toPoly=0 := by
  rw [matrix_mulVec]
  constructor
  · intro hv
    apply Polynomial.ext
    intro i
    by_cases hi : i<A.natDegree+B.natDegree
    · have he := congrFun hv ⟨i,hi⟩
      simpa only [← CPolynomial.coeff_toPoly,Polynomial.coeff_zero,Pi.zero_apply] using he
    · rw [Polynomial.coeff_zero]
      apply Polynomial.coeff_eq_zero_of_degree_lt
      apply (relation_degree E A B hA hB hE v).trans_le
      rw [Polynomial.degree_eq_natDegree hA.ne_zero,Polynomial.degree_eq_natDegree hB.ne_zero,
        ← CPolynomial.natDegree_toPoly,← CPolynomial.natDegree_toPoly]
      exact_mod_cast Nat.le_of_not_gt hi
  · intro hv
    ext i
    simpa only [← CPolynomial.coeff_toPoly,Polynomial.coeff_zero,Pi.zero_apply] using
      congrArg (fun P : ℚ[X] => P.coeff i.val) hv

def encode (A B U V : XPoly) (z : ℚ) : Fin (unknowns A.natDegree B.natDegree) → ℚ :=
  Fin.append (fun i=>U.coeff i.val) (Fin.snoc (fun i=>V.coeff i.val) z)

theorem encode_parts (A B U V : XPoly) (z : ℚ) :
    leftPart A.natDegree B.natDegree (encode A B U V z)=(fun i=>U.coeff i.val) ∧
    rightPart A.natDegree B.natDegree (encode A B U V z)=(fun i=>V.coeff i.val) ∧
    lastPart A.natDegree B.natDegree (encode A B U V z)=z := by
  dsimp only [leftPart,rightPart,lastPart,lastIndex,encode]
  constructor
  · funext i;exact Fin.append_left _ _ i
  · constructor
    · funext i
      change Fin.append (fun i : Fin A.natDegree=>U.coeff i.val)
        (Fin.snoc (fun i : Fin B.natDegree=>V.coeff i.val) z)
        (Fin.natAdd A.natDegree i.castSucc)=V.coeff i.val
      rw [Fin.append_right,Fin.snoc_castSucc]
    · rw [Fin.append_right,Fin.snoc_last]

theorem zero_last_implies_zero (E A B : XPoly) (hA : A.toPoly.Monic)
    (hc : IsCoprime A.toPoly B.toPoly) (v : Fin (unknowns A.natDegree B.natDegree) → ℚ)
    (hv : (relation E A B v).toPoly=0) (hz : lastPart A.natDegree B.natDegree v=0) : v=0 := by
  have hu : (U A B v).toPoly.degree<A.toPoly.degree := by
    simpa only [U,Polynomial.degree_eq_natDegree hA.ne_zero,CPolynomial.natDegree_toPoly] using
      decode_degree A.natDegree (leftPart A.natDegree B.natDegree v)
  have hrel : A.toPoly*(V A B v).toPoly+(U A B v).toPoly*B.toPoly=0 := by
    simpa only [relation,CPolynomial.toPoly_sub,CPolynomial.toPoly_add,CPolynomial.toPoly_mul,
      CPolynomial.C_toPoly,hz,map_zero,zero_mul,sub_zero,add_comm,mul_comm] using hv
  have he := coprime_correction_unique hA hc hu hrel
  have hleft : leftPart A.natDegree B.natDegree v=0 := by
    funext i
    have h := congrArg (fun P : ℚ[X] => P.coeff i.val) he.1
    simpa only [U,← CPolynomial.coeff_toPoly,decode_coeff,dif_pos i.isLt,Polynomial.coeff_zero,Pi.zero_apply] using h
  have hright : rightPart A.natDegree B.natDegree v=0 := by
    funext i
    have h := congrArg (fun P : ℚ[X] => P.coeff i.val) he.2
    simpa only [V,← CPolynomial.coeff_toPoly,decode_coeff,dif_pos i.isLt,Polynomial.coeff_zero,Pi.zero_apply] using h
  funext i
  refine Fin.addCases (fun j=>?_) (fun j=>?_) i
  · exact congrFun hleft j
  · refine Fin.lastCases ?_ (fun j=>?_) j
    · exact hz
    · exact congrFun hright j

def normalized (A B : XPoly) (v : Fin (unknowns A.natDegree B.natDegree) → ℤ) :
    Fin (unknowns A.natDegree B.natDegree) → ℚ :=
  fun i=>(v i:ℚ)/(v (lastIndex A.natDegree B.natDegree):ℚ)

/-  Actual original-input determinant/kernel computation and coordinate division. -/
def solve (E A B : XPoly) : XPoly×XPoly :=
  match N0591.witness (matrix E A B) with
  | none => (0,0)
  | some v => (U A B (normalized A B v),V A B (normalized A B v))

theorem witness_exists (E A B : XPoly) (hA : A.toPoly.Monic) (hB : B.toPoly.Monic)
    (hc : IsCoprime A.toPoly B.toPoly)
    (hE : E.toPoly.degree<A.toPoly.degree+B.toPoly.degree) :
    ∃w,N0591.witness (matrix E A B)=some w ∧
      matrix E A B *ᵥ (fun j=>(w j:ℚ))=0 ∧ w≠0 := by
  let uv := N0364.correction E A B
  let v := encode A B uv.1 uv.2 1
  have hd := N0364.correction_degrees E A B hA hB hc hE
  have hid := N0364.correction_identity E A B hA hc
  have hp := encode_parts A B uv.1 uv.2 1
  have hu : decode A.natDegree (fun i=>uv.1.coeff i.val)=uv.1 := by
    apply decode_encode
    simpa only [Polynomial.degree_eq_natDegree hA.ne_zero,CPolynomial.natDegree_toPoly] using hd.1
  have hv : decode B.natDegree (fun i=>uv.2.coeff i.val)=uv.2 := by
    apply decode_encode
    simpa only [Polynomial.degree_eq_natDegree hB.ne_zero,CPolynomial.natDegree_toPoly] using hd.2
  have hk : matrix E A B *ᵥ v=0 := by
    apply (kernel_iff E A B hA hB hE v).mpr
    simp only [relation,U,V,v,hp.1,hp.2.1,hp.2.2,hu,hv,
      CPolynomial.toPoly_sub,CPolynomial.toPoly_add,CPolynomial.toPoly_mul,CPolynomial.C_toPoly,
      map_one,one_mul]
    exact sub_eq_zero.mpr hid.symm
  have hn : v≠0 := by
    intro hz
    have he : v (lastIndex A.natDegree B.natDegree)=1 := hp.2.2
    rw [hz,Pi.zero_apply] at he
    exact zero_ne_one he
  exact N0591.witness_complete (matrix E A B) v hk hn

/-  Universal actual correction refinement, including zero-degree seed factors.
The former Euclidean algorithm is not called anywhere in solve. -/
theorem solve_eq_correction (E A B : XPoly) (hA : A.toPoly.Monic) (hB : B.toPoly.Monic)
    (hc : IsCoprime A.toPoly B.toPoly)
    (hE : E.toPoly.degree<A.toPoly.degree+B.toPoly.degree) :
    solve E A B=N0364.correction E A B := by
  obtain ⟨w,hw,hker,hn⟩ := witness_exists E A B hA hB hc hE
  have hrel := (kernel_iff E A B hA hB hE (fun j=>(w j:ℚ))).mp hker
  have hz : (w (lastIndex A.natDegree B.natDegree):ℚ)≠0 := by
    intro hz
    have hzero := zero_last_implies_zero E A B hA hc (fun j=>(w j:ℚ)) hrel hz
    apply hn
    funext j
    have hj : (w j:ℚ)=0 := by simpa only [Pi.zero_apply] using congrFun hzero j
    change w j=0
    exact_mod_cast hj
  have hnrm : normalized A B w=
      (w (lastIndex A.natDegree B.natDegree):ℚ)⁻¹ • (fun j=>(w j:ℚ)) := by
    ext j
    simp [normalized,Pi.smul_apply,smul_eq_mul,div_eq_mul_inv,mul_comm]
  have hkn : matrix E A B *ᵥ normalized A B w=0 := by
    rw [hnrm,Matrix.mulVec_smul,hker,smul_zero]
  have hlast : lastPart A.natDegree B.natDegree (normalized A B w)=1 := by
    simp [lastPart,normalized,hz]
  have hid : E.toPoly=(U A B (normalized A B w)).toPoly*B.toPoly+
      (V A B (normalized A B w)).toPoly*A.toPoly := by
    have he := (kernel_iff E A B hA hB hE (normalized A B w)).mp hkn
    simp only [relation,CPolynomial.toPoly_sub,CPolynomial.toPoly_add,CPolynomial.toPoly_mul,
      CPolynomial.C_toPoly,hlast,map_one,one_mul] at he
    exact (sub_eq_zero.mp he).symm
  have hdu : (U A B (normalized A B w)).toPoly.degree<A.toPoly.degree := by
    simpa only [U,Polynomial.degree_eq_natDegree hA.ne_zero,CPolynomial.natDegree_toPoly] using
      decode_degree A.natDegree (leftPart A.natDegree B.natDegree (normalized A B w))
  have hdold := N0364.correction_degrees E A B hA hB hc hE
  have heq := coprime_correction_pair_unique hA hc hdu hdold.1 hid
    (N0364.correction_identity E A B hA hc)
  rw [solve,hw]
  apply Prod.ext
  · apply (CPolynomial.ringEquiv (R:=ℚ)).injective
    exact heq.1
  · apply (CPolynomial.ringEquiv (R:=ℚ)).injective
    exact heq.2

/-  Every positive-order residual formed from an actual prefix lies in the
fixed Sylvester window; there is no residual-degree input oracle. -/
theorem actual_residual_degree (P : Poly) (A B : XPoly)
    (hA : A.toPoly.Monic) (hB : B.toPoly.Monic) (hc : IsCoprime A.toPoly B.toPoly)
    (h0 : (P.coeff 0).toPoly=A.toPoly*B.toPoly)
    (hd : ∀q>0,(P.coeff q).toPoly.degree<A.toPoly.degree+B.toPoly.degree)
    (t q : ℕ) (hq : 0<q) :
    (residual P (iterate P A B t).1 (iterate P A B t).2 q).toPoly.degree<
      A.toPoly.degree+B.toPoly.degree := by
  have hm := iterate_monic_degrees P A B hA hB hc h0 hd t
  have hprod : (Polynomial.Bivariate.swap
      (image (iterate P A B t).1*image (iterate P A B t).2)).Monic := by
    rw [map_mul]
    exact hm.1.mul hm.2.2.1
  have hz : (image (iterate P A B t).1*image (iterate P A B t).2).coeff 0=
      A.toPoly*B.toPoly := by
    rw [iterate_product_coeff P A B hA hB hc h0 hd t 0 (Nat.zero_le _),
      N0365.polynomial_coeff,h0]
  have hbound := N0319.monic_swap_positive_degree _ _ hprod hz q hq
  rw [Polynomial.degree_mul] at hbound
  rw [residual_image]
  exact (Polynomial.degree_sub_le _ _).trans_lt
    (max_lt (by simpa only [N0365.polynomial_coeff] using hd q hq) hbound)

