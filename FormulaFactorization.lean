/-  Literal pointer computation selects the existing low n+1 coefficients of
f, before the installer changes the native gcd capacity and second address. -/
theorem first_run (p Sn W n M c : ℕ) [Fact p.Prime] (σ : Env)
    (hs : Slots (presentation p) canonical nq.WS Sn W σ)
    (hN : σ.vars nq.n=M) (hc : σ.vars secondRegister=c) (hn : σ.vars degreeRegister=n)
