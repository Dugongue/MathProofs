      rw [he, Nat.add_mod_right, Nat.mod_eq_of_lt (by omega)]
    rw [hrhs]

theorem subModWord_lt (m a b : UInt64) (hm : 0 < m.toNat) (hmw : m.toNat ≤ UInt64.word)
