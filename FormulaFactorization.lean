    image (decode a b (u+v))=image (decode a b u)+image (decode a b v) := by
  ext i j
  by_cases hi : i<a+1 <;> by_cases hj : j<b+1 <;>
    simp [Polynomial.coeff_add,decode_coefficient,hi,hj]

