  obtain ⟨⟨t, s, ht, hs, k, State, hfin, tm, htm⟩, hl⟩ := hf
  refine ⟨⟨t, s, ht, hs, k, State, hfin, tm, fun a => ?_⟩, ?_⟩
  · simpa only [h a] using htm a
  · exact hl.mono fun a => by rw [h a]

