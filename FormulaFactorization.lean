/-!
# Adaptive joins of finite factor partitions

Partitions are equivalence relations on the labels of the distinct factors in a
fixed univariate fiber.  `P ≤ T` means that every current block lies in a block of
the true factor partition.  Joining another safe partition preserves this
invariant.  A pair joined by the new partition but separated by the current one
strictly reduces the number of quotient classes.

This module proves the finite combinatorial statements.  The polynomial module
must supply the safe fiber partitions and the crossing pair from a failed
factor test; those algebraic assertions are not assumed as new axioms here.
-/

namespace Internal.N0339.N0197.Partition

universe u

/-  Number of equivalence classes of a finite partition. -/
noncomputable def blockCount {α : Type u} (P : Setoid α) : ℕ :=
  Nat.card (Quotient P)

/-  A new partition joins two labels that the current partition separates. -/
def Crosses {α : Type u} (P Q : Setoid α) : Prop :=
  ∃ a b, Q a b ∧ ¬ P a b

theorem quotientMap_surjective {α : Type u} {P Q : Setoid α} (h : P ≤ Q) :
    Function.Surjective (Setoid.map_of_le h) := by
  intro q
  induction q using Quotient.inductionOn with
  | _ a => exact ⟨Quotient.mk P a, rfl⟩

theorem quotientMap_not_injective_of_crossing {α : Type u}
    {P Q : Setoid α} (h : P ≤ Q) {a b : α} (hQ : Q a b) (hP : ¬ P a b) :
    ¬ Function.Injective (Setoid.map_of_le h) := by
  intro hinj
  apply hP
  apply Quotient.exact
  apply hinj
  exact Quotient.sound hQ

theorem blockCount_lt_of_le_of_crossing {α : Type u} [Finite α]
    {P Q : Setoid α} (h : P ≤ Q) {a b : α} (hQ : Q a b) (hP : ¬ P a b) :
    blockCount Q < blockCount P := by
  classical
  let := Fintype.ofFinite (Quotient P)
  let := Fintype.ofFinite (Quotient Q)
  simpa only [blockCount, Nat.card_eq_fintype_card] using
    Fintype.card_lt_of_surjective_not_injective (Setoid.map_of_le h)
      (quotientMap_surjective h) (quotientMap_not_injective_of_crossing h hQ hP)

theorem join_refines {α : Type u} {P Q T : Setoid α}
    (hP : P ≤ T) (hQ : Q ≤ T) : P ⊔ Q ≤ T :=
  sup_le hP hQ

theorem blockCount_join_lt_of_crosses {α : Type u} [Finite α]
    {P Q : Setoid α} (h : Crosses P Q) : blockCount (P ⊔ Q) < blockCount P := by
  obtain ⟨a, b, hQ, hP⟩ := h
  have hleft : P ≤ P ⊔ Q := le_sup_left
  have hright : Q ≤ P ⊔ Q := le_sup_right
  exact blockCount_lt_of_le_of_crossing hleft (hright hQ) hP

theorem crosses_iff_not_le {α : Type u} {P Q : Setoid α} :
    Crosses P Q ↔ ¬ Q ≤ P := by
  classical
  constructor
  · rintro ⟨a, b, hQ, hP⟩ hle
    exact hP (hle hQ)
  · intro h
    by_contra hcross
    apply h
    intro a b hQ
    by_contra hP
    exact hcross ⟨a, b, hQ, hP⟩

theorem blockCount_le_labels {r : ℕ} (P : Setoid (Fin r)) :
    blockCount P ≤ r := by
  have h := Nat.card_le_card_of_surjective (Quotient.mk P) Quotient.mk_surjective
  simpa only [blockCount, Nat.card_fin] using h

theorem blockCount_bot (r : ℕ) : blockCount (⊥ : Setoid (Fin r)) = r := by
  exact (Nat.card_congr Setoid.quotientBotEquiv).trans (Nat.card_fin r)

theorem blockCount_pos {r : ℕ} (hr : 0 < r) (P : Setoid (Fin r)) :
    0 < blockCount P := by
  let : Nonempty (Fin r) := ⟨⟨0, hr⟩⟩
  let : Nonempty (Quotient P) := ⟨Quotient.mk P ⟨0, hr⟩⟩
  exact Nat.card_pos

/-  Every strict decrease consumes at least one unit of the initial budget. -/
theorem descending_budget (μ : ℕ → ℕ) (k : ℕ)
    (hstep : ∀ i, i < k → μ (i + 1) < μ i) : μ k + k ≤ μ 0 := by
  induction k with
  | zero => simp
  | succ k ih =>
      have hpre : ∀ i, i < k → μ (i + 1) < μ i := by
        intro i hi
        exact hstep i (Nat.lt_trans hi (Nat.lt_succ_self k))
      have hi := ih hpre
      have hk := hstep k (Nat.lt_succ_self k)
      omega

/-  The actual join operation and a crossing pair force a strict budget drop. -/
theorem join_chain_budget {r : ℕ} (P Q : ℕ → Setoid (Fin r)) (k : ℕ)
    (hjoin : ∀ i, i < k → P (i + 1) = P i ⊔ Q i)
    (hcross : ∀ i, i < k → Crosses (P i) (Q i)) :
    blockCount (P k) + k ≤ blockCount (P 0) := by
  apply descending_budget (fun i => blockCount (P i)) k
  intro i hi
  rw [hjoin i hi]
  exact blockCount_join_lt_of_crosses (hcross i hi)

/-  At most `r - 1` successful strict joins are possible on `r > 0` labels. -/
theorem strict_join_rounds_le {r : ℕ} (hr : 0 < r)
    (P Q : ℕ → Setoid (Fin r)) (k : ℕ)
    (hjoin : ∀ i, i < k → P (i + 1) = P i ⊔ Q i)
    (hcross : ∀ i, i < k → Crosses (P i) (Q i)) : k ≤ r - 1 := by
  have hbudget := join_chain_budget P Q k hjoin hcross
  have hupper := blockCount_le_labels (P 0)
  have hpos := blockCount_pos hr (P k)
  omega

/-  Every stage remains inside the same fixed true factor partition. -/
theorem join_chain_refines {r : ℕ} (P Q : ℕ → Setoid (Fin r))
    (T : Setoid (Fin r)) (k : ℕ) (hzero : P 0 ≤ T)
    (hjoin : ∀ i, i < k → P (i + 1) = P i ⊔ Q i)
    (hsafe : ∀ i, i < k → Q i ≤ T) : P k ≤ T := by
  induction k with
  | zero => exact hzero
  | succ k ih =>
      have hpre : ∀ i, i < k → P (i + 1) = P i ⊔ Q i := by
        intro i hi
        exact hjoin i (Nat.lt_trans hi (Nat.lt_succ_self k))
      have hsafePre : ∀ i, i < k → Q i ≤ T := by
        intro i hi
        exact hsafe i (Nat.lt_trans hi (Nat.lt_succ_self k))
      rw [hjoin k (Nat.lt_succ_self k)]
      exact join_refines (ih hpre hsafePre) (hsafe k (Nat.lt_succ_self k))

/-  A safe partition with no remaining crossing of the true partition is exact. -/
theorem eq_of_refines_of_no_crossing {α : Type u} {P T : Setoid α}
    (hsafe : P ≤ T) (hterminal : ¬ Crosses P T) : P = T := by
  apply le_antisymm hsafe
  by_contra h
  exact hterminal (crosses_iff_not_le.mpr h)


/-! ## Executable joins of array-backed label partitions

A table `v : Vector (Fin r) r` represents the equivalence relation given by
having equal entries.  Each merge materializes a new array; it does not build a
nested function whose evaluation could repeatedly traverse previous merges.
-/

/-  Read a class label at a finite index. -/
def label {r : ℕ} (v : Vector (Fin r) r) (i : Fin r) : Fin r := v[i.val]

/-  The partition encoded by an array of class labels. -/
def labelSetoid {r : ℕ} (v : Vector (Fin r) r) : Setoid (Fin r) :=
  Setoid.ker (fun i => (label v i))

/-  Merge the blocks containing `a` and `b`, scanning the label table once. -/
def mergeLabels {r : ℕ} (v : Vector (Fin r) r) (a b : Fin r) :
    Vector (Fin r) r :=
  let va := (label v a)
  let vb := (label v b)
  v.map (fun x => if x = vb then va else x)

@[simp] theorem label_mergeLabels {r : ℕ} (v : Vector (Fin r) r)
    (a b x : Fin r) :
    label (mergeLabels v a b) x = if label v x = label v b then label v a else label v x := by
  simp only [label, mergeLabels, Vector.getElem_map]
  rfl
theorem labelSetoid_le_mergeLabels {r : ℕ} (v : Vector (Fin r) r)
    (a b : Fin r) : labelSetoid v ≤ labelSetoid (mergeLabels v a b) := by
  intro x y h
  change (label v x) = (label v y) at h
  change (label (mergeLabels v a b) x) = (label (mergeLabels v a b) y)
  simp only [label_mergeLabels]
  rw [h]

theorem mergeLabels_relates {r : ℕ} (v : Vector (Fin r) r) (a b : Fin r) :
    labelSetoid (mergeLabels v a b) a b := by
  change (label (mergeLabels v a b) a) = (label (mergeLabels v a b) b)
  simp only [label_mergeLabels]
  by_cases h : (label v a) = (label v b) <;> simp [h]

/-  Merging two labels already equivalent under `T` preserves refinement of `T`. -/
theorem mergeLabels_refines {r : ℕ} (v : Vector (Fin r) r)
    (a b : Fin r) (T : Setoid (Fin r))
    (hv : labelSetoid v ≤ T) (hab : T a b) :
    labelSetoid (mergeLabels v a b) ≤ T := by
  intro x y h
  change (label (mergeLabels v a b) x) = (label (mergeLabels v a b) y) at h
  simp only [label_mergeLabels] at h
  by_cases hx : (label v x) = (label v b)
  · by_cases hy : (label v y) = (label v b)
    · exact hv (hx.trans hy.symm)
    · have hay : (label v a) = (label v y) := by simpa [hx, hy] using h
      exact T.trans (T.trans (hv hx) (T.symm hab)) (hv hay)
  · by_cases hy : (label v y) = (label v b)
    · have hxa : (label v x) = (label v a) := by simpa [hx, hy] using h
      exact T.trans (T.trans (hv hxa) hab) (T.symm (hv hy))
    · apply hv
      change label v x = label v y
      simpa [hx, hy] using h

/-  Execute a list of elementary block merges. -/
def mergeEdges {r : ℕ} (v : Vector (Fin r) r) :
    List (Fin r × Fin r) → Vector (Fin r) r
  | [] => v
  | (a, b) :: es => mergeEdges (mergeLabels v a b) es

theorem labelSetoid_le_mergeEdges {r : ℕ} (es : List (Fin r × Fin r))
    (v : Vector (Fin r) r) : labelSetoid v ≤ labelSetoid (mergeEdges v es) := by
  induction es generalizing v with
  | nil => exact le_rfl
  | cons e es ih =>
      exact le_trans (labelSetoid_le_mergeLabels v e.1 e.2)
        (ih (mergeLabels v e.1 e.2))

theorem mergeEdges_refines {r : ℕ} (es : List (Fin r × Fin r))
    (v : Vector (Fin r) r) (T : Setoid (Fin r))
    (hv : labelSetoid v ≤ T) (hes : ∀ e ∈ es, T e.1 e.2) :
    labelSetoid (mergeEdges v es) ≤ T := by
  induction es generalizing v with
  | nil => exact hv
  | cons e es ih =>
      apply ih (mergeLabels v e.1 e.2)
      · exact mergeLabels_refines v e.1 e.2 T hv (hes e (by simp))
      · intro e' he'
        exact hes e' (by simp [he'])

theorem mergeEdges_relates {r : ℕ} (es : List (Fin r × Fin r))
    (v : Vector (Fin r) r) {a b : Fin r} (he : (a, b) ∈ es) :
    labelSetoid (mergeEdges v es) a b := by
  induction es generalizing v with
  | nil => simp at he
  | cons e es ih =>
      rcases List.mem_cons.mp he with h | h
      · cases h
        exact labelSetoid_le_mergeEdges es (mergeLabels v a b)
          (mergeLabels_relates v a b)
      · exact ih (mergeLabels v e.1 e.2) h

/-  All pairs of labels related by the second input partition. -/
def labelEdges {r : ℕ} (w : Vector (Fin r) r) : List (Fin r × Fin r) :=
  ((List.finRange r).product (List.finRange r)).filter (fun e => (label w e.1) = (label w e.2))

@[simp] theorem mem_labelEdges {r : ℕ} (w : Vector (Fin r) r) (a b : Fin r) :
    (a, b) ∈ labelEdges w ↔ (label w a) = (label w b) := by
  simp [labelEdges]

theorem length_labelEdges_le {r : ℕ} (w : Vector (Fin r) r) :
    (labelEdges w).length ≤ r * r := by
  have hprod : ((List.finRange r).product (List.finRange r)).length = r * r := by
    exact (List.length_product _ _).trans (by simp)
  exact (List.length_filter_le _ _).trans_eq hprod

/-  An executable join, with array labels as both input and output. -/
def joinLabels {r : ℕ} (v w : Vector (Fin r) r) : Vector (Fin r) r :=
  mergeEdges v (labelEdges w)

/-  The computed label partition is exactly the actual lattice join. -/
theorem labelSetoid_joinLabels {r : ℕ} (v w : Vector (Fin r) r) :
    labelSetoid (joinLabels v w) = labelSetoid v ⊔ labelSetoid w := by
  apply le_antisymm
  · apply mergeEdges_refines (labelEdges w) v _ le_sup_left
    intro e he
    have hright : labelSetoid w ≤ labelSetoid v ⊔ labelSetoid w := le_sup_right
    exact hright ((mem_labelEdges w e.1 e.2).mp he)
  · apply sup_le
    · exact labelSetoid_le_mergeEdges (labelEdges w) v
    · intro a b hab
      exact mergeEdges_relates (labelEdges w) v ((mem_labelEdges w a b).mpr hab)

/-  Number of label-comparison slots: one for every pair during filtering,
then `r` for each materialized table map.  This is an explicit abstract operation
count, not a theorem about a compiler or a machine-cost semantics. -/
def joinComparisonSlots {r : ℕ} (w : Vector (Fin r) r) : ℕ :=
  r * r + r * (labelEdges w).length

theorem joinComparisonSlots_le {r : ℕ} (w : Vector (Fin r) r) :
    joinComparisonSlots w ≤ r * r + r * (r * r) := by
  exact Nat.add_le_add_left (Nat.mul_le_mul_left r (length_labelEdges_le w)) _
end Internal.N0339.N0197.Partition

