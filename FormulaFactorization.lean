  capacity : σ.vars q.n = N
  width : σ.vars q.N = N
  row : σ.vars q.u = 0
  divisorIndex : σ.vars q.w = N-1-Q.natDegree
  zero : val F canonical q.WS σ 0 = 0
  first : ∀ i < N, val F canonical q.WS σ (5+N+i) = P.coeff (N-1-i)
  second : ∀ i < N, val F canonical q.WS σ (5+N+N+i) = Q.coeff (N-1-i)
  fit : 5+N+N+N ≤ Sn
  firstCapacity : P = 0 ∨ P.natDegree < N
  secondCapacity : Q.natDegree < N
  divisorNonzero : Q ≠ 0

