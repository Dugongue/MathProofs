theorem builderLoop_run {W n d H : ℕ} (σ : Env) (A : RectData n d) (target : Fin n) (k : ℕ) (mixed : Bool)
    (hn : σ.vars nVar=n) (hc : σ.vars count=n*n) (hl : σ.vars linearVar=0)
    (ht : σ.vars targetVar=target.val) (hk : σ.vars prefixVar=k) (hm : σ.vars mixedVar=if mixed then 1 else 0) (hd : σ.vars dimVar=d)
