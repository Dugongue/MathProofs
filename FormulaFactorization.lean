      tau.inp=sigma.inp ∧ tau.out=sigma.out := by
  let s1:=sigma.setVar cntReg n
  let s2:=s1.setVar sbReg sourceBase
  let s3:=s2.setVar dbReg targetBase
  have r1:Run B (.assign cntReg cntE) sigma s1 (1+cntE.size):=Run.assign hc
  have r2:Run B (.assign sbReg sbE) s1 s2 (1+sbE.size):=Run.assign hs
