      (perturbationSource a A B f)).natDegree ≤ max f.formalDegree (A*B).natDegree := by
  change (N0276.auxiliaryPolynomial (N0041.seriesEnvironment env) (radialSource a f) +
    algebraMap ℚ (Polynomial (PowerSeries R)) (-1) *
      N0276.auxiliaryPolynomial (N0041.seriesEnvironment env) (numericSource (A*B))).natDegree ≤ _
  rw [radialSource_correct, numericSource_correct]
  apply (Polynomial.natDegree_add_le _ _).trans
