/-! Integer-determinant greedy column selection. The data program uses actual
materialized Gram determinants; real vector spaces occur only in correctness.
This is the basis-selection component of a determinant-only integer kernel. -/
namespace Internal.N0339.N0197.N0261
open Matrix
open scoped BigOperators RealInnerProductSpace
set_option maxHeartbeats 2400000
set_option maxRecDepth 4096
set_option backward.isDefEq.respectTransparency false

structure Selection (n : ℕ) where
  count : ℕ
  column : Fin count → Fin n

def empty (n : ℕ) : Selection n := ⟨0,Fin.elim0⟩

def append {n : ℕ} (s : Selection n) (j : Fin n) : Selection n :=
  ⟨s.count+1,Fin.snoc s.column j⟩

def selectedRows {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (s : Selection n) :
    Matrix (Fin s.count) (Fin m) ℤ := fun i r=>M r (s.column i)

def gramDet {k m : ℕ} (B : Matrix (Fin k) (Fin m) ℤ) : ℤ :=
  N0301.matrixDeterminant (N0296.gram B)

noncomputable def realColumns {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) :
    Fin n → EuclideanSpace ℝ (Fin m) := fun j=>WithLp.toLp 2 (fun r=>(M r j:ℝ))

noncomputable def selectedReal {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (s : Selection n) :=
  fun i : Fin s.count=>realColumns M (s.column i)

noncomputable def columnSpan {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (s : Selection n) :=
  Submodule.span ℝ (Set.range (selectedReal M s))

theorem gramDet_cast {k m : ℕ} (B : Matrix (Fin k) (Fin m) ℤ) :
    (gramDet B:ℝ)=(Matrix.gram ℝ (N0297.rows B)).det := by
  rw [gramDet,N0301.matrixDeterminant_correct,Int.cast_det]
  congr 1
  ext i j
  exact N0297.gram_entry_cast B i j

theorem gramDet_nonzero {k m : ℕ} (B : Matrix (Fin k) (Fin m) ℤ) :
    gramDet B ≠ 0 ↔ LinearIndependent ℝ (N0297.rows B) := by
  rw [← Matrix.det_gram_ne_zero_iff_linearIndependent,← gramDet_cast]
  exact Int.cast_ne_zero.symm

theorem selected_rows_real {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (s : Selection n) :
    N0297.rows (selectedRows M s)=selectedReal M s := rfl

theorem appended_real {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (s : Selection n) (j : Fin n) :
    selectedReal M (append s j)=Fin.snoc (selectedReal M s) (realColumns M j) := by
  funext i
  refine Fin.lastCases ?_ (fun i=>?_) i
  · simp [selectedReal,append]
  · simp [selectedReal,append]

theorem span_append {m n : ℕ} (M : Matrix (Fin m) (Fin n) ℤ) (s : Selection n) (j : Fin n) :
    columnSpan M s ≤ columnSpan M (append s j) := by
