        exact Fin.ne_of_gt ((hp.2.1 t ht).trans hir))
      rw [congrFun houter c]
      exact (coordinate_le_norm B r c).trans ((hM r).trans hw)

theorem normalized_norm_le {n d} (B : IntBasis n d) (hB : FullRank B) (Phi M : ℝ)
    (hPhi : (potential B:ℝ)≤Phi) (hMlarge : (n+1:ℝ)*Phi≤M) :
    ∀ r : Fin n, ‖N0297.rows (normalize B) r‖^2≤M := by
  intro r
  exact (normalized_row_norm B hB r).trans
    ((mul_le_mul_of_nonneg_left hPhi (by positivity)).trans hMlarge)

theorem scanSwap_norm_le {n d} (B C : IntBasis n d) (is : List (Fin n)) (M : ℝ)
    (hM : ∀ r : Fin n, ‖N0297.rows B r‖^2≤M)
    (h : scanSwap B is=some C) : ∀ r : Fin n, ‖N0297.rows C r‖^2≤M := by
  induction is with
  | nil => simp [scanSwap] at h
  | cons i is ih =>
    simp only [scanSwap] at h
    split_ifs at h with hi
    · cases ht : fastTrySwap B i ⟨i.val+1,hi⟩ with
      | none => simp only [ht] at h;exact ih h
      | some D =>
        simp only [ht,Option.some.injEq] at h
        subst D
        rw [fastTrySwap_correct] at ht
        let j : Fin n := ⟨i.val+1,hi⟩
        by_cases hs : 4*prefixVolume (permuteRows B (Equiv.swap i j)) j.val<3*prefixVolume B j.val
        · have he : permuteRows B (Equiv.swap i j)=C := by
            simpa only [trySwap,j,if_pos hs,Option.some.injEq] using ht
          subst C
          intro r
          exact hM (Equiv.swap i j r)
        · have he : trySwap B i j=none := by simp only [trySwap,if_neg hs]
          have hh : trySwap B i j=some C := ht
          rw [he] at hh
          contradiction
    · exact ih h

/-  Every actual recursive call, every inner fold prefix, every tested adjacent
permutation, and the actual quotient operand are bounded by fixed input data. -/
def RunWidthBound {n d} : ℕ → IntBasis n d → ℝ → ℝ → Prop
  | 0,B,W,_ => MatrixWidth B W
  | k+1,B,W,Q => MatrixWidth B W ∧
    (∀ (i : Fin n) (left right js : List (Fin n)),
      (List.finRange n = left ++ i :: right) → (js.length ≤ n) →
      (MatrixWidth (fastReduceList (normalizeList B left) i js) W ∧
        (∀ j : Fin n, (j < i) →
          |(computedCoefficient (fastReduceList (normalizeList B left) i js) i j:ℝ)| ≤ Q))) ∧
    (∀ sigma : Equiv.Perm (Fin n), MatrixWidth (permuteRows (normalize B) sigma) W) ∧
    match findSwap (normalize B) with
    | none => MatrixWidth (normalize B) W
    | some C => RunWidthBound k C W Q

theorem runWidths_of_bounds {n d} (B : IntBasis n d) (hB : FullRank B) (k : ℕ) (Phi M : ℝ)
    (hPhi : (potential B:ℝ)≤Phi) (hPhi0 : 1≤Phi) (hM0 : 0≤M)
    (hMlarge : (n+1:ℝ)*Phi≤M)
    (hM : ∀ r : Fin n, ‖N0297.rows B r‖^2≤M) :
    RunWidthBound k B (widthBound n Phi M) (quotientBound n Phi M) := by
  have hw := widthBound_ge_M n Phi M (by linarith) hM0
  induction k generalizing B with
  | zero => intro r c;exact (coordinate_le_norm B r c).trans ((hM r).trans hw)
  | succ k ih =>
    have hn := normalized_norm_le B hB Phi M hPhi hMlarge
    refine ⟨?_,?_,?_,?_⟩
    · intro r c;exact (coordinate_le_norm B r c).trans ((hM r).trans hw)
    · intro i left right js hsplit hlen
      exact ⟨actual_partial_matrix_width B hB i left right js hsplit hlen Phi M hPhi
        (by linarith) hM0 hMlarge hM,
        fun j hji => actual_partial_quotient_width B hB i j hji left right js hsplit hlen Phi M hPhi hM⟩
    · intro sigma r c
      exact (coordinate_le_norm (normalize B) (sigma r) c).trans ((hn (sigma r)).trans hw)
    · cases hs : findSwap (normalize B) with
      | none =>
        simp only [hs]
        intro r c
        exact (coordinate_le_norm (normalize B) r c).trans ((hn r).trans hw)
      | some C =>
        simp only [hs]
        have hfull := normalizeList_fullRank B (List.finRange n) hB
        have hd := scanSwap_success (normalize B) C _ hfull hs
        have hpot : (potential C:ℝ)≤Phi := by
          have ht := hd.2.2
          rw [N0284.normalize,normalizeList_potential] at ht
          have ht' : 4*(potential C:ℝ)<3*(potential B:ℝ) := by exact_mod_cast ht
          have hp : 0≤(potential C:ℝ) := by exact_mod_cast (potential_pos C hd.1).le
          nlinarith
        exact ih C hd.1 hpot (scanSwap_norm_le (normalize B) C _ M hn hs)

noncomputable def sourcePhi {n d} (B : IntBasis n d) : ℝ := (potential B:ℝ)

noncomputable def sourceNorm {n d} (B : IntBasis n d) : ℝ :=
  (∑ r : Fin n, ‖N0297.rows B r‖^2)+(n+1:ℝ)*sourcePhi B+1

noncomputable def sourceWidth {n d} (B : IntBasis n d) : ℝ := widthBound n (sourcePhi B) (sourceNorm B)
noncomputable def sourceQuotient {n d} (B : IntBasis n d) : ℝ := quotientBound n (sourcePhi B) (sourceNorm B)

/-  Universal all-iteration widths of the unchanged actual reducer, derived
entirely from its original matrix. No width invariant is an input. -/
theorem all_iteration_widths {n d} (B : IntBasis n d) (hB : FullRank B) (k : ℕ) :
    RunWidthBound k B (sourceWidth B) (sourceQuotient B) := by
  have hPhi : 1≤ sourcePhi B := by
    have hp := potential_pos B hB
    have hi : (1:ℤ)≤potential B := by omega
    change (1:ℝ)≤(potential B:ℝ)
    exact_mod_cast hi
