    scanCost p N ≤ 100000000000000*(p+1)*(p.size+1)*(N+1)^3 := by
  have hP : 1 ≤ (p.size+1)*(N+1)^3 := by
    have hp : 0<(p.size+1)*(N+1)^3 := by positivity
    omega
  simpa only [scanCost,scanGuard,Cond.size,Expr.size,stepBudget,Nat.mul_assoc] using
