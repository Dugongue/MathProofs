/-! Framed payload sizes derived directly from the specified codec. These are
mathematical wire-length laws, independent of any former list compiler. -/
namespace N0169.Computation.N0582
set_option autoImplicit false

/-  The bits occupied by the framed element stream, excluding its count word. -/
def payloadSize {α : Type} (e : Encoding α) (xs : List α) : ℕ :=
  (Encoding.frames (xs.map e.encode)).length

theorem payloadSize_eq {α : Type} (e : Encoding α) (xs : List α) :
    payloadSize e xs = 2 * (xs.map (fun a => (e.encode a).length)).sum + xs.length := by
  simp only [payloadSize,Encoding.frames_length,List.map_map,List.length_map,Function.comp_def]

theorem payloadSize_append {α : Type} (e : Encoding α) (xs ys : List α) :
    payloadSize e (xs ++ ys) = payloadSize e xs + payloadSize e ys := by
  simp only [payloadSize_eq,List.map_append,List.sum_append,List.length_append]
  omega

theorem payloadSize_cons {α : Type} (e : Encoding α) (a : α) (xs : List α) :
    payloadSize e (a :: xs) = 2*(e.encode a).length + 1 + payloadSize e xs := by
  simp only [payloadSize_eq,List.map_cons,List.sum_cons,List.length_cons]
  omega

theorem payloadSize_le_word {α : Type} (e : Encoding α) (xs : List α) :
    payloadSize e xs ≤ (e.list.encode xs).length := by
  rw [payloadSize_eq,Encoding.list_encoded_length]
  omega

/-  Both the count header and all payload frames are included. -/
theorem word_length_le_payload {α : Type} (e : Encoding α) (xs : List α) :
    (e.list.encode xs).length ≤ 3*payloadSize e xs+1 := by
  have hb : xs.length.bits.length ≤ xs.length := by
    rw [Nat.size_eq_bits_len]
    exact Nat.size_le.mpr xs.length.lt_two_pow_self
  rw [Encoding.list_encoded_length,payloadSize_eq]
  omega

theorem sum_take_le {α : Type} (g : α → ℕ) (xs : List α) (i : ℕ) :
    ((xs.take i).map g).sum ≤ (xs.map g).sum := by
  have hs := congrArg (fun ys : List α => (ys.map g).sum) (List.take_append_drop i xs)
  rw [List.map_append,List.sum_append] at hs
  omega

theorem payloadSize_sublist {α : Type} (e : Encoding α) {xs ys : List α}
    (h : xs.Sublist ys) : payloadSize e xs ≤ payloadSize e ys := by
  induction h with
  | slnil => exact Nat.le_refl _
  | cons a h ih => rw [payloadSize_cons]; omega
  | cons_cons a h ih => rw [payloadSize_cons,payloadSize_cons]; omega

theorem payloadSize_take_le {α : Type} (e : Encoding α) (xs : List α) (i : ℕ) :
    payloadSize e (xs.take i) ≤ payloadSize e xs := by
  have hs := congrArg (payloadSize e) (List.take_append_drop i xs)
  rw [payloadSize_append] at hs
  omega

end N0169.Computation.N0582

