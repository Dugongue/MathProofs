    simpa only [Polynomial.map_prod, Polynomial.map_pow] using hcount
  have hdegree : (∏ i ∈ s, (F i).map φ).natDegree = ∑ i ∈ s, (F i).natDegree := by
    rw [Polynomial.natDegree_prod_of_monic s (fun i => (F i).map φ) hm]
