/-  Physically install the stored result into the standard first buffer and
construct zero cell/second buffer before the existing real degree scan. -/
theorem degreeBuffer_run (p Sn W N os : ℕ) [Fact p.Prime] (G : (ZMod p)[X]) (σ : Env)
    (hs : Slots (presentation p) canonical q.WS Sn W σ)
    (hn : σ.vars q.n=N) (ho : σ.vars resultRegister=os)
    (hfit : 5+4*N   ≤   Sn) (hos : 5+4*N   ≤   os) (hofit : os+N   ≤   Sn)
    (hcap : G=0    ∨    G.natDegree<N)
    (hdata : ∀i<N,val (presentation p) canonical q.WS σ (os+i)=G.coeff (N-1-i)) :
    ∃τ,Run W degreeBufferProgram σ τ (10000*(N+1))    ∧   
      Internal.N0339.N0550.Buffers (presentation p) q Sn W N G 0 τ    ∧   
      (∀s<Sn,5+4*N   ≤   s → val (presentation p) canonical q.WS τ s=val (presentation p) canonical q.WS σ s)    ∧   
      τ.inp=σ.inp    ∧    τ.out=σ.out := by
  have hNW : N<W := by have := hs.slots_word;omega
  have h1W : 1<W := by have := hs.slots_word;omega
  let σ1 := σ.setVar q.N N
  have hs1 : Slots (presentation p) canonical q.WS Sn W σ1 :=
    Slots.setVar (presentation p) canonical hs (by decide) (by decide) _
  have hn1 : σ1.vars q.n=N := by simpa only [σ1,vars_setVar,if_neg (by decide : q.n   ≠   q.N)] using hn
  have ho1 : σ1.vars resultRegister=os := by simpa only [σ1,vars_setVar,if_neg (by decide : resultRegister   ≠   q.N)] using ho
  have rinit : Run W (.assign q.N (.var q.n)) σ σ1 2 :=
    Run.assign ((evalB_var (by rw [hn];exact hNW)).trans (congrArg some hn))
  have en : (Expr.var q.n).evalB W σ1=some N :=
    (evalB_var (by rw [hn1];exact hNW)).trans (congrArg some hn1)
  have ed : firstExpression.evalB W σ1=some (5+N) :=
    evalB_bin (evalB_lit (by have := hs.slots_word;omega)) en (by change 5+N<W;have := hs.slots_word;omega)
  have es : (Expr.var resultRegister).evalB W σ1=some os :=
    (evalB_var (by rw [ho1];have := hs.slots_word;omega)).trans (congrArg some ho1)
  obtain ⟨ξ,hcopy,hξ,hvalues,hcopyframe,hcopyvars,hj,hcopyarrays,hincopy,houtcopy⟩ :=
    copy_run (fieldMacros (presentation p)) q Internal.N0339.N0501.names_valid
      [q.n,resultRegister] (by decide) firstExpression (.var resultRegister)
      (by simp [VarsIn,firstExpression,Internal.N0339.N0501.firstExpr,plus])
      (by simp [VarsIn]) hs1 ed es (by simp [σ1]) (by omega) hofit (Or.inl (by omega))
  have hcopy' : Run W (Internal.N0339.N0502.copy q firstExpression (.var resultRegister)) σ1 ξ
      (copyCost (fieldMacros (presentation p)) firstExpression (.var resultRegister) N) := by
    rw [Internal.N0339.N0502.copy_eq (presentation p)]
    exact hcopy
  obtain ⟨ζ,hzero,hζ,hcell,hzeroframe,hzerovars,hzeroarrays,hinzero,houtzero⟩ :=
    constE_run (F:=presentation p) (r:=canonical) q constantIndex (by decide) (by decide)
      [] (by simp) (.lit 0) trivial hξ (evalB_lit (by omega)) (by omega)
      (.lit 0) [] (by simp) trivial (evalB_lit (by omega)) (Fact.out : p.Prime).pos
  have hnζ : ζ.vars q.n=N := (hzerovars q.n (by decide)).trans ((hcopyvars q.n (by decide) (by decide)).trans hn1)
  have enζ : (Expr.var q.n).evalB W ζ=some N :=
    (evalB_var (by rw [hnζ];exact hNW)).trans (congrArg some hnζ)
  have eaddr : secondExpression.evalB W ζ=some (5+N+N) :=
    evalB_bin (evalB_bin (evalB_lit (by have := hs.slots_word;omega)) enζ
      (by change 5+N<W;have := hs.slots_word;omega)) enζ (by change 5+N+N<W;have := hs.slots_word;omega)
  let η := ζ.setVar scratchAddress (5+N+N)
  have hη : Slots (presentation p) canonical q.WS Sn W η :=
    Slots.setVar (presentation p) canonical hζ (by decide) (by decide) _
  have hnη : η.vars q.n=N := by simpa only [η,vars_setVar,if_neg (by decide : q.n   ≠   scratchAddress)] using hnζ
  have raddr : Run W (.assign scratchAddress secondExpression) ζ η 6 := Run.assign eaddr
  obtain ⟨τ,hfill,hτ,hsecond,hfillframe,hfillvars,hfillarrays,hinfill,houtfill⟩ :=
    fill_run (F:=presentation p) (r:=canonical) (bb:=5+N+N) (Lv:=N) q filler (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      hη (by simp [η,filler]) hnη (by omega)
  have hrun : Run W degreeBufferProgram σ τ (10000*(N+1)) := by
    have hh := rinit.seq (hcopy'.seq (hzero.seq (raddr.seq hfill)))
    apply hh.mono
    simp only [copyCost,copyStep,fieldMacros,presentation,firstExpression,
      Internal.N0339.N0501.firstExpr,plus,constCostE,
      Internal.N0339.N0463.fillCost,Internal.N0339.N0463.fillStep,Expr.size]
    omega
  have hcapτ : τ.vars q.n=N := (hfillvars q.n (by decide) (by decide)).trans hnη
  have hzeroτ : val (presentation p) canonical q.WS τ 0=0 := by
    rw [hfillframe 0 (by omega) (Or.inl (by omega)),val_setVar (presentation p) canonical (by decide : scratchAddress   ≠   q.WS)]
    simpa only [Nat.cast_zero] using hcell
  refine ⟨τ,hrun,⟨hτ,hcapτ,hzeroτ,?_,?_,by omega,hcap,Or.inl rfl⟩,?_,
    hinfill.trans (hinzero.trans hincopy),houtfill.trans (houtzero.trans houtcopy)⟩
  · intro i hi
    rw [hfillframe _ (by omega) (Or.inl (by omega)),val_setVar (presentation p) canonical (by decide : scratchAddress   ≠   q.WS),
      hzeroframe _ (by omega) (by omega),hvalues i hi,val_setVar (presentation p) canonical (by decide : q.N   ≠   q.WS)]
    exact hdata i hi
  · intro i hi
    rw [hsecond i hi]
    rw [Polynomial.coeff_zero]
  · intro t ht htail
    rw [hfillframe t ht (Or.inr (by omega)),val_setVar (presentation p) canonical (by decide : scratchAddress   ≠   q.WS),
      hzeroframe t ht (by omega),hcopyframe t ht (Or.inr (by omega)),val_setVar (presentation p) canonical (by decide : q.N   ≠   q.WS)]

private theorem degree_pay (N : ℕ) : 10000*(N+1)+(10000*(N+1)+2)  ≤  30000*(N+1) := by omega

/-  Actual stored coefficient scan computes the next degree register. -/
theorem degree_run (p Sn W N os : ℕ) [Fact p.Prime] (G : (ZMod p)[X]) (σ : Env)
    (hs : Slots (presentation p) canonical q.WS Sn W σ)
    (hn : σ.vars q.n=N) (ho : σ.vars resultRegister=os)
    (hfit : 5+4*N  ≤  Sn) (hos : 5+4*N  ≤  os) (hofit : os+N  ≤  Sn)
    (hG : G  ≠  0) (hcap : G.natDegree<N)
    (hdata : ∀i<N,val (presentation p) canonical q.WS σ (os+i)=G.coeff (N-1-i)) :
    ∃τ,Run W degreeProgram σ τ (30000*(N+1))   ∧   Slots (presentation p) canonical q.WS Sn W τ   ∧  
      τ.vars degreeRegister=G.natDegree   ∧   τ.vars q.n=N   ∧   τ.vars resultRegister=os   ∧  
      (∀s<Sn,5+4*N  ≤  s → val (presentation p) canonical q.WS τ s=val (presentation p) canonical q.WS σ s)   ∧  
      τ.inp=σ.inp   ∧   τ.out=σ.out := by
  obtain ⟨ξ,hbuffer,hξ,hbufferframe,hinbuffer,houtbuffer⟩ := degreeBuffer_run p Sn W N os G σ hs hn ho
    hfit hos hofit (Or.inr hcap) hdata
  obtain ⟨ζ,hdegree,hζ,hvalue,hdegreeframe,hindegree,houtdegree⟩ :=
    N0188.degree_run p Sn W N G 0 ξ hξ hG
  have hword : G.natDegree<W := by have := hs.slots_word;omega
  have e : (Expr.var N0188.trialDegree).evalB W ζ=some G.natDegree :=
    (evalB_var (by rw [hvalue];exact hword)).trans (congrArg some hvalue)
  let τ := ζ.setVar degreeRegister G.natDegree
  have rset : Run W (.assign degreeRegister (.var N0188.trialDegree)) ζ τ 2 := Run.assign e
  have hτ := Slots.setVar (presentation p) canonical hζ.slots (by decide : degreeRegister∉regNames canonical)
    (by decide : degreeRegister  ≠  q.WS) G.natDegree
  have hrun : Run W degreeProgram σ τ (30000*(N+1)) :=
    (hbuffer.seq (hdegree.seq rset)).mono (degree_pay N)
  refine ⟨τ,hrun,hτ,by simp [τ],?_,?_,?_,hindegree.trans hinbuffer,houtdegree.trans houtbuffer⟩
  · simpa only [τ,vars_setVar,if_neg (by decide : q.n  ≠  degreeRegister)] using hζ.capacity
  · exact ((run_frame hrun).1 resultRegister (by decide)).trans ho
  · intro t ht htail
    rw [val_setVar (presentation p) canonical (by decide : degreeRegister  ≠  q.WS),hdegreeframe t,hbufferframe t ht htail]

/-  Capacity and persistent matrix pointers are recomputed by real scalar
instructions after the genuine stored-factor degree has been read. -/
theorem reset_run (p Sn W n b c : ℕ) [Fact p.Prime] (σ : Env)
    (hs : Slots (presentation p) canonical q.WS Sn W σ)
    (hn : σ.vars degreeRegister=n) (hb : σ.vars numeratorAddress=b) (hc : σ.vars polynomialAddress=c)
    (hMW : p*n+1<W) (hbW : b<W) (hcW : c<W) :
    ∃τ,Run W resetProgram σ τ 10   ∧   Slots (presentation p) canonical q.WS Sn W τ   ∧  
      Parameters n (p*n+1) b c τ   ∧  
      (∀s,val (presentation p) canonical q.WS τ s=val (presentation p) canonical q.WS σ s)   ∧  
      τ.inp=σ.inp   ∧   τ.out=σ.out := by
  have hnle : n  ≤  p*n := Nat.le_mul_of_pos_left _ (Fact.out : p.Prime).pos
  have hpW : p<W := by have hh:=hs.base.arithmetic_word;change (p+1)^2<W at hh;nlinarith
  have en : (Expr.var degreeRegister).evalB W σ=some n :=
    (evalB_var (by rw [hn];omega)).trans (congrArg some hn)
  have ep : (Expr.var canonical.p).evalB W σ=some p :=
    (evalB_var (by rw [hs.base.prime];exact hpW)).trans (congrArg some hs.base.prime)
  have ecap : (Expr.add (.mul (.var canonical.p) (.var degreeRegister)) (.lit 1)).evalB W σ=some (p*n+1) :=
    evalB_bin (evalB_bin ep en (by change p*n<W;omega)) (evalB_lit (by omega)) (by change p*n+1<W;exact hMW)
  let σ1 := σ.setVar q.n (p*n+1)
  let σ2 := σ1.setVar firstRegister b
  let τ := σ2.setVar secondRegister c
  have hs1 := Slots.setVar (presentation p) canonical hs (by decide : q.n∉regNames canonical) (by decide : q.n  ≠  q.WS) (p*n+1)
  have hs2 := Slots.setVar (presentation p) canonical hs1 (by decide : firstRegister∉regNames canonical) (by decide : firstRegister  ≠  q.WS) b
  have hsτ := Slots.setVar (presentation p) canonical hs2 (by decide : secondRegister∉regNames canonical) (by decide : secondRegister  ≠  q.WS) c
  have hb1 : σ1.vars numeratorAddress=b := by simpa only [σ1,vars_setVar,if_neg (by decide : numeratorAddress  ≠  q.n)] using hb
  have hc2 : σ2.vars polynomialAddress=c := by
    simpa only [σ2,σ1,vars_setVar,if_neg (by decide : polynomialAddress  ≠  firstRegister),if_neg (by decide : polynomialAddress  ≠  q.n)] using hc
  have r1 : Run W (.assign q.n (.add (.mul (.var canonical.p) (.var degreeRegister)) (.lit 1))) σ σ1 6 := Run.assign ecap
  have r2 : Run W (.assign firstRegister (.var numeratorAddress)) σ1 σ2 2 :=
    Run.assign ((evalB_var (by rw [hb1];exact hbW)).trans (congrArg some hb1))
  have r3 : Run W (.assign secondRegister (.var polynomialAddress)) σ2 τ 2 :=
    Run.assign ((evalB_var (by rw [hc2];exact hcW)).trans (congrArg some hc2))
  have hrun : Run W resetProgram σ τ 10 := r1.seq (r2.seq r3)
  have hpar : Parameters n (p*n+1) b c τ := by
    refine ⟨?_,?_,?_,by simp [τ]⟩
    · simpa only [τ,σ2,σ1,vars_setVar,if_neg (by decide : degreeRegister  ≠  secondRegister),
        if_neg (by decide : degreeRegister  ≠  firstRegister),if_neg (by decide : degreeRegister  ≠  q.n)] using hn
    · simp [τ,σ2,σ1,vars_setVar,show q.n  ≠  secondRegister by decide,show q.n  ≠  firstRegister by decide]
    · simp [τ,σ2,vars_setVar,show firstRegister  ≠  secondRegister by decide]
  refine ⟨τ,hrun,hsτ,hpar,?_,rfl,rfl⟩
  intro t
  rw [val_setVar (presentation p) canonical (by decide : secondRegister  ≠  q.WS),
    val_setVar (presentation p) canonical (by decide : firstRegister  ≠  q.WS),
    val_setVar (presentation p) canonical (by decide : q.n  ≠  q.WS)]

private theorem update_pay (N : ℕ) : 30000*(N+1)+(10000*(N+1)+10)  ≤  50000*(N+1) := by omega

/-  Complete physical factor-to-next-input update, including degree discovery,
all coefficient copies and the next matrix capacity/address assignments. -/
theorem program_run (p Sn W N r os b c : ℕ) [Fact p.Prime] (G : (ZMod p)[X]) (σ : Env)
    (hs : Slots (presentation p) canonical q.WS Sn W σ)
    (hn : σ.vars q.n=N) (hr : σ.vars rawRegister=r) (ho : σ.vars resultRegister=os)
    (hb : σ.vars numeratorAddress=b) (hc : σ.vars polynomialAddress=c)
    (hfit : 5+4*N  ≤  Sn) (hos : 5+4*N  ≤  os) (hofit : os+N  ≤  Sn) (hrfit : r+N  ≤  os)
    (hG : G  ≠  0) (hcap : G.natDegree<N)
    (hMW : p*G.natDegree+1<W) (hbW : b<W) (hcW : c<W)
    (hdata : ∀i<N,val (presentation p) canonical q.WS σ (os+i)=G.coeff (N-1-i)) :
    ∃τ,Run W program σ τ (50000*(N+1))   ∧   Slots (presentation p) canonical q.WS Sn W τ   ∧  
      Parameters G.natDegree (p*G.natDegree+1) b c τ   ∧  
      τ.vars rawRegister=r   ∧   τ.vars resultRegister=os   ∧  
      (∀i<N,val (presentation p) canonical q.WS τ (r+i)=G.coeff i)   ∧  
      (∀a,a  ≠  canonical.mem → a  ≠  canonical.scratch → τ.arrs a=σ.arrs a)   ∧  
      τ.inp=σ.inp   ∧   τ.out=σ.out := by
  obtain ⟨ξ,hdegree,hξ,hdeg,hN,hoξ,hdegreeframe,hin,hout⟩ := degree_run p Sn W N os G σ hs hn ho hfit hos hofit hG hcap hdata
  have hrξ : ξ.vars rawRegister=r := ((run_frame hdegree).1 _ (by decide)).trans hr
  have hdataξ : ∀i<N,val (presentation p) canonical q.WS ξ (os+i)=G.coeff (N-1-i) := by
    intro i hi
    exact (hdegreeframe _ (by omega) (by omega)).trans (hdata i hi)
  obtain ⟨ζ,hraw,hζ,hvalues,hrawframe,hcapζ,hrζ,hoζ,hinraw,houtraw⟩ :=
    raw_run p Sn W N r os G ξ hξ hN hrξ hoξ (by omega) hofit hrfit hdataξ
  have hdegζ : ζ.vars degreeRegister=G.natDegree := ((run_frame hraw).1 _ (by decide)).trans hdeg
  have hbζ : ζ.vars numeratorAddress=b := ((run_frame (hdegree.seq hraw)).1 _ (by decide)).trans hb
  have hcζ : ζ.vars polynomialAddress=c := ((run_frame (hdegree.seq hraw)).1 _ (by decide)).trans hc
  obtain ⟨τ,hreset,hτ,hparams,hresetvals,hinreset,houtreset⟩ := reset_run p Sn W G.natDegree b c ζ hζ hdegζ hbζ hcζ hMW hbW hcW
  have hrun : Run W program σ τ (50000*(N+1)) := (hdegree.seq (hraw.seq hreset)).mono (update_pay N)
  refine ⟨τ,hrun,hτ,hparams,?_,?_,?_,?_,hinreset.trans (hinraw.trans hin),houtreset.trans (houtraw.trans hout)⟩
  · exact ((run_frame hreset).1 _ (by decide)).trans hrζ
  · exact ((run_frame hreset).1 _ (by decide)).trans hoζ
  · intro i hi
    exact (hresetvals _).trans (hvalues i hi)
  · intro a ha hs
    apply (run_frame hrun).2.1 a
    intro hw
    have hh := program_arrays_syntax hw
    simp only [Finset.mem_insert,Finset.mem_singleton] at hh
    exact hh.elim ha hs

/-  The irreducible branch returns the current padded f through the same raw
ascending interface as the strict-degree update branch. -/
def restoreReverseProgram : Com := by
  run_tac do
    let e ← Lean.Elab.Term.elabTerm
      (← `(rcopyLoop (fieldMacros (presentation 2)) q (.var rawRegister) N0189.firstPointer))
      (some (Lean.mkConst ``Com))
    let e ← Lean.Meta.withTransparency .all (Lean.Meta.reduce e)
    (←Lean.Elab.Tactic.getMainGoal).assign e

theorem restoreReverseProgram_eq (p : ℕ) [Fact p.Prime] :
    restoreReverseProgram=rcopyLoop (fieldMacros (presentation p)) q (.var rawRegister)
      N0189.firstPointer := rfl

def restoreProgram : Com := .seq (.assign q.N (.add (.var degreeRegister) (.lit 1))) restoreReverseProgram

theorem restore_run (p Sn W n M b c r : ℕ) [Fact p.Prime] (F : (ZMod p)[X]) (σ : Env)
    (hs : Slots (presentation p) canonical q.WS Sn W σ) (hparams : Parameters n M b c σ)
    (hr : σ.vars rawRegister=r) (hwide : n+1 ≤ M) (hbefore : c+M ≤ r) (hfit : r+(n+1) ≤ Sn)
    (hdata : ∀i<M,val (presentation p) canonical q.WS σ (c+i)=F.coeff (M-1-i)) :
    ∃τ,Run W restoreProgram σ τ (10000*(n+2))  ∧  Slots (presentation p) canonical q.WS Sn W τ  ∧ 
      Parameters n M b c τ  ∧  (∀i<n+1,val (presentation p) canonical q.WS τ (r+i)=F.coeff i)  ∧ 
      (∀s<Sn,(s< r  ∨  r+(n+1) ≤ s) → val (presentation p) canonical q.WS τ s=val (presentation p) canonical q.WS σ s)  ∧ 
      τ.inp=σ.inp  ∧  τ.out=σ.out := by
  have hMW : M<W := by have := hs.slots_word;omega
  have hnW : n+1<W := by omega
  have eN : (Expr.var q.n).evalB W σ=some M :=
    (evalB_var (by rw [hparams.capacity];exact hMW)).trans (congrArg some hparams.capacity)
  have en : (Expr.var degreeRegister).evalB W σ=some n :=
    (evalB_var (by rw [hparams.degree];omega)).trans (congrArg some hparams.degree)
  have ec : (Expr.var secondRegister).evalB W σ=some c :=
    (evalB_var (by rw [hparams.divisor];have := hs.slots_word;omega)).trans (congrArg some hparams.divisor)
  have enext : (Expr.add (.var degreeRegister) (.lit 1)).evalB W σ=some (n+1) :=
    evalB_bin en (evalB_lit (by omega)) (by change n+1<W;exact hnW)
  have es0 : N0189.firstPointer.evalB W σ=some (c+(M-(n+1))) :=
    evalB_bin ec (evalB_bin eN enext (by change M-(n+1)<W;omega))
      (by change c+(M-(n+1))<W;have := hs.slots_word;omega)
  let ξ := σ.setVar q.N (n+1)
  have hξ : Slots (presentation p) canonical q.WS Sn W ξ :=
    Slots.setVar (presentation p) canonical hs (by decide) (by decide) _
  have rinit : Run W (.assign q.N (.add (.var degreeRegister) (.lit 1))) σ ξ 4 := Run.assign enext
  have hrξ : ξ.vars rawRegister=r := by simpa only [ξ,vars_setVar,if_neg (by decide : rawRegister ≠ q.N)] using hr
  have ed : (Expr.var rawRegister).evalB W ξ=some r :=
    (evalB_var (by rw [hrξ];have := hs.slots_word;omega)).trans (congrArg some hrξ)
  have es : N0189.firstPointer.evalB W ξ=some (c+(M-(n+1))) := by
    rw [evalB_setVar_noVar _ (by simp only [NoVar,N0189.firstPointer];decide) σ]
    exact es0
  obtain ⟨τ,hcopy,hτ,hvalues,hframe,hvars,hj,harrays,hin,hout⟩ :=
    rcopy_run (Nv:=n+1) (fieldMacros (presentation p)) q Internal.N0339.N0501.names_valid
      [rawRegister,secondRegister,q.n,degreeRegister] (by decide) (.var rawRegister)
      N0189.firstPointer (by simp [VarsIn])
      (by simp [VarsIn,N0189.firstPointer]) hξ ed es (by simp [ξ])
      hfit (by omega) (Or.inr (by omega))
  have hcopy' : Run W restoreReverseProgram ξ τ (rcopyCost (fieldMacros (presentation p))
      (.var rawRegister) N0189.firstPointer (n+1)) := by
    rw [restoreReverseProgram_eq p]
    exact hcopy
  have hrun : Run W restoreProgram σ τ (10000*(n+2)) := (rinit.seq hcopy').mono (by
    simp only [rcopyCost,rcopyStep,fieldMacros,presentation,N0189.firstPointer,Expr.size]
    omega)
  have hpar : Parameters n M b c τ := ⟨
    ((run_frame hrun).1 _ (by decide)).trans hparams.degree,
    ((run_frame hrun).1 _ (by decide)).trans hparams.capacity,
    ((run_frame hrun).1 _ (by decide)).trans hparams.numerator,
    ((run_frame hrun).1 _ (by decide)).trans hparams.divisor⟩
  refine ⟨τ,hrun,hτ,hpar,?_,?_,hin,hout⟩
  · intro i hi
    have hv := hvalues i hi
    rw [val_setVar (presentation p) canonical (by decide : q.N ≠ q.WS)] at hv
    have hidx : c+(M-(n+1))+(n+1-1-i)=c+(M-1-i) := by omega
    rw [hidx,hdata _ (by omega),show M-1-(M-1-i)=i by omega] at hv
    exact hv
  · intro t ht houtside
    rw [hframe t ht houtside,val_setVar (presentation p) canonical (by decide : q.N ≠ q.WS)]

