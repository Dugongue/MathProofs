theorem toPolynomial_ofPolynomial [Semiring R] [DecidableEq R] (p : Polynomial R) :
    toPolynomial (ofPolynomial p) = p := by
  ext n
  simp [coeff_toPolynomial, coeff_ofPolynomial]

