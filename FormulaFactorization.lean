        Internal.N0339.N0349.Runs M.machine t (M.initial (N0090.encode f)) final ∧
        Internal.N0339.N0349.Halts M.machine final ∧
        M.HasOutput final [answer] ∧
        (answer = true ↔ polynomial f = 0)

/-  A fixed deterministic polynomial-time machine returning a complete factorization.
The output syntax, multiplicities, irreducibility and separation up to units are all bound
inside this conclusion. No factorization procedure is supplied as a premise. -/
def FormulaFactorizationInP : Prop :=
  ∃ (M : BinaryTransducer) (C k : ℕ), 0 < C ∧
    ∀ f : RationalFormula,
      ∃ (t : ℕ)
        (final : Internal.N0339.N0349.Config (Fin (M.workTapes + 2))
          (Option Bool) M.State) (output : FactorizationOutput),
        t ≤ C * (inputSize f + 1) ^ k ∧
        Internal.N0339.N0349.Runs M.machine t (M.initial (N0090.encode f)) final ∧
