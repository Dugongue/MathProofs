def MatrixWidth {n d} (B : IntBasis n d) (W : ℝ) : Prop :=
  ∀ r : Fin n, ∀ c : Fin d, |(B r c:ℝ)|≤W

theorem widthBound_ge_M (n : ℕ) (Phi M : ℝ) (hPhi : 0 ≤ Phi) (hM : 0 ≤ M) : M≤widthBound n Phi M := by
  have hp : 1≤(2:ℝ)^n := one_le_pow₀ (by norm_num)
  unfold widthBound
  have hh : 0≤((2:ℝ)^n-1)*(Phi*M+3)*(n+1:ℝ)*Phi := by positivity
  linarith

theorem actual_partial_matrix_width {n d} (B : IntBasis n d) (hB : FullRank B) (i : Fin n)
    (left right js : List (Fin n)) (hsplit : List.finRange n=left++i::right) (hlen : js.length≤n)
