    z ∈ (ofDeterministic tm cfg t).visitedByTapeHead i ↔
      ∃ m ≤ t, (tm.runFrom cfg m).workTapePos i = z := by
  simp only [visitedByTapeHead, Finset.mem_image, Finset.mem_univ, true_and]
