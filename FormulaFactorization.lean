  intro k hk
  apply sub_eq_zero.mp
  simpa only [Polynomial.coeff_sub] using homogeneous_ode_coeff_zero (F-G) B N hzero hw k hk

/-  Root indices are distinct; their VALUES may repeat arbitrarily. -/
def linearRoot {R : Type*} [CommRing R] (r : R) : R[X] := 1 + C r * X

def rootProduct {ι R : Type*} [DecidableEq ι] [CommRing R]
    (s : Finset ι) (r : ι → R) : R[X] := ∏ i ∈ s, linearRoot (r i)

