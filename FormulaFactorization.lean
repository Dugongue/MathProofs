/-  Any actual positive-powered product of nonunit monic factors pays both its
number of factors and every stored exponent in its polynomial degree. -/
theorem monic_product_dimension_bounds {R : Type} [CommRing R] [IsDomain R] {r : ℕ}
    (F : Fin r → R[X]) (e : Fin r → ℕ) (G : R[X])
    (hm : ∀ i, (F i).Monic) (hnu : ∀ i, ¬IsUnit (F i)) (he : ∀ i, 0 < e i)
    (hprod : (∏ i, (F i)^e i) = G) :
    r ≤ G.natDegree ∧ ∀ i, e i ≤ G.natDegree := by
  have hdeg (i : Fin r) : 0 < (F i).natDegree := (hm i).natDegree_pos_of_not_isUnit (hnu i)
  have hsum : G.natDegree = ∑ i, e i*(F i).natDegree := by
    rw [← hprod, Polynomial.natDegree_prod_of_monic _ _ (fun i _ => (hm i).pow _)]
    apply Finset.sum_congr rfl
    intro i hi
    exact (hm i).natDegree_pow (e i)
  constructor
  · rw [hsum]
    calc
      r = ∑ _i : Fin r, (1 : ℕ) := by simp
      _ ≤ _ := Finset.sum_le_sum (fun i _ => Nat.mul_pos (he i) (hdeg i))
  · intro i
    rw [hsum]
    calc
      e i = e i*1 := (Nat.mul_one _).symm
      _ ≤ e i*(F i).natDegree := Nat.mul_le_mul_left _ (hdeg i)
      _ ≤ _ := Finset.single_le_sum (fun (j : Fin r) _ => Nat.zero_le (e j*(F j).natDegree)) (Finset.mem_univ i)

