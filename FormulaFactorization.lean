    _ ≤ ((d : ℤ) * shift z i).natAbs + (read z (last q) * read c i).natAbs :=
      Int.natAbs_sub_le _ _
    _ = d * (shift z i).natAbs + (read z (last q)).natAbs * (read c i).natAbs := by
      rw [Int.natAbs_mul, Int.natAbs_mul, Int.natAbs_natCast]
