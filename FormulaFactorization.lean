/-  Total concrete compiler after a fixed rational center, including its full Y-degree budget. -/
def radialClusterFormula {ι : Type} (a : ι → ℚ) (A B : NumericPolynomial) (N : ℕ)
    (f : N0090.Formula (Option ι)) : N0090.Formula (Option ι) :=
  N0041.clusterFormula A B N (max f.formalDegree (A*B).natDegree)
    (perturbationSource a A B f)

/-  The concrete radial source removes the manual perturbation/source-identity premise. -/
theorem radialClusterFormula_correct {ι R : Type} [CommRing R] [IsDomain R] [Algebra ℚ R]
