@[simp, grind =] theorem support_monomial (n : Nat) (c : R) :
    (monomial n c).support = if c = (0 : R) then [] else [n] := by
  by_cases hc : c = (0 : R)
  · simp [hc]
  · have hcz : c ≠ Zero.zero := hc
    simpa [support, size_monomial_of_ne_zero hc, coeff_monomial, hc, hcz]
