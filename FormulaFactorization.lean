  .seq (.store r.mem (address r.outBase r.i)
    (pointExpr op (.get r.mem (address r.aBase r.i))
      (.get r.mem (address r.bBase r.i)) (.var r.p)))
    (.assign r.i (.add (.var r.i) (.lit 1)))

def pointRoutine (r : FieldNames) (op : PointOp) : Com:=
  .seq (.assign r.i (.lit 0)) (.while (.lt (.var r.i) (.var r.e)) (pointBody r op))

def copyRoutine (r : FieldNames) : Com:=pointRoutine r .copy



def negRoutine (r : FieldNames) : Com:=pointRoutine r .neg

def subRoutine (r : FieldNames) : Com:=pointRoutine r .sub

def eqBody (r : FieldNames) : Com:=
  .seq (.ite (.eq (.get r.mem (address r.aBase r.i)) (.get r.mem (address r.bBase r.i)))
    .skip (.assign r.flag (.lit 0))) (.assign r.i (.add (.var r.i) (.lit 1)))

def eqRoutine (r : FieldNames) : Com:=
  .seq (.assign r.flag (.lit 1)) (.seq (.assign r.i (.lit 0))
    (.while (.lt (.var r.i) (.var r.e)) (eqBody r)))

