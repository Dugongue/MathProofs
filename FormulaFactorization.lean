          exact_mod_cast Nat.mul_le_mul_left (2 ^ b) (Nat.pow_le_pow_left hf k)
       _ = (2 : ℤ) ^ (b + k * (1 + n + b)) := by
          simp only [Nat.cast_pow, Nat.cast_ofNat, ← pow_mul, ← pow_add, Nat.mul_comm]

