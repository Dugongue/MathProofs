    Polynomial.degree_add_eq_left_of_degree_lt hdu,Polynomial.degree_add_eq_left_of_degree_lt hdv⟩

/-  Actual repeated p-adic correction, starting from the given mod-p factors. -/
def iterate {p : ℕ} [Fact p.Prime] (P H K : IntPolynomial) : ℕ → IntPolynomial × IntPolynomial
  | 0 => (H,K)
  | t+1 =>
    let z := iterate (p:=p) P H K t
    step (p:=p) (p^(t+1)) P z.1 z.2

/-  Every requested precision is produced by the actual loop. Input data includes
