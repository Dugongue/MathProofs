namespace Internal.N0339.N0197.N0321
open Polynomial
open scoped BigOperators

section Relation
variable {K I J : Type*} [CommRing K]

/-  Two fixed fiber labels share an actual initial line-factor divisor. -/
def EdgeOn (lineTotal : Finset J) (g : I → K[X]) (initial : J → K[X]) (i k : I) : Prop :=
  ∃ j ∈ lineTotal, g i ∣ initial j ∧ g k ∣ initial j

/-  Actual finite line incidence generates the semantic line partition. -/
def partitionOn (lineTotal : Finset J) (g : I → K[X]) (initial : J → K[X]) : Setoid I :=
  Relation.EqvGen.setoid (EdgeOn lineTotal g initial)






theorem edge_to_partition (lineTotal : Finset J) (g : I → K[X]) (initial : J → K[X])
    {i k : I} (h : EdgeOn lineTotal g initial i k) : partitionOn lineTotal g initial i k :=
  Relation.EqvGen.rel _ _ h

theorem same_initial_factor_related_on (lineTotal : Finset J) (g : I → K[X]) (initial : J → K[X])
    {i k : I} (j : J) (hj : j ∈ lineTotal) (hi : g i ∣ initial j) (hk : g k ∣ initial j) :
    partitionOn lineTotal g initial i k := edge_to_partition lineTotal g initial ⟨j,hj,hi,hk⟩

/-  Any equivalence relation containing the concrete edges contains the whole closure. -/
theorem partition_le_of_edges (lineTotal : Finset J) (g : I → K[X]) (initial : J → K[X])
