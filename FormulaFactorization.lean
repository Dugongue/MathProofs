    ∃ τ, Run B (zeroTest M q z k) σ τ (zeroCost M Nv) ∧ Slots F r q.WS Sn B τ ∧
      (∀ s, val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ≠ z → x ≠ k → τ.vars x = σ.vars x) ∧
      (τ.vars z = 1 ↔ ∃ m < Nv, val F r q.WS σ (5 + m) ≠ 0) ∧ τ.vars z ≤ 1 ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hSB := hS.slots_word
  have hNB : Nv < B := by omega
  have hkA : k ≠ r.aBase := fun h => hkS (h ▸ by simp [regNames, scalarNames])
  have hNS : q.N ∉ regNames r := hq.2 _ q.N_mem
  let I : Env → Prop := fun τ =>
    Slots F r q.WS Sn B τ ∧ (∀ s, val F r q.WS τ s = val F r q.WS σ s) ∧
