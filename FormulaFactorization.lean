def commonDenominator {q : ℕ} (v : Vector ℚ (q + 1)) : ℕ :=
  ∏ i : Fin (q + 1), (read v i).den

/-  Actual cleared integer entries, using only rational projections, finite
products and exact natural division. -/
def clearedNumerators {q : ℕ} (v : Vector ℚ (q + 1)) : Vector ℤ (q + 1) :=
  Vector.ofFn (fun i => (read v i).num * (commonDenominator v / (read v i).den : ℕ))

