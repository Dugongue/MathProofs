/-  A single-term Hahn series with coefficient in `line B g` belongs to
`coefficientRing B h0 hB`. -/
lemma single_mem {g : Γ} {r : R} (hr : r ∈ line (K := K) B g) :
    HahnSeries.single g r ∈ coefficientRing B h0 hB := by
  intro a
  by_cases h : g = a
