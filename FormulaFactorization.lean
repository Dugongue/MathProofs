/- Mathematical codec and actual-machine certificate interfaces. These are
independently defined specifications; no PlanarHom implementation is imported. -/
namespace N0169.Computation

structure Encoding (α : Type) where
  encode : α → List Bool
  decode : List Bool → Option α
  decode_encode : ∀ a, decode (encode a) = some a

/-  A real finite-alphabet polynomial-time machine on the complete encoded
input and output words. This is a witness, not a supplied cost oracle. -/
def Realized {α β : Type} (ea : Encoding α) (eb : Encoding β) (f : α → β) : Prop :=
  ∃ M : Turing.TM2ComputableInPolyTime ea.encode eb.encode f,
    ∀ k, Finite (M.tm.Γ k)

