def detAt {n d : ℕ} (A : RectData n d) (q : ℕ) : ℤ :=
  N0268.prefixDet (rectValue A).transpose (min (q+1) n) (Nat.min_le_right _ _)

def Good {n d : ℕ} (A : RectData n d) (q : ℕ) : Prop := detAt A q=0
instance {n d : ℕ} (A : RectData n d) (q : ℕ) : Decidable (Good A q) := inferInstanceAs (Decidable (detAt A q=0))

def Best {n d : ℕ} (A : RectData n d) (c a : ℕ) : Prop :=
  (a=0 ∧ ∀q,q<c → ¬Good A q) ∨
  (0<a ∧ a≤ c ∧ Good A (a-1) ∧ ∀q,q<a-1 → ¬Good A q)

def nextAnswer {n d : ℕ} (A : RectData n d) (c a : ℕ) : ℕ := if a=0 ∧ Good A c then c+1 else a

theorem best_step {n d : ℕ} (A : RectData n d) (c a : ℕ) (h : Best A c a) :
    Best A (c+1) (nextAnswer A c a) := by
  rcases h with ⟨ha,hn⟩ | ⟨ha,hac,hgood,hn⟩
  · by_cases hg : Good A c
    · right
      rw [nextAnswer,if_pos ⟨ha,hg⟩]
      exact ⟨by omega,le_rfl,by simpa only [Nat.add_sub_cancel] using hg,
        by simpa only [Nat.add_sub_cancel] using hn⟩
    · left
      rw [nextAnswer,if_neg (by simp only [hg,and_false,not_false_eq_true])]
      refine ⟨ha,?_⟩
      intro q hq
      by_cases he : q=c
      · simpa only [he] using hg
      · exact hn q (by omega)
  · right
    rw [nextAnswer,if_neg (by omega : ¬(a=0 ∧ Good A c))]
    exact ⟨ha,by omega,hgood,hn⟩

theorem best_answer_le {n d : ℕ} (A : RectData n d) (c a : ℕ) (h : Best A c a) : a≤ c := by
  rcases h with ⟨rfl,_⟩ | ⟨_,ha,_⟩ <;> omega

theorem best_firstSingular {n d : ℕ} (A : RectData n d) (a : ℕ) (h : Best A n a) :
    (N0268.firstSingular (rectValue A).transpose).map (fun j=>j.val+1)=
