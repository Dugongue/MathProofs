/-! ## Registers -/

/-  The loop registers of the bank builder. `nR`, `mR` are inputs. -/
structure UNames where
  nR : String
  mR : String
  NR : String
  LR : String
  tot : String
  s : String
  k : String
  j : String
  i : String
  bb : String
  base : String
  src : String
  ci : String

def UNames.list (w : UNames) : List String :=
  [w.nR, w.mR, w.NR, w.LR, w.tot, w.s, w.k, w.j, w.i, w.bb, w.base, w.src, w.ci]

/-  The registers are distinct, avoid the field-macro registers and the control registers. -/
structure UNames.Valid (r : FieldNames) (q : RNames) (w : UNames) : Prop where
  nodup : w.list.Nodup
  reg : ∀ x ∈ w.list, x ∉ regNames r
  ctl : ∀ x ∈ w.list, x ∉ q.list

theorem UNames.Valid.ne_ctl {r : FieldNames} {q : RNames} {w : UNames} (hw : w.Valid r q)
    {x y : String} (hx : x ∈ w.list) (hy : y ∈ q.list) : x ≠ y := fun h => hw.ctl x hx (h ▸ hy)

theorem UNames.Valid.ctl_ne {r : FieldNames} {q : RNames} {w : UNames} (hw : w.Valid r q)
    {x y : String} (hx : x ∈ q.list) (hy : y ∈ w.list) : x ≠ y := fun h => hw.ctl y hy (h ▸ hx)

/-  Discharges `x ≠ y` for two distinct listed registers. -/
syntax "wdisch " term : tactic
macro_rules
  | `(tactic| wdisch $hw) => `(tactic| first
      | (refine UNames.Valid.ne_ctl $hw ?_ ?_ <;> (simp [UNames.list, RNames.list]; done))
      | (refine UNames.Valid.ctl_ne $hw ?_ ?_ <;> (simp [UNames.list, RNames.list]; done))
      | (intro hh; have hnd := ($hw).nodup; simp [UNames.list, hh] at hnd; done))

theorem vars_setVar_same (σ : Env) (x : String) (v : ℕ) : (σ.setVar x v).vars x = v := by simp

theorem vars_setVar_other {σ : Env} {x y : String} {v : ℕ} (h : y ≠ x) :
    (σ.setVar x v).vars y = σ.vars y := by simp [h]

theorem evalB_var_eq {B : ℕ} {σ : Env} {x : String} {v : ℕ} (h : σ.vars x = v) (hv : v < B) :
    (Expr.var x).evalB B σ = some v := by
  rw [← h]; exact evalB_var (by rw [h]; exact hv)

theorem evalB_bin_eq {B : ℕ} {σ : Env} {op : Bop} {e f : Expr} {a b v : ℕ}
    (he : e.evalB B σ = some a) (hf : f.evalB B σ = some b) (h : op.apply a b = v) (hv : v < B) :
    (Expr.bin op e f).evalB B σ = some v := by
  rw [← h]; exact evalB_bin he hf (by rw [h]; exact hv)

theorem evalB_mul_eq {B : ℕ} {σ : Env} {e f : Expr} {a b v : ℕ}
    (he : e.evalB B σ = some a) (hf : f.evalB B σ = some b) (h : a * b = v) (hv : v < B) :
    (Expr.bin .mul e f).evalB B σ = some v := evalB_bin_eq he hf h hv

theorem evalB_div_eq {B : ℕ} {σ : Env} {e f : Expr} {a b v : ℕ}
    (he : e.evalB B σ = some a) (hf : f.evalB B σ = some b) (h : a / b = v) (hv : v < B) :
    (Expr.bin .div e f).evalB B σ = some v := evalB_bin_eq he hf h hv

theorem evalB_sub_eq {B : ℕ} {σ : Env} {e f : Expr} {a b v : ℕ}
    (he : e.evalB B σ = some a) (hf : f.evalB B σ = some b) (h : a - b = v) (hv : v < B) :
    (Expr.bin .sub e f).evalB B σ = some v := evalB_bin_eq he hf h hv

theorem evalB_plus_eq {B : ℕ} {σ : Env} {e f : Expr} {a b v : ℕ}
    (he : e.evalB B σ = some a) (hf : f.evalB B σ = some b) (h : a + b = v) (hv : v < B) :
    (plus e f).evalB B σ = some v := by
  unfold plus; exact evalB_bin_eq he hf h hv

/-! ## The program -/

def jExpr (w : UNames) : Expr := .bin .div (.var w.k) (.var w.mR)
def iExpr (w : UNames) : Expr := .bin .sub (.var w.k) (.bin .mul (.var w.j) (.var w.mR))
def bbExpr (w : UNames) : Expr := .bin .mul (plus (.var w.j) (.lit 1)) (.var w.LR)
/-  The query slot `bb + 5 + n`. -/
def qExpr (w : UNames) : Expr := plus (plus (.var w.bb) (.lit 5)) (.var w.nR)
/-  The start of row `i` of the bank. -/
def baseExpr (w : UNames) : Expr :=
  plus (plus (plus (.var w.bb) (.lit 5)) (.var w.NR)) (.bin .mul (.var w.i) (.var w.NR))
/-  Coordinate `n + 1 + i` of row `i`. -/
def eExpr (w : UNames) : Expr := plus (plus (plus (.var w.base) (.var w.nR)) (.lit 1)) (.var w.i)
/-  Coordinate `n` of row `i`. -/
def dExpr (w : UNames) : Expr := plus (.var w.base) (.var w.nR)
/-  Column `i` of the matrix. -/
def srcExpr (w : UNames) : Expr := plus (.lit 5) (.bin .mul (.var w.i) (.var w.nR))
def kCond (w : UNames) : Cond := .lt (.var w.k) (.bin .mul (.var w.mR) (.var w.mR))

def usetup (q : RNames) (w : UNames) : Com :=
  .seq (.assign w.NR (plus (plus (.var w.nR) (.lit 1)) (.var w.mR)))
    (.seq (.assign w.LR (plus (plus (.lit 5) (.var w.NR)) (.bin .mul (.var w.mR) (.var w.NR))))
      (.seq (.assign w.tot (.bin .mul (plus (.var w.mR) (.lit 1)) (.var w.LR)))
        (.assign q.N (.var w.nR))))

def zeroBody (r : FieldNames) (q : RNames) (w : UNames) : Com :=
  .seq (constLoad r q w.ci (.var w.s) 0) (.assign w.s (plus (.var w.s) (.lit 1)))

def zeroFill (r : FieldNames) (q : RNames) (w : UNames) : Com :=
  .seq (.assign w.s (.var w.LR)) (.while (.lt (.var w.s) (.var w.tot)) (zeroBody r q w))

section prog
variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}

def ubody (M : FieldMacros F r) (q : RNames) (w : UNames) : Com :=
  .seq (.assign w.j (jExpr w))
  (.seq (.assign w.i (iExpr w))
  (.seq (.assign w.bb (bbExpr w))
  (.seq (constLoad r q w.ci (qExpr w) 1)
  (.seq (.assign w.base (baseExpr w))
  (.seq (constLoad r q w.ci (eExpr w) 1)
  (.seq (.ite (.eq (.var w.i) (.var w.j)) (constLoad r q w.ci (dExpr w) 1) .skip)
  (.seq (.assign w.src (srcExpr w))
  (.seq (copyLoop M q (.var w.base) (.var w.src))
        (.assign w.k (plus (.var w.k) (.lit 1)))))))))))

def ufinish (q : RNames) (w : UNames) : Com :=
  .seq (.assign q.N (.var w.NR))
    (.seq (.assign q.n (plus (.var w.nR) (.lit 1))) (.assign q.c (.var w.mR)))

/-  **The uniform bank builder**: one literal command. -/
def ubankCom (M : FieldMacros F r) (q : RNames) (w : UNames) : Com :=
  .seq (usetup q w) (.seq (zeroFill r q w) (.seq (.assign w.k (.lit 0))
    (.seq (.while (kCond w) (ubody M q w)) (ufinish q w))))

def zeroStep (w : UNames) (e : ℕ) : ℕ := constCost (.var w.s) e + 4

def zeroCost (w : UNames) (e n m : ℕ) : ℕ := 2 + ((4 + zeroStep w e) * (m * bankL n m) + 4)

def bodyCost (M : FieldMacros F r) (w : UNames) (n : ℕ) : ℕ :=
  4 + 6 + 6 + constCost (qExpr w) F.e + 10 + constCost (eExpr w) F.e +
    (4 + constCost (dExpr w) F.e) + 6 + copyCost M (.var w.base) (.var w.src) n + 4

/-  The exact cost bound of `ubankCom`. -/
def ubankCost (M : FieldMacros F r) (w : UNames) (n m : ℕ) : ℕ :=
  22 + zeroCost w F.e n m + 2 + ((6 + bodyCost M w n) * (m * m) + 6) + 8

end prog

/-! ## The values -/

section vals
variable {K : Type} [Field K]

/-  Coordinate `t` of row `i` of bank `j`: `A(·,i) ‖ δ(i,j) ‖ e_i`. -/
def rowVal {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) (j i t : ℕ) : K :=
  if h : t < n ∧ i < m then A ⟨t, h.1⟩ ⟨i, h.2⟩
  else if t = n then (if i = j then 1 else 0) else if t = n + 1 + i then 1 else 0

/-  Offset `s` of bank `j` after `k` steps of the row loop. -/
def slotGoal {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) (k j s : ℕ) : K :=
  if s < 5 then 0
  else if s < 5 + bankN n m then (if s - 5 = n ∧ j * m < k then 1 else 0)
  else if j * m + (s - (5 + bankN n m)) / bankN n m < k then
    rowVal A j ((s - (5 + bankN n m)) / bankN n m) ((s - (5 + bankN n m)) % bankN n m)
  else 0

/-  The whole workspace after `k` steps of the row loop; `h` outside the bank region. -/
def memGoal {n m : ℕ} (h : ℕ → K) (A : Matrix (Fin n) (Fin m) K) (k a : ℕ) : K :=
  if bankL n m ≤ a ∧ a < (m + 1) * bankL n m then
    slotGoal A k (a / bankL n m - 1) (a % bankL n m)
  else h a

/-  The effect of one step `(j, i)` of the row loop on the workspace `g`. -/
def bodyVal (g : ℕ → K) (n m j i a : ℕ) : K :=
  if (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m ≤ a ∧
      a < (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + n then
    g (5 + i * n + (a - ((j + 1) * bankL n m + 5 + bankN n m + i * bankN n m)))
  else if i = j ∧ a = (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + n then 1
  else if a = (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + n + 1 + i then 1
  else if a = (j + 1) * bankL n m + 5 + n then 1
  else g a

theorem bankN_eq (n m : ℕ) : bankN n m = n + 1 + m := rfl
theorem bankL_eq (n m : ℕ) : bankL n m = 5 + bankN n m + m * bankN n m := rfl

theorem rowVal_lt {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) (j : ℕ) {i t : ℕ} (ht : t < n)
    (hi : i < m) : rowVal A j i t = A ⟨t, ht⟩ ⟨i, hi⟩ := by
  unfold rowVal; rw [dif_pos ⟨ht, hi⟩]

theorem rowVal_n {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) (j i : ℕ) :
    rowVal A j i n = if i = j then 1 else 0 := by
  unfold rowVal; rw [dif_neg (by omega), if_pos rfl]

theorem rowVal_e {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) (j i u : ℕ) :
    rowVal A j i (n + 1 + u) = if u = i then 1 else 0 := by
  unfold rowVal
  rw [dif_neg (by omega), if_neg (by omega)]
  by_cases h : u = i
  · rw [if_pos (by omega), if_pos h]
  · rw [if_neg (by omega), if_neg h]

theorem slotGoal_scratch {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) (k j : ℕ) {s : ℕ} (hs : s < 5) :
    slotGoal A k j s = 0 := by
  unfold slotGoal; rw [if_pos hs]

theorem slotGoal_query {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) (k j : ℕ) {t : ℕ}
    (ht : t < bankN n m) : slotGoal A k j (5 + t) = if t = n ∧ j * m < k then 1 else 0 := by
  unfold slotGoal; rw [if_neg (by omega), if_pos (by omega), Nat.add_sub_cancel_left]

theorem slotGoal_row {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) (k j I : ℕ) {t : ℕ}
    (ht : t < bankN n m) :
    slotGoal A k j (5 + bankN n m + I * bankN n m + t) =
      if j * m + I < k then rowVal A j I t else 0 := by
  obtain ⟨hd, hm⟩ := divmod_row (i := I) ht
  have e : 5 + bankN n m + I * bankN n m + t - (5 + bankN n m) = I * bankN n m + t := by omega
  unfold slotGoal; rw [if_neg (by omega), if_neg (by omega), e, hd, hm]

theorem slotGoal_zero {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) (j s : ℕ) :
    slotGoal A 0 j s = 0 := by
  unfold slotGoal
  split_ifs with h1 h2 h3 h4 <;> first | rfl | (exfalso; omega) | simp_all

theorem slot_cases {n m S : ℕ} (hS : S < bankL n m) :
    S < 5 ∨ (∃ t, t < bankN n m ∧ S = 5 + t) ∨
      (∃ I t, I < m ∧ t < bankN n m ∧ S = 5 + bankN n m + I * bankN n m + t) := by
  have hN0 : 0 < bankN n m := by unfold bankN; omega
  have hL := bankL_eq n m
  by_cases h5 : S < 5
  · exact Or.inl h5
  by_cases hq : S < 5 + bankN n m
  · exact Or.inr (Or.inl ⟨S - 5, by omega, by omega⟩)
  refine Or.inr (Or.inr ⟨(S - (5 + bankN n m)) / bankN n m, (S - (5 + bankN n m)) % bankN n m,
    (Nat.div_lt_iff_lt_mul hN0).mpr (by omega), Nat.mod_lt _ hN0, ?_⟩)
  have := Nat.div_add_mod (S - (5 + bankN n m)) (bankN n m)
  rw [Nat.mul_comm] at this
  omega

theorem region_decomp {n m a : ℕ} (h : bankL n m ≤ a ∧ a < (m + 1) * bankL n m) :
    ∃ J S, J < m ∧ S < bankL n m ∧ a = (J + 1) * bankL n m + S := by
  have hL0 : 0 < bankL n m := by unfold bankL; omega
  have h1 : 1 ≤ a / bankL n m := (Nat.le_div_iff_mul_le hL0).mpr (by omega)
  refine ⟨a / bankL n m - 1, a % bankL n m, ?_, Nat.mod_lt _ hL0, ?_⟩
  · have := (Nat.div_lt_iff_lt_mul hL0).mpr h.2; omega
  · have e : a / bankL n m - 1 + 1 = a / bankL n m := by omega
    rw [e, Nat.mul_comm]; exact (Nat.div_add_mod a (bankL n m)).symm

theorem memGoal_at {n m : ℕ} (h : ℕ → K) (A : Matrix (Fin n) (Fin m) K) (k : ℕ) {J S : ℕ}
    (hJ : J < m) (hS : S < bankL n m) :
    memGoal h A k ((J + 1) * bankL n m + S) = slotGoal A k J S := by
  obtain ⟨hd, hm⟩ := divmod_row (i := J + 1) hS
  have h1 : bankL n m ≤ (J + 1) * bankL n m := Nat.le_mul_of_pos_left _ (by omega)
  have h2 : (J + 1) * bankL n m + bankL n m ≤ (m + 1) * bankL n m := by
    have := Nat.mul_le_mul_right (bankL n m) (show J + 1 + 1 ≤ m + 1 by omega)
    have e : (J + 1 + 1) * bankL n m = (J + 1) * bankL n m + bankL n m := by ring
    omega
  unfold memGoal; rw [if_pos ⟨by omega, by omega⟩, hd, hm, Nat.add_sub_cancel]

theorem memGoal_out {n m : ℕ} (h : ℕ → K) (A : Matrix (Fin n) (Fin m) K) (k : ℕ) {a : ℕ}
    (ha : ¬ (bankL n m ≤ a ∧ a < (m + 1) * bankL n m)) : memGoal h A k a = h a := by
  unfold memGoal; rw [if_neg ha]

theorem mul_sep {L J j : ℕ} (hJ : J ≠ j) : J * L + L ≤ j * L ∨ j * L + L ≤ J * L := by
  rcases Nat.lt_or_gt_of_ne hJ with h | h
  · left
    have := Nat.mul_le_mul_right L (show J + 1 ≤ j by omega)
    have e : (J + 1) * L = J * L + L := by ring
    omega
  · right
    have := Nat.mul_le_mul_right L (show j + 1 ≤ J by omega)
    have e : (j + 1) * L = j * L + L := by ring
    omega

theorem idx_eq {m J j x i : ℕ} (hx : x < m) (hi : i < m) (h : J * m + x = j * m + i) : J = j := by
  have h1 := (divmod_row (N := m) (i := J) hx).1
  have h2 := (divmod_row (N := m) (i := j) hi).1
  rw [h] at h1; omega

end vals


section vals2
variable {K : Type} [Field K]

theorem bodyVal_congr {g g' : ℕ → K} {Sn n m j i a : ℕ} (hg : ∀ s < Sn, g s = g' s)
    (ha : a < Sn) (hsrc : 5 + i * n + n ≤ Sn) :
    bodyVal g n m j i a = bodyVal g' n m j i a := by
  unfold bodyVal
  split_ifs with h1
  · exact hg _ (by omega)
  all_goals first | rfl | exact hg a ha

/-  **One step of the row loop** on the abstract workspace. -/
theorem goal_step {n m : ℕ} (h : ℕ → K) (A : Matrix (Fin n) (Fin m) K)
    (hA : ∀ t i (ht : t < n) (hi : i < m), h (5 + i * n + t) = A ⟨t, ht⟩ ⟨i, hi⟩)
    {j i : ℕ} (hj : j < m) (hi : i < m) (a : ℕ) :
    bodyVal (memGoal h A (j * m + i)) n m j i a = memGoal h A (j * m + i + 1) a := by
  have hN := bankN_eq n m
  have hL := bankL_eq n m
  have hRN : i * bankN n m + bankN n m ≤ m * bankN n m := by
    have := Nat.mul_le_mul_right (bankN n m) (show i + 1 ≤ m by omega)
    rw [Nat.add_mul, Nat.one_mul] at this; exact this
  have hin : i * n + n ≤ m * bankN n m := by
    have h1 := Nat.mul_le_mul_right n (show i + 1 ≤ m by omega)
    have h2 := Nat.mul_le_mul_left m (show n ≤ bankN n m by omega)
    rw [Nat.add_mul, Nat.one_mul] at h1; omega
  have hPL : bankL n m ≤ (j + 1) * bankL n m := Nat.le_mul_of_pos_left _ (by omega)
  have hPT : (j + 1) * bankL n m + bankL n m ≤ (m + 1) * bankL n m := by
    have := Nat.mul_le_mul_right (bankL n m) (show j + 1 + 1 ≤ m + 1 by omega)
    have e : (j + 1 + 1) * bankL n m = (j + 1) * bankL n m + bankL n m := by ring
    omega
  by_cases hreg : bankL n m ≤ a ∧ a < (m + 1) * bankL n m
  · obtain ⟨J, S, hJ, hS, rfl⟩ := region_decomp hreg
    rw [memGoal_at h A _ hJ hS]
    by_cases hJj : J = j
    · subst hJj
      rcases slot_cases hS with hs5 | ⟨t, ht, rfl⟩ | ⟨I, t, hI, ht, rfl⟩
      · unfold bodyVal
        rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
          memGoal_at h A _ hJ hS, slotGoal_scratch _ _ _ hs5, slotGoal_scratch _ _ _ hs5]
      · unfold bodyVal
        rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), slotGoal_query _ _ _ ht]
        by_cases htn : t = n
        · rw [if_pos (by omega), if_pos ⟨htn, by omega⟩]
        · rw [if_neg (by omega), memGoal_at h A _ hJ hS, slotGoal_query _ _ _ ht,
            if_neg (fun hh => htn hh.1), if_neg (fun hh => htn hh.1)]
      · rw [slotGoal_row _ _ _ _ ht]
        by_cases hIi : I = i
        · subst hIi
          rw [if_pos (by omega)]
          unfold bodyVal
          by_cases htn : t < n
          · rw [if_pos ⟨by omega, by omega⟩]
            rw [show (J + 1) * bankL n m + (5 + bankN n m + I * bankN n m + t) -
                ((J + 1) * bankL n m + 5 + bankN n m + I * bankN n m) = t by omega]
            have hlow : ¬ (bankL n m ≤ 5 + I * n + t ∧ 5 + I * n + t < (m + 1) * bankL n m) := by
              omega
            rw [memGoal_out h A _ hlow, hA t I htn hI, rowVal_lt A J htn hI]
          · rw [if_neg (by omega)]
            by_cases hte : t = n
            · by_cases hij : I = J
              · rw [if_pos ⟨hij, by omega⟩, hte, rowVal_n, if_pos hij]
              · rw [if_neg (fun hh => hij hh.1), if_neg (by omega), if_neg (by omega),
                  memGoal_at h A _ hJ hS, slotGoal_row _ _ _ _ ht, if_neg (by omega), hte,
                  rowVal_n, if_neg hij]
            · obtain ⟨u, rfl⟩ : ∃ u, t = n + 1 + u := ⟨t - (n + 1), by omega⟩
              rw [if_neg (by omega), rowVal_e]
              by_cases hui : u = I
              · rw [if_pos (by omega), if_pos hui]
              · rw [if_neg (by omega), if_neg (by omega), memGoal_at h A _ hJ hS,
                  slotGoal_row _ _ _ _ ht, if_neg (by omega), if_neg hui]
        · have hsep := mul_sep (L := bankN n m) hIi
          unfold bodyVal
          rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
            memGoal_at h A _ hJ hS, slotGoal_row _ _ _ _ ht]
          by_cases hlt : I < i
          · rw [if_pos (by omega), if_pos (by omega)]
          · rw [if_neg (by omega), if_neg (by omega)]
    · have hsep := mul_sep (L := bankL n m) (show J + 1 ≠ j + 1 by omega)
      unfold bodyVal
      rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
        memGoal_at h A _ hJ hS]
      rcases slot_cases hS with hs5 | ⟨t, ht, rfl⟩ | ⟨I, t, hI, ht, rfl⟩
      · rw [slotGoal_scratch _ _ _ hs5, slotGoal_scratch _ _ _ hs5]
      · have hne : J * m ≠ j * m + i := fun hh => hJj (idx_eq (x := 0) (by omega) hi (by omega))
        rw [slotGoal_query _ _ _ ht, slotGoal_query _ _ _ ht]
        by_cases hc : t = n ∧ J * m < j * m + i
        · rw [if_pos hc, if_pos ⟨hc.1, by omega⟩]
        · rw [if_neg hc, if_neg (by omega)]
      · have hne : J * m + I ≠ j * m + i := fun hh => hJj (idx_eq hI hi hh)
        rw [slotGoal_row _ _ _ _ ht, slotGoal_row _ _ _ _ ht]
        by_cases hlt : J * m + I < j * m + i
        · rw [if_pos hlt, if_pos (by omega)]
        · rw [if_neg hlt, if_neg (by omega)]
  · unfold bodyVal
    rw [if_neg (by omega), if_neg (by omega), if_neg (by omega), if_neg (by omega),
      memGoal_out h A _ hreg, memGoal_out h A _ hreg]

theorem goal_final_scratch {n m : ℕ} (h : ℕ → K) (A : Matrix (Fin n) (Fin m) K) (k : ℕ)
    {j s : ℕ} (hj : j < m) (hs : s < 5) : memGoal h A k ((j + 1) * bankL n m + s) = 0 := by
  rw [memGoal_at h A _ hj (by unfold bankL; omega), slotGoal_scratch _ _ _ hs]

theorem goal_final_query {n m : ℕ} (h : ℕ → K) (A : Matrix (Fin n) (Fin m) K)
    {j t : ℕ} (hj : j < m) (ht : t < bankN n m) :
    memGoal h A (m * m) ((j + 1) * bankL n m + 5 + t) = if t = n then 1 else 0 := by
  have e : (j + 1) * bankL n m + 5 + t = (j + 1) * bankL n m + (5 + t) := by omega
  have hjm : j * m < m * m := by
    have := Nat.mul_le_mul_right m (show j + 1 ≤ m by omega)
    rw [Nat.add_mul, Nat.one_mul] at this; omega
  rw [e, memGoal_at h A _ hj (by unfold bankL; omega), slotGoal_query _ _ _ ht]
  by_cases htn : t = n
  · rw [if_pos ⟨htn, hjm⟩, if_pos htn]
  · rw [if_neg (fun hh => htn hh.1), if_neg htn]

theorem goal_final_row {n m : ℕ} (h : ℕ → K) (A : Matrix (Fin n) (Fin m) K)
    {j i t : ℕ} (hj : j < m) (hi : i < m) (ht : t < bankN n m) :
    memGoal h A (m * m) ((j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + t) =
      rowVal A j i t := by
  have hRN : i * bankN n m + bankN n m ≤ m * bankN n m := by
    have := Nat.mul_le_mul_right (bankN n m) (show i + 1 ≤ m by omega)
    rw [Nat.add_mul, Nat.one_mul] at this; exact this
  have e : (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + t =
      (j + 1) * bankL n m + (5 + bankN n m + i * bankN n m + t) := by omega
  have hjm : j * m + m ≤ m * m := by
    have := Nat.mul_le_mul_right m (show j + 1 ≤ m by omega)
    rw [Nat.add_mul, Nat.one_mul] at this; omega
  rw [e, memGoal_at h A _ hj (by unfold bankL; omega), slotGoal_row _ _ _ _ ht,
    if_pos (by omega)]

end vals2


/-! ## Runs -/

section runs
variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}

theorem usetup_run (q : RNames) (hq : q.Valid r) (w : UNames) (hw : w.Valid r q)
    {Sn B : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ) {n m : ℕ}
    (hn : σ.vars w.nR = n) (hm : σ.vars w.mR = m) (hcap : (m + 1) * bankL n m ≤ Sn) :
    ∃ σ1, Run B (usetup q w) σ σ1 22 ∧ Slots F r q.WS Sn B σ1 ∧
      σ1.vars w.nR = n ∧ σ1.vars w.mR = m ∧ σ1.vars w.NR = bankN n m ∧
      σ1.vars w.LR = bankL n m ∧ σ1.vars w.tot = (m + 1) * bankL n m ∧ σ1.vars q.N = n ∧
      (∀ x, x ≠ w.NR → x ≠ w.LR → x ≠ w.tot → x ≠ q.N → σ1.vars x = σ.vars x) ∧
      (∀ a, val F r q.WS σ1 a = val F r q.WS σ a) ∧ σ1.arrs = σ.arrs ∧ σ1.inp = σ.inp ∧
      σ1.out = σ.out := by
  have hSB := hS.slots_word
  have hLT : bankL n m ≤ (m + 1) * bankL n m := Nat.le_mul_of_pos_left _ (by omega)
  have hL := bankL_eq n m
  have hN := bankN_eq n m
  have hmN : m ≤ bankN n m := by omega
  have hmm : m * bankN n m ≤ bankL n m := by omega
  have hNW : w.NR ≠ q.WS := hw.ne_ctl (by simp [UNames.list]) q.WS_mem
  have hLW : w.LR ≠ q.WS := hw.ne_ctl (by simp [UNames.list]) q.WS_mem
  have hTW : w.tot ≠ q.WS := hw.ne_ctl (by simp [UNames.list]) q.WS_mem
  have hQW : q.N ≠ q.WS := hq.ne_of (by intro h; simp [RNames.list, h])
  have hQS : q.N ∉ regNames r := hq.2 _ q.N_mem
  have e1 : (plus (plus (.var w.nR) (.lit 1)) (.var w.mR)).evalB B σ = some (bankN n m) :=
    evalB_plus_eq (evalB_plus_eq (evalB_var_eq hn (by omega)) (evalB_lit (by omega)) rfl
      (by omega)) (evalB_var_eq hm (by omega)) rfl (by omega)
  set σa := σ.setVar w.NR (bankN n m) with hσa
  have e2 : (plus (plus (.lit 5) (.var w.NR)) (.bin .mul (.var w.mR) (.var w.NR))).evalB B σa =
      some (bankL n m) := by
    have hNa : σa.vars w.NR = bankN n m := by simp [hσa]
    have hma : σa.vars w.mR = m := by
      rw [hσa, vars_setVar_other (by wdisch hw)]; exact hm
    exact evalB_plus_eq (evalB_plus_eq (evalB_lit (by omega)) (evalB_var_eq hNa (by omega)) rfl
      (by omega)) (evalB_mul_eq (evalB_var_eq hma (by omega)) (evalB_var_eq hNa (by omega)) rfl
      (by omega)) rfl (by omega)
  set σb := σa.setVar w.LR (bankL n m) with hσb
  have e3 : (Expr.bin .mul (plus (.var w.mR) (.lit 1)) (.var w.LR)).evalB B σb =
      some ((m + 1) * bankL n m) := by
    have hLb : σb.vars w.LR = bankL n m := by simp [hσb]
    have hmb : σb.vars w.mR = m := by
      rw [hσb, vars_setVar_other (by wdisch hw), hσa, vars_setVar_other (by wdisch hw)]; exact hm
    exact evalB_mul_eq (evalB_plus_eq (evalB_var_eq hmb (by omega)) (evalB_lit (by omega)) rfl
      (by omega)) (evalB_var_eq hLb (by omega)) rfl (by omega)
  set σc := σb.setVar w.tot ((m + 1) * bankL n m) with hσc
  have e4 : (Expr.var w.nR).evalB B σc = some n := by
    have hnc : σc.vars w.nR = n := by
      rw [hσc, vars_setVar_other (by wdisch hw), hσb, vars_setVar_other (by wdisch hw), hσa,
        vars_setVar_other (by wdisch hw)]; exact hn
    exact evalB_var_eq hnc (by omega)
  refine ⟨σc.setVar q.N n, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · refine ((Run.assign e1).seq ((Run.assign e2).seq ((Run.assign e3).seq
      (Run.assign e4)))).mono (le_of_eq ?_)
    simp only [plus, Expr.size]
  · exact Slots.setVar F r (Slots.setVar F r (Slots.setVar F r (Slots.setVar F r hS
      (hw.reg _ (by simp [UNames.list])) hNW _) (hw.reg _ (by simp [UNames.list])) hLW _)
      (hw.reg _ (by simp [UNames.list])) hTW _) hQS hQW _
  · rw [vars_setVar_other (by wdisch hw), hσc, vars_setVar_other (by wdisch hw), hσb,
      vars_setVar_other (by wdisch hw), hσa, vars_setVar_other (by wdisch hw)]; exact hn
  · rw [vars_setVar_other (by wdisch hw), hσc, vars_setVar_other (by wdisch hw), hσb,
      vars_setVar_other (by wdisch hw), hσa, vars_setVar_other (by wdisch hw)]; exact hm
  · rw [vars_setVar_other (by wdisch hw), hσc, vars_setVar_other (by wdisch hw), hσb,
      vars_setVar_other (by wdisch hw), hσa, vars_setVar_same]
  · rw [vars_setVar_other (by wdisch hw), hσc, vars_setVar_other (by wdisch hw), hσb,
      vars_setVar_same]
  · rw [vars_setVar_other (by wdisch hw), hσc, vars_setVar_same]
  · rw [vars_setVar_same]
  · intro x h1 h2 h3 h4
    rw [vars_setVar_other h4, hσc, vars_setVar_other h3, hσb, vars_setVar_other h2, hσa,
      vars_setVar_other h1]
  · intro a
    rw [val_setVar F r hQW, hσc, val_setVar F r hTW, hσb, val_setVar F r hLW, hσa,
      val_setVar F r hNW]
  · rfl
  · rfl
  · rfl

theorem uzero_run (q : RNames) (hq : q.Valid r) (w : UNames) (hw : w.Valid r q)
    {Sn B : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ) {L T : ℕ} (hLv : σ.vars w.LR = L)
    (hTv : σ.vars w.tot = T) (hLT : L ≤ T) (hT : T ≤ Sn) :
    ∃ τ, Run B (zeroFill r q w) σ τ (2 + ((4 + zeroStep w F.e) * (T - L) + 4)) ∧
      Slots F r q.WS Sn B τ ∧
      (∀ a < Sn, val F r q.WS τ a = if L ≤ a ∧ a < T then 0 else val F r q.WS σ a) ∧
      (∀ x, x ≠ w.s → x ≠ w.ci → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hSB := hS.slots_word
  have hsS : w.s ∉ regNames r := hw.reg _ (by simp [UNames.list])
  have hsW : w.s ≠ q.WS := hw.ne_ctl (by simp [UNames.list]) q.WS_mem
  have hciS : w.ci ∉ regNames r := hw.reg _ (by simp [UNames.list])
  have hciW : w.ci ≠ q.WS := hw.ne_ctl (by simp [UNames.list]) q.WS_mem
  have hsci : w.s ≠ w.ci := by wdisch hw
  have hts : w.tot ≠ w.s := by wdisch hw
  have htc : w.tot ≠ w.ci := by wdisch hw
  let I : Env → Prop := fun τ =>
    Slots F r q.WS Sn B τ ∧ L ≤ τ.vars w.s ∧ τ.vars w.s ≤ T ∧
    (∀ x, x ≠ w.s → x ≠ w.ci → τ.vars x = σ.vars x) ∧
    (∀ a < Sn, val F r q.WS τ a = if L ≤ a ∧ a < τ.vars w.s then 0 else val F r q.WS σ a) ∧
    (∀ a, a ≠ r.mem → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out
  have hI0 : I (σ.setVar w.s L) := by
    refine ⟨Slots.setVar F r hS hsS hsW L, by simp, by simp; omega, ?_, ?_, fun _ _ => rfl,
      rfl, rfl⟩
    · intro x h1 _; rw [vars_setVar_other h1]
    · intro a _
      rw [val_setVar F r hsW, vars_setVar_same, if_neg (by omega)]
  have htot : ∀ τ, I τ → τ.vars w.tot = T := fun τ hτ => by rw [hτ.2.2.2.1 _ hts htc, hTv]
  have hdef : ∀ τ, I τ → ∃ v, (Cond.lt (.var w.s) (.var w.tot)).evalB B τ = some v :=
    fun τ hτ => evalB_condLt_vars (by have := hτ.2.2.1; omega) (by rw [htot τ hτ]; omega)
  have hstep : ∀ τ, I τ → (Cond.lt (.var w.s) (.var w.tot)).evalB B τ = some true →
      ∃ τ', Run B (zeroBody r q w) τ τ' (zeroStep w F.e) ∧ I τ' ∧
        T - τ'.vars w.s < T - τ.vars w.s := by
    intro τ hτ hc
    have hT' := htot τ hτ
    obtain ⟨hSτ, hL1, hle, hfix, hval, harr, hinp, hout⟩ := hτ
    have hlt : τ.vars w.s < T := by
      rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hT']; omega))] at hc
      simp only [Option.some.injEq, decide_eq_true_eq] at hc
      rw [hT'] at hc; exact hc
    obtain ⟨τ1, r1, hS1, hv1, hk1, hfix1, harr1, hinp1, hout1⟩ :=
      const_run q w.ci hciS hciW [w.s] (by simp; exact hsci) (.var w.s) (by simp [VarsIn]) hSτ
        (evalB_var (by omega)) (by omega) (v := 0) F.prime.pos
    have hs1 : τ1.vars w.s = τ.vars w.s := hfix1 _ hsci
    have hinc : (plus (.var w.s) (.lit 1)).evalB B τ1 = some (τ.vars w.s + 1) :=
      evalB_plus_eq (evalB_var_eq hs1 (by omega)) (evalB_lit (by omega)) rfl (by omega)
    refine ⟨τ1.setVar w.s (τ.vars w.s + 1), (r1.seq (Run.assign hinc)).mono ?_,
      ⟨Slots.setVar F r hS1 hsS hsW _, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
    · unfold zeroStep; simp only [plus, Expr.size]; omega
    · rw [vars_setVar_same]; omega
    · rw [vars_setVar_same]; omega
    · intro x h1 h2; rw [vars_setVar_other h1, hfix1 x h2, hfix x h1 h2]
    · intro a ha
      rw [val_setVar F r hsW, vars_setVar_same]
      by_cases hae : a = τ.vars w.s
      · rw [if_pos ⟨by omega, by omega⟩, hae, hv1, Nat.cast_zero]
      · rw [hk1 a ha hae, hval a ha]
        by_cases hlo : L ≤ a ∧ a < τ.vars w.s
        · rw [if_pos hlo, if_pos ⟨hlo.1, by omega⟩]
        · rw [if_neg hlo, if_neg (by omega)]
    · intro a ha; simp only [arrs_setVar]; rw [harr1 a ha, harr a ha]
    · simp only [inp_setVar]; rw [hinp1, hinp]
    · simp only [out_setVar]; rw [hout1, hout]
    · rw [vars_setVar_same]; omega
  obtain ⟨τw, hrw, hIw, hcw⟩ := Run.while_count I (fun τ => T - τ.vars w.s) (zeroStep w F.e)
    hdef hstep hI0
  have hT' := htot τw hIw
  obtain ⟨hSw, hL1, hle, hfix, hval, harr, hinp, hout⟩ := hIw
  have hseq : τw.vars w.s = T := by
    rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hT']; omega))] at hcw
    simp only [Option.some.injEq, decide_eq_false_iff_not, not_lt] at hcw
    rw [hT'] at hcw; omega
  refine ⟨τw, ?_, hSw, ?_, fun x h1 h2 => hfix x h1 h2, harr, hinp, hout⟩
  · refine ((Run.assign (x := w.s) (evalB_var_eq hLv (by omega))).seq hrw).mono (le_of_eq ?_)
    simp only [vars_setVar_same, Expr.size, Cond.size]
  · intro a ha; rw [hval a ha, hseq]

end runs


section runs2
variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}

/-  **One step of the row loop.** -/
theorem ubody_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (w : UNames)
    (hw : w.Valid r q) {Sn B : ℕ} {τ : Env} (hS : Slots F r q.WS Sn B τ) {n m k : ℕ}
    (hn : τ.vars w.nR = n) (hm : τ.vars w.mR = m) (hN : τ.vars w.NR = bankN n m)
    (hL : τ.vars w.LR = bankL n m) (hqN : τ.vars q.N = n) (hk : τ.vars w.k = k)
    (hkm : k < m * m) (hcap : (m + 1) * bankL n m ≤ Sn) :
    ∃ τ', Run B (ubody M q w) τ τ' (bodyCost M w n) ∧ Slots F r q.WS Sn B τ' ∧
      τ'.vars w.k = k + 1 ∧
      (∀ x, x ∉ regNames r → x ≠ q.j → x ≠ w.j → x ≠ w.i → x ≠ w.bb → x ≠ w.base →
        x ≠ w.src → x ≠ w.ci → x ≠ w.k → τ'.vars x = τ.vars x) ∧
      (∀ a < Sn, val F r q.WS τ' a = bodyVal (val F r q.WS τ) n m (k / m) (k % m) a) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ'.arrs a = τ.arrs a) ∧ τ'.inp = τ.inp ∧
      τ'.out = τ.out := by
  have hSB := hS.slots_word
  have hm0 : 0 < m := Nat.pos_of_ne_zero (by rintro rfl; simp at hkm)
  have hj : k / m < m := (Nat.div_lt_iff_lt_mul hm0).mpr hkm
  have hi : k % m < m := Nat.mod_lt _ hm0
  have hkji : k / m * m + k % m = k := by rw [Nat.mul_comm]; exact Nat.div_add_mod k m
  have hjB : k / m < B := by
    have : bankL n m ≤ (m + 1) * bankL n m := Nat.le_mul_of_pos_left _ (by omega)
    have := bankL_eq n m; have := bankN_eq n m; omega
  generalize hjd : k / m = j at hj hkji hjB ⊢
  generalize hid : k % m = i at hi hkji ⊢
  have hNe := bankN_eq n m
  have hLe := bankL_eq n m
  have hmN : m * m ≤ m * bankN n m := Nat.mul_le_mul_left _ (by omega)
  have hRN : i * bankN n m + bankN n m ≤ m * bankN n m := by
    have := Nat.mul_le_mul_right (bankN n m) (show i + 1 ≤ m by omega)
    rw [Nat.add_mul, Nat.one_mul] at this; exact this
  have hin : i * n + n ≤ m * bankN n m := by
    have h1 := Nat.mul_le_mul_right n (show i + 1 ≤ m by omega)
    have h2 := Nat.mul_le_mul_left m (show n ≤ bankN n m by omega)
    rw [Nat.add_mul, Nat.one_mul] at h1; omega
  have hPL : bankL n m ≤ (j + 1) * bankL n m := Nat.le_mul_of_pos_left _ (by omega)
  have hPT : (j + 1) * bankL n m + bankL n m ≤ (m + 1) * bankL n m := by
    have := Nat.mul_le_mul_right (bankL n m) (show j + 1 + 1 ≤ m + 1 by omega)
    have e : (j + 1 + 1) * bankL n m = (j + 1) * bankL n m + bankL n m := by ring
    omega
  have hjm : j * m ≤ k := by omega
  have regW : ∀ x ∈ w.list, x ∉ regNames r ∧ x ≠ q.WS :=
    fun x hx => ⟨hw.reg x hx, hw.ne_ctl hx q.WS_mem⟩
  obtain ⟨hjS, hjW⟩ := regW w.j (by simp [UNames.list])
  obtain ⟨hiS, hiW⟩ := regW w.i (by simp [UNames.list])
  obtain ⟨hbbS, hbbW⟩ := regW w.bb (by simp [UNames.list])
  obtain ⟨hbaseS, hbaseW⟩ := regW w.base (by simp [UNames.list])
  obtain ⟨hsrcS, hsrcW⟩ := regW w.src (by simp [UNames.list])
  obtain ⟨hciS, hciW⟩ := regW w.ci (by simp [UNames.list])
  obtain ⟨hkS, hkW⟩ := regW w.k (by simp [UNames.list])
  -- 1. j := k / m
  have e1 : (jExpr w).evalB B τ = some j := by
    rw [← hjd]
    exact evalB_div_eq (evalB_var_eq hk (by omega)) (evalB_var_eq hm (by omega)) rfl (by omega)
  set τ1 := τ.setVar w.j j with hτ1
  have f1 : ∀ x, x ≠ w.j → τ1.vars x = τ.vars x := fun x hx => vars_setVar_other hx
  have o1 : τ1.vars w.j = j := vars_setVar_same _ _ _
  -- 2. i := k - j m
  have k1 : τ1.vars w.k = k := by rw [f1 w.k (by wdisch hw)]; exact hk
  have m1 : τ1.vars w.mR = m := by rw [f1 w.mR (by wdisch hw)]; exact hm
  have e2 : (iExpr w).evalB B τ1 = some i :=
    evalB_sub_eq (evalB_var_eq k1 (by omega))
      (evalB_mul_eq (evalB_var_eq o1 (by omega)) (evalB_var_eq m1 (by omega)) rfl (by omega))
      (by omega) (by omega)
  set τ2 := τ1.setVar w.i i with hτ2
  have f2 : ∀ x, x ≠ w.i → τ2.vars x = τ1.vars x := fun x hx => vars_setVar_other hx
  have o2 : τ2.vars w.i = i := vars_setVar_same _ _ _
  -- 3. bb := (j + 1) L
  have j2 : τ2.vars w.j = j := by rw [f2 w.j (by wdisch hw), o1]
  have L2 : τ2.vars w.LR = bankL n m := by
    rw [f2 w.LR (by wdisch hw), f1 w.LR (by wdisch hw)]; exact hL
  have e3 : (bbExpr w).evalB B τ2 = some ((j + 1) * bankL n m) :=
    evalB_mul_eq (evalB_plus_eq (evalB_var_eq j2 (by omega)) (evalB_lit (by omega)) rfl
      (by omega)) (evalB_var_eq L2 (by omega)) rfl (by omega)
  set τ3 := τ2.setVar w.bb ((j + 1) * bankL n m) with hτ3
  have f3 : ∀ x, x ≠ w.bb → τ3.vars x = τ2.vars x := fun x hx => vars_setVar_other hx
  have o3 : τ3.vars w.bb = (j + 1) * bankL n m := vars_setVar_same _ _ _
  have hS3 : Slots F r q.WS Sn B τ3 :=
    Slots.setVar F r (Slots.setVar F r (Slots.setVar F r hS hjS hjW _) hiS hiW _) hbbS hbbW _
  -- 4. the query one
  have n3 : τ3.vars w.nR = n := by
    rw [f3 w.nR (by wdisch hw), f2 w.nR (by wdisch hw), f1 w.nR (by wdisch hw)]; exact hn
  have e4 : (qExpr w).evalB B τ3 = some ((j + 1) * bankL n m + 5 + n) :=
    evalB_plus_eq (evalB_plus_eq (evalB_var_eq o3 (by omega)) (evalB_lit (by omega)) rfl
      (by omega)) (evalB_var_eq n3 (by omega)) rfl (by omega)
  obtain ⟨τ4, r4, hS4, hv4, hk4, f4, ha4, hi4, ho4⟩ :=
    const_run q w.ci hciS hciW [w.bb, w.nR]
      (by intro x hx; simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
          rcases hx with rfl | rfl <;> wdisch hw)
      (qExpr w) (by simp [qExpr, plus, VarsIn]) hS3 e4 (by omega) (v := 1)
      (by have := F.prime.two_le; omega)
  -- 5. base := bb + 5 + N + i N
  have bb4 : τ4.vars w.bb = (j + 1) * bankL n m := by rw [f4 w.bb (by wdisch hw), o3]
  have N4 : τ4.vars w.NR = bankN n m := by
    rw [f4 w.NR (by wdisch hw), f3 w.NR (by wdisch hw), f2 w.NR (by wdisch hw),
      f1 w.NR (by wdisch hw)]; exact hN
  have i4 : τ4.vars w.i = i := by
    rw [f4 w.i (by wdisch hw), f3 w.i (by wdisch hw), o2]
  have e5 : (baseExpr w).evalB B τ4 =
      some ((j + 1) * bankL n m + 5 + bankN n m + i * bankN n m) :=
    evalB_plus_eq (evalB_plus_eq (evalB_plus_eq (evalB_var_eq bb4 (by omega))
      (evalB_lit (by omega)) rfl (by omega)) (evalB_var_eq N4 (by omega)) rfl (by omega))
      (evalB_mul_eq (evalB_var_eq i4 (by omega)) (evalB_var_eq N4 (by omega)) rfl (by omega))
      rfl (by omega)
  set τ5 := τ4.setVar w.base ((j + 1) * bankL n m + 5 + bankN n m + i * bankN n m) with hτ5
  have f5 : ∀ x, x ≠ w.base → τ5.vars x = τ4.vars x := fun x hx => vars_setVar_other hx
  have o5 : τ5.vars w.base = (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m :=
    vars_setVar_same _ _ _
  have hS5 : Slots F r q.WS Sn B τ5 := Slots.setVar F r hS4 hbaseS hbaseW _
  -- 6. the identity one at coordinate n + 1 + i
  have n5 : τ5.vars w.nR = n := by
    rw [f5 w.nR (by wdisch hw), f4 w.nR (by wdisch hw)]; exact n3
  have i5 : τ5.vars w.i = i := by rw [f5 w.i (by wdisch hw)]; exact i4
  have e6 : (eExpr w).evalB B τ5 =
      some ((j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + n + 1 + i) :=
    evalB_plus_eq (evalB_plus_eq (evalB_plus_eq (evalB_var_eq o5 (by omega))
      (evalB_var_eq n5 (by omega)) rfl (by omega)) (evalB_lit (by omega)) rfl (by omega))
      (evalB_var_eq i5 (by omega)) rfl (by omega)
  obtain ⟨τ6, r6, hS6, hv6, hk6, f6, ha6, hi6, ho6⟩ :=
    const_run q w.ci hciS hciW [w.base, w.nR, w.i]
      (by intro x hx; simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
          rcases hx with rfl | rfl | rfl <;> wdisch hw)
      (eExpr w) (by simp [eExpr, plus, VarsIn]) hS5 e6 (by omega) (v := 1)
      (by have := F.prime.two_le; omega)
  -- 7. the pivot one at coordinate n when i = j
  have i6 : τ6.vars w.i = i := by rw [f6 w.i (by wdisch hw)]; exact i5
  have j6 : τ6.vars w.j = j := by
    rw [f6 w.j (by wdisch hw), f5 w.j (by wdisch hw), f4 w.j (by wdisch hw),
      f3 w.j (by wdisch hw)]; exact j2
  have base6 : τ6.vars w.base = (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m := by
    rw [f6 w.base (by wdisch hw), o5]
  have n6 : τ6.vars w.nR = n := by rw [f6 w.nR (by wdisch hw)]; exact n5
  have hcnd : (Cond.eq (.var w.i) (.var w.j)).evalB B τ6 = some (i == j) :=
    evalB_condEq (evalB_var_eq i6 (by omega)) (evalB_var_eq j6 (by omega))
  obtain ⟨τ7, r7, hS7, hval7, f7, ha7, hi7, ho7⟩ : ∃ τ7,
      Run B (.ite (.eq (.var w.i) (.var w.j)) (constLoad r q w.ci (dExpr w) 1) .skip) τ6 τ7
        (4 + constCost (dExpr w) F.e) ∧ Slots F r q.WS Sn B τ7 ∧
      (∀ s < Sn, val F r q.WS τ7 s =
        if i = j ∧ s = (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + n then 1
        else val F r q.WS τ6 s) ∧
      (∀ x, x ≠ w.ci → τ7.vars x = τ6.vars x) ∧ (∀ a, a ≠ r.mem → τ7.arrs a = τ6.arrs a) ∧
      τ7.inp = τ6.inp ∧ τ7.out = τ6.out := by
    by_cases hij : i = j
    · have ed : (dExpr w).evalB B τ6 =
          some ((j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + n) :=
        evalB_plus_eq (evalB_var_eq base6 (by omega)) (evalB_var_eq n6 (by omega)) rfl (by omega)
      obtain ⟨τ7, r7, hS7, hv7, hk7, hf7, ha7, hi7, ho7⟩ :=
        const_run q w.ci hciS hciW [w.base, w.nR]
          (by intro x hx; simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
              rcases hx with rfl | rfl <;> wdisch hw)
          (dExpr w) (by simp [dExpr, plus, VarsIn]) hS6 ed (by omega) (v := 1)
          (by have := F.prime.two_le; omega)
      refine ⟨τ7, (Run.ite_true (by rw [hcnd]; simp [hij]) r7).mono ?_, hS7, ?_, hf7, ha7, hi7,
        ho7⟩
      · simp only [Cond.size, Expr.size] <;> omega
      · intro s hs
        by_cases hsd : s = (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + n
        · rw [if_pos ⟨hij, hsd⟩, hsd, hv7, Nat.cast_one]
        · rw [if_neg (fun hh => hsd hh.2), hk7 s hs hsd]
    · refine ⟨τ6, (Run.ite_false (by rw [hcnd]; simp [hij]) Run.skip).mono ?_, hS6,
        fun s _ => by rw [if_neg (fun hh => hij hh.1)], fun _ _ => rfl, fun _ _ => rfl, rfl, rfl⟩
      simp only [Cond.size, Expr.size]; unfold constCost; omega
  -- 8. src := 5 + i n
  have i7 : τ7.vars w.i = i := by rw [f7 w.i (by wdisch hw)]; exact i6
  have n7 : τ7.vars w.nR = n := by rw [f7 w.nR (by wdisch hw)]; exact n6
  have e8 : (srcExpr w).evalB B τ7 = some (5 + i * n) :=
    evalB_plus_eq (evalB_lit (by omega))
      (evalB_mul_eq (evalB_var_eq i7 (by omega)) (evalB_var_eq n7 (by omega)) rfl (by omega))
      rfl (by omega)
  set τ8 := τ7.setVar w.src (5 + i * n) with hτ8
  have f8 : ∀ x, x ≠ w.src → τ8.vars x = τ7.vars x := fun x hx => vars_setVar_other hx
  have o8 : τ8.vars w.src = 5 + i * n := vars_setVar_same _ _ _
  have hS8 : Slots F r q.WS Sn B τ8 := Slots.setVar F r hS7 hsrcS hsrcW _
  -- 9. copy column i of the matrix into row i
  have base8 : τ8.vars w.base = (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m := by
    rw [f8 w.base (by wdisch hw), f7 w.base (by wdisch hw)]; exact base6
  have qN8 : τ8.vars q.N = n := by
    rw [f8 q.N (by wdisch hw), f7 q.N (by wdisch hw), f6 q.N (by wdisch hw),
      f5 q.N (by wdisch hw), f4 q.N (by wdisch hw), f3 q.N (by wdisch hw),
      f2 q.N (by wdisch hw), f1 q.N (by wdisch hw)]; exact hqN
  obtain ⟨τ9, r9, hS9, hc9, hf9, f9, hj9, ha9, hi9, ho9⟩ :=
    copy_run M q hq [w.base, w.src]
      (by intro x hx; simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
          rcases hx with rfl | rfl
          · exact ⟨hbaseS, hw.ne_ctl (by simp [UNames.list]) q.j_mem⟩
          · exact ⟨hsrcS, hw.ne_ctl (by simp [UNames.list]) q.j_mem⟩)
      (.var w.base) (.var w.src) (by simp [VarsIn]) (by simp [VarsIn]) hS8
      (evalB_var_eq base8 (by omega)) (evalB_var_eq o8 (by omega)) qN8 (by omega) (by omega)
      (Or.inr (by omega))
  -- 10. k := k + 1
  have k9 : τ9.vars w.k = k := by
    rw [f9 w.k hkS (hw.ne_ctl (by simp [UNames.list]) q.j_mem), f8 w.k (by wdisch hw),
      f7 w.k (by wdisch hw), f6 w.k (by wdisch hw), f5 w.k (by wdisch hw),
      f4 w.k (by wdisch hw), f3 w.k (by wdisch hw), f2 w.k (by wdisch hw)]; exact k1
  have e10 : (plus (.var w.k) (.lit 1)).evalB B τ9 = some (k + 1) :=
    evalB_plus_eq (evalB_var_eq k9 (by omega)) (evalB_lit (by omega)) rfl (by omega)
  refine ⟨τ9.setVar w.k (k + 1), ?_, Slots.setVar F r hS9 hkS hkW _, vars_setVar_same _ _ _,
    ?_, ?_, ?_, ?_, ?_⟩
  · refine ((Run.assign e1).seq ((Run.assign e2).seq ((Run.assign e3).seq (r4.seq
      ((Run.assign e5).seq (r6.seq (r7.seq ((Run.assign e8).seq
      (r9.seq (Run.assign e10)))))))))).mono (le_of_eq ?_)
    unfold bodyCost
    simp only [jExpr, iExpr, bbExpr, baseExpr, srcExpr, plus, Expr.size] <;> omega
  · intro x hR hqj h1 h2 h3 h4 h5 h6 h7
    rw [vars_setVar_other h7, f9 x hR hqj, f8 x h5, f7 x h6, f6 x h6, f5 x h4, f4 x h6, f3 x h3,
      f2 x h2, f1 x h1]
  · intro a ha
    rw [val_setVar F r hkW]
    unfold bodyVal
    by_cases hc : (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m ≤ a ∧
        a < (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + n
    · rw [if_pos hc]
      obtain ⟨t, ht, rfl⟩ : ∃ t, t < n ∧
          a = (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + t :=
        ⟨a - ((j + 1) * bankL n m + 5 + bankN n m + i * bankN n m), by omega, by omega⟩
      rw [hc9 t ht, Nat.add_sub_cancel_left, hτ8, val_setVar F r hsrcW, hval7 _ (by omega),
        if_neg (by omega), hk6 _ (by omega) (by omega), hτ5, val_setVar F r hbaseW,
        hk4 _ (by omega) (by omega), hτ3, val_setVar F r hbbW, hτ2, val_setVar F r hiW, hτ1,
        val_setVar F r hjW]
    · rw [if_neg hc, hf9 a ha (by omega), hτ8, val_setVar F r hsrcW, hval7 a ha]
      by_cases h1 : i = j ∧ a = (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + n
      · rw [if_pos h1, if_pos h1]
      · rw [if_neg h1, if_neg h1]
        by_cases h2 : a = (j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + n + 1 + i
        · rw [if_pos h2, h2, hv6, Nat.cast_one]
        · rw [if_neg h2, hk6 a ha h2, hτ5, val_setVar F r hbaseW]
          by_cases h3 : a = (j + 1) * bankL n m + 5 + n
          · rw [if_pos h3, h3, hv4, Nat.cast_one]
          · rw [if_neg h3, hk4 a ha h3, hτ3, val_setVar F r hbbW, hτ2, val_setVar F r hiW, hτ1,
              val_setVar F r hjW]
  · intro a h1 h2
    change τ9.arrs a = τ.arrs a
    rw [ha9 a h1 h2]
    change τ7.arrs a = τ.arrs a
    rw [ha7 a h1, ha6 a h1]
    change τ4.arrs a = τ.arrs a
    rw [ha4 a h1]; rfl
  · change τ9.inp = τ.inp
    rw [hi9]; change τ7.inp = τ.inp; rw [hi7, hi6]; change τ4.inp = τ.inp; rw [hi4]; rfl
  · change τ9.out = τ.out
    rw [ho9]; change τ7.out = τ.out; rw [ho7, ho6]; change τ4.out = τ.out; rw [ho4]; rfl

/-  **The row loop.** -/
theorem ukloop_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (w : UNames)
    (hw : w.Valid r q) {Sn B : ℕ} {ρ : Env} (hS : Slots F r q.WS Sn B ρ) {n m : ℕ}
    (h : ℕ → K) (A : Matrix (Fin n) (Fin m) K)
    (hA : ∀ t i (ht : t < n) (hi : i < m), h (5 + i * n + t) = A ⟨t, ht⟩ ⟨i, hi⟩)
    (hn : ρ.vars w.nR = n) (hm : ρ.vars w.mR = m) (hN : ρ.vars w.NR = bankN n m)
    (hL : ρ.vars w.LR = bankL n m) (hqN : ρ.vars q.N = n) (hk : ρ.vars w.k = 0)
    (hcap : (m + 1) * bankL n m ≤ Sn) (hmem : ∀ a < Sn, val F r q.WS ρ a = memGoal h A 0 a) :
    ∃ τ, Run B (.while (kCond w) (ubody M q w)) ρ τ ((6 + bodyCost M w n) * (m * m) + 6) ∧
      Slots F r q.WS Sn B τ ∧ (∀ a < Sn, val F r q.WS τ a = memGoal h A (m * m) a) ∧
      (∀ x, x ∉ regNames r → x ≠ q.j → x ≠ w.j → x ≠ w.i → x ≠ w.bb → x ≠ w.base →
        x ≠ w.src → x ≠ w.ci → x ≠ w.k → τ.vars x = ρ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = ρ.arrs a) ∧ τ.inp = ρ.inp ∧
      τ.out = ρ.out := by
  have hSB := hS.slots_word
  have hLe := bankL_eq n m
  have hNm : m ≤ bankN n m := by unfold bankN; omega
  have hmN : m * m ≤ m * bankN n m := Nat.mul_le_mul_left _ hNm
  have hLT : bankL n m ≤ (m + 1) * bankL n m := Nat.le_mul_of_pos_left _ (by omega)
  have hin0 : ∀ i < m, 5 + i * n + n ≤ Sn := by
    intro i hi
    have h1 := Nat.mul_le_mul_right n (show i + 1 ≤ m by omega)
    have h2 := Nat.mul_le_mul_left m (show n ≤ bankN n m by unfold bankN; omega)
    rw [Nat.add_mul, Nat.one_mul] at h1; omega
  let I : Env → Prop := fun τ =>
    Slots F r q.WS Sn B τ ∧ τ.vars w.k ≤ m * m ∧
    (∀ x, x ∉ regNames r → x ≠ q.j → x ≠ w.j → x ≠ w.i → x ≠ w.bb → x ≠ w.base →
        x ≠ w.src → x ≠ w.ci → x ≠ w.k → τ.vars x = ρ.vars x) ∧
    (∀ a < Sn, val F r q.WS τ a = memGoal h A (τ.vars w.k) a) ∧
    (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = ρ.arrs a) ∧ τ.inp = ρ.inp ∧ τ.out = ρ.out
  have keep : ∀ x ∈ w.list, x ≠ w.j → x ≠ w.i → x ≠ w.bb → x ≠ w.base → x ≠ w.src →
      x ≠ w.ci → x ≠ w.k → ∀ τ, I τ → τ.vars x = ρ.vars x :=
    fun x hx a3 a4 a5 a6 a7 a8 a9 τ hτ =>
      hτ.2.2.1 x (hw.reg x hx) (hw.ne_ctl hx q.j_mem) a3 a4 a5 a6 a7 a8 a9
  have kn : ∀ τ, I τ → τ.vars w.nR = n := fun τ hτ => by
    rw [keep w.nR (by simp [UNames.list]) (by wdisch hw) (by wdisch hw) (by wdisch hw)
      (by wdisch hw) (by wdisch hw) (by wdisch hw) (by wdisch hw) τ hτ, hn]
  have km : ∀ τ, I τ → τ.vars w.mR = m := fun τ hτ => by
    rw [keep w.mR (by simp [UNames.list]) (by wdisch hw) (by wdisch hw) (by wdisch hw)
      (by wdisch hw) (by wdisch hw) (by wdisch hw) (by wdisch hw) τ hτ, hm]
  have kN : ∀ τ, I τ → τ.vars w.NR = bankN n m := fun τ hτ => by
    rw [keep w.NR (by simp [UNames.list]) (by wdisch hw) (by wdisch hw) (by wdisch hw)
      (by wdisch hw) (by wdisch hw) (by wdisch hw) (by wdisch hw) τ hτ, hN]
  have kL : ∀ τ, I τ → τ.vars w.LR = bankL n m := fun τ hτ => by
    rw [keep w.LR (by simp [UNames.list]) (by wdisch hw) (by wdisch hw) (by wdisch hw)
      (by wdisch hw) (by wdisch hw) (by wdisch hw) (by wdisch hw) τ hτ, hL]
  have kqN : ∀ τ, I τ → τ.vars q.N = n := fun τ hτ => by
    rw [hτ.2.2.1 q.N (hq.2 _ q.N_mem) (hq.ne_of (by intro h; simp [RNames.list, h]))
      (by wdisch hw) (by wdisch hw) (by wdisch hw) (by wdisch hw) (by wdisch hw)
      (by wdisch hw) (by wdisch hw), hqN]
  have hI0 : I ρ := ⟨hS, by omega, fun _ _ _ _ _ _ _ _ _ _ => rfl,
    fun a ha => by rw [hk]; exact hmem a ha, fun _ _ _ => rfl, rfl, rfl⟩
  have hcond : ∀ τ, I τ → (kCond w).evalB B τ = some (decide (τ.vars w.k < m * m)) :=
    fun τ hτ => by
      unfold kCond
      exact evalB_condLt (evalB_var (by have := hτ.2.1; omega))
        (evalB_mul_eq (evalB_var_eq (km τ hτ) (by omega)) (evalB_var_eq (km τ hτ) (by omega))
          rfl (by omega))
  have hdef : ∀ τ, I τ → ∃ v, (kCond w).evalB B τ = some v := fun τ hτ => ⟨_, hcond τ hτ⟩
  have hstep : ∀ τ, I τ → (kCond w).evalB B τ = some true →
      ∃ τ', Run B (ubody M q w) τ τ' (bodyCost M w n) ∧ I τ' ∧
        m * m - τ'.vars w.k < m * m - τ.vars w.k := by
    intro τ hτ hc
    have hlt : τ.vars w.k < m * m := by
      rw [hcond τ hτ] at hc; simpa using hc
    obtain ⟨τ', r', hS', hk', hfix', hval', harr', hinp', hout'⟩ :=
      ubody_run M q hq w hw hτ.1 (kn τ hτ) (km τ hτ) (kN τ hτ) (kL τ hτ) (kqN τ hτ) rfl hlt hcap
    have hm0 : 0 < m := Nat.pos_of_ne_zero (by rintro rfl; simp at hlt)
    refine ⟨τ', r', ⟨hS', by omega, ?_, ?_, ?_, ?_, ?_⟩, by omega⟩
    · intro x a1 a2 a3 a4 a5 a6 a7 a8 a9
      rw [hfix' x a1 a2 a3 a4 a5 a6 a7 a8 a9]; exact hτ.2.2.1 x a1 a2 a3 a4 a5 a6 a7 a8 a9
    · intro a ha
      rw [hval' a ha, hk', bodyVal_congr hτ.2.2.2.1 ha (hin0 _ (Nat.mod_lt _ hm0))]
      have hkji : τ.vars w.k / m * m + τ.vars w.k % m = τ.vars w.k := by
        rw [Nat.mul_comm]; exact Nat.div_add_mod _ _
      have := goal_step h A hA ((Nat.div_lt_iff_lt_mul hm0).mpr hlt) (Nat.mod_lt (τ.vars w.k) hm0) a
      rw [hkji] at this; exact this
    · intro a h1 h2; rw [harr' a h1 h2]; exact hτ.2.2.2.2.1 a h1 h2
    · rw [hinp']; exact hτ.2.2.2.2.2.1
    · rw [hout']; exact hτ.2.2.2.2.2.2
  obtain ⟨τf, hrf, hIf, hcf⟩ := Run.while_count I (fun τ => m * m - τ.vars w.k)
    (bodyCost M w n) hdef hstep hI0
  have hkf : τf.vars w.k = m * m := by
    have hle := hIf.2.1
    rw [hcond τf hIf] at hcf; simp at hcf; omega
  obtain ⟨hSf, -, hfixf, hvalf, harrf, hinpf, houtf⟩ := hIf
  refine ⟨τf, hrf.mono (le_of_eq ?_), hSf, fun a ha => by rw [hvalf a ha, hkf], hfixf, harrf,
    hinpf, houtf⟩
  simp only [hk, Nat.sub_zero, kCond, Cond.size, Expr.size] <;> ring

end runs2


section main
variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}

/-  **The uniform bank builder.** From the dense matrix `A` (column-major at `5 + i·n + t`) and
the dimension registers, the single command `ubankCom` writes every normalized bank, leaves the
work region `[0, L)` and everything above the banks untouched, and installs `q.N = N`,
`q.n = n + 1`, `q.c = m`. -/
theorem ubank_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (w : UNames)
    (hw : w.Valid r q) {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) {Sn B : ℕ} {σ : Env}
    (hS : Slots F r q.WS Sn B σ) (hn : σ.vars w.nR = n) (hm : σ.vars w.mR = m)
    (hcap : (m + 1) * bankL n m ≤ Sn)
    (hA : ∀ (t : Fin n) (i : Fin m), val F r q.WS σ (5 + i.val * n + t.val) = A t i) :
    ∃ τ, Run B (ubankCom M q w) σ τ (ubankCost M w n m) ∧ Slots F r q.WS Sn B τ ∧
      (∀ j < m, ∀ s < 5, val F r q.WS τ ((j + 1) * bankL n m + s) = 0) ∧
      (∀ j < m, ∀ t < bankN n m,
        val F r q.WS τ ((j + 1) * bankL n m + 5 + t) = if t = n then 1 else 0) ∧
      (∀ j < m, ∀ i < m, ∀ t < bankN n m,
        val F r q.WS τ ((j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + t) =
          rowVal A j i t) ∧
      (∀ s < bankL n m, val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ s < Sn, (m + 1) * bankL n m ≤ s → val F r q.WS τ s = val F r q.WS σ s) ∧
      τ.vars q.N = bankN n m ∧ τ.vars q.n = n + 1 ∧ τ.vars q.c = m ∧
      τ.vars w.nR = n ∧ τ.vars w.mR = m ∧
      (∀ x, x ∉ regNames r → x ∉ w.list → x ≠ q.j → x ≠ q.N → x ≠ q.n → x ≠ q.c →
        τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hSB := hS.slots_word
  have hLT : bankL n m ≤ (m + 1) * bankL n m := Nat.le_mul_of_pos_left _ (by omega)
  have hLe := bankL_eq n m
  have hNe := bankN_eq n m
  have hbk : ∀ j < m, (j + 1) * bankL n m + bankL n m ≤ (m + 1) * bankL n m := by
    intro j hj
    have := Nat.mul_le_mul_right (bankL n m) (show j + 1 + 1 ≤ m + 1 by omega)
    have e : (j + 1 + 1) * bankL n m = (j + 1) * bankL n m + bankL n m := by ring
    omega
  have hrow : ∀ i < m, i * bankN n m + bankN n m ≤ m * bankN n m := by
    intro i hi
    have := Nat.mul_le_mul_right (bankN n m) (show i + 1 ≤ m by omega)
    rw [Nat.add_mul, Nat.one_mul] at this; exact this
  -- setup and zero fill
  obtain ⟨σ1, r1, hS1, h1n, h1m, h1N, h1L, h1T, h1qN, hfr1, hval1, harr1, hinp1, hout1⟩ :=
    usetup_run q hq w hw hS hn hm hcap
  obtain ⟨σ2, r2, hS2, hval2, hfr2, harr2, hinp2, hout2⟩ :=
    uzero_run q hq w hw hS1 h1L h1T hLT hcap
  have eTL : (m + 1) * bankL n m - bankL n m = m * bankL n m := by
    rw [Nat.add_mul, Nat.one_mul, Nat.add_sub_cancel]
  rw [eTL] at r2
  have hkS : w.k ∉ regNames r := hw.reg _ (by simp [UNames.list])
  have hkW : w.k ≠ q.WS := hw.ne_ctl (by simp [UNames.list]) q.WS_mem
  -- k := 0
  have r3 : Run B (.assign w.k (.lit 0)) σ2 (σ2.setVar w.k 0) 2 :=
    Run.assign (evalB_lit (by omega))
  have hS3 := Slots.setVar F r hS2 hkS hkW 0
  have rd3 : ∀ x, x ≠ w.k → x ≠ w.s → x ≠ w.ci → (σ2.setVar w.k 0).vars x = σ1.vars x :=
    fun x h1 h2 h3 => by rw [vars_setVar_other h1, hfr2 x h2 h3]
  have hA' : ∀ t i (ht : t < n) (hi : i < m),
