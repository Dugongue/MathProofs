      split <;> simp_all

/-  A returned index really is a supplied candidate whose specialized formula is nonzero. -/
theorem chooseHead_sound (pit : (n : ℕ) → Formula n → Bool) {n : ℕ}
    (f : Formula (n + 1)) (is : List ℕ) (i : ℕ)
    (h : (chooseHead pit f is).1 = some i) :
    i ∈ is ∧ pit n (headSpecialize i f) = false := by
  induction is with
  | nil => simp [chooseHead] at h
  | cons j js ih =>
      simp only [chooseHead] at h
      split at h
      · exact ⟨List.mem_cons_of_mem _ (ih h).1, (ih h).2⟩
      · simp only [Option.some.injEq] at h
        subst i
        exact ⟨by simp, by simpa using ‹¬ pit n (headSpecialize j f) = true›⟩

/-  The finite sequential search succeeds whenever one supplied candidate is nonzero. -/
theorem chooseHead_complete (pit : (n : ℕ) → Formula n → Bool) {n : ℕ}
    (f : Formula (n + 1)) (is : List ℕ)
    (h : ∃ i ∈ is, pit n (headSpecialize i f) = false) :
    ∃ i, (chooseHead pit f is).1 = some i := by
  induction is with
  | nil => simp at h
  | cons j js ih =>
      simp only [chooseHead]
      split
      · apply ih
        obtain ⟨i, hi, hp⟩ := h
        rcases List.mem_cons.mp hi with rfl | hi
        · simp_all
        · exact ⟨i, hi, hp⟩
      · exact ⟨j, rfl⟩

/-  Recursive deterministic search; the second component counts every PIT call. -/
def findPoint (pit : (n : ℕ) → Formula n → Bool) (D : ℕ) :
    (n : ℕ) → Formula n → Option (Fin n → ℚ) × ℕ
  | 0, _ => (some (fun j => Fin.elim0 j), 0)
  | n + 1, f =>
      let first := chooseHead pit f (List.range (D + 1))
      match first.1 with
      | none => (none, first.2)
      | some i =>
          let next := findPoint pit D n (headSpecialize i f)
          (next.1.map (Fin.cons (i : ℚ)), first.2 + next.2)

/-  The exact execution counter is bounded by n(D+1), for all inputs and all PIT answers. -/
theorem findPoint_queries_le (pit : (n : ℕ) → Formula n → Bool) (D n : ℕ)
    (f : Formula n) : (findPoint pit D n f).2 ≤ n * (D + 1) := by
  induction n with
  | zero => simp [findPoint]
  | succ n ih =>
      have hfirst := chooseHead_queries_le pit f (List.range (D + 1))
      simp only [List.length_range] at hfirst
      cases h : (chooseHead pit f (List.range (D + 1))).1 with
      | none =>
          simp only [findPoint, h]
          rw [Nat.succ_mul]
          omega
      | some i =>
          have hnext := ih (headSpecialize i f)
          simp only [findPoint, h]
          rw [Nat.succ_mul]
          omega

/-  A nonzero input yields a valid grid witness, with no classical choice in the search program. -/
theorem findPoint_correct (pit : (n : ℕ) → Formula n → Bool) (hpit : CorrectPIT pit)
    (D n : ℕ) (f : Formula n) (hd : f.formalDegree ≤ D) (hf : ¬ IsZero f) :
    ∃ p : Fin n → ℚ,
      (findPoint pit D n f).1 = some p ∧
      N0090.eval₂ (RingHom.id ℚ) p f ≠ 0 ∧
      (∀ j, ∃ i ≤ D, p j = (i : ℚ)) := by
  classical
  induction n with
  | zero =>
      refine ⟨(fun j => Fin.elim0 j), rfl, ?_, ?_⟩
      · intro hz
        apply hf
        intro env
        have he : env = (fun j => Fin.elim0 j) := by
          funext j
          exact Fin.elim0 j
        simpa [he] using hz
      · intro j
        exact Fin.elim0 j
  | succ n ih =>
      have hex : ∃ i ∈ List.range (D + 1), pit n (headSpecialize i f) = false := by
        obtain ⟨i, hi, hnz⟩ := exists_nonzero_headSpecialize D f hd hf
        refine ⟨i, by simpa [List.mem_range] using hi, ?_⟩
        cases hp : pit n (headSpecialize i f) with
        | false => rfl
        | true => exact False.elim (hnz ((hpit n _).mp hp))
      obtain ⟨i, hchoose⟩ := chooseHead_complete pit f (List.range (D + 1)) hex
      have hs := chooseHead_sound pit f (List.range (D + 1)) i hchoose
      have hni : ¬ IsZero (headSpecialize i f) := by
        intro hz
        have ht := (hpit n _).mpr hz
        rw [hs.2] at ht
        cases ht
      obtain ⟨p, hp, hpnz, hpgrid⟩ :=
        ih (headSpecialize i f) ((headSpecialize_degree i f).trans hd) hni
      refine ⟨Fin.cons (i : ℚ) p, ?_, ?_, ?_⟩
      · simp [findPoint, hchoose, hp]
      · simpa only [eval_headSpecialize] using hpnz
      · intro j
        refine Fin.cases ?_ (fun k => ?_) j
        · refine ⟨i, ?_, rfl⟩
          exact Nat.le_of_lt_succ (List.mem_range.mp hs.1)
        · simpa using hpgrid k


