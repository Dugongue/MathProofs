  have en : (Expr.var q.n).evalB B σ = some N := by
    simpa only [hN] using (evalB_var (B:=B) (σ:=σ) (x:=q.n) (by rw [hN];omega))
  have ep : (Expr.var q.pv).evalB B σ = some ip := by
    simpa only [hip] using (evalB_var (B:=B) (σ:=σ) (x:=q.pv) (by rw [hip];omega))
  have eq : (Expr.var q.w).evalB B σ = some iq := by
    simpa only [hiq] using (evalB_var (B:=B) (σ:=σ) (x:=q.w) (by rw [hiq];omega))
  have e5 : (Expr.lit 5).evalB B σ = some 5 := evalB_lit (by omega)
  have e1 := evalB_bin (op:=Bop.add) e5 en (by change 5+N < B;omega)
  have e2 := evalB_bin (op:=Bop.add) e1 en (by change 5+N+N < B;omega)
