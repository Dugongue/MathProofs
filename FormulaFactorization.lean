theorem swapBody_run {W n d : ℕ} (σ : Env) (A : RectData n d) (i j : Fin n) (c : Fin d)
    (hd : σ.vars dimVar=d) (hi : σ.vars swapI=i.val) (hj : σ.vars swapJ=j.val) (hc : σ.vars swapCol=c.val)
