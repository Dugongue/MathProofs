      rw [CPolynomial.coeff_toPoly]
      exact Polynomial.coeff_eq_zero_of_natDegree_lt
        (by rw [← CPolynomial.natDegree_toPoly]; exact hP.1.trans_lt (Nat.lt_of_not_ge ht))
    rw [hz,CPolynomial.coeff_zero]
    unfold arrayBill
    norm_num only [N0090.ratWeight_eq, Rat.num_zero, Rat.den_zero, Int.natAbs_zero,
