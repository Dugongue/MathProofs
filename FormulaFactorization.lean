structure LiftSpec (env : Fin n → R) (a : Fin n → ℚ) (A B : NumericPolynomial)
    (f : N0090.Formula (Option (Fin n))) (p : PowerSeries R[X] × PowerSeries R[X]) : Prop where
  initialLeft : PowerSeries.coeff 0 p.1 = N0041.initial A
  initialRight : PowerSeries.coeff 0 p.2 = N0041.initial B
