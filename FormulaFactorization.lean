  refine ⟨Q.eval t, ?_⟩
  have he := congrArg (fun P : S[X] => P.eval t) hQ
  simp [W, U, V, N0335.productPerturbation, N0334.eval_finiteLog] at he
  simpa only [N0335.productPerturbation, mul_comm a t, mul_comm b t] using he

/-  Finite logarithms preserve every explicit principal-ideal congruence. -/
theorem finiteLog_congr (N : ℕ) (u v m : S) (h : m ∣ u-v) :
    m ∣ N0194.finiteLog N u - N0194.finiteLog N v := by
  unfold N0194.finiteLog
  rw [← sum_sub_distrib]
  apply dvd_sum
  intro l hl
  have hp := h.trans (sub_dvd_pow_sub_pow u v (l+1))
  convert hp.mul_left (algebraMap ℚ S (N0194.logCoefficient l)) using 1
  simp only [Algebra.smul_def]
  ring

/-  Raising a finite-log cutoff discards only explicitly high-order parameter terms. -/
theorem finiteLog_cutoff (D M : ℕ) (hDM : D ≤ M) (u t : S) (ht : t ∣ u) :
    t^(D+1) ∣ N0194.finiteLog M u - N0194.finiteLog D u := by
  induction M, hDM using Nat.le_induction with
  | base => simp
  | @succ M hDM ih =>
      have hp : t^(D+1) ∣ u^(M+1) :=
        (pow_dvd_pow_of_dvd ht (D+1)).trans (pow_dvd_pow u (Nat.succ_le_succ hDM))
      have hterm := hp.mul_left (algebraMap ℚ S (N0194.logCoefficient M))
      have hlog : N0194.finiteLog (M+1) u =
          N0194.finiteLog M u + N0194.logCoefficient M • u^(M+1) := by
        exact sum_range_succ _ _
      convert dvd_add ih hterm using 1
      rw [hlog]
      simp only [Algebra.smul_def]
      ring

/-  Finite log numerator after multiplication by a fixed denominator power. -/
def clearedLog (N : ℕ) (a x : S) : S :=
  ∑ l ∈ range N, N0194.logCoefficient l • (a^(N-(l+1))*x^(l+1))

/-  Only a supplied genuine multiplicative inverse is used in the proof representation. -/
theorem unit_power_cancel (a ai : S) (N m : ℕ) (hm : m ≤ N) (hai : a*ai = 1) :
    a^N * ai^m = a^(N-m) := by
  calc
    a^N*ai^m = (a^(N-m)*a^m)*ai^m := by rw [← pow_add, Nat.sub_add_cancel hm]
    _ = a^(N-m)*(a*ai)^m := by rw [mul_pow]; ring
    _ = a^(N-m) := by rw [hai, one_pow, mul_one]

/-  Clearing a unit denominator is an exact finite polynomial identity. -/
theorem clearedLog_eq_unit (N : ℕ) (a ai x : S) (hai : a*ai = 1) :
    clearedLog N a x = a^N * N0194.finiteLog N (x*ai) := by
  unfold clearedLog N0194.finiteLog
  rw [mul_sum]
  apply sum_congr rfl
  intro l hl
  have hm : l+1 ≤ N := Nat.succ_le_of_lt (mem_range.mp hl)
  have hp := unit_power_cancel a ai N (l+1) hm hai
  simp only [Algebra.smul_def, mul_pow]
  rw [← hp]
  ring

/-  Fully denominator-cleared finite log product congruence with actual inverse equations. -/
theorem clearedLog_product_jet (N : ℕ) (a b ai bi x y t : S)
    (hai : a*ai = 1) (hbi : b*bi = 1) (hx : t ∣ x) (hy : t ∣ y) :
    t^(N+1) ∣ clearedLog N (a*b) (a*y+b*x+x*y) -
      b^N*clearedLog N a x - a^N*clearedLog N b y := by
  have hab : (a*b)*(ai*bi) = 1 := by
    calc
      _ = (a*ai)*(b*bi) := by ring
      _ = 1 := by rw [hai, hbi, one_mul]
  have hpert : (a*y+b*x+x*y)*(ai*bi) =
      N0335.productPerturbation (x*ai) (y*bi) := by
    unfold N0335.productPerturbation
    linear_combination (y*bi)*hai + (x*ai)*hbi
  have h := finiteLog_product_jet N (x*ai) (y*bi) t (hx.mul_right ai) (hy.mul_right bi)
  have hw := h.mul_left ((a*b)^N)
  convert hw using 1
  rw [clearedLog_eq_unit N (a*b) (ai*bi) (a*y+b*x+x*y) hab,
    clearedLog_eq_unit N a ai x hai, clearedLog_eq_unit N b bi y hbi, hpert]
  simp only [mul_pow]
  ring
/-  Every ring homomorphism between Q-algebras transports the finite cleared numerator. -/
@[simp] theorem map_clearedLog {T : Type*} [CommRing T] [Algebra ℚ T]
    (f : S →+* T) (N : ℕ) (a x : S) :
    f (clearedLog N a x) = clearedLog N (f a) (f x) := by
  simp only [clearedLog, map_sum, Algebra.smul_def, map_mul, map_pow,
    RingHom.map_rat_algebraMap]

end FullLog

/-  Low series coefficients descend through any actual injective coefficient map. -/
theorem coefficients_equal_of_map_jet {R T : Type*} [CommRing R] [CommRing T]
    (f : R →+* T) (hf : Function.Injective f) (N : ℕ) (F G : PowerSeries R)
    (h : (PowerSeries.X : PowerSeries T)^(N+1) ∣ PowerSeries.map f F - PowerSeries.map f G) :
    ∀ n ≤ N, PowerSeries.coeff n F = PowerSeries.coeff n G := by
  intro n hn
  have hz := (PowerSeries.X_pow_dvd_iff.mp h) n (by omega)
  simp only [map_sub, PowerSeries.coeff_map] at hz
  apply hf
  exact sub_eq_zero.mp hz

/-  A real field embedding clears all fixed numeric denominators, and injectivity descends the coefficients. -/
theorem clearedLog_series_product_coeff_via_embedding
    {R T : Type*} [CommRing R] [Algebra ℚ R] [Field T] [Algebra ℚ T]
    (f : R[X] →+* T) (hf : Function.Injective f) (A B : R[X])
    (hA : A ≠ 0) (hB : B ≠ 0) (H K : PowerSeries R[X])
    (hH0 : PowerSeries.coeff 0 H = A) (hK0 : PowerSeries.coeff 0 K = B)
    (N n : ℕ) (hn : n ≤ N) :
    PowerSeries.coeff n (clearedLog N (PowerSeries.C (A*B)) (H*K-PowerSeries.C (A*B))) =
      PowerSeries.coeff n (PowerSeries.C (B^N)*clearedLog N (PowerSeries.C A) (H-PowerSeries.C A) +
        PowerSeries.C (A^N)*clearedLog N (PowerSeries.C B) (K-PowerSeries.C B)) := by
  let μ := PowerSeries.map f
  let a : PowerSeries T := PowerSeries.C (f A)
  let b : PowerSeries T := PowerSeries.C (f B)
  let ai : PowerSeries T := PowerSeries.C ((f A)⁻¹)
  let bi : PowerSeries T := PowerSeries.C ((f B)⁻¹)
  let x : PowerSeries T := μ H-a
  let y : PowerSeries T := μ K-b
  have ha : f A ≠ 0 := by
    intro h
    apply hA
    apply hf
    simpa only [map_zero] using h
  have hb : f B ≠ 0 := by
    intro h
    apply hB
    apply hf
    simpa only [map_zero] using h
  have hai : a*ai = 1 := by
    dsimp [a, ai]
    rw [← map_mul, mul_inv_cancel₀ ha, map_one]
  have hbi : b*bi = 1 := by
    dsimp [b, bi]
    rw [← map_mul, mul_inv_cancel₀ hb, map_one]
  have hx : (PowerSeries.X : PowerSeries T) ∣ x := by
    apply PowerSeries.X_dvd_iff.mpr
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply]
    change PowerSeries.coeff 0 (PowerSeries.map f H - PowerSeries.C (f A)) = 0
    rw [map_sub, PowerSeries.coeff_map, hH0]
    simp only [PowerSeries.coeff_C, ite_true, sub_self]
  have hy : (PowerSeries.X : PowerSeries T) ∣ y := by
    apply PowerSeries.X_dvd_iff.mpr
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply]
    change PowerSeries.coeff 0 (PowerSeries.map f K - PowerSeries.C (f B)) = 0
    rw [map_sub, PowerSeries.coeff_map, hK0]
    simp only [PowerSeries.coeff_C, ite_true, sub_self]
  have hprod := clearedLog_product_jet N a b ai bi x y PowerSeries.X hai hbi hx hy
  have hcA : μ (PowerSeries.C A) = a := by simp [μ, a]
  have hcB : μ (PowerSeries.C B) = b := by simp [μ, b]
  have hcAB : μ (PowerSeries.C (A*B)) = a*b := by
    simp only [μ, PowerSeries.map_C, map_mul, a, b]
  have he : μ (H*K-PowerSeries.C (A*B)) = a*y+b*x+x*y := by
    rw [map_sub, map_mul, hcAB]
    dsimp [x, y]
    ring
  have hmap : (PowerSeries.X : PowerSeries T)^(N+1) ∣
      μ (clearedLog N (PowerSeries.C (A*B)) (H*K-PowerSeries.C (A*B))) -
      μ (PowerSeries.C (B^N)*clearedLog N (PowerSeries.C A) (H-PowerSeries.C A) +
        PowerSeries.C (A^N)*clearedLog N (PowerSeries.C B) (K-PowerSeries.C B)) := by
    have hleft : μ (clearedLog N (PowerSeries.C (A*B)) (H*K-PowerSeries.C (A*B))) =
        clearedLog N (a*b) (a*y+b*x+x*y) := by
      rw [map_clearedLog, hcAB, he]
    have hcApow : μ (PowerSeries.C (A^N)) = a^N := by simp only [map_pow, hcA]
    have hcBpow : μ (PowerSeries.C (B^N)) = b^N := by simp only [map_pow, hcB]
    have hright : μ (PowerSeries.C (B^N)*clearedLog N (PowerSeries.C A) (H-PowerSeries.C A) +
        PowerSeries.C (A^N)*clearedLog N (PowerSeries.C B) (K-PowerSeries.C B)) =
        b^N*clearedLog N a x + a^N*clearedLog N b y := by
      simp only [map_add, map_mul, map_clearedLog, hcBpow, hcApow, map_sub, hcA, hcB, x, y]
    rw [hleft, hright]
    simpa only [sub_sub] using hprod
  exact coefficients_equal_of_map_jet f hf N _ _ hmap n hn


/-  The canonical fraction field supplies the embedding; no embedding or inverse oracle is assumed. -/
theorem clearedLog_series_product_coeff
    {R : Type*} [CommRing R] [IsDomain R] [Algebra ℚ R]
    (A B : R[X]) (hA : A ≠ 0) (hB : B ≠ 0) (H K : PowerSeries R[X])
    (hH0 : PowerSeries.coeff 0 H = A) (hK0 : PowerSeries.coeff 0 K = B)
    (N n : ℕ) (hn : n ≤ N) :
    PowerSeries.coeff n (clearedLog N (PowerSeries.C (A*B)) (H*K-PowerSeries.C (A*B))) =
      PowerSeries.coeff n (PowerSeries.C (B^N)*clearedLog N (PowerSeries.C A) (H-PowerSeries.C A) +
        PowerSeries.C (A^N)*clearedLog N (PowerSeries.C B) (K-PowerSeries.C B)) := by
  exact clearedLog_series_product_coeff_via_embedding
    (algebraMap R[X] (FractionRing R[X])) (IsFractionRing.injective R[X] (FractionRing R[X]))
    A B hA hB H K hH0 hK0 N n hn
/-  Actual coefficientwise extension of a fixed polynomial linear functional. -/
def applyCoefficientwise {R : Type*} [CommRing R]
    (L : R[X] →ₗ[R] R) (E : PowerSeries R[X]) : PowerSeries R :=
  PowerSeries.mk fun n => L (PowerSeries.coeff n E)

@[simp] theorem coeff_applyCoefficientwise {R : Type*} [CommRing R]
    (L : R[X] →ₗ[R] R) (E : PowerSeries R[X]) (n : ℕ) :
    PowerSeries.coeff n (applyCoefficientwise L E) = L (PowerSeries.coeff n E) := by
  simp [applyCoefficientwise]

/-  The finite numeric-residue log correction that the source compiler must compute. -/
def residueLog {R : Type*} [CommRing R] [Algebra ℚ R]
    (D : ℕ) (A B : R[X]) (J : ℕ → R[X]) (F : PowerSeries R[X]) (k : ℕ) : PowerSeries R :=
  ∑ l ∈ range D, N0194.logCoefficient l •
    applyCoefficientwise (clusterFunctional (A^(l+1)) (J (l+1)) (A.natDegree*(l+1)-1))
      (PowerSeries.C (X^(k-1)) * (F-PowerSeries.C (A*B))^(l+1))

/-  A fixed numerator shift is still an actual polynomial linear functional. -/
def shiftedFunctional {R : Type*} [CommRing R] (L : R[X] →ₗ[R] R) (Q : R[X]) : R[X] →ₗ[R] R where
  toFun P := L (Q*P)
  map_add' P T := by rw [mul_add, map_add]
  map_smul' c P := by simp only [mul_smul_comm, map_smul, RingHom.id_apply]

/-  Clearing all denominators to level N leaves the actual residue log unchanged. -/
theorem residueLog_cleared_coeff {R : Type*} [CommRing R] [Algebra ℚ R]
    (N : ℕ) (A B : R[X]) (hA : A.Monic) (J K : ℕ → R[X])
    (hJK : ∀ l, J l * B^l + K l * A^l = 1)
    (F : PowerSeries R[X]) (k n : ℕ) :
    PowerSeries.coeff n (residueLog N A B J F k) =
      clusterFunctional (A^N) (J N) (A.natDegree*N-1)
        (X^(k-1) * PowerSeries.coeff n
          (clearedLog N (PowerSeries.C (A*B)) (F-PowerSeries.C (A*B)))) := by
  let E := F-PowerSeries.C (A*B)
  let L := shiftedFunctional (clusterFunctional (A^N) (J N) (A.natDegree*N-1)) (X^(k-1))
  have hscalar (c : ℚ) (P : R[X]) : L (c • P) = c • L P :=
    (L.restrictScalars ℚ).map_smul c P
  have hclear : PowerSeries.coeff n (clearedLog N (PowerSeries.C (A*B)) E) =
      ∑ l ∈ range N, N0194.logCoefficient l • ((A*B)^(N-(l+1))*PowerSeries.coeff n (E^(l+1))) := by
    simp only [clearedLog, map_sum, PowerSeries.coeff_smul, ← map_pow,
      PowerSeries.coeff_C_mul]
  change _ = L (PowerSeries.coeff n (clearedLog N (PowerSeries.C (A*B)) E))
  rw [hclear, map_sum]
  simp only [residueLog, map_sum, PowerSeries.coeff_smul, coeff_applyCoefficientwise,
    PowerSeries.coeff_C_mul, hscalar]
  apply sum_congr rfl
  intro l hl
  congr 1
  have hm : l+1 ≤ N := Nat.succ_le_of_lt (mem_range.mp hl)
  have hc := N0624.clusterFunctional_raise_denominator_by hA
    (X^(k-1)*PowerSeries.coeff n (E^(l+1))) (l+1) (N-(l+1))
    (J (l+1)) (K (l+1)) (J N) (K N) (hJK (l+1)) (by
      simpa only [Nat.add_sub_of_le hm] using hJK N)
  rw [Nat.add_sub_of_le hm] at hc
  rw [hc]
  change clusterFunctional (A^N) (J N) (A.natDegree*N-1)
      ((A*B)^(N-(l+1))*(X^(k-1)*PowerSeries.coeff n (E^(l+1)))) =
    clusterFunctional (A^N) (J N) (A.natDegree*N-1)
      (X^(k-1)*((A*B)^(N-(l+1))*PowerSeries.coeff n (E^(l+1))))
  apply congrArg (clusterFunctional (A^N) (J N) (A.natDegree*N-1))
  ring

/-  At the common denominator level the complementary cluster is killed exactly. -/
theorem clusterFunctional_pure_cluster {R : Type*} [CommRing R]
    (A B : R[X]) (hA : A.Monic) (P J K : R[X]) (l k : ℕ)
    (hJK : J*B^l + K*A^l = 1) :
    clusterFunctional (A^l) J k (P*B^l) = clusterFunctional (A^l) 1 k P := by
  have hd : A^l ∣ P*B^l*J-P := by
    refine ⟨-P*K, ?_⟩
    linear_combination P*hJK
  rw [clusterFunctional_apply, clusterFunctional_apply, mul_one,
    Polynomial.modByMonic_eq_of_dvd_sub (hA.pow l) hd]
/-  The actual finite numeric residue formula selects the Hensel H cluster and kills K's log. -/
theorem residueLog_pure_coeff {R : Type*} [CommRing R] [IsDomain R] [Algebra ℚ R]
    (N : ℕ) (A B : R[X]) (hA : A.Monic) (hB : B ≠ 0)
    (J Kinv : ℕ → R[X]) (hJK : ∀ l, J l * B^l + Kinv l * A^l = 1)
    (H K : PowerSeries R[X]) (hH0 : PowerSeries.coeff 0 H = A) (hK0 : PowerSeries.coeff 0 K = B)
    (k n : ℕ) (hn : n ≤ N) :
    PowerSeries.coeff n (residueLog N A B J (H*K) k) =
      clusterFunctional (A^N) 1 (A.natDegree*N-1)
        (X^(k-1)*PowerSeries.coeff n (clearedLog N (PowerSeries.C A) (H-PowerSeries.C A))) := by
  rw [residueLog_cleared_coeff N A B hA J Kinv hJK]
  have hclear := clearedLog_series_product_coeff A B hA.ne_zero hB H K hH0 hK0 N n hn
  rw [hclear]
  simp only [map_add, PowerSeries.coeff_C_mul]
  let P := PowerSeries.coeff n (clearedLog N (PowerSeries.C A) (H-PowerSeries.C A))
  let Q := PowerSeries.coeff n (clearedLog N (PowerSeries.C B) (K-PowerSeries.C B))
  have hpa : X^(k-1)*(B^N*P) = (X^(k-1)*P)*B^N := by ring
  have hpb : X^(k-1)*(A^N*Q) = (X^(k-1)*Q)*A^N := by ring
  change clusterFunctional (A^N) (J N) (A.natDegree*N-1)
      (X^(k-1)*(B^N*P+A^N*Q)) =
    clusterFunctional (A^N) 1 (A.natDegree*N-1) (X^(k-1)*P)
  rw [mul_add, map_add, hpa, hpb,
    clusterFunctional_pure_cluster A B hA (X^(k-1)*P) (J N) (Kinv N) N (A.natDegree*N-1) (hJK N),
    N0626.clusterFunctional_complement_zero A (X^(k-1)*Q) (J N) N (A.natDegree*N-1) hA,
    add_zero]
/-  Constant coefficient polynomials are preserved by the actual variable interchange. -/
@[simp] theorem toSeries_constantPolynomial {R : Type*} [CommRing R] (A : R[X]) :
    N0035.toSeries (A.map (PowerSeries.C : R →+* PowerSeries R)) =
      PowerSeries.C A := by
  apply PowerSeries.ext
  intro n
  apply Polynomial.ext
  intro j
  rw [N0035.bicomponent, Polynomial.coeff_map]
  by_cases hn : n = 0
  · subst n
    simp only [PowerSeries.coeff_C, ite_true]
  · simp only [PowerSeries.coeff_C, hn, ite_false, Polynomial.coeff_zero]

/-  A strict Y-degree bound survives extraction of any t coefficient. -/
theorem coefficient_degree_lt {R : Type*} [CommRing R]
    (P : Polynomial (PowerSeries R)) (q n : ℕ) (hP : P.degree < q) :
    (PowerSeries.coeff n (N0035.toSeries P)).degree < q := by
  rw [Polynomial.degree_lt_iff_coeff_zero] at hP ⊢
  intro j hj
  rw [N0035.bicomponent, hP j hj, map_zero]

/-  Monic remainder commutes with coefficient extraction; extraction is not assumed multiplicative. -/
theorem coefficient_modByMonic {R : Type*} [CommRing R] [Nontrivial R]
    (P : Polynomial (PowerSeries R)) (A : R[X]) (hA : A.Monic) (n : ℕ) :
    PowerSeries.coeff n (N0035.toSeries
      (P %ₘ (A.map (PowerSeries.C : R →+* PowerSeries R)))) =
      PowerSeries.coeff n (N0035.toSeries P) %ₘ A := by
  let A' := A.map (PowerSeries.C : R →+* PowerSeries R)
  have hA' : A'.Monic := hA.map _
  have hdeg : A'.natDegree = A.natDegree := by
    exact Polynomial.natDegree_map_eq_of_injective
      (fun x y h => by simpa only [PowerSeries.constantCoeff_C] using congrArg PowerSeries.constantCoeff h) A
  have hr : (P %ₘ A').degree < A.natDegree := by
    rw [← hdeg, ← Polynomial.degree_eq_natDegree hA'.ne_zero]
    exact Polynomial.degree_modByMonic_lt P hA'
  have h := congrArg (fun Q : Polynomial (PowerSeries R) =>
      PowerSeries.coeff n (N0035.toSeries Q))
    (Polynomial.modByMonic_add_div P A')
  have heq : PowerSeries.coeff n (N0035.toSeries (P %ₘ A')) +
      A * PowerSeries.coeff n (N0035.toSeries (P /ₘ A')) =
      PowerSeries.coeff n (N0035.toSeries P) := by
    simpa only [map_add, map_mul, A', toSeries_constantPolynomial,
      PowerSeries.coeff_C_mul] using h
  exact (Polynomial.div_modByMonic_unique
    (PowerSeries.coeff n (N0035.toSeries (P /ₘ A')))
    (PowerSeries.coeff n (N0035.toSeries (P %ₘ A'))) hA
    ⟨heq, by
      rw [Polynomial.degree_eq_natDegree hA.ne_zero]
      exact coefficient_degree_lt (P %ₘ A') A.natDegree n hr⟩).2.symm

/-  The exact numeric remainder functional is the coefficient series of the generic one. -/
theorem coefficient_totalFunctional {R : Type*} [CommRing R] [Nontrivial R]
    (P : Polynomial (PowerSeries R)) (A : R[X]) (hA : A.Monic) (n j : ℕ) :
    PowerSeries.coeff n
      (clusterFunctional (A.map (PowerSeries.C : R →+* PowerSeries R)) 1 j P) =
    clusterFunctional A 1 j (PowerSeries.coeff n (N0035.toSeries P)) := by
  simp only [clusterFunctional_apply, mul_one]
  rw [← N0035.bicomponent, coefficient_modByMonic P A hA n]

/-  A positive-log numerator is proper at the common monic denominator degree. -/
theorem clearedLog_degree_lt {R : Type*} [CommRing R] [Nontrivial R] [Algebra ℚ R]
    (N p : ℕ) (hN : 0 < N) (hp : 0 < p) (a x : R[X])
    (ha : a.natDegree ≤ p) (hx : x.degree < p) :
    (clearedLog N a x).degree < p*N := by
  have hxnat : x.natDegree ≤ p-1 := by
    by_cases hz : x = 0
    · simp [hz]
    · have : x.natDegree < p := by
        simpa only [Polynomial.degree_eq_natDegree hz, Nat.cast_lt] using hx
      omega
  have hb : (clearedLog N a x).natDegree ≤ p*N-1 := by
    unfold clearedLog
    apply Polynomial.natDegree_sum_le_of_forall_le
    intro l hl
    apply (Polynomial.natDegree_smul_le _ _).trans
    apply Polynomial.natDegree_mul_le.trans
    apply (Nat.add_le_add (Polynomial.natDegree_pow_le_of_le (N-(l+1)) ha)
      (Polynomial.natDegree_pow_le_of_le (l+1) hxnat)).trans
    have hm : l+1 ≤ N := Nat.succ_le_of_lt (mem_range.mp hl)
    have he := Nat.sub_add_cancel hm
    have hp' := Nat.sub_add_cancel hp
    have hpos : 0 < p*N := Nat.mul_pos hp hN
    have he' := congrArg (fun q : ℕ => q*p) he
    have hp'' := congrArg (fun q : ℕ => (l+1)*q) hp'
    have ht := Nat.sub_add_cancel hpos
    nlinarith
  exact Polynomial.degree_le_natDegree.trans_lt (by
    exact_mod_cast (lt_of_le_of_lt hb (Nat.sub_lt (Nat.mul_pos hp hN) (by omega))))

@[simp] theorem reflect_smul {R : Type*} [CommRing R] [Algebra ℚ R]
    (p : ℕ) (q : ℚ) (P : R[X]) :
    Polynomial.reflect p (q • P) = q • Polynomial.reflect p P := by
  ext j
  simp only [Polynomial.coeff_reflect, Polynomial.coeff_smul]

theorem reflect_sum {R : Type*} [CommRing R] {ι : Type*}
    (p : ℕ) (s : Finset ι) (f : ι → R[X]) :
    Polynomial.reflect p (∑ i ∈ s, f i) = ∑ i ∈ s, Polynomial.reflect p (f i) := by
  classical
