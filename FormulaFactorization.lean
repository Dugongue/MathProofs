  | i :: rest => match inspect v i with
    | some w => (some (Partition.joinLabels v w), 1)
    | none => let z := scan inspect v rest; (z.1, z.2 + 1)

/-  The local backend property consumed by the finite controller. -/
def Progress {r : ℕ} (inspect : Inspector r) (Safe : Labels r → Prop) : Prop :=
  ∀ v, Safe v → ∀ i w, inspect v i = some w →
    Safe (Partition.joinLabels v w) ∧
      Partition.blockCount (Partition.labelSetoid (Partition.joinLabels v w)) <
        Partition.blockCount (Partition.labelSetoid v)

