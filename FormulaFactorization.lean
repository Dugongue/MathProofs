        simpa using Nat.le_of_not_lt hi
      rw [Array.getD_eq_getD_getElem?, Array.getElem?_eq_none hbound, Option.getD_none]
      have ha : a.coeff i = 0 :=
        coeff_eq_zero_of_size_le a (by omega)
      have hb : b.coeff (i - d) = 0 :=
        coeff_eq_zero_of_size_le b (by omega)
      rw [ha, hb]
      simp

