theorem closed_fastShear_run {n d : ℕ} (S : ℕ) (σ : Env) (A : RectData n d) (i j : Fin n)
    (hn : n≤S) (hd : d≤S) (hctx : BasisContext σ A i j) (hRank : FullRank (rectValue A))
