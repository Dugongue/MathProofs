    (hF : ∀ i < M,val (presentation p) canonical q.WS σ (c+i)=f.toPoly.coeff (M-1-i))
    (hFd : f.toPoly=0 ∨ f.toPoly.natDegree < M) :
    ∃ τ,Run W residueProgram σ τ (4000000000000*(p.size+1)*(M+1)^3) ∧
