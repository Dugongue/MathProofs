def RowBits {n d : ℕ} (B : IntBasis n d) (i : Fin n) (R : ℕ) : Prop :=
  ∀js : List (Fin n),js.length≤n →
    MatrixBits (fastReduceList B i js) R ∧
      ∀j : Fin n,j < i → (computedCoefficient (fastReduceList B i js) i j).natAbs.size+1≤R

