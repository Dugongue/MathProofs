  | var i => simp only [encode, bitCost, List.length_append, List.length_cons, List.length_nil]
  | add f g ihf ihg => simp [encode, bitCost, ihf, ihg]; omega
  | mul f g ihf ihg => simp [encode, bitCost, ihf, ihg]; omega





