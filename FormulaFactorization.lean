  | none => simp [result,N0268.witness,hs] at hv
  | some j =>
    have he : N0268.candidate (rectValue A).transpose j=v := by
      simpa [result,N0268.witness,hs] using hv
    have h := outputWord_magnitude A j q
    rw [magnitude_eq_abs,outputWord_value,he] at h
    exact h


