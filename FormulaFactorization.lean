section Line

variable {R S : Type*} [CommRing R] [CommRing S] [IsDomain S]

/-  The strict positive coefficient bound survives specialization because its
monic fiber keeps its degree, even when the coefficient map is not injective. -/
theorem mapped_coefficient_degree {A : R[X]} (hA : A.Monic) (φ : R →+* S)
    (H : PowerSeries R[X])
    (hHdeg : ∀ n > 0, (PowerSeries.coeff n H).degree < A.degree) :
    ∀ n > 0, (PowerSeries.coeff n (PowerSeries.map (Polynomial.mapRingHom φ) H)).degree <
