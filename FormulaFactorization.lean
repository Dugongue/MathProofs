below the full x-degree; the zero-degree seed boundary is included. -/
theorem correction_term_degree (A B U : ℚ[X]) (hA : A.Monic) (hB : B.Monic)
    (hU : U.degree<A.degree) : (U*B).degree<A.degree+B.degree := by
  by_cases hz : U=0
  · rw [hz,zero_mul,Polynomial.degree_zero,Polynomial.degree_eq_natDegree hA.ne_zero,
      Polynomial.degree_eq_natDegree hB.ne_zero]
