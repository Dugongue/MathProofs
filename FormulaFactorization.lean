theorem to_native_list {ei : Encoding γ} {ea : Encoding α} {xs : γ → List α}
    (hxs : Realized ei ea.list xs) :
    ComputableTidilyInPolyTime xs (wire ei) (encList (wire ea)) := by
  simpa only [Function.comp_def,id_eq] using
    (counted_to_native ea).comp (realized_to_native hxs).tidy

theorem of_native_list {ei : Encoding γ} {ea : Encoding α} {xs : γ → List α}
    (hxs : ComputableTidilyInPolyTime xs (wire ei) (encList (wire ea))) :
