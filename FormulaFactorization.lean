theorem swapPrefix_current {n d : ℕ} (A : RectData n d) (i j r : Fin n) (c : Fin d) :
    swapPrefix A i j c.val r c=A r c := by simp [swapPrefix]

theorem swapPrefix_step {n d : ℕ} (A : RectData n d) (i j : Fin n) (hij : i≠j) (c : Fin d) :
    updateCell (updateCell (swapPrefix A i j c.val) i c (A j c)) j c (A i c)=swapPrefix A i j (c.val+1) := by
  funext r v
  by_cases hv : v=c
  · subst v
    by_cases hi : r=i
    · subst r
      simp [updateCell,swapPrefix,hij,Equiv.swap_apply_def]
    · by_cases hj : r=j
      · subst r
        simp [updateCell,swapPrefix,Equiv.swap_apply_def]
      · simp [updateCell,swapPrefix,hi,hj,Equiv.swap_apply_def]
  · have hval : v.val≠c.val := by intro he; exact hv (Fin.ext he)
    simp only [updateCell,hv,and_false,if_false]
    unfold swapPrefix
    by_cases hl : v.val<c.val
    · have hl' : v.val<c.val+1 := by omega
      simp only [if_pos hl,if_pos hl']
    · have hl' : ¬v.val<c.val+1 := by omega
      simp only [if_neg hl,if_neg hl']

def swapI : String := "LLL.reducer.swapI"
def swapJ : String := "LLL.reducer.swapJ"
def swapCol : String := "LLL.reducer.swapCol"
def tempIS : String := "LLL.reducer.swapIS"
def tempIN : String := "LLL.reducer.swapIN"
