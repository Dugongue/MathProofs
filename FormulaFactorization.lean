  induction h using inductionOn generalizing a with
  | var i => rw [eval_var_iff.mp ha]; exact .var i
  | const q => rw [eval_const_iff.mp ha]; exact .const q
  | add g k ihg ihk =>
    obtain ⟨a₁, a₂, ha₁, ha₂, rfl⟩ := eval_add_iff.mp ha
