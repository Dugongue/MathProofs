/-  Reserved Y is variable zero; original input i is variable i+1. -/
def variableNumber {n : ℕ} : Option (Fin n) → ℕ
  | none => 0
  | some i => i.val+1

def namedSource {n : ℕ} (f : N0090.Formula (Option (Fin n))) : N0090.Formula ℕ :=
  N0090.substitute (fun v => .var (variableNumber v)) f

def binarySource {n : ℕ} (f : N0090.Formula (Option (Fin n))) : List Bool :=
  N0090.encode (namedSource f)

def variableWeight {n : ℕ} (v : Option (Fin n)) : ℕ := (N0090.natCode (variableNumber v)).length

 theorem binarySource_length {n : ℕ} (f : N0090.Formula (Option (Fin n))) :
    (binarySource f).length = N0090.bitCost variableWeight f := by
  rw [binarySource, N0090.encode_length]
  unfold namedSource
  induction f <;> simp only [N0090.substitute, N0090.bitCost, variableWeight, *]

 theorem variableNumber_injective (n : ℕ) : Function.Injective (variableNumber (n := n)) := by
  intro v w h
  cases v with
  | none =>
      cases w with
      | none => rfl
      | some j => simp only [variableNumber] at h; omega
  | some i =>
      cases w with
      | none => simp only [variableNumber] at h; omega
      | some j =>
          apply congrArg some
          apply Fin.ext
          simp only [variableNumber] at h
          omega

