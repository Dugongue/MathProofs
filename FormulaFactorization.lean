    _ ≤ ∑ j, ((2 * (enc j (values j)).length + 1) +
        if j = i then 2 * growth else 0) := by
      apply Finset.sum_le_sum
      intro j _
      by_cases h : j = i
      · subst j
        simp only [Function.update_self, ite_true]
        omega
      · simp only [Function.update_of_ne h, if_neg h, Nat.add_zero]
        exact le_rfl
