      · intro x hxa hxb hxr
        exact (hf x hxa hxb hxr).trans (hfρ x hxa hxb hxr)
      · rw [hz, Nat.size_zero]
        exact Nat.size_pos.mpr hbpos
    · have hp : 0 < η.vars gb := Nat.pos_of_ne_zero hz
      have htest : (Cond.lt (.lit 0) (.var gb)).evalB W η = some true := by
        rw [evalB_condLt (evalB_lit hw) (evalB_var hbη)]
        simpa using hp
      obtain ⟨ζ, rr2, hA2, hB2, hf2, harr2, hin2, hout2⟩ := euclidStep_run haη hbη
      refine ⟨ζ, ?_, ⟨?_, ?_, ?_, ?_, harr2.trans (harr.trans harrρ),
        hin2.trans (hin.trans hinρ), hout2.trans (hout.trans houtρ)⟩, ?_⟩
      · exact (rr.seq (Run.ite_true htest rr2)).mono (by norm_num [Cond.size, Expr.size])
