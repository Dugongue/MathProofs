variable {K : Type} [Field K]

/-  The value of row `i` of bank `j` at position `t`. -/
def rowVal {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) (j i t : ℕ) : K :=
  if h : t < n ∧ i < m then A ⟨t, h.1⟩ ⟨i, h.2⟩
  else if t = n then (if i = j then 1 else 0) else if t = n + 1 + i then 1 else 0

variable [DecidableEq K]

theorem query_target_value {n m : ℕ} (t : Fin ((n + 1) + m)) :
    read (query (m := m) (N0496.target : Fin (n + 1) → K)) t =
      if t.val = n then 1 else 0 := by
  induction t using Fin.addCases with
  | left a =>
    induction a using Fin.addCases with
    | left b =>
      simp [query, N0496.target, read_ofFn, Fin.addCases_left,
        Fin.coe_castAdd, b.isLt.ne]
    | right b =>
      have hb : b.val = 0 := by omega
      simp [query, N0496.target, read_ofFn, Fin.addCases_left,
        Fin.addCases_right, Fin.coe_castAdd, Fin.coe_natAdd, hb]
  | right b =>
    have hb : n + 1 + b.val ≠ n := by omega
    simp [query, read_ofFn, Fin.addCases_right, Fin.coe_natAdd, hb]

theorem row_columns_value {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) (j i : Fin m)
    (t : Fin ((n + 1) + m)) :
    read (augmented (N0496.columns A j) i) t =
      rowVal A j.val i.val t.val := by
  induction t using Fin.addCases with
  | left a =>
    induction a using Fin.addCases with
    | left b =>
      simp [augmented, N0496.columns, read_ofFn, rowVal,
        Fin.addCases_left, Fin.coe_castAdd, b.isLt, i.isLt]
    | right b =>
      have hb : b.val = 0 := by omega
      simp [augmented, N0496.columns, read_ofFn, rowVal,
        Fin.addCases_left, Fin.addCases_right, Fin.coe_castAdd, Fin.coe_natAdd, hb, Fin.ext_iff]
  | right b =>
    have h1 : ¬ (n + 1 + b.val < n) := by omega
    have h2 : n + 1 + b.val ≠ n := by omega
    simp only [augmented, read_ofFn, Fin.addCases_right, Fin.coe_natAdd, rowVal, h2, if_false]
    rw [dif_neg (fun h => h1 h.1), Pi.single_apply]
    by_cases hb : b = i
    · subst hb; simp
    · rw [if_neg hb, if_neg (fun e => hb (Fin.ext (by omega)))]

variable [Fintype K] (F : FieldPresentation K)

theorem bankL_eq_blockSize (n m : ℕ) :
    bankL n m = N0524.blockSize n m := rfl

/-  **The scan banks from the explicit slot clauses of the normalized banks.** -/
theorem banks_of_clauses {n m : ℕ} (A : Matrix (Fin n) (Fin m) K) (τ : Env)
    (h0 : ∀ j < m, ∀ s < 5, val F canonical N0524.q.WS τ
      ((j + 1) * bankL n m + s) = 0)
    (hq : ∀ j < m, ∀ t < bankN n m, val F canonical N0524.q.WS τ
      ((j + 1) * bankL n m + 5 + t) = if t = n then 1 else 0)
    (hr : ∀ j < m, ∀ i < m, ∀ t < bankN n m,
      val F canonical N0524.q.WS τ
        ((j + 1) * bankL n m + 5 + bankN n m + i * bankN n m + t) = rowVal A j i t) :
    N0524.Banks F A τ := by
  intro j
  refine ⟨?_, fun t => ?_, fun i t => ?_⟩
  · have h := h0 j.val j.isLt 0 (by omega)
    rw [Nat.add_zero, bankL_eq_blockSize] at h
    exact h
  · rw [query_target_value]
    have h := hq j.val j.isLt t.val t.isLt
    rw [bankL_eq_blockSize] at h
    exact h
  · rw [row_columns_value]
    have h := hr j.val j.isLt i.val i.isLt t.val t.isLt
    have e : N0524.bankAddress n m j.val +
        rowStart ((n + 1) + m) i.val + t.val =
        (j.val + 1) * bankL n m + 5 + bankN n m + i.val * bankN n m + t.val := by
      rw [bankL_eq_blockSize]
      unfold N0524.bankAddress rowStart bankN; omega
    rw [e]
    exact h

