    split_ifs
    · exact key c₁ k _ _ _ le_rfl (by omega)
    · exact key c₂ k _ _ _ le_rfl (by omega)
  · beta_reduce
    split_ifs
    · exact key c₁ k _ _ _ le_rfl (by omega)
    · exact key c₂ k _ _ _ le_rfl (by omega)
  · beta_reduce
