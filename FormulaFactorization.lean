/-!
# Rational hitting lists: certificates

A nonzero value of a rational formula at a rational matrix substitution becomes an invertible
value after a generic quantum-deformation lift into a matrix ring over a Hahn series field
(`Rational.formula_invertible_witness`); the domain of the original tree is preserved through a
localization regular at the specialization point. The affine certificate pencils of a formula then
yield nonzero determinant polynomials of bounded degree (`PencilCertificates.determinant_ne_zero`,
`PencilCertificates.degree_le`), which the generator evaluates on an integer grid.

## Main definitions

* `Cslib.Circuits.Rational.LocalSpecialization.denominators`,
  `Cslib.Circuits.Rational.LocalSpecialization.Regular`,
  `Cslib.Circuits.Rational.LocalSpecialization.evaluate`,
  `Cslib.Circuits.Rational.LocalSpecialization.intoField`: fractions regular at a point, their
  evaluation, and their embedding into a field.
* `Cslib.Circuits.Rational.PencilCertificates.coefficients`,
  `Cslib.Circuits.Rational.PencilCertificates.lifts`,
  `Cslib.Circuits.Rational.PencilCertificates.polynomial`,
  `Cslib.Circuits.Rational.PencilCertificates.determinant`: the polynomial matrix certificate of
  an affine pencil and its determinant.

## Main results

* `Cslib.Circuits.Rational.QuantumLift.formula_invertible_value`,
  `Cslib.Circuits.Rational.formula_invertible_witness`: a nonzero value lifts to a defined
  invertible value.
* `Cslib.Circuits.Rational.PencilCertificates.determinant_ne_zero`,
  `Cslib.Circuits.Rational.PencilCertificates.degree_le`: the certificate determinants are
  nonzero polynomials of bounded total degree.

## References

* Adapted from OpenAI's formalization [OpenAI2026RationalHitting] at revision
  adc7f1241b42e322a6451854ab7e4b4c146bf78a (file
  lean/OAI/Computability/RationalHitting/Certificates.lean), via the complexitylib port
  [Schlesinger2026RationalHitting] at revision add0aca8ee0d71e68969f2cb45cf91554a50f787.
-/

public section

namespace Internal.N0154.N0037

namespace N0590.N0332
open IsLocalization Matrix
noncomputable section
variable {P K E : Type*} [CommRing P] [Field K] [Field E]

/-  Elements whose specialized values are nonzero. -/
def denominators (ev : P →+* K) : Submonoid P where
  carrier := {p | ev p ≠ 0}
  one_mem' := by simp
  mul_mem' := by
    intro x y hx hy
    change ev (x * y) ≠ 0
    rw [map_mul]
    exact mul_ne_zero hx hy

/-  Localize at precisely the denominators nonzero at the chosen point. -/
abbrev Regular (ev : P →+* K) := Localization (denominators ev)

/-  Extend specialization to fractions regular at the chosen point. -/
def evaluate (ev : P →+* K) : Regular ev →+* K :=
  IsLocalization.lift (fun y : denominators ev => isUnit_iff_ne_zero.mpr y.property)

/-  On the image of `algebraMap P (Regular ev)`, `evaluate ev` agrees with `ev`. -/
@[simp] lemma evaluate_algebraMap (ev : P →+* K) (p : P) :
    evaluate ev (algebraMap P (Regular ev) p) = ev p := IsLocalization.lift_eq _ _

/-  Only fractions whose denominator is nonzero at the point are evaluated.
The entire division algebra is deliberately not given a specialization. -/
private lemma evaluate_reflects_units (ev : P →+* K) (x : Regular ev)
    (hx : IsUnit (evaluate ev x)) : IsUnit x := by
  obtain ⟨a, b, rfl⟩ := IsLocalization.exists_mk'_eq (denominators ev) x
  have heq : ev a = ev b * evaluate ev (IsLocalization.mk' (Regular ev) a b) :=
    (IsLocalization.lift_mk'_spec _ a _ b).mp rfl
  have ha : ev a ≠ 0 := by rw [heq]; exact mul_ne_zero b.property hx.ne_zero
  let a' : denominators ev := ⟨a, ha⟩
  apply isUnit_iff_exists_inv.mpr
  exact ⟨IsLocalization.mk' (Regular ev) (b : P) a', IsLocalization.mk'_mul_mk'_eq_one a' b⟩

/-  Embed the regular localization into a field containing its numerator ring. -/
def intoField (ev : P →+* K) (j : P →+* E) (hj : Function.Injective j) :
    Regular ev →+* E :=
  IsLocalization.lift (g := j) (fun y : denominators ev => isUnit_iff_ne_zero.mpr (by
    intro hz
    have hy : (y : P) = 0 := hj (hz.trans (map_zero j).symm)
    exact y.property (by rw [hy, map_zero])))

/-  On the image of `algebraMap P (Regular ev)`, `intoField ev j hj` agrees with `j`. -/
@[simp] lemma intoField_algebraMap (ev : P →+* K) (j : P →+* E)
    (hj : Function.Injective j) (p : P) :
    intoField ev j hj (algebraMap P (Regular ev) p) = j p := IsLocalization.lift_eq _ _

/-  The embedding `intoField ev j hj` of `Regular ev` into `E` is injective. -/
lemma intoField_injective (ev : P →+* K) (j : P →+* E) (hj : Function.Injective j) :
    Function.Injective (intoField ev j hj) := by
  apply (IsLocalization.lift_injective_iff _).mpr
  intro x y
  constructor
  · intro h
    simpa only [intoField_algebraMap] using congrArg (intoField ev j hj) h
  · intro h
    rw [hj h]

variable {ι : Type*} [Fintype ι] [DecidableEq ι]
private lemma matrix_reflects_units (ev : P →+* K) (A : Matrix ι ι (Regular ev))
    (hA : IsUnit ((evaluate ev).mapMatrix A)) : IsUnit A := by
  rw [Matrix.isUnit_iff_isUnit_det] at hA ⊢
  apply evaluate_reflects_units ev
  rwa [RingHom.map_det]

end
end N0590.N0332

namespace N0590.N0583
open Matrix HahnSeries
open N0590.N0332 N0590.N0392
noncomputable section
variable {K : Type*} [Field K] [CharZero K] {d : ℕ} [NeZero d]
  {n : ℕ} (χ : AddChar (ZMod d) K)

/-  The original tree remains defined after the generic deformation. A nonzero
original value becomes invertible. Domain preservation uses the localization
regular at (1,1), while final invertibility uses the division subring. -/
theorem formula_invertible_value (hχ : χ.IsPrimitive) (f : Formula n)
    (W : Fin n → Matrix (ZMod d) (ZMod d) K) (a : Matrix (ZMod d) (ZMod d) K)
    (ha : f.Eval (algebraMap ℚ _) W a) (ha0 : a ≠ 0) :
    ∃ b : Matrix (ZMod d) (ZMod d) (HahnSeries Exponents K),
      f.Eval (algebraMap ℚ _) (fun i => representation χ (liftD χ (W i))) b ∧ IsUnit b := by
  let P := MvPolynomial (Fin 2) K
  let ev : P →+* K := (MvPolynomial.aeval (fun _ : Fin 2 => (1 : K))).toRingHom
  let O := Regular ev
  let cO : ℚ →+* Matrix (ZMod d) (ZMod d) O :=
    (algebraMap O _).comp ((algebraMap P O).comp (MvPolynomial.C.comp (algebraMap ℚ K)))
  let X : Fin n → Matrix (ZMod d) (ZMod d) O := fun i =>
    (algebraMap P O).mapMatrix (polynomialLift χ (W i))
  let eps : Matrix (ZMod d) (ZMod d) O →+* Matrix (ZMod d) (ZMod d) K :=
    (evaluate ev).mapMatrix
  let inc : Matrix (ZMod d) (ZMod d) O →+*
      Matrix (ZMod d) (ZMod d) (HahnSeries Exponents K) :=
    (intoField ev N0392.embed N0392.embed_injective).mapMatrix
  have hX : (fun i => eps (X i)) = W := funext fun i => by
    rw [show eps (X i) = ev.mapMatrix (polynomialLift χ (W i)) from
      Matrix.ext fun j k => evaluate_algebraMap ev _]
    exact polynomialLift_specialize χ hχ (W i)
  have ha' : f.Eval (eps.comp cO) (fun i => eps (X i)) a := by
    rwa [hX, RingHom.ext_rat (eps.comp cO) (algebraMap ℚ _)]
  obtain ⟨y, hy, hyval⟩ := ha'.lift eps (matrix_reflects_units ev)
  have hy0 : y ≠ 0 := fun hz => ha0 (by rw [← hyval, hz, map_zero])
  have hb0 : inc y ≠ 0 :=
    (map_ne_zero_iff inc (Matrix.map_injective (intoField_injective ev _ _))).mpr hy0
  have hiX : (fun i => inc (X i)) = (fun i => representation χ (liftD χ (W i))) :=
    funext fun i => by
      rw [show inc (X i) = N0392.embed.mapMatrix (polynomialLift χ (W i)) from
        Matrix.ext fun j k => intoField_algebraMap ev _ N0392.embed_injective _]
      exact polynomialLift_embed χ (W i)
  have hb : f.Eval (algebraMap ℚ _) (fun i => representation χ (liftD χ (W i))) (inc y) := by
    simpa only [hiX, RingHom.ext_rat (inc.comp cO) (algebraMap ℚ _)] using hy.map inc
  letI : CharZero (Matrix (ZMod d) (ZMod d) K⟦Exponents⟧) := by
    constructor
    intro m n h
    have h00 : (m : K⟦Exponents⟧) = (n : K⟦Exponents⟧) := by
      simpa only [Matrix.natCast_apply, if_true] using
        congrArg (fun A : Matrix (ZMod d) (ZMod d) K⟦Exponents⟧ => A 0 0) h
    exact Nat.cast_injective h00
  let : CharZero (divisionSubring χ) := (representation χ).charZero
  refine ⟨inc y, hb, ?_⟩
  apply Formula.Eval.unit_of_division_lift (representation χ)
    (c := Rat.castHom (divisionSubring χ))
    (X := fun i => liftD χ (W i)) (h := f) _ hb0
  rwa [RingHom.ext_rat ((representation χ).comp (Rat.castHom (divisionSubring χ)))
    (algebraMap ℚ _)]

end
end N0590.N0583

namespace N0590
open Matrix
open scoped N0590.N0392
noncomputable section

/-  A nonzero value of a formula at a rational matrix substitution becomes a defined invertible
value at some substitution of matrices over the Hahn series field `QuantumLift.Exponents ℂ`. -/
theorem formula_invertible_witness {n d : ℕ} (hd : 0 < d) (f : Formula n)
    (W : Fin n → Matrix (Fin d) (Fin d) ℚ) (a : Matrix (Fin d) (Fin d) ℚ)
    (ha : f.Eval (algebraMap ℚ _) W a) (ha0 : a ≠ 0) :
    ∃ (X : Fin n → Matrix (Fin d) (Fin d) (HahnSeries N0583.Exponents ℂ))
      (v : Matrix (Fin d) (Fin d) (HahnSeries N0583.Exponents ℂ)),
      f.Eval (algebraMap ℚ _) X v ∧ IsUnit v := by
  let : NeZero d := ⟨Nat.ne_of_gt hd⟩
  let e := Matrix.reindexRingEquiv ℂ (ZMod.finEquiv d).toEquiv
  let j : Matrix (Fin d) (Fin d) ℚ →+* Matrix (ZMod d) (ZMod d) ℂ :=
    e.toRingHom.comp (algebraMap ℚ ℂ).mapMatrix
  have hj : Function.Injective j := e.injective.comp (Matrix.map_injective (algebraMap ℚ
    ℂ).injective)
  have ha' : f.Eval (algebraMap ℚ _) (fun i => j (W i)) (j a) := by
