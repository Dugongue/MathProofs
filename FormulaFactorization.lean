    (hB : B.toPoly.natDegree ≤ b) :
    algebraMap ℚ K (normNode A B a b i) =
      ∏ j : Fin a, ((B.toPoly.map (algebraMap ℚ K)).eval (β j) - algebraMap ℚ K (i : ℚ)) := by
  have henv : (fun i : Empty => algebraMap ℚ K (Empty.elim i)) = Empty.elim := by
    funext i; exact Empty.elim i
  rw [normNode, N0345.map_formula_eval, RingHom.comp_id, henv]
  unfold normNodeSource
  rw [N0644.monicProductFormula_correct (β := β)]
  · apply Finset.prod_congr rfl
    intro j hj
    change (N0276.auxiliaryPolynomial (Empty.elim : Empty → K) (denseFormula B) +
      C (algebraMap ℚ K (-(i : ℚ)))).eval (β j) = _
    rw [denseFormula_aux]
    simp only [Polynomial.eval_add, Polynomial.eval_C, Polynomial.eval_neg, map_neg, sub_eq_add_neg]
  · exact (denseFormula_aux Empty.elim A).trans hA
  · have he : N0276.auxiliaryPolynomial (Empty.elim : Empty → K)
        (.add (denseFormula B) (.const (-(i : ℚ)))) =
        B.toPoly.map (algebraMap ℚ K) + C (algebraMap ℚ K (-(i : ℚ))) := by
      change N0276.auxiliaryPolynomial Empty.elim (denseFormula B) + _ = _
      rw [denseFormula_aux]
      rfl
    rw [he]
    exact (Polynomial.natDegree_add_le _ _).trans
      (max_le (Polynomial.natDegree_map_le.trans hB) (by simp))
/-  The literal dense tree has a polynomial bill from its actual coefficients. -/
theorem denseFormula_bitCost {ι : Type} (w : Option ι → ℕ)
    (P : N0625.NumericPolynomial) (h : ℕ)
    (hc : ∀ i ≤ P.natDegree, N0090.ratWeight (P.coeff i) ≤ h) :
    N0090.bitCost w (denseFormula P) ≤
      (P.natDegree + 1) * (h + P.natDegree * (4 + w none) +
        (2 + N0090.ratWeight 1) + 6) + (2 + N0090.ratWeight 0) := by
  unfold denseFormula
  have hb := N0090.weightedSum_bitCost_le w
    ((List.range (P.natDegree + 1)).map fun i => (P.coeff i, N0090.power (.var none) i))
    h (P.natDegree * (4 + w none) + (2 + N0090.ratWeight 1))
  apply (by simpa only [List.length_map, List.length_range, Nat.add_assoc] using hb)
  intro t ht
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp ht
  have hi' : i ≤ P.natDegree := Nat.le_of_lt_succ (List.mem_range.mp hi)
  refine ⟨hc i hi', ?_⟩
  rw [N0090.bitCost_power]
  change i * ((2 + w none) + 2) + _ ≤ _
  nlinarith

/-  Every numeric coefficient literal is bounded by the actual paid source
that computes it, with no input-height assumption or unknown inverse table. -/
theorem normCoefficient_literal_bound (A B : N0625.NumericPolynomial) (a b k : ℕ) :
    N0090.ratWeight (normCoefficient A B a b k) ≤
      4 * N0090.bitCost (fun _ : Empty => 0) (normCoefficientSource A B a b k) + 7 := by
  simpa only [normCoefficient, zero_add, one_mul] using
    N0345.evaluated_literal_bit_bound (fun _ : Empty => 0) 0 Empty.elim
      (by intro i; exact Empty.elim i) (normCoefficientSource A B a b k)

/-  The norm characteristic has degree at most the number of roots,
with multiplicity; no separability condition is used. -/
theorem normPolynomial_degree {R : Type} [CommRing R] (a : ℕ) (γ : Fin a → R) :
    (∏ i : Fin a, (C (γ i) - X)).natDegree ≤ a := by
  have hi : ∀ i : Fin a, (C (γ i) - X : R[X]).natDegree ≤ 1 := by
    intro i
    exact (Polynomial.natDegree_sub_le _ _).trans
      (max_le (by simp) Polynomial.natDegree_X_le)
  exact (Polynomial.natDegree_prod_le _ _).trans (by
    simpa using Finset.sum_le_sum (fun i (h : i ∈ Finset.univ) => hi i))

/-  Actual rational interpolation coefficients equal the norm characteristic
coefficients in every split extension. -/
theorem normCoefficient_correct {K : Type} [CommRing K] [Algebra ℚ K]
    (A B : N0625.NumericPolynomial) (a b k : ℕ) (β : Fin a → K)
    (hA : A.toPoly.map (algebraMap ℚ K) = ∏ j : Fin a, (X - C (β j)))
    (hB : B.toPoly.natDegree ≤ b) (hk : k ≤ a) :
    algebraMap ℚ K (normCoefficient A B a b k) =
      (∏ j : Fin a, (C ((B.toPoly.map (algebraMap ℚ K)).eval (β j)) - X)).coeff k := by
  rw [N0276.coefficient_eq_weighted_evaluations _ a k
    (normPolynomial_degree a _) hk]
  unfold normCoefficient normCoefficientSource
  rw [N0090.eval₂_weightedSum]
  simp only [List.map_map, Function.comp_def, map_list_sum, map_mul, RingHom.id_apply]
  rw [← List.sum_toFinset _ (List.nodup_range (n := a + 1))]
  simp only [List.toFinset_range]
  apply Finset.sum_congr rfl
  intro i hi
  change algebraMap ℚ K (N0276.coefficientWeight a k i) *
    algebraMap ℚ K (normNode A B a b i) = _
  rw [normNode_correct A B a b i β hA hB]
  simp only [Polynomial.eval_prod, Polynomial.eval_sub, Polynomial.eval_C, Polynomial.eval_X]

/-  Sign changes have no effect on the exact paid literal size. -/
theorem ratWeight_neg (q : ℚ) : N0090.ratWeight (-q) = N0090.ratWeight q := by
  simp [N0090.ratWeight_eq]

/-  Inversion only exchanges the reduced numerator and denominator. -/
theorem ratWeight_inv (q : ℚ) : N0090.ratWeight q⁻¹ = N0090.ratWeight q := by
  by_cases hq : q = 0
  · simp [hq]
  · have hn : q.num ≠ 0 := Rat.num_ne_zero.mpr hq
    simp only [N0090.ratWeight_eq, Rat.num_inv, Rat.den_inv_of_ne_zero hq,
      Int.natAbs_mul, Int.natAbs_natCast, Int.natAbs_sign_of_ne_zero hn, one_mul]
    omega

/-  A uniform polynomial node budget, including the grid scalar. -/
def normNodeBudget (A B : N0625.NumericPolynomial) (a b : ℕ) : ℕ :=
  N0644.outputBudget a b
    (N0344.reverseCostBound a
      (N0090.bitCost (N0206.auxiliaryWeight (fun _ : Empty => 0)) (denseFormula A)) 0)
    (N0090.bitCost (N0206.auxiliaryWeight (fun _ : Empty => 0)) (denseFormula B) + 2 * a + 9)

theorem normNodeSource_bitCost (A B : N0625.NumericPolynomial)
    (a b i : ℕ) (hi : i ≤ a) :
    N0090.bitCost (fun _ : Empty => 0) (normNodeSource A B a b i) ≤ normNodeBudget A B a b := by
  unfold normNodeSource N0644.monicProductFormula
  apply (N0644.productFormula_bitCost _ _ _ _ _).trans
  apply N0644.outputBudget_mono
  · exact N0344.reverseFormula_bitCost _ a _
  · have hs := N0206.natLiteral_bit_bound a i hi
    simp only [N0090.bitCost, ratWeight_neg]
    omega

def normCoefficientBudget (A B : N0625.NumericPolynomial) (a b : ℕ) : ℕ :=
  (a + 1) * (4 * ((2 * a + 2) * (a + 1)) + 7 + normNodeBudget A B a b + 6) +
    (2 + N0090.ratWeight 0)

theorem normCoefficientSource_bitCost (A B : N0625.NumericPolynomial)
    (a b k : ℕ) :
    N0090.bitCost (fun _ : Empty => 0) (normCoefficientSource A B a b k) ≤
      normCoefficientBudget A B a b := by
  unfold normCoefficientSource normCoefficientBudget
  have hh := N0090.weightedSum_bitCost_le (fun _ : Empty => 0)
    ((List.range (a + 1)).map fun i =>
      (N0276.coefficientWeight a k i, normNodeSource A B a b i))
    (4 * ((2 * a + 2) * (a + 1)) + 7) (normNodeBudget A B a b)
  apply (by simpa only [List.length_map, List.length_range] using hh)
  intro t ht
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp ht
  have hi' := Nat.le_of_lt_succ (List.mem_range.mp hi)
  exact ⟨N0206.coefficientWeight_bit_bound a k i hi', normNodeSource_bitCost A B a b i hi'⟩

/-  Uniform actual numeric coefficient heights from the two original dense inputs. -/
theorem normCoefficient_paid_height (A B : N0625.NumericPolynomial) (a b k : ℕ) :
    N0090.ratWeight (normCoefficient A B a b k) ≤ 4 * normCoefficientBudget A B a b + 7 := by
  exact (normCoefficient_literal_bound A B a b k).trans
    (by gcongr; exact normCoefficientSource_bitCost A B a b k)

/-  Actual raw inverse source: the sole inverse scalar is a computed rational
norm constant. It is charged with its proved literal height. -/
def rawInverseSource (A B : N0625.NumericPolynomial) (a b : ℕ) :
    N0090.Formula (Option Empty) :=
  N0090.scale (-(normCoefficient A B a b 0)⁻¹)
    (N0090.weightedSum ((List.range a).map fun j =>
      (normCoefficient A B a b (j + 1), N0090.power (denseFormula B) j)))

/-  The only inverted literal has the same height as the computed norm constant. -/
theorem rawInverse_scalar_height (A B : N0625.NumericPolynomial) (a b : ℕ) :
    N0090.ratWeight (-(normCoefficient A B a b 0)⁻¹) ≤ 4 * normCoefficientBudget A B a b + 7 := by
  rw [ratWeight_neg, ratWeight_inv]
  exact normCoefficient_paid_height A B a b 0

/-  Exact coefficient identity behind the structured inverse, over any ring. -/
theorem constant_tail_identity {R : Type} [CommRing R] (P : R[X]) (a : ℕ)
    (hP : P.natDegree ≤ a) :
    C (P.coeff 0) + X * ∑ j ∈ Finset.range a, C (P.coeff (j + 1)) * X ^ j = P := by
  have hp := P.as_sum_range_C_mul_X_pow' (show P.natDegree < a + 1 by omega)
  rw [Finset.sum_range_succ'] at hp
  simp only [pow_zero, mul_one] at hp
  have hs : X * ∑ j ∈ Finset.range a, C (P.coeff (j + 1)) * X ^ j =
      ∑ j ∈ Finset.range a, C (P.coeff (j + 1)) * X ^ (j + 1) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [pow_succ]
    ring
  rw [hs, add_comm]
  exact hp.symm
/-  Concrete polynomial semantics of the raw paid inverse source. -/
theorem rawInverseSource_aux {R : Type} [CommRing R] [Algebra ℚ R]
    (A B : N0625.NumericPolynomial) (a b : ℕ) :
    N0276.auxiliaryPolynomial (Empty.elim : Empty → R) (rawInverseSource A B a b) =
      C (algebraMap ℚ R (-(normCoefficient A B a b 0)⁻¹)) *
        ∑ j ∈ Finset.range a, C (algebraMap ℚ R (normCoefficient A B a b (j + 1))) *
          (B.toPoly.map (algebraMap ℚ R)) ^ j := by
  unfold rawInverseSource N0276.auxiliaryPolynomial
  rw [N0090.eval₂_scale, N0090.eval₂_weightedSum]
  simp only [List.map_map, Function.comp_def, N0090.eval₂_power]
  rw [← List.sum_toFinset _ (List.nodup_range (n := a))]
  simp only [List.toFinset_range]
  congr 1
  apply Finset.sum_congr rfl
  intro j hj
  change _ * N0276.auxiliaryPolynomial Empty.elim (denseFormula B) ^ j = _
  rw [denseFormula_aux]
  rfl

/-  The computed raw source is an inverse modulo A, proved through any split
field. The field and its roots are proof witnesses only. -/
theorem rawInverseSource_inverse {K : Type} [Field K] [Algebra ℚ K]
    (A B : N0625.NumericPolynomial) (a b : ℕ) (β : Fin a → K)
    (hA : A.toPoly.map (algebraMap ℚ K) = ∏ j : Fin a, (X - C (β j)))
    (hAB : IsCoprime A.toPoly B.toPoly) (hB : B.toPoly.natDegree ≤ b) :
    A.toPoly ∣ N0276.auxiliaryPolynomial (Empty.elim : Empty → ℚ)
      (rawInverseSource A B a b) * B.toPoly - 1 := by
  let f := algebraMap ℚ K
  let AM := A.toPoly.map f
  let BM := B.toPoly.map f
  let P : K[X] := ∏ j : Fin a, (C (BM.eval (β j)) - X)
  have hcop : IsCoprime AM BM := hAB.map (Polynomial.mapRingHom f)
  have hc0 : P.coeff 0 ≠ 0 := norm_constant_ne_zero a β AM BM hA hcop
  have hc (k : ℕ) (hk : k ≤ a) : f (normCoefficient A B a b k) = P.coeff k :=
    normCoefficient_correct A B a b k β hA hB hk
  have hdiv : AM ∣ P.comp BM := by
    change A.toPoly.map f ∣ P.comp BM
    rw [hA]
    exact rootProduct_dvd_composedNorm a β BM
  have htail := congrArg (fun Q : K[X] => Q.comp BM)
    (constant_tail_identity P a (normPolynomial_degree a _))
  simp only [Polynomial.add_comp, Polynomial.C_comp, Polynomial.mul_comp, Polynomial.X_comp,
    Polynomial.sum_comp, Polynomial.pow_comp] at htail
  have he : (N0276.auxiliaryPolynomial (Empty.elim : Empty → ℚ)
      (rawInverseSource A B a b)).map f * BM - 1 = -C ((P.coeff 0)⁻¹) * P.comp BM := by
    rw [rawInverseSource_aux]
    simp only [Polynomial.map_mul, Polynomial.map_C, Polynomial.map_sum, Polynomial.map_pow,
      Polynomial.map_map, RingHom.comp_id, Algebra.algebraMap_self, RingHom.id_apply]
    simp only [map_neg, map_inv₀ f, hc 0 (Nat.zero_le _)]
    have hs : (∑ j ∈ Finset.range a,
        C (f (normCoefficient A B a b (j + 1))) * BM ^ j) =
        ∑ j ∈ Finset.range a, C (P.coeff (j + 1)) * BM ^ j := by
      apply Finset.sum_congr rfl
      intro j hj
      rw [hc (j + 1) (by have := Finset.mem_range.mp hj; omega)]
    change (-C ((P.coeff 0)⁻¹) *
      ∑ j ∈ Finset.range a, C (f (normCoefficient A B a b (j + 1))) * BM ^ j) * BM - 1 = _
    rw [hs, ← htail]
    have hinv : C ((P.coeff 0)⁻¹) * C (P.coeff 0) = (1 : K[X]) := by
      rw [← Polynomial.C_mul, inv_mul_cancel₀ hc0, Polynomial.C_1]
    linear_combination hinv
  apply (Polynomial.map_dvd_map' f).mp
  simpa only [Polynomial.map_sub, Polynomial.map_mul, Polynomial.map_one, ← he] using
    (dvd_mul_left _ (-C ((P.coeff 0)⁻¹))).trans (mul_dvd_mul_left _ hdiv)

/-  One output coefficient of the reduced inverse, computed by the existing
root-free residue source with J = 1; no Euclidean algorithm is called. -/
def inverseCoefficientSource (A B : N0625.NumericPolynomial) (a b r : ℕ) :
    N0090.Formula Empty :=
  let f := rawInverseSource A B a b
  N0625.functionalFormula A 1 r 0 f.formalDegree f

def inverseCoefficient (A B : N0625.NumericPolynomial) (a b r : ℕ) : ℚ :=
  N0090.eval₂ (RingHom.id ℚ) Empty.elim (inverseCoefficientSource A B a b r)

/-  Executable structured initializer: a dense polynomial of proved inverse
coefficients. Its only divisions are numeric literal inversion and monic reduction. -/
def structuredInverse (A B : N0625.NumericPolynomial) (a b : ℕ) :
    N0625.NumericPolynomial :=
  Internal.N0048.CPolynomial.ofArray (Array.ofFn fun r : Fin a => inverseCoefficient A B a b r.val)

theorem inverseCoefficient_correct (A B : N0625.NumericPolynomial) (a b r : ℕ)
    (hA : A.toPoly.Monic) :
    inverseCoefficient A B a b r =
      ((N0276.auxiliaryPolynomial (Empty.elim : Empty → ℚ)
        (rawInverseSource A B a b)) %ₘ A.toPoly).coeff r := by
  unfold inverseCoefficient inverseCoefficientSource
  have h := N0625.functionalFormula_correct (Empty.elim : Empty → ℚ) A 1 r 0
    (rawInverseSource A B a b).formalDegree (rawInverseSource A B a b) hA
    (N0388.auxiliaryPolynomial_degree _ _)
  simpa only [Algebra.algebraMap_self, Internal.N0048.CPolynomial.toPoly_one, Polynomial.map_id,
    pow_zero, one_mul, clusterFunctional_apply, mul_one] using h

theorem structuredInverse_toPoly (A B : N0625.NumericPolynomial) (a b : ℕ)
    (hA : A.toPoly.Monic) (ha : A.toPoly.natDegree = a) :
    (structuredInverse A B a b).toPoly =
      (N0276.auxiliaryPolynomial (Empty.elim : Empty → ℚ)
        (rawInverseSource A B a b)) %ₘ A.toPoly := by
  ext r
  rw [← Internal.N0048.CPolynomial.coeff_toPoly]
  unfold structuredInverse
  rw [Internal.N0048.CPolynomial.coeff_ofArray, Array.getD_eq_getD_getElem?]
  by_cases hr : r < a
  · simp only [Array.getElem?_ofFn, hr, Option.getD_some]
    exact inverseCoefficient_correct A B a b r hA
  · simp only [Array.getElem?_ofFn, hr, Option.getD_none]
    symm
    apply Polynomial.coeff_eq_zero_of_degree_lt
    have hd := Polynomial.degree_modByMonic_lt
      (N0276.auxiliaryPolynomial (Empty.elim : Empty → ℚ) (rawInverseSource A B a b)) hA
    rw [Polynomial.degree_eq_natDegree hA.ne_zero, ha] at hd
    exact hd.trans_le (by exact_mod_cast Nat.le_of_not_gt hr)

theorem structuredInverse_proper (A B : N0625.NumericPolynomial) (a b : ℕ)
    (hA : A.toPoly.Monic) (ha : A.toPoly.natDegree = a) :
    (structuredInverse A B a b).toPoly.degree < A.toPoly.degree := by
  rw [structuredInverse_toPoly A B a b hA ha]
  exact Polynomial.degree_modByMonic_lt _ hA

/-  The structured initializer has the exact same proper inverse as the
existing executable Euclidean backend, without using it in this program. -/
theorem structuredInverse_eq_euclidean {K : Type} [Field K] [Algebra ℚ K]
    (A B : N0625.NumericPolynomial) (a b : ℕ) (β : Fin a → K)
    (hA : A.toPoly.Monic) (ha : A.toPoly.natDegree = a)
    (hsplit : A.toPoly.map (algebraMap ℚ K) = ∏ j : Fin a, (X - C (β j)))
    (hAB : IsCoprime A.toPoly B.toPoly) (hB : B.toPoly.natDegree ≤ b) :
    (structuredInverse A B a b).toPoly = (N0625.reducedInversePair A B).1.toPoly := by
  apply proper_inverse_unique A.toPoly B.toPoly _ _ hA hAB
    (structuredInverse_proper A B a b hA ha) (N0625.reducedInversePair_proper A B hA)
  · have hr := rawInverseSource_inverse A B a b β hsplit hAB hB
    have hm := Polynomial.dvd_modByMonic_sub
      (N0276.auxiliaryPolynomial (Empty.elim : Empty → ℚ) (rawInverseSource A B a b)) A.toPoly
    rw [structuredInverse_toPoly A B a b hA ha]
    convert dvd_add hr (dvd_mul_right _ B.toPoly |>.trans (mul_dvd_mul_right hm B.toPoly)) using 1 <;> ring
  · obtain h := N0625.reducedInversePair_correct A B hA hAB
    refine ⟨-(N0625.reducedInversePair A B).2.toPoly, ?_⟩
    linear_combination h

/-  Polynomial paid budget for the complete raw inverse tree. -/
def rawInverseBudget (A B : N0625.NumericPolynomial) (a b : ℕ) : ℕ :=
  let H := 4 * normCoefficientBudget A B a b + 7
  let S := N0090.bitCost (N0206.auxiliaryWeight (fun _ : Empty => 0)) (denseFormula B)
  4 + H + (a * (H + (a * (S + 2) + (2 + N0090.ratWeight 1)) + 6) + (2 + N0090.ratWeight 0))

theorem rawInverseSource_bitCost (A B : N0625.NumericPolynomial) (a b : ℕ) :
    N0090.bitCost (N0206.auxiliaryWeight (fun _ : Empty => 0)) (rawInverseSource A B a b) ≤
      rawInverseBudget A B a b := by
  unfold rawInverseSource
  rw [N0090.bitCost_scale]
  have hh := N0090.weightedSum_bitCost_le (N0206.auxiliaryWeight (fun _ : Empty => 0))
    ((List.range a).map fun j =>
      (normCoefficient A B a b (j + 1), N0090.power (denseFormula B) j))
    (4 * normCoefficientBudget A B a b + 7)
    (a * (N0090.bitCost (N0206.auxiliaryWeight (fun _ : Empty => 0)) (denseFormula B) + 2) +
      (2 + N0090.ratWeight 1)) (by
      intro t ht
      obtain ⟨j, hj, rfl⟩ := List.mem_map.mp ht
      refine ⟨normCoefficient_paid_height A B a b (j + 1), ?_⟩
      rw [N0090.bitCost_power]
      have hj' : j ≤ a := Nat.le_of_lt (List.mem_range.mp hj)
      gcongr)
  have hs := rawInverse_scalar_height A B a b
  simp only [List.length_map, List.length_range] at hh
  unfold rawInverseBudget
  dsimp only
  omega

/-  A polynomial, uniform source bound for one proper inverse coefficient. -/
def inverseSourceBudget (A B : N0625.NumericPolynomial) (a b h : ℕ) : ℕ :=
  let T := rawInverseBudget A B a b
  (T + 1) * ((4 * (((a + 2) * (h + 7) + 1) * (T + 1)) + 7) +
    ((T + 1) * (4 * ((2 * T + 2) * (T + 1)) + 7 +
      (2 * T + 6) * T + 6) + (2 + N0090.ratWeight 0)) + 6) + (2 + N0090.ratWeight 0)

theorem inverseCoefficientSource_bitCost (A B : N0625.NumericPolynomial)
    (a b h r : ℕ) (hA : A.toPoly.Monic) (ha : A.toPoly.natDegree = a)
    (hr : r < a) (hc : ∀ i < a, N0090.ratWeight (A.coeff i) ≤ h) :
    N0090.bitCost (fun _ : Empty => 0) (inverseCoefficientSource A B a b r) ≤
      inverseSourceBudget A B a b h := by
  have hapos : 0 < a := by omega
  have hdeg : A.toPoly.natDegree = (a - 1) + 1 := by omega
  have hproper : (1 : ℚ[X]).degree < A.toPoly.degree := by
    rw [Polynomial.degree_one, Polynomial.degree_eq_natDegree hA.ne_zero, ha]
    exact_mod_cast hapos
  have hones : ∀ i < (a - 1) + 1,
      N0090.ratWeight ((1 : N0625.NumericPolynomial).coeff i) ≤ h + 7 := by
    intro i hi
    rw [Internal.N0048.CPolynomial.coeff_toPoly, Internal.N0048.CPolynomial.toPoly_one, Polynomial.coeff_one]
    split_ifs <;> norm_num [N0090.ratWeight_eq]
  have h := N0627.functionalFormula_bitCost_input_bound (fun _ : Empty => 0)
    (a - 1) A 1 hA hdeg (by simpa only [Internal.N0048.CPolynomial.toPoly_one] using hproper) (h + 7)
    (fun i hi => (hc i (by omega)).trans (Nat.le_add_right _ _)) hones r 0
    (rawInverseSource A B a b).formalDegree (by omega) (rawInverseSource A B a b)
  change N0090.bitCost _ (N0625.functionalFormula _ _ _ _ _ _) ≤ _
  apply h.trans
  have hcost := rawInverseSource_bitCost A B a b
  have hdegree := (N0090.formalDegree_le_bitCost
    (N0206.auxiliaryWeight (fun _ : Empty => 0)) (rawInverseSource A B a b)).trans hcost
  unfold inverseSourceBudget
  dsimp only
  simp only [Nat.add_zero]
  gcongr <;> omega

theorem inverseCoefficient_paid_height (A B : N0625.NumericPolynomial)
    (a b h r : ℕ) (hA : A.toPoly.Monic) (ha : A.toPoly.natDegree = a)
    (hr : r < a) (hc : ∀ i < a, N0090.ratWeight (A.coeff i) ≤ h) :
    N0090.ratWeight (inverseCoefficient A B a b r) ≤ 4 * inverseSourceBudget A B a b h + 7 := by
