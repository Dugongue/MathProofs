theorem expr_layout_mono (L L' : Layout)
    (hs : ∀x,x∈L.scalars → x∈L'.scalars) (ha : ∀a,a∈L.arrays → a∈L'.arrays) (ht : L.temps ≤ L'.temps) :
    ∀(e : Expr)(d : ℕ),Expr.Ok L e d → Expr.Ok L' e d := by
  intro e
  induction e with
  | lit v => intro d h; trivial
  | var x => intro d h; exact hs x h
  | get a e ih => intro d h; exact ⟨ha a h.1,ih d h.2.1,h.2.2.trans_le ht⟩
  | bin op e f ihe ihf => intro d h; exact ⟨ihf d h.1,ihe (d+1) h.2.1,h.2.2.trans_le ht⟩

theorem com_layout_mono (L L' : Layout)
    (hs : ∀x,x∈L.scalars → x∈L'.scalars) (ha : ∀a,a∈L.arrays → a∈L'.arrays) (ht : L.temps ≤ L'.temps) :
    ∀c : Com,Com.Ok L c → Com.Ok L' c := by
  intro c
  induction c with
  | skip => intro h; trivial
  | assign x e => intro h; exact ⟨hs x h.1,expr_layout_mono L L' hs ha ht e 0 h.2⟩
  | store a i e => intro h; exact ⟨ha a h.1,expr_layout_mono L L' hs ha ht i 0 h.2.1,expr_layout_mono L L' hs ha ht e 1 h.2.2.1,h.2.2.2.trans_le ht⟩
  | seq c d ihc ihd => intro h; exact ⟨ihc h.1,ihd h.2⟩
  | ite b c d ihc ihd => intro h; exact ⟨expr_layout_mono L L' hs ha ht (condExpr b) 0 h.1,ihc h.2.1,ihd h.2.2⟩
  | «while» b c ih => intro h; exact ⟨expr_layout_mono L L' hs ha ht (condExpr b) 0 h.1,ih h.2⟩
  | read x => intro h; exact hs x h
  | write e => intro h; exact ⟨expr_layout_mono L L' hs ha ht e 0 h.1,h.2.trans_le ht⟩

