/-  Full actual-source Berlekamp split, from original coefficients alone.
The source returns irreducibility or a physically stored positive proper gcd.
There is no supplied matrix, kernel vector, initialized v buffer or Run. -/
theorem program_complete (p Sn W n M b c r gs os : ℕ) [Fact p.Prime]
    (f : CPolynomial (ZMod p)) (σ : Env)
    (hs : Slots (presentation p) canonical nq.WS Sn W σ) (hparams : Parameters n M b c σ)
    (hr : σ.vars N0179.rawRegister=r)
    (ha : σ.vars N0186.vectorAddress=gs)
    (ho : σ.vars N0188.resultRegister=os)
    (hM : M=p*n+1) (hfdeg : f.natDegree=n) (hpos : 2  ≤  n) (hf : f.toPoly.Monic) (hsf : Squarefree f.toPoly)
    (hwork : 5+4*M  ≤  Sn) (hbafter : 5+4*M  ≤  b) (hcafter : 5+4*M  ≤  c)
    (hbfit : b+M  ≤  c) (hfit : c+M  ≤  r) (hrawfit : r+(n+1)  ≤  Sn)
    (hkernel : 5+n*(n-1)  ≤  Sn)
    (hbank : n*N0178.bankSize n (n-1)  ≤  Sn)
    (hkeep1 : 5+n*(n-1)  ≤  c) (hkeep2 : n*N0178.bankSize n (n-1)  ≤  c)
    (harray : n*(n-1)  ≤  (σ.arrs matrixArray).length) (harrayW : (σ.arrs matrixArray).length<W)
    (hcg : c+M  ≤  gs) (hvector : N0178.bankSize n (n-1)+(n-1)  ≤  gs)
    (hgos : gs+(n+1)  ≤  os) (hof : os+(n+1)  ≤  Sn)
    (hraw : ∀i<n+1,val (presentation p) canonical nq.WS σ (r+i)=f.toPoly.coeff i) :
    ∃τ,Run W program σ τ (splitCost p n M)   ∧   Slots (presentation p) canonical nq.WS Sn W τ   ∧  
      ((τ.vars foundRegister=0   ∧   Irreducible f.toPoly)   ∨  
        (τ.vars foundRegister=1   ∧   ∃v : Array ℕ,
          N0188.Recorded p (n+1) os n f
            (N0182.decodedPolynomial p v) p τ))   ∧  
      τ.inp=σ.inp   ∧   τ.out=σ.out := by
  let σ1 := σ.setVar foundRegister 0
  have h0W : 0<W := by have := hs.slots_word;omega
  have h1W : 1<W := by have hh:=hs.base.arithmetic_word;change (p+1)^2<W at hh;nlinarith
  have rinit : Run W (.assign foundRegister (.lit 0)) σ σ1 2 := Run.assign (evalB_lit h0W)
  have hs1 : Slots (presentation p) canonical nq.WS Sn W σ1 :=
    Slots.setVar (presentation p) canonical hs (by decide) (by decide) _
  have hvars1 : ∀x,x  ≠  foundRegister → σ1.vars x=σ.vars x := by intro x hx;simp only [σ1,vars_setVar,if_neg hx]
  have hpar1 : Parameters n M b c σ1 := ⟨
    (hvars1 _ (by decide)).trans hparams.degree,(hvars1 _ (by decide)).trans hparams.capacity,
    (hvars1 _ (by decide)).trans hparams.numerator,(hvars1 _ (by decide)).trans hparams.divisor⟩
  obtain ⟨ξ,hkernelRun,hξ,hpar,hnone,hsome,hpad,hbase,hflag,hinkernel,houtkernel⟩ :=
    polynomial_framed p Sn W n M b c r f σ1 hs1 hpar1 ((hvars1 _ (by decide)).trans hr) hM hfdeg hpos hf
      hwork hbafter hcafter hbfit hfit hrawfit hkernel hbank hkeep1 hkeep2 harray (by simpa [σ1] using harrayW)
      (fun i hi=>(val_setVar (presentation p) canonical (by decide) σ 0 (r+i)).trans (hraw i hi))
  have hwide : n+1  ≤  M := by
    have hp : 0<p := (Fact.out : p.Prime).pos
    have hh : n  ≤  p*n := Nat.le_mul_of_pos_left _ hp
    omega
  have hfBound : ξ.vars kernelFlag ≤ 1 := hflag
  cases hv : N0178.output n (n-1) ξ with
  | none =>
    have hnflag : ξ.vars kernelFlag  ≠  0 := by
      intro hz
      change ξ.vars "P18.kernel.flag"=0 at hz
      simp [N0178.output,hz] at hv
    have hf1 : ξ.vars kernelFlag=1 := by omega
    have ev : (Expr.var kernelFlag).evalB W ξ=some 1 :=
      (evalB_var (by rw [hf1];exact h1W)).trans (congrArg some hf1)
    have eguard : (Cond.eq (.var kernelFlag) (.lit 0)).evalB W ξ=some false :=
      evalB_condEq ev (evalB_lit h0W)
    have rbranch : Run W (.ite (.eq (.var kernelFlag) (.lit 0)) positiveBody .skip) ξ ξ 5 :=
      Run.ite_false eguard Run.skip
    have hrun : Run W program σ ξ (splitCost p n M) := by
      apply (rinit.seq (hkernelRun.seq rbranch)).mono
      exact stop_pay (kernelCost p n M) (bodyCost p n)
    have htrivial : ∀x,(N0182.matrix p f.natDegree f).mulVec x=0 → x=0 := by
      rw [hfdeg]
      exact hnone.mp hv
    have hirr := N0182.trivial_irreducible p f hf (by omega) hsf htrivial
    have hfound : ξ.vars foundRegister=0 := by
      have hh := (run_frame hkernelRun).1 foundRegister (by decide)
