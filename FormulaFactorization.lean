theorem setCell_self {w a v : ℕ} (m : ℕ → ℕ) (ha : a < 2 ^ w) (hv : v < 2 ^ w) :
    setCell w m a v a = v := by
  rw [setCell_eq, Nat.mod_eq_of_lt ha, if_pos rfl, Nat.mod_eq_of_lt hv]

