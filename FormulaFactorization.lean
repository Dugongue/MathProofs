/-  `(x + y % M) % M = (x + y) % M`. -/
private theorem add_mod_inner (x y M : Nat) : (x + y % M) % M = (x + y) % M := by
  rw [Nat.add_mod, Nat.mod_mod, ← Nat.add_mod]

/-  Modular negation commutes with multiplication by `w`: since `(M-X)*w` and
