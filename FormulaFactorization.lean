    elimCost M q N c ≤ 1000 * W * (N + 1) * (c + 1) := by
  have h1 := hW.one; have h2 := hW.mul; have h3 := hW.inv
  have a1 := axpyCost_le hW (rowBase q (.var q.w)) (rowBase q (.var q.u)) (by
    simp [rowBase, plus, Expr.size]) (by simp [rowBase, plus, Expr.size]) N
  have a2 := axpyCost_le hW (.lit 5) (rowBase q (.var q.u)) (by simp [Expr.size])
    (by simp [rowBase, plus, Expr.size]) N
  have hs : 60 + M.costMul + axpyCost M (rowBase q (.var q.w)) (rowBase q (.var q.u)) N ≤
      361 * W * (N + 1) := by nlinarith
  have := Nat.mul_le_mul_right c hs
  unfold elimCost
  nlinarith

theorem stepCost_le (hW : CostBound M W) (q : RNames) (N n c : ℕ) (hn : n ≤ N) :
    stepCost M q N n c ≤ 1100 * W * (N + 1) * (c + 1) := by
  have h1 := hW.one
  have p := pivotCost_le hW n
  have e := elimCost_le hW q N c
