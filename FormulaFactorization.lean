  exact N0041.clusterFormula_bitCost u A B N _ _

section PaidRadial

/-  Actual finite center literals, not an assumed small center-height witness. -/
def centerHeight {ι : Type} [Fintype ι] (a : ι → ℚ) : ℕ :=
  Finset.univ.sup (fun i => N0090.ratWeight (a i))

 theorem centerHeight_bound {ι : Type} [Fintype ι] (a : ι → ℚ) (i : ι) :
    N0090.ratWeight (a i) ≤ centerHeight a :=
  Finset.le_sup (f := fun i => N0090.ratWeight (a i)) (Finset.mem_univ i)

 theorem ratWeight_neg (q : ℚ) : N0090.ratWeight (-q) = N0090.ratWeight q := by
  simp [N0090.ratWeight_eq]

/-  Every copied center literal and variable occurrence is paid in the actual radial tree. -/
 theorem radialSource_bitCost {ι : Type} [Fintype ι] (w : ι → ℕ)
    (a : ι → ℚ) (f : N0090.Formula (Option ι)) :
    N0090.bitCost (N0206.auxiliaryWeight (N0206.auxiliaryWeight w)) (radialSource a f) ≤
      (14+2*centerHeight a)*N0090.bitCost (N0206.auxiliaryWeight w) f := by
  induction f with
  | const q =>
      simp only [radialSource, N0090.substitute, N0090.bitCost]
      nlinarith
  | var v =>
      cases v with
      | none =>
          simp only [radialSource, N0090.substitute, radialSubstitution, N0090.bitCost, N0206.auxiliaryWeight]
          omega
      | some i =>
          have h := centerHeight_bound a i
          simp only [radialSource, N0090.substitute, radialSubstitution, N0090.bitCost,
            N0206.auxiliaryWeight, ratWeight_neg]
          nlinarith
  | add f g hf hg =>
      simp only [radialSource, N0090.substitute, N0090.bitCost] at hf hg ⊢
      nlinarith
  | mul f g hf hg =>
      simp only [radialSource, N0090.substitute, N0090.bitCost] at hf hg ⊢
      nlinarith

 theorem numericSource_bitCost {ι : Type} (w : ι → ℕ) (D : NumericPolynomial) :
    N0090.bitCost (N0206.auxiliaryWeight w) (numericSource D) ≤
      N0344.tableCostBound D.natDegree (2+N0041.fiberHeight D) 0 := by
  apply N0344.tableFormula_bitCost
  intro j hj
  exact Nat.add_le_add_left (N0041.fiberHeight_bound D j hj) 2

