  · exact h.scalar_names
  · simpa [he] using h.degree_pos
  · simpa [hp] using h.arithmetic_word
  · exact h.memory_word
  · exact h.modulus_word
  · exact h.scratch_word
  · simpa [he] using h.scratch_fit
  · simpa [ha,he] using h.first_fit
  · simpa [hb,he] using h.second_fit
