  | some v =>
    have hf0 : ξ.vars kernelFlag=0 := by
      by_contra hz
      change ξ.vars "P18.kernel.flag"  ≠  0 at hz
      simp [N0178.output,hz] at hv
    have ev : (Expr.var kernelFlag).evalB W ξ=some 0 :=
      (evalB_var (by rw [hf0];exact h0W)).trans (congrArg some hf0)
    have eguard : (Cond.eq (.var kernelFlag) (.lit 0)).evalB W ξ=some true :=
      evalB_condEq ev (evalB_lit h0W)
    obtain ⟨hvsize,hvnonzero,hvnull⟩ := hsome v hv
    have haξ : ξ.vars N0186.vectorAddress=gs :=
      ((run_frame hkernelRun).1 _ (by decide)).trans ((hvars1 _ (by decide)).trans ha)
    have hoξ : ξ.vars N0188.resultRegister=os :=
      ((run_frame hkernelRun).1 _ (by decide)).trans ((hvars1 _ (by decide)).trans ho)
    obtain ⟨τ,hbody,hτ,hfound,hrecord,hin,hout⟩ := positiveBody_run p Sn W n M c gs os f ξ v hξ
      hpar.capacity hpar.divisor hpar.degree haξ hoξ hbase hv hvsize hvnonzero hvnull hf hfdeg hpos hwide
      hpad (by omega) hcg hvector hgos hof
    have rbranch : Run W (.ite (.eq (.var kernelFlag) (.lit 0)) positiveBody .skip) ξ τ (4+bodyCost p n) :=
      Run.ite_true eguard hbody
    have hrun : Run W program σ τ (splitCost p n M) := by
      apply (rinit.seq (hkernelRun.seq rbranch)).mono
      exact start_pay (kernelCost p n M) (bodyCost p n)
    exact ⟨τ,hrun,hτ,Or.inr ⟨hfound,v,hrecord⟩,hin.trans hinkernel,hout.trans houtkernel⟩

/-  A physical recorded output is a genuine monic positive proper divisor;
the witness is the actual shifted gcd associated with its executed index. -/
theorem recorded_factor (p N os n limit : ℕ) [Fact p.Prime]
    (f v : CPolynomial (ZMod p)) (σ : Env)
    (h : N0188.Recorded p N os n f v limit σ) :
    ∃g : CPolynomial (ZMod p),g.toPoly.Monic  ∧  0<g.natDegree  ∧  g.natDegree<n  ∧  g.toPoly ∣ f.toPoly  ∧ 
      ∀i<N,val (presentation p) canonical nq.WS σ (os+i)=g.toPoly.coeff (N-1-i) := by
  obtain ⟨c,hc,hpos,hlt,hcoeff⟩ := h
  let g := N0177.shiftedGcd f v c
  have he : g.toPoly=gcd f.toPoly (v.toPoly-C (c : ZMod p)) := by
    dsimp only [g,N0177.shiftedGcd]
    rw [N0192.gcd_output,CPolynomial.toPoly_sub,CPolynomial.C_toPoly]
  have hnonzero : (gcd f.toPoly (v.toPoly-C (c : ZMod p))) ≠ 0 := by
    intro hz
    simp only [hz,Polynomial.natDegree_zero] at hpos
    omega
  have hm : (gcd f.toPoly (v.toPoly-C (c : ZMod p))).Monic := by
    simpa only [normalize_gcd] using Polynomial.monic_normalize hnonzero
  refine ⟨g,by rw [he];exact hm,?_,?_,?_,?_⟩
  · rw [CPolynomial.natDegree_toPoly,he]
    exact hpos
  · rw [CPolynomial.natDegree_toPoly,he]
    exact hlt
  · rw [he]
    exact gcd_dvd_left _ _
  · intro i hi
    rw [he]
    exact hcoeff i hi

/-  Universal contextual execution bound for the full computed split source.
The runtime prime is charged by VALUE; the source never specializes to p. -/
theorem splitCost_bound (p n M : ℕ) :
    splitCost p n M ≤ 1000000000000000000*(p+1)*(p.size+1)*(M+n+2)^4 := by
  let T := M+n+2
  let U := (p+1)*(p.size+1)*T^4
  have hT : 1 ≤ T := by dsimp [T];omega
  have hP : 1 ≤ p.size+1 := by omega
  have hQ : 1 ≤ (p+1)*(p.size+1) := by nlinarith
  have hU : 1 ≤ U := by
    have hh : 0<U := by dsimp [U];positivity
    omega
  have hscale : T^4 ≤ U := Nat.le_mul_of_pos_left _ hQ
  have hlinear : n+2 ≤ U := (show n+2 ≤ T by dsimp [T];omega).trans
    ((Nat.le_self_pow (by decide) T).trans hscale)
  have hk := N0182.total_budget p n M
  have hkernel : kernelCost p n M ≤ 10000000000000000*U := by
    have hfactor : (p.size+1)*T^4 ≤ (p+1)*(p.size+1)*T^4 :=
      Nat.mul_le_mul_right (T^4) (Nat.le_mul_of_pos_left _ (by omega : 0<p+1))
    have hh := Nat.mul_le_mul_left 10000000000000000 hfactor
    exact hk.trans (by simpa only [U,T,Nat.mul_assoc] using hh)
  have hp3 : (n+2)^3 ≤ T^4 := (Nat.pow_le_pow_left (by dsimp [T];omega) 3).trans
    (Nat.pow_le_pow_right hT (by decide))
  have hs := N0188.scanCost_bound p (n+1)
  have hscan : N0188.scanCost p (n+1) ≤ 100000000000000*U := by
    have hm := Nat.mul_le_mul_left (100000000000000*(p+1)*(p.size+1)) hp3
    have hs' : N0188.scanCost p (n+1) ≤ 
        100000000000000*(p+1)*(p.size+1)*(n+2)^3 := by simpa only [Nat.add_assoc] using hs
    exact hs'.trans (by simpa only [U,Nat.mul_assoc] using hm)
  calc
    splitCost p n M ≤ 1000000000000000000*U := by
      unfold splitCost bodyCost
      nlinarith only [hkernel,hscan,hlinear,hU]
    _ = _ := by dsimp [U,T];ring

