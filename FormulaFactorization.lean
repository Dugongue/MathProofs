def subtractScaledShiftStep [Sub R] [Mul R]
    (q : Array R) (shift : Nat) (coeff : R) (next : Array R) (j : Nat) : Array R :=
  let idx := shift + j
  next.set! idx (next.getD idx (Zero.zero : R) - coeff * q.getD j (Zero.zero : R))

