theorem decode_inner_degree (a b : ℕ) (v : Fin ((a+1)*(b+1)) → ℚ) (i : ℕ) :
    ((image (decode a b v)).coeff i).natDegree ≤ b := by
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro j hj
  by_cases hi : i<a+1 <;> simp [decode_coefficient,hi,show ¬j<b+1 by omega]

