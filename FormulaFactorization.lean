  (fun c => (c.left,(c.head,c.right))) (fun p => ⟨p.1,p.2.1,p.2.2⟩) (by intro c;cases c;rfl)
def bankEncoding := codeEncoding.list
abbrev State := ℕ × List Code
def stateEncoding := BitEncoding.nat.prod bankEncoding
abbrev Row (n : ℕ) := N0377.Row n

theorem finite_pack : FFP codeEncoding tripleEncoding (fun c => (c.left,(c.head,c.right))) :=
  finite_view _ _ _ (fun _=>rfl)
theorem finite_unpack : FFP tripleEncoding codeEncoding (fun p => (⟨p.1,p.2.1,p.2.2⟩ : Code)) :=
  finite_view _ _ _ (by rintro ⟨l,h,r⟩;rfl)
theorem finite_left : FFP codeEncoding BitEncoding.nat Code.left :=
  finite_pack.comp (finite_fst BitEncoding.nat (BitEncoding.nat.prod BitEncoding.nat))
theorem finite_head : FFP codeEncoding BitEncoding.nat Code.head :=
  (finite_pack.comp (finite_snd BitEncoding.nat (BitEncoding.nat.prod BitEncoding.nat))).comp
    (finite_fst BitEncoding.nat BitEncoding.nat)
theorem finite_right : FFP codeEncoding BitEncoding.nat Code.right :=
  (finite_pack.comp (finite_snd BitEncoding.nat (BitEncoding.nat.prod BitEncoding.nat))).comp
    (finite_snd BitEncoding.nat BitEncoding.nat)

theorem finite_mod_four : FFP BitEncoding.nat BitEncoding.nat (fun n=>n%4) := by
  have hd : FFP (BitEncoding.nat.prod BitEncoding.nat) (BitEncoding.nat.prod BitEncoding.nat)
      (fun p : ℕ × ℕ => (p.1/p.2,p.1%p.2)) :=
    N0169.Computation.N0007.realized_nat_divMod
  exact (((finite_id _).pair (finite_const _ BitEncoding.nat 4)).comp hd).comp (finite_snd _ _)

theorem finite_div_four : FFP BitEncoding.nat BitEncoding.nat (fun n=>n/4) :=
  ((finite_id _).pair (finite_const _ BitEncoding.nat 4)).comp N0837.finite_nat_div

theorem finite_move (m : Internal.N0339.N0349.Move) : FFP codeEncoding codeEncoding (moveCode m) := by
  have hfour := finite_const codeEncoding BitEncoding.nat 4
  cases m with
  | stay => exact (finite_id _).congr (fun _=>rfl)
  | left =>
    have hl := finite_left.comp finite_div_four
    have hh := finite_left.comp finite_mod_four
    have hr := (finite_head.pair ((hfour.pair finite_right).comp finite_mul)).comp finite_addition
    exact ((hl.pair (hh.pair hr)).comp finite_unpack).congr (fun _=>rfl)
  | right =>
    have hl := (finite_head.pair ((hfour.pair finite_left).comp finite_mul)).comp finite_addition
    have hh := finite_right.comp finite_mod_four
    have hr := finite_right.comp finite_div_four
    exact ((hl.pair (hh.pair hr)).comp finite_unpack).congr (fun _=>rfl)

theorem finite_act (a : Internal.N0339.N0349.Action (Option Bool)) :
    FFP codeEncoding codeEncoding (actCode a) := by
  have hh : FFP codeEncoding BitEncoding.nat
      (fun c=>match a.write with | none=>c.head | some b=>symbol b) := by
    cases a.write with
    | none => exact finite_head
    | some b => exact finite_const _ _ (symbol b)
  have hc := (finite_left.pair (hh.pair finite_right)).comp finite_unpack
  exact (hc.comp (finite_move a.move)).congr (fun _=>rfl)

theorem finite_eq_const (n : ℕ) : FFP BitEncoding.nat BitEncoding.bool (fun m=>decide (m=n)) := by
  have h0 := finite_const BitEncoding.nat BitEncoding.nat n
  have hl := ((finite_id _).pair h0).comp finite_sub
  have hr := (h0.pair (finite_id _)).comp finite_sub
  exact (((hl.pair hr).comp finite_addition).comp finite_isZero).congr (fun m=>by
    change decide ((m-n)+(n-m)=0)=decide (m=n)
    have he : ((m-n)+(n-m)=0) ↔ m=n := by omega
    simp only [he])

theorem finite_and : FFP (BitEncoding.bool.prod BitEncoding.bool) BitEncoding.bool
    (fun p : Bool × Bool=>p.1 && p.2) := by
  have hp := (finite_fst BitEncoding.bool BitEncoding.bool).pair
    ((finite_snd BitEncoding.bool BitEncoding.bool).pair (finite_const _ BitEncoding.bool false))
  exact (hp.comp (finite_select BitEncoding.bool)).congr (by rintro ⟨a,b⟩;cases a <;> cases b <;> rfl)

theorem finite_fixedList {α β : Type} (ea : BitEncoding α) (eb : BitEncoding β)
    (fs : List (α→β)) (h : ∀ f∈fs,FFP ea eb f) :
    FFP ea eb.list (fun a=>fs.map (fun f=>f a)) := by
  induction fs with
  | nil => exact finite_const _ _ []
  | cons f fs ih =>
    have hf := h f (by simp)
    have ht := ih (fun g hg=>h g (by simp [hg]))
    exact ((hf.pair ht).comp (finite_cons eb)).congr (fun _=>rfl)

theorem finite_ofFn {α β : Type} (ea : BitEncoding α) (eb : BitEncoding β) (n : ℕ)
    (fs : Fin n→α→β) (h : ∀ i,FFP ea eb (fs i)) :
    FFP ea eb.list (fun a=>List.ofFn (fun i=>fs i a)) := by
  have hf := finite_fixedList ea eb (List.ofFn fs) (by
    intro f hf
    obtain ⟨i,rfl⟩ := List.mem_ofFn.mp hf
    exact h i)
  exact hf.congr (fun a=>by rw [List.map_ofFn];rfl)

def readCode (p : State) (i : ℕ) : Code := getAt p.2 i ⟨0,0,0⟩

theorem finite_readCode (i : ℕ) : FFP stateEncoding codeEncoding (fun p=>readCode p i) :=
  ((finite_snd BitEncoding.nat bankEncoding).pair (finite_const _ BitEncoding.nat i)).comp
    (finite_getAt codeEncoding ⟨0,0,0⟩)

def matchesTape {n : ℕ} (r : Row n) (is : List (Fin n)) (p : State) : Bool :=
  is.all (fun i=>decide ((readCode p i.val).head=symbol (r.heads i)))

theorem finite_matchesTape {n : ℕ} (r : Row n) (is : List (Fin n)) :
    FFP stateEncoding BitEncoding.bool (matchesTape r is) := by
  induction is with
  | nil => exact finite_const _ _ true
  | cons i is ih =>
    have hi := ((finite_readCode i.val).comp finite_head).comp (finite_eq_const (symbol (r.heads i)))
    exact ((hi.pair ih).comp finite_and).congr (fun _=>rfl)

def rowTest {n : ℕ} (r : Row n) (p : State) : Bool :=
  decide (p.1=r.state) && matchesTape r (List.ofFn id) p

theorem finite_matches {n : ℕ} (r : Row n) : FFP stateEncoding BitEncoding.bool (rowTest r) :=
  (((finite_fst BitEncoding.nat bankEncoding).comp (finite_eq_const r.state)).pair
    (finite_matchesTape r (List.ofFn id))).comp finite_and

def effect {n : ℕ} (e : N0380.Effect n) (p : State) : State :=
  match e with
  | none => p
  | some (q,acts) => (q,List.ofFn (fun i=>actCode (acts i) (readCode p i.val)))

theorem finite_effect {n : ℕ} (e : N0380.Effect n) :
    FFP stateEncoding stateEncoding (effect e) := by
  cases e with
  | none => exact (finite_id _).congr (fun _=>rfl)
  | some qa =>
    have hb := finite_ofFn stateEncoding codeEncoding n
      (fun i p=>actCode (qa.2 i) (readCode p i.val)) (fun i=>(finite_readCode i.val).comp (finite_act (qa.2 i)))
