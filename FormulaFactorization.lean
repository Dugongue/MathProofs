/-  Constructor-tag integer format: false tags ofNat, true tags negSucc.
The stored negative payload is its constructor index. -/
def int : Encoding ℤ where
  encode z := (prod bool nat).encode (match z with | .ofNat n => (false,n) | .negSucc n => (true,n))
  decode w := ((prod bool nat).decode w).map (fun p => if p.1 then Int.negSucc p.2 else Int.ofNat p.2)
  decode_encode z := by cases z <;> simp [(prod bool nat).decode_encode]

def rat : Encoding ℚ where
  encode q := (prod int nat).encode (q.num,q.den)
  decode w := ((prod int nat).decode w).map (fun p => mkRat p.1 p.2)
  decode_encode q := by simp only [(prod int nat).decode_encode,Option.map_some,Rat.mkRat_self]

def unaryNat : Encoding ℕ where
  encode n := List.replicate n true
  decode w := some w.length
  decode_encode n := by simp only [List.length_replicate]

@[simp] theorem nat_length (n : ℕ) : (nat.encode n).length = n.size := by
  simpa only [nat] using Nat.size_eq_bits_len n

@[simp] theorem int_ofNat (n : ℕ) : int.encode (Int.ofNat n) = [true,false,false] ++ n.bits := rfl
@[simp] theorem int_negSucc (n : ℕ) : int.encode (Int.negSucc n) = [true,true,false] ++ n.bits := rfl
@[simp] theorem rat_word (q : ℚ) : rat.encode q = frame (int.encode q.num) ++ q.den.bits := rfl
@[simp] theorem unaryNat_length (n : ℕ) : (unaryNat.encode n).length = n := List.length_replicate

end Encoding
