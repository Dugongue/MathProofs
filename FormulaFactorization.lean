/-! An actual fixed layout for arbitrary finite IMP syntax. Names and temporary
requirements are computed from the program itself; no user layout or correctness
certificate is assumed. This instantiates the existing compiler contract unchanged. -/
namespace Internal.N0339.N0197.N0257
open N0316.Imp N0316.N0049

def exprScalars : Expr → List String
  | .lit _ => []
  | .var x => [x]
  | .get _ e => exprScalars e
  | .bin _ e f => exprScalars e ++ exprScalars f

def exprArrays : Expr → List String
  | .lit _ | .var _ => []
  | .get a e => a :: exprArrays e
  | .bin _ e f => exprArrays e ++ exprArrays f

def exprDepth : Expr → ℕ
  | .lit _ | .var _ => 0
  | .get _ e => max 1 (exprDepth e)
  | .bin _ e f => max (exprDepth f) (exprDepth e + 1)

theorem expr_ok (L : Layout) (e : Expr) (d : ℕ)
    (hs : ∀ x ∈ exprScalars e, x ∈ L.scalars)
    (ha : ∀ a ∈ exprArrays e, a ∈ L.arrays)
    (hd : d + exprDepth e ≤ L.temps) : Expr.Ok L e d := by
  induction e generalizing d with
  | lit n => trivial
  | var x => exact hs x (by simp [exprScalars])
  | get a e ih =>
    change a ∈ L.arrays ∧ Expr.Ok L e d ∧ d < L.temps
    refine ⟨ha a (by simp [exprArrays]), ih d ?_ ?_ ?_, ?_⟩
    · exact hs
    · intro b hb; exact ha b (by simp [exprArrays,hb])
    · simp only [exprDepth] at hd; omega
    · simp only [exprDepth] at hd; omega
  | bin op e f ihe ihf =>
    change Expr.Ok L f d ∧ Expr.Ok L e (d+1) ∧ d < L.temps
    refine ⟨ihf d ?_ ?_ ?_, ihe (d+1) ?_ ?_ ?_, ?_⟩
    · intro x hx; exact hs x (by simp [exprScalars,hx])
    · intro a hx; exact ha a (by simp [exprArrays,hx])
    · simp only [exprDepth] at hd; omega
    · intro x hx; exact hs x (by simp [exprScalars,hx])
    · intro a hx; exact ha a (by simp [exprArrays,hx])
    · simp only [exprDepth] at hd; omega
    · simp only [exprDepth] at hd; omega

def scalars : Com → List String
  | .skip => []
  | .assign x e => x :: exprScalars e
  | .store _ i e => exprScalars i ++ exprScalars e
  | .seq c d => scalars c ++ scalars d
  | .ite b c d => exprScalars (condExpr b) ++ scalars c ++ scalars d
  | .while b c => exprScalars (condExpr b) ++ scalars c
  | .read x => [x]
  | .write e => exprScalars e

def arrays : Com → List String
  | .skip => []
  | .assign _ e => exprArrays e
  | .store a i e => a :: (exprArrays i ++ exprArrays e)
  | .seq c d => arrays c ++ arrays d
  | .ite b c d => exprArrays (condExpr b) ++ arrays c ++ arrays d
  | .while b c => exprArrays (condExpr b) ++ arrays c
  | .read _ => []
  | .write e => exprArrays e

def depth : Com → ℕ
  | .skip | .read _ => 0
  | .assign _ e => exprDepth e
  | .store _ i e => max 1 (max (exprDepth i) (exprDepth e+1))
  | .seq c d => max (depth c) (depth d)
  | .ite b c d => max (exprDepth (condExpr b)) (max (depth c) (depth d))
  | .while b c => max (exprDepth (condExpr b)) (depth c)
  | .write e => max 1 (exprDepth e)

theorem command_ok (L : Layout) (c : Com)
    (hs : ∀ x ∈ scalars c, x ∈ L.scalars)
    (ha : ∀ a ∈ arrays c, a ∈ L.arrays)
    (hd : depth c ≤ L.temps) : Com.Ok L c := by
  induction c with
  | skip => trivial
  | assign x e =>
    refine ⟨hs x (by simp [scalars]),expr_ok L e 0 ?_ ?_ ?_⟩
    · intro y hy;exact hs y (by simp [scalars,hy])
    · exact ha
    · simpa only [depth,Nat.zero_add] using hd
  | store a i e =>
    refine ⟨ha a (by simp [arrays]),expr_ok L i 0 ?_ ?_ ?_,expr_ok L e 1 ?_ ?_ ?_,?_⟩
    · intro x hx;exact hs x (by simp [scalars,hx])
    · intro b hb;exact ha b (by simp [arrays,hb])
    · simp only [depth] at hd;omega
    · intro x hx;exact hs x (by simp [scalars,hx])
    · intro b hb;exact ha b (by simp [arrays,hb])
    · simp only [depth] at hd;omega
    · simp only [depth] at hd;omega
  | seq c d ihc ihd =>
    refine ⟨ihc ?_ ?_ ?_,ihd ?_ ?_ ?_⟩
    · intro x hx;exact hs x (by simp [scalars,hx])
    · intro a ha';exact ha a (by simp [arrays,ha'])
    · simp only [depth] at hd;omega
    · intro x hx;exact hs x (by simp [scalars,hx])
    · intro a ha';exact ha a (by simp [arrays,ha'])
    · simp only [depth] at hd;omega
  | ite b c d ihc ihd =>
    refine ⟨expr_ok L (condExpr b) 0 ?_ ?_ ?_,ihc ?_ ?_ ?_,ihd ?_ ?_ ?_⟩
    · intro x hx;exact hs x (by simp [scalars,hx])
    · intro a hx;exact ha a (by simp [arrays,hx])
    · simp only [depth] at hd;omega
    · intro x hx;exact hs x (by simp [scalars,hx])
    · intro a hx;exact ha a (by simp [arrays,hx])
    · simp only [depth] at hd;omega
    · intro x hx;exact hs x (by simp [scalars,hx])
    · intro a hx;exact ha a (by simp [arrays,hx])
    · simp only [depth] at hd;omega
  | «while» b c ih =>
    refine ⟨expr_ok L (condExpr b) 0 ?_ ?_ ?_,ih ?_ ?_ ?_⟩
    · intro x hx;exact hs x (by simp [scalars,hx])
    · intro a hx;exact ha a (by simp [arrays,hx])
    · simp only [depth] at hd;omega
    · intro x hx;exact hs x (by simp [scalars,hx])
    · intro a hx;exact ha a (by simp [arrays,hx])
    · simp only [depth] at hd;omega
  | read x => exact hs x (by simp [scalars])
  | write e =>
    refine ⟨expr_ok L e 0 hs ha ?_,?_⟩
    · simp only [depth] at hd;omega
    · simp only [depth] at hd;omega

/-  All fields are actual finite data computed from the literal program. -/
def layout (c : Com) : Layout where
  scalars := scalars c
  arrays := arrays c
  temps := depth c+1

theorem program_ok (c : Com) : Com.Ok (layout c) c :=
  command_ok (layout c) c (fun _ h => h) (fun _ h => h) (Nat.le_succ _)

