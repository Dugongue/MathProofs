    (hP : P input w) :
    ∃ w' e, Q input w w' e ∧ ∃ p : (repeatUntilBlank i tm).RunPath input,
      p.head = wordsCfg input (some (.run tm.q₀)) w out ∧
      p.last = wordsCfg input (if w' i = [] then none else some (.run tm.q₀)) w' (out ++ e) ∧
