    (hwork : 5+4*(n+1)   ≤   c) (hcfit : c+M   ≤   gs)
    (hvector : N0178.bankSize n (n-1)+(n-1)   ≤   gs)
    (hvos : gs+(n+1)   ≤   os) (hof : os+(n+1)   ≤   Sn) :
    ∃τ,Run W positiveBody σ τ (8+10000*(n+2)+N0188.scanCost p (n+1))    ∧   
