    (hl : l ≤ N) (hk : k ≤ A.natDegree) (hi : i ≤ N*d) :
    N0090.ratWeight (N0625.numericWeight (A^l) (N0625.clusterInverse A B l).1
      (A.natDegree*l-1) (i+(k-1))) ≤ residueHeight A B N d := by
  unfold residueHeight
  apply Finset.le_sup_of_le (α := ℕ) (s := range (N+1)) (b := l) (mem_range.mpr (by omega))
  apply Finset.le_sup_of_le (α := ℕ) (s := range (A.natDegree+1)) (b := k) (mem_range.mpr (by omega))
  exact Finset.le_sup (α := ℕ) (s := range (N*d+1)) (b := i)
    (f := fun i => N0090.ratWeight (N0625.numericWeight (A^l)
      (N0625.clusterInverse A B l).1 (A.natDegree*l-1) (i+(k-1))))
    (mem_range.mpr (by omega))

def logBudget (N S : ℕ) : ℕ :=
  N*(2*N+7+N*(S+2)+(2+N0090.ratWeight 1)+6)+(2+N0090.ratWeight 0)

def expBudget (N S : ℕ) : ℕ :=
  N*(2*(N*N)+7+N*(S+2)+(2+N0090.ratWeight 1)+6)+(2+N0090.ratWeight 0)

def functionalBudget (M W S : ℕ) : ℕ :=
  (M+1)*(W+N0344.projectionCostBound M S+6)+(2+N0090.ratWeight 0)

def correctionBudget (N d W S : ℕ) : ℕ :=
  N*(2*N+7+functionalBudget (N*d) W (N*(S+2)+(2+N0090.ratWeight 1))+6)+(2+N0090.ratWeight 0)

