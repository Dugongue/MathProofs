    (packNumeric_input_bill D P hP hmP))

/-  Universal coefficient bound for every actual monic-Y bivariate divisor.
No factor degree, factor coefficient height or factor source is supplied. -/
theorem factor_coefficient_bound (D : ℕ) (P Q : NumericBivariate) (hP : Bounded D P)
    (hmP : (Polynomial.Bivariate.swap (N0365.polynomial P)).Monic)
    (hmQ : (Polynomial.Bivariate.swap (N0365.polynomial Q)).Monic)
    (hdiv : N0365.polynomial Q ∣ N0365.polynomial P) (t y : ℕ) :
    N0090.ratWeight ((Q.coeff t).coeff y) ≤ factorCoefficientBudget D (arrayBill D P) := by
  have hQ := bounded_divisor D P Q hP hmP hdiv
  by_cases ht : t ≤ D
  · rw [← packNumeric_coeff_at D Q hQ t y ht]
    exact packed_factor_coefficient_bound D P Q hP hmP hmQ hdiv _
  · have hz : Q.coeff t = 0 := by
      rw [CPolynomial.coeff_toPoly]
      exact Polynomial.coeff_eq_zero_of_natDegree_lt
        (by rw [← CPolynomial.natDegree_toPoly]; exact hQ.1.trans_lt (Nat.lt_of_not_ge ht))
    rw [hz,CPolynomial.coeff_zero]
