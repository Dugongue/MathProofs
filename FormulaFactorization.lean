    wire e a = e.encode a := rfl

variable {α β : Type} {encIn : α ↪ List Bool} {encOut : β ↪ List Bool}
  {f : α → β} {t s : α → ℕ}

theorem finite_time_certificate
    (h : ComputableInTimeAndSpace f encIn encOut t s)
    (ht : PolyBounded (fun a => (encIn a).length) t) :
    ∃ h : TM2ComputableInPolyTime encIn encOut f, ∀ stack, Finite (h.tm.Γ stack) := by
  obtain ⟨k, State, hfinite, tm, htm⟩ := h
  let : Fintype State := Fintype.ofFinite State
  have htime : PolyBounded (fun a => (encIn a).length)
      (fun a => (encIn a).length + (k + 1) * (t a + 1) + (encOut (f a)).length + 3) :=
    ((PolyBounded.self.add ((PolyBounded.const (k + 1)).mul (ht.add (.const 1)))).add
      (ht.mono fun a => (htm a).length_output_le)).add (.const 3)
  obtain ⟨p, hp⟩ := htime.exists_polynomial
  let target : TM2ComputableInPolyTime encIn encOut f := {
    tm := N0653.machine tm.q₀ tm.tr
    inputAlphabet := Equiv.refl Bool
    outputAlphabet := Equiv.refl Bool
    time := p
    outputsFun a := by
      simp only [Equiv.refl, List.map_id]
      have hrun := N0653.outputsInTime tm (htm a).1 (htm a).2.1
      exact ⟨hrun.toEvalsTo, hrun.steps_le_m.trans (hp a)⟩ }
  exact ⟨target, fun stack => inferInstance⟩

theorem finite_certificate (h : ComputableInPolyTime f encIn encOut) :
    ∃ h : TM2ComputableInPolyTime encIn encOut f, ∀ stack, Finite (h.tm.Γ stack) := by
  obtain ⟨t, s, ht, _, h⟩ := h
  exact finite_time_certificate h (.of_polynomiallyBounded _ ht)

/-  The actual native compiler preserves the complete chosen input/output words. -/
theorem native_to_realized {ea : Encoding α} {eb : Encoding β}
    (h : ComputableInPolyTime f (wire ea) (wire eb)) : Realized ea eb f :=
  finite_certificate h

/-  Actual finite-stack machines transfer to native machines on the SAME wires. -/
theorem realized_to_native {ea : Encoding α} {eb : Encoding β}
    (h : Realized ea eb f) : ComputableInPolyTime f (wire ea) (wire eb) := by
  obtain ⟨M, hM⟩ := h
  letI := hM
  have hf := M.computableInPolyTime_encList
    (encA := encFinEnum Bool) (encB := encFinEnum Bool)
    (wire ea).injective (wire eb).injective
  obtain ⟨hinput, _⟩ := trans_encList_polyTime (wire ea) (encFinEnum Bool)
  obtain ⟨_, houtput⟩ := trans_encList_polyTime (wire eb) (encFinEnum Bool)
  simpa only [Function.comp_def] using houtput.comp (hf.comp hinput)

theorem realized_iff_native {ea : Encoding α} {eb : Encoding β} :
    Realized ea eb f ↔ ComputableInPolyTime f (wire ea) (wire eb) :=
  ⟨realized_to_native, native_to_realized⟩

end
