    intro i hi
    exact (hshiftframe _ (by omega) (by omega)).trans (hfirst i hi)
  have hQdeg : (v.toPoly-C (c : ZMod p)).natDegree<N := by
    exact (Polynomial.natDegree_sub_le _ _).trans_lt (max_lt hvdeg (by simpa using hN))
  obtain ⟨ζ,R,hgcd,hζ,hgcdframe,hins,houts⟩ := gcd_run p Sn W N ps gs f.toPoly
    (v.toPoly-C (c : ZMod p)) ξ hξ hnξ hpξ hgξ hfit hps hgs hpf hgf hfirstξ hsecond
    (Or.inr hfdeg) (Or.inr hQdeg)
  have hG : G   ≠   0 := gcd_ne_zero_of_left hf.ne_zero
  obtain ⟨η,hdegree,hη,hdegη,hdegreeframe,hideg,hodeg⟩ := degree_run p Sn W N G R ζ hζ hG
  have hslots : Slots (presentation p) canonical q.WS Sn W η := hη.slots
  have hnW : n<W := by have := hs.slots_word;omega
  have hdW : G.natDegree<W := by
    have hcap : G.natDegree<N := hη.firstCapacity.resolve_left hG
    have := hs.slots_word
    omega
  have h1W : 1<W := by have := hs.slots_word;omega
  have hdegreeIndex : η.vars degreeRegister=n := by
    have hprefix := hshift.seq (hgcd.seq hdegree)
    exact ((run_frame hprefix).1 degreeRegister (by decide)).trans hd
  obtain ⟨τ,htest,heq⟩ := test_run W n G.natDegree η hdegreeIndex hdegη hnW hdW h1W
  have htestval : ∀s,val (presentation p) canonical q.WS τ s=val (presentation p) canonical q.WS η s := by
    intro s
    rw [heq,val_setVar (presentation p) canonical (by decide : trialGood   ≠   q.WS)]
  have hτ := Internal.N0339.N0550.Buffers.setVar (presentation p) q hη
    (by decide : trialGood∉regNames canonical) (by decide : trialGood   ≠   q.WS) (by decide : q.n   ≠   trialGood)
    (v:=if 0<G.natDegree    ∧    G.natDegree<n then 1 else 0)
  have hrun : Run W trialProgram σ τ (3000000000000*(p.size+1)*(N+1)^3) := by
    have hh := hshift.seq (hgcd.seq (hdegree.seq htest))
    apply hh.mono
    have hP : 1   ≤   p.size+1 := by omega
    have hlin : N+1   ≤   (p.size+1)*(N+1)^3 :=
      (Nat.le_self_pow (by decide) (N+1)).trans (Nat.le_mul_of_pos_left _ hP)
    have hu : 1   ≤   (p.size+1)*(N+1)^3 := by
      have hpositive : 0<(p.size+1)*(N+1)^3 := by positivity
      omega
    nlinarith only [hlin,hu]
  have hframe : ∀s<Sn,5+4*N   ≤   s → s   ≠   gs+(N-1) → 
      val (presentation p) canonical q.WS τ s=val (presentation p) canonical q.WS σ s := by
    intro s hss htail hne
    exact (htestval s).trans ((hdegreeframe s).trans ((hgcdframe s hss htail).trans (hshiftframe s hss hne)))
  refine ⟨τ,R,hrun,by simpa only [heq] using hτ,?_,?_,?_,?_,hframe,?_,?_,?_,?_,?_,?_⟩
  · simpa only [heq,vars_setVar,show trialDegree   ≠   trialGood by decide,ite_false] using hdegη
  · simp only [heq,vars_setVar,ite_true,G]
  · intro i hi
    exact (hframe _ (by omega) (by omega) (by omega)).trans (hfirst i hi)
  · intro i hi hne
    exact (hframe _ (by omega) (by omega) (by omega)).trans (hhigh i hi hne)
  · exact ((run_frame hrun).1 shiftRegister (by decide)).trans hc
  · exact ((run_frame hrun).1 degreeRegister (by decide)).trans hd
  · exact ((run_frame hrun).1 firstRegister (by decide)).trans hp
  · exact ((run_frame hrun).1 secondRegister (by decide)).trans hg
  · rw [heq]
    exact hideg.trans (hins.trans hin)
  · rw [heq]
    exact hodeg.trans (houts.trans hout)

abbrev resultRegister := Internal.N0339.N0501.outReg

def captureProgram : Com := .seq (.assign q.N (.var q.n))
  (Internal.N0339.N0502.copy q (.var resultRegister)
    Internal.N0339.N0501.firstExpr)

/-  An actual successful gcd is copied to a protected persistent result area. -/
theorem capture_run (p Sn W N os : ℕ) [Fact p.Prime]
    (P Q : (ZMod p)[X]) (σ : Env)
    (h : Internal.N0339.N0550.Buffers (presentation p) q Sn W N P Q σ)
    (ho : σ.vars resultRegister=os) (hos : 5+4*N   ≤   os) (hof : os+N   ≤   Sn) :
    ∃τ,Run W captureProgram σ τ (2000000000000*(p.size+1)*(N+1)^3)    ∧   
      Slots (presentation p) canonical q.WS Sn W τ    ∧   
      (∀i<N,val (presentation p) canonical q.WS τ (os+i)=P.coeff (N-1-i))    ∧   
      (∀s<Sn,(s<os    ∨    os+N   ≤   s) → val (presentation p) canonical q.WS τ s=val (presentation p) canonical q.WS σ s)    ∧   
      (∀x,x∉regNames canonical → x   ≠   q.N → x   ≠   q.j → τ.vars x=σ.vars x)    ∧   
      τ.inp=σ.inp    ∧    τ.out=σ.out := by
  let ξ := σ.setVar q.N N
  have hξ : Slots (presentation p) canonical q.WS Sn W ξ :=
    Slots.setVar (presentation p) canonical h.slots (by decide) (by decide) N
  have hN : ξ.vars q.N=N := by simp [ξ]
  have hn : ξ.vars q.n=N := by simpa only [ξ,vars_setVar,if_neg (by decide : q.n   ≠   q.N)] using h.capacity
  have hoξ : ξ.vars resultRegister=os := by simpa only [ξ,vars_setVar,if_neg (by decide : resultRegister   ≠   q.N)] using ho
  have hNW : N<W := by have := h.slots.slots_word;omega
  have hinit : Run W (.assign q.N (.var q.n)) σ ξ 2 :=
    Run.assign ((evalB_var (by rw [h.capacity];exact hNW)).trans (congrArg some h.capacity))
  have eout : (Expr.var resultRegister).evalB W ξ=some os :=
    (evalB_var (by rw [hoξ];have := h.slots.slots_word;omega)).trans (congrArg some hoξ)
  have efirst : Internal.N0339.N0501.firstExpr.evalB W ξ=some (5+N) := by
    apply Internal.N0339.N0501.evalB_plus
    · exact evalB_lit (by have := h.slots.slots_word;omega)
    · exact (evalB_var (by rw [hn];exact hNW)).trans (congrArg some hn)
    · have := h.slots.slots_word;omega
  obtain ⟨τ,hcopy,ht,hvalues,hframe,hvars,hj,harrays,hin,hout⟩ :=
    Internal.N0339.N0468.copy_run
      (Internal.N0339.N0461.fieldMacros (presentation p)) q
      Internal.N0339.N0501.names_valid [resultRegister,q.n]
      (by decide) (.var resultRegister) Internal.N0339.N0501.firstExpr
      (by simp [VarsIn]) (by simp [VarsIn,Internal.N0339.N0501.firstExpr,plus])
      hξ eout efirst hN hof (by have := h.fit;omega) (Or.inr (by omega))
  have hpay : 2+Internal.N0339.N0468.copyCost
      (Internal.N0339.N0461.fieldMacros (presentation p))
      (.var resultRegister) Internal.N0339.N0501.firstExpr N   ≤   
        2000000000000*(p.size+1)*(N+1)^3 := by
    have hh := N0192.caller_budget p N
    unfold Internal.N0339.N0501.cost at hh
    dsimp only [resultRegister] at ⊢
    omega
  refine ⟨τ,?_,ht,?_,?_,?_,hin,hout⟩
  · have hh := hinit.seq hcopy
    rw [←Internal.N0339.N0502.copy_eq (presentation p)] at hh
    exact hh.mono hpay
  · intro i hi
    rw [hvalues i hi,val_setVar (presentation p) canonical (by decide : q.N   ≠   q.WS)]
    exact h.first i hi
  · intro s hss houtside
    rw [hframe s hss houtside,val_setVar (presentation p) canonical (by decide : q.N   ≠   q.WS)]
  · intro x hx hxN hxj
    rw [hvars x hx hxj]
    simp only [ξ,vars_setVar,if_neg hxN]

def foundRegister : String := "P25.berlekamp.shift.found"

def recordProgram : Com := .seq captureProgram (.assign foundRegister (.lit 1))
def scanBody : Com := .seq trialProgram
  (.seq (.ite (.eq (.var trialGood) (.lit 1)) recordProgram .skip)
    (.assign shiftRegister (.add (.var shiftRegister) (.lit 1))))
def scanGuard : Cond := .lt (.var shiftRegister) (.var canonical.p)
def program : Com := .seq (.assign shiftRegister (.lit 0))
  (.seq (.assign foundRegister (.lit 0)) (.while scanGuard scanBody))

/-  Proof-only contents of the actually stored persistent result area. -/
def Recorded (p : ℕ) [Fact p.Prime] (N os n : ℕ)
    (f v : CPolynomial (ZMod p)) (limit : ℕ) (σ : Env) : Prop :=
  ∃c<limit,0<(gcd f.toPoly (v.toPoly-C (c : ZMod p))).natDegree    ∧   
    (gcd f.toPoly (v.toPoly-C (c : ZMod p))).natDegree<n    ∧   
    ∀i<N,val (presentation p) canonical q.WS σ (os+i)=
      (gcd f.toPoly (v.toPoly-C (c : ZMod p))).coeff (N-1-i)

/-  Actual finite-scan invariant, including failure completeness for the
already executed shifts and a physical coefficient buffer on success. -/
structure ScanState (p Sn W N ps gs os n : ℕ) [Fact p.Prime]
    (f v : CPolynomial (ZMod p)) (σ0 σ : Env) : Prop where
  slots : Slots (presentation p) canonical q.WS Sn W σ
  capacity : σ.vars q.n=N
  first_address : σ.vars firstRegister=ps
  second_address : σ.vars secondRegister=gs
  result_address : σ.vars resultRegister=os
  original_degree : σ.vars degreeRegister=n
  count : σ.vars shiftRegister   ≤   p
  flag : σ.vars foundRegister   ≤   1
  first : ∀i<N,val (presentation p) canonical q.WS σ (ps+i)=f.toPoly.coeff (N-1-i)
  high : ∀i<N,i   ≠   N-1 → val (presentation p) canonical q.WS σ (gs+i)=v.toPoly.coeff (N-1-i)
  none : σ.vars foundRegister=0 → ∀c<σ.vars shiftRegister,
    ¬(0<(gcd f.toPoly (v.toPoly-C (c : ZMod p))).natDegree    ∧   
      (gcd f.toPoly (v.toPoly-C (c : ZMod p))).natDegree<n)
  some : σ.vars foundRegister=1 → Recorded p N os n f v (σ.vars shiftRegister) σ
  inp : σ.inp=σ0.inp
  out : σ.out=σ0.out

private theorem step_pay (P : ℕ) (hP : 1 ≤ P) :
    3000000000000*P+(3000000000000*P+4) ≤ 7000000000000*P := by omega

private theorem capture_pay (P : ℕ) (hP : 1 ≤ P) :
    1+3+(2000000000000*P+2) ≤ 3000000000000*P := by omega

private theorem skip_pay (P : ℕ) (hP : 1 ≤ P) :
    1+3+1 ≤ 3000000000000*P := by omega

def stepBudget (p N : ℕ) : ℕ := 7000000000000*(p.size+1)*(N+1)^3

theorem scanBody_run (p Sn W N ps gs os n : ℕ) [Fact p.Prime]
    (f v : CPolynomial (ZMod p)) (σ0 σ : Env)
    (h : ScanState p Sn W N ps gs os n f v σ0 σ)
    (hc : σ.vars shiftRegister<p) (hN : 0<N) (hf : f.toPoly.Monic)
    (hfdeg : f.toPoly.natDegree<N) (hvdeg : v.toPoly.natDegree<N) (hv0 : v.toPoly.coeff 0=0)
    (hnN : n<N) (hfit : 5+4*N  ≤  Sn) (hps : 5+4*N  ≤  ps) (hgs : 5+4*N  ≤  gs)
    (hpf : ps+N  ≤  Sn) (hgf : gs+N  ≤  Sn) (hdisjoint : ps+N  ≤  gs)
    (hos : gs+N  ≤  os) (hof : os+N  ≤  Sn) :
    ∃τ,Run W scanBody σ τ (stepBudget p N)   ∧  
      ScanState p Sn W N ps gs os n f v σ0 τ   ∧  
      τ.vars shiftRegister=σ.vars shiftRegister+1 := by
  let c := σ.vars shiftRegister
  let G := gcd f.toPoly (v.toPoly-C (c : ZMod p))
  let P := (p.size+1)*(N+1)^3
  have hP : 1  ≤  P := by
    have hh : 0<P := by dsimp [P];positivity
    omega
  have hpW : p<W := by
    have hh:=h.slots.base.arithmetic_word
    change (p+1)^2<W at hh
    nlinarith
  have h1W : 1<W := by have := (Fact.out : p.Prime).two_le;omega
  obtain ⟨ξ,R,htrial,hξ,hdeg,hgood,hfirst,hhigh,hframe,hcount,hdegree,hfirstaddr,hsecondaddr,hin,hout⟩ :=
    trial_run p Sn W N ps gs n c f v σ h.slots h.capacity h.first_address h.second_address
      h.original_degree rfl hc hN hf hfdeg hvdeg hv0 hnN hfit hps hgs hpf hgf hdisjoint h.first h.high
  have hresultaddr : ξ.vars resultRegister=os :=
    ((run_frame htrial).1 resultRegister (by decide)).trans h.result_address
  let select := Com.ite (.eq (.var trialGood) (.lit 1)) recordProgram .skip
  have finish : ∀η,Run W select ξ η (3000000000000*P) →
      Slots (presentation p) canonical q.WS Sn W η →
      η.inp=ξ.inp → η.out=ξ.out →
      (∀i<N,val (presentation p) canonical q.WS η (ps+i)=f.toPoly.coeff (N-1-i)) →
      (∀i<N,i  ≠  N-1 → val (presentation p) canonical q.WS η (gs+i)=v.toPoly.coeff (N-1-i)) →
      η.vars foundRegister  ≤  1 →
      (η.vars foundRegister=0 → ∀j<c+1,
        ¬(0<(gcd f.toPoly (v.toPoly-C (j : ZMod p))).natDegree   ∧  
          (gcd f.toPoly (v.toPoly-C (j : ZMod p))).natDegree<n)) →
      (η.vars foundRegister=1 → Recorded p N os n f v (c+1) η) →
      ∃τ,Run W scanBody σ τ (stepBudget p N)   ∧  
        ScanState p Sn W N ps gs os n f v σ0 τ   ∧  
        τ.vars shiftRegister=σ.vars shiftRegister+1 := by
    intro η hselect hη hselectIn hselectOut hfirstη hhighη hflagη hnoneη hsomeη
    have hpre := htrial.seq hselect
    have hvars : ∀x,x∉scalarWrites (.seq trialProgram select) → η.vars x=σ.vars x := (run_frame hpre).1
    have hindex : η.vars shiftRegister=c := hvars _ (by decide)
    let τ := η.setVar shiftRegister (c+1)
    have einc : (Expr.add (.var shiftRegister) (.lit 1)).evalB W η=some (c+1) :=
      evalB_bin ((evalB_var (by rw [hindex];dsimp [c];omega)).trans (congrArg some hindex))
        (evalB_lit h1W) (by change c+1<W;dsimp [c];omega)
    have rinc : Run W (.assign shiftRegister (.add (.var shiftRegister) (.lit 1))) η τ 4 := Run.assign einc
    have hrun : Run W scanBody σ τ (stepBudget p N) := by
      have hh := htrial.seq (hselect.seq rinc)
      apply hh.mono
      simpa only [stepBudget,P,Nat.mul_assoc] using step_pay P hP
    have hτ : Slots (presentation p) canonical q.WS Sn W τ :=
      Slots.setVar (presentation p) canonical hη (by decide) (by decide) _
    have hval : ∀s,val (presentation p) canonical q.WS τ s=val (presentation p) canonical q.WS η s :=
      fun s=>val_setVar (presentation p) canonical (by decide) η _ s
    have hkeep : ∀x,x  ≠  shiftRegister → x∉scalarWrites (.seq trialProgram select) → τ.vars x=σ.vars x := by
      intro x hx hxw
      exact (show τ.vars x=η.vars x by simp only [τ,vars_setVar,if_neg hx]).trans (hvars x hxw)
    refine ⟨τ,hrun,?_,by simp [τ,c]⟩
    refine ⟨hτ,?_,?_,?_,?_,?_,by simp [τ,c];omega,?_,?_,?_,?_,?_,?_,?_⟩
    · exact (hkeep _ (by decide) (by decide)).trans h.capacity
    · exact (hkeep _ (by decide) (by decide)).trans h.first_address
    · exact (hkeep _ (by decide) (by decide)).trans h.second_address
    · exact (hkeep _ (by decide) (by decide)).trans h.result_address
    · exact (hkeep _ (by decide) (by decide)).trans h.original_degree
    · simpa only [τ,vars_setVar,if_neg (by decide : foundRegister  ≠  shiftRegister)] using hflagη
    · intro i hi;exact (hval _).trans (hfirstη i hi)
    · intro i hi hne;exact (hval _).trans (hhighη i hi hne)
    · intro hz j hj
      have hzη : η.vars foundRegister=0 := by simpa only [τ,vars_setVar,if_neg (by decide : foundRegister  ≠  shiftRegister)] using hz
      exact hnoneη hzη j (by simpa only [τ,vars_setVar,ite_true] using hj)
    · intro hz
      have hzη : η.vars foundRegister=1 := by simpa only [τ,vars_setVar,if_neg (by decide : foundRegister  ≠  shiftRegister)] using hz
      obtain ⟨j,hj,hpos,hlt,hcoeff⟩ := hsomeη hzη
      exact ⟨j,by simpa only [τ,vars_setVar,ite_true] using hj,hpos,hlt,fun i hi=>(hval _).trans (hcoeff i hi)⟩
    · exact hselectIn.trans (hin.trans h.inp)
    · exact hselectOut.trans (hout.trans h.out)
  by_cases hg : 0<G.natDegree   ∧   G.natDegree<n
  · have hgξ : ξ.vars trialGood=1 := by simpa only [G,if_pos hg] using hgood
    have etest : (Cond.eq (.var trialGood) (.lit 1)).evalB W ξ=some true := by
      have ev : (Expr.var trialGood).evalB W ξ=some 1 :=
        (evalB_var (by rw [hgξ];exact h1W)).trans (congrArg some hgξ)
      exact evalB_condEq ev (evalB_lit h1W)
    obtain ⟨χ,hcapture,hχ,hvalues,hcaptureframe,hcapturevars,hincap,houtcap⟩ :=
      capture_run p Sn W N os G R ξ hξ hresultaddr (by omega) hof
    let η := χ.setVar foundRegister 1
    have rfound : Run W (.assign foundRegister (.lit 1)) χ η 2 := Run.assign (evalB_lit h1W)
    have hselect : Run W select ξ η (3000000000000*P) := by
      have hh := Run.ite_true (d:=.skip) etest (hcapture.seq rfound)
      apply hh.mono
      simpa only [P,Nat.mul_assoc,Cond.size,Expr.size] using capture_pay P hP
    have hη : Slots (presentation p) canonical q.WS Sn W η :=
      Slots.setVar (presentation p) canonical hχ (by decide) (by decide) 1
    have hval : ∀s,val (presentation p) canonical q.WS η s=val (presentation p) canonical q.WS χ s :=
      fun s=>val_setVar (presentation p) canonical (by decide) χ 1 s
    apply finish η hselect hη (by simpa only [η,inp_setVar] using hincap) (by simpa only [η,out_setVar] using houtcap)
    · intro i hi
      exact (hval _).trans ((hcaptureframe _ (by omega) (Or.inl (by omega))).trans (hfirst i hi))
    · intro i hi hne
      exact (hval _).trans ((hcaptureframe _ (by omega) (Or.inl (by omega))).trans (hhigh i hi hne))
    · simp [η]
    · intro hz
      simp [η] at hz
    · intro _
      exact ⟨c,by omega,hg.1,hg.2,fun i hi=>(hval _).trans (hvalues i hi)⟩
  · have hgξ : ξ.vars trialGood=0 := by simpa only [G,if_neg hg] using hgood
    have etest : (Cond.eq (.var trialGood) (.lit 1)).evalB W ξ=some false := by
      have ev : (Expr.var trialGood).evalB W ξ=some 0 :=
        (evalB_var (by rw [hgξ];omega)).trans (congrArg some hgξ)
      exact evalB_condEq ev (evalB_lit h1W)
    have hselect : Run W select ξ ξ (3000000000000*P) := by
      exact (Run.ite_false etest Run.skip).mono (skip_pay P hP)
    have hfound : ξ.vars foundRegister=σ.vars foundRegister := (run_frame htrial).1 _ (by decide)
    apply finish ξ hselect hξ.slots rfl rfl hfirst hhigh
    · rw [hfound];exact h.flag
    · intro hz j hj
      by_cases hjc : j<c
      · exact h.none (hfound.symm.trans hz) j hjc
      · have he : j=c := by omega
        subst j
        exact hg
    · intro hz
      obtain ⟨j,hj,hpos,hlt,hcoeff⟩ := h.some (hfound.symm.trans hz)
      refine ⟨j,by dsimp [c];omega,hpos,hlt,?_⟩
      intro i hi
      exact (hframe _ (by omega) (by omega) (by omega)).trans (hcoeff i hi)

private theorem init_pay (C : ℕ) : 2+(2+C) ≤ 4+C := by omega

def scanCost (p N : ℕ) : ℕ := 4+((1+scanGuard.size+stepBudget p N)*p+1+scanGuard.size)

/-  The real finite p-shift loop, including every gcd, degree test, branch,
protected result copy and index update. No per-iteration execution is supplied. -/
theorem program_run (p Sn W N ps gs os n : ℕ) [Fact p.Prime]
    (f v : CPolynomial (ZMod p)) (σ : Env)
    (hs : Slots (presentation p) canonical q.WS Sn W σ)
    (hn : σ.vars q.n=N) (hp : σ.vars firstRegister=ps) (hg : σ.vars secondRegister=gs)
    (ho : σ.vars resultRegister=os) (hd : σ.vars degreeRegister=n)
    (hN : 0<N) (hf : f.toPoly.Monic) (hfdeg : f.toPoly.natDegree<N)
    (hvdeg : v.toPoly.natDegree<N) (hv0 : v.toPoly.coeff 0=0)
    (hnN : n<N) (hfit : 5+4*N ≤ Sn) (hps : 5+4*N ≤ ps) (hgs : 5+4*N ≤ gs)
    (hpf : ps+N ≤ Sn) (hgf : gs+N ≤ Sn) (hdisjoint : ps+N ≤ gs) (hos : gs+N ≤ os) (hof : os+N ≤ Sn)
    (hfirst : ∀i<N,val (presentation p) canonical q.WS σ (ps+i)=f.toPoly.coeff (N-1-i))
    (hhigh : ∀i<N,i ≠ N-1 → val (presentation p) canonical q.WS σ (gs+i)=v.toPoly.coeff (N-1-i)) :
    ∃τ,Run W program σ τ (scanCost p N)  ∧ 
      ScanState p Sn W N ps gs os n f v σ τ  ∧  τ.vars shiftRegister=p := by
  let σ1 := σ.setVar shiftRegister 0
  let σ2 := σ1.setVar foundRegister 0
  have h1 : Slots (presentation p) canonical q.WS Sn W σ1 :=
    Slots.setVar (presentation p) canonical hs (by decide) (by decide) _
  have h2 : Slots (presentation p) canonical q.WS Sn W σ2 :=
    Slots.setVar (presentation p) canonical h1 (by decide) (by decide) _
  have hval : ∀s,val (presentation p) canonical q.WS σ2 s=val (presentation p) canonical q.WS σ s := by
    intro s
    rw [val_setVar (presentation p) canonical (by decide : foundRegister ≠ q.WS),
      val_setVar (presentation p) canonical (by decide : shiftRegister ≠ q.WS)]
  let I := ScanState p Sn W N ps gs os n f v σ
  let V := fun ρ : Env=>p-ρ.vars shiftRegister
  have hI : I σ2 := by
    refine ⟨h2,?_,?_,?_,?_,?_,by simp [σ2,σ1],by simp [σ2],?_,?_,?_,?_,rfl,rfl⟩
    · simpa only [σ2,σ1,vars_setVar,if_neg (by decide : q.n ≠ foundRegister),if_neg (by decide : q.n ≠ shiftRegister)] using hn
    · simpa only [σ2,σ1,vars_setVar,if_neg (by decide : firstRegister ≠ foundRegister),if_neg (by decide : firstRegister ≠ shiftRegister)] using hp
    · simpa only [σ2,σ1,vars_setVar,if_neg (by decide : secondRegister ≠ foundRegister),if_neg (by decide : secondRegister ≠ shiftRegister)] using hg
    · simpa only [σ2,σ1,vars_setVar,if_neg (by decide : resultRegister ≠ foundRegister),if_neg (by decide : resultRegister ≠ shiftRegister)] using ho
    · simpa only [σ2,σ1,vars_setVar,if_neg (by decide : degreeRegister ≠ foundRegister),if_neg (by decide : degreeRegister ≠ shiftRegister)] using hd
    · intro i hi;exact (hval _).trans (hfirst i hi)
    · intro i hi hne;exact (hval _).trans (hhigh i hi hne)
    · intro _ j hj
      simpa [σ2,σ1,vars_setVar,show shiftRegister ≠ foundRegister by decide] using hj
