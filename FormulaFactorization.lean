theorem leadingCoeff_ne_zero_of_pos_size (p : DensePoly R) (hpos : 0 < p.size) :
    p.leadingCoeff ≠ (Zero.zero : R) := by
  rw [leadingCoeff_eq_coeff_last p hpos]
  exact coeff_last_ne_zero_of_pos_size p hpos

