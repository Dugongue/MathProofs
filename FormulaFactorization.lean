          .branch (fun s => s.selected.isNone)
            (.goto fun _ => .done) (.goto fun _ => .select)
    | .select => .branch (fun s => s.selected.getD false)
        (.load (fun s => { s with carry := false, left := none, right := none }) <|
          .goto fun _ => .add)
        (.goto fun _ => .shiftFirst)
    | .add =>
