/-  Decoding a valid word supplies injectivity, independently of machine proofs. -/
def wire {α : Type} (e : Encoding α) : α ↪ List Bool :=
  ⟨e.encode, fun a b h => by
    have hh := congrArg e.decode h
    simpa only [e.decode_encode, Option.some.injEq] using hh⟩

