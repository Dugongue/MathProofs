    Encoding.decode (binarySource f) = some (namedSource f) := Encoding.decode_encode _

 theorem namedSource_semantics {n : ℕ} {R : Type} [Semiring R]
    (c : ℚ →+* R) (env : ℕ → R) (f : N0090.Formula (Option (Fin n))) :
    N0090.eval₂ c env (namedSource f) = N0090.eval₂ c (fun v => env (variableNumber v)) f := by
  rw [namedSource, N0090.eval₂_substitute]
  rfl

