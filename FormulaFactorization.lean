  unfold widthBound
  have hp : 0 ≤ (Phi*M+3)*(n+1:ℝ)*Phi := by positivity
  nlinarith [mul_nonneg (sub_nonneg.mpr hpow) hp]

theorem actual_partial_quotient_width {n d} (B : IntBasis n d) (hB : FullRank B) (i j : Fin n)
    (hji : j < i) (left right js : List (Fin n)) (hsplit : List.finRange n=left++i::right)
    (hlen : js.length ≤ n) (Phi M : ℝ) (hPhi : (potential B:ℝ) ≤ Phi)
    (hM : ∀ r : Fin n, ‖N0297.rows B r‖^2 ≤ M) :
    |(computedCoefficient (fastReduceList (normalizeList B left) i js) i j:ℝ)|≤quotientBound n Phi M := by
