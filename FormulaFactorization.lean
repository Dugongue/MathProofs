  induction n with
  | zero => rfl
  | succ n ih => simp [List.replicate_succ,listCode,symbol,ih]

def halfCode (s : ListBlank (Option Bool)) : ℕ := s.liftOn listCode (by
  rintro a b ⟨n,rfl⟩
  change listCode a = listCode (a++List.replicate n (none:Option Bool))
  rw [listCode_append,listCode_blanks,mul_zero,add_zero])

