    (a : ι → ℚ) (A B : NumericPolynomial) (f : N0090.Formula (Option ι)) :
    N0090.bitCost (N0206.auxiliaryWeight (N0206.auxiliaryWeight w)) (perturbationSource a A B f) ≤
      perturbationBudget (A*B).natDegree (centerHeight a) (N0041.fiberHeight (A*B))
