  have hwin := MultiTapeNTM.RunPath.inWindow_of_space_le (p := p) (by simp [hhead]) hspace
  intro c hc
  rcases RelSeries.mem_snoc.mp hc with hc | rfl
  · obtain ⟨c₀, hc₀, rfl⟩ := RelSeries.exists_of_mem_map hc
    exact hwin c₀ (hqmem c₀ hc₀)
