@[simp]
lemma encInt_zero : encInt 0 = [false] := rfl

@[simp]
lemma encInt_natCast_add_one (n : ℕ) :
    encInt ((n : ℤ) + 1) = false :: true :: List.replicate n true :=
  rfl

@[simp]
lemma encInt_negSucc (n : ℕ) : encInt (Int.negSucc n) = true :: List.replicate n true :=
  rfl

