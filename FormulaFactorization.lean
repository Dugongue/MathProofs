      change (0 : DensePoly R).coeff k = (Zero.zero : R)
      exact coeff_eq_zero_of_size_le (0 : DensePoly R) (by simp)
    · have hzero : p.coeff (k - n) = (Zero.zero : R) := by
        exact coeff_eq_zero_of_size_le p (by omega)
      simp [hp, hk, hzero]
      change (0 : DensePoly R).coeff k = (Zero.zero : R)
      exact coeff_eq_zero_of_size_le (0 : DensePoly R) (by simp)
