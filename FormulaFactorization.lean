/- BEGIN CLEAN SOURCE Mathproof.AlgebraicComplexity.FormulaFactorization20261027.PITMachineAdapter SHA256 80bcd44b0b0a2d4a55235311bab80f0b62e6d66d2a7eb6900fbbedd118df06a8 -/
section P25Clean0763



/-! The frozen physical PIT premise supplies an actual total Boolean interface.
Bounded execution is a semantic observer, not a new polynomial-time simulator.
Every returned Boolean is tied to the same physical machine run and charged caller. -/
namespace Internal.N0339.N0197.N0373
open Internal.N0339.N0349

section Bounded
variable {ι Γ Q : Type} [Inhabited Γ] [Fintype ι] [Fintype Γ] [Fintype Q]

/-  Follow at most budget actual transitions, returning immediately at halt. -/
def boundedRun (M : Machine ι Γ Q) : ℕ → Config ι Γ Q → Config ι Γ Q
  | 0, c => c
  | fuel + 1, c => match step M c with
    | none => c
    | some d => boundedRun M fuel d

theorem boundedRun_halt (M : Machine ι Γ Q) (c : Config ι Γ Q)
    (hh : Halts M c) (fuel : ℕ) : boundedRun M fuel c = c := by
  change step M c = none at hh
  cases fuel with
  | zero => rfl
  | succ fuel => simp only [boundedRun, hh]

/-  A completed actual run determines the bounded observer at any sufficient budget. -/
theorem boundedRun_eq_of_runs {M : Machine ι Γ Q} {n : ℕ} {c d : Config ι Γ Q}
    (hr : Runs M n c d) (hh : Halts M d) (fuel : ℕ) (hn : n ≤ fuel) :
    boundedRun M fuel c = d := by
  induction hr generalizing fuel with
  | refl c => exact boundedRun_halt M c hh fuel
  | @cons n c d e hs hr ih =>
    cases fuel with
    | zero => omega
    | succ fuel => simpa only [boundedRun, hs] using ih hh fuel (by omega)

/-  The observer never fabricates a transition or silently pads after a halt. -/
theorem boundedRun_runs (M : Machine ι Γ Q) (fuel : ℕ) (c : Config ι Γ Q) :
    ∃ n ≤ fuel, Runs M n c (boundedRun M fuel c) := by
  induction fuel generalizing c with
  | zero => exact ⟨0, le_rfl, .refl c⟩
  | succ fuel ih =>
    cases hs : step M c with
    | none => exact ⟨0, Nat.zero_le _, by simpa only [boundedRun, hs] using Runs.refl (M := M) c⟩
    | some d =>
      obtain ⟨n,hn,hr⟩ := ih d
      exact ⟨n+1, Nat.succ_le_succ hn, by simpa only [boundedRun, hs] using Runs.cons hs hr⟩
end Bounded

/-  Exactly the per-machine content of FormulaPITInP, with its original bit budget. -/
def Spec (M : BinaryTransducer) (C k : ℕ) : Prop :=
  ∀ f : RationalFormula, ∃ (t : ℕ)
    (final : Config (Fin (M.workTapes+2)) (Option Bool) M.State) (b : Bool),
    t ≤ C * (inputSize f+1)^k ∧ Runs M.machine t (M.initial (N0090.encode f)) final ∧
      Halts M.machine final ∧ M.HasOutput final [b] ∧ (b = true ↔ polynomial f = 0)

/-  Read the canonical one-bit answer after the actual stated time budget.
This is executable bounded simulation; no choice of a correct answer is used. -/
def naturalAnswer (M : BinaryTransducer) (C k : ℕ) (f : RationalFormula) : Bool :=
  (readStack 1 ((boundedRun M.machine (C*(inputSize f+1)^k)
    (M.initial (N0090.encode f))).tapes M.outputTape)).headD false

theorem naturalAnswer_of_execution (M : BinaryTransducer) (C k : ℕ) (f : RationalFormula)
    (t : ℕ) (final : Config (Fin (M.workTapes+2)) (Option Bool) M.State) (b : Bool)
    (ht : t ≤ C*(inputSize f+1)^k) (hr : Runs M.machine t (M.initial (N0090.encode f)) final)
    (hh : Halts M.machine final) (ho : M.HasOutput final [b]) : naturalAnswer M C k f = b := by
  unfold naturalAnswer
  rw [boundedRun_eq_of_runs hr hh _ ht]
  rw [ho]
  change (readStack [b].length (stackTape [b])).headD false = b
  rw [readStack_stackTape]
  rfl

theorem naturalAnswer_correct (M : BinaryTransducer) (C k : ℕ) (h : Spec M C k)
    (f : RationalFormula) : naturalAnswer M C k f = true ↔ polynomial f = 0 := by
  obtain ⟨t,final,b,ht,hr,hh,ho,hb⟩ := h f
  rw [naturalAnswer_of_execution M C k f t final b ht hr hh ho]
  exact hb

/-  Every finite query is named exactly as in the existing physical-query adapter. -/
def finiteAnswer (M : BinaryTransducer) (C k : ℕ) (n : ℕ) (f : N0382.Formula n) : Bool :=
