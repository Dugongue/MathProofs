The proof requires no per-line fiber decomposition or exponent matching. -/
theorem split_powers (I J : Finset ι) (g : ι → R[X]) (e : ι → ℕ)
    (U V : R[X]) (hU : U.Monic) (hV : V.Monic)
    (hprimeI : ∀ i ∈ I, Prime (g i)) (hprimeJ : ∀ i ∈ J, Prime (g i))
    (hmonicI : ∀ i ∈ I, (g i).Monic) (hmonicJ : ∀ i ∈ J, (g i).Monic)
    (hprod : U*V = (∏ i ∈ I, (g i)^e i)*(∏ i ∈ J, (g i)^e i))
    (hnotU : ∀ i ∈ J, ¬ g i ∣ U) (hnotV : ∀ i ∈ I, ¬ g i ∣ V) :
    U = ∏ i ∈ I, (g i)^e i ∧ V = ∏ i ∈ J, (g i)^e i := by
  apply monic_split_of_dvd hU hV
    (Polynomial.monic_prod_of_monic I (fun i => (g i)^e i) (fun i hi => (hmonicI i hi).pow _))
    (Polynomial.monic_prod_of_monic J (fun i => (g i)^e i) (fun i hi => (hmonicJ i hi).pow _)) hprod
