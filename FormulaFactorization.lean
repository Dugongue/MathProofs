namespace N0202


def ga : String := "P15.GSS.gcd.a"
def gb : String := "P15.GSS.gcd.b"
def gr : String := "P15.GSS.gcd.r"
def remExpr : Expr := .bin .sub (.var ga) (.bin .mul (.bin .div (.var ga) (.var gb)) (.var gb))
def euclidStep : Com := .seq (.assign gr remExpr)
  (.seq (.assign ga (.var gb)) (.assign gb (.var gr)))
def euclidPair : Com := .seq euclidStep (.ite (.lt (.lit 0) (.var gb)) euclidStep .skip)
def gcdIMP : Com := .while (.lt (.lit 0) (.var gb)) euclidPair

/-  Every two Euclidean remainders halve the second operand. -/
theorem double_remainder_half (a b : ℕ) (hb : 0 < b) (hr : 0 < a % b) :
    b % (a % b) ≤ b / 2 := by
  have hrb := Nat.mod_lt a hb
  by_cases h : a % b ≤ b / 2
  · exact (Nat.mod_lt b hr).le.trans h
  · have he : b % (a % b) = b - a % b := by
      rw [Nat.mod_eq_sub_mod hrb.le, Nat.mod_eq_of_lt (by omega)]
    rw [he]
    omega

/-  A positive natural number loses a bit when halved. -/
theorem size_half_lt {b : ℕ} (hb : 0 < b) : Nat.size (b / 2) < Nat.size b := by
  induction b using Nat.binaryRec' with
  | zero => omega
  | bit z n hn ih =>
    have hne : Nat.bit z n ≠ 0 := Nat.bit_ne_zero_iff.mpr hn
    rw [Nat.size_bit hne]
    have hdiv : Nat.bit z n / 2 = n := by
      cases z <;> simp [Nat.bit_val, Nat.add_div]
    rw [hdiv]
    omega

/-  Literal remainder/swap execution, retaining the entire nonlocal workspace. -/
theorem euclidStep_run {W : ℕ} {σ : Env}
    (ha : σ.vars ga < W) (hb : σ.vars gb < W) :
    ∃ τ, Run W euclidStep σ τ 12 ∧
      τ.vars ga = σ.vars gb ∧ τ.vars gb = σ.vars ga % σ.vars gb ∧
      (∀ x, x ≠ ga → x ≠ gb → x ≠ gr → τ.vars x = σ.vars x) ∧
      τ.arrs = σ.arrs ∧ τ.inp = σ.inp ∧ τ.out = σ.out := by
  let a := σ.vars ga
  let b := σ.vars gb
  let r := a % b
  have hq : a / b < W := (Nat.div_le_self a b).trans_lt ha
  have hm : (a / b) * b < W := (Nat.div_mul_le_self a b).trans_lt ha
  have hr : r < W := (Nat.mod_le a b).trans_lt ha
  have er : remExpr.evalB W σ = some r := by
    rw [remExpr, evalB_bin (op := .sub) (evalB_var ha)
      (evalB_bin (op := .mul) (evalB_bin (op := .div) (evalB_var ha) (evalB_var hb) hq) (evalB_var hb) hm)
      (by simpa [Bop.apply, ← Nat.mod_eq_sub_div_mul] using hr)]
    simp only [Bop.apply, ← Nat.mod_eq_sub_div_mul]
    rfl
  let σ1 := σ.setVar gr r
  let σ2 := σ1.setVar ga b
  have eb : (Expr.var gb).evalB W σ1 = some b := by
    apply evalB_var
    simpa [σ1, Env.setVar, gb, gr] using hb
  have er' : (Expr.var gr).evalB W σ2 = some r := by
    apply evalB_var
    simpa [σ2, σ1, Env.setVar, ga, gr] using hr
  refine ⟨σ2.setVar gb r, ?_, ?_, ?_, ?_, rfl, rfl, rfl⟩
  · exact (Run.assign er).seq ((Run.assign eb).seq (Run.assign er'))
  · simp [σ2, σ1, Env.setVar, ga, gb, gr, b]
  · simp [σ2, σ1, Env.setVar, ga, gb, gr, r, a, b]
  · intro x hxa hxb hxr
    simp [σ2, σ1, Env.setVar, hxa, hxb, hxr]


/-  Machine Euclid preserves the exact Nat.gcd used in coprimeRefine and killCoeffs. -/
theorem remainder_gcd (a b : ℕ) : Nat.gcd b (a % b) = Nat.gcd a b := by
  rw [Nat.gcd_comm b (a % b), ← Nat.gcd_rec b a, Nat.gcd_comm b a]

