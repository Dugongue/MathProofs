  have hp : 0 < (prefixVolume B (j.val+1) : ℝ) := by exact_mod_cast prefixVolume_pos B hB (j.val+1)
  have hl : -(prefixVolume B (j.val+1) : ℝ) ≤ 2*(mixedNumerator B i j : ℝ) := by exact_mod_cast hc.1
  have hu : 2*(mixedNumerator B i j : ℝ) < (prefixVolume B (j.val+1) : ℝ) := by exact_mod_cast hc.2
  rw [ratio,abs_le]
  constructor
  · apply (le_div_iff₀ hp).mpr
    nlinarith
  · apply (div_le_iff₀ hp).mpr
    nlinarith

theorem prefix_one_le {n d} (B : IntBasis n d) (hB : FullRank B) (k : ℕ) :
    1 ≤ prefixVolume B k := by have := prefixVolume_pos B hB k;omega

theorem prefix_le_potential {n d} (B : IntBasis n d) (hB : FullRank B) (k : ℕ) (hk : k ≤ n) :
    prefixVolume B k ≤ potential B := by
  have hall (s : Finset ℕ) : (1:ℤ) ≤ ∏ a ∈ s, prefixVolume B a := by
    induction s using Finset.induction_on with
    | empty => simp
    | @insert a s ha ih =>
      rw [Finset.prod_insert ha]
      have hp := prefix_one_le B hB a
      nlinarith [mul_nonneg (by omega : 0 ≤ prefixVolume B a-1) (by omega : 0 ≤ (∏ x ∈ s, prefixVolume B x)-1)]
  have hmem : k ∈ Finset.range (n+1) := Finset.mem_range.mpr (by omega)
  have hr := hall ((Finset.range (n+1)).erase k)
  have hp := prefix_one_le B hB k
  unfold potential
  rw [← Finset.prod_erase_mul _ _ hmem]
  nlinarith [mul_nonneg (by omega : 0 ≤ prefixVolume B k)
    (by omega : 0 ≤ (∏ x ∈ (Finset.range (n+1)).erase k, prefixVolume B x)-1)]

theorem gsSquare_bounds {n d} (B : IntBasis n d) (hB : FullRank B) (j : Fin n) :
    gsSquare B j ≤ (potential B : ℝ) ∧ 1 ≤ (potential B : ℝ)*gsSquare B j := by
  have hstep := N0297.prefix_step B j
  change (prefixVolume B (j.val+1) : ℝ)=(prefixVolume B j.val : ℝ)*gsSquare B j at hstep
  have hprev : (1:ℝ) ≤ prefixVolume B j.val := by exact_mod_cast prefix_one_le B hB j.val
  have hnext : (1:ℝ) ≤ prefixVolume B (j.val+1) := by exact_mod_cast prefix_one_le B hB (j.val+1)
  have hprevle : (prefixVolume B j.val : ℝ) ≤ potential B := by
    exact_mod_cast prefix_le_potential B hB j.val (by omega)
  have hnextle : (prefixVolume B (j.val+1) : ℝ) ≤ potential B := by
    exact_mod_cast prefix_le_potential B hB (j.val+1) (by omega)
  have hnonneg : 0 ≤ gsSquare B j := sq_nonneg _
  constructor
  · nlinarith [mul_nonneg (by linarith : 0 ≤ (prefixVolume B j.val : ℝ)-1) hnonneg]
  · nlinarith [mul_nonneg (by linarith : 0 ≤ (potential B : ℝ)-prefixVolume B j.val) hnonneg]

/-  Exact norm decomposition of each literal row in its actual orthogonal GS frame. -/
theorem row_norm_decomposition {n d} (B : IntBasis n d) (hB : FullRank B) (i : Fin n) :
    ‖N0297.rows B i‖^2 = gsSquare B i+
      ∑ j ∈ Finset.Iio i, (ratio B i j)^2*gsSquare B j := by
  let b := N0297.rows B
  have hd : b i=gramSchmidt ℝ b i+∑ j∈Finset.Iio i,
      (⟪gramSchmidt ℝ b j,b i⟫_ℝ/‖gramSchmidt ℝ b j‖^2) • gramSchmidt ℝ b j := by
    rw [N0298.gramSchmidt_real_def]
    abel
  have hself : ⟪gramSchmidt ℝ b i,b i⟫_ℝ=gsSquare B i := by
    conv_lhs => rw [hd]
    rw [inner_add_right,inner_sum]
    have hz : (∑ j ∈ Finset.Iio i, ⟪gramSchmidt ℝ b i,
        (⟪gramSchmidt ℝ b j,b i⟫_ℝ/‖gramSchmidt ℝ b j‖^2) • gramSchmidt ℝ b j⟫_ℝ)=0 := by
      apply Finset.sum_eq_zero
      intro j hj
      rw [inner_smul_right,gramSchmidt_orthogonal ℝ b (Fin.ne_of_gt (Finset.mem_Iio.mp hj)),mul_zero]
    rw [hz,add_zero,real_inner_self_eq_norm_sq]
    rfl
  have hprod (j : Fin n) (hji : j < i) :
      ⟪gramSchmidt ℝ b j,b i⟫_ℝ=ratio B i j*gsSquare B j := by
    have hn : gsSquare B j ≠ 0 := by
      have hs := (gsSquare_bounds B hB j).2
      intro hz
      rw [hz,mul_zero] at hs
      norm_num at hs
    rw [ratio_eq_coefficient B hB i j hji]
    dsimp [N0297.coefficient,gsSquare,b] at *
    exact (div_mul_cancel₀ _ hn).symm
  calc
    _ = ⟪b i,b i⟫_ℝ := (real_inner_self_eq_norm_sq _).symm
    _ = ⟪gramSchmidt ℝ b i,b i⟫_ℝ+
      ∑ j ∈ Finset.Iio i, (⟪gramSchmidt ℝ b j,b i⟫_ℝ/‖gramSchmidt ℝ b j‖^2)*⟪gramSchmidt ℝ b j,b i⟫_ℝ := by
      conv_lhs => lhs;rw [hd]
      rw [inner_add_left,sum_inner]
      simp only [real_inner_smul_left]
    _ = _ := by
      rw [hself]
      congr 1
      apply Finset.sum_congr rfl
      intro j hj
      have hji := Finset.mem_Iio.mp hj
      rw [hprod j hji]
      change (ratio B i j*gsSquare B j/gsSquare B j)*(ratio B i j*gsSquare B j)=_
      have hn : gsSquare B j ≠ 0 := by
        have hs := (gsSquare_bounds B hB j).2
        intro hz;rw [hz,mul_zero] at hs;norm_num at hs
      rw [mul_div_cancel_right₀ _ hn]
      ring

/-  Every fully reduced row is bounded by the actual input Gram potential. -/
theorem reduced_row_norm {n d} (B : IntBasis n d) (hB : FullRank B) (i : Fin n)
    (hs : ∀ j : Fin n, j < i → CoefficientReduced B i j) :
    ‖N0297.rows B i‖^2 ≤ (n+1:ℝ)*(potential B : ℝ) := by
  have hPhi : (0:ℝ) ≤ potential B := by exact_mod_cast (potential_pos B hB).le
  rw [row_norm_decomposition B hB i]
  calc
    _ ≤ (potential B : ℝ)+∑ _j ∈ Finset.Iio i, (potential B : ℝ) := by
      apply add_le_add (gsSquare_bounds B hB i).1
      apply Finset.sum_le_sum
      intro j hj
      have hb := ratio_bound B hB i j (hs j (Finset.mem_Iio.mp hj))
      have hsq : (ratio B i j)^2 ≤ 1 := by have := abs_le.mp hb;nlinarith [sq_abs (ratio B i j)]
      have hg : 0 ≤ gsSquare B j := sq_nonneg _
      exact (mul_le_mul_of_nonneg_right hsq hg).trans (by simpa using (gsSquare_bounds B hB j).1)
    _ = (i.val+1:ℝ)*(potential B : ℝ) := by rw [Finset.sum_const,Fin.card_Iio,nsmul_eq_mul];ring
    _ ≤ _ := mul_le_mul_of_nonneg_right (by exact_mod_cast Nat.add_le_add_right (Nat.le_of_lt i.isLt) 1) hPhi

theorem normalized_row_norm {n d} (B : IntBasis n d) (hB : FullRank B) (i : Fin n) :
    ‖N0297.rows (normalize B) i‖^2 ≤ (n+1:ℝ)*(potential B : ℝ) := by
  have h := reduced_row_norm (normalize B) (normalizeList_fullRank B _ hB) i
    (fun j hj => normalize_sizeReduced B hB i j hj)
  rw [N0284.normalize,normalizeList_potential] at h
  exact h

/-  Exact linearity in the changed target row, including all lower coefficients. -/
theorem mixed_target_shear {n d} (B : IntBasis n d) {i j k : Fin n}
    (hki : k < i) (q : ℤ) : mixedNumerator (shear B i j q) i k =
      mixedNumerator B i k-q*mixedNumerator B j k := by
  have hout : k.val+1 ≤ i.val := by have := hki;omega
  have hrow : (fun r : PrefixIndex n (k.val+1) => (N0296.gram (shear B i j q)) i r.val)=
      (fun r : PrefixIndex n (k.val+1) => (N0296.gram B) i r.val)+
      (-q) • (fun r : PrefixIndex n (k.val+1) => (N0296.gram B) j r.val) := by
    funext r
    have hr : r.val ≠ i := by
      intro he;have hv := congrArg Fin.val he;have := r.property;omega
    simp [N0296.gram,Matrix.mul_apply,Matrix.transpose_apply,shear,hr,
      add_mul,neg_mul,Finset.sum_add_distrib,Finset.sum_neg_distrib,Finset.mul_sum,mul_assoc,sub_eq_add_neg]
  unfold mixedNumerator
  dsimp only
  rw [prefix_shear_outside B i j q hout,hrow,Matrix.det_updateRow_add,Matrix.det_updateRow_smul]
  ring

theorem ratio_target_shear {n d} (B : IntBasis n d) {i j k : Fin n}
    (hki : k < i) (q : ℤ) : ratio (shear B i j q) i k=ratio B i k-(q:ℝ)*ratio B j k := by
  have hout : k.val+1 ≤ i.val := by have := hki;omega
  have hp : prefixVolume (shear B i j q) (k.val+1)=prefixVolume B (k.val+1) := by
    unfold prefixVolume;rw [prefix_shear_outside B i j q hout]
  rw [ratio,hp,mixed_target_shear B hki]
  push_cast
  unfold ratio
  ring

theorem nearest_ratio_error {n d} (B : IntBasis n d) (hB : FullRank B) (i j : Fin n) :
    |ratio B i j-(computedCoefficient B i j:ℝ)|≤(1/2:ℝ) := by
  have hp : 0 < (prefixVolume B (j.val+1) : ℝ) := by exact_mod_cast prefixVolume_pos B hB _
  have hr := computedCoefficient_remainder B i j (prefixVolume_pos B hB _)
  have hl : -(prefixVolume B (j.val+1):ℝ)≤
      2*((mixedNumerator B i j:ℝ)-(computedCoefficient B i j:ℝ)*prefixVolume B (j.val+1)) := by exact_mod_cast hr.1
  have hu : 2*((mixedNumerator B i j:ℝ)-(computedCoefficient B i j:ℝ)*prefixVolume B (j.val+1))<
      (prefixVolume B (j.val+1):ℝ) := by exact_mod_cast hr.2
  have he : ratio B i j-(computedCoefficient B i j:ℝ)=
      ((mixedNumerator B i j:ℝ)-(computedCoefficient B i j:ℝ)*prefixVolume B (j.val+1))/prefixVolume B (j.val+1) := by
    unfold ratio;field_simp [ne_of_gt hp]
  rw [he,abs_div,abs_of_pos hp]
  apply (div_le_iff₀ hp).mpr
  rw [abs_le]
  constructor <;> nlinarith

theorem coefficient_abs_le {n d} (B : IntBasis n d) (hB : FullRank B) (i j : Fin n) :
    |(computedCoefficient B i j:ℝ)|≤|ratio B i j|+(1/2:ℝ) := by
  calc
    _ = |ratio B i j-(ratio B i j-(computedCoefficient B i j:ℝ))| := by congr 1;ring
    _ ≤ |ratio B i j|+|ratio B i j-(computedCoefficient B i j:ℝ)| := abs_sub_le_sum _ _
    _ ≤ _ := add_le_add le_rfl (nearest_ratio_error B hB i j)

def PrefixReduced {n d} (B : IntBasis n d) (i : Fin n) : Prop :=
  ∀ r : Fin n, r < i → ∀ k : Fin n, k < r → CoefficientReduced B r k

theorem shear_prefix_reduced {n d} (B : IntBasis n d) {i j : Fin n} (hji : j < i)
    (hs : PrefixReduced B i) : PrefixReduced (computedShear B i j) i := by
  intro r hri k hkr
  unfold CoefficientReduced computedShear
  rw [all_prefix_gram_invariant B hji,N0280.mixed_later_shear B hkr hri]
  exact hs r hri k hkr

/-  Each actual shear amplifies all target coefficients by at most two when
previous rows have been genuinely size-reduced. -/
theorem shear_ratio_growth {n d} (B : IntBasis n d) {i j : Fin n} (hji : j < i)
    (hB : FullRank B) (hs : PrefixReduced B i) (A : ℝ) (hA : 1 ≤ A)
    (hb : ∀ k : Fin n, k < i → |ratio B i k|≤A) :
    ∀ k : Fin n, k < i → |ratio (computedShear B i j) i k|≤2*A := by
  intro k hki
  have hq : |(computedCoefficient B i j:ℝ)|≤A+(1/2:ℝ) :=
    (coefficient_abs_le B hB i j).trans (add_le_add (hb j hji) le_rfl)
  rcases lt_trichotomy k j with hkj|he|hjk
  · have hjkbound := ratio_bound B hB j k (hs j hji k hkj)
    rw [computedShear,ratio_target_shear B hki]
    calc
      _ ≤ |ratio B i k|+|(computedCoefficient B i j:ℝ)*ratio B j k| := abs_sub_le_sum _ _
      _ = |ratio B i k|+|(computedCoefficient B i j:ℝ)| * |ratio B j k| := by rw [abs_mul]
      _ ≤ A+(A+(1/2:ℝ))*(1/2:ℝ) := by
        exact add_le_add (hb k hki) (mul_le_mul hq hjkbound (abs_nonneg _) (by linarith))
      _ ≤ _ := by linarith
  · subst k
    have hc := ratio_bound (computedShear B i j)
      (N0280.computedShear_fullRank B hji hB) i j
      (computedShear_sets B hji hB)
    exact hc.trans (by linarith)
  · have he : ratio (computedShear B i j) i k=ratio B i k := by
      unfold ratio computedShear
      rw [all_prefix_gram_invariant B hji,N0280.mixed_lower_shear B hki hjk]
    rw [he]
    exact (hb k hki).trans (by linarith)

theorem reduceList_prefix_reduced {n d} (B : IntBasis n d) (i : Fin n) (js : List (Fin n))
    (hs : PrefixReduced B i) : PrefixReduced (reduceList B i js) i := by
  induction js generalizing B with
  | nil => exact hs
  | cons j js ih =>
    simp only [reduceList,List.foldl_cons]
    split_ifs with hji
    · exact ih _ (shear_prefix_reduced B hji hs)
    · exact ih B hs

/-  Uniform 2^length amplification along EVERY actual partial earlier-row fold. -/
theorem reduceList_ratio_growth {n d} (B : IntBasis n d) (i : Fin n) (js : List (Fin n))
    (hB : FullRank B) (hs : PrefixReduced B i) (A : ℝ) (hA : 1 ≤ A)
    (hb : ∀ k : Fin n, k < i → |ratio B i k|≤A) :
    ∀ k : Fin n, k < i → |ratio (reduceList B i js) i k|≤(2:ℝ)^js.length*A := by
  induction js generalizing B A with
  | nil => simpa only [reduceList,List.foldl_nil,List.length_nil,pow_zero,one_mul] using hb
  | cons j js ih =>
    simp only [reduceList,List.foldl_cons,List.length_cons]
    split_ifs with hji
    · change ∀ k : Fin n, k < i → |ratio (reduceList (computedShear B i j) i js) i k|≤(2:ℝ)^(js.length+1)*A
      have hh := ih _ (N0280.computedShear_fullRank B hji hB)
        (shear_prefix_reduced B hji hs) (2*A) (by linarith) (shear_ratio_growth B hji hB hs A hA hb)
      intro k hk
      simpa only [pow_succ,mul_assoc] using hh k hk
    · change ∀ k : Fin n, k < i → |ratio (reduceList B i js) i k|≤(2:ℝ)^(js.length+1)*A
      intro k hk
      have hh := ih B hB hs A hA hb k hk
      have hp : 0 ≤ (2:ℝ)^js.length*A := by positivity
      rw [pow_succ]
      nlinarith

def TargetWidth {n d} (B : IntBasis n d) (i : Fin n) (M : ℝ) : Prop :=
  ∀ c : Fin d, |(B i c:ℝ)|≤M

def EarlierWidth {n d} (B : IntBasis n d) (i : Fin n) (J : ℝ) : Prop :=
  ∀ r : Fin n, r < i → ∀ c : Fin d, |(B r c:ℝ)|≤J

theorem shear_target_width {n d} (B : IntBasis n d) {i j : Fin n} (hji : j < i)
    (hB : FullRank B) (A M J : ℝ) (hA : 1 ≤ A) (hJ : 0 ≤ J)
    (hb : ∀ k : Fin n, k < i → |ratio B i k|≤A)
    (ht : TargetWidth B i M) (he : EarlierWidth B i J) :
    TargetWidth (computedShear B i j) i (M+(A+1)*J) := by
  have hq : |(computedCoefficient B i j:ℝ)|≤A+1 :=
    ((coefficient_abs_le B hB i j).trans (add_le_add (hb j hji) le_rfl)).trans (by linarith)
  intro c
  simp [computedShear,shear,Int.cast_sub,Int.cast_mul]
  calc
    _ ≤ |(B i c:ℝ)|+|(computedCoefficient B i j:ℝ)*(B j c:ℝ)| := abs_sub_le_sum _ _
    _ = |(B i c:ℝ)|+|(computedCoefficient B i j:ℝ)| * |(B j c:ℝ)| := by rw [abs_mul]
    _ ≤ _ := add_le_add (ht c) (mul_le_mul hq (he j hji c) (abs_nonneg _) (by linarith))

theorem shear_earlier_width {n d} (B : IntBasis n d) {i j : Fin n} (J : ℝ)
    (he : EarlierWidth B i J) : EarlierWidth (computedShear B i j) i J := by
  intro r hri c
  have hr : r ≠ i := Fin.ne_of_lt hri
  simpa only [computedShear,shear,if_neg hr] using he r hri c

/-  Literal coordinate growth through every finite partial inner reduction.
The bound is geometric in the number of actual candidate shears, not in fuel. -/
theorem reduceList_target_width {n d} (B : IntBasis n d) (i : Fin n) (js : List (Fin n))
    (hB : FullRank B) (hs : PrefixReduced B i) (A : ℝ) (hA : 1 ≤ A)
    (hb : ∀ k : Fin n, k < i → |ratio B i k|≤A)
    (M J : ℝ) (hJ : 0 ≤ J) (ht : TargetWidth B i M) (he : EarlierWidth B i J) :
    TargetWidth (reduceList B i js) i (M+((2:ℝ)^js.length-1)*(A+1)*J) := by
  induction js generalizing B A M with
  | nil => simpa only [reduceList,List.foldl_nil,List.length_nil,pow_zero,sub_self,zero_mul,add_zero] using ht
  | cons j js ih =>
    simp only [reduceList,List.foldl_cons,List.length_cons]
    split_ifs with hji
    · change TargetWidth (reduceList (computedShear B i j) i js) i (M+((2:ℝ)^(js.length+1)-1)*(A+1)*J)
      have hh := ih (B:=computedShear B i j)
        (hB:=N0280.computedShear_fullRank B hji hB)
        (hs:=shear_prefix_reduced B hji hs) (A:=2*A) (hA:=by linarith)
        (hb:=shear_ratio_growth B hji hB hs A hA hb) (M:=M+(A+1)*J)
        (ht:=shear_target_width B hji hB A M J hA hJ hb ht he)
        (he:=shear_earlier_width B J he)
      intro c
      have hc := hh c
      have hp : 1 ≤ (2:ℝ)^js.length := one_le_pow₀ (by norm_num)
      rw [pow_succ]
      nlinarith [mul_nonneg (by linarith : 0 ≤ (2:ℝ)^js.length-1) hJ]
    · change TargetWidth (reduceList B i js) i (M+((2:ℝ)^(js.length+1)-1)*(A+1)*J)
      intro c
      have hh := ih (B:=B) (hB:=hB) (hs:=hs) (A:=A) (hA:=hA) (hb:=hb)
        (M:=M) (ht:=ht) (he:=he) c
      have hp : 0 ≤ (2:ℝ)^js.length*(A+1)*J := by positivity
      rw [pow_succ]
      nlinarith

