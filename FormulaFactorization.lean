/-  The update of a row `y` by the pivot row `v` at column `pv`. -/
noncomputable def elimVec {Nv : ℕ} (v : Fin Nv → K) (pv : Fin Nv) (y : Fin Nv → K) : Fin Nv → K :=
  fun j => y j - y pv * (v pv)⁻¹ * v j

