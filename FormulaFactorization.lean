          have hprod : (B*W).coeff m = 0 := by
            rw [Polynomial.coeff_mul]
            apply sum_eq_zero
            rintro ⟨i,j⟩ hij
            have he := _root_.Finset.HasAntidiagonal.mem_antidiagonal.mp hij
            have hj : j < m+1 := by omega
            rw [ih j hj (by omega)]
