    (perturbationSource_hensel env a A B f H K hHK)

/-  Actual source bit bill for the complete radial compiler, with every initialized numeric literal charged. -/
theorem radialClusterFormula_bitCost {ι : Type} (u : Option ι → ℕ)
    (a : ι → ℚ) (A B : NumericPolynomial) (N : ℕ) (f : N0090.Formula (Option ι)) :
