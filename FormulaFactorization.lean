      (A*B).toPoly.map (algebraMap ℚ (PowerSeries R)) =
      -((A*B).toPoly.map (algebraMap ℚ (PowerSeries R))) := by ring
  rw [hminus, Polynomial.natDegree_neg]
  exact Polynomial.natDegree_map_le.trans_eq (A*B).natDegree_toPoly.symm

/-  Hensel's actual product identity implies the exact source identity needed by the compiler. -/
 theorem perturbationSource_hensel (env : ι → R) (a : ι → ℚ) (A B : NumericPolynomial)
    (f : N0090.Formula (Option ι)) (H K : PowerSeries R[X])
