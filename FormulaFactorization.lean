    {xs : γ → List α} (hx : Realized ei ea.list xs) :
    Realized ei ea.list (fun x => (xs x).reverse) :=
  of_native_list (ComputableTidilyInPolyTime.listReverseWithInput (to_native_list hx))

theorem realized_flatten {ei : Encoding γ} {ea : Encoding α}
