abbrev rationalize := N0595.rationalize
abbrev sourceBill := N0310.sourceBill

theorem cast_injective : Function.Injective (Int.castRingHom ℚ) := by
  intro a b h
  change (a : ℚ) = (b : ℚ) at h
  exact_mod_cast h

/-  The mathematical witnesses for correctness are derived from the input.
This theorem does not supply an oracle to the modular computation. -/
theorem exists_coprime_cofactors (P Q : IntPolynomial) (hP : P.toPoly.Monic) :
    ∃ G A B : IntPolynomial, G.toPoly.Monic ∧ A.toPoly.Monic ∧
      P.toPoly = G.toPoly*A.toPoly ∧ Q.toPoly = G.toPoly*B.toPoly ∧
      IsCoprime (A.toPoly.map (Int.castRingHom ℚ)) (B.toPoly.map (Int.castRingHom ℚ)) := by
  let z := CPolynomial.normXgcd (rationalize P) (rationalize Q)
  let g := z.1.toPoly
  have hpn : (rationalize P).toPoly  ≠  0 := by
    rw [N0595.rationalize_correct]
    exact (Polynomial.map_ne_zero_iff cast_injective).mpr hP.ne_zero
  have hgn : EuclideanDomain.gcd (rationalize P).toPoly (rationalize Q).toPoly  ≠  0 := by
    intro hz
    exact hpn (EuclideanDomain.gcd_eq_zero_iff.mp hz).1
  have hg : g = normalize (EuclideanDomain.gcd (rationalize P).toPoly (rationalize Q).toPoly) :=
    CPolynomial.normXgcd_fst_toPoly _ _
  have hgm : g.Monic := by rw [hg]; exact Polynomial.monic_normalize hgn
  have hgp : g ∣ (rationalize P).toPoly := by
    rw [hg]; exact normalize_dvd_iff.mpr (EuclideanDomain.gcd_dvd_left _ _)
  have hgq : g ∣ (rationalize Q).toPoly := by
    rw [hg]; exact normalize_dvd_iff.mpr (EuclideanDomain.gcd_dvd_right _ _)
  obtain ⟨gZ,hgZ⟩ := IsIntegrallyClosed.eq_map_mul_C_of_dvd ℚ hP (by
    simpa only [N0595.rationalize_correct,
      show algebraMap ℤ ℚ = Int.castRingHom ℚ from rfl] using hgp)
  have hmap : gZ.map (Int.castRingHom ℚ) = g := by
    simpa only [hgm.leadingCoeff,Polynomial.C_1,mul_one,
      show algebraMap ℤ ℚ = Int.castRingHom ℚ from rfl] using hgZ
  let G : IntPolynomial := CPolynomial.toPolyLinearEquiv.symm gZ
  have hG : G.toPoly = gZ := CPolynomial.toPolyLinearEquiv.apply_symm_apply gZ
  have hGm : G.toPoly.Monic := by
    apply Polynomial.monic_of_injective (f := Int.castRingHom ℚ) cast_injective
    rw [hG,hmap]; exact hgm
  have hGP : G.toPoly ∣ P.toPoly := by
    apply (Polynomial.IsPrimitive.Int.dvd_iff_map_cast_dvd_map_cast _ _ hGm.isPrimitive).mpr
    rw [hG,hmap]
    simpa only [N0595.rationalize_correct] using hgp
  have hGQ : G.toPoly ∣ Q.toPoly := by
    apply (Polynomial.IsPrimitive.Int.dvd_iff_map_cast_dvd_map_cast _ _ hGm.isPrimitive).mpr
    rw [hG,hmap]
    simpa only [N0595.rationalize_correct] using hgq
  let A := N0363.monicQuotient P G
  let B := N0363.monicQuotient Q G
  have hPA : G.toPoly*A.toPoly=P.toPoly :=
    N0363.monicQuotient_product P G hGm hGP
  have hQB : G.toPoly*B.toPoly=Q.toPoly :=
    N0363.monicQuotient_product Q G hGm hGQ
  have hAm : A.toPoly.Monic :=
    N0363.monicQuotient_monic P G hP hGm hGP
  have hma : (rationalize P).toPoly = g*(A.toPoly.map (Int.castRingHom ℚ)) := by
    rw [N0595.rationalize_correct,← hPA,Polynomial.map_mul,hG,hmap]
  have hmb : (rationalize Q).toPoly = g*(B.toPoly.map (Int.castRingHom ℚ)) := by
    rw [N0595.rationalize_correct,← hQB,Polynomial.map_mul,hG,hmap]
  have hz := CPolynomial.normXgcd_bezout (rationalize P) (rationalize Q) 0
  change z.1 = z.2.1*(rationalize P)+z.2.2*(rationalize Q) at hz
  have hb := congrArg CPolynomial.toPoly hz
  rw [CPolynomial.toPoly_add,CPolynomial.toPoly_mul,CPolynomial.toPoly_mul,hma,hmb] at hb
  have hu : z.2.1.toPoly*(A.toPoly.map (Int.castRingHom ℚ))+
      z.2.2.toPoly*(B.toPoly.map (Int.castRingHom ℚ))=1 := by
    apply mul_left_cancel₀ hgm.ne_zero
    calc
      g*(z.2.1.toPoly*A.toPoly.map (Int.castRingHom ℚ)+
        z.2.2.toPoly*B.toPoly.map (Int.castRingHom ℚ)) =
          z.2.1.toPoly*(g*A.toPoly.map (Int.castRingHom ℚ))+
          z.2.2.toPoly*(g*B.toPoly.map (Int.castRingHom ℚ)) := by ring
      _ = g := hb.symm
      _ = g*1 := (mul_one g).symm
  exact ⟨G,A,B,hGm,hAm,hPA.symm,hQB.symm,⟨_,_,hu⟩⟩

/-  Cofactor coefficient bound with only the divisor monic. The source and
cofactor may have arbitrary nonzero leading coefficient. -/
theorem cofactor_norm_bound (Q G B : ℚ[X]) (hQ : Q ≠ 0) (hG : G.Monic)
    (hprod : Q=G*B) (i : ℕ) :
    ‖B.coeff i‖  ≤  (2:ℝ)^Q.natDegree*Q.sum (fun _ a=>‖a‖) := by
  have hd : B.natDegree  ≤  Q.natDegree :=
    Polynomial.natDegree_le_of_dvd ⟨G,by simpa only [mul_comm] using hprod⟩ hQ
  have hm : B.mapMahlerMeasure N0361.complexCast  ≤ 
      Q.mapMahlerMeasure N0361.complexCast := by
    rw [hprod,Polynomial.mapMahlerMeasure_mul]
    exact le_mul_of_one_le_left (Polynomial.mapMahlerMeasure_nonneg _ _)
      (Polynomial.Monic.one_le_mapMahlerMeasure _ N0361.complexCast_isometry hG)
  have hc : (B.natDegree.choose i:ℝ)  ≤  (2:ℝ)^Q.natDegree := by
    exact_mod_cast (Nat.choose_le_two_pow B.natDegree i).trans
      (Nat.pow_le_pow_right (by decide : 0<2) hd)
  calc
    ‖B.coeff i‖  ≤  (B.natDegree.choose i:ℝ)*B.mapMahlerMeasure N0361.complexCast :=
      Polynomial.norm_coeff_le_choose_mul_mapMahlerMeasure _ N0361.complexCast_isometry i B
    _  ≤  (2:ℝ)^Q.natDegree*Q.mapMahlerMeasure N0361.complexCast :=
      mul_le_mul hc hm (Polynomial.mapMahlerMeasure_nonneg _ _) (by positivity)
    _  ≤  _ := mul_le_mul_of_nonneg_left
      (Polynomial.mapMahlerMeasure_le_sum_norm_coeff _ _ N0361.complexCast_isometry)
      (by positivity)

def inputExponent (S : ℕ) := N0361.inputHeightBudget S S
def factorExponent (S : ℕ) := N0361.factorHeightBudget S S
def cofactorExponent (S : ℕ) := 2*S+1+inputExponent S
def resultantExponent (S : ℕ) := (2*S)*(2*S)+(factorExponent S+cofactorExponent S)*(2*S)
def gammaBudget (S : ℕ) := resultantExponent S+1
def heightBudget (S : ℕ) := factorExponent S+2





theorem factor_exponent_mono {a b : ℕ} (h : a ≤ b) : factorExponent a ≤ factorExponent b := by
  unfold factorExponent N0361.factorHeightBudget N0361.magnitudeExponent
    N0361.denominatorExponent N0361.inputHeightBudget
  gcongr

theorem monic_coeff_bound (P G : IntPolynomial) (hP : P.toPoly.Monic)
    (hG : G.toPoly.Monic) (hGP : G.toPoly ∣ P.toPoly) (S : ℕ) (hS : sourceBill P ≤ S)
    (i : ℕ) : (G.coeff i).natAbs ≤ 2^factorExponent S := by
  exact (N0310.divisor_coeff_bound P G hP hG hGP i).trans
    (Nat.pow_le_pow_right (by decide) (factor_exponent_mono hS))


theorem integer_cofactor_coeff_bound (Q G B : IntPolynomial) (hQ : Q ≠ 0)
    (hG : G.toPoly.Monic) (hQB : Q.toPoly=G.toPoly*B.toPoly)
    (S : ℕ) (hS : sourceBill Q ≤ S) (i : ℕ) :
    (B.coeff i).natAbs ≤ 2^cofactorExponent S := by
  have hd : Q.natDegree ≤ S := (N0310.source_degree_le_bill Q).trans hS
  have hw : ∀ j, N0090.ratWeight ((rationalize Q).coeff j) ≤ inputExponent S := by
    intro j
    have hh := N0361.input_coeff_height (rationalize Q) j
    rw [N0310.rationalize_degree] at hh
    apply hh.trans
    unfold inputExponent
    change N0361.inputHeightBudget Q.natDegree (sourceBill Q)  ≤  _
    unfold N0361.inputHeightBudget
    gcongr
  have hs := N0361.input_norm_sum_bound (rationalize Q) (inputExponent S) hw
  have hqn : (rationalize Q).toPoly ≠ 0 := by
    rw [N0595.rationalize_correct]
    exact (Polynomial.map_ne_zero_iff cast_injective).mpr
      ((CPolynomial.toPoly_eq_zero_iff Q).not.mpr hQ)
  have hp : (rationalize Q).toPoly =
      (rationalize G).toPoly*(rationalize B).toPoly := by
    simp only [N0595.rationalize_correct,← Polynomial.map_mul,← hQB]
  have hgm : (rationalize G).toPoly.Monic := by
    rw [N0595.rationalize_correct]; exact hG.map _
  have hn := cofactor_norm_bound _ _ _ hqn hgm hp i
  have hi : ‖(rationalize B).toPoly.coeff i‖ = ((B.coeff i).natAbs:ℝ) := by
    rw [← CPolynomial.coeff_toPoly,N0310.rationalize_coeff,
      N0361.rational_norm_num_den,Rat.num_intCast,Rat.den_intCast]
    simp
  rw [hi,← CPolynomial.natDegree_toPoly,N0310.rationalize_degree] at hn
  rw [N0310.rationalize_degree] at hs
  have hsp : ((S+1:ℕ):ℝ) ≤ (2:ℝ)^(S+1) := by
    exact_mod_cast N0310.le_two_pow (S+1)
  have hn' : ((B.coeff i).natAbs:ℝ) ≤ (2:ℝ)^cofactorExponent S := by
    calc
      _  ≤  (2:ℝ)^Q.natDegree*((Q.natDegree+1:ℕ)*(2:ℝ)^inputExponent S) :=
        hn.trans (mul_le_mul_of_nonneg_left hs (by positivity))
      _  ≤  (2:ℝ)^S*(((S+1:ℕ):ℝ)*(2:ℝ)^inputExponent S)  := by gcongr <;> norm_num
      _  ≤  (2:ℝ)^S*((2:ℝ)^(S+1)*(2:ℝ)^inputExponent S)  := by gcongr <;> norm_num
      _ = _ := by unfold cofactorExponent; rw [← pow_add,← pow_add]; congr 1; omega
  exact_mod_cast hn'

theorem resultant_nonzero (A B : ℤ[X])
    (hc : IsCoprime (A.map (Int.castRingHom ℚ)) (B.map (Int.castRingHom ℚ))) :
    A.resultant B ≠ 0 := by
  intro hz
  have hr : (A.map (Int.castRingHom ℚ)).resultant (B.map (Int.castRingHom ℚ))=0 := by
    rw [Polynomial.resultant_map_map,
      Polynomial.natDegree_map_eq_of_injective (f:=Int.castRingHom ℚ) cast_injective,
      Polynomial.natDegree_map_eq_of_injective (f:=Int.castRingHom ℚ) cast_injective,hz,map_zero]
  exact (Polynomial.resultant_eq_zero_iff.mp hr).2 hc

/-  Every prime outside the actual integer resultant is a good cofactor prime.
No degree-preservation premise is required for reduction modulo that prime. -/
theorem good_prime_coprime (A B : ℤ[X]) (hA : 0<A.natDegree) (p : ℕ) [Fact p.Prime]
    (hp : ¬p ∣ (A.resultant B).natAbs) :
    IsCoprime (A.map (Int.castRingHom (ZMod p))) (B.map (Int.castRingHom (ZMod p))) := by
  obtain ⟨a,b,_,_,he⟩ := Polynomial.exists_mul_add_mul_eq_C_resultant
    A B le_rfl le_rfl (Or.inl (Nat.ne_of_gt hA))
  let φ := Int.castRingHom (ZMod p)
  let c : ZMod p := (A.resultant B:ℤ)
  have hc : c ≠ 0 := by
    intro hz
    exact hp (Int.natCast_dvd.mp ((ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp hz))
  have hm := congrArg (Polynomial.map φ) he
  simp only [Polynomial.map_add,Polynomial.map_mul,Polynomial.map_C] at hm
  refine ⟨Polynomial.C c⁻¹*a.map φ,Polynomial.C c⁻¹*b.map φ,?_⟩
  calc
    _ = Polynomial.C c⁻¹*((A.map φ)*(a.map φ)+(B.map φ)*(b.map φ)) := by ring
    _ = Polynomial.C c⁻¹*Polynomial.C c := by rw [hm]; rfl
    _ = 1 := by rw [← Polynomial.C_mul,inv_mul_cancel₀ hc,Polynomial.C_1]

theorem resultant_size_bound (A B : ℤ[X]) (S : ℕ)
    (hAd : A.natDegree ≤ S) (hBd : B.natDegree ≤ S)
    (hA : ∀ i,(A.coeff i).natAbs ≤ 2^factorExponent S)
    (hB : ∀ i,(B.coeff i).natAbs ≤ 2^cofactorExponent S) :
    (A.resultant B).natAbs.size ≤ gammaBudget S := by
  let h := factorExponent S+cofactorExponent S
  have hAc : ∀ i,(A.coeff i).natAbs ≤ 2^h := fun i=>(hA i).trans
    (Nat.pow_le_pow_right (by decide) (by dsimp [h]; omega))
  have hBc : ∀ i,(B.coeff i).natAbs ≤ 2^h := fun i=>(hB i).trans
    (Nat.pow_le_pow_right (by decide) (by dsimp [h]; omega))
  have hb := N0595.resultant_bound A B (2^h) hAc hBc
  have hd : A.natDegree+B.natDegree ≤ 2*S := by omega
  have hf : (A.natDegree+B.natDegree).factorial ≤ 2^((2*S)*(2*S)) := by
    calc
      _  ≤  (2*S).factorial := Nat.factorial_le hd
      _  ≤  (2*S)^(2*S) := Nat.factorial_le_pow _
      _  ≤  (2^(2*S))^(2*S) := Nat.pow_le_pow_left (N0310.le_two_pow _) _
      _ = _ := by rw [← pow_mul]
  have hr : (A.resultant B).natAbs ≤ 2^resultantExponent S := by
    apply hb.trans
    unfold N0595.resultantBudget resultantExponent
    calc
      _  ≤  2^((2*S)*(2*S))*(2^h)^(2*S) :=
        Nat.mul_le_mul hf (Nat.pow_le_pow_right (by positivity) hd)
      _ = _ := by rw [← pow_mul,← pow_add]
  exact (Nat.size_le_size hr).trans (by simp only [Nat.size_pow,gammaBudget,Nat.le_refl])


/-  Entire numeric cutoff is computed from the two original dense inputs. -/
def gcd (P Q : IntPolynomial) : IntPolynomial :=
  let S := sourceBill P+sourceBill Q
  N0342.compute P Q (gammaBudget S) (heightBudget S)

/-  Complete correctness of the actual modular gcd on the source instances
needed by derivative tests and lattice factor extraction. No target factor,
cofactor, bad-prime witness, or height bound is supplied to the algorithm. -/
theorem gcd_spec (P Q : IntPolynomial) (hP : P.toPoly.Monic) (hQ : Q ≠ 0)
    (hdeg : Q.natDegree < P.natDegree) :
    ∃ A B : IntPolynomial, (gcd P Q).toPoly.Monic ∧ A.toPoly.Monic ∧
      P.toPoly = (gcd P Q).toPoly*A.toPoly ∧
      Q.toPoly = (gcd P Q).toPoly*B.toPoly ∧
      IsCoprime (A.toPoly.map (Int.castRingHom ℚ)) (B.toPoly.map (Int.castRingHom ℚ)) := by
  obtain ⟨G,A,B,hG,hA,hPA,hQB,hc⟩ := exists_coprime_cofactors P Q hP
  let S := sourceBill P+sourceBill Q
  have hSP : sourceBill P ≤ S := Nat.le_add_right _ _
  have hSQ : sourceBill Q ≤ S := Nat.le_add_left _ _
  have hPn : P.toPoly ≠ 0 := hP.ne_zero
  have hQn : Q.toPoly ≠ 0 := (CPolynomial.toPoly_eq_zero_iff Q).not.mpr hQ
  have hGP : G.toPoly ∣ P.toPoly := ⟨A.toPoly,hPA⟩
  have hGQ : G.toPoly ∣ Q.toPoly := ⟨B.toPoly,hQB⟩
  have hAP : A.toPoly ∣ P.toPoly := ⟨G.toPoly,by simpa only [mul_comm] using hPA⟩
  have hBQ : B.toPoly ∣ Q.toPoly := ⟨G.toPoly,by simpa only [mul_comm] using hQB⟩
  have hAd : A.toPoly.natDegree ≤ S :=
    (Polynomial.natDegree_le_of_dvd hAP hPn).trans
      (by simpa only [← CPolynomial.natDegree_toPoly] using
        (N0310.source_degree_le_bill P).trans hSP)
  have hBd : B.toPoly.natDegree ≤ S :=
    (Polynomial.natDegree_le_of_dvd hBQ hQn).trans
      (by simpa only [← CPolynomial.natDegree_toPoly] using
        (N0310.source_degree_le_bill Q).trans hSQ)
  have hGd : G.toPoly.natDegree ≤ Q.natDegree := by
    simpa only [← CPolynomial.natDegree_toPoly] using
      Polynomial.natDegree_le_of_dvd hGQ hQn
  have hmul := hG.natDegree_mul' hA.ne_zero
  rw [← hPA,← CPolynomial.natDegree_toPoly] at hmul
  have hApos : 0<A.toPoly.natDegree := by omega
  let D := (A.toPoly.resultant B.toPoly).natAbs
  have hD : 0<D := Int.natAbs_pos.mpr (resultant_nonzero _ _ hc)
  have hsize : D.size ≤ gammaBudget S := by
    apply resultant_size_bound _ _ S hAd hBd
    · intro i
      simpa only [← CPolynomial.coeff_toPoly] using monic_coeff_bound P A hP hA hAP S hSP i
    · intro i
      simpa only [← CPolynomial.coeff_toPoly] using integer_cofactor_coeff_bound Q G B hQ hG hQB S hSQ i
  have hheight : ∀ i,2*(G.coeff i).natAbs ≤ 2^heightBudget S := by
    intro i
    calc
      _ ≤ 2*(2^factorExponent S) := Nat.mul_le_mul_left _ (monic_coeff_bound P G hP hG hGP S hSP i)
      _ = 2^(factorExponent S+1) := by rw [pow_succ]; omega
      _ ≤ _ := Nat.pow_le_pow_right (by decide) (by unfold heightBudget; omega)
  have he : gcd P Q=G := N0342.compute_eq_of_cofactors
    P Q G A.toPoly B.toPoly D (gammaBudget S) (heightBudget S) hP hQ hG hPA hQB hD hsize hheight
    (fun p hp _ hn=>by
      letI : Fact p.Prime := ⟨hp⟩
      exact good_prime_coprime _ _ hApos p hn)
  rw [he]
  exact ⟨A,B,hG,hA,hPA,hQB,hc⟩

