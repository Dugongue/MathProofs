/-! ### `find?` on `finRange` -/

theorem find_finRange_some : ∀ (n : ℕ) (p : Fin n → Bool) (i : Fin n), p i = true →
    (∀ k : Fin n, k.val < i.val → p k = false) → (List.finRange n).find? p = some i
  | 0, _, i, _, _ => i.elim0
  | n + 1, p, i, hi, hlt => by
    rw [List.finRange_succ, List.find?_cons]
    by_cases h0 : i.val = 0
    · have hi0 : i = 0 := Fin.ext h0
      subst hi0
      simp [hi]
    · have hp0 : p 0 = false := hlt 0 (by simp only [Fin.val_zero]; omega)
      rw [hp0, List.find?_map]
      have hrec := find_finRange_some n (p ∘ Fin.succ) (i.pred (fun h => h0 (by rw [h]; rfl)))
        (by simp [hi]) (by
          intro k hk
          apply hlt
          simp only [Fin.val_succ, Fin.coe_pred] at hk ⊢
          omega)
      rw [hrec]
      simp

theorem find_finRange_none (n : ℕ) (p : Fin n → Bool) (h : ∀ k : Fin n, p k = false) :
    (List.finRange n).find? p = none := by
  rw [List.find?_eq_none]
  intro k _
  simp [h k]

/-! ### Row addresses -/

def rowStart (N u : ℕ) : ℕ := 5 + N + u * N

def rowBase (q : RNames) (ue : Expr) : Expr :=
  plus (plus (.lit 5) (.var q.N)) (.bin .mul ue (.var q.N))





theorem evalB_rowBase {B : ℕ} {σ : Env} (q : RNames) {ue : Expr} {uv Nv : ℕ}
    (hu : ue.evalB B σ = some uv) (hN : σ.vars q.N = Nv) (hlt : rowStart Nv uv < B) :
    (rowBase q ue).evalB B σ = some (rowStart Nv uv) := by
  unfold rowBase plus rowStart at *
  have hNv : (Expr.var q.N).evalB B σ = some Nv := by
    rw [← hN]; exact evalB_var (by rw [hN]; omega)
  have h1 : (Expr.bin .add (.lit 5) (.var q.N)).evalB B σ = some (5 + Nv) :=
    evalB_bin (evalB_lit (by omega)) hNv (by change 5 + Nv < B; omega)
  have h2 : (Expr.bin .mul ue (.var q.N)).evalB B σ = some (uv * Nv) :=
    evalB_bin hu hNv (by change uv * Nv < B; omega)
  exact evalB_bin h1 h2 (by change 5 + Nv + uv * Nv < B; omega)

theorem varsIn_rowBase (q : RNames) {ue : Expr} (hu : VarsIn q.fixed ue) :
    VarsIn q.fixed (rowBase q ue) := by
  have hN : q.N ∈ q.fixed := by simp [RNames.fixed]
  exact ⟨⟨trivial, hN⟩, hu, hN⟩

/-! ### The scan -/

variable {K : Type} [Field K] [Fintype K] [DecidableEq K] {F : FieldPresentation K} {r : FieldNames}

