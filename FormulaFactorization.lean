/-  Proof-only interpretation of the literal runtime context. All underlying
arrays and exponents are produced by the actual initialized factorizer. -/
structure Model {n r : ℕ} (c : Context) (a : Fin n → ℚ)
    (f : N0090.Formula (Option (Fin n))) (g : Fin r → CPolynomial ℚ) (e : Fin r → ℕ) : Prop where
  vars_length : (vars c).length=n
  axis_length : (degreeAxis c).length=f.formalDegree
  center_eq : center c=List.ofFn a
  tokens_eq : monicTokens c=tokens (N0039.namedSource f)
  fiber_eq : fiber c=N0875.packetOf g e
  monic : ∀ i,(g i).toPoly.Monic
  prime : ∀ i,Prime (g i).toPoly
  positive : ∀ i,0<e i
  injective : Function.Injective (fun i=>(g i).toPoly)
  product_eq : (∏ i,(g i).toPoly^(e i))=N0276.auxiliaryPolynomial a f

theorem fiber_length {n r : ℕ} {c : Context} {a : Fin n→ℚ}
    {f : N0090.Formula (Option (Fin n))} {g : Fin r→ CPolynomial ℚ} {e : Fin r→ℕ}
    (h : Model c a f g e) : (fiber c).length=r := by
  rw [h.fiber_eq]
  simp [N0875.packetOf]

theorem exponent_bound {n r : ℕ} {c : Context} {a : Fin n→ℚ}
    {f : N0090.Formula (Option (Fin n))} {g : Fin r→ CPolynomial ℚ} {e : Fin r→ℕ}
    (h : Model c a f g e) (i : Fin r) : e i ≤ (degreeAxis c).length := by
  have hb := N0050.monic_product_dimension_bounds (fun j=>(g j).toPoly) e _
    h.monic (fun j=>(h.prime j).not_isUnit) h.positive h.product_eq
  exact (hb.2 i).trans ((N0388.auxiliaryPolynomial_degree a f).trans_eq h.axis_length.symm)

