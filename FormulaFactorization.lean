/-  A nonzero homogeneous polynomial stays nonzero after fixing the distinguished coordinate to one. -/
theorem homogeneous_dehomogenize_ne_zero {ι : Type} [Finite ι]
    (H : MvPolynomial (Option ι) ℚ) (d : ℕ) (hH : H.IsHomogeneous d) (hH0 : H ≠ 0) :
