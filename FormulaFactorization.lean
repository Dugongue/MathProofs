@[simp, grind =]
theorem toPolynomial_mul [Semiring R] [DecidableEq R] (p q : Internal.N0208.DensePoly R) :
    toPolynomial (p * q) = toPolynomial p * toPolynomial q := by
  ext n
  rw [coeff_toPolynomial, Polynomial.coeff_mul]
  simp_rw [coeff_toPolynomial]
