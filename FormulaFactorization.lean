/-! ### Register names of the routines -/

/-  Control registers of the elimination routines. -/
structure RNames where
  WS : String
  N : String
  c : String
  n : String
  u : String
  w : String
  j : String
  i : String
  pv : String
  f : String

def RNames.list (q : RNames) : List String := [q.WS, q.N, q.c, q.n, q.u, q.w, q.j, q.i, q.pv, q.f]

/-  Control registers are distinct and avoid every field-macro register. -/
structure RNames.Valid (r : FieldNames) (q : RNames) : Prop where
  nodup : q.list.Nodup
  avoid : ∀ x ∈ q.list, x ∉ regNames r

/-  The expression mentions only the listed scalars. -/
def VarsIn (l : List String) : Expr → Prop
  | .lit _ => True
  | .var y => y ∈ l
  | .get _ _ => False
  | .bin _ e f => VarsIn l e ∧ VarsIn l f

theorem noVar_of_varsIn {l : List String} {x : String} (hx : x ∉ l) :
    ∀ e : Expr, VarsIn l e → NoVar x e
  | .lit _, _ => trivial
  | .var y, h => fun hy => hx (hy ▸ h)
  | .get _ _, h => h.elim
  | .bin _ e f, h => ⟨noVar_of_varsIn hx e h.1, noVar_of_varsIn hx f h.2⟩

theorem evalB_congr_varsIn {B : ℕ} {l : List String} {σ τ : Env}
    (hv : ∀ x ∈ l, τ.vars x = σ.vars x) :
    ∀ e : Expr, VarsIn l e → e.evalB B τ = e.evalB B σ
  | .lit _, _ => rfl
  | .var y, h => by simp only [Expr.evalB]; rw [hv y h]
  | .get _ _, h => h.elim
  | .bin _ e f, h => by
