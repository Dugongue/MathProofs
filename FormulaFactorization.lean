    have hs : ∀ k : Fin n, k < r → CoefficientReduced C r k :=
      fun k hkr => normalizeList_sets B left hp.1 hB r (hp.2.2 r hri) k hkr
    have hh := (coordinate_le_norm C r c).trans (reduced_row_norm C hC r hs)
    rw [hpot] at hh
