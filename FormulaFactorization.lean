    (A.natDegree+1) (logSource A B N d E)).trans (expBudget_mono hl)
  have hp := N0206.coefficientFormula_bitCost w (A.natDegree*A.natDegree) k (expSource A B N d E)
  change N0090.bitCost w _ ≤ N0344.projectionCostBound _ _ at hp
