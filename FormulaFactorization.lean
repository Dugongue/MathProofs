  {r : FieldNames}

/-  One candidate. -/
def candBody (M : FieldMacros F r) (q : RNames) (cn : CNames) : Com :=
  .seq (loadChosen M q cn.cc)
    (.seq (copyLoop M q (.lit 5) (inBase q (.var cn.t)))
      (.seq (.assign q.c (.var cn.cc))
