  apply Int.emod_eq_zero_of_dvd
  rcases Int.dvd_of_emod_eq_zero h with ⟨c, hc⟩
  rcases Int.dvd_of_emod_eq_zero h' with ⟨d, hd⟩
  rcases selfdvd m.toNat (Int.ofNat w.toNat + Int.ofNat w'.toNat) with ⟨e, he⟩
