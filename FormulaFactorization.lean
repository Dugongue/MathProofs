theorem routine_run_framed (q : RNames) (hq : q.Valid canonical)
    {Sn B N : Nat} {P Q : K[X]} {σ : Env} (h : Buffers F q Sn B N P Q σ)
    (hfit : 5+N+N+N+N≤Sn) :
