  pointState (processed r modArray σ) (finishNames r)
    (fun j=>((processed r modArray σ).arrs r.scratch).getD j 0) (σ.vars r.e)

theorem processed_vars (r : FieldNames) (modArray : String) (σ : Env) (x : String)
    (hxi : x≠r.i) (hxv : x≠r.value) (hxk : x≠r.k) (hxj : x≠r.j) :
    (processed r modArray σ).vars x=σ.vars x :=
  (loopState_vars r modArray (initialized r σ) x hxi hxv hxk hxj _).trans
    (initialized_vars r σ x hxi hxk hxj)

