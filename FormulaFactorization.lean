    calc
      _ ≤ ∑ _t ∈ Finset.range (D+1), ∑ _y ∈ Finset.range (D+1),
          factorCoefficientBudget D (arrayBill D P) := by
        apply Finset.sum_le_sum
        intro t ht
        apply Finset.sum_le_sum
        intro y hy
        exact factor_coefficient_bound D P Q hP hmP hmQ hdiv t y
      _ = _ := by simp [Nat.mul_assoc]
  simpa only [arrayBill, factorArrayBudget, Nat.add_assoc] using
    Nat.add_le_add_left (Nat.add_le_add hcode hsum) 7


