def HasOutput (M : BinaryTransducer)
    (final : Internal.N0339.N0349.Config (Fin (M.workTapes + 2)) (Option Bool) M.State)
    (bits : List Bool) : Prop :=
  final.tapes M.outputTape = Internal.N0339.N0349.stackTape bits

