abbrev kernelFlag := Internal.N0339.N0524.flag

def maxCapacity (p D : ℕ) : ℕ := p*D+1
def work (p D : ℕ) : ℕ := 16*(p+1)*(D+1)^3+16
def numerator (p D : ℕ) : ℕ := work p D
def polynomial (p D : ℕ) : ℕ := numerator p D+maxCapacity p D
def raw (p D : ℕ) : ℕ := polynomial p D+maxCapacity p D
def vector (p D : ℕ) : ℕ := raw p D+(D+1)
def result (p D : ℕ) : ℕ := vector p D+(D+1)
def workspace (p D : ℕ) : ℕ := result p D+(D+1)

theorem capacity_le (p D n : ℕ) (hn : n    ≤    D) : p*n+1    ≤    maxCapacity p D :=
  Nat.add_le_add_right (Nat.mul_le_mul_left p hn) 1

theorem native_work (p D : ℕ) : 5+4*maxCapacity p D    ≤    work p D := by
  have hD : D    ≤    (D+1)^3 := (Nat.le_succ D).trans (Nat.le_self_pow (by decide) (D+1))
  have hm := Nat.mul_le_mul (Nat.le_succ p) hD
  unfold maxCapacity work
  nlinarith only [hm]

theorem kernel_bank_bound (n : ℕ) :
    n*N0178.bankSize n (n-1)    ≤    7*(n+1)^3 := by
  have hsum : (n+1)+(n-1)    ≤    2*(n+1) := by omega
  have hmul := Nat.mul_le_mul (Nat.sub_le n 1) hsum
  have hunit : 1    ≤    (n+1)^2 := by
    have hh : 0<(n+1)^2 := by positivity
    omega
  have hbank : N0178.bankSize n (n-1)    ≤    7*(n+1)^2 := by
    unfold N0178.bankSize
    nlinarith only [hsum,hmul,hunit]
  calc
    n*N0178.bankSize n (n-1)    ≤    n*(7*(n+1)^2) := Nat.mul_le_mul_left n hbank
    _     ≤     (n+1)*(7*(n+1)^2) := Nat.mul_le_mul_right _ (Nat.le_succ n)
    _ = _ := by ring

theorem kernel_work (p D n : ℕ) (hn : n    ≤    D) :
    n*N0178.bankSize n (n-1)    ≤    work p D := by
  have hb := kernel_bank_bound n
  have hp := Nat.pow_le_pow_left (Nat.add_le_add_right hn 1) 3
  have hs : (D+1)^3    ≤    (p+1)*(D+1)^3 := Nat.le_mul_of_pos_left _ (by omega)
  unfold work
  nlinarith only [hb,hp,hs]

theorem matrix_work (p D n : ℕ) (hn : n    ≤    D) : 5+n*(n-1)    ≤    work p D := by
  have hn1 : n    ≤    D+1 := by omega
  have hm := Nat.mul_le_mul hn1 ((Nat.sub_le n 1).trans hn1)
  have hpow : (D+1)^2    ≤    (D+1)^3 := Nat.pow_le_pow_right (by omega) (by decide)
  have hs : (D+1)^3    ≤    (p+1)*(D+1)^3 := Nat.le_mul_of_pos_left _ (by omega)
  unfold work
  nlinarith only [hm,hpow,hs]

theorem vector_work (p D n : ℕ) (hpos : 0<n) (hn : n    ≤    D) :
    N0178.bankSize n (n-1)+(n-1)    ≤    vector p D := by
  let L := N0178.bankSize n (n-1)
  have hL : 0<L := by dsimp [L,N0178.bankSize];omega
  have hm : n-1    ≤    (n-1)*L := Nat.le_mul_of_pos_right _ hL
  have hbank := kernel_work p D n hn
  have hbound : L+(n-1)    ≤    n*L := by
    have he : n=n-1+1 := by omega
    have heMul := congrArg (fun a : ℕ=>a*L) he
    nlinarith only [hm,heMul]
  unfold vector raw polynomial numerator
  exact hbound.trans (hbank.trans (by omega))

structure Ready (p D n Sn : ℕ) : Prop where
  wide : n+1   ≤   p*n+1
  work_space : 5+4*(p*n+1)   ≤   Sn
  numerator_after : 5+4*(p*n+1)   ≤   numerator p D
  polynomial_after : 5+4*(p*n+1)   ≤   polynomial p D
  numerator_fit : numerator p D+(p*n+1)   ≤   polynomial p D
  polynomial_fit : polynomial p D+(p*n+1)   ≤   raw p D
  raw_fit : raw p D+(n+1)   ≤   Sn
  matrix_fit : 5+n*(n-1)   ≤   Sn
  kernel_fit : n*N0178.bankSize n (n-1)   ≤   Sn
  matrix_keep : 5+n*(n-1)   ≤   polynomial p D
  kernel_keep : n*N0178.bankSize n (n-1)   ≤   polynomial p D
  vector_fit : polynomial p D+(p*n+1)   ≤   vector p D
  kernel_vector : N0178.bankSize n (n-1)+(n-1)   ≤   vector p D
  result_fit : vector p D+(n+1)   ≤   result p D
  output_fit : result p D+(n+1)   ≤   Sn
  raw_result : raw p D+(n+1)   ≤   result p D
  update_space : 5+4*(n+1) ≤ Sn
  result_after : 5+4*(n+1) ≤ result p D
  numerator_space : numerator p D ≤ Sn
  polynomial_space : polynomial p D ≤ Sn
  capacity_fit : p*n+1   ≤   Sn

/-  Every future smaller degree satisfies the actual source's storage ABI in
one explicit polynomial workspace; no future-step source transformation. -/
theorem layout_ready (p D n Sn : ℕ) (hp : 0<p) (hpos : 0<n) (hn : n   ≤   D)
    (hspace : workspace p D   ≤   Sn) : Ready p D n Sn := by
  have hcap := capacity_le p D n hn
  have hwork := native_work p D
  have hmatrix := matrix_work p D n hn
  have hkernel := kernel_work p D n hn
  have hvector := vector_work p D n hpos hn
  have hwide : n+1   ≤   p*n+1 := Nat.add_le_add_right (Nat.le_mul_of_pos_left _ hp) 1
  constructor
  all_goals simp only [numerator,polynomial,raw,vector,result,workspace] at *
  all_goals omega

theorem table_mono (D n : ℕ) (hn : n   ≤   D) : n*(n-1)   ≤   D*(D-1) :=
  Nat.mul_le_mul hn (Nat.sub_le_sub_right hn 1)

/-  The explicit whole workspace has a universal polynomial value bound. -/
theorem workspace_bound (p D : ℕ) : workspace p D   ≤   64*(p+1)*(D+1)^3+64 := by
  have hD : D   ≤   (D+1)^3 := (Nat.le_succ D).trans (Nat.le_self_pow (by decide) (D+1))
  have hpD := Nat.mul_le_mul (Nat.le_succ p) hD
  have hbase : D+1   ≤   (p+1)*(D+1)^3 := (Nat.le_self_pow (by decide) (D+1)).trans
    (Nat.le_mul_of_pos_left _ (by omega))
  unfold workspace result vector raw polynomial numerator work maxCapacity
  nlinarith only [hpD,hbase]

def activeRegister : String := "P25.berlekamp.seed.active"

def saveProgram : Com := .seq (.assign numeratorAddress (.var firstRegister))
  (.seq (.assign polynomialAddress (.var secondRegister)) (.assign activeRegister (.lit 1)))

def prepareUpdate : Com := .assign q.n (.add (.var degreeRegister) (.lit 1))
def positiveCode : Com := .seq N0189.positiveBody
  (.seq prepareUpdate N0187.program)
def negativeCode : Com := .seq N0187.restoreProgram (.assign activeRegister (.lit 0))

def splitBody : Com := .seq N0182.program
  (.ite (.eq (.var kernelFlag) (.lit 0))
    positiveCode negativeCode)

def body : Com := .ite (.lt (.var degreeRegister) (.lit 2)) (.assign activeRegister (.lit 0)) splitBody
def guard : Cond := .eq (.var activeRegister) (.lit 1)
def program : Com := .seq saveProgram (.while guard body)

structure Inv (p D Sn W : ℕ) [Fact p.Prime] (original current : CPolynomial (ZMod p)) (σ0 σ : Env) : Prop where
  slots : Slots (presentation p) canonical q.WS Sn W σ
  monic : current.toPoly.Monic
  squarefree : Squarefree current.toPoly
  positive : 0<current.natDegree
  bounded : current.natDegree  ≤  D
  divisor : current.toPoly  ∣  original.toPoly
  params : Parameters current.natDegree (p*current.natDegree+1) (numerator p D) (polynomial p D) σ
  raw_address : σ.vars rawRegister=raw p D
  vector_address : σ.vars vectorAddress=vector p D
  result_address : σ.vars resultRegister=result p D
  saved_numerator : σ.vars numeratorAddress=numerator p D
  saved_polynomial : σ.vars polynomialAddress=polynomial p D
  coefficients : ∀i<current.natDegree+1,val (presentation p) canonical q.WS σ (raw p D+i)=current.toPoly.coeff i
  active : σ.vars activeRegister  ≤  1
  stopped : σ.vars activeRegister=0 → Irreducible current.toPoly
  table_length : (σ.arrs matrixArray).length=(σ0.arrs matrixArray).length
  inp : σ.inp=σ0.inp
  out : σ.out=σ0.out

def State (p D Sn W : ℕ) [Fact p.Prime] (original : CPolynomial (ZMod p)) (σ0 σ : Env) : Prop :=
  ∃current,Inv p D Sn W original current σ0 σ

def potential (σ : Env) : ℕ := if σ.vars activeRegister=0 then 0 else σ.vars degreeRegister

def globalNames : List String := [rawRegister,vectorAddress,resultRegister,numeratorAddress,polynomialAddress]
def Globals (σ τ : Env) : Prop := ∀x∈globalNames,τ.vars x=σ.vars x

private theorem globals_of_run {W C : ℕ} {code : Com} {σ τ : Env}
    (hr : Run W code σ τ C) (hf : ∀x∈globalNames,x∉scalarWrites code) : Globals σ τ :=
  fun x hx=>(run_frame hr).1 x (hf x hx)

/-  Proof-only invariant assembly from the actual component execution. -/
private theorem reframe (p D Sn W : ℕ) [Fact p.Prime]
    (original current next : CPolynomial (ZMod p)) (σ0 σ τ : Env)
    (h : Inv p D Sn W original current σ0 σ) {C : ℕ} {code : Com} (hr : Run W code σ τ C)
    (hs : Slots (presentation p) canonical q.WS Sn W τ)
    (hm : next.toPoly.Monic) (hsf : Squarefree next.toPoly) (hpos : 0<next.natDegree)
    (hb : next.natDegree  ≤  D) (hdiv : next.toPoly  ∣  original.toPoly)
    (hpar : Parameters next.natDegree (p*next.natDegree+1) (numerator p D) (polynomial p D) τ)
    (hcoeff : ∀i<next.natDegree+1,val (presentation p) canonical q.WS τ (raw p D+i)=next.toPoly.coeff i)
    (hactive : τ.vars activeRegister  ≤  1) (hstop : τ.vars activeRegister=0 → Irreducible next.toPoly)
    (hg : Globals σ τ) (hin : τ.inp=σ.inp) (hout : τ.out=σ.out) :
    Inv p D Sn W original next σ0 τ := by
  refine ⟨hs,hm,hsf,hpos,hb,hdiv,hpar,?_,?_,?_,?_,?_,hcoeff,hactive,hstop,?_,hin.trans h.inp,hout.trans h.out⟩
  · exact (hg _ (by simp [globalNames])).trans h.raw_address
  · exact (hg _ (by simp [globalNames])).trans h.vector_address
  · exact (hg _ (by simp [globalNames])).trans h.result_address
  · exact (hg _ (by simp [globalNames])).trans h.saved_numerator
  · exact (hg _ (by simp [globalNames])).trans h.saved_polynomial
  · exact ((run_frame hr).2.2.1 matrixArray).trans h.table_length

def stepCost (p D : ℕ) : ℕ :=
  1000000000000000000*(p+1)*(p.size+1)*(p*D+D+3)^4+60000*(D+2)+32

theorem split_budget_le (p D n : ℕ) (hn : n  ≤  D) :
    N0189.splitCost p n (p*n+1)  ≤  
      1000000000000000000*(p+1)*(p.size+1)*(p*D+D+3)^4 := by
  have hm := Nat.mul_le_mul_left p hn
  have hbase : p*n+1+n+2  ≤  p*D+D+3 := by omega
  exact (N0189.splitCost_bound p n (p*n+1)).trans
    (Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hbase 4))

theorem globals_fresh_body : ∀x∈globalNames,x∉scalarWrites body := by decide

private theorem linear_pay (p D : ℕ) : 6 ≤ stepCost p D := by unfold stepCost;omega
private theorem negative_pay (K B T n D : ℕ) (hK : 2+K+(5+B) ≤ T) (hn : n ≤ D) :
    4+(K+(4+(10000*(n+2)+2))) ≤ T+60000*(D+2)+32 := by omega
private theorem positive_pay (K B T n D : ℕ) (hK : 2+K+(5+B) ≤ T) (hn : n ≤ D) :
    4+(K+(4+(B+(4+50000*(n+2))))) ≤ T+60000*(D+2)+32 := by omega

/-  Every actual seed-controller body either certifies its current input or
physically installs a strictly smaller monic squarefree divisor. -/
theorem body_run (p D Sn W : ℕ) [Fact p.Prime]
    (original : CPolynomial (ZMod p)) (σ0 σ : Env)
    (hstate : State p D Sn W original σ0 σ) (hactive : σ.vars activeRegister=1)
    (hspace : workspace p D ≤ Sn)
    (htable : D*(D-1) ≤ (σ0.arrs matrixArray).length) (htableW : (σ0.arrs matrixArray).length<W) :
    ∃τ,Run W body σ τ (stepCost p D)  ∧  State p D Sn W original σ0 τ  ∧  potential τ<potential σ := by
  obtain ⟨f,hf⟩ := hstate
  let n := f.natDegree
  have hnpos : 0<n := hf.positive
  have hnD : n ≤ D := hf.bounded
  have hready := layout_ready p D n Sn (Fact.out : p.Prime).pos hnpos hnD hspace
  have hnword : n<W := by
    have hnle : n ≤ p*n := Nat.le_mul_of_pos_left _ (Fact.out : p.Prime).pos
    have hc := hready.capacity_fit
    have hw := hf.slots.slots_word
    omega
  have h2W : 2<W := by
    have hh := hf.slots.base.arithmetic_word
    change (p+1)^2<W at hh
    have hp := (Fact.out : p.Prime).two_le
    nlinarith
  have ed : (Expr.var degreeRegister).evalB W σ=some n :=
    (evalB_var (by rw [hf.params.degree];exact hnword)).trans (congrArg some hf.params.degree)
  have eouter : (Cond.lt (.var degreeRegister) (.lit 2)).evalB W σ=some (decide (n<2)) :=
    evalB_condLt ed (evalB_lit h2W)
  have hV : potential σ=n := by simp only [potential,hactive,if_neg (by decide : ¬(1=0)),hf.params.degree];rfl
  by_cases hlin : n<2
  · have etrue : (Cond.lt (.var degreeRegister) (.lit 2)).evalB W σ=some true := by simpa [hlin] using eouter
    let τ := σ.setVar activeRegister 0
    have rset : Run W (.assign activeRegister (.lit 0)) σ τ 2 := Run.assign (evalB_lit (by omega))
    have hrun : Run W body σ τ (stepCost p D) :=
      (Run.ite_true (d:=splitBody) etrue rset).mono (linear_pay p D)
    have hτ := Slots.setVar (presentation p) canonical hf.slots (by decide : activeRegister∉regNames canonical)
      (by decide : activeRegister ≠ q.WS) 0
    have hpar : Parameters f.natDegree (p*f.natDegree+1) (numerator p D) (polynomial p D) τ := ⟨
      ((run_frame rset).1 _ (by decide)).trans hf.params.degree,
      ((run_frame rset).1 _ (by decide)).trans hf.params.capacity,
      ((run_frame rset).1 _ (by decide)).trans hf.params.numerator,
      ((run_frame rset).1 _ (by decide)).trans hf.params.divisor⟩
    have hirr : Irreducible f.toPoly := by
      have hn1 : f.natDegree=1 := by dsimp [n] at hlin;have := hf.positive;omega
      apply Polynomial.irreducible_of_degree_eq_one
      rw [Polynomial.degree_eq_natDegree hf.monic.ne_zero,←CPolynomial.natDegree_toPoly,hn1]
      rfl
    have hnew := reframe p D Sn W original f f σ0 σ τ hf hrun hτ hf.monic hf.squarefree hf.positive hf.bounded hf.divisor
      hpar (fun i hi=>(val_setVar (presentation p) canonical (by decide) σ 0 _).trans (hf.coefficients i hi))
      (by simp [τ]) (fun _=>hirr) (globals_of_run hrun globals_fresh_body) rfl rfl
    refine ⟨τ,hrun,⟨f,hnew⟩,?_⟩
    rw [hV]
    simpa only [potential,τ,vars_setVar,ite_true] using hnpos
  · have hn2 : 2 ≤ n := by omega
    have efalse : (Cond.lt (.var degreeRegister) (.lit 2)).evalB W σ=some false := by simpa [hlin] using eouter
    have harray : n*(n-1) ≤ (σ.arrs matrixArray).length := by
      rw [hf.table_length]
      exact (table_mono D n hnD).trans htable
    obtain ⟨ξ,hkernel,hξ,hparams,hnone,hsome,hpad,hbase,hflag,hinK,houtK⟩ :=
      N0189.polynomial_framed p Sn W n (p*n+1) (numerator p D) (polynomial p D) (raw p D)
        f σ hf.slots hf.params hf.raw_address rfl rfl hn2 hf.monic
        hready.work_space hready.numerator_after hready.polynomial_after hready.numerator_fit hready.polynomial_fit hready.raw_fit
        hready.matrix_fit hready.kernel_fit hready.matrix_keep hready.kernel_keep harray
        (by rw [hf.table_length];exact htableW) hf.coefficients
    have hk : Run W N0182.program σ ξ
        (N0189.kernelCost p n (p*n+1)) := hkernel
    have hgK : Globals σ ξ := globals_of_run hk (by decide)
    have hactiveξ : ξ.vars activeRegister=1 := ((run_frame hk).1 activeRegister (by decide)).trans hactive
    have hbound : ξ.vars kernelFlag ≤ 1 := hflag
    have hsplit := split_budget_le p D n hnD
    cases hv : N0178.output n (n-1) ξ with
    | none =>
      have hnflag : ξ.vars kernelFlag ≠ 0 := by
        intro hz
        change ξ.vars "P18.kernel.flag"=0 at hz
        simp [N0178.output,hz] at hv
      have hf1 : ξ.vars kernelFlag=1 := by omega
      have ev : (Expr.var kernelFlag).evalB W ξ=some 1 :=
        (evalB_var (by rw [hf1];omega)).trans (congrArg some hf1)
      have einner : (Cond.eq (.var kernelFlag) (.lit 0)).evalB W ξ=some false :=
        evalB_condEq ev (evalB_lit (by omega))
      have hrawξ : ξ.vars rawRegister=raw p D := (hgK _ (by simp [globalNames])).trans hf.raw_address
      obtain ⟨ζ,hrestore,hζ,hparζ,hcoeffζ,hframeζ,hinR,houtR⟩ :=
        N0187.restore_run p Sn W n (p*n+1) (numerator p D) (polynomial p D) (raw p D)
          f.toPoly ξ hξ hparams hrawξ hready.wide hready.polynomial_fit hready.raw_fit hpad
      let τ := ζ.setVar activeRegister 0
      have rset : Run W (.assign activeRegister (.lit 0)) ζ τ 2 := Run.assign (evalB_lit (by omega))
      have rnegative : Run W negativeCode ξ τ (10000*(n+2)+2) := hrestore.seq rset
      have rsplit := hk.seq (Run.ite_false (c:=positiveCode) einner rnegative)
      have hrun : Run W body σ τ (stepCost p D) := by
        have rr := Run.ite_false (c:=.assign activeRegister (.lit 0)) efalse rsplit
        apply rr.mono
        exact negative_pay _ _ _ n D hsplit hnD
      have hτ := Slots.setVar (presentation p) canonical hζ (by decide : activeRegister∉regNames canonical)
        (by decide : activeRegister ≠ q.WS) 0
      have hparτ : Parameters f.natDegree (p*f.natDegree+1) (numerator p D) (polynomial p D) τ := ⟨
        ((run_frame rset).1 _ (by decide)).trans hparζ.degree,
        ((run_frame rset).1 _ (by decide)).trans hparζ.capacity,
        ((run_frame rset).1 _ (by decide)).trans hparζ.numerator,
        ((run_frame rset).1 _ (by decide)).trans hparζ.divisor⟩
      have hirr := N0182.trivial_irreducible p f hf.monic hf.positive hf.squarefree (hnone.mp hv)
      have hnew := reframe p D Sn W original f f σ0 σ τ hf hrun hτ hf.monic hf.squarefree hf.positive hf.bounded hf.divisor
        hparτ (fun i hi=>(val_setVar (presentation p) canonical (by decide) ζ 0 _).trans (hcoeffζ i hi))
        (by simp [τ]) (fun _=>hirr) (globals_of_run hrun globals_fresh_body) (hinR.trans hinK) (houtR.trans houtK)
      refine ⟨τ,hrun,⟨f,hnew⟩,?_⟩
      rw [hV]
      simpa only [potential,τ,vars_setVar,ite_true] using hnpos
    | some v =>
      have hf0 : ξ.vars kernelFlag=0 := by
        by_contra hz
        change ξ.vars "P18.kernel.flag" ≠ 0 at hz
        simp [N0178.output,hz] at hv
      have ev : (Expr.var kernelFlag).evalB W ξ=some 0 :=
        (evalB_var (by rw [hf0];omega)).trans (congrArg some hf0)
      have einner : (Cond.eq (.var kernelFlag) (.lit 0)).evalB W ξ=some true :=
        evalB_condEq ev (evalB_lit (by omega))
      obtain ⟨hvsize,hvnonzero,hvnull⟩ := hsome v hv
      have hva : ξ.vars vectorAddress=vector p D := (hgK _ (by simp [globalNames])).trans hf.vector_address
      have hvo : ξ.vars resultRegister=result p D := (hgK _ (by simp [globalNames])).trans hf.result_address
      have hworkN : 5+4*(n+1) ≤ polynomial p D := by have := hready.polynomial_after;have := hready.wide;omega
      obtain ⟨θ,hpositive,hθ,hfound,hrecord,hinP,houtP⟩ :=
        N0189.positiveBody_run p Sn W n (p*n+1) (polynomial p D) (vector p D) (result p D)
          f ξ v hξ hparams.capacity hparams.divisor hparams.degree hva hvo hbase hv hvsize hvnonzero hvnull
          hf.monic rfl hn2 hready.wide hpad hworkN hready.vector_fit hready.kernel_vector hready.result_fit hready.output_fit
      obtain ⟨g,hgm,hgp,hglt,hgdiv,hgcoeff⟩ := N0189.recorded_factor p (n+1) (result p D) n p
        f (N0182.decodedPolynomial p v) θ hrecord
      have hdegθ : θ.vars degreeRegister=n := ((run_frame hpositive).1 _ (by decide)).trans hparams.degree
      have hnword' : n+1<W := by have := hready.wide;have := hready.capacity_fit;have := hf.slots.slots_word;omega
      have ecap : (Expr.add (.var degreeRegister) (.lit 1)).evalB W θ=some (n+1) :=
        evalB_bin ((evalB_var (by rw [hdegθ];omega)).trans (congrArg some hdegθ))
          (evalB_lit (by omega)) (by change n+1<W;exact hnword')
      let ζ := θ.setVar q.n (n+1)
      have rcap : Run W prepareUpdate θ ζ 4 := Run.assign ecap
      have hζ := Slots.setVar (presentation p) canonical hθ (by decide : q.n∉regNames canonical) (by decide : q.n ≠ q.WS) (n+1)
      have hglobalsζ : Globals σ ζ := globals_of_run (hk.seq (hpositive.seq rcap)) (by decide)
      have hrawζ : ζ.vars rawRegister=raw p D := (hglobalsζ _ (by simp [globalNames])).trans hf.raw_address
      have hresultζ : ζ.vars resultRegister=result p D := (hglobalsζ _ (by simp [globalNames])).trans hf.result_address
      have hnumζ : ζ.vars numeratorAddress=numerator p D := (hglobalsζ _ (by simp [globalNames])).trans hf.saved_numerator
      have hpolyζ : ζ.vars polynomialAddress=polynomial p D := (hglobalsζ _ (by simp [globalNames])).trans hf.saved_polynomial
      have hgD : g.natDegree ≤ D := hglt.le.trans hnD
      have hreadyG := layout_ready p D g.natDegree Sn (Fact.out : p.Prime).pos hgp hgD hspace
      have hGnonzero : g.toPoly ≠ 0 := hgm.ne_zero
      have hGcap : g.toPoly.natDegree<n+1 := by rw [←CPolynomial.natDegree_toPoly];omega
      have hGword : p*g.toPoly.natDegree+1<W := by
        rw [←CPolynomial.natDegree_toPoly]
        exact hreadyG.capacity_fit.trans_lt hf.slots.slots_word
      have hdataζ : ∀i<n+1,val (presentation p) canonical q.WS ζ (result p D+i)=g.toPoly.coeff (n+1-1-i) := by
        intro i hi
        rw [val_setVar (presentation p) canonical (by decide : q.n ≠ q.WS)]
        exact hgcoeff i hi
      obtain ⟨τ,hupdate,hτ,hparτ,hrawτ,hresultτ,hcoeffτ,harraysτ,hinU,houtU⟩ :=
