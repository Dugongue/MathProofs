  have hh := lt_of_not_ge h
  have ha : 0 ≤ |ratio B i j|-1 := by linarith
  have hp := mul_nonneg (abs_nonneg (ratio B i j)) ha
  nlinarith [sq_abs (ratio B i j)]

theorem coordinate_le_norm {n d} (B : IntBasis n d) (i : Fin n) (c : Fin d) :
    |(B i c:ℝ)| ≤ ‖N0297.rows B i‖^2 := by
  have hc := N0313.coordinate_abs_le (B i) c
