noncomputable def widthBound (n : ℕ) (Phi M : ℝ) : ℝ :=
  M+((2:ℝ)^n-1)*(Phi*M+3)*(n+1:ℝ)*Phi

noncomputable def quotientBound (n : ℕ) (Phi M : ℝ) : ℝ := (2:ℝ)^n*(Phi*M+2)+1

theorem actual_partial_target_width {n d} (B : IntBasis n d) (hB : FullRank B) (i : Fin n)
    (left right js : List (Fin n)) (hsplit : List.finRange n=left++i::right) (hlen : js.length ≤ n)
    (Phi M : ℝ) (hPhi : (potential B:ℝ) ≤ Phi)
    (hM : ∀ r : Fin n, ‖N0297.rows B r‖^2 ≤ M) :
    TargetWidth (fastReduceList (normalizeList B left) i js) i (widthBound n Phi M) := by
  obtain ⟨hC,hs,hb,ht,he⟩ := outer_prefix_width_data B hB i left right hsplit Phi M hPhi hM
  have hbase : (0:ℝ) ≤ (potential B:ℝ) := by exact_mod_cast (potential_pos B hB).le
  have hPhi0 : 0 ≤ Phi := hbase.trans hPhi
  have hM0 : 0 ≤ M := (sq_nonneg _).trans (hM i)
