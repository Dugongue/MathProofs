def scan {n : ℕ} : List (Row n)→State→State
  | [],p => p
  | r::rs,p => if rowTest r p then effect r.effect p else scan rs p

theorem finite_scan {n : ℕ} (rs : List (Row n)) : FFP stateEncoding stateEncoding (scan rs) := by
  induction rs with
  | nil => exact (finite_id _).congr (fun _=>rfl)
  | cons r rs ih =>
    have hp : FFP stateEncoding BitEncoding.bool (fun p=>decide (rowTest r p=true)) :=
      (finite_matches r).congr (fun p=>by simp)
    exact (finite_ite (p:=fun p=>rowTest r p=true) hp (finite_effect r.effect) ih).congr (fun p=>by simp [scan])

def next (M : BinaryTransducer) : State→State := scan (N0376.rows M)

theorem finite_next (M : BinaryTransducer) : FFP stateEncoding stateEncoding (next M) :=
  finite_scan (N0376.rows M)

end
