      Polynomial.degree_eq_natDegree hA.ne_zero,Polynomial.degree_eq_natDegree hB.ne_zero]
    have hn := Polynomial.natDegree_lt_natDegree hz hU
    exact_mod_cast (show U.natDegree+B.natDegree<A.natDegree+B.natDegree by omega)

