      τ.vars kq.WS=σ.vars nq.WS ∧
      (∀a,τ.arrs a=σ.arrs a) ∧ τ.inp=σ.inp ∧ τ.out=σ.out := by
  let σ1 := σ.setVar kq.WS (σ.vars nq.WS)
  let σ2 := σ1.setVar uw.nR n
  let τ := σ2.setVar uw.mR (n-1)
  have hbase : σ.vars nq.WS<W := by
    have hf:=hs.fit;have hm:=hs.base.memory_word;change σ.vars nq.WS+Sn*1≤_ at hf;omega
  have r1 : Run W (.assign kq.WS (.var nq.WS)) σ σ1 2 := Run.assign (evalB_var hbase)
  have hn1 : σ1.vars degreeRegister=n := by simpa [σ1,vars_setVar,show degreeRegister≠kq.WS by decide] using hn
  have hread1 : (Expr.var degreeRegister).evalB W σ1=some n :=
    (evalB_var (by rw [hn1];exact hnW)).trans (congrArg some hn1)
  have r2 : Run W (.assign uw.nR (.var degreeRegister)) σ1 σ2 2 := Run.assign hread1
  have hn2 : σ2.vars degreeRegister=n := by simpa [σ2,vars_setVar,show degreeRegister≠uw.nR by decide] using hn1
  have hread2 : (Expr.var degreeRegister).evalB W σ2=some n :=
    (evalB_var (by rw [hn2];exact hnW)).trans (congrArg some hn2)
  have h1W : 1<W := by
    have hh:=hs.base.arithmetic_word
    change (p+1)^2<W at hh
    have hp:2≤p := (Fact.out : p.Prime).two_le
    nlinarith
  have r3 : Run W (.assign uw.mR (.sub (.var degreeRegister) (.lit 1))) σ2 τ 4 :=
    Run.assign (evalB_bin hread2 (evalB_lit h1W) (by change n-1<W;omega))
  have hrun : Run W setupProgram σ τ 10 := (r1.seq (r2.seq r3)).mono (by omega)
  have hslots : Slots (presentation p) canonical nq.WS Sn W τ := by
    apply Internal.N0339.N0493.Slots.transport hs
    all_goals simp only [τ,σ2,σ1,vars_setVar,arrs_setVar,ite_false,show canonical.e≠kq.WS by decide,
      show canonical.e≠uw.nR by decide,show canonical.e≠uw.mR by decide,
      show canonical.p≠kq.WS by decide,show canonical.p≠uw.nR by decide,show canonical.p≠uw.mR by decide,
      show canonical.modBase≠kq.WS by decide,show canonical.modBase≠uw.nR by decide,show canonical.modBase≠uw.mR by decide,
      show canonical.exp≠kq.WS by decide,show canonical.exp≠uw.nR by decide,show canonical.exp≠uw.mR by decide,
