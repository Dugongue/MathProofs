theorem prefix_polynomial (J : CPolynomial ℚ) (n : ℕ) :
    rationalOfList (List.replicate n 0++J.val.toList)=CPolynomial.X^n*J := by
  apply CPolynomial.eq_iff_coeff.mpr
  intro i
  rw [rationalOfList_coeff,CPolynomial.coeff_toPoly,CPolynomial.toPoly_mul,
    CPolynomial.toPoly_pow,CPolynomial.X_toPoly,Polynomial.coeff_X_pow_mul']
  by_cases hi : n ≤ i
  · rw [List.getD_append_right _ _ _ _ (by simpa using hi)]
    simp only [List.length_replicate,stored_getD,if_pos hi]
    exact CPolynomial.coeff_toPoly J _
  · rw [List.getD_append _ _ _ _ (by simpa using Nat.lt_of_not_ge hi)]
    simp [hi]

theorem prefix_stored (J : CPolynomial ℚ) (n : ℕ) :
    N0396.trimRat (List.replicate n 0++J.val.toList)=
      (CPolynomial.X^n*J).val.toList := by
  rw [N0398.trimRat_exact,prefix_polynomial]
