def dst (q : RNames) : Expr := plus (plus (.lit 5) (.var q.n)) (.var q.pv)
def src (q : RNames) : Expr := plus (plus (plus (.lit 5) (.var q.n)) (.var q.n)) (.var q.w)

def cancelBranch (q : RNames) : Com :=
  .seq (.assign q.N (.sub (.var q.n) (.var q.w)))
