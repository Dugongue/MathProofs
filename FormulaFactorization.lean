      rcases Nat.lt_or_ge (a.toNat + b.toNat) UInt64.word with hlt | hle
      · have hs : (UInt64.addCarry a b false).1.toNat = a.toNat + b.toNat := by
          rw [hfst, Nat.mod_eq_of_lt hlt]
