theorem beqCoeffs_iff_eq {a b : DensePoly R} : beqCoeffs a b = true ↔ a = b := by
  constructor
  · exact eq_of_beqCoeffs
  · intro h
    subst h
    unfold beqCoeffs
    rw [Bool.and_eq_true]
    constructor
    · exact beq_self_eq_true a.size
    · rw [List.all_eq_true]
      intro i _
      exact decide_eq_true rfl

