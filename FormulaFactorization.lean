  rw [binarySource_length]
  have h := N0047.radialClusterFormula_uniform_bitCost variableWeight a A B hA hAB N f
  apply h.trans
  have hi := input_bill_le_binary f
  unfold decoderBudget N0047.uniformOutputBudget
  apply N0046.outputBudget_mono_source
  unfold N0046.perturbationBudget
  gcongr

