def PreservesDispatch {N : Nat} {L : Type}
    (stmt : TM2.Stmt (fun _ : CoreStack => SparseSymbol) L
      (FullInterpreterState N)) : Prop :=
  ∀ state tapes, FullInterpreterState.dispatchLens.get
