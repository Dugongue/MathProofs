    encInt encBool 1 1 :=
  ((headD (enc₁ := encBool) false).comp
    (of_linear (.of_take_one (f := fun z : ℤ => (encInt z).take 1) (encOut := encBits)
      fun _ => rfl))).mono

lemma int_tailEmpty : ComputableTidilyInDegree (fun z : ℤ => (encInt z).tail.isEmpty)
    encInt encBool 1 1 :=
