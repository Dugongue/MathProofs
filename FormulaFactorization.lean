/-  Numeric reverse fiber as a copied formula table. -/
def fiberSource {ι : Type} (A : NumericPolynomial) : N0090.Formula (Option ι) :=
  N0344.tableFormula A.natDegree (fun j => .const (A.coeff (A.natDegree-j)))

/-  Actual finite log source; degree p² before projection is paid. -/
def fiberLogSource {ι : Type} (A : NumericPolynomial) : N0090.Formula (Option ι) :=
  N0194.finiteLogFormula A.natDegree (.add (fiberSource A) (.const (-1)))

def fiberLogCoefficient {ι : Type} (A : NumericPolynomial) (k : ℕ) : N0090.Formula ι :=
  N0276.coefficientFormula (A.natDegree*A.natDegree) k (fiberLogSource A)

/-  Input E has Y as none; the output retains the same auxiliary slot for z. -/
def logSource {ι : Type} (A B : NumericPolynomial) (N d : ℕ)
    (E : N0090.Formula (Option ι)) : N0090.Formula (Option ι) :=
  N0344.tableFormula A.natDegree (fun k => if k = 0 then .const 0 else
    .add (fiberLogCoefficient A k) (N0625.clusterCorrectionFormula A B k N d E))

def expSource {ι : Type} (A B : NumericPolynomial) (N d : ℕ)
    (E : N0090.Formula (Option ι)) : N0090.Formula (Option ι) :=
  N0175.finiteExpFormula (A.natDegree+1) (logSource A B N d E)

/-  The pre-projection z degree p² is used, not the output degree p. -/
def reverseCoefficientSource {ι : Type} (A B : NumericPolynomial) (N d k : ℕ)
    (E : N0090.Formula (Option ι)) : N0090.Formula ι :=
  N0276.coefficientFormula (A.natDegree*A.natDegree) k (expSource A B N d E)

/-  Every t projection uses the actual source degree plus N; no truncated-degree assumption is made. -/
def clippedCoefficientSource {ι : Type} (A B : NumericPolynomial) (N d k : ℕ)
    (E : N0090.Formula (Option (Option ι))) : N0090.Formula ι :=
  let f := reverseCoefficientSource A B N d k E
  N0090.sum ((List.range (N+1)).map fun n =>
    N0276.coefficientFormula (N+f.formalDegree) n f)

/-  Full copied output in Y and original variables; the t jet is evaluated at one after clipping. -/
def clusterFormula {ι : Type} (A B : NumericPolynomial) (N d : ℕ)
    (E : N0090.Formula (Option (Option ι))) : N0090.Formula (Option ι) :=
  if A.natDegree = 0 then .const 1 else
    N0344.tableFormula A.natDegree (fun j =>
      clippedCoefficientSource A B N d (A.natDegree-j) E)

