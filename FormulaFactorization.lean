        returnLabel right w a ha m hm (sparseValue_mem_lt hm address)
        base state
  | ind address =>
      exact subtractInstruction_correct_of_operand_lt (.ind address) hN
        returnLabel right w a ha m hm (sparseValue_ind_lt hm address)
        base state
  | lit n =>
      by_cases hnlt : n < 2 ^ w
