theorem decode_degree (n : ℕ) (v : Fin n → R) : (decode n v).toPoly.degree<n := by
  rw [Polynomial.degree_lt_iff_coeff_zero]
  intro i hi
  rw [← CPolynomial.coeff_toPoly,decode_coeff,dif_neg (by omega)]

theorem decode_encode (n : ℕ) (P : CPolynomial R) (hP : P.toPoly.degree<n) :
    decode n (fun i=>P.coeff i.val)=P := by
  apply CPolynomial.eq_iff_coeff.mpr
  intro i
  rw [decode_coeff]
  split_ifs with hi
  · rfl
  · simpa only [← CPolynomial.coeff_toPoly] using
      (Polynomial.coeff_eq_zero_of_degree_lt
        (hP.trans_le (by exact_mod_cast Nat.le_of_not_gt hi))).symm

noncomputable def decodeLinear (n : ℕ) : (Fin n → R) →ₗ[R] R[X] where
  toFun v := (decode n v).toPoly
