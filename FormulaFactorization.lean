theorem fit_mono {B B' v u : ℕ} (hB : B ≤ B') (h : fit B v = some u) : fit B' v = some u := by
  rw [fit_eq_some] at h ⊢; exact ⟨h.1, by omega⟩

theorem Expr.evalB_mono {B B' : ℕ} (hB : B ≤ B') {σ : Env} :
    ∀ {e : Expr} {v : ℕ}, e.evalB B σ = some v → e.evalB B' σ = some v
  | .lit n, v, h => fit_mono hB h
  | .var x, v, h => fit_mono hB h
  | .get a i, v, h => by
    simp only [Expr.evalB, Option.bind_eq_some_iff] at h ⊢
    obtain ⟨k, hk, u, hu, hf⟩ := h
    exact ⟨k, Expr.evalB_mono hB hk, u, hu, fit_mono hB hf⟩
  | .bin op e f, v, h => by
    simp only [Expr.evalB, Option.bind_eq_some_iff] at h ⊢
    obtain ⟨m, hm, n, hn, hf⟩ := h
    exact ⟨m, Expr.evalB_mono hB hm, n, Expr.evalB_mono hB hn, fit_mono hB hf⟩

theorem Cond.evalB_mono {B B' : ℕ} (hB : B ≤ B') {σ : Env} {b : Cond} {r : Bool}
    (h : b.evalB B σ = some r) : b.evalB B' σ = some r := by
  cases b <;>
  · simp only [Cond.evalB, Option.bind_eq_some_iff, Option.map_eq_some_iff] at h ⊢
    obtain ⟨m, hm, n, hn, hr⟩ := h
    exact ⟨m, Expr.evalB_mono hB hm, n, Expr.evalB_mono hB hn, hr⟩

theorem BigStepB.mono {B B' : ℕ} (hB : B ≤ B') {c : Com} {σ σ' : Env} {k : ℕ}
    (h : BigStepB B c σ σ' k) : BigStepB B' c σ σ' k := by
  induction h with
  | skip => exact .skip
  | assign he => exact .assign (Expr.evalB_mono hB he)
  | store hi he hk => exact .store (Expr.evalB_mono hB hi) (Expr.evalB_mono hB he) hk
  | seq _ _ ih ih' => exact .seq ih ih'
  | ite_true hb _ ih => exact .ite_true (Cond.evalB_mono hB hb) ih
  | ite_false hb _ ih => exact .ite_false (Cond.evalB_mono hB hb) ih
  | while_true hb _ _ ih ih' => exact .while_true (Cond.evalB_mono hB hb) ih ih'
  | while_false hb => exact .while_false (Cond.evalB_mono hB hb)
  | read h => exact .read h
  | write he => exact .write (Expr.evalB_mono hB he)

