                    (.assign cn.cc (plus (.var cn.cc) (.lit 1))))
                  .skip)
                (.assign cn.t (plus (.var cn.t) (.lit 1)))))))))

/-  **The compression program.** -/
def compressCom (M : FieldMacros F r) (q : RNames) (cn : CNames) : Com :=
  .seq (.assign cn.cc (.lit 0))
    (.seq (.assign cn.t (.lit 0)) (.while (.lt (.var cn.t) (.var cn.R)) (candBody M q cn)))




























































































































































































































































































































































































































































































































































































































