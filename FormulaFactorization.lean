section P25Clean0275




/-! Actual pairing on promised canonical rational polynomial sources.
The source decoder is a mathematical record witness only: the execution
certificates use the two already executed input-word computers unchanged. -/
namespace N0169.Computation.N0601
open Turing Internal.N0048
set_option autoImplicit false
set_option maxHeartbeats 500000
set_option backward.isDefEq.respectTransparency true
noncomputable section
attribute [local instance] Classical.propDecidable

abbrev Source := {P : CPolynomial ℚ // P.toPoly.Monic}
def sourceBits (I : Source) : List Bool := Encoding.rat.list.encode I.1.val.toList

theorem sourceBits_injective : Function.Injective sourceBits := by
  intro I J h
  have hw : I.1.val.toList = J.1.val.toList := Encoding.rat.list.encode_injective h
  apply Subtype.ext
  apply CPolynomial.ext
  exact Array.toList_inj.mp hw

noncomputable def sourceEncoding : Encoding Source where
  encode := sourceBits
  decode w := if h : ∃ I, sourceBits I = w then some (Classical.choose h) else none
  decode_encode I := by
    rw [dif_pos (show ∃ J, sourceBits J = sourceBits I from ⟨I,rfl⟩)]
    congr 1
    apply sourceBits_injective
    exact Classical.choose_spec (show ∃ J, sourceBits J = sourceBits I from ⟨I,rfl⟩)

theorem realized_pair {β γ : Type} (eb : Encoding β) (ec : Encoding γ)
    (f : Source → β) (g : Source → γ)
    (A : TM2ComputableInPolyTime sourceBits eb.encode f)
    (B : TM2ComputableInPolyTime sourceBits ec.encode g)
    (hA : ∀ k, Finite (A.tm.Γ k)) (hB : ∀ k, Finite (B.tm.Γ k)) :
    Realized sourceEncoding (eb.prod ec) (fun I => (f I,g I)) := by
  have ha : Realized sourceEncoding eb f := ⟨A,hA⟩
  have hb : Realized sourceEncoding ec g := ⟨B,hB⟩
  exact Realized.pair ha hb

/-  This constructor chooses an actual computer from the checked compiler;
its finite alphabets are obtained from that same witness. -/
noncomputable def pair_context {β γ : Type} (eb : Encoding β) (ec : Encoding γ)
    (f : Source → β) (g : Source → γ)
    (A : TM2ComputableInPolyTime sourceBits eb.encode f)
    (B : TM2ComputableInPolyTime sourceBits ec.encode g)
    (hA : ∀ k, Finite (A.tm.Γ k)) (hB : ∀ k, Finite (B.tm.Γ k)) :
    TM2ComputableInPolyTime sourceBits (eb.prod ec).encode (fun I => (f I,g I)) :=
  Classical.choose (realized_pair eb ec f g A B hA hB)

theorem pair_context_finite {β γ : Type} (eb : Encoding β) (ec : Encoding γ)
    (f : Source → β) (g : Source → γ)
    (A : TM2ComputableInPolyTime sourceBits eb.encode f)
    (B : TM2ComputableInPolyTime sourceBits ec.encode g)
    (hA : ∀ k, Finite (A.tm.Γ k)) (hB : ∀ k, Finite (B.tm.Γ k)) :
    ∀ k, Finite ((pair_context eb ec f g A B hA hB).tm.Γ k) :=
  Classical.choose_spec (realized_pair eb ec f g A B hA hB)

end
