theorem reduceList_row_other {n d} (B : IntBasis n d) (i : Fin n) (js : List (Fin n))
    (r : Fin n) (hri : r ≠ i) : (reduceList B i js) r=B r := by
  induction js generalizing B with
  | nil => rfl
  | cons j js ih =>
    simp only [reduceList,List.foldl_cons]
    split_ifs with hji
    · exact (ih _).trans (by funext c;simp [computedShear,shear,hri])
    · exact ih B

theorem normalizeList_row_other {n d} (B : IntBasis n d) (is : List (Fin n)) (r : Fin n)
    (hother : ∀ i ∈ is, r ≠ i) : (normalizeList B is) r=B r := by
  induction is generalizing B with
  | nil => rfl
  | cons i is ih =>
    simp only [normalizeList,List.foldl_cons]
    exact (ih _ (fun j hj => hother j (List.mem_cons_of_mem i hj))).trans
      (by rw [fastReduceList_correct];exact reduceList_row_other B i _ r (hother i List.mem_cons_self))

theorem finite_prefix_data {n} (i : Fin n) (left right : List (Fin n))
    (hsplit : List.finRange n=left++i::right) :
    left.Pairwise (· < ·) ∧ (∀ r ∈ left, r < i) ∧ (∀ r : Fin n, r < i → r ∈ left) := by
  have hp : (left++i::right).Pairwise (· < ·) := by rw [← hsplit];exact List.pairwise_lt_finRange n
  obtain ⟨hl,hr,hcross⟩ := List.pairwise_append.mp hp
  refine ⟨hl,fun r hrl => hcross r hrl i List.mem_cons_self,?_⟩
  intro r hri
  have hm : r ∈ left++i::right := by rw [← hsplit];exact List.mem_finRange r
  rcases List.mem_append.mp hm with hm | hm
  · exact hm
  · rcases List.mem_cons.mp hm with he | hrr
    · subst r;exact (lt_irrefl _ hri).elim
    · have hir := (List.pairwise_cons.mp hr).1 r hrr
      exact (lt_asymm hri hir).elim

theorem outer_prefix_reduced {n d} (B : IntBasis n d) (hB : FullRank B) (i : Fin n)
    (left right : List (Fin n)) (hsplit : List.finRange n=left++i::right) :
    PrefixReduced (normalizeList B left) i := by
  have hp := finite_prefix_data i left right hsplit
  intro r hri k hkr
  exact normalizeList_sets B left hp.1 hB r (hp.2.2 r hri) k hkr

theorem rows_eq_of_row_eq {n d} (B C : IntBasis n d) (i : Fin n) (h : B i=C i) :
    N0297.rows B i=N0297.rows C i := by
  change WithLp.toLp 2 (fun c => (B i c:ℝ))=WithLp.toLp 2 (fun c => (C i c:ℝ))
  congr 1
  funext c
  exact congrArg (fun z : ℤ => (z:ℝ)) (congrFun h c)

/-  All width inputs for an actual outer prefix are derived from the original
round input and its literal finite list decomposition. -/
theorem outer_prefix_width_data {n d} (B : IntBasis n d) (hB : FullRank B) (i : Fin n)
    (left right : List (Fin n)) (hsplit : List.finRange n=left++i::right)
    (Phi M : ℝ) (hPhi : (potential B:ℝ) ≤ Phi)
    (hM : ∀ r : Fin n, ‖N0297.rows B r‖^2 ≤ M) :
    FullRank (normalizeList B left) ∧ PrefixReduced (normalizeList B left) i ∧
    (∀ k : Fin n, k < i → |ratio (normalizeList B left) i k|≤Phi*M+2) ∧
    TargetWidth (normalizeList B left) i M ∧ EarlierWidth (normalizeList B left) i ((n+1:ℝ)*Phi) := by
  let C := normalizeList B left
  have hC : FullRank C := normalizeList_fullRank B left hB
  have hp := finite_prefix_data i left right hsplit
  have hrow : C i=B i := normalizeList_row_other B left i (fun r hr => Fin.ne_of_gt (hp.2.1 r hr))
  have hreal := rows_eq_of_row_eq C B i hrow
  have hpot : potential C=potential B := normalizeList_potential B left
  have hbase : (0:ℝ) ≤ (potential B:ℝ) := by exact_mod_cast (potential_pos B hB).le
  have hPhi0 : 0 ≤ Phi := hbase.trans hPhi
  have hM0 : 0 ≤ M := (sq_nonneg _).trans (hM i)
  refine ⟨hC,outer_prefix_reduced B hB i left right hsplit,?_,?_,?_⟩
  · intro k hki
    have hh := initial_ratio_abs C hC i k hki
    rw [hpot,hreal] at hh
    have hm : (potential B:ℝ)*‖N0297.rows B i‖^2 ≤ Phi*M :=
      mul_le_mul hPhi (hM i) (sq_nonneg _) hPhi0
    linarith
  · intro c
    have hh := coordinate_le_norm C i c
    rw [hreal] at hh
    exact hh.trans (hM i)
