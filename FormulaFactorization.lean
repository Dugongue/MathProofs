def symbol (a : Option Bool) : ℕ := match a with | none => 0 | some false => 1 | some true => 2

theorem symbol_lt (a : Option Bool) : symbol a < 4 := by cases a with | none => decide | some b => cases b <;> decide

theorem symbol_injective : Function.Injective symbol := by
  intro a b he
  fin_cases a <;> fin_cases b <;> simp_all [symbol]

def listCode : List (Option Bool) → ℕ
  | [] => 0
  | a::s => symbol a+4*listCode s

theorem listCode_append (s t : List (Option Bool)) : listCode (s++t)=listCode s+4^s.length*listCode t := by
  induction s with
  | nil => simp [listCode]
  | cons a s ih => simp only [List.cons_append,listCode,List.length_cons,pow_succ,ih];ring

