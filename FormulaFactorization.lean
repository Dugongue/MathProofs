namespace Internal.N0339.N0197.N0627

open Polynomial

/-  Stable finite-index array read. -/
def read {T : Type} {n : ℕ} (v : Vector T n) (i : Fin n) : T := v[i.val]

def last (q : ℕ) : Fin (q + 1) := ⟨q, by omega⟩

def predecessor {q : ℕ} (i : Fin (q + 1)) (hi : 0 < i.val) : Fin (q + 1) :=
  ⟨i.val - 1, by omega⟩

def shift {T : Type} [Zero T] {q : ℕ} (v : Vector T (q + 1)) (i : Fin (q + 1)) : T :=
  if hi : 0 < i.val then read v (predecessor i hi) else 0

/-  One literal companion step: shift minus the last entry times the low modulus coefficients. -/
def rationalStep {q : ℕ} (a v : Vector ℚ (q + 1)) : Vector ℚ (q + 1) :=
  Vector.ofFn (fun i => shift v i - read v (last q) * read a i)

/-  Integer numerators for the same step after clearing the fixed modulus denominator. -/
def integerStep {q : ℕ} (d : ℕ) (c z : Vector ℤ (q + 1)) : Vector ℤ (q + 1) :=
  Vector.ofFn (fun i => (d : ℤ) * shift z i - read z (last q) * read c i)

@[simp] theorem read_rationalStep {q : ℕ} (a v : Vector ℚ (q + 1)) (i : Fin (q + 1)) :
    read (rationalStep a v) i = shift v i - read v (last q) * read a i := by
  simp [read, rationalStep]

@[simp] theorem read_integerStep {q : ℕ} (d : ℕ) (c z : Vector ℤ (q + 1)) (i : Fin (q + 1)) :
    read (integerStep d c z) i = (d : ℤ) * shift z i - read z (last q) * read c i := by
  simp [read, integerStep]

/-  Every recursive call produces a complete fresh vector. -/
def rationalStates {q : ℕ} (a v : Vector ℚ (q + 1)) : ℕ → Vector ℚ (q + 1)
  | 0 => v
  | n + 1 => rationalStep a (rationalStates a v n)

def integerStates {q : ℕ} (d : ℕ) (c z : Vector ℤ (q + 1)) : ℕ → Vector ℤ (q + 1)
  | 0 => z
  | n + 1 => integerStep d c (integerStates d c z n)

theorem shift_natAbs_le {q : ℕ} (z : Vector ℤ (q + 1)) (H : ℕ)
