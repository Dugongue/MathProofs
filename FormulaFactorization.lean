/- Independent encoders and parsers for the specified binary wire formats.
Only the mathematical byte protocol is shared with the replaced interfaces. -/
namespace N0169.Computation
namespace Encoding
set_option autoImplicit false
set_option maxHeartbeats 600000

abbrev Bits := List Bool

def bits : Encoding Bits := ⟨id, some, fun _ => rfl⟩

def bool : Encoding Bool where
  encode b := [b]
  decode w := match w with | [b] => some b | _ => none
  decode_encode _ := rfl

/-  Little-endian binary evaluation, implemented as a right fold. -/
def binaryValue (w : Bits) : ℕ := w.foldr Nat.bit 0

@[simp] theorem binaryValue_bits (n : ℕ) : binaryValue n.bits = n := by
  induction n using Nat.binaryRec' with
  | zero => rfl
  | bit b n h ih => simpa [binaryValue,Nat.bits_append_bit n b h] using congrArg (Nat.bit b) ih

def nat : Encoding ℕ where
  encode := Nat.bits
  decode w := some (binaryValue w)
  decode_encode n := by simp only [binaryValue_bits]

/-  Each bit receives a true marker; a false marker ends the word. -/
def frame : Bits → Bits
  | [] => [false]
  | b::bs => true::b::frame bs

def unframe : Bits → Option (Bits × Bits)
  | [] => none
  | false::rest => some ([],rest)
  | true::[] => none
  | true::b::rest => (unframe rest).map (fun q => (b::q.1,q.2))

@[simp] theorem unframe_frame (a tail : Bits) : unframe (frame a ++ tail) = some (a,tail) := by
  induction a with
  | nil => rfl
  | cons b bs ih => simp only [frame,List.cons_append,unframe,ih,Option.map_some]

@[simp] theorem frame_length (a : Bits) : (frame a).length = 2*a.length+1 := by
  induction a with
  | nil => rfl
  | cons b bs ih => simp only [frame,List.length_cons,ih];omega

def prod {α β : Type} (ea : Encoding α) (eb : Encoding β) : Encoding (α × β) where
  encode p := frame (ea.encode p.1) ++ eb.encode p.2
  decode w := match unframe w with
    | none => none
    | some (left,right) => match ea.decode left,eb.decode right with
      | some a,some b => some (a,b)
      | _,_ => none
  decode_encode p := by
    rcases p with ⟨a,b⟩
    simp only [unframe_frame,ea.decode_encode,eb.decode_encode]

@[simp] theorem prod_length {α β : Type} (ea : Encoding α) (eb : Encoding β) (p : α × β) :
    ((prod ea eb).encode p).length = 2*(ea.encode p.1).length+(eb.encode p.2).length+1 := by
  simp only [prod,List.length_append,frame_length]
  omega

def frames (ws : List Bits) : Bits := ws.foldr (fun w acc => frame w ++ acc) []

@[simp] theorem frames_nil : frames [] = [] := rfl
@[simp] theorem frames_cons (w : Bits) (ws : List Bits) : frames (w::ws) = frame w ++ frames ws := rfl

@[simp] theorem frames_length (ws : List Bits) :
    (frames ws).length = 2*(ws.map List.length).sum+ws.length := by
  induction ws with
  | nil => rfl
  | cons w ws ih => simp only [frames_cons,List.length_append,frame_length,ih,List.map_cons,List.sum_cons,List.length_cons];omega

/-  Count-directed parsing still consumes each element's actual framed word. -/
def readFrames {α : Type} (ea : Encoding α) : ℕ → Bits → Option (List α × Bits)
  | 0,w => some ([],w)
  | n+1,w => do
    let (word,tail) ← unframe w
    let a ← ea.decode word
    let (as,rest) ← readFrames ea n tail
    pure (a::as,rest)

@[simp] theorem readFrames_encode {α : Type} (ea : Encoding α) (xs : List α) (tail : Bits) :
    readFrames ea xs.length (frames (xs.map ea.encode) ++ tail) = some (xs,tail) := by
  induction xs with
  | nil => rfl
  | cons a xs ih =>
    simp [List.length_cons,List.map_cons,frames_cons,List.append_assoc,readFrames,
      unframe_frame,ea.decode_encode,ih]

def list {α : Type} (ea : Encoding α) : Encoding (List α) where
  encode xs := frame xs.length.bits ++ frames (xs.map ea.encode)
  decode w := do
    let (count,tail) ← unframe w
    let (xs,rest) ← readFrames ea (binaryValue count) tail
    if rest = [] then some xs else none
