/-  Semantic polynomial of an actual companion array. -/
noncomputable def polynomial {q : ℕ} (v : Vector ℚ (q + 1)) : ℚ[X] :=
  Polynomial.ofFn (q + 1) (read v)

/-  The monic modulus encoded by the low coefficient array. -/
noncomputable def modulus {q : ℕ} (a : Vector ℚ (q + 1)) : ℚ[X] :=
  X ^ (q + 1) + polynomial a

@[simp] theorem polynomial_coeff_lt {q : ℕ} (v : Vector ℚ (q + 1)) {n : ℕ} (hn : n < q + 1) :
    (polynomial v).coeff n = read v ⟨n, hn⟩ :=
  Polynomial.ofFn_coeff_eq_val_of_lt _ hn

@[simp] theorem polynomial_coeff_ge {q : ℕ} (v : Vector ℚ (q + 1)) {n : ℕ} (hn : q + 1 ≤ n) :
    (polynomial v).coeff n = 0 :=
  Polynomial.ofFn_coeff_eq_zero_of_ge _ hn

theorem polynomial_degree_lt {q : ℕ} (v : Vector ℚ (q + 1)) :
    (polynomial v).degree < (q + 1 : ℕ) :=
  Polynomial.ofFn_degree_lt _

theorem modulus_monic {q : ℕ} (a : Vector ℚ (q + 1)) : (modulus a).Monic := by
  apply (Polynomial.monic_X_pow (q + 1)).add_of_left
