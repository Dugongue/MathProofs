def erase [Zero R] [BEq R] [LawfulBEq R] (n : ℕ) (p : CPolynomial R) : CPolynomial R :=
  let arr : CPolynomial.Raw R := p.val.setIfInBounds n 0
  ⟨arr.trim, N0654.isCanonical_trim arr⟩

