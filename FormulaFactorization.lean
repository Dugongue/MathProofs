    (hprime : ∀ i, Prime (g i)) (hsep : ∀ i j, i ≠ j → ¬ g i ∣ g j)
    (he : ∀ i, 0 < e i)
    (hprod : (∏ i ∈ s, (g i)^e i) = ∏ i ∈ t, (g i)^e i) : s = t := by
  apply Finset.ext
  intro i
  rw [← prime_dvd_product_iff_mem s g e hprime hsep he i,
    ← prime_dvd_product_iff_mem t g e hprime hsep he i, hprod]

