      simp only [N0387.test, integerTest, Matrix.reindex_apply]
      simpa only [Int.cast_natCast, Matrix.submatrix_apply] using
        N0275.padded_cast (K := CyclotomicRing.R e) (CyclotomicRing.dimension e)
          N (a.val : ℤ) (x 0 : ℤ) _ _)
