  simp only [Algebra.algebraMap_self] at h
  rw [h, directionSource_polynomial, ← polynomial_eval₂]
  simp only [Algebra.algebraMap_self, RingHom.comp_id]
  have henv : directionEnvironment a = fun v : Option ι => C (v.elim 1 a) * X := by
    funext v
    cases v with
    | none => simp only [directionEnvironment, Option.elim_none, map_one, one_mul]
    | some i => rfl
