        rw [CPolynomial.coeff_toPoly]
        exact Polynomial.coeff_eq_zero_of_natDegree_lt
          (by rw [← CPolynomial.natDegree_toPoly]; exact (hP.2 t).trans_lt (Nat.lt_of_not_ge hy))
