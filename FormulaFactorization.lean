    (hc : IsCoprime (reduce (p:=p) H).toPoly (reduce (p:=p) K).toPoly) :
    (step (p:=p) q P H K).1.toPoly.Monic ∧ (step (p:=p) q P H K).2.toPoly.Monic ∧
