      obtain ⟨hhead, htail, hnext⟩ := sub_borrow_head_tail a b borrow h
      simp only [fixedBits, subBits]
      rw [hhead, htail]
      apply congrArg ((fullSubtractor a.bodd b.bodd borrow).1 :: ·)
