    Fits p a' q := ha ▸ h

theorem fits_singleton {p : Program} {a : ℕ} {ins : Instr} :
    Fits p a [ins] ↔ p[a]? = some ins := by
  constructor
  · exact fun h => h.head
  · intro h i hi
    have : i = 0 := by simp at hi; omega
    subst this
    simpa using h

theorem fits_self (q r : Program) : Fits (q ++ r) 0 q := by
  intro i hi
  simpa using List.getElem?_append_left (l₂ := r) hi

