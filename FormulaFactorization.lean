    rw [Nat.cast_add (R := CPolynomial R) n 1,
      Nat.cast_one (R := CPolynomial R),
      Nat.cast_add (R := R) n 1,
      Nat.cast_one (R := R), ih, eq_iff_coeff]
    intro i
    simp only [coeff_add, coeff_C, coeff_one]
