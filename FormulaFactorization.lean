theorem coeff_product_sum (s : Finset κ) (P : κ → R[X]) (n : κ → ℕ)
    (hP : ∀ i ∈ s, (P i).natDegree ≤ n i) :
    (∏ i ∈ s, P i).coeff (∑ i ∈ s, n i) = ∏ i ∈ s, (P i).coeff (n i) := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
      have htail : ∀ j ∈ s, (P j).natDegree ≤ n j := fun j hj => hP j (by simp [hj])
      have hdeg : (∏ j ∈ s, P j).natDegree ≤ ∑ j ∈ s, n j :=
        (Polynomial.natDegree_prod_le _ _).trans (Finset.sum_le_sum htail)
      rw [Finset.prod_insert hi, Finset.sum_insert hi,
        Polynomial.coeff_mul_add_eq_of_natDegree_le (hP i (by simp)) hdeg, ih htail, Finset.prod_insert hi]

theorem powerProduct_degree (s : κ →₀ ℕ) (P : κ → R[X]) (hP : ∀ i, (P i).natDegree ≤ 1) :
    (s.prod fun i e => P i ^ e).natDegree ≤ s.sum (fun _ e => e) := by
  classical
  exact (Polynomial.natDegree_prod_le _ _).trans (Finset.sum_le_sum (fun i hi =>
    Polynomial.natDegree_pow_le.trans (by simpa only [Nat.mul_one] using Nat.mul_le_mul_left (s i) (hP i))))

theorem powerProduct_top (s : κ →₀ ℕ) (P : κ → R[X]) (hP : ∀ i, (P i).natDegree ≤ 1) :
    (s.prod fun i e => P i ^ e).coeff (s.sum fun _ e => e) =
      s.prod (fun i e => (P i).coeff 1 ^ e) := by
  classical
  rw [show (s.prod fun i e => P i ^ e).coeff (s.sum fun _ e => e) =
      ∏ i ∈ s.support, (P i ^ s i).coeff (s i) from
    coeff_product_sum s.support (fun i => P i ^ s i) (fun i => s i)
      (fun i hi => Polynomial.natDegree_pow_le.trans (by
        simpa only [Nat.mul_one] using Nat.mul_le_mul_left (s i) (hP i)))]
  apply Finset.prod_congr rfl
  intro i hi
  simpa only [Nat.mul_one] using (Polynomial.coeff_pow_of_natDegree_le (p := P i) (m := s i) (hP i))

/-  At the total-degree bound, only linear slopes matter; constant offsets contribute nothing. -/
theorem top_coefficient_same_slopes (G : MvPolynomial κ ℚ) (d : ℕ) (hG : G.totalDegree ≤ d)
    (c : ℚ →+* R) (P Q : κ → R[X])
    (hP : ∀ i, (P i).natDegree ≤ 1) (hQ : ∀ i, (Q i).natDegree ≤ 1)
    (hslopes : ∀ i, (P i).coeff 1 = (Q i).coeff 1) :
    (MvPolynomial.eval₂ (Polynomial.C.comp c) P G).coeff d =
      (MvPolynomial.eval₂ (Polynomial.C.comp c) Q G).coeff d := by
  classical
  conv_lhs => rw [MvPolynomial.as_sum G]
  conv_rhs => rw [MvPolynomial.as_sum G]
  rw [MvPolynomial.eval₂_sum, MvPolynomial.eval₂_sum, finsetSum_coeff, finsetSum_coeff]
  apply Finset.sum_congr rfl
  intro s hs
  rw [MvPolynomial.eval₂_monomial, MvPolynomial.eval₂_monomial]
  change (C (c (G.coeff s)) * s.prod (fun i e => P i ^ e)).coeff d =
    (C (c (G.coeff s)) * s.prod (fun i e => Q i ^ e)).coeff d
  rw [Polynomial.coeff_C_mul, Polynomial.coeff_C_mul]
  have hsd : s.sum (fun _ e => e) ≤ d := (MvPolynomial.le_totalDegree hs).trans hG
  by_cases heq : s.sum (fun _ e => e) = d
  · rw [← heq, powerProduct_top s P hP, powerProduct_top s Q hQ]
    congr 1
    apply Finset.prod_congr rfl
    intro i hi
    change (P i).coeff 1 ^ (s i) = (Q i).coeff 1 ^ (s i)
    rw [hslopes i]
  · have hlt : s.sum (fun _ e => e) < d := by omega
    rw [Polynomial.coeff_eq_zero_of_natDegree_lt ((powerProduct_degree s P hP).trans_lt hlt),
      Polynomial.coeff_eq_zero_of_natDegree_lt ((powerProduct_degree s Q hQ).trans_lt hlt)]

