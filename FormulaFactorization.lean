theorem PowerInput.inputBuffer_run (h : PowerInput F r B σ) :
    Run B (bufferStore r 2 (.get r.mem (address r.aBase r.j))) σ
      (storedBuffer r σ 2 (sourceCoeff σ r.mem r.aBase)) (100*(F.e+1)) := by
  have hh:=h.outer_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hek:r.e≠r.k:=by tauto
  have hej:r.e≠r.j:=by tauto
  have hkj:r.k≠r.j:=by tauto
  have hak:r.aBase≠r.k:=by tauto
  have haj:r.aBase≠r.j:=by tauto
  have hf:=h.scratch_fit
  have hw:=h.scratch_word
  have he:=F.degree_pos
  have hp:F.p<B:=by have hh:=h.arithmetic_word; nlinarith
  have hr:=bufferStore_run r (B:=B) σ 2 (.get r.mem (address r.aBase r.j))
    (sourceCoeff σ r.mem r.aBase) hek hej hkj
    (by rw [h.degree]; omega) (by omega) (by rw [h.degree]; omega) h.scratch_word
    (by rw [h.degree]; omega) (by
      intro j hj
      let ξ:=σ.setVar r.k (2*σ.vars r.e)
      let f:=sourceCoeff σ r.mem r.aBase
      let τ:=pointState ξ (workNames r) f j
      have hav:τ.vars r.aBase=σ.vars r.aBase:=by simp [τ,ξ,pointState,workNames,hak,haj]
      have hjv:τ.vars r.j=j:=by simp [τ,pointState,workNames]
      have hidx:σ.vars r.aBase+j<(σ.arrs r.mem).length:=by
        have hfit:=h.first_fit; rw [h.degree] at hj; omega
      have hidxB:σ.vars r.aBase+j<B:=hidx.trans h.memory_word
      have hi:(address r.aBase r.j).evalB B τ=some (σ.vars r.aBase+j):=by
        have hleft:(Expr.var r.aBase).evalB B τ=some (σ.vars r.aBase):=by
          simpa only [hav] using evalB_var (σ:=τ) (x:=r.aBase) (by rw [hav]; omega)
        have hright:(Expr.var r.j).evalB B τ=some j:=by
          simpa only [hjv] using evalB_var (σ:=τ) (x:=r.j) (by rw [hjv]; omega)
        exact evalB_bin (op:=Bop.add) hleft hright hidxB
      have hv:(σ.arrs r.mem).getD (σ.vars r.aBase+j) 0<B:=
        (h.first_canonical ⟨j,by simpa only [h.degree] using hj⟩).trans hp
      have ht:=pointState_get_evalB (workNames r) ξ f r.mem (address r.aBase r.j) hi hidx
        (Or.inl h.separate) hv
      simpa only [sourceCoeff, ξ, f, arrs_setVar] using ht)
  apply hr.mono
  simp only [address,Expr.size,h.degree]
  omega

def fillExpr (r : FieldNames) (identity : Bool) : Expr :=
  if identity then .sub (.lit 1) (.var r.j) else .lit 0

def fillValue (identity : Bool) (j : Nat) : Nat := if identity then 1-j else 0

theorem PowerInput.fillBuffer_run (h : PowerInput F r B σ) {n : Nat}
    (hn : n∈[3,4]) (identity : Bool) :
    Run B (bufferStore r n (fillExpr r identity)) σ
      (storedBuffer r σ n (fillValue identity)) (100*(F.e+1)) := by
  have hh:=h.outer_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hek:r.e≠r.k:=by tauto
  have hej:r.e≠r.j:=by tauto
  have hkj:r.k≠r.j:=by tauto
  have hnb:3≤n ∧ n≤4:=by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hn; omega
  have hf:=h.scratch_fit
  have hw:=h.scratch_word
  have he:=F.degree_pos
  have h1:1<B:=by omega
  have hr:=bufferStore_run r (B:=B) σ n (fillExpr r identity) (fillValue identity) hek hej hkj
    (by rw [h.degree]; omega) (by omega) (by rw [h.degree]; nlinarith) h.scratch_word
    (by rw [h.degree]; nlinarith) (by
      intro j hj
      let τ:=pointState (σ.setVar r.k (n*σ.vars r.e)) (workNames r) (fillValue identity) j
      have hjv:τ.vars r.j=j:=by simp [τ,pointState,workNames]
      have hjB:j<B:=by rw [h.degree] at hj; omega
      cases identity
      · exact evalB_lit (by omega)
      · have hright:(Expr.var r.j).evalB B τ=some j:=by
          simpa only [hjv] using evalB_var (σ:=τ) (x:=r.j) (by rw [hjv]; exact hjB)
        exact evalB_bin (op:=Bop.sub) (evalB_lit h1) hright (by change 1-j<B; omega))
  apply hr.mono
  cases identity <;> simp [fillExpr,Expr.size,h.degree] <;> omega

theorem PowerInput.stored_same (h : PowerInput F r B σ) {n : Nat}
    (hn : n∈[2,3,4]) (f : Nat→Nat) :
    bufferCoeffs F r (storedBuffer r σ n f) n=fun i=>f i.val := by
  have hnb:2≤n ∧ n≤4:=by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hn; omega
  funext i
  have hh:=storedBuffer_output r σ n f
    (by rw [h.degree]; have hf:=h.scratch_fit; nlinarith)
    (j:=i.val) (by simpa only [h.degree] using i.isLt)
  simpa only [bufferCoeffs,h.degree] using hh

theorem PowerInput.stored_other (h : PowerInput F r B σ) {n k : Nat}
    (hn : n∈[2,3,4]) (hk : k≠n) (f : Nat→Nat) :
    bufferCoeffs F r (storedBuffer r σ k f) n=bufferCoeffs F r σ n := by
  have hnb:2≤n ∧ n≤4:=by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hn; omega
  funext i
  apply storedBuffer_read r σ k f r.scratch (n*F.e+i.val)
  · have hf:=h.scratch_fit; have hi:=i.isLt; nlinarith
  · right
    rw [h.degree]
    have hi:=i.isLt
    rcases lt_or_gt_of_ne hk with hl|hl
    · right; nlinarith
    · left; nlinarith

def expState (r : FieldNames) (σ : Env) (n : Nat) : Env := σ.setVar r.exponent n

def baseState (r : FieldNames) (σ : Env) (n : Nat) : Env :=
  storedBuffer r (expState r σ n) 2 (sourceCoeff (expState r σ n) r.mem r.aBase)

def oneState (r : FieldNames) (σ : Env) (n : Nat) : Env :=
  storedBuffer r (baseState r σ n) 3 (fillValue true)

def initialState (r : FieldNames) (σ : Env) (n : Nat) : Env :=
  storedBuffer r (oneState r σ n) 4 (fillValue false)

theorem PowerInput.expState (h : PowerInput F r B σ) (n : Nat) :
    PowerInput F r B (expState r σ n) := h.setExponent n

theorem PowerInput.baseState (h : PowerInput F r B σ) (n : Nat) :
    PowerInput F r B (baseState r σ n) := (h.expState n).buffer_preserves _ _

theorem PowerInput.oneState (h : PowerInput F r B σ) (n : Nat) :
    PowerInput F r B (oneState r σ n) := (h.baseState n).buffer_preserves _ _

theorem PowerInput.initialState (h : PowerInput F r B σ) (n : Nat) :
    PowerInput F r B (initialState r σ n) := (h.oneState n).buffer_preserves _ _

theorem initialState_vars (r : FieldNames) (σ : Env) (n : Nat) (x : String)
    (hk : x≠r.k) (hj : x≠r.j) (he : x≠r.exponent) :
    (initialState r σ n).vars x=σ.vars x := by
  simp only [initialState,oneState,baseState,storedBuffer_vars r _ _ _ x hk hj]
  simp [expState,he]

theorem initialState_exponent (h : PowerInput F r B σ) (n : Nat) :
    (initialState r σ n).vars r.exponent=n := by
  have hh:=h.outer_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hk:r.exponent≠r.k:=by tauto
  have hj:r.exponent≠r.j:=by tauto
  simp only [initialState,oneState,baseState,storedBuffer_vars r _ _ _ r.exponent hk hj]
  simp [expState]

theorem initialState_memory (h : PowerInput F r B σ) (n : Nat) :
    (initialState r σ n).arrs r.mem=σ.arrs r.mem := by
  simp only [initialState,oneState,baseState,storedBuffer_memory r _ _ _ h.separate]
  rfl

theorem initializePower_run (h : PowerInput F r B σ) (exponent : Expr) (n : Nat)
    (hex : exponent.evalB B σ=some n) :
    Run B (initializePower r exponent) σ (initialState r σ n)
      (300*(F.e+1)+exponent.size+1) := by
  have ha:=Run.assign (x:=r.exponent) hex
  have hb:=(h.expState n).inputBuffer_run
  have hc:=(h.baseState n).fillBuffer_run (n:=3) (by simp) true
  have hd:=(h.oneState n).fillBuffer_run (n:=4) (by simp) false
  exact (ha.seq (hb.seq (hc.seq hd))).mono (by omega)

theorem initialState_coefficients (h : PowerInput F r B σ) (n : Nat) :
    bufferCoeffs F r (initialState r σ n) 2=
      N0520.slice F σ r (σ.vars r.aBase) ∧
    bufferCoeffs F r (initialState r σ n) 3=(fun i=>1-i.val) ∧
    bufferCoeffs F r (initialState r σ n) 4=(fun _=>0) := by
  have hh:=h.outer_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hae:r.aBase≠r.exponent:=by tauto
  constructor
  · unfold initialState
    rw [(h.oneState n).stored_other (by simp) (by decide)]
    unfold oneState
    rw [(h.baseState n).stored_other (by simp) (by decide)]
    unfold baseState
    rw [(h.expState n).stored_same (by simp)]
    funext i
    simp [sourceCoeff,expState,hae,N0520.slice]
  · constructor
    · unfold initialState
      rw [(h.oneState n).stored_other (by simp) (by decide)]
      unfold oneState
      rw [(h.baseState n).stored_same (by simp)]
      rfl
    · unfold initialState
      rw [(h.oneState n).stored_same (by simp)]
      rfl

theorem initialState_bufferInput (h : PowerInput F r B σ) (n : Nat) (hn : n<B) :
    BufferInput F r B (initialState r σ n) := by
  have hi:=h.initialState n
  refine {
    degree:=hi.degree,prime:=hi.prime,separate:=hi.separate,outer_names:=hi.outer_names,
    inner_names:=hi.inner_names,private_names:=hi.private_names,arithmetic_word:=hi.arithmetic_word,
    memory_word:=hi.memory_word,scratch_word:=hi.scratch_word,scratch_fit:=hi.scratch_fit,
    modulus_fit:=hi.modulus_fit,modulus_value:=hi.modulus_value,
    buffer_canonical:=?_,exponent_word:=?_ }
  · intro k hk j hj
    have hc:=initialState_coefficients h n
    simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hk
    rcases hk with rfl|rfl|rfl
    · have he:=congrFun hc.1 ⟨j,hj⟩
      exact he.trans_lt (h.first_canonical ⟨j,hj⟩)
    · have he:=congrFun hc.2.1 ⟨j,hj⟩
      change (bufferCoeffs F r (initialState r σ n) 3 ⟨j,hj⟩)<F.p
      rw [he]
      have hp:=F.prime.two_le; omega
    · have he:=congrFun hc.2.2 ⟨j,hj⟩
      exact he.trans_lt F.prime.pos
  · rw [initialState_exponent h]; exact hn

theorem decode_identity (F : FieldPresentation K) :
    N0520.decode F (fun i=>1-i.val)=1 := by
  unfold N0520.decode
  let z:Fin F.e:=⟨0,F.degree_pos⟩
  rw [Finset.sum_eq_single z]
  · simp [z]
  · intro i hi hiz
    have hv : 0 < i.val:=by
      by_contra hh
      have hi0:i.val=0:=by omega
      exact hiz (Fin.ext hi0)
    simp [show 1-i.val=0 by omega]
  · simp

theorem initialState_values (h : PowerInput F r B σ) (n : Nat) :
    bufferValue F r (initialState r σ n) 2=
      N0520.decode F
        (N0520.slice F σ r (σ.vars r.aBase)) ∧
      bufferValue F r (initialState r σ n) 3=1 := by
  have hc:=initialState_coefficients h n
  unfold bufferValue
  rw [hc.1,hc.2.1,decode_identity]
  exact ⟨rfl,rfl⟩

def finalState (r : FieldNames) (σ : Env) : Env :=
  pointState σ (finishNames r)
    (fun j=>(σ.arrs r.scratch).getD (3*σ.vars r.e+j) 0) (σ.vars r.e)

theorem finishPower_run (h : BufferInput F r B σ)
    (hout : σ.vars r.outBase+F.e ≤ (σ.arrs r.mem).length) :
    Run B (storeLoop (finishNames r) (.get r.scratch (.add (buffer r 3) (.var r.j)))) σ
      (finalState r σ) (100*(F.e+1)) := by
  have hh:=h.outer_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hej:r.e≠r.j:=by tauto
  have hoj:r.outBase≠r.j:=by tauto
  have hf:=h.scratch_fit
  have hw:=h.scratch_word
  have he:=F.degree_pos
  have hp:F.p<B:=by have hh:=h.arithmetic_word; nlinarith
  let f:Nat→Nat:=fun j=>(σ.arrs r.scratch).getD (3*σ.vars r.e+j) 0
  have hr:=storeLoop_run (finishNames r) (.get r.scratch (.add (buffer r 3) (.var r.j)))
    (B:=B) σ f hoj hej (by change σ.vars r.e<B; rw [h.degree]; omega) h.memory_word
    (by change σ.vars r.outBase+σ.vars r.e ≤ (σ.arrs r.mem).length; rw [h.degree]; exact hout)
    (by
      intro j hj
      change j<σ.vars r.e at hj
      let τ:=pointState σ (finishNames r) f j
      have hev:τ.vars r.e=σ.vars r.e:=by simp [τ,pointState,finishNames,hej]
      have hjv:τ.vars r.j=j:=by simp [τ,pointState,finishNames]
      have h3:3<B:=by omega
      have heB:σ.vars r.e<B:=by rw [h.degree]; omega
      have hprod:3*σ.vars r.e<B:=by rw [h.degree]; omega
      have hidx:3*σ.vars r.e+j<(σ.arrs r.scratch).length:=by rw [h.degree] at *; omega
      have hidxB:3*σ.vars r.e+j<B:=hidx.trans h.scratch_word
      have hb:(buffer r 3).evalB B τ=some (3*σ.vars r.e):=by
        have hx:(Expr.var r.e).evalB B τ=some (σ.vars r.e):=by
          simpa only [hev] using evalB_var (σ:=τ) (x:=r.e) (by rw [hev]; exact heB)
        exact evalB_bin (op:=Bop.mul) (evalB_lit h3) hx hprod
      have hjx:(Expr.var r.j).evalB B τ=some j:=by
        simpa only [hjv] using evalB_var (σ:=τ) (x:=r.j) (by rw [hjv]; omega)
      have hi:=evalB_bin (op:=Bop.add) hb hjx hidxB
      have hv:(σ.arrs r.scratch).getD (3*σ.vars r.e+j) 0<B:=by
        rw [h.degree]
        exact (h.buffer_canonical 3 (by simp) j (by simpa only [h.degree] using hj)).trans hp
      exact pointState_get_evalB (finishNames r) σ f r.scratch _ hi hidx (Or.inl h.separate.symm) hv)
  apply hr.mono
  simp only [finishNames,buffer,Expr.size,h.degree]
  omega

theorem finalState_coefficients (h : BufferInput F r B σ)
    (hout : σ.vars r.outBase+F.e ≤ (σ.arrs r.mem).length) :
    N0520.slice F (finalState r σ) r (σ.vars r.outBase)=
      bufferCoeffs F r σ 3 := by
  funext i
  have hh:=writeValues_inside (σ.arrs r.mem) (σ.vars r.outBase) (σ.vars r.e) i.val
    (fun j=>(σ.arrs r.scratch).getD (3*σ.vars r.e+j) 0)
    (by rw [h.degree]; exact hout) (by simpa only [h.degree] using i.isLt)
  simpa [finalState,pointState,finishNames,N0520.slice,
    bufferCoeffs,h.degree] using hh

def MemoryFrame (e : Nat) (r : FieldNames) (σ τ : Env) : Prop :=
  ∀j<(σ.arrs r.mem).length,
    j<σ.vars r.outBase ∨ σ.vars r.outBase+e ≤ j →
      (τ.arrs r.mem).getD j 0=(σ.arrs r.mem).getD j 0

/-  The full finite command executes field powering, including initialization and output extraction. -/
theorem powerCore_correct (h : PowerInput F r B σ) (exponent : Expr) (n : Nat)
    (hn : n<B) (hex : exponent.evalB B σ=some n) :
    ∃τ,Run B (powerCore r exponent) σ τ (50000*(F.e+1)^2*(n.size+1)+exponent.size+1) ∧
      N0520.decode F
        (N0520.slice F τ r (σ.vars r.outBase))=
      N0520.decode F
        (N0520.slice F σ r (σ.vars r.aBase)) ^ n ∧
      N0520.Canonical F
        (N0520.slice F τ r (σ.vars r.outBase)) ∧
      MemoryFrame F.e r σ τ := by
  have hi:=initializePower_run h exponent n hex
  obtain ⟨τ,hl,hτ,hzero,hvalue,hmem,hvars⟩:=powerLoop_run (initialState_bufferInput h n hn)
  rw [initialState_exponent h] at hl hvalue
  have hh:=h.outer_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hok:r.outBase≠r.k:=by tauto
  have hoj:r.outBase≠r.j:=by tauto
  have hoe:r.outBase≠r.exponent:=by tauto
  have hov:τ.vars r.outBase=σ.vars r.outBase:=
    (hvars r.outBase (by simp [scalarNames]) hoe).trans (initialState_vars r σ n r.outBase hok hoj hoe)
  have hmv:τ.arrs r.mem=σ.arrs r.mem:=hmem.trans (initialState_memory h n)
  have hfit:τ.vars r.outBase+F.e ≤ (τ.arrs r.mem).length:=by rw [hov,hmv]; exact h.output_fit
  have hf:=finishPower_run hτ hfit
  refine ⟨finalState r τ,?_,?_,?_,?_⟩
  · apply (hi.seq (hl.seq hf)).mono
    have hs : F.e+1 ≤ (F.e+1)^2 := by nlinarith
    have hp : 1 ≤ (F.e+1)^2 := by nlinarith only [hs]
    have hm := Nat.mul_le_mul_right n.size hp
    nlinarith only [hs,hp,hm]
  · have hs:=finalState_coefficients hτ hfit
    rw [hov] at hs
    rw [hs]
    have hv:=initialState_values h n
    change bufferValue F r τ 3 = _
    rw [hv.1,hv.2,one_mul] at hvalue
    exact hvalue
  · have hs:=finalState_coefficients hτ hfit
    rw [hov] at hs
    rw [hs]
    intro i
    exact hτ.buffer_canonical 3 (by simp) i.val i.isLt
  · intro j hj hsep
    have ht:=pointState_read_preserved (finishNames r) τ
      (fun j=>(τ.arrs r.scratch).getD (3*τ.vars r.e+j) 0) (τ.vars r.e) j r.mem
      (by rw [hmv]; exact hj) (by
        right
        change j<τ.vars r.outBase ∨ τ.vars r.outBase+τ.vars r.e ≤ j
        rw [hov,hτ.degree]
        exact hsep)
    simpa only [finalState,hmv] using ht

/-  Literal q-power/ordinary exponentiation macro, with no abstract field-operation callback. -/
theorem powRoutine_correct (h : PowerInput F r B σ) (hex : σ.vars r.exp<B) :
    ∃τ,Run B (powRoutine r) σ τ (100000*(F.e+1)^2*((σ.vars r.exp).size+1)) ∧
      N0520.decode F
        (N0520.slice F τ r (σ.vars r.outBase))=
      N0520.decode F
        (N0520.slice F σ r (σ.vars r.aBase)) ^ σ.vars r.exp ∧
      N0520.Canonical F
        (N0520.slice F τ r (σ.vars r.outBase)) ∧
      MemoryFrame F.e r σ τ := by
  obtain ⟨τ,hr,ho,hc,hframe⟩:=powerCore_correct h (.var r.exp) (σ.vars r.exp) hex (evalB_var hex)
  refine ⟨τ,hr.mono ?_,ho,hc,hframe⟩
  simp only [Expr.size]
  have hp : 0 < (F.e+1)^2*((σ.vars r.exp).size+1) := by positivity
  nlinarith only [hp]

def CardPrivate (r : FieldNames) : Prop :=
  ∀x∈scalarNames r,x≠(cardNames r).out ∧ x≠(cardNames r).index

theorem canonical_cardPrivate : CardPrivate canonical := by
  unfold CardPrivate scalarNames canonical cardNames
  decide




def cardState (r : FieldNames) (σ : Env) : Env :=
  N0529.state (cardNames r) σ (σ.vars r.e)

theorem cardState_vars (r : FieldNames) (σ : Env) (h : CardPrivate r)
    (x : String) (hx : x∈scalarNames r) : (cardState r σ).vars x=σ.vars x := by
  simp [cardState,N0529.state,(h x hx).1,(h x hx).2]

theorem PowerInput.cardState_input (h : PowerInput F r B σ) (hn : CardPrivate r) :
    PowerInput F r B (cardState r σ) := by
  have hv (x : String) (hx : x∈scalarNames r):
      (cardState r σ).vars x=σ.vars x:=cardState_vars r σ hn x hx
  refine {
    degree:=(hv r.e (by simp [scalarNames])).trans h.degree,
    prime:=(hv r.p (by simp [scalarNames])).trans h.prime,separate:=h.separate,
    outer_names:=h.outer_names,inner_names:=h.inner_names,private_names:=h.private_names,
    arithmetic_word:=h.arithmetic_word,memory_word:=h.memory_word,
    scratch_word:=h.scratch_word,scratch_fit:=h.scratch_fit,
    modulus_fit:=?_,modulus_value:=?_,first_fit:=?_,first_canonical:=?_,output_fit:=?_ }
  · rw [hv r.modBase (by simp [scalarNames])]; exact h.modulus_fit
  · intro i; unfold sourceCoeff; rw [hv r.modBase (by simp [scalarNames])]; exact h.modulus_value i
  · rw [hv r.aBase (by simp [scalarNames])]; exact h.first_fit
  · intro i; unfold sourceCoeff; rw [hv r.aBase (by simp [scalarNames])]; exact h.first_canonical i
  · rw [hv r.outBase (by simp [scalarNames])]; exact h.output_fit

theorem inverse_exponent_size (p e : Nat) (he : 0<e) :
    (2*p^e-3).size ≤ e*(p.size+1) := by
  have hp:=Nat.lt_size_self p
  have hpow:=Nat.pow_lt_pow_left hp (Nat.ne_of_gt he)
  rw [←pow_mul] at hpow
  have h2:2*p^e<2^(p.size*e+1):=by rw [pow_succ]; omega
  have hs:(2*p^e-3).size ≤ p.size*e+1:=Nat.size_le.mpr (by omega)
  nlinarith

/-  The actual inverse command constructs the field cardinality and uses a positive inverse exponent. -/
theorem invRoutine_correct (h : PowerInput F r B σ) (hc : CardPrivate r)
    (hnames : (cardNames r).out≠(cardNames r).index)
    (hcap : (F.p+1)^(F.e+1)<B) :
    ∃τ,Run B (invRoutine r) σ τ
        (1000000*(F.e+1)^2*(F.e*(F.p.size+1)+1)) ∧
      N0520.decode F
        (N0520.slice F τ r (σ.vars r.outBase))=
      (N0520.decode F
        (N0520.slice F σ r (σ.vars r.aBase)))⁻¹ ∧
      N0520.Canonical F
        (N0520.slice F τ r (σ.vars r.outBase)) ∧
      MemoryFrame F.e r σ τ := by
