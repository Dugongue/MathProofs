/-  All packed factor literals are paid by the ORIGINAL bivariate table. -/
theorem packed_factor_coefficient_bound (D : ℕ) (P Q : NumericBivariate) (hP : Bounded D P)
    (hmP : (Polynomial.Bivariate.swap (N0365.polynomial P)).Monic)
    (hmQ : (Polynomial.Bivariate.swap (N0365.polynomial Q)).Monic)
    (hdiv : N0365.polynomial Q ∣ N0365.polynomial P) (n : ℕ) :
    N0090.ratWeight ((packNumeric (D+1) Q).coeff n) ≤ factorCoefficientBudget D (arrayBill D P) := by
  have hQ := bounded_divisor D P Q hP hmP hdiv
  have hpm := (packNumeric_monic_degree D P hP hmP).1
  have hqm := (packNumeric_monic_degree D Q hQ hmQ).1
