/-! Original dense input bills control the actual initialized cluster literals.
These are output-height and source-size theorems, not intermediate xgcd runtime bounds. -/
namespace Internal.N0339.N0197.N0047

open Polynomial Finset
abbrev NumericPolynomial := N0625.NumericPolynomial

/-  Exact paid dense input tree. -/
def denseBill (P : NumericPolynomial) : ℕ :=
  N0090.bitCost (N0206.auxiliaryWeight (fun _ : Empty => 0)) (N0628.denseFormula P)

/-  The universal inverse budget with the two concrete dense source bills exposed as parameters. -/
def inverseBudget (a b h SA SB : ℕ) : ℕ :=
  let normNode := N0644.outputBudget a b (N0344.reverseCostBound a SA 0) (SB+2*a+9)
  let normCoeff := (a+1)*(4*((2*a+2)*(a+1))+7+normNode+6)+(2+N0090.ratWeight 0)
  let H := 4*normCoeff+7
  let T := 4+H+(a*(H+(a*(SB+2)+(2+N0090.ratWeight 1))+6)+(2+N0090.ratWeight 0))
  (T+1)*((4*(((a+2)*(h+7)+1)*(T+1))+7)+
    ((T+1)*(4*((2*T+2)*(T+1))+7+(2*T+6)*T+6)+(2+N0090.ratWeight 0))+6)+(2+N0090.ratWeight 0)

 theorem inverseSourceBudget_eq (A B : NumericPolynomial) (a b h : ℕ) :
    N0628.inverseSourceBudget A B a b h = inverseBudget a b h (denseBill A) (denseBill B) := by
  rfl

 theorem powerSumBudget_mono {N N' s s' b b' : ℕ} (hN : N ≤ N') (hs : s ≤ s') (hb : b ≤ b') :
    N0445.outputBudget N s b ≤ N0445.outputBudget N' s' b' := by
  unfold N0445.outputBudget N0445.rawBudget
  dsimp only
  gcongr

 theorem newtonBudget_mono {N N' B B' : ℕ} (hN : N ≤ N') (hB : B ≤ B') :
    N0357.outputBudget N B ≤ N0357.outputBudget N' B' := by
  unfold N0357.outputBudget N0357.expBudget N0357.logBudget
  gcongr

 theorem symmetricBudget_mono {a a' b b' SA SA' SB SB' : ℕ}
    (ha : a ≤ a') (hb : b ≤ b') (hSA : SA ≤ SA') (hSB : SB ≤ SB') :
    N0644.outputBudget a b SA SB ≤ N0644.outputBudget a' b' SA' SB' := by
  apply newtonBudget_mono ha
  unfold N0644.traceBudget
  dsimp only
  have hL : a*b ≤ a'*b' := Nat.mul_le_mul ha hb
  have hp := N0344.projectionCostBound_mono hL
    (show a*(SB+2)+9 ≤ a'*(SB'+2)+9 by gcongr)
  have hm : N0644.momentBudget (a*b) a SA ≤
      N0644.momentBudget (a'*b') a' SA' := by
    unfold N0644.momentBudget
    have hs := powerSumBudget_mono hL hSA hSA
    omega
  gcongr

 theorem reverseBudget_mono {a a' S S' : ℕ} (ha : a ≤ a') (hS : S ≤ S') :
    N0344.reverseCostBound a S 0 ≤ N0344.reverseCostBound a' S' 0 := by
  unfold N0344.reverseCostBound N0344.tableCostBound
  have hp := N0344.projectionCostBound_mono ha hS
  gcongr

 theorem inverseBudget_mono {a a' b b' h h' SA SA' SB SB' : ℕ}
    (ha : a ≤ a') (hb : b ≤ b') (hh : h ≤ h') (hSA : SA ≤ SA') (hSB : SB ≤ SB') :
    inverseBudget a b h SA SB ≤ inverseBudget a' b' h' SA' SB' := by
  have hn := symmetricBudget_mono ha hb (reverseBudget_mono ha hSA)
    (show SB+2*a+9 ≤ SB'+2*a'+9 by omega)
  unfold inverseBudget
  dsimp only
  gcongr
/-  A fixed polynomial in original dense input degrees/bills and the maximum power. -/
def inverseHeight (A B : NumericPolynomial) (N : ℕ) : ℕ :=
  4*inverseBudget (N*A.natDegree) (N*B.natDegree) (N0629.powerHeight A N)
    (N0629.densePowerBudget A N) (N0629.densePowerBudget B N)+7

/-  Every actual computed powered inverse coefficient is bounded from the ORIGINAL dense inputs. -/
theorem clusterInverse_height (A B : NumericPolynomial) (N l r : ℕ)
    (hA : A.toPoly.Monic) (hAB : IsCoprime A.toPoly B.toPoly) (hl : l ≤ N) :
    N0090.ratWeight ((N0625.clusterInverse A B l).1.coeff r) ≤ inverseHeight A B N := by
  have hm : (A^l).toPoly.Monic := by rw [Internal.N0048.CPolynomial.toPoly_pow]; exact hA.pow l
  have ha : (A^l).toPoly.natDegree = l*A.natDegree := by
    rw [Internal.N0048.CPolynomial.toPoly_pow, hA.natDegree_pow, ← Internal.N0048.CPolynomial.natDegree_toPoly]
  have hc : IsCoprime (A^l).toPoly (B^l).toPoly := by
    simpa only [Internal.N0048.CPolynomial.toPoly_pow] using hAB.pow (m := l) (n := l)
  have hb := N0629.power_natDegree_le_uniform B l N hl
  have hd := N0628.euclidean_inverse_paid_height (A^l) (B^l)
    (l*A.natDegree) (N*B.natDegree) (N0629.powerHeight A N) r hm ha hc hb
    (fun i hi => N0629.power_coeff_height_uniform A l N i hl)
  have hsA : denseBill (A^l) ≤ N0629.densePowerBudget A N :=
    N0629.powered_denseFormula_bitCost_uniform A l N hl
  have hsB : denseBill (B^l) ≤ N0629.densePowerBudget B N :=
    N0629.powered_denseFormula_bitCost_uniform B l N hl
  rw [inverseSourceBudget_eq] at hd
  exact hd.trans (by
    unfold inverseHeight
    gcongr
    exact inverseBudget_mono (Nat.mul_le_mul_right _ hl) (le_refl _) (le_refl _) hsA hsB)

/-  Fixed polynomial bound for every initialized numericWeight used by the cluster compiler. -/
def residueHeightBudget (A B : NumericPolynomial) (N d : ℕ) : ℕ :=
  let h := N0629.powerHeight A N+inverseHeight A B N
  4*(((N*A.natDegree+1)*h+1)*(N*d+A.natDegree+1))+7

/-  Actual denominator and actual inverse heights discharge the generic companion-weight bill. -/
theorem numericWeight_uniform (A B : NumericPolynomial) (N d l k i : ℕ)
    (hA : A.toPoly.Monic) (hAB : IsCoprime A.toPoly B.toPoly) (hp : 0 < A.natDegree)
    (hl : l ≤ N) (hk : k ≤ A.natDegree) (hi : i ≤ N*d) :
    N0090.ratWeight (N0625.numericWeight (A^l) (N0625.clusterInverse A B l).1
      (A.natDegree*l-1) (i+(k-1))) ≤ residueHeightBudget A B N d := by
  by_cases hl0 : l = 0
  · subst l
    rw [N0627.numericWeight_one_denominator_zero _ _ (by simp only [pow_zero, Internal.N0048.CPolynomial.toPoly_one])]
    unfold residueHeightBudget
    norm_num [N0090.ratWeight_eq]
  · have hlpos : 0 < l := Nat.pos_of_ne_zero hl0
    have hprod : 0 < A.natDegree*l := Nat.mul_pos hp hlpos
    have hm : (A^l).toPoly.Monic := by rw [Internal.N0048.CPolynomial.toPoly_pow]; exact hA.pow l
    have hd : (A^l).toPoly.natDegree = (A.natDegree*l-1)+1 := by
      rw [Internal.N0048.CPolynomial.toPoly_pow, hA.natDegree_pow, ← Internal.N0048.CPolynomial.natDegree_toPoly,
        Nat.mul_comm l A.natDegree]
      omega
    have hj := N0625.clusterInverse_proper A B hA l
    rw [← Internal.N0048.CPolynomial.toPoly_pow] at hj
    let h := N0629.powerHeight A N+inverseHeight A B N
    have hD : ∀ j < (A.natDegree*l-1)+1, N0090.ratWeight ((A^l).coeff j) ≤ h := by
      intro j hj
      exact (N0629.power_coeff_height_uniform A l N j hl).trans (Nat.le_add_right _ _)
    have hJ : ∀ j < (A.natDegree*l-1)+1,
        N0090.ratWeight ((N0625.clusterInverse A B l).1.coeff j) ≤ h := by
      intro j hj
      exact (clusterInverse_height A B N l j hA hAB hl).trans (Nat.le_add_left _ _)
    have hw := N0627.dense_numericWeight_bound (A.natDegree*l-1) (A^l)
      (N0625.clusterInverse A B l).1 hm hd hj h hD hJ
      (A.natDegree*l-1) (i+(k-1)) (by omega)
    apply hw.trans
    unfold residueHeightBudget
    dsimp only [h]
    have hpl : A.natDegree*l ≤ N*A.natDegree := by nlinarith
    have hin : i+(k-1) ≤ N*d+A.natDegree := by omega
    have hq : A.natDegree*l-1+2 ≤ N*A.natDegree+1 := by omega
    gcongr

/-  The initialized-height gap is closed for the actual finite table, universally over promised inputs. -/
theorem residueHeight_uniform (A B : NumericPolynomial) (N d : ℕ)
    (hA : A.toPoly.Monic) (hAB : IsCoprime A.toPoly B.toPoly) (hp : 0 < A.natDegree) :
    N0041.residueHeight A B N d ≤ residueHeightBudget A B N d := by
  unfold N0041.residueHeight
  apply Finset.sup_le
  intro l hl
  apply Finset.sup_le
  intro k hk
  apply Finset.sup_le
  intro i hi
  exact numericWeight_uniform A B N d l k i hA hAB hp
    (Nat.le_of_lt_succ (mem_range.mp hl)) (Nat.le_of_lt_succ (mem_range.mp hk))
    (Nat.le_of_lt_succ (mem_range.mp hi))

 theorem fiberHeight_uniform (A : NumericPolynomial) :
    N0041.fiberHeight A ≤ N0629.powerHeight A 1 := by
  unfold N0041.fiberHeight
  apply Finset.sup_le
  intro j hj
  simpa only [pow_one] using N0629.power_coeff_height A 1 j

 theorem outputBudget_mono_heights {p N d F F' W W' S y : ℕ} (hF : F ≤ F') (hW : W ≤ W') :
    N0041.outputBudget p N d F W S y ≤ N0041.outputBudget p N d F' W' S y := by
  unfold N0041.outputBudget N0041.clippedCoefficientBudget
    N0041.reverseCoefficientBudget N0041.expBudget
    N0041.logSourceBudget N0041.correctionBudget N0041.functionalBudget
    N0041.fiberCoefficientBudget N0041.logBudget
    N0344.projectionCostBound N0344.tableCostBound
  dsimp only
  gcongr

/-  This budget contains only original dense input degrees/bills, N,d, and input source size.
All initialized inverse and residue heights have been eliminated. -/
def uniformOutputBudget (A B : NumericPolynomial) (N d S y : ℕ) : ℕ :=
  N0041.outputBudget A.natDegree N d (N0629.powerHeight A 1)
    (residueHeightBudget A B N d) S y

/-  Universal paid source bound for every monic coprime dense A,B, including degree zero.
This is an actual formula-source theorem, not a Turing-machine running-time claim. -/
theorem clusterFormula_uniform_bitCost {ι : Type} (u : Option ι → ℕ)
    (A B : NumericPolynomial) (hA : A.toPoly.Monic) (hAB : IsCoprime A.toPoly B.toPoly)
    (N d : ℕ) (E : N0090.Formula (Option (Option ι))) :
    N0090.bitCost u (N0041.clusterFormula A B N d E) ≤
      uniformOutputBudget A B N d
        (N0090.bitCost (N0206.auxiliaryWeight (N0206.auxiliaryWeight (fun i => u (some i)))) E) (u none) := by
  by_cases hp : A.natDegree = 0
  · rw [N0041.clusterFormula_degree_zero A B N d E hp]
    change 2+N0090.ratWeight 1 ≤ _
    unfold uniformOutputBudget N0041.outputBudget
    omega
  · exact (N0041.clusterFormula_bitCost u A B N d E).trans
      (outputBudget_mono_heights (fiberHeight_uniform A)
        (residueHeight_uniform A B N d hA hAB (Nat.pos_of_ne_zero hp)))

/-  Original dense bills also pay the numeric product used in the radial perturbation. -/
def productHeight (A B : NumericPolynomial) : ℕ :=
  4*N0344.projectionCostBound (A.natDegree+B.natDegree) (2+denseBill A+denseBill B)+7

def productSource (A B : NumericPolynomial) : N0090.Formula (Option Empty) :=
  .mul (N0628.denseFormula A) (N0628.denseFormula B)

 theorem productSource_aux (A B : NumericPolynomial) :
    N0276.auxiliaryPolynomial (Empty.elim : Empty → ℚ) (productSource A B) = (A*B).toPoly := by
  change N0276.auxiliaryPolynomial Empty.elim (N0628.denseFormula A) *
    N0276.auxiliaryPolynomial Empty.elim (N0628.denseFormula B) = _
  rw [N0628.denseFormula_aux, N0628.denseFormula_aux,
    Algebra.algebraMap_self, Polynomial.map_id, Polynomial.map_id, Internal.N0048.CPolynomial.toPoly_mul]

 theorem product_degree_le (A B : NumericPolynomial) :
    (A*B).toPoly.natDegree ≤ A.natDegree+B.natDegree := by
  rw [Internal.N0048.CPolynomial.toPoly_mul, Internal.N0048.CPolynomial.natDegree_toPoly,
    Internal.N0048.CPolynomial.natDegree_toPoly]
  exact Polynomial.natDegree_mul_le

 theorem product_coeff_height (A B : NumericPolynomial) (r : ℕ) :
    N0090.ratWeight ((A*B).coeff r) ≤ productHeight A B := by
  by_cases hr : r ≤ A.natDegree+B.natDegree
  · let f := N0276.coefficientFormula (A.natDegree+B.natDegree) r (productSource A B)
    have hc := N0276.coefficientFormula_correct (Empty.elim : Empty → ℚ) (productSource A B)
      (A.natDegree+B.natDegree) r (by rw [productSource_aux]; exact product_degree_le A B) hr
    rw [productSource_aux, ← Internal.N0048.CPolynomial.coeff_toPoly] at hc
    rw [← hc]
    have hv := N0345.evaluated_literal_bit_bound (fun _ : Empty => 0) 0 Empty.elim
      (by intro i; exact Empty.elim i) f
    simp only [zero_add, one_mul] at hv
    have hb := N0206.coefficientFormula_bitCost (fun _ : Empty => 0)
      (A.natDegree+B.natDegree) r (productSource A B)
    change N0090.bitCost _ f ≤ N0344.projectionCostBound _ _ at hb
    have he : N0090.bitCost (N0206.auxiliaryWeight (fun _ : Empty => 0)) (productSource A B) =
        2+denseBill A+denseBill B := rfl
    rw [he] at hb
    exact hv.trans (by unfold productHeight; gcongr)
  · have hz : (A*B).coeff r = 0 := by
      rw [Internal.N0048.CPolynomial.coeff_toPoly]
      exact Polynomial.coeff_eq_zero_of_natDegree_lt ((product_degree_le A B).trans_lt (Nat.lt_of_not_ge hr))
    rw [hz]
    unfold productHeight
    norm_num [N0090.ratWeight_eq]

 theorem product_fiberHeight (A B : NumericPolynomial) :
    N0041.fiberHeight (A*B) ≤ productHeight A B := by
  unfold N0041.fiberHeight
  apply Finset.sup_le
  intro j hj
  exact product_coeff_height A B j

/-  Entire radial decoder source bill from original dense A,B, original f, and the actual rational center. -/
theorem radialClusterFormula_uniform_bitCost {ι : Type} [Fintype ι] (u : Option ι → ℕ)
    (a : ι → ℚ) (A B : NumericPolynomial) (hA : A.toPoly.Monic)
    (hAB : IsCoprime A.toPoly B.toPoly) (N : ℕ) (f : N0090.Formula (Option ι)) :
    N0090.bitCost u (N0046.radialClusterFormula a A B N f) ≤
      uniformOutputBudget A B N (max f.formalDegree (A*B).natDegree)
        (N0046.perturbationBudget (A*B).natDegree (N0046.centerHeight a) (productHeight A B)
          (N0090.bitCost (N0206.auxiliaryWeight (fun i => u (some i))) f)) (u none) := by
  have hc := clusterFormula_uniform_bitCost u A B hA hAB N (max f.formalDegree (A*B).natDegree)
    (N0046.perturbationSource a A B f)
