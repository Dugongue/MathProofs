/-  Executable powered product on the actual finite numeric labels. -/
def product {r : ℕ} (g : Fin r → NumericPolynomial) (e : Fin r → ℕ)
    (s : Finset (Fin r)) : NumericPolynomial := ∏ i ∈ s, (g i)^e i

theorem product_toPoly {r : ℕ} (g : Fin r → NumericPolynomial) (e : Fin r → ℕ)
