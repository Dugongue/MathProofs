  intro k hk
  change N0090.bitCost w (if k = 0 then .const 0 else .add (fiberLogCoefficient A k)
    (N0625.clusterCorrectionFormula A B k N d E)) ≤ _
  by_cases hk0 : k = 0
  · rw [if_pos hk0]
