  exact diagonal_coefficient (polynomial f) _ d

theorem homogeneousComponent_top_ne_zero {κ : Type} [DecidableEq κ]
    (G : MvPolynomial κ ℚ) (hG : G ≠ 0) (d : ℕ) (hd : G.totalDegree = d) :
    MvPolynomial.homogeneousComponent d G ≠ 0 := by
  classical
  obtain ⟨s, hs, hmax⟩ := Finset.exists_mem_eq_sup G.support (MvPolynomial.support_nonempty.mpr hG)
    (fun s => s.sum fun _ e => e)
  have hsd : s.degree = d := by
    simpa only [MvPolynomial.totalDegree, Finsupp.degree_apply, Finsupp.sum] using hmax.symm.trans hd
  intro hz
  have hc := congrArg (MvPolynomial.coeff s) hz
  have hcc : MvPolynomial.coeff s (MvPolynomial.homogeneousComponent d G) = MvPolynomial.coeff s G := by
    rw [MvPolynomial.coeff_homogeneousComponent, if_pos hsd]
  rw [hcc, MvPolynomial.coeff_zero] at hc
  exact (MvPolynomial.mem_support_iff.mp hs) hc

/-  The represented leading-direction polynomial is nonzero for every nonzero promised input. -/
theorem leadingDirection_nonzero {ι : Type} [Finite ι] [DecidableEq ι]
    (d : ℕ) (f : N0090.Formula (Option ι)) (hf : polynomial f ≠ 0)
    (hdegree : (polynomial f).totalDegree = d) (hd : d ≤ f.formalDegree) :
    polynomial (leadingDirection d f) ≠ 0 := by
