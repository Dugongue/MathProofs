theorem swapLoop_run {W n d H : ℕ} (σ : Env) (A : RectData n d) (i j : Fin n) (hij : i≠j)
    (hLive : LiveBasis σ A) (hi : σ.vars swapI=i.val) (hj : σ.vars swapJ=j.val) (hc : σ.vars swapCol=0)
    (hA : RectBound A H) (hW : n*d<W) (hW3 : 3≤W) (hH : H<W) :
    ∃τ,Run W swapLoop σ τ (200*(d+1)) ∧ LiveBasis τ (swapData A i j) ∧
      τ.vars swapI=i.val ∧ τ.vars swapJ=j.val ∧ τ.vars swapCol=d := by
  have hdB : d<W := by have hn := i.isLt; nlinarith
  let I : Env → Prop := fun ρ=>∃l,l≤d ∧ LiveBasis ρ (swapPrefix A i j l) ∧
    ρ.vars swapI=i.val ∧ ρ.vars swapJ=j.val ∧ ρ.vars swapCol=l
