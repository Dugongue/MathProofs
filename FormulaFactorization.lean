    (hc : cntE.evalB B sigma=some n)
    (hs : sbE.evalB B (sigma.setVar cntReg n)=some sourceBase)
    (hd : dbE.evalB B ((sigma.setVar cntReg n).setVar sbReg sourceBase)=some targetBase)
    (hn : n<B) (hsourceB : sourceBase+n<B) (htargetB : targetBase+n<B)
    (hfitSource : sourceBase+n≤(sigma.arrs src).length)
    (hfitTarget : targetBase+n≤(sigma.arrs dst).length)
    (hword : ∀k<n,(sigma.arrs src).getD (sourceBase+k) 0<B) :
    ∃tau,Run B (copyBlock src dst cntE sbE dbE) sigma tau
        (20*n+9+cntE.size+sbE.size+dbE.size) ∧
      (∀k<n,(tau.arrs dst).getD (targetBase+k) 0=
        (sigma.arrs src).getD (sourceBase+k) 0) ∧
      (∀k,(k<targetBase ∨ targetBase+n≤k) →
        (tau.arrs dst).getD k 0=(sigma.arrs dst).getD k 0) ∧
      (∀a,a≠dst→tau.arrs a=sigma.arrs a) ∧
      ((tau.arrs dst).length=(sigma.arrs dst).length) ∧
