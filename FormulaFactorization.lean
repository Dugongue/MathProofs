/-  Distinct normalized irreducibles stay coprime in the actual fraction field. -/
theorem fraction_factors_coprime (s : Finset A) (Q : A → R[X])
    (hm : ∀ i ∈ s, (Q i).Monic) (hi : ∀ i ∈ s, Irreducible (Q i))
    (hne : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → Q i ≠ Q j) :
    ∀ i ∈ s, ∀ j ∈ s, i ≠ j →
      IsCoprime ((Q i).map (algebraMap R K)) ((Q j).map (algebraMap R K)) := by
  intro i hsi j hsj hij
  have hirri : Irreducible ((Q i).map (algebraMap R K)) :=
    ((hm i hsi).irreducible_iff_irreducible_map_fraction_map).mp (hi i hsi)
  have hirrj : Irreducible ((Q j).map (algebraMap R K)) :=
    ((hm j hsj).irreducible_iff_irreducible_map_fraction_map).mp (hi j hsj)
  rcases hirri.isCoprime_or_dvd ((Q j).map (algebraMap R K)) with hc | hd
  · exact hc
  · have ha := hirri.prime.associated_of_dvd hirrj.prime hd
    have he := Polynomial.eq_of_monic_of_associated ((hm i hsi).map _) ((hm j hsj).map _) ha
    exact False.elim (hne i hsi j hsj hij (Polynomial.map_injective (algebraMap R K) (IsFractionRing.injective R K) he))

/-  The actual unpowered global product is generically separable in characteristic zero. -/
theorem fraction_plain_product_separable (s : Finset A) (Q : A → R[X])
    (hm : ∀ i ∈ s, (Q i).Monic) (hi : ∀ i ∈ s, Irreducible (Q i))
    (hne : ∀ i ∈ s, ∀ j ∈ s, i ≠ j → Q i ≠ Q j) :
    (∏ i ∈ s, (Q i).map (algebraMap R K)).Separable := by
  apply Polynomial.separable_prod' (fraction_factors_coprime s Q hm hi hne)
  intro i hsi
  exact (((hm i hsi).irreducible_iff_irreducible_map_fraction_map).mp (hi i hsi)).separable
end GenericFactors

