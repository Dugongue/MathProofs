    (evalB_var (by rw [hn];omega)).trans (congrArg some hn)
  have eN : (Expr.var nq.n).evalB W σ=some M :=
    (evalB_var (by rw [hN];exact hMW)).trans (congrArg some hN)
  have ec : (Expr.var secondRegister).evalB W σ=some c :=
    (evalB_var (by rw [hc];have := hs.slots_word;omega)).trans (congrArg some hc)
  apply Run.assign
