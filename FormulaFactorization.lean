def Names.Valid (r : Names) : Prop := [r.base,r.index,r.limit,r.value].Nodup

def Names.point (r : Names) : FieldNames :=
  {canonical with mem:=r.array,outBase:=r.base,i:=r.index,e:=r.limit,value:=r.value}

def readBody (r : Names) : Com :=
  .seq (.read r.value) <|
  .seq (.store r.array (address r.base r.index) (.var r.value)) <|
    .assign r.index (.add (.var r.index) (.lit 1))

def readBlock (r : Names) : Com :=
  .seq (.assign r.index (.lit 0))
    (.while (.lt (.var r.index) (.var r.limit)) (readBody r))

