/-!
# Bounded Kronecker reduction for actual bivariate factor literals

The finite numeric transposition and packing wrappers use existing CompPoly
monomials and eval₂. The coefficient-recovery argument follows Dimitris Mitsios,
CompPoly/Bivariate/Kronecker.lean (Apache 2.0), without importing unrelated NTT
implementations. Mathematical polynomial interpretations are proof-only.
-/
namespace Internal.N0339.N0197.N0018
open Polynomial Internal.N0048
open scoped BigOperators
set_option backward.isDefEq.respectTransparency false

abbrev NumericPolynomial := N0365.NumericPolynomial
abbrev NumericBivariate := N0365.NumericBivariate

/-  Ordinary polynomial evaluation supplies the proof reduction. -/
noncomputable def packHom (gap : ℕ) : Polynomial ℚ[X] →+* ℚ[X] :=
  Polynomial.eval₂RingHom (RingHom.id ℚ[X]) (X^gap)

noncomputable def pack (gap : ℕ) (F : Polynomial ℚ[X]) : ℚ[X] := packHom gap F




theorem pack_dvd (gap : ℕ) {F G : Polynomial ℚ[X]} (h : G ∣ F) : pack gap G ∣ pack gap F :=
  map_dvd (packHom gap) h

theorem pack_sum (gap : ℕ) (F : Polynomial ℚ[X]) :
    pack gap F = ∑ j ∈ F.support, F.coeff j * X^(gap*j) := by
  unfold pack packHom
  change F.eval₂ (RingHom.id ℚ[X]) (X^gap) = _
  rw [Polynomial.eval₂_eq_sum, Polynomial.sum_def]
  simp only [RingHom.id_apply, ← pow_mul]

/-  Exact coefficient recovery, adapted from CompPoly's bounded Kronecker proof. -/
theorem pack_coeff (gap : ℕ) (hg : 0 < gap) (F : Polynomial ℚ[X])
    (hF : ∀ j, (F.coeff j).natDegree < gap) (n : ℕ) :
    (pack gap F).coeff n = (F.coeff (n/gap)).coeff (n%gap) := by
  rw [pack_sum, Polynomial.finsetSum_coeff, Finset.sum_eq_single (n/gap)]
  · rw [Polynomial.coeff_mul_X_pow', if_pos (Nat.mul_div_le n gap)]
    have hsub : n-gap*(n/gap) = n%gap := by have := Nat.mod_add_div n gap; omega
    rw [hsub]
  · intro j hj hjn
    rw [Polynomial.coeff_mul_X_pow']
    split_ifs with hle
    · apply Polynomial.coeff_eq_zero_of_natDegree_lt
      have hjlt : j < n/gap :=
        lt_of_le_of_ne ((Nat.le_div_iff_mul_le hg).mpr (by rw [Nat.mul_comm]; exact hle)) hjn
      have hn : gap*j+gap ≤ n := by
        have h := Nat.mul_le_mul_left gap hjlt
        rw [Nat.mul_succ] at h
        exact h.trans (Nat.mul_div_le n gap)
      exact (hF j).trans_le (by omega)
    · rfl
  · intro hn
    have hz : F.coeff (n/gap) = 0 := by
      by_contra hz
      exact hn (Polynomial.mem_support_iff.mpr hz)
    rw [hz, zero_mul, Polynomial.coeff_zero]

theorem pack_coefficient_at (gap : ℕ) (hg : 0 < gap) (F : Polynomial ℚ[X])
    (hF : ∀ j, (F.coeff j).natDegree < gap) (t y : ℕ) (ht : t < gap) :
    (pack gap F).coeff (gap*y+t) = (F.coeff y).coeff t := by
  rw [pack_coeff gap hg F hF]
  have hm : (gap*y+t)%gap = t := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt ht]
  have hd : (gap*y+t)/gap = y := by
    rw [Nat.add_comm, Nat.add_mul_div_left _ _ hg, Nat.div_eq_of_lt ht, Nat.zero_add]
  rw [hm,hd]

/-  Monic in the outer variable plus bounded coefficient degrees gives a
unique encoded leading term, including the constant-one case. -/
theorem pack_monic_degree (gap : ℕ) (hg : 0 < gap) (F : Polynomial ℚ[X])
    (hF : ∀ j, (F.coeff j).natDegree < gap) (hm : F.Monic) :
    (pack gap F).Monic ∧ (pack gap F).natDegree = gap*F.natDegree := by
  have hc : (pack gap F).coeff (gap*F.natDegree) = 1 := by
    have h := pack_coefficient_at gap hg F hF 0 F.natDegree hg
    simpa [hm.coeff_natDegree] using h
  have hd : (pack gap F).natDegree ≤ gap*F.natDegree := by
    apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
    intro n hn
    rw [pack_coeff gap hg F hF]
    have hy : F.natDegree ≤ n/gap := (Nat.le_div_iff_mul_le hg).mpr (by simpa only [Nat.mul_comm] using hn.le)
    by_cases heq : F.natDegree = n/gap
    · rw [← heq, hm.coeff_natDegree, Polynomial.coeff_one]
      apply if_neg
      intro hmod
      have h := Nat.mod_add_div n gap
      rw [hmod, zero_add, ← heq] at h
      omega
    · have hlt : F.natDegree < n/gap := lt_of_le_of_ne hy heq
      rw [Polynomial.coeff_eq_zero_of_natDegree_lt hlt]
      rfl
  have heq := Polynomial.natDegree_eq_of_le_of_coeff_ne_zero hd (by rw [hc]; exact one_ne_zero)
  refine ⟨?_,heq⟩
  change (pack gap F).leadingCoeff = 1
  rw [Polynomial.leadingCoeff,heq,hc]

/-  Actual finite numeric transposition, the CompPoly coefficient-array construction. -/
def transpose (P : NumericBivariate) : NumericBivariate :=
  ∑ t ∈ CPolynomial.support P, ∑ y ∈ CPolynomial.support (P.coeff t),
    CPolynomial.monomial y (CPolynomial.monomial t ((P.coeff t).coeff y))

/-  Actual packing uses the already verified CompPoly evaluator. -/
def packNumeric (gap : ℕ) (P : NumericBivariate) : NumericPolynomial :=
  CPolynomial.eval₂ (RingHom.id NumericPolynomial) (CPolynomial.X^gap) (transpose P)


theorem transpose_coeff (P : NumericBivariate) (y t : ℕ) :
    ((transpose P).coeff y).coeff t = (P.coeff t).coeff y := by
  have hzero (n : ℕ) : CPolynomial.monomial n (0 : ℚ) = 0 := by
    apply CPolynomial.eq_iff_coeff.mpr
    intro i
    simp only [CPolynomial.coeff_monomial, CPolynomial.coeff_zero, ite_self]
  have hinner (k : ℕ) :
      CPolynomial.coeff (∑ j ∈ CPolynomial.support (P.coeff k),
        CPolynomial.monomial j (CPolynomial.monomial k ((P.coeff k).coeff j))) y =
      CPolynomial.monomial k ((P.coeff k).coeff y) := by
    rw [CPolynomial.coeff_finset_sum]
    by_cases hy : y ∈ CPolynomial.support (P.coeff k)
    · rw [Finset.sum_eq_single_of_mem y hy]
      · rw [CPolynomial.coeff_monomial, if_pos rfl]
      · intro j hj hjy
        rw [CPolynomial.coeff_monomial, if_neg (Ne.symm hjy)]
    · have hz : (P.coeff k).coeff y = 0 := by
        by_contra hn
        exact hy ((CPolynomial.mem_support_iff _ _).mpr hn)
      rw [Finset.sum_eq_zero]
      · rw [hz,hzero]
      · intro j hj
        rw [CPolynomial.coeff_monomial, if_neg]
        intro hyj
        exact hy (hyj ▸ hj)
  unfold transpose
  rw [CPolynomial.coeff_finset_sum]
  simp_rw [hinner]
  rw [CPolynomial.coeff_finset_sum]
  by_cases ht : t ∈ CPolynomial.support P
  · rw [Finset.sum_eq_single_of_mem t ht]
    · rw [CPolynomial.coeff_monomial, if_pos rfl]
    · intro k hk hkt
      rw [CPolynomial.coeff_monomial, if_neg (Ne.symm hkt)]
  · have hz : P.coeff t = 0 := by
      by_contra hn
      exact ht ((CPolynomial.mem_support_iff _ _).mpr hn)
    rw [Finset.sum_eq_zero]
    · rw [hz,CPolynomial.coeff_zero]
    · intro k hk
      rw [CPolynomial.coeff_monomial, if_neg]
      intro htk
      exact ht (htk ▸ hk)

