    refine ⟨⟨?_,?_⟩,hidxτ,hb⟩
    · rw [hs]
      exact SegInv.step hInv.1 (by rw [fr.len _,hS]; exact rect_address_lt i c)
        (by simp only [rowSign,dif_pos hld] <;> rfl)
    · rw [hn]
      exact SegInv.step hInv.2 (by rw [fr.len _,hN]; exact rect_address_lt i c)
        (by simp only [rowMagnitude,dif_pos hld] <;> rfl)
