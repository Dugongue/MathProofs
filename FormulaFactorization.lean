  · rw [hv r.aBase (by simp),hm]; exact h.first_fit
  · intro i; unfold sourceCoeff; rw [hv r.aBase (by simp),hm]; exact h.first_canonical i
  · rw [hv r.outBase (by simp),hm]; exact h.output_fit

