variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}

/-  A uniform bound on the macro costs. -/
structure CostBound (M : FieldMacros F r) (W : ℕ) : Prop where
  one : 1 ≤ W
  point : M.costPoint ≤ W
  mul : M.costMul ≤ W
  inv : M.costInv ≤ W
  eq : M.costEq ≤ W

variable {M : FieldMacros F r} {W : ℕ}

theorem copyCost_le (hW : CostBound M W) (D S : Expr) (hD : D.size ≤ 40) (hS : S.size ≤ 40)
    (N : ℕ) : copyCost M D S N ≤ 200 * W * (N + 1) := by
  have h1 := hW.one; have h2 := hW.point
  have hs : 4 + copyStep M D S ≤ 155 * W := by unfold copyStep; omega
  have := Nat.mul_le_mul_right N hs
  unfold copyCost
  nlinarith

theorem axpyCost_le (hW : CostBound M W) (D S : Expr) (hD : D.size ≤ 40) (hS : S.size ≤ 40)
    (N : ℕ) : axpyCost M D S N ≤ 300 * W * (N + 1) := by
  have h1 := hW.one; have h2 := hW.point; have h3 := hW.mul
  have hs : 4 + axpyStep M D S ≤ 237 * W := by unfold axpyStep; omega
  have := Nat.mul_le_mul_right N hs
  unfold axpyCost
  nlinarith

theorem pivotCost_le (hW : CostBound M W) (n : ℕ) : pivotCost M n ≤ 60 * W * (n + 1) := by
  have h1 := hW.one; have h2 := hW.eq
  have hs : 44 + M.costEq ≤ 45 * W := by omega
  have := Nat.mul_le_mul_right n hs
  unfold pivotCost
  nlinarith

theorem zeroCost_le (hW : CostBound M W) (n : ℕ) : zeroCost M n ≤ 50 * W * (n + 1) := by
  have h1 := hW.one; have h2 := hW.eq
  have hs : 40 + M.costEq ≤ 41 * W := by omega
  have := Nat.mul_le_mul_right n hs
  unfold zeroCost
  nlinarith

