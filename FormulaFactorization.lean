    (ctx.fromMont (ctx.mulMont a b)).toNat * UInt64.word % p.toNat
        = (ctx.mulMont a b).toNat := fromMont_repr ctx (ctx.mulMont a b) hmul_lt
    _ = y * UInt64.word % p.toNat := hyR_eq_mul.symm

