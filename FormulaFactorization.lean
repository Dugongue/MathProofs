/-!
# Distinct-root count certifies a regular fiber

For a monic family, every coefficient specialization preserves each degree.
Positive exponents preserve the set of distinct roots of the total product.
If the specialized powered product attains the sum of the original degrees as
its distinct-root count, the unpowered product is separable.  Consequently each
specialized factor is squarefree and factors at distinct indices are coprime.

The target is an arbitrary field.  Splitting is proved from attainment of the
full root count, rather than silently assumed or imposed by an algebraic closure.
No existence or efficient selection of a point attaining this count is claimed.
-/

namespace Internal.N0339.N0197.N0620

open Polynomial
open scoped BigOperators

universe u v w

section FieldPolynomials

variable {K : Type u} [Field K] [DecidableEq K] {ι : Type v}

/-  Full distinct-root count forces both splitting and separability. -/
theorem splits_and_separable_of_full_distinct_roots {P : K[X]} (hP : P ≠ 0)
    (hcount : P.roots.toFinset.card = P.natDegree) : P.Splits ∧ P.Separable := by
  classical
  have hcard : P.roots.card = P.natDegree :=
    Nat.le_antisymm (Polynomial.card_roots' P)
      (hcount ▸ Multiset.toFinset_card_le P.roots)
  have hsplit : P.Splits := Polynomial.splits_iff_card_roots.mpr hcard
  have hnodup : P.roots.Nodup :=
    Multiset.toFinset_card_eq_card_iff_nodup.mp (hcount.trans hcard.symm)
  exact ⟨hsplit, (Polynomial.nodup_roots_iff_of_splits hP hsplit).mp hnodup⟩

/-  Positive exponents change root multiplicities but not the actual distinct
root set of a finite monic product. -/
theorem distinct_roots_powered_product_eq (s : Finset ι) (G : ι → K[X])
    (m : ι → ℕ) (hmonic : ∀ i ∈ s, (G i).Monic) (hpos : ∀ i ∈ s, 0 < m i) :
    (∏ i ∈ s, (G i) ^ m i).roots.toFinset = (∏ i ∈ s, G i).roots.toFinset := by
  classical
  have hplain : (∏ i ∈ s, G i) ≠ 0 :=
    (Polynomial.monic_prod_of_monic s G hmonic).ne_zero
  have hpowered : (∏ i ∈ s, (G i) ^ m i) ≠ 0 :=
    (Polynomial.monic_prod_of_monic s (fun i => (G i) ^ m i)
      (fun i hi => (hmonic i hi).pow _)).ne_zero
  ext a
  rw [Multiset.mem_toFinset, Multiset.mem_toFinset, Polynomial.mem_roots hpowered,
    Polynomial.mem_roots hplain, Polynomial.isRoot_prod, Polynomial.isRoot_prod]
  constructor
  · rintro ⟨i, hi, hroot⟩
    refine ⟨i, hi, ?_⟩
    change (G i).eval a = 0
    change ((G i) ^ m i).eval a = 0 at hroot
    rw [Polynomial.eval_pow] at hroot
    exact (pow_eq_zero_iff (Nat.ne_of_gt (hpos i hi))).mp hroot
  · rintro ⟨i, hi, hroot⟩
    refine ⟨i, hi, ?_⟩
    change ((G i) ^ m i).eval a = 0
    rw [Polynomial.eval_pow]
    change (G i).eval a = 0 at hroot
    exact (pow_eq_zero_iff (Nat.ne_of_gt (hpos i hi))).mpr hroot

/-  Separability of the actual finite product supplies both required regularity
conditions on the individual factors. -/
theorem regular_factors_of_separable_product (s : Finset ι) (G : ι → K[X])
    (hsep : (∏ i ∈ s, G i).Separable) :
    (∀ i ∈ s, Squarefree (G i)) ∧
      (∀ i ∈ s, ∀ j ∈ s, i ≠ j → IsCoprime (G i) (G j)) := by
  classical
  constructor
  · intro i hi
    exact (hsep.of_dvd (Finset.dvd_prod_of_mem G hi)).squarefree
  · intro i hi j hj hij
    have hpair : ({i, j} : Finset ι) ⊆ s := by
      intro a ha
      rcases Finset.mem_insert.mp ha with rfl | ha
      · exact hi
      · exact (Finset.mem_singleton.mp ha) ▸ hj
    have hdiv : G i * G j ∣ ∏ a ∈ s, G a := by
      simpa [hij] using Finset.prod_dvd_prod_of_subset ({i, j} : Finset ι) s G hpair
