      change swapPrefix A i j c.val i c=A i c
      exact swapPrefix_current A i j i c
    have heJ : swapPrefix A i j l j c=A j c := by
      change swapPrefix A i j c.val j c=A j c
      exact swapPrefix_current A i j j c
    have hiM : (swapPrefix A i j l i c).magnitude<W := by rw [heI]; exact (hA i c).trans_lt hH
    have hjM : (swapPrefix A i j l j c).magnitude<W := by rw [heJ]; exact (hA j c).trans_lt hH
    obtain ⟨τ,hr,hnext,harr⟩ := swapBody_model_run ρ (swapPrefix A i j l) i j c hL.dimension hI hJ hidx hL.basis hW hW3 hiM hjM
    have fr := Frame.of_run hr
    have hpost : RectArrays τ (swapPrefix A i j (l+1)) := by
      rw [heI,heJ] at harr
      change RectArrays τ (updateCell (updateCell (swapPrefix A i j c.val) i c (A j c)) j c (A i c)) at harr
      rw [swapPrefix_step A i j hij c] at harr
      exact harr
