    Run.assign ((evalB_var (by rw [hn];exact hNW)).trans (congrArg some hn))
  have hrξ : ξ.vars rawRegister=r := by simpa only [ξ,vars_setVar,if_neg (by decide : rawRegister    ≠    q.N)] using hr
  have hoξ : ξ.vars resultRegister=os := by simpa only [ξ,vars_setVar,if_neg (by decide : resultRegister    ≠    q.N)] using ho
  have ed : (Expr.var rawRegister).evalB W ξ=some r :=
