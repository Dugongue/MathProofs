def swapData {n d : ℕ} (A : RectData n d) (i j : Fin n) : RectData n d := fun r c=>A (Equiv.swap i j r) c

theorem swapData_value {n d : ℕ} (A : RectData n d) (i j : Fin n) :
    rectValue (swapData A i j)=N0294.permuteRows (rectValue A) (Equiv.swap i j) := rfl

theorem swapData_twice {n d : ℕ} (A : RectData n d) (i j : Fin n) : swapData (swapData A i j) i j=A := by
  funext r c
  simp [swapData]

def swapPrefix {n d : ℕ} (A : RectData n d) (i j : Fin n) (l : ℕ) : RectData n d :=
  fun r c=>if c.val<l then A (Equiv.swap i j r) c else A r c

theorem swapPrefix_zero {n d : ℕ} (A : RectData n d) (i j : Fin n) : swapPrefix A i j 0=A := by
  funext r c
  simp [swapPrefix]
theorem swapPrefix_full {n d : ℕ} (A : RectData n d) (i j : Fin n) : swapPrefix A i j d=swapData A i j := by
  funext r c
