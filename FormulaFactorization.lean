  rw [N0276.auxiliaryPolynomial, directionSource, N0090.eval₂_substitute]
  congr 1
  funext v
  cases v <;> rfl

theorem directionEnvironment_degree {ι R : Type} [CommRing R] (env : ι → R)
    (v : Option ι) : (directionEnvironment env v).natDegree ≤ 1 := by
  cases v with
  | none => exact Polynomial.natDegree_X_le
  | some i => exact (Polynomial.natDegree_C_mul_le _ _).trans Polynomial.natDegree_X_le

theorem directionSource_T_degree {ι R : Type} [CommRing R] [Algebra ℚ R]
    (env : ι → R) (f : N0090.Formula (Option ι)) :
