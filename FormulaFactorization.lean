    refine Fin.addCases ?_ ?_ r
    · intro r
      have he:=congrFun hA r
      simpa [columns,target,Matrix.mulVec,dotProduct,mul_comm] using he
    · intro r
      simp [columns,target,hj]

theorem candidate_correct (A : Matrix (Fin n) (Fin m) K) (j : Fin m)
    (h : test A j=true) : A.mulVec (candidate A j)=0 ∧ candidate A j j=1 :=
  (constraints_sum A j _).mp (coordinates_solution _ _ ((test_iff A j).mp h))

theorem test_complete (A : Matrix (Fin n) (Fin m) K) (j : Fin m) (x : Fin m→K)
    (hA : A.mulVec x=0) (hj : x j=1) : test A j=true := by
  apply (test_iff A j).mpr
  rw [←(constraints_sum A j x).mpr ⟨hA,hj⟩]
  exact Submodule.sum_mem _ (fun i _=>Submodule.smul_mem _ _ (Submodule.subset_span ⟨i,rfl⟩))

