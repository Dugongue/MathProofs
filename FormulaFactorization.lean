      (N*(N0090.bitCost (N0206.auxiliaryWeight w) E+2)+(2+N0090.ratWeight 1))) (by
      intro t ht
      obtain ⟨j,hj,rfl⟩ := List.mem_map.mp ht
      have hjN : j+1 ≤ N := Nat.succ_le_of_lt (List.mem_range.mp hj)
      refine ⟨(N0627.logCoefficient_bit_bound j).trans (by omega), ?_⟩
      have hb := N0625.functionalFormula_bitCost_le w
        (A^(j+1)) (N0625.clusterInverse A B (j+1)).1
        (A.natDegree*(j+1)-1) (k-1) ((j+1)*d) (residueHeight A B N d)
        (N0090.power E (j+1)) (by
          intro i hi
          exact residueHeight_bound A B N d (j+1) k i hjN hk
            (hi.trans (Nat.mul_le_mul_right d hjN)))
      change N0090.bitCost w _ ≤ functionalBudget _ _ _ at hb
