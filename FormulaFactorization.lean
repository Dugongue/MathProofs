  unfold logBudget
  gcongr

 theorem expBudget_mono {N S T : ℕ} (h : S ≤ T) : expBudget N S ≤ expBudget N T := by
  unfold expBudget
  gcongr

 theorem fiberLogCoefficient_bitCost {ι : Type} (w : ι → ℕ) (A : NumericPolynomial) (k : ℕ) :
    N0090.bitCost w (fiberLogCoefficient A k) ≤ fiberCoefficientBudget A.natDegree (fiberHeight A) := by
  have hf : N0090.bitCost (N0206.auxiliaryWeight w)
