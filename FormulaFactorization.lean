/-! Iterated executable quadratic Hensel lifting using the imported Hex kernel.
This module certifies the actual returned factors and Bezout witnesses; it
makes no claim about physical-machine runtime. -/
namespace Internal.N0339.N0197.N0246
open Internal.N0208

/-  The modulus used by the executable doubling loop. -/
def modulus (m : Nat) : Nat → Nat
  | 0 => m
  | k + 1 => modulus m k * modulus m k

/-  Every stage uses the original target and the previous computed witnesses. -/
def lift (m : Nat) (f : ZPoly) (seed : QuadraticLiftResult) :
    Nat → QuadraticLiftResult
  | 0 => seed
  | k + 1 =>
    let r := lift m f seed k
    ZPoly.quadraticHenselStep (modulus m k) f r.g r.h r.s r.t

/-  Sufficient invariant for another executed quadratic step. -/
def Valid (f : ZPoly) (m : Nat) (r : QuadraticLiftResult) : Prop :=
  ZPoly.congr (r.g * r.h) f m ∧
    ZPoly.congr (r.s * r.g + r.t * r.h) 1 m ∧ DensePoly.Monic r.g

theorem modulus_gt_one (m : Nat) (hm : 1 < m) (k : Nat) :
    1 < modulus m k := by
  induction k with
  | zero => exact hm
  | succ k ih =>
    have hmul := Nat.mul_le_mul_left (modulus m k) (show 1 ≤ modulus m k by omega)
    simp only [Nat.mul_one] at hmul
    simp only [modulus]
    omega

/-  The full loop preserves the factor, Bezout and monic invariants at every
precision. The output is the executable Hex computation, not a chosen lift. -/
theorem lift_valid (m : Nat) (f : ZPoly) (seed : QuadraticLiftResult)
    (hm : 1 < m) (hseed : Valid f m seed) (k : Nat) :
    Valid f (modulus m k) (lift m f seed k) := by
  induction k with
  | zero => exact hseed
  | succ k ih =>
    obtain ⟨hprod,hbez,hmonic⟩ := ih
    have hspec := ZPoly.quadraticHenselStep_spec (modulus m k) f
      (lift m f seed k).g (lift m f seed k).h
      (lift m f seed k).s (lift m f seed k).t
      (modulus_gt_one m hm k) hprod hbez hmonic
    have hmon := ZPoly.quadraticHenselStep_monic (modulus m k) f
      (lift m f seed k).g (lift m f seed k).h
      (lift m f seed k).s (lift m f seed k).t
      (modulus_gt_one m hm k) hmonic
    exact ⟨hspec.1,hspec.2,hmon⟩

/-  Closed precision: k iterations lift the modulus to m^(2^k). -/
theorem modulus_eq_pow (m k : Nat) : modulus m k = m ^ (2 ^ k) := by
  induction k with
  | zero => simp [modulus]
  | succ k ih =>
    calc
      modulus m (k+1) = modulus m k * modulus m k := rfl
      _ = (m ^ (2 ^ k)) ^ 2 := by rw [ih, Nat.pow_two]
      _ = m ^ (2 ^ k * 2) := (Nat.pow_mul m (2 ^ k) 2).symm
      _ = m ^ (2 ^ (k+1)) := by rw [Nat.pow_succ]

