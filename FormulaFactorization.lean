    (hnot : ∀ i ∈ J, ¬ g i ∣ U) : U ∣ ∏ i ∈ I, (g i)^e i := by
  apply N0649.strip_prime_product J g e U (∏ i ∈ I, (g i)^e i) hprime hnot
  rw [mul_comm, ← hprod]
  exact dvd_mul_right U V

