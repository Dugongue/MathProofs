theorem subtractInstruction_correct_of_operand_lt {N : Nat} {R : Type}
    (o : Op) (hN : operandArgument o <= N)
    (returnLabel : R)
    (right : R -> TM2.Stmt (fun _ : CoreStack => SparseSymbol) R
      (FullInterpreterState N))
    (w a : Nat) (ha : a < 2 ^ w)
    (m : SparseMemory) (hm : m.Normalized w)
