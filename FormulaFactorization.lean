abbrev curTape : Fin (k + 1 + 2) := Fin.natAdd (k + 1) 0

/-  The tape holding the next word: the output tape of `Turing.MultiTapeTM.onWords`. -/
abbrev nextTape : Fin (k + 1 + 2) := (Fin.last k).castAdd 2

