/-  Prefix determinants are products of the actual full-frame GS squares. -/
theorem prefix_product {N d k : ℕ} (B : IntBasis N d) (h : k≤N) :
    (prefixVolume B k : ℝ)=∏ i : Fin k,‖gramSchmidt ℝ (rows B) (Fin.castLE h i)‖^2 := by
  rw [prefix_cast]
  let f : Fin k→EuclideanSpace ℝ (Fin d) := fun i=>rows B (Fin.castLE h i)
  have he : Matrix.gram ℝ (fun r : PrefixIndex N k=>rows B r.val)=
      (Matrix.gram ℝ f).submatrix (prefixEquiv h) (prefixEquiv h) := by ext i j;rfl
  rw [he,Matrix.det_submatrix_equiv_self,N0298.gram_det_eq_prod_gramSchmidt,Finset.prod_pow]
  apply congrArg (fun x : ℝ=>x^2)
  apply Finset.prod_congr rfl
  intro i _
  rw [gramSchmidt_take]

/-  Determinant as an actual linear functional of its replacement vector. -/
noncomputable def gramFunctional {N : ℕ} (b : Fin N→E) (j : Fin N) : E→ₗ[ℝ]ℝ where
  toFun v := (Matrix.updateRow (Matrix.gram ℝ (fun r : PrefixIndex N (j.val+1)=>b r.val))
    ⟨j,Nat.lt_succ_self _⟩ (fun r=>⟪v,b r.val⟫_ℝ)).det
  map_add' v w := by
    have he : (fun r : PrefixIndex N (j.val+1)=>⟪v+w,b r.val⟫_ℝ)=
        (fun r=>⟪v,b r.val⟫_ℝ)+(fun r=>⟪w,b r.val⟫_ℝ) := by funext r;exact inner_add_left _ _ _
    rw [he,Matrix.det_updateRow_add]
  map_smul' a v := by
    have he : (fun r : PrefixIndex N (j.val+1)=>⟪a • v,b r.val⟫_ℝ)=
        a • (fun r=>⟪v,b r.val⟫_ℝ) := by funext r;exact real_inner_smul_left _ _ _
    rw [he,Matrix.det_updateRow_smul]
    rfl

theorem functional_row {N : ℕ} (b : Fin N→E) (j : Fin N) :
    gramFunctional b j (b j)=(Matrix.gram ℝ (fun r : PrefixIndex N (j.val+1)=>b r.val)).det := by
  change (Matrix.updateRow _ _ ((Matrix.gram ℝ (fun r : PrefixIndex N (j.val+1)=>b r.val)) ⟨j,Nat.lt_succ_self _⟩)).det=_
  rw [Matrix.updateRow_eq_self]

theorem functional_earlier {N : ℕ} (b : Fin N→E) (j r : Fin N) (hr : r<j) :
    gramFunctional b j (b r)=0 := by
  change (Matrix.updateRow _ ⟨j,Nat.lt_succ_self _⟩
    ((Matrix.gram ℝ (fun r : PrefixIndex N (j.val+1)=>b r.val)) ⟨r,by have := r.isLt;omega⟩)).det=0
  apply Matrix.det_updateRow_eq_zero
  intro he
  exact hr.ne (congrArg Subtype.val he)

theorem functional_span {N : ℕ} (b : Fin N→E) (j : Fin N) (v : E)
    (hv : v∈Submodule.span ℝ (b '' Set.Iio j)) : gramFunctional b j v=0 := by
  have hspan : Submodule.span ℝ (b '' Set.Iio j)≤LinearMap.ker (gramFunctional b j) := by
    apply Submodule.span_le.mpr
    rintro _ ⟨r,hr,rfl⟩
    exact functional_earlier b j r hr
  exact hspan hv

theorem functional_gs_earlier {N : ℕ} (b : Fin N→E) (j r : Fin N) (hr : r<j) :
    gramFunctional b j (gramSchmidt ℝ b r)=0 := by
  apply functional_span
  exact Submodule.span_mono (Set.image_mono (Set.Iic_subset_Iio.mpr hr))
    (gramSchmidt_mem_span ℝ b le_rfl)

theorem functional_gs_later {N : ℕ} (b : Fin N→E) (j r : Fin N) (hr : j< r) :
    gramFunctional b j (gramSchmidt ℝ b r)=0 := by
  apply Matrix.det_eq_zero_of_row_eq_zero (i:=⟨j,Nat.lt_succ_self _⟩)
  intro a
  rw [Matrix.updateRow_self]
  exact gramSchmidt_inv_triangular ℝ b (by
    have ha := a.property
    have hjr : j.val< r.val := hr
    change a.val.val< r.val
    omega)

theorem functional_gs_self {N : ℕ} (b : Fin N→E) (j : Fin N) :
    gramFunctional b j (gramSchmidt ℝ b j)=gramFunctional b j (b j) := by
  rw [N0298.gramSchmidt_real_def,map_sub,map_sum]
  have he : (∑ i∈Finset.Iio j,gramFunctional b j
      ((⟪gramSchmidt ℝ b i,b j⟫_ℝ/‖gramSchmidt ℝ b i‖^2) • gramSchmidt ℝ b i))=0 := by
    apply Finset.sum_eq_zero
    intro i hi
    rw [map_smul,functional_gs_earlier b j i (Finset.mem_Iio.mp hi)]
    simp
  rw [he,sub_zero]

/-  Exact Cramer numerator identity, with no assumed coefficient oracle. -/
theorem functional_coefficient {N : ℕ} (b : Fin N→E) (i j : Fin N) (hji : j < i) :
    gramFunctional b j (b i)=coefficient b i j*gramFunctional b j (b j) := by
  have he := congrArg (gramFunctional b j) (N0298.gramSchmidt_real_def b i)
  rw [functional_gs_later b j i hji,map_sub,map_sum] at he
  have hs : (∑ r∈Finset.Iio i,gramFunctional b j
      ((⟪gramSchmidt ℝ b r,b i⟫_ℝ/‖gramSchmidt ℝ b r‖^2) • gramSchmidt ℝ b r))=
      coefficient b i j*gramFunctional b j (b j) := by
    rw [Finset.sum_eq_single j]
    · rw [map_smul,functional_gs_self]
      rfl
    · intro r hr hrj
      rw [map_smul]
      have hz : gramFunctional b j (gramSchmidt ℝ b r)=0 := by
        rcases hrj.lt_or_gt with h | h
        · exact functional_gs_earlier b j r h
        · exact functional_gs_later b j r h
      rw [hz];simp
    · intro h
      exact (h (Finset.mem_Iio.mpr hji)).elim
  rw [hs] at he
  linarith

theorem mixed_cast {N d : ℕ} (B : IntBasis N d) (i j : Fin N) :
    (mixedNumerator B i j : ℝ)=gramFunctional (rows B) j (rows B i) := by
  unfold mixedNumerator
  change ((Matrix.updateRow (N0296.gram (prefixRows B (j.val+1)))
    ⟨j,Nat.lt_succ_self _⟩ (fun r=>(N0296.gram B) i r.val)).det : ℝ)=
    (Matrix.updateRow (Matrix.gram ℝ (fun r : PrefixIndex N (j.val+1)=>rows B r.val))
      ⟨j,Nat.lt_succ_self _⟩ (fun r=>⟪rows B i,rows B r.val⟫_ℝ)).det
  rw [Int.cast_det,Matrix.map_updateRow]
  have hG : (N0296.gram (prefixRows B (j.val+1))).map (fun x : ℤ=>(x : ℝ))=
      Matrix.gram ℝ (fun r : PrefixIndex N (j.val+1)=>rows B r.val) := by
    ext r t
    exact gram_entry_cast (prefixRows B (j.val+1)) r t
  have hrow : ((fun x : ℤ=>(x : ℝ)) ∘ (fun r : PrefixIndex N (j.val+1)=>N0296.gram B i r.val))=
      (fun r=>⟪rows B i,rows B r.val⟫_ℝ) := by
    funext r
    exact gram_entry_cast B i r.val
  rw [hG,hrow]

/-  The actual integer mixed numerator equals D times the actual GS coefficient. -/
theorem mixedNumerator_eq {N d : ℕ} (B : IntBasis N d) (i j : Fin N) (hji : j < i) :
    (mixedNumerator B i j : ℝ)=(prefixVolume B (j.val+1) : ℝ)*coefficient (rows B) i j := by
  rw [mixed_cast,functional_coefficient (rows B) i j hji,functional_row,← prefix_cast]
  ring

/-  Exact successive-prefix Gram volume identity for the actual full-frame GS. -/
theorem prefix_step {N d : ℕ} (B : IntBasis N d) (j : Fin N) :
    (prefixVolume B (j.val+1) : ℝ)=
      (prefixVolume B j.val : ℝ)*‖gramSchmidt ℝ (rows B) j‖^2 := by
  rw [prefix_product B (show j.val+1≤N by omega),Fin.prod_univ_castSucc]
  have he : (∏ i : Fin j.val,
      ‖gramSchmidt ℝ (rows B) (Fin.castLE (show j.val+1≤N by omega) i.castSucc)‖^2)=
      (prefixVolume B j.val : ℝ) := by
    rw [prefix_product B (show j.val≤N by omega)]
    apply Finset.prod_congr rfl
    intro i _
    congr 2
  rw [he]
  congr 2

theorem independent_rows {N d : ℕ} (B : IntBasis N d) (hB : FullRank B) :
    LinearIndependent ℝ (rows B) := by
  apply Matrix.linearIndependent_of_det_gram_ne_zero
  have he : Matrix.gram ℝ (rows B)=(N0296.gram B).map (Int.castRingHom ℝ) := by
    ext i j
    exact (gram_entry_cast B i j).symm
  rw [he]
  change ((N0296.gram B).map (fun x : ℤ=>(x : ℝ))).det≠0
  rw [← Int.cast_det]
  exact_mod_cast hB

theorem swapped_gs_before {N : ℕ} (b : Fin N→E) (i j : Fin N)
    (hij : i.val+1=j.val) (r : Fin N) (hr : r < i) :
    gramSchmidt ℝ (fun a=>b (Equiv.swap i j a)) r=gramSchmidt ℝ b r := by
  apply N0298.gramSchmidt_prefix_congr
  intro a ha
  rw [Equiv.swap_apply_of_ne_of_ne]
  · intro he
    have := congrArg Fin.val he
    have hrv : r.val < i.val := hr
    have hav : a.val≤ r.val := ha
    omega
  · intro he
    have := congrArg Fin.val he
    have hrv : r.val < i.val := hr
    have hav : a.val≤ r.val := ha
    omega

/-  The adjacent swap has the actual residual g_j + mu_(j,i) g_i. -/
theorem swapped_gs_at {N : ℕ} (b : Fin N→E) (i j : Fin N)
    (hij : i.val+1=j.val) :
    gramSchmidt ℝ (fun a=>b (Equiv.swap i j a)) i=
      gramSchmidt ℝ b j+coefficient b j i • gramSchmidt ℝ b i := by
  let C := fun a=>b (Equiv.swap i j a)
  have hji : i < j := by change i.val < j.val;omega
  have hCi : C i=b j := by simp [C]
  have hs : (∑ r∈Finset.Iio i,
      (⟪gramSchmidt ℝ C r,C i⟫_ℝ/‖gramSchmidt ℝ C r‖^2) • gramSchmidt ℝ C r)=
      ∑ r∈Finset.Iio i,
      (⟪gramSchmidt ℝ b r,b j⟫_ℝ/‖gramSchmidt ℝ b r‖^2) • gramSchmidt ℝ b r := by
    apply Finset.sum_congr rfl
    intro r hr
    have he := swapped_gs_before b i j hij r (Finset.mem_Iio.mp hr)
    change gramSchmidt ℝ C r=gramSchmidt ℝ b r at he
    simp only [he,hCi]
  have hset : Finset.Iio j=insert i (Finset.Iio i) := by
    ext r
    simp only [Finset.mem_Iio,Finset.mem_insert]
    have hrj : r < j ↔ r.val < j.val := Iff.rfl
    have hri : r < i ↔ r.val < i.val := Iff.rfl
    have heq : r=i ↔ r.val=i.val := Fin.ext_iff
    rw [hrj,hri,heq]
    omega
  change gramSchmidt ℝ C i=_
  rw [N0298.gramSchmidt_real_def,hs,hCi,
    N0298.gramSchmidt_real_def b j,hset,
    Finset.sum_insert (by simp)]
  dsimp [coefficient]
  abel

theorem swapped_gs_norm {N : ℕ} (b : Fin N→E) (i j : Fin N)
    (hij : i.val+1=j.val) :
    ‖gramSchmidt ℝ (fun a=>b (Equiv.swap i j a)) i‖^2=
      ‖gramSchmidt ℝ b j‖^2+(coefficient b j i)^2*‖gramSchmidt ℝ b i‖^2 := by
  rw [swapped_gs_at b i j hij]
  have hne : j≠i := by intro he;have := congrArg Fin.val he;omega
  have ho : ⟪gramSchmidt ℝ b j,coefficient b j i • gramSchmidt ℝ b i⟫_ℝ=0 := by
    rw [inner_smul_right,gramSchmidt_orthogonal ℝ b hne,mul_zero]
  have hp : ‖gramSchmidt ℝ b j+coefficient b j i • gramSchmidt ℝ b i‖^2=
      ‖gramSchmidt ℝ b j‖^2+‖coefficient b j i • gramSchmidt ℝ b i‖^2 := by
    simpa only [pow_two] using norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ ho
  rw [hp]
  simp only [norm_smul,Real.norm_eq_abs,mul_pow,sq_abs]

/-  Exact adjacent swap-volume identity behind the integer Lovasz test. -/
theorem swap_volume {N d : ℕ} (B : IntBasis N d) (i j : Fin N)
    (hij : i.val+1=j.val) :
    (prefixVolume (permuteRows B (Equiv.swap i j)) j.val : ℝ)=
      (prefixVolume B i.val : ℝ)*
        (‖gramSchmidt ℝ (rows B) j‖^2+(coefficient (rows B) j i)^2*‖gramSchmidt ℝ (rows B) i‖^2) := by
  rw [← hij,prefix_step]
  have hp := swap_prefix_away B i j hij i.val (by omega)
  rw [hp]
  have he : rows (permuteRows B (Equiv.swap i j))=(fun a=>rows B (Equiv.swap i j a)) := rfl
  rw [he,swapped_gs_norm (rows B) i j hij]

/-  The actual adjacent integer numerator certificate implies actual GS size. -/
theorem size_condition {n d : ℕ} (B : IntBasis (n+1) d) (hB : FullRank B)
    (hs : N0280.AdjacentSizeReduced B) :
    N0281.AdjacentSize (rows B) := by
  intro r
  let i : Fin (n+1) := r.castSucc
  let j : Fin (n+1) := r.succ
  have hij : i.val+1=j.val := rfl
  obtain ⟨hl,hu⟩ := hs i j hij
  have hD : (0 : ℝ)<(prefixVolume B j.val : ℝ) := by
    exact_mod_cast prefixVolume_pos B hB j.val
  have hm : (mixedNumerator B j i : ℝ)=
      (prefixVolume B j.val : ℝ)*coefficient (rows B) j i := by
    simpa only [hij] using mixedNumerator_eq B j i (by change i.val < j.val;omega)
  have hlr : -(prefixVolume B j.val : ℝ)≤2*(mixedNumerator B j i : ℝ) := by exact_mod_cast hl
  have hur : 2*(mixedNumerator B j i : ℝ)≤(prefixVolume B j.val : ℝ) := by exact_mod_cast hu.le
  rw [hm] at hlr hur
  have hlo : (-1 : ℝ)≤2*coefficient (rows B) j i :=
    le_of_mul_le_mul_left (a:=(prefixVolume B j.val : ℝ)) (by nlinarith [hlr]) hD
  have hup : 2*coefficient (rows B) j i≤(1 : ℝ) :=
    le_of_mul_le_mul_left (a:=(prefixVolume B j.val : ℝ)) (by nlinarith [hur]) hD
  change |coefficient (rows B) j i|≤(1/2 : ℝ)
  exact abs_le.mpr ⟨by linarith,by linarith⟩

/-  Failure of every actual adjacent integer swap test implies actual Lovasz. -/
theorem lovasz_condition {n d : ℕ} (B : IntBasis (n+1) d) (hB : FullRank B)
    (hs : N0284.AdjacentStable B) :
    N0281.Lovasz (rows B) := by
  intro r
  let i : Fin (n+1) := r.castSucc
  let j : Fin (n+1) := r.succ
  have hij : i.val+1=j.val := rfl
  have hnone : trySwap B i j=none := by
    have hh := hs i (show i.val+1 < n+1 from Nat.succ_lt_succ r.isLt)
    exact hh
  have htest : 3*prefixVolume B j.val≤4*prefixVolume (permuteRows B (Equiv.swap i j)) j.val := by
    by_contra hn
    have hlt : 4*prefixVolume (permuteRows B (Equiv.swap i j)) j.val < 3*prefixVolume B j.val := by omega
    simp only [trySwap,hlt,if_true] at hnone
    cases hnone
  have hreal : (3 : ℝ)*(prefixVolume B j.val : ℝ)≤
      4*(prefixVolume (permuteRows B (Equiv.swap i j)) j.val : ℝ) := by exact_mod_cast htest
  have hbase : (0 : ℝ)<(prefixVolume B i.val : ℝ) := by exact_mod_cast prefixVolume_pos B hB i.val
  have he : (prefixVolume B j.val : ℝ)=
      (prefixVolume B i.val : ℝ)*‖gramSchmidt ℝ (rows B) i‖^2 := by
    simpa only [hij] using prefix_step B i
  rw [he,swap_volume B i j hij] at hreal
  have hmul : (prefixVolume B i.val : ℝ)*((3/4 : ℝ)*‖gramSchmidt ℝ (rows B) i‖^2)≤
      (prefixVolume B i.val : ℝ)*(‖gramSchmidt ℝ (rows B) j‖^2+
        (coefficient (rows B) j i)^2*‖gramSchmidt ℝ (rows B) i‖^2) := by nlinarith [hreal]
  exact le_of_mul_le_mul_left hmul hbase

/-  Both actual determinant certificates suffice for the full norm guarantee. -/
theorem certified_basis_approximation {n : ℕ} (B : IntBasis (n+1) (n+1))
    (hB : FullRank B) (hs : N0280.AdjacentSizeReduced B)
    (hl : N0284.AdjacentStable B)
    (w : EuclideanSpace ℝ (Fin (n+1)))
    (hw : ∃ c : Fin (n+1)→ℤ,w=∑ i,(c i : ℝ) • rows B i) (hw0 : w≠0) :
    ‖rows B 0‖^2≤(2 : ℝ)^n*‖w‖^2 :=
  N0281.lattice_approximation (rows B) (independent_rows B hB)
    (size_condition B hB hs) (lovasz_condition B hB hl) w hw hw0

/-  Arbitrary positive-rank wrapper avoids casts at rank d+r. -/
theorem certified_basis_approximation_rank {N : ℕ} (B : IntBasis N N) (hN : 0<N)
    (hB : FullRank B) (hs : N0280.AdjacentSizeReduced B)
    (hl : N0284.AdjacentStable B)
    (w : EuclideanSpace ℝ (Fin N))
    (hw : ∃ c : Fin N→ℤ,w=∑ i,(c i : ℝ) • rows B i) (hw0 : w≠0) :
    ‖rows B ⟨0,hN⟩‖^2≤(2 : ℝ)^(N-1)*‖w‖^2 := by
  cases N with
  | zero => omega
  | succ n => exact certified_basis_approximation B hB hs hl w hw hw0

/-  Literal integer vecMul equals the real combination of the literal rows. -/
theorem real_vecMul {N d : ℕ} (B : IntBasis N d) (c : Fin N→ℤ) :
    WithLp.toLp 2 (fun j=>((c ᵥ* B) j : ℝ))=∑ i,(c i : ℝ) • rows B i := by
  apply (WithLp.equiv 2 (Fin d→ℝ)).injective
  ext j
  simp [Matrix.vecMul,dotProduct,rows,Int.cast_sum,Int.cast_mul]

/-  The actual producer returns an approximate-shortest basis for its OLD
integer lattice. No reduced basis, short vector, or GS certificate is supplied. -/
theorem produced_approximation {N : ℕ} (B : IntBasis N N) (hN : 0<N) (hB : FullRank B) :
    ∃ C,N0284.produce B=some C ∧ FullRank C ∧
      N0284.SameRowLattice B C ∧
      ∀ w : Fin N→ℤ,w≠0 → (∃ c : Fin N→ℤ,c ᵥ* B=w) →
        ‖rows C ⟨0,hN⟩‖^2≤(2 : ℝ)^(N-1)*
          ‖WithLp.toLp 2 (fun j=>(w j : ℝ))‖^2 := by
  obtain ⟨C,hC,hfull,hLat,hstable,hsize⟩ := N0280.produce_basis_adjacent B hB
  refine ⟨C,hC,hfull,hLat,?_⟩
  intro w hw hmem
  obtain ⟨c,hc⟩ := (hLat w).mp hmem
  have hv : WithLp.toLp 2 (fun j=>(w j : ℝ))≠(0 : EuclideanSpace ℝ (Fin N)) := by
    intro hz
    apply hw
    funext j
    have hh : (w j : ℝ)=0 := by
      simpa using congrArg (fun x : EuclideanSpace ℝ (Fin N)=>x j) hz
    change w j=0
    exact_mod_cast hh
  apply certified_basis_approximation_rank C hN hfull hsize hstable _ ?_ hv
  refine ⟨c,?_⟩
  rw [← hc]
  exact real_vecMul C c

