  have h : (moveInputPos p .neg).val = p.val - 1 := by grind [SignType.cast]
  rw [runFrom, Function.iterate_succ_apply, N0632.step_eq rfl, ← runFrom, ← h]
  simp only [rewindInput, tr_ofTr]
  exact N0632.runFrom_walk (moveInputPos p .neg) (by omega)

end Turing.MultiTapeTM

