section P25Clean0310


/-!
# Paid coefficient bounds for actual dense polynomial powers

These bounds refer to the original dense numeric input tree. All coefficient
sources are actual fixed-grid arithmetic trees, with no coefficient-input oracle.
-/
namespace Internal.N0339.N0197.N0629
open Polynomial

abbrev NumericPolynomial := N0625.NumericPolynomial

def powerSource (P : NumericPolynomial) (l : ℕ) : N0090.Formula (Option Empty) :=
  N0090.power (N0628.denseFormula P) l

def coefficientSource (P : NumericPolynomial) (l r : ℕ) : N0090.Formula Empty :=
  N0276.coefficientFormula (l * P.natDegree) r (powerSource P l)

def powerCoefficientBudget (P : NumericPolynomial) (l : ℕ) : ℕ :=
  let M := l * P.natDegree
  let S := N0090.bitCost (N0206.auxiliaryWeight (fun _ : Empty => 0))
    (N0628.denseFormula P)
  (M + 1) * (4 * ((2 * M + 2) * (M + 1)) + 7 +
    (2 * M + 6) * (l * (S + 2) + (2 + N0090.ratWeight 1)) + 6) +
    (2 + N0090.ratWeight 0)

def powerHeight (P : NumericPolynomial) (l : ℕ) : ℕ := 4 * powerCoefficientBudget P l + 7

theorem powerSource_aux {R : Type} [CommRing R] [Algebra ℚ R]
    (P : NumericPolynomial) (l : ℕ) :
    N0276.auxiliaryPolynomial (Empty.elim : Empty → R) (powerSource P l) =
      (P.toPoly.map (algebraMap ℚ R)) ^ l := by
  unfold powerSource N0276.auxiliaryPolynomial
  rw [N0090.eval₂_power]
  change N0276.auxiliaryPolynomial Empty.elim (N0628.denseFormula P) ^ l = _
  rw [N0628.denseFormula_aux]

theorem power_natDegree_le (P : NumericPolynomial) (l : ℕ) :
    (P ^ l).toPoly.natDegree ≤ l * P.natDegree := by
  rw [Internal.N0048.CPolynomial.toPoly_pow, Internal.N0048.CPolynomial.natDegree_toPoly]
  simpa only [Nat.mul_comm] using (Polynomial.natDegree_pow_le (p := P.toPoly) (n := l))

theorem coefficientSource_correct (P : NumericPolynomial) (l r : ℕ)
    (hr : r ≤ l * P.natDegree) :
    N0090.eval₂ (RingHom.id ℚ) Empty.elim (coefficientSource P l r) = (P ^ l).coeff r := by
  have hdeg : (N0276.auxiliaryPolynomial (Empty.elim : Empty → ℚ) (powerSource P l)).natDegree ≤
      l * P.natDegree := by
    rw [powerSource_aux, Algebra.algebraMap_self, Polynomial.map_id]
    simpa only [Internal.N0048.CPolynomial.toPoly_pow] using power_natDegree_le P l
  have hc := N0276.coefficientFormula_correct (Empty.elim : Empty → ℚ)
    (powerSource P l) (l * P.natDegree) r hdeg hr
  simpa only [coefficientSource, powerSource_aux, Algebra.algebraMap_self, Polynomial.map_id,
    Internal.N0048.CPolynomial.toPoly_pow, Internal.N0048.CPolynomial.coeff_toPoly] using hc

theorem coefficientSource_bitCost (P : NumericPolynomial) (l r : ℕ) :
    N0090.bitCost (fun _ : Empty => 0) (coefficientSource P l r) ≤ powerCoefficientBudget P l := by
  have h := N0206.coefficientFormula_bitCost (fun _ : Empty => 0)
    (l * P.natDegree) r (powerSource P l)
  simpa only [coefficientSource, powerCoefficientBudget, powerSource, N0090.bitCost_power] using h

/-  Every output coefficient literal of an actual dense power has a polynomial
bound from the original dense input source; zero and constant inputs are included. -/
theorem power_coeff_height (P : NumericPolynomial) (l r : ℕ) :
    N0090.ratWeight ((P ^ l).coeff r) ≤ powerHeight P l := by
  by_cases hr : r ≤ l * P.natDegree
  · rw [← coefficientSource_correct P l r hr]
    have h := N0345.evaluated_literal_bit_bound (fun _ : Empty => 0) 0 Empty.elim
      (by intro i; exact Empty.elim i) (coefficientSource P l r)
    simp only [zero_add, one_mul] at h
    exact h.trans (by unfold powerHeight; gcongr; exact coefficientSource_bitCost P l r)
  · have hc : (P ^ l).coeff r = 0 := by
      rw [Internal.N0048.CPolynomial.coeff_toPoly]
      apply Polynomial.coeff_eq_zero_of_natDegree_lt
      exact (power_natDegree_le P l).trans_lt (Nat.lt_of_not_ge hr)
    rw [hc]
    unfold powerHeight
    norm_num [N0090.ratWeight_eq]

def densePowerBudget (P : NumericPolynomial) (l : ℕ) : ℕ :=
  (l * P.natDegree + 1) * (powerHeight P l + (l * P.natDegree) * 4 +
    (2 + N0090.ratWeight 1) + 6) + (2 + N0090.ratWeight 0)

theorem powered_denseFormula_bitCost (P : NumericPolynomial) (l : ℕ) :
    N0090.bitCost (N0206.auxiliaryWeight (fun _ : Empty => 0))
      (N0628.denseFormula (P ^ l)) ≤ densePowerBudget P l := by
  have h := N0628.denseFormula_bitCost
    (N0206.auxiliaryWeight (fun _ : Empty => 0)) (P ^ l) (powerHeight P l)
    (fun i hi => power_coeff_height P l i)
  apply h.trans
  have hd : (P ^ l).natDegree ≤ l * P.natDegree := by
    rw [Internal.N0048.CPolynomial.natDegree_toPoly]
    exact power_natDegree_le P l
  unfold densePowerBudget
  simp only [N0206.auxiliaryWeight, Option.elim_none, add_zero]
  gcongr

theorem powerHeight_mono (P : NumericPolynomial) {l L : ℕ} (hl : l ≤ L) :
    powerHeight P l ≤ powerHeight P L := by
  unfold powerHeight powerCoefficientBudget
  dsimp only
  gcongr

theorem densePowerBudget_mono (P : NumericPolynomial) {l L : ℕ} (hl : l ≤ L) :
    densePowerBudget P l ≤ densePowerBudget P L := by
  unfold densePowerBudget
  gcongr
  exact powerHeight_mono P hl

theorem power_coeff_height_uniform (P : NumericPolynomial) (l L r : ℕ) (hl : l ≤ L) :
    N0090.ratWeight ((P ^ l).coeff r) ≤ powerHeight P L :=
  (power_coeff_height P l r).trans (powerHeight_mono P hl)

theorem powered_denseFormula_bitCost_uniform (P : NumericPolynomial) (l L : ℕ) (hl : l ≤ L) :
    N0090.bitCost (N0206.auxiliaryWeight (fun _ : Empty => 0))
      (N0628.denseFormula (P ^ l)) ≤ densePowerBudget P L :=
  (powered_denseFormula_bitCost P l).trans (densePowerBudget_mono P hl)

theorem power_natDegree_le_uniform (P : NumericPolynomial) (l L : ℕ) (hl : l ≤ L) :
    (P ^ l).toPoly.natDegree ≤ L * P.natDegree :=
  (power_natDegree_le P l).trans (Nat.mul_le_mul_right _ hl)

end Internal.N0339.N0197.N0629

