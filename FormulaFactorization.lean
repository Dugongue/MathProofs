open Polynomial Finset

/-  A fixed, executable order for all interpolation nodes except i. -/
def factorNodes (M i : ℕ) : List ℕ := (List.range (M + 1)).filter (fun j => j != i)

noncomputable def basisForList (i : ℕ) (js : List ℕ) : ℚ[X] :=
  (js.map fun (j : ℕ) => C (((i : ℚ) - (j : ℚ))⁻¹) * (X - C (j : ℚ))).prod

