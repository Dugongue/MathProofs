def shapeBank : String := "Kernel.binary.shape"
def writerIndex : String := "Kernel.binary.writer"
def inputWords {n d : ℕ} (A : RectData n d) : List ℕ :=
  [n*d,n,d] ++ List.replicate (n+d) 0 ++
    N0304.signs A ++ N0304.magnitudes A
def vectorWords {n : ℕ} (v : Fin n → ℤ) : List ℕ :=
  (List.ofFn fun q => [if v q < 0 then 1 else 0,(v q).natAbs]).flatten
def resultWords {n : ℕ} : Option (Fin n → ℤ) → List ℕ
  | none => [0]
  | some v => [1,n] ++ vectorWords v
def result {n d : ℕ} (A : RectData n d) :=
  N0268.witness (rectValue A).transpose
def shapeLoader : Com := .seq (.assign count (.add (.var nVar) (.var dimVar)))
  (readBlock (N0168.io shapeBank))
def pairBody : Com := .seq
  (.ite (.eq (.get kernelN (.var writerIndex)) (.lit 0))
    (.write (.lit 0)) (.write (.get kernelS (.var writerIndex))))
  (.seq (.write (.get kernelN (.var writerIndex)))
    (.assign writerIndex (.add (.var writerIndex) (.lit 1))))
def pairLoop : Com := .while (.lt (.var writerIndex) (.var nVar)) pairBody
def someWriter : Com := .seq (.write (.lit 1)) (.seq (.write (.var nVar))
  (.seq (.assign writerIndex (.lit 0)) pairLoop))
def writer : Com := .ite (.eq (.var kernelFound) (.lit 0)) (.write (.lit 0)) someWriter
def program : Com := .seq
  (Internal.N0339.N0575.readFields N0304.headNames)
  (.seq shapeLoader (.seq N0304.loader (.seq kernelProgram writer)))
def lengths (n d : ℕ) (a : String) : ℕ :=
  if a=shapeBank then n+d else if a=kernelS ∨ a=kernelN then n
  else N0304.lengths n d a
def N {n d : ℕ} (A : RectData n d) := bitSize (inputWords A)

theorem raw_dimensions {n d : ℕ} (A : RectData n d) :
    n*d ≤ N A ∧ n ≤ N A ∧ d ≤ N A ∧ n+d ≤ N A := by
  have h := N0318.Encoding.length_le_bitSize (inputWords A)
  have he : (inputWords A).length=3+(n+d)+2*(n*d) := by
    simp [inputWords,N0304.signs,N0304.magnitudes]
    omega
  rw [he] at h
  change _ ≤ N A at h
  omega

theorem raw_magnitude {n d : ℕ} (A : RectData n d) (i : Fin n) (j : Fin d) :
    (A i j).magnitude < 2^(N A+1) := by
  have hm : (A i j).magnitude ∈ N0304.magnitudes A := by
    apply List.mem_ofFn.mpr
    refine ⟨Fin.mkDivMod i j,?_⟩
    simp
  exact N0318.Encoding.mem_lt_two_pow_bitSize_add_one
    (show (A i j).magnitude ∈ inputWords A by
      simp only [inputWords,List.mem_append]
      tauto)

theorem raw_bill_bound {n d : ℕ} (A : RectData n d) :
    sourceBill A ≤ 8*(N A+1)^2 := by
  obtain ⟨hnd,hn,hd,hshape⟩ := raw_dimensions A
  have hc (i : Fin n) (j : Fin d) : (A i j).magnitude.size ≤ N A+1 :=
    Nat.size_le.mpr (raw_magnitude A i j)
  have hs : (∑i : Fin n,∑j : Fin d,(A i j).magnitude.size) ≤ n*d*(N A+1) := by
    calc
      _ ≤ ∑_i : Fin n,∑_j : Fin d,(N A+1) :=
        Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => hc i j
      _ = _ := by simp; ring
  have hm := Nat.mul_le_mul_right (N A+1) hnd
  unfold sourceBill
  nlinarith

noncomputable def valuePolynomial : Polynomial ℕ := 1000000000000*(Polynomial.X+1)^12
noncomputable def timePolynomial : Polynomial ℕ := 1000000000000000000000000*(Polynomial.X+1)^20
def sourceTime (S : ℕ) := 20000000*(S+1)^10

theorem raw_word_capacity {n d : ℕ} (A : RectData n d) :
    N0282.wordBound (sourceBill A) ≤
      2^(valuePolynomial.eval (N A)+N A+1) := by
  have hb := raw_bill_bound A
  have hp0 : 1 ≤ (N A+1)^2 := Nat.one_le_pow _ _ (by omega)
  have hb1 : sourceBill A+1 ≤ 9*(N A+1)^2 := by omega
  have hp := Nat.pow_le_pow_left hb1 6
  have he : N0282.wordExponent (sourceBill A) ≤
      5314410000*(N A+1)^12 := by
    calc
      _ ≤ 10000*(9*(N A+1)^2)^6 := Nat.mul_le_mul_left _ hp
      _ = _ := by ring
  apply Nat.pow_le_pow_right (by decide)
  have hc : 5314410000*(N A+1)^12 ≤ 1000000000000*(N A+1)^12 :=
    Nat.mul_le_mul_right _ (by decide)
  simp only [valuePolynomial,Polynomial.eval_mul,Polynomial.eval_pow,
    Polynomial.eval_add,Polynomial.eval_X,Polynomial.eval_one,Polynomial.eval_ofNat]
  omega

theorem raw_time_capacity {n d : ℕ} (A : RectData n d) :
    sourceTime (sourceBill A) ≤ timePolynomial.eval (N A) := by
  have hb := raw_bill_bound A
  have hp0 : 1 ≤ (N A+1)^2 := Nat.one_le_pow _ _ (by omega)
  have hb1 : sourceBill A+1 ≤ 9*(N A+1)^2 := by omega
  calc
    _ ≤ 20000000*(9*(N A+1)^2)^10 :=
      Nat.mul_le_mul_left _ (Nat.pow_le_pow_left hb1 10)
    _ = 69735688020000000*(N A+1)^20 := by ring
    _ ≤ timePolynomial.eval (N A) := by
      simp only [timePolynomial,Polynomial.eval_mul,Polynomial.eval_pow,
        Polynomial.eval_add,Polynomial.eval_X,Polynomial.eval_one,Polynomial.eval_ofNat]
      exact Nat.mul_le_mul_right _ (by decide)

theorem shapeLoader_run {W n d : ℕ} (σ : Env) (tail : List ℕ)
