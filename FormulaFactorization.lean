  simpa using (Fin.sum_univ_eq_sum_range (fun k=>if hk:k<d then zval (A i ⟨k,hk⟩)*zval (A j ⟨k,hk⟩) else 0) d).symm

def DotContext {n d : ℕ} (σ : Env) (A : RectData n d) (i j : Fin n) (l : ℕ) : Prop :=
  σ.vars dimVar=d ∧ σ.vars gramLeft=i.val ∧ σ.vars gramRight=j.val ∧ σ.vars dotIndex=l ∧ RectArrays σ A ∧ ScratchReady σ

def dotArgs : Com := .seq (.assign argAS (.get basisS (rectAddress (.var gramLeft) (.var dotIndex))))
  (.seq (.assign argAN (.get basisN (rectAddress (.var gramLeft) (.var dotIndex))))
    (.seq (.assign argBS (.get basisS (rectAddress (.var gramRight) (.var dotIndex))))
      (.seq (.assign argBN (.get basisN (rectAddress (.var gramRight) (.var dotIndex))))
        (.seq (.assign argCS (.var gramS)) (.assign argCN (.var gramN))))))
def dotBody : Com := .seq dotArgs (.seq call (.seq (savePair gramS gramN)
  (.assign dotIndex (.add (.var dotIndex) (.lit 1)))))
def dotLoop : Com := .while (.lt (.var dotIndex) (.var dimVar)) dotBody
def dotInit : Com := .seq (.assign dotIndex (.lit 0)) (.seq (.assign gramS (.lit 0)) (.assign gramN (.lit 0)))
def dotProgram : Com := .seq dotInit dotLoop



abbrev DotKeeps (c : Com) : Prop :=
  dimVar∉scalarWrites c ∧ gramLeft∉scalarWrites c ∧ gramRight∉scalarWrites c ∧ dotIndex∉scalarWrites c ∧
    basisS∉arrayWrites c ∧ basisN∉arrayWrites c

theorem dotContext_frame {n d l : ℕ} {c : Com} {σ τ : Env} {A : RectData n d} {i j : Fin n}
    (h : DotContext σ A i j l) (fr : Frame c σ τ) (hk : DotKeeps c) : DotContext τ A i j l := by
  rcases hk with ⟨hD,hL,hR,hI,hS,hN⟩
  refine ⟨(fr.vars _ hD).trans h.1,(fr.vars _ hL).trans h.2.1,(fr.vars _ hR).trans h.2.2.1,
    (fr.vars _ hI).trans h.2.2.2.1,?_,?_⟩
  · intro r v
    rw [fr.arrs _ hS,fr.arrs _ hN]
    exact h.2.2.2.2.1 r v
  · simpa only [ScratchReady,fr.len] using h.2.2.2.2.2

/-  Four actual rectangular array reads and two scalar reads prepare the
existing concrete signed multiply-add source. -/
theorem dotArgs_run {W n d : ℕ} (σ : Env) (A : RectData n d) (i j : Fin n) (k : Fin d) (a : Signed)
    (hctx : DotContext σ A i j k.val) (ha : PairRep σ gramS gramN a)
    (hW : n*d<W) (hW3 : 3≤W) (hiM : (A i k).magnitude<W) (hjM : (A j k).magnitude<W) (haM : a.magnitude<W) :
    ∃τ,Run W dotArgs σ τ 40 ∧ CallArgs τ (A i k) (A j k) a := by
  have his := (hctx.2.2.2.2.1 i k).1
  have hin := (hctx.2.2.2.2.1 i k).2
  have hjs := (hctx.2.2.2.2.1 j k).1
  have hjn := (hctx.2.2.2.2.1 j k).2
  have hils := (List.getElem?_eq_some_iff.mp his).1
  have hiln := (List.getElem?_eq_some_iff.mp hin).1
  have hjls := (List.getElem?_eq_some_iff.mp hjs).1
  have hjln := (List.getElem?_eq_some_iff.mp hjn).1
  have hivs : (σ.arrs basisS).getD (d*i.val+k.val) 0=(A i k).sign := by simp only [List.getD_eq_getElem?_getD,his,Option.getD_some]
  have hivn : (σ.arrs basisN).getD (d*i.val+k.val) 0=(A i k).magnitude := by simp only [List.getD_eq_getElem?_getD,hin,Option.getD_some]
  have hjvs : (σ.arrs basisS).getD (d*j.val+k.val) 0=(A j k).sign := by simp only [List.getD_eq_getElem?_getD,hjs,Option.getD_some]
  have hjvn : (σ.arrs basisN).getD (d*j.val+k.val) 0=(A j k).magnitude := by simp only [List.getD_eq_getElem?_getD,hjn,Option.getD_some]
  have hia := (rect_address_lt i k).trans hW
  have hja := (rect_address_lt j k).trans hW
  have hdpos : 0<d := Nat.zero_lt_of_lt k.isLt
  have hnpos : 0<n := Nat.zero_lt_of_lt i.isLt
  have hnB : n<W := by nlinarith
  have hdB : d<W := by nlinarith
  have hiB := i.isLt.trans hnB
  have hjB := j.isLt.trans hnB
  have hkB := k.isLt.trans hdB
  have hmi : d*i.val<W := by omega
  have hmj : d*j.val<W := by omega
  have hisB := (A i k).bit.trans_le (by omega : 2≤W)
  have hjsB := (A j k).bit.trans_le (by omega : 2≤W)
  have hasB := a.bit.trans_le (by omega : 2≤W)
  rcases ha with ⟨has,han⟩
  have hd := hctx.1
  have hi := hctx.2.1
  have hj := hctx.2.2.1
  have hk := hctx.2.2.2.1
  simp only [dimVar,gramLeft,gramRight,dotIndex,gramS,gramN,basisS,basisN] at hd hi hj hk has han hils hiln hjls hjln hivs hivn hjvs hjvn
  imp_vcgen [dotArgs,rectAddress,CallArgs,argAS,argAN,argBS,argBN,argCS,argCN,dimVar,gramLeft,gramRight,dotIndex,gramS,gramN,basisS,basisN,
    hd,hi,hj,hk,has,han,hils,hiln,hjls,hjln,hivs,hivn,hjvs,hjvn,hia,hja,hnB,hdB,hiB,hjB,hkB,hmi,hmj,hisB,hjsB,hasB,hiM,hjM,haM]
  all_goals simp

theorem dotBody_run {W n d H : ℕ} (σ : Env) (A : RectData n d) (i j : Fin n) (k : Fin d)
    (hctx : DotContext σ A i j k.val) (ha : PairRep σ gramS gramN (dotPrefix A i j k.val))
    (hA : RectBound A H) (hW : n*d<W) (hW3 : 3≤W) (hH : H<W) (hcap : d*H^2<W) :
    ∃τ,Run W dotBody σ τ 300 ∧ DotContext τ A i j (k.val+1) ∧ PairRep τ gramS gramN (dotPrefix A i j (k.val+1)) := by
  have hpre := dotPrefix_bound A i j hA k.val
  have hle : k.val*H^2≤d*H^2 := Nat.mul_le_mul_right _ k.isLt.le
  have haM : (dotPrefix A i j k.val).magnitude<W := hpre.trans_lt (hle.trans_lt hcap)
  have hp : (A i k).magnitude*(A j k).magnitude+(dotPrefix A i j k.val).magnitude<W := by
    have hh := Nat.mul_le_mul (hA i k) (hA j k)
    have hb := Nat.mul_le_mul_right (H^2) (show k.val+1≤d by omega)
    nlinarith
  have hout := (madd_magnitude_le (A i k) (A j k) (dotPrefix A i j k.val)).trans_lt hp
  obtain ⟨ρ,ra,hargs⟩ := dotArgs_run σ A i j k (dotPrefix A i j k.val) hctx ha hW hW3
    ((hA i k).trans_lt hH) ((hA j k).trans_lt hH) haM
  have ca := dotContext_frame hctx (Frame.of_run ra) (by decide)
  obtain ⟨ν,rc,hres,hcv,hca,hci,hco⟩ := call_run ρ (A i k) (A j k) (dotPrefix A i j k.val) hargs hW3
    ((hA i k).trans_lt hH) ((hA j k).trans_lt hH) haM hp ca.2.2.2.2.2.1 ca.2.2.2.2.2.2.1 ca.2.2.2.2.2.2.2
  have cc := dotContext_frame ca (Frame.of_run rc) (by decide)
  obtain ⟨η,rs,hpair⟩ := savePair_run ν gramS gramN (madd (A i k) (A j k) (dotPrefix A i j k.val)) hres
    (by decide) (by decide) (by omega) hout
  have cs := dotContext_frame cc (Frame.of_run rs) (by decide)
  have hdW : d<W := by have hn := i.isLt; nlinarith
  let τ := η.setVar dotIndex (k.val+1)
  have ri : Run W (.assign dotIndex (.add (.var dotIndex) (.lit 1))) η τ 4 :=
    Run.assign (evalB_bin (op:=.add) (evalB_var_iff.mpr ⟨cs.2.2.2.1.symm,by rw [cs.2.2.2.1]; omega⟩)
      (evalB_lit (by omega)) (by change k.val+1<W; omega))
  have fi := Frame.of_run ri
  refine ⟨τ,(ra.seq (rc.seq (rs.seq ri))).mono (by omega),?_,?_⟩
  · refine ⟨(fi.vars _ (by decide)).trans cs.1,(fi.vars _ (by decide)).trans cs.2.1,
      (fi.vars _ (by decide)).trans cs.2.2.1,?_,?_,scratchReady_of_run ri cs.2.2.2.2.2⟩
    · simp [τ,Env.setVar]
    · intro r c
      rw [fi.arrs basisS (by decide),fi.arrs basisN (by decide)]
      exact cs.2.2.2.2.1 r c
  · rw [dotPrefix_step]
    exact pair_frame hpair fi (by decide) (by decide)

theorem dotLoop_run {W n d H : ℕ} (σ : Env) (A : RectData n d) (i j : Fin n)
    (hctx : DotContext σ A i j 0) (ha : PairRep σ gramS gramN zero)
    (hA : RectBound A H) (hW : n*d<W) (hW3 : 3≤W) (hH : H<W) (hcap : d*H^2<W) :
    ∃τ,Run W dotLoop σ τ (400*(d+1)) ∧ DotContext τ A i j d ∧ PairRep τ gramS gramN (dotPrefix A i j d) := by
  have hdW : d<W := by have hn := i.isLt; nlinarith
  let I : Env → Prop := fun ρ=>∃l,l≤d ∧ DotContext ρ A i j l ∧ PairRep ρ gramS gramN (dotPrefix A i j l)
  let V : Env → ℕ := fun ρ=>d-ρ.vars dotIndex
  have hcond (ρ : Env) (l : ℕ) (hl : l≤d) (hc : DotContext ρ A i j l) :
      (Cond.lt (.var dotIndex) (.var dimVar)).evalB W ρ=some (decide (l<d)) :=
    evalB_condLt (evalB_var_iff.mpr ⟨hc.2.2.2.1.symm,by rw [hc.2.2.2.1]; omega⟩)
      (evalB_var_iff.mpr ⟨hc.1.symm,by rw [hc.1]; exact hdW⟩)
  have hdef : ∀ρ,I ρ → ∃v,(Cond.lt (.var dotIndex) (.var dimVar)).evalB W ρ=some v := by
    rintro ρ ⟨l,hl,hc,hp⟩
    exact ⟨_,hcond ρ l hl hc⟩
  have hstep : ∀ρ,I ρ → (Cond.lt (.var dotIndex) (.var dimVar)).evalB W ρ=some true →
      ∃τ,Run W dotBody ρ τ 300 ∧ I τ ∧ V τ<V ρ := by
    rintro ρ ⟨l,hl,hc,hp⟩ ht
    rw [hcond ρ l hl hc] at ht
    have hld : l<d := by simpa using ht
    obtain ⟨τ,hr,hct,hpt⟩ := dotBody_run ρ A i j ⟨l,hld⟩ hc hp hA hW hW3 hH hcap
    refine ⟨τ,hr,⟨l+1,by omega,hct,hpt⟩,?_⟩
    simp only [V,hct.2.2.2.1,hc.2.2.2.1]
    omega
  have hi : I σ := ⟨0,by omega,hctx,ha⟩
  obtain ⟨τ,hr,⟨l,hl,hc,hp⟩,ht⟩ := Run.while_count I V 300 hdef hstep hi
  rw [hcond τ l hl hc] at ht
  have hld : l=d := by
    have hnot : ¬l<d := by simpa using ht
    omega
  rw [hld] at hc hp
  refine ⟨τ,hr.mono ?_,hc,hp⟩
  simp only [V,hctx.2.2.2.1,Cond.size,Expr.size,Nat.sub_zero]
  omega

theorem dotProgram_run {W n d H : ℕ} (σ : Env) (A : RectData n d) (i j : Fin n)
    (hd : σ.vars dimVar=d) (hi : σ.vars gramLeft=i.val) (hj : σ.vars gramRight=j.val)
    (harr : RectArrays σ A) (hready : ScratchReady σ)
    (hA : RectBound A H) (hW : n*d<W) (hW3 : 3≤W) (hH : H<W) (hcap : d*H^2<W) :
    ∃τ,Run W dotProgram σ τ (500*(d+1)) ∧ PairRep τ gramS gramN (dotPrefix A i j d) := by
  let σ1 := σ.setVar dotIndex 0
  let σ2 := σ1.setVar gramS 0
  let ρ := σ2.setVar gramN 0
  have r1 : Run W (.assign dotIndex (.lit 0)) σ σ1 2 := Run.assign (evalB_lit (by omega))
  have r2 : Run W (.assign gramS (.lit 0)) σ1 σ2 2 := Run.assign (evalB_lit (by omega))
  have r3 : Run W (.assign gramN (.lit 0)) σ2 ρ 2 := Run.assign (evalB_lit (by omega))
  have rinit : Run W dotInit σ ρ 6 := r1.seq (r2.seq r3)
  have fr := Frame.of_run rinit
  have hc : DotContext ρ A i j 0 := by
    refine ⟨(fr.vars _ (by decide)).trans hd,(fr.vars _ (by decide)).trans hi,(fr.vars _ (by decide)).trans hj,?_,?_,scratchReady_of_run rinit hready⟩
    · simp [ρ,σ2,σ1,Env.setVar,dotIndex,gramS,gramN]
    · intro r c
      rw [fr.arrs basisS (by decide),fr.arrs basisN (by decide)]
      exact harr r c
  have hp : PairRep ρ gramS gramN zero := by simp [PairRep,ρ,σ2,σ1,Env.setVar,gramS,gramN,dotIndex,zero]
  obtain ⟨τ,hr,hctx,hrep⟩ := dotLoop_run ρ A i j hc hp hA hW hW3 hH hcap
  exact ⟨τ,(rinit.seq hr).mono (by omega),hrep⟩



def selectedRow {n : ℕ} (target : Fin n) (k : ℕ) (mixed : Bool) (r : Fin n) : Fin n :=
  if mixed then if r.val+1=k then target else r else r

def buildData {n d : ℕ} (A : RectData n d) (target : Fin n) (k : ℕ) (mixed : Bool) : Data n := fun r c=>
  if r.val<k then if c.val<k then dotPrefix A (selectedRow target k mixed r) c d else zero
  else if r=c then one else zero

theorem buildData_bound {n d H : ℕ} (A : RectData n d) (target : Fin n) (k : ℕ) (mixed : Bool) (hA : RectBound A H) :
    DataBound (buildData A target k mixed) (d*H^2+1) := by
  intro r c
  unfold buildData
  split_ifs
  · exact (dotPrefix_bound A _ _ hA d).trans (by omega)
  · simp [zero]
  · simp [one]
  · simp [zero]

theorem buildData_prefix {n d : ℕ} (A : RectData n d) (target : Fin n) (k : ℕ) :
    N0301.unpack (packed (buildData A target k false))=paddedGram (rectValue A) k := by
  rw [packed,N0301.unpack_pack]
  funext r c
  simp only [buildData,selectedRow,Bool.false_eq_true,↓reduceIte,paddedGram,padPrefix]
  split_ifs <;> first | exact dotPrefix_full A r c | rfl

theorem buildData_mixed {n d : ℕ} (A : RectData n d) (target j : Fin n) :
    N0301.unpack (packed (buildData A target (j.val+1) true))=paddedMixed (rectValue A) target j := by
  rw [packed,N0301.unpack_pack]
  funext r c
  simp only [buildData,selectedRow,↓reduceIte,paddedMixed,padPrefix]
  split_ifs <;> (try simp_all only [dotPrefix_full,Matrix.updateRow_apply,Subtype.ext_iff,Fin.ext_iff,Nat.add_right_cancel_iff])
  all_goals rfl

def prefixVar : String := "LLL.reducer.prefix"
def mixedVar : String := "LLL.reducer.mixed"
def targetVar : String := "LLL.reducer.target"

def dotSelect : Com := .seq (.assign gramLeft (.var rowVar))
  (.seq (.ite (.eq (.var mixedVar) (.lit 0)) .skip
    (.ite (.eq (.add (.var rowVar) (.lit 1)) (.var prefixVar)) (.assign gramLeft (.var targetVar)) .skip))
    (.assign gramRight (.var colVar)))
def copyGram : Com := .seq (.assign resultS (.var gramS)) (.assign resultN (.var gramN))
def interior : Com := .seq dotSelect (.seq dotProgram copyGram)
def constantEntry (v : ℕ) : Com := .seq (.assign resultS (.lit 0)) (.assign resultN (.lit v))
def matrixEntry : Com := .ite (.lt (.var rowVar) (.var prefixVar))
  (.ite (.lt (.var colVar) (.var prefixVar)) interior (constantEntry 0))
  (.ite (.eq (.var rowVar) (.var colVar)) (constantEntry 1) (constantEntry 0))

theorem dotSelect_run {W n : ℕ} (σ : Env) (r c target : Fin n) (k : ℕ) (mixed : Bool)
    (hr : σ.vars rowVar=r.val) (hc : σ.vars colVar=c.val) (ht : σ.vars targetVar=target.val)
    (hk : σ.vars prefixVar=k) (hm : σ.vars mixedVar=if mixed then 1 else 0)
    (hkN : k≤n) (hnW : n<W) (hW3 : 3≤W) :
    ∃τ,Run W dotSelect σ τ 20 ∧ τ.vars gramLeft=(selectedRow target k mixed r).val ∧ τ.vars gramRight=c.val := by
  have hrB := r.isLt.trans hnW
  have hcB := c.isLt.trans hnW
  have htB := target.isLt.trans hnW
  have hkB : k<W := hkN.trans_lt hnW
  have hsB : r.val+1<W := by omega
  simp only [rowVar,colVar,targetVar,prefixVar,mixedVar] at hr hc ht hk hm
  cases mixed <;> by_cases he : r.val+1=k
  all_goals apply wp.run
  all_goals imp_vcgen [dotSelect,rowVar,colVar,targetVar,prefixVar,mixedVar,gramLeft,gramRight,hr,hc,ht,hk,hm]
  all_goals simp_all [selectedRow,gramLeft,gramRight]
  all_goals omega

theorem copyGram_run {W : ℕ} (σ : Env) (a : Signed) (ha : PairRep σ gramS gramN a)
    (hmag : a.magnitude<W) (hW2 : 2≤W) :
    ∃τ,Run W copyGram σ τ 4 ∧ CallResult τ a := by
  rcases ha with ⟨hs,hn⟩
  have hsb := a.bit.trans_le hW2
  simp only [gramS,gramN] at hs hn
  apply wp.run
  imp_vcgen [copyGram,CallResult,gramS,gramN,resultS,resultN,hs,hn]
  all_goals simp_all

theorem interior_run {W n d H : ℕ} (σ : Env) (A : RectData n d) (r c target : Fin n) (k : ℕ) (mixed : Bool)
    (hr : σ.vars rowVar=r.val) (hc : σ.vars colVar=c.val) (ht : σ.vars targetVar=target.val)
    (hk : σ.vars prefixVar=k) (hm : σ.vars mixedVar=if mixed then 1 else 0) (hd : σ.vars dimVar=d)
    (harr : RectArrays σ A) (hready : ScratchReady σ) (hA : RectBound A H)
    (hkN : k≤n) (hnW : n<W) (hW : n*d<W) (hW3 : 3≤W) (hH : H<W) (hcap : d*H^2<W) :
    ∃τ,Run W interior σ τ (600*(d+1)) ∧ CallResult τ (dotPrefix A (selectedRow target k mixed r) c d) := by
  obtain ⟨ρ,rs,hl,hr'⟩ := dotSelect_run σ r c target k mixed hr hc ht hk hm hkN hnW hW3
  have fs := Frame.of_run rs
  have hdρ : ρ.vars dimVar=d := (fs.vars _ (by decide)).trans hd
  have haρ : RectArrays ρ A := by
    intro i j
    rw [fs.arrs basisS (by decide),fs.arrs basisN (by decide)]
    exact harr i j
  obtain ⟨ν,rd,hrep⟩ := dotProgram_run ρ A (selectedRow target k mixed r) c hdρ hl hr' haρ
    (scratchReady_of_run rs hready) hA hW hW3 hH hcap
  obtain ⟨τ,rc,hres⟩ := copyGram_run ν (dotPrefix A (selectedRow target k mixed r) c d) hrep
    ((dotPrefix_bound A _ _ hA d).trans_lt hcap) (by omega)
  exact ⟨τ,(rs.seq (rd.seq rc)).mono (by omega),hres⟩

theorem constantEntry_run {W : ℕ} (σ : Env) (v : ℕ) (hv : v<W) (hW : 0<W) :
    ∃τ,Run W (constantEntry v) σ τ 4 ∧ CallResult τ ⟨0,v,by decide⟩ := by
  apply wp.run
  imp_vcgen [constantEntry,CallResult,resultS,resultN]
  all_goals simp_all

theorem matrixEntry_run {W n d H : ℕ} (σ : Env) (A : RectData n d) (r c target : Fin n) (k : ℕ) (mixed : Bool)
    (hr : σ.vars rowVar=r.val) (hc : σ.vars colVar=c.val) (ht : σ.vars targetVar=target.val)
    (hk : σ.vars prefixVar=k) (hm : σ.vars mixedVar=if mixed then 1 else 0) (hd : σ.vars dimVar=d)
    (harr : RectArrays σ A) (hready : ScratchReady σ) (hA : RectBound A H)
    (hkN : k≤n) (hnW : n<W) (hW : n*d<W) (hW3 : 3≤W) (hH : H<W) (hcap : d*H^2<W) :
    ∃τ,Run W matrixEntry σ τ (700*(d+1)) ∧ CallResult τ (buildData A target k mixed r c) := by
  have er : (Expr.var rowVar).evalB W σ=some r.val := evalB_var_iff.mpr ⟨hr.symm,by rw [hr]; exact r.isLt.trans hnW⟩
  have ec : (Expr.var colVar).evalB W σ=some c.val := evalB_var_iff.mpr ⟨hc.symm,by rw [hc]; exact c.isLt.trans hnW⟩
  have ek : (Expr.var prefixVar).evalB W σ=some k := evalB_var_iff.mpr ⟨hk.symm,by rw [hk]; exact hkN.trans_lt hnW⟩
  have cr := evalB_condLt er ek
  have cc := evalB_condLt ec ek
  have ce := evalB_condEq er ec
  by_cases hR : r.val<k
  · by_cases hC : c.val<k
    · obtain ⟨τ,ri,hres⟩ := interior_run σ A r c target k mixed hr hc ht hk hm hd harr hready hA hkN hnW hW hW3 hH hcap
      refine ⟨τ,(Run.ite_true (by simpa only [hR,decide_true] using cr)
        (Run.ite_true (by simpa only [hC,decide_true] using cc) ri)).mono ?_,?_⟩
      · simp [Cond.size,Expr.size]
        omega
      · simpa only [buildData,if_pos hR,if_pos hC] using hres
    · obtain ⟨τ,rz,hres⟩ := constantEntry_run (W:=W) σ 0 (by omega) (by omega)
      refine ⟨τ,(Run.ite_true (by simpa only [hR,decide_true] using cr)
        (Run.ite_false (by simpa only [hC,decide_false] using cc) rz)).mono ?_,?_⟩
      · simp [Cond.size,Expr.size]
        omega
      · simpa only [buildData,if_pos hR,if_neg hC,zero] using hres
  · by_cases hEq : r=c
    · obtain ⟨τ,ro,hres⟩ := constantEntry_run (W:=W) σ 1 (by omega) (by omega)
      refine ⟨τ,(Run.ite_false (by simpa only [hR,decide_false] using cr)
        (Run.ite_true (by simpa [hEq] using ce) ro)).mono ?_,?_⟩
      · simp [Cond.size,Expr.size]
        omega
      · simpa only [buildData,if_neg hR,if_pos hEq,one] using hres
    · have hval : r.val≠c.val := by simpa only [Fin.ext_iff] using hEq
      obtain ⟨τ,rz,hres⟩ := constantEntry_run (W:=W) σ 0 (by omega) (by omega)
      refine ⟨τ,(Run.ite_false (by simpa only [hR,decide_false] using cr)
        (Run.ite_false (by simpa [hval] using ce) rz)).mono ?_,?_⟩
      · simp [Cond.size,Expr.size]
        omega
      · simpa only [buildData,if_neg hR,if_neg hEq,zero] using hres



open N0167 (count)

def buildSign {n d : ℕ} (A : RectData n d) (target : Fin n) (k : ℕ) (mixed : Bool) (l : ℕ) : ℕ :=
