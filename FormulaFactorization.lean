variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}

theorem clobbered_scalar (x : String) (hx : x ∈ clobbered r) : x ∈ regNames r :=
  clobbered_reg r x hx

theorem RNames.Valid.reg_ok {q : RNames} (hq : q.Valid r) {x : String} (hx : x ∈ q.list) :
    x ∉ clobbered r ∧ x ≠ r.aBase ∧ x ≠ r.bBase ∧ x ≠ r.outBase := by
  have h := hq.2 x hx
  refine ⟨fun hc => h (clobbered_scalar x hc), ?_, ?_, ?_⟩ <;>
    (intro he; apply h; rw [he]; simp [regNames, scalarNames])

theorem RNames.Valid.not_aBase {q : RNames} (hq : q.Valid r) : r.aBase ∉ q.list := fun h =>
  (hq.reg_ok h).2.1 rfl

theorem RNames.Valid.not_bBase {q : RNames} (hq : q.Valid r) : r.bBase ∉ q.list := fun h =>
  (hq.reg_ok h).2.2.1 rfl

/-! ### Macro calls on slot expressions -/

/-  A field-macro call with slot arguments. -/
def mcall (r : FieldNames) (q : RNames) (c : Com) (a b o : Expr) : Com :=
  call r (addr r q.WS a) (addr r q.WS b) (addr r q.WS o) c

def plus (a b : Expr) : Expr := .bin .add a b

/-  One update step. -/
def axpyBody (M : FieldMacros F r) (q : RNames) (D S : Expr) : Com :=
  .seq (mcall r q M.mul (.lit 2) (plus S (.var q.j)) (.lit 3))
    (.seq (mcall r q M.sub (plus D (.var q.j)) (.lit 3) (.lit 4))
      (.seq (mcall r q M.copy (.lit 4) (.lit 4) (plus D (.var q.j)))
        (.assign q.j (plus (.var q.j) (.lit 1)))))

/-  `dst[j] := dst[j] - t * src[j]` for all `j < N`. -/
def axpyLoop (M : FieldMacros F r) (q : RNames) (D S : Expr) : Com :=
  .seq (.assign q.j (.lit 0)) (.while (.lt (.var q.j) (.var q.N)) (axpyBody M q D S))

/-  The cost of one iteration. -/
def axpyStep (M : FieldMacros F r) (D S : Expr) : ℕ :=
  70 + 2 * (D.size + S.size) + M.costMul + 2 * M.costPoint

/-  The cost of the loop. -/
def axpyCost (M : FieldMacros F r) (D S : Expr) (N : ℕ) : ℕ :=
  2 + (4 + axpyStep M D S) * N + 4

/-  Frame of a routine on the workspace. -/






theorem val_eq_of_slice {WS : String} {σ τ : Env} {s : ℕ}
    (h : slice F τ r (τ.vars WS + s * F.e) = slice F σ r (σ.vars WS + s * F.e)) :
    val F r WS τ s = val F r WS σ s := by
  unfold val; rw [h]

/-  The registers a reduction changes. -/
def RNames.moving (q : RNames) : List String := [q.u, q.w, q.j, q.i, q.pv, q.f]

/-  All registers except `j`. -/
def RNames.fixed (q : RNames) : List String := [q.WS, q.N, q.c, q.n, q.u, q.w, q.i, q.pv, q.f]

theorem RNames.fixed_sub (q : RNames) : ∀ x ∈ q.fixed, x ∈ q.list := by
  intro x hx
  simp only [RNames.fixed, RNames.list, List.mem_cons, List.not_mem_nil, or_false] at hx ⊢
  tauto

theorem RNames.j_mem (q : RNames) : q.j ∈ q.list := by simp [RNames.list]

theorem RNames.WS_mem (q : RNames) : q.WS ∈ q.list := by simp [RNames.list]

theorem RNames.N_mem (q : RNames) : q.N ∈ q.list := by simp [RNames.list]

theorem RNames.Valid.j_not_fixed {q : RNames} (hq : q.Valid r) : q.j ∉ q.fixed := by
  have hn := hq.1
  simp only [RNames.list, List.nodup_cons, List.mem_cons, List.not_mem_nil, or_false,
    not_or] at hn
  simp only [RNames.fixed, List.mem_cons, List.not_mem_nil, or_false, not_or]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;> intro h <;> simp_all

theorem RNames.Valid.ne_of {q : RNames} (hq : q.Valid r) {x y : String}
    (h : x = y → ¬ q.list.Nodup) : x ≠ y := fun e => h e hq.1

theorem RNames.Valid.WS_ne_j {q : RNames} (hq : q.Valid r) : q.WS ≠ q.j := by
  intro h; exact hq.j_not_fixed (h ▸ by simp [RNames.fixed])

/-  Facts preserved by a call for the control registers. -/
theorem call_regs {q : RNames} (hq : q.Valid r) {WS : String} {S B : ℕ} {σ τ : Env} {so : ℕ}
    (h : CallResult F r WS S B σ τ so) : ∀ x ∈ q.list, τ.vars x = σ.vars x := by
  intro x hx
  obtain ⟨h1, h2, h3, h4⟩ := hq.reg_ok hx
  exact h.vars x h1 h2 h3 h4

/-  Every register outside the field-macro registers survives a call. -/
theorem call_regs_all {WS : String} {S B : ℕ} {σ τ : Env} {so : ℕ}
    (h : CallResult F r WS S B σ τ so) : ∀ x, x ∉ regNames r → τ.vars x = σ.vars x := by
  intro x hx
  refine h.vars x (fun hc => hx (clobbered_scalar x hc)) ?_ ?_ ?_ <;>
    (intro he; apply hx; rw [he]; simp [regNames, scalarNames])

theorem eq_regs_all {WS : String} {S B : ℕ} {σ τ : Env}
    (h : EqResult F r WS S B σ τ) : ∀ x, x ∉ regNames r → τ.vars x = σ.vars x := by
  intro x hx
  refine h.vars x (fun hc => hx (clobbered_scalar x hc)) ?_ ?_ ?_ <;>
    (intro he; apply hx; rw [he]; simp [regNames, scalarNames])

theorem call_val {WS : String} {S B : ℕ} {σ τ : Env} {so : ℕ}
    (h : CallResult F r WS S B σ τ so) {s : ℕ} (hs : s < S) (hne : s ≠ so) :
    val F r WS τ s = val F r WS σ s := val_eq_of_slice (h.others s hs hne)

