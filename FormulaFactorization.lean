    all_goals rcases hx with rfl|rfl|rfl|rfl|rfl <;> tauto
  have hm:=storedBuffer_memory r σ n f h.separate
  refine {
    degree:=(hv r.e (by simp)).trans h.degree,
    prime:=(hv r.p (by simp)).trans h.prime,separate:=h.separate,
    outer_names:=h.outer_names,inner_names:=h.inner_names,private_names:=h.private_names,
    arithmetic_word:=h.arithmetic_word,memory_word:=?_,scratch_word:=?_,scratch_fit:=?_,
    modulus_fit:=?_,modulus_value:=?_,first_fit:=?_,first_canonical:=?_,output_fit:=?_ }
