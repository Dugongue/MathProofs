           (pow_le_pow_right₀ hw' (Nat.sub_le k j |>.trans hk))
       _ = _ := by rw [← mul_pow]; congr 1; ring

private lemma full_bound (M : ℕ) (a t : ℤ) (w H : ℕ) (hw : 1 ≤ w) (hH : 1 ≤ H)
