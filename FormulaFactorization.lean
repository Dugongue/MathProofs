def clippedCoefficientBudget (p N d F W S : ℕ) : ℕ :=
  let V := reverseCoefficientBudget p N d F W S
  (N+1)*(N0344.projectionCostBound (N+V) V+2)+(2+N0090.ratWeight 0)

/-  A fixed polynomial in actual initialized numeric heights and actual input source size. -/
def outputBudget (p N d F W S y : ℕ) : ℕ :=
  N0344.tableCostBound p (clippedCoefficientBudget p N d F W S) y+(2+N0090.ratWeight 1)

