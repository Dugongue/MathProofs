theorem encoded_output_length_le {α β A B : Type} {ea : α → List A} {eb : β → List B}
    {f : α → β} (h : TM2ComputableInPolyTime ea eb f) (a : α) :
    (eb (f a)).length ≤ (outputLengthPolynomial h).eval (ea a).length := by
  have hr := Internal.outputsInTime_length_le h.tm
    (List.map h.inputAlphabet.invFun (ea a))
    (List.map h.outputAlphabet.invFun (eb (f a)))
    (h.time.eval (ea a).length) (h.outputsFun a)
  simpa only [List.length_map,outputLengthPolynomial,Polynomial.eval_add,
    Polynomial.eval_X,Polynomial.eval_mul,Polynomial.eval_C,Nat.mul_comm] using hr

/-  Monotonicity uses natural coefficients, without a supplied size hypothesis. -/
theorem polynomial_monotone (p : Polynomial ℕ) : Monotone p.eval :=
  Internal.natPolynomial_eval_monotone p

end
