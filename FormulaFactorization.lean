      rw [he, Nat.add_mod_left, Nat.mod_eq_of_lt (by omega)]
    · have hk : (a.toNat + b.toNat) % UInt64.word = a.toNat + b.toNat - UInt64.word := by
        rw [Nat.mod_eq_sub_mod hle, Nat.mod_eq_of_lt (by omega)]
