variable {R : Type*} [CommRing R] [Algebra ℚ R]

theorem binomialSeries_pow (r : ℚ) (k : ℕ) :
    (PowerSeries.binomialSeries R r) ^ k = PowerSeries.binomialSeries R ((k : ℚ) * r) := by
  induction k with
  | zero => simp
  | succ k ih =>
      rw [pow_succ, ih, ← PowerSeries.binomialSeries_add]
      congr 1
      push_cast
      ring

/-  Roots with normalized constant term are unique because the geometric factor is a unit. -/
theorem normalized_power_unique (k : ℕ) (hk : 0 < k)
    (S T : PowerSeries R) (hS : S.constantCoeff = 1) (hT : T.constantCoeff = 1)
    (hpow : S ^ k = T ^ k) : S = T := by
  let V : PowerSeries R := ∑ i ∈ range k, S ^ i * T ^ (k - 1 - i)
  have hV : V.constantCoeff = (k : R) := by simp [V, hS, hT]
  have hunit : IsUnit V := by
    apply PowerSeries.isUnit_iff_constantCoeff.mpr
    rw [hV]
    have hq : IsUnit (k : ℚ) := isUnit_iff_ne_zero.mpr (Nat.cast_ne_zero.mpr (by omega))
    simpa using hq.map (algebraMap ℚ R)
  have hzero : V * (S - T) = 0 := by
    rw [show V * (S - T) = S ^ k - T ^ k from (Commute.all S T).geom_sum₂_mul k]
    rw [hpow, sub_self]
  have hz : S - T = 0 := hunit.mul_left_cancel (by simpa using hzero)
  exact sub_eq_zero.mp hz

/-  Substitution of the zero-constant perturbation into the binomial series gives its chosen root. -/
theorem binomial_series_root (k : ℕ) (hk : 0 < k) (H : PowerSeries R)
    (hH : H.constantCoeff = 1) :
    (PowerSeries.binomialSeries ℚ ((k : ℚ)⁻¹)).subst (H ^ k - 1) = H := by
  let U : PowerSeries R := H ^ k - 1
  have hU : U.constantCoeff = 0 := by simp [U, hH]
  have hsubst : PowerSeries.HasSubst U := .of_constantCoeff_zero' hU
  let S : PowerSeries R := (PowerSeries.binomialSeries ℚ ((k : ℚ)⁻¹)).subst U
  have hS : S.constantCoeff = 1 := by
    rw [show S = (PowerSeries.binomialSeries ℚ ((k : ℚ)⁻¹)).subst U from rfl]
    rw [← PowerSeries.coeff_zero_eq_constantCoeff, PowerSeries.coeff_subst' hsubst]
    rw [finsum_eq_single _ 0]
    · simp
    · intro j hj
      have hp := PowerSeries.le_order_pow_of_constantCoeff_eq_zero j hU
      have hz : PowerSeries.coeff 0 (U ^ j) = 0 :=
        PowerSeries.coeff_of_lt_order _ (lt_of_lt_of_le (by exact_mod_cast Nat.pos_of_ne_zero hj) hp)
      simp [hz]
  have hp : S ^ k = H ^ k := by
    rw [show S = (PowerSeries.binomialSeries ℚ ((k : ℚ)⁻¹)).subst U from rfl,
      ← PowerSeries.subst_pow hsubst, binomialSeries_pow]
    have hkinv : (k : ℚ) * (k : ℚ)⁻¹ = 1 := mul_inv_cancel₀ (Nat.cast_ne_zero.mpr (by omega))
    rw [hkinv, show (1 : ℚ) = (1 : ℕ) from rfl, PowerSeries.binomialSeries_nat]
    simp only [pow_one]
    rw [PowerSeries.subst_add hsubst, PowerSeries.subst_X hsubst]
    have hone : PowerSeries.subst U (1 : PowerSeries ℚ) = 1 := by
      rw [← PowerSeries.coe_substAlgHom hsubst, map_one]
    rw [hone]
    dsimp [U]
    ring
  exact normalized_power_unique k hk S H hS hH hp


theorem coeff_power_zero (U : PowerSeries R) (hU : U.constantCoeff = 0)
    (n j : ℕ) (hnj : n < j) : PowerSeries.coeff n (U ^ j) = 0 := by
  apply PowerSeries.coeff_of_lt_order
  exact (show (n : ℕ∞) < j by exact_mod_cast hnj).trans_le
    (PowerSeries.le_order_pow_of_constantCoeff_eq_zero j hU)

theorem binomial_series_coeff_finite (k d n : ℕ) (U : PowerSeries R)
    (hU : U.constantCoeff = 0) (hn : n ≤ d) :
    PowerSeries.coeff n ((PowerSeries.binomialSeries ℚ ((k : ℚ)⁻¹)).subst U) =
      ∑ j ∈ range (d + 1), algebraMap ℚ R (binomialWeight k j) *
        PowerSeries.coeff n (U ^ j) := by
  rw [PowerSeries.coeff_subst' (.of_constantCoeff_zero' hU)]
  calc
    _ = ∑ j ∈ range (d + 1),
        PowerSeries.coeff j (PowerSeries.binomialSeries ℚ ((k : ℚ)⁻¹)) •
          PowerSeries.coeff n (U ^ j) := by
      apply finsum_eq_sum_of_support_subset
      intro j hj
      change _ ≠ 0 at hj
      by_contra hmem
      have hjd : d < j := by simpa using hmem
      have hz := coeff_power_zero U hU n j (by omega)
      exact hj (by simp [hz])
    _ = _ := by
      apply Finset.sum_congr rfl
      intro j hj
      simp [binomialWeight_eq, Algebra.smul_def]

noncomputable def finiteBinomial (k d : ℕ) (U : R[X]) : R[X] :=
  ∑ j ∈ range (d + 1), C (algebraMap ℚ R (binomialWeight k j)) * U ^ j

theorem finiteBinomial_coeff (k d n : ℕ) (hk : 0 < k) (H : R[X])
    (hH : H.coeff 0 = 1) (hn : n ≤ d) :
    (finiteBinomial k d (H ^ k - 1)).coeff n = H.coeff n := by
  have hh : (H : PowerSeries R).constantCoeff = 1 := by simpa using hH
  have hU : ((H : PowerSeries R) ^ k - 1).constantCoeff = 0 := by simp [hh]
  have hc := binomial_series_coeff_finite k d n ((H : PowerSeries R) ^ k - 1) hU hn
  rw [binomial_series_root k hk _ hh] at hc
  have hco : ((H ^ k - 1 : R[X]) : PowerSeries R) = (H : PowerSeries R) ^ k - 1 := by simp
  rw [← hco] at hc
  have hs : ∀ j, PowerSeries.coeff n (((H ^ k - 1 : R[X]) : PowerSeries R) ^ j) =
      ((H ^ k - 1) ^ j : R[X]).coeff n := by
    intro j
    rw [← Polynomial.coe_pow, Polynomial.coeff_coe]
  simpa only [finiteBinomial, finsetSum_coeff, coeff_C_mul, Polynomial.coeff_coe, hs] using hc.symm









