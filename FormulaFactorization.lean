  N0344.projectionCostBound (p*p)
    (logBudget p (N0344.tableCostBound p (2+F) 0+4+N0090.ratWeight (-1)))

def logSourceBudget (p N d F W S : ℕ) : ℕ :=
  N0344.tableCostBound p
    (2+fiberCoefficientBudget p F+correctionBudget N d W S+(2+N0090.ratWeight 0)) 0

def reverseCoefficientBudget (p N d F W S : ℕ) : ℕ :=
  N0344.projectionCostBound (p*p)
