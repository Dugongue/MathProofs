/-  Explicit linear copying bill for the coefficient formula. -/
theorem coefficientFormula_gateCount {ι : Type}
    (M k : ℕ) (f : N0090.Formula (Option ι)) :
    (coefficientFormula M k f).gateCount = (M + 1) * (f.gateCount + 3) + 1 := by
