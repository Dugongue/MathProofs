namespace Internal.N0339.N0197.N0004
open scoped BigOperators
open Polynomial
set_option backward.isDefEq.respectTransparency false

abbrev Labels (r : ℕ) := Vector (Fin r) r
abbrev Inspector (r : ℕ) := Labels r → Fin r → Option (Labels r)

/-  Test anchors in order, stopping immediately at the first failed test.
