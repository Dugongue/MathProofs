    | nil => rfl
    | cons a s =>
      simp only [ListBlank.head_mk,List.headI_cons,halfCode_mk,listCode]
      have hh := symbol_lt a
      omega

theorem halfCode_tail (s : ListBlank (Option Bool)) : halfCode s.tail=halfCode s/4 := by
  induction s using ListBlank.induction_on with
  | h s =>
    cases s with
    | nil => rfl
    | cons a s =>
      simp only [ListBlank.tail_mk,List.tail_cons,halfCode_mk,listCode]
      have hh := symbol_lt a
      omega

