import Mathlib.RingTheory.AdjoinRoot
import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
import Mathlib.LinearAlgebra.Dimension.Free
import Mathlib.FieldTheory.Minpoly.Basic
import Mathlib.LinearAlgebra.Matrix.ToLin

/-! Exact alignment over the coefficient field of a primary operator. -/
namespace Mathproof.Problem17ComparatorPrimaryAlign
open Algebra Module Polynomial

set_option backward.isDefEq.respectTransparency false
set_option linter.style.haveILetI false

variable {K V W : Type*} [Field K]
  [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]

/-- The literal algebra generated by a polynomial root acting on a space. -/
noncomputable def rootAction (f : K[X]) (S : End K V) (hS : aeval S f = 0) :
    AdjoinRoot f →ₐ[K] End K V := by
  let A := adjoin K ({S} : Set (End K V))
  let s : A := ⟨S, self_mem_adjoin_singleton K S⟩
  have hs : f.eval₂ (Algebra.ofId K A) s = 0 := by
    change f.eval₂ (algebraMap K A) s = 0
    rw [← aeval_def]
    apply Subtype.ext
    change ((aeval s f : A) : End K V) = 0
    exact (coe_aeval_mk_apply (p := f) S (self_mem_adjoin_singleton K S)).trans hS
  exact A.val.comp (AdjoinRoot.liftAlgHom f (Algebra.ofId K A) s hs)

@[simp] theorem rootAction_root (f : K[X]) (S : End K V) (hS : aeval S f = 0) :
    rootAction f S hS (AdjoinRoot.root f) = S := by
  unfold rootAction
  rw [AlgHom.comp_apply, AdjoinRoot.liftAlgHom_root]
  rfl

theorem rootAction_mem (f : K[X]) (S : End K V) (hS : aeval S f = 0) (a : AdjoinRoot f) :
    rootAction f S hS a ∈ adjoin K ({S} : Set (End K V)) := by
  unfold rootAction
  exact Subtype.property _

/-- Intertwining the root implies intertwining the entire field action. -/
theorem root_intertwining {f : K[X]} (φ : AdjoinRoot f →ₐ[K] End K V)
    (ψ : AdjoinRoot f →ₐ[K] End K W) (L : V →ₗ[K] W)
    (h : ∀ x, L (φ (AdjoinRoot.root f) x) = ψ (AdjoinRoot.root f) (L x)) :
    ∀ a x, L (φ a x) = ψ a (L x) := by
  intro a
  have ha : a ∈ adjoin K ({AdjoinRoot.root f} : Set (AdjoinRoot f)) := by
    rw [AdjoinRoot.adjoinRoot_eq_top]; trivial
  induction ha using Algebra.adjoin_induction with
  | mem b hb =>
    obtain rfl : b = AdjoinRoot.root f := hb
    exact h
  | algebraMap r =>
    intro x
    rw [φ.commutes, ψ.commutes]
    exact L.map_smul r x
  | add b c hb hc ihb ihc =>
    intro x
    simp [map_add, ihb, ihc]
  | mul b c hb hc ihb ihc =>
    intro x
    rw [map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply, ihb, ihc]

private theorem intertwines_pow (L : V →ₗ[K] W) (S : End K V) (T : End K W)
    (h : ∀ x, L (S x) = T (L x)) (r : ℕ) :
    ∀ x, L ((S^r) x) = (T^r) (L x) := by
  induction r with
  | zero => simp
  | succ r ih =>
    intro x
    rw [pow_succ, pow_succ, Module.End.mul_apply, Module.End.mul_apply, ih, h]

/-- Under the explicitly specified coefficient-field actions, every
base-field intertwiner is exactly a field-linear intertwiner of the original
operators. This is the completeness of enumerating all field-linear maps on
repeated blocks and testing the original intertwiner equation. -/
theorem filtered_primary_iff {f : K[X]} [Fact (Irreducible f)]
    (S : End K V) (T : End K W) (r : ℕ)
    (hS : aeval (S^r) f = 0) (hT : aeval (T^r) f = 0) :
    letI : Module (AdjoinRoot f) V := Module.compHom V (rootAction f (S^r) hS).toRingHom
    letI : Module (AdjoinRoot f) W := Module.compHom W (rootAction f (T^r) hT).toRingHom
    (∃ L : V ≃ₗ[K] W, ∀ x, L (S x) = T (L x)) ↔
      ∃ L : V ≃ₗ[AdjoinRoot f] W, ∀ x, L (S x) = T (L x) := by
  let φ := rootAction f (S^r) hS
  let ψ := rootAction f (T^r) hT
  letI : Module (AdjoinRoot f) V := Module.compHom V φ.toRingHom
  letI : Module (AdjoinRoot f) W := Module.compHom W ψ.toRingHom
  haveI : IsScalarTower K (AdjoinRoot f) V := ⟨fun a b x => by
    change φ (a • b) x = a • φ b x
    rw [map_smul]
    rfl⟩
  haveI : IsScalarTower K (AdjoinRoot f) W := ⟨fun a b x => by
    change ψ (a • b) x = a • ψ b x
    rw [map_smul]
    rfl⟩
  constructor
  · rintro ⟨L, hL⟩
    have h := root_intertwining φ ψ L.toLinearMap (by
      simpa [φ, ψ] using intertwines_pow L.toLinearMap S T hL r)
    let L' : V ≃ₗ[AdjoinRoot f] W :=
      { toEquiv := L.toEquiv
        map_add' := L.map_add
        map_smul' := h }
    exact ⟨L', hL⟩
  · rintro ⟨L, hL⟩
    exact ⟨L.restrictScalars K, hL⟩

/-- Equal base-field dimensions give an alignment of the coefficient roots
without a rational canonical form of the original operators. -/
theorem align_primary_roots [Module.Finite K V] [Module.Finite K W]
    {f : K[X]} [Fact (Irreducible f)] (hf : f.Monic)
    (S : End K V) (T : End K W) (hS : aeval S f = 0) (hT : aeval T f = 0)
    (hd : finrank K V = finrank K W) :
    ∃ L : V ≃ₗ[K] W, ∀ x, L (S x) = T (L x) := by
  let E := AdjoinRoot f
  let φ := rootAction f S hS
  let ψ := rootAction f T hT
  letI : Module E V := Module.compHom V φ.toRingHom
  letI : Module E W := Module.compHom W ψ.toRingHom
  haveI : IsScalarTower K E V := ⟨fun a b x => by
    change φ (a • b) x = a • φ b x
    rw [map_smul]
    rfl⟩
  haveI : IsScalarTower K E W := ⟨fun a b x => by
    change ψ (a • b) x = a • ψ b x
    rw [map_smul]
    rfl⟩
  haveI : Module.Finite E V := Module.Finite.of_restrictScalars_finite K E V
  haveI : Module.Finite E W := Module.Finite.of_restrictScalars_finite K E W
  have hE : finrank K E = f.natDegree := (AdjoinRoot.powerBasis' hf).finrank
  have hmul := (Module.finrank_mul_finrank K E V).trans
    (hd.trans (Module.finrank_mul_finrank K E W).symm)
  have hpos : 0 < finrank K E := hE ▸ (Fact.out : Irreducible f).natDegree_pos
  have he : finrank E V = finrank E W := Nat.eq_of_mul_eq_mul_left hpos hmul
  let L := LinearEquiv.ofFinrankEq V W he
  refine ⟨L.restrictScalars K, ?_⟩
  intro x
  have h := L.map_smul (AdjoinRoot.root f) x
  change L (φ (AdjoinRoot.root f) x) = ψ (AdjoinRoot.root f) (L x) at h
  simpa [φ, ψ] using h


section Matrix

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

private theorem matrix_root {f : K[X]} (S : Matrix ι ι K) (hS : aeval S f = 0) :
    aeval (Matrix.toLinAlgEquiv' S) f = 0 := by
  rw [aeval_algHom_apply, hS, map_zero]

noncomputable def matrixRootAction (f : K[X]) (S : Matrix ι ι K) (hS : aeval S f = 0) :
    AdjoinRoot f →ₐ[K] Matrix ι ι K :=
  LinearMap.toMatrixAlgEquiv'.toAlgHom.comp
    (rootAction f (Matrix.toLinAlgEquiv' S) (matrix_root S hS))

@[simp] theorem matrixRootAction_root (f : K[X]) (S : Matrix ι ι K) (hS : aeval S f = 0) :
    matrixRootAction f S hS (AdjoinRoot.root f) = S := by
  simp [matrixRootAction, AlgHom.comp_apply]

theorem matrixRootAction_mem (f : K[X]) (S : Matrix ι ι K) (hS : aeval S f = 0)
    (a : AdjoinRoot f) : matrixRootAction f S hS a ∈ adjoin K {S} := by
  have h :
      matrixRootAction f S hS a ∈
        (adjoin K {Matrix.toLinAlgEquiv' S}).map LinearMap.toMatrixAlgEquiv'.toAlgHom :=
    ⟨_, rootAction_mem f (Matrix.toLinAlgEquiv' S) (matrix_root S hS) a, rfl⟩
  rw [AlgHom.map_adjoin_singleton] at h
  simpa using h

end Matrix
end Mathproof.Problem17ComparatorPrimaryAlign

#print axioms Mathproof.Problem17ComparatorPrimaryAlign.filtered_primary_iff
#print axioms Mathproof.Problem17ComparatorPrimaryAlign.align_primary_roots
#print axioms Mathproof.Problem17ComparatorPrimaryAlign.matrixRootAction_mem
