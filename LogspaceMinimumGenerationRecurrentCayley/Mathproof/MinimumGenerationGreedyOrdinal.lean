import Mathproof.MinimumGenerationGreedyGenerator
import Mathlib.GroupTheory.Coset.Card
import Mathlib.Algebra.Group.Subgroup.Finite
import Mathlib.Data.Set.Card

namespace Mathproof.MinimumGeneration.GreedyOrdinal

open Subgroup

variable {n : Nat}

/-- Specification list of the accepted labels. The executable ordinal scan below
uses the same traversal without constructing this list. -/
def collect (accept : Fin n → Bool) (start : Nat) : Nat → List (Fin n)
  | 0 => []
  | fuel + 1 =>
    if h : start < n then
      if accept ⟨start, h⟩ then ⟨start, h⟩ :: collect accept (start+1) fuel
      else collect accept (start+1) fuel
    else []

/-- Find one requested generator ordinal using a label cursor and a remaining
ordinal, consuming only one membership verdict at a time. -/
def ordinal (accept : Fin n → Bool) (start : Nat) : Nat → Nat → Option (Fin n)
  | 0, _ => none
  | fuel + 1, index =>
    if h : start < n then
      if accept ⟨start, h⟩ then
        match index with
        | 0 => some ⟨start, h⟩
        | index + 1 => ordinal accept (start+1) fuel index
      else ordinal accept (start+1) fuel index
    else none

theorem ordinal_exact (accept : Fin n → Bool) (start fuel index : Nat) :
    ordinal accept start fuel index = (collect accept start fuel)[index]? := by
  induction fuel generalizing start index with
  | zero => simp [ordinal, collect]
  | succ fuel ih =>
    by_cases h : start < n
    · by_cases a : accept ⟨start, h⟩ = true
      · cases index <;> simp [ordinal, collect, h, a, ih]
      · simp [ordinal, collect, h, a, ih]
    · simp [ordinal, collect, h]

theorem collect_mem (accept : Fin n → Bool) (start fuel : Nat) (x : Fin n) :
    x ∈ collect accept start fuel ↔ start ≤ x.val ∧ x.val < start + fuel ∧ accept x = true := by
  induction fuel generalizing start with
  | zero => simp [collect]; omega
  | succ fuel ih =>
    by_cases h : start < n
    · let a : Fin n := ⟨start, h⟩
      by_cases ha : accept a = true
      · simp only [collect, dif_pos h]
        change x ∈ (if accept a then a :: collect accept (start+1) fuel
          else collect accept (start+1) fuel) ↔ _
        rw [if_pos ha, List.mem_cons, ih]
        constructor
        · rintro (rfl | ⟨ha₁, ha₂, hb⟩)
          · exact ⟨le_rfl, by simp [a], ha⟩
          · exact ⟨by omega, by omega, hb⟩
        · rintro ⟨h₁,h₂,h₃⟩
          by_cases hx : x.val = start
          · exact Or.inl (Fin.ext hx)
          · exact Or.inr ⟨by omega, by omega, h₃⟩
      · simp only [collect, dif_pos h]
        change x ∈ (if accept a then a :: collect accept (start+1) fuel
          else collect accept (start+1) fuel) ↔ _
        rw [if_neg ha, ih]
        constructor
        · rintro ⟨h₁,h₂,h₃⟩
          exact ⟨by omega, by omega, h₃⟩
        · rintro ⟨h₁,h₂,h₃⟩
          have hx : x.val ≠ start := by
            intro hv
            exact ha ((show x = a from Fin.ext hv) ▸ h₃)
          exact ⟨by omega, by omega, h₃⟩
    · simp only [collect, dif_neg h, List.not_mem_nil, false_iff]
      intro hx
      have := x.isLt
      omega

private theorem double_card {G : Type*} [Group G] [Finite G] {H K : Subgroup G}
    (h : H < K) : 2 * Nat.card H ≤ Nat.card K := by
  have hSet : (H : Set G) ⊂ (K : Set G) := Set.ssubset_iff_subset_ne.mpr
    ⟨h.le, fun hEq => h.ne (SetLike.coe_injective hEq)⟩
  have hlt : Nat.card H < Nat.card K := Set.ncard_lt_ncard hSet
  obtain ⟨r, hr⟩ := card_dvd_of_le h.le
  have hr₂ : 2 ≤ r := by
    by_contra! hh
    have ho : r = 0 ∨ r = 1 := by omega
    rcases ho with rfl | rfl <;> simp_all
  calc
    2 * Nat.card H ≤ r * Nat.card H := Nat.mul_le_mul_right _ hr₂
    _ = Nat.card K := by simpa [Nat.mul_comm] using hr.symm

private def subgroupBefore [Group (Fin n)] (eligible : Fin n → Bool) (cut : Nat) :
    Subgroup (Fin n) :=
  closure {x | eligible x = true ∧ x.val < cut}

private theorem prefix_mono [Group (Fin n)] (eligible : Fin n → Bool) :
    Monotone (subgroupBefore eligible) := by
  intro a b h
  apply closure_mono
  intro x hx
  exact ⟨hx.1, hx.2.trans_le h⟩

/-- Each accepted label doubles the order of the subgroup generated by the preceding labels. -/
theorem collect_card [Group (Fin n)] {query : (Fin n → Bool) → Fin n → Bool}
    (correct : ChiefExecution.CorrectMembership query) (eligible : Fin n → Bool)
    (start fuel : Nat) :
    2 ^ (collect (GreedyGenerator.accept query eligible) start fuel).length *
      Nat.card (subgroupBefore eligible start) ≤ Nat.card (subgroupBefore eligible (start+fuel)) := by
  induction fuel generalizing start with
  | zero => simp [collect]
  | succ fuel ih =>
    let test := GreedyGenerator.accept query eligible
    have hinc : subgroupBefore eligible start ≤ subgroupBefore eligible (start+1) := prefix_mono eligible (by omega)
    have after := ih (start+1)
    have e : start + 1 + fuel = start + (fuel + 1) := by omega
    rw [e] at after
    by_cases h : start < n
    · let a : Fin n := ⟨start,h⟩
      by_cases ha : test a = true
      · have valid := (GreedyGenerator.accept_spec correct eligible a).mp ha
        have ax : a ∈ subgroupBefore eligible (start+1) := subset_closure ⟨valid.1, by simp [a]⟩
        have lack : a ∉ subgroupBefore eligible start := valid.2
        have strict : subgroupBefore eligible start < subgroupBefore eligible (start+1) :=
          lt_of_le_of_ne hinc (fun hEq => lack (hEq.symm ▸ ax))
        change 2 ^ (collect test start (fuel+1)).length * _ ≤ _
        simp only [collect,dif_pos h]
        change 2 ^ (if test a then a :: collect test (start+1) fuel else
          collect test (start+1) fuel).length * Nat.card (subgroupBefore eligible start) ≤ _
        rw [if_pos ha, List.length_cons, Nat.pow_succ, Nat.mul_assoc]
        exact (Nat.mul_le_mul_left _ (double_card strict)).trans after
      · change 2 ^ (collect test start (fuel+1)).length * _ ≤ _
        simp only [collect,dif_pos h]
        change 2 ^ (if test a then a :: collect test (start+1) fuel else
          collect test (start+1) fuel).length * Nat.card (subgroupBefore eligible start) ≤ _
        rw [if_neg ha]
        exact (Nat.mul_le_mul_left _ (card_le_of_le hinc)).trans after
    · simp only [collect, dif_neg h, List.length_nil, Nat.pow_zero, Nat.one_mul]
      exact card_le_of_le (prefix_mono eligible (by omega))

theorem collect_log_length [G : Group (Fin n)] {query : (Fin n → Bool) → Fin n → Bool}
    (correct : ChiefExecution.CorrectMembership query) (eligible : Fin n → Bool) :
    (collect (GreedyGenerator.accept query eligible) 0 n).length ≤ Nat.log2 n := by
  have h₀ : 1 ≤ Nat.card (subgroupBefore eligible 0) := Nat.card_pos
  have hGrp : n ≠ 0 := by have := G.toOne.one.isLt; omega
  apply (Nat.le_log2 hGrp).2
  calc
    2 ^ (collect (GreedyGenerator.accept query eligible) 0 n).length
      ≤ 2 ^ (collect (GreedyGenerator.accept query eligible) 0 n).length *
        Nat.card (subgroupBefore eligible 0) := Nat.le_mul_of_pos_right _ h₀
    _ ≤ Nat.card (subgroupBefore eligible (0+n)) := collect_card correct eligible 0 n
    _ ≤ n := by simpa using (subgroupBefore eligible (0+n)).card_le_card_group

theorem collect_closure [Group (Fin n)] {query : (Fin n → Bool) → Fin n → Bool}
    (correct : ChiefExecution.CorrectMembership query) (eligible : Fin n → Bool) :
    closure {x | x ∈ collect (GreedyGenerator.accept query eligible) 0 n} =
      closure {x | eligible x = true} := by
  have hm : {x | x ∈ collect (GreedyGenerator.accept query eligible) 0 n} =
      {x | GreedyGenerator.accept query eligible x = true ∧ x.val < n} := by
    ext x
    simp only [Set.mem_ofPred_eq, collect_mem, Nat.zero_le, Nat.zero_add, true_and]
    exact and_comm
  rw [hm, GreedyGenerator.closure_accept_prefix correct eligible n]
  congr 1
  ext x
  simp

end Mathproof.MinimumGeneration.GreedyOrdinal
