import Mathproof.MinimumGenerationChiefExecution
import Mathproof.MinimumGenerationTableIO

namespace Mathproof.MinimumGeneration.GreedyGenerator

open Subgroup

variable {n : Nat}

/-- The unfiltered allowed labels strictly earlier than a cursor. Their closure
equals the closure of the greedy predecessors, so no earlier greedy list is
stored or recursively queried. -/
def before (allow : Fin n → Bool) (i : Nat) (x : Fin n) : Bool :=
  allow x && decide (x.val < i)

def accept (query : (Fin n → Bool) → Fin n → Bool) (allow : Fin n → Bool)
    (x : Fin n) : Bool :=
  allow x && !(query (before allow x.val) x)

theorem accept_spec [Group (Fin n)] {query : (Fin n → Bool) → Fin n → Bool}
    (h : ChiefExecution.CorrectMembership query) (allow : Fin n → Bool) (x : Fin n) :
    accept query allow x = true ↔
      allow x = true ∧ x ∉ closure {y | allow y = true ∧ y.val < x.val} := by
  have hset : {y | before allow x.val y = true} =
      {y | allow y = true ∧ y.val < x.val} := by
    ext y
    simp [before]
  simp only [accept, Bool.and_eq_true, Bool.not_eq_true']
  rw [← Bool.not_eq_true, h, hset]

/-- Greedy selection preserves the subgroup generated by every prefix of the
allowed labels. Every membership test uses the unfiltered earlier prefix. -/
theorem closure_accept_prefix [Group (Fin n)] {query : (Fin n → Bool) → Fin n → Bool}
    (h : ChiefExecution.CorrectMembership query) (allow : Fin n → Bool) (cut : Nat) :
    closure {x | accept query allow x = true ∧ x.val < cut} =
      closure {x | allow x = true ∧ x.val < cut} := by
  let S : Subgroup (Fin n) := closure {x | accept query allow x = true ∧ x.val < cut}
  refine le_antisymm (closure_mono ?_) ((Subgroup.closure_le S).2 ?_)
  · intro x hx
    exact ⟨((accept_spec h allow x).mp hx.1).1, hx.2⟩
  · have all (k : Nat) : ∀ x : Fin n, x.val = k → allow x = true → x.val < cut → x ∈ S := by
      induction k using Nat.strongRecOn with
      | ind k ih =>
        intro x hx ha hc
        by_cases hm : x ∈ closure {y : Fin n | allow y = true ∧ y.val < x.val}
        · have hs : closure {y : Fin n | allow y = true ∧ y.val < x.val} ≤ S := by
            apply (Subgroup.closure_le S).2
            intro y hy
            exact ih y.val (by simpa [hx] using hy.2) y rfl hy.1 (hy.2.trans hc)
          exact hs hm
        · exact subset_closure ⟨(accept_spec h allow x).mpr ⟨ha, hm⟩, hc⟩
    intro x hx
    exact all x.val x rfl hx.1 hx.2

/-- The entire search keeps just the current raw label between membership
calls. The returned label is the next positive generator in increasing order. -/
def next (query : (Fin n → Bool) → Fin n → Bool) (allow : Fin n → Bool)
    (start : Nat) : Option (Fin n) :=
  ChiefExecution.firstHitFrom (accept query allow) start (n - start)

theorem next_spec [Group (Fin n)] {query : (Fin n → Bool) → Fin n → Bool}
    (h : ChiefExecution.CorrectMembership query) (allow : Fin n → Bool)
    (start : Nat) (x : Fin n) :
    next query allow start = some x ↔
      start ≤ x.val ∧
      (allow x = true ∧ x ∉ closure {y | allow y = true ∧ y.val < x.val}) ∧
      ∀ y : Fin n, start ≤ y.val → y.val < x.val →
        (allow y = true → y ∈ closure {z | allow z = true ∧ z.val < y.val}) := by
  rw [next, ChiefExecution.firstHitFrom_eq_some_iff]
  rw [accept_spec h allow x]
  constructor
  · rintro ⟨hx, _, acceptX, least⟩
    refine ⟨hx, acceptX, fun y hy hxy ha => ?_⟩
    by_contra hm
    have htrue := (accept_spec h allow y).mpr ⟨ha, hm⟩
    rw [least y hy hxy] at htrue
    contradiction
  · rintro ⟨hx, acceptX, least⟩
    refine ⟨hx, by have := x.isLt; omega, acceptX, fun y hy hxy => ?_⟩
    apply Bool.eq_false_of_not_eq_true
    intro he
    obtain ⟨ha, hm⟩ := (accept_spec h allow y).mp he
    exact hm (least y hy hxy ha)

theorem next_cursor_width {query : (Fin n → Bool) → Fin n → Bool} {allow : Fin n → Bool}
    {start : Nat} {x : Fin n} (hx : next query allow start = some x) :
    start ≤ x.val ∧ x.val + 1 < 2 ^ TableIO.width n := by
  have h := (ChiefExecution.firstHitFrom_eq_some_iff (accept query allow) start (n - start) x).mp hx
  exact ⟨h.1, (Nat.succ_le_of_lt x.isLt).trans_lt Nat.lt_log2_self⟩

end Mathproof.MinimumGeneration.GreedyGenerator
