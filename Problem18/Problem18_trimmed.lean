variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
def budget (N : Nat) := constCostE (.var output) (.lit 0) F.e+2+loopCost F N
theorem entry_derivative {N ps : Nat} {σ : Env} (P : K[X]) (hP : P.degree<N)
    (hp : ∀i<N,val F canonical WS σ (ps+i)=P.coeff (N-1-i)) (i : Nat) (hi : i<N) :
    entry F σ N ps i=P.derivative.coeff (N-1-i) := by
  by_cases hi0 : i=0
  · subst i
    simp only [entry,if_true,Nat.sub_zero]
    rw [coeff_derivative,show N-1+1=N by omega,coeff_eq_zero_of_degree_lt hP,zero_mul]
  · rw [entry,if_neg hi0,hp (i-1) (by omega),coeff_derivative]
    rw [show N-1-(i-1)=N-i by omega,show N-1-i+1=N-i by omega]
    rw [show ((N-1-i:Nat):K)+1=((N-i:Nat):K) by
      have hc := congrArg (fun t : Nat => (t : K)) (show N-1-i+1=N-i by omega)
      simpa only [Nat.cast_add,Nat.cast_one] using hc]
    exact mul_comm _ _
theorem derivative_run {B Sn N ps ds : Nat} {σ : Env}
    (hS : Slots F canonical WS Sn B σ) (hN : σ.vars sizeReg=N) (hN1 : 1 ≤ N)
    (hp : σ.vars tw.pS=ps) (hd : σ.vars output=ds)
    (hp5 : 5 ≤ ps) (hd5 : 5 ≤ ds) (hpf : ps+N ≤ Sn) (hdf : ds+N ≤ Sn)
    (hsep : ps+N ≤ ds ∨ ds+N ≤ ps)
    (P : K[X]) (hP : P.degree<N)
    (hcoef : ∀i<N,val F canonical WS σ (ps+i)=P.coeff (N-1-i)) :
    ∃τ,Run B Problem18IMPPolynomialDerivativeController20261002.program σ τ (budget F N) ∧ Slots F canonical WS Sn B τ ∧
      (∀i<N,val F canonical WS τ (ds+i)=P.derivative.coeff (N-1-i)) ∧
      (∀s<Sn,s≠2 → (s<ds ∨ ds+N ≤ s) → val F canonical WS τ s=val F canonical WS σ s) ∧
      (∀x,x∉regNames canonical → x≠ci → x≠q.j → τ.vars x=σ.vars x) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hSB:=hS.slots_word
  obtain ⟨ξ,hz,hs,hzero,hmem,hvars,_,hin,hout⟩:=
    constE_run (F:=F) (r:=canonical) q ci (by decide) (by decide)
      [output] (by decide) (.var output) (by simp [VarsIn]) hS
      (by simpa only [hd] using evalB_var (σ:=σ) (B:=B) (x:=output) (by rw [hd];omega))
      (by omega) (.lit 0) [] (by simp) trivial (evalB_lit (by omega : 0<B)) F.prime.pos
  let ξ':=ξ.setVar q.j 1
  have hs' : Slots F canonical WS Sn B ξ' := Slots.setVar F canonical hs (by decide) (by decide) 1
  have hn' : ξ'.vars sizeReg=N := by
    change ξ.vars sizeReg=N;rw [hvars _ (by decide)];exact hN
  have hp' : ξ'.vars tw.pS=ps := by
    change ξ.vars tw.pS=ps;rw [hvars _ (by decide)];exact hp
  have hd' : ξ'.vars output=ds := by
    change ξ.vars output=ds;rw [hvars _ (by decide)];exact hd
  have hz' : val F canonical WS ξ' ds=0 := by
    change val F canonical q.WS ξ ds=0
    simpa only [Nat.cast_zero] using hzero
  have hsrc : ∀i<N,val F canonical WS ξ' (ps+i)=val F canonical WS σ (ps+i) := by
    intro i hi
    change val F canonical q.WS ξ (ps+i)=val F canonical q.WS σ (ps+i)
    apply hmem _ (by omega)
    rcases hsep with h|h <;> omega
  obtain ⟨τ,hl,ht,hcoeff,hframe,hreg,hli,hlo⟩:=loop_run F hs' hn'
    (by simp [ξ']) hN1 hp' hd' hp5 hd5 hpf hdf hsep hz'
  have ha : Run B (.assign q.j (.lit 1)) ξ ξ' 2 :=
    Run.assign (evalB_lit (by omega : 1<B))
  have hall:=hz.seq (ha.seq hl)
  refine ⟨τ,?_,ht,?_,?_,?_,?_,?_⟩
  · simpa only [Problem18IMPPolynomialDerivativeController20261002.program,budget,Nat.add_assoc] using hall
  · intro i hi
    rw [hcoeff i hi]
    apply entry_derivative F P hP
    · intro j hj;exact (hsrc j hj).trans (hcoef j hj)
    · exact hi
  · intro s hsx hs2 hso
    rw [hframe s hsx hs2 hso]
    change val F canonical q.WS ξ s=val F canonical q.WS σ s
    apply hmem s hsx
    rcases hso with h|h <;> omega
  · intro x hx hci hqj
    rw [hreg x hx hci hqj]
    change (ξ.setVar q.j 1).vars x=σ.vars x
    rw [vars_setVar,if_neg hqj,hvars x hci]
  · exact hli.trans hin
  · exact hlo.trans hout
end Mathproof.Problem18IMPPolynomialDerivativeComplete20261002
