namespace Mathproof.Problem18UniformIdealCertificate20260930
open MvPolynomial MonomialOrder
open Mathproof.LibraryBridges.Claude.GroebnerNormalForms_20260908
open Mathproof.Problem18BoundedCompletionDegree20260930
open Mathproof.Problem18BoundedMacaulay20260930
open Mathproof.Problem18BoundedMacaulayCompletion20260930
open Mathproof.Meta.Problem18BoundedControlledDickson20260930
open Mathproof.Meta.Problem18BoundedControlledDicksonEnumeration20260930
variable {N : Nat} {K : Type*} [Field K]
theorem macaulay_completion_alternative
    (F : Finset (MvPolynomial (Fin N) K)) (d : Nat)
    (hF : ∀ f ∈ F, f.totalDegree ≤ d) (n : Nat) :
    (∃ G : Finset (MvPolynomial (Fin N) K),
      IsBasisFor degLex (generatedIdeal (F : Set (MvPolynomial (Fin N) K))) (G : Set (MvPolynomial (Fin N) K)) ∧
      (∀ g ∈ G, g.totalDegree ≤ d*2^n) ∧
      ∀ g ∈ G, g ∈ macaulaySpan (F : Set (MvPolynomial (Fin N) K)) (2*d*2^n)) ∨
    (∃ G : Finset (MvPolynomial (Fin N) K), ∃ l : List (FinExponent N),
      l.length = n ∧ Relation.ReflTransGen (ControlledExtension d) l [] ∧
      generatedIdeal (G : Set (MvPolynomial (Fin N) K)) = generatedIdeal (F : Set (MvPolynomial (Fin N) K)) ∧
      (∀ g ∈ G, g.totalDegree ≤ d*2^n) ∧
      (∀ g ∈ G, g ∈ macaulaySpan (F : Set (MvPolynomial (Fin N) K)) (2*d*2^n)) ∧
      ∀ a ∈ l, ∃ g ∈ G, g ≠ 0 ∧ degLex.degree g = a) := by
  classical
  induction n with
  | zero =>
      right
      refine ⟨F,[],rfl,Relation.ReflTransGen.refl,rfl,?_,?_,by simp⟩
      · simpa using hF
      · intro g hg
        exact generator_mem_macaulaySpan _ _ hg
  | succ n ih =>
      have hmono : d*2^n ≤ d*2^(n+1) := by
        exact Nat.mul_le_mul_left d (Nat.pow_le_pow_right (by omega) (by omega))
      have hEmono : 2*d*2^n ≤ 2*d*2^(n+1) := by
        exact Nat.mul_le_mul_left (2*d) (Nat.pow_le_pow_right (by omega) (by omega))
      rcases ih with ⟨G,hGB,hdeg,hmac⟩ | ⟨G,l,hlen,hreach,hspan,hdeg,hmac,hcover⟩
      · exact Or.inl ⟨G,hGB,(fun g hg => (hdeg g hg).trans hmono),
          fun g hg => macaulaySpan_mono hEmono (hmac g hg)⟩
      · by_cases hGB : IsGroebner degLex (G : Set (MvPolynomial (Fin N) K))
        · exact Or.inl ⟨G,⟨hGB,hspan⟩,(fun g hg => (hdeg g hg).trans hmono),
            fun g hg => macaulaySpan_mono hEmono (hmac g hg)⟩
        · right
          obtain ⟨r,hr0,hrI,hred,hrdeg,hrmac⟩ :=
            non_groebner_macaulay_obstruction (F : Set (MvPolynomial (Fin N) K))
              (G : Set (MvPolynomial (Fin N) K)) (2*d*2^n) (d*2^n) hmac hdeg hGB
          have hrbound : r.totalDegree ≤ d*2^(n+1) := by
            calc r.totalDegree ≤ 2*(d*2^n) := hrdeg
                 _ = d*2^(n+1) := by rw [pow_succ]; ring
          have hfresh : ∀ a ∈ l, ¬ ExponentDivides a (degLex.degree r) := by
            intro a ha
            obtain ⟨g,hg,hg0,hga⟩ := hcover a ha
            rw [← hga]
            exact hred (degLex.degree r) (degLex.degree_mem_support hr0) g hg hg0
          have hcoord : ∀ i, degLex.degree r i ≤ d*2^(l.length+1) := by
            intro i
            rw [hlen]
            exact (Finsupp.le_degree i (degLex.degree r)).trans
              (by simpa only [degree_degLexDegree] using hrbound)
          have hnewspan : generatedIdeal (insert r (G : Set (MvPolynomial (Fin N) K))) = generatedIdeal (G : Set (MvPolynomial (Fin N) K)) := by
            apply le_antisymm
            · apply Ideal.span_le.mpr
              intro f hf
              rcases Set.mem_insert_iff.mp hf with rfl | hf
              · exact hrI
              · exact Ideal.subset_span hf
            · exact Ideal.span_mono (Set.subset_insert _ _)
          refine ⟨insert r G,degLex.degree r :: l,by simp [hlen],
            Relation.ReflTransGen.head ⟨degLex.degree r,rfl,hfresh,hcoord⟩ hreach,
            ?_,?_,?_,?_⟩
          · simpa only [Finset.coe_insert] using hnewspan.trans hspan
          · intro g hg
            rcases Finset.mem_insert.mp hg with rfl | hg
            · exact hrbound
            · exact (hdeg g hg).trans hmono
          · intro g hg
            rcases Finset.mem_insert.mp hg with rfl | hg
            · convert hrmac using 1 <;> congr 1 <;> rw [pow_succ] <;> ring
            · exact macaulaySpan_mono hEmono (hmac g hg)
          · intro a ha
            rcases List.mem_cons.mp ha with rfl | ha
            · exact ⟨r,Finset.mem_insert_self _ _,hr0,rfl⟩
            · obtain ⟨g,hg,hg0,hga⟩ := hcover a ha
              exact ⟨g,Finset.mem_insert_of_mem hg,hg0,hga⟩
theorem exists_uniform_macaulay_groebner
    (F : Finset (MvPolynomial (Fin N) K)) (d : Nat)
    (hF : ∀ f ∈ F, f.totalDegree ≤ d) :
    ∃ G : Finset (MvPolynomial (Fin N) K),
      IsBasisFor degLex (generatedIdeal (F : Set (MvPolynomial (Fin N) K))) (G : Set (MvPolynomial (Fin N) K)) ∧
      (∀ g ∈ G, g.totalDegree ≤ d*2^(controlledDepth N d)) ∧
      ∀ g ∈ G, g ∈ macaulaySpan (F : Set (MvPolynomial (Fin N) K))
        (2*d*2^(controlledDepth N d)) := by
  rcases macaulay_completion_alternative F d hF (controlledDepth N d) with h | h
  · exact h
  · obtain ⟨G,l,hlen,hreach,_⟩ := h
    have hlt := controlled_history_length_lt_depth hreach
    omega
theorem one_mem_ideal_iff_uniform_macaulay
    (F : Finset (MvPolynomial (Fin N) K)) (d : Nat)
    (hF : ∀ f ∈ F, f.totalDegree ≤ d) :
    (1 : MvPolynomial (Fin N) K) ∈ generatedIdeal (F : Set (MvPolynomial (Fin N) K)) ↔
      (1 : MvPolynomial (Fin N) K) ∈ macaulaySpan (F : Set (MvPolynomial (Fin N) K))
        (2*d*2^(controlledDepth N d)) := by
  classical
  constructor
  · intro h1
    obtain ⟨G,hG,hdeg,hmac⟩ := exists_uniform_macaulay_groebner F d hF
    obtain ⟨g,hg,hg0,hdiv⟩ := hG.1 1 (hG.2.symm ▸ h1) one_ne_zero
    have hgdegree : degLex.degree g = 0 := by
      apply le_antisymm
      · intro i
        simpa only [degLex.degree_one] using hdiv i
      · exact bot_le
    have hgeq := degLex.eq_C_of_degree_eq_zero hgdegree
    have hlc : degLex.leadingCoeff g ≠ 0 := degLex.leadingCoeff_ne_zero_iff.mpr hg0
    have hmul := (macaulaySpan (F : Set (MvPolynomial (Fin N) K))
      (2*d*2^(controlledDepth N d))).smul_mem (degLex.leadingCoeff g)⁻¹ (hmac g hg)
    rw [hgeq, degLex.leadingCoeff_C, smul_eq_C_mul, ← map_mul, inv_mul_cancel₀ hlc, map_one] at hmul
    exact hmul
  · intro h
    exact macaulaySpan_le_ideal _ _ h
end Mathproof.Problem18UniformIdealCertificate20260930
end
end
