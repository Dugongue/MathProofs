    rw [hreg3 q.N rNS (ha.ne_of (by intro h; simp [RNames.list, ANames.list, h]))
      (ha.ne_of (by intro h; simp [RNames.list, ANames.list, h]))
      (ha.ne_of (by intro h; simp [RNames.list, ANames.list, h]))
      (ha.ne_of (by intro h; simp [RNames.list, ANames.list, h]))]
    simp [hσ2]
  have hlx : ∀ y ∈ [an.xB], y ∉ regNames r ∧ y ≠ q.j := by
