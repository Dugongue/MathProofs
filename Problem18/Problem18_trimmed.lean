theorem geometricIdeal_section_eq (Ω : Type) [Field Ω] [Algebra K Ω]
    (fs : List (MvPolynomial (Fin n) K)) (i j : Fin n) (u u₀ : Ω) :
    geometricIdeal (K := Ω) (L := Ω) (systemSet (sectionSystem
        (fs.map (MvPolynomial.map (algebraMap K Ω))) i j u u₀))
      = Ideal.span (MvPolynomial.map (algebraMap K Ω) '' systemSet fs) ⊔
        Ideal.span {X i + MvPolynomial.C u * X j - MvPolynomial.C u₀} := by
  rw [geometricIdeal_self, ← Ideal.span_union]
  congr 1
  ext g
  simp only [systemSet, Set.mem_setOf_eq, Set.mem_union, Set.mem_image, Set.mem_singleton_iff,
    List.mem_append, List.mem_map, List.mem_singleton]
theorem adjoin_range_mk_X_eq_top {E : Type} [Field E] (I : Ideal (MvPolynomial (Fin n) E)) :
    Algebra.adjoin E (Set.range fun m : Fin n => Ideal.Quotient.mk I (X m)) = ⊤ := by
  rw [eq_top_iff]
  rintro a -
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  induction p using MvPolynomial.induction_on with
  | C c =>
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap]
    exact Subalgebra.algebraMap_mem _ c
  | add p q hp hq =>
    rw [map_add]; exact Subalgebra.add_mem _ hp hq
  | mul_X p m hp =>
    rw [map_mul]; exact Subalgebra.mul_mem _ hp (Algebra.subset_adjoin ⟨m, rfl⟩)
theorem bounded_of_represents {d : Nat} (rows : List (DenseInput n d K))
    (fs : List (MvPolynomial (Fin n) K)) (h : Represents rows fs) : Bounded d fs := by
  intro f hf
  induction h with
  | nil => simp at hf
  | cons hvf _ ih =>
    rcases List.mem_cons.mp hf with rfl | hf'
    · exact hvf.1
    · exact ih hf'
end Bookkeeping
variable (L : Type) [Field L] [Algebra K L] [IsAlgClosed L] [Algebra.IsAlgebraic K L]
def BertiniOutput (Ω : Type) [Field Ω] [Algebra K Ω] [Algebra L Ω] (n : Nat) (u u₀ : Ω) : Prop :=
  ∀ (fs : List (MvPolynomial (Fin n) K)) (P : Ideal (MvPolynomial (Fin n) L)),
    (geometricIdeal (L := L) (systemSet fs)).minimalPrimes = {P} →
    ∀ i j : Fin n,
      AlgebraicIndependent L ![Ideal.Quotient.mk P (X i), Ideal.Quotient.mk P (X j)] →
      (Ideal.map (MvPolynomial.map (algebraMap L Ω)) P).IsPrime ∧
      ∃ Q : Ideal (MvPolynomial (Fin n) Ω),
        (Ideal.span (MvPolynomial.map (algebraMap K Ω) '' systemSet fs) ⊔
          Ideal.span {X i + MvPolynomial.C u * X j - MvPolynomial.C u₀}).minimalPrimes = {Q} ∧
        Ideal.map (MvPolynomial.map (algebraMap L Ω)) P < Q
def CurvePoint (n dd Qc : Nat) : Prop :=
  ∀ fs : List (MvPolynomial (Fin n) K), Bounded dd fs → IrredDimT L fs 1 →
    Qc < Fintype.card K → ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0
theorem hgen_of_bertiniOutput {n : Nat} (Ω : Type) [Field Ω] [Algebra K Ω] [Algebra L Ω]
    [IsScalarTower K L Ω] [IsAlgClosed Ω] (u u₀ : Ω) (hB : BertiniOutput (K := K) L Ω n u u₀) (d : Nat) :
    ∀ (fs : List (MvPolynomial (Fin n) K)) (t : Nat), Bounded d fs → 2 ≤ t →
      IrredDimT L fs t → ∃ i j : Fin n,
        UniqueComp Ω (fs.map (MvPolynomial.map (algebraMap K Ω))) ∧
        SectionCond Ω (fs.map (MvPolynomial.map (algebraMap K Ω))) i j u u₀ := by
  intro fs t _ ht hirr
  obtain ⟨P, hP, htr⟩ := hirr
  have hPmem : P ∈ (geometricIdeal (L := L) (systemSet fs)).minimalPrimes := by
    rw [hP]; exact Set.mem_singleton P
  haveI : P.IsPrime := hPmem.isPrime
  have h2 : (2 : Cardinal) ≤ Algebra.trdeg L (MvPolynomial (Fin n) L ⧸ P) := by
    rw [htr]; exact_mod_cast ht
  obtain ⟨i, j, -, hind⟩ := exists_independent_pair (k := L)
    (fun m : Fin n => Ideal.Quotient.mk P (X m)) (adjoin_range_mk_X_eq_top P) h2
  obtain ⟨hBC, Q, hQ, hlt⟩ := hB fs P hP i j hind
  refine ⟨i, j, ?_⟩
  rw [← geometricIdeal_section_eq] at hQ
  exact bertini_output L Ω fs P hP i j u u₀ hBC Q hQ hlt
noncomputable def bridgeT {n d c₀ : Nat} (T : SectionTemplateT (K := K) n (descentDegree n d) c₀)
    (Ω : Type) [Field Ω] [Algebra K Ω] [Algebra L Ω] [IsScalarTower K L Ω] [IsAlgClosed Ω]
    (u u₀ : Ω) (hu : Transcendental K u)
    (hu₀ : Transcendental (Polynomial.aeval u : Polynomial K →ₐ[K] Ω).range u₀)
    (hB : BertiniOutput (K := K) L Ω n u u₀) (Qc : Nat) (hC : CurvePoint (K := K) L n (descentDegree n d) Qc)
    (hd : 1 ≤ descentDegree n d) : PointBridgeT (K := K) L n d where
  Qcurve := Qc
  Qpencil := 2 * (T.clauseBound * T.degreeBound)
  dDesc := descentDegree n d
  one_le_dDesc := hd
  curve_point := fun fs hb hirr hq => hC fs hb hirr hq
  section_step := fun fs t hb ht hirr hq =>
    section_stepT_of_template L T Ω u u₀ hu hu₀ (hgen_of_bertiniOutput L Ω u u₀ hB _) hq fs t hb ht hirr
  descent := fun fs hb hfix => descent_bridge L fs hb hfix
theorem pointExistence_of_bridges {n : Nat} (B : (d : Nat) → PointBridgeT (K := K) L n d) :
    PointExistence (K := K) L n (fun d => max (B d).Qcurve (B d).Qpencil) := by
  intro d rows fs hrep hq hfix
  exact pointExistence_of_bridgeT L (B d) fs (bounded_of_represents rows fs hrep) hq hfix
structure BridgeParts (n : Nat) where
  Ω : Type
  [fieldΩ : Field Ω]
  [algKΩ : Algebra K Ω]
