theorem prodCall_run {B n d e sb : Nat} (a b o w r k c : Sz) {A Bv O W m q p : Nat} (σ : Env)
    (hv : ValidMemory F B σ)
    (hn : σ.vars nR = n) (hd : σ.vars dR = d) (he : σ.vars eR = e) (hsb : σ.vars sbR = sb)
