  have hfc := hIc τf hIf
  obtain ⟨hSf, hjf, hfixf, hrowsf, hkeepf, harrf, hinpf, houtf⟩ := hIf
  have htf : τf.vars t = c := by
    simp only [Option.some.injEq, decide_eq_false_iff_not, not_lt] at hcf'
