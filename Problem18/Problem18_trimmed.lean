theorem slots_set {WS : String} {S B : Nat} {σ : Env} (h : Slots F canonical WS S B σ)
    (x : String) (v : Nat) (he : canonical.e≠x) (hp : canonical.p≠x)
    (hm : canonical.modBase≠x) (hex : canonical.exp≠x) (hw : WS≠x) :
    Slots F canonical WS S B (σ.setVar x v) := by
  obtain ⟨⟨h1,h2,h3,h4,h5,h6,h7,h8,h9,h10,h11,h12⟩,hws,hfit,hmod,hcan,hsw⟩:=h
  refine ⟨⟨h1,?_,?_,h4,h5,h6,h7,h8,?_,?_,?_,h12⟩,hws,?_,?_,?_,hsw⟩ <;>
    simp only [vars_setVar,arrs_setVar,if_neg he,if_neg hp,if_neg hm,if_neg hex,if_neg hw] <;>
    first | assumption | (intro i;exact h10 i) | (intro s hs;exact hcan s hs)
def copies : List (String×String) → Com
  | []=>.skip
  | (x,y)::xs=>.seq (.assign x (.var y)) (copies xs)
def copied : List (String×String) → Env → Env
  | [],σ=>σ
  | (x,y)::xs,σ=>copied xs (σ.setVar x (σ.vars y))
theorem copies_run {B : Nat} (xs : List (String×String)) (σ : Env)
    (hb : ∀p∈xs,σ.vars p.2<B)
    (hd : ∀p∈xs,∀q∈xs,p.1≠q.2) :
    Run B (copies xs) σ (copied xs σ) (2*xs.length+1) := by
  induction xs generalizing σ with
  | nil=>simpa [copies,copied] using (Run.skip (B:=B) (σ:=σ))
  | cons p xs ih=>
    rcases p with ⟨x,y⟩
    have hr:=Run.assign (x:=x) (evalB_var (hb (x,y) (by simp)))
    have htail:=ih (σ.setVar x (σ.vars y))
      (fun q hq=>by
        have hxy:x≠q.2:=hd (x,y) (by simp) q (by simp [hq])
        simpa [vars_setVar,Ne.symm hxy] using hb q (by simp [hq]))
      (fun p hp q hq=>hd p (by simp [hp]) q (by simp [hq]))
    exact (hr.seq htail).mono (by simp only [Expr.size,List.length_cons];omega)
theorem copied_slots {WS : String} {S B : Nat} (xs : List (String×String)) (σ : Env)
    (hs : Slots F canonical WS S B σ)
    (hf : ∀p∈xs,canonical.e≠p.1 ∧ canonical.p≠p.1 ∧ canonical.modBase≠p.1 ∧
      canonical.exp≠p.1 ∧ WS≠p.1) : Slots F canonical WS S B (copied xs σ) := by
  induction xs generalizing σ with
  | nil=>exact hs
  | cons p xs ih=>
    have h:=hf p (by simp)
