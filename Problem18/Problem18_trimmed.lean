  have hξ : ValidMemory F B ξ:=validMemory_arguments h av bv ov
  have hA : ξ.vars canonical.aBase=av:=by simp [ξ,arguments,canonical]
  have hB : ξ.vars canonical.bBase=bv:=by simp [ξ,arguments,canonical]
  have hO : ξ.vars canonical.outBase=ov:=by simp [ξ,arguments,canonical]
  have hQ : ξ.vars canonical.exp=σ.vars canonical.exp:=by simp [ξ,arguments,canonical]
  have hM : ξ.vars canonical.modBase=σ.vars canonical.modBase:=by simp [ξ,arguments,canonical]
  obtain ⟨τ,hr,hτ,hv,hm,hf⟩:=primitive_run_preserving op hξ
    (by change ξ.vars canonical.aBase+F.e≤(σ.arrs canonical.mem).length; rw [hA]; exact ha)
    (by change ξ.vars canonical.bBase+F.e≤(σ.arrs canonical.mem).length; rw [hB]; exact hb)
    (by change ξ.vars canonical.outBase+F.e≤(σ.arrs canonical.mem).length; rw [hO]; exact ho)
    (by rw [hO,hA]; exact hoa) (by rw [hO,hB]; exact hob)
    (by rw [hO,hM]; exact hom) (by rw [hQ]; exact hex)
  refine ⟨τ,?_,hτ,?_,?_,?_⟩
  · simpa only [hQ] using call_run canonical a b o op.code hea heb heo hr
  · rw [hA,hB,hO,hQ] at hv
    exact hv
  · intro j hj hd
    exact hm j hj (by simpa only [hO] using hd)
  · refine ⟨?_,hf.2⟩
    intro x hx
    simp only [callRegisters,List.mem_append,List.mem_cons,List.not_mem_nil,or_false,not_or] at hx
    exact (hf.1 x hx.1).trans
      (arguments_vars canonical σ av bv ov x hx.2.1 hx.2.2.1 hx.2.2.2)
