  | b::bs => let r:=readWord bs; (Nat.bit b r.1,r.2+3)
def digit (F : FieldPresentation K) (q t i j : ℕ) : Fin F.p×ℕ :=
  let a:=binaryPower q i
  let b:=binaryPower F.p j
  (⟨((t/a.1)%q/b.1)%F.p,Nat.mod_lt _ F.prime.pos⟩,a.2+b.2+4)
theorem digit_value (F : FieldPresentation K) (q t i j : ℕ) :
    ((digit F q t i j).1:ℕ)=((t/q^i)%q/F.p^j)%F.p := by simp [digit]
theorem digit_cost (F : FieldPresentation K) (q t i j : ℕ) :
    (digit F q t i j).2 ≤ 2*i.size+2*j.size+4 := by
  dsimp only [digit]
  have ha:=binaryPower_cost q i
  have hb:=binaryPower_cost F.p j
  omega
def vector (F : FieldPresentation K) (n t : ℕ) : (Fin n→K)×ℕ :=
  let q:=binaryPower F.p F.e
  let es:=Array.ofFn fun ij:Fin (n*F.e) => digit F q.1 t (finProdFinEquiv.symm ij).1.val (finProdFinEquiv.symm ij).2.val
  ((fun i => F.coordinate.symm fun j => (es[(finProdFinEquiv (i,j)).val]'(by simpa [es] using (finProdFinEquiv (i,j)).isLt)).1),
    q.2+∑ij:Fin (n*F.e),(es[ij.val]'(by simpa [es] using ij.isLt)).2)
theorem vector_value (F : FieldPresentation K) (n : ℕ) (t : Fin ((F.p^F.e)^n)) :
    (vector F n t.val).1=(vectorEquiv F n).symm t := by
  funext i
  apply F.coordinate.injective
  simp only [vector,Array.getElem_ofFn,Fin.eta,Equiv.symm_apply_apply,binaryPower_correct,
    vectorEquiv,Equiv.symm_trans,Equiv.trans_apply,Equiv.piCongrRight,Pi.map_apply,
    Equiv.apply_symm_apply]
  apply funext
  intro j
  apply Fin.ext
  rw [digit_value]
  change (_ : ℕ) = ((F.coordinate (F.coordinate.symm
    (finFunctionFinEquiv.symm (finFunctionFinEquiv.symm t i)))) j).val
  rw [Equiv.apply_symm_apply]
  rfl
def vectorBudget (n e : ℕ) := 2*e.size+n*e*(2*n.size+2*e.size+4)
theorem vector_cost (F : FieldPresentation K) (n t : ℕ) :
    (vector F n t).2 ≤ vectorBudget n F.e := by
  have hq:=binaryPower_cost F.p F.e
  dsimp only [vector]
  apply Nat.add_le_add hq
  calc
    _ ≤ ∑_ij:Fin (n*F.e),(2*n.size+2*F.e.size+4) := by
      apply Finset.sum_le_sum
      intro ij hij
      simp only [Array.getElem_ofFn, Fin.eta]
      apply (digit_cost _ _ _ _ _).trans
      have hi:=Nat.size_le_size (finProdFinEquiv.symm ij).1.isLt.le
      have hj:=Nat.size_le_size (finProdFinEquiv.symm ij).2.isLt.le
      omega
    _ = _ := by simp
def pair (F : FieldPresentation K) (n t : ℕ) : ((Fin n→K)×(Fin n→K))×ℕ :=
  let q:=binaryPower F.p F.e
  let N:=binaryPower q.1 n
  let a:=vector F n (t/N.1)
  let b:=vector F n (t%N.1)
  ((a.1,b.1),q.2+N.2+2+a.2+b.2)
def sample (F : FieldPresentation K) (n : ℕ) (coins : Fin (pairSize F n).size→Bool) :
    Option ((Fin n→K)×(Fin n→K))×ℕ :=
  let q:=binaryPower F.p F.e
  let N:=binaryPower q.1 n
  let size:=N.1*N.1
  let w:=readWord (List.ofFn coins)
  if w.1<size then
    let r:=pair F n w.1
    (some r.1,q.2+N.2+1+w.2+1+r.2)
  else (none,q.2+N.2+1+w.2+1)
end Mathproof.Problem18CountedFairSampling20261001
end
