section Integralize
variable {K : Type} {F : Type*} [Field K] [Field F] [Algebra K F]
theorem integralize {B D : ℕ} {t y : F} (ht : Transcendental K t)
    (hr : BoundedRelation K B D t y) :
    ∃ (h : ℕ) (a : Polynomial K) (c : Fin h → Polynomial K), 1 ≤ h ∧ h ≤ D ∧ a ≠ 0 ∧
      a.natDegree ≤ B ∧ (∀ k, (c k).natDegree ≤ B * D) ∧
      (aeval t a * y) ^ h + ∑ k : Fin h, aeval t (c k) * (aeval t a * y) ^ k.val = 0 := by
  obtain ⟨h, hD, c0, a, ha, haB, hc0, hrel⟩ := hr
  have hta : aeval t a ≠ 0 := fun h0 => ht ⟨a, ha, h0⟩
  have h1 : 1 ≤ h := by
    rcases Nat.eq_zero_or_pos h with rfl | hpos
    · simp only [pow_zero, mul_one, Finset.univ_eq_empty, Finset.sum_empty, add_zero] at hrel
      exact absurd hrel hta
    · exact hpos
  refine ⟨h, a, fun k => c0 k * a ^ (h - 1 - k.val), h1, hD, ha, haB, ?_, ?_⟩
  · intro k
    calc (c0 k * a ^ (h - 1 - k.val)).natDegree
        ≤ (c0 k).natDegree + (h - 1 - k.val) * a.natDegree := by
          refine (Polynomial.natDegree_mul_le).trans ?_
          exact Nat.add_le_add_left (Polynomial.natDegree_pow_le) _
      _ ≤ B + (h - 1 - k.val) * B := Nat.add_le_add (hc0 k) (Nat.mul_le_mul_left _ haB)
      _ = (h - k.val) * B := by
          have hk := k.isLt
          rw [show h - k.val = 1 + (h - 1 - k.val) by omega, add_mul, one_mul]
      _ ≤ B * D := by rw [mul_comm]; exact Nat.mul_le_mul_left _ (by omega)
  · have hmul := congrArg (fun x => aeval t a ^ (h - 1) * x) hrel
    simp only [mul_zero, mul_add, Finset.mul_sum] at hmul
    rw [← hmul]
    congr 1
    · rw [mul_pow, ← mul_assoc, ← pow_succ, Nat.sub_add_cancel h1]
    · apply Finset.sum_congr rfl
      intro k _
      have hk := k.isLt
      have he : aeval t a ^ (h - 1) = aeval t a ^ (h - 1 - k.val) * aeval t a ^ k.val := by
        rw [← pow_add]; congr 1; omega
      rw [map_mul, map_pow, mul_pow, he]
      ring
end Integralize
section Monomials
variable {F : Type*} [Field F] {K : Type} [Field K] [Algebra K F]
variable {n : ℕ} (t : F) (h : Fin n → ℕ) (w : Fin n → F) (c : (j : Fin n) → Fin (h j) → Polynomial K)
def mono (α : (j : Fin n) → Fin (h j)) : F := ∏ j, w j ^ (α j : ℕ)
def mulMat (j : Fin n) : Matrix ((l : Fin n) → Fin (h l)) ((l : Fin n) → Fin (h l)) (Polynomial K) :=
  fun α β =>
    if hlt : (α j : ℕ) + 1 < h j then (if β = Function.update α j ⟨(α j : ℕ) + 1, hlt⟩ then 1 else 0)
    else (if ∀ l, l ≠ j → β l = α l then -(c j (β j)) else 0)
theorem mono_update (α : (j : Fin n) → Fin (h j)) (j : Fin n) (v : Fin (h j)) :
    mono h w (Function.update α j v) = w j ^ (v : ℕ) * ∏ l ∈ Finset.univ.erase j, w l ^ (α l : ℕ) := by
  unfold mono
  rw [← Finset.mul_prod_erase _ _ (Finset.mem_univ j), Function.update_self]
  congr 1
  apply Finset.prod_congr rfl
  intro l hl
  rw [Function.update_of_ne (Finset.ne_of_mem_erase hl)]
theorem mono_eq (α : (j : Fin n) → Fin (h j)) (j : Fin n) :
    mono h w α = w j ^ (α j : ℕ) * ∏ l ∈ Finset.univ.erase j, w l ^ (α l : ℕ) := by
  have := mono_update h w α j (α j)
  rwa [Function.update_eq_self] at this
theorem mulMat_spec (hw : ∀ j, w j ^ h j + ∑ k : Fin (h j), aeval t (c j k) * w j ^ k.val = 0)
    (j : Fin n) (α : (l : Fin n) → Fin (h l)) :
    w j * mono h w α = ∑ β, aeval t (mulMat h c j α β) * mono h w β := by
  classical
  by_cases hlt : (α j : ℕ) + 1 < h j
  · simp only [mulMat, dif_pos hlt]
    simp only [apply_ite (aeval t), map_one, map_zero, ite_mul, one_mul, zero_mul,
      Finset.sum_ite_eq', Finset.mem_univ, if_true]
    rw [mono_update, mono_eq h w α j, ← mul_assoc, ← pow_succ']
  · simp only [mulMat, dif_neg hlt]
    have hj : (α j : ℕ) + 1 = h j := by have := (α j).isLt; omega
    have hfilter : (Finset.univ.filter fun β : (l : Fin n) → Fin (h l) => ∀ l, l ≠ j → β l = α l) =
        Finset.univ.image (fun v : Fin (h j) => Function.update α j v) := by
      ext β
      simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_image]
      constructor
      · intro hβ
        refine ⟨β j, ?_⟩
        funext l
        by_cases hl : l = j
        · subst hl; rw [Function.update_self]
        · rw [Function.update_of_ne hl, hβ l hl]
      · rintro ⟨v, rfl⟩ l hl
        rw [Function.update_of_ne hl]
    have hinj : Function.Injective (fun v : Fin (h j) => Function.update α j v) := by
      intro v v' hv
      have := congrFun hv j
      simpa using this
    simp only [apply_ite (aeval t), map_zero, ite_mul, zero_mul]
    rw [← Finset.sum_filter, hfilter, Finset.sum_image (fun v _ v' _ hv => hinj hv)]
    simp only [Function.update_self, mono_update]
    have hrest := hw j
    rw [mono_eq h w α j, ← mul_assoc, ← pow_succ', hj]
    have hsum : ∑ v : Fin (h j), aeval t (-c j v) * (w j ^ (v : ℕ) *
        ∏ l ∈ Finset.univ.erase j, w l ^ (α l : ℕ)) =
        -(∑ k : Fin (h j), aeval t (c j k) * w j ^ k.val) *
          ∏ l ∈ Finset.univ.erase j, w l ^ (α l : ℕ) := by
      rw [neg_mul, Finset.sum_mul, ← Finset.sum_neg_distrib]
      apply Finset.sum_congr rfl
      intro v _
      rw [map_neg]
      ring
    rw [hsum, eq_neg_of_add_eq_zero_left hrest]
end Monomials
section Determinant
variable {K : Type} {F : Type*} [Field K] [Field F] [Algebra K F]
theorem charpoly_eval_eq_zero {ι : Type*} [Fintype ι] [DecidableEq ι] (t u : F) (g : ι → F)
    (α0 : ι) (hg0 : g α0 = 1) (M : Matrix ι ι (Polynomial K))
    (hact : ∀ α, u * g α = ∑ β, aeval t (M α β) * g β) :
    (M.charpoly.map (aeval t : Polynomial K →ₐ[K] F).toRingHom).eval u = 0 := by
  rw [← Matrix.charpoly_map, Matrix.eval_charpoly]
  apply (Matrix.exists_mulVec_eq_zero_iff).mp
  refine ⟨g, fun h0 => by simpa [hg0] using congrFun h0 α0, ?_⟩
  funext α
  rw [Matrix.sub_mulVec, Pi.sub_apply, Matrix.scalar_apply, Matrix.mulVec_diagonal, hact α]
  simp [Matrix.mulVec, dotProduct, Matrix.map_apply]
end Determinant
section Combination
variable {K : Type} {F : Type*} [Field K] [Field F] [Algebra K F]
def combBound (n B D : ℕ) : ℕ := D ^ n * (2 * n * B + B * D)
theorem combination_relation {B D : ℕ} {t : F} (ht : Transcendental K t) {n : ℕ}
    (y : Fin n → F) (hr : ∀ j, BoundedRelation K B D t (y j)) (cc : Fin n → K) :
    NonmonicRelation K (combBound n B D) t (∑ j, algebraMap K F (cc j) * y j) := by
  classical
  choose h a c h1 hD ha haB hc hw using fun j => integralize ht (hr j)
  set w : Fin n → F := fun j => aeval t (a j) * y j with hw_def
  let ι := (l : Fin n) → Fin (h l)
  let A : Fin n → Polynomial K := fun j => ∏ l ∈ Finset.univ.erase j, a l
  let b : Fin n → Polynomial K := fun j => Polynomial.C (cc j) * A j
  let M : Matrix ι ι (Polynomial K) := ∑ j, b j • mulMat h c j
  let atot : Polynomial K := ∏ j, a j
  set z : F := ∑ j, algebraMap K F (cc j) * y j with hz_def
  set u : F := aeval t atot * z with hu_def
  have hu : u = ∑ j, aeval t (b j) * w j := by
    rw [hu_def, hz_def, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    have hsplit : atot = a j * A j := (Finset.mul_prod_erase _ _ (Finset.mem_univ j)).symm
    simp only [hw_def, b, hsplit, map_mul, Polynomial.aeval_C]
    ring
  have hact : ∀ α : ι, u * mono h w α = ∑ β, aeval t (M α β) * mono h w β := by
    intro α
    rw [hu, Finset.sum_mul]
    have hsp : ∀ j, aeval t (b j) * w j * mono h w α =
        ∑ β, aeval t (b j * mulMat h c j α β) * mono h w β := by
      intro j
      rw [mul_assoc, mulMat_spec t h w c hw j α, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro β _
      rw [map_mul (aeval t) (b j) (mulMat h c j α β)]
      ring
    simp only [hsp]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro β _
    rw [← Finset.sum_mul, ← map_sum]
    congr 2
    simp [M, Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul]
  have hA : ∀ j, (A j).natDegree ≤ (n - 1) * B := by
    intro j
    refine le_trans (Polynomial.natDegree_prod_le (s := _) (f := _)) ?_
    refine (Finset.sum_le_sum fun l _ => haB l).trans ?_
    rw [Finset.sum_const, Finset.card_erase_of_mem (Finset.mem_univ j), Finset.card_univ,
      Fintype.card_fin, smul_eq_mul]
  have hMj : ∀ j α β, (mulMat h c j α β).natDegree ≤ B * D := by
    intro j α β
    simp only [mulMat]
    split_ifs <;> simp [hc]
  have hM : ∀ α β, (M α β).natDegree ≤ (n - 1) * B + B * D := by
    intro α β
    simp only [M, Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul]
    apply Polynomial.natDegree_sum_le_of_forall_le
    intro j _
    refine Polynomial.natDegree_mul_le.trans (Nat.add_le_add ?_ (hMj j α β))
    exact (Polynomial.natDegree_C_mul_le _ _).trans (hA j)
  let α0 : ι := fun l => ⟨0, h1 l⟩
  have hg0 : mono h w α0 = 1 := by simp [mono, α0]
  have hχ := charpoly_eval_eq_zero t u (mono h w) α0 hg0 M hact
  set χ := M.charpoly with hχ_def
  set N := Fintype.card ι with hN_def
  have hχdeg : χ.natDegree = N := Matrix.charpoly_natDegree_eq_dim M
  have hχlead : χ.coeff N = 1 := by
    rw [← hχdeg]; exact (Matrix.charpoly_monic M).coeff_natDegree
  rw [Polynomial.eval_map, Polynomial.eval₂_eq_sum_range, hχdeg, Finset.sum_range_succ,
    hχlead, map_one, one_mul, Finset.sum_range] at hχ
  have hNle : N ≤ D ^ n := by
    rw [hN_def, Fintype.card_pi]
    simp only [Fintype.card_fin]
    have := Finset.prod_le_pow_card (Finset.univ : Finset (Fin n)) h D (fun j _ => hD j)
    simpa using this
  have hatot : atot.natDegree ≤ n * B := by
    refine le_trans (Polynomial.natDegree_prod_le (s := _) (f := _)) ?_
    refine (Finset.sum_le_sum fun l _ => haB l).trans ?_
    rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, smul_eq_mul]
  have hatot0 : atot ≠ 0 := Finset.prod_ne_zero_iff.mpr fun j _ => ha j
  refine ⟨N, fun i => χ.coeff i * atot ^ (i : ℕ), atot ^ N, pow_ne_zero _ hatot0, ?_, ?_, ?_⟩
  · calc (atot ^ N).natDegree ≤ N * atot.natDegree := Polynomial.natDegree_pow_le
      _ ≤ N * (n * B) := Nat.mul_le_mul_left _ hatot
      _ ≤ D ^ n * (2 * n * B + B * D) := by
          apply Nat.mul_le_mul hNle
          nlinarith
  · intro i
    have hi := i.isLt
    calc (χ.coeff i * atot ^ (i : ℕ)).natDegree
        ≤ (χ.coeff i).natDegree + (i : ℕ) * atot.natDegree :=
