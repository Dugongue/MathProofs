  have hb := coefficient_weight_le_degree k K hD P
  have hd := hD P
  have hp : (0:ℤ)<placeDegree k K P := by exact_mod_cast placeDegree_pos k K P
  by_contra hn
  have : 1≤D P := by omega
  nlinarith
theorem boundedDivisor_reconstruct (N : Nat) (D : DivisorA k K)
    (hD : IsEffective k K D) (hd : deg k K D≤N) :
    boundedDivisor k K N (fun P => (D P.val).toNat)=D := by
  ext P
  rw [boundedDivisor_apply]
  split_ifs with hP
  · exact Int.toNat_of_nonneg (hD P)
  · symm
    apply effective_coefficient_zero_of_degree_lt k K D hD P
    have hp : (N:ℤ)<placeDegree k K P := by exact_mod_cast Nat.lt_of_not_ge hP
