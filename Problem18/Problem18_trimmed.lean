    · exact hQ
    · rw [hcη]; exact hsη.base.memory_word
  obtain ⟨τ,hr3,hsτ,hrdy,hmτ,ha,hv,hi,ho⟩ :=
    Problem18P34Subfield20261003NRecursiveSnapshot.run P hP F S B η hsη hcη
      (by simpa [η,prepared,hM] using hbank) hlayout
      (fun k hk => hwords _ (List.getElem_mem hk)) himage hseven hapart
  refine ⟨τ,?_,hsη,hsτ,hrdy,hmτ,ha,?_,hi,ho⟩
  · apply (hr1.seq (hr2.seq hr3)).mono
    simp only [η,prepared,arrs_setVar,hM]; omega
  · intro x hi hc hq
