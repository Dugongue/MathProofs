variable {K : Type*} [Field K] [Fintype K] (σ : K ≃+* K)
variable (f : (fixedField σ)[X])
variable (φ : AdjoinRoot (f.map (algebraMap (fixedField σ) K)) ≃+* AdjoinRoot (f.map (algebraMap (fixedField σ) K)))
    (hc : ∀ a : K,φ (AdjoinRoot.of (f.map (algebraMap (fixedField σ) K)) a)=AdjoinRoot.of (f.map (algebraMap (fixedField σ) K)) (σ a))
    (hr : φ (AdjoinRoot.root (f.map (algebraMap (fixedField σ) K)))=AdjoinRoot.root (f.map (algebraMap (fixedField σ) K)))
include σ f φ hc hr
theorem quotient_conjugation_mk (a : K[X]) :
    φ (AdjoinRoot.mk (f.map (algebraMap (fixedField σ) K)) a)=AdjoinRoot.mk (f.map (algebraMap (fixedField σ) K)) (a.map σ.toRingHom) := by
  have he : φ.toRingHom.comp (AdjoinRoot.mk (f.map (algebraMap (fixedField σ) K)))=
      (AdjoinRoot.mk (f.map (algebraMap (fixedField σ) K))).comp (Polynomial.mapRingHom σ.toRingHom) := by
    ext x
    · change φ (AdjoinRoot.mk (f.map (algebraMap (fixedField σ) K)) (C x)) =
        AdjoinRoot.mk (f.map (algebraMap (fixedField σ) K)) ((C x).map σ.toRingHom)
      rw [Polynomial.map_C,AdjoinRoot.mk_C,AdjoinRoot.mk_C]
      exact hc x
    · change φ (AdjoinRoot.mk (f.map (algebraMap (fixedField σ) K)) X) =
        AdjoinRoot.mk (f.map (algebraMap (fixedField σ) K)) (X.map σ.toRingHom)
      rw [Polynomial.map_X,AdjoinRoot.mk_X]
      exact hr
  exact congrArg (fun h : K[X] →+* AdjoinRoot (f.map (algebraMap (fixedField σ) K)) => h a) he
theorem quotient_conjugation_remainder (hm : f.Monic) (x : AdjoinRoot (f.map (algebraMap (fixedField σ) K))) :
    AdjoinRoot.modByMonicHom (hm.map (algebraMap (fixedField σ) K)) (φ x)=
      (AdjoinRoot.modByMonicHom (hm.map (algebraMap (fixedField σ) K)) x).map σ.toRingHom := by
  obtain ⟨a,rfl⟩ := AdjoinRoot.mk_surjective x
  rw [quotient_conjugation_mk σ f φ hc hr,AdjoinRoot.modByMonicHom_mk,
    AdjoinRoot.modByMonicHom_mk,Polynomial.map_modByMonic σ.toRingHom (hm.map (algebraMap (fixedField σ) K)),
    mapped_fixedField_fixed σ f]
theorem fixed_quotient_element_descends (hm : f.Monic)
    (x : AdjoinRoot (f.map (algebraMap (fixedField σ) K))) (hx : φ x=x) :
    ∃ a : AdjoinRoot f,quotientBaseMap (algebraMap (fixedField σ) K) f a=x := by
  let r := AdjoinRoot.modByMonicHom (hm.map (algebraMap (fixedField σ) K)) x
  have hfix : r.map σ.toRingHom=r := by
    have h := quotient_conjugation_remainder σ f φ hc hr hm x
    rw [hx] at h
    exact h.symm
  obtain ⟨a,ha⟩ := fixed_polynomial_descends σ r hfix
  refine ⟨AdjoinRoot.mk f a,?_⟩
  rw [quotientBaseMap_mk,ha]
  exact AdjoinRoot.mk_leftInverse (hm.map (algebraMap (fixedField σ) K)) x
theorem base_units_fixed_surjective (hm : f.Monic) :
    Function.Surjective (baseUnitsFixedEmbedding (algebraMap (fixedField σ) K) f σ
      (fun a => (mem_fixedField σ a.val).mp a.property) φ hc hr) := by
  intro u
  obtain ⟨x,hx⟩ := fixed_quotient_element_descends σ f φ hc hr hm u.val.val u.property
  have hu : Units.map φ.toMonoidHom u.val=u.val := Units.ext u.property
  have hui : φ (↑u.val⁻¹:AdjoinRoot (f.map (algebraMap (fixedField σ) K)))=(↑u.val⁻¹:AdjoinRoot (f.map (algebraMap (fixedField σ) K))) := by
    have h : Units.map φ.toMonoidHom u.val⁻¹=u.val⁻¹ := by rw [map_inv,hu]
    exact congrArg Units.val h
  obtain ⟨y,hy⟩ := fixed_quotient_element_descends σ f φ hc hr hm (↑u.val⁻¹) hui
  have hxy : x*y=1 := (quotientBaseMap_injective (algebraMap (fixedField σ) K) f) (by rw [map_mul,hx,hy,Units.mul_inv,map_one])
  let v : (AdjoinRoot f)ˣ := ⟨x,y,hxy,by rw [mul_comm]; exact hxy⟩
  refine ⟨v,?_⟩
  apply Subtype.ext
  apply Units.ext
  exact hx
theorem fixed_units_card (hm : f.Monic) :
    Nat.card {u : (AdjoinRoot (f.map (algebraMap (fixedField σ) K)))ˣ // φ u.val=u.val}=Nat.card (AdjoinRoot f)ˣ := by
  let e := baseUnitsFixedEmbedding (algebraMap (fixedField σ) K) f σ
    (fun a => (mem_fixedField σ a.val).mp a.property) φ hc hr
  exact (Nat.card_congr (Equiv.ofBijective e
    ⟨e.injective,base_units_fixed_surjective σ f φ hc hr hm⟩)).symm
end
