      τ.arrs canonical.mem=σ.arrs canonical.mem ∧
      (∀ a, a ≠ P.memoryBank → a ≠ P.layoutBank → τ.arrs a=σ.arrs a) ∧
      (∀ x, x ≠ P.idx → x ≠ P.count → x ≠ names.qr → τ.vars x=σ.vars x) ∧
