variable {K M ι : Type*} [Field K] [DecidableEq K] [AddCommGroup M] [Module K M]
def fractionFree (p : M →ₗ[K] (ι → K)) (i : ι) (v : M) : M →ₗ[K] M :=
  (p v i) • LinearMap.id - (((LinearMap.proj i).comp p).smulRight v)
@[simp] theorem fractionFree_apply (p : M →ₗ[K] (ι → K)) (i : ι) (v x : M) :
    fractionFree p i v x=(p v i) • x-(p x i) • v := rfl
theorem rowSpan_map (f : M →ₗ[K] M) (vs : List M) :
    rowSpan (K:=K) (vs.map f)=(rowSpan (K:=K) vs).map f := by
  rw [rowSpan,rowSpan,Submodule.map_span]
  congr 1
  ext x
  simp
theorem rowSpan_zero_cons (vs : List M) :
    rowSpan (K:=K) (0::vs)=rowSpan (K:=K) vs := by
  have hset : {v : M | v∈0::vs}=insert 0 {v | v∈vs} := by ext x; simp
  rw [rowSpan,hset]
  exact Submodule.span_insert_zero
theorem fractionFree_span_iff (p : M →ₗ[K] (ι → K)) (i : ι) (v x : M) (vs : List M)
    (hv : p v i ≠ 0) :
    x∈rowSpan (K:=K) (v::vs) ↔
      fractionFree p i v x∈rowSpan (K:=K) (vs.map (fractionFree p i v)) := by
  let E:=fractionFree p i v
  have hEv : E v=0 := by simp [E]
  have hmap : (rowSpan (K:=K) (v::vs)).map E=rowSpan (K:=K) (vs.map E) := by
    rw [← rowSpan_map,List.map_cons,hEv,rowSpan_zero_cons]
  constructor
  · intro hx
    rw [← hmap]
    exact ⟨x,hx,rfl⟩
  · intro hx
    have hsub : rowSpan (K:=K) (vs.map E)≤ rowSpan (K:=K) (v::vs) := by
      apply Submodule.span_le.mpr
      intro y hy
      obtain ⟨z,hz,rfl⟩:=List.mem_map.mp hy
      exact Submodule.sub_mem _
        (Submodule.smul_mem _ _ (mem_rowSpan _ _ (List.mem_cons_of_mem _ hz)))
        (Submodule.smul_mem _ _ (mem_rowSpan _ _ List.mem_cons_self))
    have hsum:=Submodule.add_mem _ (hsub hx)
      (Submodule.smul_mem (rowSpan (K:=K) (v::vs)) (p x i)
        (mem_rowSpan _ _ List.mem_cons_self))
    have hp : (p v i) • x∈rowSpan (K:=K) (v::vs) := by
      simpa only [E,fractionFree_apply,sub_add_cancel] using hsum
    exact (Submodule.smul_mem_iff _ hv).mp hp
end Linear
