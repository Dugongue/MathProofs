      rw [hvars₃ y hy h1 h2 h3 h4, hres₂.vars y hy h1 h2 h3, hvars₁ y hy h1 h2 h3 h4]
    · intro arr h1 h2
      rw [harr₃ arr h1 h2, hres₂.arrays arr h1 h2, harr₁ arr h1 h2]
    · rw [hinp₃, hres₂.inp, hinp₁]
    · rw [hout₃, hres₂.out, hout₁]
theorem monoCom_run {WS : String} {S B n : ℕ} (ms : MonoSlots) (hv : ms.Valid n S)
    (a : Fin n → ℕ) (hd : ∀ i, a i < B) {σ : Env} (hS : Slots F r WS S B σ)
    (hone : val F r WS σ ms.ONE = 1) :
    ∃ τ : Env, Run B (monoCom M WS ms a) σ τ (monoCost M a) ∧
      Slots F r WS S B τ ∧
      val F r WS τ (ms.out n) = ∏ i, val F r WS σ (ms.X + i.val) ^ a i ∧
      (∀ s < S, s ≠ ms.A0 → s ≠ ms.A1 → s ≠ ms.T → val F r WS τ s = val F r WS σ s) ∧
      MonoFrame (r := r) σ τ ∧
      (∀ arr, arr ≠ r.mem → arr ≠ r.scratch → τ.arrs arr = σ.arrs arr) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hSB := hS.slots_word
  have hpos := hv.pos
  obtain ⟨τ₁, hrun₁, hval₁, hres₁⟩ :=
    slot_call F r M.copy_spec hS (.lit ms.ONE) (.lit 0) (.lit ms.A0)
      (evalB_lit (by have := hv.one; omega)) (evalB_lit (by omega))
      (evalB_lit (by have := hv.a0; omega)) trivial trivial trivial
      hv.one hpos hv.a0 hv.a0_one hv.a0_zero
  obtain ⟨τ₂, hrun₂, hS₂, hval₂, hoth₂, hvars₂, harr₂, hinp₂, hout₂⟩ :=
    monoSteps_run M ms hv a hd (List.finRange n) false τ₁ hres₁.slots
  have hx₁ : ∀ j : Fin n, val F r WS τ₁ (ms.X + j.val) = val F r WS σ (ms.X + j.val) := by
    intro j
    have hj : ms.X + j.val < S := by have := j.isLt; have := hv.fit; omega
    exact val_of_slice_eq (hres₁.others _ hj (hv.a0_x _ j.isLt).symm)
  refine ⟨τ₂, ?_, hS₂, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · have h := hrun₁.seq hrun₂
    refine h.mono ?_
    simp only [monoCost, Expr.size]
    omega
  · unfold MonoSlots.out
    have hlen : (List.finRange n).length = n := List.length_finRange
    rw [hlen] at hval₂
    rw [hval₂]
    simp only [MonoSlots.acc, Bool.false_eq_true, if_false]
    rw [hval₁, hone, one_mul, Fin.prod_univ_def]
    congr 1
    exact List.map_congr_left (fun j _ => by rw [hx₁ j])
  · intro s hs h0 h1 ht
    rw [hoth₂ s hs h0 h1 ht]
    exact val_of_slice_eq (hres₁.others s hs h0)
  · intro y hy h1 h2 h3 h4
    rw [hvars₂ y hy h1 h2 h3 h4, hres₁.vars y hy h1 h2 h3]
  · intro arr h1 h2
    rw [harr₂ arr h1 h2, hres₁.arrays arr h1 h2]
  · rw [hinp₂, hres₁.inp]
  · rw [hout₂, hres₁.out]
