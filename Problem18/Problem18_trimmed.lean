    (lensPhaseLeft binaryCoreRenaming InterpreterMacroState.addLens
      sparseAddCoreProgram .done (Sum.inl SymbolMoveLabel.loop))
    (addResultMoveProgram returnLabel rightProgram) h₂ h₃'
