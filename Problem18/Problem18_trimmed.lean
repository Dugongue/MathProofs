open Mathproof.Problem18AtlasDeterminantProduct20261001
open Mathproof.Problem18DeterminantClassIsometry20261001
variable (K : Type*) [Field K] [Fintype K]
abbrev RegularForm (n : ℕ) :=
  {B : LinearMap.BilinForm K (Fin n → K) // B.IsSymm ∧ B.Nondegenerate}
def Isometric {n : ℕ} (B C : RegularForm K n) : Prop :=
  ∃ e : (Fin n → K) ≃ₗ[K] (Fin n → K),∀ x y,C.val (e x) (e y)=B.val x y
instance formSetoid (n : ℕ) : Setoid (RegularForm K n) where
  r := Isometric K
  iseqv := {
    refl := fun B => ⟨LinearEquiv.refl K _,fun _ _ => rfl⟩
    symm := by
      rintro B C ⟨e,he⟩
      refine ⟨e.symm,fun x y => ?_⟩
      simpa only [e.apply_symm_apply] using (he (e.symm x) (e.symm y)).symm
    trans := by
      rintro B C D ⟨e,he⟩ ⟨f,hf⟩
      exact ⟨e.trans f,fun x y => (hf (e x) (e y)).trans (he x y)⟩ }
abbrev FormClass (n : ℕ) := Quotient (formSetoid K n)
instance finite_regularForm (n : ℕ) : Finite (RegularForm K n) := by
  letI : Finite (LinearMap.BilinForm K (Fin n → K)) := Finite.of_injective
    (fun B : LinearMap.BilinForm K (Fin n → K) => fun x y => B x y)
    (by intro B C h; apply LinearMap.ext; intro x; apply LinearMap.ext; intro y; exact congrFun (congrFun h x) y)
  infer_instance
noncomputable def representative {n : ℕ} (c : FormClass K n) : RegularForm K n := Quotient.out c
theorem representative_covers {n : ℕ} (B : RegularForm K n) :
    Isometric K B (representative K (Quotient.mk _ B)) :=
  Quotient.exact (Quotient.out_eq' (Quotient.mk _ B)).symm
theorem representative_isometric_iff {n : ℕ} (c d : FormClass K n) :
    Isometric K (representative K c) (representative K d) ↔ c=d := by
  constructor
  · intro h
    have he := Quotient.sound (s:=formSetoid K n) h
    simpa only [representative,Quotient.out_eq'] using he
  · rintro rfl
    exact ⟨LinearEquiv.refl K _,fun _ _ => rfl⟩
theorem isometric_isAlt_iff {n : ℕ} {B C : RegularForm K n} (h : Isometric K B C) :
    B.val.IsAlt ↔ C.val.IsAlt := by
  obtain ⟨e,he⟩ := h
  constructor
  · intro hB x
    obtain ⟨x,rfl⟩ := e.surjective x
    rw [he]
    exact hB x
  · intro hC x
    rw [←he]
    exact hC (e x)
noncomputable def alternationClass {n : ℕ} : FormClass K n → Bool := by
  classical
  exact Quotient.lift (fun B => decide B.val.IsAlt) (by
    intro B C h
    exact congrArg (fun p : Prop => decide p) (propext (isometric_isAlt_iff K h)))
