namespace Mathproof.Problem18DistinctDegreeSquare20260930
open Polynomial UniqueFactorizationMonoid
variable {K : Type*} [Field K] [Fintype K]
def FrobeniusSquareTests (f a : K[X]) : Prop := by
  classical
  exact ∀ d : ℕ,1≤d → d≤f.natDegree →
    gcd f (X^(Nat.card K^d)-X) ∣ a^((Nat.card K^d)/2)-1
def PrimarySquares (f a : K[X]) : Prop :=
  ∀ p : K[X],Irreducible p → p ∣ f → IsSquare (aeval (AdjoinRoot.root p) a)
theorem aeval_root_zero_iff (p a : K[X]) :
    aeval (AdjoinRoot.root p) a=0 ↔ p ∣ a := by
  rw [AdjoinRoot.aeval_eq,AdjoinRoot.mk_eq_zero]
theorem adjoinRoot_card (p : K[X]) [Fact (Irreducible p)] :
    Nat.card (AdjoinRoot p)=Nat.card K^p.natDegree := by
  letI : FiniteDimensional K (AdjoinRoot p) := (AdjoinRoot.powerBasis (Fact.out : Irreducible p).ne_zero).finite
  have hd : Module.finrank K (AdjoinRoot p)=p.natDegree := finrank_quotient_span_eq_natDegree
  let b := Module.finBasis K (AdjoinRoot p)
  letI : Finite (AdjoinRoot p) := Finite.of_injective b.equivFun b.equivFun.injective
  letI : Fintype (AdjoinRoot p) := Fintype.ofFinite _
  simp only [Nat.card_eq_fintype_card]
  rw [Module.card_eq_pow_finrank (K := K) (V := AdjoinRoot p),hd]
theorem frobenius_divisor_fixed (p : K[X]) [Fact (Irreducible p)] (d : ℕ)
    (hp : p ∣ X^(Nat.card K^d)-X) (z : AdjoinRoot p) : z^(Nat.card K^d)=z := by
  let F := FiniteField.frobeniusAlgHom K (AdjoinRoot p)
  have hF (x : AdjoinRoot p) : (F^d) x=x^(Nat.card K^d) := by
    simp only [F,AlgHom.coe_pow,FiniteField.coe_frobeniusAlgHom,pow_iterate,Nat.card_eq_fintype_card]
  have hr : (AdjoinRoot.root p)^(Nat.card K^d)=AdjoinRoot.root p := by
    have h := (aeval_root_zero_iff p (X^(Nat.card K^d)-X)).mpr hp
    simpa only [map_sub,map_pow,aeval_X,sub_eq_zero] using h
  have he : F^d=1 := by
    apply AdjoinRoot.algHom_ext
    rw [hF]
    exact hr
  rw [← hF,he]
  rfl
theorem square_pow_half_eq_one {E : Type*} [Field E] (Q : ℕ) (hQ : Q%2=1)
    (hfix : ∀ z : E,z^Q=z) (a : E) (ha : a≠0) (hs : IsSquare a) : a^(Q/2)=1 := by
  obtain ⟨z,rfl⟩ := hs
  have hz : z≠0 := by intro h; apply ha; rw [h,zero_mul]
  rw [← pow_two,← pow_mul,Nat.two_mul_odd_div_two hQ]
  apply mul_right_cancel₀ hz
  rw [one_mul,← pow_succ,Nat.sub_add_cancel (by omega : 1≤Q)]
  exact hfix z
theorem squarefree_dvd_of_irreducible (g r : K[X]) (hg : Squarefree g) (hg0 : g≠0)
    (h : ∀ p : K[X],Irreducible p → p ∣ g → p ∣ r) : g ∣ r := by
  classical
  by_cases hr : r=0
  · simp [hr]
  apply (dvd_iff_normalizedFactors_le_normalizedFactors hg0 hr).mpr
  apply (Multiset.le_iff_subset ((squarefree_iff_nodup_normalizedFactors hg0).mp hg)).mpr
  intro p hp
  have hi := irreducible_of_normalized_factor p hp
  exact (mem_normalizedFactors_iff' hr).mpr
    ⟨hi,normalize_normalized_factor p hp,h p hi (dvd_of_mem_normalizedFactors hp)⟩
theorem primarySquares_iff_frobeniusSquareTests
    (f a : K[X]) (hf : Squarefree f) (hf0 : f≠0) (hcop : IsCoprime f a)
    (hchar : ringChar K≠2) : PrimarySquares f a ↔ FrobeniusSquareTests f a := by
  classical
  have hqodd : Nat.card K%2=1 := by
    simpa only [Nat.card_eq_fintype_card] using FiniteField.odd_card_of_char_ne_two hchar
  have hqpow (d : ℕ) : (Nat.card K^d)%2=1 := by rw [Nat.pow_mod,hqodd]; simp
  have hnonzero (p : K[X]) (hi : Irreducible p) (hp : p ∣ f) :
      aeval (AdjoinRoot.root p) a≠0 := by
    intro hz
    exact hi.not_isUnit (hcop.isUnit_of_dvd' hp ((aeval_root_zero_iff p a).mp hz))
  constructor
  · intro hs d hd hdf
    let g := gcd f (X^(Nat.card K^d)-X)
    have hgf : g ∣ f := gcd_dvd_left _ _
    have hg0 : g≠0 := by intro h; exact hf0 (zero_dvd_iff.mp (h ▸ hgf))
    apply squarefree_dvd_of_irreducible g _ (hf.squarefree_of_dvd hgf) hg0
    intro p hi hpg
    letI : Fact (Irreducible p) := ⟨hi⟩
    have hpf : p ∣ f := hpg.trans hgf
    have hpF : p ∣ X^(Nat.card K^d)-X := hpg.trans (gcd_dvd_right _ _)
    apply (aeval_root_zero_iff p _).mp
    have hh := square_pow_half_eq_one (Nat.card K^d) (hqpow d)
      (frobenius_divisor_fixed p d hpF) (aeval (AdjoinRoot.root p) a)
      (hnonzero p hi hpf) (hs p hi hpf)
    simpa only [map_sub,map_pow,map_one,sub_eq_zero] using hh
  · intro ht p hi hpf
    letI : Fact (Irreducible p) := ⟨hi⟩
    letI : FiniteDimensional K (AdjoinRoot p) := (AdjoinRoot.powerBasis hi.ne_zero).finite
    let b := Module.finBasis K (AdjoinRoot p)
    letI : Finite (AdjoinRoot p) := Finite.of_injective b.equivFun b.equivFun.injective
    letI : Fintype (AdjoinRoot p) := Fintype.ofFinite _
    have hc : Fintype.card (AdjoinRoot p)=Nat.card K^p.natDegree := by
      simpa only [Nat.card_eq_fintype_card] using adjoinRoot_card p
    have hEchar : ringChar (AdjoinRoot p)≠2 := by
      intro he
      have heven := FiniteField.even_card_of_char_two he
      rw [hc] at heven
      have hodd := hqpow p.natDegree
      omega
    have hpF : p ∣ X^(Nat.card K^p.natDegree)-X := by
      apply (aeval_root_zero_iff p _).mp
      have he := FiniteField.pow_card (AdjoinRoot.root p)
      rw [hc] at he
      simpa only [map_sub,map_pow,aeval_X,sub_eq_zero] using he
    have htest := ht p.natDegree hi.natDegree_pos (natDegree_le_of_dvd hpf hf0)
    have hdiv : p ∣ a^((Nat.card K^p.natDegree)/2)-1 :=
      (dvd_gcd hpf hpF).trans htest
    apply (FiniteField.isSquare_iff hEchar (hnonzero p hi hpf)).mpr
    rw [hc]
    have he := (aeval_root_zero_iff p _).mpr hdiv
    simpa only [map_sub,map_pow,map_one,sub_eq_zero] using he
end Mathproof.Problem18DistinctDegreeSquare20260930
end
