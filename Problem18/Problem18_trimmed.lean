noncomputable section
open Classical
open scoped BigOperators
variable {K : Type*} [Field K] [Fintype K]
theorem square_fiber_card (hodd : ringChar K ≠ 2) (t : K) :
    (Nat.card {x : K // x^2=t} : ℤ)=quadraticChar K t+1 := by
  simpa only [Nat.card_eq_fintype_card,Fintype.card_subtype,Set.toFinset_ofPred] using
    quadraticChar_card_sqrts hodd t
noncomputable def hyperbolaEquivUnits (t : K) (ht : t ≠ 0) :
    {uv : K × K // uv.1*uv.2=t} ≃ Kˣ where
  toFun uv := Units.mk0 uv.val.1 (by
    intro h; apply ht; rw [← uv.property,h,zero_mul])
  invFun u := ⟨(u.val,t/u.val),by
    dsimp
    rw [mul_div_cancel₀ _ u.ne_zero]⟩
  left_inv uv := by
    apply Subtype.ext
    change ((uv.val.1,t/uv.val.1) : K × K)=uv.val
    apply Prod.ext
    · rfl
    · apply (div_eq_iff (by
        intro h; apply ht; rw [← uv.property,h,zero_mul])).mpr
      exact ((mul_comm uv.val.2 uv.val.1).trans uv.property).symm
  right_inv u := by apply Units.ext; rfl
noncomputable def differenceSquareEquiv (hodd : ringChar K ≠ 2) (t : K) :
    {xy : K × K // xy.1^2-xy.2^2=t} ≃
      {uv : K × K // uv.1*uv.2=t} where
  toFun xy := ⟨(xy.val.1+xy.val.2,xy.val.1-xy.val.2),by
    dsimp
    calc _ = xy.val.1^2-xy.val.2^2 := by ring
         _ = t := xy.property⟩
  invFun uv := ⟨((uv.val.1+uv.val.2)/2,(uv.val.1-uv.val.2)/2),by
    dsimp
    have h2 := Ring.two_ne_zero hodd
    calc _ = uv.val.1*uv.val.2 := by field_simp; ring
         _ = t := uv.property⟩
  left_inv xy := by
    have h2 := Ring.two_ne_zero hodd
    apply Subtype.ext
    apply Prod.ext <;> dsimp <;> field_simp <;> ring
  right_inv uv := by
    have h2 := Ring.two_ne_zero hodd
    apply Subtype.ext
    apply Prod.ext <;> dsimp <;> field_simp <;> ring
noncomputable def differenceSquareFiberEquiv (t : K) :
    {xy : K × K // xy.1^2-xy.2^2=t} ≃
      Σ x : K,{y : K // y^2=x^2-t} where
  toFun xy := ⟨xy.val.1,⟨xy.val.2,by linear_combination -xy.property⟩⟩
  invFun xy := ⟨(xy.1,xy.2.val),by linear_combination -xy.2.property⟩
  left_inv xy := rfl
  right_inv xy := rfl
theorem quadratic_difference_sum (hodd : ringChar K ≠ 2) (t : K) (ht : t ≠ 0) :
    (∑ x : K,quadraticChar K (x^2-t)) = -1 := by
  have hc : Nat.card {xy : K × K // xy.1^2-xy.2^2=t}=Nat.card K-1 := by
    rw [Nat.card_congr (differenceSquareEquiv hodd t),
      Nat.card_congr (hyperbolaEquivUnits t ht),Nat.card_eq_fintype_card,
      Fintype.card_units,Nat.card_eq_fintype_card]
  have hf : (Nat.card {xy : K × K // xy.1^2-xy.2^2=t} : ℤ)=
      (∑ x : K,quadraticChar K (x^2-t))+Nat.card K := by
    rw [Nat.card_congr (differenceSquareFiberEquiv t),Nat.card_sigma,Nat.cast_sum]
    simp_rw [square_fiber_card hodd]
    rw [Finset.sum_add_distrib]
    simp only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,mul_one,Nat.card_eq_fintype_card]
  rw [hc,Nat.cast_sub (by exact Nat.one_le_of_lt (Nat.card_pos (α := K)))] at hf
  push_cast at hf
  linarith
end
end Mathproof.Problem18OddSphereCard20260930
