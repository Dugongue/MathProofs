variable {N : Nat} {K : Type*} [Field K]
theorem mem_ideal_iff_uniform_macaulay
    (F : Finset (MvPolynomial (Fin N) K)) (d : Nat)
    (hF : ∀ f ∈ F, f.totalDegree ≤ d) (p : MvPolynomial (Fin N) K) :
    p ∈ generatedIdeal (F : Set (MvPolynomial (Fin N) K)) ↔
      p ∈ macaulaySpan (F : Set (MvPolynomial (Fin N) K))
        (2*d*2^(controlledDepth N d)+p.totalDegree) := by
  classical
  constructor
  · intro hp
    obtain ⟨G,hG,hdeg,hmac⟩ := exists_uniform_macaulay_groebner F d hF
    let b : Reducer (G : Set (MvPolynomial (Fin N) K)) → MvPolynomial (Fin N) K := fun g => g.val
    have hb : ∀ i, b i ≠ 0 := fun i => i.property.2
    have hu : ∀ i, IsUnit (degLex.leadingCoeff (b i)) := fun i =>
      isUnit_iff_ne_zero.mpr (degLex.leadingCoeff_ne_zero_iff.mpr (hb i))
    obtain ⟨q,r,heq,hq,hr⟩ := degLex.div hu p
    have hrepI : Finsupp.linearCombination _ b q ∈ generatedIdeal (G : Set (MvPolynomial (Fin N) K)) := by
      rw [Finsupp.linearCombination_apply]
      exact Ideal.sum_mem _ (fun k _ => Ideal.mul_mem_left _ _ (Ideal.subset_span k.property.1))
    have hrI : r ∈ generatedIdeal (G : Set (MvPolynomial (Fin N) K)) := by
      rw [← hG.2,heq] at hp
      simpa using (generatedIdeal (G : Set (MvPolynomial (Fin N) K))).sub_mem hp hrepI
    have hred : IsReduced degLex (G : Set (MvPolynomial (Fin N) K)) r := by
      intro a ha g hg hg0
      exact hr a ha ⟨g,hg,hg0⟩
    have hr0 := reduced_mem_eq_zero_checked degLex (G : Set (MvPolynomial (Fin N) K)) hG.1 r hred hrI
    rw [hr0,add_zero] at heq
    have hcomb : Finsupp.linearCombination _ b q ∈
        macaulaySpan (F : Set (MvPolynomial (Fin N) K))
          (2*d*2^(controlledDepth N d)+p.totalDegree) := by
      rw [Finsupp.linearCombination_apply]
      apply Submodule.sum_mem
      intro k hk
      have hqdeg : (q k).totalDegree ≤ p.totalDegree :=
        (multiplier_totalDegree_le (b k) (q k) (hb k)).trans (degLex_totalDegree_monotone (hq k))
      exact mul_mem_macaulaySpan (F : Set (MvPolynomial (Fin N) K))
        (2*d*2^(controlledDepth N d)) p.totalDegree (q k) (b k) hqdeg (hmac _ k.property.1)
    simpa only [← heq] using hcomb
  · intro hp
    exact macaulaySpan_le_ideal _ _ hp
