  simp [Matrix.one_apply,Function.comp_def]
def templates (a b : Nat) : List (PolyExpr (Params a b ⊕ OuterVar a b) Int) :=
    ((List.finRange a).flatMap fun i => (List.finRange a).map fun j => isoP i j) ++
    ((List.finRange b).flatMap fun i => (List.finRange b).map fun j => isoR i j) ++
