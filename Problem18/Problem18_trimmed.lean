    (lo hi : Nat) (h : hi ≤ O ∨ O + L ≤ lo) : Keep σ τ lo hi :=
  fun j a b => hf j (by omega)
theorem keep_of2 {σ τ : Env} {O L W M : Nat}
    (hf : ∀ j, (j < O ∨ O + L ≤ j) → (j < W ∨ W + M ≤ j) →
      (τ.arrs canonical.mem).getD j 0 = (σ.arrs canonical.mem).getD j 0)
    (lo hi : Nat) (h : hi ≤ O ∨ O + L ≤ lo) (h' : hi ≤ W ∨ W + M ≤ lo) : Keep σ τ lo hi :=
  fun j a b => hf j (by omega) (by omega)
