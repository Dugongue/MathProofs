variable {K : Type} [Field K] [Fintype K] (F : FieldPresentation K)
variable (u : Bool) (q : Nat) {a b c : Nat} (A T : RectTensor a b c K) (ext : String → Nat)
def cardProgram : Com := .ite (.eq (.var "u") (.lit 0))
  (.assign canonical.exp (.var "q"))
  (.assign canonical.exp (.bin .mul (.var "q") (.var "q")))
def program : Com := .seq (.assign names.q.WS (.add (.var canonical.e) (.lit 1))) cardProgram
def ready : Env := ((result F u q A T ext).setVar names.q.WS (F.e+1)).setVar canonical.exp (Fintype.card K)
theorem scalar (x : String) (hx : x≠loadIndex ∧ x≠loadValue ∧ x≠base ∧ x≠total) :
    (result F u q A T ext).vars x=(modPrepared F u q A T ext).vars x := by
