theorem gauss_valid : gauss.Valid canonical := by constructor <;> decide
def maxLength (n : Nat) := rowStart (2*n) n
def bankStart (n d : Nat) := (d+1)*maxLength n
def body : Com := .seq (.assign gauss.N (.add (.var gauss.n) (.var indexReg)))
  (.seq (.assign gauss.c (.var indexReg))
    (.seq (.assign bankReg (.mul (.add (.var indexReg) (.lit 1)) (.var strideReg)))
      (.seq (Problem18IMPIntertwinerTrialBank20261001.program gauss flagReg scanReg bankReg)
        (.assign indexReg (.add (.var indexReg) (.lit 1))))))
def routine : Com := .seq (.assign indexReg (.lit 0))
  (.seq (.assign flagReg (.lit 1))
    (.seq (.while (.eq (.var flagReg) (.lit 1)) body)
      (.assign answerReg (.bin .sub (.var indexReg) (.lit 1)))))
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
def bodyBudget (n : Nat) :=
  200*macroBudget F*(maxLength n+1)+
  1200*macroBudget F*(2*n+1)*(n+1)^2+50*macroBudget F*(n+1)+50
def scanBudget (n : Nat) := (bodyBudget F n+4)*(n+1)+20
def Bank {n : Nat} (S : Module.End K (Fin n→K)) (z : Fin n→K) (σ : Env) (d : Nat) : Prop :=
  val F canonical gauss.WS σ (bankStart n d)=0 ∧
  restRows (fun s=>val F canonical gauss.WS σ (bankStart n d+s)) (n+d) d 0=
    (rows (fun j:Fin d=>orbit S z j.val)).map read ∧
  rowVec (fun s=>val F canonical gauss.WS σ (bankStart n d+s)) 5 (n+d)=
    read (query (m:=d) (orbit S z d))
structure Input {n : Nat} (S : Module.End K (Fin n→K)) (z : Fin n→K)
    (Sn B : Nat) (σ : Env) : Prop where
  slots : Slots F canonical gauss.WS Sn B σ
  dimension : σ.vars gauss.n=n
  stride : σ.vars strideReg=maxLength n
  fit : (n+2)*maxLength n ≤ Sn
  banks : ∀d ≤ n,Bank F S z σ d
theorem length_le {n d : Nat} (hd : d ≤ n) : rowStart (n+d) d ≤ maxLength n := by
  unfold maxLength rowStart
  gcongr <;> omega
theorem length_pos (n : Nat) : 5 ≤ maxLength n := by unfold maxLength rowStart; omega
theorem word_bounds {n Sn B : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ : Env} (h : Input F S z Sn B σ) : n+2<B ∧ maxLength n<B := by
  have hl:=length_pos n
  have hs:=h.slots.slots_word
  have hf:=h.fit
  constructor <;> nlinarith
theorem bank_fit {n Sn B d : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ : Env} (h : Input F S z Sn B σ) (hd : d ≤ n) :
    bankStart n d+rowStart (n+d) d ≤ Sn ∧ maxLength n ≤ bankStart n d := by
  have hL:=length_le hd
  have hh:=Nat.mul_le_mul_right (maxLength n) (show d+2 ≤ n+2 by omega)
  have hf:=h.fit
  unfold bankStart
  constructor <;> nlinarith
theorem bank_congr {n Sn d : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ τ : Env} (hd : d ≤ n) (hfit : bankStart n d+rowStart (n+d) d ≤ Sn)
    (hmem : ∀s<Sn,maxLength n ≤ s→val F canonical gauss.WS τ s=val F canonical gauss.WS σ s)
    (h : Bank F S z σ d) : Bank F S z τ d := by
  have hstart : maxLength n ≤ bankStart n d := by unfold bankStart; nlinarith
  have hv (s : Nat) (hs : s< rowStart (n+d) d) :
      val F canonical gauss.WS τ (bankStart n d+s)=val F canonical gauss.WS σ (bankStart n d+s) :=
    hmem _ (by omega) (by omega)
  refine ⟨?_,?_,?_⟩
  · simpa using (hv 0 (by unfold rowStart; omega)).trans h.1
  · rw [←h.2.1]
    unfold restRows
    apply List.map_congr_left
    intro t ht
    simp only [List.mem_range,Nat.sub_zero] at ht
    funext i
    apply hv
    have hi:=i.isLt
    have hm:=Nat.mul_le_mul_right (n+d) (show t+1 ≤ d by omega)
    unfold rowStart
    nlinarith
  · rw [←h.2.2]
    funext i
    apply hv
    have hi:=i.isLt
    unfold rowStart
    omega
theorem input_setVar {n Sn B : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ : Env} (h : Input F S z Sn B σ) (x : String) (v : Nat)
    (hx : x∉regNames canonical) (hw : x≠gauss.WS) (hn : x≠gauss.n) (hl : x≠strideReg) :
    Input F S z Sn B (σ.setVar x v) := by
  refine ⟨Slots.setVar F canonical h.slots hx hw v,?_,?_,h.fit,?_⟩
  · simpa only [vars_setVar,if_neg hn.symm] using h.dimension
  · simpa only [vars_setVar,if_neg hl.symm] using h.stride
  · intro d hd
    simpa only [Bank,val_setVar F canonical hw] using h.banks d hd
theorem input_transport {n Sn B : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ τ : Env} (h : Input F S z Sn B σ) (hs : Slots F canonical gauss.WS Sn B τ)
    (hn : τ.vars gauss.n=σ.vars gauss.n) (hl : τ.vars strideReg=σ.vars strideReg)
    (hm : ∀s<Sn,maxLength n ≤ s→val F canonical gauss.WS τ s=val F canonical gauss.WS σ s) :
    Input F S z Sn B τ :=
  ⟨hs,hn.trans h.dimension,hl.trans h.stride,h.fit,
    fun d hd=>bank_congr F hd (bank_fit F h hd).1 hm (h.banks d hd)⟩
def prepared (σ : Env) (n d : Nat) : Env :=
  ((σ.setVar gauss.N (n+d)).setVar gauss.c d).setVar bankReg (bankStart n d)
theorem prepared_input {n Sn B d : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ : Env} (h : Input F S z Sn B σ) : Input F S z Sn B (prepared σ n d) := by
  unfold prepared
  repeat' apply input_setVar F
  all_goals first | exact h | decide
theorem trial_cost_le (n d : Nat) (hd : d ≤ n) :
    copyCost (fieldMacros F) (.lit 0) (.var bankReg) (rowStart (n+d) d)+
      reduceCost (fieldMacros F) gauss (n+d) n d+zeroCost (fieldMacros F) n+34 ≤ bodyBudget F n := by
  have hc:=copyCost_le (concrete_costBound F) (Expr.lit 0) (Expr.var bankReg) (by decide) (by decide) (rowStart (n+d) d)
  have hr:=reduce_cost F gauss (n+d) n d (by omega)
  have hz:=zeroCost_le (concrete_costBound F) n
  have hc' : copyCost (fieldMacros F) (.lit 0) (.var bankReg) (rowStart (n+d) d) ≤ 200*macroBudget F*(maxLength n+1) :=
    hc.trans (by gcongr; exact length_le hd)
  have hr' : reduceCost (fieldMacros F) gauss (n+d) n d ≤ 1200*macroBudget F*(2*n+1)*(n+1)^2 :=
    hr.trans (by gcongr <;> omega)
  unfold bodyBudget
  omega
theorem body_run {n Sn B : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ : Env} (h : Input F S z Sn B σ) (hd : σ.vars indexReg ≤ n) :
    ∃τ,Run B body σ τ (bodyBudget F n) ∧ Input F S z Sn B τ ∧
      τ.vars indexReg=σ.vars indexReg+1 ∧ τ.vars flagReg ≤ 1 ∧
      (τ.vars flagReg=0 ↔ dependence S z (σ.vars indexReg)=true) ∧
      (∀j:Fin (σ.vars indexReg),val F canonical gauss.WS τ (5+(n+j.val))=
        -coefficients S z (σ.vars indexReg) j) ∧
      (∀s<Sn,maxLength n ≤ s→val F canonical gauss.WS τ s=val F canonical gauss.WS σ s) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  let d:=σ.vars indexReg
  have hword:=word_bounds F h
  have hfit:=bank_fit F h hd
  have hL:=length_le hd
  have hb : bankStart n d<B := by have hs:=h.slots.slots_word; unfold d; omega
  have hsum : n+d<B := by have hlen:=length_pos n; unfold d; nlinarith [h.fit,h.slots.slots_word]
  let σ1:=σ.setVar gauss.N (n+d)
  let σ2:=σ1.setVar gauss.c d
  have eN : (Expr.add (.var gauss.n) (.var indexReg)).evalB B σ=some (n+d) := by
    apply evalB_bin
    · rw [←h.dimension]; exact evalB_var (by rw [h.dimension]; omega)
    · exact evalB_var (by dsimp [d] at *; omega)
    · exact hsum
  have ec : (Expr.var indexReg).evalB B σ1=some d := by
    apply evalB_var_iff.mpr
    exact ⟨by simp [σ1,gauss,indexReg,d],by simpa [σ1,gauss,indexReg] using (show σ.vars indexReg<B by omega)⟩
  have eb : (Expr.mul (.add (.var indexReg) (.lit 1)) (.var strideReg)).evalB B σ2=some (bankStart n d) := by
    have ei : σ2.vars indexReg=d := by simp [σ2,σ1,gauss,indexReg,d]
    have el : σ2.vars strideReg=maxLength n := by simpa [σ2,σ1,gauss,strideReg] using h.stride
    apply evalB_bin
    · apply evalB_bin
      · rw [←ei]; exact evalB_var (by rw [ei]; dsimp [d] at *; omega)
      · exact evalB_lit (by omega)
      · dsimp [d] at *; omega
    · rw [←el]; exact evalB_var (by rw [el]; omega)
    · exact hb
  have prepRun := (Run.assign (x:=gauss.N) eN).seq
    ((Run.assign (x:=gauss.c) ec).seq (Run.assign (x:=bankReg) eb))
  have hp:=prepared_input F (d:=d) h
  obtain ⟨ρ,hr,hs,hN,hflag,hiff,hcoord,hmem,hregs,hi,ho⟩ :=
    Problem18IMPIntertwinerTrialBank20261001.bank_trial_run F gauss gauss_valid flagReg scanReg bankReg
      (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) hp.slots
      (fun j:Fin d=>orbit S z j.val) (orbit S z d)
      (by simp [prepared,gauss,bankReg])
      hp.dimension (by simp [prepared,gauss,bankReg])
      (by simpa [prepared,bankReg] using hfit.1)
      (by simp [prepared,bankReg]; exact hL.trans hfit.2)
      (by simpa [prepared,bankReg] using (hp.banks d hd).1)
      (by simpa [prepared,bankReg] using (hp.banks d hd).2.1)
      (by simpa [prepared,bankReg] using (hp.banks d hd).2.2)
  have hv (s : Nat) (hs' : s<Sn) (hge : maxLength n ≤ s) :
      val F canonical gauss.WS ρ s=val F canonical gauss.WS σ s := by
    rw [hmem s hs' (hL.trans hge)]
    simp [prepared,val_setVar,gauss,bankReg]
  have hdim : ρ.vars gauss.n=σ.vars gauss.n := by
    rw [hregs _ (by decide) (by decide) (by decide) (by decide) (by decide)]
    simp [prepared,gauss,bankReg]
  have hstride : ρ.vars strideReg=σ.vars strideReg := by
    rw [hregs _ (by decide) (by decide) (by decide) (by decide) (by decide)]
    simp [prepared,gauss,bankReg,strideReg]
  have hidx : ρ.vars indexReg=d := by
    rw [hregs _ (by decide) (by decide) (by decide) (by decide) (by decide)]
    simp [prepared,gauss,bankReg,indexReg,d]
  have hin:=input_transport F h hs hdim hstride hv
  have einc : (Expr.add (.var indexReg) (.lit 1)).evalB B ρ=some (d+1) := by
    apply evalB_bin
    · rw [←hidx]; exact evalB_var (by rw [hidx]; dsimp [d] at *; omega)
    · exact evalB_lit (by omega)
    · dsimp [d] at *; omega
  have hall:=(Run.assign (x:=gauss.N) eN).seq
    ((Run.assign (x:=gauss.c) ec).seq
      ((Run.assign (x:=bankReg) eb).seq (hr.seq (Run.assign (x:=indexReg) einc))))
  refine ⟨ρ.setVar indexReg (d+1),?_,input_setVar F hin indexReg _ (by decide) (by decide) (by decide) (by decide),?_,?_,?_,?_,?_,hi,ho⟩
  · exact hall.mono (by have hh:=trial_cost_le F n d hd; simp only [Expr.size]; omega)
  · simp [d]
  · simpa [indexReg,flagReg] using hflag
  · simpa [d,indexReg,flagReg] using hiff.trans (dependence_iff S z d).symm
  · intro j; simpa [d,val_setVar,gauss,indexReg,coefficients] using hcoord j
  · intro s hs' hge; simpa [val_setVar,gauss,indexReg] using hv s hs' hge
theorem least_degree_unique {n d : Nat} (S : Module.End K (Fin n→K)) (z : Fin n→K)
    (hd : dependence S z d=true) (hbefore : ∀j<d,dependence S z j≠true) :
    d=(firstDegree S z).val := by
  have hf:=firstDegree_spec S z
  by_contra he
  rcases lt_or_gt_of_ne he with hlt|hgt
  · exact hf.2 d hlt hd
  · exact hbefore _ hgt hf.1
structure Invariant {n : Nat} (S : Module.End K (Fin n→K)) (z : Fin n→K)
    (Sn B : Nat) (σ τ : Env) : Prop where
  input : Input F S z Sn B τ
  index_le : τ.vars indexReg ≤ n+1
  flag_le : τ.vars flagReg ≤ 1
  waiting : τ.vars flagReg=1→∀j<τ.vars indexReg,dependence S z j≠true
  success : τ.vars flagReg=0→∃d ≤ n,τ.vars indexReg=d+1 ∧ d=(firstDegree S z).val ∧
    ∀j:Fin d,val F canonical gauss.WS τ (5+(n+j.val))=-coefficients S z d j
  memory : ∀s<Sn,maxLength n ≤ s→val F canonical gauss.WS τ s=val F canonical gauss.WS σ s
  input_tape : τ.inp=σ.inp
  output_tape : τ.out=σ.out
def initialized (σ : Env) := (σ.setVar indexReg 0).setVar flagReg 1
theorem initialized_invariant {n Sn B : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ : Env} (h : Input F S z Sn B σ) : Invariant F S z Sn B σ (initialized σ) := by
  have h1:=input_setVar F h indexReg 0 (by decide) (by decide) (by decide) (by decide)
  have h2:=input_setVar F h1 flagReg 1 (by decide) (by decide) (by decide) (by decide)
  refine ⟨h2,?_,?_,?_,?_,?_,rfl,rfl⟩
  · simp [initialized,indexReg,flagReg]
  · simp [initialized]
  · intro _ j hj
    simp [initialized,indexReg,flagReg] at hj
  · intro hh; simp [initialized] at hh
  · intro s hs hl; simp [initialized,val_setVar,gauss,indexReg,flagReg]
theorem active_index_le {n Sn B : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ τ : Env} (h : Invariant F S z Sn B σ τ) (hf : τ.vars flagReg=1) : τ.vars indexReg ≤ n := by
  obtain ⟨d,hd⟩:=exists_dependence S z
  by_contra hn
  have hlt : d.val<τ.vars indexReg := by have hh:=d.isLt; omega
  exact h.waiting hf d.val hlt hd
theorem iteration_run {n Sn B : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ τ : Env} (h : Invariant F S z Sn B σ τ) (hf : τ.vars flagReg=1) :
    ∃ρ,Run B body τ ρ (bodyBudget F n) ∧ Invariant F S z Sn B σ ρ ∧
      ρ.vars indexReg=τ.vars indexReg+1 := by
  have hd:=active_index_le F h hf
  obtain ⟨ρ,hr,hin,hidx,hflag,hiff,hcoord,hmem,hi,ho⟩:=body_run F h.input hd
  refine ⟨ρ,hr,?_,hidx⟩
  refine ⟨hin,by omega,hflag,?_,?_,?_,hi.trans h.input_tape,ho.trans h.output_tape⟩
  · intro hfρ j hj
    rw [hidx] at hj
    by_cases he:j=τ.vars indexReg
    · subst j
      intro hh
      have hz:=hiff.mpr hh
      omega
    · exact h.waiting hf j (by omega)
  · intro hz
    exact ⟨τ.vars indexReg,hd,hidx,
      least_degree_unique S z (hiff.mp hz) (h.waiting hf),hcoord⟩
  · intro s hs hl; exact (hmem s hs hl).trans (h.memory s hs hl)
theorem routine_run {n Sn B : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ : Env} (h : Input F S z Sn B σ) :
    ∃τ,Run B routine σ τ (scanBudget F n) ∧ Slots F canonical gauss.WS Sn B τ ∧
      τ.vars answerReg=(firstDegree S z).val ∧
      (∀j:Fin (firstDegree S z).val,val F canonical gauss.WS τ (5+(n+j.val))=
        -coefficients S z (firstDegree S z).val j) ∧
      (∀s<Sn,maxLength n ≤ s→val F canonical gauss.WS τ s=val F canonical gauss.WS σ s) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  let I:=Invariant F S z Sn B σ
  let V:=fun τ:Env=>n+1-τ.vars indexReg
  have hB : 1<B := by have hh:=(word_bounds F h).1; omega
  have hdef : ∀τ,I τ→∃v,(Cond.eq (.var flagReg) (.lit 1)).evalB B τ=some v := by
    intro τ ht
    exact ⟨_,evalB_condEq (evalB_var (show τ.vars flagReg<B by have hh:=ht.flag_le; omega)) (evalB_lit hB)⟩
  have hstep : ∀τ,I τ→(Cond.eq (.var flagReg) (.lit 1)).evalB B τ=some true→
      ∃ρ,Run B body τ ρ (bodyBudget F n) ∧ I ρ ∧ V ρ<V τ := by
    intro τ ht he
    have hc:=evalB_condEq (evalB_var (show τ.vars flagReg<B by have hh:=ht.flag_le; omega)) (evalB_lit hB)
    rw [he] at hc
    have hf : τ.vars flagReg=1 := by simpa using hc.symm
    have hd:=active_index_le F ht hf
    obtain ⟨ρ,hr,hρ,hidx⟩:=iteration_run F ht hf
    exact ⟨ρ,hr,hρ,by dsimp [V]; rw [hidx]; omega⟩
  obtain ⟨ρ,hr,hρ,hfalse⟩:=Run.while_count I V (bodyBudget F n) hdef hstep (initialized_invariant F h)
  have hc:=evalB_condEq (evalB_var (show ρ.vars flagReg<B by have hh:=hρ.flag_le; omega)) (evalB_lit hB)
  rw [hfalse] at hc
  have hf : ρ.vars flagReg≠1 := by simpa using hc.symm
  have hz : ρ.vars flagReg=0 := by have hh:=hρ.flag_le; omega
  obtain ⟨d,hd,hidx,he,hcoeff⟩:=hρ.success hz
  subst d
  have hword:=(word_bounds F h).1
  have ea0 : (Expr.bin .sub (.var indexReg) (.lit 1)).evalB B ρ=some (ρ.vars indexReg-1) := by
    apply evalB_bin
    · exact evalB_var (by have hh:=hρ.index_le; omega)
    · exact evalB_lit hB
    · change ρ.vars indexReg-1<B
      have hh:=hρ.index_le
      omega
  have ea : (Expr.bin .sub (.var indexReg) (.lit 1)).evalB B ρ=some (firstDegree S z).val := by
    simpa only [hidx,Nat.add_sub_cancel] using ea0
  have h0:=Run.assign (x:=indexReg) (σ:=σ) (evalB_lit (by omega : 0<B))
  have h1:=Run.assign (x:=flagReg) (σ:=σ.setVar indexReg 0) (evalB_lit hB)
  have ha:=Run.assign (x:=answerReg) ea
  have hall:=h0.seq (h1.seq (hr.seq ha))
  refine ⟨ρ.setVar answerReg (firstDegree S z).val,hall.mono ?_,?_,by simp,?_,?_,hρ.input_tape,hρ.output_tape⟩
  · simp [scanBudget,V,initialized,flagReg,indexReg,Cond.size,Expr.size]
    nlinarith
  · exact Slots.setVar F canonical hρ.input.slots (by decide) (by decide) _
  · intro j; simpa [val_setVar,gauss,answerReg] using hcoeff j
  · intro s hs hl; simpa [val_setVar,gauss,answerReg] using hρ.memory s hs hl
end
