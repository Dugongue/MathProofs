variable {K : Type} [Field K] [Fintype K] [DecidableEq K]
theorem boundaryLane_run_cost (F : FieldPresentation K)
    {B a b c : Nat} {u : Bool} {q : Nat} {A : RectTensor a b c K}
    (sigma : Env) (h : BoundaryInput F B a b c u q A sigma) :
    ∃ xi t, t ≤ boundaryControllerCost F q a b c ∧ Run B boundaryLane sigma xi (t+2) ∧
      xi.out = sigma.out ++
        [if Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck
          (Problem18IMPBoundaryDispatchAdapter20261002.boundaryGram u q
            (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
              (sortOrder a b c) A h.first)) then 1 else 0] ∧
      xi.inp = sigma.inp := by
  obtain ⟨tau,t,ht,hr,hresult,hbit,hbound,hin,hout⟩ :=
    Mathproof.Problem18P36BoundaryRoutedController20261003.boundaryController_run_cost F sigma h
  let decision := Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck
    (Problem18IMPBoundaryDispatchAdapter20261002.boundaryGram u q
      (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
        (sortOrder a b c) A h.first))
  have hvalue : tau.vars Problem18P36BoundaryDecision20261002.resultReg =
      (if decision then 1 else 0) := by
    rcases hbit with hzero | hone
    · have hd : decision = false := by
        cases hdec : decision with
        | false => rfl
        | true =>
            have := hresult.mpr hdec
            omega
      rw [hd, hzero]
      rfl
    · have hd : decision = true := hresult.mp hone
      rw [hd, hone]
      rfl
  let xi : Env := {tau with
    out := tau.out ++ [tau.vars Problem18P36BoundaryDecision20261002.resultReg]}
  have hw : Run B (.write (.var Problem18P36BoundaryDecision20261002.resultReg))
      tau xi 2 := Run.write (evalB_var hbound)
  refine ⟨xi,t,ht,?_,?_,?_⟩
  · simpa [boundaryLane] using hr.seq hw
  · simp only [xi,hout,hvalue]
    rfl
