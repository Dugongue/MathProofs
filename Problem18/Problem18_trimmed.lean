  have hcount : (Expr.var r.i).evalB B (iterCopied r modArray σ)=some (σ.vars r.i) := by
    simpa only [hci] using evalB_var (σ:=iterCopied r modArray σ) (x:=r.i) (by rw [hci]; omega)
  have hinc:=Run.assign (x:=r.i)
    (evalB_bin (op:=Bop.add) hcount (evalB_lit hone) (by change σ.vars r.i+1<B; omega))
  have hr:=hlead.seq (hk.seq (hmap.seq (hzero.seq (hcopy.seq hinc))))
  apply hr.mono
