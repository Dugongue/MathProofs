    rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hRw]; omega))] at hcw
    simp only [Option.some.injEq, decide_eq_false_iff_not, not_lt] at hcw
    rw [hRw] at hcw; omega
