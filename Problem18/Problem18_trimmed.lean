    intro x y
    apply Prod.ext
    · ext i c
      generalize hd : finSumFinEquiv.symm c = d
      cases d <;>
        simp [anchorMatrixMap, anchorLeftMatrix, leftTestVector, hd,
          map_add, mul_add]
    · ext i c
      generalize hd : finSumFinEquiv.symm c = d
      cases d <;>
        simp [anchorMatrixMap, anchorRightMatrix, rightTestVector, hd, map_add]
  map_smul' := by
    intro a x
    apply Prod.ext
    · ext i c
      generalize hd : finSumFinEquiv.symm c = d
      cases d <;>
        simp [anchorMatrixMap, anchorLeftMatrix, leftTestVector, hd, map_smul,
          mul_assoc, mul_left_comm, mul_comm]
    · ext i c
      generalize hd : finSumFinEquiv.symm c = d
      cases d <;>
        simp [anchorMatrixMap, anchorRightMatrix, rightTestVector, hd, map_smul,
          mul_assoc, mul_left_comm, mul_comm]
@[simp] theorem anchorMatrixLinearMap_apply
    (B : LinearMap.BilinForm K V) (eps : K)
    {k z m : ℕ} (E : (Fin (k + z) → K) →ₗ[K] V)
    (u : Fin m → V × V) :
    anchorMatrixLinearMap B eps E u = anchorMatrixMap B eps E u := rfl
theorem anchorMatrixMap_crossZero_card_mul
    [FiniteDimensional K V] [Fintype K] [Fintype V]
    (B : LinearMap.BilinForm K V) (hB : B.Nondegenerate)
    (eps : K) (heps : eps ^ 2 = 1)
    {k z m : ℕ} (E : (Fin (k + z) → K) →ₗ[K] V)
    (hE : Function.Injective E) :
    Nat.card {u : Fin m → V × V //
        ∀ i, (anchorMatrixMap B eps E u).1.mulVec
          ((anchorMatrixMap B eps E u).2 i) = 0} *
      Nat.card
        (Matrix (Fin k) (Fin (m + m)) K ×
          Matrix (Fin z) (Fin (m + m)) K) =
      Nat.card (CrossZeroPairs (K := K) k (m + m) z) *
        Nat.card (Fin m → V × V) := by
  let f := anchorMatrixLinearMap (m := m) B eps E
  have hf : Function.Surjective f := by
    change Function.Surjective (anchorMatrixMap (m := m) B eps E)
    exact anchorMatrixMap_surjective B hB eps heps E hE
  exact Mathproof.Problem18AnchorCoordinates20260930.surjective_preimage_card_mul
    f hf (fun P => ∀ i, P.1.mulVec (P.2 i) = 0)
