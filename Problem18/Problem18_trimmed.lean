variable [DecidableEq K]
theorem clauseRows_run {c0 m : ℕ} (M : FieldMacros F r) (q : RNames) (ci : String)
    (hciS : ci ∉ regNames r) (hciW : ci ≠ q.WS) (X T O : Expr) (l : List String)
    (hl : ∀ x ∈ l, x ∉ regNames r ∧ x ≠ ci) (hXp : VarsIn l X) (hTp : VarsIn l T)
    (hOp : VarsIn l O) (cl : Clause (Fin (c0 + m)) ℤ) (a : Fin c0 → K)
    {B Sn xv tv ov D : ℕ} {σ : Env} (hxt : xv + c0 ≤ tv) (hto : tv + D ≤ ov)
    (hS : Slots F r q.WS Sn B σ) (hX : X.evalB B σ = some xv) (hT : T.evalB B σ = some tv)
    (hO : O.evalB B σ = some ov)
    (hfit : ov + (sysExprs cl).length * (boundedExponents (m + 1) (clauseDeg cl)).length ≤ Sn)
    (hb : ∀ p ∈ sysExprs cl, ∀ e ∈ rowExprs p (clauseDeg cl), polyDepth e ≤ D ∧ constBound e < B)
    (ha : ∀ i : Fin c0, val F r q.WS σ (xv + i.val) = a i) :
    ∃ τ, Run B (clauseLoadCom M q ci X T O (boundedExponents (m + 1) (clauseDeg cl)).length
          (clauseDeg cl) (sysExprs cl) 0) σ τ
        (clauseLoadCost M X T O (boundedExponents (m + 1) (clauseDeg cl)).length (clauseDeg cl)
          (sysExprs cl) 0) ∧
      Slots F r q.WS Sn B τ ∧
      (∀ u (hu : u < (clauseRows cl a).length)
        (j : Fin (boundedExponents (m + 1) (clauseDeg cl)).length),
        val F r q.WS τ (ov + u * (boundedExponents (m + 1) (clauseDeg cl)).length + j.val) =
          read ((clauseRows cl a)[u]'hu).1 j) ∧
      (∀ s < Sn, (s < tv ∨ tv + D ≤ s) →
        (s < ov ∨ ov + (sysExprs cl).length * (boundedExponents (m + 1) (clauseDeg cl)).length ≤ s) →
        val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ≠ ci → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  obtain ⟨τ, hr, hS', hv, hf, hx, har, hi, ho⟩ :=
    clauseLoad_run M q ci hciS hciW X T O l hl hXp hTp hOp (clauseDeg cl) _ rfl hxt hto
      (sysExprs cl) 0 σ hS hX hT hO (by simpa using hfit) hb
  have hdata : (fun i : Fin c0 => val F r q.WS σ (xv + i.val)) = a := funext ha
  refine ⟨τ, hr, hS', ?_, ?_, hx, har, hi, ho⟩
  · intro u hu j
    have hu' : u < (sysExprs cl).length := by simpa [clauseRows] using hu
    have := hv u hu' j
    rw [Nat.zero_add, hdata] at this
    rw [this]
    simp [clauseRows, List.getElem_map]
  · intro s hs h1 h2
    exact hf s hs h1 (by simpa using h2)
end Mathproof.Problem18ClaudeIMPClauseLoad20261001
end
