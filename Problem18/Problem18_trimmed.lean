          (hcond.trans (by rw [hb']))
          (Run.store haddr (evalB_lit (σ:=ρ) (B:=B) (n:=1) hB1) hidx)
        have hu : unitDigit e j = 1 := by simp [unitDigit, hz]
        simpa [ρ1, hu, digitIsZero, Cond.size, Expr.size] using this.mono (by simp [digitIsZero])
      · have hb' : (j % e == 0) = false := by simp [hz]
        have := Run.ite_false (c:=(.store canonical.mem (.bin .add (.var fbase) (.var fj)) (.lit 1)))
          (d:=(.store canonical.mem (.bin .add (.var fbase) (.var fj)) (.lit 0)))
          (hcond.trans (by rw [hb']))
          (Run.store haddr (evalB_lit (σ:=ρ) (B:=B) (n:=0) (by omega)) hidx)
        have hu : unitDigit e j = 0 := by simp [unitDigit, hz]
        simpa [ρ1, hu, digitIsZero, Cond.size, Expr.size] using this.mono (by simp [digitIsZero])
    have hinc : (Expr.bin .add (.var fj) (.lit 1)).evalB B ρ1 = some (j + 1) := by
      have := evalB_bin (op:=.add) (evalB_var (σ:=ρ1) (x:=fj) (B:=B) (by simp [ρ1, hjeq]; omega))
        (evalB_lit (σ:=ρ1) (B:=B) (n:=1) hB1) (by simp [Bop.apply, ρ1, hjeq]; omega)
      simpa [Bop.apply, ρ1, hjeq] using this
    refine ⟨ρ1.setVar fj (j+1), (hr1.seq (Run.assign (x:=fj) hinc)).mono (by simp), ?_, ?_⟩
    · refine ⟨by simp; omega, (vsn (by decide)).trans hcnt, (vsn (by decide)).trans hbase,
        (vsn (by decide)).trans hee, by simp [ρ1, hlen], ?_, ?_, ?_⟩
      · intro a ha; simp [ρ1, ha, harr a ha]
      · intro k hk
