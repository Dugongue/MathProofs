theorem rebuild_bound (F : FieldPresentation K) (n d R M c : Nat) :
    Problem18RecursiveBankRebuild20261002.cost F n d R M c ≤
      rebuildCoefficient n d R c*scale F M := by
  obtain ⟨h1,hM,he,hw⟩:=scale_bounds F M
  have hl:=loader_bound F n d c (scale F M) he hw h1
