def strides (o : Order) (a b e : Nat) : Nat × Nat × Nat :=
  match o with
  | .abc => (a*b*e,b*e,e)
  | .acb => (e,b*e,a*b*e)
  | .bac => (a*b*e,e,b*e)
  | .bca => (b*e,e,a*b*e)
  | .cab => (e,a*b*e,b*e)
  | .cba => (b*e,a*b*e,e)
def parameters (base : Nat) (o : Order) (a b c e : Nat) : Parameters :=
  let s:=shape o a b c
