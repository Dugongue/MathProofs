def AltMat (n : ℕ) (K : Type u) [Field K] := {U : Matrix (Fin n) (Fin n) K // IsAlt U}
def altOfFun (f : {p : Fin n × Fin n // p.1 < p.2} → K) : Matrix (Fin n) (Fin n) K :=
