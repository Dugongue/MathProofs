variable {N : Nat} {K L : Type*} [Field K] [Fintype K] [Field L] [Algebra K L]
  [Algebra.IsAlgebraic K L]
theorem coefficientAutomorphism_X_sub_C (g : L ≃ₐ[K] L) (i : Fin N) (a : L) :
    coefficientAutomorphism (N := N) g (X i - C a) = X i - C (g a) := by
  simp [coefficientAutomorphism]
theorem rationalPointKernel_eq_vanishingIdeal (x : Fin N → K) :
    rationalPointKernel (L := L) x = vanishingIdeal L {fun i => algebraMap K L (x i)} := by
  ext p
  rw [mem_vanishingIdeal_singleton_iff]
  exact Iff.rfl
theorem pow_card_fixed_mem_range (x : L) (hx : x ^ Fintype.card K = x) :
    ∃ c : K, algebraMap K L c = x := by
  classical
  have hq1 : 1 < Fintype.card K := Fintype.one_lt_card
  let f : Polynomial L := Polynomial.X ^ Fintype.card K - Polynomial.X
  have hf0 : f ≠ 0 := FiniteField.X_pow_card_sub_X_ne_zero L hq1
  have hdeg : f.natDegree = Fintype.card K := FiniteField.X_pow_card_sub_X_natDegree_eq L hq1
  let S : Finset L := (Finset.univ : Finset K).image (algebraMap K L)
  have hS : S.card = Fintype.card K := by
    rw [Finset.card_image_of_injective _ (algebraMap K L).injective, Finset.card_univ]
  have hsub : S ⊆ f.roots.toFinset := by
    intro y hy
    obtain ⟨c, -, rfl⟩ := Finset.mem_image.mp hy
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hf0]
    simp [f, Polynomial.IsRoot, ← map_pow, FiniteField.pow_card]
  have hcard : f.roots.toFinset.card ≤ Fintype.card K := by
    calc f.roots.toFinset.card ≤ f.roots.card := Multiset.toFinset_card_le _
      _ ≤ f.natDegree := Polynomial.card_roots' f
      _ = Fintype.card K := hdeg
  have heq : S = f.roots.toFinset :=
    Finset.eq_of_subset_of_card_le hsub (by rw [hS]; exact hcard)
  have hx' : x ∈ f.roots.toFinset := by
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hf0]
    simp [f, Polynomial.IsRoot, hx]
  rw [← heq] at hx'
  obtain ⟨c, -, hc⟩ := Finset.mem_image.mp hx'
  exact ⟨c, hc⟩
theorem fixed_maximal_is_rational [IsAlgClosed L] (P : Ideal (MvPolynomial (Fin N) L))
    (hP : P.IsMaximal)
    (hfix : P.comap (coefficientAutomorphism (FiniteField.frobeniusAlgEquivOfAlgebraic K L)) = P) :
    ∃ x : Fin N → K, P = rationalPointKernel x := by
  obtain ⟨a, rfl⟩ := isMaximal_iff_eq_vanishingIdeal_singleton.mp hP
  set g := FiniteField.frobeniusAlgEquivOfAlgebraic K L with hg
  have hfixa : ∀ i, a i ^ Fintype.card K = a i := by
    intro i
    have hmem : X i - C (a i) ∈ vanishingIdeal L {a} := by
      rw [mem_vanishingIdeal_singleton_iff]
      simp
    have h2 : X i - C (a i) ∈ (vanishingIdeal L {a}).comap (coefficientAutomorphism g) := by
      rw [hfix]
      exact hmem
    rw [Ideal.mem_comap, coefficientAutomorphism_X_sub_C, mem_vanishingIdeal_singleton_iff] at h2
    simp only [map_sub, aeval_X, aeval_C, Algebra.algebraMap_self_apply, sub_eq_zero] at h2
    exact (h2.symm : g (a i) = a i)
  choose x hx using fun i => pow_card_fixed_mem_range (K := K) (a i) (hfixa i)
  refine ⟨x, ?_⟩
  rw [rationalPointKernel_eq_vanishingIdeal]
  congr 2
  funext i
  exact (hx i).symm
theorem fixed_zero_dim_component_rational_point [IsAlgClosed L]
    (F : Set (MvPolynomial (Fin N) K)) (P : Ideal (MvPolynomial (Fin N) L))
    (hP : P ∈ (geometricIdeal (L := L) F).minimalPrimes) (hmax : P.IsMaximal)
    (hfix : P.comap (coefficientAutomorphism (FiniteField.frobeniusAlgEquivOfAlgebraic K L)) = P) :
    ∃ x : Fin N → K, ∀ f ∈ F, eval x f = 0 := by
  obtain ⟨x, rfl⟩ := fixed_maximal_is_rational P hmax hfix
  exact ⟨x, (geometricIdeal_le_rationalPointKernel_iff (L := L) F x).mp hP.1.2⟩
end Mathproof.Problem18ZeroDimFixedComponent20261001
