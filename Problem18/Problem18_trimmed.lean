variable {K : Type*} [Field K]
abbrev FixedConstant (n : ℕ) (c : K) := {f : MonicDegree (K:=K) n // f.val.coeff 0=c}
theorem monicCoefficients_zero (n : ℕ) (f : MonicDegree (K:=K) (n+1)) :
    FiniteFieldOrthogonalUnitaryTI.monicCoefficients (n+1) f 0=f.val.coeff 0 := by
  change f.val.eraseLead.coeff 0=f.val.coeff 0
  simp [eraseLead_coeff,f.property.2]
noncomputable def fixedConstantEquiv (n : ℕ) (c : K) :
    FixedConstant (K:=K) (n+1) c ≃ (Fin n → K) := by
  let e : FixedConstant (K:=K) (n+1) c ≃ {v : Fin (n+1) → K // v 0=c} :=
    (FiniteFieldOrthogonalUnitaryTI.monicCoefficients (K:=K) (n+1)).subtypeEquiv
      (fun f => by rw [monicCoefficients_zero])
  let t : {v : Fin (n+1) → K // v 0=c} ≃ (Fin n → K) :=
    { toFun := fun v => Fin.tail v.val
      invFun := fun v => ⟨Fin.cons c v,by simp⟩
      left_inv := by
        intro v
        apply Subtype.ext
        change Fin.cons c (Fin.tail v.val)=v.val
        simpa only [v.property] using Fin.cons_self_tail v.val
      right_inv := by intro v; rfl }
  exact e.trans t
theorem fixedConstant_card [Finite K] (n : ℕ) (c : K) :
    Nat.card (FixedConstant (K:=K) (n+1) c)=Nat.card K^n := by
  rw [Nat.card_congr (fixedConstantEquiv n c),Nat.card_fun,Nat.card_fin]
noncomputable def fixedConstantDivisorEquiv {n : ℕ} (g : K[X]) (hg : g.Monic)
    (hgn : g.natDegree≤n) (hg0 : g.coeff 0≠0) (c : K) :
    {f : {f : MonicDegree (K:=K) n // g ∣ f.val} // f.val.val.coeff 0=c} ≃
      FixedConstant (K:=K) (n-g.natDegree) (c/g.coeff 0) := by
  apply (monicDivisibleEquiv g hg hgn).subtypeEquiv
  intro f
  have he := modByMonic_add_div f.val.val g
  rw [(modByMonic_eq_zero_iff_dvd hg).mpr f.property,zero_add] at he
  have hc := congrArg (fun p : K[X] => p.coeff 0) he
  rw [mul_coeff_zero] at hc
  change f.val.val.coeff 0=c ↔ (f.val.val /ₘ g).coeff 0=c/g.coeff 0
  rw [eq_div_iff hg0,← hc]
  constructor <;> intro hh <;> simpa only [mul_comm] using hh
theorem fixedConstant_divisor_card [Finite K] {n : ℕ} (g : K[X]) (hg : g.Monic)
    (hgn : g.natDegree<n) (hg0 : g.coeff 0≠0) (c : K) :
    Nat.card {f : {f : MonicDegree (K:=K) n // g ∣ f.val} // f.val.val.coeff 0=c}=
      Nat.card K^(n-g.natDegree-1) := by
  rw [Nat.card_congr (fixedConstantDivisorEquiv g hg hgn.le hg0 c)]
  have he : n-g.natDegree=(n-g.natDegree-1)+1 := by omega
  rw [he,fixedConstant_card]
  simp only [Nat.add_sub_cancel]
end Mathproof.Problem18FixedConstantMonic20260930
