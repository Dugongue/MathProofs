def query (n d count reserve : Nat) :=
  source n d count reserve+certificateRows n d count*lenL n d (eliminantShift n d)
def coefficients (n d count reserve : Nat) := query n d count reserve+lenL n d (eliminantShift n d)
def residueBase (n d count reserve : Nat) := coefficients n d count reserve+certificateRows n d count+5
def rowLength (n d : Nat) := (boundedExponents n (frobeniusDegree n d)).length
def temp1 (n d count reserve : Nat) := residueBase n d count reserve+6*eliminantDegree n d
def temp2 (n d count reserve : Nat) := temp1 n d count reserve+1
def system (n d count reserve : Nat) := temp2 n d count reserve+1
def output (n d count reserve i : Nat) := system n d count reserve+(count+i)*rowLength n d
def original (n d count reserve : Nat) := system n d count reserve+(count+n)*rowLength n d
def slots (n d count reserve : Nat) := original n d count reserve+count*lenD n d+1
theorem certificate_order (n d count reserve : Nat) :
    rowStart (lenL n d (eliminantShift n d)+certificateRows n d count)
      (certificateRows n d count) ≤ source n d count reserve ∧
