def budget (n : ℕ) : ℕ := seedCost q sizeReg seedT F.e (n*n)+2+
  4200*Problem18IMPConcreteEliminationBounds20261001.macroBudget F*(n*n+1)^3
theorem initialize_run {B Sn n m : ℕ} {σ : Env} (h : Ready F B Sn σ)
    (hn : σ.vars sizeReg=n) (hm : σ.vars generatorCount=m)
    (S : Fin m→Matrix (Fin n) (Fin n) K)
    (hg : ∀i:Fin m,slotMatrix F q.WS σ (σ.vars generatorBase+i.val*(n*n)) n=S i) :
    ∃τ,Run B program σ τ (budget F n) ∧ Ready F B Sn τ ∧
      τ.vars basisCount=(basisTable S 0).length ∧
      basisTable S 0=chosenOf (val F canonical q.WS τ) (n*n) (τ.vars basisCount) ∧
      τ.vars sizeReg=n ∧ τ.vars generatorCount=m ∧
      (∀i:Fin m,slotMatrix F q.WS τ (τ.vars generatorBase+i.val*(n*n)) n=S i) ∧
      val F canonical q.WS τ 0=0 ∧ τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hN:σ.vars q.N=n*n:=by rw [h.dim,hn]
  have hcap:inStart (n*n) (n*n*(m+1)) ≤ σ.vars generatorBase:=by
    simpa only [hN,hm] using h.candidates_before
  have hseedbefore:inStart (n*n) 1 ≤ σ.vars generatorBase:=by
    by_cases h0:n*n=0
    · simpa only [h0,Nat.zero_mul,inStart,Nat.mul_zero,Nat.add_zero] using hcap
    · exact (inStart_mono (show 1 ≤ n*n*(m+1) from Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero h0 (Nat.succ_ne_zero m)))).trans hcap
  have hr:=h.right_before; have ho:=h.output_before; have hf:=h.fit
  have hgb:=h.generators_before
  have hB:1 < B:=by have hs:=h.slots.slots_word; omega
  obtain ⟨ξ,hseed,hξ,hzero,hidentity,hkeep,hregs,harr,hin,hout⟩:=
    seed_run_sizeReg (F:=F) q (by decide) (by decide) h.slots hN hn (by omega)
  let ζ:=ξ.setVar cn.R 1
  have hζ:Slots F canonical q.WS Sn B ζ:=Slots.setVar F canonical hξ (by decide) (by decide) _
  have hNξ:ξ.vars q.N=n*n:=(hregs _ (by decide) (by decide)).trans hN
  have hζN:ζ.vars q.N=n*n:=by simpa [ζ,cn,q] using hNξ
  have hζzero:val F canonical q.WS ζ 0=0:=by
    rw [val_setVar F canonical (show cn.R≠q.WS by decide)]; exact hzero
  obtain ⟨τ,hred,hτ,hrank,hbasis,hmem,hfix,harrays,hi,ho'⟩:=
    compress_run_concrete F q q_valid cn (by constructor <;> decide) hζ
      ([pack (1:Matrix (Fin n) (Fin n) K)]) hζN (by simp [ζ]) (by simpa using (show inStart (n*n) 1 ≤ Sn by omega))
      hζzero (by simpa using hB) (by
        intro t ht k
        have ht0:t=0:=by simp only [List.length_cons,List.length_nil] at ht; omega
        subst t
        obtain ⟨⟨i,j⟩,rfl⟩:=finProdFinEquiv.surjective k
        rw [val_setVar F canonical (show cn.R≠q.WS by decide)]
        simp only [List.getElem_cons_zero,read_pack]
        change val F canonical q.WS ξ (inStart (n*n) 0+(finProdFinEquiv (i,j)).val)=
          (1:Matrix (Fin n) (Fin n) K) (finProdFinEquiv.symm (finProdFinEquiv (i,j))).1
            (finProdFinEquiv.symm (finProdFinEquiv (i,j))).2
        rw [Equiv.symm_apply_apply]
        simpa [Matrix.one_apply,finProdFinEquiv,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm,Nat.mul_comm] using hidentity i j)
  have hall:=hseed.seq ((Run.assign (x:=cn.R) (evalB_lit hB)).seq hred)
  have hfixed : ∀x∈controls,x≠basisCount → τ.vars x=σ.vars x:=by
    intro x hx hxc
    exact (run_frame hall).1 x (by
      simp only [controls,List.mem_cons,List.not_mem_nil,or_false] at hx
      rcases hx with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;>
        first | contradiction | decide)
  have hNτ:τ.vars q.N=n*n:=(hfixed q.N (by simp [controls]) (by decide)).trans hN
  have hnτ:τ.vars sizeReg=n:=(hfixed sizeReg (by simp [controls]) (by decide)).trans hn
  have hmτ:τ.vars generatorCount=m:=(hfixed generatorCount (by simp [controls]) (by decide)).trans hm
  have hcc:τ.vars basisCount=(basisTable S 0).length:=by
    have hh:=congrArg List.length hbasis
    simpa only [chosenOf_length,basisTable,cn,basisCount] using hh.symm
  have hcle:τ.vars basisCount ≤ n*n:=by rw [hcc]; exact basisTable_length S 0
  have hready:Ready F B Sn τ:=by
    have hmod:=hfixed canonical.modBase (by simp [controls]) (by decide)
    have hws:=hfixed q.WS (by simp [controls]) (by decide)
    have hbase:=hfixed generatorBase (by simp [controls]) (by decide)
    have hright:=hfixed rightReg (by simp [controls]) (by decide)
    have hout:=hfixed outputReg (by simp [controls]) (by decide)
    have hwork:=hfixed scratchReg (by simp [controls]) (by decide)
    refine ⟨hτ,hmod.trans h.modulus,hws.trans h.workspace,
      ((run_frame hall).2.2.1 _).trans h.length,by rw [hNτ,hnτ],by simpa [hNτ] using hcle,
      by rw [hmτ]; simpa only [hm] using h.generators_word,?_,?_,?_,?_,?_⟩
    · simpa only [hNτ,hmτ,hbase,hN,hm] using h.candidates_before
    · simpa only [hbase,hmτ,hNτ,hright,hN,hm] using h.generators_before
    · simpa only [hright,hNτ,hout,hN] using h.right_before
    · simpa only [hout,hNτ,hwork,hN] using h.output_before
    · simpa only [hwork] using h.fit
  refine ⟨τ,hall.mono ?_,hready,hcc,hbasis,hnτ,hmτ,?_,?_,hi.trans hin,ho'.trans hout⟩
  · have hh:=Problem18IMPConcreteEliminationBounds20261001.compress_cost F q cn (n*n) 1
    have hbound:compressCost (fieldMacros F) q cn (n*n) 1 ≤
        4200*Problem18IMPConcreteEliminationBounds20261001.macroBudget F*(n*n+1)^3:=by
      calc
        _ ≤ 2100*Problem18IMPConcreteEliminationBounds20261001.macroBudget F*(n*n+1)^3*(1+1):=hh
        _ = _ := by ring
    simp only [List.length_cons,List.length_nil,Expr.size,Nat.zero_add,budget]
    omega
  · intro i
    rw [hfixed generatorBase (by simp [controls]) (by decide),←hg i]
    ext a b
    change val F canonical q.WS τ (σ.vars generatorBase+i.val*(n*n)+a.val*n+b.val)=_
    have hab:=Problem18IMPMatrixMemory20261001.index_lt a b
    have hj:=Nat.mul_le_mul_right (n*n) (Nat.succ_le_of_lt i.isLt)
    rw [Nat.succ_mul] at hj
    have hgb':σ.vars generatorBase+m*(n*n) ≤ σ.vars rightReg:=by simpa only [hN,hm] using hgb
    have hs0:0 < inStart (n*n) 0:=by simp [inStart,rowStart]
    have hs1:=inStart_mono (N:=n*n) (show 0 ≤ 1 by omega)
    rw [hmem _ (by omega) (Or.inr (by omega)),val_setVar F canonical (show cn.R≠q.WS by decide)]
    exact hkeep _ (by omega) (by omega) (Or.inr (by omega))
  · rw [hmem 0 (by have hs:=h.slots.slots_word; omega) (Or.inl rfl)]
    exact hζzero
