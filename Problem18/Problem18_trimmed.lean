abbrev CleanupLabel := Sum Empty OutputAdapterLabel
abbrev CleanupAlphabet := Alphabet WrapperAlphabet
def liftCleanupStmt {N : Nat} :
    TM2.Stmt WrapperAlphabet CleanupLabel (WrapperState N) →
      TM2.Stmt CleanupAlphabet CleanupLabel (WrapperState N × Bool)
  | .push k f q => .push (.inl k) (fun s => f s.1) (liftCleanupStmt q)
  | .peek k f q => .peek (.inl k) (fun s a => (f s.1 a, s.2))
      (liftCleanupStmt q)
  | .pop k f q => .pop (.inl k) (fun s a => (f s.1 a, s.2))
      (liftCleanupStmt q)
  | .load f q => .load (fun s => (f s.1, s.2)) (liftCleanupStmt q)
  | .branch f a b => .branch (fun s => f s.1)
      (liftCleanupStmt a) (liftCleanupStmt b)
  | .goto f => .goto (fun s => f s.1)
  | .halt => .halt
def program {N : Nat} (label : CleanupLabel) :
    TM2.Stmt CleanupAlphabet CleanupLabel (WrapperState N × Bool) :=
  liftCleanupStmt
    ((liftCoreProgram (fun _ : Empty => .halt)
      (outputAdapterProgram (N := N) (L := Empty))) label)
def cfg {N : Nat}
    (c : TM2.Cfg WrapperAlphabet CleanupLabel (WrapperState N)) :
    TM2.Cfg CleanupAlphabet CleanupLabel (WrapperState N × Bool) :=
  ⟨c.l, (c.var, false), stackFn WrapperAlphabet c.stk [] []⟩
variable {N : Nat}
@[simp] theorem stepAux_liftCleanupStmt
    (q : TM2.Stmt WrapperAlphabet CleanupLabel (WrapperState N))
    (v : WrapperState N)
    (s : (k : WrapperStack) → List (WrapperAlphabet k)) :
    TM2.stepAux (liftCleanupStmt q) (v, false)
      (stackFn WrapperAlphabet s [] []) =
    cfg (TM2.stepAux q v s) := by
  induction q generalizing v s with
  | push k f q ih =>
      simp only [liftCleanupStmt, TM2.stepAux, stackFn_inl]
      rw [update_stackFn]
      exact ih _ _
  | peek k f q ih =>
      simpa only [liftCleanupStmt, TM2.stepAux, stackFn_inl] using
        ih (f v (s k).head?) s
  | pop k f q ih =>
      simp only [liftCleanupStmt, TM2.stepAux, stackFn_inl]
      rw [update_stackFn]
      exact ih _ _
  | load f q ih => simpa only [liftCleanupStmt, TM2.stepAux] using ih (f v) s
