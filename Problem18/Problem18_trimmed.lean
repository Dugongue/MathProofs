namespace Mathproof.Problem18P34Machine20261002Layout
open Lax13Proofs.Imp Lax13Proofs.Compile Lax13Proofs.Reasoning
open Problem18P34Machine20261002
structure Includes (L L' : Layout) : Prop where
  scalars : L.scalars ⊆ L'.scalars
  arrays : L.arrays ⊆ L'.arrays
  temps : L.temps ≤ L'.temps
def merge (L R : Layout) : Layout :=
  ⟨L.scalars++R.scalars,L.arrays++R.arrays,max L.temps R.temps⟩
theorem left (L R : Layout) : Includes L (merge L R) :=
  ⟨fun _ h=>List.mem_append_left _ h,fun _ h=>List.mem_append_left _ h,le_max_left _ _⟩
theorem right (L R : Layout) : Includes R (merge L R) :=
  ⟨fun _ h=>List.mem_append_right _ h,fun _ h=>List.mem_append_right _ h,le_max_right _ _⟩
theorem expr_mono {L R : Layout} (h : Includes L R) (e : Expr) (d : Nat)
    (he : Expr.Ok L e d) : Expr.Ok R e d := by
  induction e generalizing d with
  | lit n => trivial
  | var x => exact h.scalars he
  | get a i ih => exact ⟨h.arrays he.1,ih d he.2.1,he.2.2.trans_le h.temps⟩
  | bin op e f ie iff => exact ⟨iff d he.1,ie (d+1) he.2.1,he.2.2.trans_le h.temps⟩
theorem com_mono {L R : Layout} (h : Includes L R) (c : Com)
    (hc : Com.Ok L c) : Com.Ok R c := by
  induction c with
  | skip => trivial
  | assign x e => exact ⟨h.scalars hc.1,expr_mono h e 0 hc.2⟩
  | store a i e => exact ⟨h.arrays hc.1,expr_mono h i 0 hc.2.1,
      expr_mono h e 1 hc.2.2.1,hc.2.2.2.trans_le h.temps⟩
  | seq c d ic id => exact ⟨ic hc.1,id hc.2⟩
  | ite b c d ic id => exact ⟨expr_mono h (condExpr b) 0 hc.1,ic hc.2.1,id hc.2.2⟩
  | «while» b c ic => exact ⟨expr_mono h (condExpr b) 0 hc.1,ic hc.2⟩
  | read x => exact h.scalars hc
  | write e => exact ⟨expr_mono h e 0 hc.1,hc.2.trans_le h.temps⟩
def exprScalars : Expr → List String
  | .lit _ => []
  | .var x => [x]
  | .get _ i => exprScalars i
  | .bin _ e f => exprScalars e++exprScalars f
def exprArrays : Expr → List String
  | .lit _ => []
  | .var _ => []
  | .get a i => a::exprArrays i
  | .bin _ e f => exprArrays e++exprArrays f
theorem expr_ok (e : Expr) (L : Layout) (d : Nat)
    (hs : exprScalars e ⊆ L.scalars) (ha : exprArrays e ⊆ L.arrays)
    (hd : d+e.size ≤ L.temps) : Expr.Ok L e d := by
  induction e generalizing d with
  | lit n => trivial
  | var x => exact hs (by simp [exprScalars])
  | get a i ih =>
    simp only [exprScalars,exprArrays] at hs ha
    simp only [Expr.size] at hd
    exact ⟨ha (by simp),ih d hs (fun _ h=>ha (List.mem_cons_of_mem _ h)) (by omega),by omega⟩
  | bin op e f ie iff =>
    simp only [Expr.size] at hd
    refine ⟨iff d (fun _ h=>hs (List.mem_append_right _ h))
      (fun _ h=>ha (List.mem_append_right _ h)) (by omega),
      ie (d+1) (fun _ h=>hs (List.mem_append_left _ h))
      (fun _ h=>ha (List.mem_append_left _ h)) (by omega),by omega⟩
def exprLayout (e : Expr) (d : Nat) : Layout := ⟨exprScalars e,exprArrays e,d+e.size⟩
theorem exprLayout_ok (e : Expr) (d : Nat) : Expr.Ok (exprLayout e d) e d :=
  expr_ok e _ d (fun _ h=>h) (fun _ h=>h) le_rfl
def empty : Layout := ⟨[],[],1⟩
def scalar (x : String) : Layout := ⟨[x],[],1⟩
def array (x : String) : Layout := ⟨[],[x],1⟩
def layout : Com → Layout
  | .skip => empty
  | .assign x e => merge (scalar x) (exprLayout e 0)
  | .store a i e => merge (array a) (merge (exprLayout i 0) (exprLayout e 1))
  | .seq c d => merge (layout c) (layout d)
  | .ite b c d => merge (exprLayout (condExpr b) 0) (merge (layout c) (layout d))
  | .while b c => merge (exprLayout (condExpr b) 0) (layout c)
  | .read x => scalar x
  | .write e => merge empty (exprLayout e 0)
theorem layout_ok (c : Com) : Com.Ok (layout c) c := by
  induction c with
  | skip => trivial
  | assign x e =>
    exact ⟨by simp [layout,merge,scalar],expr_mono (right _ _) e 0 (exprLayout_ok e 0)⟩
  | store a i e =>
    refine ⟨by simp [layout,merge,array],?_,?_,?_⟩
    · exact expr_mono (right _ _) i 0 (expr_mono (left _ _) i 0 (exprLayout_ok i 0))
    · exact expr_mono (right _ _) e 1 (expr_mono (right _ _) e 1 (exprLayout_ok e 1))
    · simp [layout,merge,array]
  | seq c d ic id => exact ⟨com_mono (left _ _) c ic,com_mono (right _ _) d id⟩
  | ite b c d ic id =>
    exact ⟨expr_mono (left _ _) (condExpr b) 0 (exprLayout_ok _ 0),
      com_mono (right _ _) c (com_mono (left _ _) c ic),
      com_mono (right _ _) d (com_mono (right _ _) d id)⟩
  | «while» b c ic => exact ⟨expr_mono (left _ _) (condExpr b) 0 (exprLayout_ok _ 0),
      com_mono (right _ _) c ic⟩
  | read x => simp [layout,scalar,Com.Ok]
  | write e => exact ⟨expr_mono (right _ _) e 0 (exprLayout_ok e 0),by simp [layout,merge,empty]⟩
theorem finish_auto
    (producer : ∀cutoff,∃(c : Com)(P T : Polynomial Nat),Executes cutoff c P T) :
    Mathproof.Problem18P34Frozen20261002.P34 := by
  apply Problem18P34Machine20261002.finish
  intro cutoff
  obtain ⟨c,P,T,hr⟩:=producer cutoff
  exact ⟨layout c,c,P,T,layout_ok c,hr⟩
end Mathproof.Problem18P34Machine20261002Layout
end
