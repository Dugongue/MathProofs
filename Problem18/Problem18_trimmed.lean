variable {K : Type} [Field K] (F : FieldPresentation K)
def s1 (sigma : Env) (c : Nat) : Env := sigma.setVar count c
def s2 (sigma : Env) (c left : Nat) : Env := (s1 sigma c).setVar baseA left
def s3 (sigma : Env) (c left right : Nat) : Env :=
  (s2 sigma c left).setVar baseB right
def s4 (sigma : Env) (c left right stride : Nat) : Env :=
  (s3 sigma c left right).setVar strideA stride
def s5 (sigma : Env) (c left right stride : Nat) : Env :=
  (s4 sigma c left right stride).setVar strideB 0
def s6 (sigma : Env) (c left right stride scratch : Nat) : Env :=
  (s5 sigma c left right stride).setVar acc scratch
def s7 (sigma : Env) (c left right stride scratch prodAddr : Nat) : Env :=
  (s6 sigma c left right stride scratch).setVar prod prodAddr
def installed (sigma : Env) (c left right stride scratch prodAddr nextAddr : Nat) : Env :=
  (s7 sigma c left right stride scratch prodAddr).setVar next nextAddr
@[simp] theorem installed_count (sigma : Env)
    (c left right stride scratch prodAddr nextAddr : Nat) :
    (installed sigma c left right stride scratch prodAddr nextAddr).vars count = c := by
  simp [installed,s7,s6,s5,s4,s3,s2,s1,Env.setVar,
