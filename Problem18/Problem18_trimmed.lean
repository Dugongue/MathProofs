    (evalB_var (by have:=hτ.1;omega : tau.vars copyIndex<B))
    (evalB_var (by rw [hτ.2.1];exact hn : tau.vars copyCount<B))
  rw [hfalse,hτ.2.1] at ht
  have hi:tau.vars copyIndex=n:=by
    have hh:¬tau.vars copyIndex<n:=by simpa using ht.symm
