  have h₂ : (∀s t,(augmentedKernelEntry F e ker s t).eval x=0) ↔matrix F e*tests x ker=0 := by
    simp only [←entry]
    exact ⟨fun h=>by ext i j;exact h i j,fun h i j=>congrFun (congrFun h i) j⟩
