    ⟨hb.symm,by simpa [hb] using hbB⟩,rfl,hnB⟩
theorem initial_copy_evals {B a b c n gram base work : Nat} {sigma : Env}
    (h : RuntimeLayout F B a b c n gram base work sigma) :
    (Expr.var gramBase).evalB B sigma = some gram ∧
    (Expr.var poweredGramBase).evalB B sigma = some base ∧
    blockSize.evalB B sigma = some (blockWords F n) := by
  have hblock : blockSize.evalB B sigma = some (blockWords F n) := by
    have hn := exN_eval h.dimA_eq h.dimB_eq h.n_eq
      h.a_word h.b_word h.packed.n_word
    have he : (Expr.var canonical.e).evalB B sigma = some F.e := by
      have hh := evalB_var (B:=B) (x:=canonical.e) (σ:=sigma)
        (by rw [h.packed.valid.degree]; exact h.packed.valid.degree_word)
      simpa [h.packed.valid.degree] using hh
    have hsq : (Expr.mul exN exN).evalB B sigma = some (n*n) := by
      exact evalB_bin hn hn (by simpa only [Bop.apply] using h.packed.square_word)
    have hmul := evalB_bin (op:=Bop.mul) hsq he
      (show (n*n)*F.e < B by
        simpa [blockWords,Nat.mul_comm] using h.block_word)
    simpa [blockSize,blockWords,Nat.mul_comm] using hmul
  refine ⟨?_,?_,hblock⟩
  · simpa [evalB_var_iff,h.gram_eq] using h.gram_word
  · simpa [evalB_var_iff,h.base_eq] using h.base_word
private theorem power_address_eval {B a b c n gram base work k : Nat} {sigma : Env}
    (h : RuntimeLayout F B a b c n gram base work sigma)
    (hcursor : sigma.vars powerCursor = k) (hkc : k < c) :
    (powerAddress (.var powerCursor)).evalB B sigma =
      some (powerAt F base n k) := by
  have hblock := (initial_copy_evals F h).2.2
  have hkB : k < B := lt_trans hkc h.c_word
  have hcur : (Expr.var powerCursor).evalB B sigma = some k := by
    simpa [evalB_var_iff,hcursor] using hkB
  have htwoB : 2 < B := by
    have hh := h.packed.valid.arithmetic_word
    have hp := F.prime.two_le
    nlinarith
  have htwo : (Expr.lit 2).evalB B sigma = some 2 := evalB_lit htwoB
  have hstride : powerStride.evalB B sigma = some (2*blockWords F n) := by
    unfold powerStride
    exact evalB_bin (op:=Bop.mul) htwo hblock h.stride_word
  have hmul : (Expr.mul (.var powerCursor) powerStride).evalB B sigma =
      some (k*(2*blockWords F n)) := by
    apply evalB_bin (op:=Bop.mul) hcur hstride
    simp only [Bop.apply]
    have hmono := Nat.mul_le_mul_right (2*blockWords F n) (Nat.le_of_lt hkc)
    have hh := h.powers_word
    omega
  have hbase : (Expr.var poweredGramBase).evalB B sigma = some base := by
    simpa [evalB_var_iff,h.base_eq] using h.base_word
  unfold powerAddress powerAt
  apply evalB_bin (op:=Bop.add) hbase hmul
  simp only [Bop.apply]
  have hmono := Nat.mul_le_mul_right (2*blockWords F n) (Nat.le_of_lt hkc)
  have hh := h.powers_word
  omega
private theorem power_address_of_eval {B a b c n gram base work k : Nat}
    {sigma : Env} (q : Expr)
    (h : RuntimeLayout F B a b c n gram base work sigma)
    (hq : q.evalB B sigma = some k) (hkc : k < c) :
    (powerAddress q).evalB B sigma = some (powerAt F base n k) := by
  have hblock := (initial_copy_evals F h).2.2
  have htwoB : 2 < B := by
    have hh := h.packed.valid.arithmetic_word
    have hp := F.prime.two_le
    nlinarith
  have htwo : (Expr.lit 2).evalB B sigma = some 2 := evalB_lit htwoB
  have hstride : powerStride.evalB B sigma = some (2*blockWords F n) := by
    unfold powerStride
    exact evalB_bin (op:=Bop.mul) htwo hblock h.stride_word
  have hmul : (Expr.mul q powerStride).evalB B sigma =
      some (k*(2*blockWords F n)) := by
    apply evalB_bin (op:=Bop.mul) hq hstride
    simp only [Bop.apply]
    have hmono := Nat.mul_le_mul_right (2*blockWords F n) (Nat.le_of_lt hkc)
    have hh := h.powers_word
    omega
  have hbase : (Expr.var poweredGramBase).evalB B sigma = some base := by
    simpa [evalB_var_iff,h.base_eq] using h.base_word
  unfold powerAddress powerAt
  apply evalB_bin (op:=Bop.add) hbase hmul
  simp only [Bop.apply]
  have hmono := Nat.mul_le_mul_right (2*blockWords F n) (Nat.le_of_lt hkc)
  have hh := h.powers_word
  omega
theorem current_copy_evals {B a b c n gram base work k : Nat} {sigma : Env}
    (h : RuntimeLayout F B a b c n gram base work sigma)
    (hk : 1 <= k) (hkc : k < c)
    (hcursor : sigma.vars powerCursor = k) :
    (Expr.var gramBase).evalB B sigma = some gram ∧
    (gramCopyAddress (.var powerCursor)).evalB B sigma =
      some (gramCopyAt F base n k) ∧
    blockSize.evalB B sigma = some (blockWords F n) := by
  have hinit := initial_copy_evals F h
  have hp := power_address_eval F h hcursor hkc
  refine ⟨hinit.1,?_,hinit.2.2⟩
  have heq : powerAt F base n k - blockWords F n =
      gramCopyAt F base n k := by
    rcases k with _ | k
    · omega
    · let w := blockWords F n
      have hrewrite : (k+1)*(2*w) = w + (2*k+1)*w := by ring
      dsimp [w] at hrewrite
      dsimp [powerAt,gramCopyAt]
      rw [hrewrite]
      have : 2*(k+1)-1 = 2*k+1 := by omega
      rw [this]
      omega
  have hbound : powerAt F base n k - blockWords F n < B := by
    have hpB := h.powers_word
    have hmono := Nat.mul_le_mul_right (2*blockWords F n) (Nat.le_of_lt hkc)
    dsimp [powerAt]
    omega
  unfold gramCopyAddress
  have hev := evalB_bin (op:=Bop.sub) hp hinit.2.2 hbound
  simpa only [Bop.apply,heq] using hev
theorem install_product_at_run {B a b c n gram base work k : Nat} {sigma : Env}
    (h : RuntimeLayout F B a b c n gram base work sigma)
    (hk : 1 <= k) (hkc : k < c)
    (hcursor : sigma.vars powerCursor = k) :
    Run B installProduct sigma
      (productInstalled sigma (powerAt F base n (k-1))
        (gramCopyAt F base n k) (powerAt F base n k) n work)
      installCost := by
  have hcur : (Expr.var powerCursor).evalB B sigma = some k := by
    have hh := evalB_var (B:=B) (x:=powerCursor) (σ:=sigma)
      (by rw [hcursor]; exact lt_trans hkc h.c_word)
    simpa [hcursor] using hh
  have hone : (Expr.lit 1).evalB B sigma = some 1 := by
    apply evalB_lit
    have hh := h.packed.valid.arithmetic_word
    have hp := F.prime.two_le
    nlinarith
  have hsub : (Expr.sub (.var powerCursor) (.lit 1)).evalB B sigma =
      some (k-1) := by
    apply evalB_bin (op:=Bop.sub) hcur hone
    simp only [Bop.apply]
    exact lt_trans (Nat.sub_lt (by omega) (by omega)) (lt_trans hkc h.c_word)
  have hleft := power_address_of_eval F _ h hsub (by omega : k-1<c)
  have hnow := current_copy_evals F h hk hkc hcursor
  have hout := power_address_eval F h hcursor hkc
  have hn0 := exN_eval h.dimA_eq h.dimB_eq h.n_eq
    h.a_word h.b_word h.packed.n_word
  have hn1 : exN.evalB B
      (productS3 sigma (powerAt F base n (k-1))
        (gramCopyAt F base n k) (powerAt F base n k)) = some n := by
    simpa [productS3,productS2,productS1,exN,exA,exB,dimA,dimB,Env.setVar,
      canonical] using hn0
  have hn2 : exN.evalB B
      (productS4 sigma (powerAt F base n (k-1))
        (gramCopyAt F base n k) (powerAt F base n k) n) = some n := by
    simpa [productS4,productS3,productS2,productS1,exN,exA,exB,
      Env.setVar,canonical,rows,dimA,dimB] using hn0
  have hn3 : exN.evalB B
      (productS5 sigma (powerAt F base n (k-1))
        (gramCopyAt F base n k) (powerAt F base n k) n) = some n := by
    simpa [productS5,productS4,productS3,productS2,productS1,
      exN,exA,exB,Env.setVar,canonical,rows,columns,dimA,dimB] using hn0
  have hwB : (productS6 sigma (powerAt F base n (k-1))
      (gramCopyAt F base n k) (powerAt F base n k) n).vars productWork < B := by
    simpa [productS6,productS5,productS4,productS3,productS2,productS1,
      Env.setVar,canonical,rows,columns,count,productWork] using
      (show sigma.vars productWork < B by rw [h.work_eq]; exact h.work_word)
  have hw0 := evalB_var (B:=B) (x:=productWork)
    (σ:=productS6 sigma (powerAt F base n (k-1))
      (gramCopyAt F base n k) (powerAt F base n k) n) hwB
  have hwEq : (productS6 sigma (powerAt F base n (k-1))
      (gramCopyAt F base n k) (powerAt F base n k) n).vars productWork = work := by
    simpa [productS6,productS5,productS4,productS3,productS2,productS1,
      Env.setVar,canonical,rows,columns,count,productWork] using h.work_eq
  have hw : (Expr.var productWork).evalB B
      (productS6 sigma (powerAt F base n (k-1))
        (gramCopyAt F base n k) (powerAt F base n k) n) = some work := by
    rw [←hwEq]
    exact hw0
  have hright : (gramCopyAddress (.var powerCursor)).evalB B
      (productS1 sigma (powerAt F base n (k-1))) =
        some (gramCopyAt F base n k) := by
    unfold productS1
    rw [Problem18ClaudeIMPSlots20261001.evalB_setVar_noVar]
    · exact hnow.2.1
    · simp [Problem18ClaudeIMPSlots20261001.NoVar,gramCopyAddress,
        powerAddress,powerStride,blockSize,exN,exA,exB,canonical,
        poweredGramBase,powerCursor,dimA,dimB]
  have hout' : (powerAddress (.var powerCursor)).evalB B
      (productS2 sigma (powerAt F base n (k-1)) (gramCopyAt F base n k)) =
        some (powerAt F base n k) := by
    unfold productS2 productS1
    rw [Problem18ClaudeIMPSlots20261001.evalB_setVar_noVar,
      Problem18ClaudeIMPSlots20261001.evalB_setVar_noVar]
    · exact hout
    all_goals simp [Problem18ClaudeIMPSlots20261001.NoVar,powerAddress,
      powerStride,blockSize,exN,exA,exB,canonical,poweredGramBase,
      powerCursor,dimA,dimB]
  exact installProduct_run hleft hright hout'
    hn1 hn2 hn3 hw
private theorem copyGram_independent :
    Problem18RecursivePreparedCopy20261002.Independent
