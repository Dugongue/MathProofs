variable {K V : Type*} [Field K] [Fintype K]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
theorem selfAdjoint_aeval (B : LinearMap.BilinForm K V) (S : Module.End K V)
    (hS : B.IsSelfAdjoint S) (p : K[X]) : B.IsSelfAdjoint (aeval S p) := by
  intro x y
  induction p using Polynomial.induction_on' with
  | add p q hp hq =>
    simp only [aeval_add,LinearMap.add_apply,map_add,hp,hq]
  | monomial n c =>
    simp only [aeval_monomial,← Algebra.smul_def,LinearMap.smul_apply,map_smul,
      Mathproof.Problem18CyclicIsotropy20260930.selfAdjoint_pow_move B S hS]
theorem commuting_form_isometry_iff_tests
    (B C : LinearMap.BilinForm K V) (hnB : B.Nondegenerate) (hnC : C.Nondegenerate)
    (S : Module.End K V) (hS : B.IsSelfAdjoint S) (v : V) (hv : PolynomiallyCyclic S v)
    (hs : Squarefree S.charpoly) (hchar : ringChar K≠2) (a : K[X])
    (hC : ∀ x y,C x y=B ((aeval S a) x) y) :
    (∃ T : V ≃ₗ[K] V,(∀ x,T (S x)=S (T x)) ∧ ∀ x y,B (T x) (T y)=C x y) ↔
      FrobeniusSquareTests S.charpoly a := by
  have hiD : Function.Injective (aeval S a) := by
    apply LinearMap.ker_eq_bot.mp
    apply LinearMap.ker_eq_bot'.mpr
    intro x hx
    apply hnC.1
    intro y
    rw [hC,hx,map_zero,LinearMap.zero_apply]
  have hcop := injective_aeval_coprime S a hs hiD
  rw [frobeniusTests_iff_square_mod S.charpoly a S.charpoly_monic hs hcop hchar]
  constructor
  · rintro ⟨T,hT,hform⟩
    obtain ⟨r,hr,_⟩ := cyclic_commutant_polynomial S T.toLinearMap v hv hT
    have he : aeval S a=(aeval S r.val)^2 := by
      apply LinearMap.ext
      intro x
      apply sub_eq_zero.mp
      apply hnB.1
      intro y
      rw [map_sub,LinearMap.sub_apply]
      apply sub_eq_zero.mpr
      rw [← hC]
      change C x y=B ((aeval S r.val) ((aeval S r.val) x)) y
      rw [selfAdjoint_aeval B S hS r.val,hr]
      exact (hform x y).symm
    refine ⟨r.val,(cyclic_aeval_zero_iff S v hv _).mp ?_⟩
    simp only [map_sub,map_pow,he,sub_self]
  · rintro ⟨r,hr⟩
    have he : aeval S a=(aeval S r)^2 := by
      have hh := aeval_eq_zero_of_dvd_aeval_eq_zero hr S.aeval_self_charpoly
      simpa only [map_sub,map_pow,sub_eq_zero] using hh
    have hir : Function.Injective (aeval S r) := by
      intro x y hxy
      apply hiD
      rw [he]
      change (aeval S r) ((aeval S r) x)=(aeval S r) ((aeval S r) y)
      rw [hxy]
    let T := LinearEquiv.ofBijective (aeval S r) ⟨hir,LinearMap.injective_iff_surjective.mp hir⟩
    refine ⟨T,?_,?_⟩
    · intro x
      exact (commuting_aeval S S (fun _ => rfl) r x).symm
    · intro x y
      change B ((aeval S r) x) ((aeval S r) y)=C x y
      rw [hC,he]
      exact (selfAdjoint_aeval B S hS r ((aeval S r) x) y).symm
def KernelSquareTests (S D : Module.End K V) : Prop := by
  classical
  exact ∀ d : ℕ,1≤d → d≤S.charpoly.natDegree →
    LinearMap.ker (aeval S (gcd S.charpoly (X^(Nat.card K^d)-X))) ≤
      LinearMap.ker (D^((Nat.card K^d)/2)-1)
theorem kernelTests_iff_frobeniusTests (S : Module.End K V) (v : V)
    (hv : PolynomiallyCyclic S v) (hs : Squarefree S.charpoly) (a : K[X]) :
    KernelSquareTests S (aeval S a) ↔ FrobeniusSquareTests S.charpoly a := by
  classical
  constructor
  · intro ht d hd hn
    apply (cyclic_divisor_kernel_iff S v hv hs _ _ (gcd_dvd_left _ _)).mp
    simpa only [map_sub,map_pow,map_one] using ht d hd hn
  · intro ht d hd hn
    have hh := (cyclic_divisor_kernel_iff S v hv hs _ _ (gcd_dvd_left _ _)).mpr (ht d hd hn)
    simpa only [map_sub,map_pow,map_one] using hh
theorem commuting_form_isometry_iff_kernel_tests
    (B C : LinearMap.BilinForm K V) (hnB : B.Nondegenerate) (hnC : C.Nondegenerate)
    (S D : Module.End K V) (hS : B.IsSelfAdjoint S) (v : V) (hv : PolynomiallyCyclic S v)
    (hs : Squarefree S.charpoly) (hchar : ringChar K≠2)
    (hD : ∀ x,D (S x)=S (D x)) (hC : ∀ x y,C x y=B (D x) y) :
    (∃ T : V ≃ₗ[K] V,(∀ x,T (S x)=S (T x)) ∧ ∀ x y,B (T x) (T y)=C x y) ↔
      KernelSquareTests S D := by
  obtain ⟨a,ha,_⟩ := cyclic_commutant_polynomial S D v hv hD
  rw [← ha,kernelTests_iff_frobeniusTests S v hv hs a.val]
  exact commuting_form_isometry_iff_tests B C hnB hnC S hS v hv hs hchar a.val
    (by intro x y; rw [ha]; exact hC x y)
section BetweenSpaces
variable {W : Type*} [AddCommGroup W] [Module K W] [FiniteDimensional K W]
theorem intertwining_isometry_iff_kernel_tests
    (B : LinearMap.BilinForm K V) (C : LinearMap.BilinForm K W)
    (hnB : B.Nondegenerate) (hnC : C.Nondegenerate)
    (S D : Module.End K V) (R : Module.End K W) (hS : B.IsSelfAdjoint S)
    (v : V) (hv : PolynomiallyCyclic S v) (hs : Squarefree S.charpoly) (hchar : ringChar K≠2)
    (H : V ≃ₗ[K] W) (hH : ∀ x,H (S x)=R (H x))
    (hD : ∀ x,D (S x)=S (D x)) (hpair : ∀ x y,C (H x) (H y)=B (D x) y) :
    (∃ Q : V ≃ₗ[K] W,(∀ x,Q (S x)=R (Q x)) ∧ ∀ x y,C (Q x) (Q y)=B x y) ↔
      KernelSquareTests S D := by
  let C' := C.comp H.toLinearMap H.toLinearMap
  have hnC' : C'.Nondegenerate := by
    constructor
    · intro x hx
      apply H.injective
      rw [map_zero]
      apply hnC.1
      intro y
      obtain ⟨y,rfl⟩ := H.surjective y
      exact hx y
    · intro y hy
      apply H.injective
      rw [map_zero]
      apply hnC.2
      intro x
      obtain ⟨x,rfl⟩ := H.surjective x
      exact hy x
  rw [← commuting_form_isometry_iff_kernel_tests B C' hnB hnC' S D hS v hv hs hchar hD hpair]
  constructor
  · rintro ⟨Q,hQ,hform⟩
    let Z := H.trans Q.symm
    have hZ (x : V) : Q (Z x)=H x := Q.apply_symm_apply _
    refine ⟨Z,?_,?_⟩
    · intro x
      apply Q.injective
      rw [hZ,hQ,hZ,hH]
    · intro x y
      rw [← hform,hZ,hZ]
      rfl
  · rintro ⟨Z,hZ,hform⟩
    let Q := Z.symm.trans H
    have hQ (x : V) : Q (Z x)=H x := by
      change H (Z.symm (Z x))=H x
      rw [Z.symm_apply_apply]
    refine ⟨Q,?_,?_⟩
    · intro x
      obtain ⟨x,rfl⟩ := Z.surjective x
      rw [← hZ,hQ,hQ,hH]
    · intro x y
      obtain ⟨x,rfl⟩ := Z.surjective x
      obtain ⟨y,rfl⟩ := Z.surjective y
      rw [hQ,hQ]
      exact (hform x y).symm
end BetweenSpaces
