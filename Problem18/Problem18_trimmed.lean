    words x = 1 :: x.unitary.toNat :: x.q :: x.fieldData.presentation.p ::
      x.fieldData.presentation.e :: x.a :: x.b :: x.c ::
      ((List.finRange x.fieldData.presentation.e).map
          (fun i => (x.fieldData.presentation.modulus i).val) ++
        tensorCoordinates x.fieldData.presentation x.source ++
        tensorCoordinates x.fieldData.presentation x.target) := by
  simp [words, Mathproof.Problem18RAMUniformRootRuntime20261001.queryWords,
