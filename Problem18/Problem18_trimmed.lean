    (modelTraceForm_nonalternating g _ (fun i => (c i).property)) haB hd
theorem charTwo_squarefree_operator_card [CharP K 2]
    (hm : ∀ i,(g i).Monic) (hcop : Pairwise (fun i j => IsCoprime (g i) (g j)))
    (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hnB : B.Nondegenerate) (haB : ¬B.IsAlt)
    (hdim : Module.finrank K V=∑ i,(g i).natDegree) :
    Nat.card (Operators g B)=
      Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y)) := by
  have hcount := squarefree_selfAdjoint_card_coefficients g hm hcop B hB hnB
  have hall (c : Coefficients g) : ∃ e : (∀ i,AdjoinRoot (g i)) ≃ₗ[K] V,
      ∀ x y,B (e x) (e y)=∑ i,Algebra.trace K (AdjoinRoot (g i)) ((c i).val*x i*y i) := by
    simpa only [modelTraceForm_apply] using charTwo_coefficients_representable g B hB hnB haB hdim c
  rw [Nat.card_congr (Equiv.subtypeUnivEquiv hall),Nat.card_pi] at hcount
  have hc (i : ι) : Nat.card {z : AdjoinRoot (g i) // z≠0}=Nat.card K^(g i).natDegree-1 := by
    letI : Fintype (AdjoinRoot (g i)) := Fintype.ofFinite _
    rw [← Mathproof.Problem18DistinctDegreeSquare20260930.adjoinRoot_card (g i)]
    simp only [Nat.card_eq_fintype_card,Fintype.card_subtype_compl,Fintype.card_subtype_eq]
  simp_rw [hc] at hcount
  rw [mul_comm (∏ i,(Nat.card K^(g i).natDegree-1))] at hcount
