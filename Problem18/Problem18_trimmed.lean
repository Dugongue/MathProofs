variable {K : Type} [Field K] {a b c : ℕ}
def swapAB (A : RectTensor a b c K) : RectTensor b a c K :=
  fun k ij => A k (ij.2,ij.1)
def swapAC (A : RectTensor a b c K) : RectTensor c b a K :=
  fun i kj => A kj.1 (i,kj.2)
theorem swapAB_involutive (A : RectTensor a b c K) : swapAB (swapAB A)=A := rfl
theorem swapAC_involutive (A : RectTensor a b c K) : swapAC (swapAC A)=A := rfl
theorem action_apply (A : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (i : Fin a) (j : Fin b) (k : Fin c) :
    rectAction P Q R A k (i,j) =
      ∑ u, ∑ v, ∑ w, P i u * Q j v * R k w * A w (u,v) := by
  simp only [rectAction, Matrix.mul_apply, Matrix.transpose_apply,
    Matrix.kronecker, Matrix.kroneckerMap_apply, Fintype.sum_prod_type, Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro u hu
  apply Finset.sum_congr rfl
  intro v hv
  apply Finset.sum_congr rfl
  intro w hw
  ring
theorem swapAB_action (A : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) :
    swapAB (rectAction P Q R A) = rectAction Q P R (swapAB A) := by
  ext k ij
  rcases ij with ⟨j,i⟩
  change rectAction P Q R A k (i,j) = rectAction Q P R (swapAB A) k (j,i)
  simp only [action_apply,swapAB]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro v hv
  apply Finset.sum_congr rfl
  intro u hu
  apply Finset.sum_congr rfl
  intro w hw
  ring
theorem swapAC_action (A : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) :
    swapAC (rectAction P Q R A) = rectAction R Q P (swapAC A) := by
  ext i kj
  rcases kj with ⟨k,j⟩
  change rectAction P Q R A k (i,j) = rectAction R Q P (swapAC A) i (k,j)
  simp only [action_apply,swapAC]
  rw [Finset.sum_comm]
  conv_lhs => arg 2; ext v; rw [Finset.sum_comm]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro w hw
  apply Finset.sum_congr rfl
  intro v hv
  apply Finset.sum_congr rfl
  intro u hu
  ring
theorem root_swapAB_iff (unitary : Bool) (q : ℕ) (A B : RectTensor a b c K) :
    equivalent unitary q A B ↔ equivalent unitary q (swapAB A) (swapAB B) := by
  constructor
  · rintro ⟨P,Q,R,hP,hQ,hR,he⟩
    refine ⟨Q,P,R,hQ,hP,hR,?_⟩
    rw [← swapAB_action,he]
  · rintro ⟨Q,P,R,hQ,hP,hR,he⟩
    refine ⟨P,Q,R,hP,hQ,hR,?_⟩
    have h := congrArg swapAB he
    simpa only [swapAB_action,swapAB_involutive] using h
theorem root_swapAC_iff (unitary : Bool) (q : ℕ) (A B : RectTensor a b c K) :
    equivalent unitary q A B ↔ equivalent unitary q (swapAC A) (swapAC B) := by
  constructor
  · rintro ⟨P,Q,R,hP,hQ,hR,he⟩
    refine ⟨R,Q,P,hR,hQ,hP,?_⟩
    rw [← swapAC_action,he]
  · rintro ⟨R,Q,P,hR,hQ,hP,he⟩
    refine ⟨P,Q,R,hP,hQ,hR,?_⟩
    have h := congrArg swapAC he
    simpa only [swapAC_action,swapAC_involutive] using h
