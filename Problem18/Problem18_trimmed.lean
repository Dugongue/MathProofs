variable {K : Type} [Field K] [Fintype K] [SolverSize K] [DecidableEq K] (F : FieldPresentation K)
theorem run_preserving {c0 m : Nat} (cl : Clause (Fin (c0+m)) Int) (D B : Nat) (a : Fin c0→K) (σ : Env)
    (hS : Slots F canonical names.q.WS (size cl D) B σ)
    (hz : val F canonical names.q.WS σ 0=0)
    (hQ : σ.vars names.qr=SolverSize.card K) (hQB : SolverSize.card K<B)
    (hb : ∀ p∈sysExprs cl,∀ e∈rowExprs p (clauseDeg cl),polyDepth e ≤ D ∧ constBound e<B)
    (ha : ∀i:Fin c0,val F canonical names.q.WS σ (5+i.val)=a i)
    (hwords : (sysExprs cl).length+(m+1)+lenM (m+1) (eliminantShift (m+1) (clauseDeg cl))+
      lenD (m+1) (clauseDeg cl)+lenM (m+1) (geoE (m+1) (frobeniusDegree (m+1) (clauseDeg cl)))+
      rowLength (m+1) (clauseDeg cl)<B)
    (htape : σ.InpBounded B) :
    ∃ τ, Run B (program cl D) σ τ (cost F cl D) ∧
      (τ.vars geoNames.z=1 ↔ (Problem18P34Subfield20261003Semantics.clauseRun cl a).1=true) ∧ τ.vars geoNames.z ≤ 1 ∧
      Slots F canonical names.q.WS (size cl D) B τ ∧
      val F canonical names.q.WS τ 0=0 ∧
      (∀ bank,bank ≠ canonical.mem → bank ≠ canonical.scratch → τ.arrs bank=σ.arrs bank) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hSB:=hS.slots_word
  have hres : 5+c0+D ≤ reserve cl D:=le_max_right _ _
  have hrs : reserve cl D ≤ source (m+1) (clauseDeg cl) (sysExprs cl).length (reserve cl D):=le_max_left _ _
  have hprefix : 5+c0+D ≤ inputBase cl D := by
    unfold inputBase original system temp2 temp1 residueBase coefficients query
    omega
  have hfit : inputBase cl D+(sysExprs cl).length*lenD (m+1) (clauseDeg cl)<size cl D := by
    unfold size slots inputBase; omega
  have hciS : names.fn.ci ∉ regNames canonical := by decide
  have hciW : names.fn.ci ≠ names.q.WS := by decide
  obtain ⟨σ0,hr0,hS0,hrows0,hframe0,hreg0,harr0,hi0,ho0⟩ :=
    clauseRows_run (fieldMacros F) names.q names.fn.ci hciS hciW (.lit 5) (.lit (5+c0))
      (.lit (inputBase cl D)) [] (by simp) trivial trivial trivial cl a (D:=D)
      le_rfl hprefix hS (evalB_lit (by omega)) (evalB_lit (by omega)) (evalB_lit (by omega))
      (by exact Nat.le_of_lt hfit) hb ha
  let vs := (clauseRows cl a).map Prod.fst
  have hvs : vs.length=(sysExprs cl).length := by simp [vs,clauseRows]
  have hz0 : val F canonical names.q.WS σ0 0=0 :=
    (hframe0 0 (by omega) (Or.inl (by omega)) (Or.inl (by omega))).trans hz
  have hQ0 : σ0.vars names.qr=SolverSize.card K :=
    (hreg0 names.qr names_valid.qr.1 (by decide)).trans hQ
  obtain ⟨σ1,hr1,hL1,hv1,hi1,ho1⟩ :=
    Problem18ConcreteSolverSetup20261002.setup_run F (m+1) (clauseDeg cl) (reserve cl D) (SolverSize.card K) B vs σ0
      (by simpa only [hvs,size] using hS0) hz0
      (by intro u hu k hk; simpa only [vs,List.getElem_map,hvs,inputBase,lenD] using hrows0 u
            (by simpa only [vs,List.length_map] using hu) ⟨k,hk⟩)
      hQ0 hQB (by rw [hvs]; omega) (by omega) (by omega)
      (by simpa only [Env.InpBounded,hi0] using htape)
  have hreserve : Problem18P34Subfield20261003NConcreteFiniteParameterSolver.reserve (m+1) (clauseDeg cl) vs.length ≤ reserve cl D := by
    rw [hvs]; exact le_max_left _ _
  obtain ⟨τ,hr2,hans,hansB,hS2,hframe2,hi2,ho2⟩ :=
    Problem18ConcreteSolverDecisionFrame20261002.decision_run_preserving F names names_valid geoNames geoNames_valid
      (m+1) (clauseDeg cl) (reserve cl D) (SolverSize.card K) B vs σ1 hL1 hreserve
      (by rw [hvs]; omega) (by omega) (by omega)
  have hr : Run B (program cl D) σ τ (cost F cl D) := by
    simp only [program,cost]
    rw [clauseLoadCom_uniform _ F]
    simpa only [hvs,lenD] using hr0.seq (hr1.seq hr2)
  have hs0 : 0 < slots (m+1) (clauseDeg cl) vs.length (reserve cl D) := by
    unfold slots; omega
  exact ⟨τ,hr,hans,hansB,by simpa only [hvs,size] using hS2,
    (hframe2 0 hs0 (Or.inl rfl)).trans hL1.zero,
    fun bank hm hs=>Problem18P34Subfield20261003NConcreteSolverScopeAssembly.clause_caller_array_preserved cl hr bank hm hs,
    hi2.trans (hi1.trans hi0),ho2.trans (ho1.trans ho0)⟩
end
