    ((Matrix.of fun (_ : Fin 1) (_ : Fin c) => (1:K)) * X) *
      (Mathproof.Problem18PairBoundaryModeCharTwoMath20261004.krRows (X.transpose * X)).transpose =
    Matrix.of (fun _ k => Mathproof.Problem18PairBoundaryModeCharTwoMath20261004.tvec X k) := by
  ext i k
