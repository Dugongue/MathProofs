    (A B : Matrix (Fin n) (Fin n) K) (hAB : A*B=1) (hBA : B*A=1) :
    Matrix (Fin n) (Fin r) K ≃ Matrix (Fin n) (Fin r) K where
  toFun X := A*X
  invFun X := B*X
  left_inv X := by dsimp; rw [← Matrix.mul_assoc, hBA, Matrix.one_mul]
  right_inv X := by dsimp; rw [← Matrix.mul_assoc, hAB, Matrix.one_mul]
theorem gram_image_congruence {n r : ℕ}
    (A B : Matrix (Fin n) (Fin n) K) (hBA : B*A=1)
    (X : Matrix (Fin n) (Fin r) K) (J : Matrix (Fin r) (Fin r) K) :
    LinearMap.range ((A*X)*J*(A*X).transpose).mulVecLin =
      (LinearMap.range (X*J*X.transpose).mulVecLin).map A.mulVecLin := by
  have hAT : A.transpose*B.transpose=1 := by
    rw [← Matrix.transpose_mul, hBA, Matrix.transpose_one]
  have heq : (A*X)*J*(A*X).transpose =
      (A*(X*J*X.transpose))*A.transpose := by
    simp only [Matrix.transpose_mul, Matrix.mul_assoc]
  rw [heq, range_mul_right_inverse _ _ _ hAT,
    Matrix.mulVecLin_mul, LinearMap.range_comp]
theorem hermitian_gram_image_congruence [StarRing K] {n r : ℕ}
    (A B : Matrix (Fin n) (Fin n) K) (hBA : B*A=1)
    (X : Matrix (Fin n) (Fin r) K) (J : Matrix (Fin r) (Fin r) K) :
    LinearMap.range ((A*X)*J*(A*X)ᴴ).mulVecLin =
      (LinearMap.range (X*J*Xᴴ).mulVecLin).map A.mulVecLin := by
  have hAT : Aᴴ*Bᴴ=1 := by
    rw [← Matrix.conjTranspose_mul, hBA, Matrix.conjTranspose_one]
  have heq : (A*X)*J*(A*X)ᴴ = (A*(X*J*Xᴴ))*Aᴴ := by
    simp only [Matrix.conjTranspose_mul, Matrix.mul_assoc]
  rw [heq, range_mul_right_inverse _ _ _ hAT,
    Matrix.mulVecLin_mul, LinearMap.range_comp]
theorem equivariant_fiber_card_eq {n : ℕ} {Ω : Type*}
    (f : Ω → Submodule K (Fin n → K))
    (hact : ∀ g : (Fin n → K) ≃ₗ[K] (Fin n → K),
      ∃ e : Ω ≃ Ω, ∀ x, f (e x) = (f x).map g.toLinearMap)
    (W W' : Submodule K (Fin n → K))
    (h : Module.finrank K W = Module.finrank K W') :
    Nat.card {x : Ω // f x = W} = Nat.card {x : Ω // f x = W'} := by
  obtain ⟨g, hg⟩ := exists_equiv_map_eq W W' h
  obtain ⟨e, he⟩ := hact g
  apply Nat.card_congr (Equiv.subtypeEquiv e _)
  intro x
  rw [he, ← hg]
  exact (Submodule.map_injective_of_injective g.injective).eq_iff.symm
private theorem equiv_matrices {n : ℕ} (g : (Fin n → K) ≃ₗ[K] (Fin n → K)) :
    LinearMap.toMatrix' g.toLinearMap * LinearMap.toMatrix' g.symm.toLinearMap = 1 ∧
    LinearMap.toMatrix' g.symm.toLinearMap * LinearMap.toMatrix' g.toLinearMap = 1 := by
  constructor <;> rw [← LinearMap.toMatrix'_comp]
  · simp
  · simp
theorem gram_image_fiber_card_eq {n r : ℕ}
    (J : Matrix (Fin r) (Fin r) K)
    (W W' : Submodule K (Fin n → K))
