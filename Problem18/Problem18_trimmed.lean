theorem finite_fiber_extension {U V T : Type*} [Finite U] [Finite V]
    (i j : U → V) (hi : Function.Injective i) (hj : Function.Injective j)
    (L M : V → T) (hcompat : ∀ u, M (j u) = L (i u))
    (hfiber : ∀ t, Nat.card {v // L v = t} = Nat.card {v // M v = t})
    (x : V) (hx : x ∉ Set.range i) :
    ∃ y, y ∉ Set.range j ∧ M y = L x := by
  classical
  let A := {u : U // L (i u) = L x}
  let S := {v : V // L v = L x}
  let R := {v : V // M v = L x}
  letI : Fintype A := Fintype.ofFinite _
  letI : Fintype S := Fintype.ofFinite _
  letI : Fintype R := Fintype.ofFinite _
  let f : A → S := fun u => ⟨i u.val, u.property⟩
  let g : A → R := fun u => ⟨j u.val, (hcompat u.val).trans u.property⟩
  have hfi : Function.Injective f := by
    intro u v h
    exact Subtype.ext (hi (congrArg Subtype.val h))
  have hm : (⟨x, rfl⟩ : S) ∉ Set.range f := by
    rintro ⟨u, hu⟩
    exact hx ⟨u.val, congrArg Subtype.val hu⟩
  have hlt := Fintype.card_lt_of_injective_of_notMem f hfi hm
  by_contra hn
  have hgs : Function.Surjective g := by
    intro y
    have hy : y.val ∈ Set.range j := by
      by_contra h
      exact hn ⟨y.val, h, y.property⟩
    obtain ⟨u, hu⟩ := hy
    refine ⟨⟨u, ?_⟩, ?_⟩
    · rw [← hcompat u, hu]
      exact y.property
    · exact Subtype.ext hu
  have hle := Fintype.card_le_of_surjective g hgs
  have he := hfiber (L x)
  change Nat.card S = Nat.card R at he
  simp only [Nat.card_eq_fintype_card] at he
  omega
