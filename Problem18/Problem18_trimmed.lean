  have hq : q≠0 := by dsimp only [q]; exact_mod_cast (Nat.card_pos (α:=F)).ne'
  have hg : (Nat.card (Matrix.unitaryGroup (Fin n) K) : ℝ)≠0 := by
    exact_mod_cast (Nat.card_pos (α:=Matrix.unitaryGroup (Fin n) K)).ne'
