  let g:=annihilator A z
  let d:=monicGcd s.2 g.1
  let h:=Problem18CountedPolynomialDivision20261001.divide g.1 d.1
  let f:=Problem18CountedPolynomialArithmetic20261001.mul s.2 h.1
  let w:=action A s.2 z
