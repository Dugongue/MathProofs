variable {k : Type*} [Field k] [DecidableEq k] {M : ℕ}
def vget {n : ℕ} (v : Vector k n) (j : ℕ) : k := if h : j < n then v[j] else 0
theorem vget_ofFn {n : ℕ} (f : Fin n → k) (j : ℕ) :
    vget (Vector.ofFn f) j = if h : j < n then f ⟨j, h⟩ else 0 := by
  by_cases h : j < n <;> simp [vget, h]
def costSum {α : Type*} {n : ℕ} (es : Vector (α × ℕ) n) : ℕ → ℕ
  | 0 => 0
  | j + 1 => costSum es j + (if h : j < n then es[j].2 else 0)
def countedOfFn {α : Type*} (n : ℕ) (f : Fin n → α × ℕ) : Vector α n × ℕ :=
  let es := Vector.ofFn f
  (es.map Prod.fst, costSum es n)
theorem countedOfFn_fst {α : Type*} (n : ℕ) (f : Fin n → α × ℕ) :
    (countedOfFn n f).1 = Vector.ofFn fun i => (f i).1 := by
  ext i hi
  simp [countedOfFn]
theorem vget_countedOfFn {n : ℕ} (f : Fin n → k × ℕ) (j : ℕ) :
    vget (countedOfFn n f).1 j = if h : j < n then (f ⟨j, h⟩).1 else 0 := by
  rw [countedOfFn_fst, vget_ofFn]
theorem costSum_const {α : Type*} {n : ℕ} (es : Vector (α × ℕ) n) (c : ℕ)
    (hc : ∀ i : Fin n, es[i.val].2 = c) (j : ℕ) (hj : j ≤ n) : costSum es j = j * c := by
  induction j with
  | zero => simp [costSum]
  | succ j ih =>
    rw [costSum, ih (by omega), dif_pos (by omega : j < n), hc ⟨j, by omega⟩]
    ring
theorem countedOfFn_cost {α : Type*} (n : ℕ) (f : Fin n → α × ℕ) (c : ℕ)
    (hc : ∀ i, (f i).2 = c) : (countedOfFn n f).2 = n * c :=
  costSum_const _ c (fun i => by simp [hc]) n le_rfl
theorem countedOfFn_cost_pair {α : Type*} (n : ℕ) (g : Fin n → α) (c : ℕ) :
    (countedOfFn n (fun i => (g i, c))).2 = n * c :=
  countedOfFn_cost n _ c (fun _ => rfl)
noncomputable def residuePoly {D : ℕ} (v : Vector k D) : Polynomial k :=
  ∑ j ∈ Finset.range D, Polynomial.C (vget v j) * Polynomial.X ^ j
noncomputable def modulus {D : ℕ} (cs : Vector k D) : Polynomial k :=
  Polynomial.X ^ D + residuePoly cs
noncomputable abbrev residueMap {D : ℕ} (cs : Vector k D) :
    Polynomial k →+* Polynomial k ⧸ Ideal.span {modulus cs} :=
  Ideal.Quotient.mk _
theorem residuePoly_coeff {D : ℕ} (v : Vector k D) (n : ℕ) :
    (residuePoly v).coeff n = if n < D then vget v n else 0 := by
  rw [residuePoly, Polynomial.finsetSum_coeff]
  simp only [Polynomial.coeff_C_mul_X_pow]
  rw [Finset.sum_ite_eq]
  simp only [Finset.mem_range]
theorem residueMap_modulus {D : ℕ} (cs : Vector k D) : residueMap cs (modulus cs) = 0 :=
  Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_span_singleton_self _)
theorem aeval_residuePoly {D : ℕ} {A : Type*} [CommRing A] [Algebra k A] (x : A) (v : Vector k D) :
    Polynomial.aeval x (residuePoly v) = ∑ j ∈ Finset.range D, vget v j • x ^ j := by
  unfold residuePoly
  rw [map_sum]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [map_mul, Polynomial.aeval_C, map_pow, Polynomial.aeval_X, Algebra.smul_def]
def mulX {D : ℕ} (cs w : Vector k D) : Vector k D × ℕ :=
  countedOfFn D fun j : Fin D =>
    ((if j.val = 0 then 0 else vget w (j.val - 1)) - vget cs j.val * vget w (D - 1), 2)
theorem mulX_spec {D : ℕ} (hD : 0 < D) (cs w : Vector k D) :
    residuePoly (mulX cs w).1 =
      Polynomial.X * residuePoly w - Polynomial.C (vget w (D - 1)) * modulus cs := by
  ext n
  rw [Polynomial.coeff_sub, Polynomial.coeff_C_mul, modulus, Polynomial.coeff_add,
    Polynomial.coeff_X_pow, residuePoly_coeff, residuePoly_coeff]
  simp only [mulX, vget_countedOfFn]
  rcases n with _ | n
  · rw [Polynomial.coeff_X_mul_zero]
    have h0 : (0 : ℕ) ≠ D := by omega
    have h0' : D ≠ 0 := by omega
    simp [hD, h0, h0'] <;> ring
  · rw [Polynomial.coeff_X_mul, residuePoly_coeff]
    rcases lt_trichotomy (n + 1) D with h | h | h
    · have hn : n < D := by omega
      have hne : n + 1 ≠ D := by omega
      simp [h, hn, hne] <;> ring
    · subst h
      simp
    · have hn : ¬ n < D := by omega
      have hlt : ¬ n + 1 < D := by omega
      have hne : n + 1 ≠ D := by omega
      simp [hn, hlt, hne]
theorem mulX_map {D : ℕ} (hD : 0 < D) (cs w : Vector k D) :
    residueMap cs (residuePoly (mulX cs w).1) =
      residueMap cs Polynomial.X * residueMap cs (residuePoly w) := by
  rw [mulX_spec hD, map_sub, map_mul, map_mul, residueMap_modulus, mul_zero, sub_zero]
theorem mulX_cost {D : ℕ} (cs w : Vector k D) : (mulX cs w).2 = 2 * D := by
  simp only [mulX, countedOfFn_cost_pair]
  ring
theorem residuePoly_zero (D : ℕ) : residuePoly (Vector.ofFn fun _ : Fin D => (0 : k)) = 0 := by
  ext n
  rw [residuePoly_coeff, vget_ofFn, Polynomial.coeff_zero]
  simp
theorem residuePoly_combine {D : ℕ} (a b : Vector k D) (s : k) :
    residuePoly (countedOfFn D fun l : Fin D => (vget a l.val + s * vget b l.val, 2)).1 =
      residuePoly a + Polynomial.C s * residuePoly b := by
  ext n
  rw [Polynomial.coeff_add, Polynomial.coeff_C_mul, residuePoly_coeff, residuePoly_coeff,
    residuePoly_coeff, vget_countedOfFn]
  by_cases h : n < D <;> simp [h]
def mulLoop {D : ℕ} (cs p q : Vector k D) : ℕ → Vector k D × Vector k D × ℕ
  | 0 => (Vector.ofFn fun _ => 0, p, 0)
  | j + 1 =>
    let r := mulLoop cs p q j
    let c := mulX cs r.2.1
    let a := countedOfFn D (fun l : Fin D => (vget r.1 l.val + vget q j * vget r.2.1 l.val, 2))
    (a.1, c.1, r.2.2 + c.2 + a.2)
def mulMod {D : ℕ} (cs p q : Vector k D) : Vector k D × ℕ :=
  let r := mulLoop cs p q D
  (r.1, r.2.2)
theorem mulLoop_spec {D : ℕ} (hD : 0 < D) (cs p q : Vector k D) (j : ℕ) :
    residueMap cs (residuePoly (mulLoop cs p q j).1) =
        residueMap cs (residuePoly p) *
          residueMap cs (∑ l ∈ Finset.range j, Polynomial.C (vget q l) * Polynomial.X ^ l) ∧
      residueMap cs (residuePoly (mulLoop cs p q j).2.1) =
        residueMap cs (residuePoly p) * residueMap cs Polynomial.X ^ j := by
  induction j with
  | zero =>
    constructor
    · simp only [mulLoop, residuePoly_zero, map_zero, Finset.range_zero, Finset.sum_empty,
        mul_zero]
    · simp only [mulLoop, pow_zero, mul_one]
  | succ j ih =>
    obtain ⟨ih1, ih2⟩ := ih
    simp only [mulLoop]
    constructor
    · rw [residuePoly_combine, map_add, map_mul, ih1, ih2, Finset.sum_range_succ, map_add,
        map_mul, map_pow]
      ring
    · rw [mulX_map hD, ih2]
      ring
theorem mulMod_spec {D : ℕ} (hD : 0 < D) (cs p q : Vector k D) :
    residueMap cs (residuePoly (mulMod cs p q).1) =
      residueMap cs (residuePoly p) * residueMap cs (residuePoly q) :=
  (mulLoop_spec hD cs p q D).1
theorem mulLoop_cost {D : ℕ} (cs p q : Vector k D) (j : ℕ) :
    (mulLoop cs p q j).2.2 = 4 * D * j := by
  induction j with
  | zero => rfl
  | succ j ih =>
    simp only [mulLoop, mulX_cost, ih, countedOfFn_cost_pair]
    ring
theorem mulMod_cost {D : ℕ} (cs p q : Vector k D) : (mulMod cs p q).2 = 4 * D * D :=
  mulLoop_cost cs p q D
def oneVec (D : ℕ) : Vector k D := Vector.ofFn fun j => if j.val = 0 then 1 else 0
theorem residuePoly_one {D : ℕ} (hD : 0 < D) : residuePoly (oneVec (k := k) D) = 1 := by
  ext n
  rw [residuePoly_coeff, Polynomial.coeff_one, oneVec, vget_ofFn]
  by_cases h0 : n = 0
  · subst h0
    simp [hD]
  · simp [h0]
def powBits {D : ℕ} (cs x : Vector k D) : List Bool → Vector k D × ℕ
  | [] => (oneVec D, 0)
  | b :: bs =>
    let r := powBits cs x bs
    let s := mulMod cs r.1 r.1
    if b then
      let t := mulMod cs s.1 x
      (t.1, r.2 + s.2 + t.2)
    else (s.1, r.2 + s.2)
theorem powBits_spec {D : ℕ} (hD : 0 < D) (cs x : Vector k D) (bs : List Bool) :
    residueMap cs (residuePoly (powBits cs x bs).1) =
      residueMap cs (residuePoly x) ^ bitsValue bs := by
  induction bs with
  | nil => simp only [powBits, residuePoly_one hD, map_one, bitsValue, pow_zero]
  | cons b bs ih =>
    cases b
    · simp only [powBits, Bool.false_eq_true, ↓reduceIte]
      rw [mulMod_spec hD, ih, bitsValue, Nat.bit_false_apply]
      ring
    · simp only [powBits, eq_self_iff_true, ↓reduceIte, if_true]
      rw [mulMod_spec hD, mulMod_spec hD, ih, bitsValue, Nat.bit_true_apply]
      ring
theorem powBits_cost {D : ℕ} (cs x : Vector k D) (bs : List Bool) :
    (powBits cs x bs).2 ≤ bs.length * (8 * D * D) := by
  induction bs with
  | nil => simp [powBits]
  | cons b bs ih =>
    cases b
    · simp only [powBits, Bool.false_eq_true, ↓reduceIte, mulMod_cost, List.length_cons]
      nlinarith [ih, Nat.zero_le (D * D)]
    · simp only [powBits, eq_self_iff_true, ↓reduceIte, if_true, mulMod_cost, List.length_cons]
      nlinarith [ih, Nat.zero_le (D * D)]
def frobeniusResidue {D : ℕ} (cs : Vector k D) (Q : ℕ) : Vector k D × ℕ :=
  let x := mulX cs (oneVec D)
  let r := powBits cs x.1 Q.bits
  (r.1, x.2 + r.2)
theorem frobeniusResidue_spec {D : ℕ} (hD : 0 < D) (cs : Vector k D) (Q : ℕ) :
    residueMap cs (residuePoly (frobeniusResidue cs Q).1) = residueMap cs Polynomial.X ^ Q := by
  simp only [frobeniusResidue]
  rw [powBits_spec hD, mulX_map hD, residuePoly_one hD, map_one, mul_one, bitsValue_bits]
theorem frobeniusResidue_cost {D : ℕ} (cs : Vector k D) (Q : ℕ) :
    (frobeniusResidue cs Q).2 ≤ 2 * D + Nat.size Q * (8 * D * D) := by
  simp only [frobeniusResidue, mulX_cost]
  have h := powBits_cost cs (mulX cs (oneVec D)).1 Q.bits
  rw [Nat.size_eq_bits_len] at h
  exact Nat.add_le_add_left h _
theorem frobenius_eval {D : ℕ} (hD : 0 < D) (cs : Vector k D) (Q : ℕ) {A : Type*} [CommRing A]
    [Algebra k A] (t : A) (ht : Polynomial.aeval t (modulus cs) = 0) :
    Polynomial.aeval t (residuePoly (frobeniusResidue cs Q).1) = t ^ Q := by
  have h := frobeniusResidue_spec hD cs Q
  rw [← map_pow] at h
  obtain ⟨g, hg⟩ := Ideal.mem_span_singleton.mp (Ideal.Quotient.eq.mp h)
  have h2 := congrArg (Polynomial.aeval t) hg
  rw [map_sub, map_mul, ht, zero_mul, map_pow, Polynomial.aeval_X, sub_eq_zero] at h2
  exact h2
def eliminantDegree (M d : ℕ) : ℕ := max 1 ((d * 2 ^ controlledDepth M d) ^ M)
def eliminantShift (M d : ℕ) : ℕ := 2 * d * 2 ^ controlledDepth M d + eliminantDegree M d
def frobeniusDegree (M d : ℕ) : ℕ := max d (eliminantDegree M d)
theorem eliminantDegree_pos (M d : ℕ) : 0 < eliminantDegree M d :=
  lt_of_lt_of_le Nat.one_pos (le_max_left _ _)
theorem degree_le_shift (M d : ℕ) : eliminantDegree M d ≤ d + eliminantShift M d :=
  (Nat.le_add_left (eliminantDegree M d) (2 * d * 2 ^ controlledDepth M d)).trans
    (Nat.le_add_left _ d)
abbrev eliminantRows (d : ℕ) (vs : List (DenseInput M d k)) (i : Fin M) :
    List (Vector k (boundedExponents M (d + eliminantShift M d)).length) :=
  macaulayRows d (eliminantShift M d) vs ++
    lowPowerRows (d + eliminantShift M d) i (eliminantDegree M d)
def eliminantCertificate (d : ℕ) (vs : List (DenseInput M d k)) (i : Fin M) :
    CertificateResult k (eliminantRows d vs i).length :=
  arrayCertificate (eliminantRows d vs i)
    (powerRow (d + eliminantShift M d) i (eliminantDegree M d))
def lowCoefficients (D R : ℕ) {n : ℕ} (c : Vector k n) : Vector k D × ℕ :=
  countedOfFn D fun e => (- vget c (R + e.val), 1)
theorem lowCoefficients_cost (D R : ℕ) {n : ℕ} (c : Vector k n) :
    (lowCoefficients D R c).2 = D := by
  simp only [lowCoefficients, countedOfFn_cost_pair, mul_one]
def eliminantCoefficients (d : ℕ) (vs : List (DenseInput M d k)) (i : Fin M) :
    Vector k (eliminantDegree M d) :=
  (lowCoefficients (eliminantDegree M d) (macaulayRows d (eliminantShift M d) vs).length
    (eliminantCertificate d vs i).coefficients).1
theorem eliminantCertificate_member (d : ℕ) (vs : List (DenseInput M d k)) (i : Fin M) :
    (eliminantCertificate d vs i).member =
      (coordinateFiniteCheck d (eliminantDegree M d) vs i).1 := rfl
noncomputable def eliminantRowPoly (d : ℕ) (vs : List (DenseInput M d k))
    (fs : List (MvPolynomial (Fin M) k)) (i : Fin M) (j : ℕ) : MvPolynomial (Fin M) k :=
  if j < (macaulayRows d (eliminantShift M d) vs).length then
    (polynomialRows (eliminantShift M d) fs).getD j 0
  else X i ^ (j - (macaulayRows d (eliminantShift M d) vs).length)
theorem eliminant_row (d : ℕ) (vs : List (DenseInput M d k)) (fs : List (MvPolynomial (Fin M) k))
    (hv : List.Forall₂ (ValidDenseInput d) vs fs) (i : Fin M)
    (j : Fin (eliminantRows d vs i).length) :
    rowFamily (eliminantRows d vs i) j =
      observePolynomial (d + eliminantShift M d) (eliminantRowPoly d vs fs i j.val) := by
  unfold eliminantRowPoly
  by_cases h : j.val < (macaulayRows d (eliminantShift M d) vs).length
  · rw [if_pos h]
    refine Eq.trans ?_ (polynomialRows_observation d (eliminantShift M d) vs fs hv ⟨j.val, h⟩)
    simp only [rowFamily, eliminantRows, List.getElem_append_left h, Fin.val_mk]
  · rw [if_neg h]
    simp only [rowFamily, eliminantRows, List.getElem_append_right (Nat.le_of_not_lt h),
      lowPowerRows, List.getElem_map, List.getElem_range]
    exact powerRow_read _ _ _
theorem eliminant_identity (d : ℕ) (vs : List (DenseInput M d k))
    (fs : List (MvPolynomial (Fin M) k)) (hv : List.Forall₂ (ValidDenseInput d) vs fs)
    (i : Fin M) (h : (eliminantCertificate d vs i).member = true) :
    observePolynomial (d + eliminantShift M d)
        (∑ j ∈ Finset.range ((macaulayRows d (eliminantShift M d) vs).length + eliminantDegree M d),
          vget (eliminantCertificate d vs i).coefficients j • eliminantRowPoly d vs fs i j) =
      observePolynomial (d + eliminantShift M d) (X i ^ eliminantDegree M d) := by
  have hc := arrayCertificate_coefficients (eliminantRows d vs i)
    (powerRow (d + eliminantShift M d) i (eliminantDegree M d)) h
  rw [powerRow_read] at hc
  rw [← hc, map_sum]
  have hlen : (eliminantRows d vs i).length =
      (macaulayRows d (eliminantShift M d) vs).length + eliminantDegree M d := by
    simp only [eliminantRows, List.length_append, lowPowerRows, List.length_map, List.length_range]
  rw [← hlen, ← Fin.sum_univ_eq_sum_range]
  refine Finset.sum_congr rfl (fun j _ => ?_)
  rw [map_smul, eliminant_row d vs fs hv i j]
  congr 1
  unfold vget
  exact dif_pos j.isLt
noncomputable def macaulayPart (d : ℕ) (vs : List (DenseInput M d k))
    (fs : List (MvPolynomial (Fin M) k)) (i : Fin M) : MvPolynomial (Fin M) k :=
  ∑ j ∈ Finset.range (macaulayRows d (eliminantShift M d) vs).length,
    vget (eliminantCertificate d vs i).coefficients j • (polynomialRows (eliminantShift M d) fs).getD j 0
noncomputable def lowPart (d : ℕ) (vs : List (DenseInput M d k)) (i : Fin M) :
    MvPolynomial (Fin M) k :=
  ∑ e ∈ Finset.range (eliminantDegree M d),
    vget (eliminantCertificate d vs i).coefficients
      ((macaulayRows d (eliminantShift M d) vs).length + e) • X i ^ e
theorem eliminant_split (d : ℕ) (vs : List (DenseInput M d k))
    (fs : List (MvPolynomial (Fin M) k)) (i : Fin M) :
    ∑ j ∈ Finset.range ((macaulayRows d (eliminantShift M d) vs).length + eliminantDegree M d),
        vget (eliminantCertificate d vs i).coefficients j • eliminantRowPoly d vs fs i j =
      macaulayPart d vs fs i + lowPart d vs i := by
  rw [Finset.sum_range_add, macaulayPart, lowPart]
  congr 1
  · refine Finset.sum_congr rfl (fun j hj => ?_)
    rw [eliminantRowPoly, if_pos (Finset.mem_range.mp hj)]
  · refine Finset.sum_congr rfl (fun e _ => ?_)
    rw [eliminantRowPoly, if_neg (Nat.not_lt.mpr (Nat.le_add_right _ _)), Nat.add_sub_cancel_left]
theorem eliminant_mem (d : ℕ) (vs : List (DenseInput M d k)) (fs : List (MvPolynomial (Fin M) k))
    (hv : List.Forall₂ (ValidDenseInput d) vs fs) (i : Fin M)
    (h : (eliminantCertificate d vs i).member = true) :
    Polynomial.aeval (X i : MvPolynomial (Fin M) k) (modulus (eliminantCoefficients d vs i)) ∈
      generatedIdeal (fs.toFinset : Set (MvPolynomial (Fin M) k)) := by
  have hF : ∀ f ∈ (fs.toFinset : Set (MvPolynomial (Fin M) k)), f.totalDegree ≤ d :=
    fun f hf => valid_inputs_degree d vs fs hv f (List.mem_toFinset.mp (Finset.mem_coe.mp hf))
  have hS1 : macaulayPart d vs fs i ∈
      macaulaySpan (fs.toFinset : Set (MvPolynomial (Fin M) k)) (eliminantShift M d) := by
    rw [macaulayPart]
    exact Submodule.sum_mem _ (fun j _ =>
      Submodule.smul_mem _ _ (polynomialRow_mem (eliminantShift M d) fs j))
  have hS2 : lowPart d vs i ∈ lowPowers (K := k) i (eliminantDegree M d) := by
    rw [lowPart]
    refine Submodule.sum_mem _ (fun e he => Submodule.smul_mem _ _ ?_)
    unfold lowPowers
    exact Submodule.subset_span ⟨⟨e, Finset.mem_range.mp he⟩, rfl⟩
  have heq : X i ^ eliminantDegree M d = macaulayPart d vs fs i + lowPart d vs i := by
    apply observePolynomial_injective_bounded (d + eliminantShift M d)
    · rw [totalDegree_X_pow]
      exact degree_le_shift M d
    · exact (totalDegree_add _ _).trans (max_le
        (macaulay_span_degree d (eliminantShift M d) _ hF hS1)
        ((lowPowers_degree i (eliminantDegree M d) hS2).trans (degree_le_shift M d)))
    · rw [← eliminant_split d vs fs i]
      exact (eliminant_identity d vs fs hv i h).symm
  have hlow : ∑ e ∈ Finset.range (eliminantDegree M d),
      vget (eliminantCoefficients d vs i) e • (X i : MvPolynomial (Fin M) k) ^ e =
        - lowPart d vs i := by
    rw [lowPart, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl (fun e he => ?_)
    rw [eliminantCoefficients, lowCoefficients, vget_countedOfFn,
      dif_pos (Finset.mem_range.mp he)]
    exact neg_smul _ _
  have hmod : Polynomial.aeval (X i : MvPolynomial (Fin M) k)
      (modulus (eliminantCoefficients d vs i)) = macaulayPart d vs fs i := by
    rw [modulus, map_add, map_pow, Polynomial.aeval_X, aeval_residuePoly, hlow, heq]
    ring
  rw [hmod]
  exact macaulaySpan_le_ideal (N := M) (K := k) (fs.toFinset : Set (MvPolynomial (Fin M) k))
    (eliminantShift M d) hS1
theorem gate_of_finite {L : Type*} [Field L] [Algebra k L] [IsAlgClosed L]
    [Algebra.IsAlgebraic k L] (d : ℕ) (vs : List (DenseInput M d k))
    (fs : List (MvPolynomial (Fin M) k)) (hv : List.Forall₂ (ValidDenseInput d) vs fs)
    (hfin : (zeroLocus L (generatedIdeal (fs.toFinset : Set (MvPolynomial (Fin M) k)))).Finite)
    (i : Fin M) : (eliminantCertificate d vs i).member = true := by
  rw [eliminantCertificate_member, coordinateFiniteCheck_correct d _ vs fs hv i]
  have hF : ∀ f ∈ fs.toFinset, f.totalDegree ≤ d :=
    fun f hf => valid_inputs_degree d vs fs hv f (List.mem_toFinset.mp hf)
  letI := Mathproof.Problem18BoundedGeometricDescent20260930.finiteDimensional_of_finite_geometric_locus
    (K := k) (L := L) _ hfin
  exact coordinate_relations_of_finrank_bound _ _
    ((Mathproof.Problem18BoundedGeometricDimension20260930.finite_geometric_quotient_uniform_finrank
      (K := k) (L := L) fs.toFinset d hF hfin).trans (le_max_right _ _)) i
def rowEntryLoop (B : ℕ) (i : Fin M) {D : ℕ} (r : Vector k D)
    (a : Fin (boundedExponents M B).length) : ℕ → k × ℕ
  | 0 => (0, 0)
  | e + 1 =>
    let t := rowEntryLoop B i r a e
    (t.1 + vget r e * read (powerRow B i e) a, t.2 + 2)
def frobeniusRowCounted (B D : ℕ) (i : Fin M) (r : Vector k D) : DenseInput M B k × ℕ :=
  countedOfFn _ fun a =>
    let t := rowEntryLoop B i r a D
    (t.1 - read (powerRow B i 1) a, t.2 + 1)
def frobeniusRow (B D : ℕ) (i : Fin M) (r : Vector k D) : DenseInput M B k :=
  (frobeniusRowCounted B D i r).1
theorem rowEntryLoop_value (B : ℕ) (i : Fin M) {D : ℕ} (r : Vector k D)
    (a : Fin (boundedExponents M B).length) (e : ℕ) :
    (rowEntryLoop B i r a e).1 = ∑ j ∈ Finset.range e, vget r j * read (powerRow B i j) a := by
  induction e with
  | zero => simp [rowEntryLoop]
  | succ e ih => simp only [rowEntryLoop, ih, Finset.sum_range_succ]
theorem rowEntryLoop_cost (B : ℕ) (i : Fin M) {D : ℕ} (r : Vector k D)
    (a : Fin (boundedExponents M B).length) (e : ℕ) : (rowEntryLoop B i r a e).2 = 2 * e := by
  induction e with
  | zero => rfl
  | succ e ih =>
    simp only [rowEntryLoop, ih]
    ring
theorem frobeniusRowCounted_cost (B D : ℕ) (i : Fin M) (r : Vector k D) :
    (frobeniusRowCounted B D i r).2 = (B + 1) ^ M * (2 * D + 1) := by
  unfold frobeniusRowCounted
  rw [countedOfFn_cost _ _ (2 * D + 1), boundedExponents_length]
  intro a
  simp only [rowEntryLoop_cost]
noncomputable def frobeniusPoly (i : Fin M) {D : ℕ} (r : Vector k D) : MvPolynomial (Fin M) k :=
  Polynomial.aeval (X i : MvPolynomial (Fin M) k) (residuePoly r) - X i
theorem frobeniusRow_read (B D : ℕ) (i : Fin M) (r : Vector k D) :
    read (frobeniusRow B D i r) = observePolynomial B (frobeniusPoly i r) := by
  rw [frobeniusPoly, map_sub, aeval_residuePoly, map_sum]
  funext a
  simp only [frobeniusRow, frobeniusRowCounted, countedOfFn_fst, read_ofFn, rowEntryLoop_value,
    map_smul, powerRow_read, pow_one, Pi.sub_apply, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
theorem frobeniusPoly_degree {D : ℕ} (hD : 0 < D) (i : Fin M) (r : Vector k D) :
    (frobeniusPoly i r).totalDegree ≤ D := by
  rw [frobeniusPoly, aeval_residuePoly]
  refine (totalDegree_sub _ _).trans (max_le ?_ ?_)
  · apply lowPowers_degree i D
    refine Submodule.sum_mem _ (fun e he => Submodule.smul_mem _ _ ?_)
    unfold lowPowers
    exact Submodule.subset_span ⟨⟨e, Finset.mem_range.mp he⟩, rfl⟩
  · rw [totalDegree_X]
    exact hD
theorem valid_of_read {B : ℕ} (v : DenseInput M B k) (p : MvPolynomial (Fin M) k)
    (hdeg : p.totalDegree ≤ B) (h : read v = observePolynomial B p) : ValidDenseInput B v p := by
  refine ⟨hdeg, fun a => ?_⟩
  have h1 := congrFun h a
  simp only [observePolynomial, LinearMap.coe_mk, AddHom.coe_mk] at h1
  exact h1
def rowCharge (M d : ℕ) : ℕ := (frobeniusDegree M d + 1) ^ M * (2 * eliminantDegree M d + 1)
def coordinateStep (Q d : ℕ) (vs : List (DenseInput M d k)) (i : Fin M) :
    Bool × DenseInput M (frobeniusDegree M d) k × ℕ :=
  let c := eliminantCertificate d vs i
  let cs := lowCoefficients (eliminantDegree M d) (macaulayRows d (eliminantShift M d) vs).length
    c.coefficients
  let r := frobeniusResidue cs.1 Q
  let row := frobeniusRowCounted (frobeniusDegree M d) (eliminantDegree M d) i r.1
  (c.member, row.1, c.fieldOps + cs.2 + r.2 + row.2)
def coordinateSteps (Q d : ℕ) (vs : List (DenseInput M d k)) :
    List (Bool × DenseInput M (frobeniusDegree M d) k × ℕ) :=
  (List.finRange M).map (coordinateStep Q d vs)
def frobeniusSystem (Q d : ℕ) (vs : List (DenseInput M d k)) :
    List (DenseInput M (frobeniusDegree M d) k) :=
  vs.map (targetRow d (frobeniusDegree M d)) ++ (coordinateSteps Q d vs).map (fun s => s.2.1)
def finiteRationalDecide (Q d : ℕ) (vs : List (DenseInput M d k)) : Bool × ℕ :=
  let steps := coordinateSteps Q d vs
  let ops := (steps.map fun s => s.2.2).sum
  if steps.all (fun s => s.1) then
    let g := geometricFeasible (frobeniusDegree M d)
      (vs.map (targetRow d (frobeniusDegree M d)) ++ steps.map (fun s => s.2.1))
    (g.1, ops + g.2)
  else (false, ops)
noncomputable def frobeniusPolys (Q d : ℕ) (vs : List (DenseInput M d k))
    (fs : List (MvPolynomial (Fin M) k)) : List (MvPolynomial (Fin M) k) :=
  fs ++ (List.finRange M).map fun i =>
    frobeniusPoly i (frobeniusResidue (eliminantCoefficients d vs i) Q).1
theorem frobeniusSystem_valid (Q d : ℕ) (vs : List (DenseInput M d k))
    (fs : List (MvPolynomial (Fin M) k)) (hv : List.Forall₂ (ValidDenseInput d) vs fs) :
    List.Forall₂ (ValidDenseInput (frobeniusDegree M d)) (frobeniusSystem Q d vs)
      (frobeniusPolys Q d vs fs) := by
  unfold frobeniusSystem frobeniusPolys
  have h1 : List.Forall₂ (ValidDenseInput (frobeniusDegree M d))
      (vs.map (targetRow d (frobeniusDegree M d))) fs := by
    rw [List.forall₂_map_left_iff]
    exact hv.imp (fun v f hvf => valid_of_read _ _ (hvf.1.trans (le_max_left _ _))
      (targetRow_correct d _ v f hvf))
  have h2 : List.Forall₂ (ValidDenseInput (frobeniusDegree M d))
      ((coordinateSteps Q d vs).map (fun s => s.2.1))
      ((List.finRange M).map fun i =>
        frobeniusPoly i (frobeniusResidue (eliminantCoefficients d vs i) Q).1) := by
    rw [coordinateSteps, List.map_map, List.forall₂_map_left_iff, List.forall₂_map_right_iff,
      List.forall₂_same]
    intro i _
    exact valid_of_read _ _
      ((frobeniusPoly_degree (eliminantDegree_pos M d) i _).trans (le_max_right _ _))
      (frobeniusRow_read (frobeniusDegree M d) (eliminantDegree M d) i
        (frobeniusResidue (eliminantCoefficients d vs i) Q).1)
  exact List.rel_append h1 h2
theorem finiteRationalDecide_fst (Q d : ℕ) (vs : List (DenseInput M d k)) :
    (finiteRationalDecide Q d vs).1 =
      ((coordinateSteps Q d vs).all (fun s => s.1) &&
        (geometricFeasible (frobeniusDegree M d) (frobeniusSystem Q d vs)).1) := by
  by_cases h : (coordinateSteps Q d vs).all (fun s => s.1) = true
  · simp [finiteRationalDecide, frobeniusSystem, h]
  · simp [finiteRationalDecide, h]
theorem coordinateSteps_all (Q d : ℕ) (vs : List (DenseInput M d k)) :
    (coordinateSteps Q d vs).all (fun s => s.1) = true ↔
      ∀ i, (eliminantCertificate d vs i).member = true := by
  simp [coordinateSteps, coordinateStep]
theorem aeval_generatedIdeal {L : Type*} [CommRing L] [Algebra k L] (x : Fin M → L)
    (fs : List (MvPolynomial (Fin M) k)) (hx : ∀ f ∈ fs, MvPolynomial.aeval x f = 0)
    (p : MvPolynomial (Fin M) k)
    (hp : p ∈ generatedIdeal (fs.toFinset : Set (MvPolynomial (Fin M) k))) :
    MvPolynomial.aeval x p = 0 := by
  have hle : generatedIdeal (fs.toFinset : Set (MvPolynomial (Fin M) k)) ≤
      RingHom.ker (MvPolynomial.aeval x).toRingHom := by
    unfold generatedIdeal
    apply Ideal.span_le.mpr
    intro f hf
    exact RingHom.mem_ker.mpr (hx f (List.mem_toFinset.mp (Finset.mem_coe.mp hf)))
  exact RingHom.mem_ker.mp (hle hp)
theorem aeval_aeval_X {L : Type*} [CommRing L] [Algebra k L] (x : Fin M → L) (i : Fin M)
    (p : Polynomial k) :
    MvPolynomial.aeval x (Polynomial.aeval (X i : MvPolynomial (Fin M) k) p) =
      Polynomial.aeval (x i) p := by
  rw [← Polynomial.aeval_algHom_apply, MvPolynomial.aeval_X]
theorem fixed_descends [Fintype k] {L : Type*} [Field L] [Algebra k L] [Algebra.IsAlgebraic k L]
    (x : L) (hx : x ^ Fintype.card k = x) : ∃ c : k, algebraMap k L c = x := by
  have hint : IsIntegral k x := Algebra.IsIntegral.isIntegral x
  haveI : FiniteDimensional k (IntermediateField.adjoin k {x}) :=
    IntermediateField.adjoin.finiteDimensional hint
  haveI : Finite (IntermediateField.adjoin k {x}) := Module.finite_of_finite (R := k)
  obtain ⟨c, hc⟩ := Mathproof.Problem18FiniteAlgebraSolver20260930.finite_field_fixed_descends
    (K := k) (⟨x, IntermediateField.mem_adjoin_simple_self k x⟩ : IntermediateField.adjoin k {x})
    (Subtype.ext (by simp [hx]))
  exact ⟨c, by simpa using congrArg Subtype.val hc⟩
theorem frobeniusPolys_roots [Fintype k] {L : Type*} [Field L] [Algebra k L]
    [Algebra.IsAlgebraic k L] (Q d : ℕ) (hQ : Q = Fintype.card k) (vs : List (DenseInput M d k))
    (fs : List (MvPolynomial (Fin M) k)) (hv : List.Forall₂ (ValidDenseInput d) vs fs)
    (hpass : ∀ i, (eliminantCertificate d vs i).member = true) :
    (∃ x : Fin M → L, ∀ f ∈ frobeniusPolys Q d vs fs, MvPolynomial.aeval x f = 0) ↔
      ∃ y : Fin M → k, ∀ f ∈ fs, MvPolynomial.eval y f = 0 := by
  have hD := eliminantDegree_pos M d
  constructor
  · rintro ⟨x, hx⟩
    have hfs : ∀ f ∈ fs, MvPolynomial.aeval x f = 0 :=
      fun f hf => hx f (List.mem_append_left _ hf)
    have hfix : ∀ i, x i ^ Fintype.card k = x i := by
      intro i
      have hm : Polynomial.aeval (x i) (modulus (eliminantCoefficients d vs i)) = 0 := by
        rw [← aeval_aeval_X x i]
        exact aeval_generatedIdeal x fs hfs _ (eliminant_mem d vs fs hv i (hpass i))
      have hr := frobenius_eval hD (eliminantCoefficients d vs i) Q (x i) hm
      have hrow := hx (frobeniusPoly i (frobeniusResidue (eliminantCoefficients d vs i) Q).1)
        (List.mem_append_right _ (List.mem_map.mpr ⟨i, List.mem_finRange i, rfl⟩))
      rw [frobeniusPoly, map_sub, aeval_aeval_X, MvPolynomial.aeval_X, hr, sub_eq_zero] at hrow
      rw [← hQ]
      exact hrow
    choose y hy using fun i => fixed_descends (x i) (hfix i)
    refine ⟨y, fun f hf => ?_⟩
    have h0 := hfs f hf
    rw [show x = algebraMap k L ∘ y from funext fun i => (hy i).symm,
      MvPolynomial.aeval_algebraMap_apply] at h0
    exact (map_eq_zero_iff (algebraMap k L) (algebraMap k L).injective).mp h0
  · rintro ⟨y, hy⟩
    refine ⟨algebraMap k L ∘ y, fun f hf => ?_⟩
    have hfs : ∀ g ∈ fs, MvPolynomial.aeval (algebraMap k L ∘ y) g = 0 := by
      intro g hg
      rw [MvPolynomial.aeval_algebraMap_apply]
      have hg0 : MvPolynomial.aeval y g = 0 := hy g hg
      rw [hg0, map_zero]
    rcases List.mem_append.mp hf with hf | hf
    · exact hfs f hf
    · obtain ⟨i, _, rfl⟩ := List.mem_map.mp hf
      have hm : Polynomial.aeval ((algebraMap k L ∘ y) i)
          (modulus (eliminantCoefficients d vs i)) = 0 := by
        rw [← aeval_aeval_X (algebraMap k L ∘ y) i]
        exact aeval_generatedIdeal _ fs hfs _ (eliminant_mem d vs fs hv i (hpass i))
      rw [frobeniusPoly, map_sub, aeval_aeval_X, MvPolynomial.aeval_X,
        frobenius_eval hD _ Q _ hm, hQ, Function.comp_apply, ← map_pow, FiniteField.pow_card,
        sub_self]
theorem finiteRationalDecide_correct [Fintype k] {L : Type*} [Field L] [Algebra k L]
    [IsAlgClosed L] [Algebra.IsAlgebraic k L] (Q d : ℕ) (hQ : Q = Fintype.card k)
    (vs : List (DenseInput M d k)) (fs : List (MvPolynomial (Fin M) k))
    (hv : List.Forall₂ (ValidDenseInput d) vs fs)
    (hfin : (zeroLocus L (generatedIdeal (fs.toFinset : Set (MvPolynomial (Fin M) k)))).Finite) :
    (finiteRationalDecide Q d vs).1 = true ↔ ∃ y : Fin M → k, ∀ f ∈ fs, MvPolynomial.eval y f = 0 := by
  have hpass := gate_of_finite d vs fs hv hfin
  have hall : (coordinateSteps Q d vs).all (fun s => s.1) = true :=
    (coordinateSteps_all Q d vs).mpr hpass
  rw [finiteRationalDecide_fst, hall, Bool.true_and,
    geometricFeasible_correct (L := L) _ _ _ (frobeniusSystem_valid Q d vs fs hv)]
  exact frobeniusPolys_roots (L := L) Q d hQ vs fs hv hpass
def eliminantRowBound (M d s : ℕ) : ℕ := s * (eliminantShift M d + 1) ^ M + eliminantDegree M d
def eliminantColumns (M d : ℕ) : ℕ := (d + eliminantShift M d + 1) ^ M
def certificateBound (M d s : ℕ) : ℕ :=
  2 * eliminantRowBound M d s * eliminantColumns M d +
    (4 * eliminantColumns M d + 2 * eliminantRowBound M d s + 2) * eliminantRowBound M d s ^ 2 +
    eliminantColumns M d + eliminantRowBound M d s
def feasibilityRows (M d s : ℕ) : ℕ :=
  (s + M) * (2 * frobeniusDegree M d * 2 ^ controlledDepth M (frobeniusDegree M d) + 1) ^ M
def feasibilityColumns (M d : ℕ) : ℕ :=
  (frobeniusDegree M d + 2 * frobeniusDegree M d * 2 ^ controlledDepth M (frobeniusDegree M d) + 1) ^ M
def feasibilityBound (M d s : ℕ) : ℕ :=
  feasibilityRows M d s * feasibilityColumns M d +
    (2 * feasibilityColumns M d + 1) * feasibilityRows M d s ^ 2 + feasibilityColumns M d + 1
def coordinateFixedCost (M d s : ℕ) : ℕ :=
  certificateBound M d s + 3 * eliminantDegree M d + rowCharge M d
def coordinateSlopeCost (M d : ℕ) : ℕ := 8 * eliminantDegree M d * eliminantDegree M d
def decisionConstant (M d s : ℕ) : ℕ :=
  M * coordinateFixedCost M d s + M * coordinateSlopeCost M d + feasibilityBound M d s
theorem coordinateStep_cost (Q d : ℕ) (vs : List (DenseInput M d k)) (s : ℕ)
    (hs : vs.length ≤ s) (i : Fin M) :
    (coordinateStep Q d vs i).2.2 ≤ coordinateFixedCost M d s + coordinateSlopeCost M d * Nat.size Q := by
  have hn : (eliminantRows d vs i).length ≤ eliminantRowBound M d s := by
    simp only [eliminantRows, List.length_append, macaulayRows_length, lowPowerRows,
      List.length_map, List.length_range, eliminantRowBound]
    exact Nat.add_le_add_right (Nat.mul_le_mul hs (multiplierExponents_length_le _)) _
  have hcert : (eliminantCertificate d vs i).fieldOps ≤ certificateBound M d s := by
    refine (arrayCertificate_cost (eliminantRows d vs i)
      (powerRow (d + eliminantShift M d) i (eliminantDegree M d))).trans ?_
    generalize (eliminantRows d vs i).length = L at hn ⊢
    rw [boundedExponents_length]
    unfold certificateBound eliminantColumns
    gcongr
  have hres := frobeniusResidue_cost (eliminantCoefficients d vs i) Q
  have hstep : (coordinateStep Q d vs i).2.2 = (eliminantCertificate d vs i).fieldOps +
      (lowCoefficients (eliminantDegree M d) (macaulayRows d (eliminantShift M d) vs).length
        (eliminantCertificate d vs i).coefficients).2 +
      (frobeniusResidue (eliminantCoefficients d vs i) Q).2 +
      (frobeniusRowCounted (frobeniusDegree M d) (eliminantDegree M d) i
        (frobeniusResidue (eliminantCoefficients d vs i) Q).1).2 := rfl
  rw [hstep, lowCoefficients_cost, frobeniusRowCounted_cost]
  unfold coordinateFixedCost coordinateSlopeCost rowCharge
  nlinarith [hcert, hres]
theorem feasibility_cost (Q d : ℕ) (vs : List (DenseInput M d k)) (s : ℕ) (hs : vs.length ≤ s) :
    (geometricFeasible (frobeniusDegree M d) (frobeniusSystem Q d vs)).2 ≤ feasibilityBound M d s := by
  have hg := geometricFeasible_elimination_cost (frobeniusDegree M d) (frobeniusSystem Q d vs)
  dsimp only at hg
  have hlen : (frobeniusSystem Q d vs).length = vs.length + M := by
    simp [frobeniusSystem, coordinateSteps]
  have hr : (frobeniusSystem Q d vs).length * (multiplierExponents M
      (2 * frobeniusDegree M d * 2 ^ controlledDepth M (frobeniusDegree M d))).length ≤
        feasibilityRows M d s := by
    rw [hlen]
    exact Nat.mul_le_mul (by omega) (multiplierExponents_length_le _)
  refine hg.trans ?_
  unfold feasibilityBound feasibilityColumns
  gcongr
theorem finiteRationalDecide_cost (Q d : ℕ) (vs : List (DenseInput M d k)) (s : ℕ)
    (hs : vs.length ≤ s) :
    (finiteRationalDecide Q d vs).2 ≤ decisionConstant M d s * (Nat.size Q + 1) := by
  have hops : ((coordinateSteps Q d vs).map fun t => t.2.2).sum ≤
      M * coordinateFixedCost M d s + M * coordinateSlopeCost M d * Nat.size Q := by
    have h := List.sum_le_card_nsmul ((coordinateSteps Q d vs).map fun t => t.2.2)
      (coordinateFixedCost M d s + coordinateSlopeCost M d * Nat.size Q) (by
        intro x hx
        simp only [coordinateSteps, List.map_map, List.mem_map, List.mem_finRange, true_and,
          Function.comp_apply] at hx
        obtain ⟨i, rfl⟩ := hx
        exact coordinateStep_cost Q d vs s hs i)
    simp only [coordinateSteps, List.length_map, List.length_finRange, smul_eq_mul] at h
    calc _ ≤ M * (coordinateFixedCost M d s + coordinateSlopeCost M d * Nat.size Q) := h
      _ = _ := by ring
  have hfeas := feasibility_cost Q d vs s hs
  by_cases hg : (coordinateSteps Q d vs).all (fun t => t.1) = true
  · have he : (finiteRationalDecide Q d vs).2 =
        ((coordinateSteps Q d vs).map fun t => t.2.2).sum +
          (geometricFeasible (frobeniusDegree M d) (frobeniusSystem Q d vs)).2 := by
      simp [finiteRationalDecide, frobeniusSystem, hg]
    rw [he]
    unfold decisionConstant
    nlinarith [hops, hfeas, Nat.zero_le (M * coordinateFixedCost M d s * Nat.size Q),
      Nat.zero_le (M * coordinateSlopeCost M d), Nat.zero_le (feasibilityBound M d s * Nat.size Q)]
  · have he : (finiteRationalDecide Q d vs).2 =
        ((coordinateSteps Q d vs).map fun t => t.2.2).sum := by
      simp [finiteRationalDecide, hg]
    rw [he]
    unfold decisionConstant
    nlinarith [hops, Nat.zero_le (M * coordinateFixedCost M d s * Nat.size Q),
      Nat.zero_le (M * coordinateSlopeCost M d), Nat.zero_le (feasibilityBound M d s * Nat.size Q),
      Nat.zero_le (feasibilityBound M d s)]
theorem finiteRationalDecide_cost_card [Fintype k] (d : ℕ) (vs : List (DenseInput M d k))
    (s : ℕ) (hs : vs.length ≤ s) :
    (finiteRationalDecide (Fintype.card k) d vs).2 ≤
      decisionConstant M d s * (Nat.size (Fintype.card k) + 1) :=
  finiteRationalDecide_cost (Fintype.card k) d vs s hs
end Mathproof.Problem18FiniteParameterDecision20261001
