theorem embeddingOrbit_isometric (B : Form σ V) (C : Form σ W)
    (j : EmbeddingOrbit σ B C) : ∀ x y,(sumForm σ B C) (j.val x) (j.val y)=B x y := by
  obtain ⟨Q,hQ⟩ := j.property
  rw [← hQ]
  intro x y
  have h := Q.property (x,0) (y,0)
  simpa only [restriction,LinearMap.comp_apply,LinearMap.inl_apply,LinearEquiv.coe_coe,
    sumForm_apply,map_zero,LinearMap.zero_apply,add_zero] using h
theorem embeddingOrbit_of_same_range (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingLeft) (j₀ : EmbeddingOrbit σ B C)
    (j : IsometricEmbeddings σ B (sumForm σ B C))
    (hr : LinearMap.range j.val=LinearMap.range j₀.val) :
    j.val ∈ Set.range (restriction σ B C) := by
  let i₀ : IsometricEmbeddings σ B (sumForm σ B C) :=
    ⟨j₀.val,embeddingOrbit_isometric σ B C j₀⟩
  let U := sameRangeIsometry σ B (sumForm σ B C) hB i₀ j hr
  obtain ⟨Q,hQ⟩ := j₀.property
  let L : Isometries σ (sumForm σ B C) :=
    ⟨U.val.prodCongr (LinearEquiv.refl K W),by
      rintro ⟨x,z⟩ ⟨y,w⟩
      change B (U.val x) (U.val y)+C z w=B x y+C z w
      rw [U.property]⟩
