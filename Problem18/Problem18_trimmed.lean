namespace Mathproof.Problem18AffinePoleAvoidance20261001
open FunctionField FunctionField.Chart MvPolynomial
open Mathproof.Problem18MonicFunctionFieldPoleBound20260930
open Mathproof.Problem18AffinePlaceSpecialization20261001
open scoped Polynomial RatFunc WithZero BigOperators
variable (k F : Type*) [Field k] [Field F]
variable [Algebra k F] [Algebra k[X] F] [Algebra k⟮X⟯ F]
  [IsScalarTower k k[X] F] [IsScalarTower k[X] k⟮X⟯ F]
  [_root_.FunctionField k F] [Algebra.IsSeparable k⟮X⟯ F]
  [FunctionField.IsFullConstantField k F]
theorem effective_support_card_le_degree (D : DivisorA k F) (hD : 0 ≤ D) :
    (D.support.card : ℤ) ≤ deg k F D := by
  classical
  calc
    (D.support.card : ℤ) = ∑ v ∈ D.support, (1 : ℤ) := by simp
    _ ≤ ∑ v ∈ D.support, D v * (placeDegree k F v : ℤ) := by
      apply Finset.sum_le_sum
      intro v hv
      have hc : 1 ≤ D v := by
        have hn := Finsupp.mem_support_iff.mp hv
        have hp := hD v
        change 0 ≤ D v at hp
        omega
      have hd : (1 : ℤ) ≤ placeDegree k F v := by
        exact_mod_cast placeDegree_pos k F v
      nlinarith
    _ = deg k F D := rfl
theorem exists_rational_chart_outside (D : DivisorA k F) (hD : 0 ≤ D)
    (hcount : deg k F D < (Nat.card {P : Place k F // P.degree = 1} : ℤ)) :
    ∃ v : PlaceA k F, placeDegree k F v = 1 ∧ v ∉ D.support := by
  classical
  by_contra h
  push_neg at h
  let f : {P : Place k F // P.degree = 1} → D.support := fun P =>
    ⟨(chartToPlace k F).symm P.val, h _ (by rw [placeDegree_eq, Equiv.apply_symm_apply]; exact P.property)⟩
  have hf : Function.Injective f := by
    intro P Q he
    apply Subtype.ext
    apply (chartToPlace k F).symm.injective
    exact congrArg Subtype.val he
  have hc : Nat.card {P : Place k F // P.degree = 1} ≤ D.support.card := by
    simpa only [Nat.card_eq_fintype_card, Fintype.card_coe] using Nat.card_le_card_of_injective f hf
  have hs := effective_support_card_le_degree k F D hD
  have hcZ : (Nat.card {P : Place k F // P.degree = 1} : ℤ) ≤ D.support.card := by
    exact_mod_cast hc
  omega
theorem affine_point_of_pole_count {ι : Type*} (y : ι → F)
    (D : DivisorA k F) (hD : 0 ≤ D) (hy : ∀ i, polarDivisor k F (y i) ≤ D)
    (S : Set (MvPolynomial ι k)) (hS : ∀ f ∈ S, aeval y f = 0)
    (hcount : deg k F D < (Nat.card {P : Place k F // P.degree = 1} : ℤ)) :
    ∃ x : ι → k, ∀ f ∈ S, eval x f = 0 := by
  obtain ⟨v, hv, hout⟩ := exists_rational_chart_outside k F D hD hcount
  apply rational_point_of_regular_place (chartToPlace k F v)
    (by rwa [← placeDegree_eq]) y ?_ S hS
  intro i
  change y i ∈ (placeValuation k F v).valuationSubring
  rw [Valuation.mem_valuationSubring_iff]
  have hzero : D v = 0 := Finsupp.notMem_support_iff.mp hout
  calc
    placeValuation k F v (y i) ≤ WithZero.exp (polarDivisor k F (y i) v) :=
      valuation_le_exp_polar k F (y i) v
    _ ≤ WithZero.exp (D v) := WithZero.exp_le_exp.mpr (hy i v)
    _ = 1 := by rw [hzero, WithZero.exp_zero]
end Mathproof.Problem18AffinePoleAvoidance20261001
end
end
