    have hziso : Z≤Z.orthogonalBilin C := isotropic_transport σ B C e he U hiu
    refine ⟨⟨Z,hzdim,?_⟩,hZ,hχ.trans hcu⟩
    intro x hx y hy
    exact hziso hy x hx⟩
  have hf : Function.Injective f := by
    intro S T heq
    apply Subtype.ext
    apply E.injective
    exact congrArg Subtype.val heq
  have hcount := Nat.card_le_card_of_injective f hf
  have hb := Mathproof.Problem18GeneralIsotropicPrimaryUnion20261001.isotropic_primary_union_bound
    σ (1:K) (fun _=>rfl) (by simp) C hnC (fun x y=>by simpa only [σ,one_mul,RingEquiv.refl_apply] using hsC x y)
    h hm hi hd
  rw [diagonalSpace_id_card] at hb
  have hs : Nat.card (Mathproof.Problem18SelfAdjointCoordinateRestriction20260930.selfAdjointSpace σ C)=
