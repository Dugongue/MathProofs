      x ≠ canonical.i := by
  decide
theorem canonical_i_ne_flag : canonical.i ≠ canonical.flag := by decide
theorem canonical_regs_ne :
    ∀ x ∈ [canonical.p, canonical.e, canonical.aBase, canonical.bBase],
      x ≠ canonical.i ∧ x ≠ canonical.flag := by
  decide
theorem e_lt {B : Nat} {σ : Env} (h : MacroInput F canonical B σ) : σ.vars canonical.e < B := by
  rw [h.degree]
  have h1 := h.scratch_fit
  have h2 := h.scratch_word
  omega
theorem p_pos {B : Nat} {σ : Env} (h : MacroInput F canonical B σ) : 0 < σ.vars canonical.p := by
  rw [h.prime]; exact F.prime.pos
theorem arith {B : Nat} {σ : Env} (h : MacroInput F canonical B σ) :
    (σ.vars canonical.p + 1) ^ 2 < B := by
  rw [h.prime]; exact h.arithmetic_word
theorem coeffA {B : Nat} {σ : Env} (h : MacroInput F canonical B σ) :
    ∀ j < σ.vars canonical.e, (σ.arrs canonical.mem).getD (σ.vars canonical.aBase + j) 0 < σ.vars canonical.p := by
  intro j hj
  rw [h.degree] at hj
  rw [h.prime]
  exact h.first_canonical ⟨j, hj⟩
theorem coeffB {B : Nat} {σ : Env} (h : MacroInput F canonical B σ) :
    ∀ j < σ.vars canonical.e, (σ.arrs canonical.mem).getD (σ.vars canonical.bBase + j) 0 < σ.vars canonical.p := by
  intro j hj
  rw [h.degree] at hj
  rw [h.prime]
  exact h.second_canonical ⟨j, hj⟩
theorem coeffMod {B : Nat} {σ : Env} (h : MacroInput F canonical B σ) :
    ∀ j < σ.vars canonical.e, (σ.arrs canonical.mem).getD (σ.vars canonical.modBase + j) 0 < σ.vars canonical.p := by
  intro j hj
  rw [h.degree] at hj
  rw [h.prime, h.modulus_value ⟨j, hj⟩]
  exact (F.modulus ⟨j, hj⟩).isLt
