def workFormula {R : Type*} [CommSemiring R] (b c qs bs : R) : R :=
  let rem := b+2+2*(b+1)*(b+1)
  let mod := 100*(b+2)*(b+2)
  let scalarDet := b*(b*b*(3*b+3))+b+1
  let polyDet := b*(b*b*(20*(b+1)*(b+1+2)*(b+1+2)))+b+2*(b+1)*(b+1)
  let krylov := b*b*(bs*(4*b*b*b)+2*b)
  let regular := (b+1)*(b+1)+(b+1)*rem+3
  let frob := 2*bs+(b*qs+2)*mod+2*(b+1)+(b+1)*rem
  let division := (b+1)+(b+1)*(3*(b+1)+1)+(b+1)+2
  let degree := frob+division+(b+1)*(2*b*b*b+b*b)+2*bs+(b*qs+1)*(4*b*b*b)+1+b*b+2*b*b*b+b*b
  4*b*c*b+2*(3*b*b+polyDet)+regular+2*(krylov+scalarDet)+
    (2*krylov+scalarDet+1+b*b*(scalarDet+1)+2*b*b*b)+2*b*b*b+b*degree+(b+1)+6
theorem trialBudget_eq_formula (b c q : ℕ) :
    trialBudget b c q=workFormula b c q.size b.size := rfl
end Mathproof.Problem18BoundaryTrialPolynomial20261001
end
