  | .seq c d => .seq (iso I c) (iso I d)
  | .ite b c d => .ite (renC I.ren b) (iso I c) (iso I d)
  | .while b c => .while (renC I.ren b) (iso I c)
  | .read x => .seq (.assign (I.ren x) (.get I.tin (.var I.pin)))
      (.assign I.pin (.bin .add (.var I.pin) (.lit 1)))
