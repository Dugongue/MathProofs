namespace Mathproof.Problem18RootRetainedValidatorIMP20261001
open Lax13Proofs.Imp Lax13Proofs.Reasoning Lax13Proofs.Compile
open Problem18IMPPolynomialCompiler20261001 Problem18RootParser20261001
open Lax51.BinaryWordEncoding Lax51.RamPolytime
def echoRead (x : String) : Com := .seq (.read x) (.write (.var x))
def readFields : List String → Com
  | []=>.skip
  | x::xs=>.seq (echoRead x) (readFields xs)
def readEnv : List String → List Nat → Env → Env
  | x::xs,v::vs,σ=>readEnv xs vs {σ.setVar x v with inp:=vs}
  | _,_,σ=>σ
theorem readEnv_out (ns : List String) (ws : List Nat) (τ : Env) (o : List Nat) :
    readEnv ns ws {τ with out:=o}={readEnv ns ws τ with out:=o} := by
  induction ns generalizing ws τ with
  | nil=>rfl
  | cons n ns ih=>cases ws with
    | nil=>rfl
    | cons w ws=>exact ih ws {τ.setVar n w with inp:=ws}
theorem readFields_run (names : List String) (values : List Nat) (σ : Env)
    (h : names.length≤values.length) (hi : σ.inp=values) (B : Nat)
    (hv : ∀v∈values,v<B) :
    Run B (readFields names) σ
      {readEnv names values σ with out:=σ.out++values.take names.length}
      (3*names.length+1) := by
  induction names generalizing values σ with
  | nil=>simpa [readFields,readEnv] using (Run.skip (B:=B) (σ:=σ))
  | cons x xs ih=>
    cases values with
    | nil=>simp at h
    | cons v vs=>
      let σ₁ : Env:={σ.setVar x v with inp:=vs}
      let σ₂ : Env:={σ₁ with out:=σ.out++[v]}
      have hr : Run B (.read x) σ σ₁ 1:=Run.read hi
      have hw : Run B (.write (.var x)) σ₁ σ₂ 2:=by
        apply Run.write
        simpa [σ₁] using (evalB_var (σ:=σ₁) (x:=x) (by simpa [σ₁] using hv v (by simp)))
      have ht:=ih vs σ₂ (by simpa using h) rfl (fun w hw=>hv w (by simp [hw]))
      have hrun:=(hr.seq hw).seq ht
      have he : {readEnv xs vs σ₂ with out:=σ₂.out++vs.take xs.length} =
          {readEnv (x::xs) (v::vs) σ with out:=σ.out++(v::vs).take (x::xs).length} := by
        dsimp only [σ₂]
        rw [readEnv_out]
        simp only [readEnv,List.length_cons,List.take_succ_cons]
        simp [σ₁,List.append_assoc]
      rw [he] at hrun
      exact hrun.mono (by simp only [List.length_cons]; omega)
def scanBody : Com := .seq (echoRead "v")
  (.seq (.assign "left" (.sub (.var "left") (.lit 1)))
    (.ite (.lt (.var "v") (.var "p")) .skip (.assign "ok" (.lit 0))))
def scan : Com := .while (.lt (.lit 0) (.var "left")) scanBody
theorem scan_run (B p : Nat) (xs : List Nat) (σ : Env)
    (hB : 1<B) (hp : p<B) (hi : σ.inp=xs) (hl : σ.vars "left"=xs.length)
    (hpp : σ.vars "p"=p) (hlen : xs.length<B) (hv : ∀v∈xs,v<B) :
    ∃τ,Run B scan σ τ (30*xs.length+10) ∧
      τ.vars "ok"=(if ∀v∈xs,v<p then σ.vars "ok" else 0) ∧
      τ.vars "p"=p ∧ τ.vars "left"=0 ∧ τ.out=σ.out++xs := by
  induction xs generalizing σ with
  | nil=>
    have hc : (Cond.lt (.lit 0) (.var "left")).evalB B σ=some false := by
      simp [evalB_condLt_iff,hl]; omega
    refine ⟨σ,(Run.while_false hc).mono ?_,?_,hpp,hl,(by simp)⟩
    · simp [Cond.size,Expr.size]
    · simp
  | cons v xs ih=>
    let σ₀ : Env:={σ.setVar "v" v with inp:=xs}
    let σ₁ : Env:={σ₀ with out:=σ.out++[v]}
    let σ₂ := σ₁.setVar "left" xs.length
    let σ₃ := if v<p then σ₂ else σ₂.setVar "ok" 0
    have hlen' : xs.length+1<B := by simpa using hlen
    have hread : Run B (.read "v") σ σ₀ 1:=Run.read hi
    have hwrite : Run B (.write (.var "v")) σ₀ σ₁ 2 :=
      Run.write (evalB_var (by simpa [σ₀] using hv v (by simp)))
    have hr : Run B (echoRead "v") σ σ₁ 3:=hread.seq hwrite
    have hd : (Expr.sub (.var "left") (.lit 1)).evalB B σ₁=some xs.length := by
      simp [evalB_bin_iff,σ₁,σ₀,hl,Bop.apply]; omega
    have hdec:=Run.assign (x:="left") hd
    have htest : (Cond.lt (.var "v") (.var "p")).evalB B σ₂=some (decide (v<p)) := by
      simp [evalB_condLt_iff,σ₂,σ₁,σ₀,hpp,hp,hv v (by simp)]
    have hb : Run B scanBody σ σ₃ 20 := by
      by_cases h : v<p
      · have hh:=(hr.seq (hdec.seq (Run.ite_true (b:=.lt (.var "v") (.var "p")) (d:=.assign "ok" (.lit 0))
          (by simpa only [h,decide_true] using htest) (Run.skip (B:=B) (σ:=σ₂)))))
        simpa only [scanBody,σ₃,if_pos h] using hh.mono (by simp [Expr.size,Cond.size] : _≤20)
      · have ha:=Run.assign (x:="ok") (σ:=σ₂) (evalB_lit (by omega : 0<B))
        have hh:=hr.seq (hdec.seq (Run.ite_false (b:=.lt (.var "v") (.var "p")) (c:=.skip) (by simpa only [h,decide_false] using htest) ha))
        simpa only [scanBody,σ₃,if_neg h] using hh.mono (by simp [Expr.size,Cond.size] : _≤20)
    have hleft : σ₃.vars "left"=xs.length := by by_cases h : v<p <;> simp [σ₃,σ₂,σ₁,σ₀,h]
    have hp₃ : σ₃.vars "p"=p := by by_cases h : v<p <;> simp [σ₃,σ₂,σ₁,σ₀,h,hpp]
    have hin : σ₃.inp=xs := by by_cases h : v<p <;> simp [σ₃,σ₂,σ₁,σ₀,h]
    obtain ⟨τ,ht,hok,hpt,hlt,hout⟩:=ih σ₃ hin hleft hp₃ (by simp at hlen; omega)
      (fun w hw=>hv w (by simp [hw]))
    have hc : (Cond.lt (.lit 0) (.var "left")).evalB B σ=some true := by
      simp [evalB_condLt_iff,hl,hlen]; omega
    have hw : Run B scan σ τ (1+(Cond.lt (.lit 0) (.var "left")).size+20+(30*xs.length+10)) := by
      obtain ⟨k,hk,hk'⟩:=hb
      obtain ⟨t,ht',ht''⟩:=ht
      exact ⟨_,by omega,BigStepB.while_true hc hk' ht''⟩
    refine ⟨τ,hw.mono (by simp [Cond.size,Expr.size]; omega),?_,hpt,hlt,?_⟩
    · rw [hok]
      by_cases h : v<p <;> by_cases hs : ∀w∈xs,w<p <;> simp [σ₃,σ₂,σ₁,σ₀,h,hs]
    · by_cases h : v<p <;> simpa [σ₃,σ₂,σ₁,σ₀,h,List.append_assoc] using hout
end Mathproof.Problem18RootRetainedValidatorIMP20261001
