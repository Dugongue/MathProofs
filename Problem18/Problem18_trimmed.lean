variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}
def prevE (W : Expr) (j : String) : Expr := .bin .sub (plus W (.var j)) (.lit 1)
def mulXBody (M : FieldMacros F r) (q : RNames) (j : String) (C W O : Expr) (D T : ℕ) : Com :=
  .seq (mcall r q M.mul (plus C (.var j)) (plus W (.lit (D - 1))) (.lit T))
    (.seq (mcall r q M.sub (prevE W j) (.lit T) (plus O (.var j)))
