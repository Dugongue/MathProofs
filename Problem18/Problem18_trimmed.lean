theorem candidate_rows {n m : ℕ} (S : Fin m→Matrix (Fin n) (Fin n) K)
    (vs : List (Vector K (n*n))) (g : ℕ→K)
    (hp : ∀i (hi:i < vs.length) (k:Fin (n*n)),g (inStart (n*n) i+k.val)=read (vs[i]'hi) k)
    (ht : ∀i (hi:i < vs.length) (j:Fin m),
