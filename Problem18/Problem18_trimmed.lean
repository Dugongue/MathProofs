theorem segCopySame_run {a idx cnt sb db : String}
    (hic : idx≠cnt) (his : idx≠sb) (hid : idx≠db)
    {B n sourceBase targetBase : Nat} (sigma : Env)
    (hn : n<B) (hcount : sigma.vars cnt=n)
    (hsource : sigma.vars sb=sourceBase)
    (htarget : sigma.vars db=targetBase)
    (hsourceB : sourceBase+n<B) (htargetB : targetBase+n<B)
    (hfitSource : sourceBase+n≤(sigma.arrs a).length)
    (hfitTarget : targetBase+n≤(sigma.arrs a).length)
    (hdisj : sourceBase+n ≤ targetBase ∨ targetBase+n ≤ sourceBase)
    (hword : ∀k<n,(sigma.arrs a).getD (sourceBase+k) 0<B) :
    ∃tau,Run B (segCopy a a idx cnt sb db) sigma tau (20*n+6) ∧
      (∀k<n,(tau.arrs a).getD (targetBase+k) 0=
        (sigma.arrs a).getD (sourceBase+k) 0) ∧
      (∀k,(k<targetBase ∨ targetBase+n≤k) →
        (tau.arrs a).getD k 0=(sigma.arrs a).getD k 0) ∧
      (∀b,b≠a→ tau.arrs b=sigma.arrs b) ∧
      ((tau.arrs a).length=(sigma.arrs a).length) ∧
      (∀x,x≠idx→ tau.vars x=sigma.vars x) ∧
      tau.inp=sigma.inp ∧ tau.out=sigma.out := by
  let I : Env→ Prop:=fun rho=>rho.vars idx≤n ∧ rho.vars cnt=n ∧
    rho.vars sb=sourceBase ∧ rho.vars db=targetBase ∧
    (∀b,b≠a→  rho.arrs b=sigma.arrs b) ∧
    (rho.arrs a).length=(sigma.arrs a).length ∧
    (∀k< rho.vars idx,
      (rho.arrs a).getD (targetBase+k) 0=
        (sigma.arrs a).getD (sourceBase+k) 0) ∧
    (∀k,(k<targetBase ∨ targetBase+rho.vars idx≤k)→
      (rho.arrs a).getD k 0=(sigma.arrs a).getD k 0) ∧
    (∀x,x≠idx→  rho.vars x=sigma.vars x) ∧ rho.inp=sigma.inp ∧ rho.out=sigma.out
  let V : Env→ Nat:=fun rho=>n-rho.vars idx
  have hdef : ∀rho,I rho →
      ∃v,(Cond.lt (.var idx) (.var cnt)).evalB B rho=some v := by
    intro rho h
    exact evalB_condLt_vars (by have:=h.1;omega) (by rw [h.2.1];exact hn)
  have hstep : ∀rho,I rho →
      (Cond.lt (.var idx) (.var cnt)).evalB B rho=some true →
