  rw [canonicalQuadratic_eq_strict]
  simp [altToStrict, strictQuadratic]
theorem nontrivial_character_energy_eq {a b : ℕ}
    (E : Submodule K (Fin a → Fin b → K))
    (ψ : AddChar K ℂ) (hψ : ψ ≠ 1) (m : ℕ) :
    (∑ χ : AddChar (SymMat b K) ℂ, if χ = 1 then 0 else
      (‖(∑ x : E, χ (repeatedGram E x)) / (Fintype.card E : ℂ)‖^2)^m) =
    (∑ A : {A : AltMat b K // A.val.rank ≠ 0},
      ∑ z : Fin b → K, completionEnergy E ψ (canonicalQuadratic A.val) z m) +
    ∑ z : {z : Fin b → K // z ≠ 0}, completionEnergy E ψ 0 z.val m := by
  let e := Equiv.ofBijective (upperCharacter (n := b) ψ)
    (upperCharacter_bijective ψ hψ)
  rw [← Equiv.sum_comp e, Fintype.sum_prod_type]
  simp only [e, Equiv.ofBijective_apply, upperCharacter_eq_one ψ hψ,
    Prod.mk.injEq, upperCharacter_repeatedGram]
  rw [← Equiv.sum_comp (strictAltEquiv (K := K) b).symm]
  have heq (A : AltMat b K) :
      (strictAltEquiv (K := K) b).symm A = 0 ↔ A = 0 := by
    change altToStrict A = 0 ↔ A = 0
    constructor
    · intro h
      apply altToStrict_injective
      exact h.trans (show (0 : StrictPair b → K) = altToStrict (0 : AltMat b K) from rfl)
    · rintro rfl
      rfl
  simp only [heq]
  have hquad (A : AltMat b K) :
      strictQuadratic ((strictAltEquiv (K := K) b).symm A) = canonicalQuadratic A := by
    exact (canonicalQuadratic_eq_strict A).symm
  simp only [hquad]
  change (∑ A : AltMat b K, ∑ z : Fin b → K,
    if A = 0 ∧ z = 0 then 0 else completionEnergy E ψ (canonicalQuadratic A) z m) = _
  have hsplit (A : AltMat b K) :
      (∑ z : Fin b → K, if A = 0 ∧ z = 0 then 0 else
        completionEnergy E ψ (canonicalQuadratic A) z m) =
      if A = 0 then (∑ z : {z : Fin b → K // z ≠ 0}, completionEnergy E ψ 0 z.val m)
      else ∑ z : Fin b → K, completionEnergy E ψ (canonicalQuadratic A) z m := by
    by_cases hA : A = 0
    · subst A
      simp only [true_and, canonicalQuadratic_zero, if_true]
      simpa using sum_if_zero (fun _ : Fin b → K => (0 : ℝ))
        (fun z => completionEnergy E ψ 0 z m)
    · simp [hA]
  simp_rw [hsplit]
  rw [sum_if_zero, add_comm]
  congr 1
  apply Fintype.sum_equiv (Equiv.subtypeEquivRight (fun A => not_congr (alt_rank_eq_zero_iff A))).symm
  intro A
  rfl
theorem conditioned_character_energy_average_le
    (a b d : ℕ) (ha : 2 ≤ a) (hb : 8 ≤ b) (hdb : 64*d ≤ b)
    (ψ : AddChar K ℂ) (hψ : ψ ≠ 1) :
    (∑ g : InjectiveSample K (Module.Dual K (Fin a → Fin b → K)) d,
      ∑ χ : AddChar (SymMat b K) ℂ, if χ = 1 then 0 else
