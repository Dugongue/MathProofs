      Nat.card {U : Matrix.unitaryGroup (Fin (n+1)) K // unitaryColumn U=v}=
        Nat.card (Matrix.unitaryGroup (Fin n) K) :=
    Nat.card_congr (columnFiberEquiv hcard hstar n v)
