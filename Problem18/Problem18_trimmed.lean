    (mul_le_mul_of_nonneg_left (inv_le_inv₀ (pow_pos hq0 _) (pow_pos hq0 _) |>.mpr
      (pow_le_pow_right₀ hq1 (by dsimp [m]; omega : c/4 ≤ m))) (by norm_num))
  have hpref : evenPowerProduct q m≠0 := ne_of_gt
