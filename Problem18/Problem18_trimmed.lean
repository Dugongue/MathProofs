    BitstringEncoding.bitEncode b = [b] := by
  cases b <;> decide
theorem status_decode_clockedDecision (p : Program)
    (wordBound timeBound : Polynomial Nat) (x : List Nat) :
    let d := simulationAfterFuel p wordBound timeBound x
    let status := if d.l.isNone then Lax51.BinaryWordEncoding.Symbol.one
      else Lax51.BinaryWordEncoding.Symbol.zero
    Mathproof.Problem18FiniteTransducer20261001.run statusDecoder .status
      (status :: d.stk .output) =
      BitstringEncoding.bitEncode (clockedDecision p wordBound timeBound x) := by
  dsimp only
  by_cases h : (simulationAfterFuel p wordBound timeBound x).l.isNone
  · rw [if_pos h, run_success,
      totalDecoder_eq_singleton_headD]
    simp [clockedDecision, simulationSucceeded, simulationRawOutput, h]
  · rw [if_neg h, run_timeout]
    simp [clockedDecision, simulationSucceeded, h]
end
