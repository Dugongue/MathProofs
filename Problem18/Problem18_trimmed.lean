def Fine (B : Nat) (σ : Env) : Expr → Prop
  | .lit n => n < B
  | .var x => σ.vars x < B
  | .get _ _ => False
  | .bin op e f => Fine B σ e ∧ Fine B σ f ∧ op.apply (evalN σ e) (evalN σ f) < B
theorem evalB_fine {B : Nat} {σ : Env} : ∀ (e : Expr), Fine B σ e → e.evalB B σ = some (evalN σ e)
  | .lit _, h => evalB_lit h
  | .var _, h => evalB_var h
  | .get _ _, h => absurd h id
  | .bin _ e f, h => evalB_bin (evalB_fine e h.1) (evalB_fine f h.2.1) h.2.2
theorem evalN_congr {σ τ : Env} : ∀ (e : Expr), (∀ x ∈ reads e, τ.vars x = σ.vars x) →
    evalN τ e = evalN σ e
  | .lit _, _ => rfl
  | .var x, h => h x (by simp [reads])
  | .get _ _, _ => rfl
  | .bin op e f, h => by
    simp only [evalN]
    rw [evalN_congr e (fun x hx => h x (by simp [reads, hx])),
      evalN_congr f (fun x hx => h x (by simp [reads, hx]))]
theorem fine_congr {B : Nat} {σ τ : Env} : ∀ (e : Expr), (∀ x ∈ reads e, τ.vars x = σ.vars x) →
    Fine B σ e → Fine B τ e
  | .lit _, _, h => h
  | .var x, hr, h => by simp only [Fine] at h ⊢; rw [hr x (by simp [reads])]; exact h
  | .get _ _, _, h => h
  | .bin op e f, hr, h => by
    have he : ∀ x ∈ reads e, τ.vars x = σ.vars x := fun x hx => hr x (by simp [reads, hx])
    have hf : ∀ x ∈ reads f, τ.vars x = σ.vars x := fun x hx => hr x (by simp [reads, hx])
    exact ⟨fine_congr e he h.1, fine_congr f hf h.2.1, by
      rw [evalN_congr e he, evalN_congr f hf]; exact h.2.2⟩
theorem evalB_transport {B : Nat} {σ τ : Env} (e : Expr) (hr : ∀ x ∈ reads e, τ.vars x = σ.vars x)
    (h : Fine B σ e) : e.evalB B τ = some (evalN σ e) := by
  rw [evalB_fine e (fine_congr e hr h), evalN_congr e hr]
