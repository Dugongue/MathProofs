  have hb := (polynomiallyCyclic_iff_cyclicEvalMap_bijective S v).mp hv
  have hd : Module.finrank K (Fin n→K)=n := by simp
  rw [hd] at hb
  let E := LinearEquiv.ofBijective (cyclicEvalMap S v n) hb
  exact E.isUnit_det (Polynomial.degreeLT.basis K n) (Pi.basisFun K (Fin n))
theorem intertwiner_eq_krylov_candidate (S R : Module.End K (Fin n→K))
    (v w : Fin n→K) (hv : PolynomiallyCyclic S v)
    (T : (Fin n→K) ≃ₗ[K] (Fin n→K))
    (hT : ∀ x,T (S x)=R (T x)) (htv : T v=w) :
    LinearMap.toMatrix' T.toLinearMap=krylovMatrix R w*(krylovMatrix S v)⁻¹ := by
  have he : T.toLinearMap.comp (cyclicEvalMap S v n)=cyclicEvalMap R w n := by
    apply LinearMap.ext
    intro p
    change T ((aeval S p.val) v)=(aeval R p.val) w
    rw [intertwiner_aeval T S R hT,htv]
  have hm := LinearMap.toMatrix_comp (Polynomial.degreeLT.basis K n)
    (Pi.basisFun K (Fin n)) (Pi.basisFun K (Fin n)) T.toLinearMap (cyclicEvalMap S v n)
  rw [he] at hm
  have hmat : LinearMap.toMatrix' T.toLinearMap*krylovMatrix S v=krylovMatrix R w := by
    simpa only [krylovMatrix,LinearMap.toMatrix_eq_toMatrix'] using hm.symm
  rw [← hmat,Matrix.mul_nonsing_inv_cancel_right _ _ (krylovMatrix_isUnit_det S v hv)]
