    rw [val_alias F hρalias,hmem _ (by
      have hadd:=matrix_address_bounds i j
      omega) (Or.inr (by
        have hadd:=matrix_address_bounds i j
        omega))]
    rw [val_alias F hζalias]
    simp only [ζ,ξ,val_setVar F canonical (show gauss.N≠workspaceName by decide),
      val_setVar F canonical (show gauss.WS≠workspaceName by decide)]
    exact h.matrix i j
  have hseedρ : Problem18IMPBoundaryAnnihilatorPhase20261002.seedValue F n ρ=
      (Problem18DeterministicCyclicSweep20261001.sweep S.toLin' n).1 := by
    funext j
    unfold Problem18IMPBoundaryAnnihilatorPhase20261002.seedValue
    rw [val_alias F hρalias,hcopied j.val j.isLt,val_alias F hζalias]
    simp only [ζ,ξ,val_setVar F canonical (show gauss.N≠workspaceName by decide),
      val_setVar F canonical (show gauss.WS≠workspaceName by decide)]
    exact h.vector j
  obtain ⟨τ,hann,hτ,hcoeff,hdegree,hframe,hτw,hτn,hτi,hti,hto⟩:=
    Problem18IMPBoundaryAnnihilatorPhase20261002.program_run F hρcommon hρw hρn hρmod hρlen
      hb.annihilator hb.seed
  refine ⟨τ,hcopyRun.seq hann,hτ,?_,?_,?_,hτw,?_,?_⟩
  · simpa only [hmatrixρ,hseedρ] using hcoeff
  · simpa only [hmatrixρ,hseedρ] using hdegree
