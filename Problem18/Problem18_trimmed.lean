def clauseCoeff {a b : Nat} (cl : Clause (Fin (a+b)) Int) (D : Nat) : Nat :=
  40+Problem18ConcreteClausePolynomial20261002.coefficient cl D
def patternCoeff (n d D : Nat) (pat : Σ k : Nat,Fin k → Fin (boxSize n (cpE n d))) : Nat :=
  2+existsMappedCost (fun cl => clauseCoeff cl D) (clauses (qe (template n d pat)))
