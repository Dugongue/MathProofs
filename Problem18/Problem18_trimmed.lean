      simpa [he] using ht
    have hm:=h.multiply_run (a:=3) (b:=2) (out:=4) (by simp) (by simp) (by simp)
    have hc:=(h.multiply_preserves (a:=3) (b:=2) (out:=4) (by simp) (by simp) (by simp)).copy_run
