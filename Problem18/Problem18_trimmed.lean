    (heps : eps*τ eps=1) (B : Form (V := Fin n → K) τ)
    (hB : B.SeparatingLeft) (hsym : ∀ x y, B y x=eps*τ (B x y)) :
    Fintype.card K ^ n.choose 2 ≤
