  Problem18IMPBoundarySweepState20261002.initializeCost F.e n+
    (n*Problem18IMPBoundarySweepStep20261002.cost F n+1)
theorem program_run {B n : Nat} {S : Matrix (Fin n) (Fin n) K} {σ : Env}
    (h : Core F B S σ) (hb : WordBounds B n F.e) :
    ∃τ, Run B (program n) σ τ (cost F n) ∧
      State F B S n τ ∧
      (∀j : Fin n,val F canonical Problem18IMPBoundaryPhaseState20261002.workspaceName τ (candidate n+j.val)=
        (Problem18DeterministicCyclicSweep20261001.sweep S.toLin' n).1 j) ∧
      (∀j<capacity n,val F canonical Problem18IMPBoundaryPhaseState20261002.workspaceName τ (first n+j)=
        (Problem18DeterministicCyclicSweep20261001.sweep S.toLin' n).2.coeff
          (capacity n-1-j)) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  obtain ⟨ρ,hr,hρ,hri,hro⟩:=initialize_run F h hb.initial
  obtain ⟨τ,hs,hτ,hsi,hso⟩:=iterations_run F hρ (i:=0) (k:=n) (by omega) hb
  refine ⟨τ,hr.seq hs,by simpa using hτ,?_,?_,hsi.trans hri,hso.trans hro⟩
  · simpa only [Nat.zero_add] using hτ.vector
  · simpa only [Nat.zero_add] using hτ.polynomial
