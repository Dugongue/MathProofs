structure MulLayout (r : FieldNames) (modArray : String) (B : Nat) (σ : Env) : Prop where
  scalar_names : (scalarNames r).Nodup
  degree_pos : 0<σ.vars r.e
  arithmetic_word : (σ.vars r.p+1)^2<B
  memory_word : (σ.arrs r.mem).length<B
  modulus_word : (σ.arrs modArray).length<B
  scratch_word : (σ.arrs r.scratch).length<B
  scratch_fit : 2*σ.vars r.e ≤ (σ.arrs r.scratch).length
  first_fit : σ.vars r.aBase+σ.vars r.e ≤ (σ.arrs r.mem).length
  second_fit : σ.vars r.bBase+σ.vars r.e ≤ (σ.arrs r.mem).length
  modulus_fit : σ.vars r.modBase+σ.vars r.e ≤ (σ.arrs modArray).length
  first_separate : r.mem≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars r.aBase
  second_separate : r.mem≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars r.bBase
  modulus_separate : modArray≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars r.modBase
  coefficients : ∀j<σ.vars r.e,
    sourceCoeff σ r.mem r.aBase j<σ.vars r.p ∧
    sourceCoeff σ r.mem r.bBase j<σ.vars r.p ∧
    sourceCoeff σ modArray r.modBase j<σ.vars r.p ∧
    (σ.arrs r.scratch).getD j 0<σ.vars r.p
theorem MulLayout.setVar {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulLayout r modArray B σ) (x : String) (v : Nat)
    (hx : ∀y∈[r.p,r.e,r.aBase,r.bBase,r.modBase],y≠x) :
    MulLayout r modArray B (σ.setVar x v) := by
  have hp:r.p≠x:=hx r.p (by simp)
  have he:r.e≠x:=hx r.e (by simp)
  have ha:r.aBase≠x:=hx r.aBase (by simp)
  have hb:r.bBase≠x:=hx r.bBase (by simp)
  have hm:r.modBase≠x:=hx r.modBase (by simp)
  constructor
  · exact h.scalar_names
  · simpa [he] using h.degree_pos
  · simpa [hp] using h.arithmetic_word
  · exact h.memory_word
  · exact h.modulus_word
  · exact h.scratch_word
  · simpa [he] using h.scratch_fit
  · simpa [ha,he] using h.first_fit
  · simpa [hb,he] using h.second_fit
  · simpa [hm,he] using h.modulus_fit
  · simpa [ha,he] using h.first_separate
  · simpa [hb,he] using h.second_separate
  · simpa [hm,he] using h.modulus_separate
  · simpa [sourceCoeff,hp,he,ha,hb,hm] using h.coefficients
theorem iterStart_layout {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulLayout r modArray B σ) : MulLayout r modArray B (iterStart r σ) := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  apply MulLayout.setVar (x:=r.k)
  · apply MulLayout.setVar h (x:=r.value)
    intro y hy
    simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hy
    rcases hy with rfl|rfl|rfl|rfl|rfl <;> tauto
  · intro y hy
    simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hy
    rcases hy with rfl|rfl|rfl|rfl|rfl <;> tauto
