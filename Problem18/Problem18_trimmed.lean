    (ha : σ.vars "a"=a) (hb : σ.vars "b"=b) (hc : σ.vars "c"=c)
    (haB : a < B) (hbB : b < B) (hcB : c < B)
    (hr : Run B (f (sortOrder a b c)) σ τ t) :
    Run B (route f) σ τ (t+12) := by
  have ab (v : Nat):=le_run (t:=v) (τ:=τ) "a" "b" (leBranch "b" "c" (f .abc) (leBranch "a" "c" (f .acb) (f .cab)))
    (leBranch "a" "c" (f .bac) (leBranch "b" "c" (f .bca) (f .cba))) ha hb haB hbB
  have bc (v : Nat):=le_run (t:=v) (τ:=τ) "b" "c" (f .abc) (leBranch "a" "c" (f .acb) (f .cab)) hb hc hbB hcB
  have ac (v : Nat):=le_run (t:=v) (τ:=τ) "a" "c" (f .acb) (f .cab) ha hc haB hcB
  have ac' (v : Nat):=le_run (t:=v) (τ:=τ) "a" "c" (f .bac) (leBranch "b" "c" (f .bca) (f .cba)) ha hc haB hcB
  have bc' (v : Nat):=le_run (t:=v) (τ:=τ) "b" "c" (f .bca) (f .cba) hb hc hbB hcB
  by_cases hab:a≤b
  · by_cases hbc:b≤ c
    · have r:=bc t (by simpa [sortOrder,hab,hbc] using hr)
      exact (ab (t+4) (by simpa [hab] using r)).mono (by omega)
    · have r:=ac t (by by_cases h:a≤ c <;> simpa [sortOrder,hab,hbc,h] using hr)
      have r':=bc (t+4) (by simpa [hbc] using r)
      exact (ab (t+8) (by simpa [hab] using r')).mono (by omega)
  · by_cases hac:a≤ c
    · have r:=ac' t (by simpa [sortOrder,hab,hac] using hr)
      exact (ab (t+4) (by simpa [hab] using r)).mono (by omega)
    · have r:=bc' t (by by_cases h:b≤ c <;> simpa [sortOrder,hab,hac,h] using hr)
      have r':=ac' (t+4) (by simpa [hac] using r)
      exact (ab (t+8) (by simpa [hab] using r')).mono (by omega)
def firstName : Order → String
  | .abc | .acb => "a"
  | .bac | .bca => "b"
  | .cab | .cba => "c"
def secondName : Order → String
  | .abc | .cba => "b"
  | .acb | .bca => "c"
  | .bac | .cab => "a"
theorem names {a b c : Nat} {σ : Env} (o : Order)
    (ha : σ.vars "a"=a) (hb : σ.vars "b"=b) (hc : σ.vars "c"=c) :
    σ.vars (firstName o)=(shape o a b c).1 ∧
    σ.vars (secondName o)=(shape o a b c).2.1 := by
  cases o <;> simp_all [firstName,secondName,shape]
def profiles (cutoff : Nat) (f : Order → Nat → Nat → Com) (o : Order) : Com :=
  dispatch ((List.range cutoff).map fun a=>
    dispatch ((List.range cutoff).map (f o a)) 0 (.var (secondName o)))
    0 (.var (firstName o))
def program (cutoff : Nat) (f : Order → Nat → Nat → Com) : Com := route (profiles cutoff f)
theorem profiles_run {B a b t cutoff : Nat} {σ τ : Env}
    (f : Order → Nat → Nat → Com) (o : Order)
    (ha : σ.vars (firstName o)=a) (hb : σ.vars (secondName o)=b)
    (haC : a < cutoff) (hbC : b < cutoff) (hC : cutoff < B)
    (hr : Run B (f o a b) σ τ t) :
    Run B (profiles cutoff f o) σ τ (t+8*cutoff) := by
  have rb:=Problem18ConcreteStaticDispatch20261002.run B
    ((List.range cutoff).map (f o a)) 0 b (.var (secondName o)) (f o a b) σ τ t
    (by simpa [hb] using evalB_var (B:=B) (σ:=σ) (x:=secondName o) (hb ▸ hbC.trans hC))
    (by simpa using hC) (by simp [List.getElem?_range,hbC]) hr
  have ra:=Problem18ConcreteStaticDispatch20261002.run B
    ((List.range cutoff).map fun a=>dispatch ((List.range cutoff).map (f o a)) 0 (.var (secondName o)))
    0 a (.var (firstName o)) _ σ τ _
    (by simpa [ha] using evalB_var (B:=B) (σ:=σ) (x:=firstName o) (ha ▸ haC.trans hC))
    (by simpa using hC) (by simp [List.getElem?_range,haC]) rb
  exact ra.mono (by simp only [Expr.size,List.length_map,List.length_range];omega)
theorem run {B a b c t cutoff : Nat} {σ τ : Env}
    (f : Order → Nat → Nat → Com)
    (ha : σ.vars "a"=a) (hb : σ.vars "b"=b) (hc : σ.vars "c"=c)
    (haB : a < B) (hbB : b < B) (hcB : c < B)
    (hmed : median a b c < cutoff) (hC : cutoff < B)
    (hr : Run B (f (sortOrder a b c) (shape (sortOrder a b c) a b c).1
      (shape (sortOrder a b c) a b c).2.1) σ τ t) :
    Run B (program cutoff f) σ τ (t+8*cutoff+12) := by
  have hs:=sorted_shape a b c
  have hmid:(shape (sortOrder a b c) a b c).2.1 < cutoff:=by rwa [sorted_middle_median]
  have hn:=names (sortOrder a b c) ha hb hc
  exact route_run (profiles cutoff f) ha hb hc haB hbB hcB
    (profiles_run f _ hn.1 hn.2 (hs.1.trans_lt hmid) hmid hC hr)
end Mathproof.Problem18P34Assembly20261003Dispatch
