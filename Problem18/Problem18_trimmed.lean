def cmpVCost (s d n : Expr) (m : Nat) : Nat := s.size + d.size + n.size + 3 + ((5 + 16) * m + 6)
theorem cmpV_run [DecidableEq K] {W Sn bankLen workLen : Nat} (flag : String) {σ : Env}
    (hS : FState F W Sn bankLen workLen σ) (s d n : Expr) {sv dv nv : Nat} {x y : Nat → K}
    (hf : flag ∉ [cIdx, cS, cD, cCnt])
    (hrs : ∀ z ∈ reads s ++ reads d ++ reads n, z ∉ [cS, cD, cCnt])
    (hs : Fine W σ s) (hd : Fine W σ d) (hn : Fine W σ n)
    (hsv : evalN σ s = sv) (hdv : evalN σ d = dv) (hnv : evalN σ n = F.e * nv)
    (hx : Vals F work σ sv nv x) (hy : Vals F work σ dv nv y)
    (hsfit : sv + F.e * nv ≤ workLen) (hdfit : dv + F.e * nv ≤ workLen) :
    ∃ τ, Run W (cmpV flag s d n) σ τ (cmpVCost s d n (F.e * nv)) ∧
      τ.vars flag = (if ∀ i < nv, x i = y i then σ.vars flag else 0) ∧
      (∀ z, z ∉ [cIdx, cS, cD, cCnt, flag] → τ.vars z = σ.vars z) ∧ τ.arrs = σ.arrs ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  classical
  have hf' : flag ≠ cIdx ∧ flag ≠ cS ∧ flag ≠ cD ∧ flag ≠ cCnt := by
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hf; exact hf
  have hWw := hS.wword
  have hpW := hS.p_lt
  have n1 : cS ≠ cCnt := by decide
  have n2 : cS ≠ cD := by decide
  have n3 : cD ≠ cCnt := by decide
  have hlen' : (σ.arrs work).length = workLen := hS.wlen
  let σ1 := σ.setVar cS sv
  have e1 : s.evalB W σ = some sv := hsv ▸ evalB_fine s hs
  have e2 : d.evalB W σ1 = some dv := by
    rw [← hdv]; apply evalB_transport d _ hd
    intro z hz; have := hrs z (by simp [hz]); simp [σ1, show z ≠ cS by intro h; simp_all]
  let σ2 := σ1.setVar cD dv
  have e3 : n.evalB W σ2 = some (F.e * nv) := by
    rw [← hnv]; apply evalB_transport n _ hn
    intro z hz; have := hrs z (by simp [hz])
    simp [σ2, σ1, show z ≠ cS by intro h; simp_all, show z ≠ cD by intro h; simp_all]
