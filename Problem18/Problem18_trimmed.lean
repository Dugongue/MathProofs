  obtain ⟨y,hy,hby⟩ := diagonal_order_profile hodd (by omega : 0<c) b hb
  have hδ0 : 0 ≤ δ := by positivity
  have hδ : δ ≤ 1/4 := by
    have hpow : 4 ≤ q^(c/4) := calc
      4=2^2 := by norm_num
