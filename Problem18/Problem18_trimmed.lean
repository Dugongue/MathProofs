def codimensionGram
    {i j h d : Type*} [Fintype j] [Fintype h] [Fintype d] [StarRing K]
    (e : (i × j) ≃ (h ⊕ d))
    (P : Matrix (h ⊕ d) (h ⊕ d) K) (x : h → K) :
