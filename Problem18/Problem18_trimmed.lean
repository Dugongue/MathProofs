theorem incidence_card_le (τ : K ≃+* K) (σ : E ≃+* E) (eps : K)
    (hcompat : (algebraMap K E).comp (τ : K →+* K) =
      (σ : E →+* E).comp (algebraMap K E))
    (hσ : Function.Involutive σ)
    (ρ₀ : E →ₐ[K] Module.End K (Fin n → K)) :
    Nat.card (Incidence (n := n) τ σ eps) ≤
