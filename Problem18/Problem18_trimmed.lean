theorem compileList_correct (P : FieldPresentation K) (d : UnitaryFieldData (K:=K) q)
    (ps : List (StarExpr (OuterVar a b) K)) :
    (compileList P d ps).1=ps.flatMap (fun p=>[(compile P d p).1,(compile P d p).2]) := by
  induction ps <;> simp_all only [compileList,List.flatMap_nil,List.flatMap_cons,List.cons_append,
    List.nil_append,compileCounted_correct]
theorem compileList_cost (P : FieldPresentation K) (d : UnitaryFieldData (K:=K) q)
    (ps : List (StarExpr (OuterVar a b) K)) (M : Nat) (hm : ∀p∈ps,starMass p ≤ M) :
