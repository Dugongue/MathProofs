  cases c with
  | ofNat n =>
    simp only [resVal, Int.ofNat_eq_natCast, Int.cast_natCast]
    exact (CharP.cast_eq_mod L p n).symm
  | negSucc m =>
    simp only [resVal]
    rw [← CharP.cast_eq_mod L p, Nat.cast_sub (Nat.mod_lt _ hp).le, CharP.cast_eq_zero,
      ← CharP.cast_eq_mod L p, Int.cast_negSucc, zero_sub]
theorem resExpr_spec {B : ℕ} {σ : Env} (r : FieldNames) (hb : Base F r B σ) (c : ℤ)
    (hc : c.natAbs < B) :
    (resExpr (.var r.p) c).evalB B σ = some (resVal F.p c) ∧ resVal F.p c < F.p ∧
      ((resVal F.p c : ℕ) : K) = (c : K) := by
  haveI := F.characteristic
  have hp0 : 0 < F.p := F.prime.pos
  have hpB : F.p < B := by
    have := hb.arithmetic_word; nlinarith
  have hP : (Expr.var r.p).evalB B σ = some F.p := by
    rw [← hb.prime]; exact evalB_var (by rw [hb.prime]; exact hpB)
  exact ⟨resExpr_eval hP hpB c hc, resVal_lt hp0 c, resVal_cast F.p hp0 c⟩
open Mathproof.Problem18BoundedEncoding20260930 (PolyExpr)
open Mathproof.Problem18SpecializationSafeElimination20261001 (interpret)
section Compiler
variable {c : ℕ}
def polyDepth : PolyExpr (Fin c) ℤ → ℕ
  | .const _ => 1
  | .var _ => 0
  | .add a b => polyDepth a + polyDepth b + 1
  | .mul a b => polyDepth a + polyDepth b + 1
def constBound : PolyExpr (Fin c) ℤ → ℕ
  | .const z => z.natAbs
  | .var _ => 0
  | .add a b => max (constBound a) (constBound b)
  | .mul a b => max (constBound a) (constBound b)
def opSlot (xv tv : ℕ) : PolyExpr (Fin c) ℤ → ℕ → ℕ
  | .var i, _ => xv + i.val
  | .const _, k => tv + k
  | .add a b, k => tv + (k + polyDepth a + polyDepth b)
  | .mul a b, k => tv + (k + polyDepth a + polyDepth b)
def opExpr (X T : Expr) : PolyExpr (Fin c) ℤ → ℕ → Expr
  | .var i, _ => plus X (.lit i.val)
  | .const _, k => plus T (.lit k)
  | .add a b, k => plus T (.lit (k + polyDepth a + polyDepth b))
  | .mul a b, k => plus T (.lit (k + polyDepth a + polyDepth b))
def opCode (M : FieldMacros F r) (q : RNames) (ci : String) (X T : Expr) :
    PolyExpr (Fin c) ℤ → ℕ → Com
  | .var _, _ => .skip
  | .const z, k => constLoadE r q ci (plus T (.lit k)) (resExpr (.var r.p) z)
  | .add a b, k => .seq (opCode M q ci X T a k) (.seq (opCode M q ci X T b (k + polyDepth a))
      (mcall r q M.add (opExpr X T a k) (opExpr X T b (k + polyDepth a))
        (plus T (.lit (k + polyDepth a + polyDepth b)))))
  | .mul a b, k => .seq (opCode M q ci X T a k) (.seq (opCode M q ci X T b (k + polyDepth a))
      (mcall r q M.mul (opExpr X T a k) (opExpr X T b (k + polyDepth a))
        (plus T (.lit (k + polyDepth a + polyDepth b)))))
def opCost (M : FieldMacros F r) (X T : Expr) : PolyExpr (Fin c) ℤ → ℕ → ℕ
  | .var _, _ => 1
  | .const z, k => constCostE (plus T (.lit k)) (resExpr (.var r.p) z) F.e
  | .add a b, k => opCost M X T a k + (opCost M X T b (k + polyDepth a) +
      (15 + (opExpr X T a k).size + (opExpr X T b (k + polyDepth a)).size +
        (plus T (.lit (k + polyDepth a + polyDepth b))).size + M.costPoint))
  | .mul a b, k => opCost M X T a k + (opCost M X T b (k + polyDepth a) +
      (15 + (opExpr X T a k).size + (opExpr X T b (k + polyDepth a)).size +
        (plus T (.lit (k + polyDepth a + polyDepth b))).size + M.costMul))
theorem opSlot_cases (xv tv : ℕ) (e : PolyExpr (Fin c) ℤ) (k : ℕ) :
    (∃ i : Fin c, opSlot xv tv e k = xv + i.val) ∨
      (tv + k ≤ opSlot xv tv e k ∧ opSlot xv tv e k < tv + k + polyDepth e) := by
  cases e with
  | var i => exact Or.inl ⟨i, rfl⟩
  | const z => right; simp only [opSlot, polyDepth]; omega
  | add a b => right; simp only [opSlot, polyDepth]; omega
  | mul a b => right; simp only [opSlot, polyDepth]; omega
theorem opExpr_varsIn {X T : Expr} {l : List String} (hX : VarsIn l X) (hT : VarsIn l T)
    (e : PolyExpr (Fin c) ℤ) (k : ℕ) : VarsIn l (opExpr X T e k) := by
  cases e <;> exact ⟨by assumption, trivial⟩
theorem plus_lit_eval {B : ℕ} {σ : Env} {X : Expr} {xv i : ℕ} (hX : X.evalB B σ = some xv)
    (h : xv + i < B) : (plus X (.lit i)).evalB B σ = some (xv + i) :=
  evalB_bin hX (evalB_lit (by omega)) h
theorem opExpr_eval {B : ℕ} {σ : Env} {X T : Expr} {xv tv : ℕ} (hX : X.evalB B σ = some xv)
    (hT : T.evalB B σ = some tv) (e : PolyExpr (Fin c) ℤ) (k : ℕ) (h : opSlot xv tv e k < B) :
    (opExpr X T e k).evalB B σ = some (opSlot xv tv e k) := by
  cases e <;> exact plus_lit_eval (by assumption) h
theorem varsIn_resExpr (p : String) (z : ℤ) : VarsIn [p] (resExpr (.var p) z) := by
  cases z <;> simp [resExpr, modE, VarsIn]
end Compiler
section Run
variable {c : ℕ}
theorem op_run (M : FieldMacros F r) (q : RNames) (ci : String) (hciS : ci ∉ regNames r)
    (hciW : ci ≠ q.WS) (X T : Expr) (l : List String) (hl : ∀ x ∈ l, x ∉ regNames r ∧ x ≠ ci)
    (hXp : VarsIn l X) (hTp : VarsIn l T) {B Sn xv tv D : ℕ} (hxfit : xv + c ≤ Sn)
    (htfit : tv + D ≤ Sn) (hdis : ∀ i < c, ∀ j < D, xv + i ≠ tv + j) :
    ∀ (e : PolyExpr (Fin c) ℤ) (k : ℕ) (σ : Env), Slots F r q.WS Sn B σ →
      X.evalB B σ = some xv → T.evalB B σ = some tv → k + polyDepth e ≤ D → constBound e < B →
      ∃ τ, Run B (opCode M q ci X T e k) σ τ (opCost M X T e k) ∧ Slots F r q.WS Sn B τ ∧
        val F r q.WS τ (opSlot xv tv e k) =
          interpret (Int.castRingHom K) (fun i => val F r q.WS σ (xv + i.val)) e ∧
        (∀ s < Sn, (s < tv + k ∨ tv + k + polyDepth e ≤ s) →
          val F r q.WS τ s = val F r q.WS σ s) ∧
        (∀ x, x ∉ regNames r → x ≠ ci → τ.vars x = σ.vars x) ∧
        (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hpreg : r.p ∈ regNames r := by simp [regNames, scalarNames]
  have hlv : ∀ x ∈ l, x ≠ ci := fun x hx => (hl x hx).2
  have hnoA : r.aBase ∉ l := fun h => (hl _ h).1 (by simp [regNames, scalarNames])
  have hnoB : r.bBase ∉ l := fun h => (hl _ h).1 (by simp [regNames, scalarNames])
  have hbin : ∀ (cm : Com) (f : K → K → K) (cost : ℕ), BinarySpec F r cm f cost →
      ∀ (a b : PolyExpr (Fin c) ℤ) (k : ℕ) (σ : Env),
      (∀ (σ : Env), Slots F r q.WS Sn B σ → X.evalB B σ = some xv → T.evalB B σ = some tv →
        k + polyDepth a ≤ D → constBound a < B →
        ∃ τ, Run B (opCode M q ci X T a k) σ τ (opCost M X T a k) ∧ Slots F r q.WS Sn B τ ∧
          val F r q.WS τ (opSlot xv tv a k) =
            interpret (Int.castRingHom K) (fun i => val F r q.WS σ (xv + i.val)) a ∧
          (∀ s < Sn, (s < tv + k ∨ tv + k + polyDepth a ≤ s) →
            val F r q.WS τ s = val F r q.WS σ s) ∧
          (∀ x, x ∉ regNames r → x ≠ ci → τ.vars x = σ.vars x) ∧
          (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
          τ.out = σ.out) →
      (∀ (σ : Env), Slots F r q.WS Sn B σ → X.evalB B σ = some xv → T.evalB B σ = some tv →
        k + polyDepth a + polyDepth b ≤ D → constBound b < B →
        ∃ τ, Run B (opCode M q ci X T b (k + polyDepth a)) σ τ (opCost M X T b (k + polyDepth a)) ∧
          Slots F r q.WS Sn B τ ∧
          val F r q.WS τ (opSlot xv tv b (k + polyDepth a)) =
            interpret (Int.castRingHom K) (fun i => val F r q.WS σ (xv + i.val)) b ∧
          (∀ s < Sn, (s < tv + (k + polyDepth a) ∨ tv + (k + polyDepth a) + polyDepth b ≤ s) →
            val F r q.WS τ s = val F r q.WS σ s) ∧
          (∀ x, x ∉ regNames r → x ≠ ci → τ.vars x = σ.vars x) ∧
          (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
          τ.out = σ.out) →
      Slots F r q.WS Sn B σ → X.evalB B σ = some xv → T.evalB B σ = some tv →
      k + polyDepth a + polyDepth b + 1 ≤ D → constBound a < B → constBound b < B →
      ∃ τ, Run B (.seq (opCode M q ci X T a k) (.seq (opCode M q ci X T b (k + polyDepth a))
          (mcall r q cm (opExpr X T a k) (opExpr X T b (k + polyDepth a))
            (plus T (.lit (k + polyDepth a + polyDepth b)))))) σ τ
          (opCost M X T a k + (opCost M X T b (k + polyDepth a) +
            (15 + (opExpr X T a k).size + (opExpr X T b (k + polyDepth a)).size +
              (plus T (.lit (k + polyDepth a + polyDepth b))).size + cost))) ∧
        Slots F r q.WS Sn B τ ∧
        val F r q.WS τ (tv + (k + polyDepth a + polyDepth b)) =
          f (interpret (Int.castRingHom K) (fun i => val F r q.WS σ (xv + i.val)) a)
            (interpret (Int.castRingHom K) (fun i => val F r q.WS σ (xv + i.val)) b) ∧
        (∀ s < Sn, (s < tv + k ∨ tv + k + (polyDepth a + polyDepth b + 1) ≤ s) →
          val F r q.WS τ s = val F r q.WS σ s) ∧
        (∀ x, x ∉ regNames r → x ≠ ci → τ.vars x = σ.vars x) ∧
        (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
        τ.out = σ.out := by
    intro cm f cost hspec a b k σ iha ihb hS hX hT hD hca hcb
    obtain ⟨τ1, hr1, hS1, hv1, hf1, hx1, har1, hi1, ho1⟩ := iha σ hS hX hT (by omega) hca
    have hX1 : X.evalB B τ1 = some xv := by
      rw [evalB_congr_varsIn (fun x hx => hx1 x (hl x hx).1 (hl x hx).2) X hXp]; exact hX
    have hT1 : T.evalB B τ1 = some tv := by
      rw [evalB_congr_varsIn (fun x hx => hx1 x (hl x hx).1 (hl x hx).2) T hTp]; exact hT
    obtain ⟨τ2, hr2, hS2, hv2, hf2, hx2, har2, hi2, ho2⟩ := ihb τ1 hS1 hX1 hT1 (by omega) hcb
    have hX2 : X.evalB B τ2 = some xv := by
      rw [evalB_congr_varsIn (fun x hx => hx2 x (hl x hx).1 (hl x hx).2) X hXp]; exact hX1
    have hT2 : T.evalB B τ2 = some tv := by
      rw [evalB_congr_varsIn (fun x hx => hx2 x (hl x hx).1 (hl x hx).2) T hTp]; exact hT1
    have hSB := hS.slots_word
    set sa := opSlot xv tv a k with hsa
    set sb := opSlot xv tv b (k + polyDepth a) with hsb
    set so := tv + (k + polyDepth a + polyDepth b) with hso
    have hca' := opSlot_cases xv tv a k
    have hcb' := opSlot_cases xv tv b (k + polyDepth a)
    have hsaS : sa < Sn := by
      rcases hca' with ⟨i, hi⟩ | ⟨_, h2⟩
      · rw [hsa, hi]; have := i.isLt; omega
      · omega
    have hsbS : sb < Sn := by
      rcases hcb' with ⟨i, hi⟩ | ⟨_, h2⟩
      · rw [hsb, hi]; have := i.isLt; omega
      · omega
    have hsoS : so < Sn := by omega
    have hne1 : so ≠ sa := by
      rcases hca' with ⟨i, hi⟩ | ⟨_, h2⟩
      · rw [hso, hsa, hi]; exact (hdis i.val i.isLt _ (by omega)).symm
      · omega
    have hne2 : so ≠ sb := by
      rcases hcb' with ⟨i, hi⟩ | ⟨_, h2⟩
      · rw [hso, hsb, hi]; exact (hdis i.val i.isLt _ (by omega)).symm
      · omega
    have hea := opExpr_eval hX2 hT2 a k (by omega)
    have heb := opExpr_eval hX2 hT2 b (k + polyDepth a) (by omega)
    have heo : (plus T (.lit (k + polyDepth a + polyDepth b))).evalB B τ2 = some so :=
      plus_lit_eval hT2 (by omega)
    have hvb : NoVar r.aBase (opExpr X T b (k + polyDepth a)) :=
      noVar_of_varsIn hnoA _ (opExpr_varsIn hXp hTp b _)
    have hTo : VarsIn l (plus T (.lit (k + polyDepth a + polyDepth b))) := ⟨hTp, trivial⟩
    obtain ⟨τ3, hr3, hv3, hc3⟩ := slot_call F r hspec hS2 _ _ _ hea heb heo hvb
      (noVar_of_varsIn hnoA _ hTo) (noVar_of_varsIn hnoB _ hTo) hsaS hsbS hsoS hne1 hne2
    have hdata : ∀ i : Fin c, val F r q.WS τ1 (xv + i.val) = val F r q.WS σ (xv + i.val) := by
      intro i
      apply hf1 _ (by have := i.isLt; omega)
      by_contra hcon
      push Not at hcon
      exact hdis i.val i.isLt (xv + i.val - tv) (by omega) (by omega)
    have hva : val F r q.WS τ2 sa = val F r q.WS τ1 sa := by
      apply hf2 _ hsaS
      rcases hca' with ⟨i, hi⟩ | ⟨_, h2⟩
      · rw [hsa, hi]
        by_contra hcon
        push Not at hcon
        exact hdis i.val i.isLt (xv + i.val - tv) (by omega) (by omega)
      · left; omega
    refine ⟨τ3, (hr1.seq (hr2.seq hr3)), hc3.slots, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [hv3, hva, hv1, hv2,
        show (fun i : Fin c => val F r q.WS τ1 (xv + i.val)) =
          fun i => val F r q.WS σ (xv + i.val) from funext hdata]
    · intro s hs hout
      rw [call_val hc3 hs (by omega), hf2 s hs (by omega), hf1 s hs (by omega)]
    · intro x hx hxc
      rw [call_regs_all hc3 x hx, hx2 x hx hxc, hx1 x hx hxc]
    · intro a' h1 h2
      rw [hc3.arrays a' h1 h2, har2 a' h1 h2, har1 a' h1 h2]
    · rw [hc3.inp, hi2, hi1]
    · rw [hc3.out, ho2, ho1]
  intro e
  induction e with
  | var i =>
    intro k σ hS _ _ _ _
    exact ⟨σ, Run.skip, hS, rfl, fun _ _ _ => rfl, fun _ _ _ => rfl, fun _ _ _ => rfl, rfl, rfl⟩
  | const z =>
    intro k σ hS hX hT hD hcB
    have hSB := hS.slots_word
    simp only [polyDepth] at hD
    have hSv : (plus T (.lit k)).evalB B σ = some (tv + k) := plus_lit_eval hT (by omega)
    obtain ⟨hVv, hvp, hcast⟩ := resExpr_spec (F := F) r hS.base z hcB
    obtain ⟨τ, hr, hS', hv, hoth, hvars, harr, hinp, hout⟩ :=
      constE_run q ci hciS hciW l hlv (plus T (.lit k)) ⟨hTp, trivial⟩ hS hSv (by omega)
        (resExpr (.var r.p) z) [r.p]
        (fun x hx => by
          simp only [List.mem_singleton] at hx
          subst hx; exact fun h => hciS (h ▸ hpreg))
        (varsIn_resExpr r.p z) hVv hvp
    refine ⟨τ, hr, hS', ?_, ?_, fun x _ hx => hvars x hx, fun a h1 _ => harr a h1, hinp, hout⟩
    · change val F r q.WS τ (tv + k) = Int.castRingHom K z
      rw [hv, hcast]; rfl
    · intro s hs hout'
      simp only [polyDepth] at hout'
      exact hoth s hs (by omega)
  | add a b iha ihb =>
    intro k σ hS hX hT hD hcB
    simp only [constBound] at hcB
    simp only [polyDepth] at hD ⊢
    obtain ⟨τ, h1, h2, h3, h4, h5, h6, h7, h8⟩ := hbin M.add (fun x y => x + y) M.costPoint
      M.add_spec a b k σ (iha k) (ihb (k + polyDepth a)) hS hX hT (by omega)
      (lt_of_le_of_lt (le_max_left _ _) hcB) (lt_of_le_of_lt (le_max_right _ _) hcB)
    exact ⟨τ, h1, h2, h3, h4, h5, h6, h7, h8⟩
  | mul a b iha ihb =>
    intro k σ hS hX hT hD hcB
    simp only [constBound] at hcB
    simp only [polyDepth] at hD ⊢
    obtain ⟨τ, h1, h2, h3, h4, h5, h6, h7, h8⟩ := hbin M.mul (fun x y => x * y) M.costMul
      M.mul_spec a b k σ (iha k) (ihb (k + polyDepth a)) hS hX hT (by omega)
      (lt_of_le_of_lt (le_max_left _ _) hcB) (lt_of_le_of_lt (le_max_right _ _) hcB)
    exact ⟨τ, h1, h2, h3, h4, h5, h6, h7, h8⟩
end Run
section Top
variable {c : ℕ}
def polyExprCom (M : FieldMacros F r) (q : RNames) (ci : String) (X O T : Expr)
    (e : PolyExpr (Fin c) ℤ) : Com :=
  .seq (opCode M q ci X T e 0) (mcall r q M.copy (opExpr X T e 0) (opExpr X T e 0) O)
def polyExprCost (M : FieldMacros F r) (X O T : Expr) (e : PolyExpr (Fin c) ℤ) : ℕ :=
  opCost M X T e 0 + (15 + (opExpr X T e 0).size + (opExpr X T e 0).size + O.size + M.costPoint)
theorem polyExpr_run (M : FieldMacros F r) (q : RNames) (ci : String) (hciS : ci ∉ regNames r)
    (hciW : ci ≠ q.WS) (X O T : Expr) (l : List String) (hl : ∀ x ∈ l, x ∉ regNames r ∧ x ≠ ci)
    (hXp : VarsIn l X) (hOp : VarsIn l O) (hTp : VarsIn l T) {B Sn xv ov tv : ℕ} {σ : Env}
    (hS : Slots F r q.WS Sn B σ) (hX : X.evalB B σ = some xv) (hO : O.evalB B σ = some ov)
    (hT : T.evalB B σ = some tv) (e : PolyExpr (Fin c) ℤ) (hxfit : xv + c ≤ Sn) (hov : ov < Sn)
    (htfit : tv + polyDepth e ≤ Sn) (hdis : ∀ i < c, ∀ j < polyDepth e, xv + i ≠ tv + j)
    (hox : ∀ i < c, xv + i ≠ ov) (hot : ∀ j < polyDepth e, tv + j ≠ ov) (hcB : constBound e < B) :
    ∃ τ, Run B (polyExprCom M q ci X O T e) σ τ (polyExprCost M X O T e) ∧
      Slots F r q.WS Sn B τ ∧
      val F r q.WS τ ov = interpret (Int.castRingHom K) (fun i => val F r q.WS σ (xv + i.val)) e ∧
      (∀ s < Sn, s ≠ ov → (s < tv ∨ tv + polyDepth e ≤ s) → val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ≠ ci → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hnoA : r.aBase ∉ l := fun h => (hl _ h).1 (by simp [regNames, scalarNames])
  have hnoB : r.bBase ∉ l := fun h => (hl _ h).1 (by simp [regNames, scalarNames])
  obtain ⟨τ1, hr1, hS1, hv1, hf1, hx1, har1, hi1, ho1⟩ :=
    op_run M q ci hciS hciW X T l hl hXp hTp hxfit htfit hdis e 0 σ hS hX hT (by omega) hcB
  have hcong : ∀ E : Expr, VarsIn l E → E.evalB B τ1 = E.evalB B σ := fun E hE =>
    evalB_congr_varsIn (fun x hx => hx1 x (hl x hx).1 (hl x hx).2) E hE
  have hX1 : X.evalB B τ1 = some xv := by rw [hcong X hXp]; exact hX
  have hT1 : T.evalB B τ1 = some tv := by rw [hcong T hTp]; exact hT
  have hO1 : O.evalB B τ1 = some ov := by rw [hcong O hOp]; exact hO
  have hSB := hS.slots_word
  have hcs := opSlot_cases xv tv e 0
  have hsaS : opSlot xv tv e 0 < Sn := by
    rcases hcs with ⟨i, hi⟩ | ⟨_, h2⟩
    · rw [hi]; have := i.isLt; omega
    · omega
  have hne : ov ≠ opSlot xv tv e 0 := by
    rcases hcs with ⟨i, hi⟩ | ⟨h1, h2⟩
    · rw [hi]; exact (hox i.val i.isLt).symm
    · intro h; exact hot (opSlot xv tv e 0 - tv) (by omega) (by omega)
  have hea := opExpr_eval hX1 hT1 e 0 (by omega)
  obtain ⟨τ, hr, hv, hc⟩ := slot_call F r M.copy_spec hS1 _ _ _ hea hea hO1
    (noVar_of_varsIn hnoA _ (opExpr_varsIn hXp hTp e 0)) (noVar_of_varsIn hnoA _ hOp)
    (noVar_of_varsIn hnoB _ hOp) hsaS hsaS hov hne hne
  refine ⟨τ, hr1.seq hr, hc.slots, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hv]; exact hv1
  · intro s hs hso hout
    rw [call_val hc hs hso, hf1 s hs (by omega)]
  · intro x hx hxc
    rw [call_regs_all hc x hx, hx1 x hx hxc]
  · intro a h1 h2
    rw [hc.arrays a h1 h2, har1 a h1 h2]
  · rw [hc.inp, hi1]
  · rw [hc.out, ho1]
def polyVecCom (M : FieldMacros F r) (q : RNames) (ci : String) (X T : Expr) :
    Expr → List (PolyExpr (Fin c) ℤ) → Com
  | _, [] => .skip
