theorem cappedShiftProgram_preservesDispatch {N : Nat} (rightShift : Bool) :
    ProgramPreservesDispatch (cappedShiftProgram (N:=N) rightShift) := by
  intro label
  cases label with
  | countdown label =>
      apply PreservesDispatch.mapLabelStmt embedCountdownController
      exact (ProgramPreservesDispatch.lensMultiPhaseLeft
        countdownCoreRenaming FullInterpreterState.countdownLens
        (by intros; rfl) sparseCountdownProgram
        (countdownExit CappedShiftLabel.cleanupFuel CappedShiftLabel.fuel)
        countdownOnExit (by intros; rfl)) label
  | left label =>
      have hround := shiftLeftRoundProgram_preservesDispatch (N:=N) () (fun _=>.halt)
        (by intro u; cases u; intro state tapes; rfl)
      rcases label with label | label
      · exact PreservesDispatch.mapLabelStmt CappedShiftLabel.left (hround (.inl label))
      · rcases label with label | label
        · exact PreservesDispatch.mapLabelStmt CappedShiftLabel.left (hround (.inr (.inl label)))
        · rcases label with label | label
          · exact PreservesDispatch.mapLabelStmt CappedShiftLabel.left
              (hround (.inr (.inr (.inl label))))
          · cases label
            apply StmtPreservesDispatch.sound
            exact ⟨by intro state; rfl, True.intro⟩
  | right label =>
      have hround := shiftRightRoundProgram_preservesDispatch (N:=N) () (fun _=>.halt)
        (by intro u; cases u; intro state tapes; rfl)
      rcases label with label | label
      · exact PreservesDispatch.mapLabelStmt CappedShiftLabel.right (hround (.inl label))
      · rcases label with label | label
        · exact PreservesDispatch.mapLabelStmt CappedShiftLabel.right (hround (.inr (.inl label)))
        · rcases label with label | label
          · exact PreservesDispatch.mapLabelStmt CappedShiftLabel.right
              (hround (.inr (.inr (.inl label))))
          · cases label
            apply StmtPreservesDispatch.sound
            exact ⟨by intro state; rfl, True.intro⟩
  | fuel | cleanupFuel | cleanupCount | cleanupTemp | done =>
      apply StmtPreservesDispatch.sound
      simp [StmtPreservesDispatch,cappedShiftProgram,cappedShiftCleanupStmt,resetShiftControls,
        FullInterpreterState.dispatchLens,FullInterpreterState.macroLens,
        FullInterpreterState.moveLens,FullInterpreterState.shiftLens,FullInterpreterState.countdownLens,
        InterpreterMacroState.moveLens,StateLens.comp]
