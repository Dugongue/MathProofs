theorem body_run {n Sn B : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ : Env} (h : Input F S z Sn B σ) (hd : σ.vars index ≤ n) :
    ∃τ,Run B body σ τ (bodyCost F n) ∧ Input F S z Sn B τ ∧
