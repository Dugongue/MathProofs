    (U *ᵥ y) ⬝ᵥ y = 0 := by
  rw [quadForm_expand]
  refine Finset.sum_ninvolution (fun p => (p.2, p.1)) (fun p => ?_) (fun p hp => ?_)
    (fun _ => Finset.mem_univ _) (fun _ => rfl)
  · have hring : U p.1 p.2 * y p.2 * y p.1 + U p.2 p.1 * y p.1 * y p.2
        = (U p.1 p.2 + U p.2 p.1) * (y p.1 * y p.2) := by ring
    rw [hring, h.2 p.1 p.2, zero_mul]
  · obtain ⟨i, j⟩ := p
    intro heq
    have hji : j = i := congrArg Prod.fst heq
    subst hji
    exact hp (by simp [h.1])
theorem quadForm_single (U : Matrix (Fin n) (Fin n) K) (i j : Fin n) :
