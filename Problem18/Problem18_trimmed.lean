theorem header_run {W : Nat} {σ : Env} {L t u q p e a b c : Nat} {rest : List Nat}
    (hq : σ.arrs qA = L :: t :: u :: q :: p :: e :: a :: b :: c :: rest)
    (hs : σ.arrs sA = List.replicate (11 + (e + a*b*c*e)) 0)
    (hval : ∀ v ∈ L :: t :: u :: q :: p :: e :: a :: b :: c :: rest, v < W)
    (hNW : 11 + (e + a*b*c*e) < W) (he : 0 < e) (hc : 0 < c) :
    ∃ σ', Run W header σ σ' 60 ∧
      σ'.arrs sA = [10 + (e + a*b*c*e), 0, u, q, p, e, a, b, c] ++
        List.replicate (e + a*b*c*e + 2) 0 ∧
      (∀ y, y ≠ sA → σ'.arrs y = σ.arrs y) ∧ σ'.vars = σ.vars ∧
      σ'.inp = σ.inp ∧ σ'.out = σ.out := by
