namespace Mathproof.Problem18PrimaryAssemblyBoundary20260930
open Polynomial Module
open scoped BigOperators
open Mathproof.Problem18PrimaryRestrictionBoundary20260930
open Mathproof.Problem18PrimaryNonzeroBoundary20260930
open Mathproof.Meta.Problem18SpectralBlocks20260930
variable {K V ι : Type*} [Field K] [AddCommGroup V] [Module K V]
  [Fintype ι] [DecidableEq ι]
abbrev Primary (S : Module.End K V) (g : ι → K[X]) (i : ι) :=
  LinearMap.ker (Polynomial.aeval S (g i))
noncomputable def primarySum (S : Module.End K V) (g : ι → K[X]) :
    (∀ i, Primary S g i) →ₗ[K] V where
  toFun x := ∑ i, (x i : V)
  map_add' x y := by simp [Finset.sum_add_distrib]
  map_smul' a x := by simp [Finset.smul_sum]
theorem kernel_le_of_dvd (S : Module.End K V) {p q : K[X]} (h : p ∣ q) :
    LinearMap.ker (Polynomial.aeval S p) ≤ LinearMap.ker (Polynomial.aeval S q) := by
  intro x hx
  apply LinearMap.mem_ker.mpr
  obtain ⟨r,rfl⟩ := h
  rw [mul_comm,Polynomial.aeval_mul,Module.End.mul_apply,LinearMap.mem_ker.mp hx,map_zero]
theorem primarySum_injective (S : Module.End K V) (g : ι → K[X])
    (hc : ∀ i, IsCoprime (g i) (∏ j ∈ Finset.univ.erase i, g j)) :
    Function.Injective (primarySum S g) := by
  intro x y hxy
  funext i
  apply Subtype.ext
  obtain ⟨e,he,hz⟩ := exists_crt_projector_polynomial (S := S) (hc i)
  have hproj (z : ∀ j, Primary S g j) : polyEval S e (primarySum S g z)=(z i : V) := by
    change polyEval S e (∑ j, (z j : V))=(z i : V)
    rw [map_sum]
    rw [Finset.sum_eq_single i]
    · exact he _ (z i).property
    · intro j hj hji
      apply hz
      exact kernel_le_of_dvd S (Finset.dvd_prod_of_mem g (Finset.mem_erase.mpr ⟨hji,Finset.mem_univ _⟩))
        (z j).property
    · intro hi
      exact False.elim (hi (Finset.mem_univ _))
  exact (hproj x).symm.trans ((congrArg (polyEval S e) hxy).trans (hproj y))
variable [FiniteDimensional K V] [Fintype K]
theorem factor_coprime_complement (S : Module.End K V) (g : ι → K[X])
    (hf : S.charpoly=∏ i,g i) (hs : Squarefree S.charpoly) (i : ι) :
    IsCoprime (g i) (∏ j ∈ Finset.univ.erase i,g j) := by
  apply isRelPrime_iff_isCoprime.mp
  apply (squarefree_mul_iff.mp _).1
  rw [Finset.mul_prod_erase _ _ (Finset.mem_univ i),← hf]
  exact hs
theorem primarySum_bijective (S : Module.End K V) (g : ι → K[X])
    (hm : ∀ i,(g i).Monic) (hi : ∀ i,Irreducible (g i))
    (hf : S.charpoly=∏ i,g i) (hs : Squarefree S.charpoly) :
    Function.Bijective (primarySum S g) := by
  have hinj := primarySum_injective S g (factor_coprime_complement S g hf hs)
  refine ⟨hinj,(LinearMap.injective_iff_surjective_of_finrank_eq_finrank ?_).mp hinj⟩
  rw [Module.finrank_pi_fintype]
  calc
    (∑ i,Module.finrank K (Primary S g i)) = ∑ i,(g i).natDegree := by
      apply Finset.sum_congr rfl
      intro i hi'
      rw [← (S.restrict (primary_kernel_invariant S (g i))).charpoly_natDegree,
        squarefree_primary_restriction_charpoly S (g i) (hm i) (hi i)]
      · rw [hf]; exact Finset.dvd_prod_of_mem g (Finset.mem_univ i)
      · exact hs
    _ = (∏ i,g i).natDegree := (Polynomial.natDegree_prod_of_monic _ _ (fun i _ => hm i)).symm
    _ = Module.finrank K V := by rw [← hf,S.charpoly_natDegree]
noncomputable def primarySumEquiv (S : Module.End K V) (g : ι → K[X])
    (hm : ∀ i,(g i).Monic) (hi : ∀ i,Irreducible (g i))
    (hf : S.charpoly=∏ i,g i) (hs : Squarefree S.charpoly) :
    (∀ i,Primary S g i) ≃ₗ[K] V :=
  LinearEquiv.ofBijective (primarySum S g) (primarySum_bijective S g hm hi hf hs)
theorem exists_simultaneous_primary_coordinates (S : Module.End K V) (g : ι → K[X])
    (hm : ∀ i,(g i).Monic) (hi : ∀ i,Irreducible (g i))
    (hf : S.charpoly=∏ i,g i) (hs : Squarefree S.charpoly) :
    ∃ (e : ∀ i,AdjoinRoot (g i) ≃ₗ[K] Primary S g i)
      (E : (∀ i,AdjoinRoot (g i)) ≃ₗ[K] V),
      (∀ x,E x=∑ i,(e i (x i) : V)) ∧
      ∀ x,E (fun i => AdjoinRoot.root (g i)*x i)=S (E x) := by
  have hh (i : ι) := squarefree_primary_coordinates S (g i) (hm i) (hi i)
    (by rw [hf]; exact Finset.dvd_prod_of_mem g (Finset.mem_univ i)) hs
  choose e he using hh
  let E := (LinearEquiv.piCongrRight e).trans (primarySumEquiv S g hm hi hf hs)
  refine ⟨e,E,fun x => rfl,?_⟩
  intro x
  change (∑ i, (e i (AdjoinRoot.root (g i)*x i) : V))=S (∑ i,(e i (x i) : V))
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro i hi'
  exact congrArg Subtype.val (he i (x i))
theorem primarySum_form (S : Module.End K V) (g : ι → K[X])
    (B : LinearMap.BilinForm K V) (hS : IsSelfAdjointFor B S)
    (hf : S.charpoly=∏ i,g i) (hs : Squarefree S.charpoly)
    (x y : ∀ i,Primary S g i) :
    B (primarySum S g x) (primarySum S g y)=∑ i,B (x i) (y i) := by
  change B (∑ i,(x i : V)) (∑ j,(y j : V))=∑ i,B (x i) (y i)
  rw [B.map_sum₂]
  apply Finset.sum_congr rfl
  intro i hi'
  rw [map_sum,Finset.sum_eq_single i]
  · intro j hj hji
    have hc := (factor_coprime_complement S g hf hs i).of_prod_right j
      (Finset.mem_erase.mpr ⟨hji,Finset.mem_univ _⟩)
    exact coprime_kernels_pairing_eq_zero hS hc (x i).property (y j).property
  · intro hn
    exact False.elim (hn (Finset.mem_univ _))
theorem primary_coordinates_trace (S : Module.End K V) (h : K[X])
    (B : LinearMap.BilinForm K V) (hB : B.IsRefl) (hnd : B.Nondegenerate)
    (hS : IsSelfAdjointFor B S) (hm : h.Monic) (hi : Irreducible h)
    (hd : h ∣ S.charpoly) (hs : Squarefree S.charpoly)
    (e : AdjoinRoot h ≃ₗ[K] LinearMap.ker (Polynomial.aeval S h))
    (he : ∀ x,e (AdjoinRoot.root h*x)=(S.restrict (primary_kernel_invariant S h)) (e x)) :
    ∃ c : AdjoinRoot h, c ≠ 0 ∧ ∀ x y,
      B (e x) (e y)=Algebra.trace K (AdjoinRoot h) (c*x*y) := by
  letI : Fact (Irreducible h) := ⟨hi⟩
  letI : FiniteDimensional K (AdjoinRoot h) := (AdjoinRoot.powerBasis hi.ne_zero).finite
  obtain ⟨q,hq⟩ := hd
  have hc : IsCoprime h q := isRelPrime_iff_isCoprime.mp
    (squarefree_mul_iff.mp (hq ▸ hs)).1
  have hn : (B.domRestrict₁₂ (LinearMap.ker (Polynomial.aeval S h))
      (LinearMap.ker (Polynomial.aeval S h))).Nondegenerate := by
    exact nondegenerate_restrict_of_orthogonal_complement hB hnd
      (Mathproof.Meta.Problem18SpectralDecomposition20260930.isCompl_primarySpaces_of_charpoly_eq_mul hc hq).sup_eq_top
      (primarySpace_le_orthogonalBilin hS hc)
  let C := LinearMap.BilinForm.congr e.symm
    (B.domRestrict₁₂ (LinearMap.ker (Polynomial.aeval S h)) (LinearMap.ker (Polynomial.aeval S h)))
  have hC : C.Nondegenerate := LinearMap.BilinForm.Nondegenerate.congr e.symm hn
  have ha : ∀ x y,C (AdjoinRoot.root h*x) y=C x (AdjoinRoot.root h*y) := by
    intro x y
    change B (e (AdjoinRoot.root h*x)) (e y)=B (e x) (e (AdjoinRoot.root h*y))
    rw [he,he]
    exact hS _ _
  have hb := Mathproof.Problem18PrimaryTraceBoundary20260930.balanced_of_generator C
    (AdjoinRoot.root h) (AdjoinRoot.adjoinRoot_eq_top (f := h)) ha
  refine ⟨Mathproof.Problem18PrimaryTraceBoundary20260930.traceCoefficient C,
    Mathproof.Problem18PrimaryTraceBoundary20260930.traceCoefficient_ne_zero C hb hC,?_⟩
  exact Mathproof.Problem18PrimaryTraceBoundary20260930.balanced_trace_representation C hb
theorem exists_simultaneous_primary_trace_form (S : Module.End K V) (g : ι → K[X])
    (B : LinearMap.BilinForm K V) (hB : B.IsRefl) (hnd : B.Nondegenerate)
    (hS : IsSelfAdjointFor B S)
    (hm : ∀ i,(g i).Monic) (hi : ∀ i,Irreducible (g i))
    (hf : S.charpoly=∏ i,g i) (hs : Squarefree S.charpoly) :
    ∃ (E : (∀ i,AdjoinRoot (g i)) ≃ₗ[K] V) (c : ∀ i,AdjoinRoot (g i)),
      (∀ i,c i ≠ 0) ∧
      (∀ x,E (fun i => AdjoinRoot.root (g i)*x i)=S (E x)) ∧
      ∀ x y,B (E x) (E y)=∑ i,Algebra.trace K (AdjoinRoot (g i)) (c i*x i*y i) := by
  have hh (i : ι) := squarefree_primary_coordinates S (g i) (hm i) (hi i)
    (by rw [hf]; exact Finset.dvd_prod_of_mem g (Finset.mem_univ i)) hs
  choose e he using hh
  have ht (i : ι) := primary_coordinates_trace S (g i) B hB hnd hS (hm i) (hi i)
    (by rw [hf]; exact Finset.dvd_prod_of_mem g (Finset.mem_univ i)) hs (e i) (he i)
  choose c hc htrace using ht
  let E := (LinearEquiv.piCongrRight e).trans (primarySumEquiv S g hm hi hf hs)
  refine ⟨E,c,hc,?_,?_⟩
  · intro x
    change (∑ i, (e i (AdjoinRoot.root (g i)*x i) : V))=S (∑ i,(e i (x i) : V))
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro i hi'
    exact congrArg Subtype.val (he i (x i))
  · intro x y
    change B (primarySum S g (fun i => e i (x i)))
      (primarySum S g (fun i => e i (y i)))=_
    rw [primarySum_form S g B hS hf hs]
    exact Finset.sum_congr rfl (fun i _ => htrace i (x i) (y i))
end Mathproof.Problem18PrimaryAssemblyBoundary20260930
end
