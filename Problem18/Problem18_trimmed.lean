namespace Mathproof.Problem18P36FlaggedClock20261004
open Turing TM2
open Mathproof.Problem18TM2OperationalBridge20260930
open Mathproof.Problem18RAMAnswerCodec20261001
open Mathproof.Problem18FiniteTransducer20261001
inductive Phase | idle | restore (success : Bool) | exit (success : Bool)
  deriving DecidableEq, Fintype
variable {K Λ σ : Type} (Γ : K → Type)
def Alphabet : Sum K Bool → Type
  | .inl k => Γ k
  | .inr _ => Unit
instance [∀ k, Fintype (Γ k)] (k : Sum K Bool) : Fintype (Alphabet Γ k) := by
  cases k with
  | inl k => exact inferInstanceAs (Fintype (Γ k))
  | inr _ => exact inferInstanceAs (Fintype Unit)
def stackFn (s : ∀ k, List (Γ k)) (left right : List Unit) :
    ∀ k, List (Alphabet Γ k)
  | .inl k => s k
  | .inr false => left
  | .inr true => right
@[simp] theorem stackFn_inl (s : ∀ k, List (Γ k)) (left right : List Unit)
    (k : K) : stackFn Γ s left right (.inl k) = s k := rfl
@[simp] theorem stackFn_left (s : ∀ k, List (Γ k)) (left right : List Unit) :
    stackFn Γ s left right (.inr false) = left := rfl
@[simp] theorem stackFn_right (s : ∀ k, List (Γ k)) (left right : List Unit) :
    stackFn Γ s left right (.inr true) = right := rfl
def cfg (c : TM2.Cfg Γ Λ σ) (left right : List Unit) :
    TM2.Cfg (Alphabet Γ) (Sum Λ Phase) (σ × Bool) :=
  ⟨some (c.l.elim (.inr .idle) Sum.inl), (c.var, false),
    stackFn Γ c.stk left right⟩
def phaseCfg (v : σ) (s : ∀ k, List (Γ k)) (phase : Phase)
    (left right : List Unit) :
    TM2.Cfg (Alphabet Γ) (Sum Λ Phase) (σ × Bool) :=
  ⟨some (.inr phase), (v, false),
    stackFn Γ s left right⟩
variable [DecidableEq K]
def liftStmt : TM2.Stmt Γ Λ σ →
    TM2.Stmt (Alphabet Γ) (Sum Λ Phase) (σ × Bool)
  | .push k f q => .push (.inl k) (fun s => f s.1) (liftStmt q)
  | .peek k f q => .peek (.inl k) (fun s a => (f s.1 a, s.2)) (liftStmt q)
  | .pop k f q => .pop (.inl k) (fun s a => (f s.1 a, s.2)) (liftStmt q)
  | .load f q => .load (fun s => (f s.1, s.2)) (liftStmt q)
  | .branch f a b => .branch (fun s => f s.1) (liftStmt a) (liftStmt b)
  | .goto f => .goto (fun s => .inl (f s.1))
  | .halt => .goto (fun _ => .inr .idle)
def tick (successOnEmpty : Bool)
    (q : TM2.Stmt (Alphabet Γ) (Sum Λ Phase) (σ × Bool)) :
    TM2.Stmt (Alphabet Γ) (Sum Λ Phase) (σ × Bool) :=
  .pop (.inr false) (fun s a => (s.1, a.isSome))
    (.branch Prod.snd
      (.push (.inr true) (fun _ => ()) (.load (fun s => (s.1, false)) q))
      (.goto (fun _ => .inr (.restore successOnEmpty))))
def program (statusStack : K) (statusSymbol : Bool → Γ statusStack)
    (M : Λ → TM2.Stmt Γ Λ σ) :
    Sum Λ Phase → TM2.Stmt (Alphabet Γ) (Sum Λ Phase) (σ × Bool)
  | .inl l => tick Γ false (liftStmt Γ (M l))
  | .inr .idle => tick Γ true (.goto (fun _ => .inr .idle))
  | .inr (.restore success) =>
      .pop (.inr true) (fun s a => (s.1, a.isSome))
        (.branch Prod.snd
          (.load (fun s => (s.1, false))
            (.goto (fun _ => .inr (.restore success))))
          (.goto (fun _ => .inr (.exit success))))
  | .inr (.exit success) =>
      .push (.inl statusStack) (fun _ => statusSymbol success) .halt
theorem update_stackFn (s : ∀ k, List (Γ k)) (left right : List Unit)
    (k : K) (v : List (Γ k)) :
    Function.update (stackFn Γ s left right) (.inl k) v =
      stackFn Γ (Function.update s k v) left right := by
  funext j
  cases j with
  | inl j =>
      by_cases h : j = k
      · subst j; simp [stackFn]
      · simp [stackFn, h]
  | inr j => cases j <;> simp [stackFn]
theorem update_left (s : ∀ k, List (Γ k)) (left right value : List Unit) :
    Function.update (stackFn Γ s left right) (.inr false) value =
      stackFn Γ s value right := by
  funext j
  cases j with
  | inl j => simp [stackFn]
  | inr j => cases j <;> simp [stackFn]
theorem update_right (s : ∀ k, List (Γ k)) (left right value : List Unit) :
    Function.update (stackFn Γ s left right) (.inr true) value =
      stackFn Γ s left value := by
  funext j
  cases j with
  | inl j => simp [stackFn]
  | inr j => cases j <;> simp [stackFn]
theorem replicate_transfer (n : Nat) (rest : List Unit) :
    List.replicate n () ++ (() :: rest) =
      List.replicate (n + 1) () ++ rest := by
  induction n <;> simp_all [List.replicate_succ]
theorem stepAux_liftStmt (q : TM2.Stmt Γ Λ σ) (v : σ)
    (s : ∀ k, List (Γ k)) (left right : List Unit) :
    TM2.stepAux (liftStmt Γ q) (v, false)
      (stackFn Γ s left right) =
    cfg Γ (TM2.stepAux q v s) left right := by
  induction q generalizing v s with
  | push k f q ih =>
      simp only [liftStmt, TM2.stepAux,
        stackFn_inl]
      rw [update_stackFn]
      exact ih _ _
  | peek k f q ih =>
      simpa only [liftStmt, TM2.stepAux,
        stackFn_inl] using ih (f v (s k).head?) s
  | pop k f q ih =>
      simp only [liftStmt, TM2.stepAux,
        stackFn_inl]
      rw [update_stackFn]
      exact ih _ _
  | load f q ih => simpa only [liftStmt, TM2.stepAux] using ih (f v) s
  | branch f a b iha ihb =>
      cases h : f v <;> simp [liftStmt, TM2.stepAux, h, iha, ihb]
  | goto f => rfl
  | halt => rfl
variable (statusStack : K) (statusSymbol : Bool → Γ statusStack)
theorem tick_step (M : Λ → TM2.Stmt Γ Λ σ) (c : TM2.Cfg Γ Λ σ)
    (left right : List Unit) :
    TM2.step (program Γ statusStack statusSymbol M)
      (cfg Γ c (() :: left) right) =
      some (cfg Γ (totalStep (TM2.step M) c) left (() :: right)) := by
  rcases c with ⟨l,v,s⟩
  cases l with
  | none =>
      simp [cfg, program, tick, TM2.step, TM2.stepAux, totalStep,
        update_left,
        update_right]
  | some l =>
      simpa [cfg, program, tick, TM2.step, TM2.stepAux, totalStep,
        update_left,
        update_right] using
        congrArg some (stepAux_liftStmt Γ (M l) v s left (() :: right))
theorem empty_tick (M : Λ → TM2.Stmt Γ Λ σ) (c : TM2.Cfg Γ Λ σ)
    (right : List Unit) :
    TM2.step (program Γ statusStack statusSymbol M) (cfg Γ c [] right) =
      some (phaseCfg Γ c.var c.stk (.restore c.l.isNone) [] right) := by
  rcases c with ⟨l,v,s⟩
  cases l <;>
    simp [cfg, phaseCfg, program, tick, TM2.step, TM2.stepAux,
      update_left]
theorem restore_step (M : Λ → TM2.Stmt Γ Λ σ) (v : σ)
    (s : ∀ k, List (Γ k)) (success : Bool) (left right : List Unit) :
    TM2.step (program Γ statusStack statusSymbol M)
      (phaseCfg Γ v s (.restore success) left (() :: right)) =
    some (phaseCfg Γ v s (.restore success) left right) := by
  simp [phaseCfg, program, TM2.step, TM2.stepAux,
    update_left,
    update_right]
theorem restore_empty (M : Λ → TM2.Stmt Γ Λ σ) (v : σ)
    (s : ∀ k, List (Γ k)) (success : Bool) (left : List Unit) :
    TM2.step (program Γ statusStack statusSymbol M)
      (phaseCfg Γ v s (.restore success) left []) =
    some (phaseCfg Γ v s (.exit success) left []) := by
  simp [phaseCfg, program, TM2.step, TM2.stepAux,
    update_right]
def sanitizedAnswer (success : Bool)
    (raw : List Lax51.BinaryWordEncoding.Symbol) : Bool :=
  if success then (run decoder .start raw).head?.getD false else false
@[simp] theorem sanitizedAnswer_timeout (raw) :
    sanitizedAnswer false raw = false := rfl
end Mathproof.Problem18P36FlaggedClock20261004
