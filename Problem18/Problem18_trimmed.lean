  refine ⟨tau,hrun,?_,?_,h5,h6,h9,h10,h11⟩
  · intro k hk
    exact h7 k (by omega)
  · intro k hk
    exact h8 k (by rw [hi];exact hk)
def fillBody (a idx db : String) (v : Nat) : Com :=
  .seq (.store a (.bin .add (.var db) (.var idx)) (.lit v))
    (.assign idx (.bin .add (.var idx) (.lit 1)))
def fillWords (a idx cnt db : String) (v : Nat) : Com :=
  .seq (.assign idx (.lit 0))
    (.while (.lt (.var idx) (.var cnt)) (fillBody a idx db v))
theorem fillWords_run {a idx cnt db : String} (hic : idx≠cnt) (hid : idx≠db)
    {B n targetBase v : Nat} (sigma : Env)
    (hn : n<B) (hvB : v<B) (hcount : sigma.vars cnt=n)
    (htarget : sigma.vars db=targetBase) (htargetB : targetBase+n<B)
