  have h2 : (Expr.bin .mul (.bin .div A P) P).evalB B σ = some (a / p * p) :=
    evalB_bin h1 hP (by change a / p * p < B; exact lt_of_le_of_lt (Nat.div_mul_le_self a p) haB)
  have hdm := Nat.div_add_mod a p
  rw [Nat.mul_comm] at hdm
  have h3 := evalB_bin (op := .sub) hA h2 (by change a - a / p * p < B; omega)
  have he : Bop.apply .sub a (a / p * p) = a % p := by change a - a / p * p = a % p; omega
  rw [he] at h3
  exact h3
theorem resExpr_eval {B : ℕ} {σ : Env} {P : Expr} {p : ℕ} (hP : P.evalB B σ = some p)
