def bodyCost (E n : Nat) : Nat := 20+2*productCost E n+3*copyCost E n
theorem invariant_step {M : Type} [Monoid M] (A X X' : M) (v : Nat) (hX : v/2=0 ∨ X'=X*X) :
    (if v%2=1 then A*X else A) * X'^(v/2) = A*X^v := by
  rcases hX with h|h
  · rw [h, pow_zero, mul_one]
    have hv : v=0 ∨ v=1 := by omega
    rcases hv with rfl|rfl <;> simp
  · rw [h]; exact step_invariant A X v
theorem evalB_var_eq {B : Nat} {x : String} {ρ : Env} {v : Nat} (h : ρ.vars x=v) (hv : v<B) :
