theorem mod_pow_div_mod (a p e j : ℕ) (hj : j < e) :
    a % p ^ e / p ^ j % p = a / p ^ j % p := by
  rw [← Nat.mod_mul_right_div_self (a % p ^ e) (p ^ j) p, ← Nat.mod_mul_right_div_self a (p ^ j) p,
    Nat.mod_mod_of_dvd]
  refine ⟨p ^ (e - j - 1), ?_⟩
  rw [mul_assoc, ← pow_succ', ← pow_add]
  congr 1
  omega
theorem digitCoord_eq_vector (n t : ℕ) (i : Fin n) :
    digitCoord F t i.val = (vector F n t).1 i := by
  unfold digitCoord vector
  simp only [Array.getElem_ofFn, Fin.eta, Equiv.symm_apply_apply, binaryPower_correct]
  congr 1
  funext j
  apply Fin.ext
  rw [digit_value]
  simp only [digitVec]
  rw [mod_pow_div_mod _ _ _ _ j.isLt, Nat.div_div_eq_div_mul, ← pow_mul, ← pow_add, mul_comm]
theorem exists_counter (n : ℕ) (x : Fin n → K) :
    ∃ t < (F.p ^ F.e) ^ n, ∀ i : Fin n, digitCoord F t i.val = x i := by
  refine ⟨((vectorEquiv F n) x).val, ((vectorEquiv F n) x).isLt, fun i => ?_⟩
  rw [digitCoord_eq_vector, vector_value, Equiv.symm_apply_apply]
theorem smallFieldDecide_iff_counter {n d : ℕ} (rows : List (DenseInput n d K)) :
    (smallFieldDecide F rows).1 = true ↔
      ∃ t < (F.p ^ F.e) ^ n, ∀ v ∈ rows,
        denseEval (fun i : Fin n => digitCoord F t i.val) (Problem18ArrayElimination20260929.read v) = 0 := by
  rw [smallFieldDecide_correct]
  constructor
  · rintro ⟨x, hx⟩
    obtain ⟨t, ht, hdig⟩ := exists_counter F n x
    refine ⟨t, ht, ?_⟩
    have : (fun i : Fin n => digitCoord F t i.val) = x := funext hdig
    rw [this]; exact hx
  · rintro ⟨t, _, h⟩
    exact ⟨_, h⟩
end Mathproof.Problem18ClaudeDigitSurj20261001
