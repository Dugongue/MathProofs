theorem bank_local_congr {n d : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ τ : Env}
    (hv : ∀s< rowStart (n+d) d,val F canonical gauss.WS τ (bankStart n d+s)=
      val F canonical gauss.WS σ (bankStart n d+s))
    (h : Bank F S z σ d) : Bank F S z τ d := by
  refine ⟨?_,?_,?_⟩
  · simpa using (hv 0 (by unfold rowStart;omega)).trans h.1
  · rw [←h.2.1]
    unfold restRows
    apply List.map_congr_left
    intro t ht
    simp only [List.mem_range,Nat.sub_zero] at ht
    funext i
    apply hv
    have hi:=i.isLt
    have hm:=Nat.mul_le_mul_right (n+d) (show t+1 ≤ d by omega)
    unfold rowStart
    nlinarith
  · rw [←h.2.2]
    funext i
    apply hv
    have hi:=i.isLt
    unfold rowStart
    omega
structure Invariant {n : Nat} (S : Module.End K (Fin n→K)) (z : Fin n→K)
    (Sn B : Nat) (σ τ : Env) : Prop where
  input : Input F S z Sn B τ
  index_le : τ.vars index ≤ n+1
  limit_eq : τ.vars limit=n+1
  banks : ∀j<τ.vars index,Bank F S z τ j
  memory : ∀s<Sn,(s< maxLength n ∨ (n+2)*maxLength n ≤ s) →
    val F canonical gauss.WS τ s=val F canonical gauss.WS σ s
  input_tape : τ.inp=σ.inp
  output_tape : τ.out=σ.out
theorem iteration_run {n Sn B : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ τ : Env} (hI : Invariant F S z Sn B σ τ) (hi : τ.vars index<n+1) :
    ∃ρ,Run B body τ ρ (bodyCost F n) ∧ Invariant F S z Sn B σ ρ ∧
      ρ.vars index=τ.vars index+1 := by
  obtain ⟨ρ,hr,hρ,hidx,hbank,hmem,hin,hout⟩:=body_run F hI.input (by omega)
  have hd : τ.vars index ≤ n := by omega
  have hlen:=length_le hd
  have hbfit:=bank_bounds F hI.input hd
  have hfull : bankStart n (τ.vars index)+rowStart (n+τ.vars index) (τ.vars index) ≤
      (n+2)*maxLength n := by
    have hh:=Nat.mul_le_mul_right (maxLength n) (show τ.vars index+2 ≤ n+2 by omega)
    unfold bankStart
    nlinarith
  have hstart : maxLength n ≤ bankStart n (τ.vars index) := by unfold bankStart;nlinarith
  refine ⟨ρ,hr,⟨hρ,by rw [hidx];omega,?_,?_,?_,hin.trans hI.input_tape,hout.trans hI.output_tape⟩,hidx⟩
  · rw [(run_frame hr).1 limit (by decide)];exact hI.limit_eq
  · intro j hj
    rw [hidx] at hj
    by_cases he:j=τ.vars index
    · subst j;exact hbank
    · have hjold : j<τ.vars index := by omega
      apply bank_local_congr F ?_ (hI.banks j hjold)
      intro s hs
      have hl:=length_le (show j ≤ n by omega)
      have hb:=bank_bounds F hI.input (show j ≤ n by omega)
      have hend : bankStart n j+rowStart (n+j) j ≤ bankStart n (τ.vars index) := by
        have hh:=Nat.mul_le_mul_right (maxLength n) (show j+2 ≤ τ.vars index+1 by omega)
        unfold bankStart
        nlinarith
      apply hmem _ (by have ht:=hI.input.table_fit;omega) (Or.inl (by omega))
  · intro s hs hsep
    apply (hmem s hs ?_).trans (hI.memory s hs hsep)
    rcases hsep with hh|hh
    · exact Or.inl (by omega)
    · exact Or.inr (by omega)
def initialized (σ : Env) (n : Nat) := (σ.setVar index 0).setVar limit (n+1)
theorem routine_run {n Sn B : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ : Env} (h : Input F S z Sn B σ) :
    ∃τ,Run B routine σ τ (routineCost F n) ∧
      Problem18IMPBoundaryDependence20261001.Input F S z Sn B τ ∧
      (∀s<Sn,(s< maxLength n ∨ (n+2)*maxLength n ≤ s) →
        val F canonical gauss.WS τ s=val F canonical gauss.WS σ s) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hw:=word_bounds F h
  have hinit : Input F S z Sn B (initialized σ n) := by
    apply input_setVar F
    · exact input_setVar F h index 0 (by decide) (by decide) (by decide) (by decide) (by decide)
    all_goals decide
  have h0 : Invariant F S z Sn B σ (initialized σ n) := by
    refine ⟨hinit,by simp [initialized,index,limit],by simp [initialized],?_,?_,rfl,rfl⟩
    · intro j hj;simp [initialized,index,limit] at hj
    · intro s _ _
      simp only [initialized,val_setVar F canonical (show limit≠gauss.WS by decide),
        val_setVar F canonical (show index≠gauss.WS by decide)]
  have hdef : ∀τ,Invariant F S z Sn B σ τ →
      ∃b,(Cond.lt (.var index) (.var limit)).evalB B τ=some b := by
    intro τ ht
    have hi:=ht.index_le
    have hl:=ht.limit_eq
    exact evalB_condLt_vars (by omega) (by omega)
  have hstep : ∀τ,Invariant F S z Sn B σ τ →
      (Cond.lt (.var index) (.var limit)).evalB B τ=some true →
      ∃ρ,Run B body τ ρ (bodyCost F n) ∧ Invariant F S z Sn B σ ρ ∧
        n+1-ρ.vars index<n+1-τ.vars index := by
    intro τ ht hcond
    have hi:=ht.index_le
    have hl:=ht.limit_eq
    rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by omega))] at hcond
    simp only [Option.some.injEq,decide_eq_true_eq] at hcond
    obtain ⟨ρ,hr,hρ,hidx⟩:=iteration_run F ht (by omega)
    exact ⟨ρ,hr,hρ,by rw [hidx];omega⟩
  obtain ⟨τ,hr,hτ,hstop⟩:=Run.while_count (Invariant F S z Sn B σ)
    (fun τ=>n+1-τ.vars index) (bodyCost F n) hdef hstep h0
  have hi:=hτ.index_le
  have hl:=hτ.limit_eq
  have he : τ.vars index=n+1 := by
    rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by omega))] at hstop
    simp only [Option.some.injEq,decide_eq_false_iff_not] at hstop
    omega
  have en : (Expr.add (.var gauss.n) (.lit 1)).evalB B (σ.setVar index 0)=some (n+1) := by
    apply evalB_bin
    · simpa [gauss,index] using (show (Expr.var gauss.n).evalB B σ=some n by rw [←h.dimension];exact evalB_var (by rw [h.dimension];omega))
    · exact evalB_lit (by omega)
    · change n+1<B;omega
  refine ⟨τ,?_,⟨hτ.input.slots,hτ.input.dimension,hτ.input.stride,?_,?_⟩,
    hτ.memory,hτ.input_tape,hτ.output_tape⟩
  · apply ((Run.assign (x:=index) (evalB_lit (by omega : 0<B))).seq
      ((Run.assign (x:=limit) en).seq hr)).mono
    simp [routineCost,initialized,index,limit,Expr.size,Cond.size]
    ring_nf
    omega
  · have ht:=hτ.input.table_after;have hf:=hτ.input.table_fit;omega
  · intro d hd
    exact hτ.banks d (by rw [he];omega)
theorem decide_run {n Sn B : Nat} {S : Module.End K (Fin n→K)} {z : Fin n→K}
    {σ : Env} (h : Input F S z Sn B σ) :
    ∃τ,Run B decideProgram σ τ (routineCost F n+scanBudget F n) ∧
      Slots F canonical gauss.WS Sn B τ ∧ τ.vars answerReg=(firstDegree S z).val ∧
      (∀j:Fin (firstDegree S z).val,val F canonical gauss.WS τ (5+(n+j.val))=
        -coefficients S z (firstDegree S z).val j) ∧
      (∀s<Sn,(n+2)*maxLength n ≤ s → val F canonical gauss.WS τ s=val F canonical gauss.WS σ s) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  obtain ⟨ρ,hr,hρ,hmem,hin,hout⟩:=routine_run F h
  obtain ⟨τ,ht,hslots,hdegree,hcoeff,hframe,hit,hot⟩:=
    Problem18IMPBoundaryDependence20261001.routine_run F hρ
  refine ⟨τ,hr.seq ht,hslots,hdegree,hcoeff,?_,hit.trans hin,hot.trans hout⟩
  intro s hs hge
  rw [hframe s hs (by nlinarith),hmem s hs (Or.inr hge)]
end
