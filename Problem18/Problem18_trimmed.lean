theorem coefficient_weight_le_degree {D : DivisorA k K} (hD : IsEffective k K D)
    (P : PlaceA k K) : D P * placeDegree k K P ≤ deg k K D := by
  classical
  have h : Finsupp.single P (D P) ≤ D := by
    intro Q
    by_cases hQP : Q=P
    · subst Q; simp
    · simpa [Finsupp.single_apply,hQP] using hD Q
  simpa only [deg_single] using deg_mono k K h
theorem finite_effective_degree_le [Finite k] (n : Nat) :
    {D : DivisorA k K | IsEffective k K D ∧ deg k K D ≤ n}.Finite := by
  classical
  let S := {P : PlaceA k K // placeDegree k K P ≤ n}
  let T := {D : DivisorA k K // IsEffective k K D ∧ deg k K D ≤ n}
  letI : Finite S := (finite_chart_places_degree_le k K n).to_subtype
  have hcoeff (D : T) (P : PlaceA k K) : (D.val P) ∈ Set.Icc (0 : ℤ) n := by
    have h := (coefficient_weight_le_degree k K D.property.1 P).trans D.property.2
    have hp : (1 : ℤ) ≤ placeDegree k K P := by exact_mod_cast placeDegree_pos k K P
    exact ⟨D.property.1 P,by nlinarith [D.property.1 P]⟩
  have hzero (D : T) (P : PlaceA k K) (hp : ¬ placeDegree k K P ≤ n) : D.val P = 0 := by
    have h := (coefficient_weight_le_degree k K D.property.1 P).trans D.property.2
    have hp' : (n : ℤ) < placeDegree k K P := by exact_mod_cast Nat.lt_of_not_ge hp
    have hn := D.property.1 P
    by_contra hne
    have hd : 1 ≤ D.val P := by omega
    nlinarith
  let φ : T → (S → Set.Icc (0 : ℤ) n) := fun D P => ⟨D.val P.val,hcoeff D P.val⟩
  have hinj : Function.Injective φ := by
    intro D E h
    apply Subtype.ext
    ext P
    by_cases hp : placeDegree k K P ≤ n
    · exact congrArg Subtype.val (congrFun h ⟨P,hp⟩)
    · rw [hzero D P hp,hzero E P hp]
