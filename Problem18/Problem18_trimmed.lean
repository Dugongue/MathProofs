      (∀k<n,(tau.arrs a).getD (targetBase+k) 0=v) ∧
      (∀k,(k<targetBase ∨ targetBase+n≤k) →
        (tau.arrs a).getD k 0=(sigma.arrs a).getD k 0) ∧
