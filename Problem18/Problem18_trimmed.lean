    (segCopy nativeMem spanMem mcIdx mcCnt mcSb mcDb)
def sbA : Sz := Sz.ve +ₛ Cₛ 1
def sbB : Sz := (Sz.ve +ₛ Cₛ 1) +ₛ Sz.ve *ₛ sideLen
noncomputable def sides : Com :=
  .seq (.assign sbR (Sz.expr sbA)) <| .seq (side gatherA) <|
    .seq (.assign sbR (Sz.expr sbB)) (side gatherT)
def cmpArgs (o cnt : Sz) : List (String × Sz) :=
  [(cc, cnt), (c1, sbA +ₛ Sz.ve *ₛ o), (c2, sbB +ₛ Sz.ve *ₛ o)]
def cmp (o cnt : Sz) (flag : String) : Com :=
  .seq (asg (cmpArgs o cnt)) (segEq canonical.mem ci cc c1 c2 flag)
def cmps : Com := .seq (cmp oG (Sz.ve *ₛ (n1 *ₛ n1)) gF) (cmp oT (Sz.ve *ₛ (Cₛ 1 *ₛ n1)) tF)
noncomputable def spans : Com :=
  .seq (.assign sbR (Sz.expr sbA)) <| .seq spanBlock <| .seq (.assign zA (.var zR)) <|
    .seq (.assign sbR (Sz.expr sbB)) spanBlock
def combine : Com :=
  .seq (.assign result (.lit 0))
    (.ite (.eq (.var rTReg) (.lit 1))
      (.ite (.eq (.var gF) (.lit 1))
        (.ite (.eq (.var zA) (.var zR))
          (.ite (.eq (.var zA) (.lit 0)) (.assign result (.var tF)) (.assign result (.lit 1)))
          .skip)
        .skip)
      .skip)
noncomputable def core : Com := .seq setup <| .seq sides <| .seq cmps <| .seq spans combine
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
structure CoreStart (B n d : Nat) (ρ : Env) : Prop where
  vn : ρ.vars nR = n
  vd : ρ.vars dR = d
  ve : ρ.vars eR = F.e
  vp : ρ.vars canonical.p = F.p
  vmod : ρ.vars canonical.modBase = 0
  vexp : ρ.vars canonical.exp < B
  arith : (F.p+1)^2 < B
  inv : (F.p+1)^(F.e+1) < B
  scr_word : (ρ.arrs canonical.scratch).length < B
  scr_fit : 16*(F.e+1) ≤ (ρ.arrs canonical.scratch).length
  nat_len : F.e ≤ (ρ.arrs nativeMem).length
  nat_mod : ∀ i (hi : i < F.e), (ρ.arrs nativeMem).getD i 0 = (F.modulus ⟨i, hi⟩).val
  m_len : charTwoMemLen n d F.e ≤ (ρ.arrs canonical.mem).length
  m_word : (ρ.arrs canonical.mem).length < B
  m_zero : ∀ j, (ρ.arrs canonical.mem).getD j 0 = 0
  p_len : charTwoSpanLen n d F.e ≤ (ρ.arrs spanMem).length
  p_word : (ρ.arrs spanMem).length < B
theorem mcArgs_facts : (∀ p ∈ mcArgs, p.1 ∉ Sz.reads) ∧ (mcArgs.map Prod.fst).Nodup := by
  refine ⟨?_, by simp only [mcArgs, List.map_cons, List.map_nil]; decide⟩
  intro p hp; simp only [mcArgs, List.mem_cons, List.not_mem_nil, or_false] at hp
  rcases hp with rfl|rfl|rfl <;> (dsimp only; decide)
theorem setup_run {B n d : Nat} (ρ : Env) (h : CoreStart F B n d ρ) (sb : Nat)
    (hsb : ρ.vars sbR = sb) :
    ∃ τ, Run B setup ρ τ (asgCost mcArgs + (20*F.e+6) + (20*F.e+6)) ∧
      ValidMemory F B τ ∧
      (∀ i (hi : i < F.e), (τ.arrs spanMem).getD i 0 = (F.modulus ⟨i, hi⟩).val) ∧
      (τ.arrs canonical.mem).length = (ρ.arrs canonical.mem).length ∧
      (τ.arrs spanMem).length = (ρ.arrs spanMem).length ∧
      (∀ a, a ≠ canonical.mem → a ≠ spanMem → τ.arrs a = ρ.arrs a) ∧
      (∀ x, x ∉ scalarWrites setup → τ.vars x = ρ.vars x) ∧
      τ.inp = ρ.inp ∧ τ.out = ρ.out := by
  have hE := F.degree_pos
  have hpB : F.p < B := by have := h.arith; nlinarith
  have heB1 : F.e + 1 < B := by
    have := h.inv
    have h2 : F.e + 1 < (F.p+1)^(F.e+1) := by
      have hp2 := F.prime.two_le
      calc F.e+1 < 2^(F.e+1) := Nat.lt_two_pow_self
        _ ≤ (F.p+1)^(F.e+1) := Nat.pow_le_pow_left (by omega) _
    omega
  have heB : F.e < B := by omega
  have hnatlen := h.nat_len
  have hMe : F.e ≤ (ρ.arrs canonical.mem).length := by
    have := h.m_len; unfold charTwoMemLen at this; omega
  have hPe : F.e ≤ (ρ.arrs spanMem).length := by
    have := h.p_len; unfold charTwoSpanLen at this; omega
  obtain ⟨ρ1, r1, vals1, rest1, arr1, i1, o1⟩ := asg_run mcArgs ρ h.vn h.vd h.ve hsb
    mcArgs_facts.1 mcArgs_facts.2
    (by intro x hx; simp only [mcArgs, List.mem_cons, List.not_mem_nil, or_false] at hx
        rcases hx with rfl|rfl|rfl <;> simp [Sz.majorant] <;> omega)
  have hcnt : ρ1.vars mcCnt = F.e := vals1 (mcCnt, Sz.ve) (by simp [mcArgs])
  have hs : ρ1.vars mcSb = 0 := vals1 (mcSb, Cₛ 0) (by simp [mcArgs])
  have hdb : ρ1.vars mcDb = 0 := vals1 (mcDb, Cₛ 0) (by simp [mcArgs])
  have hnatw : ∀ k < F.e, (ρ1.arrs nativeMem).getD (0+k) 0 < B := by
    intro k hk; rw [arr1, Nat.zero_add, h.nat_mod k hk]
    exact lt_trans (F.modulus ⟨k, hk⟩).isLt hpB
  obtain ⟨ρ2, r2, c2', f2, a2, l2, v2, i2, o2⟩ :=
    segCopy_run (src := nativeMem) (dst := canonical.mem) (idx := mcIdx) (cnt := mcCnt)
      (sb := mcSb) (db := mcDb) (by decide) (by decide) (by decide) (by decide)
      (n := F.e) (sourceBase := 0) (targetBase := 0) ρ1 heB hcnt hs hdb (by omega) (by omega)
      (by rw [arr1]; omega) (by rw [arr1]; omega) hnatw
