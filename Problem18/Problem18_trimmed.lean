      have hh := Mathproof.Problem18OrdinaryFirstGeneration20261001.charTwo_first_family_failure_le (K:=K) a b c ha hb hbc hlarge
      exact hh.trans (enlarge_constant b hb 5 (by norm_num))
    · exact Mathproof.Problem18OrdinaryFirstGeneration20261001.odd_first_family_failure_le (K:=K) hchar a b c ha hb hbc hlarge
  | true =>
    let d := Classical.choice (Mathproof.Problem18UnitaryRootField20260930.exists_unitaryFieldData q hv)
    letI : StarRing K := d.starRing
    have he : (fun A : RectTensor (a+1) b c K=>Algebra.adjoin K (Set.range (rawFirst true q A))≠⊤)=
