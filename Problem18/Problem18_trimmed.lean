abbrev tBank : String := Problem18IMPTensorGather20261002.memory
abbrev kBank : String := Mathproof.Problem18PairBoundaryPrefix20261004.keepBank
def swapK : String ≃ String := Equiv.swap tBank kBank
def gatherT : Com := gatherCall (atW oX)
def gatherA : Com := renameCom swapK (gatherCall (atW oX))
theorem gatherT_facts : (∀ x ∈ sideRegs, x ∉ scalarWrites gatherT) ∧ noRead gatherT ∧
    gatherT.NoWrite ∧ arrayWrites gatherT ⊆ {canonical.mem, canonical.scratch} := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · unfold gatherT gatherCall; simp only [Problem18IMPTensorGatherStore20261002.routine,
      Problem18IMPTensorGatherStore20261002.body, scalarWrites]; decide
  · unfold gatherT gatherCall; repeat' constructor
  · unfold gatherT gatherCall; repeat' constructor
  · unfold gatherT gatherCall; decide
theorem gatherA_facts : (∀ x ∈ sideRegs, x ∉ scalarWrites gatherA) ∧ noRead gatherA ∧
    gatherA.NoWrite ∧ arrayWrites gatherA ⊆ {canonical.mem, canonical.scratch} := by
  obtain ⟨h1, h2, h3, -⟩ := gatherT_facts
  refine ⟨?_, ?_, ?_, ?_⟩
  · unfold gatherA; rw [scalarWrites_rename]; exact h1
  · unfold gatherA; rw [noRead_rename]; exact h2
  · unfold gatherA; rw [noWrite_rename]; exact h3
  · unfold gatherA gatherCall swapK; decide
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
structure GatherInput (B a b c : Nat) (src : String) (A : RectTensor a b c K) (ρ0 : Env) : Prop where
  a_pos : 0 < a
  b_pos : 0 < b
  c_pos : 0 < c
  first : (shape (sortOrder a b c) a b c).1 = 1
  loaded : (parameters 0 (sortOrder a b c) a b c F.e).loaded ρ0
  bounded : (parameters 0 (sortOrder a b c) a b c F.e).bounded B
  cells_word : a*b*c*F.e < B
  total : ρ0.vars Problem18IMPTensorGather20261002.total = a*b*c*F.e
  cells : a*b*c = boundaryHeight a b c * boundaryWidth a b c
  fit : a*b*c*F.e ≤ (ρ0.arrs src).length
  len_word : (ρ0.arrs src).length < B
  canon : ∀ x < (ρ0.arrs src).length, (ρ0.arrs src).getD x 0 < F.p
  value : ∀ x < a*b*c*F.e, (ρ0.arrs src).getD x 0 = (tensorCoordinates F A).getD x 0
theorem loaded_of_regs {a b c : Nat} {ρ ρ0 : Env}
    (h : (parameters 0 (sortOrder a b c) a b c F.e).loaded ρ0)
    (hr : ∀ x ∈ sideRegs, ρ.vars x = ρ0.vars x) :
    (parameters 0 (sortOrder a b c) a b c F.e).loaded ρ := by
  obtain ⟨h0,h1,h2,h3,h4,h5,h6⟩ := h
  refine ⟨?_,?_,?_,?_,?_,?_,?_⟩ <;> (rw [hr _ (by decide)]; assumption)
theorem gatherT_spec {B a b c sb : Nat} (T : RectTensor a b c K) (ρ0 : Env)
    (hg : GatherInput F B a b c tBank T ρ0)
    (hx : Sz.majorant (atW oX) (boundaryWidth a b c) (boundaryHeight a b c) F.e sb < B)
    (hmod : ρ0.vars canonical.modBase + F.e ≤ sb + F.e*xN (boundaryWidth a b c) (boundaryHeight a b c))
    (hfitX : sb + F.e*xN (boundaryWidth a b c) (boundaryHeight a b c) +
      F.e*(boundaryHeight a b c * boundaryWidth a b c) ≤ (ρ0.arrs canonical.mem).length) :
    GatherSpec F B (boundaryWidth a b c) (boundaryHeight a b c) sb
      (1 + (Sz.expr (atW oX)).size + 210*(a*b*c*F.e+1)) gatherT ρ0
      (Problem18DimensionOneBoundary20260930.matrixOf
        (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
          (sortOrder a b c) T hg.first)) := by
  intro ρ hv hn hd he hsb hr harr hlen
  have hsrc : ρ.arrs tBank = ρ0.arrs tBank := harr _ (by decide) (by decide)
  have hN : a*b*c*F.e = F.e*(boundaryHeight a b c * boundaryWidth a b c) := by
    rw [hg.cells, Nat.mul_comm]
  obtain ⟨τ, r, v, m, f⟩ := gatherCall_run F (atW oX)
    (X := sb + F.e*xN (boundaryWidth a b c) (boundaryHeight a b c)) ρ hv hn hd he hsb hx rfl
    hg.a_pos hg.b_pos hg.c_pos T hg.first (loaded_of_regs F hg.loaded hr) hg.bounded hg.cells_word
    (by rw [hr _ (by decide)]; exact hg.total) (by rw [hr _ (by decide)]; exact hmod)
    (by rw [hlen, hN]; exact hfitX) (by rw [hsrc]; exact hg.fit) (by rw [hsrc]; exact hg.len_word)
    (by rw [hsrc]; exact hg.canon) (by rw [hsrc]; exact hg.value)
  refine ⟨τ, r, v, m, ?_⟩
  intro j hj
  exact f j (by rw [hN]; exact hj)
theorem gatherA_spec {B a b c sb : Nat} (A : RectTensor a b c K) (ρ0 : Env)
    (hg : GatherInput F B a b c kBank A ρ0)
    (hx : Sz.majorant (atW oX) (boundaryWidth a b c) (boundaryHeight a b c) F.e sb < B)
    (hmod : ρ0.vars canonical.modBase + F.e ≤ sb + F.e*xN (boundaryWidth a b c) (boundaryHeight a b c))
    (hfitX : sb + F.e*xN (boundaryWidth a b c) (boundaryHeight a b c) +
      F.e*(boundaryHeight a b c * boundaryWidth a b c) ≤ (ρ0.arrs canonical.mem).length) :
    GatherSpec F B (boundaryWidth a b c) (boundaryHeight a b c) sb
      (1 + (Sz.expr (atW oX)).size + 210*(a*b*c*F.e+1)) gatherA ρ0
      (Problem18DimensionOneBoundary20260930.matrixOf
        (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
          (sortOrder a b c) A hg.first)) := by
  intro ρ hv hn hd he hsb hr harr hlen
  let ρ' := renameEnv swapK ρ
  have hmem' : ∀ x : Env, (renameEnv swapK x).arrs canonical.mem = x.arrs canonical.mem := by
    intro x; show x.arrs (swapK.symm canonical.mem) = _
    simp [swapK, Equiv.swap_apply_of_ne_of_ne (show canonical.mem ≠ tBank by decide)
      (show canonical.mem ≠ kBank by decide)]
  have hscr' : ∀ x : Env, (renameEnv swapK x).arrs canonical.scratch = x.arrs canonical.scratch := by
    intro x; show x.arrs (swapK.symm canonical.scratch) = _
    simp [swapK, Equiv.swap_apply_of_ne_of_ne (show canonical.scratch ≠ tBank by decide)
      (show canonical.scratch ≠ kBank by decide)]
  have hsrc' : ρ'.arrs tBank = ρ0.arrs kBank := by
    show ρ.arrs (swapK.symm tBank) = _
    simp [swapK]
    exact harr _ (by decide) (by decide)
  have hv' : ValidMemory F B ρ' :=
    Mathproof.Problem18PairBoundaryModeC2Calls20261004.valid_of_words F hv rfl rfl rfl
      (by rw [hmem']) (by rw [hscr']) (fun i _ => by rw [hmem'])
      (fun j hj => by rw [hmem'] at hj ⊢; exact hv.coefficients j hj)
  have hN : a*b*c*F.e = F.e*(boundaryHeight a b c * boundaryWidth a b c) := by
    rw [hg.cells, Nat.mul_comm]
  obtain ⟨τ', r, v, m, f⟩ := gatherCall_run F (atW oX)
    (X := sb + F.e*xN (boundaryWidth a b c) (boundaryHeight a b c)) ρ' hv' hn hd he hsb hx rfl
    hg.a_pos hg.b_pos hg.c_pos A hg.first (loaded_of_regs F hg.loaded hr) hg.bounded hg.cells_word
    (by show ρ.vars _ = _; rw [hr _ (by decide)]; exact hg.total)
    (by show ρ.vars _ + _ ≤ _; rw [hr _ (by decide)]; exact hmod)
    (by rw [hmem', hlen, hN]; exact hfitX) (by rw [hsrc']; exact hg.fit)
    (by rw [hsrc']; exact hg.len_word) (by rw [hsrc']; exact hg.canon)
    (by rw [hsrc']; exact hg.value)
  refine ⟨renameEnv swapK τ', ?_, ?_, ?_, ?_⟩
  · have := rename_run swapK r
    have h2 : renameEnv swapK ρ' = ρ := swap_involutive _ _ ρ
    rw [h2] at this
    exact this
  · exact Mathproof.Problem18PairBoundaryModeC2Calls20261004.valid_of_words F v rfl rfl rfl
      (by rw [hmem']) (by rw [hscr']) (fun i _ => by rw [hmem'])
      (fun j hj => by rw [hmem'] at hj ⊢; exact v.coefficients j hj)
  · rw [← m]
    exact Mathproof.Problem18PairBoundaryModeC2Base20261004.matrix_congr F
      (fun j _ _ => by rw [hmem'])
  · intro j hj
    rw [hmem', f j (by rw [hN]; exact hj), hmem']
end Mathproof.Problem18PairBoundaryModeC2Gather20261004
