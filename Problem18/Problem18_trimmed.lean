        Function.update] <;> rfl
theorem fullInput_padding_complete {N : Nat} (p : Polynomial Nat)
    (x : List Nat) (state : WrapperState N)
    (hlen : x.length < 2 ^ simulationWordWidth p x)
    (hfit : ∀ n ∈ x, n < 2 ^ simulationWordWidth p x) :
