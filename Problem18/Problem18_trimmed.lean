theorem mono_pow {s : Nat} (hs : 1 ≤ s) {i j : Nat} (h : i ≤ j) : s ^ i ≤ s ^ j :=
  Nat.pow_le_pow_right hs h
theorem m2 {x y s : Nat} (hx : x ≤ s) (hy : y ≤ s) : x * y ≤ s ^ 2 := by
  have := Nat.mul_le_mul hx hy; nlinarith
theorem m3 {x y z s : Nat} (hx : x ≤ s) (hy : y ≤ s) (hz : z ≤ s) : x * y * z ≤ s ^ 3 := by
  have := Nat.mul_le_mul (Nat.mul_le_mul hx hy) hz; nlinarith
theorem m4 {x y z w s : Nat} (hx : x ≤ s) (hy : y ≤ s) (hz : z ≤ s) (hw : w ≤ s) :
    x * y * (z * w) ≤ s ^ 4 := by
  have := Nat.mul_le_mul (Nat.mul_le_mul hx hy) (Nat.mul_le_mul hz hw); nlinarith
theorem blockSize_le {N M s : Nat} (hN : N ≤ s ^ 4) (hM : M ≤ s ^ 2) (hs : 1 ≤ s) :
