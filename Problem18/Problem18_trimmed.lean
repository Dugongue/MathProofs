  rw [readState_vars _ _ _ _ _ _ hx.1 hx.2.1]
  simp only [vars_setVar,if_neg hx.2.2.2,if_neg hx.2.2.1]
  exact readState_vars _ _ _ _ _ _ hx.1 hx.2.1
theorem fields :
    (result F u q A T ext).vars canonical.e=F.e ∧
    (result F u q A T ext).vars canonical.p=F.p ∧
    (result F u q A T ext).vars canonical.modBase=0 ∧
    (result F u q A T ext).vars "u"=u.toNat ∧
    (result F u q A T ext).vars "q"=q := by
  repeat' constructor
  all_goals rw [scalar F u q A T ext _ (by decide)]
  all_goals simp [modPrepared,after,readEnv,headerNames,queryWords,header,List.append_assoc,canonical]
theorem zero_tail (i : Nat) (hi : i<ext canonical.mem) (hle : F.e ≤ i) :
    ((result F u q A T ext).arrs canonical.mem).getD i 0=0 := by
  have h:=readState_outside modIO (modPrepared F u q A T ext) (modWords F)
    (tensorCoordinates F A++tensorCoordinates F T) i
    (by simpa [modIO,modPrepared,after,readEnv,headerNames,queryWords,header,List.append_assoc,initEnv] using hi)
    (by right; simpa [modIO,modPrepared,modWords] using hle)
  have hz : ((modPrepared F u q A T ext).arrs canonical.mem).getD i 0=0 := by
    simp [modPrepared,after,readEnv,headerNames,queryWords,header,List.append_assoc,initEnv]
  change _=((modPrepared F u q A T ext).arrs canonical.mem).getD i 0 at h
  rw [hz] at h
  simpa [result,prepared,readState,pointState,Names.point,loadNames,Problem18IMPTensorGather20261002.memory,canonical,
    modLoaded,modIO,modWords] using h
theorem card_run (B : Nat) (σ : Env) (hu : σ.vars "u"=u.toNat) (hq : σ.vars "q"=q)
    (hQ : (if u then q*q else q)=Fintype.card K) (hqB : q<B) (hcard : Fintype.card K<B) (h1 : 1<B) :
    Run B cardProgram σ (σ.setVar canonical.exp (Fintype.card K)) 10 := by
  have ev : (Expr.var "q").evalB B σ=some q := by simpa [hq] using evalB_var (B:=B) (σ:=σ) (x:="q") (hq ▸ hqB)
  cases u
  · simp only [Bool.false_eq_true,↓reduceIte] at hQ
    have cond : (Cond.eq (.var "u") (.lit 0)).evalB B σ=some true := by
      simpa [hu] using evalB_condEq (evalB_var (B:=B) (σ:=σ) (x:="u") (by simp [hu]; omega)) (evalB_lit (B:=B) (by omega : 0<B))
    have hr:=Run.ite_true (d:=.assign canonical.exp (.bin .mul (.var "q") (.var "q"))) cond (Run.assign (x:=canonical.exp) ev)
    try simp only [Bop.apply] at hr
    rw [hQ] at hr
    exact hr.mono (by simp [Cond.size,Expr.size])
  · simp only [↓reduceIte] at hQ
    have cond : (Cond.eq (.var "u") (.lit 0)).evalB B σ=some false := by
      simpa [hu] using evalB_condEq (evalB_var (B:=B) (σ:=σ) (x:="u") (by simpa [hu] using h1)) (evalB_lit (B:=B) (by omega : 0<B))
    have he:=evalB_bin (op:=.mul) ev ev (by simpa [hQ] using hcard)
    have hr:=Run.ite_false (c:=.assign canonical.exp (.var "q")) cond (Run.assign (x:=canonical.exp) he)
    try simp only [Bop.apply] at hr
    rw [hQ] at hr
    exact hr.mono (by simp [Cond.size,Expr.size])
theorem run (B : Nat) (hE : F.e+1<B) (hqB : q<B)
    (hQ : (if u then q*q else q)=Fintype.card K) (hcard : Fintype.card K<B) :
    Run B program (result F u q A T ext) (ready F u q A T ext) 20 := by
  have hf:=fields F u q A T ext
