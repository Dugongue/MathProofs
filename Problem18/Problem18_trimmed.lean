  if h : i < c * (a * b) then
    Z ⟨i / (a * b), (Nat.div_lt_iff_lt_mul (pos_of_lt_mul h)).mpr h⟩
      (⟨i % (a * b) / b, (Nat.div_lt_iff_lt_mul (pos_of_lt_mul (pos_of_lt_mul h))).mpr
          (Nat.mod_lt _ (pos_of_lt_mul h))⟩,
        ⟨i % b, Nat.mod_lt _ (pos_of_lt_mul (pos_of_lt_mul h))⟩)
