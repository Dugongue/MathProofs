theorem map_val_injective {A B : Type*} [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]
    (B0 : Subalgebra k B) :
    Function.Injective (Algebra.TensorProduct.map B0.val (AlgHom.id k A)) := by
  have heq : (Algebra.TensorProduct.map B0.val (AlgHom.id k A) : B0 ⊗[k] A → B ⊗[k] A) =
      (B0.val.toLinearMap.rTensor A : B0 ⊗[k] A → B ⊗[k] A) := by
    funext z
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]
    | tmul b a => rw [Algebra.TensorProduct.map_tmul, LinearMap.rTensor_tmul]; rfl
    | add z w hz hw => rw [map_add, map_add, hz, hw]
  rw [heq]
  exact Module.Flat.rTensor_preserves_injective_linearMap (M := A) B0.val.toLinearMap
    Subtype.val_injective
theorem exists_fg_preimage {A B : Type*} [CommRing A] [Algebra k A] [CommRing B] [Algebra k B]
    (z : B ⊗[k] A) : ∃ s : Finset B, ∀ t : Finset B, s ⊆ t →
      ∃ z' : Algebra.adjoin k (t : Set B) ⊗[k] A,
        Algebra.TensorProduct.map (Algebra.adjoin k (t : Set B)).val (AlgHom.id k A) z' = z := by
  classical
  induction z using TensorProduct.induction_on with
  | zero => exact ⟨∅, fun t _ => ⟨0, map_zero _⟩⟩
  | tmul b a =>
    refine ⟨{b}, fun t ht => ⟨⟨b, Algebra.subset_adjoin (Finset.mem_coe.mpr
      (ht (Finset.mem_singleton_self b)))⟩ ⊗ₜ[k] a, ?_⟩⟩
    rw [Algebra.TensorProduct.map_tmul, AlgHom.id_apply]
    rfl
  | add x y hx hy =>
    obtain ⟨s1, h1⟩ := hx
    obtain ⟨s2, h2⟩ := hy
    refine ⟨s1 ∪ s2, fun t ht => ?_⟩
    obtain ⟨x', hx'⟩ := h1 t (Finset.union_subset_left ht)
    obtain ⟨y', hy'⟩ := h2 t (Finset.union_subset_right ht)
    exact ⟨x' + y', by rw [map_add, hx', hy']⟩
theorem noZeroDivisors_tensor {A B : Type*} [CommRing A] [IsDomain A] [Algebra k A]
    [CommRing B] [IsDomain B] [Algebra k B] : NoZeroDivisors (B ⊗[k] A) := by
  classical
  refine ⟨fun {x y} hxy => ?_⟩
  obtain ⟨s1, h1⟩ := exists_fg_preimage (k := k) x
  obtain ⟨s2, h2⟩ := exists_fg_preimage (k := k) y
  obtain ⟨x', hx'⟩ := h1 (s1 ∪ s2) Finset.subset_union_left
  obtain ⟨y', hy'⟩ := h2 (s1 ∪ s2) Finset.subset_union_right
  haveI : Algebra.FiniteType k (Algebra.adjoin k ((s1 ∪ s2 : Finset B) : Set B)) :=
    (Subalgebra.fg_iff_finiteType _).mp (Subalgebra.fg_adjoin_finset _)
  have hinj := map_val_injective (A := A) (Algebra.adjoin k ((s1 ∪ s2 : Finset B) : Set B))
  have h0 : x' * y' = 0 := hinj (by rw [map_mul, hx', hy', hxy, map_zero])
  rcases eq_zero_or_eq_zero_of_finiteType _ _ h0 with h | h
  · left
    rw [← hx', h, map_zero]
  · right
    rw [← hy', h, map_zero]
theorem isDomain_tensor {A B : Type*} [CommRing A] [IsDomain A] [Algebra k A]
    [CommRing B] [IsDomain B] [Algebra k B] : IsDomain (B ⊗[k] A) := by
  haveI : NoZeroDivisors (B ⊗[k] A) := noZeroDivisors_tensor
  haveI : Nontrivial (B ⊗[k] A) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_flat_right k B A
      (algebraMap k B).injective
  exact NoZeroDivisors.to_isDomain _
