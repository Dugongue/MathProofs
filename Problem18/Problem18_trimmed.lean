variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
def anchorLeftMatrix (B : LinearMap.BilinForm K V) (eps : K)
    {k m : ℕ} (w : Fin k → V) (u : Fin m → V × V) :
    Matrix (Fin k) (Fin (m + m)) K := fun i c =>
  match finSumFinEquiv.symm c with
  | Sum.inl j => B (u j).2 (w i)
  | Sum.inr j => eps * B (u j).1 (w i)
def anchorRightMatrix (B : LinearMap.BilinForm K V)
    {z m : ℕ} (v : Fin z → V) (u : Fin m → V × V) :
    Matrix (Fin z) (Fin (m + m)) K := fun i c =>
  match finSumFinEquiv.symm c with
  | Sum.inl j => B (u j).1 (v i)
  | Sum.inr j => B (u j).2 (v i)
theorem anchorLeft_mulVec_anchorRight
    (B : LinearMap.BilinForm K V) (eps : K)
    {k z m : ℕ} (w : Fin k → V) (v : Fin z → V)
    (u : Fin m → V × V) (i : Fin k) (l : Fin z) :
    (anchorLeftMatrix B eps w u).mulVec
        (anchorRightMatrix B v u l) i =
      ∑ j : Fin m,
        (B (u j).2 (w i) * B (u j).1 (v l) +
          eps * B (u j).1 (w i) * B (u j).2 (v l)) := by
  change (∑ c : Fin (m + m),
    anchorLeftMatrix B eps w u i c * anchorRightMatrix B v u l c) = _
  rw [← Equiv.sum_comp finSumFinEquiv, Fintype.sum_sum_type]
  simp only [anchorLeftMatrix, anchorRightMatrix, Equiv.symm_apply_apply]
  rw [← Finset.sum_add_distrib]
def invariantSampleToCrossZero
    (B : LinearMap.BilinForm K V) (eps : K)
    {W : Submodule K V} {k z m : ℕ}
    (w : Fin k → V) (v : Fin z → V)
    (hw : ∀ i, w i ∈ W)
    (hv : ∀ l, RightOrthogonalTo B W (v l))
    (u : Fin m → V × V)
    (hpres : Preserves W (∑ j,
      Mathproof.Problem18AnchorBilinear20260930.anchorPair
        B eps (u j).1 (u j).2)) :
    CrossZeroPairs (K := K) k (m + m) z :=
  ⟨(anchorLeftMatrix B eps w u, anchorRightMatrix B v u), by
    intro l
    funext i
    rw [anchorLeft_mulVec_anchorRight]
    exact anchor_invariant_cross_equation m u hpres (hw i) (hv l)⟩
def leftTestVector {k z : ℕ}
    (E : (Fin (k + z) → K) →ₗ[K] V) (i : Fin k) : V :=
  E (Pi.single (Fin.castAdd z i) 1)
def rightTestVector {k z : ℕ}
    (E : (Fin (k + z) → K) →ₗ[K] V) (l : Fin z) : V :=
  E (Pi.single (Fin.natAdd k l) 1)
def anchorMatrixMap (B : LinearMap.BilinForm K V) (eps : K)
    {k z m : ℕ} (E : (Fin (k + z) → K) →ₗ[K] V) :
    (Fin m → V × V) →
      Matrix (Fin k) (Fin (m + m)) K ×
        Matrix (Fin z) (Fin (m + m)) K := fun u =>
  (anchorLeftMatrix B eps (leftTestVector E) u,
    anchorRightMatrix B (rightTestVector E) u)
theorem anchorMatrixMap_surjective
    [FiniteDimensional K V]
    (B : LinearMap.BilinForm K V) (hB : B.Nondegenerate)
    (eps : K) (heps : eps ^ 2 = 1)
    {k z m : ℕ} (E : (Fin (k + z) → K) →ₗ[K] V)
    (hE : Function.Injective E) :
    Function.Surjective (anchorMatrixMap (m := m) B eps E) := by
  classical
  intro P
  let xcoord (j : Fin m) : Fin (k + z) → K :=
    Fin.addCases
      (fun i => eps * P.1 i (finSumFinEquiv (Sum.inr j)))
      (fun l => P.2 l (finSumFinEquiv (Sum.inl j)))
  let ycoord (j : Fin m) : Fin (k + z) → K :=
    Fin.addCases
      (fun i => P.1 i (finSumFinEquiv (Sum.inl j)))
      (fun l => P.2 l (finSumFinEquiv (Sum.inr j)))
  have hs := Mathproof.Problem18AnchorCoordinates20260930.pairingCoordinates_surjective
    B hB E hE
  choose x hx using fun j : Fin m => hs (xcoord j)
  choose y hy using fun j : Fin m => hs (ycoord j)
  refine ⟨fun j => (x j, y j), ?_⟩
  apply Prod.ext
  · ext i c
    obtain ⟨c, rfl⟩ := finSumFinEquiv.surjective c
    cases c with
    | inl j =>
        have h := congrFun (hy j) (Fin.castAdd z i)
        rw [Mathproof.Problem18AnchorCoordinates20260930.pairingCoordinates_apply] at h
        simpa only [anchorMatrixMap, anchorLeftMatrix, leftTestVector,
          Equiv.symm_apply_apply, xcoord, ycoord, Fin.addCases_left] using h
    | inr j =>
        have h := congrFun (hx j) (Fin.castAdd z i)
        rw [Mathproof.Problem18AnchorCoordinates20260930.pairingCoordinates_apply] at h
        have h' : B (x j) (leftTestVector E i) =
            eps * P.1 i (finSumFinEquiv (Sum.inr j)) := by
          simpa only [xcoord, Fin.addCases_left, leftTestVector] using h
        simp only [anchorMatrixMap, anchorLeftMatrix, Equiv.symm_apply_apply]
        change eps * B (x j) (leftTestVector E i) =
          P.1 i (finSumFinEquiv (Sum.inr j))
        rw [h']
        have heps' : eps * eps = 1 := by simpa only [pow_two] using heps
        rw [← mul_assoc, heps', one_mul]
  · ext l c
    obtain ⟨c, rfl⟩ := finSumFinEquiv.surjective c
    cases c with
    | inl j =>
        have h := congrFun (hx j) (Fin.natAdd k l)
        rw [Mathproof.Problem18AnchorCoordinates20260930.pairingCoordinates_apply] at h
        simpa only [anchorMatrixMap, anchorRightMatrix, rightTestVector,
          Equiv.symm_apply_apply, xcoord, ycoord, Fin.addCases_right] using h
    | inr j =>
        have h := congrFun (hy j) (Fin.natAdd k l)
        rw [Mathproof.Problem18AnchorCoordinates20260930.pairingCoordinates_apply] at h
        simpa only [anchorMatrixMap, anchorRightMatrix, rightTestVector,
          Equiv.symm_apply_apply, xcoord, ycoord, Fin.addCases_right] using h
noncomputable def anchorMatrixLinearMap
    (B : LinearMap.BilinForm K V) (eps : K)
    {k z m : ℕ} (E : (Fin (k + z) → K) →ₗ[K] V) :
    (Fin m → V × V) →ₗ[K]
      Matrix (Fin k) (Fin (m + m)) K ×
        Matrix (Fin z) (Fin (m + m)) K where
  toFun := anchorMatrixMap B eps E
