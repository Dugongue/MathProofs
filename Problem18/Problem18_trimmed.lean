namespace Mathproof.Problem18RootSyntaxMachine20261001
open Problem18FiniteTransducer20261001 Problem18RootWordCodec20261001 BitstringEncoding Turing
def syntaxTransducer : Transducer Bool Bool ReadState where
  initial:=.start
  next q b:=((toRAM.next q b).1,[])
  finish q:=[decide (q=ReadState.start)]
  next_bound _ _:=by simp
  finish_bound _:=by simp
def wellFormed : ReadState → List Bool → Bool
  | q,[]=>decide (q=ReadState.start)
  | q,b::bs=>wellFormed (toRAM.next q b).1 bs
theorem syntax_run (q : ReadState) (xs : List Bool) : run syntaxTransducer q xs=[wellFormed q xs] := by
  induction xs generalizing q with
  | nil=>rfl
  | cons b bs ih=>exact ih (toRAM.next q b).1
theorem header_block (bs rest : List Bool) :
    wellFormed .header (delimit bs++rest)=wellFormed .start rest := by
  induction bs with
  | nil=>rfl
  | cons b bs ih=>exact ih
theorem start_block (bs rest : List Bool) :
    wellFormed .start (delimit bs++rest)=wellFormed .start rest := by
  cases bs with
  | nil=>rfl
  | cons b bs=>exact header_block bs rest
theorem undelimit_suffix (xs block rest : List Bool) (h : undelimit xs=some (block,rest)) :
    xs=delimit block++rest := by
  induction xs using undelimit.induct generalizing block rest with
  | case1 rest' =>
    simp only [undelimit,Option.some.injEq,Prod.mk.injEq] at h
    rcases h with ⟨rfl,rfl⟩
    rfl
  | case2 b input ih=>
    obtain ⟨⟨tail,r⟩,ht,he⟩:=Option.map_eq_some_iff.mp h
    cases he
    change true::b::input=true::b::(delimit tail++r)
    rw [ih tail r ht]
  | case3 xs => simp [undelimit] at h
theorem wellFormed_iff_blocks (xs : List Bool) :
    wellFormed .start xs=true ↔ ∃blocks,undelimitBlocks xs=some blocks := by
  suffices h : ∀fuel xs,xs.length≤fuel →
      (wellFormed .start xs=true ↔ ∃blocks,undelimitBlocksAux fuel xs=some blocks) by
    exact h xs.length xs le_rfl
  intro fuel
  induction fuel with
  | zero=>
    intro xs hx
    cases xs with
    | nil=>simp [wellFormed,undelimitBlocksAux]
    | cons b bs=>simp at hx
  | succ fuel ih=>
    intro xs hx
    cases xs with
    | nil=>simp [wellFormed,undelimitBlocksAux]
    | cons b bs=>
      cases hd : undelimit (b::bs) with
      | none=>
        have hf : wellFormed .start (b::bs)=false := by
          have haux : ∀xs,undelimit xs=none → wellFormed .header xs=false := by
            intro ys
            induction ys using undelimit.induct with
            | case1 rest=>simp [undelimit]
            | case2 c rest ihr=>
              intro hh
              have ht : undelimit rest=none := by simpa [undelimit] using hh
              exact ihr ht
            | case3 ys hfalse htrue=>
              intro hh
              cases ys with
              | nil=>rfl
              | cons a ys=>
                cases a with
                | false=>exact False.elim (hfalse _ rfl)
                | true=>cases ys with
                  | nil=>rfl
                  | cons c ys=>exact False.elim (htrue _ _ rfl)
          cases b with
          | false=>simp [undelimit] at hd
          | true=>cases bs with
            | nil=>rfl
            | cons c cs=>
              change wellFormed .header cs=false
              apply haux cs
              simpa [undelimit] using hd
        simp [undelimitBlocksAux,hd,hf]
      | some pair=>
        obtain ⟨block,rest⟩:=pair
        have hs:=undelimit_suffix (b::bs) block rest hd
        have hl : rest.length≤fuel := by
          have hlen:=congrArg List.length hs
          simp only [List.length_cons,List.length_append,length_delimit] at hlen
          simp only [List.length_cons] at hx
          omega
        rw [show wellFormed .start (b::bs)=wellFormed .start rest by rw [hs,start_block]]
        rw [ih rest hl]
        simp only [undelimitBlocksAux,hd,Option.bind_some]
        constructor
        · rintro ⟨tail,ht⟩; exact ⟨block::tail,by simp [ht]⟩
        · rintro ⟨tail,ht⟩
          obtain ⟨r,hr,_⟩:=Option.map_eq_some_iff.mp ht
          exact ⟨r,hr⟩
noncomputable def syntaxMachine : TM2ComputableInPolyTime id id
    (fun xs : List Bool=>[wellFormed .start xs]) := by
  have he : run syntaxTransducer syntaxTransducer.initial=(fun xs=>[wellFormed .start xs]) :=
    funext (fun xs=>syntax_run .start xs)
  rw [←he]
  exact computable syntaxTransducer
theorem syntax_machine_exists : Nonempty (TM2ComputableInPolyTime id id
    (fun xs : List Bool=>[wellFormed .start xs])) := ⟨syntaxMachine⟩
end Mathproof.Problem18RootSyntaxMachine20261001
end
