theorem bitSize_append (x y : List Nat) : bitSize (x ++ y) = bitSize x + bitSize y := by
  simp [bitSize, encode, List.flatMap_append]
theorem bits_length_le_of_lt {k m : Nat} (h : k < 2 ^ m) : (Nat.bits k).length ≤ m := by
  rw [Nat.size_eq_bits_len]; exact Nat.size_le.mpr h
theorem poly_mono (P : Polynomial Nat) {m n : Nat} (h : m ≤ n) : P.eval m ≤ P.eval n := by
  rw [Polynomial.eval_eq_sum, Polynomial.eval_eq_sum]
  apply Finset.sum_le_sum
  intro i _
  exact Nat.mul_le_mul_left _ (Nat.pow_le_pow_left h i)
theorem routed_bitSize_le (u q p e a b c o br : Nat) (s t : List Nat)
    (ho : o < 8) (hbr : br < 4) :
    bitSize ([0,u,q,p,e,a,b,c] ++ [o, br] ++ s) ≤
      bitSize (1 :: u :: q :: p :: e :: a :: b :: c :: (s ++ t)) + 7 := by
  have h1 := bits_length_le_of_lt (k := o) (m := 3) (by simpa using ho)
  have h2 := bits_length_le_of_lt (k := br) (m := 2) (by simpa using hbr)
  simp only [List.cons_append, List.nil_append, Lax51Proofs.Encoding.bitSize_cons, bitSize_append]
  simp
  omega
