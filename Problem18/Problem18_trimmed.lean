theorem pre_P_ne_B (y y' : String) : pre "B" y ≠ pre "P" y' := by
  intro h; have := congrArg (fun t => t.toList.take 5) h; simp [pre, String.toList_append] at this
theorem pre_P_ne_L (y y' : String) : pre "L" y ≠ pre "P" y' := by
  intro h; have := congrArg (fun t => t.toList.take 5) h; simp [pre, String.toList_append] at this
theorem pre_B_ne_L (y y' : String) : pre "L" y ≠ pre "B" y' := by
  intro h; have := congrArg (fun t => t.toList.take 5) h; simp [pre, String.toList_append] at this
noncomputable def mkExt (base extS extP extB extL : String → Nat) : String → Nat := by
  classical
  exact fun y =>
    if h : ∃ z, y = pre "S" z then extS h.choose else
    if h : ∃ z, y = pre "P" z then extP h.choose else
    if h : ∃ z, y = pre "B" z then extB h.choose else
    if h : ∃ z, y = pre "L" z then extL h.choose else base y
