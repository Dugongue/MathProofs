variable {K : Type*} [Field K] [Fintype K] (σ : K ≃+* K)
theorem fixed_polynomial_descends (p : K[X]) (hp : p.map σ.toRingHom=p) :
    ∃ f : (fixedField σ)[X],f.map (algebraMap (fixedField σ) K)=p := by
  apply (Polynomial.mem_lifts p).mp
  apply (Polynomial.lifts_iff_coeff_lifts p).mpr
  intro i
  refine ⟨⟨p.coeff i,?_⟩,rfl⟩
  apply (mem_fixedField σ _).mpr
  simpa only [Polynomial.coeff_map,RingEquiv.toRingHom_eq_coe,RingEquiv.coe_toRingHom] using congrArg (fun p : K[X] => p.coeff i) hp
theorem mapped_fixedField_fixed (f : (fixedField σ)[X]) :
    (f.map (algebraMap (fixedField σ) K)).map σ.toRingHom=
      f.map (algebraMap (fixedField σ) K) := by
  ext i
  simp only [Polynomial.coeff_map]
  exact (mem_fixedField σ (f.coeff i).val).mp (f.coeff i).property
theorem polynomial_conjugate_twice (hσ : Function.Involutive σ) (p : K[X]) :
    (p.map σ.toRingHom).map σ.toRingHom=p := by
  ext i
  simpa only [Polynomial.coeff_map,RingEquiv.toRingHom_eq_coe,RingEquiv.coe_toRingHom] using hσ (p.coeff i)
theorem fixed_divisor_eq (f : (fixedField σ)[X]) (hm : f.Monic) (hi : Irreducible f)
    (p : K[X]) (hpm : p.Monic) (hpu : ¬IsUnit p)
    (hpd : p ∣ f.map (algebraMap (fixedField σ) K)) (hpf : p.map σ.toRingHom=p) :
    p=f.map (algebraMap (fixedField σ) K) := by
  obtain ⟨a,ha⟩ := fixed_polynomial_descends σ p hpf
  have ham : a.Monic := Polynomial.monic_of_injective (algebraMap (fixedField σ) K).injective
    (ha.symm ▸ hpm)
  have had : a ∣ f := (Polynomial.map_dvd_map' (algebraMap (fixedField σ) K)).mp (ha.symm ▸ hpd)
  have hau : ¬IsUnit a := by
    intro hu
    apply hpu
    rw [← ha]
    exact hu.map (Polynomial.mapRingHom (algebraMap (fixedField σ) K))
  have haf : f=a := Polynomial.eq_of_monic_of_associated hm ham ((hi.dvd_iff.mp had).resolve_left hau)
  rw [← ha,← haf]
theorem irreducible_fixed_or_pair (hσ : Function.Involutive σ)
    (f : (fixedField σ)[X]) (hm : f.Monic) (hi : Irreducible f) :
    ∃ g : K[X],g.Monic ∧ Irreducible g ∧
      ((f.map (algebraMap (fixedField σ) K)=g ∧ g.map σ.toRingHom=g) ∨
       (f.map (algebraMap (fixedField σ) K)=g*g.map σ.toRingHom ∧ g.map σ.toRingHom≠g)) := by
  let F := f.map (algebraMap (fixedField σ) K)
  have hF : ¬IsUnit F := Polynomial.not_isUnit_of_natDegree_pos _ (by
    rw [hm.natDegree_map]; exact hi.natDegree_pos)
  obtain ⟨g,hgm,hgi,hgd⟩ := Polynomial.exists_monic_irreducible_factor F hF
  have hgc : Irreducible (g.map σ.toRingHom) :=
    (MulEquiv.irreducible_iff (Polynomial.mapEquiv σ).toMulEquiv).mpr hgi
  have hFfix : F.map σ.toRingHom=F := mapped_fixedField_fixed σ f
  have hgcd : g.map σ.toRingHom ∣ F := by
    have hh := Polynomial.map_dvd σ.toRingHom hgd
    rwa [hFfix] at hh
  refine ⟨g,hgm,hgi,?_⟩
  by_cases hfix : g.map σ.toRingHom=g
  · left
    exact ⟨(fixed_divisor_eq σ f hm hi g hgm hgi.not_isUnit hgd hfix).symm,hfix⟩
  · right
    have hcop : IsCoprime g (g.map σ.toRingHom) := by
      apply hgi.coprime_iff_not_dvd.mpr
      intro hd
      exact hfix (Polynomial.eq_of_monic_of_associated hgm (hgm.map _)
        (hgi.associated_of_dvd hgc hd)).symm
    have hprod : g*g.map σ.toRingHom ∣ F := hcop.mul_dvd hgd hgcd
    have hunit : ¬IsUnit (g*g.map σ.toRingHom) := by
      intro hu
      exact hgi.not_dvd_isUnit hu (dvd_mul_right _ _)
    have hprodFix : (g*g.map σ.toRingHom).map σ.toRingHom=g*g.map σ.toRingHom := by
      rw [Polynomial.map_mul,polynomial_conjugate_twice σ hσ,mul_comm]
    exact ⟨(fixed_divisor_eq σ f hm hi _ (hgm.mul (hgm.map _)) hunit hprod hprodFix).symm,hfix⟩
theorem irreducible_parity_factorization (hσ : Function.Involutive σ) (hne : σ ≠ 1)
    (q : ℕ) (hK : Nat.card K=q^2)
    (f : (fixedField σ)[X]) (hm : f.Monic) (hi : Irreducible f) :
    (Odd f.natDegree ∧ Irreducible (f.map (algebraMap (fixedField σ) K))) ∨
    (Even f.natDegree ∧ ∃ g : K[X],g.Monic ∧ Irreducible g ∧
      f.map (algebraMap (fixedField σ) K)=g*g.map σ.toRingHom ∧
        g.map σ.toRingHom≠g ∧ 2*g.natDegree=f.natDegree) := by
  obtain ⟨g,hgm,hgi,hg | hg⟩ := irreducible_fixed_or_pair σ hσ f hm hi
  · left
    letI : Fact (Irreducible g) := ⟨hgi⟩
    have ho := self_conjugate_irreducible_degree_odd σ hσ hne q hK g (Associated.of_eq hg.2)
    have hd : f.natDegree=g.natDegree := by rw [← hm.natDegree_map (algebraMap (fixedField σ) K),hg.1]
    exact ⟨hd.symm ▸ ho,hg.1.symm ▸ hgi⟩
  · right
    have hd : 2*g.natDegree=f.natDegree := by
      have hh := congrArg Polynomial.natDegree hg.1
      rw [hm.natDegree_map,Polynomial.natDegree_mul hgi.ne_zero (hgm.map _).ne_zero,
        hgm.natDegree_map] at hh
      omega
    exact ⟨⟨g.natDegree,by omega⟩,g,hgm,hgi,hg.1,hg.2,hd⟩
end
end Mathproof.Problem18UnitaryPolynomialSplit20260930
