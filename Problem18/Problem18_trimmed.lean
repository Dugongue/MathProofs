  change ab ∈ Finset.univ.filter (fun ab : K × K => (specialize P ab.1).eval ab.2 = 0) at hab
  rw [Finset.mem_filter] at hab
  obtain ⟨-, hz⟩ := hab
  by_cases hb : ab.1 ∈ badSet P
  · exact Finset.mem_union_left _ (Finset.mem_product.mpr ⟨hb, Finset.mem_univ _⟩)
  · apply Finset.mem_union_right
    rw [Finset.mem_biUnion]
    refine ⟨ab.1, Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, hb⟩, ?_⟩
    rw [Finset.mem_product, Finset.mem_singleton, Multiset.mem_toFinset]
