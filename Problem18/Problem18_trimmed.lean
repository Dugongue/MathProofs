    simpa only [one_div] using one_div_le_one_div_of_le (by positivity) hp
  have hpos : (0 : ℝ)≤((Fintype.card K : ℝ)^((m+m+127)/128))⁻¹ := by positivity
  change (Nat.card {z : Sample G.toBilin' m // Bad z} : ℝ)/Nat.card (Sample G.toBilin' m)≤_
  simp only [←Nat.card_eq_fintype_card] at hred hirr
  change (Nat.card {z : Sample G.toBilin' m // Red z} : ℝ)/Nat.card (Sample G.toBilin' m)≤_ at hred
  change (Nat.card {z : Sample G.toBilin' m // Irr z} : ℝ)/Nat.card (Sample G.toBilin' m)≤_ at hirr
  rw [Nat.card_eq_fintype_card (α := K)] at hred hirr
