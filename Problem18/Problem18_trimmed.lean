theorem specialize_sumPair {P : Type} (z : P→K) (a b : Nat) (f : Fin a×Fin b→StarExpr (P ⊕ V) Int) :
    specialize z (sumPair a b f)=sxSumPair a b (fun i=>specialize z (f i)) := by
  simp [sumPair,sxSumPair,specialize_sumFin]
def data (d : UnitaryFieldData (K:=K) q) (F G : Matrix (Fin c) (Fin a×Fin b) K) : Params a b→K :=fun z=>
