    (hστ : ∀ s, σ (algebraMap S L s)=algebraMap S L (τ s))
    (p q : HeightOneSpectrum S) (hpq : p.asIdeal.comap τ.toRingHom=q.asIdeal) :
    (q.valuation L).valuationSubring =
      (p.valuation L).valuationSubring.comap σ.toRingHom := by
