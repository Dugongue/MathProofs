  letI : Finite V := Finite.of_injective (Module.finBasis K V).equivFun
    (Module.finBasis K V).equivFun.injective
  letI : Finite (Module.End K V) := Finite.of_injective
    (fun S : Module.End K V => (S : V → V)) DFunLike.coe_injective
  letI : Finite ((∀ i,AdjoinRoot (g i)) ≃ₗ[K] V) := Finite.of_injective
