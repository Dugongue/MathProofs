theorem ker_eq_range_complement (S : Module.End K V)
    (hs : Squarefree S.charpoly) (g q : K[X]) (hq : S.charpoly=g*q) :
    LinearMap.ker (aeval S g)=LinearMap.range (aeval S q) := by
  have hc : IsCoprime g q := isRelPrime_iff_isCoprime.mp
    (squarefree_mul_iff.mp (hq ▸ hs)).1
  obtain ⟨u,v,huv⟩ := hc
  apply le_antisymm
  · intro x hx
    refine ⟨(aeval S v) x,?_⟩
    have hh := congrArg (fun p : K[X] => (aeval S p) x) huv
    simp only [aeval_add,aeval_mul,map_one,LinearMap.add_apply,
      Module.End.mul_apply,Module.End.one_apply,LinearMap.mem_ker.mp hx,map_zero,
      zero_add] at hh
    have hm : aeval S q * aeval S v=aeval S v * aeval S q := by
      rw [← map_mul,← map_mul,mul_comm]
    change (aeval S q * aeval S v) x=x
    rw [hm]
    exact hh
  · rintro x ⟨y,rfl⟩
    change (aeval S g) ((aeval S q) y)=0
    rw [← Module.End.mul_apply,← aeval_mul,← hq,S.aeval_self_charpoly]
    rfl
