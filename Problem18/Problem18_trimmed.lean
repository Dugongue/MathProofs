    (hB : B.SeparatingLeft) (f g : Module.End K V) :
    adjoint B hB (f+g) = adjoint B hB f + adjoint B hB g := by
  symm
  apply adjoint_unique
  intro x y
  simp only [LinearMap.add_apply, map_add]
  exact congrArg₂ (· + ·) (adjoint_spec B hB f x y) (adjoint_spec B hB g x y)
theorem adjoint_mul (B : HermitianForm (K := K) (V := V))
    (hB : B.SeparatingLeft) (f g : Module.End K V) :
    adjoint B hB (f*g) = adjoint B hB g * adjoint B hB f := by
  symm
  apply adjoint_unique
  intro x y
  change B (adjoint B hB g (adjoint B hB f x)) y = B x (f (g y))
  rw [adjoint_spec, adjoint_spec]
theorem adjoint_scalar (B : HermitianForm (K := K) (V := V))
    (hB : B.SeparatingLeft) (a : K) :
