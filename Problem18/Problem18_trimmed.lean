  have h1 : Mathproof.Problem18TypedSourceCheck20261001.sourceCheck B x.unitary x.q
      x.source = true := by
    have := hacc
    unfold accepted at this
    convert this
  obtain ⟨hfirst, hf⟩ := first_of_source B x.unitary x.q x.source hbranch h1
  refine ⟨hfirst, by unfold firstOK; convert hf, ?_⟩
  letI : CharP x.fieldData.carrier x.fieldData.presentation.p :=
    x.fieldData.presentation.characteristic
  have hc := pair_correct x.unitary x.fieldData.presentation.p x.q x.valid x.source x.target
    hfirst hf
