namespace Problem18IntertwinerLine20260930
open Matrix
open Problem18MatrixAlgebraClassification20260929
section Endomorphisms
variable {K V ι : Type*} [Field K] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] [Nontrivial V]
theorem intertwiner_isUnit (S T : ι → Module.End K V) (X : Module.End K V)
    (hX0 : X ≠ 0) (hgen : Algebra.adjoin K (Set.range S) = ⊤)
    (hX : ∀ i, X * S i = T i * X) : IsUnit X := by
  apply (LinearMap.isUnit_iff_ker_eq_bot X).2
  by_contra hk
  have hkt : LinearMap.ker X ≠ ⊤ := by
    intro h
    apply hX0
    exact LinearMap.ker_eq_top.mp h
  apply stabilizerAlgebra_ne_top (LinearMap.ker X) hk hkt
  apply top_unique
  rw [← hgen]
  apply Algebra.adjoin_le
  rintro _ ⟨i, rfl⟩ x hx
  change X (S i x) = 0
  have he := LinearMap.congr_fun (hX i) x
  change X (S i x) = T i (X x) at he
  rw [show X x = 0 from hx, map_zero] at he
  exact he
end Endomorphisms
section Matrices
variable {K i ι : Type*} [Field K] [StarRing K] [Fintype i] [DecidableEq i]
theorem matched_adjoint_gram (S T : ι → Matrix i i K) (mate : ι → ι)
    (hS : ∀ j, (S (mate j))ᴴ = S j) (hT : ∀ j, (T (mate j))ᴴ = T j)
    (X : Matrix i i K) (hX : ∀ j, X * S j = T j * X) (j : ι) :
    (Xᴴ * X) * S j = S j * (Xᴴ * X) := by
  have ht : S j * Xᴴ = Xᴴ * T j := by
    simpa only [Matrix.conjTranspose_mul, hS j, hT j] using
      congrArg Matrix.conjTranspose (hX (mate j))
  rw [Matrix.mul_assoc, hX j, ← Matrix.mul_assoc, ← ht, Matrix.mul_assoc]
theorem matched_adjoint_scalar_gram (S T : ι → Matrix i i K) (mate : ι → ι)
    (hS : ∀ j, (S (mate j))ᴴ = S j) (hT : ∀ j, (T (mate j))ᴴ = T j)
    (hgen : Algebra.adjoin K (Set.range S) = ⊤)
    (X : Matrix i i K) (hX : ∀ j, X * S j = T j * X) :
    FiniteFieldOrthogonalUnitaryTI.IsScalar (Xᴴ * X) := by
  apply FiniteFieldOrthogonalUnitaryTI.scalar_of_generates _ _ hgen
  rintro _ ⟨j, rfl⟩
  exact matched_adjoint_gram S T mate hS hT X hX j
end Matrices
end Problem18IntertwinerLine20260930
