namespace Mathproof.Problem18SerializedInputBound20260930
open Mathproof.Problem18AllFormatRoot20260930
open Mathproof.Problem18PresentationSize20260930
open Problem18OrthogonalAssembly
variable {K : Type} [Field K] [Fintype K]
theorem queryBits_length_le (F : FieldPresentation K) (unitary : Bool) (q a b c : ℕ)
    (hv : validSize K unitary q) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (A B : RectTensor a b c K) :
    (queryBits F unitary q A B).length ≤ 128 * ((a*b*c+1)*(q.size+1))^2 := by
  let m := a*b*c
  let s := q.size
  let S := (m+1)*(s+1)
  let w := m+2*s+1
  let l := 1 :: (header F unitary q a b c ++ tensorCoordinates F A ++ tensorCoordinates F B)
  have hn (x : ℕ) : x.size ≤ x := Nat.size_le.mpr Nat.lt_two_pow_self
  have he : F.e ≤ 2*s := presentation_degree_le_qsize F unitary q hv
  have hp : F.p.size ≤ 2*s := presentation_prime_size_le_qsize F unitary q hv
  have ham : a ≤ m := (Nat.le_mul_of_pos_right a hb).trans (Nat.le_mul_of_pos_right (a*b) hc)
  have hbm : b ≤ m := (Nat.le_mul_of_pos_left b ha).trans (Nat.le_mul_of_pos_right (a*b) hc)
  have hcm : c ≤ m := Nat.le_mul_of_pos_left c (Nat.mul_pos ha hb)
  have hres (x : ℕ) (hx : x < F.p) : x.size ≤ w := by
    have h := (Nat.size_le_size hx.le).trans hp
    dsimp [w]
    omega
  have hhead : ∀ x ∈ header F unitary q a b c, x.size ≤ w := by
    intro x hx
    change x ∈ [unitary.toNat, q, F.p, F.e, a, b, c] ++ _ at hx
    rcases List.mem_append.mp hx with hx | hx
    · simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
      rcases hx with hx | hx | hx | hx | hx | hx | hx <;> subst x
      · cases unitary <;> simp [w, Bool.toNat]
      · dsimp [w, s]; omega
      · dsimp [w]; omega
      · have := hn F.e; dsimp [w]; omega
      · have := hn a; dsimp [w]; omega
      · have := hn b; dsimp [w]; omega
      · have := hn c; dsimp [w]; omega
    · rcases List.mem_map.mp hx with ⟨i, _, rfl⟩
      exact hres _ (F.modulus i).isLt
  have hw : ∀ x ∈ l, x.size ≤ w := by
    intro x hx
    rcases List.mem_cons.mp hx with rfl | hx
    · simp [w]
    · rcases List.mem_append.mp hx with hx | hx
      · rcases List.mem_append.mp hx with hx | hx
        · exact hhead x hx
        · exact hres x (tensorCoordinates_entry_lt F A x hx)
      · exact hres x (tensorCoordinates_entry_lt F B x hx)
  have hlen : l.length = 8 + F.e + 2*m*F.e := by
    simp [l, header, tensorCoordinates_length, m]
    ring
  have hlenS : l.length ≤ 14*S := by
    rw [hlen]
    have hmul := Nat.mul_le_mul_left (2*m) he
    dsimp [S]
    nlinarith
  have hwS : 2*w+1 ≤ 7*S := by
    dsimp [w, S]
    nlinarith
  change (BitstringEncoding.bitEncode l).length ≤ 128*S^2
  calc
    _ ≤ l.length * (2*w+1) := encoded_list_length_le l w hw
    _ ≤ (14*S) * (7*S) := Nat.mul_le_mul hlenS hwS
    _ ≤ 128*S^2 := by nlinarith [sq_nonneg (S : ℤ)]
end Mathproof.Problem18SerializedInputBound20260930
end
