  have asB : an.sB ∉ regNames r := ha.avoid _ (by simp [ANames.list])
  have axB : an.xB ∉ regNames r := ha.avoid _ (by simp [ANames.list])
  have aoB : an.oB ∉ regNames r := ha.avoid _ (by simp [ANames.list])
  have az : an.z ∉ regNames r := ha.avoid _ (by simp [ANames.list])
  have ak : an.k ∉ regNames r := ha.avoid _ (by simp [ANames.list])
  have nNwW : an.Nw ≠ q.WS := ha.ne_of (by intro h; simp [RNames.list, ANames.list, h])
  have nNW : q.N ≠ q.WS := ha.ne_of (by intro h; simp [RNames.list, ANames.list, h])
  have nnW : q.n ≠ q.WS := ha.ne_of (by intro h; simp [RNames.list, ANames.list, h])
  have ncW : q.c ≠ q.WS := ha.ne_of (by intro h; simp [RNames.list, ANames.list, h])
  have naW : an.a ≠ q.WS := ha.ne_of (by intro h; simp [RNames.list, ANames.list, h])
  have nzk : an.z ≠ an.k := ha.ne_of (by intro h; simp [RNames.list, ANames.list, h])
  have nzW : an.z ≠ q.WS := ha.ne_of (by intro h; simp [RNames.list, ANames.list, h])
  have nkW : an.k ≠ q.WS := ha.ne_of (by intro h; simp [RNames.list, ANames.list, h])
