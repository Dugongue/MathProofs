  have heval : (Expr.bin .add (.var canonical.e) (.lit 1)).evalB B rho=some (F.e+1) :=
    evalB_bin hevar (evalB_lit (by omega)) heB
  have hcolRho : rho.vars Problem18IMPTensorGather20261002.cols=n :=
