    · simp only [out_setVar]; rw [houtc, hτb, out_setVar, hτa, out_setVar]; exact hout
  obtain ⟨τf, hrf, hIf, hcf⟩ := Run.while_count I (fun τ => c - τ.vars t)
    (chosenStep M q cc t src dst N) (fun τ h => ⟨_, hcond τ h⟩) hstep hI0
  have hcf' := hcf
