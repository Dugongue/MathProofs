theorem program_run {Sn B N ps gs os : Nat} {P Q : K[X]} {σ : Env}
    (hS : Slots F canonical q.WS Sn B σ) (hn : σ.vars q.n=N)
    (hp : σ.vars pReg=ps) (hg : σ.vars gReg=gs) (ho : σ.vars outReg=os)
