def cI : String := "P18.pairBoundary.coord.i"
def cJ : String := "P18.pairBoundary.coord.j"
def bI : String := "P18.pairBoundary.coord.fill.i"
def bC : String := "P18.pairBoundary.coord.fill.c"
def bD : String := "P18.pairBoundary.coord.fill.d"
def gI : String := "P18.pairBoundary.coord.copy.i"
def gC : String := "P18.pairBoundary.coord.copy.c"
def gS : String := "P18.pairBoundary.coord.copy.s"
def gD : String := "P18.pairBoundary.coord.copy.d"
def physE (s : Expr) : Expr :=
  .bin .add (.bin .add (.var canonical.e) (.lit 1)) (.bin .mul s (.var canonical.e))
def regionS : SizeExpr := (Cₛ 2 *ₛ Dₛ +ₛ Cₛ 2 *ₛ (Dₛ *ₛ Dₛ)) *ₛ SizeExpr.degree
def row0S : SizeExpr := Cₛ 5 +ₛ Cₛ 2 *ₛ Dₛ
def twoNS : SizeExpr := Cₛ 2 *ₛ Dₛ
def eE : Expr := .var canonical.e
def nE' : Expr := .var colsR
def srcRow : Expr := .bin .add (byteE sTAS) (.bin .mul (.bin .mul (.var cJ) nE') eE)
def dstRow : Expr :=
  .bin .add (byteE row0S) (.bin .mul (.bin .mul (.var cJ) (expression colsR canonical.e twoNS)) eE)
def unitWord : Expr := .bin .add dstRow (.bin .mul (.bin .add nE' (.var cJ)) eE)
def rowBody : Com :=
  .seq (.assign gC (.bin .mul nE' eE)) <|
  .seq (.assign gS srcRow) <|
  .seq (.assign gD dstRow) <|
  .seq (segCopy canonical.mem canonical.mem gI gC gS gD) <|
  .seq (.store canonical.mem unitWord (.lit 1))
    (.assign cJ (.bin .add (.var cJ) (.lit 1)))
def rowLoop : Com :=
  .seq (.assign cJ (.lit 0)) (.while (.lt (.var cJ) nE') rowBody)
def build : Com :=
  .seq (.assign bD (byteE (Cₛ 5))) <|
  .seq (.assign bC (expression colsR canonical.e regionS)) <|
  .seq (fillWords canonical.mem bI bC bD 0) <|
  .seq (.store canonical.mem (physE (.bin .add (.lit 5) (.var cI))) (.lit 1)) rowLoop
def rowRegs : List String := [cJ,gI,gC,gS,gD]
def Written (R n e j k : Nat) : Prop :=
  ∃j'<j,(R+j'*(2*(n*e)) ≤ k ∧ k<R+j'*(2*(n*e))+n*e) ∨ k=R+j'*(2*(n*e))+(n*e+j'*e)
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
theorem block_le {j j' M : Nat} (h : j'<j) : j'*M+M ≤ j*M := by
  have := Nat.mul_le_mul_right M (Nat.succ_le_of_lt h)
  rw [Nat.succ_mul] at this;exact this
theorem var_eval {B v : Nat} {x : String} {σ : Env} (h : σ.vars x=v) (hv : v<B) :
    (Expr.var x).evalB B σ=some v := by rw [← h];exact evalB_var (by rw [h];exact hv)
theorem srcRow_eval {B n j S : Nat} {σ : Env} (hc : σ.vars colsR=n)
    (he : σ.vars canonical.e=F.e) (hj : σ.vars cJ=j) (hS : phys F.e (sTA n)=S)
    (hbT : majorant (byteS sTAS) n F.e<B) (hjn : j*n*F.e ≤ S+j*n*F.e)
    (hB : S+j*n*F.e<B) (hjB : j<B) (hnB : n<B) (heB : F.e<B) (hjnB : j*n<B) :
    srcRow.evalB B σ=some (S+j*n*F.e) := by
  have hb := byteEval sTAS hc he hbT
  rw [v_sTA,hS] at hb
  exact evalB_bin (op:=.add) hb
    (evalB_bin (op:=.mul) (evalB_bin (op:=.mul) (var_eval hj hjB) (var_eval hc hnB) hjnB)
      (var_eval he heB) (by show j*n*F.e<B;omega))
    hB
theorem dstRow_eval {B n j R : Nat} {σ : Env} (hc : σ.vars colsR=n)
    (he : σ.vars canonical.e=F.e) (hj : σ.vars cJ=j) (hR : phys F.e (5+2*n)=R)
    (hbR : majorant (byteS row0S) n F.e<B) (h2n : majorant twoNS n F.e<B)
    (hB : R+j*(2*n)*F.e<B) (hjB : j<B) (heB : F.e<B) (hj2 : j*(2*n)<B) :
    dstRow.evalB B σ=some (R+j*(2*n)*F.e) := by
  have hb := byteEval row0S hc he hbR
  have hv0 : value row0S n F.e=5+2*n := by simp [row0S,value]
  rw [hv0,hR] at hb
  have h2v : (expression colsR canonical.e twoNS).evalB B σ=some (2*n) := by
    have := sizeEval twoNS hc he h2n
    simpa [twoNS,value] using this
  exact evalB_bin (op:=.add) hb
    (evalB_bin (op:=.mul) (evalB_bin (op:=.mul) (var_eval hj hjB) h2v hj2)
      (var_eval he heB) (by show j*(2*n)*F.e<B;omega))
    hB
theorem unitWord_eval {B n j R : Nat} {σ : Env} (hc : σ.vars colsR=n)
    (he : σ.vars canonical.e=F.e) (hj : σ.vars cJ=j) (hR : phys F.e (5+2*n)=R)
    (hbR : majorant (byteS row0S) n F.e<B) (h2n : majorant twoNS n F.e<B)
    (hB : R+j*(2*n)*F.e+(n+j)*F.e<B) (hjB : j<B) (hnB : n<B) (heB : F.e<B) (hj2 : j*(2*n)<B) :
    unitWord.evalB B σ=some (R+j*(2*n)*F.e+(n+j)*F.e) := by
  have hd := dstRow_eval F hc he hj hR hbR h2n (by omega) hjB heB hj2
  have hnj : n+j<B := by
    have : n+j ≤ (n+j)*F.e := Nat.le_mul_of_pos_right _ F.degree_pos
    omega
  exact evalB_bin (op:=.add) hd
    (evalB_bin (op:=.mul) (evalB_bin (op:=.add) (var_eval hc hnB) (var_eval hj hjB) hnj)
      (var_eval he heB) (by show (n+j)*F.e<B;omega)) hB
noncomputable def rowCost (n e : Nat) : Nat :=
  20*(n*e)+60+srcRow.size+dstRow.size+unitWord.size
theorem rowLoop_run {B n R S : Nat} (σ0 : Env)
    (hc : σ0.vars colsR=n) (he : σ0.vars canonical.e=F.e)
    (hR : phys F.e (5+2*n)=R) (hS : phys F.e (sTA n)=S)
    (hlen : S+n*(n*F.e) ≤ (σ0.arrs canonical.mem).length)
    (hRS : R+n*(2*(n*F.e)) ≤ S)
    (hLB : (σ0.arrs canonical.mem).length<B)
    (hwB : ∀k,S ≤ k → k<(σ0.arrs canonical.mem).length → (σ0.arrs canonical.mem).getD k 0<B)
    (hbT : majorant (byteS sTAS) n F.e<B) (hbR : majorant (byteS row0S) n F.e<B)
    (h2n : majorant twoNS n F.e<B) :
    ∃τ,Run B rowLoop σ0 τ ((4+rowCost n F.e)*n+6) ∧
      (∀j<n,∀w<n*F.e,(τ.arrs canonical.mem).getD (R+j*(2*(n*F.e))+w) 0=
        (σ0.arrs canonical.mem).getD (S+j*(n*F.e)+w) 0) ∧
      (∀j<n,(τ.arrs canonical.mem).getD (R+j*(2*(n*F.e))+(n*F.e+j*F.e)) 0=1) ∧
      (∀k,¬Written R n F.e n k →
        (τ.arrs canonical.mem).getD k 0=(σ0.arrs canonical.mem).getD k 0) ∧
      (∀x,x∉rowRegs → τ.vars x=σ0.vars x) ∧
      (∀a,a≠canonical.mem → τ.arrs a=σ0.arrs a) ∧
      (τ.arrs canonical.mem).length=(σ0.arrs canonical.mem).length ∧
      τ.inp=σ0.inp ∧ τ.out=σ0.out := by
  have hE := F.degree_pos
  have heB : F.e<B := by
    have : F.e ≤ n*(n*F.e) ∨ n=0 := by
      rcases Nat.eq_zero_or_pos n with h|h
      · exact Or.inr h
      · exact Or.inl (by have:=Nat.le_mul_of_pos_left F.e (Nat.mul_pos h h);
                         rw [Nat.mul_assoc] at this;exact this)
    rcases this with h|h
    · omega
    · subst h;unfold phys at hS;omega
  have hnB : n<B := by
    have : n ≤ n*(n*F.e) ∨ n=0 := by
      rcases Nat.eq_zero_or_pos n with h|h
      · exact Or.inr h
      · exact Or.inl (Nat.le_mul_of_pos_right _ (Nat.mul_pos h hE))
    rcases this with h|h <;> omega
  have hneB : n*F.e<B := by
    have : n*F.e ≤ n*(n*F.e) ∨ n=0 := by
      rcases Nat.eq_zero_or_pos n with h|h
      · exact Or.inr h
      · exact Or.inl (Nat.le_mul_of_pos_left _ h)
    rcases this with h|h
    · omega
    · subst h;simp;omega
  set L:=(σ0.arrs canonical.mem).length with hLdef
  let I : Env → Prop := fun ρ => ρ.vars cJ ≤ n ∧
    (∀x,x∉rowRegs → ρ.vars x=σ0.vars x) ∧
    (∀a,a≠canonical.mem → ρ.arrs a=σ0.arrs a) ∧
    (ρ.arrs canonical.mem).length=L ∧
    (∀j<ρ.vars cJ,∀w<n*F.e,(ρ.arrs canonical.mem).getD (R+j*(2*(n*F.e))+w) 0=
      (σ0.arrs canonical.mem).getD (S+j*(n*F.e)+w) 0) ∧
    (∀j<ρ.vars cJ,(ρ.arrs canonical.mem).getD (R+j*(2*(n*F.e))+(n*F.e+j*F.e)) 0=1) ∧
    (∀k,¬Written R n F.e (ρ.vars cJ) k →
      (ρ.arrs canonical.mem).getD k 0=(σ0.arrs canonical.mem).getD k 0) ∧
    ρ.inp=σ0.inp ∧ ρ.out=σ0.out
  let V : Env → Nat := fun ρ => n-ρ.vars cJ
  have hcv : ∀ρ,I ρ → ρ.vars colsR=n := fun ρ h=>(h.2.1 _ (by decide)).trans hc
  have hev : ∀ρ,I ρ → ρ.vars canonical.e=F.e := fun ρ h=>(h.2.1 _ (by decide)).trans he
  have hdef : ∀ρ,I ρ → ∃v,(Cond.lt (.var cJ) nE').evalB B ρ=some v := by
    intro ρ h
    exact evalB_condLt_vars (by have:=h.1;omega) (by rw [hcv ρ h];omega)
  have hstep : ∀ρ,I ρ → (Cond.lt (.var cJ) nE').evalB B ρ=some true →
      ∃τ,Run B rowBody ρ τ (rowCost n F.e) ∧ I τ ∧ V τ<V ρ := by
    intro ρ h ht
    have hc' := hcv ρ h
    have he' := hev ρ h
    obtain ⟨h1,h2,h3,h4,h5,h6,h7,h8,h9⟩:=h
    change Cond.evalB B (Cond.lt (Expr.var cJ) (Expr.var colsR)) ρ=some true at ht
    have htest:=evalB_condLt (evalB_var (by omega : ρ.vars cJ<B))
      (evalB_var (by rw [hc'];omega : ρ.vars colsR<B))
    rw [ht,hc'] at htest
    have hj : ρ.vars cJ<n := by simpa using htest.symm
    obtain ⟨j,hjdef⟩ : ∃j,ρ.vars cJ=j := ⟨_,rfl⟩
    rw [hjdef] at hj h1 h5 h6 h7
    have hjb := block_le (M:=2*(n*F.e)) hj
    have hje : j*F.e+F.e ≤ n*F.e := block_le (M:=F.e) hj
    have hjn : j*(n*F.e)+n*F.e ≤ n*(n*F.e) := block_le (M:=n*F.e) hj
    have hsplit1 : j*n*F.e=j*(n*F.e) := by ring
    have hsplit2 : j*(2*n)*F.e=j*(2*(n*F.e)) := by ring
    have hsplit3 : (n+j)*F.e=n*F.e+j*F.e := by ring
    have hjB : j<B := by omega
    have hjnB : j*n<B := by
      have : j*n ≤ j*(n*F.e) := Nat.mul_le_mul_left _ (Nat.le_mul_of_pos_right n hE)
      omega
    have hj2B : j*(2*n)<B := by
      have : j*(2*n) ≤ j*(2*(n*F.e)) :=
        Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ (Nat.le_mul_of_pos_right n hE))
      omega
    let ρ1:=ρ.setVar gC (n*F.e)
    have r1 : Run B (.assign gC (.bin .mul nE' eE)) ρ ρ1 4 :=
      Run.assign (evalB_bin (op:=.mul) (var_eval hc' hnB) (var_eval he' heB) (by show n*F.e<B;omega))
    have h1c : ρ1.vars colsR=n := by simp only [ρ1];rw [setVar_cols (by decide)];exact hc'
    have h1e : ρ1.vars canonical.e=F.e := by simp only [ρ1];rw [setVar_e (by decide)];exact he'
    have h1j : ρ1.vars cJ=j := by simp only [ρ1];rw [vars_setVar,if_neg (by decide)];exact hjdef
    let ρ2:=ρ1.setVar gS (S+j*n*F.e)
    have r2 : Run B (.assign gS srcRow) ρ1 ρ2 (1+srcRow.size) :=
      Run.assign (srcRow_eval F h1c h1e h1j hS hbT (by omega) (by rw [hsplit1];omega)
        hjB hnB heB hjnB)
    have h2c : ρ2.vars colsR=n := by simp only [ρ2];rw [setVar_cols (by decide)];exact h1c
    have h2e : ρ2.vars canonical.e=F.e := by simp only [ρ2];rw [setVar_e (by decide)];exact h1e
    have h2j : ρ2.vars cJ=j := by simp only [ρ2];rw [vars_setVar,if_neg (by decide)];exact h1j
    let ρ3:=ρ2.setVar gD (R+j*(2*n)*F.e)
    have r3 : Run B (.assign gD dstRow) ρ2 ρ3 (1+dstRow.size) :=
      Run.assign (dstRow_eval F h2c h2e h2j hR hbR h2n (by rw [hsplit2];omega) hjB heB hj2B)
    have h3c : ρ3.vars colsR=n := by simp only [ρ3];rw [setVar_cols (by decide)];exact h2c
    have h3e : ρ3.vars canonical.e=F.e := by simp only [ρ3];rw [setVar_e (by decide)];exact h2e
    have h3j : ρ3.vars cJ=j := by simp only [ρ3];rw [vars_setVar,if_neg (by decide)];exact h2j
    have hmem3 : ρ3.arrs canonical.mem=ρ.arrs canonical.mem := rfl
    obtain ⟨ρ4,r4,hcp4,ho4,ha4,hl4,hv4,hi4,hou4⟩:=segCopySame_run (a:=canonical.mem)
      (idx:=gI) (cnt:=gC) (sb:=gS) (db:=gD) (by decide) (by decide) (by decide) (B:=B)
      (n:=n*F.e) (sourceBase:=S+j*n*F.e) (targetBase:=R+j*(2*n)*F.e) ρ3 hneB
      (by simp [ρ3,ρ2,ρ1,gC,gS,gD]) (by simp [ρ3,ρ2,gS,gD]) (by simp [ρ3])
      (by rw [hsplit1];omega) (by rw [hsplit2];omega)
      (by rw [hmem3,h4,hsplit1];omega) (by rw [hmem3,h4,hsplit2];omega)
      (Or.inr (by rw [hsplit1,hsplit2];omega))
      (by
        intro k hk
        rw [hmem3,h7 _ (by
          rintro ⟨j',hj',hw|hw⟩
          · have := block_le (M:=2*(n*F.e)) (lt_of_lt_of_le hj' h1)
            rw [hsplit1] at *;omega
          · have := block_le (M:=2*(n*F.e)) (lt_of_lt_of_le hj' h1)
            have : j'*F.e+F.e ≤ n*F.e := block_le (M:=F.e) (lt_of_lt_of_le hj' h1)
            rw [hsplit1] at *;omega)]
        exact hwB _ (by rw [hsplit1];omega) (by rw [hsplit1];omega))
    have h4c : ρ4.vars colsR=n := by rw [hv4 _ (by decide)];exact h3c
    have h4e : ρ4.vars canonical.e=F.e := by rw [hv4 _ (by decide)];exact h3e
    have h4j : ρ4.vars cJ=j := by rw [hv4 _ (by decide)];exact h3j
    have hl4' : (ρ4.arrs canonical.mem).length=L := by rw [hl4,hmem3,h4]
    let u:=R+j*(2*n)*F.e+(n+j)*F.e
    have hu : u=R+j*(2*(n*F.e))+(n*F.e+j*F.e) := by simp only [u];rw [hsplit2,hsplit3]
    have r5 : Run B (.store canonical.mem unitWord (.lit 1)) ρ4 (ρ4.setArr canonical.mem u 1)
        (1+unitWord.size+1) :=
      Run.store (unitWord_eval F h4c h4e h4j hR hbR h2n (by rw [hsplit2,hsplit3];omega)
        hjB hnB heB hj2B) (evalB_lit (by omega)) (by rw [hl4',hu];omega)
    let ρ5:=ρ4.setArr canonical.mem u 1
    let τ:=ρ5.setVar cJ (j+1)
    have hinc : (Expr.bin .add (.var cJ) (.lit 1)).evalB B ρ5=some (j+1) :=
      evalB_bin (var_eval (by simp [ρ5];exact h4j) hjB) (evalB_lit (by omega)) (by show j+1<B;omega)
    have r6 : Run B (.assign cJ (.bin .add (.var cJ) (.lit 1))) ρ5 τ 4 := Run.assign hinc
    have hτm : ∀k,(τ.arrs canonical.mem).getD k 0=
        if k=u then 1 else (ρ4.arrs canonical.mem).getD k 0 := by
      intro k
      simp only [τ,ρ5,arrs_setVar,arrs_setArr,if_pos rfl]
      by_cases hk : k=u
      · subst hk;rw [if_pos rfl];exact getD_set_self (by rw [hl4',hu];omega)
      · rw [if_neg hk];exact getD_set_ne (Ne.symm hk)
    have hτj : τ.vars cJ=j+1 := by simp [τ]
    refine ⟨τ,?_,?_,?_⟩
    · have hall:=r1.seq (r2.seq (r3.seq (r4.seq (r5.seq r6))))
      exact hall.mono (by unfold rowCost;omega)
    · refine ⟨by rw [hτj];omega,?_,?_,?_,?_,?_,?_,?_,?_⟩
      · intro x hx
        have hx1 : x≠cJ := fun e=>hx (by simp [rowRegs,e])
        have hx2 : x≠gI := fun e=>hx (by simp [rowRegs,e])
        have hx3 : x≠gC := fun e=>hx (by simp [rowRegs,e])
        have hx4 : x≠gS := fun e=>hx (by simp [rowRegs,e])
        have hx5 : x≠gD := fun e=>hx (by simp [rowRegs,e])
        simp only [τ,ρ5,vars_setVar,if_neg hx1,vars_setArr]
        rw [hv4 x hx2]
        simp only [ρ3,ρ2,ρ1,vars_setVar,if_neg hx3,if_neg hx4,if_neg hx5]
        exact h2 x hx
      · intro a ha
        simp only [τ,ρ5,arrs_setVar,arrs_setArr,if_neg ha]
        rw [ha4 a ha];exact h3 a ha
      · simp only [τ,ρ5,arrs_setVar,length_arrs_setArr];exact hl4'
      · intro j' hj' w hw
        rw [hτj] at hj'
        have hneu : R+j'*(2*(n*F.e))+w≠u := by
          rw [hu]
          rcases Nat.lt_or_ge j' j with hl|hl
          · have := block_le (M:=2*(n*F.e)) hl;omega
          · have : j'=j := by omega
            subst this;omega
        rw [hτm,if_neg hneu]
        rcases Nat.lt_or_ge j' j with hl|hl
        · have := block_le (M:=2*(n*F.e)) hl
          rw [ho4 _ (Or.inl (by rw [hsplit2];omega)),hmem3]
          exact h5 j' hl w hw
        · have : j'=j := by omega
          subst this
          rw [show R+j'*(2*(n*F.e))+w=R+j'*(2*n)*F.e+w by rw [hsplit2],hcp4 w hw,hmem3]
          rw [h7 _ (by
            rintro ⟨j'',hj'',hw'|hw'⟩
            · have := block_le (M:=2*(n*F.e)) (lt_of_lt_of_le hj'' h1)
              rw [hsplit1] at *;omega
            · have := block_le (M:=2*(n*F.e)) (lt_of_lt_of_le hj'' h1)
              have : j''*F.e+F.e ≤ n*F.e := block_le (M:=F.e) (lt_of_lt_of_le hj'' h1)
              rw [hsplit1] at *;omega)]
          rw [hsplit1]
      · intro j' hj'
        rw [hτj] at hj'
        rcases Nat.lt_or_ge j' j with hl|hl
        · have := block_le (M:=2*(n*F.e)) hl
          have : j'*F.e+F.e ≤ n*F.e := block_le (M:=F.e) (lt_of_lt_of_le hl (le_of_lt hj))
          rw [hτm,if_neg (by rw [hu];omega),ho4 _ (Or.inl (by rw [hsplit2];omega)),hmem3]
          exact h6 j' hl
        · have : j'=j := by omega
          subst this
          rw [hτm,if_pos hu.symm]
      · intro k hk
        rw [hτj] at hk
        have hnot : ¬Written R n F.e j k := fun ⟨j',hj',hh⟩=>hk ⟨j',by omega,hh⟩
        have hk1 : k≠u := fun e=>hk ⟨j,by omega,Or.inr (by rw [e,hu])⟩
        have hk2 : k<R+j*(2*n)*F.e ∨ R+j*(2*n)*F.e+n*F.e ≤ k := by
          by_contra hc0
          push_neg at hc0
          exact hk ⟨j,by omega,Or.inl ⟨by rw [← hsplit2];omega,by rw [← hsplit2];omega⟩⟩
        rw [hτm,if_neg hk1,ho4 k hk2,hmem3]
        exact h7 k hnot
      · exact hi4.trans h8
      · exact hou4.trans h9
    · show n-τ.vars cJ<n-ρ.vars cJ
      rw [hτj,hjdef];omega
  have hI0 : I (σ0.setVar cJ 0) := by
    refine ⟨by simp,?_,fun _ _=>rfl,rfl,?_,?_,?_,rfl,rfl⟩
    · intro x hx
      have : x≠cJ := fun e=>hx (by simp [rowRegs,e])
      simp [this]
    · intro j hj;simp at hj
    · intro j hj;simp at hj
    · intro k hk;rfl
  obtain ⟨τ,hr,hτ,hfalse⟩:=Run.while_count I V (rowCost n F.e) hdef hstep hI0
  have hcτ := hcv τ hτ
  obtain ⟨h1,h2,h3,h4,h5,h6,h7,h8,h9⟩:=hτ
  have ht:=evalB_condLt (evalB_var (by omega : τ.vars cJ<B))
    (evalB_var (by rw [hcτ];omega : τ.vars colsR<B))
  change Cond.evalB B (Cond.lt (Expr.var cJ) (Expr.var colsR)) τ=some false at hfalse
  rw [hfalse,hcτ] at ht
  have hdone : τ.vars cJ=n := by
