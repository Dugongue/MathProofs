theorem irreducible_map_of_isIntegral_mem
    (hE : ∀ a : F, IsIntegral E a → a ∈ Set.range (algebraMap E F))
    {f : Polynomial E} (hm : f.Monic) (hf : Irreducible f) :
    Irreducible (f.map (algebraMap E F)) := by
  have hinj := Polynomial.map_injective (algebraMap E F) (algebraMap E F).injective
  have hmF : (f.map (algebraMap E F)).Monic := hm.map _
  rw [hmF.irreducible_iff_natDegree]
  refine ⟨fun h1 => hf.not_isUnit ?_, fun g h hg hh hgh => ?_⟩
  · have : f = 1 := hinj (by rw [h1, Polynomial.map_one])
    rw [this]
    exact isUnit_one
  · have hlift : ∀ q : Polynomial F, q.Monic → q ∣ f.map (algebraMap E F) →
        ∃ q0 : Polynomial E, q0.map (algebraMap E F) = q := by
      intro q hq hdvd
      have hl : q ∈ Polynomial.lifts (algebraMap E F) := by
        rw [Polynomial.lifts_iff_coeff_lifts]
        intro n
        exact hE _ (Polynomial.isIntegral_coeff_of_dvd f q hm hq hdvd n)
      obtain ⟨q0, hq0⟩ := hl
      exact ⟨q0, hq0⟩
    obtain ⟨g0, hg0⟩ := hlift g hg ⟨h, hgh.symm⟩
    obtain ⟨h0, hh0⟩ := hlift h hh ⟨g, by rw [← hgh, mul_comm]⟩
    have hprod : g0 * h0 = f := hinj (by rw [Polynomial.map_mul, hg0, hh0, hgh])
    have hg0m : g0.Monic :=
      Polynomial.monic_of_injective (algebraMap E F).injective (by rw [hg0]; exact hg)
    have hh0m : h0.Monic :=
      Polynomial.monic_of_injective (algebraMap E F).injective (by rw [hh0]; exact hh)
    rcases (hm.irreducible_iff_natDegree.mp hf).2 g0 h0 hg0m hh0m hprod with h1 | h1
    · left
      rw [← hg0, Polynomial.natDegree_map]
      exact h1
    · right
      rw [← hh0, Polynomial.natDegree_map]
      exact h1
theorem isField_tensor_of_adjoin_eq_top
    (hE : ∀ a : F, IsIntegral E a → a ∈ Set.range (algebraMap E F))
    {L : Type*} [Field L] [Algebra E L] (α : L) (hα : IsIntegral E α)
    (htop : IntermediateField.adjoin E {α} = ⊤) : IsField (L ⊗[E] F) := by
  classical
  have hirr : Irreducible ((minpoly E α).map (algebraMap E F)) :=
    irreducible_map_of_isIntegral_mem hE (minpoly.monic hα) (minpoly.irreducible hα)
  haveI : Fact (Irreducible ((minpoly E α).map (algebraMap E F))) := ⟨hirr⟩
  haveI : Nontrivial (L ⊗[E] F) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_flat_right E L F
      (algebraMap E L).injective
  let i : F →+* L ⊗[E] F := (Algebra.TensorProduct.includeRight : F →ₐ[E] L ⊗[E] F).toRingHom
  have hi : i.comp (algebraMap E F) = algebraMap E (L ⊗[E] F) :=
    RingHom.ext fun c => (Algebra.TensorProduct.includeRight : F →ₐ[E] L ⊗[E] F).commutes c
  have hroot : ((minpoly E α).map (algebraMap E F)).eval₂ i (α ⊗ₜ[E] (1 : F)) = 0 := by
    rw [Polynomial.eval₂_map, hi, ← Polynomial.aeval_def]
    have h1 : (α ⊗ₜ[E] (1 : F)) = (Algebra.TensorProduct.includeLeft : L →ₐ[E] L ⊗[E] F) α := rfl
    rw [h1, Polynomial.aeval_algHom_apply, minpoly.aeval, map_zero]
  let ψ : AdjoinRoot ((minpoly E α).map (algebraMap E F)) →+* L ⊗[E] F :=
    AdjoinRoot.lift i (α ⊗ₜ[E] (1 : F)) hroot
  have hψroot : ψ (AdjoinRoot.root _) = α ⊗ₜ[E] (1 : F) := AdjoinRoot.lift_root hroot
  have hψof : ∀ b : F, ψ (AdjoinRoot.of _ b) = (1 : L) ⊗ₜ[E] b := fun b =>
    AdjoinRoot.lift_of hroot
  have hinj : Function.Injective ψ := ψ.injective
  have hconst : ∀ c : E, (Algebra.TensorProduct.includeLeft : L →ₐ[E] L ⊗[E] F)
      (algebraMap E L c) ∈ ψ.range := by
    intro c
    refine ⟨AdjoinRoot.of _ (algebraMap E F c), ?_⟩
    rw [hψof, AlgHom.commutes]
    exact ((Algebra.TensorProduct.includeRight : F →ₐ[E] L ⊗[E] F).commutes c)
  have hpoly : ∀ p : Polynomial E,
      (Algebra.TensorProduct.includeLeft : L →ₐ[E] L ⊗[E] F) (Polynomial.aeval α p) ∈ ψ.range := by
    intro p
    induction p using Polynomial.induction_on with
    | C c =>
      rw [Polynomial.aeval_C]
      exact hconst c
    | add p q hp hq =>
      rw [map_add, map_add]
      exact add_mem hp hq
    | monomial n c _ =>
      rw [map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X, map_mul, map_pow]
      refine mul_mem (hconst c) (pow_mem ?_ _)
      exact ⟨AdjoinRoot.root _, hψroot⟩
  have hL : ∀ l : L, l ⊗ₜ[E] (1 : F) ∈ ψ.range := by
    intro l
    have hl : l ∈ (IntermediateField.adjoin E {α}).toSubalgebra := by
      rw [htop]
      trivial
    rw [IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic hα.isAlgebraic,
      Algebra.adjoin_singleton_eq_range_aeval] at hl
    obtain ⟨p, rfl⟩ := hl
    exact hpoly p
  have hrange : ∀ z : L ⊗[E] F, z ∈ ψ.range := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => exact zero_mem _
    | tmul l b =>
      have h1 : l ⊗ₜ[E] b = (l ⊗ₜ[E] (1 : F)) * ((1 : L) ⊗ₜ[E] b) := by
        rw [Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]
      rw [h1]
      exact mul_mem (hL l) ⟨AdjoinRoot.of _ b, hψof b⟩
    | add x y hx hy => exact add_mem hx hy
  have hsurj : Function.Surjective ψ := fun z => RingHom.mem_range.mp (hrange z)
  exact MulEquiv.isField (Field.toIsField _)
    (RingEquiv.ofBijective ψ ⟨hinj, hsurj⟩).symm.toMulEquiv
end T1
