theorem finishProgram_result_bit {B t : Nat} {sigma tau : Env}
    (h : Run B Problem18P36BoundaryDecision20261002.finishProgram sigma tau t) :
    tau.vars Problem18P36BoundaryDecision20261002.resultReg=0 ∨
      tau.vars Problem18P36BoundaryDecision20261002.resultReg=1 := by
  obtain ⟨k,hk,hstep⟩:=h
  cases hstep with
  | ite_true _ h₁ =>
      cases h₁ with
      | ite_true _ h₂ =>
          cases h₂ with
          | ite_true _ ha =>
              cases ha with
              | assign hev =>
                  rw [evalB_lit_iff] at hev
                  exact Or.inr hev.1
          | ite_false _ ha =>
              cases ha with
              | assign hev =>
                  rw [evalB_lit_iff] at hev
                  exact Or.inl hev.1
      | ite_false _ ha =>
          cases ha with
          | assign hev =>
              rw [evalB_lit_iff] at hev
              exact Or.inl hev.1
  | ite_false _ ha =>
      cases ha with
      | assign hev =>
          rw [evalB_lit_iff] at hev
          exact Or.inl hev.1
theorem nativeTail_result_bit {B t : Nat} {sigma tau : Env}
    (h : Run B nativeTail sigma tau t) :
    tau.vars Problem18P36BoundaryDecision20261002.resultReg=0 ∨
      tau.vars Problem18P36BoundaryDecision20261002.resultReg=1 := by
  obtain ⟨k,hk,hstep⟩:=h
  unfold nativeTail Problem18P35BoundaryCompleteNative20261003.program
    Problem18P36BoundaryDecision20261002.program at hstep
  cases hstep with
  | seq _ hcomplete =>
      cases hcomplete with
      | seq _ hdecision =>
          cases hdecision with
          | seq _ hrest =>
              cases hrest with
              | seq _ hrest' =>
                  cases hrest' with
                  | seq _ hfinish =>
                      exact finishProgram_result_bit ⟨_,le_rfl,hfinish⟩
