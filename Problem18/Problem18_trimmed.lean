structure Invariant (Sn B : Nat) (σ τ : Env) : Prop where
  input : Input F Sn B τ
  controls : ∀x∈keep,τ.vars x=σ.vars x
  index_le : τ.vars q.pv ≤ σ.vars q.f
  memory : ∀s<σ.vars q.i,s≠2 → s≠3 → s≠4 →
    val F canonical q.WS τ s=val F canonical q.WS σ s
  value : ∀i:Fin (σ.vars q.N),val F canonical q.WS τ (σ.vars q.i+i.val)=
    hornerVector F σ (σ.vars q.N) (τ.vars q.pv) i
  input_tape : τ.inp=σ.inp
  output_tape : τ.out=σ.out
theorem iteration_run {Sn B : Nat} {σ τ : Env} (h : Input F Sn B σ)
    (hI : Invariant F Sn B σ τ) (hi : τ.vars q.pv<σ.vars q.f) :
    ∃ρ,Run B body τ ρ (bodyCost F (σ.vars q.N)) ∧ Invariant F Sn B σ ρ ∧
      ρ.vars q.pv=τ.vars q.pv+1 := by
  have hn:=hI.controls q.N (by simp [keep])
  have ha:=hI.controls q.i (by simp [keep])
  have hc:=hI.controls q.c (by simp [keep])
  have hz:=hI.controls q.w (by simp [keep])
  have hm:=hI.controls q.n (by simp [keep])
  obtain ⟨ρ,hr,hρ,hidx,hvalue,hprefix,hin,hout⟩:=body_run F hI.input
    (by rw [hI.controls q.f (by simp [keep])];exact hi)
  have hr' : Run B body τ ρ (bodyCost F (σ.vars q.N)) := by simpa only [hn] using hr
  have hregs : ∀x∈keep,ρ.vars x=σ.vars x := by
    intro x hx
    exact ((run_frame hr).1 x (keep_safe x hx)).trans (hI.controls x hx)
  have hfit:=h.work_fit
  have hac:=h.acc_before
  have hma:=h.matrix_before
  have hsv:=h.source_before
  have hco:=h.coeff_before
  have h5:=h.coeff5
  have hmatrix : matrix F τ (σ.vars q.N)=matrix F σ (σ.vars q.N) := by
    ext i j
    unfold matrix
    rw [hm]
    apply hI.memory
    · have hh:=row_entry_bound i.isLt j.isLt;omega
    all_goals omega
  have hacc : vector F τ (σ.vars q.i) (σ.vars q.N)=
      hornerVector F σ (σ.vars q.N) (τ.vars q.pv) := funext hI.value
  have hvalue' : ∀i:Fin (σ.vars q.N),val F canonical q.WS ρ (σ.vars q.i+i.val)=
      (matrix F τ (σ.vars q.N)).mulVec (vector F τ (σ.vars q.i) (σ.vars q.N)) i+
        val F canonical q.WS τ (σ.vars q.c+τ.vars q.pv)*
          val F canonical q.WS τ (σ.vars q.w+i.val) := by
    have hh:=hvalue
    have hdim:=hn
    simp only [ha,hc,hz] at hh
    generalize hleft : τ.vars q.N=nt at hh hdim
    generalize hright : σ.vars q.N=ns at hdim ⊢
    clear hleft hright
    subst nt
    exact hh
  refine ⟨ρ,hr',⟨hρ,hregs,?_,?_,?_,hin.trans hI.input_tape,hout.trans hI.output_tape⟩,hidx⟩
  · rw [hidx];omega
  · intro s hs h2 h3 h4
    exact (hprefix s (by rw [ha];exact hs) h2 h3 h4).trans (hI.memory s hs h2 h3 h4)
  · intro i
    rw [hvalue' i,hidx,hornerVector,hmatrix,hacc]
    rw [hI.memory (σ.vars q.c+τ.vars q.pv) (by omega) (by omega) (by omega) (by omega),
      hI.memory (σ.vars q.w+i.val) (by have hh:=i.isLt;omega) (by omega) (by omega) (by omega)]
theorem routine_run {Sn B : Nat} {σ : Env} (h : Input F Sn B σ)
    (hzero : ∀i:Fin (σ.vars q.N),val F canonical q.WS σ (σ.vars q.i+i.val)=0) :
    ∃τ,Run B routine σ τ ((bodyCost F (σ.vars q.N)+4)*σ.vars q.f+6) ∧
      Input F Sn B τ ∧ τ.vars q.pv=σ.vars q.f ∧
      (∀i:Fin (σ.vars q.N),val F canonical q.WS τ (σ.vars q.i+i.val)=
        hornerVector F σ (σ.vars q.N) (σ.vars q.f) i) ∧
      (∀s<σ.vars q.i,s≠2 → s≠3 → s≠4 → val F canonical q.WS τ s=val F canonical q.WS σ s) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  let σ0:=σ.setVar q.pv 0
  have hkeep : ∀x∈keep,x≠q.pv := by decide
  have hregs : ∀x∈keep,σ0.vars x=σ.vars x := by
    intro x hx
    simp only [σ0,vars_setVar,if_neg (hkeep x hx)]
  have hslots : Slots F canonical q.WS Sn B σ0:=
    Slots.setVar F canonical h.slots (by decide) (by decide) 0
  have h0 : Invariant F Sn B σ σ0 := by
    refine ⟨input_transport F h hslots hregs rfl ?_,hregs,by simp [σ0],?_,?_,rfl,rfl⟩
    · simpa only [σ0,val_setVar F canonical (WS:=q.WS) (x:=q.pv) (by decide)] using h.zero
    · intro s _ _ _ _;exact val_setVar F canonical (by decide) σ 0 s
    · intro i
      simp only [σ0,vars_setVar,if_true,hornerVector,Pi.zero_apply,val_setVar F canonical (WS:=q.WS) (x:=q.pv) (by decide)]
      exact hzero i
  have hdef : ∀τ,Invariant F Sn B σ τ → ∃b,(Cond.lt (.var q.pv) (.var q.f)).evalB B τ=some b := by
    intro τ ht
    have hf:=ht.controls q.f (by simp [keep])
    have hi:=ht.index_le
    have hb:=h.capacity
    exact evalB_condLt_vars (by omega) (by omega)
  have hstep : ∀τ,Invariant F Sn B σ τ →
      (Cond.lt (.var q.pv) (.var q.f)).evalB B τ=some true →
      ∃ρ,Run B body τ ρ (bodyCost F (σ.vars q.N)) ∧ Invariant F Sn B σ ρ ∧
        σ.vars q.f-ρ.vars q.pv<σ.vars q.f-τ.vars q.pv := by
    intro τ ht hcond
    have hf:=ht.controls q.f (by simp [keep])
    have hi:=ht.index_le
    have hb:=h.capacity
    rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by omega))] at hcond
    simp only [Option.some.injEq,decide_eq_true_eq] at hcond
    obtain ⟨ρ,hr,hρ,hidx⟩:=iteration_run F h ht (by omega)
    exact ⟨ρ,hr,hρ,by rw [hidx];omega⟩
  obtain ⟨τ,hr,hτ,hstop⟩:=Run.while_count (Invariant F Sn B σ)
    (fun τ=>σ.vars q.f-τ.vars q.pv) (bodyCost F (σ.vars q.N)) hdef hstep h0
  have hf:=hτ.controls q.f (by simp [keep])
  have hi:=hτ.index_le
  have hb:=h.capacity
  have he : τ.vars q.pv=σ.vars q.f := by
    rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by omega))] at hstop
    simp only [Option.some.injEq,decide_eq_false_iff_not] at hstop
    omega
  refine ⟨τ,?_,hτ.input,he,?_,hτ.memory,hτ.input_tape,hτ.output_tape⟩
  · apply ((Run.assign (x:=q.pv) (evalB_lit (by omega : 0<B))).seq hr).mono
    simp [σ0,Cond.size,Expr.size]
    ring_nf
    omega
  · simpa only [he] using hτ.value
noncomputable def accumulatedPolynomial (σ : Env) : Nat→Polynomial K
  | 0=>0
  | k+1=>Polynomial.X*accumulatedPolynomial σ k+
      Polynomial.C (val F canonical q.WS σ (σ.vars q.c+k))
theorem accumulated_coeff (σ : Env) (k i : Nat) :
    (accumulatedPolynomial F σ k).coeff i=
      if i<k then val F canonical q.WS σ (σ.vars q.c+(k-1-i)) else 0 := by
  induction k generalizing i with
  | zero=>simp [accumulatedPolynomial]
  | succ k ih=>
    cases i with
    | zero=>simp [accumulatedPolynomial]
    | succ i=>
      simp only [accumulatedPolynomial,Polynomial.coeff_add,Polynomial.coeff_X_mul,
        Polynomial.coeff_C,show i+1≠0 by omega,if_false,add_zero,ih]
      by_cases hi:i<k
      · rw [if_pos hi,if_pos (by omega)]
        congr 1
        omega
      · rw [if_neg hi,if_neg (by omega)]
theorem accumulated_eq (σ : Env) (p : Polynomial K) (D : Nat)
    (htail : ∀i,D ≤ i → p.coeff i=0)
    (hcoeff : ∀j<D,val F canonical q.WS σ (σ.vars q.c+j)=p.coeff (D-1-j)) :
    accumulatedPolynomial F σ D=p := by
  ext i
  rw [accumulated_coeff]
  by_cases hi:i<D
  · rw [if_pos hi,hcoeff (D-1-i) (by omega)]
    congr 1
    omega
  · rw [if_neg hi,htail i (by omega)]
theorem accumulated_action (σ : Env) (n k : Nat) :
    (Polynomial.aeval (matrix F σ n).toLin' (accumulatedPolynomial F σ k))
      (vector F σ (σ.vars q.w) n)=hornerVector F σ n k := by
  induction k with
  | zero=>simp [accumulatedPolynomial,hornerVector]
  | succ k ih=>
    simp only [accumulatedPolynomial,map_add,map_mul,Polynomial.aeval_X,Polynomial.aeval_C,
      LinearMap.add_apply,Module.End.mul_apply,Module.algebraMap_end_apply,ih]
    rfl
theorem polynomial_action_run {Sn B : Nat} {σ : Env} (h : Input F Sn B σ)
    (hzero : ∀i:Fin (σ.vars q.N),val F canonical q.WS σ (σ.vars q.i+i.val)=0)
    (p : Polynomial K) (htail : ∀i,σ.vars q.f ≤ i → p.coeff i=0)
    (hcoeff : ∀j<σ.vars q.f,val F canonical q.WS σ (σ.vars q.c+j)=
      p.coeff (σ.vars q.f-1-j)) :
    ∃τ,Run B routine σ τ ((bodyCost F (σ.vars q.N)+4)*σ.vars q.f+6) ∧
      Input F Sn B τ ∧
      (∀i:Fin (σ.vars q.N),val F canonical q.WS τ (σ.vars q.i+i.val)=
        ((Polynomial.aeval (matrix F σ (σ.vars q.N)).toLin' p)
          (vector F σ (σ.vars q.w) (σ.vars q.N))) i) ∧
      (∀s<σ.vars q.i,s≠2 → s≠3 → s≠4 → val F canonical q.WS τ s=val F canonical q.WS σ s) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  obtain ⟨τ,hr,hτ,_,hv,hm,hin,hout⟩:=routine_run F h hzero
  refine ⟨τ,hr,hτ,?_,hm,hin,hout⟩
  intro i
  rw [hv i,←accumulated_action,accumulated_eq F σ p _ htail hcoeff]
