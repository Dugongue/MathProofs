noncomputable def zmodFin (p : ℕ) [NeZero p] : ZMod p ≃ Fin p where
  toFun x := ⟨x.val, x.val_lt⟩
  invFun i := (i.val : ZMod p)
  left_inv x := ZMod.natCast_zmod_val x
  right_inv i := by
    apply Fin.ext
    exact ZMod.val_cast_of_lt i.isLt
noncomputable def fromPowerBasis {K : Type} [Field K] (p : ℕ) [Fact p.Prime]
    [CharP K p] [Algebra (ZMod p) K] (B : PowerBasis (ZMod p) K) : FieldPresentation K := by
  let co : K ≃ (Fin B.dim → Fin p) :=
    B.basis.equivFun.toEquiv.trans (Equiv.piCongrRight fun _ => zmodFin p)
  have hco (x : K) : x = ∑ i : Fin B.dim, ((co x i).val : K) * B.gen ^ i.val := by
    calc
      x = ∑ i : Fin B.dim, (B.basis.repr x i) • B.basis i := (B.basis.sum_repr x).symm
      _ = _ := by
        apply Finset.sum_congr rfl
        intro i hi
        change (B.basis.repr x i) • B.basis i =
          (((B.basis.repr x i).val : ℕ) : K) * B.gen ^ i.val
        rw [B.basis_eq_pow, Algebra.smul_def]
        congr 1
        calc
          algebraMap (ZMod p) K (B.basis.repr x i) =
              algebraMap (ZMod p) K ((B.basis.repr x i).val : ZMod p) :=
            congrArg (algebraMap (ZMod p) K) (ZMod.natCast_zmod_val (B.basis.repr x i)).symm
          _ = ((B.basis.repr x i).val : K) := map_natCast (algebraMap (ZMod p) K) _
  exact {
    p := p
    e := B.dim
    prime := Fact.out
    degree_pos := B.dim_pos
    characteristic := inferInstance
    generator := B.gen
    modulus := co (-(B.gen ^ B.dim))
    coordinate := co
    coordinate_spec := hco
    modulus_spec := by rw [← hco]; exact add_neg_cancel _ }
theorem exists_fieldPresentation (K : Type) [Field K] [Fintype K] :
    Nonempty (FieldPresentation K) := by
  let p := ringChar K
  have hp : p.Prime := CharP.char_is_prime K p
  letI : Fact p.Prime := ⟨hp⟩
  letI : Algebra (ZMod p) K := ZMod.algebra K p
  exact ⟨fromPowerBasis p (Field.powerBasisOfFiniteOfSeparable (ZMod p) K)⟩
end Mathproof.Problem18FieldPresentation20260930
