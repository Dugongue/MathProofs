def CNames.list (cn : CNames) : List String := [cn.t, cn.cc, cn.R, cn.z, cn.k]
structure CNames.Valid (r : FieldNames) (q : RNames) (cn : CNames) : Prop where
  nodup : (q.list ++ cn.list).Nodup
