    (he : τ.vars r.e = ρ.vars r.e) (hp : τ.vars r.p = ρ.vars r.p)
    (hm : τ.vars r.modBase = ρ.vars r.modBase) (hx : τ.vars r.exp = ρ.vars r.exp)
    (hWS : τ.vars WS = ρ.vars WS)
    (hmem : τ.arrs r.mem = ρ.arrs r.mem)
    (hscratch : τ.arrs r.scratch = σ.arrs r.scratch) : Slots F r WS S B τ := by
  have hbase : Base F r B τ := by
    refine ⟨href.base.names, ?_, ?_, href.base.arithmetic_word, href.base.inverse_word,
      ?_, ?_, ?_, ?_, ?_, ?_, href.base.priv⟩
