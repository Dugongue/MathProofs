section Generic
variable {L : Type*} [Field L]
def fAny {m : ℕ} : List (Formula ℤ m) → Formula ℤ m
  | [] => .falsum
  | φ :: l => fOr φ (fAny l)
theorem holds_any {m : ℕ} (l : List (Formula ℤ m)) (x : Fin m → L) :
    (fAny l).Holds (Int.castRingHom L) x ↔ ∃ φ ∈ l, φ.Holds (Int.castRingHom L) x := by
  induction l with
  | nil => simp [fAny, Formula.Holds]
  | cons φ l ih =>
    rw [fAny, holds_or, ih]
    simp only [List.mem_cons, exists_eq_or_imp]
theorem holds_equiv (σ : L ≃+* L) : ∀ {m : ℕ} (φ : Formula ℤ m) (x : Fin m → L),
    φ.Holds (Int.castRingHom L) (fun i => σ (x i)) ↔ φ.Holds (Int.castRingHom L) x := by
  intro m φ
  induction φ with
  | zero p =>
    intro x
    simp only [Formula.Holds]
    have h := interpret_map (σ : L →+* L) x p
    simp only [RingEquiv.coe_toRingHom] at h
    rw [h]
    exact map_eq_zero_iff _ σ.injective
  | falsum => intro x; rfl
  | neg p ih =>
    intro x
    simp only [Formula.Holds]
    rw [ih]
  | disj p q ihp ihq =>
    intro x
    simp only [Formula.Holds]
    rw [ihp, ihq]
  | ex p ih =>
    intro x
    simp only [Formula.Holds]
    constructor
    · rintro ⟨a, ha⟩
      refine ⟨σ.symm a, ?_⟩
      rw [← ih]
      have hc : (fun i => σ ((Fin.cons (σ.symm a) x : Fin _ → L) i)) =
          Fin.cons a (fun i => σ (x i)) := by
        funext i
        refine Fin.cases ?_ (fun j => ?_) i <;> simp
      rw [hc]
      exact ha
    · rintro ⟨a, ha⟩
      refine ⟨σ a, ?_⟩
      rw [← ih] at ha
      have hc : (fun i => σ ((Fin.cons a x : Fin _ → L) i)) =
          Fin.cons (σ a) (fun i => σ (x i)) := by
        funext i
        refine Fin.cases ?_ (fun j => ?_) i <;> simp
      rw [hc] at ha
      exact ha
theorem exists_unflat {k c : ℕ} (P : (Fin k → Fin c → L) → Prop) :
    (∃ w : Fin (k * c) → L, P (unflat w)) ↔ ∃ U, P U :=
  ⟨fun ⟨w, h⟩ => ⟨_, h⟩, fun ⟨U, h⟩ => ⟨flatData U, by rwa [unflat_flatData]⟩⟩
def paramF {m s k : ℕ} (n d : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m)
    (Uv : Fin k → Fin (boxSize n (cpE n d)) → Fin m) (S : Fin k → Fin (boxSize n (cpE n d))) :
    Formula ℤ m :=
  fConj [pivotCond (boxSize n (cpE n d)) Uv S, closedCond n (cpE n d) Uv S,
    containCond n d (cpE n d) Fv Uv, irredCond n (cpE n d) (cpT n d) Uv,
    isolCond n d (cpE n d) (cpD n d) Fv Uv]
theorem holds_paramF {m s k : ℕ} (n d : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m)
    (Uv : Fin k → Fin (boxSize n (cpE n d)) → Fin m) (S : Fin k → Fin (boxSize n (cpE n d)))
    (env : Fin m → L) :
    (paramF n d Fv Uv S).Holds (Int.castRingHom L) env ↔
      IsP n d (fun r j => env (Fv r j)) S (fun i j => env (Uv i j)) := by
  rw [paramF, holds_conj]
  simp only [List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq]
  rw [holds_pivotCond, holds_closedCond, holds_containCond, holds_irredCond, holds_isolCond]
  rfl
end Generic
section Collision
variable {L : Type*} [Field L]
def pairBody {m s k1 k2 : ℕ} (n d : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m)
    (yv : Fin n → Fin m) (S1 : Fin k1 → Fin (boxSize n (cpE n d)))
    (S2 : Fin k2 → Fin (boxSize n (cpE n d))) :
    Formula ℤ (m + k1 * boxSize n (cpE n d) + k2 * boxSize n (cpE n d)) :=
  fConj [
    paramF n d (fun r j => oldIdx _ (oldIdx _ (Fv r j)))
      (fun i j => oldIdx _ (newIdx _ (finProdFinEquiv (i, j)))) S1,
    paramF n d (fun r j => oldIdx _ (oldIdx _ (Fv r j)))
      (fun i j => newIdx _ (finProdFinEquiv (i, j))) S2,
    rowsZero n (cpE n d) (fun i j => oldIdx _ (newIdx _ (finProdFinEquiv (i, j))))
      (fun t => oldIdx _ (oldIdx _ (yv t))),
    rowsZero n (cpE n d) (fun i j => newIdx _ (finProdFinEquiv (i, j)))
      (fun t => oldIdx _ (oldIdx _ (yv t))),
    exBlock n (fAnd
      (rowsZero n (cpE n d) (fun i j => oldIdx n (oldIdx _ (newIdx _ (finProdFinEquiv (i, j)))))
        (newIdx n))
      (.neg (rowsZero n (cpE n d) (fun i j => oldIdx n (newIdx _ (finProdFinEquiv (i, j))))
        (newIdx n))))]
theorem holds_pairBody {m s k1 k2 : ℕ} (n d : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m)
    (yv : Fin n → Fin m) (S1 : Fin k1 → Fin (boxSize n (cpE n d)))
    (S2 : Fin k2 → Fin (boxSize n (cpE n d))) (env : Fin m → L)
    (w1 : Fin (k1 * boxSize n (cpE n d)) → L) (w2 : Fin (k2 * boxSize n (cpE n d)) → L) :
    (pairBody n d Fv yv S1 S2).Holds (Int.castRingHom L)
        (extEnv (extEnv env _ w1) _ w2) ↔
      IsP n d (fun r j => env (Fv r j)) S1 (unflat w1) ∧
        IsP n d (fun r j => env (Fv r j)) S2 (unflat w2) ∧
        (∀ i, denseEval (fun t => env (yv t)) (unflat w1 i) = 0) ∧
        (∀ i, denseEval (fun t => env (yv t)) (unflat w2 i) = 0) ∧
        ∃ z : Fin n → L, (∀ i, denseEval z (unflat w1 i) = 0) ∧
          ¬ ∀ i, denseEval z (unflat w2 i) = 0 := by
  rw [pairBody, holds_conj]
  simp only [List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq]
  rw [holds_paramF, holds_paramF, holds_rowsZero, holds_rowsZero, holds_exBlock]
  simp only [holds_and, holds_rowsZero, Formula.Holds, extEnv_oldIdx, extEnv_newIdx]
  rfl
def pairF {m s : ℕ} (n d : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m) (yv : Fin n → Fin m)
    (p1 p2 : Σ k : ℕ, Fin k → Fin (boxSize n (cpE n d))) : Formula ℤ m :=
  exBlock _ (exBlock _ (pairBody n d Fv yv p1.2 p2.2))
theorem holds_pairF {m s : ℕ} (n d : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m)
    (yv : Fin n → Fin m) (p1 p2 : Σ k : ℕ, Fin k → Fin (boxSize n (cpE n d)))
    (env : Fin m → L) :
    (pairF n d Fv yv p1 p2).Holds (Int.castRingHom L) env ↔
      ∃ (U1 : Fin p1.1 → Fin (boxSize n (cpE n d)) → L)
        (U2 : Fin p2.1 → Fin (boxSize n (cpE n d)) → L),
        IsP n d (fun r j => env (Fv r j)) p1.2 U1 ∧
        IsP n d (fun r j => env (Fv r j)) p2.2 U2 ∧
        (∀ i, denseEval (fun t => env (yv t)) (U1 i) = 0) ∧
        (∀ i, denseEval (fun t => env (yv t)) (U2 i) = 0) ∧
        ∃ z : Fin n → L, (∀ i, denseEval z (U1 i) = 0) ∧ ¬ ∀ i, denseEval z (U2 i) = 0 := by
  rw [pairF, holds_exBlock]
  constructor
  · rintro ⟨w1, hw⟩
    rw [holds_exBlock] at hw
    obtain ⟨w2, hw⟩ := hw
    rw [holds_pairBody] at hw
    exact ⟨_, _, hw⟩
  · rintro ⟨U1, U2, h⟩
    refine ⟨flatData U1, ?_⟩
    rw [holds_exBlock]
    refine ⟨flatData U2, ?_⟩
    rw [holds_pairBody, unflat_flatData, unflat_flatData]
    exact h
def collF {m s : ℕ} (n d : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m) (yv : Fin n → Fin m) :
    Formula ℤ m :=
  fAny ((patterns (boxSize n (cpE n d))).flatMap fun p1 =>
    (patterns (boxSize n (cpE n d))).map fun p2 => pairF n d Fv yv p1 p2)
theorem holds_collF {m s : ℕ} (n d : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m)
    (yv : Fin n → Fin m) (env : Fin m → L) :
    (collF n d Fv yv).Holds (Int.castRingHom L) env ↔
      InColl n d (fun r j => env (Fv r j)) (fun t => env (yv t)) := by
  rw [collF, holds_any]
  simp only [List.mem_flatMap, List.mem_map]
  constructor
  · rintro ⟨φ, ⟨p1, -, p2, -, rfl⟩, h⟩
    rw [holds_pairF] at h
    obtain ⟨U1, U2, h⟩ := h
    exact ⟨p1.1, p1.2, U1, p2.1, p2.2, U2, h⟩
  · rintro ⟨k1, S1, U1, k2, S2, U2, h⟩
    have hk1 : k1 ≤ boxSize n (cpE n d) := by
      simpa using Fintype.card_le_of_injective S1 (pivots_injective _ _ _ _ _ _ _ _ h.1)
    have hk2 : k2 ≤ boxSize n (cpE n d) := by
      simpa using Fintype.card_le_of_injective S2 (pivots_injective _ _ _ _ _ _ _ _ h.2.1)
    refine ⟨_, ⟨⟨k1, S1⟩, mem_patterns S1 hk1, ⟨k2, S2⟩, mem_patterns S2 hk2, rfl⟩, ?_⟩
    rw [holds_pairF]
    exact ⟨U1, U2, h⟩
end Collision
section Basis
variable {L : Type*} [Field L]
def lowF {m : ℕ} (n D : ℕ) (vv : Fin (boxSize n D) → Fin m) : Formula ℤ m :=
  fConj (List.ofFn fun j => if D < weight n D j then fEq (PolyExpr.var (vv j)) else fTrue)
theorem holds_lowF {m : ℕ} (n D : ℕ) (vv : Fin (boxSize n D) → Fin m) (env : Fin m → L) :
    (lowF n D vv).Holds (Int.castRingHom L) env ↔ ∀ j, D < weight n D j → env (vv j) = 0 := by
  rw [lowF, holds_conj_ofFn]
  refine forall_congr' fun j => ?_
  split_ifs with h
  · simp [holds_eq, interpret, h]
  · simp [holds_true, h]
def inWF {m s : ℕ} (n d D : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m)
    (vv : Fin (boxSize n D) → Fin m) : Formula ℤ m :=
  fAnd (lowF n D vv)
    (allBlock n (fImp (collF n d (fun r j => oldIdx n (Fv r j)) (newIdx n))
      (fEq (boxExpr n D (fun j => oldIdx n (vv j)) (newIdx n)))))
theorem holds_inWF {m s : ℕ} (n d D : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m)
    (vv : Fin (boxSize n D) → Fin m) (env : Fin m → L) :
    (inWF n d D Fv vv).Holds (Int.castRingHom L) env ↔
      InW n d D (fun r j => env (Fv r j)) (fun j => env (vv j)) := by
  rw [inWF, holds_and, holds_lowF, holds_allBlock]
  refine and_congr Iff.rfl (forall_congr' fun y => ?_)
  rw [holds_imp, holds_collF, holds_eq, interpret_boxExpr]
  simp only [Function.comp_def, extEnv_oldIdx, extEnv_newIdx]
def chiF {k : ℕ} (n d D s : ℕ) (S : Fin k → Fin (boxSize n D)) :
    Formula ℤ (s * boxSize n d + k * boxSize n D) :=
  fConj [pivotCond (boxSize n D) (fun i j => parVar (s := s) (c := boxSize n d) i j) S,
    fConj (List.ofFn fun i => inWF n d D (fun r j => dataVar (k := k) (c' := boxSize n D) r j)
      (fun j => parVar (s := s) (c := boxSize n d) i j)),
    allBlock (boxSize n D) (fImp
      (inWF n d D (fun r j => oldIdx (boxSize n D) (dataVar (k := k) (c' := boxSize n D) r j))
        (newIdx (boxSize n D)))
      (fConj (List.ofFn fun j => fEq (PolyExpr.sub (.var (newIdx (boxSize n D) j))
        (PolyExpr.sum (List.ofFn fun i =>
          .mul (.var (newIdx (boxSize n D) (S i)))
            (.var (oldIdx (boxSize n D) (parVar (s := s) (c := boxSize n d) i j)))))))))]
theorem holds_chi {k : ℕ} (n d D s : ℕ) (S : Fin k → Fin (boxSize n D))
    (a : Fin (s * boxSize n d) → L) (u : Fin (k * boxSize n D) → L) :
    (chiF n d D s S).Holds (Int.castRingHom L) (Fin.append a u) ↔
      IsCB n d D (unflat a) S (unflat u) := by
  rw [chiF, holds_conj]
  simp only [List.mem_cons, List.not_mem_nil, or_false, forall_eq_or_imp, forall_eq]
  rw [holds_pivotCond, holds_conj_ofFn, holds_allBlock]
  simp only [holds_inWF, append_dataVar, append_parVar]
  refine and_congr Iff.rfl (and_congr Iff.rfl (forall_congr' fun v => ?_))
  rw [holds_imp, holds_inWF, holds_conj_ofFn]
  simp only [holds_eq, interpret_sub, interpret_sum_ofFn, interpret, extEnv_oldIdx,
    extEnv_newIdx, sub_eq_zero, append_dataVar, append_parVar]
end Basis
section Rational
variable {K : Type*} [Field K] [Fintype K]
variable {L : Type*} [Field L] [Algebra K L] [Algebra.IsAlgebraic K L]
theorem isCB_rational {s k : ℕ} (n d D : ℕ) (FK : Fin s → Fin (boxSize n d) → K)
    (S : Fin k → Fin (boxSize n D)) (U : Fin k → Fin (boxSize n D) → L)
    (h : IsCB n d D (fun r j => algebraMap K L (FK r j)) S U) :
    ∀ i j, ∃ c : K, algebraMap K L c = U i j := by
  set φ := FiniteField.frobeniusAlgEquivOfAlgebraic K L with hφ
  have hdata : unflat (fun t => algebraMap K L (flatData FK t)) =
      fun r j => algebraMap K L (FK r j) := by
    funext r j
    simp only [unflat, flatData, Equiv.symm_apply_apply]
  have h1 : (chiF n d D s S).Holds (Int.castRingHom L)
      (Fin.append (fun t => algebraMap K L (flatData FK t)) (flatData U)) := by
    rw [holds_chi, hdata, unflat_flatData]
    exact h
  have h2 := (holds_equiv φ.toRingEquiv _ _).mpr h1
  rw [append_map, holds_chi] at h2
  have hfixd : unflat (fun i => φ.toRingEquiv (algebraMap K L (flatData FK i))) =
      fun r j => algebraMap K L (FK r j) := by
    rw [← hdata]
    funext r j
    simp only [unflat, AlgEquiv.coe_ringEquiv, AlgEquiv.commutes]
  have hU : unflat (fun i => φ.toRingEquiv (flatData U i)) = fun i j => φ (U i j) := by
    funext i j
    simp only [unflat, flatData, Equiv.symm_apply_apply, AlgEquiv.coe_ringEquiv]
  rw [hfixd, hU] at h2
  have heq := isCB_unique n d D _ S U _ h h2
  intro i j
  apply Mathproof.Problem18ZeroDimFixedComponent20261001.pow_card_fixed_mem_range
  have hij := congrFun (congrFun heq i) j
  rw [hφ, FiniteField.coe_frobeniusAlgEquivOfAlgebraic] at hij
  exact hij.symm
end Rational
