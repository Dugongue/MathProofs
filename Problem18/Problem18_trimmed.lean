  have hco : 1 + (len.size + 2) + (s.size + 22) = s.size + len.size + 25 := by omega
  rw [hco] at hrunW
  refine ⟨digitState r σ WS w k base mv p i, ?_, ?_, ?_, ?_, hmlen i,
    fun x hxw hxk => hvars i x hxw hxk, rfl, rfl⟩
  · have hrun := h1.seq (h2.seq hrunW)
    refine hrun.mono ?_
    simp only [digitsCost]
