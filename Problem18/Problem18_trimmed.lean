namespace Mathproof.Problem18ArrayBirdCharpoly20260930
open Matrix CompPoly Polynomial
variable {R : Type*} [CommRing R]
def arrayOf {n : ℕ} (F : Matrix (Fin n) (Fin n) R) : Array R :=
  Array.ofFn fun k : Fin (n*n) => F k.divNat k.modNat
theorem arrayOf_size {n : ℕ} (F : Matrix (Fin n) (Fin n) R) : (arrayOf F).size=n*n := by
  simp [arrayOf]
theorem get_arrayOf {n : ℕ} (F : Matrix (Fin n) (Fin n) R) (i j : Fin n) :
    BirdDet.get n (arrayOf F) i.val j.val=F i j := by
  have h := congrFun (congrFun (Matrix.ofArray_ofFn F) i) j
  rw [Matrix.ofArray_eq_of_getD] at h
  exact h
def stage (n : ℕ) (A F : Array R) : Array R :=
  arrayOf (fun i j : Fin n => BirdDet.stepEntry n A (BirdDet.get n F) i.val j.val)
def stages (n : ℕ) (A : Array R) : ℕ→Array R
  | 0 => A
  | t+1 => let F := stages n A t; stage n A F
theorem sumFrom_congr (n lo : ℕ) (f g : ℕ→R)
    (h : ∀ k,lo≤k→k<n→f k=g k) : BirdDet.sumFrom n lo f=BirdDet.sumFrom n lo g := by
  induction lo using BirdDet.sumFrom_induct n with
  | step lo hlo ih =>
    rw [BirdDet.sumFrom_step n lo f hlo,BirdDet.sumFrom_step n lo g hlo,h lo le_rfl hlo]
    congr 1
    exact ih (fun k hk hkn => h k (by omega) hkn)
  | stop lo hlo => rw [BirdDet.sumFrom_stop n lo f hlo,BirdDet.sumFrom_stop n lo g hlo]
theorem stepEntry_congr (n : ℕ) (A : Array R) (F G : ℕ→ℕ→R)
    (h : ∀ i j,i<n→j<n→F i j=G i j) (i j : ℕ) (hi : i<n) (hj : j<n) :
    BirdDet.stepEntry n A F i j=BirdDet.stepEntry n A G i j := by
  unfold BirdDet.stepEntry
  rw [sumFrom_congr n (i+1) (fun k => F k k) (fun k => G k k)
    (fun k _ hk => h k k hk hk)]
  congr 1
  apply sumFrom_congr
  intro k hk hkn
  rw [h i k hi hkn]
theorem stages_get (n t : ℕ) (A : Array R) (i j : Fin n) :
    BirdDet.get n (stages n A t) i.val j.val=
      ((BirdDet.stepEntry n A)^[t] (BirdDet.get n A)) i.val j.val := by
  induction t generalizing i j with
  | zero => rfl
  | succ t ih =>
    rw [stages,stage,get_arrayOf,Function.iterate_succ_apply']
    apply stepEntry_congr
    · intro i j hi hj
      exact ih ⟨i,hi⟩ ⟨j,hj⟩
    · exact i.isLt
    · exact j.isLt
def determinant (n : ℕ) (A : Array R) : R :=
  match n with
  | 0 => 1
  | t+1 => (-1:R)^t*BirdDet.get (t+1) (stages (t+1) A t) 0 0
theorem determinant_eq_bird (n : ℕ) (A : Array R) : determinant n A=BirdDet.birdDet n A := by
  cases n with
  | zero => rfl
  | succ t =>
    rw [BirdDet.birdDet_succ]
    change (-1:R)^t*BirdDet.get (t+1) (stages (t+1) A t) 0 0=
      (-1:R)^t*((BirdDet.stepEntry (t+1) A)^[t] (BirdDet.get (t+1) A)) 0 0
    congr 1
    exact stages_get (t+1) t A 0 0
theorem determinant_correct {n : ℕ} (A : Array R) (hA : A.size=n*n) :
    determinant n A=(Matrix.ofArray A hA).det := by
  rw [determinant_eq_bird,BirdDet.det_eq_birdDet]
theorem determinant_arrayOf {n : ℕ} (F : Matrix (Fin n) (Fin n) R) :
    determinant n (arrayOf F)=F.det := by
  rw [determinant_correct _ (arrayOf_size F)]
  exact congrArg Matrix.det (Matrix.ofArray_ofFn F)
section Characteristic
variable {K : Type*} [Field K] [BEq K] [LawfulBEq K] [DecidableEq K]
def characteristicArray (n : ℕ) (A : Array K) : Array (CPolynomial K) :=
  arrayOf (fun i j : Fin n => (if i=j then CPolynomial.X else 0)-
    CPolynomial.C (BirdDet.get n A i.val j.val))
def characteristic (n : ℕ) (A : Array K) : CPolynomial K :=
  determinant n (characteristicArray n A)
theorem characteristic_correct {n : ℕ} (A : Array K) (hA : A.size=n*n) :
    (characteristic n A).toPoly=(Matrix.ofArray A hA).charpoly := by
  rw [characteristic,characteristicArray,determinant_arrayOf]
  let M : Matrix (Fin n) (Fin n) (CPolynomial K) :=
    fun i j => (if i=j then CPolynomial.X else 0)-CPolynomial.C (BirdDet.get n A i.val j.val)
  change CPolynomial.ringEquiv M.det=(Matrix.ofArray A hA).charpoly
  rw [(CPolynomial.ringEquiv (R:=K)).map_det M]
  apply congrArg Matrix.det
  apply Matrix.ext
  intro i j
  change (M i j).toPoly=(Matrix.ofArray A hA).charmatrix i j
  simp only [M,CPolynomial.toPoly_sub,
    Matrix.charmatrix_apply,Matrix.diagonal_apply,Matrix.ofArray_eq_of_getD,Matrix.of_apply,
    CPolynomial.C_toPoly]
  split_ifs <;> simp only [CPolynomial.X_toPoly,CPolynomial.toPoly_zero,BirdDet.get]
def inverse (n : ℕ) (A : Array K) : Array K :=
  let d := determinant n A
  let M : Matrix (Fin n) (Fin n) K := fun i j => BirdDet.get n A i.val j.val
  arrayOf (fun i j => d⁻¹*determinant n (arrayOf (M.updateRow j (Pi.single i 1))))
theorem inverse_size (n : ℕ) (A : Array K) : (inverse n A).size=n*n := by
  simp [inverse,arrayOf]
theorem inverse_correct {n : ℕ} (A : Array K) (hA : A.size=n*n) :
    Matrix.ofArray (inverse n A) (inverse_size n A)=(Matrix.ofArray A hA)⁻¹ := by
  have he : (fun i j : Fin n => BirdDet.get n A i.val j.val)=Matrix.ofArray A hA := by
    rw [Matrix.ofArray_eq_of_getD]
    rfl
  have hx : Matrix.ofArray (inverse n A) (inverse_size n A)=
      (fun i j : Fin n => (determinant n A)⁻¹*determinant n
        (arrayOf (Matrix.updateRow (fun r s : Fin n => BirdDet.get n A r.val s.val) j (Pi.single i 1)))) :=
    by
      simpa only [inverse,arrayOf] using (Matrix.ofArray_ofFn
        (fun i j : Fin n => (determinant n A)⁻¹*determinant n
          (arrayOf (Matrix.updateRow (fun r s : Fin n => BirdDet.get n A r.val s.val) j (Pi.single i 1)))))
  rw [hx]
  ext i j
  simp only [determinant_arrayOf,he,determinant_correct A hA,Matrix.inv_def,
    Ring.inverse_eq_inv,Matrix.smul_apply,smul_eq_mul,Matrix.adjugate_apply]
end Characteristic
