section config
def Good (M : Nat) (σ : Env) : Expr → Prop
  | .lit _ => True
  | .var x => σ.vars x ≤ M
  | .bin .add e f => Good M σ e ∧ Good M σ f
  | .bin .mul e f => Good M σ e ∧ Good M σ f
  | _ => False
def pmaj (M : Nat) : Expr → Nat
  | .lit n => n+1
  | .var _ => M+1
  | .bin .add e f => pmaj M e+pmaj M f
  | .bin .mul e f => pmaj M e*pmaj M f
  | _ => 1
theorem pmaj_pos (M : Nat) : ∀ e : Expr, 0 < pmaj M e
  | .lit n => by simp [pmaj]
  | .var _ => by simp [pmaj]
  | .get _ _ => by simp [pmaj]
  | .bin op e f => by
      have he := pmaj_pos M e
      have hf := pmaj_pos M f
      cases op <;> simp [pmaj] <;> first | exact Nat.mul_pos he hf | omega
theorem good_eval {B M : Nat} {σ : Env} :
    ∀ e : Expr, Good M σ e → pmaj M e < B → ∃ v, e.evalB B σ = some v ∧ v+1 ≤ pmaj M e
  | .lit n, _, h => ⟨n, evalB_lit (by simp [pmaj] at h; omega), by simp [pmaj]⟩
  | .var x, hg, h => by
      simp only [Good] at hg
      simp only [pmaj] at h
      exact ⟨_, evalB_var (by omega), by simp [pmaj]; omega⟩
  | .get _ _, hg, _ => by simp [Good] at hg
  | .bin op e f, hg, h => by
      cases op with
      | add =>
        simp only [Good] at hg
        simp only [pmaj] at h
        obtain ⟨m,hm,hmb⟩ := good_eval (B:=B) (M:=M) (σ:=σ) e hg.1 (by omega)
        obtain ⟨n,hn,hnb⟩ := good_eval (B:=B) (M:=M) (σ:=σ) f hg.2 (by omega)
        exact ⟨_, evalB_bin hm hn (by simp [Bop.apply]; omega), by simp [Bop.apply,pmaj]; omega⟩
      | mul =>
        simp only [Good] at hg
        simp only [pmaj] at h
        have pe := pmaj_pos M e
        have pf := pmaj_pos M f
        have hle : pmaj M e ≤ pmaj M e*pmaj M f := Nat.le_mul_of_pos_right _ pf
        have hlf : pmaj M f ≤ pmaj M e*pmaj M f := Nat.le_mul_of_pos_left _ pe
        obtain ⟨m,hm,hmb⟩ := good_eval (B:=B) (M:=M) (σ:=σ) e hg.1 (by omega)
        obtain ⟨n,hn,hnb⟩ := good_eval (B:=B) (M:=M) (σ:=σ) f hg.2 (by omega)
        have hprod : (m+1)*(n+1) ≤ pmaj M e*pmaj M f := Nat.mul_le_mul hmb hnb
        have hmn : m*n+1 ≤ (m+1)*(n+1) := by nlinarith
        exact ⟨_, evalB_bin hm hn (by simp [Bop.apply]; omega), by simp [Bop.apply,pmaj]; omega⟩
      | _ => simp [Good] at hg
def gval (W : Nat) (σ : Env) (e : Expr) : Nat := (e.evalB W σ).getD 0
theorem sortedBase_eval (M W : Nat) (σ : Env)
    (ha : σ.vars "a" ≤ M) (hb : σ.vars "b" ≤ M) (hc : σ.vars "c" ≤ M)
    (he : σ.vars canonical.e ≤ M)
    (hW : 1000000000000*(M+1)^8 < W) :
    ∃ d, sortedBase.evalB W σ = some d := by
  have hg : Good M σ sortedBase := by
    simp [sortedBase,physicalSlot,sortedSlot,algebraPrefix,candidateEnd,dimSum,capFlat,capGen,capSq,Good]
    omega
  have hle : pmaj M sortedBase ≤ 1000000000000*(M+1)^8 := by
    have hM1 : 1 ≤ M+1 := by omega
    have hMM : M ≤ M+1 := by omega
    simp only [sortedBase,physicalSlot,sortedSlot,algebraPrefix,candidateEnd,dimSum,capFlat,capGen,capSq,
      Expr.add,Expr.mul,pmaj]
    apply pb_close hM1
    · pbound
    · decide +kernel
    · decide +kernel
  obtain ⟨d,hd,-⟩ := good_eval (B:=W) (M:=M) (σ:=σ) sortedBase hg (by omega)
  exact ⟨d,hd⟩
end config
section bounds
theorem lt_cap {Q c d N : Nat} (h : Q ≤ c*(N+1)^d) (hc : c ≤ 2^400) (hd : d ≤ 100) :
    Q < 2^(1000000000*(N+1)^10) := by
  have hX : (N+1)^d ≤ 2^(N*d) := by
    rw [Nat.pow_mul]
    exact Nat.pow_le_pow_left (succ_le_two_pow N) d
  have h1 : Q ≤ 2^(400+N*d) := by
    rw [Nat.pow_add]
    exact h.trans (Nat.mul_le_mul hc hX)
  have h10 : N+1 ≤ (N+1)^10 := by
    calc N+1 = (N+1)^1 := (Nat.pow_one _).symm
      _ ≤ (N+1)^10 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have hexp : 400+N*d < 1000000000*(N+1)^10 := by
    have : N*d ≤ N*100 := Nat.mul_le_mul_left _ hd
    nlinarith
  exact h1.trans_lt (Nat.pow_lt_pow_right (by norm_num) hexp)
theorem poly_fits {Q N : Nat} (h : Q ≤ 10^60*(N+1)^60) :
    Q < 2^(sourceWordPolynomial.eval N+N+1) ∧ Q < 2^(sourceWordPolynomial.eval N+N) := by
  have hq := lt_cap (c:=10^60) (d:=60) h (by decide +kernel) (by norm_num)
  rw [sourceWordPolynomial_eval]
  constructor
  · exact hq.trans_le (Nat.pow_le_pow_right (by norm_num) (by omega))
  · exact hq.trans_le (Nat.pow_le_pow_right (by norm_num) (by omega))
theorem prime_power_fits {p e N : Nat} (hp : p.size ≤ N) (he : e ≤ N) :
    (p+1)^(e+1) < 2^(sourceWordPolynomial.eval N+N+1) := by
  have h1 : p+1 ≤ 2^p.size := Nat.lt_size_self p
  have h2 : (p+1)^(e+1) ≤ 2^(N*(N+1)) := by
    rw [Nat.pow_mul]
    calc (p+1)^(e+1) ≤ (2^p.size)^(e+1) := Nat.pow_le_pow_left h1 _
      _ ≤ (2^N)^(e+1) := Nat.pow_le_pow_left (Nat.pow_le_pow_right (by norm_num) hp) _
      _ ≤ (2^N)^(N+1) := Nat.pow_le_pow_right (Nat.one_le_two_pow) (by omega)
  have h10 : N+1 ≤ (N+1)^10 := by
    calc N+1 = (N+1)^1 := (Nat.pow_one _).symm
      _ ≤ (N+1)^10 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have h3 : N*(N+1) < 1000000000*(N+1)^10+N+1 := by
    have : N*(N+1) ≤ (N+1)*(N+1) := Nat.mul_le_mul_right _ (by omega)
    have h11 : (N+1)*(N+1) ≤ (N+1)^10 := by
      calc (N+1)*(N+1) = (N+1)^2 := by ring
