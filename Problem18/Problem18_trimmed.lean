variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}
def constsCom (r : FieldNames) (q : RNames) (ci : String) (dst : Expr) : List ℕ → ℕ → Com
  | [], _ => .skip
  | v :: vs, i => .seq (constLoad r q ci (plus dst (.lit i)) v) (constsCom r q ci dst vs (i + 1))
def constsCost (dst : Expr) (e L : ℕ) : ℕ := L * constCost (plus dst (.lit 0)) e + 1
theorem constCost_lit (dst : Expr) (i e : ℕ) :
    constCost (plus dst (.lit i)) e = constCost (plus dst (.lit 0)) e := rfl
theorem consts_run (q : RNames) (ci : String) (hciS : ci ∉ regNames r) (hciW : ci ≠ q.WS)
    (l : List String) (hl : ∀ x ∈ l, x ≠ ci) (dst : Expr) (hdp : VarsIn l dst) {B Sn dv : ℕ} :
    ∀ (vals : List ℕ) (i₀ : ℕ) (σ : Env), Slots F r q.WS Sn B σ → dst.evalB B σ = some dv →
      dv + i₀ + vals.length ≤ Sn → (∀ v ∈ vals, v < F.p) →
      ∃ τ, Run B (constsCom r q ci dst vals i₀) σ τ (constsCost dst F.e vals.length) ∧
        Slots F r q.WS Sn B τ ∧
        (∀ t (ht : t < vals.length), val F r q.WS τ (dv + i₀ + t) = ((vals[t] : ℕ) : K)) ∧
        (∀ s < Sn, (s < dv + i₀ ∨ dv + i₀ + vals.length ≤ s) →
          val F r q.WS τ s = val F r q.WS σ s) ∧
        (∀ x, x ≠ ci → τ.vars x = σ.vars x) ∧
        (∀ a, a ≠ r.mem → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out := by
  intro vals
  induction vals with
  | nil =>
    intro i₀ σ hS _ _ _
    exact ⟨σ, Run.skip.mono (by simp [constsCost]), hS, fun t ht => by simp at ht,
      fun _ _ _ => rfl, fun _ _ => rfl, fun _ _ => rfl, rfl, rfl⟩
  | cons v vs ih =>
    intro i₀ σ hS hdv hfit hp
    have hSB := hS.slots_word
    simp only [List.length_cons] at hfit
    have hpe : (plus dst (.lit i₀)).evalB B σ = some (dv + i₀) := by
      unfold plus; exact evalB_bin hdv (evalB_lit (by omega)) (by change dv + i₀ < B; omega)
    obtain ⟨τ1, hr1, hS1, hv1, ho1, hreg1, harr1, hinp1, hout1⟩ :=
      const_run (F := F) q ci hciS hciW l hl (plus dst (.lit i₀)) ⟨hdp, trivial⟩ hS hpe
        (by omega) (hp v (by simp))
    have hdv1 : dst.evalB B τ1 = some dv := by
      rw [evalB_congr_varsIn (fun x hx => hreg1 x (hl x hx)) dst hdp]; exact hdv
    obtain ⟨τ, hr, hSτ, hvals, hfr, hregs, harr, hinp, hout⟩ :=
      ih (i₀ + 1) τ1 hS1 hdv1 (by omega) (fun w hw => hp w (List.mem_cons_of_mem _ hw))
    refine ⟨τ, ?_, hSτ, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · refine (hr1.seq hr).mono ?_
      rw [constCost_lit]
      unfold constsCost
      simp only [List.length_cons]
      nlinarith
    · intro t ht
      cases t with
      | zero =>
        rw [hfr _ (by omega) (Or.inl (by omega)), Nat.add_zero, hv1]
        simp
      | succ t =>
        rw [show dv + i₀ + (t + 1) = dv + (i₀ + 1) + t by omega, hvals t (by simpa using ht)]
        simp
    · intro s hs hs'
      simp only [List.length_cons] at hs'
      rw [hfr s hs (by omega), ho1 s hs (by omega)]
    · intro x hx; rw [hregs x hx, hreg1 x hx]
    · intro a h1; rw [harr a h1, harr1 a h1]
    · rw [hinp, hinp1]
    · rw [hout, hout1]
end Mathproof.Problem18ClaudeIMPConsts20261001
