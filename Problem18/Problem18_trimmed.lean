noncomputable def elementary (w : ι → ℝ) (j : ℕ) : ℝ :=
  ∑ s ∈ univ.powersetCard j, ∏ i ∈ s, w i
theorem mass_nonneg (w : ι → ℝ) (hw0 : ∀ i, 0 ≤ w i) (hw1 : ∀ i, w i ≤ 1)
    (x : ι → Bool) : 0 ≤ mass w x := by
  apply prod_nonneg
  intro i hi
  split <;> first | exact hw0 i | exact sub_nonneg.mpr (hw1 i)
theorem joint_mass (w : ι → ℝ) (s : Finset ι) :
    (∑ x, mass w x * if ∀ i ∈ s, x i = true then 1 else 0) = ∏ i ∈ s, w i := by
  have hp (x : ι → Bool) :
      (if ∀ i ∈ s, x i = true then (1 : ℝ) else 0) =
      ∏ i, if i ∈ s → x i = true then (1 : ℝ) else 0 := by
    rw [Fintype.prod_boole]
  simp_rw [hp, mass, ← prod_mul_distrib]
  rw [← Fintype.prod_sum (fun i (v : Bool) =>
    (if v then w i else 1-w i) * if i ∈ s → v = true then (1 : ℝ) else 0)]
  have hi (i : ι) :
      (∑ v : Bool, (if v then w i else 1-w i) *
        if i ∈ s → v = true then (1 : ℝ) else 0) = if i ∈ s then w i else 1 := by
    by_cases h : i ∈ s <;> simp [h]
