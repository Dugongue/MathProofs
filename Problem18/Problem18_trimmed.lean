theorem body_run {B S : Nat} (L : Layout) (σ0 ρ : Env) (hok : L.Ok S)
    (hmb : σ0.vars canonical.modBase+F.e ≤ σ0.vars ws) (hg : Good F L S B σ0 ρ)
    (hvB : ρ.vars exponentReg<B) :
    ∃τ, Run B (body L) ρ τ (bodyCost F.e L.n) ∧ Good F L S B σ0 τ ∧
      τ.vars exponentReg=ρ.vars exponentReg/2 ∧
      mat F L (σ0.vars ws) L.acc τ=(if ρ.vars exponentReg%2=1 then
        mat F L (σ0.vars ws) L.acc ρ * mat F L (σ0.vars ws) L.base ρ
        else mat F L (σ0.vars ws) L.acc ρ) ∧
      (ρ.vars exponentReg/2=0 ∨ mat F L (σ0.vars ws) L.base τ=
        mat F L (σ0.vars ws) L.base ρ * mat F L (σ0.vars ws) L.base ρ) := by
  have hB2 : 2<B := by have := p_lt F hg.valid; have := F.prime.two_le; omega
  have hhalf : (Expr.bin .div (.var exponentReg) (.lit 2)).evalB B ρ=
      some (ρ.vars exponentReg/2) :=
    evalB_bin (evalB_var hvB) (evalB_lit hB2) (show ρ.vars exponentReg/2<B by omega)
  have r1 : Run B (.assign halfReg (.bin .div (.var exponentReg) (.lit 2))) ρ
      (ρ.setVar halfReg (ρ.vars exponentReg/2)) 4 := (Run.assign hhalf).mono (by simp)
  have hg1 : Good F L S B σ0 (ρ.setVar halfReg (ρ.vars exponentReg/2)) :=
    hg.setVar F halfReg _ (by decide)
  have hx1 : (ρ.setVar halfReg (ρ.vars exponentReg/2)).vars exponentReg=ρ.vars exponentReg := by
    simp only [vars_setVar, if_neg (by decide : exponentReg≠halfReg)]
  have hh1 : (ρ.setVar halfReg (ρ.vars exponentReg/2)).vars halfReg=ρ.vars exponentReg/2 := by
    simp only [vars_setVar, if_pos rfl, eq_self_iff_true, if_true, ite_true]
  obtain ⟨ρ2,r2,hg2,hacc2,hbase2,hx2,hh2⟩ : ∃ρ2, Run B
      (.ite (.eq (.var exponentReg) (.bin .mul (.var halfReg) (.lit 2))) .skip (multiplyStep L))
      (ρ.setVar halfReg (ρ.vars exponentReg/2)) ρ2 (6+(productCost F.e L.n+copyCost F.e L.n)) ∧
      Good F L S B σ0 ρ2 ∧
      mat F L (σ0.vars ws) L.acc ρ2=(if ρ.vars exponentReg%2=1 then
        mat F L (σ0.vars ws) L.acc ρ * mat F L (σ0.vars ws) L.base ρ
        else mat F L (σ0.vars ws) L.acc ρ) ∧
      mat F L (σ0.vars ws) L.base ρ2=mat F L (σ0.vars ws) L.base ρ ∧
      ρ2.vars exponentReg=ρ.vars exponentReg ∧ ρ2.vars halfReg=ρ.vars exponentReg/2 := by
    have htest := evalB_condEq (evalB_var_eq hx1 hvB)
      (evalB_bin (op:=.mul) (evalB_var_eq hh1 (show ρ.vars exponentReg/2<B by omega))
        (evalB_lit hB2) (show ρ.vars exponentReg/2*2<B by omega))
    by_cases hpar : ρ.vars exponentReg%2=1
    · have hb : (ρ.vars exponentReg==Bop.apply .mul (ρ.vars exponentReg/2) 2)=false := by
        simp only [Bop.apply, beq_eq_false_iff_ne]; omega
      rw [hb] at htest
      obtain ⟨τ,hr,hgτ,hacc,hbase,hx,hh⟩ := multiply_step_run F L σ0 _ hok hmb hg1
      refine ⟨τ,(Run.ite_false htest hr).mono ?_,hgτ,?_,?_,?_,?_⟩
      · simp only [Cond.size, Expr.size]; omega
      · rw [if_pos hpar, hacc]; rfl
      · rw [hbase]; rfl
      · rw [hx, hx1]
      · rw [hh, hh1]
    · have hb : (ρ.vars exponentReg==Bop.apply .mul (ρ.vars exponentReg/2) 2)=true := by
        simp only [Bop.apply, beq_iff_eq]; omega
      rw [hb] at htest
      refine ⟨_,(Run.ite_true htest Run.skip).mono ?_,hg1,?_,rfl,hx1,hh1⟩
      · simp only [Cond.size, Expr.size, productCost, copyCost]; omega
      · rw [if_neg hpar]; rfl
  have r3 : Run B (.assign exponentReg (.var halfReg)) ρ2
      (ρ2.setVar exponentReg (ρ.vars exponentReg/2)) 2 :=
    (Run.assign (evalB_var_eq hh2 (show ρ.vars exponentReg/2<B by omega))).mono (by simp)
  have hg3 : Good F L S B σ0 (ρ2.setVar exponentReg (ρ.vars exponentReg/2)) :=
    hg2.setVar F exponentReg _ (by decide)
  have hx3 : (ρ2.setVar exponentReg (ρ.vars exponentReg/2)).vars exponentReg=
      ρ.vars exponentReg/2 := by
    simp only [vars_setVar, if_pos rfl, eq_self_iff_true, if_true, ite_true]
  have htest4 := evalB_condLt (evalB_lit (σ:=ρ2.setVar exponentReg (ρ.vars exponentReg/2))
    (show 0<B by omega)) (evalB_var_eq hx3 (show ρ.vars exponentReg/2<B by omega))
  by_cases hpos : 0<ρ.vars exponentReg/2
  · have hb : decide (0<ρ.vars exponentReg/2)=true := by simp [hpos]
    rw [hb] at htest4
    obtain ⟨τ,hr,hgτ,hacc,hbase,hx,_⟩ := square_step_run F L σ0 _ hok hmb hg3
    refine ⟨τ,?_,hgτ,?_,?_,Or.inr ?_⟩
    · have hall := r1.seq (r2.seq (r3.seq (Run.ite_true (d:=.skip) htest4 hr)))
      exact hall.mono (by simp only [bodyCost, Cond.size, Expr.size]; omega)
    · rw [hx, hx3]
    · rw [hacc]; exact hacc2
    · rw [hbase]; rw [show mat F L (σ0.vars ws) L.base (ρ2.setVar exponentReg (ρ.vars exponentReg/2))=
        mat F L (σ0.vars ws) L.base ρ2 from rfl, hbase2]
  · have hb : decide (0<ρ.vars exponentReg/2)=false := by simp [hpos]
