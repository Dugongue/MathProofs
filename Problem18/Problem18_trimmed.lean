    ((hyperbolic_symmetric m).eq x.1 y.1) ((modelForm_symmetric r (1 : SquareClass K)).eq x.2 y.2)⟩
  have haA : ¬A.IsAlt := by
    intro h
    apply modelForm_not_alt r (1 : SquareClass K)
    intro x
