variable {K : Type} [Field K] [Fintype K] (F : FieldPresentation K)
variable {W Sn a b c : Nat} {u : Bool} {q : Nat} {A : RectTensor a b c K} {σ : Env}
theorem pg_nums (h : PostGather F W Sn a b c u q A σ) :
    let S := a+b+c
