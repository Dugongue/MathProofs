namespace Mathproof.Problem18BertiniRatFuncClosure20261001
open Polynomial
open scoped BigOperators
section LAC
variable {K Ω : Type*} [Field K] [Field Ω] [Algebra K Ω]
theorem aeval_ne_zero_of_transcendental (L : IntermediateField K Ω) {s : Ω}
    (hs : Transcendental L s) {p : K[X]} (hp : p ≠ 0) : aeval s p ≠ 0 := by
  intro h
  apply hs
  refine ⟨p.map (algebraMap K L), (Polynomial.map_ne_zero_iff (algebraMap K L).injective).mpr hp, ?_⟩
  rw [aeval_map_algebraMap]
  exact h
theorem exists_clear_denominators {s : Ω} (hsK : ∀ p : K[X], p ≠ 0 → aeval s p ≠ 0) {w : Ω}
    (halg : IsAlgebraic (IntermediateField.adjoin K {s}) w) :
    ∃ (N : ℕ) (Φ : ℕ → K[X]), Φ N ≠ 0 ∧
      ∑ i ∈ Finset.range (N + 1), aeval s (Φ i) * w ^ i = 0 := by
  classical
  obtain ⟨P, hP0, hPw⟩ := halg
  have hc : ∀ i, ∃ p q : K[X], q ≠ 0 ∧
      ((P.coeff i : IntermediateField.adjoin K {s}) : Ω) * aeval s q = aeval s p := by
    intro i
    obtain ⟨r, q, hrq⟩ := (IntermediateField.mem_adjoin_simple_iff K _).mp (P.coeff i).2
    by_cases hq : aeval s q = 0
    · refine ⟨0, 1, one_ne_zero, ?_⟩
      rw [hrq, hq, div_zero, zero_mul, map_zero]
    · refine ⟨r, q, fun h => hq (by rw [h, map_zero]), ?_⟩
      rw [hrq, div_mul_cancel₀ _ hq]
  choose p q hq0 hpq using hc
  have hD : ∀ i ∈ Finset.range (P.natDegree + 1),
      aeval s (p i * ∏ j ∈ (Finset.range (P.natDegree + 1)).erase i, q j) =
        ((P.coeff i : IntermediateField.adjoin K {s}) : Ω) *
          ∏ j ∈ Finset.range (P.natDegree + 1), aeval s (q j) := by
    intro i hi
    rw [map_mul, map_prod, ← hpq i, mul_assoc,
      Finset.mul_prod_erase _ (fun j => aeval s (q j)) hi]
  refine ⟨P.natDegree, fun i => p i * ∏ j ∈ (Finset.range (P.natDegree + 1)).erase i, q j,
    ?_, ?_⟩
  · intro h0
    have hlead : ((P.coeff P.natDegree : IntermediateField.adjoin K {s}) : Ω) ≠ 0 := by
      rw [ne_eq, ZeroMemClass.coe_eq_zero]
      exact leadingCoeff_ne_zero.mpr hP0
    have hprod : ∏ j ∈ Finset.range (P.natDegree + 1), aeval s (q j) ≠ 0 :=
      Finset.prod_ne_zero_iff.mpr (fun j _ => hsK _ (hq0 j))
    have h1 := hD P.natDegree (Finset.self_mem_range_succ _)
    have h2 : aeval s (p P.natDegree *
        ∏ j ∈ (Finset.range (P.natDegree + 1)).erase P.natDegree, q j) = 0 := by
      rw [show p P.natDegree * ∏ j ∈ (Finset.range (P.natDegree + 1)).erase P.natDegree, q j = 0
        from h0, map_zero]
    rw [h2] at h1
    exact mul_ne_zero hlead hprod h1.symm
  · calc ∑ i ∈ Finset.range (P.natDegree + 1),
          aeval s (p i * ∏ j ∈ (Finset.range (P.natDegree + 1)).erase i, q j) * w ^ i
        = ∑ i ∈ Finset.range (P.natDegree + 1),
            (∏ j ∈ Finset.range (P.natDegree + 1), aeval s (q j)) *
              (((P.coeff i : IntermediateField.adjoin K {s}) : Ω) * w ^ i) :=
          Finset.sum_congr rfl (fun i hi => by rw [hD i hi]; ring)
      _ = (∏ j ∈ Finset.range (P.natDegree + 1), aeval s (q j)) * aeval w P := by
          rw [← Finset.mul_sum, aeval_eq_sum_range]
          congr 1
      _ = 0 := by rw [hPw, mul_zero]
theorem isAlgebraic_specialize (L : IntermediateField K Ω) {s : Ω} (hs : Transcendental L s)
    {N : ℕ} {Φ : ℕ → K[X]} {w : Ω}
    (hsum : ∑ i ∈ Finset.range (N + 1), aeval s (Φ i) * w ^ i = 0)
    {r q : Polynomial L} (hq : aeval s q ≠ 0) (hw : w = aeval s r / aeval s q)
    (a : K) (hqa : q.eval (algebraMap K L a) ≠ 0) (hΦa : (Φ N).eval a ≠ 0) :
    IsAlgebraic K (r.eval (algebraMap K L a) / q.eval (algebraMap K L a)) := by
  set Ψ : Polynomial L :=
    ∑ i ∈ Finset.range (N + 1), (Φ i).map (algebraMap K L) * r ^ i * q ^ (N - i) with hΨ
  have hΨs : aeval s Ψ = 0 := by
    have hcalc : aeval s Ψ = aeval s q ^ N * ∑ i ∈ Finset.range (N + 1), aeval s (Φ i) * w ^ i := by
      rw [hΨ, map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl (fun i hi => ?_)
      have hiN : i ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hqi : aeval s q ^ i ≠ 0 := pow_ne_zero _ hq
      have hsplit : aeval s q ^ N = aeval s q ^ (N - i) * aeval s q ^ i := by
        rw [← pow_add, Nat.sub_add_cancel hiN]
      rw [map_mul, map_mul, map_pow, map_pow, aeval_map_algebraMap, hw, div_pow, hsplit]
      first | (field_simp; ring) | field_simp
    rw [hcalc, hsum, mul_zero]
  have hΨ0 : Ψ = 0 := by
    by_contra h
    exact hs ⟨Ψ, h, hΨs⟩
  have hev : ∑ i ∈ Finset.range (N + 1), algebraMap K L ((Φ i).eval a) *
      r.eval (algebraMap K L a) ^ i * q.eval (algebraMap K L a) ^ (N - i) = 0 := by
    have h1 := congrArg (Polynomial.eval (algebraMap K L a)) hΨ0
    rw [hΨ, eval_zero, eval_finsetSum] at h1
    simpa only [eval_mul, eval_pow, eval_map, eval₂_at_apply] using h1
  refine ⟨∑ i ∈ Finset.range (N + 1), C ((Φ i).eval a) * X ^ i, ?_, ?_⟩
  · intro h0
    have h1 := congrArg (fun P : K[X] => P.coeff N) h0
    simp only [finsetSum_coeff, coeff_C_mul_X_pow, coeff_zero] at h1
    rw [Finset.sum_ite_eq] at h1
    simp [hΦa] at h1
  · have hqa' : q.eval (algebraMap K L a) ^ N ≠ 0 := pow_ne_zero _ hqa
    apply mul_right_cancel₀ hqa'
    rw [zero_mul, map_sum, Finset.sum_mul]
    refine Eq.trans (Finset.sum_congr rfl (fun i hi => ?_)) hev
    have hiN : i ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    have hqi : q.eval (algebraMap K L a) ^ i ≠ 0 := pow_ne_zero _ hqa
    have hsplit : q.eval (algebraMap K L a) ^ N =
        q.eval (algebraMap K L a) ^ (N - i) * q.eval (algebraMap K L a) ^ i := by
      rw [← pow_add, Nat.sub_add_cancel hiN]
    rw [map_mul, aeval_C, map_pow, aeval_X, div_pow, hsplit]
    first | (field_simp; ring) | field_simp
theorem exists_poly_of_values (L : IntermediateField K Ω) (r q : Polynomial L) (hq0 : q ≠ 0)
    (n : ℕ) (hr : r.natDegree ≤ n) (hqn : q.natDegree ≤ n) (t : Finset K)
    (ht : t.card = 2 * n + 1) (c : K → K)
    (hc : ∀ a ∈ t, r.eval (algebraMap K L a) = algebraMap K L (c a) * q.eval (algebraMap K L a)) :
    ∃ f g : K[X], g ≠ 0 ∧ r * g.map (algebraMap K L) = f.map (algebraMap K L) * q := by
  classical
  let Λ : (degreeLT K (n + 1) × degreeLT K (n + 1)) →ₗ[K] (t → K) :=
    { toFun := fun v a => (v.1 : K[X]).eval (a : K) - c a * (v.2 : K[X]).eval (a : K)
      map_add' := by
        intro v v'
        funext a
        simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add, eval_add, Pi.add_apply]
        ring
      map_smul' := by
        intro b v
        funext a
        simp only [Prod.smul_fst, Prod.smul_snd, Submodule.coe_smul, eval_smul, smul_eq_mul,
          Pi.smul_apply, RingHom.id_apply]
        ring }
  haveI : FiniteDimensional K (degreeLT K (n + 1)) :=
    LinearEquiv.finiteDimensional (degreeLTEquiv K (n + 1)).symm
  have hdim : Module.finrank K (t → K) <
      Module.finrank K (degreeLT K (n + 1) × degreeLT K (n + 1)) := by
    rw [Module.finrank_fintype_fun_eq_card, Module.finrank_prod,
      (degreeLTEquiv K (n + 1)).finrank_eq, Module.finrank_fin_fun, Fintype.card_coe, ht]
    omega
  obtain ⟨v, hv, hv0⟩ := (Submodule.ne_bot_iff _).mp (LinearMap.ker_ne_bot_of_finrank_lt (f := Λ) hdim)
  have hval : ∀ a ∈ t, (v.1 : K[X]).eval a = c a * (v.2 : K[X]).eval a := by
    intro a ha
    have h1 := congrFun (LinearMap.mem_ker.mp hv) ⟨a, ha⟩
    simpa [Λ, sub_eq_zero] using h1
  have hdeg : ∀ p : K[X], p ∈ degreeLT K (n + 1) → p.natDegree ≤ n := by
    intro p hp
    by_cases h : p = 0
    · simp [h]
    · exact Nat.lt_succ_iff.mp ((natDegree_lt_iff_degree_lt h).mpr (mem_degreeLT.mp hp))
  have hΔ : r * (v.2 : K[X]).map (algebraMap K L) - (v.1 : K[X]).map (algebraMap K L) * q = 0 := by
    apply Polynomial.eq_zero_of_natDegree_lt_card_of_eval_eq_zero' _
      (t.map ⟨algebraMap K L, (algebraMap K L).injective⟩)
    · intro x hx
      obtain ⟨a, ha, rfl⟩ := Finset.mem_map.mp hx
      simp only [Function.Embedding.coeFn_mk, eval_sub, eval_mul, eval_map, eval₂_at_apply,
        hc a ha, hval a ha, map_mul]
      ring
    · rw [Finset.card_map, ht]
      have h1 := natDegree_sub_le (r * (v.2 : K[X]).map (algebraMap K L))
        ((v.1 : K[X]).map (algebraMap K L) * q)
      have h2 : (r * (v.2 : K[X]).map (algebraMap K L)).natDegree ≤ n + n :=
        natDegree_mul_le.trans (add_le_add hr (natDegree_map_le.trans (hdeg _ v.2.2)))
      have h3 : ((v.1 : K[X]).map (algebraMap K L) * q).natDegree ≤ n + n :=
        natDegree_mul_le.trans (add_le_add (natDegree_map_le.trans (hdeg _ v.1.2)) hqn)
      omega
  have hg : (v.2 : K[X]) ≠ 0 := by
    intro hg0
    apply hv0
    have hf0 : (v.1 : K[X]) = 0 := by
      rw [hg0, Polynomial.map_zero, mul_zero, zero_sub, neg_eq_zero, mul_eq_zero] at hΔ
      rcases hΔ with h | h
      · exact (Polynomial.map_eq_zero_iff (algebraMap K L).injective).mp h
      · exact absurd h hq0
    exact Prod.ext (Subtype.ext hf0) (Subtype.ext hg0)
  exact ⟨v.1, v.2, hg, sub_eq_zero.mp hΔ⟩
theorem mem_adjoin_of_isAlgebraic [Infinite K] (L : IntermediateField K Ω)
    (hK : ∀ x : L, IsAlgebraic K x → ∃ b : K, algebraMap K L b = x)
    {s : Ω} (hs : Transcendental L s) {w : Ω} (hw : w ∈ IntermediateField.adjoin L {s})
    (halg : IsAlgebraic (IntermediateField.adjoin K {s}) w) :
    w ∈ IntermediateField.adjoin K {s} := by
  classical
  obtain ⟨r, q, hrq⟩ := (IntermediateField.mem_adjoin_simple_iff L _).mp hw
  by_cases hq : aeval s q = 0
  · rw [hrq, hq, div_zero]
    exact zero_mem _
  have hq0 : q ≠ 0 := fun h => hq (by rw [h, map_zero])
  have hsK : ∀ p : K[X], p ≠ 0 → aeval s p ≠ 0 := fun p hp =>
    aeval_ne_zero_of_transcendental L hs hp
  obtain ⟨N, Φ, hΦN, hsum⟩ := exists_clear_denominators hsK halg
  have hbad : {a : K | q.eval (algebraMap K L a) = 0 ∨ (Φ N).eval a = 0}.Finite := by
    rw [Set.setOf_or]
    apply Set.Finite.union
    · refine ((q.roots.toFinset.finite_toSet).preimage
        (algebraMap K L).injective.injOn).subset (fun a ha => ?_)
      simp only [Set.mem_preimage, Finset.mem_coe, Multiset.mem_toFinset, mem_roots hq0,
        IsRoot.def]
      exact ha
    · refine ((Φ N).roots.toFinset.finite_toSet).subset (fun a ha => ?_)
      simp only [Finset.mem_coe, Multiset.mem_toFinset, mem_roots hΦN, IsRoot.def]
      exact ha
  obtain ⟨t, htsub, htcard⟩ :=
    hbad.infinite_compl.exists_subset_card_eq (2 * max r.natDegree q.natDegree + 1)
  have hval : ∀ a ∈ t, ∃ b : K,
      r.eval (algebraMap K L a) = algebraMap K L b * q.eval (algebraMap K L a) := by
    intro a ha
    have hgood := htsub (Finset.mem_coe.mpr ha)
    simp only [Set.mem_compl_iff, Set.mem_setOf_eq, not_or] at hgood
    obtain ⟨b, hb⟩ := hK _ (isAlgebraic_specialize L hs hsum hq hrq a hgood.1 hgood.2)
    exact ⟨b, by rw [hb, div_mul_cancel₀ _ hgood.1]⟩
  choose! c hc using hval
  obtain ⟨f, g, hg0, hfg⟩ := exists_poly_of_values L r q hq0 (max r.natDegree q.natDegree)
    (le_max_left _ _) (le_max_right _ _) t htcard c hc
  have hgs : aeval s g ≠ 0 := hsK g hg0
  have h2 := congrArg (aeval s) hfg
  rw [map_mul, map_mul, aeval_map_algebraMap, aeval_map_algebraMap] at h2
  have hw' : w = aeval s f / aeval s g := by
    rw [hrq, div_eq_div_iff hq hgs]
    exact h2
  rw [hw']
  exact div_mem
    (IntermediateField.algebra_adjoin_le_adjoin K {s} (Polynomial.aeval_mem_adjoin_singleton K s))
    (IntermediateField.algebra_adjoin_le_adjoin K {s} (Polynomial.aeval_mem_adjoin_singleton K s))
end LAC
