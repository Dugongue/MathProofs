namespace Mathproof.Problem18MatrixSpanCheck20261001
open Matrix
open Problem18ArrayElimination20260929 Problem18Elimination20260929
variable {K : Type*} [Field K] [DecidableEq K] {n : ℕ}
def flattenLinear : Matrix (Fin n) (Fin n) K→ₗ[K](Fin (n*n)→K) where
  toFun M k := M (finProdFinEquiv.symm k).1 (finProdFinEquiv.symm k).2
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
def flatten (M : Matrix (Fin n) (Fin n) K) : Vector K (n*n) :=
  Vector.ofFn (flattenLinear M)
@[simp] theorem read_flatten (M : Matrix (Fin n) (Fin n) K) :
    read (flatten M)=flattenLinear M := read_ofFn _
theorem flattenLinear_injective : Function.Injective (flattenLinear (K:=K) (n:=n)) := by
  intro M N h
  apply Matrix.ext
  intro i j
  have hh := congrFun h (finProdFinEquiv (i,j))
  change M (finProdFinEquiv.symm (finProdFinEquiv (i,j))).1
    (finProdFinEquiv.symm (finProdFinEquiv (i,j))).2=
    N (finProdFinEquiv.symm (finProdFinEquiv (i,j))).1
    (finProdFinEquiv.symm (finProdFinEquiv (i,j))).2 at hh
  simpa only [Equiv.symm_apply_apply] using hh
def matrixSpanCheck (ms : List (Matrix (Fin n) (Fin n) K))
    (M : Matrix (Fin n) (Fin n) K) : Bool×ℕ :=
  spanCheck (ms.map flatten) (flatten M)
theorem matrixSpanCheck_correct (ms : List (Matrix (Fin n) (Fin n) K))
    (M : Matrix (Fin n) (Fin n) K) :
    (matrixSpanCheck ms M).1=true ↔ M∈Submodule.span K {A | A∈ms} := by
  rw [matrixSpanCheck,spanCheck_iff,read_flatten]
  have hm : (ms.map flatten).map read=ms.map flattenLinear := by
    simp only [List.map_map,Function.comp_def,read_flatten]
  rw [hm]
  have hs : rowSpan (K:=K) (ms.map flattenLinear)=
      (rowSpan (K:=K) ms).map flattenLinear := by
    rw [rowSpan,rowSpan,Submodule.map_span]
    congr 1
    ext y
    simp only [Set.mem_setOf_eq,List.mem_map,Set.mem_image]
  rw [hs]
  constructor
  · intro h
    obtain ⟨A,hA,hAM⟩ := Submodule.mem_map.mp h
    exact flattenLinear_injective hAM ▸ hA
  · intro h
    exact Submodule.mem_map.mpr ⟨M,h,rfl⟩
end Mathproof.Problem18MatrixSpanCheck20261001
end
