    (h : a ≤ b) : reduceCost M q Nv nv a ≤ reduceCost M q Nv nv b := by
  unfold reduceCost stepCost
  have h1 := elimCost_mono M q Nv h
  have h2 : (4 + (pivotCost M nv + 10 + elimCost M q Nv a)) * a ≤
      (4 + (pivotCost M nv + 10 + elimCost M q Nv b)) * b := Nat.mul_le_mul (by omega) h
  omega
