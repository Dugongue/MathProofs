variable {K : Type*} [Field K] [StarRing K] {a b d m r : ℕ}
set_option backward.isDefEq.respectTransparency false
theorem tensorGram_inner_sum (J : Matrix (Fin d) (Fin d) K)
    (N : Fin d→Fin a→Fin b→K) :
    tensorGram J N=∑i,(rowBlock N i)ᵀ*J*((rowBlock N i)ᵀ)ᴴ := by
  simp only [tensorGram,metricGram,Matrix.transpose_sum,Matrix.transpose_mul,
    Matrix.transpose_transpose,Matrix.mul_assoc,Matrix.conjTranspose_transpose,
    Matrix.transpose_conjTranspose]
theorem tensorGram_isHermitian (J : Matrix (Fin d) (Fin d) K) (hJ : J.IsHermitian)
    (N : Fin d→Fin a→Fin b→K) : (tensorGram J N).IsHermitian := by
  rw [tensorGram_inner_sum]
  change (∑i,(rowBlock N i)ᵀ*J*((rowBlock N i)ᵀ)ᴴ)ᴴ=_
  rw [Matrix.conjTranspose_sum]
  apply Finset.sum_congr rfl
  intro i _
  exact Matrix.isHermitian_mul_mul_conjTranspose _ hJ
theorem tensorGram_inner_succ (J : Matrix (Fin d) (Fin d) K)
    (N : Fin d→Fin (a+1)→Fin b→K) :
    tensorGram J N=(rowBlock N 0)ᵀ*J*((rowBlock N 0)ᵀ)ᴴ+
      tensorGram J (fun r i j=>N r i.succ j) := by
  rw [tensorGram_inner_sum,Fin.sum_univ_succ,tensorGram_inner_sum]
  rfl
theorem gram_fromCols (H : Matrix (Fin d) (Fin d) K)
    (C : Matrix (Fin r) (Fin r) K) (X : Matrix (Fin b) (Fin d) K)
    (Y : Matrix (Fin b) (Fin r) K) :
    fromCols X Y * fromBlocks H 0 0 C * (fromCols X Y)ᴴ=
      X*H*Xᴴ+Y*C*Yᴴ := by
  rw [Matrix.fromCols_mul_fromBlocks,Matrix.conjTranspose_fromCols_eq_fromRows_conjTranspose,
    Matrix.fromCols_mul_fromRows]
  simp only [Matrix.mul_zero,add_zero,zero_add]
theorem gram_reindex_columns (H : Matrix (Fin d) (Fin d) K)
    (C : Matrix (Fin r) (Fin r) K) (X : Matrix (Fin b) (Fin d) K)
    (Y : Matrix (Fin b) (Fin r) K) :
    (fromCols X Y).submatrix id finSumFinEquiv.symm *
      Matrix.reindex finSumFinEquiv finSumFinEquiv (fromBlocks H 0 0 C) *
      ((fromCols X Y).submatrix id finSumFinEquiv.symm)ᴴ=
      X*H*Xᴴ+Y*C*Yᴴ := by
  change (fromCols X Y).submatrix id finSumFinEquiv.symm *
    (fromBlocks H 0 0 C).submatrix finSumFinEquiv.symm finSumFinEquiv.symm *
    ((fromCols X Y)ᴴ).submatrix finSumFinEquiv.symm id=_
  rw [Matrix.submatrix_mul_equiv,Matrix.submatrix_mul_equiv]
  exact gram_fromCols H C X Y
theorem hyperbolic_residual_gram
    (u : Fin m→(Fin b→K)×(Fin b→K))
    (C : Matrix (Fin r) (Fin r) K) (Y : Matrix (Fin b) (Fin r) K) :
    (fromCols (packed u) Y).submatrix id finSumFinEquiv.symm *
      Matrix.reindex finSumFinEquiv finSumFinEquiv (fromBlocks (hyperbolicMetric m (1:K)) 0 0 C) *
      ((fromCols (packed u) Y).submatrix id finSumFinEquiv.symm)ᴴ=
      (∑j,(Matrix.vecMulVec (u j).1 (star (u j).2)+Matrix.vecMulVec (u j).2 (star (u j).1)))+
        Y*C*Yᴴ := by
  rw [gram_reindex_columns,packed_hermitian_gram]
def tensorRowsEquiv (d a b : ℕ) :
    (Fin d→Fin (a+1)→Fin b→K) ≃
      Matrix (Fin b) (Fin d) K × (Fin d→Fin a→Fin b→K) where
  toFun N := (fun j r=>N r 0 j,fun r i j=>N r i.succ j)
  invFun z r i j := Fin.cases (z.1 j r) (fun k=>z.2 r k j) i
  left_inv N := by
    funext r i j
    cases i using Fin.cases <;> rfl
  right_inv z := by
    apply Prod.ext <;> rfl
def splitColumnsEquiv (d r b : ℕ) :
    Matrix (Fin b) (Fin (d+r)) K ≃
      Matrix (Fin b) (Fin d) K × Matrix (Fin b) (Fin r) K where
  toFun X := (fun i j=>X i (finSumFinEquiv (Sum.inl j)),fun i j=>X i (finSumFinEquiv (Sum.inr j)))
  invFun z := (fromCols z.1 z.2).submatrix id finSumFinEquiv.symm
  left_inv X := by
    funext i j
    obtain ⟨j,rfl⟩ := finSumFinEquiv.surjective j
    cases j <;> simp only [Matrix.submatrix_apply,Equiv.symm_apply_apply,Matrix.fromCols] <;> rfl
  right_inv z := by
    apply Prod.ext <;> funext i j <;>
      simp only [Matrix.submatrix_apply,Equiv.symm_apply_apply,Matrix.fromCols] <;> rfl
def sourceSampleEquiv (m r a b : ℕ) :
    (Fin ((m+m)+r)→Fin (a+1)→Fin b→K) ≃
      ((Fin m→(Fin b→K)×(Fin b→K)) × Matrix (Fin b) (Fin r) K) ×
        (Fin ((m+m)+r)→Fin a→Fin b→K) :=
  (tensorRowsEquiv ((m+m)+r) a b).trans
    (((splitColumnsEquiv (m+m) r b).trans
      ((packedEquiv (K:=K) b m).symm.prodCongr (Equiv.refl _))).prodCongr (Equiv.refl _))
theorem sourceSample_gram (C : Matrix (Fin r) (Fin r) K)
    (z : ((Fin m→(Fin b→K)×(Fin b→K)) × Matrix (Fin b) (Fin r) K) ×
      (Fin ((m+m)+r)→Fin a→Fin b→K)) :
    let J := Matrix.reindex finSumFinEquiv finSumFinEquiv
      (fromBlocks (hyperbolicMetric m (1:K)) 0 0 C)
    tensorGram J ((sourceSampleEquiv m r a b).symm z)=
      (∑j,(Matrix.vecMulVec (z.1.1 j).1 (star (z.1.1 j).2)+
        Matrix.vecMulVec (z.1.1 j).2 (star (z.1.1 j).1)))+
      (z.1.2*C*z.1.2ᴴ+tensorGram J z.2) := by
  dsimp only
  rw [tensorGram_inner_succ]
  change (fromCols (packed z.1.1) z.1.2).submatrix id finSumFinEquiv.symm *
    Matrix.reindex finSumFinEquiv finSumFinEquiv (fromBlocks (hyperbolicMetric m (1:K)) 0 0 C) *
    ((fromCols (packed z.1.1) z.1.2).submatrix id finSumFinEquiv.symm)ᴴ+
    tensorGram _ z.2=_
  rw [hyperbolic_residual_gram,add_assoc]
end
end Mathproof.Problem18AnchorTensorDecomposition20261001
