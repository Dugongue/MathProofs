  | t + 1, s => (step w p s).bind (run w p t)
def initState (x : List ℕ) : State where
  pc := 0
  acc := 0
  mem := fun _ => 0
  inp := x
  out := []
def RunsTo (w : ℕ) (p : Program) (x y : List ℕ) (t : ℕ) : Prop :=
  ∃ s : State, run w p t (initState x) = some s ∧ step w p s = none ∧ s.out = y
