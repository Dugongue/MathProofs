def segEqBody (arr idx o1 o2 flag : String) : Com :=
  .seq (.ite (.eq (.get arr (.bin .add (.var o1) (.var idx)))
      (.get arr (.bin .add (.var o2) (.var idx))))
      .skip (.assign flag (.lit 0)))
    (.assign idx (.bin .add (.var idx) (.lit 1)))
def segEq (arr idx cnt o1 o2 flag : String) : Com :=
  .seq (.assign flag (.lit 1)) <| .seq (.assign idx (.lit 0))
    (.while (.lt (.var idx) (.var cnt)) (segEqBody arr idx o1 o2 flag))
theorem getElem?_of_getD {l : List Nat} {k : Nat} (h : k<l.length) :
    l[k]?=some (l.getD k 0) := by
  simp [List.getD,List.getElem?_eq_getElem h]
theorem segEq_run {arr idx cnt o1 o2 flag : String}
    (hic : idx≠cnt) (hi1 : idx≠o1) (hi2 : idx≠o2) (hif : idx≠flag)
    (hfc : flag≠cnt) (hf1 : flag≠o1) (hf2 : flag≠o2)
    {B n b1 b2 : Nat} (sigma : Env)
    (hB1 : 1<B) (hn : n<B) (hcount : sigma.vars cnt=n)
    (h1 : sigma.vars o1=b1) (h2 : sigma.vars o2=b2)
    (h1B : b1+n<B) (h2B : b2+n<B)
    (hfit1 : b1+n≤(sigma.arrs arr).length) (hfit2 : b2+n≤(sigma.arrs arr).length)
    (hword : ∀k<n,(sigma.arrs arr).getD (b1+k) 0<B ∧ (sigma.arrs arr).getD (b2+k) 0<B) :
    ∃tau,Run B (segEq arr idx cnt o1 o2 flag) sigma tau (20*n+8) ∧
      (tau.vars flag=0 ∨ tau.vars flag=1) ∧
      (tau.vars flag=1 ↔ ∀k<n,(sigma.arrs arr).getD (b1+k) 0=(sigma.arrs arr).getD (b2+k) 0) ∧
      tau.arrs=sigma.arrs ∧
      (∀x,x≠idx→x≠flag→tau.vars x=sigma.vars x) ∧
      tau.inp=sigma.inp ∧ tau.out=sigma.out := by
  let w : Nat→Nat→Prop:=fun k _=>(sigma.arrs arr).getD (b1+k) 0=(sigma.arrs arr).getD (b2+k) 0
  let I : Env→Prop:=fun rho=>rho.vars idx≤n ∧ rho.vars cnt=n ∧
    rho.vars o1=b1 ∧ rho.vars o2=b2 ∧ rho.arrs=sigma.arrs ∧
    ((rho.vars flag=1 ∧ ∀k< rho.vars idx,w k 0) ∨
     (rho.vars flag=0 ∧ ∃k< rho.vars idx,¬w k 0))
  let V : Env→Nat:=fun rho=>n-rho.vars idx
  have hdef : ∀rho,I rho →
      ∃v,(Cond.lt (.var idx) (.var cnt)).evalB B rho=some v := by
    intro rho h
    exact evalB_condLt_vars (by have:=h.1;omega) (by rw [h.2.1];exact hn)
  have hstep : ∀rho,I rho →
      (Cond.lt (.var idx) (.var cnt)).evalB B rho=some true →
      ∃tau,Run B (segEqBody arr idx o1 o2 flag) rho tau 16 ∧ I tau ∧ V tau<V rho := by
    intro rho h hc
    obtain ⟨hidx,hcnt,ho1,ho2,harr,hflag⟩:=h
    have htest:=evalB_condLt
      (evalB_var (by omega : rho.vars idx<B))
      (evalB_var (by rw [hcnt];exact hn : rho.vars cnt<B))
    rw [hc,hcnt] at htest
    have hi : rho.vars idx<n:=by simpa using htest.symm
    have ha1 : (Expr.bin .add (.var o1) (.var idx)).evalB B rho=some (b1+rho.vars idx) := by
      have := evalB_bin (op:=.add) (evalB_var (σ:=rho) (x:=o1) (B:=B) (by rw [ho1];omega))
        (evalB_var (σ:=rho) (x:=idx) (B:=B) (by omega)) (by simp [Bop.apply,ho1];omega)
      simpa [Bop.apply,ho1] using this
    have ha2 : (Expr.bin .add (.var o2) (.var idx)).evalB B rho=some (b2+rho.vars idx) := by
      have := evalB_bin (op:=.add) (evalB_var (σ:=rho) (x:=o2) (B:=B) (by rw [ho2];omega))
        (evalB_var (σ:=rho) (x:=idx) (B:=B) (by omega)) (by simp [Bop.apply,ho2];omega)
      simpa [Bop.apply,ho2] using this
    have hl1 : b1+rho.vars idx<(sigma.arrs arr).length := by omega
    have hl2 : b2+rho.vars idx<(sigma.arrs arr).length := by omega
    have hg1 : (Expr.get arr (.bin .add (.var o1) (.var idx))).evalB B rho=
        some ((sigma.arrs arr).getD (b1+rho.vars idx) 0) :=
      evalB_get ha1 (by rw [harr];exact getElem?_of_getD hl1) (hword _ hi).1
    have hg2 : (Expr.get arr (.bin .add (.var o2) (.var idx))).evalB B rho=
        some ((sigma.arrs arr).getD (b2+rho.vars idx) 0) :=
      evalB_get ha2 (by rw [harr];exact getElem?_of_getD hl2) (hword _ hi).2
    have hcond:=evalB_condEq hg1 hg2
    have hite : ∃rho1,Run B (.ite (.eq (.get arr (.bin .add (.var o1) (.var idx)))
        (.get arr (.bin .add (.var o2) (.var idx)))) .skip (.assign flag (.lit 0))) rho rho1 12 ∧
        rho1.vars idx=rho.vars idx ∧ rho1.vars cnt=n ∧ rho1.vars o1=b1 ∧ rho1.vars o2=b2 ∧
        rho1.arrs=sigma.arrs ∧
        ((rho1.vars flag=1 ∧ ∀k< rho.vars idx+1,w k 0) ∨
         (rho1.vars flag=0 ∧ ∃k< rho.vars idx+1,¬w k 0)) := by
      by_cases heq : w (rho.vars idx) 0
      · have hb : ((sigma.arrs arr).getD (b1+rho.vars idx) 0==
            (sigma.arrs arr).getD (b2+rho.vars idx) 0)=true := by
          exact beq_iff_eq.mpr heq
        refine ⟨rho,(Run.ite_true (hcond.trans (by rw [hb])) Run.skip).mono (by simp),
          rfl,hcnt,ho1,ho2,harr,?_⟩
        rcases hflag with ⟨hf,hall⟩|⟨hf,hex⟩
        · left
          refine ⟨hf,fun k hk=>?_⟩
          rcases Nat.lt_succ_iff_lt_or_eq.mp hk with hk|hk
          · exact hall k hk
          · rw [hk];exact heq
        · right
          obtain ⟨k,hk,hn⟩:=hex
          exact ⟨hf,k,by omega,hn⟩
      · have hb : ((sigma.arrs arr).getD (b1+rho.vars idx) 0==
            (sigma.arrs arr).getD (b2+rho.vars idx) 0)=false := by
          exact beq_eq_false_iff_ne.mpr heq
        refine ⟨rho.setVar flag 0,
          (Run.ite_false (hcond.trans (by rw [hb]))
            (Run.assign (x:=flag) (evalB_lit (by omega : 0<B)))).mono (by simp),
          by simp [hif],by simp [hfc.symm,hcnt],by simp [hf1.symm,ho1],by simp [hf2.symm,ho2],
          by simp [harr],?_⟩
        right
        exact ⟨by simp,rho.vars idx,by omega,heq⟩
    obtain ⟨rho1,hr1,hidx1,hcnt1,ho11,ho21,harr1,hflag1⟩:=hite
    have hinc : (Expr.bin .add (.var idx) (.lit 1)).evalB B rho1=
        some (rho.vars idx+1) := by
      have := evalB_bin (op:=.add) (evalB_var (σ:=rho1) (x:=idx) (B:=B) (by rw [hidx1];omega))
        (evalB_lit (σ:=rho1) (B:=B) (n:=1) (by omega)) (by simp [Bop.apply,hidx1];omega)
      simpa [Bop.apply,hidx1] using this
    refine ⟨rho1.setVar idx (rho.vars idx+1),
      (hr1.seq (Run.assign (x:=idx) hinc)).mono (by simp),?_,?_⟩
    · refine ⟨by simp;omega,by simp [hic.symm,hcnt1],by simp [hi1.symm,ho11],
        by simp [hi2.symm,ho21],by simp [harr1],?_⟩
      simpa [Ne.symm hif] using hflag1
    · show n-(rho1.setVar idx (rho.vars idx+1)).vars idx<n-rho.vars idx
      simp;omega
  have hI : I ((sigma.setVar flag 1).setVar idx 0) := by
    refine ⟨by simp,?_,?_,?_,rfl,?_⟩
    · simp [hic.symm,hfc.symm,hcount]
    · simp [hi1.symm,hf1.symm,h1]
    · simp [hi2.symm,hf2.symm,h2]
    · left;simp [Ne.symm hif]
  obtain ⟨tau,hr,hτ,hfalse⟩:=Run.while_count I V 16 hdef hstep hI
  obtain ⟨hidx,hcnt,-,-,harr,hflag⟩:=hτ
  have ht:=evalB_condLt
    (evalB_var (by omega : tau.vars idx<B))
    (evalB_var (by rw [hcnt];exact hn : tau.vars cnt<B))
  rw [hfalse,hcnt] at ht
  have hiN:tau.vars idx=n:=by
    have hh:¬tau.vars idx<n:=by simpa using ht.symm
    omega
  have hrun:Run B (segEq arr idx cnt o1 o2 flag) sigma tau (20*n+8) := by
    have hh:=(Run.assign (σ:=sigma) (x:=flag) (evalB_lit (by omega : 1<B))).seq
      ((Run.assign (σ:=sigma.setVar flag 1) (x:=idx) (evalB_lit (by omega : 0<B))).seq hr)
    apply hh.mono
    simp [V,Cond.size,Expr.size]
    omega
  refine ⟨tau,hrun,?_,?_,harr,?_,?_,?_⟩
  · rcases hflag with ⟨h,_⟩|⟨h,_⟩
    · exact Or.inr h
    · exact Or.inl h
  · rw [hiN] at hflag
    rcases hflag with ⟨h,hall⟩|⟨h,hex⟩
    · exact ⟨fun _=>hall,fun _=>h⟩
    · constructor
      · intro h';omega
      · intro hall
        obtain ⟨k,hk,hn⟩:=hex
        exact absurd (hall k hk) hn
  · intro x hx hy
    apply (run_frame hrun).1 x
    simp [segEq,segEqBody,scalarWrites,hx,hy]
  · exact (run_frame hrun).2.2.2.1 (by simp [segEq,segEqBody,noRead])
  · exact (run_frame hrun).2.2.2.2 (by simp [segEq,segEqBody,Com.NoWrite])
end Mathproof.Problem18PairBoundaryModeCompare20261004
