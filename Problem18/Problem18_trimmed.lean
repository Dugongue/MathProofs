def FlatSpec (H : RectTensor a b c K) (v : ℕ → K) : Prop :=
  ∀ (k : Fin c) (i : Fin a) (j : Fin b), v (k.val * (a * b) + i.val * b + j.val) = H k (i, j)
theorem matOf_flat (H : RectTensor a b c K) (v : ℕ → K) (h : FlatSpec H v) :
    matOf c (a * b) v = flat H := by
  funext k t
  simp only [matOf, flat, Matrix.submatrix_apply, id]
  have hb : 0 < b := by
    rcases Nat.eq_zero_or_pos b with h0 | h0
    · subst h0; exact absurd t.isLt (by simp)
    · exact h0
  set ij := finProdFinEquiv.symm t with hij
  have ht : t = finProdFinEquiv ij := by rw [hij, Equiv.apply_symm_apply]
  rw [ht, finProdFinEquiv_apply_val, ← h k ij.1 ij.2]
  congr 1
  ring
theorem matOf_aug (w N : ℕ) (s : K) (v : ℕ → K) (M : Matrix (Fin c) (Fin N) K)
    (hM : matOf c N v = M) :
    matOf c (N + w) (augF w N s v) = augM w (s • M) := by
  funext k t
  have hpos : 0 < N + w := Nat.lt_of_le_of_lt (Nat.zero_le _) t.isLt
  have hmod : (k.val * (N + w) + t.val) % (N + w) = t.val := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt t.isLt]
  have hdiv : (k.val * (N + w) + t.val) / (N + w) = k.val := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hpos, Nat.div_eq_of_lt t.isLt, Nat.zero_add]
  simp only [matOf, augF, augM, hmod, hdiv]
  by_cases ht : t.val < N
  · rw [if_pos ht, dif_pos ht, ← hM]
    simp [matOf, Matrix.smul_apply, mul_comm]
  · rw [if_neg ht, dif_neg ht]
theorem gramF_eq (ex N : ℕ) (v : ℕ → K) (M : Matrix (Fin c) (Fin N) K)
    (hM : matOf c N v = M) (s t : Fin N) :
    gramF ex c N v (s.val * N + t.val) = (adjF ex M * M) s t := by
  have hpos : 0 < N := Nat.lt_of_le_of_lt (Nat.zero_le _) t.isLt
  have hmod : (s.val * N + t.val) % N = t.val := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt t.isLt]
  have hdiv : (s.val * N + t.val) / N = s.val := by
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hpos, Nat.div_eq_of_lt t.isLt, Nat.zero_add]
  rw [gramF, hmod, hdiv, Matrix.mul_apply, ← Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro k _
  rw [← hM]
  simp [adjF, matOf]
theorem gram_iff (ex N : ℕ) (d : K) (vH vB : ℕ → K) (H B : Matrix (Fin c) (Fin N) K)
    (hH : matOf c N vH = H) (hB : matOf c N vB = B) :
    (∀ idx < N * N, gramF ex c N vH idx * d = gramF ex c N vB idx) ↔
      d • (adjF ex H * H) = adjF ex B * B := by
  constructor
  · intro h
    funext s t
    have hlt : s.val * N + t.val < N * N := by
      have := Nat.mul_le_mul_right N (Nat.succ_le_of_lt s.isLt)
      rw [Nat.succ_mul] at this; have := t.isLt; omega
    have := h _ hlt
    rw [gramF_eq ex N vH H hH, gramF_eq ex N vB B hB] at this
    simp only [Matrix.smul_apply, smul_eq_mul]
    rw [← this, mul_comm]
  · intro h idx hidx
    have hpos : 0 < N := by
      rcases Nat.eq_zero_or_pos N with h0 | h0
      · subst h0; simp at hidx
      · exact h0
    have hs : idx / N < N := by rw [Nat.div_lt_iff_lt_mul hpos]; exact hidx
    have ht : idx % N < N := Nat.mod_lt _ hpos
    have hidx' : idx = (⟨idx / N, hs⟩ : Fin N).val * N + (⟨idx % N, ht⟩ : Fin N).val := by
      simp [Nat.div_add_mod']
    rw [hidx', gramF_eq ex N vH H hH, gramF_eq ex N vB B hB]
    have := congrFun (congrFun h ⟨idx / N, hs⟩) ⟨idx % N, ht⟩
    simp only [Matrix.smul_apply, smul_eq_mul] at this
    rw [← this, mul_comm]
