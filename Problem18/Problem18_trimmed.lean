noncomputable def framedTraceEquiv :
    (Σ S : Operators g B,Frames g S.val) ≃ (Σ c : Coefficients g,TraceIsometries g B c) where
  toFun s := ⟨frameCoefficients g hm hcop B hB hnB s.1 s.2,
    ⟨s.2.val,frame_trace g hm hcop B hB hnB s.1 s.2⟩⟩
  invFun ce := ⟨traceOperator g hm hcop B ce.1 ce.2,traceFrame g hm hcop B ce.1 ce.2⟩
  left_inv s := by
    have he : traceOperator g hm hcop B (frameCoefficients g hm hcop B hB hnB s.1 s.2)
