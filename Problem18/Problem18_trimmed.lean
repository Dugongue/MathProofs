theorem run_from_compressed (n d B Sn : Nat) (rows : List (DenseInput n d K))
    (σ : Env)
    (hS : Slots F canonical names.q.WS Sn B σ)
    (hz : val F canonical names.q.WS σ 0=0)
    (hN : σ.vars names.q.N=boxSize n d)
    (hcomp : (compress rows).1=
      chosenOf (val F canonical names.q.WS σ) (boxSize n d) (σ.vars cn.cc))
    (hcount : σ.vars cn.cc ≤ boxSize n d)
    (hfit : inStart (boxSize n d) (σ.vars cn.cc) ≤ Sn)
    (hsquare : 5+boxSize n d*boxSize n d ≤ Sn)
    (hNB : boxSize n d<B) :
    ∃τ,Run B (program F n d) σ τ (cost F n d (σ.vars cn.cc)) ∧
      Slots F canonical names.q.WS Sn B τ ∧
      (∀r:Fin (boxSize n d),∀j:Fin (boxSize n d),
        val F canonical names.q.WS τ
          (5+r.val*boxSize n d+j.val)=rowData n d rows r j) ∧
      (∀i:Fin (boxSize n d*boxSize n d),
        val F canonical names.q.WS τ (5+i.val)=flatData (rowData n d rows) i) ∧
      val F canonical names.q.WS τ 0=0 ∧
      τ.inp=σ.inp ∧ τ.out=σ.out ∧ τ.vars cn.cc=σ.vars cn.cc ∧
      (∀s<Sn,inStart (boxSize n d) (boxSize n d) ≤ s →
        val F canonical names.q.WS τ s=val F canonical names.q.WS σ s) := by
  let N:=boxSize n d
  let c:=σ.vars cn.cc
