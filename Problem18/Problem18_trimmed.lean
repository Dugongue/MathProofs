    (.ite (.eq (.var rTReg) (.lit 1))
      (.seq (.assign cntR (ex cntSize)) <| .seq (.assign o1R (ex o1Size)) <|
        .seq (.assign o2R (ex o2Size)) <|
        .seq (segEq pairBank idxR cntR o1R o2R flagR) (.assign modeResult (.var flagR)))
      .skip)
def unitaryCost (n e : Nat) : Nat :=
