theorem preserves_inf {H : Module.End K V} {U W : Submodule K V}
    (hU : Preserves U H) (hW : Preserves W H) : Preserves (U ⊓ W) H :=
  fun x hx => ⟨hU x hx.1,hW x hx.2⟩
theorem preserves_orthogonal (σ : K →+* K)
    (B : V →ₛₗ[σ] V →ₗ[K] K) (H : Module.End K V)
    (hH : ∀ x y, B (H x) y=B x (H y)) (W : Submodule K V)
    (hW : Preserves W H) : Preserves (W.orthogonalBilin B) H := by
  intro x hx w hw
  rw [← hH]
  exact hx (H w) (hW w hw)
theorem exists_minimal_dichotomy (σ : K →+* K)
    (B : V →ₛₗ[σ] V →ₗ[K] K) (H T : Module.End K V)
    (hH : ∀ x y, B (H x) y=B x (H y))
    (hT : ∀ x y, B (T x) y=B x (T y))
    (U : Submodule K V) (hU : U≠⊥) (hUH : Preserves U H) (hUT : Preserves U T) :
    ∃ W : Submodule K V, W≠⊥ ∧ W≤U ∧ Preserves W H ∧ Preserves W T ∧
      (W ⊓ W.orthogonalBilin B=⊥ ∨ W≤W.orthogonalBilin B) := by
  classical
  let P (k : ℕ) := ∃ W : Submodule K V,
    W≠⊥ ∧ W≤U ∧ Preserves W H ∧ Preserves W T ∧ finrank K W=k
  have hex : ∃ k, P k := ⟨finrank K U,U,hU,le_rfl,hUH,hUT,rfl⟩
  obtain ⟨W,hW,hWU,hWH,hWT,hk⟩ := Nat.find_spec hex
  refine ⟨W,hW,hWU,hWH,hWT,?_⟩
  by_cases hz : W ⊓ W.orthogonalBilin B=⊥
  · exact Or.inl hz
  · right
    have hR : P (finrank K ↥(W ⊓ W.orthogonalBilin B)) :=
      ⟨_,hz,inf_le_left.trans hWU,
        preserves_inf hWH (preserves_orthogonal σ B H hH W hWH),
        preserves_inf hWT (preserves_orthogonal σ B T hT W hWT),rfl⟩
    have hdim := Nat.find_min' hex hR
    have he : W ⊓ W.orthogonalBilin B=W :=
      Submodule.eq_of_le_of_finrank_le inf_le_left (hk ▸ hdim)
    exact (inf_eq_left.mp he)
theorem bilinear_small_witness (B : LinearMap.BilinForm K V) (hB : B.Nondegenerate)
    (H T : Module.End K V)
    (hH : ∀ x y, B (H x) y=B x (H y))
    (hT : ∀ x y, B (T x) y=B x (T y))
    (U : Submodule K V) (hU : U≠⊥) (hUp : U≠⊤)
    (hUH : Preserves U H) (hUT : Preserves U T) :
    ∃ W : Submodule K V, W≠⊥ ∧ 2*finrank K W≤finrank K V ∧
      Preserves W H ∧ Preserves W T ∧
      (W ⊓ B.orthogonal W=⊥ ∨ W≤B.orthogonal W) := by
  have hs : ∃ L : Submodule K V, L≠⊥ ∧ 2*finrank K L≤finrank K V ∧
      Preserves L H ∧ Preserves L T := by
    by_cases hk : 2*finrank K U≤finrank K V
    · exact ⟨U,hU,hk,hUH,hUT⟩
    · refine ⟨B.orthogonal U,?_,?_,
        preserves_orthogonal (RingHom.id K) B H hH U hUH,
        preserves_orthogonal (RingHom.id K) B T hT U hUT⟩
      · intro hz
        have hd := B.finrank_orthogonal hB U
        rw [hz,finrank_bot] at hd
