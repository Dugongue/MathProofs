variable {K V W : Type*} [Field K] [AddCommGroup V] [Module K V]
  [AddCommGroup W] [Module K W] [FiniteDimensional K V] [FiniteDimensional K W]
  (σ : K ≃+* K)
set_option backward.isDefEq.respectTransparency false
local instance [Finite V] : Finite (Module.End K V) := Finite.of_injective
  (fun A : Module.End K V => (A : V → V)) DFunLike.coe_injective
local instance [Finite V] [Finite W] : Finite (Module.End K (V × W)) := Finite.of_injective
  (fun A : Module.End K (V × W) => (A : V × W → V × W)) DFunLike.coe_injective
local instance [Finite V] [Finite W] : Finite (V →ₗ[K] V × W) := Finite.of_injective
  (fun j : V →ₗ[K] V × W => (j : V → V × W)) DFunLike.coe_injective
abbrev SourceOperators (B : Form σ V) (f : K[X]) :=
  {A : SelfAdjointOperators σ B // A.val.charpoly=f}
abbrev JointOperators (B : Form σ V) (C : Form σ W) (f : K[X]) :=
  {T : SelfAdjointOperators σ (sumForm σ B C) //
    IsCoprime f (T.val.charpoly/f) ∧ Nonempty (SpectralMarkings σ B C f T)}
abbrev Incidences (B : Form σ V) (C : Form σ W) (f : K[X]) :=
  (A : SourceOperators σ B f) × ConditionedMarked σ B C A.val (IsCoprime f)
noncomputable def incidenceEquiv (B : Form σ V) (C : Form σ W) (f : K[X]) :
    Incidences σ B C f ≃
      ((T : JointOperators σ B C f) × SpectralMarkings σ B C f T.val) where
  toFun N :=
    let M : SpectralMarkings σ B C f N.2.2.val.val :=
      ⟨N.2.1,⟨N.1.val,N.1.property,N.2.2.val.property⟩⟩
    ⟨⟨N.2.2.val.val,by
      constructor
      · simpa only [N.1.property] using N.2.2.property
      · exact ⟨M⟩⟩,M⟩
  invFun N :=
    ⟨⟨N.2.2.val,N.2.2.property.1⟩,N.2.1,⟨⟨N.1.val,N.2.2.property.2⟩,by
      simpa only [N.2.2.property.1] using N.1.property.1⟩⟩
  left_inv := fun _ => rfl
  right_inv := fun _ => rfl
theorem incidences_card [Finite V] [Finite W]
    (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft) (f : K[X]) :
    Nat.card (Incidences σ B C f)=Nat.card (SourceOperators σ B f)*
      (Nat.card (EmbeddingOrbit σ B C)*
        Nat.card {D : SelfAdjointOperators σ C // IsCoprime f D.val.charpoly}) := by
  letI : Finite (Module.End K V) := Finite.of_injective
    (fun A : Module.End K V => (A : V → V)) DFunLike.coe_injective
  letI : Fintype (SourceOperators σ B f) := Fintype.ofFinite _
  rw [Incidences,Nat.card_sigma]
  simp_rw [conditioned_marked_card σ B C hB _ (IsCoprime f)]
  simp only [Finset.sum_const,Finset.card_univ,smul_eq_mul,Nat.card_eq_fintype_card]
theorem incidences_card_unmarked [Finite V] [Finite W]
    (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft) (f : K[X]) :
    Nat.card (Incidences σ B C f)=
      Nat.card (JointOperators σ B C f)*Nat.card (Isometries σ B) := by
  letI : Finite (Module.End K (V × W)) := Finite.of_injective
    (fun T : Module.End K (V × W) => (T : V × W → V × W)) DFunLike.coe_injective
  letI : Fintype (JointOperators σ B C f) := Fintype.ofFinite _
  rw [Nat.card_congr (incidenceEquiv σ B C f),Nat.card_sigma]
  have h (T : JointOperators σ B C f) :
      Nat.card (SpectralMarkings σ B C f T.val)=Nat.card (Isometries σ B) :=
    spectral_markings_card σ B C hB f T.val T.property.1 (Classical.choice T.property.2)
  simp_rw [h]
  simp only [Finset.sum_const,Finset.card_univ,smul_eq_mul,Nat.card_eq_fintype_card]
