def allFuns (c : ℕ) : (k : ℕ) → List (Fin k → Fin c)
  | 0 => [Fin.elim0]
  | k+1 => (allFuns c k).flatMap fun f => (List.finRange c).map fun a => Fin.cons a f
theorem mem_allFuns (c : ℕ) : ∀ (k : ℕ) (f : Fin k → Fin c), f ∈ allFuns c k := by
  intro k
  induction k with
  | zero =>
    intro f
    simp only [allFuns, List.mem_singleton]
    funext i
    exact i.elim0
  | succ k ih =>
    intro f
    simp only [allFuns, List.mem_flatMap, List.mem_map, List.mem_finRange, true_and]
    exact ⟨Fin.tail f, ih _, f 0, Fin.cons_self_tail f⟩
def patterns (c : ℕ) : List (Σ k : ℕ, Fin k → Fin c) :=
