  change (A*B).rank + _ = B.rank at hi
  change A.rank + _ = _ at hker
  simp only [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] at hker
  omega
theorem gram_rank_lower {n r : ℕ}
    (X : Matrix (Fin n) (Fin r) K) (J : Matrix (Fin r) (Fin r) K)
