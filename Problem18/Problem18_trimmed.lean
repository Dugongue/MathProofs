  let e := e.consumeMData
  if e.isRawNatLit then return s
  match e.getAppFnArgs with
  | (``OfNat.ofNat, _) => return s
  | (``HAdd.hAdd, #[_, _, _, _, a, b]) => do collect b (← collect a s)
  | (``HSub.hSub, #[_, _, _, _, a, b]) => do collect b (← collect a s)
  | (``HMul.hMul, #[_, _, _, _, a, b]) => do collect b (← collect a s)
  | (``HDiv.hDiv, #[_, _, _, _, a, b]) => do collect b (← collect a s)
  | (``HMod.hMod, #[_, _, _, _, a, b]) => do collect b (← collect a s)
  | (``Min.min, #[_, _, a, b]) => do collect b (← collect a (s.insert e))
  | (``Max.max, #[_, _, a, b]) => do collect b (← collect a (s.insert e))
  | (``HPow.hPow, #[_, _, _, _, a, b]) => do collect b (← collect a (s.insert e))
  | (``Nat.cast, #[_, _, a]) => collect a s
  | (``Int.ofNat, #[a]) => collect a s
  | (``Nat.succ, #[a]) => collect a s
  | (``Neg.neg, #[_, _, a]) => collect a s
  | (``Int.toNat, #[a]) => collect a (s.insert e)
  | (``Int.natAbs, #[a]) => collect a (s.insert e)
  | _ => return s.insert e
def factAtomsAux : Nat → Expr → MetaM (Option (Std.HashSet Expr))
  | 0, _ => return none
  | fuel + 1, t => do
  let factAtoms := factAtomsAux fuel
  let collect := collect 100000
  let t := (← instantiateMVars t).consumeMData
  let rel (ty a b : Expr) : MetaM (Option (Std.HashSet Expr)) := do
    if ← isIntNat ty then return some (← collect b (← collect a {})) else return none
  let both (p q : Expr) : MetaM (Option (Std.HashSet Expr)) := do
    let some x ← factAtoms p | return none
    let some y ← factAtoms q | return none
    return some (y.fold (fun acc a => acc.insert a) x)
  match t.getAppFnArgs with
  | (``Eq, #[ty, a, b]) => rel ty a b
  | (``Ne, #[ty, a, b]) => rel ty a b
  | (``LE.le, #[ty, _, a, b]) => rel ty a b
  | (``LT.lt, #[ty, _, a, b]) => rel ty a b
  | (``GE.ge, #[ty, _, a, b]) => rel ty a b
  | (``GT.gt, #[ty, _, a, b]) => rel ty a b
  | (``Dvd.dvd, #[ty, _, a, b]) => rel ty a b
  | (``Not, #[p]) => factAtoms p
  | (``And, #[p, q]) => both p q
  | (``Or, #[p, q]) => both p q
  | (``Iff, #[p, q]) => both p q
  | (``False, _) => return some {}
  | _ =>
    match t with
    | .forallE _ d b _ =>
      if !b.hasLooseBVars && (← isProp d) && (← isProp b) then both d b else return none
    | _ => return none
def factAtoms (t : Expr) : MetaM (Option (Std.HashSet Expr)) := factAtomsAux 1000 t
def prune (g : MVarId) : MetaM MVarId := g.withContext do
  let tgt ← instantiateMVars (← g.getType)
  let goalAtoms := (← factAtoms tgt).getD {}
  let mut facts : Array (FVarId × Std.HashSet Expr) := #[]
  let mut drop : Array FVarId := #[]
  for d in ← getLCtx do
    if d.isImplementationDetail then continue
    let ty ← instantiateMVars d.type
    if ← isProp ty then
      match ← factAtoms ty with
      | some s => facts := facts.push (d.fvarId, s)
      | none => drop := drop.push d.fvarId
  let mut alive := facts
  repeat
    let mut cnt : Std.HashMap Expr Nat := {}
    for (_, s) in alive do
      for a in s do
        cnt := cnt.insert a (cnt.getD a 0 + 1)
    let keep := alive.filter fun (_, s) =>
      s.toList.all fun a => goalAtoms.contains a || cnt.getD a 0 ≥ 2
    if keep.size == alive.size then break
    for (f, _) in alive do
      unless keep.any (·.1 == f) do drop := drop.push f
    alive := keep
  g.tryClearMany drop
elab "pomega_prune" : tactic => do
  let g ← getMainGoal
  replaceMainGoal [← prune g]
macro "pomega" : tactic => `(tactic| first | (pomega_prune; omega) | omega)
end Mathproof.SlimOmega20261005
end
