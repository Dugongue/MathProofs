  rw [←Problem18P34Frontend20261003FiniteSystem.equivalence]
  constructor
  · rintro ⟨x,hx⟩
    refine ⟨x ∘ Fintype.equivFin (OuterVar a b),?_⟩
    apply (finite_zeros F G h _).mp
    simpa [Function.comp_def] using hx
  · rintro ⟨x,hx⟩
    exact ⟨x ∘ (Fintype.equivFin (OuterVar a b)).symm,(finite_zeros F G h x).mpr hx⟩
