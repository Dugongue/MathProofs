  have hs := finite_field_subspace_count_bound_four (K := K) n r hr
  have hc := SymMatCard.natCard_symm (n := r) (K := K)
  have hb := symmetric_rank_card_le_subspaces (K := K) n r
  rw [hc] at hb
  have hbNat : (Nat.card {A : SymMat n K // A.val.rank = r} : ℝ) ≤
      (Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = r} : ℝ) *
        (Nat.card K : ℝ) ^ ((r + 1).choose 2) := by
    exact_mod_cast hb
  have hb' : (Nat.card {A : SymMat n K // A.val.rank = r} : ℝ) ≤
      (Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = r} : ℝ) *
        (Fintype.card K : ℝ) ^ ((r + 1).choose 2) := by
    simpa only [Nat.card_eq_fintype_card] using hbNat
  calc
    _ ≤ (Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = r} : ℝ) *
        (Fintype.card K : ℝ) ^ ((r + 1).choose 2) := hb'
    _ ≤ (4 * (Fintype.card K : ℝ) ^ (r * (n-r))) *
        (Fintype.card K : ℝ) ^ ((r+1).choose 2) :=
      mul_le_mul_of_nonneg_right hs (by positivity)
    _ = _ := by rw [mul_assoc, ← pow_add]
