theorem regular_marking_of_subspace
    (hcard : Nat.card K=Nat.card F^2) (hstar : ∀ a : K,star a=a^Nat.card F)
    (B : V →ₗ⋆[K] V →ₗ[K] K) (C : W →ₗ⋆[K] W →ₗ[K] K)
    (hB : B.IsSymm) (hnB : B.Nondegenerate) (hC : C.IsSymm) (hnC : C.Nondegenerate)
    (hsA : (sumForm (starRingAut : K ≃+* K) B C).IsSymm)
    (hnA : (sumForm (starRingAut : K ≃+* K) B C).Nondegenerate)
    (f : K[X]) (hd : Module.finrank K V=f.natDegree)
    (T : SelfAdjointOperators (starRingAut : K ≃+* K) (sumForm (starRingAut : K ≃+* K) B C))
    (U : Submodule K (V×W)) (hU : Preserves U T.val)
    (hnU : ((sumForm (starRingAut : K ≃+* K) B C).domRestrict₁₂ U U).SeparatingLeft)
    (hR : (T.val.restrict hU).charpoly=f) :
    Nonempty (SpectralMarkings (starRingAut : K ≃+* K) B C f T) := by
  let σ : K ≃+* K := starRingAut
  let A := sumForm σ B C
  let Z := U.orthogonalBilin A
  have hcomp : IsCompl U Z := Problem18HermitianRegularWitt20260929.regular_isCompl
    hcard hstar A hsA U hnU
  have hnZ : (A.domRestrict₁₂ Z Z).SeparatingLeft :=
    Problem18HermitianRegularWitt20260929.orthogonal_restrict_separatingLeft A hsA hnA.1 U hcomp
  let R := T.val.restrict hU
  have hdU : Module.finrank K V=Module.finrank K U := by
    rw [hd,←hR,LinearMap.charpoly_natDegree]
  have hdZ : Module.finrank K W=Module.finrank K Z := by
    have hh := (Submodule.prodEquivOfIsCompl U Z hcomp).finrank_eq
    rw [Module.finrank_prod,Module.finrank_prod,←hdU] at hh
    omega
  obtain ⟨e,he⟩ := Problem18HermitianRegularWitt20260929.exists_isometry_equiv_of_finrank_eq
    hcard hstar B (A.domRestrict₁₂ U U) hB (hsA.domRestrict U) hnB.1 hnU hdU
  obtain ⟨k,hk⟩ := Problem18HermitianRegularWitt20260929.exists_isometry_equiv_of_finrank_eq
    hcard hstar C (A.domRestrict₁₂ Z Z) hC (hsA.domRestrict Z) hnC.1 hnZ hdZ
  let E := Submodule.prodEquivOfIsCompl U Z hcomp
  have hE (x y : U×Z) : A (E x) (E y)=A x.1.val y.1.val+A x.2.val y.2.val := by
    change A (x.1.val+x.2.val) (y.1.val+y.2.val)=_
    have hfg : A x.1.val y.2.val=0 := y.2.property x.1.val x.1.property
    have hgf' : A x.2.val y.1.val=0 := hsA.isRefl.eq_zero (x.2.property y.1.val y.1.property)
    simp only [map_add,LinearMap.add_apply,hfg,hgf',add_zero,zero_add]
  let Q : Isometries σ A := ⟨(e.prodCongr k).trans E,by
    intro x y
    rw [LinearEquiv.trans_apply,LinearEquiv.trans_apply,hE]
    exact congrArg₂ (·+·) (he x.1 y.1) (hk x.2 y.2)⟩
  let S : SelfAdjointOperators σ B := ⟨e.symm.conj R,by
    intro x y
    rw [←he,←he]
    change A ((e (e.symm (R (e x)))):V×W) (e y) =
      A (e x) ((e (e.symm (R (e y)))):V×W)
    rw [e.apply_symm_apply,e.apply_symm_apply]
    exact T.property (e x) (e y)⟩
  let j := restrictionToOrbit σ B C Q
  refine ⟨⟨j,⟨S,?_,?_⟩⟩⟩
  · change (e.symm.conj R).charpoly=f
    rw [LinearEquiv.charpoly_conj,hR]
  · intro x
    have hj (z : V) : j.val z=(e z).val := by
      change E (e z,k 0)=(e z).val
      rw [map_zero]
      change (e z).val+0=(e z).val
      exact add_zero _
    rw [hj,hj]
    change T.val (e x).val=(e (e.symm (R (e x)))).val
    rw [e.apply_symm_apply]
    rfl
end
end Mathproof.Problem18HermitianRegularMarking20261001
