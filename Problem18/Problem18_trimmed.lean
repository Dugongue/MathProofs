variable {K : Type} [Field K] [Fintype K] [DecidableEq K]
def parameterCount {n d : Nat} (pc : Cand n d) : Nat :=
  pc.1.1 * childBox n d + 1
def pointSystem (n d : Nat) (a : Fin (boxSize n d * boxSize n d) → K)
    (pc : Cand n d) :
    List (DenseInput (parameterCount pc)
      (frobeniusDegree (parameterCount pc) (clauseDeg pc.2)) K) :=
  frobeniusSystem (Fintype.card K) (clauseDeg pc.2)
    ((clauseRows pc.2 a).map Prod.fst)
def program (n d : Nat) (a : Fin (boxSize n d * boxSize n d) → K)
    (pc : Cand n d) : Com :=
  Problem18ConcretePointLoop20261002.program (parameterCount pc)
    (frobeniusDegree (parameterCount pc) (clauseDeg pc.2))
    (pointSystem n d a pc).length (parameterCount pc)
variable (F : FieldPresentation K)
def cost (n d : Nat) (a : Fin (boxSize n d * boxSize n d) → K)
    (pc : Cand n d) : Nat :=
  parameterCount pc * Problem18ConcretePointStep20261002.cost F
    (parameterCount pc)
    (frobeniusDegree (parameterCount pc) (clauseDeg pc.2))
    (pointSystem n d a pc).length + 1
def extracted (n d : Nat) (a : Fin (boxSize n d * boxSize n d) → K)
    (pc : Cand n d) (τ : Env) : Fin (pc.1.1 * childBox n d) → K :=
  fun i => val F canonical names.q.WS τ
    (outBase (parameterCount pc)
      (frobeniusDegree (parameterCount pc) (clauseDeg pc.2))
      (pointSystem n d a pc).length + i.val)
def polynomialCost (n d : Nat) (a : Fin (boxSize n d * boxSize n d) → K)
    (pc : Cand n d) : Nat :=
  Problem18IMPConcreteEliminationBounds20261001.macroBudget F *
    Problem18ConcretePointLoop20261002.coefficient (parameterCount pc)
      (frobeniusDegree (parameterCount pc) (clauseDeg pc.2))
      (pointSystem n d a pc).length
theorem selected_candidate_run_bounded (n d B : Nat)
    (a : Fin (boxSize n d * boxSize n d) → K) (pc : Cand n d) (σ : Env)
    (h : Input F (parameterCount pc)
      (frobeniusDegree (parameterCount pc) (clauseDeg pc.2)) B
      (pointSystem n d a pc) σ) :
    ∃ τ, Run B (program n d a pc) σ τ (polynomialCost F n d a pc) ∧
      Input F (parameterCount pc)
        (frobeniusDegree (parameterCount pc) (clauseDeg pc.2)) B
        (pointSystem n d a pc) τ ∧
      (childFrom n d a pc).1 = childRowsOf pc.1.1 (extracted F n d a pc τ) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  obtain ⟨τ,hr,hτ,hv,hi,ho⟩ :=
    Problem18ConcretePointLoop20261002.run_bounded F (parameterCount pc)
      (frobeniusDegree (parameterCount pc) (clauseDeg pc.2)) B
      (pointSystem n d a pc) σ h
  refine ⟨τ,?_,hτ,?_,hi,ho⟩
  · simpa only [program,polynomialCost] using hr
  · unfold childFrom
    simp only
    apply congrArg (childRowsOf pc.1.1)
    funext i
    have hh := hv (Fin.castSucc i)
    have hic : (Fin.castSucc i).val = i.val := rfl
    rw [hic] at hh
    change coordValue _ _ (Fin.castSucc i) =
      val F canonical names.q.WS τ (_ + i.val)
    simpa only [parameterCount, pointSystem] using hh.symm
theorem selected_child_run_bounded (n d B : Nat)
    (rows : List (DenseInput n d K)) (pc : Cand n d)
    (hfind : (childCands n d).find? (fun pc =>
      (candRun n d (flatData (rowData n d rows)) pc).1) = some pc)
    (σ : Env)
    (h : Input F (parameterCount pc)
      (frobeniusDegree (parameterCount pc) (clauseDeg pc.2)) B
      (pointSystem n d (flatData (rowData n d rows)) pc) σ) :
    ∃ τ, Run B (program n d (flatData (rowData n d rows)) pc) σ τ
        (polynomialCost F n d (flatData (rowData n d rows)) pc) ∧
      Input F (parameterCount pc)
        (frobeniusDegree (parameterCount pc) (clauseDeg pc.2)) B
        (pointSystem n d (flatData (rowData n d rows)) pc) τ ∧
      (child n d rows).1 =
        childRowsOf pc.1.1
          (extracted F n d (flatData (rowData n d rows)) pc τ) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  obtain ⟨τ,hr,hτ,hrows,hi,ho⟩ := selected_candidate_run_bounded F n d B
    (flatData (rowData n d rows)) pc σ h
  refine ⟨τ,hr,hτ,?_,hi,ho⟩
  rw [show (child n d rows).1 =
      (childFrom n d (flatData (rowData n d rows)) pc).1 by
    simp only [child,hfind]]
  exact hrows
end
