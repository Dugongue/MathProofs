variable {K : Type} [Field K] [Fintype K] [BEq K] [LawfulBEq K] [DecidableEq K]
structure BoundaryAfterModulus (F : FieldPresentation K) (B a b c : Nat)
    (u : Bool) (q : Nat) (A : RectTensor a b c K)
    (sigma rho : Env) : Prop where
  run : Run B modulusCopy sigma rho (20*F.e+13)
  externalValid : ValidMemory F B (externalState rho)
  externalSlots : Slots F canonical
    Problem18IMPBoundaryPhaseState20261002.workspaceName 0 B (externalState rho)
  modBase : (externalState rho).vars canonical.modBase=0
  external_length : ((externalState rho).arrs canonical.mem).length=
    (sigma.arrs workBank).length
  native_memory : rho.arrs canonical.mem=sigma.arrs canonical.mem
  loaded : (parameters 0 (sortOrder a b c) a b c F.e).loaded (externalState rho)
  bounded : (parameters 0 (sortOrder a b c) a b c F.e).bounded B
  total : (externalState rho).vars Problem18IMPTensorGather20261002.total=
    a*b*c*F.e
  tensor_fit : a*b*c*F.e≤((externalState rho).arrs tensorBank).length
  tensor_word : ((externalState rho).arrs tensorBank).length<B
  tensor_coefficients : ∀x<((externalState rho).arrs tensorBank).length,
    ((externalState rho).arrs tensorBank).getD x 0<F.p
  tensor_value : ∀x<a*b*c*F.e,
    ((externalState rho).arrs tensorBank).getD x 0=
      (tensorCoordinates F A).getD x 0
  cols : rho.vars Problem18IMPTensorGather20261002.cols=boundaryWidth a b c
  dimC : rho.vars Problem18P36LargeCovariantController20261003.dimC=
    boundaryHeight a b c
  unitary : rho.vars "u"=u.toNat
  exponent : rho.vars "q"=q
  exp_word : rho.vars canonical.exp<B
  input : rho.inp=sigma.inp
  output : rho.out=sigma.out
theorem boundary_modulus_run (F : FieldPresentation K)
    {B a b c : Nat} {u : Bool} {q : Nat} {A : RectTensor a b c K}
    (sigma : Env) (h : BoundaryInput F B a b c u q A sigma) :
    ∃rho, BoundaryAfterModulus F B a b c u q A sigma rho := by
  have hm : ModulusCopyInput F B sigma := {
    nativeValid:=h.nativeValid
    modBase_zero:=h.modBase_zero
    work_word:=h.work_word
    work_fit:=by
      have hh:=h.work_fit
      unfold gramScratchBase gramBase gatheredBase poweredBase plainBase
        rectangularCells at hh
      omega
    work_coefficients:=h.work_coefficients }
  obtain ⟨rho,hr,hvalid,hextlen,hnative,harrays,hvars,hi,ho⟩:=
    modulusCopy_run F sigma hm
  have hkeep (x : String) (h1 : x≠copyIndex) (h2 : x≠copyCount)
      (h3 : x≠externalBase) (h4 : x≠nativeBase) :
      rho.vars x=sigma.vars x := hvars x h1 h2 h3 h4
  have hscratchLen : ((externalState rho).arrs canonical.scratch).length=
      (sigma.arrs canonical.scratch).length := by
    change (rho.arrs canonical.scratch).length=(sigma.arrs canonical.scratch).length
    rw [harrays canonical.scratch (by decide)]
  have hws : (externalState rho).vars
      Problem18IMPBoundaryPhaseState20261002.workspaceName=F.e+1 := by
    exact (hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h.workspace_eq
  have hmod : (externalState rho).vars canonical.modBase=0 := by
    exact (hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h.modBase_zero
  have hexp : (externalState rho).vars canonical.exp<B := by
    change rho.vars canonical.exp<B
    rw [hkeep _ (by decide) (by decide) (by decide) (by decide)]
    exact h.exponent_word
  have hzero : Slots F canonical
      Problem18IMPBoundaryPhaseState20261002.workspaceName 0 B
      (externalState rho) := by
    apply zeroSlots F (externalState rho) hvalid (by
      rw [hmod,hextlen]
      have hh:=h.work_fit
      unfold gramScratchBase gramBase gatheredBase poweredBase plainBase
        rectangularCells at hh
      omega) (by decide)
    · rw [hws,hextlen]
      have hh:=h.work_fit
      unfold gramScratchBase gramBase gatheredBase poweredBase plainBase
        rectangularCells at hh
      omega
    · rw [hmod,hws]
      omega
    · rw [hscratchLen]
      exact h.nativeSlots.base.scratch_fit
    · exact hexp
  have htensor : (externalState rho).arrs tensorBank=
      (externalState sigma).arrs tensorBank := by
    change rho.arrs tensorBank=sigma.arrs tensorBank
    exact harrays tensorBank (by decide)
  have hloaded : (parameters 0 (sortOrder a b c) a b c F.e).loaded
      (externalState rho) := by
    rcases h.gather_loaded with ⟨h0,h1,h2,h3,h4,h5,h6⟩
    refine ⟨?_,?_,?_,?_,?_,?_,?_⟩
    all_goals
      first
      | exact (hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h0
      | exact (hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h1
      | exact (hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h2
      | exact (hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h3
      | exact (hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h4
      | exact (hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h5
      | exact (hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h6
  refine ⟨rho,{
    run:=hr
    externalValid:=hvalid
    externalSlots:=hzero
    modBase:=hmod
    external_length:=hextlen
    native_memory:=hnative
    loaded:=hloaded
    bounded:=h.gather_bounded
    total:=(hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h.total_eq
    tensor_fit:=by rw [htensor];exact h.tensor_fit
    tensor_word:=by rw [htensor];exact h.tensor_word
    tensor_coefficients:=by
      intro x hx
      rw [htensor]
      exact h.tensor_coefficients x (by rw [←htensor];exact hx)
    tensor_value:=by
      intro x hx
      rw [htensor]
      exact h.tensor_value x hx
    cols:=(hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h.cols_eq
    dimC:=(hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h.dimC_eq
    unitary:=(hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h.unitary_reg
    exponent:=(hkeep _ (by decide) (by decide) (by decide) (by decide)).trans h.q_reg
    exp_word:=hexp
    input:=hi
    output:=ho }⟩
end Mathproof.Problem18P36BoundaryRoutedController20261003
