end Raw
@[inline] def fastMulImpl [BEq R] [LawfulBEq R]
    (P : Plan R) (p q : CPolynomial R) : CPolynomial R :=
  let raw := Raw.fastMulImpl P p.val q.val
  ⟨raw.trim, CPolynomial.Raw.Trim.isCanonical_trim raw⟩
end Plan
end NTTFast
end CPolynomial
