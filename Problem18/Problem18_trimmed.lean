section Connectives
variable {R : Type*} [CommRing R] {L : Type*} [Field L] (f : R →+* L)
def fTrue {m : ℕ} : Formula R m := .neg .falsum
def fAnd {m : ℕ} (φ ψ : Formula R m) : Formula R m := .neg (.disj (.neg φ) (.neg ψ))
def fOr {m : ℕ} (φ ψ : Formula R m) : Formula R m := .disj φ ψ
def fImp {m : ℕ} (φ ψ : Formula R m) : Formula R m := .disj (.neg φ) ψ
def fAll {m : ℕ} (φ : Formula R (m+1)) : Formula R m := .neg (.ex (.neg φ))
def fEq {m : ℕ} (p : PolyExpr (Fin m) R) : Formula R m := .zero p
def fNe {m : ℕ} (p : PolyExpr (Fin m) R) : Formula R m := .neg (.zero p)
def fConj {m : ℕ} : List (Formula R m) → Formula R m
  | [] => fTrue
  | φ :: l => fAnd φ (fConj l)
theorem holds_true {m : ℕ} (x : Fin m → L) : (fTrue : Formula R m).Holds f x := by
  simp only [fTrue, Formula.Holds, not_false_eq_true]
theorem holds_and {m : ℕ} (φ ψ : Formula R m) (x : Fin m → L) :
    (fAnd φ ψ).Holds f x ↔ φ.Holds f x ∧ ψ.Holds f x := by
  simp only [fAnd, Formula.Holds]
  tauto
theorem holds_or {m : ℕ} (φ ψ : Formula R m) (x : Fin m → L) :
    (fOr φ ψ).Holds f x ↔ φ.Holds f x ∨ ψ.Holds f x := by
  simp only [fOr, Formula.Holds]
theorem holds_imp {m : ℕ} (φ ψ : Formula R m) (x : Fin m → L) :
    (fImp φ ψ).Holds f x ↔ (φ.Holds f x → ψ.Holds f x) := by
  simp only [fImp, Formula.Holds]
  tauto
theorem holds_all {m : ℕ} (φ : Formula R (m+1)) (x : Fin m → L) :
    (fAll φ).Holds f x ↔ ∀ a : L, φ.Holds f (Fin.cons a x) := by
  simp only [fAll, Formula.Holds, not_exists, not_not]
theorem holds_eq {m : ℕ} (p : PolyExpr (Fin m) R) (x : Fin m → L) :
    (fEq p).Holds f x ↔ interpret f x p = 0 := by
  simp only [fEq, Formula.Holds]
theorem holds_ne {m : ℕ} (p : PolyExpr (Fin m) R) (x : Fin m → L) :
    (fNe p).Holds f x ↔ interpret f x p ≠ 0 := by
  simp only [fNe, Formula.Holds]
theorem holds_conj {m : ℕ} (l : List (Formula R m)) (x : Fin m → L) :
    (fConj l).Holds f x ↔ ∀ φ ∈ l, φ.Holds f x := by
  induction l with
  | nil => simp only [fConj, List.not_mem_nil, false_imp_iff, implies_true, iff_true]
           exact holds_true f x
  | cons φ l ih => simp only [fConj, holds_and, ih, List.mem_cons, forall_eq_or_imp]
theorem holds_conj_ofFn {m k : ℕ} (g : Fin k → Formula R m) (x : Fin m → L) :
    (fConj (List.ofFn g)).Holds f x ↔ ∀ i, (g i).Holds f x := by
  rw [holds_conj]
  simp only [List.mem_ofFn, forall_exists_index, forall_apply_eq_imp_iff]
end Connectives
section Blocks
variable {R : Type*} [CommRing R] {L : Type*} [Field L] (f : R →+* L)
def extEnv {m : ℕ} (x : Fin m → L) : (k : ℕ) → (Fin k → L) → Fin (m + k) → L
  | 0, _ => x
  | k+1, y => Fin.cons (y (Fin.last k)) (extEnv x k (Fin.init y))
def exBlock {m : ℕ} : (k : ℕ) → Formula R (m + k) → Formula R m
  | 0, φ => φ
  | k+1, φ => exBlock k (.ex φ)
def allBlock {m : ℕ} : (k : ℕ) → Formula R (m + k) → Formula R m
  | 0, φ => φ
  | k+1, φ => allBlock k (fAll φ)
def oldIdx {m : ℕ} : (k : ℕ) → Fin m → Fin (m + k)
  | 0, i => i
  | k+1, i => (oldIdx k i).succ
def newIdx {m : ℕ} : (k : ℕ) → Fin k → Fin (m + k)
  | 0, j => j.elim0
  | k+1, j => if h : (j : ℕ) = k then ⟨0, Nat.succ_pos _⟩ else (newIdx k ⟨j, by omega⟩).succ
theorem extEnv_oldIdx {m : ℕ} (x : Fin m → L) :
    ∀ (k : ℕ) (y : Fin k → L) (i : Fin m), extEnv x k y (oldIdx k i) = x i := by
  intro k
  induction k with
  | zero => intro y i; rfl
  | succ k ih =>
    intro y i
    simp only [extEnv, oldIdx, Fin.cons_succ]
    exact ih _ i
theorem extEnv_newIdx {m : ℕ} (x : Fin m → L) :
    ∀ (k : ℕ) (y : Fin k → L) (j : Fin k), extEnv x k y (newIdx k j) = y j := by
  intro k
  induction k with
  | zero => intro y j; exact j.elim0
  | succ k ih =>
    intro y j
    by_cases h : (j : ℕ) = k
    · have hj : j = Fin.last k := Fin.ext h
      subst hj
      simp only [newIdx, Fin.val_last, dite_true]
      rfl
    · simp only [newIdx, h, dite_false, extEnv, Fin.cons_succ]
      rw [ih]
      simp only [Fin.init]
      congr 1
theorem holds_exBlock {m : ℕ} :
    ∀ (k : ℕ) (φ : Formula R (m + k)) (x : Fin m → L),
      (exBlock k φ).Holds f x ↔ ∃ y : Fin k → L, φ.Holds f (extEnv x k y) := by
  intro k
  induction k with
  | zero =>
    intro φ x
    exact ⟨fun h => ⟨Fin.elim0, h⟩, fun ⟨_, h⟩ => h⟩
  | succ k ih =>
    intro φ x
    rw [exBlock, ih]
    constructor
    · rintro ⟨y, hy⟩
      simp only [Formula.Holds] at hy
      obtain ⟨a, ha⟩ := hy
      refine ⟨Fin.snoc y a, ?_⟩
      simp only [extEnv, Fin.snoc_last, Fin.init_snoc]
      exact ha
    · rintro ⟨y, hy⟩
      refine ⟨Fin.init y, ?_⟩
      simp only [Formula.Holds]
      exact ⟨y (Fin.last k), hy⟩
theorem holds_allBlock {m : ℕ} :
    ∀ (k : ℕ) (φ : Formula R (m + k)) (x : Fin m → L),
      (allBlock k φ).Holds f x ↔ ∀ y : Fin k → L, φ.Holds f (extEnv x k y) := by
  intro k
  induction k with
  | zero =>
    intro φ x
    exact ⟨fun h _ => h, fun h => h Fin.elim0⟩
  | succ k ih =>
    intro φ x
    rw [allBlock, ih]
    constructor
    · intro h y
      have := (holds_all f φ _).mp (h (Fin.init y)) (y (Fin.last k))
      exact this
    · intro h y
      rw [holds_all]
      intro a
      have := h (Fin.snoc y a)
      simp only [extEnv, Fin.snoc_last, Fin.init_snoc] at this
      exact this
end Blocks
section Expressions
variable {R : Type*} [CommRing R] {L : Type*} [Field L] (f : R →+* L)
abbrev boxSize (n E : ℕ) : ℕ := (boundedExponents n E).length
def powExpr {σ : Type*} (v : σ) : ℕ → PolyExpr σ R
  | 0 => .const 1
  | e+1 => .mul (.var v) (powExpr v e)
def monExpr {σ : Type*} {n : ℕ} (xv : Fin n → σ) (a : Fin n →₀ ℕ) : PolyExpr σ R :=
  (List.finRange n).foldr (fun i acc => .mul (powExpr (xv i) (a i)) acc) (.const 1)
def boxExpr {σ : Type*} (n E : ℕ) (cv : Fin (boxSize n E) → σ) (xv : Fin n → σ) : PolyExpr σ R :=
  PolyExpr.sum ((List.finRange (boxSize n E)).map fun j =>
    .mul (.var (cv j)) (monExpr xv ((boundedExponents n E)[j.val])))
theorem interpret_powExpr {σ : Type*} (x : σ → L) (v : σ) :
    ∀ e : ℕ, interpret f x (powExpr v e : PolyExpr σ R) = x v ^ e := by
  intro e
  induction e with
  | zero => simp [powExpr, interpret]
  | succ e ih => simp only [powExpr, interpret, ih]; ring
theorem interpret_foldr {σ : Type*} {n : ℕ} (x : σ → L) (xv : Fin n → σ) (a : Fin n →₀ ℕ)
    (l : List (Fin n)) :
    interpret f x (l.foldr (fun i acc => .mul (powExpr (xv i) (a i)) acc) (.const 1) :
      PolyExpr σ R) = (l.map fun i => x (xv i) ^ a i).prod := by
  induction l with
  | nil => simp [interpret]
  | cons i l ih =>
    simp only [List.foldr_cons, interpret, interpret_powExpr, List.map_cons, List.prod_cons, ih]
theorem interpret_monExpr {σ : Type*} {n : ℕ} (x : σ → L) (xv : Fin n → σ) (a : Fin n →₀ ℕ) :
    interpret f x (monExpr xv a : PolyExpr σ R) = ∏ i : Fin n, x (xv i) ^ a i := by
  rw [monExpr, interpret_foldr, Fin.prod_univ_def]
theorem interpret_sum {σ : Type*} (x : σ → L) (ps : List (PolyExpr σ R)) :
    interpret f x (PolyExpr.sum ps) = (ps.map (interpret f x)).sum := by
  induction ps with
  | nil => simp [PolyExpr.sum, PolyExpr.zero, interpret]
  | cons p ps ih => simp [PolyExpr.sum, interpret, ih]
theorem denseEval_apply {n E : ℕ} (y : Fin n → L) (v : Fin (boxSize n E) → L) :
    denseEval y v = ∑ i, (∏ j, y j ^ ((boundedExponents n E)[i.val]) j) * v i := by
  simp only [denseEval, LinearMap.sum_apply, LinearMap.smul_apply, LinearMap.proj_apply,
    smul_eq_mul]
theorem interpret_boxExpr {σ : Type*} (n E : ℕ) (x : σ → L) (cv : Fin (boxSize n E) → σ)
    (xv : Fin n → σ) :
    interpret f x (boxExpr n E cv xv : PolyExpr σ R) = denseEval (x ∘ xv) (x ∘ cv) := by
  rw [boxExpr, interpret_sum, List.map_map, ← Fin.sum_univ_def, denseEval_apply]
  refine Finset.sum_congr rfl fun j _ => ?_
  simp only [Function.comp_apply, interpret, interpret_monExpr]
  ring
end Expressions
section Pieces
variable {L : Type*} [Field L]
def rowsZero {m k : ℕ} (n E : ℕ) (Uv : Fin k → Fin (boxSize n E) → Fin m) (xv : Fin n → Fin m) :
    Formula ℤ m :=
  fConj (List.ofFn fun i => fEq (boxExpr n E (Uv i) xv))
theorem holds_rowsZero {m k : ℕ} (n E : ℕ) (Uv : Fin k → Fin (boxSize n E) → Fin m)
    (xv : Fin n → Fin m) (env : Fin m → L) :
    (rowsZero n E Uv xv).Holds (Int.castRingHom L) env ↔
      ∀ i, denseEval (fun t => env (xv t)) (fun j => env (Uv i j)) = 0 := by
  rw [rowsZero, holds_conj_ofFn]
  simp only [holds_eq, interpret_boxExpr]
  rfl
def vanishY {m k : ℕ} (n E E' : ℕ) (Uv : Fin k → Fin (boxSize n E) → Fin m)
    (pv : Fin (boxSize n E') → Fin m) : Formula ℤ m :=
  allBlock n (fImp (rowsZero n E (fun i j => oldIdx n (Uv i j)) (newIdx n))
    (fEq (boxExpr n E' (fun j => oldIdx n (pv j)) (newIdx n))))
theorem holds_vanishY {m k : ℕ} (n E E' : ℕ) (Uv : Fin k → Fin (boxSize n E) → Fin m)
    (pv : Fin (boxSize n E') → Fin m) (env : Fin m → L) :
    (vanishY n E E' Uv pv).Holds (Int.castRingHom L) env ↔
      ∀ x : Fin n → L, (∀ i, denseEval x (fun j => env (Uv i j)) = 0) →
        denseEval x (fun j => env (pv j)) = 0 := by
  rw [vanishY, holds_allBlock]
  refine forall_congr' fun x => ?_
  rw [holds_imp, holds_rowsZero, holds_eq, interpret_boxExpr]
  simp only [Function.comp_def, extEnv_oldIdx, extEnv_newIdx]
def prodVanishY {m k : ℕ} (n E E' : ℕ) (Uv : Fin k → Fin (boxSize n E) → Fin m)
    (pv qv : Fin (boxSize n E') → Fin m) : Formula ℤ m :=
  allBlock n (fImp (rowsZero n E (fun i j => oldIdx n (Uv i j)) (newIdx n))
    (fEq (.mul (boxExpr n E' (fun j => oldIdx n (pv j)) (newIdx n))
      (boxExpr n E' (fun j => oldIdx n (qv j)) (newIdx n)))))
theorem holds_prodVanishY {m k : ℕ} (n E E' : ℕ) (Uv : Fin k → Fin (boxSize n E) → Fin m)
    (pv qv : Fin (boxSize n E') → Fin m) (env : Fin m → L) :
    (prodVanishY n E E' Uv pv qv).Holds (Int.castRingHom L) env ↔
      ∀ x : Fin n → L, (∀ i, denseEval x (fun j => env (Uv i j)) = 0) →
        denseEval x (fun j => env (pv j)) * denseEval x (fun j => env (qv j)) = 0 := by
  rw [prodVanishY, holds_allBlock]
  refine forall_congr' fun x => ?_
  rw [holds_imp, holds_rowsZero, holds_eq]
  simp only [interpret, interpret_boxExpr, Function.comp_def, extEnv_oldIdx, extEnv_newIdx]
def pivotCond {m k : ℕ} (c : ℕ) (Uv : Fin k → Fin c → Fin m) (S : Fin k → Fin c) :
    Formula ℤ m :=
  fConj (List.ofFn fun i => fConj (List.ofFn fun j =>
    fEq (.add (.var (Uv i (S j))) (.const (if i = j then -1 else 0)))))
theorem holds_pivotCond {m k : ℕ} (c : ℕ) (Uv : Fin k → Fin c → Fin m) (S : Fin k → Fin c)
    (env : Fin m → L) :
    (pivotCond c Uv S).Holds (Int.castRingHom L) env ↔
      ∀ i j, env (Uv i (S j)) = if i = j then 1 else 0 := by
  rw [pivotCond, holds_conj_ofFn]
  refine forall_congr' fun i => ?_
  rw [holds_conj_ofFn]
  refine forall_congr' fun j => ?_
  rw [holds_eq]
  simp only [interpret]
  split_ifs <;> simp [add_neg_eq_zero]
def closedCond {m k : ℕ} (n E : ℕ) (Uv : Fin k → Fin (boxSize n E) → Fin m)
    (S : Fin k → Fin (boxSize n E)) : Formula ℤ m :=
  allBlock (boxSize n E) (fImp
    (vanishY n E E (fun i j => oldIdx (boxSize n E) (Uv i j)) (newIdx (boxSize n E)))
    (fConj (List.ofFn fun j => fEq (PolyExpr.sub (.var (newIdx (boxSize n E) j))
      (PolyExpr.sum (List.ofFn fun i =>
        .mul (.var (newIdx (boxSize n E) (S i))) (.var (oldIdx (boxSize n E) (Uv i j)))))))))
theorem interpret_sum_ofFn {σ : Type*} {k : ℕ} (x : σ → L) (g : Fin k → PolyExpr σ ℤ) :
    interpret (Int.castRingHom L) x (PolyExpr.sum (List.ofFn g)) =
      ∑ i, interpret (Int.castRingHom L) x (g i) := by
  rw [interpret_sum, List.map_ofFn, List.sum_ofFn]
  rfl
theorem holds_closedCond {m k : ℕ} (n E : ℕ) (Uv : Fin k → Fin (boxSize n E) → Fin m)
    (S : Fin k → Fin (boxSize n E)) (env : Fin m → L) :
    (closedCond n E Uv S).Holds (Int.castRingHom L) env ↔
      ∀ v : Fin (boxSize n E) → L,
        (∀ x : Fin n → L, (∀ i, denseEval x (fun j => env (Uv i j)) = 0) → denseEval x v = 0) →
          ∀ j, v j = ∑ i, v (S i) * env (Uv i j) := by
  rw [closedCond, holds_allBlock]
  refine forall_congr' fun v => ?_
  rw [holds_imp, holds_vanishY, holds_conj_ofFn]
  simp only [holds_eq, interpret_sub, interpret_sum_ofFn, interpret, extEnv_oldIdx,
    extEnv_newIdx, sub_eq_zero]
def containCond {m k s : ℕ} (n d E : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m)
    (Uv : Fin k → Fin (boxSize n E) → Fin m) : Formula ℤ m :=
  allBlock n (fImp (rowsZero n E (fun i j => oldIdx n (Uv i j)) (newIdx n))
    (rowsZero n d (fun r j => oldIdx n (Fv r j)) (newIdx n)))
theorem holds_containCond {m k s : ℕ} (n d E : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m)
    (Uv : Fin k → Fin (boxSize n E) → Fin m) (env : Fin m → L) :
    (containCond n d E Fv Uv).Holds (Int.castRingHom L) env ↔
      ∀ x : Fin n → L, (∀ i, denseEval x (fun j => env (Uv i j)) = 0) →
        ∀ r, denseEval x (fun j => env (Fv r j)) = 0 := by
  rw [containCond, holds_allBlock]
  refine forall_congr' fun x => ?_
  rw [holds_imp, holds_rowsZero, holds_rowsZero]
  simp only [extEnv_oldIdx, extEnv_newIdx]
def irredCond {m k : ℕ} (n E T : ℕ) (Uv : Fin k → Fin (boxSize n E) → Fin m) : Formula ℤ m :=
  allBlock (boxSize n T) (allBlock (boxSize n T) (fImp
    (prodVanishY n E T (fun i j => oldIdx (boxSize n T) (oldIdx (boxSize n T) (Uv i j)))
      (fun j => oldIdx (boxSize n T) (newIdx (boxSize n T) j)) (newIdx (boxSize n T)))
    (fOr (vanishY n E T (fun i j => oldIdx (boxSize n T) (oldIdx (boxSize n T) (Uv i j)))
        (fun j => oldIdx (boxSize n T) (newIdx (boxSize n T) j)))
      (vanishY n E T (fun i j => oldIdx (boxSize n T) (oldIdx (boxSize n T) (Uv i j)))
        (newIdx (boxSize n T))))))
theorem holds_irredCond {m k : ℕ} (n E T : ℕ) (Uv : Fin k → Fin (boxSize n E) → Fin m)
    (env : Fin m → L) :
    (irredCond n E T Uv).Holds (Int.castRingHom L) env ↔
      ∀ p q : Fin (boxSize n T) → L,
        (∀ x : Fin n → L, (∀ i, denseEval x (fun j => env (Uv i j)) = 0) →
          denseEval x p * denseEval x q = 0) →
        (∀ x : Fin n → L, (∀ i, denseEval x (fun j => env (Uv i j)) = 0) → denseEval x p = 0) ∨
        (∀ x : Fin n → L, (∀ i, denseEval x (fun j => env (Uv i j)) = 0) → denseEval x q = 0) := by
  rw [irredCond, holds_allBlock]
  refine forall_congr' fun p => ?_
  rw [holds_allBlock]
  refine forall_congr' fun q => ?_
  rw [holds_imp, holds_prodVanishY, holds_or, holds_vanishY, holds_vanishY]
  simp only [extEnv_oldIdx, extEnv_newIdx]
def isolCond {m k s : ℕ} (n d E D : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m)
    (Uv : Fin k → Fin (boxSize n E) → Fin m) : Formula ℤ m :=
  exBlock (boxSize n D) (fAnd
    (allBlock n (fImp
      (rowsZero n d (fun r j => oldIdx n (oldIdx (boxSize n D) (Fv r j))) (newIdx n))
      (fOr (rowsZero n E (fun i j => oldIdx n (oldIdx (boxSize n D) (Uv i j))) (newIdx n))
        (fEq (boxExpr n D (fun j => oldIdx n (newIdx (boxSize n D) j)) (newIdx n))))))
    (exBlock n (fAnd
      (rowsZero n E (fun i j => oldIdx n (oldIdx (boxSize n D) (Uv i j))) (newIdx n))
      (fNe (boxExpr n D (fun j => oldIdx n (newIdx (boxSize n D) j)) (newIdx n))))))
theorem holds_isolCond {m k s : ℕ} (n d E D : ℕ) (Fv : Fin s → Fin (boxSize n d) → Fin m)
    (Uv : Fin k → Fin (boxSize n E) → Fin m) (env : Fin m → L) :
    (isolCond n d E D Fv Uv).Holds (Int.castRingHom L) env ↔
      ∃ h : Fin (boxSize n D) → L,
