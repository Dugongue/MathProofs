    S.toMatrix'.charpoly=S.charpoly := by
  rw [← Matrix.charpoly_toLin',Matrix.toLin'_toMatrix']
theorem goodGram_mass_lower (hcard : Nat.card K=Nat.card F^2)
    (hstar : ∀ x : K,star x=x^Nat.card F) (n : ℕ) (hn : 2≤n) :
