theorem firstPrepCost_le {K : Type} [Field K] (F : FieldPresentation K)
    {N a b c q : Nat} (hN : 1 ≤ N) (he : F.e ≤ N) (_hp : F.p.size ≤ N) (hq : q.size ≤ N)
    (ha : a ≤ N) (hb : b ≤ N) (hc : c ≤ N) :
    firstPrepCost F a b c q ≤ 10^41 * N^40 := by
  have hab : a*b ≤ N*N := Nat.mul_le_mul ha hb
  have hcab : c*(a*b) ≤ N*N*N := by
    have := Nat.mul_le_mul hc hab
    calc c*(a*b) ≤ N*(N*N) := this
      _ = N*N*N := by ring
  have h1 := Problem18P36LargeCostBounds20261004.power_map_cost_le (x := q) hN he hq hcab
  have h2 := Problem18P36LargeCostBounds20261004.power_map_cost_le (x := 1) hN he
    (by simp; pomega) hcab
  have h3 := Problem18P36LargeCostBounds20261004.transpose_cost_le (m := c) (n := a*b)
    hN he hc hab
  have h4 := Problem18P36LargeCostBounds20261004.product_loop_cost_le (n := a*b) (k := c)
    hN he hab hc
  have c1 := gramBufferCost_le
  have c2 := transposeConfigCost_le
  have c3 := ctrlCost_le
  have c4 := sortedBase_size_le
  have c5 := firstOneSlot_size_le
  have hP : 1 ≤ N^40 := Nat.one_le_pow _ _ hN
  have hNP : N ≤ N^40 := by
    calc N = N^1 := (pow_one N).symm
      _ ≤ N^40 := Nat.pow_le_pow_right hN (by norm_num)
  have hsplit : (Problem18IMPMatrixPowerMap20261001.stepCost F.e q +
      Problem18IMPMatrixPowerMap20261001.stepCost F.e 1 + 4) * (c*(a*b)) ≤
      (Problem18IMPMatrixPowerMap20261001.stepCost F.e q + 4) * (c*(a*b)) +
      (Problem18IMPMatrixPowerMap20261001.stepCost F.e 1 + 4) * (c*(a*b)) := by
    rw [← Nat.add_mul]; exact Nat.mul_le_mul_right _ (by pomega)
  have h10 : 10^41 * N^40 = 10 * (10^40 * N^40) := by ring
  have hbig : 10^6 ≤ 10^40 * N^40 := by
    have : 10^6 ≤ 10^40 := by norm_num
    calc 10^6 ≤ 10^40 := this
      _ = 10^40 * 1 := by ring
      _ ≤ 10^40 * N^40 := Nat.mul_le_mul_left _ hP
  have hbigN : 13 * F.e ≤ 10^40 * N^40 := by
    have : 13 * N^40 ≤ 10^40 * N^40 := Nat.mul_le_mul_right _ (by norm_num)
    pomega
  unfold Problem18P36LargeCostBounds20261004.phaseBound at h1 h2 h3 h4
  unfold firstPrepCost Mathproof.Problem18P36LargeNativeReset20261004.resetCost
  pomega
end costbound
theorem first_prep_run {K : Type} [Field K] [Fintype K] [DecidableEq K]
    (F : FieldPresentation K)
    {W Sn a b c : Nat} {u : Bool} {q : Nat} {A : RectTensor a b c K} {sigma : Env}
    (h : PostGather F W Sn a b c u q A sigma) :
    ∃ tau, Run W (.seq firstGramProgram (.seq configureFirstController initializeOne))
        sigma tau (firstPrepCost F a b c q) ∧
      PostGather F W Sn a b c u q A tau ∧
      Problem18P36LargeFirstFullExecution20261004.FullProgramInputF F W a b c (a*b)
        (physN F.e (firstGramN a b c)) (physN F.e (firstPowerN a b c))
        (physN F.e (firstProductWorkN a b c)) u q A
        (Problem18IMPMatrixMemory20261001.matrix F tau
          (physN F.e (firstGramN a b c)) (a*b) (a*b)) tau ∧
      tau.vars Problem18P36LargeFirstController20261003.familyBase =
        physN F.e (firstFamilyN a b c) ∧
      tau.vars canonical.exp < W ∧
      tau.inp = sigma.inp ∧ tau.out = sigma.out := by
  obtain ⟨-,-,-,-,-,-,n7,n8,n9,-,-⟩ := pg_nums F h
  obtain ⟨tau, hrun, hp⟩ := prep_chain F h (by pomega)
  refine ⟨tau, hrun, pg_of_prep F h hp, ⟨runtime_of_prep F h hp, rfl, ?_⟩, hp.famR,
    by rw [hp.expR]; exact adj_lt F h, hp.inp, hp.out⟩
  intro rho hR hI hregs _harr hlens hmem
  exact trace_input F h hp rho hR hI hregs hmem (hlens canonical.mem)
end Mathproof.Problem18P36LargeFirstPrep20261004
