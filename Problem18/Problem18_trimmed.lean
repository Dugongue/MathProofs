abbrev Row (e n : Nat) := Vector (Coeff e) n
def findPivot {e n : Nat} (v : Row e n) : List (Fin n) → Option (Fin n)
  | [] => none
  | i::is => if isZero v[i.val] then findPivot v is else some i
def eliminate {e n : Nat} (p : Nat) (modulus : Coeff e) (i : Fin n)
    (v x : Row e n) : Row e n :=
  let a:=mul p e modulus x[i.val] (inverse p e modulus v[i.val])
  Vector.ofFn fun j=>point .sub p x[j.val] (mul p e modulus a v[j.val])
def reduce {e n : Nat} (p : Nat) (modulus : Coeff e) :
    List (Row e n) → Row e n → Row e n
  | [],x => x
  | v::vs,x =>
    match findPivot v (List.finRange n) with
    | none => reduce p modulus vs x
    | some i => let E:=eliminate p modulus i v
                reduce p modulus (vs.map E) (E x)
termination_by vs=>vs.length
def spanCheck {e n : Nat} (p : Nat) (modulus : Coeff e)
    (vs : List (Row e n)) (x : Row e n) : Bool :=
  let r:=reduce p modulus vs x
  (List.finRange n).all fun i=>isZero r[i.val]
def selectRows {e n : Nat} (p : Nat) (modulus : Coeff e)
    (chosen : List (Row e n)) : List (Row e n) → List (Row e n)
  | [] => chosen
  | v::vs => selectRows p modulus (if spanCheck p modulus chosen v then chosen else v::chosen) vs
def compress {e n : Nat} (p : Nat) (modulus : Coeff e) (vs : List (Row e n)) : List (Row e n) :=
  selectRows p modulus [] vs
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
def decodeRow {n : Nat} (v : Row F.e n) : Vector K n := v.map (decodeVector F)
def CanonicalRow {n : Nat} (v : Row F.e n) : Prop :=
  ∀i : Fin n, canonicalVector F v[i.val]
def CanonicalRows {n : Nat} (vs : List (Row F.e n)) : Prop := ∀v∈vs,CanonicalRow F v
theorem read_decodeRow {n : Nat} (v : Row F.e n) (i : Fin n) :
    Problem18ArrayElimination20260929.read (decodeRow F v) i=decodeVector F v[i.val] := by
  simp [Problem18ArrayElimination20260929.read,decodeRow]
theorem findPivot_decode {n : Nat} (v : Row F.e n) (hv : CanonicalRow F v) (cs : List (Fin n)) :
    findPivot v cs=(Problem18ArrayElimination20260929.findPivot id (decodeRow F v) cs).1 := by
  induction cs with
  | nil => rfl
  | cons i cs ih =>
    simp only [findPivot,Problem18ArrayElimination20260929.findPivot,id_eq,read_decodeRow]
    have hz := isZero_correct F v[i.val] (hv i)
    by_cases h : isZero v[i.val]=true
    · simp [h,hz.mp h,ih]
    · have hn : decodeVector F v[i.val]≠0 := fun hh=>h (hz.mpr hh)
      simp [h,hn]
theorem eliminate_decode {n : Nat} (i : Fin n) (v x : Row F.e n)
    (hv : CanonicalRow F v) (hx : CanonicalRow F x) :
    decodeRow F (eliminate F.p (modulusVector F) i v x)=
      Problem18ArrayElimination20260929.eliminateArray id i (decodeRow F v) (decodeRow F x) := by
  apply Vector.ext
  intro j hj
  simp only [decodeRow,Vector.getElem_map,eliminate,Vector.getElem_ofFn,
    Problem18ArrayElimination20260929.eliminateArray,
    Problem18ArrayElimination20260929.read,id_eq]
  rw [decode_point F .sub _ _ (hx ⟨j,hj⟩) (mul_canonical F _ _)]
  simp only [Problem18IMPFieldPresentation20261001.fieldValue,decode_mul,decode_inverse,div_eq_mul_inv,
    Vector.getElem_map]
theorem eliminate_canonical {n : Nat} (i : Fin n) (v x : Row F.e n)
    (hx : CanonicalRow F x) : CanonicalRow F (eliminate F.p (modulusVector F) i v x) := by
  intro j
  simp only [eliminate,Vector.getElem_ofFn]
  exact point_canonical F .sub _ _ (hx j)
theorem reduce_canonical {n : Nat} (vs : List (Row F.e n)) (x : Row F.e n)
    (hx : CanonicalRow F x) : CanonicalRow F (reduce F.p (modulusVector F) vs x) := by
  cases vs with
  | nil => simpa only [reduce] using hx
  | cons v vs =>
    simp only [reduce]
    split
    · exact reduce_canonical vs x hx
    · exact reduce_canonical _ _ (eliminate_canonical F _ _ _ hx)
termination_by vs.length
theorem reduce_decode {n : Nat} (vs : List (Row F.e n)) (x : Row F.e n)
    (hv : CanonicalRows F vs) (hx : CanonicalRow F x) :
    decodeRow F (reduce F.p (modulusVector F) vs x)=
      (Problem18ArrayElimination20260929.reduceArray (List.finRange n) id
        (vs.map (decodeRow F)) (decodeRow F x)).1 := by
  cases vs with
  | nil => simp [reduce,Problem18ArrayElimination20260929.reduceArray]
  | cons v vs =>
    have hv0 : CanonicalRow F v := hv v (by simp)
    have hvs : CanonicalRows F vs := fun w hw=>hv w (List.mem_cons_of_mem _ hw)
    have hp := findPivot_decode F v hv0 (List.finRange n)
    cases h : findPivot v (List.finRange n) with
    | none =>
      have hp' := hp.symm.trans h
      simp only [reduce,h,List.map_cons,Problem18ArrayElimination20260929.reduceArray,hp']
      exact reduce_decode vs x hvs hx
    | some i =>
      have hp' := hp.symm.trans h
      simp only [reduce,h,List.map_cons,Problem18ArrayElimination20260929.reduceArray,hp']
      have hE : CanonicalRows F (vs.map (eliminate F.p (modulusVector F) i v)) := by
        intro w hw
        obtain ⟨y,hy,rfl⟩ := List.mem_map.mp hw
        exact eliminate_canonical F i v y (hvs y hy)
      rw [reduce_decode _ _ hE (eliminate_canonical F i v x hx),eliminate_decode F i v x hv0 hx]
      have hmap :
          (vs.map (eliminate F.p (modulusVector F) i v)).map (decodeRow F)=
          (vs.map (decodeRow F)).map
            (Problem18ArrayElimination20260929.eliminateArray id i (decodeRow F v)) := by
        rw [List.map_map,List.map_map]
        apply List.map_congr_left
        intro y hy
        exact eliminate_decode F i v y hv0 (hvs y hy)
      rw [hmap]
termination_by vs.length
theorem spanCheck_decode {n : Nat} (vs : List (Row F.e n)) (x : Row F.e n)
    (hv : CanonicalRows F vs) (hx : CanonicalRow F x) :
    spanCheck F.p (modulusVector F) vs x=
      (Problem18ArrayElimination20260929.spanCheck (vs.map (decodeRow F)) (decodeRow F x)).1 := by
  apply Bool.eq_iff_iff.mpr
  simp only [spanCheck,List.all_eq_true,List.mem_finRange,forall_true_left,
    Problem18ArrayElimination20260929.spanCheck,decide_eq_true_eq,funext_iff,Pi.zero_apply]
  have hc := reduce_canonical F vs x hx
  simp_rw [isZero_correct F _ (hc _)]
  rw [←reduce_decode F vs x hv hx]
  simp only [read_decodeRow]
theorem selectRows_canonical {n : Nat} (chosen candidates : List (Row F.e n))
    (hc : CanonicalRows F chosen) (hv : CanonicalRows F candidates) :
    CanonicalRows F (selectRows F.p (modulusVector F) chosen candidates) := by
  induction candidates generalizing chosen with
  | nil => exact hc
  | cons v vs ih =>
    simp only [selectRows]
    apply ih
    · split_ifs
      · exact hc
      · intro w hw
        rcases List.mem_cons.mp hw with rfl|hw
        · exact hv _ (by simp)
        · exact hc w hw
    · exact fun w hw=>hv w (List.mem_cons_of_mem _ hw)
theorem selectRows_decode {n : Nat} (chosen candidates : List (Row F.e n))
    (hc : CanonicalRows F chosen) (hv : CanonicalRows F candidates) :
    (selectRows F.p (modulusVector F) chosen candidates).map (decodeRow F)=
      (Problem18PolynomialCompression20261001.selectRows (chosen.map (decodeRow F))
        (candidates.map (decodeRow F))).1 := by
  induction candidates generalizing chosen with
  | nil => rfl
  | cons v vs ih =>
    have hv0 := hv v (by simp)
    have hvs : CanonicalRows F vs := fun w hw=>hv w (List.mem_cons_of_mem _ hw)
    simp only [selectRows,List.map_cons,Problem18PolynomialCompression20261001.selectRows]
    rw [←spanCheck_decode F chosen v hc hv0]
    split_ifs
    · exact ih chosen hc hvs
    · exact ih (v::chosen) (by intro w hw; rcases List.mem_cons.mp hw with rfl|hw; exact hv0; exact hc w hw) hvs
theorem compress_decode {n : Nat} (vs : List (Row F.e n)) (hv : CanonicalRows F vs) :
    (compress F.p (modulusVector F) vs).map (decodeRow F)=
      (Problem18PolynomialCompression20261001.compress (vs.map (decodeRow F))).1 :=
  selectRows_decode F [] vs (by simp [CanonicalRows]) hv
theorem compress_length {n : Nat} (vs : List (Row F.e n)) (hv : CanonicalRows F vs) :
    (compress F.p (modulusVector F) vs).length≤n := by
  rw [←List.length_map (f:=decodeRow F),compress_decode F vs hv]
