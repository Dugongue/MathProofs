    have htN : x≠tw.Nr := by intro he;apply hxt;rw [he];decide
    have htp : x≠tw.pS := by intro he;apply hxt;rw [he];decide
    have htq : x≠tw.qS := by intro he;apply hxt;rw [he];decide
    have htw : x∉tw.work := by
      simp only [TNames.work,TNames.list,List.mem_cons,List.not_mem_nil,or_false] at hxt ⊢
