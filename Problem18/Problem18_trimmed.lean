theorem clocked_extension_of_ramPolytimeOn
    {valid : List Nat → Prop} {f : List Nat → Bool}
    (hf : RamPolytimeOn valid (resultWords f)) :
    ∃ (p : Lax51Proofs.Microcode.Program)
      (wordBound timeBound : Polynomial Nat),
      ∀ x, valid x →
        clockedDecision p wordBound timeBound x = f x := by
  obtain ⟨p₀,wordBound,timeBound₀,hram⟩ := hf
  let p := Lax51Proofs.CellToMicrocode.compile p₀
  let timeBound : Polynomial Nat := 3 * timeBound₀
  refine ⟨p,wordBound,timeBound,?_⟩
  intro x hx
  obtain ⟨hfits,hall⟩ := hram x hx
  have hw : wordBound.eval (bitSize x) ≤ simulationWordWidth wordBound x :=
    (polynomial_eval_le_simpleMajorant wordBound (bitSize x)).trans
      (by simp [simulationWordWidth])
  obtain ⟨t,ht,hrun⟩ := hall (simulationWordWidth wordBound x) hw
  have hmicro : Lax51Proofs.Microcode.RunsTo
      (simulationWordWidth wordBound x) p
      (x.length :: x) (resultWords f x) (3*t) := by
    exact Lax51Proofs.CellToMicrocode.runsTo hrun
  have htime : 3*t ≤ timeBound.eval (bitSize x) := by
    simpa [timeBound] using Nat.mul_le_mul_left 3 ht
  exact clockedDecision_eq_of_runsTo p wordBound timeBound x (f x) (3*t)
    (by simpa [resultWords] using hfits) htime
    (by simpa [resultWords] using hmicro)
end
end Mathproof.Problem18P36ClockedPartialTotalization20261004
