def negBody (M : FieldMacros F r) (q : RNames) (ci : String) (Src C : Expr) : Com :=
  .seq (mcall r q M.neg (plus Src (.var ci)) (plus Src (.var ci)) (plus C (.var ci)))
    (.assign ci (plus (.var ci) (.lit 1)))
def negLoadCom (M : FieldMacros F r) (q : RNames) (ci : String) (Src C : Expr) (D : ℕ) : Com :=
  .seq (.assign ci (.lit 0)) (.while (.lt (.var ci) (.lit D)) (negBody M q ci Src C))
def negStep (M : FieldMacros F r) (Src C : Expr) : ℕ :=
  30 + C.size + 2 * Src.size + M.costPoint
def negLoadCost (M : FieldMacros F r) (Src C : Expr) (D : ℕ) : ℕ :=
  2 + (4 + negStep M Src C) * D + 4
theorem negLoad_run (M : FieldMacros F r) (q : RNames) (ci : String) (l : List String)
    (hci : ci ∉ regNames r) (hciW : ci ≠ q.WS) (hl : ∀ x ∈ l, x ∉ regNames r ∧ x ≠ ci)
    (Src C : Expr) (hsp : VarsIn l Src) (hdp : VarsIn l C) (D : ℕ)
    {B Sn : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ) {sv dv : ℕ}
    (hsv : Src.evalB B σ = some sv) (hdv : C.evalB B σ = some dv)
    (hsd : sv + D ≤ dv) (hdfit : dv + D ≤ Sn) :
    ∃ τ, Run B (negLoadCom M q ci Src C D) σ τ (negLoadCost M Src C D) ∧
      Slots F r q.WS Sn B τ ∧
      (∀ j < D, val F r q.WS τ (dv + j) = - val F r q.WS σ (sv + j)) ∧
      (∀ s < Sn, (s < dv ∨ dv + D ≤ s) → val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ≠ ci → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hSB := hS.slots_word
  have hcA : ci ≠ r.aBase := fun h => hci (by rw [h]; simp [regNames, scalarNames])
  have hcB : ci ≠ r.bBase := fun h => hci (by rw [h]; simp [regNames, scalarNames])
  have hDB : D < B := by omega
  have hlA : ∀ e, VarsIn l e → NoVar r.aBase e := fun e he =>
    noVar_of_varsIn (fun h => (hl _ h).1 (by simp [regNames, scalarNames])) e he
  have hlB : ∀ e, VarsIn l e → NoVar r.bBase e := fun e he =>
    noVar_of_varsIn (fun h => (hl _ h).1 (by simp [regNames, scalarNames])) e he
  have toL : ∀ τ : Env, (∀ x, x ∉ regNames r → x ≠ ci → τ.vars x = σ.vars x) →
      ∀ x ∈ l, τ.vars x = σ.vars x := fun τ h x hx => h x (hl x hx).1 (hl x hx).2
  let I : Env → Prop := fun τ =>
    Slots F r q.WS Sn B τ ∧ τ.vars ci ≤ D ∧
    (∀ x, x ∉ regNames r → x ≠ ci → τ.vars x = σ.vars x) ∧
    (∀ k < D, val F r q.WS τ (dv + k) =
      if k < τ.vars ci then - val F r q.WS σ (sv + k) else val F r q.WS σ (dv + k)) ∧
    (∀ s < Sn, (s < dv ∨ dv + D ≤ s) → val F r q.WS τ s = val F r q.WS σ s) ∧
    (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out
  have hI0 : I (σ.setVar ci 0) := by
    refine ⟨Slots.setVar F r hS hci hciW 0, by simp, ?_, ?_, ?_, fun _ _ _ => rfl, rfl, rfl⟩
    · intro x _ hxc; simp only [vars_setVar, if_neg hxc]
    · intro k _
      simp only [vars_setVar, if_true, Nat.not_lt_zero, if_false]
      exact val_setVar F r hciW σ 0 _
    · intro s _ _; exact val_setVar F r hciW σ 0 s
  have hcond : ∀ τ, I τ →
      (Cond.lt (.var ci) (.lit D)).evalB B τ = some (decide (τ.vars ci < D)) := fun τ hτ =>
    evalB_condLt (evalB_var (by have := hτ.2.1; omega)) (evalB_lit hDB)
  have hdef : ∀ τ, I τ → ∃ v, (Cond.lt (.var ci) (.lit D)).evalB B τ = some v :=
    fun τ hτ => ⟨_, hcond τ hτ⟩
  have hstep : ∀ τ, I τ → (Cond.lt (.var ci) (.lit D)).evalB B τ = some true →
      ∃ τ', Run B (negBody M q ci Src C) τ τ' (negStep M Src C) ∧ I τ' ∧
        D - τ'.vars ci < D - τ.vars ci := by
    intro τ hτ hc
    rw [hcond τ hτ] at hc
    simp only [Option.some.injEq, decide_eq_true_eq] at hc
    obtain ⟨hSτ, hjle, hfix, hdst, hfr, harr, hinp, hout⟩ := hτ
    have hDτ : C.evalB B τ = some dv := by
      rw [evalB_congr_varsIn (toL τ hfix) C hdp]; exact hdv
    have hSτv : Src.evalB B τ = some sv := by
      rw [evalB_congr_varsIn (toL τ hfix) Src hsp]; exact hsv
    obtain ⟨τ1, hr1, hv1, hc1⟩ := slot_call F r M.neg_spec hSτ (plus Src (.var ci))
      (plus Src (.var ci)) (plus C (.var ci)) (evalB_plus_var hSτv rfl (by omega))
      (evalB_plus_var hSτv rfl (by omega)) (evalB_plus_var hDτ rfl (by omega))
      ⟨hlA Src hsp, hcA⟩ ⟨hlA C hdp, hcA⟩ ⟨hlB C hdp, hcB⟩ (by omega) (by omega) (by omega)
      (by omega) (by omega)
    have hj1 : τ1.vars ci = τ.vars ci := call_regs_all hc1 ci hci
    have hinc : (plus (.var ci) (.lit 1)).evalB B τ1 = some (τ.vars ci + 1) := by
      unfold plus
      exact evalB_bin (by rw [← hj1]; exact evalB_var (by rw [hj1]; omega)) (evalB_lit (by omega))
        (by change τ.vars ci + 1 < B; omega)
    refine ⟨τ1.setVar ci (τ.vars ci + 1), ?_, ⟨Slots.setVar F r hc1.slots hci hciW _, ?_, ?_,
      ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
    · refine (hr1.seq (Run.assign hinc)).mono ?_
      have e1 : (plus Src (Expr.var ci)).size = Src.size + 2 := rfl
      have e2 : (plus C (Expr.var ci)).size = C.size + 2 := rfl
      have e3 : (plus (Expr.var ci) (Expr.lit 1)).size = 3 := rfl
      rw [e1, e2, e3]; unfold negStep; omega
    · simp only [vars_setVar, if_true]; omega
    · intro x hx hxc
      simp only [vars_setVar, if_neg hxc]
      rw [call_regs_all hc1 x hx]; exact hfix x hx hxc
    · intro m hm
      rw [val_setVar F r hciW]
      simp only [vars_setVar, if_true]
      by_cases hmk : m = τ.vars ci
      · rw [hmk, if_pos (Nat.lt_succ_self _), hv1, hfr _ (by omega) (Or.inl (by omega))]
      · rw [call_val hc1 (by omega) (by omega : dv + m ≠ dv + τ.vars ci), hdst m hm]
        by_cases hlt : m < τ.vars ci
        · rw [if_pos hlt, if_pos (by omega)]
        · rw [if_neg hlt, if_neg (by omega)]
    · intro s hs hout'
      have hne : s ≠ dv + τ.vars ci := by rcases hout' with h | h <;> omega
      rw [val_setVar F r hciW, call_val hc1 hs hne]
      exact hfr s hs hout'
    · intro a h1 h2
      simp only [arrs_setVar]; rw [hc1.arrays a h1 h2]; exact harr a h1 h2
    · simp only [inp_setVar]; rw [hc1.inp]; exact hinp
    · simp only [out_setVar]; rw [hc1.out]; exact hout
    · simp only [vars_setVar, if_true]; omega
  obtain ⟨τf, hrf, hIf, hcf⟩ := Run.while_count I (fun τ => D - τ.vars ci)
    (negStep M Src C) hdef hstep hI0
  have hcf' := hcf
  rw [hcond τf hIf] at hcf'
  obtain ⟨hSf, hjf, hfixf, hdstf, hfrf, harrf, hinpf, houtf⟩ := hIf
  have hjeq : τf.vars ci = D := by
    simp only [Option.some.injEq, decide_eq_false_iff_not, not_lt] at hcf'
    omega
  refine ⟨τf, ?_, hSf, ?_, hfrf, hfixf, harrf, hinpf, houtf⟩
  · refine ((Run.assign (x := ci) (evalB_lit (σ := σ) (by omega : 0 < B))).seq hrf).mono ?_
    simp only [vars_setVar, if_true, Nat.sub_zero]
    have e1 : (Expr.lit 0).size = 1 := rfl
    have e2 : (Cond.lt (Expr.var ci) (Expr.lit D)).size = 3 := rfl
    rw [e1, e2]; unfold negLoadCost; ring_nf; try omega
  · intro k hk; rw [hdstf k hk, if_pos (by omega)]
theorem lowCoefficients_getElem (D R : ℕ) {nC : ℕ} (c : Vector K nC) {j : ℕ} (hj : j < D) :
    (lowCoefficients D R c).1[j] = - vget c (R + j) := by
  simp [lowCoefficients, countedOfFn_fst]
def frobRowFullCom (M : FieldMacros F r) (q : RNames) (fn : FNames) (qr : String)
    (Src C Xv A S X1 X2 O T1 T2 : Expr) {n : ℕ} (Bdeg D : ℕ) (i : Fin n) : Com :=
  .seq (negLoadCom M q fn.ci Src C D)
    (.seq (frobCom M q fn qr C Xv A S X1 X2 D) (frobRowCom M q fn.ci A O T1 T2 Bdeg D i))
def frobRowFullCost (M : FieldMacros F r) (Src C Xv A S X1 X2 O T1 T2 : Expr) (n Bdeg D sz : ℕ) :
    ℕ :=
  negLoadCost M Src C D + (frobCost M C Xv A S X1 X2 D sz + frobRowCost M A O T1 T2 n Bdeg)
theorem frobRowFull_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (fn : FNames)
    (hfn : fn.Valid r q) (qr : String)
    (hqr : qr ∉ regNames r ∧ qr ≠ q.j ∧ qr ≠ q.N ∧ qr ∉ fn.list) (l : List String)
    (hl : ∀ x ∈ l, x ∉ regNames r ∧ x ≠ q.j ∧ x ≠ q.N ∧ x ∉ fn.list)
    (Src C Xv A S X1 X2 O T1 T2 : Expr) (hSrc : VarsIn l Src) (hC : VarsIn l C)
    (hXv : VarsIn l Xv) (hA : VarsIn l A) (hSe : VarsIn l S) (hX1 : VarsIn l X1)
    (hX2 : VarsIn l X2) (hO : VarsIn l O) (hT1 : VarsIn l T1) (hT2 : VarsIn l T2)
    {n : ℕ} (Bdeg D R : ℕ) (i : Fin n) {nC : ℕ} (c : Vector K nC)
    {Bw Sn sv cv xv av s0 x1 x2 ov t1 t2 : ℕ} {σ : Env} (hS : Slots F r q.WS Sn Bw σ)
    (esv : Src.evalB Bw σ = some sv) (ecv : C.evalB Bw σ = some cv)
    (exv : Xv.evalB Bw σ = some xv) (eav : A.evalB Bw σ = some av)
    (es0 : S.evalB Bw σ = some s0) (ex1 : X1.evalB Bw σ = some x1)
    (ex2 : X2.evalB Bw σ = some x2) (eov : O.evalB Bw σ = some ov)
    (et1 : T1.evalB Bw σ = some t1) (et2 : T2.evalB Bw σ = some t2)
    (hz : val F r q.WS σ 0 = 0) (hD : 1 ≤ D)
    (hcoef : ∀ j < D, val F r q.WS σ (sv + j) = vget c (R + j))
    {Q : ℕ} (hQ : σ.vars qr = Q) (hQB : Q < Bw)
    (hsc : sv + D ≤ cv) (h5 : 5 ≤ cv) (hcx : cv + D ≤ xv) (hxa : xv + D ≤ av)
    (has : av + D ≤ s0) (hs1 : s0 + D ≤ x1) (h12 : x1 + D ≤ x2) (h2o : x2 + D ≤ ov)
    (ht1 : 1 ≤ t1) (ht12 : t1 < t2) (ht2 : t2 < ov)
    (hfit : ov + (boundedExponents n Bdeg).length ≤ Sn) :
    ∃ τ, Run Bw (frobRowFullCom M q fn qr Src C Xv A S X1 X2 O T1 T2 Bdeg D i) σ τ
        (frobRowFullCost M Src C Xv A S X1 X2 O T1 T2 n Bdeg D (Nat.size Q)) ∧
      Slots F r q.WS Sn Bw τ ∧
      (∀ a (ha : a < (boundedExponents n Bdeg).length),
        val F r q.WS τ (ov + a) =
          read (frobeniusRow Bdeg D i (frobeniusResidue (lowCoefficients D R c).1 Q).1) ⟨a, ha⟩) ∧
      (∀ s < Sn, s ≠ 1 → s ≠ 2 → s ≠ 3 → s ≠ 4 → s ≠ t1 → s ≠ t2 →
        (s < cv ∨ ov + (boundedExponents n Bdeg).length ≤ s) →
        val F r q.WS τ s = val F r q.WS σ s) ∧
      val F r q.WS τ 0 = 0 ∧
      (∀ x, x ∉ regNames r → x ≠ q.j → x ≠ q.N → x ∉ fn.list → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hSB := hS.slots_word
  have hciL : fn.ci ∈ fn.list := fn.mem 2 (by omega)
  have hciS : fn.ci ∉ regNames r := hfn.reg _ hciL
  have hciW : fn.ci ≠ q.WS := hfn.ws _ hciL
  have hlc : ∀ x ∈ l, x ∉ regNames r ∧ x ≠ fn.ci :=
    fun x hx => ⟨(hl x hx).1, fun e => (hl x hx).2.2.2 (e ▸ hciL)⟩
  obtain ⟨τ1, r1, hS1, hv1, hk1, hfix1, harr1, hinp1, hout1⟩ :=
    negLoad_run M q fn.ci l hciS hciW hlc Src C hSrc hC D hS esv ecv hsc (by omega)
  have hev1 : ∀ (E : Expr) (v : ℕ), VarsIn l E → E.evalB Bw σ = some v → E.evalB Bw τ1 = some v :=
    fun E v hE h => by
      rw [evalB_congr_varsIn (fun x hx => hfix1 x (hlc x hx).1 (hlc x hx).2) E hE]; exact h
  have hcs : SlotVec (val F r q.WS τ1) cv (lowCoefficients D R c).1 := by
    intro j hj
    rw [hv1 j hj, hcoef j hj, lowCoefficients_getElem D R c hj]
  have hz1 : val F r q.WS τ1 0 = 0 := by rw [hk1 0 (by omega) (Or.inl (by omega))]; exact hz
  have hQ1 : τ1.vars qr = Q := by
    rw [hfix1 qr hqr.1 (fun e => hqr.2.2.2 (e ▸ hciL))]; exact hQ
  obtain ⟨τ2, r2, hS2, hres2, hk2, hfix2, harr2, hinp2, hout2⟩ :=
    frob_run M q hq fn hfn qr hqr l hl C Xv A S X1 X2 hC hXv hA hSe hX1 hX2 hS1
      (hev1 C cv hC ecv) (hev1 Xv xv hXv exv) (hev1 A av hA eav) (hev1 S s0 hSe es0)
      (hev1 X1 x1 hX1 ex1) (hev1 X2 x2 hX2 ex2) hD hz1 h5 hcx hxa has hs1 h12 (by omega)
      hQ1 hQB (lowCoefficients D R c).1 hcs
  have hfix12 : ∀ x, x ∉ regNames r → x ≠ q.j → x ≠ q.N → x ∉ fn.list →
      τ2.vars x = σ.vars x := fun x hx hj hN hf =>
    (hfix2 x hx hj hN hf).trans (hfix1 x hx (fun e => hf (e ▸ hciL)))
  have hev2 : ∀ (E : Expr) (v : ℕ), VarsIn l E → E.evalB Bw σ = some v → E.evalB Bw τ2 = some v :=
    fun E v hE h => by
      rw [evalB_congr_varsIn (fun x hx => hfix12 x (hl x hx).1 (hl x hx).2.1 (hl x hx).2.2.1
        (hl x hx).2.2.2) E hE]; exact h
  have hz2 : val F r q.WS τ2 0 = 0 := by
    rw [hk2 0 (by omega) (by omega) (by omega) (by omega) (by omega) (Or.inl (by omega))
      (Or.inl (by omega)) (Or.inl (by omega)) (Or.inl (by omega)) (Or.inl (by omega))]
    exact hz1
  obtain ⟨τ3, r3, hS3, hrow, hk3, hz3, hfix3, harr3, hinp3, hout3⟩ :=
    frobRow_run M q fn.ci l hciS hciW hlc A O T1 T2 hA hO hT1 hT2 Bdeg D i
      (frobeniusResidue (lowCoefficients D R c).1 Q).1 hS2 (hev2 A av hA eav) (hev2 O ov hO eov)
      (hev2 T1 t1 hT1 et1) (hev2 T2 t2 hT2 et2) hz2 hres2 (by omega) ht1 ht12 ht2 hfit
  refine ⟨τ3, (r1.seq (r2.seq r3)).mono le_rfl, hS3, hrow, ?_, hz3, ?_, ?_, ?_, ?_⟩
  · intro s hs h1 h2 h3 h4 hst1 hst2 hso
    have hk : val F r q.WS τ2 s = val F r q.WS σ s := by
      rcases hso with h | h
      · rw [hk2 s hs h1 h2 h3 h4 (Or.inl (by omega)) (Or.inl (by omega)) (Or.inl (by omega))
          (Or.inl (by omega)) (Or.inl (by omega)), hk1 s hs (Or.inl h)]
      · rw [hk2 s hs h1 h2 h3 h4 (Or.inr (by omega)) (Or.inr (by omega)) (Or.inr (by omega))
          (Or.inr (by omega)) (Or.inr (by omega)), hk1 s hs (Or.inr (by omega))]
    have hso' : s < ov ∨ ov + (boundedExponents n Bdeg).length ≤ s := by
      rcases hso with h | h
      · exact Or.inl (by omega)
      · exact Or.inr h
    rw [hk3 s hs hso' hst1 hst2, hk]
  · intro x hx hj hN hf
    rw [hfix3 x hx (fun e => hf (e ▸ hciL)), hfix12 x hx hj hN hf]
  · intro a h1 h2; rw [harr3 a h1 h2, harr2 a h1 h2, harr1 a h1 h2]
  · rw [hinp3, hinp2, hinp1]
  · rw [hout3, hout2, hout1]
theorem coordinateStep_row {n : ℕ} (Q d : ℕ) (vs : List (DenseInput n d K)) (i : Fin n) :
    (coordinateStep Q d vs i).2.1 =
      frobeniusRow (frobeniusDegree n d) (eliminantDegree n d) i
        (frobeniusResidue (eliminantCoefficients d vs i) Q).1 := rfl
