def cost (cs : List Com) (t : Nat) := 4*cs.length+t
theorem run (B : Nat) (cs : List Com) (i k : Nat) (e : Expr) (c : Com)
    (σ τ : Env) (t : Nat) (he : e.evalB B σ=some (i+k))
    (hb : i+cs.length<B) (hk : cs[k]?=some c)
    (hc : Run B c σ τ t) :
    Run B (dispatch cs i e) σ τ ((e.size+3)*cs.length+t) := by
  induction cs generalizing i k with
  | nil => simp at hk
  | cons a as ih =>
    cases k with
    | zero =>
      simp only [List.getElem?_cons_zero,Option.some.injEq] at hk
      subst c
      have hcond : (Cond.eq e (.lit i)).evalB B σ=some true := by
        rw [evalB_condEq he (evalB_lit (by simp only [List.length_cons] at hb; omega))]
        simp
      exact (Run.ite_true (d:=dispatch as (i+1) e) hcond hc).mono (by
        simp only [Cond.size,Expr.size,List.length_cons,Nat.mul_add,Nat.mul_one]; omega)
    | succ k =>
      have he' : e.evalB B σ=some ((i+1)+k) := by simpa only [Nat.succ_eq_add_one,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using he
      have hcond : (Cond.eq e (.lit i)).evalB B σ=some false := by
        rw [evalB_condEq he (evalB_lit (by simp only [List.length_cons] at hb; omega))]
        simp
      have hr := ih (i+1) k he' (by simp only [List.length_cons] at hb; omega)
        (by simpa using hk)
      exact (Run.ite_false (c:=a) hcond hr).mono (by
        simp only [Cond.size,Expr.size,List.length_cons,Nat.mul_add,Nat.mul_one]; omega)
