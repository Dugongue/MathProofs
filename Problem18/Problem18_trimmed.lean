theorem program_run {B n : Nat} {S : Matrix (Fin n) (Fin n) K} {σ : Env}
    (h : State F B S n σ) (hb : WordBounds B n F.e) :
    ∃τ, Run B (program F n) σ τ (cost F n) ∧
      Slots F canonical workspaceName (slots n) B τ ∧
      (∀i<capacity n,val F canonical workspaceName τ (factor n+i)=
        (Problem18VectorAnnihilator20261001.vectorAnnihilator S.toLin'
          (Problem18DeterministicCyclicSweep20261001.sweep S.toLin' n).1).coeff
            (capacity n-1-i)) ∧
      τ.vars Problem18IMPBoundaryDependence20261001.answerReg=
        (Problem18VectorAnnihilator20261001.firstDegree S.toLin'
          (Problem18DeterministicCyclicSweep20261001.sweep S.toLin' n).1).val ∧
      (∀j : Fin n,val F canonical workspaceName τ (candidate n+j.val)=
