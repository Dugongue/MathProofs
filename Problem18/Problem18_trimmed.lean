    ((List.finRange (a*b)).flatMap fun i => (List.finRange (a*b)).map fun j =>
      Problem18P34Frontend20261003Gram.gramExpr (F.transpose*F) (G.transpose*G)
        (finProdFinEquiv.symm i) (finProdFinEquiv.symm j))
  else [.const 1]
theorem zeros (F G : Matrix (Fin c) (Fin a × Fin b) K) (x : OuterVar a b → K) :
    (∀p∈equations F G,p.eval x=0) ↔
