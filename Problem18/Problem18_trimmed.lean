    have hm : (u₀ + (ps.length + 1)) * L = u₀ * L + L + ps.length * L := by ring
    have hm1 : (u₀ + 1) * L = u₀ * L + L := by ring
    have hlen : (rowExprs p d).length = L := by rw [rowExprs_length, hLd]
    have hO' : (plus O (.lit (u₀ * L))).evalB B σ = some (ov + u₀ * L) := by
      unfold plus
      exact evalB_bin hO (evalB_lit (by omega)) (by change ov + u₀ * L < B; omega)
    obtain ⟨τ1, hr1, hS1, hv1, hf1, hx1, har1, hi1, ho1⟩ :=
      polyVec_run M q ci hciS hciW X T l hl hXp hTp (D := D) (by omega) (by omega)
        (fun i hi j hj => by omega) (rowExprs p d) (plus O (.lit (u₀ * L))) (ov + u₀ * L) σ
        ⟨hOp, trivial⟩ hS hX hO' hT (by rw [hlen]; omega)
        (fun i hi j hj => by omega) (fun k hk j hj => by omega)
        (fun e he => hb p List.mem_cons_self e he)
    rw [hlen] at hf1
    have hcong : ∀ E : Expr, VarsIn l E → E.evalB B τ1 = E.evalB B σ := fun E hE =>
      evalB_congr_varsIn (fun x hx => hx1 x (hl x hx).1 (hl x hx).2) E hE
    have hxv1 : ∀ i : Fin c0, val F r q.WS τ1 (xv + i.val) = val F r q.WS σ (xv + i.val) :=
      fun i => hf1 _ (by have := i.isLt; omega) (Or.inl (by have := i.isLt; omega))
        (Or.inl (by have := i.isLt; omega))
    obtain ⟨τ, hr, hS', hvals, hf, hxx, har, hi, ho⟩ :=
      ih (u₀ + 1) τ1 hS1 (by rw [hcong X hXp]; exact hX) (by rw [hcong T hTp]; exact hT)
        (by rw [hcong O hOp]; exact hO)
        (by rw [show u₀ + 1 + ps.length = u₀ + (ps.length + 1) by omega]; exact hfit)
        (fun q' hq e he => hb q' (List.mem_cons_of_mem _ hq) e he)
    have hdata : (fun i : Fin c0 => val F r q.WS τ1 (xv + i.val)) =
        fun i => val F r q.WS σ (xv + i.val) := funext hxv1
    refine ⟨τ, (hr1.seq hr).mono ?_, hS', ?_, ?_, ?_, ?_, ?_, ?_⟩
    · simp only [clauseLoadCost]; omega
    · intro u hu j
      cases u with
      | zero =>
        have hjL : j.val < L := hLd ▸ j.isLt
        have hidx : ov + (u₀ + 0) * L + j.val = ov + u₀ * L + j.val := by simp
        rw [hidx, hf _ (by omega) (Or.inr (by omega)) (Or.inl (by omega))]
        rw [hv1 j.val (by rw [hlen]; exact hjL), read_evaluateTemplate]
        rfl
      | succ u =>
        have := hvals u (by simpa using hu) j
        rw [show u₀ + 1 + u = u₀ + (u + 1) by omega, hdata] at this
        rw [this]
        rfl
    · intro s hs h1 h2
      simp only [List.length_cons] at h2
      rw [hf s hs h1 (by
        rcases h2 with h | h
        · left; omega
        · right; rw [show u₀ + 1 + ps.length = u₀ + (ps.length + 1) by omega]; exact h),
        hf1 s hs (by
        rcases h2 with h | h
        · left; omega
        · right; omega) h1]
    · intro x hx hxc; rw [hxx x hx hxc, hx1 x hx hxc]
    · intro a h1 h2; rw [har a h1 h2, har1 a h1 h2]
    · rw [hi, hi1]
    · rw [ho, ho1]
end Load
open Mathproof.Problem18FixedComponentTest20261001 (clauseRows sysExprs clauseDeg)
open Mathproof.Problem18FiniteParameterDecision20261001
