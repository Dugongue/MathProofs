    (resExpr P c).evalB B σ = some (resVal p c) := by
  cases c with
  | ofNat n =>
    exact modE_eval (evalB_lit (by simpa using hc)) hP (by simpa using hc)
  | negSucc m =>
    have hm : m + 1 < B := by simpa [Int.natAbs_negSucc] using hc
    have h1 := modE_eval (σ := σ) (evalB_lit hm) hP hm
    have h2 : (Expr.bin .sub P (modE (.lit (m + 1)) P)).evalB B σ = some (p - (m + 1) % p) :=
      evalB_bin hP h1 (by change p - (m + 1) % p < B; omega)
    exact modE_eval h2 hP (by omega)
theorem resVal_lt {p : ℕ} (hp : 0 < p) (c : ℤ) : resVal p c < p := by
