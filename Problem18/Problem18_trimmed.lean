  rw [Finset.sum_comm]
  simp only [map_sum,map_mul,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  rw [upperMatrix_symm τ eps hτ heps]
  change τ (y j)*(x i*(eps*τ (upperMatrix τ eps u i j)))=
    eps*(τ (τ (x i))*(τ (y j)*τ (upperMatrix τ eps u i j)))
  rw [hτ]
