    have hpa := majorant_pos a n d e b
    have hpc := majorant_pos c n d e b
    simp only [majorant] at hB
    have h1 : majorant a n d e b < B := (Nat.le_mul_of_pos_right _ hpc).trans_lt hB
    have h2 : majorant c n d e b < B := (Nat.le_mul_of_pos_left _ hpa).trans_lt hB
    have hv := (value_lt (.mul a c) n d e b).trans (by simpa only [majorant] using hB)
    simp only [value] at hv
    have := evalB_bin (op:=.mul) (ha h1) (hc h2) (by simpa [Bop.apply] using hv)
    simpa [expr,value,Bop.apply] using this
