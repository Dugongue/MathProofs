variable {K : Type*} [Field K]
theorem rectangular_rank_card_le_subspaces [Fintype K] (k r s : ℕ) :
    Nat.card {A : Matrix (Fin k) (Fin r) K // A.rank = s} ≤
      Nat.card {W : Submodule K (Fin k → K) // Module.finrank K W = s} *
        Nat.card K ^ (s * r) := by
  classical
  let S := {A : Matrix (Fin k) (Fin r) K // A.rank = s}
  let G := {W : Submodule K (Fin k → K) // Module.finrank K W = s}
  let f : S → G := fun A =>
    ⟨LinearMap.range A.val.mulVecLin, by simpa only [Matrix.rank] using A.property⟩
  have hf (W : G) : Nat.card {A : S // f A = W} ≤ Nat.card K ^ (s * r) := by
    let g : {A : S // f A = W} → (Fin r → W.val) := fun A j =>
      ⟨A.val.val.mulVec (Pi.single j 1), by
        have hj : A.val.val.mulVec (Pi.single j 1) ∈
            LinearMap.range A.val.val.mulVecLin :=
          ⟨Pi.single j 1, rfl⟩
        exact (congrArg Subtype.val A.property) ▸ hj⟩
    have hg : Function.Injective g := by
      intro A B h
      apply Subtype.ext
      apply Subtype.ext
      ext i j
      have hj := congrArg (fun u : Fin r → W.val => (u j).val i) h
      simpa only [g, Matrix.mulVec_single_one, Matrix.col_apply] using hj
    calc
      Nat.card {A : S // f A = W} ≤ Nat.card (Fin r → W.val) :=
        Nat.card_le_card_of_injective g hg
      _ = Nat.card W.val ^ r := by rw [Nat.card_fun, Nat.card_fin]
      _ = (Nat.card K ^ s) ^ r := by
        rw [Module.natCard_eq_pow_finrank (K := K), W.property]
      _ = Nat.card K ^ (s * r) := by rw [pow_mul]
  letI : Fintype G := Fintype.ofFinite G
  have he := Fintype.card_congr (Equiv.sigmaFiberEquiv f)
  rw [Fintype.card_sigma] at he
  simp only [Nat.card_eq_fintype_card] at hf ⊢
  rw [← he]
  calc
    _ ≤ ∑ _W : G, Fintype.card K ^ (s * r) :=
      Finset.sum_le_sum (fun W _ => hf W)
    _ = _ := by simp [G]
theorem rectangular_rank_count_bound [Fintype K] (k r s : ℕ) (hs : s ≤ k) :
    (Nat.card {A : Matrix (Fin k) (Fin r) K // A.rank = s} : ℝ) ≤
      4 * (Fintype.card K : ℝ) ^ (s * (k - s) + s * r) := by
  have hsub := Mathproof.Problem18Grassmann20260929.subspace_card_bound
    (K := K) k s hs
  have hcard := rectangular_rank_card_le_subspaces (K := K) k r s
  have hcard' :
      Nat.card {A : Matrix (Fin k) (Fin r) K // A.rank = s} ≤
        Nat.card {W : Submodule K (Fin k → K) // Module.finrank K W = s} *
          Fintype.card K ^ (s * r) := by
    simpa only [Nat.card_eq_fintype_card] using hcard
  have hcardR :
      (Nat.card {A : Matrix (Fin k) (Fin r) K // A.rank = s} : ℝ) ≤
        (Nat.card {W : Submodule K (Fin k → K) // Module.finrank K W = s} : ℝ) *
          (Fintype.card K : ℝ) ^ (s * r) := by
    exact_mod_cast hcard'
  calc
    _ ≤ (Nat.card {W : Submodule K (Fin k → K) // Module.finrank K W = s} : ℝ) *
          (Fintype.card K : ℝ) ^ (s * r) := hcardR
    _ ≤ (4 * (Fintype.card K : ℝ) ^ (s * (k - s))) *
          (Fintype.card K : ℝ) ^ (s * r) :=
      mul_le_mul_of_nonneg_right hsub (by positivity)
    _ = _ := by rw [mul_assoc, ← pow_add]
theorem rank_stratum_cross_weight_bound [Fintype K]
    (k r z s : ℕ) (hsk : s ≤ k) (hsr : s ≤ r) :
    (Nat.card {A : Matrix (Fin k) (Fin r) K // A.rank = s} : ℝ) /
          Fintype.card (Matrix (Fin k) (Fin r) K) *
        ((Fintype.card K : ℝ) ^ (s * z))⁻¹ ≤
      4 * ((Fintype.card K : ℝ) ^
        ((k - s) * (r - s) + s * z))⁻¹ := by
  let q : ℝ := Fintype.card K
  have hq : 0 < q := by positivity
  have hcount := rectangular_rank_count_bound (K := K) k r s hsk
  have hcardNat : Fintype.card (Matrix (Fin k) (Fin r) K) =
      Fintype.card K ^ (k * r) := by
    change Fintype.card (Fin k → Fin r → K) = _
    rw [Fintype.card_fun, Fintype.card_fun, Fintype.card_fin, Fintype.card_fin,
      ← pow_mul, Nat.mul_comm r k]
  have hcard : (Fintype.card (Matrix (Fin k) (Fin r) K) : ℝ) = q ^ (k * r) := by
    dsimp only [q]
    exact_mod_cast hcardNat
  rw [hcard]
  have hnonneg : 0 ≤ (q ^ (s * z))⁻¹ := by positivity
  have hdiv :
      (Nat.card {A : Matrix (Fin k) (Fin r) K // A.rank = s} : ℝ) /
          q ^ (k * r) ≤
        (4 * q ^ (s * (k - s) + s * r)) / q ^ (k * r) :=
    div_le_div_of_nonneg_right hcount (by positivity)
  calc
    _ ≤ ((4 * q ^ (s * (k - s) + s * r)) / q ^ (k * r)) *
          (q ^ (s * z))⁻¹ := mul_le_mul_of_nonneg_right hdiv hnonneg
    _ = 4 * (q ^ ((k - s) * (r - s) + s * z))⁻¹ := by
      have hexp :
          (s * (k - s) + s * r) + ((k - s) * (r - s) + s * z) =
            k * r + s * z := by
        apply Nat.cast_injective (R := ℤ)
        push_cast [hsk, hsr]
        ring
      rw [div_eq_mul_inv]
      field_simp [ne_of_gt hq]
      rw [← pow_add, hexp, pow_add]
theorem rank_stratum_cross_weight_largeComplement [Fintype K]
    (k r z s n : ℕ) (hsk : s ≤ k) (hsr : s ≤ r)
    (hkn : 2 * k ≤ n) (hrn : 2 * r ≤ n) (hzn : n ≤ 4 * z) :
    (Nat.card {A : Matrix (Fin k) (Fin r) K // A.rank = s} : ℝ) /
          Fintype.card (Matrix (Fin k) (Fin r) K) *
        ((Fintype.card K : ℝ) ^ (s * z))⁻¹ ≤
      4 * ((Fintype.card K : ℝ) ^ ((k * r) / 8))⁻¹ := by
  let q : ℝ := Fintype.card K
  have hq : 0 < q := by positivity
  have hterm := rank_stratum_cross_weight_bound (K := K) k r z s hsk hsr
  have hcross := Mathproof.Problem18Bounds20260929.crossRank_largeComplement
    (k : ℝ) (r : ℝ) (z : ℝ) (s : ℝ) (n : ℝ)
    (by positivity) (by positivity) (by positivity) (by positivity)
    (by exact_mod_cast hsk) (by exact_mod_cast hsr)
    (by exact_mod_cast hkn) (by exact_mod_cast hrn) (by exact_mod_cast hzn)
  let E := (k - s) * (r - s) + s * z
  have hE : (E : ℝ) =
      ((k : ℝ) - s) * ((r : ℝ) - s) + s * z := by
    dsimp only [E]
    push_cast [hsk, hsr]
    rfl
  have hmulR : (k * r : ℝ) ≤ 8 * (E : ℝ) := by
    rw [hE]
    nlinarith
  have hmul : k * r ≤ 8 * E := by exact_mod_cast hmulR
  have hdiv : (k * r) / 8 ≤ E := Nat.div_le_of_le_mul hmul
  have hq1 : (1 : ℝ) ≤ q := by
    have hq2 : (2 : ℝ) ≤ q := by
      dsimp only [q]
      exact_mod_cast Fintype.one_lt_card (α := K)
    linarith
  have hpow : q ^ ((k * r) / 8) ≤ q ^ E :=
    pow_le_pow_right₀ hq1 hdiv
  have hinv : (q ^ E)⁻¹ ≤ (q ^ ((k * r) / 8))⁻¹ := by
    simpa only [one_div] using one_div_le_one_div_of_le (pow_pos hq _) hpow
  calc
    _ ≤ 4 * (q ^ E)⁻¹ := by simpa only [q, E] using hterm
    _ ≤ 4 * (q ^ ((k * r) / 8))⁻¹ :=
      mul_le_mul_of_nonneg_left hinv (by norm_num)
theorem cross_rank_sum_largeComplement [Fintype K]
    (k r z n : ℕ) (hkn : 2 * k ≤ n) (hrn : 2 * r ≤ n)
    (hzn : n ≤ 4 * z) :
    (∑ s : Fin (min k r + 1),
      (Nat.card {A : Matrix (Fin k) (Fin r) K // A.rank = s.val} : ℝ) /
          Fintype.card (Matrix (Fin k) (Fin r) K) *
        ((Fintype.card K : ℝ) ^ (s.val * z))⁻¹) ≤
      4 * (k + 1) * ((Fintype.card K : ℝ) ^ ((k * r) / 8))⁻¹ := by
  have hterm (s : Fin (min k r + 1)) :
      (Nat.card {A : Matrix (Fin k) (Fin r) K // A.rank = s.val} : ℝ) /
            Fintype.card (Matrix (Fin k) (Fin r) K) *
          ((Fintype.card K : ℝ) ^ (s.val * z))⁻¹ ≤
        4 * ((Fintype.card K : ℝ) ^ ((k * r) / 8))⁻¹ := by
    have hsmin : s.val ≤ min k r := by omega
    exact rank_stratum_cross_weight_largeComplement (K := K)
      k r z s.val n (hsmin.trans (min_le_left _ _))
      (hsmin.trans (min_le_right _ _)) hkn hrn hzn
  calc
    _ ≤ ∑ _s : Fin (min k r + 1),
          4 * ((Fintype.card K : ℝ) ^ ((k * r) / 8))⁻¹ :=
      Finset.sum_le_sum fun s _ => hterm s
    _ = (min k r + 1) *
          (4 * ((Fintype.card K : ℝ) ^ ((k * r) / 8))⁻¹) := by simp
    _ ≤ (k + 1) *
          (4 * ((Fintype.card K : ℝ) ^ ((k * r) / 8))⁻¹) := by
      gcongr
      exact_mod_cast min_le_left k r
    _ = _ := by ring
end Mathproof.Problem18AnchorRankStrata20260930
