    RawGood u q A ↔ RawGood u q B := by
  obtain ⟨P,Q,R,hP,hQ,hR,rfl⟩:=h
  rw [rawGood_iff u q hs,rawGood_iff u q hs]
  exact (good_action_iff A P Q R ((root_isometry_iff u q hs P).mp hP)
    ((root_isometry_iff u q hs Q).mp hQ) ((root_isometry_iff u q hs R).mp hR)).symm
