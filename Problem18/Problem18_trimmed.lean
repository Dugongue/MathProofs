  obtain ⟨τ,hr4,hSτ,hout,hframe4,hvars4,harr4,hi4,ho4⟩ :=
    target_run (fieldMacros F) names.q gatherNames hg n d d (compress rows).1
      (B:=B) (Sn:=Sn) (iv:=inStart N 0) (ov:=5) (σ:=σ3) hS3 hz3
      (by simp [σ3, gatherNames, hlen]) (by simp [σ3, gatherNames])
      (by simp [σ3, gatherNames]) (by omega)
      (by
        rw [hlen]
        change 5 + c * N ≤ inStart N 0
