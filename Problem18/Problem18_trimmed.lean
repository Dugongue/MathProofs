    (p : PolyExpr (Fin (boxSize n d * boxSize n d) ⊕
      Fin (pat.1 * boxSize n (cpE n d) + 1)) Int)
    (hp : p ∈ sysExprs cl)
    (e : PolyExpr (Fin (boxSize n d * boxSize n d)) Int)
    (he : e ∈ rowExprs p (clauseDeg cl)) :
    polyDepth e ≤ requiredDepth n d := by
  apply le_maxList_of_mem
  simp only [depthValues, List.mem_flatMap, List.mem_map]
  exact ⟨pat, hpat, cl, hcl, p, hp, e, he, rfl⟩
theorem const_bound_lt (n d B : Nat)
    (hB : requiredWord n d < B)
    (pat : Σ k : Nat, Fin k → Fin (boxSize n (cpE n d)))
    (hpat : pat ∈ patterns (boxSize n (cpE n d)))
    (cl : Clause (Fin (boxSize n d * boxSize n d +
      pat.1 * boxSize n (cpE n d))) Int)
    (hcl : cl ∈ clauses (qe (template n d pat)))
    (p : PolyExpr (Fin (boxSize n d * boxSize n d) ⊕
