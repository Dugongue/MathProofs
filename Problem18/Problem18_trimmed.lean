variable {F : Type*} [Field F]
private theorem sq_eq_one_iff_mem_signs (a : F) : a ^ 2 = 1 ↔ a ∈ ({1, -1} : Finset F) := by
  rw [Finset.mem_insert, Finset.mem_singleton]
  rw [sq]
  exact mul_self_eq_one_iff
def squareOneEquivSigns : {a : F // a ^ 2 = 1} ≃ (↑({1, -1} : Finset F) : Type _) where
  toFun a := ⟨a.1, (sq_eq_one_iff_mem_signs a.1).1 a.2⟩
  invFun a := ⟨a.1, (sq_eq_one_iff_mem_signs a.1).2 a.2⟩
  left_inv _ := Subtype.ext rfl
  right_inv _ := Subtype.ext rfl
private theorem one_eq_neg_one_iff : (1 : F) = -1 ↔ (2 : F) = 0 := by
  rw [eq_neg_iff_add_eq_zero, one_add_one_eq_two]
theorem card_squareOne : Nat.card {a : F // a ^ 2 = 1} = if (2 : F) = 0 then 1 else 2 := by
  rw [Nat.card_congr (squareOneEquivSigns (F := F)), Nat.card_eq_fintype_card,
    Fintype.card_coe]
  split_ifs with h2
  · have h1 : (1 : F) = -1 := one_eq_neg_one_iff.2 h2
    rw [← h1]
    simp
  · have h1 : (1 : F) ≠ -1 := fun h => h2 (one_eq_neg_one_iff.1 h)
    exact Finset.card_pair h1
def squareOneUnitsEquiv : rootsOfUnity 2 F ≃ {a : F // a^2 = 1} where
  toFun a := ⟨(a.1 : F), (mem_rootsOfUnity' 2 a.1).1 a.2⟩
  invFun a :=
    ⟨Units.mk0 a.1 (by
        intro h0
        have h := a.2
        rw [h0] at h
        norm_num at h),
      (mem_rootsOfUnity' 2 _).2 a.2⟩
  left_inv a := Subtype.ext (Units.ext rfl)
  right_inv a := Subtype.ext rfl
theorem card_squareOneUnits : Nat.card (rootsOfUnity 2 F) = if (2 : F) = 0 then 1 else 2 := by
  rw [Nat.card_congr (squareOneUnitsEquiv (F := F)), card_squareOne]
variable (F)
theorem card_squareClass [Finite F] : Nat.card (SquareClass F) = if (2 : F) = 0 then 1 else 2 := by
  rw [← card_squareOneUnits (F := F)]
  let f : Fˣ →* Fˣ := powMonoidHom 2
  have h1 : Nat.card (squareUnits F) * (squareUnits F).index = Nat.card Fˣ :=
    (squareUnits F).card_mul_index
  have h2 : Nat.card f.ker * f.ker.index = Nat.card Fˣ := f.ker.card_mul_index
  rw [Subgroup.index_ker] at h2
  have hpos : 0 < Nat.card (squareUnits F) := Nat.card_pos
  have hker : f.ker = rootsOfUnity 2 F := (rootsOfUnity_eq_ker).symm
  have hidx : (squareUnits F).index = Nat.card f.ker := by
    have h3 : Nat.card (squareUnits F) * (squareUnits F).index =
        Nat.card (squareUnits F) * Nat.card f.ker := by
      rw [h1, ← h2, mul_comm]
      rfl
    exact Nat.eq_of_mul_eq_mul_left hpos h3
  rw [← hker, ← hidx]
  rfl
end Mathproof.Problem18AtlasSquareClassCard20261001
