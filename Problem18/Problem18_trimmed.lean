    let M : SpectralMarkings σ B C f N.2.2.val :=
      ⟨N.2.1,⟨N.1.val,N.1.property,N.2.2.property⟩⟩
    ⟨⟨N.2.2.val,⟨M⟩⟩,M⟩
  invFun N := ⟨⟨N.2.2.val,N.2.2.property.1⟩,N.2.1,⟨N.1.val,N.2.2.property.2⟩⟩
  left_inv _ := rfl
  right_inv _ := rfl
