  have ea : address F ρ baseA strideA (ρ.vars index)=address F σ baseA strideA (ρ.vars index) := by
    simp only [address,regs baseA (by simp),regs strideA (by simp)]
  have eb : address F ρ baseB strideB (ρ.vars index)=address F σ baseB strideB (ρ.vars index) := by
    simp only [address,regs baseB (by simp),regs strideB (by simp)]
