  have kp : ∀ x ∈ pairRegs ++ [canonical.e, canonical.p, canonical.modBase],
      τ.vars x = σ4.vars x := fun x hx => hfr.1 x (program_keeps x hx)
  have k4 : ∀ x ∈ pairRegs, σ4.vars x = σ3.vars x := by
    intro x hx
    have hne := setup_not_pair x hx
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hne
    simp only [σ4, s5, s4, s3, s2, s1]
    rw [sv _ _ _ _ hne.2.2.2.2.2, sv _ _ _ _ hne.2.2.2.2.1, sv _ _ _ _ hne.2.2.2.1,
      sv _ _ _ _ hne.2.2.1, sv _ _ _ _ hne.2.1, sv _ _ _ _ hne.1]
  have k4e : ∀ x ∈ [canonical.e, canonical.p, canonical.modBase], σ4.vars x = σ3.vars x := by
    intro x hx
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl <;>
    · simp only [σ4, s5, s4, s3, s2, s1]
      rw [sv _ _ _ _ (by decide), sv _ _ _ _ (by decide), sv _ _ _ _ (by decide),
        sv _ _ _ _ (by decide), sv _ _ _ _ (by decide), sv _ _ _ _ (by decide)]
  have hGτ : Glob F W Sn bankLen τ := by
    apply Glob.transfer F hG3
    · rw [kp _ (by simp), k4e _ (by simp)]
    · rw [kp _ (by simp), k4e _ (by simp)]
    · rw [kp _ (by simp), k4e _ (by simp)]
    · intro i
      have h1 := hSτ.base.modulus_value i
      rw [kp _ (by simp), hmod4, Nat.zero_add] at h1
      rw [h1, hG3.modulus i]
    · intro arr; rw [hfr.2.2.1 arr, harr4]
  refine ⟨τ, ?_, hGτ, hSτ, ?_, hdec, ?_, ?_, hiτ.trans (hi3.trans (hi2.trans hi1)), hoτ.trans (ho3.trans (ho2.trans ho1))⟩
  · have hall := hr1.seq (hr2.seq (hr3.seq (r1.seq (r2.seq (r3.seq (r4.seq (r5.seq
      (r6.seq hrun))))))))
    apply hall.mono
    simp only [interCost, Expr.size, physE, famWords]
    omega
  · rw [hfr.1 _ program_keeps_ws, hws4]
  · rw [hfr.2.1 _ program_keeps_bank, harr4, hb3]
  · intro x hx
    rw [kp x (by simp [hx]), k4 x hx, k3 x hx]
end Run
end
