variable {K : Type*} [Field K] [Fintype K] [CharP K 2] {a n : ℕ}
theorem repeated_diagonal_moment_le (i₀ : Fin a)
    (Q : QuadraticForm K (Fin n → K)) (E : Submodule K (Fin a → Fin n → K))
    (ψ : AddChar K ℂ) (hψ : ψ ≠ 1) (m : ℕ) (hm : 1 ≤ m) :
    (∑ d : Fin n → K,
      (‖(∑ x : E, ψ (∑ i, completion Q d (x.val i))) / (Fintype.card E : ℂ)‖^2)^m) ≤
      (Fintype.card K : ℝ)^(Module.finrank K (LinearMap.range Q.polarBilin) +
        (a*n - Module.finrank K E)) *
      (((Fintype.card K : ℝ)^Module.finrank K (LinearMap.range
        ((QuadraticMap.pi (fun _ : Fin a => Q)).comp E.subtype).polarBilin))⁻¹)^m := by
  let A (d : Fin n → K) : ℝ :=
    ‖(∑ x : E, ψ (∑ i, completion Q d (x.val i))) / (Fintype.card E : ℂ)‖^2
  let c : ℝ := ((Fintype.card K : ℝ)^Module.finrank K (LinearMap.range
    ((QuadraticMap.pi (fun _ : Fin a => Q)).comp E.subtype).polarBilin))⁻¹
  have hd (d : Fin n → K) : A d = 0 ∨ A d = c :=
    repeated_diagonal_dichotomy Q E ψ hψ d
  have hs : (∑ d, (A d)^m) =
      ((Finset.univ.filter (fun d => A d ≠ 0)).card : ℝ) * c^m := by
    calc
      _ = ∑ d : Fin n → K, if A d ≠ 0 then c^m else 0 := by
        apply Finset.sum_congr rfl
        intro d _
        by_cases hz : A d = 0
        · simp [hz, (show m ≠ 0 by omega)]
        · rw [if_pos hz, (hd d).resolve_left hz]
      _ = _ := by simp [Finset.sum_ite]
  have hc : (Fintype.card E : ℂ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hfilter : Finset.univ.filter (fun d : Fin n → K => A d ≠ 0) =
      Finset.univ.filter (fun d : Fin n → K =>
        (∑ x : E, ψ (∑ i, completion Q d (x.val i))) ≠ 0) := by
    ext d
    simp [A, hc]
  have hb := repeated_diagonal_support_le i₀ Q E ψ hψ
  have hbR : ((Finset.univ.filter (fun d : Fin n → K => A d ≠ 0)).card : ℝ) ≤
      (Fintype.card K : ℝ)^(Module.finrank K (LinearMap.range Q.polarBilin) +
        (a*n - Module.finrank K E)) := by
    rw [hfilter]
    exact_mod_cast hb
