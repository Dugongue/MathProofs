variable {K V : Type*} [Field K] [Fintype K] [CharP K 2]
  [AddCommGroup V] [Module K V] [Finite V] [FiniteDimensional K V]
theorem canonical_ne_zero (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (hn : B.Nondegenerate) (hna : ¬B.IsAlt) : canonicalVector B hn hB≠0 := by
  intro he
  apply hna
  intro x
  rw [canonicalVector_diagonal B hn hB,he,map_zero,zero_pow (by decide : 2≠0)]
theorem exists_unit (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (hn : B.Nondegenerate) (hna : ¬B.IsAlt) : ∃ x,B x x=1 := by
  let e := canonicalVector B hn hB
  have he : e≠0 := canonical_ne_zero B hB hn hna
  have hf : B e≠0 := by
    intro hh
    apply he
    apply hn.1
    intro x
    rw [hh]
    rfl
  obtain ⟨x,hx⟩ := LinearMap.surjective hf (1:K)
  refine ⟨x,?_⟩
  rw [canonicalVector_diagonal B hn hB,hB.eq x e,hx,one_pow]
theorem exists_unit_ne_canonical (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (hn : B.Nondegenerate) (hna : ¬B.IsAlt) (hd : 2≤finrank K V) :
    ∃ x,B x x=1 ∧ x≠canonicalVector B hn hB := by
  classical
  let e := canonicalVector B hn hB
  have he : e≠0 := canonical_ne_zero B hB hn hna
  have hf : B e≠0 := by
    intro hh
    apply he
    apply hn.1
    intro x
    rw [hh]
    rfl
  have hdim := Module.Dual.finrank_ker_add_one_of_ne_zero hf
  have hpos : 0<finrank K (LinearMap.ker (B e)) := by omega
  letI : Nontrivial (LinearMap.ker (B e)) := finrank_pos_iff.mp hpos
  obtain ⟨u,hu⟩ := exists_ne (0 : LinearMap.ker (B e))
  obtain ⟨x,hx⟩ := LinearMap.surjective hf (1:K)
  have unit_of_pair (z : V) (hz : B e z=1) : B z z=1 := by
    rw [canonicalVector_diagonal B hn hB,hB.eq z e,hz,one_pow]
  by_cases hxe : x=e
  · refine ⟨x+u,unit_of_pair _ ?_,?_⟩
    · rw [map_add,LinearMap.mem_ker.mp u.property,hx,add_zero]
    · intro hh
      apply hu
      apply Subtype.ext
      change (u:V)=0
      have hz : x+(u:V)=x := hh.trans hxe.symm
      exact add_left_cancel (hz.trans (add_zero x).symm)
  · exact ⟨x,unit_of_pair x hx,hxe⟩
theorem unit_complement_nonalternating (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (hn : B.Nondegenerate) (x : V) (hx : B x x=1)
    (hne : x≠canonicalVector B hn hB) :
    ¬(B.restrict (B.orthogonal (K ∙ x))).IsAlt := by
  let e := canonicalVector B hn hB
  have hxe : B x e=1 := by
    apply CharTwo.sq_injective
    change (B x (canonicalVector B hn hB))^2=1^2
    rw [← canonicalVector_diagonal B hn hB,hx,one_pow]
  have hx0 : B x x≠0 := by rw [hx]; exact one_ne_zero
  have hreg := LinearMap.BilinForm.restrict_nondegenerate_orthogonal_spanSingleton B hn hB.isRefl hx0
  have hzmem : e-x∈B.orthogonal (K ∙ x) := by
    intro y hy
    obtain ⟨a,rfl⟩ := Submodule.mem_span_singleton.mp hy
    simp only [map_smul,LinearMap.smul_apply,smul_eq_mul,map_sub,hxe,hx,sub_self,mul_zero]
  let z : B.orthogonal (K ∙ x) := ⟨e-x,hzmem⟩
  intro halt
  have hz : z=0 := by
    apply hreg.2
    intro u
    have hu : B (u:V) e=0 := by
      apply sq_eq_zero_iff.mp
      rw [← canonicalVector_diagonal B hn hB]
      exact halt u
    have hux : B (u:V) x=0 := hB.isRefl _ _ (u.property x (Submodule.mem_span_singleton_self x))
    change B (u:V) (e-x)=0
    rw [map_sub,hu,hux,sub_self]
  apply hne
  have hh : e-x=0 := congrArg (fun u : B.orthogonal (K ∙ x) => (u:V)) hz
  exact (sub_eq_zero.mp hh).symm
theorem exists_good_unit (D : LinearMap.BilinForm K V) (hs : D.IsSymm)
    (hn : D.Nondegenerate) (ha : ¬D.IsAlt) :
    ∃ x,D x x=1 ∧ (2≤finrank K V → x≠canonicalVector D hn hs) := by
  by_cases ht : 2≤finrank K V
  · obtain ⟨x,hx,he⟩ := exists_unit_ne_canonical D hs hn ha ht
    exact ⟨x,hx,fun _ => he⟩
  · obtain ⟨x,hx⟩ := exists_unit D hs hn ha
    exact ⟨x,hx,fun hh => (ht hh).elim⟩
variable {W : Type*} [AddCommGroup W] [Module K W] [Finite W] [FiniteDimensional K W]
theorem unit_lines_isometric (B : LinearMap.BilinForm K V) (C : LinearMap.BilinForm K W)
    (x : V) (y : W) (hx : B x x=1) (hy : C y y=1) :
    ∃ i : (K ∙ x) ≃ₗ[K] (K ∙ y),∀ a b,C (i a:W) (i b:W)=B (a:V) (b:V) := by
  have hx0 : x≠0 := by intro hh; simpa [hh] using hx
  have hy0 : y≠0 := by intro hh; simpa [hh] using hy
  let eV := LinearEquiv.toSpanNonzeroSingleton K V x hx0
  let eW := LinearEquiv.toSpanNonzeroSingleton K W y hy0
  refine ⟨eV.symm.trans eW,?_⟩
  intro a b
  obtain ⟨a,rfl⟩ := eV.surjective a
  obtain ⟨b,rfl⟩ := eV.surjective b
  simp only [LinearEquiv.trans_apply,LinearEquiv.symm_apply_apply]
  change C (a • y) (b • y)=B (a • x) (b • x)
  simp only [map_smul,LinearMap.smul_apply,smul_eq_mul,hx,hy]
theorem nonalternating_isometry_of_finrank_eq
    (B : LinearMap.BilinForm K V) (C : LinearMap.BilinForm K W)
    (hB : B.IsSymm) (hC : C.IsSymm) (hnB : B.Nondegenerate) (hnC : C.Nondegenerate)
    (haB : ¬B.IsAlt) (haC : ¬C.IsAlt) (hdim : finrank K V=finrank K W) :
    ∃ i : V ≃ₗ[K] W,∀ x y,C (i x) (i y)=B x y := by
  classical
  generalize hd : finrank K V=d
  induction d using Nat.strong_induction_on generalizing V W with
  | h d ih =>
    by_cases hd0 : d=0
    · letI : Subsingleton V := finrank_zero_iff.mp (hd.trans hd0)
      letI : Subsingleton W := finrank_zero_iff.mp (hdim.symm.trans (hd.trans hd0))
      exact ⟨LinearEquiv.ofSubsingleton V W,by intro x y; have hx : x=0 := Subsingleton.elim _ _; simp [hx]⟩
    obtain ⟨x,hx,hxe⟩ := exists_good_unit B hB hnB haB
    obtain ⟨y,hy,hye⟩ := exists_good_unit C hC hnC haC
    have hx0 : x≠0 := by intro hh; simpa [hh] using hx
    have hy0 : y≠0 := by intro hh; simpa [hh] using hy
    have hxB : B x x≠0 := by rw [hx]; exact one_ne_zero
    have hyC : C y y≠0 := by rw [hy]; exact one_ne_zero
    let P := K ∙ x
    let Q := B.orthogonal P
    let P' := K ∙ y
    let Q' := C.orthogonal P'
    have hcV : IsCompl P Q := LinearMap.BilinForm.isCompl_span_singleton_orthogonal hxB
    have hcW : IsCompl P' Q' := LinearMap.BilinForm.isCompl_span_singleton_orthogonal hyC
    have hqV : finrank K Q+1=finrank K V := by
      have hh := Submodule.finrank_add_eq_of_isCompl hcV
      have hp : finrank K P=1 := finrank_span_singleton hx0
      omega
    have hqW : finrank K Q'+1=finrank K W := by
      have hh := Submodule.finrank_add_eq_of_isCompl hcW
      have hp : finrank K P'=1 := finrank_span_singleton hy0
      omega
    have hnQ : (B.restrict Q).Nondegenerate :=
      LinearMap.BilinForm.restrict_nondegenerate_orthogonal_spanSingleton B hnB hB.isRefl hxB
    have hnQ' : (C.restrict Q').Nondegenerate :=
      LinearMap.BilinForm.restrict_nondegenerate_orthogonal_spanSingleton C hnC hC.isRefl hyC
    have hdQQ : finrank K Q=finrank K Q' := by omega
    have hlt : finrank K Q<d := by omega
    have hj : ∃ j : Q ≃ₗ[K] Q',∀ u v,C (j u:W) (j v:W)=B (u:V) (v:V) := by
      by_cases hq0 : finrank K Q=0
      · letI : Subsingleton Q := finrank_zero_iff.mp hq0
        letI : Subsingleton Q' := finrank_zero_iff.mp (hdQQ.symm.trans hq0)
        refine ⟨LinearEquiv.ofSubsingleton Q Q',?_⟩
        intro u v
        have hu : u=0 := Subsingleton.elim _ _
        simp [hu]
      · have haQ : ¬(B.restrict Q).IsAlt := unit_complement_nonalternating B hB hnB x hx (hxe (by omega))
        have haQ' : ¬(C.restrict Q').IsAlt := unit_complement_nonalternating C hC hnC y hy (hye (by omega))
