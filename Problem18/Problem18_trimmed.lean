theorem trace_key {a b c t s r i : Nat} (ht : t<c) (hs : s<b) (hr : r<b) (hi : i<a) :
    t*(2*((a*b)*(a*b))) + (s*(a*b)+r) + i*(b*((a*b)+1)) + 1 ≤ c*(2*((a*b)*(a*b))) := by
  have h1 : i*b+s+1 ≤ a*b := by nlinarith
  have h2 : i*b+r+1 ≤ a*b := by nlinarith
  have h3 : (i*b+s)*(a*b) + (i*b+r) + 1 ≤ (a*b)*(a*b) := by
    have h3a := Nat.mul_le_mul_right (a*b) h1
    have h3b : (i*b+s+1)*(a*b) = (i*b+s)*(a*b) + a*b := by ring
    pomega
  have h4 : t + 1 ≤ c := ht
  have h5 : (t+1)*(2*((a*b)*(a*b))) ≤ c*(2*((a*b)*(a*b))) := Nat.mul_le_mul_right _ h4
  have eq : t*(2*((a*b)*(a*b))) + (s*(a*b)+r) + i*(b*((a*b)+1)) + 1 =
      t*(2*((a*b)*(a*b))) + ((i*b+s)*(a*b) + (i*b+r) + 1) := by ring
  rw [eq]; nlinarith
theorem trace_bound {a b c e t s r i : Nat} (ht : t<c) (hs : s<b) (hr : r<b) (hi : i<a) :
    e*(t*(2*((a*b)*(a*b))) + (s*(a*b)+r)) + e*(i*(b*((a*b)+1))) + e ≤
      c*(2*(e*((a*b)*(a*b)))) := by
  have k := Nat.mul_le_mul_left e (trace_key (a:=a) ht hs hr hi)
  have eq1 : e*(t*(2*((a*b)*(a*b))) + (s*(a*b)+r)) + e*(i*(b*((a*b)+1))) + e =
      e*(t*(2*((a*b)*(a*b))) + (s*(a*b)+r) + i*(b*((a*b)+1)) + 1) := by ring
  have eq2 : c*(2*(e*((a*b)*(a*b)))) = e*(c*(2*((a*b)*(a*b)))) := by ring
  rw [eq1, eq2]; exact k
theorem flat_decomp {b c : Nat} (t : Fin c) (r s : Fin b) :
    let x := (t.val*b+s.val)*b+r.val
    x/(b*b) = t.val ∧ (x/b)%b = s.val ∧ x%b = r.val := by
  intro x
  have hb : 0 < b := Nat.zero_lt_of_lt r.isLt
  have e1 : x/b = t.val*b+s.val := by
    show ((t.val*b+s.val)*b+r.val)/b = _
    rw [Nat.add_comm, Nat.add_mul_div_right _ _ hb, Nat.div_eq_of_lt r.isLt]; simp
  have e2 : x%b = r.val := by
    show ((t.val*b+s.val)*b+r.val)%b = _
    rw [Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt r.isLt]
  refine ⟨?_, ?_, e2⟩
  · rw [← Nat.div_div_eq_div_mul, e1, Nat.add_comm, Nat.add_mul_div_right _ _ hb,
      Nat.div_eq_of_lt s.isLt]; simp
  · rw [e1, Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt s.isLt]
theorem cursor_decomp_lt {b c x : Nat} (hx : x < c*b*b) (hb : 0 < b) :
    x/(b*b) < c ∧ (x/b)%b < b ∧ x%b < b := by
  refine ⟨?_, Nat.mod_lt _ hb, Nat.mod_lt _ hb⟩
  apply (Nat.div_lt_iff_lt_mul (Nat.mul_pos hb hb)).mpr
  calc x < c*b*b := hx
    _ = c*(b*b) := by ring
end tracearith
