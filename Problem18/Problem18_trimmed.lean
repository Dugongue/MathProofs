      2*(Nat.card (Operators g B)*(∏ i,(Nat.card K^(g i).natDegree-1))) := by ring
    _ = _ := by rw [hcount,← hc]; ring
theorem charTwo_coefficients_representable [CharP K 2]
    (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hnB : B.Nondegenerate) (haB : ¬B.IsAlt)
    (hdim : Module.finrank K V=∑ i,(g i).natDegree) (c : Coefficients g) :
    ∃ e : (∀ i,AdjoinRoot (g i)) ≃ₗ[K] V,∀ x y,B (e x) (e y)=
      modelTraceForm g (fun i => (c i).val) x y := by
  letI : Finite V := Finite.of_injective (Module.finBasis K V).equivFun
    (Module.finBasis K V).equivFun.injective
