    simp [hne]
theorem descending_coefficient {d N : Nat} (c : Fin d→K) (hd : d<N) (i : Fin N) :
    (X^d-∑j:Fin d,C (c j)*X^j.val).coeff (N-1-i.val)=
      if i.val=N-1-d then 1 else
        if h:N-1-i.val<d then -c ⟨N-1-i.val,h⟩ else 0 := by
