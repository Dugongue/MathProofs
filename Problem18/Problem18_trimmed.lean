open Lax51.BinaryWordEncoding
variable {K : Type} [Field K] (F : FieldPresentation K)
theorem input_parameters_le (a b : K) (q : Nat) :
    F.e≤bitSize (fieldInput F a b q) ∧ F.p.size≤bitSize (fieldInput F a b q) ∧
    q.size≤bitSize (fieldInput F a b q) := by
  have hl:=Lax51Proofs.Encoding.length_le_bitSize (fieldInput F a b q)
  rw [fieldInput_length] at hl
  have hp:=Lax51Proofs.Encoding.bits_length_add_one_le_bitSize_of_mem
    (show F.p∈fieldInput F a b q by simp [fieldInput])
  have hq:=Lax51Proofs.Encoding.bits_length_add_one_le_bitSize_of_mem
    (show q∈fieldInput F a b q by simp [fieldInput])
  rw [Nat.size_eq_bits_len] at hp hq
  omega
theorem fieldWordWidth_le {L q : Nat} (he : F.e≤L) (hp : F.p.size≤L) (hq : q.size≤L) :
    fieldWordWidth F.p F.e (16*(F.e+1)) q≤100*(L+1)^2 := by
  have hs : (16*(F.e+1)).size≤16*(F.e+1) := Nat.size_le.mpr (Nat.lt_two_pow_self)
  have hm:=Nat.mul_le_mul (Nat.add_le_add_right he 1) (Nat.add_le_add_right hp 1)
  unfold fieldWordWidth
  nlinarith only [hs,hm,he,hq]
theorem primitive_cost_le (op : Primitive) {L q : Nat}
    (he : F.e≤L) (hp : F.p.size≤L) (hq : q.size≤L) :
    op.cost F q≤1000000*(L+1)^4 := by
  have hpos : 1≤L+1 := by omega
  have hsq : (F.e+1)^2≤(L+1)^2 := Nat.pow_le_pow_left (by omega) 2
  have he1 : F.e+1≤(L+1)^2 := by nlinarith only [he]
  have hq1 : q.size+1≤(L+1)^2 := by nlinarith only [hq]
  have hm:=Nat.mul_le_mul he (Nat.add_le_add_right hp 1)
  have hinv : F.e*(F.p.size+1)+1≤(L+1)^2 := by nlinarith only [hm]
  have hpow:=Nat.mul_le_mul hsq hq1
  have hiv:=Nat.mul_le_mul hsq hinv
  have hsq4 : (L+1)^2≤(L+1)^4 := Nat.pow_le_pow_right (by omega) (by decide)
  cases op with
  | point op=>simp only [Primitive.cost]; nlinarith only [he1,hsq4]
  | multiply=>simp only [Primitive.cost]; nlinarith only [hsq,hsq4]
  | power=>simp only [Primitive.cost]; nlinarith only [hpow]
  | inverse=>simp only [Primitive.cost]; nlinarith only [hiv]
theorem input_word_conditions (a b : K) (q : Nat) :
    let L:=bitSize (fieldInput F a b q)
    let B:=2^(100*(L+1)^2+L+1)
    16*(F.e+1)<B ∧ q<B ∧ (F.p+1)^2<B ∧ (F.p+1)^(F.e+1)<B := by
  dsimp only
  obtain ⟨he,hp,hq⟩:=input_parameters_le F a b q
  have hw:=fieldWordWidth_le F he hp hq
  have hm : fieldWordBound F.p F.e (16*(F.e+1)) q≤
      2^(100*(bitSize (fieldInput F a b q)+1)^2+bitSize (fieldInput F a b q)+1) :=
    Nat.pow_le_pow_right (by omega) (by omega)
  obtain ⟨hmemory,hexp,harith,hinv⟩:=fieldWord_conditions F.p F.e (16*(F.e+1)) q F.degree_pos
  exact ⟨hmemory.trans_le hm,hexp.trans_le hm,harith.trans_le hm,hinv.trans_le hm⟩
end Mathproof.Problem18IMPFieldBitBounds20261001
