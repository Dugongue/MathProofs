theorem integral_finite_pi {K L ι : Type*} [Field K] [Field L] [Algebra K L]
    [Algebra.IsIntegral K L] [Fintype ι] : Algebra.IsIntegral K (ι → L) := by
  classical
  constructor
  intro x
  have hx : ∀ i, IsIntegral K (x i) := fun i => Algebra.IsIntegral.isIntegral (x i)
  choose p hp hz using hx
  refine ⟨∏ i, p i, Polynomial.monic_prod_of_monic _ p (fun i _ => hp i), ?_⟩
  ext i
  change Polynomial.aeval x (∏ j, p j) i = 0
  rw [Polynomial.aeval_pi_apply₂]
  simp only [map_prod]
  exact Finset.prod_eq_zero (Finset.mem_univ i) (hz i)
variable {K L σ : Type*} [Field K] [Field L] [Algebra K L]
  [IsAlgClosed L] [Algebra.IsAlgebraic K L] [Finite σ]
noncomputable def reducedEvaluation (I : Ideal (MvPolynomial σ K)) :
    ((MvPolynomial σ K) ⧸ I.radical) →ₐ[K] (zeroLocus L I → L) :=
  Ideal.Quotient.liftₐ I.radical (AlgHom.pi fun x : zeroLocus L I => aeval x.val)
    (fun p hp => by
      ext x
      exact (radical_le_vanishingIdeal_zeroLocus (K := L) I hp) x.val x.property)
theorem reducedEvaluation_injective (I : Ideal (MvPolynomial σ K)) :
    Function.Injective (reducedEvaluation (L := L) I) := by
  intro a b hab
  apply sub_eq_zero.mp
  obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (a-b)
  have hz : reducedEvaluation (L := L) I (Ideal.Quotient.mk I.radical p) = 0 := by
    rw [hp, map_sub, hab, sub_self]
  rw [← hp, Ideal.Quotient.eq_zero_iff_mem,
    ← vanishingIdeal_zeroLocus_eq_radical (K := L) I]
  intro x hx
  have he := congrFun hz ⟨x,hx⟩
  exact he
theorem reduced_finiteDimensional_of_finite_geometric_locus
    (I : Ideal (MvPolynomial σ K)) (hf : (zeroLocus L I).Finite) :
    FiniteDimensional K ((MvPolynomial σ K) ⧸ I.radical) := by
  letI : Finite (zeroLocus L I) := hf
  letI : Fintype (zeroLocus L I) := Fintype.ofFinite _
  letI : Algebra.IsIntegral K L := Algebra.isAlgebraic_iff_isIntegral.mp inferInstance
  letI : Algebra.IsIntegral K (zeroLocus L I → L) := integral_finite_pi
  letI : Algebra.IsIntegral K ((MvPolynomial σ K) ⧸ I.radical) :=
    Algebra.IsIntegral.of_injective (reducedEvaluation (L := L) I) (reducedEvaluation_injective (L := L) I)
  exact Algebra.IsIntegral.finite
theorem finiteDimensional_of_finite_geometric_locus
    (I : Ideal (MvPolynomial σ K)) (hf : (zeroLocus L I).Finite) :
    FiniteDimensional K ((MvPolynomial σ K) ⧸ I) := by
  letI := reduced_finiteDimensional_of_finite_geometric_locus I hf
  let f : ((MvPolynomial σ K) ⧸ I) →ₐ[K] ((MvPolynomial σ K) ⧸ I.radical) :=
    Ideal.Quotient.factorₐ K I.le_radical
  apply Module.finite_of_surjective_of_ker_le_nilradical f
    (Ideal.Quotient.factor_surjective I.le_radical)
  · intro y hy
    obtain ⟨p,rfl⟩ := Ideal.Quotient.mk_surjective y
    have hzero : Ideal.Quotient.mk I.radical p = 0 := hy
    have hrad := (Ideal.Quotient.eq_zero_iff_mem).mp hzero
    obtain ⟨n, hn⟩ := (Ideal.mem_radical_iff).mp hrad
    rw [mem_nilradical]
    refine ⟨n, ?_⟩
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
    exact hn
  · exact IsNoetherian.noetherian _
theorem finite_geometric_locus_of_finiteDimensional
    (I : Ideal (MvPolynomial σ K))
    [FiniteDimensional K ((MvPolynomial σ K) ⧸ I)] : (zeroLocus L I).Finite := by
  let ev : zeroLocus L I → ((MvPolynomial σ K) ⧸ I →ₐ[K] L) :=
    fun x => Ideal.Quotient.liftₐ I (aeval x.val) x.property
  apply Finite.of_injective ev
  intro x y h
  apply Subtype.ext
  funext i
  have hi := congrArg (fun f : (MvPolynomial σ K) ⧸ I →ₐ[K] L =>
    f (Ideal.Quotient.mk I (X i))) h
  change aeval x.val (X i) = aeval y.val (X i) at hi
  simpa only [aeval_X] using hi
end Mathproof.Problem18BoundedGeometricDescent20260930
