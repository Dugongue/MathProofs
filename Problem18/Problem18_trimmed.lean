theorem scalar_line_symmetry (a b c : K) : 1*a*b+c=1*b*a+c := by
  ring
theorem scalar_alternating_fixed (C : LinearMap.BilinForm K V) (ha : C.IsAlt)
    (hn : C.Nondegenerate)
    (Q : Isometries (RingEquiv.refl K) (sumForm (RingEquiv.refl K) (scalarForm 1) C)) :
    ∀ a,Q.val (a,0)=(a,0) := by
  have hfirst (z : K×V) : (Q.val z).1=z.1 := by
    apply CharTwo.sq_injective
    have hh := Q.property z z
    change 1*((Q.val z).1*(Q.val z).1)+C (Q.val z).2 (Q.val z).2=
      1*(z.1*z.1)+C z.2 z.2 at hh
    simpa only [one_mul,ha.self_eq_zero,add_zero,pow_two] using hh
  have hfix : Q.val (1,0)=(1,0) := by
    apply Prod.ext
    · exact hfirst (1,0)
    · apply hn.1
      intro v
      obtain ⟨z,hz⟩ := Q.val.surjective (0,v)
      have hh := Q.property (1,0) z
      rw [hz] at hh
      have hzero : z.1=0 := by simpa only [hz] using (hfirst z).symm
      simpa only [sumForm_apply,scalarForm_apply,mul_zero,map_zero,LinearMap.zero_apply,
        zero_add,add_zero,hzero,one_mul] using hh
  intro a
  have hh := Q.val.map_smul a ((1:K),0)
  simpa only [Prod.smul_mk,smul_eq_mul,mul_one,smul_zero,hfix] using hh
theorem scalar_alternating_card (C : LinearMap.BilinForm K V) (ha : C.IsAlt)
    (hn : C.Nondegenerate) :
    Nat.card (Isometries (RingEquiv.refl K) (sumForm (RingEquiv.refl K) (scalarForm 1) C))=
      Nat.card (Isometries (RingEquiv.refl K) C) := by
  let e : Isometries (RingEquiv.refl K) (sumForm (RingEquiv.refl K) (scalarForm 1) C) ≃
      FixedLeft (RingEquiv.refl K) (scalarForm 1) C := {
    toFun Q := ⟨Q,scalar_alternating_fixed C ha hn Q⟩
    invFun Q := Q.val
    left_inv _ := rfl
    right_inv _ := rfl }
  exact (Nat.card_congr e).trans (fixedLeft_card (RingEquiv.refl K) (scalarForm 1) C
    (scalarForm_separating 1 one_ne_zero))
noncomputable def standardIsometryEquiv (n : ℕ) :
    Isometries (RingEquiv.refl K) (standardForm (K:=K) n) ≃ Matrix.orthogonalGroup (Fin n) K where
  toFun Q := ⟨LinearMap.toMatrix' Q.val.toLinearMap,by
    apply Matrix.mem_unitaryGroup_iff'.mpr
    let M := LinearMap.toMatrix' Q.val.toLinearMap
    have hm : (standardForm n).comp M.toLin' M.toLin'=standardForm n := by
      apply LinearMap.ext
      intro x
      apply LinearMap.ext
      intro y
      change standardForm n (M.toLin' x) (M.toLin' y)=standardForm n x y
      dsimp only [M]
      rw [Matrix.toLin'_toMatrix']
      exact Q.property x y
    have hh := congrArg LinearMap.BilinForm.toMatrix' hm
    rw [standardForm_pullback_matrix] at hh
    change M.transpose*M=1
    simpa [standardForm] using hh⟩
  invFun Q := ⟨orthogonalEquiv Q.val (Matrix.mem_unitaryGroup_iff'.mp Q.property),
    orthogonalEquiv_preserves Q.val (Matrix.mem_unitaryGroup_iff'.mp Q.property)⟩
  left_inv Q := by
    apply Subtype.ext
    apply LinearEquiv.ext
    intro x
    change (LinearMap.toMatrix' Q.val.toLinearMap).toLin' x=Q.val x
    rw [Matrix.toLin'_toMatrix']
    rfl
  right_inv Q := by
    apply Subtype.ext
    change LinearMap.toMatrix' Q.val.toLin'=Q.val
    exact LinearMap.toMatrix'_toLin' Q.val
theorem alternating_isometry_order (C : LinearMap.BilinForm K V) (ha : C.IsAlt)
    (hn : C.Nondegenerate) :
    Nat.card (Isometries (RingEquiv.refl K) C)=
      ∏ k ∈ Finset.range (Module.finrank K V),
        (Nat.card K^(k+1)-(if Odd (k+2) then 1 else 0)) := by
  classical
  let B : LinearMap.BilinForm K (K×V) := sumForm (RingEquiv.refl K) (scalarForm (1:K)) C
  have hBa (x y : K×V) : B x y=x.1*y.1+C x.2 y.2 := by
    change 1*(x.1*y.1)+C x.2 y.2=x.1*y.1+C x.2 y.2
    rw [one_mul]
  have hs : B.IsSymm := by
    constructor
    intro x y
    have hc : C x.2 y.2=C y.2 x.2 := by
      simpa only [CharTwo.neg_eq] using ha.neg_eq x.2 y.2
    rw [hBa,hBa,hc]
    simpa only [one_mul] using scalar_line_symmetry x.1 y.1 (C y.2 x.2)
  have hb : B.Nondegenerate := by
    constructor
    · intro x hx
      have hx1 : x.1=0 := by simpa only [hBa,mul_one,map_zero,add_zero] using hx (1,0)
      have hx2 : x.2=0 := hn.1 x.2 (fun y => by simpa only [hBa,mul_zero,zero_add] using hx (0,y))
      exact Prod.ext hx1 hx2
    · intro y hy
      have hy1 : y.1=0 := by simpa only [hBa,one_mul,map_zero,LinearMap.zero_apply,add_zero] using hy (1,0)
      have hy2 : y.2=0 := hn.2 y.2 (fun x => by simpa only [hBa,zero_mul,zero_add] using hy (0,x))
      exact Prod.ext hy1 hy2
  have hna : ¬B.IsAlt := by
    intro hh
    have hz := hh.self_eq_zero ((1:K),(0:V))
    simpa only [hBa,one_mul,map_zero,LinearMap.zero_apply,add_zero,one_ne_zero] using hz
  let n := Module.finrank K V
  have hnaI : ¬(standardForm (K:=K) (n+1)).IsAlt := by
    intro hh
    have hz := hh.self_eq_zero (Pi.single (0:Fin (n+1)) 1)
    simpa [standardForm,Matrix.toBilin'_apply'] using hz
  have hdim_arith : 1+n=n+1 := by simp only [add_comm, mul_comm]
  obtain ⟨e,he⟩ := nonalternating_isometry_of_finrank_eq B (standardForm (K:=K) (n+1))
    hs (standardForm_symm _) hb (standardForm_nondegenerate _) hna hnaI
    (by simp only [Module.finrank_prod,Module.finrank_self,Module.finrank_pi,Module.finrank_self,
      Finset.sum_const,Finset.card_univ,Fintype.card_fin,smul_eq_mul,mul_one]; exact hdim_arith)
  calc
    Nat.card (Isometries (RingEquiv.refl K) C)=Nat.card (Isometries (RingEquiv.refl K) B) :=
      (scalar_alternating_card C ha hn).symm
    _=Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) (n+1))) :=
      isometry_card_eq (RingEquiv.refl K) B _ e he
    _=Nat.card (Matrix.orthogonalGroup (Fin (n+1)) K) := Nat.card_congr (standardIsometryEquiv (K:=K) _)
    _=_ := orthogonal_order_product_charTwo n
end Mathproof.Problem18AlternatingGroupOrder20260930
