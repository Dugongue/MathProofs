  have hmax := Nat.le_max_left (maxList (constValues n d)) (maxList (wordValues n d))
  exact lt_of_le_of_lt (hm.trans hmax) hB
theorem word_bound_lt (n d B : Nat)
    (hB : requiredWord n d < B)
    (pat : Σ k : Nat, Fin k → Fin (boxSize n (cpE n d)))
    (hpat : pat ∈ patterns (boxSize n (cpE n d)))
