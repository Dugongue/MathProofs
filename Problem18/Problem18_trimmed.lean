variable {K : Type} [Field K] [Fintype K] [BEq K] [LawfulBEq K] [DecidableEq K]
def ordinaryBoundaryGramCost (F : FieldPresentation K) (a b c : Nat) : Nat :=
  boundaryLayoutCost F a b c+100+
    Problem18P34AssemblyMatrixGram20261003.cost F.e
      (boundaryHeight a b c) (boundaryWidth a b c)
def unitaryBoundaryGramCost (F : FieldPresentation K) (q a b c : Nat) : Nat :=
  boundaryLayoutCost F a b c+20000+
    Problem18P34AssemblyMatrixGram20261003.cost F.e
      (boundaryHeight a b c) (boundaryWidth a b c)+
    ((Problem18IMPMatrixPowerMap20261001.stepCost F.e q+4)*
      (boundaryWidth a b c*boundaryHeight a b c)+6)+
    (15+Problem18IMPMatrixProductLoop20261001.cost F.e
      (boundaryWidth a b c) (boundaryHeight a b c) (boundaryWidth a b c))
def boundaryGramCost (F : FieldPresentation K) (q a b c : Nat) : Nat :=
  ordinaryBoundaryGramCost F a b c+unitaryBoundaryGramCost F q a b c
structure BoundaryAfterGram (F : FieldPresentation K) (B a b c : Nat)
    (u : Bool) (q : Nat) (A : RectTensor a b c K)
    (sigma tau : Env) : Prop where
  run : ∃ runCost, runCost≤boundaryGramCost F q a b c ∧
    Run B (.seq (.seq modulusCopy (.seq boundaryGather gramLayoutSetup))
      gramProgram) sigma tau runCost
  first : (shape (sortOrder a b c) a b c).1=1
  externalValid : ValidMemory F B (externalState tau)
  externalSlots : Slots F canonical
    Problem18P34AssemblyMatrixGramSetup20261003.ws 0 B (externalState tau)
  gram : matrix F (externalState tau)
      (gramBase F.e (boundaryHeight a b c) (boundaryWidth a b c))
      (boundaryWidth a b c) (boundaryWidth a b c)=
    Problem18IMPBoundaryDispatchAdapter20261002.boundaryGram u q
      (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
        (sortOrder a b c) A first)
  native_memory : tau.arrs canonical.mem=sigma.arrs canonical.mem
  nativeValid : ValidMemory F B tau
  nativeSlots : Slots F canonical Problem18IMPBoundaryPhaseState20261002.workspaceName
    (Problem18IMPBoundaryCyclicLayout20261002.slots (boundaryWidth a b c)) B tau
  exp_word : tau.vars canonical.exp<B
  input : tau.inp=sigma.inp
  output : tau.out=sigma.out
theorem boundary_ordinary_gram_run (F : FieldPresentation K)
    {B a b c : Nat} {q : Nat} {A : RectTensor a b c K}
    (sigma : Env) (h : BoundaryInput F B a b c false q A sigma) :
    ∃tau, BoundaryAfterGram F B a b c false q A sigma tau := by
  obtain ⟨gamma,hgamma⟩:=boundary_layout_run F sigma h
  obtain ⟨tau,hgram,hvalid,hslots,hproduct,-,-,hlens,hnative,hi,ho⟩:=
    ordinaryGram_full_run F gamma hgamma.gramReady
  have heq : gamma.vars "u"=0 := by simpa using hgamma.unitary
  have hzeroB : 0<B := by
    have hs:=h.nativeSlots.slots_word
    omega
  have hu : (Cond.eq (.var "u") (.lit 0)).evalB B gamma=some true := by
    have ev : (Expr.var "u").evalB B gamma=some 0 :=
      by simpa [heq] using
        (evalB_var (B:=B) (σ:=gamma) (x:="u") (by rw [heq];exact hzeroB))
    have ez : (Expr.lit 0).evalB B gamma=some 0 :=
      evalB_lit hzeroB
    simp [Cond.evalB,ev,ez]
  have hbranch : Run B gramProgram gamma tau
      (100+Problem18P34AssemblyMatrixGram20261003.cost F.e
        (boundaryHeight a b c) (boundaryWidth a b c)) := by
    exact (Run.ite_true hu hgram).mono (by
      simp [gramProgram,Cond.size])
  have hrun : Run B
      (.seq (.seq modulusCopy (.seq boundaryGather gramLayoutSetup)) gramProgram)
      sigma tau (ordinaryBoundaryGramCost F a b c) := by
    exact (hgamma.run.seq hbranch).mono (by
      simp [ordinaryBoundaryGramCost]
      omega)
  have hscalar (x : String) (hx : x∉scalarWrites
      (.seq (.seq modulusCopy (.seq boundaryGather gramLayoutSetup)) gramProgram)) :
      tau.vars x=sigma.vars x := (run_frame hrun).1 x hx
  have hmem : tau.arrs canonical.mem=sigma.arrs canonical.mem :=
    hnative.trans hgamma.native_memory
  have hexpTau : tau.vars canonical.exp=gamma.vars canonical.exp :=
    (run_frame hgram).1 canonical.exp (by
      simp [ordinaryGram,renameCom,scalarWrites]
      decide)
  have hexpBound : tau.vars canonical.exp<B := by
    rw [hexpTau]
    exact hgamma.exp_word
  have hscratch :=
    Problem18ClaudeIMPRunArrayLength20261002.Run.arrs_length hrun canonical.scratch
  have hninv:=restoreNativeInvariants F h.nativeValid h.nativeSlots hmem
    (by rw [hscratch]; exact h.nativeValid.scratch_word)
    (by rw [hscratch]; exact h.nativeSlots.base.scratch_fit)
    (hscalar canonical.e (by
      simp [modulusCopy,modulusCopySetup,boundaryGather,gramLayoutSetup,
        gramProgram,ordinaryGram,assignAll,renameCom,copyGram,copyBody,scalarWrites]
      decide))
    (hscalar canonical.p (by
      simp [modulusCopy,modulusCopySetup,boundaryGather,gramLayoutSetup,
        gramProgram,ordinaryGram,assignAll,renameCom,copyGram,copyBody,scalarWrites]
      decide))
    (hscalar canonical.modBase (by
      simp [modulusCopy,modulusCopySetup,boundaryGather,gramLayoutSetup,
        gramProgram,ordinaryGram,assignAll,renameCom,copyGram,copyBody,scalarWrites]
      decide))
    (hscalar Problem18IMPBoundaryPhaseState20261002.workspaceName (by
      simp [modulusCopy,modulusCopySetup,boundaryGather,gramLayoutSetup,
        gramProgram,ordinaryGram,assignAll,renameCom,copyGram,copyBody,scalarWrites]
      decide))
    hexpBound
  refine ⟨tau,{
    run:=⟨ordinaryBoundaryGramCost F a b c,Nat.le_add_right _ _,hrun⟩
    first:=h.first
    externalValid:=hvalid
    externalSlots:=hslots
    gram:=?_
    native_memory:=hmem
    nativeValid:=hninv.1
    nativeSlots:=hninv.2
    exp_word:=hexpBound
    input:=hi.trans hgamma.input
    output:=ho.trans hgamma.output }⟩
  have hp:=hproduct
  rw [hgamma.destBase,hgamma.sourceBase] at hp
  rw [hgamma.sourceMatrix] at hp
  simpa [Problem18IMPBoundaryDispatchAdapter20261002.boundaryGram] using hp
