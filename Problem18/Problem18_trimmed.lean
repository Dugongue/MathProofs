theorem routine_run {B : Nat} {σ : Env}
    (he : σ.vars canonical.e=F.e)
    (ha : σ.vars canonical.aBase<B) (hb : σ.vars canonical.bBase<B)
    (ho : σ.vars canonical.outBase<B) (hw : σ.vars workBase+2*F.e<B)
    (hm : σ.vars rows<B) (hn : σ.vars columns<B)
    (hmn : σ.vars rows*σ.vars columns<B)
    (h : LoopInput F B (initialized F σ)) :
    ∃τ,Run B Problem18IMPMatrixProductLoop20261001.routine σ τ
      (cost F.e (σ.vars rows) (σ.vars count) (σ.vars columns)) ∧
      ValidMemory F B τ ∧
      τ.vars canonical.aBase=σ.vars canonical.aBase ∧
      τ.vars canonical.bBase=σ.vars canonical.bBase ∧
      τ.vars canonical.outBase=σ.vars canonical.outBase ∧
      Problem18IMPMatrixMemory20261001.matrix F τ (σ.vars canonical.outBase)
        (σ.vars rows) (σ.vars columns)=
      Problem18IMPMatrixMemory20261001.matrix F σ (σ.vars canonical.aBase)
        (σ.vars rows) (σ.vars count)*
      Problem18IMPMatrixMemory20261001.matrix F σ (σ.vars canonical.bBase)
        (σ.vars count) (σ.vars columns) := by
  obtain ⟨ρ,hr,hρ,hend⟩:=loop_run F h
  have regs:=Problem18IMPMatrixProductExecution20261001.frame_register hρ.frame
  have ea:ρ.vars savedA=σ.vars canonical.aBase:=by
    simpa [initialized,savedA,savedB,savedOut,acc,prod,next,strideA,strideB,total,outputIndex,canonical]
      using regs savedA (by simp [protectedRegisters])
  have eb:ρ.vars savedB=σ.vars canonical.bBase:=by
    simpa [initialized,savedA,savedB,savedOut,acc,prod,next,strideA,strideB,total,outputIndex,canonical]
      using regs savedB (by simp [protectedRegisters])
  have eo:ρ.vars savedOut=σ.vars canonical.outBase:=by
    simpa [initialized,savedA,savedB,savedOut,acc,prod,next,strideA,strideB,total,outputIndex,canonical]
      using regs savedOut (by simp [protectedRegisters])
  have hrest:=restore_run ρ (by rw [ea];exact ha) (by rw [eb];exact hb) (by rw [eo];exact ho)
  have hall:=prefix_run F
    (.seq (.while (.lt (.var outputIndex) (.var total)) Problem18IMPMatrixProductLoop20261001.body) restore)
    he ha hb ho hw hm hn hmn (hr.seq hrest)
  have hc : (initialized F σ).vars count=σ.vars count := by
    simp [initialized,count,savedA,savedB,savedOut,acc,prod,next,strideA,strideB,total,outputIndex]
  have hsz : (initialized F σ).vars total=σ.vars rows*σ.vars columns := by
    simp [initialized,total,outputIndex]
  have hv1:=validMemory_setVar F hρ.valid canonical.aBase (ρ.vars savedA)
    (by decide) (by decide) (by decide)
  have hv2:=validMemory_setVar F hv1 canonical.bBase (ρ.vars savedB)
    (by decide) (by decide) (by decide)
  have hv3:=validMemory_setVar F hv2 canonical.outBase (ρ.vars savedOut)
    (by decide) (by decide) (by decide)
  refine ⟨restored ρ,?_,hv3,?_,?_,?_,?_⟩
