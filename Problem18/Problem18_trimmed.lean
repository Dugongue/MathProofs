    have huw : q.u ≠ q.w := hq.ne_of (by intro h; simp [RNames.list, h])
    have huj : q.u ≠ q.j := hq.ne_of (by intro h; simp [RNames.list, h])
    have hNi : q.N ≠ q.i := hq.ne_of (by intro h; simp [RNames.list, h])
    have hNf : q.N ≠ q.f := hq.ne_of (by intro h; simp [RNames.list, h])
    have hNp : q.N ≠ q.pv := hq.ne_of (by intro h; simp [RNames.list, h])
    have hci : q.c ≠ q.i := hq.ne_of (by intro h; simp [RNames.list, h])
    have hcf : q.c ≠ q.f := hq.ne_of (by intro h; simp [RNames.list, h])
    have hcp : q.c ≠ q.pv := hq.ne_of (by intro h; simp [RNames.list, h])
    have hup' : τp.vars q.u = uv := hregsp q.u (hq.2 _ (by simp [RNames.list])) hui huf hup
    have hNp' : τp.vars q.N = Nv := by rw [hregsp q.N (hq.2 _ (by simp [RNames.list])) hNi hNf hNp, hNτ]
    have hcp' : τp.vars q.c = cv := by rw [hregsp q.c (hq.2 _ (by simp [RNames.list])) hci hcf hcp, hcτ]
    have hf01 : τp.vars q.f = 0 ∨ τp.vars q.f = 1 := by
      rcases hscan with ⟨h, _⟩ | ⟨h, _⟩
      · right; exact h
      · left; exact h
    have hfB : τp.vars q.f < B := by rcases hf01 with h | h <;> rw [h] <;> omega
    have hrestτ := restRows_cons (val F r q.WS τ) Nv cv uv hult
    have hcond_eval : (Cond.eq (.var q.f) (.lit 1)).evalB B τp =
        some (τp.vars q.f == 1) := evalB_condEq (evalB_var hfB) (evalB_lit (by omega))
    by_cases hf : τp.vars q.f = 1
    ·
      obtain ⟨hp, hpv⟩ := hpiv.1 hf
      have hnz : val F r q.WS τ (rowStart Nv uv + τp.vars q.pv) ≠ 0 := by
        rcases hscan with ⟨_, _, hne, _⟩ | ⟨h0, _⟩
