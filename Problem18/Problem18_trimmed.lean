theorem alternating_rank_eq_finrank_range {n : ℕ} (A : AltMat n K) :
    A.val.rank = Module.finrank K (LinearMap.range A.val.toBilin') := by
  let B := A.val.toBilin'
  have hker : LinearMap.ker B = LinearMap.ker A.val.mulVecLin := by
    ext x
    simp only [LinearMap.mem_ker]
    constructor
    · intro hx
      funext i
      have hxi : B x (Pi.single i 1) = 0 := by
        simpa using LinearMap.congr_fun hx (Pi.single i 1)
      have hix : B (Pi.single i 1) x = 0 := A.property.eq_iff.mp hxi
      change A.val.mulVec x i = 0
      simpa only [B, Matrix.toBilin'_apply', single_one_dotProduct] using hix
    · intro hx
      apply LinearMap.ext
      intro y
      apply A.property.eq_iff.mpr
      simp only [B, Matrix.toBilin'_apply']
      change A.val.mulVec x = 0 at hx
      rw [hx]
      exact dotProduct_zero y
  unfold Matrix.rank
  change Module.finrank K (LinearMap.range A.val.mulVecLin) =
    Module.finrank K (LinearMap.range B)
  have h₁ := A.val.mulVecLin.finrank_range_add_finrank_ker
  have h₂ := B.finrank_range_add_finrank_ker
  rw [hker] at h₂
  omega
theorem alternating_rank_even {n : ℕ} (A : AltMat n K) : Even A.val.rank := by
  let B := A.val.toBilin'
  have hker : LinearMap.ker B = LinearMap.ker A.val.mulVecLin := by
    ext x
    simp only [LinearMap.mem_ker]
    constructor
    · intro hx
      funext i
      have hxi : B x (Pi.single i 1) = 0 := by
        simpa using LinearMap.congr_fun hx (Pi.single i 1)
      have hix : B (Pi.single i 1) x = 0 := A.property.eq_iff.mp hxi
      change A.val.mulVec x i = 0
      simpa only [B, Matrix.toBilin'_apply', single_one_dotProduct] using hix
    · intro hx
      apply LinearMap.ext
      intro y
      apply A.property.eq_iff.mpr
      simp only [B, Matrix.toBilin'_apply']
      change A.val.mulVec x = 0 at hx
      rw [hx]
      exact dotProduct_zero y
  have hrank : Mathproof.Meta.AlternatingEvenRank20260901.rank B = A.val.rank := by
    unfold Mathproof.Meta.AlternatingEvenRank20260901.rank Matrix.rank
    rw [hker]
    have hrn := LinearMap.finrank_range_add_finrank_ker A.val.mulVecLin
    omega
  rw [← hrank]
  exact Mathproof.Meta.AlternatingEvenRank20260901.even_rank_of_isAlt B A.property
theorem alternating_rank_ne_one {n : ℕ} (A : AltMat n K) : A.val.rank ≠ 1 := by
  intro h
  have he := alternating_rank_even A
  rw [h] at he
  exact Nat.not_even_one he
theorem matrix_eq_zero_of_rank_eq_zero {n : ℕ} {A : Matrix (Fin n) (Fin n) K}
    (hA : A.rank = 0) : A = 0 := by
  have hr : LinearMap.range A.mulVecLin = ⊥ := by
    apply Submodule.finrank_eq_zero.mp
    simpa only [Matrix.rank] using hA
  have hl : A.mulVecLin = 0 := LinearMap.range_eq_bot.mp hr
  apply Matrix.toLin'.injective
  rw [Matrix.toLin'_apply', Matrix.toLin'_apply', hl, Matrix.mulVecLin_zero]
theorem alternating_rank_zero_card (n : ℕ) :
    Nat.card {A : AltMat n K // A.val.rank = 0} = 1 := by
  apply Nat.card_eq_one_iff_exists.mpr
  let Z : AltMat n K := ⟨0, by simpa using LinearMap.BilinForm.isAlt_zero⟩
  refine ⟨⟨Z, Matrix.rank_zero⟩, ?_⟩
  intro A
  apply Subtype.ext
  apply Subtype.ext
  exact matrix_eq_zero_of_rank_eq_zero A.property
theorem alternating_rank_one_card (n : ℕ) :
    Nat.card {A : AltMat n K // A.val.rank = 1} = 0 := by
  rw [Nat.card_eq_zero]
  exact Or.inl ⟨fun A => alternating_rank_ne_one A.val A.property⟩
theorem alternating_stratum_exponent {n r : ℕ} (hr : r ≤ n) (hp : 1 ≤ r) :
    r * (n-r) + r.choose 2 + (r-1) ≤ r * (n-1) := by
  have hc : 2 * (r.choose 2) ≤ r * (r-1) := by
    rw [Nat.choose_two_right, Nat.mul_comm 2]
    omega
  have hn := Nat.sub_add_cancel hr
  have hs := Nat.sub_add_cancel hp
  by_cases h1 : r = 1
  · subst r
    simp
  · have h2 : 2 ≤ r := by omega
    have haux : r * (r-1) + 2 * (r-1) ≤ 2 * r * (r-1) := by
      calc
        _ = (r+2) * (r-1) := by ring
        _ ≤ (2*r) * (r-1) := Nat.mul_le_mul_right (r-1) (by omega)
        _ = _ := by ring
    have hpart : 2 * r.choose 2 + 2 * (r-1) ≤ 2 * r * (r-1) :=
      (Nat.add_le_add_right hc _).trans haux
    have hsum : n-r + (r-1) = n-1 := by omega
    apply Nat.le_of_mul_le_mul_left
    calc
      2 * (r * (n-r) + r.choose 2 + (r-1)) =
          2*r*(n-r) + (2*r.choose 2 + 2*(r-1)) := by ring
      _ ≤ 2*r*(n-r) + 2*r*(r-1) := Nat.add_le_add_left hpart _
      _ = 2 * (r * (n-1)) := by rw [← hsum]; ring
    omega
theorem alternating_rank_term_bound (q : ℝ) (hq : 2 ≤ q)
    {n m r : ℕ} (hm : n ≤ m) (hr : r ≤ n) (hp : 1 ≤ r) :
    q^(r*(n-r)+r.choose 2) * ((q^r)⁻¹)^(m-1) ≤
      (q⁻¹)^(r-1) := by
  have hq0 : 0 < q := by linarith
  have he := alternating_stratum_exponent hr hp
  have hpred : n - 1 ≤ m - 1 := Nat.sub_le_sub_right hm 1
  have hmul := Nat.mul_le_mul_left r hpred
  have hexp : r * (n-r) + r.choose 2 + (r-1) ≤ r * (m-1) := he.trans hmul
  simp only [inv_pow, ← pow_mul]
  rw [← div_eq_mul_inv, ← one_div]
  apply (div_le_div_iff₀ (pow_pos hq0 _) (pow_pos hq0 _)).2
  simp only [one_mul, ← pow_add]
  exact pow_le_pow_right₀ (by linarith) hexp
theorem inverse_power_tail_le_one (q : ℝ) (hq : 2 ≤ q) (n : ℕ) :
    (∑ r : Fin n, (q⁻¹)^(r.val+1)) ≤ 1 := by
  have hq0 : 0 < q := by linarith
  have ha : 0 ≤ q⁻¹ := inv_nonneg.mpr hq0.le
  have hb : q⁻¹ ≤ 1/2 :=
    (inv_le_comm₀ hq0 (by norm_num)).2 (by norm_num; exact hq)
  induction n with
  | zero => simp
  | succ n ih =>
    rw [Fin.sum_univ_succ]
    simp only [Fin.val_zero, zero_add, pow_one, Fin.val_succ]
    have he : (∑ i : Fin n, q⁻¹ ^ (i.val+1+1)) =
        q⁻¹ * ∑ i : Fin n, q⁻¹^(i.val+1) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      simp only [pow_succ]
      ring
    rw [he]
    nlinarith [mul_le_mul_of_nonneg_left ih ha]
noncomputable def alternatingMajorant (q : ℝ) (r : ℕ) : ℝ :=
  if r = 0 then 1 else if r = 1 then 0 else 4 * (q⁻¹)^(r-1)
theorem alternating_majorant_sum_le_five (q : ℝ) (hq : 2 ≤ q) (n : ℕ) :
    (∑ r : Fin (n+1), alternatingMajorant q r.val) ≤ 5 := by
  cases n with
  | zero => simp [alternatingMajorant]
  | succ n =>
    rw [Fin.sum_univ_succ, Fin.sum_univ_succ]
    simp only [alternatingMajorant, Fin.val_zero, Fin.val_succ, if_pos,
      if_false, Nat.succ_ne_zero, Nat.succ.injEq, Nat.add_sub_cancel, zero_add]
    have ht := inverse_power_tail_le_one q hq n
    rw [← Finset.mul_sum]
    linarith
open Classical in
theorem alternating_rank_energy_le (n m : ℕ) (hm : n ≤ m) :
    (∑ A : AltMat n K,
      (((Fintype.card K : ℝ)^A.val.rank)⁻¹)^(m-1)) ≤ 5 := by
  classical
  let q : ℝ := Fintype.card K
  have hq : 2 ≤ q := by
    dsimp [q]
    exact_mod_cast (show 2 ≤ Fintype.card K from Fintype.one_lt_card)
  let f : AltMat n K → Fin (n+1) := fun A =>
    ⟨A.val.rank, Nat.lt_succ_of_le (by simpa using A.val.rank_le_card_width)⟩
  have hc (r : Fin (n+1)) : Nat.card {A // f A = r} =
      Nat.card {A : AltMat n K // A.val.rank = r.val} := by
    apply Nat.card_congr
    exact Equiv.subtypeEquivRight (fun A => Fin.ext_iff)
  have he := Fintype.sum_fiberwise' f
    (fun r => (((q^r.val)⁻¹)^(m-1)))
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
    ← Nat.card_eq_fintype_card, hc] at he
  change (∑ A, (((q^(f A).val)⁻¹)^(m-1))) ≤ _
  rw [← he]
  calc
    _ ≤ ∑ r : Fin (n+1), alternatingMajorant q r.val := by
      apply Finset.sum_le_sum
      intro r _
      by_cases h0 : r.val = 0
      · rw [h0, alternating_rank_zero_card]
        simp [alternatingMajorant]
      by_cases h1 : r.val = 1
      · rw [h1, alternating_rank_one_card]
        simp [alternatingMajorant]
      · have hp : 1 ≤ r.val := by omega
        have hb := alternating_rank_count_bound (K := K) n r.val
          (Nat.le_of_lt_succ r.isLt)
        have ht := alternating_rank_term_bound q hq hm
          (Nat.le_of_lt_succ r.isLt) hp
        change (Nat.card {A : AltMat n K // A.val.rank = r.val} : ℝ) *
          ((q^r.val)⁻¹)^(m-1) ≤ _
        rw [alternatingMajorant, if_neg h0, if_neg h1]
        calc
          _ ≤ (4 * q^(r.val*(n-r.val)+r.val.choose 2)) *
              ((q^r.val)⁻¹)^(m-1) :=
            mul_le_mul_of_nonneg_right hb (by positivity)
          _ = 4 * (q^(r.val*(n-r.val)+r.val.choose 2) *
              ((q^r.val)⁻¹)^(m-1)) := by ring
          _ ≤ 4 * (q⁻¹)^(r.val-1) :=
            mul_le_mul_of_nonneg_left ht (by norm_num)
    _ ≤ 5 := alternating_majorant_sum_le_five q hq n
end Mathproof.Problem18AlternatingEnergy20260930
