def srcRow (an : ANames) : Expr := plus (.var an.sB) (.bin .mul (.var an.a) (.var an.c))
theorem evalB_rowW {B : ℕ} {σ : Env} (an : ANames) {ue : Expr} {uv Nv : ℕ}
