    have hh := packed_frame F hp hρ j
      (by simpa [stepState,arguments,canonical] using hj1)
      (by simpa [stepState,arguments,canonical,Problem18IMPMatrixProductLoop20261001.workBase] using hj2)
    simpa [stepState,arguments,canonical] using hh
def Band (σ τ : Env) : Prop :=
  ∀j,σ.vars tableReg+F.e*((σ.vars limitReg+1)*σ.vars sizeReg) ≤ j →
    j<σ.vars Problem18IMPMatrixProductLoop20261001.workBase →
    (τ.arrs canonical.mem).getD j 0=(σ.arrs canonical.mem).getD j 0
theorem step_invariant_band {B : Nat} {σ τ : Env} (h : Input F B σ)
    (hI : Invariant F B σ τ) (hBd : Band F σ τ) (hi : τ.vars indexReg<σ.vars limitReg) :
    ∃ρ,Run B Problem18IMPBoundaryKrylov20261001.body τ ρ (stepCost F.e (σ.vars sizeReg)) ∧
      Invariant F B σ ρ ∧ Band F σ ρ ∧ ρ.vars indexReg=τ.vars indexReg+1 := by
  have heq:=hI.controls
  have ht:=input_transport F h hI
  obtain ⟨ρ,hr,hv,hidx,hval,hpref,hband,hvars⟩:=step_run_band F ht
    (by rw [heq sizeReg (by simp)]; exact hI.rows_eq)
    (by rw [heq sizeReg (by simp)]; exact hI.inner_eq)
    hI.cols_eq (by rw [heq limitReg (by simp)]; exact hi)
  have hr' : Run B Problem18IMPBoundaryKrylov20261001.body τ ρ (stepCost F.e (σ.vars sizeReg)) := by
    simpa only [heq sizeReg (by simp)] using hr
  have hregs (x : String) (hx : x∈controls) : ρ.vars x=τ.vars x:=
    hvars x (controls_safe x hx)
  have hfr:=run_frame hr
  have hmem (k : Nat) (hk : k<vectorBase F τ (τ.vars indexReg+1)) := hpref k hk
  refine ⟨ρ,hr',?_,?_,hidx⟩
  · refine ⟨hv,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_⟩
    · intro x hx
      exact (hregs x hx).trans (heq x hx)
    · exact (hvars rows (by decide)).trans hI.rows_eq
    · exact (hvars Problem18IMPMatrixDot20261001.count (by decide)).trans hI.inner_eq
    · exact (hvars columns (by decide)).trans hI.cols_eq
    · rw [hidx]; omega
    · intro a; exact (hfr.2.2.1 a).trans (hI.lengths a)
    · intro k hk
      apply (hmem k ?_).trans (hI.memory_prefix k hk)
      unfold vectorBase
      rw [heq tableReg (by simp),heq sizeReg (by simp)]
      simp only [Nat.add_mul,Nat.one_mul,Nat.mul_add]
      omega
    · intro j hj i
      rw [hidx] at hj
      by_cases he : j=τ.vars indexReg+1
      · subst j
        have hall : ∀k:Fin (σ.vars sizeReg),
            value F ρ (σ.vars tableReg) (σ.vars sizeReg) k.val (τ.vars indexReg+1)=
              (Problem18IMPMatrixMemory20261001.matrix F τ (σ.vars matrixReg)
                (σ.vars sizeReg) (σ.vars sizeReg)).mulVec
                (fun j=>value F τ (σ.vars tableReg) (σ.vars sizeReg) j.val (τ.vars indexReg)) k := by
          have hdim:=heq sizeReg (by simp)
          have hh:=hval
          simp only [heq tableReg (by simp),heq matrixReg (by simp)] at hh
          generalize hleft : τ.vars sizeReg=nt at hh hdim
          generalize hright : σ.vars sizeReg=ns at hdim ⊢
          clear hleft hright
          subst nt
          exact hh
        have hvalue:=hall i
        rw [matrix_preserved F h hI] at hvalue
        have hvec : (fun k:Fin (σ.vars sizeReg)=>value F τ (σ.vars tableReg) (σ.vars sizeReg) k.val (τ.vars indexReg))=
            ((Problem18IMPMatrixMemory20261001.matrix F σ (σ.vars matrixReg) (σ.vars sizeReg) (σ.vars sizeReg))^(τ.vars indexReg)).mulVec
              (fun k=>value F σ (σ.vars tableReg) (σ.vars sizeReg) k.val 0) :=
          funext (fun k=>hI.orbits _ (by omega) k)
        rw [hvec] at hvalue
        simpa only [pow_succ',Matrix.mulVec_mulVec] using hvalue
      · have hj' : j≤τ.vars indexReg := by omega
        apply (value_prefix F hpref ?_).trans (hI.orbits j hj' i)
        unfold vectorBase
        rw [heq tableReg (by simp),heq sizeReg (by simp)]
        have hn:=i.isLt
        have hh:=Nat.mul_le_mul_right (σ.vars sizeReg) hj'
        have hh':j*σ.vars sizeReg+i.val+1≤(τ.vars indexReg+1)*σ.vars sizeReg := by nlinarith
        have hmul:=Nat.mul_le_mul_left F.e hh'
        nlinarith
    · exact (hfr.2.2.2.1 (by repeat constructor)).trans hI.input_tape
    · exact (hfr.2.2.2.2 (by repeat constructor)).trans hI.output_tape
  · intro j hj1 hj2
    have hlim : τ.vars indexReg+2 ≤ σ.vars limitReg+1 := by omega
    have hm := Nat.mul_le_mul_left F.e (Nat.mul_le_mul_right (σ.vars sizeReg) hlim)
    have hring : F.e*((τ.vars indexReg+1)*σ.vars sizeReg)+F.e*σ.vars sizeReg=
        F.e*((τ.vars indexReg+2)*σ.vars sizeReg) := by ring
    rw [hband j ?_ ?_]
    · exact hBd j hj1 hj2
    · unfold vectorBase
      rw [heq tableReg (by simp),heq sizeReg (by simp)]
      omega
    · rw [heq Problem18IMPMatrixProductLoop20261001.workBase (by simp)]; exact hj2
theorem routine_run_band {B : Nat} {σ : Env} (h : Input F B σ) :
    ∃τ,Run B Problem18IMPBoundaryKrylov20261001.routine σ τ (loopCost F.e (σ.vars sizeReg) (σ.vars limitReg)) ∧
      Invariant F B σ τ ∧ Band F σ τ ∧ τ.vars indexReg=σ.vars limitReg := by
  let I:=fun τ : Env=>Invariant F B σ τ ∧ Band F σ τ
  let V:=fun τ : Env=>σ.vars limitReg-τ.vars indexReg
  have hd : σ.vars limitReg<B := h.limit_le.trans_lt h.n_word
  have hdef : ∀τ,I τ→∃v,(Cond.lt (.var indexReg) (.var limitReg)).evalB B τ=some v := by
    intro τ ht
    apply evalB_condLt_vars (ht.1.index_le.trans_lt hd)
    rw [ht.1.controls limitReg (by simp)]
    exact hd
  have hstep : ∀τ,I τ→(Cond.lt (.var indexReg) (.var limitReg)).evalB B τ=some true→
      ∃ρ,Run B Problem18IMPBoundaryKrylov20261001.body τ ρ (stepCost F.e (σ.vars sizeReg)) ∧ I ρ ∧ V ρ<V τ := by
    intro τ ht hb
    have he:=evalB_condLt (evalB_var (ht.1.index_le.trans_lt hd))
      (evalB_var (show τ.vars limitReg<B by rw [ht.1.controls limitReg (by simp)]; exact hd))
    rw [hb,ht.1.controls limitReg (by simp)] at he
    have hi : τ.vars indexReg<σ.vars limitReg := by simpa using he.symm
    obtain ⟨ρ,hr,hρ,hρb,hidx⟩:=step_invariant_band F h ht.1 ht.2 hi
    exact ⟨ρ,hr,⟨hρ,hρb⟩,by dsimp [V]; rw [hidx]; omega⟩
  obtain ⟨τ,hr,hτ,hfalse⟩:=Run.while_count I V (stepCost F.e (σ.vars sizeReg)) hdef hstep
    ⟨configured_invariant F h,fun _ _ _=>rfl⟩
  have he:=evalB_condLt (evalB_var (hτ.1.index_le.trans_lt hd))
    (evalB_var (show τ.vars limitReg<B by rw [hτ.1.controls limitReg (by simp)]; exact hd))
  rw [hfalse,hτ.1.controls limitReg (by simp)] at he
  have hi : ¬τ.vars indexReg<σ.vars limitReg := by simpa using he.symm
  have hend : τ.vars indexReg=σ.vars limitReg := by have hh:=hτ.1.index_le; omega
  let s1:=σ.setVar rows (σ.vars sizeReg)
  let s2:=s1.setVar Problem18IMPMatrixDot20261001.count (σ.vars sizeReg)
  let s3:=s2.setVar columns 1
  have h1:=Run.assign (x:=rows) (evalB_var h.n_word)
  have h2:=Run.assign (x:=Problem18IMPMatrixDot20261001.count) (σ:=s1)
    (evalB_var (x:=sizeReg) (by simpa [s1,rows,sizeReg] using h.n_word))
  have hB : 1<B := by have hh:=h.valid.arithmetic_word; have hp:=F.prime.two_le; nlinarith
  have h3:=Run.assign (x:=columns) (σ:=s2) (evalB_lit hB)
  have h4:=Run.assign (x:=indexReg) (σ:=s3) (evalB_lit (by omega : 0<B))
  have hall:=h1.seq (h2.seq (h3.seq (h4.seq hr)))
  have hband : Band F σ τ := by
    intro j hj1 hj2
    have := hτ.2 j (by simpa [configured] using hj1) (by simpa [configured] using hj2)
    simpa [configured] using this
  refine ⟨τ,hall.mono ?_,hτ.1,hband,hend⟩
  simp [loopCost,V,configured,Cond.size,Expr.size]
  nlinarith
end Loop
