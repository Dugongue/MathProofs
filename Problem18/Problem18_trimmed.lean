theorem basisTable_decode {n m : Nat} (S : Fin m → Mat F.e n n) (k : Nat) :
    (basisTable F.p (modulusVector F) S k).map (decodeRow F)=
      Problem18IMPAlgebraGenerationReference20261001.basisTable (fun i=>decodeMatrix F (S i)) k := by
  induction k with
  | zero =>
    rw [basisTable,boundedCompress_decode F _ (by intro v hv; obtain rfl:=List.mem_singleton.mp hv; exact identity_canonical F n)]
    simp only [List.map_cons,List.map_nil,Problem18IMPAlgebraGenerationReference20261001.basisTable]
    rw [←pack_decodeMatrix,identity_decode]
  | succ k ih =>
    rw [basisTable,boundedCompress_decode F _ (by
      intro v hv
      rcases List.mem_append.mp hv with hv|hv
      · exact basisTable_canonical F S k v hv
      · exact products_canonical F S _ v hv)]
    rw [List.map_append,products_decode,ih]
    rfl
theorem rankCheck_correct {n m : Nat} (S : Fin m → Mat F.e n n) :
    rankCheck F.p (modulusVector F) S=true ↔
      Algebra.adjoin K (Set.range (fun i=>decodeMatrix F (S i)))=⊤ := by
  have h:=congrArg List.length (basisTable_decode F S (n^2+1))
  simp only [List.length_map] at h
  rw [rankCheck,h]
  exact Problem18IMPAlgebraGenerationReference20261001.rankCheck_correct _
end Mathproof.Problem18CoordinateAlgebra20261002
