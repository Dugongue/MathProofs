def build {e r c : Nat} (f : Fin r → Fin c → Coeff e) : Mat e r c :=
  Vector.ofFn fun ij=>f (finProdFinEquiv.symm ij).1 (finProdFinEquiv.symm ij).2
theorem mget_build {e r c : Nat} (f : Fin r → Fin c → Coeff e) (i : Fin r) (j : Fin c) :
    mget (build f) i j=f i j := by
  simp only [mget,build,Vector.getElem_ofFn,Fin.eta,Equiv.symm_apply_apply]
def total {e n : Nat} (p : Nat) (f : Fin n → Coeff e) : Coeff e :=
  sum p e (List.ofFn f)
def tensor (e a b c : Nat) (xs : List Nat) : Fin c → Fin a × Fin b → Coeff e :=
  fun k ij=>Vector.ofFn fun t=>xs.getD
    (Problem18EncodedTensorSort20261001.offset a b e k.val ij.1.val ij.2.val t.val) 0
def scalarAdj {e : Nat} (p : Nat) (modulus : Coeff e) (u : Bool) (q : Nat)
    (x : Coeff e) : Coeff e := if u then power p e modulus x q else x
def matrixPower {e n : Nat} (p : Nat) (modulus : Coeff e) (A : Mat e n n) : Nat → Mat e n n
  | 0 => identity p e n
  | k+1 => matrixMul p modulus (matrixPower p modulus A k) A
def gram {e a b c : Nat} (p : Nat) (modulus : Coeff e) (u : Bool) (q : Nat)
    (A : Fin c → Fin a × Fin b → Coeff e) : Mat e c c :=
  build fun r s=>total p fun i : Fin a=>total p fun j : Fin b=>
    mul p e modulus (A r (i,j)) (scalarAdj p modulus u q (A s (i,j)))
def first {e a b c : Nat} (p : Nat) (modulus : Coeff e) (u : Bool) (q : Nat)
    (A : Fin c → Fin a × Fin b → Coeff e) (t : Fin c) : Mat e b b :=
  let P:=matrixPower p modulus (gram p modulus u q A) t.val
  build fun j k=>total p fun i : Fin a=>total p fun s : Fin c=>
    mul p e modulus
      (total p fun r : Fin c=>mul p e modulus (scalarAdj p modulus u q (A r (i,k))) (mget P r s))
      (A s (i,j))
def second {e a b c : Nat} (p : Nat) (modulus : Coeff e) (u : Bool) (q : Nat)
    (A : Fin c → Fin a × Fin b → Coeff e) (kl : Fin b × Fin b) : Mat e a a :=
  build fun i j=>total p fun k : Fin c=>
    mul p e modulus (A k (i,kl.1)) (scalarAdj p modulus u q (A k (j,kl.2)))
def largeCheck (p e a b c : Nat) (modulus : Coeff e) (u : Bool) (q : Nat)
    (xs : List Nat) : Bool :=
  let A:=tensor e a b c xs
  rankCheck p modulus (first p modulus u q A) &&
  rankCheck p modulus (fun t : Fin (b*b)=>second p modulus u q A (finProdFinEquiv.symm t))
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
def decodeTensor {a b c : Nat} (A : Fin c → Fin a × Fin b → Coeff F.e) : RectTensor a b c K :=
  fun k ij=>decodeVector F (A k ij)
theorem total_canonical {n : Nat} (f : Fin n → Coeff F.e)
    (h : ∀i,canonicalVector F (f i)) : canonicalVector F (total F.p f) := by
  apply sum_canonical F
  intro v hv
  obtain ⟨i,rfl⟩:=List.mem_ofFn.mp hv
  exact h i
theorem total_decode {n : Nat} (f : Fin n → Coeff F.e)
    (h : ∀i,canonicalVector F (f i)) :
    decodeVector F (total F.p f)=∑i,decodeVector F (f i) := by
  rw [total,sum_decode F _ (by intro v hv; obtain ⟨i,rfl⟩:=List.mem_ofFn.mp hv; exact h i)]
  simp [List.map_ofFn,List.sum_ofFn]
theorem scalarAdj_decode (u : Bool) (q : Nat) (x : Coeff F.e) :
    decodeVector F (scalarAdj F.p (modulusVector F) u q x)=
      if u then (decodeVector F x)^q else decodeVector F x := by
  cases u <;> simp [scalarAdj,decode_power]
theorem matrixPower_decode {n : Nat} (A : Mat F.e n n) (k : Nat) :
    decodeMatrix F (matrixPower F.p (modulusVector F) A k)=(decodeMatrix F A)^k := by
  induction k with
  | zero => exact identity_decode F n
  | succ k ih => rw [matrixPower,matrixMul_decode,ih,pow_succ]
theorem gram_decode {a b c : Nat} (u : Bool) (q : Nat)
    (A : Fin c → Fin a × Fin b → Coeff F.e) :
    decodeMatrix F (gram F.p (modulusVector F) u q A)=
      decodeTensor F A * Problem18LargeRootPredicate20261001.rawAdjoint u q (decodeTensor F A) := by
  ext r s
  simp only [decodeMatrix,gram,mget_build]
  rw [total_decode F _ (fun _=>total_canonical F _ (fun _=>mul_canonical F _ _))]
  simp_rw [total_decode F _ (fun _=>mul_canonical F _ _),decode_mul,scalarAdj_decode]
  cases u <;> simp [Problem18LargeRootPredicate20261001.rawAdjoint,Matrix.mul_apply,
    Fintype.sum_prod_type,decodeTensor]
theorem first_decode {a b c : Nat} (u : Bool) (q : Nat)
    (A : Fin c → Fin a × Fin b → Coeff F.e) (t : Fin c) :
    decodeMatrix F (first F.p (modulusVector F) u q A t)=
      Problem18LargeRootPredicate20261001.rawFirst u q (decodeTensor F A) t := by
  ext j k
  simp only [decodeMatrix,first,mget_build]
  rw [total_decode F _ (fun _=>total_canonical F _ (fun _=>mul_canonical F _ _))]
  simp_rw [total_decode F _ (fun _=>mul_canonical F _ _),decode_mul]
  simp_rw [total_decode F _ (fun _=>mul_canonical F _ _),decode_mul,scalarAdj_decode]
  have hp:=matrixPower_decode F (gram F.p (modulusVector F) u q A) t.val
  rw [gram_decode F u q A] at hp
  simp only [Problem18LargeRootPredicate20261001.rawFirst,
    FiniteFieldOrthogonalUnitaryTI.partialTraceRight,Matrix.transpose_apply,Matrix.mul_apply]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro s _
  congr 1
  apply Finset.sum_congr rfl
  intro r _
  have hentry:=congrFun (congrFun hp r) s
  change decodeVector F (mget _ r s)=_ at hentry
  rw [hentry]
  cases u <;> rfl
theorem second_decode {a b c : Nat} (u : Bool) (q : Nat)
    (A : Fin c → Fin a × Fin b → Coeff F.e) (kl : Fin b × Fin b) :
    decodeMatrix F (second F.p (modulusVector F) u q A kl)=
      Problem18LargeRootPredicate20261001.rawSecond u q (decodeTensor F A) kl := by
  ext i j
  simp only [decodeMatrix,second,mget_build]
  rw [total_decode F _ (fun _=>mul_canonical F _ _)]
  simp_rw [decode_mul,scalarAdj_decode]
  cases u <;> simp [Problem18LargeRootPredicate20261001.rawSecond,
    Problem18LargeRootPredicate20261001.rawAdjoint,
    Problem18LargeSourcePredicate20261001.middleSlice,Matrix.mul_apply,decodeTensor]
theorem tensor_decode {a b c : Nat} (A : RectTensor a b c K) :
    decodeTensor F (tensor F.e a b c (tensorCoordinates F A))=A := by
  ext k ij
  have he : tensor F.e a b c (tensorCoordinates F A) k ij=coordinates F (A k ij) := by
    apply Vector.ext
    intro t ht
    simp only [tensor,coordinates,Vector.getElem_ofFn]
    exact Problem18EncodedTensorSort20261001.tensorCoordinates_getD F A k ij.1 ij.2 ⟨t,ht⟩
  change decodeVector F (tensor F.e a b c (tensorCoordinates F A) k ij)=_
  rw [he,decode_coordinates]
theorem largeCheck_refines {a b c : Nat} (u : Bool) (q : Nat) (A : RectTensor a b c K) :
    largeCheck F.p F.e a b c (modulusVector F) u q (tensorCoordinates F A)=
      Problem18LargeRootPredicate20261001.rawCheck u q A := by
  apply Bool.eq_iff_iff.mpr
  simp only [largeCheck,Bool.and_eq_true,rankCheck_correct,
    Problem18LargeRootPredicate20261001.rawCheck,
    Problem18ExecutableAlgebra20261001.generationCheck_correct]
  simp_rw [first_decode,second_decode,tensor_decode]
end Mathproof.Problem18CoordinateCovariants20261002
