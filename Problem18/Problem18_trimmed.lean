section Fields
variable {K : Type} [Field K] [DecidableEq K] [Fintype K]
variable (L : Type) [Field L] [Algebra K L] [IsAlgClosed L] [Algebra.IsAlgebraic K L]
theorem weilLower : WeilLower K := by
  intro F instF instKF instPF instRF instKP instPR instFF instSep instFull
  exact Mathproof.Problem18CurvePointLowerBound20261001.degree_one_lower K F
theorem curve_points (n d : Nat) : CurvePoint (K := K) L n d (curveThreshold n d) :=
  curvePoint_of_coords L n d (coefficientBound n d) (degreeBound n d)
    weilLower (coordRelations n d) (coordDegree n d)
theorem zero_variable_point (fs : List (MvPolynomial (Fin 0) K))
    (hfix : HasFixedComponent L fs) :
    ∃ x : Fin 0 → K, ∀ f ∈ fs, eval x f = 0 := by
  classical
  obtain ⟨P, hP, -⟩ := hfix
  haveI : P.IsPrime := hP.isPrime
  refine ⟨Fin.elim0, ?_⟩
  intro f hf
  obtain ⟨c, rfl⟩ := C_surjective (Fin 0) f
  have hmem : C (algebraMap K L c) ∈ P := by
    apply hP.1.2
    exact Ideal.subset_span ⟨C c, hf, by simp⟩
  have hc : c = 0 := by
    by_contra h
    have hL : algebraMap K L c ≠ 0 := (map_ne_zero (algebraMap K L)).2 h
    have hu : IsUnit (C (algebraMap K L c) : MvPolynomial (Fin 0) L) :=
      (isUnit_iff_ne_zero.mpr hL).map C
    exact (Ideal.notMem_of_isUnit P hu) hmem
  simp [hc]
theorem positive_variable_point (n d : Nat) (hn : 1 ≤ n)
    (fs : List (MvPolynomial (Fin n) K)) (hb : Bounded d fs)
    (hq : pointThreshold n d < Fintype.card K) (hfix : HasFixedComponent L fs) :
    ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0 := by
  let P := pencilParts (K := K) L n hn (fun e => curveThreshold n (descentDegree n e))
    (fun e => curve_points L n (descentDegree n e))
  let B := bridgeT L (P.T d) P.Ω P.u P.u₀ P.hu P.hu₀ P.hB (P.Qc d) (P.hC d) (P.hd d)
  exact pointExistence_of_bridgeT L B fs hb hq hfix
theorem rational_point (n d : Nat) (fs : List (MvPolynomial (Fin n) K))
    (hb : Bounded d fs) (hq : pointThreshold n d < Fintype.card K)
    (hfix : HasFixedComponent L fs) :
    ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0 := by
  cases n with
  | zero => exact zero_variable_point L fs hfix
  | succ n => exact positive_variable_point L (n+1) d (by omega) fs hb hq hfix
theorem backend_pointExistence (n : Nat) :
    Mathproof.Problem18ClaudeBackendInstance20261001.PointExistence
      (K := K) L n (pointThreshold n) := by
  intro d rows fs hrep hq hfix
  exact rational_point L n d fs (bounded_of_represents rows fs hrep) hq hfix
end Fields
