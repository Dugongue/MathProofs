theorem polynomialComputer_output_length_le
    {f : In→Mid}
    (first : EncodedTM encIn encMid f)
    (x : In) :
    (encMid (f x)).length ≤
      (encIn x).length + first.time.eval (encIn x).length * maxPushPerStep first.tm := by
