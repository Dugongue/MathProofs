def maxList : List Nat → Nat
  | [] => 0
  | x :: xs => max x (maxList xs)
theorem le_maxList_of_mem {x : Nat} :
    ∀ {xs : List Nat}, x ∈ xs → x ≤ maxList xs
  | [], h => by simp at h
  | y :: ys, h => by
      simp only [List.mem_cons] at h
      simp only [maxList]
      rcases h with rfl | h
      · exact Nat.le_max_left _ _
      · exact (le_maxList_of_mem h).trans (Nat.le_max_right _ _)
def depthValues (n d : Nat) : List Nat :=
  (patterns (boxSize n (cpE n d))).flatMap fun pat =>
    (clauses (qe (template n d pat))).flatMap fun cl =>
      (sysExprs cl).flatMap fun p =>
        (rowExprs p (clauseDeg cl)).map polyDepth
def constValues (n d : Nat) : List Nat :=
  (patterns (boxSize n (cpE n d))).flatMap fun pat =>
    (clauses (qe (template n d pat))).flatMap fun cl =>
      (sysExprs cl).flatMap fun p =>
        (rowExprs p (clauseDeg cl)).map constBound
def requiredDepth (n d : Nat) : Nat := maxList (depthValues n d)
def wordNeed {n d : Nat}
    (pat : Σ k : Nat, Fin k → Fin (boxSize n (cpE n d)))
    (cl : Clause (Fin (boxSize n d * boxSize n d +
      pat.1 * boxSize n (cpE n d))) Int) : Nat :=
  (sysExprs cl).length + (pat.1 * boxSize n (cpE n d) + 1) +
    lenM (pat.1 * boxSize n (cpE n d) + 1)
      (eliminantShift (pat.1 * boxSize n (cpE n d) + 1) (clauseDeg cl)) +
    lenD (pat.1 * boxSize n (cpE n d) + 1) (clauseDeg cl) +
    lenM (pat.1 * boxSize n (cpE n d) + 1)
      (geoE (pat.1 * boxSize n (cpE n d) + 1)
        (frobeniusDegree (pat.1 * boxSize n (cpE n d) + 1) (clauseDeg cl))) +
    rowLength (pat.1 * boxSize n (cpE n d) + 1) (clauseDeg cl)
def wordValues (n d : Nat) : List Nat :=
  (patterns (boxSize n (cpE n d))).flatMap fun pat =>
    (clauses (qe (template n d pat))).map fun cl => wordNeed pat cl
def requiredWord (n d : Nat) : Nat :=
  max (maxList (constValues n d)) (maxList (wordValues n d))
theorem depth_bound (n d : Nat)
    (pat : Σ k : Nat, Fin k → Fin (boxSize n (cpE n d)))
    (hpat : pat ∈ patterns (boxSize n (cpE n d)))
    (cl : Clause (Fin (boxSize n d * boxSize n d +
      pat.1 * boxSize n (cpE n d))) Int)
