theorem bits_of_ne_zero {Q : ℕ} (hQ : Q ≠ 0) : Q.bits = decide (Q % 2 = 1) :: (Q / 2).bits := by
  rcases Nat.mod_two_eq_zero_or_one Q with h | h
  · have hQ2 : Q = 2 * (Q / 2) := by omega
    have hne : Q / 2 ≠ 0 := by omega
    conv_lhs => rw [hQ2]
    rw [Nat.bit0_bits _ hne, h]
    simp
  · have hQ2 : Q = 2 * (Q / 2) + 1 := by omega
    conv_lhs => rw [hQ2]
    rw [Nat.bit1_bits, h]
    simp
def powP {D : ℕ} (cs x : Vector K D) (Q : ℕ) : Vector K D := (powBits cs x Q.bits).1
theorem powP_zero {D : ℕ} (cs x : Vector K D) : powP cs x 0 = oneVec D := by
  simp [powP, powBits]
theorem powP_ne_zero {D : ℕ} (cs x : Vector K D) {Q : ℕ} (hQ : Q ≠ 0) :
