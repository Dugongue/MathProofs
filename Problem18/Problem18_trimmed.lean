variable {K : Type*} [Field K] [DecidableEq K]
structure CertificateResult (K : Type*) (r : Nat) where
  member : Bool
  coefficients : Vector K r
  fieldOps : Nat
def rowFamily {c : Nat} (rs : List (Vector K c)) : Fin rs.length → Fin c → K :=
  fun i => read rs[i.val]
def arrayCertificate {c : Nat} (rs : List (Vector K c)) (x : Vector K c) :
    CertificateResult K rs.length :=
  let v := rowFamily rs
  let a := reduceArray (List.finRange c) (Fin.castAdd rs.length) (rows v) (query (read x))
  let s := spanCheck rs x
  ⟨s.1,Vector.ofFn (fun j => -read a.1 (j.natAdd c)),s.2+a.2+rs.length⟩
theorem rowFamily_range {c : Nat} (rs : List (Vector K c)) :
    Set.range (rowFamily rs) = {v | v ∈ rs.map read} := by
  ext v
  simp only [Set.mem_range,Set.mem_setOf_eq,List.mem_map,rowFamily]
  constructor
  · rintro ⟨i,rfl⟩
    exact ⟨rs[i.val],List.getElem_mem i.isLt,rfl⟩
  · rintro ⟨x,hx,rfl⟩
    obtain ⟨i,hi,rfl⟩ := List.getElem_of_mem hx
    exact ⟨⟨i,hi⟩,rfl⟩
theorem arrayCertificate_member {c : Nat} (rs : List (Vector K c)) (x : Vector K c) :
    (arrayCertificate rs x).member=true ↔ read x∈rowSpan (K:=K) (rs.map read) :=
  spanCheck_iff rs x
theorem arrayCertificate_coefficients {c : Nat} (rs : List (Vector K c)) (x : Vector K c)
    (h : (arrayCertificate rs x).member=true) :
    ∑ j : Fin rs.length, read (arrayCertificate rs x).coefficients j • rowFamily rs j = read x := by
  have hx := (arrayCertificate_member rs x).mp h
  have hc := coordinates_solution (rowFamily rs) (read x) (by
    simpa only [rowFamily_range,rowSpan] using hx)
  exact hc
theorem arrayCertificate_cost {c : Nat} (rs : List (Vector K c)) (x : Vector K c) :
    (arrayCertificate rs x).fieldOps ≤
      2*rs.length*c+(4*c+2*rs.length+2)*rs.length^2+c+rs.length := by
  have hs := spanCheck_cost_le rs x
  have ha := reduceArray_cost_le (List.finRange c) (Fin.castAdd rs.length)
    (rows (rowFamily rs)) (query (read x))
  simp only [rows,List.length_map,List.length_finRange] at ha
  change (spanCheck rs x).2+_+rs.length≤_
  dsimp only [rows]
  nlinarith
def completionDepth (N d : Nat) : Nat := controlledDepth N d
def certificateDegree (N d t : Nat) : Nat := 2*d*2^(completionDepth N d)+t
def targetRow {N : Nat} (t B : Nat) (v : DenseInput N t K) : DenseInput N B K :=
  Vector.ofFn fun i => inputCoefficient t v ((boundedExponents N B)[i.val])
def membershipCertificate {N : Nat} (d t : Nat) (vs : List (DenseInput N d K))
    (p : DenseInput N t K) :
    CertificateResult K (macaulayRows d (certificateDegree N d t) vs).length :=
  arrayCertificate (macaulayRows d (certificateDegree N d t) vs)
    (targetRow t (d+certificateDegree N d t) p)
theorem targetRow_correct {N : Nat} (t B : Nat) (v : DenseInput N t K)
    (p : MvPolynomial (Fin N) K) (hv : ValidDenseInput t v p) :
    read (targetRow t B v) = observePolynomial B p := by
  ext i
  simpa only [targetRow,read_ofFn,observePolynomial,LinearMap.coe_mk,AddHom.coe_mk] using
    inputCoefficient_correct t v p hv ((boundedExponents N B)[i.val])
theorem valid_family_degrees {N : Nat} (d : Nat) (vs : List (DenseInput N d K))
    (fs : List (MvPolynomial (Fin N) K)) (hv : List.Forall₂ (ValidDenseInput d) vs fs) :
    ∀ f∈fs.toFinset, f.totalDegree≤d := by
  have h : ∀ f∈fs, f.totalDegree≤d := by
    induction hv with
    | nil => simp
    | @cons v f vs fs hv hs ih =>
      intro g hg
      rcases List.mem_cons.mp hg with rfl | hg
      · exact hv.1
      · exact ih g hg
  exact fun f hf => h f (List.mem_toFinset.mp hf)
theorem membershipCertificate_correct {N : Nat} (d t : Nat)
    (vs : List (DenseInput N d K)) (fs : List (MvPolynomial (Fin N) K))
    (hv : List.Forall₂ (ValidDenseInput d) vs fs)
    (v : DenseInput N t K) (p : MvPolynomial (Fin N) K) (hp : ValidDenseInput t v p) :
    (membershipCertificate d t vs v).member=true ↔
      p∈generatedIdeal (fs.toFinset : Set _) := by
  classical
  let E := certificateDegree N d t
  have hF := valid_family_degrees d vs fs hv
  have hspan : rowSpan (K:=K) ((macaulayRows d E vs).map read)=
      (macaulaySpan (fs.toFinset : Set _) E).map (observePolynomial (d+E)) := by
    rw [macaulayRows_read d E vs fs hv,← polynomialRows_span E fs]
    simp only [rowSpan,Submodule.map_span]
    congr 1
    ext x
    simp
  have ht : p.totalDegree≤d+E := by
    have hpt:=hp.1
    dsimp [E,certificateDegree]
    omega
  change (arrayCertificate _ _).member=true ↔ _
  rw [arrayCertificate_member,targetRow_correct t (d+E) v p hp,hspan]
  constructor
  · rintro ⟨q,hq,heq⟩
    have hqdeg : q.totalDegree≤d+E :=
      macaulay_span_degree (N:=N) (K:=K) d E
        (fs.toFinset : Set (MvPolynomial (Fin N) K)) hF (p:=q) hq
    have hqp := observePolynomial_injective_bounded (d+E) q p hqdeg ht heq
    exact hqp ▸ macaulaySpan_le_ideal (N:=N) (K:=K)
      (fs.toFinset : Set (MvPolynomial (Fin N) K)) E hq
  · intro h
    have hc := (mem_ideal_iff_uniform_macaulay fs.toFinset d hF p).mp h
    have hEt : 2*d*2^(controlledDepth N d)+p.totalDegree≤E := by
      have hpt:=hp.1
      dsimp [E,certificateDegree,completionDepth]
      omega
    exact ⟨p,macaulaySpan_mono hEt hc,rfl⟩
theorem polynomialRow_mem {N : Nat} (E : Nat)
    (fs : List (MvPolynomial (Fin N) K)) (i : Nat) :
    (polynomialRows E fs).getD i 0 ∈ macaulaySpan (fs.toFinset : Set _) E := by
  by_cases hi : i<(polynomialRows E fs).length
  · rw [List.getD_eq_getElem _ _ hi,← polynomialRows_span]
    exact mem_rowSpan _ _ (List.getElem_mem hi)
  · rw [List.getD_eq_default _ _ (Nat.le_of_not_gt hi)]
    exact Submodule.zero_mem _
theorem polynomialRows_observation {N : Nat} (d E : Nat)
    (vs : List (DenseInput N d K)) (fs : List (MvPolynomial (Fin N) K))
    (hv : List.Forall₂ (ValidDenseInput d) vs fs)
    (i : Fin (macaulayRows d E vs).length) :
    rowFamily (macaulayRows d E vs) i =
      observePolynomial (d+E) ((polynomialRows E fs).getD i.val 0) := by
  have h := congrArg (fun l : List (Fin (boundedExponents N (d+E)).length → K) =>
    l.getD i.val 0) (macaulayRows_read d E vs fs hv)
  rw [List.getD_eq_getElem _ _ (by simpa using i.isLt),List.getElem_map] at h
  have hz : observePolynomial (d+E) (0 : MvPolynomial (Fin N) K)=0 := map_zero _
  rw [← hz,List.getD_map] at h
  exact h
def unitTarget (N : Nat) : DenseInput N 0 K := constantRow N 0
theorem unitTarget_valid (N : Nat) :
    ValidDenseInput 0 (unitTarget N : DenseInput N 0 K) 1 := by
  constructor
  · simp
  · intro i
    simp [unitTarget,constantRow,coeff_one,eq_comm]
