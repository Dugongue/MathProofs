theorem intertwiner_aeval (T : V ≃ₗ[K] W) (S : Module.End K V) (R : Module.End K W)
    (hT : ∀ x,T (S x)=R (T x)) (p : K[X]) (x : V) :
    T ((aeval S p) x)=(aeval R p) (T x) := by
  have hp (n : ℕ) (v : V) : T ((S^n) v)=(R^n) (T v) := by
    induction n with
    | zero => simp
    | succ n ih => simp only [pow_succ',Module.End.mul_apply,hT,ih]
  induction p using Polynomial.induction_on' with
  | add p q ihp ihq => simp only [aeval_add,LinearMap.add_apply,map_add,ihp,ihq]
  | monomial n a =>
    simp only [aeval_monomial,← Algebra.smul_def,LinearMap.smul_apply,map_smul,hp]
theorem intertwiner_primary_map (T : V ≃ₗ[K] W)
    (S : Module.End K V) (R : Module.End K W) (hT : ∀ x,T (S x)=R (T x)) (p : K[X]) :
    (LinearMap.ker (aeval S p)).map T.toLinearMap=LinearMap.ker (aeval R p) := by
  ext y
  rw [Submodule.mem_map,LinearMap.mem_ker]
  constructor
  · rintro ⟨x,hx,rfl⟩
    change (aeval R p) (T x)=0
    rw [← intertwiner_aeval T S R hT,LinearMap.mem_ker.mp hx,map_zero]
  · intro hy
    refine ⟨T.symm y,?_,T.apply_symm_apply y⟩
    apply LinearMap.mem_ker.mpr
    apply T.injective
    rw [intertwiner_aeval T S R hT,T.apply_symm_apply,hy,map_zero]
noncomputable def primaryIntertwiner (T : V ≃ₗ[K] W)
    (S : Module.End K V) (R : Module.End K W) (hT : ∀ x,T (S x)=R (T x)) (p : K[X]) :
    LinearMap.ker (aeval S p) ≃ₗ[K] LinearMap.ker (aeval R p) :=
  T.ofSubmodules _ _ (intertwiner_primary_map T S R hT p)
theorem primaryIntertwiner_apply (T : V ≃ₗ[K] W)
    (S : Module.End K V) (R : Module.End K W) (hT : ∀ x,T (S x)=R (T x)) (p : K[X])
    (x : LinearMap.ker (aeval S p)) :
    (primaryIntertwiner T S R hT p x : W)=T x := rfl
