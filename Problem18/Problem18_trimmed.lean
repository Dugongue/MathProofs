open scoped BigOperators Matrix
open Matrix
variable {K : Type*} [Field K] [Fintype K] [DecidableEq K]
def CrossZeroPairs (k r z : ℕ) : Type _ :=
  {P : Matrix (Fin k) (Fin r) K × Matrix (Fin z) (Fin r) K //
    ∀ i, P.1.mulVec (P.2 i) = 0}
private def crossZeroPairsEquivSigma (k r z : ℕ) :
    CrossZeroPairs (K := K) k r z ≃
      Σ A : Matrix (Fin k) (Fin r) K,
        {N : Matrix (Fin z) (Fin r) K // ∀ i, A.mulVec (N i) = 0} where
  toFun P := ⟨P.1.1, ⟨P.1.2, P.2⟩⟩
  invFun P := ⟨(P.1, P.2.1), P.2.2⟩
  left_inv P := rfl
  right_inv P := rfl
theorem crossZero_probability_eq_rank_sum (k r z : ℕ) :
    (Nat.card (CrossZeroPairs (K := K) k r z) : ℝ) /
        Fintype.card (Matrix (Fin k) (Fin r) K × Matrix (Fin z) (Fin r) K) =
      ∑ s : Fin (min k r + 1),
        (Nat.card {A : Matrix (Fin k) (Fin r) K // A.rank = s.val} : ℝ) /
            Fintype.card (Matrix (Fin k) (Fin r) K) *
          ((Fintype.card K : ℝ) ^ (s.val * z))⁻¹ := by
  classical
  let q : ℝ := Fintype.card K
  let f : Matrix (Fin k) (Fin r) K → Fin (min k r + 1) := fun A =>
    ⟨A.rank, Nat.lt_succ_of_le (le_min
      (by simpa only [Fintype.card_fin] using A.rank_le_card_height)
      (by simpa only [Fintype.card_fin] using A.rank_le_card_width))⟩
  have hc (s : Fin (min k r + 1)) :
      Nat.card {A : Matrix (Fin k) (Fin r) K // f A = s} =
        Nat.card {A : Matrix (Fin k) (Fin r) K // A.rank = s.val} := by
    apply Nat.card_congr
    exact Equiv.subtypeEquivRight (fun A => Fin.ext_iff)
  have hzero (A : Matrix (Fin k) (Fin r) K) :
      Fintype.card {N : Matrix (Fin z) (Fin r) K //
          ∀ i, A.mulVec (N i) = 0} =
        Fintype.card K ^ ((r - A.rank) * z) := by
    exact Mathproof.Problem18CrossConstraint20260929.zeroRows_card
      r k z A.rank A.mulVecLin (by rfl)
  have hcross :
      (Nat.card (CrossZeroPairs (K := K) k r z) : ℝ) =
        ∑ A : Matrix (Fin k) (Fin r) K, q ^ ((r - A.rank) * z) := by
    have he := Nat.card_congr (crossZeroPairsEquivSigma (K := K) k r z)
    rw [Nat.card_sigma] at he
    rw [he, Nat.cast_sum]
    apply Finset.sum_congr rfl
    intro A _
    rw [Nat.card_eq_fintype_card]
    change (Fintype.card {N : Matrix (Fin z) (Fin r) K //
      ∀ i, A.mulVec (N i) = 0} : ℝ) =
        (Fintype.card K : ℝ) ^ ((r - A.rank) * z)
    exact_mod_cast hzero A
  have hfiber := Fintype.sum_fiberwise' f
    (fun s => q ^ ((r - s.val) * z))
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
    ← Nat.card_eq_fintype_card, hc] at hfiber
  have hgroup :
      (∑ A : Matrix (Fin k) (Fin r) K, q ^ ((r - A.rank) * z)) =
        ∑ s : Fin (min k r + 1),
          (Nat.card {A : Matrix (Fin k) (Fin r) K // A.rank = s.val} : ℝ) *
            q ^ ((r - s.val) * z) := by
    change (∑ A, q ^ ((r - (f A).val) * z)) = _
    exact hfiber.symm
  rw [hcross, hgroup]
  have hkcard : (Fintype.card (Matrix (Fin k) (Fin r) K) : ℝ) =
      q ^ (k * r) := by
    dsimp only [q]
    norm_cast
    change Fintype.card (Fin k → Fin r → K) = _
    simp only [Fintype.card_fun, Fintype.card_fin, ← pow_mul, Nat.mul_comm r k]
  have hzcard : (Fintype.card (Matrix (Fin z) (Fin r) K) : ℝ) =
      q ^ (z * r) := by
    dsimp only [q]
    norm_cast
    change Fintype.card (Fin z → Fin r → K) = _
    simp only [Fintype.card_fun, Fintype.card_fin, ← pow_mul, Nat.mul_comm r z]
  rw [Fintype.card_prod, Nat.cast_mul, hkcard, hzcard, Finset.sum_div]
  apply Finset.sum_congr rfl
  intro s _
  have hs : s.val ≤ r := (Nat.le_of_lt_succ s.isLt).trans (min_le_right _ _)
  have hexp : (r - s.val) * z + s.val * z = z * r := by
    rw [← add_mul, Nat.sub_add_cancel hs, Nat.mul_comm]
  have hq : 0 < q := by positivity
  field_simp [ne_of_gt hq]
  change _ * q ^ ((r - s.val) * z) * q ^ (s.val * z) =
    _ * q ^ (z * r)
  calc
    _ = _ * (q ^ ((r - s.val) * z) * q ^ (s.val * z)) := by ring
    _ = _ * q ^ (((r - s.val) * z) + s.val * z) := by rw [pow_add]
    _ = _ := by rw [hexp]
theorem crossZero_probability_largeComplement
    (k r z n : ℕ) (hkn : 2 * k ≤ n) (hrn : 2 * r ≤ n)
    (hzn : n ≤ 4 * z) :
    (Nat.card (CrossZeroPairs (K := K) k r z) : ℝ) /
        Fintype.card (Matrix (Fin k) (Fin r) K × Matrix (Fin z) (Fin r) K) ≤
      4 * (k + 1) *
        ((Fintype.card K : ℝ) ^ ((k * r) / 8))⁻¹ := by
  rw [crossZero_probability_eq_rank_sum]
  exact Mathproof.Problem18AnchorRankStrata20260930.cross_rank_sum_largeComplement
    k r z n hkn hrn hzn
end Mathproof.Problem18AnchorCrossEvent20260930
