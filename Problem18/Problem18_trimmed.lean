def Keep (σ τ : Env) (lo hi : Nat) : Prop :=
  ∀ j, lo ≤ j → j < hi → (τ.arrs canonical.mem).getD j 0 = (σ.arrs canonical.mem).getD j 0
theorem keep_trans {σ ρ τ : Env} {lo hi : Nat} (h1 : Keep σ ρ lo hi) (h2 : Keep ρ τ lo hi) :
    Keep σ τ lo hi := fun j a b => (h2 j a b).trans (h1 j a b)
theorem keep_mono {σ τ : Env} {lo hi lo' hi' : Nat} (h : Keep σ τ lo hi)
    (h1 : lo ≤ lo') (h2 : hi' ≤ hi) : Keep σ τ lo' hi' :=
  fun j a b => h j (by omega) (by omega)
theorem keep_of1 {σ τ : Env} {O L : Nat}
    (hf : ∀ j, (j < O ∨ O + L ≤ j) →
