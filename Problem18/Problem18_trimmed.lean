      have hue : τe.vars q.u = uv := by rw [hregse q.u (hq.2 _ (by simp [RNames.list])) huw huj, hup']
      have hinc : (plus (.var q.u) (.lit 1)).evalB B τe = some (uv + 1) := by
        unfold plus
        rw [← hue]
        exact evalB_bin (evalB_var (by rw [hue]; omega)) (evalB_lit (by omega))
          (by change τe.vars q.u + 1 < B; rw [hue]; omega)
      have hct : (Cond.eq (.var q.f) (.lit 1)).evalB B τp = some true := by
        rw [hcond_eval, hf]; rfl
      refine ⟨τe.setVar q.u (uv + 1), ?_, ⟨Slots.setVar F r hSe huS huW _, ?_, ?_, ?_, ?_, ?_, ?_,
        ?_, ?_⟩, ?_⟩
      · refine (hrp.seq ((Run.ite_true hct hre).seq (Run.assign hinc))).mono ?_
        have e1 : (Cond.eq (Expr.var q.f) (Expr.lit 1)).size = 3 := rfl
        have e2 : (plus (Expr.var q.u) (Expr.lit 1)).size = 3 := rfl
        rw [e1, e2]; unfold stepCost; omega
      · simp only [vars_setVar, if_true]; omega
      · intro x hx hxm
        obtain ⟨h1, h2, h3, h4, h5, h6⟩ := hmov x hxm
        simp only [vars_setVar, if_neg h1]
        rw [hregse x hx h2 h3, hregsp x hx h4 h6 h5]; exact hregs x hx hxm
      · rw [val_setVar F r huW, hfre 0 (by omega) (Or.inl rfl), hvalp]; exact hzτ
      · have hlist : restRows (val F r q.WS (τe.setVar q.u (uv + 1))) Nv cv (uv + 1) =
            (restRows (val F r q.WS τ) Nv cv (uv + 1)).map
              (eliminate (observe (Fin.castLE hnN)) ⟨τp.vars q.pv, hp⟩
                (rowVec (val F r q.WS τ) (rowStart Nv uv) Nv)) := by
          unfold restRows
          rw [List.map_map]
          apply List.map_congr_left
          intro t ht
          have ht' := List.mem_range.mp ht
          simp only [Function.comp_apply]
          rw [elimVec_eq hnN]
          funext k
          simp only [rowVec, elimVec, Fin.coe_castLE]
          rw [val_setVar F r huW, hrows (uv + 1 + t) (by omega) (by omega) k.val k.isLt, hvalp,
            hvalp, hvalp, hvalp]
        have hxv : rowVec (val F r q.WS (τe.setVar q.u (uv + 1))) 5 Nv =
            eliminate (observe (Fin.castLE hnN)) ⟨τp.vars q.pv, hp⟩
              (rowVec (val F r q.WS τ) (rowStart Nv uv) Nv) (rowVec (val F r q.WS τ) 5 Nv) := by
          rw [elimVec_eq hnN]
          funext k
          simp only [rowVec, elimVec, Fin.coe_castLE]
          rw [val_setVar F r huW, hxe k.val k.isLt, hvalp, hvalp, hvalp, hvalp]
        have hu' : (τe.setVar q.u (uv + 1)).vars q.u = uv + 1 := by simp
        rw [hu', hlist, hxv, ← hred, hrestτ, reduce_cons_some hnN _ _ _ _ hpv]
      · intro s hs hge
        rw [val_setVar F r huW, hfre s hs (Or.inr (Or.inr hge)), hvalp]; exact hhigh s hs hge
      · intro a h1 h2
        simp only [arrs_setVar]; rw [harre a h1 h2, harrp a h1 h2]; exact harr a h1 h2
      · simp only [inp_setVar]; rw [hinpe, hinpp]; exact hinp
      · simp only [out_setVar]; rw [houte, houtp]; exact hout
      · simp only [vars_setVar, if_true]; omega
    ·
      have hnone := hpiv.2 hf
      have hinc : (plus (.var q.u) (.lit 1)).evalB B τp = some (uv + 1) := by
