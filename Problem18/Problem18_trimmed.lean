open Problem18IMPFieldPresentation20261001 Problem18IMPFieldPower20261001
open Problem18IMPFieldPowerInitialization20261001
variable {K : Type} [Field K] (F : FieldPresentation K)
structure ValidMemory (B : Nat) (σ : Env) : Prop where
  degree : σ.vars canonical.e=F.e
  prime : σ.vars canonical.p=F.p
  arithmetic_word : (F.p+1)^2<B
  inverse_word : (F.p+1)^(F.e+1)<B
  memory_word : (σ.arrs canonical.mem).length<B
  scratch_word : (σ.arrs canonical.scratch).length<B
  scratch_fit : 5*F.e ≤ (σ.arrs canonical.scratch).length
  modulus_fit : σ.vars canonical.modBase+F.e ≤ (σ.arrs canonical.mem).length
  modulus_value : ∀i:Fin F.e,sourceCoeff σ canonical.mem canonical.modBase i.val=(F.modulus i).val
  coefficients : ∀j<(σ.arrs canonical.mem).length,(σ.arrs canonical.mem).getD j 0<F.p
abbrev Fits (σ : Env) (base : Nat) : Prop := base+F.e ≤ (σ.arrs canonical.mem).length
abbrev Disjoint (a b : Nat) : Prop := a+F.e ≤ b ∨ b+F.e ≤ a
def scratchRegisters : List String :=
  clobberedRegisters canonical true ++ [canonical.i,canonical.j,canonical.k,canonical.value]
def Preserves (σ τ : Env) : Prop :=
  (∀x,x∉scratchRegisters → τ.vars x=σ.vars x) ∧
  (∀arr,arr≠canonical.mem → arr≠canonical.scratch → τ.arrs arr=σ.arrs arr) ∧
  (∀arr,(τ.arrs arr).length=(σ.arrs arr).length) ∧ τ.inp=σ.inp ∧ τ.out=σ.out
variable {F} {B : Nat} {σ τ : Env}
theorem ValidMemory.slice_canonical (h : ValidMemory F B σ) (a : Nat) (ha : Fits F σ a) :
    Canonical F (slice F σ canonical a) := by
  intro i
  exact h.coefficients (a+i.val) (by have hi:=i.isLt; omega)
theorem ValidMemory.degree_word (h : ValidMemory F B σ) : F.e<B := by
  have hf:=h.scratch_fit
  have hw:=h.scratch_word
  omega
theorem ValidMemory.powerInput (h : ValidMemory F B σ)
    (ha : Fits F σ (σ.vars canonical.aBase)) (ho : Fits F σ (σ.vars canonical.outBase)) :
    PowerInput F canonical B σ := by
  exact {
    degree:=h.degree,prime:=h.prime,separate:=by decide,
    outer_names:=canonical_valid.1,inner_names:=canonical_innerNames,
    private_names:=canonical_privateNames,arithmetic_word:=h.arithmetic_word,
    memory_word:=h.memory_word,scratch_word:=h.scratch_word,scratch_fit:=h.scratch_fit,
    modulus_fit:=h.modulus_fit,modulus_value:=h.modulus_value,
    first_fit:=ha,first_canonical:=h.slice_canonical _ ha,output_fit:=ho }
theorem ValidMemory.pointInput (h : ValidMemory F B σ)
    (ha : Fits F σ (σ.vars canonical.aBase)) (hb : Fits F σ (σ.vars canonical.bBase))
    (ho : Fits F σ (σ.vars canonical.outBase))
    (hoa : Disjoint F (σ.vars canonical.outBase) (σ.vars canonical.aBase))
    (hob : Disjoint F (σ.vars canonical.outBase) (σ.vars canonical.bBase)) :
    PointInput F canonical B σ := by
  exact {
    degree:=h.degree,prime:=h.prime,names:=by decide,
    degree_word:=by rw [h.degree]; exact h.degree_word,
    arithmetic_word:=by rw [h.prime]; exact h.arithmetic_word,
    memory_word:=h.memory_word,
    first_fits:=by rw [h.degree]; exact ha,
    second_fits:=by rw [h.degree]; exact hb,
    output_fits:=by rw [h.degree]; exact ho,
    first_disjoint:=by rw [h.degree]; exact hoa,
    second_disjoint:=by rw [h.degree]; exact hob,
    first_canonical:=h.slice_canonical _ ha,second_canonical:=h.slice_canonical _ hb }
theorem ValidMemory.mulInput (h : ValidMemory F B σ)
    (ha : Fits F σ (σ.vars canonical.aBase)) (hb : Fits F σ (σ.vars canonical.bBase))
    (ho : Fits F σ (σ.vars canonical.outBase)) : MulInput canonical canonical.mem B σ := by
  refine {
    scalar_names:=canonical_valid.1,degree_pos:=by rw [h.degree]; exact F.degree_pos,
    arithmetic_word:=by rw [h.prime]; exact h.arithmetic_word,
    memory_word:=h.memory_word,modulus_word:=h.memory_word,scratch_word:=h.scratch_word,
    scratch_fit:=by rw [h.degree]; have hh:=h.scratch_fit; omega,
    first_fit:=by rw [h.degree]; exact ha,
    second_fit:=by rw [h.degree]; exact hb,
    modulus_fit:=by rw [h.degree]; exact h.modulus_fit,
    output_fit:=by rw [h.degree]; exact ho,
    first_separate:=Or.inl (by decide),second_separate:=Or.inl (by decide),
    modulus_separate:=Or.inl (by decide),output_separate:=Or.inl (by decide),
    coefficients:=?_ }
  intro j hj
  rw [h.degree] at hj
  rw [h.prime]
  exact ⟨h.coefficients _ (by omega),h.coefficients _ (by omega),
    h.coefficients _ (by have hh:=h.modulus_fit; omega)⟩
theorem ValidMemory.after (h : ValidMemory F B σ) (hf : Preserves σ τ)
    (hm : MemoryFrame F.e canonical σ τ)
    (hc : Canonical F (slice F τ canonical (σ.vars canonical.outBase)))
    (hd : Disjoint F (σ.vars canonical.outBase) (σ.vars canonical.modBase)) :
    ValidMemory F B τ := by
  have hp : τ.vars canonical.p=σ.vars canonical.p:=hf.1 _ (by decide)
  have he : τ.vars canonical.e=σ.vars canonical.e:=hf.1 _ (by decide)
  have hmod : τ.vars canonical.modBase=σ.vars canonical.modBase:=hf.1 _ (by decide)
  refine {
    degree:=he.trans h.degree,prime:=hp.trans h.prime,
    arithmetic_word:=h.arithmetic_word,inverse_word:=h.inverse_word,
    memory_word:=by rw [hf.2.2.1]; exact h.memory_word,
    scratch_word:=by rw [hf.2.2.1]; exact h.scratch_word,
    scratch_fit:=by rw [hf.2.2.1]; exact h.scratch_fit,
    modulus_fit:=by rw [hmod,hf.2.2.1]; exact h.modulus_fit,
    modulus_value:=?_,coefficients:=?_ }
  · intro i
    unfold sourceCoeff
    rw [hmod,hm]
    · exact h.modulus_value i
    · have hi:=i.isLt; have hh:=h.modulus_fit; omega
    · have hi:=i.isLt; rcases hd with hd|hd <;> omega
  · intro j hj
    rw [hf.2.2.1] at hj
    by_cases hlo : j<σ.vars canonical.outBase
    · rw [hm j hj (Or.inl hlo)]; exact h.coefficients j hj
    by_cases hhi : σ.vars canonical.outBase+F.e ≤ j
    · rw [hm j hj (Or.inr hhi)]; exact h.coefficients j hj
    have hi : j-σ.vars canonical.outBase<F.e:=by omega
    have hh:=hc ⟨j-σ.vars canonical.outBase,hi⟩
    change (τ.arrs canonical.mem).getD (σ.vars canonical.outBase+(j-σ.vars canonical.outBase)) 0<F.p at hh
    simpa only [Nat.add_sub_of_le (Nat.le_of_not_gt hlo)] using hh
inductive Primitive where
  | point (op : PointOp)
  | multiply
  | power
  | inverse
def Primitive.code : Primitive → Com
  | .point op=>pointRoutine canonical op
  | .multiply=>mulRoutine canonical
  | .power=>powRoutine canonical
  | .inverse=>invRoutine canonical
def Primitive.value (op : Primitive) (q : Nat) (a b : K) : K :=
  match op with
  | .point p=>fieldValue p a b
  | .multiply=>a*b
  | .power=>a^q
  | .inverse=>a⁻¹
def Primitive.cost (op : Primitive) (F : FieldPresentation K) (q : Nat) : Nat :=
  match op with
  | .point _=>1000*(F.e+1)
  | .multiply=>10000*(F.e+1)^2
  | .power=>100000*(F.e+1)^2*(q.size+1)
  | .inverse=>1000000*(F.e+1)^2*(F.e*(F.p.size+1)+1)
theorem primitive_preserves (op : Primitive) {cost : Nat}
    (hr : Run B op.code σ τ cost) : Preserves σ τ := by
  cases op with
  | point op =>
    have hf:=run_frame hr
    refine ⟨?_,?_,hf.2.2.1,?_,?_⟩
    · intro x hx
      apply hf.1 x
      simp only [Primitive.code,scalarWrites,pointRoutine,pointBody,Finset.mem_union,
        Finset.mem_singleton,Finset.notMem_empty,or_false,false_or,or_self]
      intro hxi
      subst x
      exact hx (by simp [scratchRegisters])
    · intro arr hm hs
      apply hf.2.1 arr
      simp [Primitive.code,arrayWrites,pointRoutine,pointBody,hm]
    · apply hf.2.2.2.1
      simp [Primitive.code,noRead,pointRoutine,pointBody]
    · apply hf.2.2.2.2
      simp [Primitive.code,Com.NoWrite,pointRoutine,pointBody]
  | multiply =>
    have hf:=run_frame hr
    refine ⟨?_,?_,hf.2.2.1,?_,?_⟩
    · intro x hx
      apply hf.1 x
      simp only [scratchRegisters,List.mem_append,List.mem_cons,List.not_mem_nil,or_false,not_or] at hx
      simp only [Primitive.code,scalarWrites,mulRoutine,mulCore,initAccumulator,hornerIteration,
        storeLoop,storeBody,workNames,finishNames,Finset.mem_union,Finset.mem_singleton,
        Finset.notMem_empty,or_false,false_or,not_or]
      tauto
    · intro arr hm hs
      apply hf.2.1 arr
      simp [Primitive.code,arrayWrites,mulRoutine,mulCore,initAccumulator,hornerIteration,
        storeLoop,storeBody,workNames,finishNames,hm,hs]
    · apply hf.2.2.2.1
      simp [Primitive.code,noRead,mulRoutine,mulCore,initAccumulator,hornerIteration,storeLoop,storeBody]
    · apply hf.2.2.2.2
      simp [Primitive.code,Com.NoWrite,mulRoutine,mulCore,initAccumulator,hornerIteration,storeLoop,storeBody]
  | power =>
    have hf:=power_inverse_frame canonical false hr
    refine ⟨?_,hf.2⟩
    intro x hx
    apply hf.1 x
    intro hh
    apply hx
    simp only [scratchRegisters,List.mem_append]
    left
    simp only [clobberedRegisters,List.mem_append,List.mem_cons,List.not_mem_nil,or_false] at hh ⊢
    tauto
  | inverse =>
    have hf:=power_inverse_frame canonical true hr
    refine ⟨?_,hf.2⟩
    intro x hx
    apply hf.1 x
    intro hh
    exact hx (List.mem_append_left _ hh)
theorem primitive_run (op : Primitive) (h : ValidMemory F B σ)
    (ha : Fits F σ (σ.vars canonical.aBase)) (hb : Fits F σ (σ.vars canonical.bBase))
    (ho : Fits F σ (σ.vars canonical.outBase))
    (hoa : Disjoint F (σ.vars canonical.outBase) (σ.vars canonical.aBase))
    (hob : Disjoint F (σ.vars canonical.outBase) (σ.vars canonical.bBase))
    (hex : σ.vars canonical.exp<B) :
    ∃τ,Run B op.code σ τ (op.cost F (σ.vars canonical.exp)) ∧
      decode F (slice F τ canonical (σ.vars canonical.outBase))=
        op.value (σ.vars canonical.exp)
          (decode F (slice F σ canonical (σ.vars canonical.aBase)))
          (decode F (slice F σ canonical (σ.vars canonical.bBase))) ∧
      Canonical F (slice F τ canonical (σ.vars canonical.outBase)) ∧
      MemoryFrame F.e canonical σ τ ∧ Preserves σ τ := by
  cases op with
  | point op =>
    have hi:=h.pointInput ha hb ho hoa hob
    obtain ⟨τ,hr,hv,hc,hrest⟩:=pointRoutine_correct F canonical op σ hi
    have hp : 0<σ.vars canonical.p:=by rw [h.prime]; exact F.prime.pos
    have hcoeff : ∀j<σ.vars canonical.e,
        (σ.arrs canonical.mem).getD (σ.vars canonical.aBase+j) 0<σ.vars canonical.p ∧
        (σ.arrs canonical.mem).getD (σ.vars canonical.bBase+j) 0<σ.vars canonical.p := by
      intro j hj
      rw [h.degree] at hj
      rw [h.prime]
      exact ⟨h.coefficients _ (by omega),h.coefficients _ (by omega)⟩
    have hknown:=pointRoutine_run (B:=B) canonical op σ hi.names hp hi.degree_word
      hi.arithmetic_word hi.memory_word hi.first_fits hi.second_fits hi.output_fits
      hi.first_disjoint hi.second_disjoint hcoeff
    have heq : τ=pointState σ canonical (resultValues σ canonical op) (σ.vars canonical.e) := by
      obtain ⟨k,hk,hkstep⟩:=hr.bigStep
      obtain ⟨l,hl,hlstep⟩:=hknown.bigStep
      exact (hkstep.unique hlstep).1
    refine ⟨τ,hr,hv,hc,?_,primitive_preserves (.point op) hr⟩
    intro j hj hsep
    rw [heq]
    apply pointState_read_preserved canonical σ _ _ j canonical.mem hj
    right
    simpa only [h.degree] using hsep
  | multiply =>
    have hi:=h.mulInput ha hb ho
    have hh:=mulCore_field_correct F canonical canonical.mem σ hi h.degree h.prime h.modulus_value
    refine ⟨completed canonical canonical.mem σ,hh.1,hh.2.1,hh.2.2,?_,
      primitive_preserves .multiply hh.1⟩
    intro j hj hsep
    exact completed_read_preserved hi canonical.mem j hj (Or.inl (by decide))
      (Or.inr (by simpa only [h.degree] using hsep))
  | power =>
    obtain ⟨τ,hr,hv,hc,hm⟩:=powRoutine_correct (h.powerInput ha ho) hex
    exact ⟨τ,hr,hv,hc,hm,primitive_preserves .power hr⟩
  | inverse =>
    obtain ⟨τ,hr,hv,hc,hm⟩:=invRoutine_correct (h.powerInput ha ho) canonical_cardPrivate
      canonical_cardNames_distinct h.inverse_word
    exact ⟨τ,hr,hv,hc,hm,primitive_preserves .inverse hr⟩
theorem primitive_run_preserving (op : Primitive) (h : ValidMemory F B σ)
    (ha : Fits F σ (σ.vars canonical.aBase)) (hb : Fits F σ (σ.vars canonical.bBase))
    (ho : Fits F σ (σ.vars canonical.outBase))
    (hoa : Disjoint F (σ.vars canonical.outBase) (σ.vars canonical.aBase))
    (hob : Disjoint F (σ.vars canonical.outBase) (σ.vars canonical.bBase))
    (hom : Disjoint F (σ.vars canonical.outBase) (σ.vars canonical.modBase))
    (hex : σ.vars canonical.exp<B) :
    ∃τ,Run B op.code σ τ (op.cost F (σ.vars canonical.exp)) ∧ ValidMemory F B τ ∧
      decode F (slice F τ canonical (σ.vars canonical.outBase))=
        op.value (σ.vars canonical.exp)
          (decode F (slice F σ canonical (σ.vars canonical.aBase)))
          (decode F (slice F σ canonical (σ.vars canonical.bBase))) ∧
      MemoryFrame F.e canonical σ τ ∧ Preserves σ τ := by
  obtain ⟨τ,hr,hv,hc,hm,hf⟩:=primitive_run op h ha hb ho hoa hob hex
  exact ⟨τ,hr,h.after hf hm hc hom,hv,hm,hf⟩
end Mathproof.Problem18IMPFieldPrimitives20261001
