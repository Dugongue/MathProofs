      ∀i,ZeroError C (BitstringEncoding.bitEncode (input i)) (answer i) ∧
        ExpectedStepsLE C (BitstringEncoding.bitEncode (input i))
          ((P.eval (BitstringEncoding.bitEncode (input i)).length : Nat) : ℝ) := by
  let J : Type := {z : List Nat×Option Bool // ∃i,input i=z.1 ∧ answer i=z.2}
  have hj : ∀z:J,FitsInWords (W.eval (bitSize z.val.1))
      ((z.val.1.length::z.val.1)++Problem18RAMAnswerCodec20261001.answerWords z.val.2) ∧
      ∀w,W.eval (bitSize z.val.1)≤w→∃t≤T.eval (bitSize z.val.1),
        Lax13.Ram.RunsTo w p (z.val.1.length::z.val.1)
          (Problem18RAMAnswerCodec20261001.answerWords z.val.2) t := by
    intro z
    obtain ⟨i,hi,ho⟩:=z.property
    simpa only [←hi,←ho] using hram i
  obtain ⟨C,P,hd,hC⟩:=deterministic_query_small
    (fun z:J=>z.val.1) (fun z:J=>z.val.2) p W T hj
  exact ⟨C,P,hd,fun i=>hC ⟨(input i,answer i),⟨i,rfl,rfl⟩⟩⟩
theorem compile_query {ι : Type u} (input : ι→List Nat) (answer : ι→Option Bool)
    (L : Layout) (c : Com) (P T : Polynomial Nat) (hok : Com.Ok L c)
    (hrun : ∀i,∃(ext : String→Nat)(σ : Env),
      Run (2^(P.eval (bitSize (input i))+bitSize (input i)+1)) c
        (initEnv ext ((input i).length::input i)) σ (T.eval (bitSize (input i))) ∧
      σ.out=Problem18RAMAnswerCodec20261001.answerWords (answer i)) :
    ∃C : CoinMachine,∃Q : Polynomial Nat,
      (∀bit,C.program bit=C.program false) ∧
      ∀i,ZeroError C (BitstringEncoding.bitEncode (input i)) (answer i) ∧
        ExpectedStepsLE C (BitstringEncoding.bitEncode (input i))
          ((Q.eval (BitstringEncoding.bitEncode (input i)).length : Nat) : ℝ) := by
  apply deterministic_query input answer (compileProgram L c)
    (wordBound L P) (timeBound L T)
  intro i
  exact compileProgram_runs_polynomial L c P T hok (input i)
    (Problem18RAMAnswerCodec20261001.answerWords (answer i)) (hrun i)
structure FieldData where
  carrier : Type
  fieldInst : Field carrier
  finiteInst : Fintype carrier
  presentation : @FieldPresentation carrier fieldInst
instance (F : FieldData) : Field F.carrier := F.fieldInst
instance (F : FieldData) : Fintype F.carrier := F.finiteInst
structure Query (cutoff : Nat) where
  fieldData : FieldData
  unitary : Bool
  q : Nat
  a : Nat
  b : Nat
  c : Nat
  valid : validSize fieldData.carrier unitary q
  positiveA : 0<a
  positiveB : 0<b
  positiveC : 0<c
  bounded : median a b c<cutoff
  source : Problem18OrthogonalAssembly.RectTensor a b c fieldData.carrier
  target : Problem18OrthogonalAssembly.RectTensor a b c fieldData.carrier
def words {cutoff : Nat} (x : Query cutoff) : List Nat :=
  queryWords x.fieldData.presentation x.unitary x.q x.source x.target
noncomputable def answer {cutoff : Nat} (x : Query cutoff) : Option Bool := by
  classical
  exact some (decide (equivalent x.unitary x.q x.source x.target))
def Executes (cutoff : Nat) (c : Com) (P T : Polynomial Nat) : Prop :=
  ∀x : Query cutoff,∃(ext : String→Nat)(σ : Env),
    Run (2^(P.eval (bitSize (words x))+bitSize (words x)+1)) c
      (initEnv ext ((words x).length::words x)) σ (T.eval (bitSize (words x))) ∧
    σ.out=Problem18RAMAnswerCodec20261001.answerWords (answer x)
theorem finish_cutoff (cutoff : Nat) (L : Layout) (c : Com) (P T : Polynomial Nat)
    (hok : Com.Ok L c) (hrun : Executes cutoff c P T) :
    ∃ (M : CoinMachine) (timeConstant timeExponent : Nat),
      (∀bit,M.program bit=M.program false) ∧
      ∀ (K : Type) [Field K] [Fintype K] (F : FieldPresentation K)
        (unitary : Bool) (q a b c : Nat),
        validSize K unitary q → 0<a → 0<b → 0<c → median a b c<cutoff →
        ∀ A B : Problem18OrthogonalAssembly.RectTensor a b c K,
          ZeroError M (queryBits F unitary q A B) (some (decide (equivalent unitary q A B))) ∧
          ExpectedStepsLE M (queryBits F unitary q A B)
            (timeConstant * (((a*b*c+1)*(q.size+1)) : Real)^timeExponent) := by
  classical
  obtain ⟨M,Q,hd,hM⟩:=compile_query (@words cutoff) (@answer cutoff) L c P T hok hrun
  obtain ⟨C,d,hC,hdpos,hQ⟩:=polynomial_query_bound Q
  refine ⟨M,C,d,hd,?_⟩
  intro K _ _ F unitary q a b c hv ha hb hc hcut A B
  let x : Query cutoff :=
    {fieldData:={carrier:=K,fieldInst:=inferInstance,finiteInst:=inferInstance,presentation:=F},
     unitary:=unitary,q:=q,a:=a,b:=b,c:=c,valid:=hv,
     positiveA:=ha,positiveB:=hb,positiveC:=hc,bounded:=hcut,source:=A,target:=B}
  have hm := hM x
  change ZeroError M (queryBits F unitary q A B)
      (some (decide (equivalent unitary q A B))) ∧
    ExpectedStepsLE M (queryBits F unitary q A B)
      ((Q.eval (queryBits F unitary q A B).length : Nat) : ℝ) at hm
  refine ⟨hm.1,?_⟩
  intro N
  exact (hm.2 N).trans (hQ K F unitary q a b c hv ha hb hc A B)
theorem finish
    (producer : ∀cutoff,∃(L : Layout)(c : Com)(P T : Polynomial Nat),
      Com.Ok L c ∧ Executes cutoff c P T) : Problem18P34Frozen20261002.P34 := by
  classical
  intro cutoff
  obtain ⟨L,c,P,T,hok,hrun⟩:=producer cutoff
  exact finish_cutoff cutoff L c P T hok hrun
end
