theorem low_rank_stratum_probability_le (n r s : ℕ) (hrn : 2*r ≤ n)
    (hs : 4*s < 3*r) :
    (Nat.card {X : Matrix (Fin n) (Fin r) K // X.rank = s} : ℝ) /
      Fintype.card (Matrix (Fin n) (Fin r) K) ≤
      4 * ((Fintype.card K : ℝ)^(n*r/8))⁻¹ := by
