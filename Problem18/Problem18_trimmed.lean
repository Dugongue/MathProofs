variable {K V W : Type*} [Field K] [Fintype K]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  [AddCommGroup W] [Module K W] [FiniteDimensional K W]
theorem irreducible_hermitian_operator_isometry
    (σ : K ≃+* K) (hσ : Function.Involutive σ) (hne : σ≠1)
    (h : K[X]) (hm : h.Monic) (hi : Irreducible h)
    (hfix : h.map σ.toRingHom=h)
    (B : V →ₛₗ[σ.toRingHom] V →ₗ[K] K)
    (C : W →ₛₗ[σ.toRingHom] W →ₗ[K] K)
    (hB : ∀ x y,B x y=σ (B y x)) (hC : ∀ x y,C x y=σ (C y x))
    (hnB : B.SeparatingLeft) (hnC : C.SeparatingLeft)
    (S : Module.End K V) (R : Module.End K W)
    (hS : Mathproof.Meta.Problem18HermitianSpectral20260930.IsSelfAdjointFor σ B S)
    (hR : Mathproof.Meta.Problem18HermitianSpectral20260930.IsSelfAdjointFor σ C R)
    (hcS : S.charpoly=h) (hcR : R.charpoly=h) :
    ∃ T : V ≃ₗ[K] W,(∀ x,T (S x)=R (T x)) ∧ ∀ x y,C (T x) (T y)=B x y := by
  classical
  letI : Fact (Irreducible h) := ⟨hi⟩
  letI : FiniteDimensional K (AdjoinRoot h) := (AdjoinRoot.powerBasis hi.ne_zero).finite
  letI : Finite (AdjoinRoot h) := Finite.of_injective (Module.finBasis K (AdjoinRoot h)).equivFun
    (Module.finBasis K (AdjoinRoot h)).equivFun.injective
  letI : Fintype (AdjoinRoot h) := Fintype.ofFinite _
  have hp : Associated (h.map σ.toRingHom) h := by rw [hfix]
  let φ := AdjoinRoot.mapRingEquiv σ h h hp
  have hφ : Function.Involutive φ := adjoinRoot_conjugation_involutive σ hσ h hp
  have hφne : φ≠1 := adjoinRoot_conjugation_ne_one σ hne h hp
  have hbase (a : K) : φ (algebraMap K (AdjoinRoot h) a)=algebraMap K (AdjoinRoot h) (σ a) :=
    AdjoinRoot.map_of σ.toRingHom h h hp.symm.dvd a
  have hroot : φ (AdjoinRoot.root h)=AdjoinRoot.root h :=
    AdjoinRoot.map_root σ.toRingHom h h hp.symm.dvd
  obtain ⟨E,hE⟩ := irreducible_charpoly_coordinates S h hm hi hcS
  obtain ⟨F,hF⟩ := irreducible_charpoly_coordinates R h hm hi hcR
  let b : CrossForm (E:=AdjoinRoot h) (L:=AdjoinRoot h) σ :=
    (B.comp E.toLinearMap).compl₂ E.toLinearMap
  let c : CrossForm (E:=AdjoinRoot h) (L:=AdjoinRoot h) σ :=
    (C.comp F.toLinearMap).compl₂ F.toLinearMap
  have hb : CrossBalanced σ φ b := by
    apply cross_balanced_of_generator σ φ b (AdjoinRoot.root h)
      (AdjoinRoot.adjoinRoot_eq_top (f:=h)) hbase
    intro x y
    change B (E (AdjoinRoot.root h*x)) (E y)=B (E x) (E (φ (AdjoinRoot.root h)*y))
    rw [hroot,hE,hE]
    exact hS _ _
  have hc : CrossBalanced σ φ c := by
    apply cross_balanced_of_generator σ φ c (AdjoinRoot.root h)
      (AdjoinRoot.adjoinRoot_eq_top (f:=h)) hbase
    intro x y
    change C (F (AdjoinRoot.root h*x)) (F y)=C (F x) (F (φ (AdjoinRoot.root h)*y))
    rw [hroot,hF,hF]
    exact hR _ _
  have hbn : b.SeparatingLeft := by
    intro x hx
    apply E.injective
    rw [map_zero]
    apply hnB
    intro y
    obtain ⟨y,rfl⟩ := E.surjective y
    exact hx y
  have hcn : c.SeparatingLeft := by
    intro x hx
    apply F.injective
    rw [map_zero]
    apply hnC
    intro y
    obtain ⟨y,rfl⟩ := F.surjective y
    exact hx y
  obtain ⟨D,hD,hform⟩ := fixed_primary_isometry σ φ hφ hφne hbase c b hc hb
    (fun x y => hC (F x) (F y)) (fun x y => hB (E x) (E y)) hcn hbn (AdjoinRoot.root h)
  let T := E.symm.trans (D.trans F)
  have hT (x : AdjoinRoot h) : T (E x)=F (D x) := by
    simp only [T,LinearEquiv.trans_apply,LinearEquiv.symm_apply_apply]
  refine ⟨T,?_,?_⟩
  · intro x
    obtain ⟨x,rfl⟩ := E.surjective x
    rw [← hE,hT,hT,hD,hF]
  · intro x y
    obtain ⟨x,rfl⟩ := E.surjective x
    obtain ⟨y,rfl⟩ := E.surjective y
    rw [hT,hT]
    exact hform x y
end Mathproof.Problem18HermitianIrreducibleIsometry20260930
end
