  have nak : an.a ≠ an.k := ha.ne_of (by intro h; simp [RNames.list, ANames.list, h])
  have nmb : an.m ≠ an.b := ha.ne_of (by intro h; simp [RNames.list, ANames.list, h])
  have nmk : an.m ≠ an.k := ha.ne_of (by intro h; simp [RNames.list, ANames.list, h])
  have nbk : an.b ≠ an.k := ha.ne_of (by intro h; simp [RNames.list, ANames.list, h])
  have nbW : an.b ≠ q.WS := ha.ne_of (by intro h; simp [RNames.list, ANames.list, h])
  have ab : an.b ∉ regNames r := ha.avoid _ (by simp [ANames.list])
  have hmov : ∀ y, y ∉ certMoving q an → y ≠ q.N ∧ y ≠ q.n ∧ y ≠ q.c ∧ y ≠ q.u ∧ y ≠ q.w ∧
      y ≠ q.j ∧ y ≠ q.i ∧ y ≠ q.pv ∧ y ≠ q.f ∧ y ≠ an.Nw ∧ y ≠ an.a ∧ y ≠ an.b ∧ y ≠ an.z ∧
      y ≠ an.k := by
    intro y hy
    simp only [certMoving, List.mem_cons, List.not_mem_nil, or_false, not_or] at hy
    exact hy
  have hqmov : ∀ y, y ∉ certMoving q an → y ∉ q.moving := by
    intro y hy hy'
    obtain ⟨_, _, _, h4, h5, h6, h7, h8, h9, _⟩ := hmov y hy
    simp only [RNames.moving, List.mem_cons, List.not_mem_nil, or_false] at hy'
