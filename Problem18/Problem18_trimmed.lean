local notation "V" => (Fin n → K)
abbrev CompatibleEmbedding (σ : E ≃+* E) (B : V → V → K) :=
  {ρ : E →ₐ[K] Module.End K V // ∀ a x y, B (ρ a x) y = B x (ρ (σ a) y)}
abbrev Incidence (τ : K ≃+* K) (σ : E ≃+* E) (eps : K) :=
  (ρ : E →ₐ[K] Module.End K V) ×
    {C : V →ₛₗ[(τ : K →+* K)] V →ₗ[K] K //
      (∀ a x y, C (ρ a x) y = C x (ρ (σ a) y)) ∧
      (∀ x y, C y x = eps * τ (C x y))}
instance embeddingFinite : Finite (E →ₐ[K] Module.End K V) :=
  Finite.of_injective (fun ρ : E →ₐ[K] Module.End K V => fun a x => ρ a x) (by
    intro ρ η h
    apply AlgHom.ext
    intro a
    apply LinearMap.ext
    intro x
    exact congrFun (congrFun h a) x)
instance incidenceFinite (τ : K ≃+* K) (σ : E ≃+* E) (eps : K) :
