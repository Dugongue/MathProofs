variable {K V : Type*} [Field K] [Fintype K]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
def Compatible {n s : ℕ} (H : LinearMap.BilinForm K V)
    (cd : FormClass K n × FormClass K s) : Prop :=
  ∃ e : ((Fin n→K)×(Fin s→K)) ≃ₗ[K] V,
    ∀ x y,H (e x) (e y)=(representative K cd.1).val x.1 y.1+(representative K cd.2).val x.2 y.2
private theorem representative_determinant (hodd : ringChar K ≠ 2) {n : ℕ}
    (c : FormClass K n) :
    determinantClass (representative K c).val (representative K c).property.2 (Pi.basisFun K (Fin n))=
      determinantClassMap K hodd c := by
  exact congrArg (determinantClassMap K hodd) (Quotient.out_eq' c)
theorem odd_compatible_iff (hodd : ringChar K ≠ 2) {n s : ℕ}
    (H : LinearMap.BilinForm K V) (hH : H.IsSymm) (hnH : H.Nondegenerate)
    (b : Module.Basis (Fin (n+s)) K V) (cd : FormClass K n × FormClass K s) :
    Compatible H cd ↔ determinantClassMap K hodd cd.1*determinantClassMap K hodd cd.2=
      determinantClass H hnH b := by
  let B := (representative K cd.1).val
  let C := (representative K cd.2).val
  have hnB : B.Nondegenerate := (representative K cd.1).property.2
  have hnC : C.Nondegenerate := (representative K cd.2).property.2
  let A : LinearMap.BilinForm K ((Fin n→K)×(Fin s→K)) := sumForm (RingEquiv.refl K) B C
  have hnA : A.Nondegenerate := sum_nondegenerate B C hnB hnC
  have hA : A.IsSymm := ⟨fun x y=>congrArg₂ (·+·)
    ((representative K cd.1).property.1.eq x.1 y.1)
    ((representative K cd.2).property.1.eq x.2 y.2)⟩
  let bA := ((Pi.basisFun K (Fin n)).prod (Pi.basisFun K (Fin s))).reindex finSumFinEquiv
  have hh := determinantClass_eq_iff_isometry hodd A H bA b hA hH hnA hnH
  rw [sum_determinantClass B C hnB hnC,representative_determinant hodd,
    representative_determinant hodd] at hh
  exact hh.symm
theorem odd_compatible_card_eq_two (hodd : ringChar K ≠ 2) {n s : ℕ}
    (hn : 0<n) (hs : 0<s)
    (H : LinearMap.BilinForm K V) (hH : H.IsSymm) (hnH : H.Nondegenerate)
    (b : Module.Basis (Fin (n+s)) K V) :
    Nat.card {cd : FormClass K n × FormClass K s // Compatible H cd}=2 := by
  let f : {cd : FormClass K n × FormClass K s // Compatible H cd} → FormClass K n := fun cd=>cd.val.1
  have hf : Function.Bijective f := by
    constructor
    · intro cd ce he
      apply Subtype.ext
      apply Prod.ext he
      apply (determinantClassMap_bijective hodd s hs).injective
      have hd := (odd_compatible_iff hodd H hH hnH b cd.val).mp cd.property
      have hc := (odd_compatible_iff hodd H hH hnH b ce.val).mp ce.property
      change cd.val.1=ce.val.1 at he
      rw [he] at hd
      exact mul_left_cancel (hd.trans hc.symm)
    · intro c
      obtain ⟨d,hd⟩ := (determinantClassMap_bijective hodd s hs).surjective
        ((determinantClassMap K hodd c)⁻¹*determinantClass H hnH b)
      refine ⟨⟨(c,d),(odd_compatible_iff hodd H hH hnH b (c,d)).mpr ?_⟩,rfl⟩
      rw [hd]
      simp only [←mul_assoc,mul_inv_cancel,mul_one,one_mul]
  rw [Nat.card_congr (Equiv.ofBijective f hf)]
  exact odd_class_card_eq_two hodd n hn
theorem charTwo_nonalternating_class_unique [CharP K 2] {n : ℕ}
    (c d : FormClass K n) (hc : ¬(representative K c).val.IsAlt)
    (hd : ¬(representative K d).val.IsAlt) : c=d := by
  apply (representative_isometric_iff K c d).mp
  exact Mathproof.Problem18CharTwoNonalternating20260930.nonalternating_isometry_of_finrank_eq
    (representative K c).val (representative K d).val
    (representative K c).property.1 (representative K d).property.1
    (representative K c).property.2 (representative K d).property.2 hc hd rfl
theorem charTwo_compatible [CharP K 2] {n s : ℕ}
    (H : LinearMap.BilinForm K V) (hH : H.IsSymm) (hnH : H.Nondegenerate) (haH : ¬H.IsAlt)
    (b : Module.Basis (Fin (n+s)) K V) (cd : FormClass K n × FormClass K s)
    (haB : ¬(representative K cd.1).val.IsAlt) : Compatible H cd := by
  letI : Finite V := Finite.of_injective b.equivFun b.equivFun.injective
  let B := (representative K cd.1).val
  let C := (representative K cd.2).val
  let A : LinearMap.BilinForm K ((Fin n→K)×(Fin s→K)) := sumForm (RingEquiv.refl K) B C
  have hnA : A.Nondegenerate := sum_nondegenerate B C
    (representative K cd.1).property.2 (representative K cd.2).property.2
  have hA : A.IsSymm := ⟨fun x y=>congrArg₂ (·+·)
    ((representative K cd.1).property.1.eq x.1 y.1)
    ((representative K cd.2).property.1.eq x.2 y.2)⟩
  have haA : ¬A.IsAlt := by
    intro hh
    apply haB
    intro x
    have hz := hh (x,0)
    change B x x+C 0 0=0 at hz
    simpa using hz
  apply Mathproof.Problem18CharTwoNonalternating20260930.nonalternating_isometry_of_finrank_eq
    A H hA hH hnA hnH haA haH
  rw [Module.finrank_prod]
  simpa using b.equivFun.finrank_eq.symm
end
