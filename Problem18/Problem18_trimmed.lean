    refine ⟨h.vn, h.vd, h.ve, h.vp, h.vmod, h.vexp, h.arith, h.inv, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [swap_arr_other σ _ (by decide) (by decide)]; exact h.scr_word
    · rw [swap_arr_other σ _ (by decide) (by decide)]; exact h.scr_fit
    · rw [swap_arr_mode]; exact h.nat_len
    · intro i hi; rw [swap_arr_mode]; exact h.nat_mod i hi
    · rw [swap_arr_mem]; exact h.m_len
    · rw [swap_arr_mem]; exact h.m_word
    · intro j; rw [swap_arr_mem]; exact h.m_zero j
    · rw [swap_arr_other σ _ (by decide) (by decide)]; exact h.p_len
    · rw [swap_arr_other σ _ (by decide) (by decide)]; exact h.p_word
