theorem chosen_get_read (g : ℕ→K) (N c : ℕ) (i : Fin c) :
    read ((chosenOf g N c)[i.val]'(by simpa only [chosenOf_length] using i.isLt))=
      Problem18ClaudeIMPPivot20261001.rowVec g (stStart N (c-1-i.val)) N := by
  simp [chosenOf,List.getElem_reverse,Nat.sub_sub,Nat.add_comm]
theorem chosen_get_matrix (g : ℕ→K) (c : ℕ) (i : Fin c) :
    unpack ((chosenOf g (n*n) c)[i.val]'(by simpa only [chosenOf_length] using i.isLt))=
      fun a b : Fin n=>g (stStart (n*n) (c-1-i.val)+a.val*n+b.val) := by
  ext a b
  change read ((chosenOf g (n*n) c)[i.val]'_) (finProdFinEquiv (a,b))=_
  rw [chosen_get_read]
  simp [Problem18ClaudeIMPPivot20261001.rowVec,finProdFinEquiv,
    Nat.mul_comm,Nat.add_comm,Nat.add_left_comm,Nat.add_assoc]
theorem products_get (S : Fin m→Matrix (Fin n) (Fin n) K)
    (vs : List (Vector K (n*n))) (i : ℕ) (hi : i< vs.length) (j : Fin m) :
    (products S vs)[i*m+j.val]'(by
      rw [products_length]
      have hh:=Nat.mul_le_mul_right m (Nat.succ_le_of_lt hi)
      have hj:=j.isLt
      nlinarith)=pack (S j*unpack (vs[i]'hi)) := by
  induction vs generalizing i with
  | nil => simp at hi
  | cons v vs ih =>
    cases i with
    | zero =>
      simp only [products,List.flatMap_cons,Nat.zero_mul,Nat.zero_add,List.getElem_cons_zero]
      rw [List.getElem_append_left (by simpa using j.isLt)]
      simp
    | succ i =>
      have hi' : i< vs.length:=by simpa using hi
      simp only [products,List.flatMap_cons,List.getElem_cons_succ]
      rw [List.getElem_append_right (by simp only [List.length_ofFn,Nat.succ_mul]; omega)]
      have hix:i*m+(m+j.val)-m=i*m+j.val:=by omega
      simpa only [products,List.length_ofFn,Nat.succ_mul,Nat.add_assoc,hix] using ih i hi'
end Encoding
