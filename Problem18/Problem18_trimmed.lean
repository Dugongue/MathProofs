theorem quadForm_expand (U : Matrix (Fin n) (Fin n) K) (y : Fin n → K) :
    (U *ᵥ y) ⬝ᵥ y = ∑ p ∈ (Finset.univ : Finset (Fin n × Fin n)), U p.1 p.2 * y p.2 * y p.1 := by
  rw [← Finset.univ_product_univ, Finset.sum_product]
  simp [Matrix.mulVec, dotProduct, Finset.sum_mul]
