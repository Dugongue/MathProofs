  exact mul_le_mul_of_nonneg_right hbR (by dsimp [c]; positivity)
theorem repeated_diagonal_moment_le_intersection (i₀ : Fin a)
    (Q : QuadraticForm K (Fin n → K)) (E : Submodule K (Fin a → Fin n → K))
    (ψ : AddChar K ℂ) (hψ : ψ ≠ 1) (m : ℕ) (hm : 1 ≤ m) :
    (∑ d : Fin n → K,
      (‖(∑ x : E, ψ (∑ i, completion Q d (x.val i))) / (Fintype.card E : ℂ)‖^2)^m) ≤
      (Fintype.card K : ℝ)^(Module.finrank K (LinearMap.range Q.polarBilin) +
        (a*n - Module.finrank K E)) *
      (((Fintype.card K : ℝ)^(a * Module.finrank K (LinearMap.range Q.polarBilin) -
        2 * Module.finrank K ↥(LinearMap.range
          (QuadraticMap.pi (fun _ : Fin a => Q)).polarBilin ⊓
          LinearMap.ker E.subtype.dualMap)))⁻¹)^m := by
  apply (repeated_diagonal_moment_le i₀ Q E ψ hψ m hm).trans
  apply mul_le_mul_of_nonneg_left _ (by positivity)
  apply pow_le_pow_left₀ (by positivity)
  apply inv_anti₀ (by positivity)
  apply pow_le_pow_right₀
  · exact_mod_cast Fintype.card_pos (α := K)
  · have hr := polar_restriction_rank_loss (QuadraticMap.pi (fun _ : Fin a => Q)) E
    rw [pi_polar_rank] at hr
    omega
