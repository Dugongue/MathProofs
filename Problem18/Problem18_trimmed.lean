namespace Mathproof.Problem18QuadraticExpressionCompiler20261001
open Problem18AllFormatRoot20260930 Problem18UnitaryRootField20260930
  Problem18InvolutionNorm20260930 Problem18ExplicitFixedCoordinates20261001
  Problem18RootQuadraticBasis20261001 Problem18BoundedEncoding20260930
  Meta.Problem18BoundedQuadraticCoordinates20260930
variable {K : Type} [Field K] [Fintype K] {σ : Type*} {q : Nat}
inductive StarExpr (σ K : Type*) where
  | const : K→StarExpr σ K
  | var : σ→StarExpr σ K
  | add : StarExpr σ K→StarExpr σ K→StarExpr σ K
  | mul : StarExpr σ K→StarExpr σ K→StarExpr σ K
  | conj : StarExpr σ K→StarExpr σ K
def StarExpr.eval (d : UnitaryFieldData (K:=K) q) (x : σ→K) : StarExpr σ K→K
  | .const c=>c
  | .var i=>x i
  | .add a b=>a.eval d x+b.eval d x
  | .mul a b=>a.eval d x*b.eval d x
  | .conj a=>d.automorphism (a.eval d x)
def StarExpr.degree : StarExpr σ K→Nat
  | .const _=>0
  | .var _=>1
  | .add a b=>max a.degree b.degree
  | .mul a b=>a.degree+b.degree
  | .conj a=>a.degree
def coordinateAssignment (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) :
    (σ→K)≃((Fin 2×σ)→fixedField d.automorphism) where
  toFun x j:=Fin.cases (rootCoordinates F d (x j.2)).1
    (fun _=>(rootCoordinates F d (x j.2)).2) j.1
  invFun y j:=(rootCoordinates F d).symm (y (0,j),y (1,j))
  left_inv x:=by funext j; exact (rootCoordinates F d).symm_apply_apply (x j)
  right_inv y:=by
    funext z
    rcases z with ⟨i,j⟩
    fin_cases i <;> simp <;> rfl
abbrev PairExpr (d : UnitaryFieldData (K:=K) q) (σ : Type*) :=
  PolyExpr (Fin 2×σ) (fixedField d.automorphism) ×
    PolyExpr (Fin 2×σ) (fixedField d.automorphism)
def compile (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) : StarExpr σ K→PairExpr d σ
  | .const c=>let z:=rootCoordinates F d c; (.const z.1,.const z.2)
  | .var i=>(.var (0,i),.var (1,i))
  | .add a b=>let u:=compile F d a; let v:=compile F d b; (.add u.1 v.1,.add u.2 v.2)
  | .mul a b=>
      let u:=compile F d a; let v:=compile F d b
      (.add (.mul u.1 v.1) (.mul (.mul (.const (rootNegNorm F d)) u.2) v.2),
       .add (.add (.mul u.1 v.2) (.mul u.2 v.1))
         (.mul (.mul (.const (rootTrace F d)) u.2) v.2))
  | .conj a=>let u:=compile F d a
      (.add u.1 (.mul (.const (rootTrace F d)) u.2),PolyExpr.neg u.2)
def pairEval (d : UnitaryFieldData (K:=K) q)
    (x : (Fin 2×σ)→fixedField d.automorphism) (p : PairExpr d σ) :
    fixedField d.automorphism × fixedField d.automorphism := (p.1.eval x,p.2.eval x)
theorem rootCoordinates_add (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) (x y : K) :
    rootCoordinates F d (x+y)=
      ((rootCoordinates F d x).1+(rootCoordinates F d y).1,
        (rootCoordinates F d x).2+(rootCoordinates F d y).2) := by
  apply Prod.ext <;> apply Subtype.ext
  all_goals simp only [rootCoordinates,coordinateEquiv,Equiv.coe_fn_mk,coordinates,
    coefficientA,coefficientB,map_add,add_div,sub_div,Subfield.coe_add,Prod.fst,Prod.snd]
  all_goals ring
theorem rootCoordinates_zero (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) :
    rootCoordinates F d 0=(0,0) := by
  apply Prod.ext <;> apply Subtype.ext
  all_goals simp [rootCoordinates,coordinateEquiv,coordinates,coefficientA,coefficientB]
theorem compile_correct (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q)
    (p : StarExpr σ K) (x : σ→K) :
    pairEval d (coordinateAssignment F d x) (compile F d p)=rootCoordinates F d (p.eval d x) := by
  induction p with
  | const c=>rfl
  | var i=>rfl
  | add a b iha ihb=>
    rw [StarExpr.eval,rootCoordinates_add,←iha,←ihb]
    rfl
  | mul a b iha ihb=>
    rw [StarExpr.eval,coordinates_mul,←iha,←ihb]
    rfl
  | conj a iha=>
    rw [StarExpr.eval,coordinates_conjugate,←iha]
    simp [compile,pairEval,coordinateConj,PolyExpr.neg,PolyExpr.eval]
theorem compile_degree (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q)
    (p : StarExpr σ K) :
    (compile F d p).1.degree≤p.degree ∧ (compile F d p).2.degree≤p.degree := by
  induction p with
  | const c=>exact ⟨Nat.le_refl _,Nat.le_refl _⟩
  | var i=>exact ⟨Nat.le_refl _,Nat.le_refl _⟩
  | add a b iha ihb=>
    simp only [compile,StarExpr.degree,PolyExpr.degree]
    omega
  | mul a b iha ihb=>
    simp only [compile,StarExpr.degree,PolyExpr.degree,zero_add]
    omega
  | conj a iha=>
    simp only [compile,StarExpr.degree,PolyExpr.degree,degree_neg,zero_add]
    omega
end Mathproof.Problem18QuadraticExpressionCompiler20261001
end
