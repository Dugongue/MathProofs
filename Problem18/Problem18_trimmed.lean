    addBits_length_of_eq false hlen
  rw [hadd] at h
  have htime : 3 * left.length + 6 =
      rightBits.length + 2 + (left.length + 1 + 1 + (left.length + 2)) := by
    omega
  rw [htime]
  simpa [addPipelineProgram, moveToOperand] using h
end Lax51Proofs.RamToTM
