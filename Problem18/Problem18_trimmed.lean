variable {K : Type} [Field K] [Fintype K] [BEq K] [LawfulBEq K] [DecidableEq K]
variable {b c : ℕ}
def leftInverseMatrix (C : Matrix (Fin c) (Fin b) K) : Matrix (Fin b) (Fin c) K :=
  matrix b (inverse b (arrayOf (C.transpose*C)))*C.transpose
theorem leftInverseMatrix_correct (C : Matrix (Fin c) (Fin b) K) :
    (leftInverseMatrix C).toLin'=gramLeftInverse C := by
  rw [leftInverseMatrix,matrix_inverse _ _ (arrayOf_size _),matrix_arrayOf]
  rfl
def markerCheck (C D : Matrix (Fin c) (Fin b) K) (e : Fin c→K) : Bool :=
  let x := leftInverseMatrix C*ᵥe
  let y := leftInverseMatrix D*ᵥe
  decide (((e-C*ᵥx=0) ↔ (e-D*ᵥy=0)) ∧ (e-C*ᵥx=0 → x=y))
theorem markerCheck_correct (C D : Matrix (Fin c) (Fin b) K)
    (hC : (C.transpose*C).det≠0) (hD : (D.transpose*D).det≠0) (e : Fin c→K) :
    markerCheck C D e=true ↔
      LinearMap.ker (Problem18MarkedRecovery20260929.augment C.toLin' e)=
      LinearMap.ker (Problem18MarkedRecovery20260929.augment D.toLin' e) := by
  rw [markerCheck,decide_eq_true_eq,matrix_augment_kernel_eq_iff C D hC hD e]
  have h (M : Matrix (Fin c) (Fin b) K) : leftInverseMatrix M*ᵥe=gramLeftInverse M e := by
    exact congrArg (fun L : (Fin c→K)→ₗ[K](Fin b→K) => L e) (leftInverseMatrix_correct M)
  rw [h,h]
def explicitCandidate (A B : Matrix (Fin c) (Fin b) K) : Matrix (Fin b) (Fin b) K :=
