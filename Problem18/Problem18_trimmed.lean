theorem routedSourceWords_bounds {K : Type} [Field K] [Fintype K]
    (F : FieldPresentation K) (cutoff : Nat) (u : Bool) (q : Nat)
    {a b c : Nat} (A : RectTensor a b c K) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) :
    let n := Lax51.BinaryWordEncoding.bitSize (routedSourceWords F cutoff u q A)
    F.e ≤ n ∧ a ≤ n ∧ b ≤ n ∧ c ≤ n ∧ a*b*c*F.e ≤ n ∧
      F.p.size + 1 ≤ n ∧ q.size + 1 ≤ n ∧
      (routedSourceWords F cutoff u q A).length ≤ n := by
  intro n
  have hlen := Lax51Proofs.Encoding.length_le_bitSize (routedSourceWords F cutoff u q A)
  rw [routedSourceWords_length] at hlen
  have he := F.degree_pos
  have hae : a ≤ a*b*c*F.e := by
    calc a ≤ a*b := Nat.le_mul_of_pos_right _ hb
      _ ≤ a*b*c := Nat.le_mul_of_pos_right _ hc
      _ ≤ a*b*c*F.e := Nat.le_mul_of_pos_right _ he
  have hbe : b ≤ a*b*c*F.e := by
    calc b ≤ a*b := Nat.le_mul_of_pos_left _ ha
      _ ≤ a*b*c := Nat.le_mul_of_pos_right _ hc
      _ ≤ a*b*c*F.e := Nat.le_mul_of_pos_right _ he
  have hce : c ≤ a*b*c*F.e := by
    calc c ≤ a*b*c := Nat.le_mul_of_pos_left _ (Nat.mul_pos ha hb)
      _ ≤ a*b*c*F.e := Nat.le_mul_of_pos_right _ he
  have hp := Lax51Proofs.Encoding.bits_length_add_one_le_bitSize_of_mem
    (show F.p ∈ routedSourceWords F cutoff u q A by simp [routedSourceWords])
  have hq := Lax51Proofs.Encoding.bits_length_add_one_le_bitSize_of_mem
    (show q ∈ routedSourceWords F cutoff u q A by simp [routedSourceWords])
  rw [Nat.size_eq_bits_len] at hp hq
  have hlen' := Lax51Proofs.Encoding.length_le_bitSize (routedSourceWords F cutoff u q A)
  exact ⟨by omega, by omega, by omega, by omega, by omega, hp, hq, hlen'⟩
