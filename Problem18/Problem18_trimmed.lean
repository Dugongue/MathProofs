theorem involution_pair_glue {ι : Type*} [Fintype ι]
    (τ : ι → ι) (hτ : Function.Involutive τ) (A : ι → Type*)
    (P : ∀ i,A i → A (τ i) → Prop)
    (hlocal : ∀ i,∃ f : ∀ j,A j,
      P i (f i) (f (τ i)) ∧ P (τ i) (f (τ i)) (f (τ (τ i)))) :
    ∃ f : ∀ i,A i,∀ i,P i (f i) (f (τ i)) := by
  classical
  letI : LinearOrder ι := LinearOrder.lift' (Fintype.equivFin ι) (Fintype.equivFin ι).injective
  let r (i : ι) := min i (τ i)
  have hrτ (i : ι) : r (τ i)=r i := by
    dsimp only [r]
    rw [hτ,min_comm]
  have hr (i : ι) : i=r i ∨ i=τ (r i) := by
    by_cases hi : i≤τ i
    · left
      exact (min_eq_left hi).symm
    · right
      dsimp only [r]
      rw [min_eq_right (le_of_not_ge hi),hτ]
  choose f hf using hlocal
  refine ⟨fun i => f (r i) i,?_⟩
  intro i
  change P i (f (r i) i) (f (r (τ i)) (τ i))
  rw [hrτ]
  have hp (k j : ι) (hj : j=k ∨ j=τ k) : P j (f k j) (f k (τ j)) := by
    rcases hj with hj | hj
    · subst j
      exact (hf k).1
    · subst j
      exact (hf k).2
  exact hp (r i) i (hr i)
