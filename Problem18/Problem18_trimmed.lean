  obtain ⟨M,hM⟩:=uniform_root_machine (fun z:J=>z.val.1) (fun z:J=>z.val.2) p W T hj
  refine ⟨{toTM2ComputableAux:=M.toTM2ComputableAux,time:=M.time,outputsFun:=?_},hM⟩
  intro i
