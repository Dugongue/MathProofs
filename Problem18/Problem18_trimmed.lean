theorem simultaneous_coordinates_with_actions {ι : Type*} [Fintype ι] [DecidableEq ι]
    (S : Module.End K V) (g : ι→K[X])
    (hm : ∀ i,(g i).Monic) (hi : ∀ i,Irreducible (g i))
    (hf : S.charpoly=∏ i,g i) (hs : Squarefree S.charpoly) :
    ∃ (e : ∀ i,AdjoinRoot (g i) ≃ₗ[K] Primary S g i)
      (E : (∀ i,AdjoinRoot (g i)) ≃ₗ[K] V),
      (∀ i x,e i (AdjoinRoot.root (g i)*x)=
        (S.restrict (primary_kernel_invariant S (g i))) (e i x)) ∧
      (∀ x,E x=∑ i,(e i (x i):V)) ∧
      ∀ x,E (fun i => AdjoinRoot.root (g i)*x i)=S (E x) := by
  have hh (i : ι) := squarefree_primary_coordinates S (g i) (hm i) (hi i)
    (by rw [hf]; exact Finset.dvd_prod_of_mem g (Finset.mem_univ i)) hs
