def resetBody : Com :=
  .seq (.store canonical.mem (.add (.var resetBase) (.var resetIndex)) (.lit 0))
    (.assign resetIndex (.add (.var resetIndex) (.lit 1)))
def oneSlotReset (addr : Expr) : Com :=
  .seq (.assign resetBase addr) <|
  .seq (.assign resetIndex (.lit 0)) <|
  .seq (.while (.lt (.var resetIndex) (.var canonical.e)) resetBody) <|
    .store canonical.mem (.var resetBase) (.lit 1)
def gapClear : Com := .store canonical.mem (.var canonical.e) (.lit 0)
def zeroState (σ : Env) (j : Nat) : Env := pointState σ resetNames (fun _ => 0) j
theorem resetBody_run {B e j : Nat} (σ : Env)
    (hd : σ.vars resetBase + e ≤ (σ.arrs canonical.mem).length)
    (hlen : (σ.arrs canonical.mem).length < B) (hj : j < e) :
    Run B resetBody (zeroState σ j) (zeroState σ (j+1)) 9 := by
  let ξ := zeroState σ j
  have hi : ξ.vars resetIndex = j := by
    simp [ξ,zeroState,pointState,resetNames]
  have ho : ξ.vars resetBase = σ.vars resetBase := by
    simp [ξ,zeroState,pointState,resetNames,resetBase,resetIndex]
  have hdi : σ.vars resetBase + j < (σ.arrs canonical.mem).length := by omega
  have hdb : σ.vars resetBase + j < B := hdi.trans hlen
  have hde : (Expr.add (.var resetBase) (.var resetIndex)).evalB B ξ =
      some (σ.vars resetBase + j) := by
    exact evalB_bin (op:=Bop.add)
      (by simpa only [ho] using
        (evalB_var (σ:=ξ) (x:=resetBase) (by rw [ho]; omega)))
      (by simpa only [hi] using
        (evalB_var (σ:=ξ) (x:=resetIndex) (by rw [hi]; omega))) hdb
  have hs := Run.store (a:=canonical.mem) hde (evalB_lit (σ:=ξ) (show 0 < B by omega)) (by
    simp [ξ,zeroState,pointState,resetNames,writeValues_length,hdi])
  have einc : (Expr.add (.var resetIndex) (.lit 1)).evalB B
      (ξ.setArr canonical.mem (σ.vars resetBase + j) 0) = some (j+1) := by
    apply evalB_bin (op:=Bop.add)
    · simpa only [vars_setArr,hi] using
        (evalB_var (σ:=ξ.setArr canonical.mem (σ.vars resetBase + j) 0)
          (x:=resetIndex) (by change ξ.vars resetIndex < B; rw [hi]; omega))
    · exact evalB_lit (by omega)
    · change j+1 < B; omega
  have hr := hs.seq (Run.assign (x:=resetIndex) einc)
  have heq : ((ξ.setArr canonical.mem (σ.vars resetBase + j) 0).setVar resetIndex (j+1)) =
      zeroState σ (j+1) := pointState_next σ resetNames (fun _ => 0) j
  rw [heq] at hr
  exact hr.mono (by simp [Expr.size])
def resetCost (addr : Expr) (e : Nat) : Nat :=
  (1 + addr.size) + (2 + (((9+4)*e+4) + 3))
theorem oneSlotReset_run {B d : Nat} (addr : Expr) (σ : Env)
    (haddr : addr.evalB B σ = some d)
    (hfit : d + σ.vars canonical.e ≤ (σ.arrs canonical.mem).length)
    (hpos : 0 < σ.vars canonical.e)
    (hlen : (σ.arrs canonical.mem).length < B) :
    ∃ τ, Run B (oneSlotReset addr) σ τ (resetCost addr (σ.vars canonical.e)) ∧
      (∀ k < σ.vars canonical.e,
        (τ.arrs canonical.mem).getD (d+k) 0 = if k = 0 then 1 else 0) ∧
      (∀ j, j < d ∨ d + σ.vars canonical.e ≤ j →
        (τ.arrs canonical.mem).getD j 0 = (σ.arrs canonical.mem).getD j 0) ∧
      (∀ x, x ≠ resetBase → x ≠ resetIndex → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ canonical.mem → τ.arrs a = σ.arrs a) ∧
      (∀ a, (τ.arrs a).length = (σ.arrs a).length) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  let e := σ.vars canonical.e
  let σ1 := σ.setVar resetBase d
  have hne1 : canonical.e ≠ resetBase := by decide
  have hne2 : canonical.e ≠ resetIndex := by decide
  have he1 : σ1.vars canonical.e = e := by simp [σ1,e,hne1]
  have hb1 : σ1.vars resetBase = d := by simp [σ1]
  have harr1 : σ1.arrs = σ.arrs := rfl
  have hfit1 : σ1.vars resetBase + e ≤ (σ1.arrs canonical.mem).length := by
    rw [hb1,harr1]; exact hfit
  have hlen1 : (σ1.arrs canonical.mem).length < B := by rw [harr1]; exact hlen
  have h1 : Run B (.assign resetBase addr) σ σ1 (1 + addr.size) := Run.assign haddr
  have heB : e < B := by
    have : e ≤ (σ.arrs canonical.mem).length := by omega
    omega
  have h2 : Run B (.assign resetIndex (.lit 0)) σ1 (zeroState σ1 0) 2 := by
    have hz : zeroState σ1 0 = σ1.setVar resetIndex 0 :=
      pointState_zero σ1 resetNames (fun _ => 0)
    rw [hz]
    exact Run.assign (evalB_lit (by omega))
  have h3 : Run B (.while (.lt (.var resetIndex) (.var canonical.e)) resetBody)
      (zeroState σ1 0) (zeroState σ1 e) ((9+4)*e+4) := by
    apply countedLoop_run resetIndex canonical.e resetBody (zeroState σ1)
    · intro i _
      simp [zeroState,pointState,resetNames]
    · intro i _
      simp [zeroState,pointState,resetNames,hne2,he1]
    · exact heB
    · intro i hi
