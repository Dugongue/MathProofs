namespace Mathproof.Problem18NonmonicPoleBound20261001
open FunctionField FunctionField.Chart
open Mathproof.Problem18MonicFunctionFieldPoleBound20260930
open scoped Polynomial RatFunc BigOperators WithZero
variable (k F : Type*) [Field k] [Field F]
variable [Algebra k F] [Algebra k[X] F] [Algebra k⟮X⟯ F]
  [IsScalarTower k k[X] F] [IsScalarTower k[X] k⟮X⟯ F]
  [_root_.FunctionField k F] [Algebra.IsSeparable k⟮X⟯ F]
  [FunctionField.IsFullConstantField k F]
theorem pole_degree_inverse (x : F) :
    deg k F (polarDivisor k F x⁻¹) = deg k F (polarDivisor k F x) := by
  classical
  by_cases hx : x = 0
  · simp [hx]
  have hu : Units.mk0 x⁻¹ (inv_ne_zero hx) = (Units.mk0 x hx)⁻¹ := by ext; rfl
  have hd : polarDivisor k F x⁻¹ = polarDivisor k F x +
      principalDivisorA k F (Additive.ofMul (Units.mk0 x hx)) := by
    unfold polarDivisor
    rw [dif_neg (inv_ne_zero hx), dif_neg hx, hu, ofMul_inv, map_neg]
    ext v
    simp only [Finsupp.sup_apply, Finsupp.neg_apply, Finsupp.zero_apply, Finsupp.add_apply]
    omega
  rw [hd, deg_add, deg_principalDivisorA_eq_zero, add_zero]
theorem polynomial_polar_bound (p : k[X]) (B : Nat) (hp : p.natDegree ≤ B) :
    polarDivisor k F (algebraMap k[X] F p) ≤ B • polarDivisor k F (XK k F) := by
  apply polar_le_of_valuation_bound k F _ _
    (nsmul_nonneg (polarDivisor_nonneg k F _) B)
  intro v
  exact polynomial_valuation_bound k F B p hp v
theorem nonmonic_relation_polar_bound {h : Nat} (c : Fin h → k[X]) (a : k[X])
    (ha : a ≠ 0) (B : Nat) (hc : ∀ i, (c i).natDegree ≤ B) (y : F)
    (hroot : algebraMap k[X] F a * y^h +
      ∑ i : Fin h, algebraMap k[X] F (c i) * y^i.val = 0) :
    polarDivisor k F y ≤ B • polarDivisor k F (XK k F) +
      polarDivisor k F (algebraMap k[X] F a)⁻¹ := by
  let b := algebraMap k[X] F a
  have hb : b ≠ 0 := by
    simpa only [b, map_zero] using (FunctionField.algebraMap_injective k F).ne ha
  have hr : y^h + ∑ i : Fin h, (b⁻¹ * algebraMap k[X] F (c i)) * y^i.val = 0 := by
    calc
      _ = b⁻¹ * (b * y^h + ∑ i : Fin h, algebraMap k[X] F (c i) * y^i.val) := by
        rw [mul_add, Finset.mul_sum]
        simp only [← mul_assoc, inv_mul_cancel₀ hb, one_mul]
      _ = 0 := by rw [show b * y^h + _ = 0 from hroot, mul_zero]
  let D := B • polarDivisor k F (XK k F) + polarDivisor k F b⁻¹
  have hD : 0 ≤ D := add_nonneg
    (nsmul_nonneg (polarDivisor_nonneg k F _) B) (polarDivisor_nonneg k F _)
  apply polar_le_of_valuation_bound k F y D hD
  intro v
  apply valuation_root_le_of_monic_coefficient_bound (placeValuation k F v)
    (fun i => b⁻¹ * algebraMap k[X] F (c i)) y (WithZero.exp (D v)) ?_ ?_ hr
  · rw [← WithZero.exp_zero]
    exact WithZero.exp_le_exp.mpr (hD v)
  · intro i
    rw [map_mul]
    calc
      _ ≤ WithZero.exp (polarDivisor k F b⁻¹ v) *
          WithZero.exp ((B : ℤ) * polarDivisor k F (XK k F) v) :=
        mul_le_mul' (valuation_le_exp_polar k F b⁻¹ v)
          (polynomial_valuation_bound k F B (c i) (hc i) v)
      _ = WithZero.exp (D v) := by
        rw [← WithZero.exp_add]
        congr 1
        simp [D, add_comm]
theorem nonmonic_relation_pole_degree_bound {h : Nat} (c : Fin h → k[X]) (a : k[X])
    (ha : a ≠ 0) (B : Nat) (hc : ∀ i, (c i).natDegree ≤ B) (haB : a.natDegree ≤ B)
    (y : F) (hroot : algebraMap k[X] F a * y^h +
      ∑ i : Fin h, algebraMap k[X] F (c i) * y^i.val = 0) :
    deg k F (polarDivisor k F y) ≤ 2 * (B : ℤ) * Module.finrank k⟮X⟯ F := by
  have hy := deg_mono k F (nonmonic_relation_polar_bound k F c a ha B hc y hroot)
  have ha' := deg_mono k F (polynomial_polar_bound k F a B haB)
  rw [deg_add, deg_nsmul, deg_polarX_eq_finrank, pole_degree_inverse] at hy
  rw [deg_nsmul, deg_polarX_eq_finrank] at ha'
  linarith
theorem nonmonic_power_basis_genus_bound (pb : PowerBasis k⟮X⟯ F)
    {h : Nat} (c : Fin h → k[X]) (a : k[X]) (ha : a ≠ 0) (B : Nat)
    (hc : ∀ i, (c i).natDegree ≤ B) (haB : a.natDegree ≤ B)
    (hroot : algebraMap k[X] F a * pb.gen^h +
      ∑ i : Fin h, algebraMap k[X] F (c i) * pb.gen^i.val = 0) :
    (genus k F : ℤ) ≤ 2 * (B : ℤ) * (pb.dim : ℤ)^3 + 1 - pb.dim := by
  have hp := nonmonic_relation_pole_degree_bound k F c a ha B hc haB pb.gen hroot
  rw [pb.finrank] at hp
  have hg := Problem18FunctionFieldGenusBound20260930.genus_le_power_basis_pole_degree k F pb
  have hm := mul_le_mul_of_nonneg_left hp (sq_nonneg (pb.dim : ℤ))
  nlinarith
theorem affine_point_of_nonmonic_relations {n : Nat} (y : Fin n → F)
    (h : Fin n → Nat) (c : (i : Fin n) → Fin (h i) → k[X]) (a : Fin n → k[X])
    (ha : ∀ i, a i ≠ 0) (B : Nat) (hc : ∀ i j, (c i j).natDegree ≤ B)
    (haB : ∀ i, (a i).natDegree ≤ B)
    (hy : ∀ i, algebraMap k[X] F (a i) * y i ^ h i +
      ∑ j : Fin (h i), algebraMap k[X] F (c i j) * y i ^ j.val = 0)
    (S : Set (MvPolynomial (Fin n) k)) (hS : ∀ f ∈ S, MvPolynomial.aeval y f = 0)
    (hcount : 2 * (n : ℤ) * B * Module.finrank k⟮X⟯ F <
      (Nat.card {P : Place k F // P.degree = 1} : ℤ)) :
    ∃ x : Fin n → k, ∀ f ∈ S, MvPolynomial.eval x f = 0 := by
  classical
  let D := ∑ i : Fin n, polarDivisor k F (y i)
  have hd : deg k F D ≤ 2 * (n : ℤ) * B * Module.finrank k⟮X⟯ F := by
    have hsum : ∀ s : Finset (Fin n),
        deg k F (∑ i ∈ s, polarDivisor k F (y i)) =
          ∑ i ∈ s, deg k F (polarDivisor k F (y i)) := by
      intro s
      induction s using Finset.induction_on with
      | empty => simp [deg_zero]
      | @insert i s hi ih => simp only [Finset.sum_insert hi, deg_add, ih]
    calc
      deg k F D = ∑ i : Fin n, deg k F (polarDivisor k F (y i)) := hsum _
      _ ≤ ∑ _i : Fin n, 2 * (B : ℤ) * Module.finrank k⟮X⟯ F :=
        Finset.sum_le_sum fun i _ =>
          nonmonic_relation_pole_degree_bound k F (c i) (a i) (ha i) B (hc i) (haB i) (y i) (hy i)
      _ = _ := by simp; ring
  apply Problem18AffinePoleAvoidance20261001.affine_point_of_pole_count k F y D
    (Finset.sum_nonneg fun i _ => polarDivisor_nonneg k F (y i)) ?_ S hS (hd.trans_lt hcount)
  intro i
  exact Finset.single_le_sum (fun j _ => polarDivisor_nonneg k F (y j)) (Finset.mem_univ i)
end Mathproof.Problem18NonmonicPoleBound20261001
end
end
