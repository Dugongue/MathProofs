namespace Mathproof.Problem18EncodedSourceCheck20261001
open Problem18AllFormatRoot20260930 Problem18TensorSorting20261001
  Problem18RootParser20261001 Problem18TypedSourceCheck20261001
open Problem18OrthogonalAssembly (RectTensor)
def branch (B a b c : Nat) : Nat :=
  let s := shape (sortOrder a b c) a b c
  if s.2.1<B then 1 else if s.1=1 then 2 else 3
def dispatch (B : Nat) (bits : List Bool) : Option (ParsedInput × Order × Nat) :=
  (parseBits bits).bind fun d=>
    if d.tag=0 then some (d,sortOrder d.a d.b d.c,branch B d.a d.b d.c) else none
theorem branch_small (B a b c : Nat) : branch B a b c=1 ↔ median a b c<B := by
  simp only [branch,sorted_middle_median]
  split_ifs <;> simp_all
theorem branch_range (B a b c : Nat) : 1≤branch B a b c ∧ branch B a b c≤3 := by
  unfold branch
  dsimp only
  split_ifs <;> omega
theorem dispatch_allocation (B : Nat) (bits : List Bool) (d : ParsedInput)
    (o : Order) (r : Nat) (h : dispatch B bits=some (d,o,r)) :
    d.Valid ∧ d.tag=0 ∧ o=sortOrder d.a d.b d.c ∧ r=branch B d.a d.b d.c ∧
      d.e≤bits.length ∧ d.a*d.b*d.c*d.e≤bits.length := by
  unfold dispatch at h
  cases hp : parseBits bits with
  | none=>simp [hp] at h
  | some d'=>
    simp only [hp,Option.bind_some] at h
    split_ifs at h with ht
    have he := Option.some.inj h
    simp only [Prod.mk.injEq] at he
    obtain ⟨h1,h2,h3⟩ := he
    rw [←h1,←h2,←h3]
    have ha := Problem18RootParserSemantics20261001.accepted_allocation bits d' hp
    have hv : d'.Valid := by
      rw [←Problem18RootParserSemantics20261001.decoded_parse] at hp
      exact parseNumbers_valid _ _ hp
    exact ⟨hv,ht,rfl,rfl,ha⟩
end Mathproof.Problem18EncodedSourceCheck20261001
