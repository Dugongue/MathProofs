    PolyExpr.sumFin a fun w => PolyExpr.sumFin b fun z =>
      .mul (.mul (tensorT ij (u,v)) (.var (.inl (.inl ((u,v),(w,z))))))
        (tensorT kl (w,z))) (.var (.inl (.inr (ij,kl))))
