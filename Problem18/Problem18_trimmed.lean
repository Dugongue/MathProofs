attribute [local instance] Mathproof.Problem18InvariantIntersectionAverage20260930.linearMapFintype
variable {F K : Type*} [Field F] [Fintype F] [Field K] [Fintype K]
  [Algebra F K] [StarRing K]
noncomputable def constraintSpace {n d : ℕ} (g : (Fin d → K) →ₗ[K] (Fin n → K)) :
    Submodule K (Fin n → K) := LinearMap.ker (LinearMap.toMatrix' g)ᴴ.mulVecLin
theorem constrained_moment_le {n d : ℕ}
    (hcard : Nat.card K=Nat.card F^2) (hstar : ∀x : K,star x=x^Nat.card F)
    (ψ : AddChar F ℂ) (hψ : ψ ≠ 1) (A : Matrix (Fin n) (Fin n) K) (hA : A.IsHermitian)
    (g : (Fin d → K) →ₗ[K] (Fin n → K)) (s : ℕ) :
    (‖(∑x : constraintSpace g,ψ (hermitianQuadratic hstar A hA.eq x.val)) /
      (Fintype.card (constraintSpace g) : ℂ)‖^2)^s  ≤
      (((Fintype.card K : ℝ)^(A.rank-2*Module.finrank K
        ↥(LinearMap.range g ⊓ LinearMap.range A.mulVecLin)))⁻¹)^s := by
  let E := constraintSpace g
  let m := Module.finrank K E
  let e : E ≃ₗ[K] (Fin m → K) := (Module.finBasis K E).equivFun
  let X := LinearMap.toMatrix' (E.subtype.comp e.symm.toLinearMap)
  have hXlin : X.mulVecLin=E.subtype.comp e.symm.toLinearMap :=
    Matrix.toLin'_toMatrix' _
  have hX : LinearMap.range X.mulVecLin=LinearMap.ker (LinearMap.toMatrix' g)ᴴ.mulVecLin := by
    rw [hXlin,LinearMap.range_comp_of_range_eq_top _ (LinearEquiv.range _)]
    exact Submodule.range_subtype E
  have hg : (LinearMap.toMatrix' g).mulVecLin=g := Matrix.toLin'_toMatrix' g
  have heval (x : Fin m → K) : X*ᵥx=(e.symm x).val :=
    LinearMap.congr_fun hXlin x
  have hcardE : Fintype.card E=Fintype.card (Fin m → K) := Fintype.card_congr e.toEquiv
  have hs : (∑x : E,ψ (hermitianQuadratic hstar A hA.eq x.val)) =
      ∑x : Fin m → K,ψ (hermitianQuadratic hstar A hA.eq (X*ᵥx)) := by
    rw [←Equiv.sum_comp e.symm.toEquiv]
    simp_rw [heval]
    rfl
  have hb1 := restricted_hermitian_fourier_bound hcard hstar ψ hψ A hA X
  rw [Mathproof.Problem18UnitaryRestrictionRank20260930.kernel_parameterization_unitary_annihilator
    (LinearMap.toMatrix' g)ᴴ X hX,Matrix.conjTranspose_conjTranspose,hg,inf_comm] at hb1
  rw [hs,hcardE]
  exact pow_le_pow_left₀ (by positivity) hb1 s
attribute [local irreducible] Finset.univ
theorem averaged_moment_le {n : ℕ}
    (hcard : Nat.card K=Nat.card F^2) (hstar : ∀x : K,star x=x^Nat.card F)
    (ψ : AddChar F ℂ) (hψ : ψ ≠ 1) (A : Matrix (Fin n) (Fin n) K) (hA : A.IsHermitian)
    (d : ℕ) (hd : d ≤ n) (s : ℕ) :
    (∑g : InjectiveSample K (Fin n → K) d,
      (‖(∑x : constraintSpace g.val,ψ (hermitianQuadratic hstar A hA.eq x.val)) /
        (Fintype.card (constraintSpace g.val) : ℂ)‖^2)^s) /
      Nat.card (InjectiveSample K (Fin n → K) d)  ≤
    ∑u : Fin (d+1),
      (16*(Fintype.card K : ℝ)^(u.val*(d-u.val)) *
        ((Fintype.card K : ℝ)^(u.val*(n-A.rank)))⁻¹) *
      (((Fintype.card K : ℝ)^(A.rank-2*u.val))⁻¹)^s := by
  let f : ℕ → ℝ := fun u => (((Fintype.card K : ℝ)^(A.rank-2*u))⁻¹)^s
  have hb := invariant_intersection_weight_average_le (K := K) (V := Fin n → K) (LinearMap.range A.mulVecLin) d
    (by simpa using hd) f (fun _ => by dsimp [f]; positivity)
  simp only [Module.finrank_fintype_fun_eq_card,Fintype.card_fin] at hb
  dsimp only [f] at hb
  change _ ≤ ∑u : Fin (d+1),
    (16*(Fintype.card K : ℝ)^(u.val*(d-u.val)) *
      ((Fintype.card K : ℝ)^(u.val*(n-A.rank)))⁻¹) *
      (((Fintype.card K : ℝ)^(A.rank-2*u.val))⁻¹)^s at hb
  have hb' :
      (∑g : InjectiveSample K (Fin n → K) d,
        (((Fintype.card K : ℝ)^(A.rank-2*Module.finrank K
          ↥(LinearMap.range g.val ⊓ LinearMap.range A.mulVecLin)))⁻¹)^s) /
        Nat.card (InjectiveSample K (Fin n → K) d) ≤
      ∑u : Fin (d+1),
        (16*(Fintype.card K : ℝ)^(u.val*(d-u.val)) *
          ((Fintype.card K : ℝ)^(u.val*(n-A.rank)))⁻¹) *
          (((Fintype.card K : ℝ)^(A.rank-2*u.val))⁻¹)^s := by
    convert! hb using 1 <;> congr! (postTransparency := .reducible)
  apply le_trans ?_ hb'
  apply div_le_div_of_nonneg_right _ (by positivity)
  exact Finset.sum_le_sum (fun g _ => constrained_moment_le hcard hstar ψ hψ A hA g.val s)
end Mathproof.Problem18AveragedHermitianConstraint20260930
