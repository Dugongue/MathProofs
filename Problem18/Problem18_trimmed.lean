      apply quotient_constants_surjective k A E L q.asIdeal
      change finrank k (A ⧸ q.asIdeal.under A) ∣ finrank k E
      rw [← q.asIdeal.over_def (IsDiscreteValuationRing.maximalIdeal A).asIdeal]
      exact hd
