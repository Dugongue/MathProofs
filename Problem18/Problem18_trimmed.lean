attribute [-instance] FunLike.toDecidableEq CommSemiRingCat.FilteredColimits.colimitCommSemiring AddMonoidAlgebra.instHopfAlgebraStruct AddMonoidAlgebra.instBialgebra Bialgebra.toAlgebra
namespace Mathproof.Problem18MacaulayAlgorithm20260930
open scoped BigOperators
open MvPolynomial
open Mathproof.Problem18DenseMonomialEnumeration20260930
open Mathproof.Meta.Problem18BoundedControlledDicksonEnumeration20260930
open Problem18ArrayElimination20260929 Problem18Elimination20260929
variable {N : Nat} {K : Type*} [Field K]
abbrev DenseInput (N d : Nat) (K : Type*) := Vector K (boundedExponents N d).length
def inputCoefficient (d : Nat) (v : DenseInput N d K) (a : FinExponent N) : K :=
  let i := (boundedExponents N d).idxOf a
  if h : i < (boundedExponents N d).length then v[i] else 0
def exponentWeight (a : FinExponent N) : Nat := ∑ i : Fin N, a i
def subtractExponent (a b : FinExponent N) : FinExponent N :=
  functionToExponent (fun i => a i-b i)
@[simp] theorem exponentWeight_eq_degree (a : FinExponent N) :
    exponentWeight a = a.degree := (Finsupp.degree_eq_sum a).symm
@[simp] theorem subtractExponent_eq (a b : FinExponent N) :
    subtractExponent a b = a-b := by ext i; rfl
def multiplierExponents (N E : Nat) : List (FinExponent N) :=
  (boundedExponents N E).filter (fun a => decide (exponentWeight a ≤ E))
def shiftedRow (d B : Nat) (v : DenseInput N d K) (a : FinExponent N) :
    Vector K (boundedExponents N B).length :=
  Vector.ofFn fun i =>
    let b := (boundedExponents N B)[i.val]
    if a ≤ b then inputCoefficient d v (subtractExponent b a) else 0
def macaulayRows (d E : Nat) (vs : List (DenseInput N d K)) :
    List (Vector K (boundedExponents N (d+E)).length) :=
  vs.flatMap fun v => (multiplierExponents N E).map (shiftedRow d (d+E) v)
def constantRow (N B : Nat) : Vector K (boundedExponents N B).length :=
  Vector.ofFn fun i => if (boundedExponents N B)[i.val] = 0 then 1 else 0
def unitIdealCheck [DecidableEq K] (d : Nat) (vs : List (DenseInput N d K)) : Bool × Nat :=
  let E := 2*d*2^(controlledDepth N d)
  spanCheck (macaulayRows d E vs) (constantRow N (d+E))
def ValidDenseInput (d : Nat) (v : DenseInput N d K)
    (f : MvPolynomial (Fin N) K) : Prop :=
  f.totalDegree ≤ d ∧ ∀ i : Fin (boundedExponents N d).length,
    v[i.val] = coeff ((boundedExponents N d)[i.val]) f
theorem inputCoefficient_correct (d : Nat) (v : DenseInput N d K)
    (f : MvPolynomial (Fin N) K) (hv : ValidDenseInput d v f) (a : FinExponent N) :
    inputCoefficient d v a = coeff a f := by
  dsimp only [inputCoefficient]
  split_ifs with h
  · simpa only [List.getElem_idxOf h] using hv.2 ⟨_,h⟩
  · have ha : a ∉ boundedExponents N d := by
      intro ha
      exact h (List.idxOf_lt_length_of_mem ha)
    symm
    by_contra hcoeff
    exact ha (bounded_support_mem f hv.1 (mem_support_iff.mpr hcoeff))
theorem mem_multiplierExponents_iff (E : Nat) (a : FinExponent N) :
    a ∈ multiplierExponents N E ↔ a.degree ≤ E := by
  simp only [multiplierExponents,List.mem_filter,decide_eq_true_eq,exponentWeight_eq_degree]
  constructor
  · exact And.right
  · intro ha
    exact ⟨(mem_boundedExponents_iff a).mpr (fun i => (Finsupp.le_degree i a).trans ha),ha⟩
theorem shiftedRow_correct (d B : Nat) (v : DenseInput N d K)
    (f : MvPolynomial (Fin N) K) (hv : ValidDenseInput d v f) (a : FinExponent N) :
    read (shiftedRow d B v a) =
      fun i => coeff ((boundedExponents N B)[i.val]) (monomial a (1 : K)*f) := by
  classical
  rw [shiftedRow,read_ofFn]
  funext i
  simp only [coeff_monomial_mul',one_mul,subtractExponent_eq,inputCoefficient_correct d v f hv]
theorem macaulayRows_length (d E : Nat) (vs : List (DenseInput N d K)) :
    (macaulayRows d E vs).length = vs.length*(multiplierExponents N E).length := by
  simp [macaulayRows,List.length_flatMap]
theorem multiplierExponents_length_le (E : Nat) :
    (multiplierExponents N E).length ≤ (E+1)^N := by
  exact (List.length_filter_le _ _).trans_eq (boundedExponents_length N E)
theorem unitIdealCheck_cost [DecidableEq K] (d : Nat) (vs : List (DenseInput N d K)) :
    (unitIdealCheck d vs).2 ≤
      let E := 2*d*2^(controlledDepth N d)
      let r := vs.length*(multiplierExponents N E).length
      let c := (d+E+1)^N
      r*c+(2*c+1)*r^2+c := by
  unfold unitIdealCheck
  have h := spanCheck_cost_le (macaulayRows d (2*d*2^(controlledDepth N d)) vs)
    (constantRow N (d+2*d*2^(controlledDepth N d)) : Vector K _)
  simpa only [macaulayRows_length,boundedExponents_length] using h
end Mathproof.Problem18MacaulayAlgorithm20260930
end
