namespace Mathproof.Meta.Problem18BoundedGeneratorBasis20260930
variable {F K : Type*} [Field F] [Field K] [Algebra F K]
theorem one_theta_linearIndependent (theta : K)
    (hout : theta ∉ Set.range (algebraMap F K)) :
    LinearIndependent F ![(1 : K), theta] := by
  rw [linearIndependent_fin2]
  constructor
  · intro hzero
    change theta = 0 at hzero
    apply hout
    refine ⟨0, ?_⟩
    simp [hzero]
  · intro a ha
    apply hout
    by_cases hzero : a = 0
    · subst a
      simp at ha
    · refine ⟨a⁻¹, ?_⟩
      have hmap : algebraMap F K a ≠ 0 := (map_ne_zero (algebraMap F K)).mpr hzero
      have hinv :
          theta = (algebraMap F K a)⁻¹ * (algebraMap F K a * theta) := by
        rw [← mul_assoc, inv_mul_cancel₀ hmap, one_mul]
      rw [hinv, show algebraMap F K a * theta = 1 by
        simpa [Algebra.smul_def] using ha]
      simp
noncomputable def generatorBasis [FiniteDimensional F K] (theta : K)
    (hout : theta ∉ Set.range (algebraMap F K)) (hfinrank : Module.finrank F K = 2) :
    Module.Basis (Fin 2) F K :=
  basisOfLinearIndependentOfCardEqFinrank' ![(1 : K), theta]
    (one_theta_linearIndependent theta hout) (by simpa using hfinrank.symm)
@[simp] theorem generatorBasis_zero [FiniteDimensional F K] (theta : K)
    (hout : theta ∉ Set.range (algebraMap F K)) (hfinrank : Module.finrank F K = 2) :
    generatorBasis theta hout hfinrank 0 = 1 := by
  simp [generatorBasis, coe_basisOfLinearIndependentOfCardEqFinrank']
@[simp] theorem generatorBasis_one [FiniteDimensional F K] (theta : K)
    (hout : theta ∉ Set.range (algebraMap F K)) (hfinrank : Module.finrank F K = 2) :
    generatorBasis theta hout hfinrank 1 = theta := by
  simp [generatorBasis, coe_basisOfLinearIndependentOfCardEqFinrank']
end Mathproof.Meta.Problem18BoundedGeneratorBasis20260930
end
