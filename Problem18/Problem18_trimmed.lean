  classical
  refine
    { toFun := fun f => ⟨boundedDivisor k K N f.val,?_,?_⟩
      invFun := fun D => ⟨fun P => (D.val P.val).toNat,?_⟩
      left_inv := ?_
      right_inv := ?_ }
  · intro P
    rw [boundedDivisor_apply]
    split_ifs <;> positivity
  · rw [boundedDivisor_degree]
    exact_mod_cast f.property
  · have h := congrArg (deg k K) (boundedDivisor_reconstruct k K N D.val D.property.1
      (by rw [D.property.2]; exact_mod_cast hn))
    rw [boundedDivisor_degree,D.property.2] at h
