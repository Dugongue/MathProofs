variable (θ : L ≃+* L) (φ : F ≃+* F) (τ : k ≃+* k)
  (hθ : ∀ c, θ (algebraMap k L c)=algebraMap k L (τ c))
  (hφ : ∀ c, φ (algebraMap k F c)=algebraMap k F (τ c))
  (hcompat : ∀ x, θ (algebraMap F L x)=algebraMap F L (φ x))
  (T : Finset (Place k F)) (hT : ∀ P∈T, pullbackPlace k F φ τ hφ P=P)
def fixedCoverFiberEquiv (σ : L ≃ₐ[F] L) :
    {Q : Place k L // restrictPlace k F L Q∈T ∧
      pullbackPlace k L θ τ hθ (galoisPlace k F L σ Q)=Q} ≃
    Σ P : ↥T, {Q : PlaceFiber k F L P.val //
      semilinearFiberEquiv k F L θ φ τ hθ hφ hcompat P.val (hT P.val P.property) (σ • Q)=Q} where
  toFun Q := ⟨⟨restrictPlace k F L Q.val,Q.property.1⟩,⟨Q.val,rfl⟩,
    Subtype.ext Q.property.2⟩
  invFun Q := ⟨Q.2.val.val,by rw [Q.2.val.property]; exact Q.1.property,
    congrArg Subtype.val Q.2.property⟩
  left_inv Q := by cases Q; rfl
  right_inv Q := by
    rcases Q with ⟨⟨P,hP⟩,⟨⟨Q,hQ⟩,hfix⟩⟩
    change restrictPlace k F L Q=P at hQ
    subst P
    rfl
include hcompat hT in
theorem finite_cover_fixed_sum :
    ∑ σ : L ≃ₐ[F] L, Nat.card {Q : Place k L // restrictPlace k F L Q∈T ∧
      pullbackPlace k L θ τ hθ (galoisPlace k F L σ Q)=Q}
      = T.card*Nat.card (L ≃ₐ[F] L) := by
  classical
  have hf (σ : L ≃ₐ[F] L) := Nat.card_congr
    (fixedCoverFiberEquiv k F L θ φ τ hθ hφ hcompat T hT σ)
  simp_rw [hf,Nat.card_sigma]
  rw [Finset.sum_comm]
  simp_rw [semilinear_fiber_fixed_sum k F L θ φ τ hθ hφ hcompat]
  simp
include hθ hcompat hT in
theorem finite_cover_invariant_sum :
    ∑ σ : L ≃ₐ[F] L, Nat.card {Q : Place k L // restrictPlace k F L Q∈T ∧
      ∀ x, Q.valuation (σ.symm (θ x))=Q.valuation x}
      = T.card*Nat.card (L ≃ₐ[F] L) := by
  classical
  have he (σ : L ≃ₐ[F] L) :
      Nat.card {Q : Place k L // restrictPlace k F L Q∈T ∧
        ∀ x, Q.valuation (σ.symm (θ x))=Q.valuation x} =
      Nat.card {Q : Place k L // restrictPlace k F L Q∈T ∧
        pullbackPlace k L θ τ hθ (galoisPlace k F L σ Q)=Q} := by
    apply Nat.card_congr
    apply Equiv.subtypeEquivRight
    intro Q
    constructor
    · rintro ⟨hQ,hfix⟩
      refine ⟨hQ,?_⟩
      have h := (semilinear_fiber_fixed_iff k F L θ φ τ hθ hφ hcompat
        (restrictPlace k F L Q) (hT _ hQ) σ ⟨Q,rfl⟩).mpr hfix
      exact congrArg Subtype.val h
    · rintro ⟨hQ,hfix⟩
      exact ⟨hQ,(semilinear_fiber_fixed_iff k F L θ φ τ hθ hφ hcompat
        (restrictPlace k F L Q) (hT _ hQ) σ ⟨Q,rfl⟩).mp (Subtype.ext hfix)⟩
  simp_rw [he]
  exact finite_cover_fixed_sum k F L θ φ τ hθ hφ hcompat T hT
end Mathproof.Problem18FiniteCoverAverage20260930
