theorem layoutFitsWords (L : Layout) (s : ℕ) :
    L.FitsWords (2^(s+1))
      (s+1+(L.temps+2+L.scalars.length+L.arrays.length+1)) := by
  let C := L.temps+2+L.scalars.length+L.arrays.length+1
  have hb : 1 ≤ 2^(s+1) := Nat.one_le_pow _ _ (by omega)
  have hc : C ≤ 2^C := (Nat.lt_two_pow_self (n := C)).le
  have hpow : 2^(s+1) ≤ 2^(s+1+C) :=
    Nat.pow_le_pow_right (by omega) (by omega)
  refine ⟨?_, hpow, ?_⟩
  · have h := Nat.pow_le_pow_right (n := 2) (by omega) (show 1 ≤ s+1 by omega)
    norm_num at h ⊢
  · calc
      L.span (2^(s+1)) ≤ C * 2^(s+1) := by
        dsimp [Layout.span, C]
        have h := Nat.mul_le_mul_left (L.temps+2+L.scalars.length) hb
        nlinarith
      _ ≤ 2^C * 2^(s+1) := Nat.mul_le_mul_right _ hc
      _ = 2^(s+1+C) := by rw [←pow_add]; congr 1; omega
theorem output_bounded {B : ℕ} {c : Com} {σ σ' : Env} {k : ℕ}
    (h : BigStepB B c σ σ' k) (hσ : ∀v ∈ σ.out, v < B) :
    ∀v ∈ σ'.out, v < B := by
  induction h with
  | skip => exact hσ
  | assign _ => exact hσ
  | store _ _ _ => exact hσ
  | seq _ _ ih ih' => exact ih' (ih hσ)
  | ite_true _ _ ih => exact ih hσ
  | ite_false _ _ ih => exact ih hσ
  | while_true _ _ _ ih ih' => exact ih' (ih hσ)
  | while_false _ => exact hσ
  | read _ => exact hσ
  | write he =>
      intro v hv
      rcases List.mem_append.mp hv with hv | hv
      · exact hσ v hv
      · have hv' : v = _ := List.mem_singleton.mp hv
        subst v
        exact Expr.lt_of_evalB he
