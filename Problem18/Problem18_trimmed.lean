variable {F V ι : Type*} [Field F] [AddCommGroup V] [Module F V]
  [Fintype ι] [DecidableEq ι]
variable (B : LinearMap.BilinForm F V) (hB : B.Nondegenerate)
def gramUnit (b : Module.Basis ι F V) : Fˣ :=
  Units.mk0 (LinearMap.BilinForm.toMatrix b B).det
    ((LinearMap.BilinForm.nondegenerate_iff_det_ne_zero b).mp hB)
def determinantClass (b : Module.Basis ι F V) : SquareClass F :=
  squareClass F (gramUnit B hB b)
variable {κ : Type*} [Fintype κ] [DecidableEq κ]
theorem determinantClass_reindex (b : Module.Basis ι F V) (e : ι ≃ κ) :
    determinantClass B hB (b.reindex e) = determinantClass B hB b := by
  unfold determinantClass
  congr 1
  apply Units.ext
  simp only [gramUnit, Units.val_mk0]
  have hm : LinearMap.BilinForm.toMatrix (b.reindex e) B =
      Matrix.reindex e e (LinearMap.BilinForm.toMatrix b B) := by
    ext i j
    simp [LinearMap.BilinForm.toMatrix_apply, Module.Basis.reindex_apply]
  rw [hm, Matrix.det_reindex_self]
