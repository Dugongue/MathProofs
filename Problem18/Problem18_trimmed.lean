noncomputable def run (n : Nat) (T : Nat → Nat) (hpt : PointExistence (K := K) L n T)
    (F : FieldPresentation K) (d : Nat) (rows : List (DenseInput n d K)) : Bool × Nat :=
  let c := compress rows
  let r := decideSystem (services n T hpt) F d c.1
  (r.1, c.2 + r.2)
theorem run_correct (n : Nat) (T : Nat → Nat) (hpt : PointExistence (K := K) L n T)
    (F : FieldPresentation K) (d : Nat) (rows : List (DenseInput n d K))
    (hv : ∀ v ∈ rows, ∃ p : MvPolynomial (Fin n) K, ValidDenseInput d v p) :
    (run n T hpt F d rows).1 = true ↔
      ∃ x : Fin n → K, ∀ v ∈ rows, denseEval x (read v) = 0 := by
  obtain ⟨fs, hfs⟩ := exists_represents (compress rows).1
    (fun v hv' => hv v (compress_sublist_values rows v hv'))
  change (decideSystem (services n T hpt) F d (compress rows).1).1 = true ↔ _
  rw [decideSystem_correct (services n T hpt) F d (compress rows).1 fs hfs]
  exact exists_congr fun x => compress_linear_zeros rows (denseEval x)
