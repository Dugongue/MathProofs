open scoped BigOperators
open Mathproof.Problem18EulerProductBounds20260930
theorem geometric_error_sum (r : ℝ) (hr : 0≤ r) (hh : r≤1/2) (n : ℕ) :
    ∑ k∈Finset.range n,r^(k+1)≤1 := by
  have hs : 0≤∑ k∈Finset.range n,r^k := Finset.sum_nonneg fun k _ => pow_nonneg hr k
  have he := geom_sum_mul_neg r n
  have hm : r*(∑ k∈Finset.range n,r^k)≤(1-r)*(∑ k∈Finset.range n,r^k) :=
    mul_le_mul_of_nonneg_right (by linarith) hs
  have hb : r*(∑ k∈Finset.range n,r^k)≤1 := by nlinarith [pow_nonneg hr n]
  simpa only [pow_succ,Finset.mul_sum,mul_comm] using hb
theorem selected_product_bounds (r : ℝ) (hr : 0≤ r) (hh : r≤1/2)
    (n : ℕ) (x : ℕ → ℝ) (hx : ∀ k∈Finset.range n,0≤x k)
    (hu : ∀ k∈Finset.range n,x k≤ r^(k+1)) :
    Real.exp (-2)≤∏ k∈Finset.range n,(1-x k) ∧
      (∏ k∈Finset.range n,(1-x k))≤1 := by
  have hhalf (k : ℕ) (hk : k∈Finset.range n) : x k≤1/2 := by
    calc x k≤ r^(k+1) := hu k hk
         _ ≤ r^1 := pow_le_pow_of_le_one hr (by linarith) (by omega)
         _ ≤1/2 := by simpa using hh
  constructor
  · simpa using finite_product_lower_of_sum (Finset.range n) x hx hhalf 1
      ((Finset.sum_le_sum hu).trans (geometric_error_sum r hr hh n))
  · apply Finset.prod_le_one
    · intro k hk; have h:=hhalf k hk; linarith
    · intro k hk; have h:=hx k hk; linarith
def orderFactor (q : ℝ) (k : ℕ) : ℝ :=
  1-(if Odd (k+2) then (q^(k+1))⁻¹ else 0)
