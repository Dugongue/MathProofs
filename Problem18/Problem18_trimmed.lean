theorem evalB_var_at {B : ℕ} {σ : Env} {x : String} {v : ℕ} (h : σ.vars x = v) (hv : v < B) :
    (Expr.var x).evalB B σ = some v := by
  have := evalB_var (σ := σ) (x := x) (by rw [h]; exact hv)
  rw [h] at this; exact this
theorem smallBody_step (q : RNames) (cn : CNames) (zn : ZNames) (sn : SNames) (rs : RowSlots)
    {n d : ℕ} (rows : List (DenseInput n d K)) {S B Qv : ℕ} {σ : Env}
