    simp only [Multiset.map_cons,Multiset.sum_cons,Multiset.card_cons,Nat.cast_add,Nat.cast_one]
    calc
      ‖a^n+(s.map (fun α => α^n)).sum‖ ≤ ‖a^n‖+‖(s.map (fun α => α^n)).sum‖ := norm_add_le _ _
      _ ≤ R^n+(s.card:ℝ)*R^n := by
        rw [norm_pow]
        exact add_le_add (pow_le_pow_left₀ (norm_nonneg a) (hs a (by simp)) n)
          (ih (fun α hα => hs α (by simp [hα])))
