  have ep : ξ.vars product=σ.vars product:=hframe.1 _ (hs product (by simp))
  have eo : ξ.vars output=σ.vars output:=hframe.1 _ (hs output (by simp))
  have eq : ξ.vars canonical.exp=σ.vars canonical.exp:=hframe.1 _ (by decide)
  have em : ξ.vars canonical.modBase=σ.vars canonical.modBase:=hframe.1 _ (by decide)
  have wc : σ.vars acc<B:=lt_of_le_of_lt (Nat.le_add_right _ _) (hc.trans_lt h.memory_word)
  have wo : σ.vars output<B:=lt_of_le_of_lt (Nat.le_add_right _ _) (ho.trans_lt h.memory_word)
  have hec : (Expr.var acc).evalB B ξ=some (σ.vars acc) := by
    simpa only [ec] using (evalB_var (by rw [ec]; exact wc) : (Expr.var acc).evalB B ξ=some (ξ.vars acc))
  have heprod : (Expr.var product).evalB B (ξ.setVar canonical.aBase (σ.vars acc))=some (σ.vars product) := by
    simpa [Expr.evalB,(hsafe product (by simp)).1,ep] using
      (evalB_var (by rw [ep]; exact wp) : (Expr.var product).evalB B ξ=some (ξ.vars product))
  have heout : (Expr.var output).evalB B
