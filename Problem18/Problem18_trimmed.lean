    (B : V →ₗ⋆[K] V →ₗ[K] K) (c : FixedUnits φ) (e : TraceIsometries φ hc B c) :
    Frames t (traceOperator φ hc t ht B c e).val :=
  ⟨e.val,by intro x; simp [traceOperator]⟩
noncomputable def incidenceMap (t : E) (ht : φ t=t) (B : V →ₗ⋆[K] V →ₗ[K] K) :
    (Σ c : FixedUnits φ,TraceIsometries φ hc B c) →
      (Σ S : Operators t B,Frames t S.val) := fun ce =>
  ⟨traceOperator φ hc t ht B ce.1 ce.2,traceFrame φ hc t ht B ce.1 ce.2⟩
theorem incidenceMap_injective (htr : (Algebra.traceForm K E).Nondegenerate)
    (t : E) (ht : φ t=t) (B : V →ₗ⋆[K] V →ₗ[K] K) :
    Function.Injective (incidenceMap φ hc t ht B) := by
  intro a b hab
  have he : a.2.val=b.2.val := congrArg (fun z : Σ S : Operators t B,Frames t S.val => z.2.val) hab
  have hform : unitTraceForm starRingAut φ hc a.1.val=unitTraceForm starRingAut φ hc b.1.val := by
    ext x y
    rw [← a.2.property,← b.2.property,he]
  have hu := unitTraceForm_injective starRingAut φ hc htr hform
  have hc' : a.1=b.1 := Subtype.ext hu
  apply Sigma.ext hc'
  exact (Subtype.heq_iff_coe_eq (by intro e; simp only [hc'])).mpr he
noncomputable def traceIsometriesEquiv (B : V →ₗ⋆[K] V →ₗ[K] K)
    (c : FixedUnits φ) (e : TraceIsometries φ hc B c) :
    TraceIsometries φ hc B c ≃ isometrySubgroup (fun x y => B x y) where
  toFun f := ⟨e.val.symm.trans f.val,by
    intro x y
    change B (f.val (e.val.symm x)) (f.val (e.val.symm y))=B x y
    rw [f.property]
    simpa only [LinearEquiv.apply_symm_apply] using
      (e.property (e.val.symm x) (e.val.symm y)).symm⟩
  invFun Q := ⟨e.val.trans Q.val,by
    intro x y
    exact (Q.property (e.val x) (e.val y)).trans (e.property x y)⟩
  left_inv f := by
    apply Subtype.ext
    apply LinearEquiv.ext
    intro x
    exact congrArg f.val (e.val.symm_apply_apply x)
  right_inv Q := by
    apply Subtype.ext
    apply LinearEquiv.ext
    intro x
    exact congrArg Q.val (e.val.apply_symm_apply x)
include hc in
theorem operator_card_lower
    (hcard : Nat.card K=Nat.card F^2) (hstar : ∀ a : K,star a=a^Nat.card F)
    (hφ : Function.Involutive φ) (htr : (Algebra.traceForm K E).Nondegenerate)
    (t : E) (ht : φ t=t) (hgen : Algebra.adjoin K ({t}:Set E)=⊤)
    (B : V →ₗ⋆[K] V →ₗ[K] K) (hB : B.IsSymm) (hnB : B.SeparatingLeft)
    (hd : Module.finrank K E=Module.finrank K V) :
    Nat.card (FixedUnits φ)*Nat.card (isometrySubgroup (fun x y => B x y)) ≤
      Nat.card (Operators t B)*Nat.card V := by
  letI : Finite E := Finite.of_injective (Module.finBasis K E).equivFun
    (Module.finBasis K E).equivFun.injective
  letI : Finite V := Finite.of_injective (Module.finBasis K V).equivFun
    (Module.finBasis K V).equivFun.injective
  letI : Finite (Module.End K V) := Finite.of_injective
    (fun S : Module.End K V => (S : V→V)) DFunLike.coe_injective
  letI : Finite (E ≃ₗ[K] V) := Finite.of_injective
    (fun e : E ≃ₗ[K] V => (e : E→V)) DFunLike.coe_injective
  letI : Fintype (FixedUnits φ) := Fintype.ofFinite _
  letI : Fintype (Operators t B) := Fintype.ofFinite _
  have hf (c : FixedUnits φ) : Nat.card (TraceIsometries φ hc B c)=
      Nat.card (isometrySubgroup (fun x y => B x y)) := by
    obtain ⟨e,he⟩ := Problem18HermitianRegularWitt20260929.exists_isometry_equiv_of_finrank_eq
      hcard hstar (unitTraceForm starRingAut φ hc c.val) B
      (unitTraceForm_symmetric starRingAut φ hφ hc c.val c.property) hB
      (unitTraceForm_separating starRingAut φ hc htr c.val) hnB hd
    exact Nat.card_congr (traceIsometriesEquiv φ hc B c ⟨e,he⟩)
  have hi := Nat.card_le_card_of_injective (incidenceMap φ hc t ht B)
    (incidenceMap_injective φ hc htr t ht B)
  rw [Nat.card_sigma,Nat.card_sigma] at hi
  simp_rw [hf] at hi
  have hj : (∑ S : Operators t B,Nat.card (Frames t S.val))≤
      Nat.card (Operators t B)*Nat.card V := by
    calc _ ≤ ∑ _S : Operators t B,Nat.card V :=
           Finset.sum_le_sum (fun S _ => frames_card_le t hgen S.val)
         _ = _ := by simp only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,Nat.cast_id,Nat.card_eq_fintype_card]
  apply le_trans _ hj
  simpa only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,Nat.cast_id,Nat.card_eq_fintype_card] using hi
end
end Mathproof.Problem18EtaleHermitianOperatorLower20260930
