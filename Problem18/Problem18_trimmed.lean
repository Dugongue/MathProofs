variable {K : Type*} [Field K] [StarRing K]
abbrev UnitSphere (n : ℕ) := {v : Fin n → K // star v ⬝ᵥ v=1}
def blockOne {n : ℕ} (V : Matrix (Fin n) (Fin n) K) : Matrix (Fin (n+1)) (Fin (n+1)) K :=
  fun i j => Fin.cases (Fin.cases 1 (fun _ => 0) j)
    (fun a => Fin.cases 0 (fun b => V a b) j) i
set_option backward.isDefEq.respectTransparency false in
set_option maxHeartbeats 800000 in
theorem blockOne_unitary_iff {n : ℕ} (V : Matrix (Fin n) (Fin n) K) :
    IsUnitary (blockOne V) ↔ IsUnitary V := by
  constructor
  · intro h
    ext i j
    have hh := congrFun (congrFun h i.succ) j.succ
    simpa [blockOne,Matrix.mul_apply,Fin.sum_univ_succ,Matrix.one_apply,Fin.succ_inj] using hh
  · intro h
    ext i j
    refine Fin.cases ?_ (fun i => ?_) i <;>
      refine Fin.cases ?_ (fun j => ?_) j
    · simp [blockOne,Matrix.mul_apply,Fin.sum_univ_succ,Matrix.one_apply,Fin.succ_inj]
    · simp [blockOne,Matrix.mul_apply,Fin.sum_univ_succ,Matrix.one_apply,Ne.symm (Fin.succ_ne_zero j)]
    · simp [blockOne,Matrix.mul_apply,Fin.sum_univ_succ,Matrix.one_apply,Fin.succ_inj]
    · have hh := congrFun (congrFun h i) j
      simpa [blockOne,Matrix.mul_apply,Fin.sum_univ_succ,Matrix.one_apply,Fin.succ_inj] using hh
theorem unitary_fix_column_block {n : ℕ} (U : Matrix (Fin (n+1)) (Fin (n+1)) K)
    (hU : IsUnitary U) (hc : ∀ i,U i 0=if i=0 then 1 else 0) :
    U=blockOne (fun i j => U i.succ j.succ) := by
  have hr (j : Fin (n+1)) : U 0 j=if 0=j then 1 else 0 := by
    have h := congrFun (congrFun hU 0) j
    simpa [Matrix.mul_apply,Matrix.conjTranspose_apply,hc,Fin.sum_univ_succ,
      Matrix.one_apply] using h
  ext i j
  refine Fin.cases ?_ (fun i => ?_) i <;>
    refine Fin.cases ?_ (fun j => ?_) j
  · simp [blockOne,hc]
  · simp [blockOne,hr,Ne.symm (Fin.succ_ne_zero j)]
  · simp [blockOne,hc]
  · rfl
noncomputable def unitaryColumn {n : ℕ} (U : Matrix.unitaryGroup (Fin (n+1)) K) :
    UnitSphere (K := K) (n+1) :=
  ⟨fun i => (U : Matrix (Fin (n+1)) (Fin (n+1)) K) i 0,by
    have h := congrFun (congrFun U.property.1 0) 0
    simpa [dotProduct,Matrix.mul_apply,Matrix.conjTranspose_apply] using h⟩
noncomputable def firstVector (n : ℕ) : UnitSphere (K := K) (n+1) :=
  ⟨Pi.single 0 1,by simp⟩
noncomputable def firstColumnFiberEquiv (n : ℕ) :
    {U : Matrix.unitaryGroup (Fin (n+1)) K // unitaryColumn U=firstVector n} ≃
      Matrix.unitaryGroup (Fin n) K where
  toFun U :=
    ⟨fun i j => (U.val : Matrix (Fin (n+1)) (Fin (n+1)) K) i.succ j.succ,by
      apply Matrix.mem_unitaryGroup_iff'.mpr
      apply (blockOne_unitary_iff _).mp
      have hc (i : Fin (n+1)) : (U.val : Matrix (Fin (n+1)) (Fin (n+1)) K) i 0=if i=0 then 1 else 0 := by
        have h := congrFun (congrArg Subtype.val U.property) i
        simpa [unitaryColumn,firstVector,Pi.single_apply] using h
      rw [← unitary_fix_column_block _ U.val.property.1 hc]
      exact U.val.property.1⟩
  invFun V :=
    ⟨⟨blockOne V.val,Matrix.mem_unitaryGroup_iff'.mpr ((blockOne_unitary_iff _).mpr V.property.1)⟩,by
      apply Subtype.ext
      funext i
      refine Fin.cases ?_ (fun i => ?_) i <;> simp [unitaryColumn,firstVector,blockOne]⟩
  left_inv U := by
    apply Subtype.ext
    apply Subtype.ext
    symm
    apply unitary_fix_column_block _ U.val.property.1
    intro i
    have h := congrFun (congrArg Subtype.val U.property) i
    simpa [unitaryColumn,firstVector,Pi.single_apply] using h
  right_inv V := by
    apply Subtype.ext
    rfl
theorem column_kernel_eq_bot {n : ℕ} (v : Fin n → K) (hv : v≠0) :
    LinearMap.ker (Matrix.toLin' (fun i (_ : Fin 1) => v i))=⊥ := by
  apply LinearMap.ker_eq_bot.mpr
  apply (injective_iff_map_eq_zero _).mpr
  intro x hx
  obtain ⟨i,hi⟩ : ∃ i,v i≠0 := Function.ne_iff.mp hv
  have h := congrFun hx i
  change (∑ j : Fin 1,v i*x j)=0 at h
  simp only [Fin.sum_univ_one] at h
  have hx0 : x 0=0 := (mul_eq_zero.mp h).resolve_left hi
  funext j
  have hj : j=0 := Subsingleton.elim _ _
  simpa [hj] using hx0
variable {F : Type*} [Field F] [Fintype F] [Fintype K] [Algebra F K]
theorem unitaryColumn_surjective
    (hcard : Nat.card K=Nat.card F^2)
