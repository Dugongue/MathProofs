section Local
variable {R : Type*} [CommRing R]
noncomputable def localEuler (e : Nat) (z : R) : PowerSeries R :=
  PowerSeries.subst (PowerSeries.X ^ e)
    (PowerSeries.rescale z (PowerSeries.mk 1))
@[simp]
theorem coeff_localEuler (z : R) {e n : Nat} (he : e ≠ 0) :
    PowerSeries.coeff n (localEuler e z) =
      if e ∣ n then z ^ (n / e) else 0 := by
  rw [localEuler, PowerSeries.coeff_subst_X_pow he]
  simp [PowerSeries.coeff_rescale]
theorem localEuler_mul_one_sub (z : R) {e : Nat} (he : e ≠ 0) :
    localEuler e z *
      (1 - PowerSeries.C z * PowerSeries.X ^ e) = 1 := by
  have hepos : 0 < e := Nat.pos_of_ne_zero he
  ext n
  rw [mul_sub, mul_one, map_sub,
    show localEuler e z * (PowerSeries.C z * PowerSeries.X ^ e) =
      PowerSeries.C z * (localEuler e z * PowerSeries.X ^ e) by ring,
    PowerSeries.coeff_C_mul, PowerSeries.coeff_mul_X_pow', coeff_localEuler z he,
    PowerSeries.coeff_one]
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · simp [Nat.not_le.mpr hepos]
  · rw [if_neg (Nat.pos_iff_ne_zero.mp hn)]
    by_cases hle : e ≤ n
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + e := ⟨n - e, by omega⟩
      rw [if_pos hle, Nat.add_sub_cancel, coeff_localEuler z he, Nat.add_div_right _ hepos]
      by_cases hd : e ∣ m
      · rw [if_pos ((Nat.dvd_add_self_right).mpr hd), if_pos hd]
        ring
      · rw [if_neg (fun h => hd ((Nat.dvd_add_self_right).mp h)), if_neg hd]
        ring
    · have hnd : ¬ e ∣ n := fun h => hle (Nat.le_of_dvd hn h)
      rw [if_neg hnd, if_neg hle]
      ring
theorem X_mul_derivativeFun_localEuler (z : R) {e : Nat} (he : e ≠ 0) :
    PowerSeries.X * PowerSeries.derivative R (localEuler e z) =
      PowerSeries.C (e : R) * localEuler e z * (localEuler e z - 1) := by
  set L := localEuler e z with hLdef
  set D := PowerSeries.derivative R
  set u : PowerSeries R := 1 - PowerSeries.C z * PowerSeries.X ^ e with hudef
  have h1 : L * u = 1 := localEuler_mul_one_sub z he
  have h2 : L * D u + u * D L = 0 := by
    have := congrArg D h1
    rw [Derivation.leibniz, Derivation.map_one_eq_zero, smul_eq_mul, smul_eq_mul] at this
    exact this
  have h3 : PowerSeries.X * D u = -(PowerSeries.C z * PowerSeries.C (e : R) * PowerSeries.X ^ e) := by
    have hXe : PowerSeries.X * (PowerSeries.X : PowerSeries R) ^ (e - 1) = PowerSeries.X ^ e := by
      rw [← pow_succ']
      congr 1
      omega
    have hDu : D u = -(PowerSeries.C z * ((e : PowerSeries R) * PowerSeries.X ^ (e - 1))) := by
      simp only [hudef, D, map_sub, Derivation.map_one_eq_zero, Derivation.leibniz,
        PowerSeries.derivative_C, PowerSeries.derivative_pow, PowerSeries.derivative_X,
        smul_eq_mul, mul_zero, add_zero, zero_sub, mul_one]
    rw [hDu, show ((e : PowerSeries R)) = PowerSeries.C (e : R) by simp]
    linear_combination (-(PowerSeries.C z * PowerSeries.C (e : R))) * hXe
  linear_combination (-(PowerSeries.X * D L) - PowerSeries.C (e : R) * L) * h1 +
    (L * PowerSeries.X) * h2 - L ^ 2 * h3
end Local
section Recurrence
variable {R : Type*} [CommSemiring R]
private theorem coeff_succ_relation {F G : R⟦X⟧}
    (h : X * PowerSeries.derivative R F = F * G) (h0 : coeff 0 F = 1) (m : Nat) :
    coeff (m + 1) F * (m + 1) =
      (∑ k ∈ Finset.range (m + 1), coeff (k + 1) F * coeff (m + 1 - (k + 1)) G) +
        coeff (m + 1) G := by
  have hc := congrArg (coeff (m + 1)) h
  rw [coeff_succ_X_mul, coeff_derivative, coeff_mul,
    Finset.Nat.sum_antidiagonal_eq_sum_range_succ (fun i j => coeff i F * coeff j G),
    Finset.sum_range_succ', h0, one_mul, Nat.sub_zero] at hc
  exact hc
theorem coeff_logDerivative_eq_of_coeff_eq_up_to
    [IsLeftCancelAdd R] {L A B C : R⟦X⟧} {N : Nat}
    (hLB : X * PowerSeries.derivative R L = L * B)
    (hAC : X * PowerSeries.derivative R A = A * C)
    (hB0 : constantCoeff B = 0) (hC0 : constantCoeff C = 0)
    (hL0 : coeff 0 L = 1)
    (hcoeff : ∀ j, j ≤ N → coeff j L = coeff j A)
    {n : Nat} (hnN : n ≤ N) :
    coeff n B = coeff n C := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    rcases n with _ | m
    · rw [coeff_zero_eq_constantCoeff_apply, coeff_zero_eq_constantCoeff_apply, hB0, hC0]
    · have hA0 : coeff 0 A = 1 := (hcoeff 0 (Nat.zero_le _)) ▸ hL0
      have kL := coeff_succ_relation hLB hL0 m
      have kA := coeff_succ_relation hAC hA0 m
      have hsum :
          (∑ k ∈ Finset.range (m + 1), coeff (k + 1) L * coeff (m + 1 - (k + 1)) B) =
            ∑ k ∈ Finset.range (m + 1), coeff (k + 1) A * coeff (m + 1 - (k + 1)) C := by
        refine Finset.sum_congr rfl fun k hk => ?_
        have hk' : k < m + 1 := Finset.mem_range.mp hk
        rw [hcoeff (k + 1) (by omega), ih (m + 1 - (k + 1)) (by omega) (by omega)]
      rw [hcoeff (m + 1) hnN, kA, hsum] at kL
      exact (add_left_cancel kL).symm
end Recurrence
end Mathproof.Problem18EulerLocalSeries20260930
