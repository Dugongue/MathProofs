    apply Prod.ext
    · exact (coordinates τ B E Z).map_zero
    · funext i; apply Subtype.ext; simp
  map_add' T U := by
    apply Prod.ext
    · exact (coordinates τ B E Z).map_add T U
    · funext i; apply Subtype.ext
