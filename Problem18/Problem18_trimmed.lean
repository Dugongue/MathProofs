set_option backward.isDefEq.respectTransparency false
abbrev Preservers (B : LinearMap.BilinForm K V) (U : Submodule K V) :=
  {T : SelfAdjointOperators (RingEquiv.refl K) B // ∀ x∈U,T.val x∈U}
def restrictedOperator (B : LinearMap.BilinForm K V) (U : Submodule K V) (T : Preservers B U) :
    SelfAdjointOperators (RingEquiv.refl K) (B.restrict U) :=
  ⟨T.val.val.restrict T.property,fun x y=>T.val.property x.val y.val⟩
noncomputable def splitCoordinates (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (U : Submodule K V) (hU : (B.restrict U).Nondegenerate) :
    (U×B.orthogonal U) ≃ₗ[K] V :=
  Submodule.prodEquivOfIsCompl U (B.orthogonal U)
    (B.isCompl_orthogonal_of_restrict_nondegenerate hB.isRefl hU)
private theorem split_pairing_m0581 (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (U : Submodule K V) (hU : (B.restrict U).Nondegenerate) (x y : U×B.orthogonal U) :
    B (splitCoordinates B hB U hU x) (splitCoordinates B hB U hU y)=
      sumForm (RingEquiv.refl K) (B.restrict U) (B.restrict (B.orthogonal U)) x y := by
  change B (x.1.val+x.2.val) (y.1.val+y.2.val)=B x.1.val y.1.val+B x.2.val y.2.val
  have hxy : B x.1.val y.2.val=0 := y.2.property x.1.val x.1.property
  have hyx : B x.2.val y.1.val=0 := hB.isRefl _ _ (x.2.property y.1.val y.1.property)
  simp only [map_add,LinearMap.add_apply,hxy,hyx,add_zero,zero_add]
private theorem split_inverse_mem (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (U : Submodule K V) (hU : (B.restrict U).Nondegenerate) (x : V) :
    ((splitCoordinates B hB U hU).symm x).2=0 ↔ x∈U := by
  let e := splitCoordinates B hB U hU
  constructor
  · intro hz
    have he := e.apply_symm_apply x
    change (e.symm x).1.val+(e.symm x).2.val=x at he
    rw [hz] at he
    simp only [ZeroMemClass.coe_zero,add_zero] at he
    exact he ▸ (e.symm x).1.property
  · intro hx
    have he : e.symm x=(⟨x,hx⟩,0) := by
      apply e.injective
      rw [e.apply_symm_apply]
      change x=x+0
      exact (add_zero x).symm
    rw [he]
noncomputable def splitOperatorEquiv (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (U : Submodule K V) (hU : (B.restrict U).Nondegenerate) :
    SelfAdjointOperators (RingEquiv.refl K) B ≃
      SelfAdjointOperators (RingEquiv.refl K)
        (sumForm (RingEquiv.refl K) (B.restrict U) (B.restrict (B.orthogonal U))) :=
  Mathproof.Problem18OrdinarySampleNormalization20261001.operatorIsometryEquiv _ _
    (splitCoordinates B hB U hU).symm (fun x y=>by
      rw [←split_pairing_m0581 B hB U hU]
      simp only [LinearEquiv.apply_symm_apply])
noncomputable def preserverEquiv (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (U : Submodule K V) (hU : (B.restrict U).Nondegenerate) :
    Preservers B U ≃ PreservedFirst (RingEquiv.refl K) (B.restrict U) (B.restrict (B.orthogonal U)) :=
  (splitOperatorEquiv B hB U hU).subtypeEquiv (fun T=>by
    constructor
    · intro ht x
      change ((splitCoordinates B hB U hU).symm (T.val (x.val+0))).2=0
      rw [add_zero]
      exact (split_inverse_mem B hB U hU _).mpr (ht x.val x.property)
    · intro ht x hx
      apply (split_inverse_mem B hB U hU _).mp
      have hh := ht ⟨x,hx⟩
      change ((splitCoordinates B hB U hU).symm (T.val (x+0))).2=0 at hh
      simpa only [add_zero] using hh)
private theorem firstOperator_restricted (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (U : Submodule K V) (hU : (B.restrict U).Nondegenerate) (T : Preservers B U) :
    firstOperator (RingEquiv.refl K) (B.restrict U) (B.restrict (B.orthogonal U))
      (preserverEquiv B hB U hU T)=restrictedOperator B U T := by
  apply Subtype.ext
  apply LinearMap.ext
  intro x
  apply Subtype.ext
  let e := splitCoordinates B hB U hU
  change (e.symm (T.val.val (x.val+0))).1.val=T.val.val x.val
  rw [add_zero]
  have he := e.apply_symm_apply (T.val.val x.val)
  change (e.symm (T.val.val x.val)).1.val+(e.symm (T.val.val x.val)).2.val=T.val.val x.val at he
  have hz := (split_inverse_mem B hB U hU (T.val.val x.val)).mpr (T.property x.val x.property)
  rw [hz] at he
  simpa only [ZeroMemClass.coe_zero,add_zero] using he
theorem regular_subspace_charpoly_card (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (U : Submodule K V) (hU : (B.restrict U).Nondegenerate) (h : K[X]) :
    Nat.card {T : Preservers B U // (restrictedOperator B U T).val.charpoly=h}=
      Nat.card (SourceOperators (RingEquiv.refl K) (B.restrict U) h)*
        Nat.card (SelfAdjointOperators (RingEquiv.refl K) (B.restrict (B.orthogonal U))) := by
  let E : {T : Preservers B U // (restrictedOperator B U T).val.charpoly=h} ≃
      {T : PreservedFirst (RingEquiv.refl K) (B.restrict U) (B.restrict (B.orthogonal U)) //
        (firstOperator (RingEquiv.refl K) (B.restrict U) (B.restrict (B.orthogonal U)) T).val.charpoly=h} :=
    (preserverEquiv B hB U hU).subtypeEquiv (fun T=>by rw [firstOperator_restricted])
  let F : {T : PreservedFirst (RingEquiv.refl K) (B.restrict U) (B.restrict (B.orthogonal U)) //
        (firstOperator (RingEquiv.refl K) (B.restrict U) (B.restrict (B.orthogonal U)) T).val.charpoly=h} ≃
      {z : SelfAdjointOperators (RingEquiv.refl K) (B.restrict U) ×
        SelfAdjointOperators (RingEquiv.refl K) (B.restrict (B.orthogonal U)) // z.1.val.charpoly=h} :=
    (blockEquiv (RingEquiv.refl K) (B.restrict U) (B.restrict (B.orthogonal U)) hU.1).subtypeEquiv
      (fun T=>Iff.rfl)
  let G : {z : SelfAdjointOperators (RingEquiv.refl K) (B.restrict U) ×
      SelfAdjointOperators (RingEquiv.refl K) (B.restrict (B.orthogonal U)) // z.1.val.charpoly=h} ≃
      SourceOperators (RingEquiv.refl K) (B.restrict U) h ×
        SelfAdjointOperators (RingEquiv.refl K) (B.restrict (B.orthogonal U)) :=
    { toFun := fun z=>(⟨z.val.1,z.property⟩,z.val.2)
      invFun := fun z=>⟨(z.1.val,z.2),z.1.property⟩
      left_inv := fun _=>rfl
      right_inv := fun _=>rfl }
  rw [Nat.card_congr (E.trans (F.trans G)),Nat.card_prod]
end
end Mathproof.Problem18OrdinaryRegularSubspaceCount20261001
