variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
structure MemAgree (W : String) (j : Nat) (σ τ : Env) : Prop where
  length : (τ.arrs canonical.mem).length=(σ.arrs canonical.mem).length
  other : ∀k,k≠j→(τ.arrs canonical.mem).getD k 0=(σ.arrs canonical.mem).getD k 0
  below : j<σ.vars W
  above : σ.vars canonical.modBase+F.e≤j
  scratch_length : (τ.arrs canonical.scratch).length=(σ.arrs canonical.scratch).length
  e : τ.vars canonical.e=σ.vars canonical.e
  p : τ.vars canonical.p=σ.vars canonical.p
  modBase : τ.vars canonical.modBase=σ.vars canonical.modBase
  exp : τ.vars canonical.exp=σ.vars canonical.exp
  ws : τ.vars W=σ.vars W
theorem MemAgree.slice {W : String} {j : Nat} {σ τ : Env} (h : MemAgree F W j σ τ)
    (base : Nat) (hb : σ.vars W≤base) :
    Problem18IMPFieldPresentation20261001.slice F τ canonical base=
      Problem18IMPFieldPresentation20261001.slice F σ canonical base := by
  funext i
  unfold Problem18IMPFieldPresentation20261001.slice
  exact h.other _ (by have:=h.below;omega)
theorem MemAgree.val {W : String} {j : Nat} {σ τ : Env} (h : MemAgree F W j σ τ) (s : Nat) :
    val F canonical W τ s=val F canonical W σ s := by
  unfold Problem18ClaudeIMPSlots20261001.val
  rw [h.ws,h.slice F _ (by omega)]
theorem MemAgree.slots {W : String} {j S B : Nat} {σ τ : Env} (h : MemAgree F W j σ τ)
    (hs : Slots F canonical W S B σ) : Slots F canonical W S B τ := by
  have hbase : Base F canonical B τ := {
    names:=hs.base.names
    degree:=h.e.trans hs.base.degree
    prime:=h.p.trans hs.base.prime
    arithmetic_word:=hs.base.arithmetic_word
    inverse_word:=hs.base.inverse_word
    memory_word:=by rw [h.length];exact hs.base.memory_word
    scratch_word:=by rw [h.scratch_length];exact hs.base.scratch_word
    scratch_fit:=by rw [h.scratch_length];exact hs.base.scratch_fit
    modulus_fit:=by rw [h.modBase,h.length];exact hs.base.modulus_fit
    modulus_value:=by
      intro i
      rw [h.modBase,h.other _ (by have:=h.above;have:=i.isLt;omega)]
      exact hs.base.modulus_value i
    exp_word:=by rw [h.exp];exact hs.base.exp_word
    priv:=hs.base.priv }
  refine ⟨hbase,hs.ws_reg,?_,?_,?_,hs.slots_word⟩
  · rw [h.ws,h.length];exact hs.fit
  · rw [h.modBase,h.ws];exact hs.modulus_apart
  · intro s hss
    rw [h.ws,h.slice F _ (by omega)]
    exact hs.canon s hss
theorem validMemory_of_slots {W : String} {S B : Nat} {σ : Env}
    (hs : Slots F canonical W S B σ)
    (hW : σ.vars W=F.e+1) (hmod : σ.vars canonical.modBase=0)
    (hlen : (σ.arrs canonical.mem).length=F.e+1+S*F.e)
    (hgap : (σ.arrs canonical.mem).getD F.e 0<F.p)
    (hscratch : 5*F.e≤(σ.arrs canonical.scratch).length) :
    ValidMemory F B σ := by
  have hp : 0<F.p := lt_of_le_of_lt (Nat.zero_le _) hgap
  refine {
    degree:=hs.base.degree
    prime:=hs.base.prime
    arithmetic_word:=hs.base.arithmetic_word
    inverse_word:=hs.base.inverse_word
    memory_word:=hs.base.memory_word
    scratch_word:=hs.base.scratch_word
    scratch_fit:=hscratch
    modulus_fit:=by rw [hmod,hlen];omega
    modulus_value:=by
      intro i
      unfold Problem18IMPFieldMultiplication20261001.sourceCoeff
      simpa [hmod] using hs.base.modulus_value i
    coefficients:=?_ }
  intro j hj
  by_cases hjm : j<F.e
  · have hv:=hs.base.modulus_value ⟨j,hjm⟩
    rw [hmod,Nat.zero_add] at hv
    rw [hv]
    have := (F.modulus ⟨j,hjm⟩).isLt
    exact this
  · by_cases hje : j=F.e
    · subst j;exact hgap
    · have he0 : 0<F.e := by
        rcases Nat.eq_zero_or_pos F.e with h0|h0
        · rw [hlen,h0] at hj;simp at hj;omega
        · exact h0
      have hk : F.e+1≤j := by omega
      let s:=(j-(F.e+1))/F.e
      let i:=(j-(F.e+1))%F.e
      have hjs : j=F.e+1+s*F.e+i := by
        have:=Nat.div_add_mod (j-(F.e+1)) F.e
        dsimp [s,i];rw [Nat.mul_comm];omega
      have hi : i<F.e := Nat.mod_lt _ he0
      have hsS : s<S := by
        by_contra hc
        have : S*F.e ≤ s*F.e := Nat.mul_le_mul_right _ (by omega)
        omega
      have hc:=hs.canon s hsS ⟨i,hi⟩
      unfold Problem18IMPFieldPresentation20261001.slice at hc
      rw [hW] at hc
      rw [hjs];exact hc
end Mathproof.Problem18PairBoundaryTransfer20261004
