        some sourceAddress := by
      apply evalB_bin
      · simpa [h3] using (evalB_var (by omega : rho.vars sb<B))
      · exact evalB_var (by omega)
      · dsimp [sourceAddress];omega
    have hta : (Expr.bin .add (.var db) (.var idx)).evalB B rho=
        some targetAddress := by
      apply evalB_bin
      · simpa [h4] using (evalB_var (by omega : rho.vars db<B))
      · exact evalB_var (by omega)
      · dsimp [targetAddress];omega
    have hget : (rho.arrs a)[sourceAddress]?=some value := by
      have hs : sourceAddress<(rho.arrs a).length := by
        rw [h6];dsimp [sourceAddress];omega
      have hsv : (rho.arrs a).getD sourceAddress 0=value :=
        h8 _ (by rcases hdisj with hd|hd <;> dsimp [sourceAddress] <;> omega)
      rw [← hsv]
      simp [List.getD,List.getElem?_eq_getElem hs]
    have hread : (Expr.get a
        (.bin .add (.var sb) (.var idx))).evalB B rho=some value :=
      evalB_get hsa hget hv
    have hr1:=Run.store (a:=a) hta hread
      (by rw [h6];change targetBase+rho.vars idx < _;omega)
    let rho1:=rho.setArr a targetAddress value
    let tau:=rho1.setVar idx (rho.vars idx+1)
    have hinc : (Expr.bin .add (.var idx) (.lit 1)).evalB B rho1=
        some (rho.vars idx+1) :=
      evalB_bin (evalB_var (by change rho.vars idx<B;omega))
        (evalB_lit (by omega)) (by change rho.vars idx+1<B;omega)
    have htv : tau.vars idx=rho.vars idx+1 := by simp [tau]
    refine ⟨tau,?_,?_,?_⟩
    · simpa only [segBody,rho1,tau,Expr.size,Nat.reduceAdd] using
        hr1.seq (Run.assign (x:=idx) hinc)
    · refine ⟨by rw [htv];omega,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_⟩
      · simpa [tau,rho1,Ne.symm hic] using h2
      · simpa [tau,rho1,Ne.symm his] using h3
      · simpa [tau,rho1,Ne.symm hid] using h4
      · intro b hb
        simp only [tau,rho1,arrs_setVar,arrs_setArr,if_neg hb]
        exact h5 b hb
      · simpa [tau,rho1] using h6
      · intro k hk
        rw [htv] at hk
        by_cases heq:k=rho.vars idx
        · subst k
          simp only [tau,rho1,arrs_setVar,arrs_setArr,if_pos rfl,ite_true]
          rw [getD_set_self (by rw [h6];omega)]
        · rw [show (tau.arrs a).getD (targetBase+k) 0=
              (rho.arrs a).getD (targetBase+k) 0 by
            simp only [tau,rho1,arrs_setVar,arrs_setArr,if_pos rfl,ite_true]
            rw [getD_set_ne (by dsimp [targetAddress];omega)]]
          exact h7 k (by omega)
      · intro k hk
        rw [htv] at hk
        have hne:targetAddress≠k:=by
          rcases hk with hk|hk <;> dsimp [targetAddress] <;> omega
        rw [show (tau.arrs a).getD k 0=
              (rho.arrs a).getD k 0 by
            simp only [tau,rho1,arrs_setVar,arrs_setArr,if_pos rfl,ite_true]
            rw [getD_set_ne hne]]
        apply h8
        rcases hk with hk|hk
        · exact Or.inl hk
        · exact Or.inr (by omega)
      · intro x hx
        simp only [tau,rho1,vars_setVar,if_neg hx,vars_setArr]
        exact h9 x hx
      · simpa [tau,rho1] using h10
      · simpa [tau,rho1] using h11
    · show n-tau.vars idx<n-rho.vars idx
      rw [htv];omega
  have hI : I (sigma.setVar idx 0) := by
    refine ⟨by simp,?_,?_,?_,fun _ _=>rfl,rfl,by simp,fun _ _=>rfl,?_,rfl,rfl⟩
    · simpa [Ne.symm hic] using hcount
    · simpa [Ne.symm his] using hsource
    · simpa [Ne.symm hid] using htarget
    · intro x hx;simp [hx]
  obtain ⟨tau,hr,hτ,hfalse⟩:=Run.while_count I V 12 hdef hstep hI
  obtain ⟨h1,h2,h3,h4,h5,h6,h7,h8,h9,h10,h11⟩:=hτ
  have ht:=evalB_condLt
    (evalB_var (by omega : tau.vars idx<B))
    (evalB_var (by rw [h2];exact hn : tau.vars cnt<B))
  rw [hfalse,h2] at ht
  have hi:tau.vars idx=n:=by
    have hh:¬tau.vars idx<n:=by simpa using ht.symm
