variable {K : Type*} [Field K] [Fintype K]
def fixedContribution (n d : ℕ) : ℝ :=
  (Nat.card (NonzeroIrreducibleDegree (K:=K) d)*fixedRepeatBound (K:=K) n d : ℕ)/
    (Nat.card K : ℝ)^(n-1)
theorem fixedContribution_zero (n : ℕ) : fixedContribution (K:=K) n 0=0 := by
  simp only [fixedContribution,nonzero_irreducible_card_zero,zero_mul,Nat.cast_zero,zero_div]
theorem fixedContribution_le (n d : ℕ) (hn : 4≤n) (hd : 0<d)
    (hq3 : (3:ℝ)≤Nat.card K) :
    fixedContribution (K:=K) n d≤(1/3:ℝ)^d+if 2*d=n then 1/3 else 0 := by
  have hq : (0:ℝ)<Nat.card K := by linarith
  have hq1 : (1:ℝ)≤Nat.card K := by linarith
  have hc : (Nat.card (NonzeroIrreducibleDegree (K:=K) d):ℝ)≤(Nat.card K:ℝ)^d := by
    have hh := nonzero_irreducible_card_mul_degree_le (K:=K) d hd
    have : Nat.card (NonzeroIrreducibleDegree (K:=K) d)≤Nat.card K^d := by
      nlinarith
    exact_mod_cast this
  have hi : (Nat.card K:ℝ)⁻¹≤1/3 := by
    rw [inv_eq_one_div]
    exact (div_le_iff₀ hq).mpr (by linarith)
  unfold fixedContribution fixedRepeatBound
  by_cases hl : 2*d<n
  · have hne : ¬2*d=n := by omega
    rw [if_pos hl,if_neg hne,add_zero]
    push_cast
    have heq : (Nat.card K:ℝ)^(n-1)=
        (Nat.card K:ℝ)^(n-2*d-1)*(Nat.card K:ℝ)^d*(Nat.card K:ℝ)^d := by
      rw [← pow_add,← pow_add]
      congr 1
      omega
    have hb : (Nat.card K:ℝ)^d*(Nat.card K:ℝ)^(n-2*d-1)/(Nat.card K:ℝ)^(n-1)=
        ((Nat.card K:ℝ)⁻¹)^d := by
      rw [heq,inv_pow]
      field_simp
    have hbound := div_le_div_of_nonneg_right
      (mul_le_mul_of_nonneg_right hc (by positivity : (0:ℝ)≤(Nat.card K:ℝ)^(n-2*d-1)))
      (by positivity : (0:ℝ)≤(Nat.card K:ℝ)^(n-1))
    rw [hb] at hbound
    have hp := pow_le_pow_left₀ (by positivity : (0:ℝ)≤(Nat.card K:ℝ)⁻¹) hi d
    exact hbound.trans hp
  · rw [if_neg hl]
    by_cases he : 2*d=n
    · rw [if_pos he,if_pos he]
      simp only [mul_one]
      have hp : (Nat.card K:ℝ)^d*(Nat.card K:ℝ)≤(Nat.card K:ℝ)^(n-1) := by
        rw [← pow_succ]
        exact pow_le_pow_right₀ hq1 (by omega)
      have hh : (Nat.card (NonzeroIrreducibleDegree (K:=K) d):ℝ)/(Nat.card K:ℝ)^(n-1)≤1/3 := by
        apply le_trans (div_le_div_of_nonneg_right hc (by positivity))
        apply le_trans _ (by simpa only [inv_eq_one_div] using hi)
        apply (div_le_div_iff₀ (pow_pos hq _) hq).mpr
        simpa only [one_mul] using hp
      exact hh.trans (le_add_of_nonneg_left (by positivity))
    · rw [if_neg he,if_neg he]
      simp only [mul_zero,Nat.cast_zero,zero_div,add_zero]
      positivity
theorem boundary_layer_le (n m : ℕ) :
    (∑ d : Fin m,if 2*(d.val+1)=n then (1/3:ℝ) else 0)≤1/3 := by
  classical
  by_cases hh : ∃ d : Fin m,2*(d.val+1)=n
  · obtain ⟨d,hd⟩ := hh
    rw [Finset.sum_eq_single d]
    · simp only [if_pos hd,le_refl]
    · intro j hj hne
      have hnj : 2*(j.val+1)≠n := by
        intro he
        apply hne
        apply Fin.ext
        omega
      simp only [if_neg hnj]
    · intro h
      exact (h (Finset.mem_univ d)).elim
  · have hz : ∀ d : Fin m,2*(d.val+1)≠n := by simpa only [not_exists] using hh
    simp only [hz,if_false,Finset.sum_const_zero]
    norm_num
theorem geometric_layer_le (m : ℕ) :
    (∑ d : Fin m,(1/3:ℝ)^(d.val+1))≤1/2 := by
  rw [Fin.sum_univ_eq_sum_range (fun d : ℕ => (1/3:ℝ)^(d+1)) m]
  have hg := geom_sum_mul_neg (1/3:ℝ) m
  have hp := pow_nonneg (by norm_num : (0:ℝ)≤1/3) m
  have he : (∑ d∈Finset.range m,(1/3:ℝ)^(d+1))=
      (∑ d∈Finset.range m,(1/3:ℝ)^d)*(1/3) := by
    rw [Finset.sum_mul]
    exact Finset.sum_congr rfl (fun _ _ => pow_succ _ _)
  rw [he]
  linarith
theorem fixed_total_contribution_le (n : ℕ) (hn : 4≤n) (hq3 : (3:ℝ)≤Nat.card K) :
    (∑ d : Fin (n+1),fixedContribution (K:=K) n d)≤5/6 := by
  rw [Fin.sum_univ_succ]
  simp only [Fin.val_zero,Fin.val_succ,fixedContribution_zero,zero_add]
  have hb := Finset.sum_le_sum (s:=Finset.univ)
    (fun (d : Fin n) _ => fixedContribution_le (K:=K) n (d.val+1) hn (by omega) hq3)
  rw [Finset.sum_add_distrib] at hb
  have hg := geometric_layer_le n
  have hh := boundary_layer_le n n
  simpa only [Fin.val_succ] using (show (∑ d : Fin n,fixedContribution (K:=K) n (d.val+1))≤5/6 by linarith)
theorem fixed_constant_squarefree_density (hodd : ringChar K≠2) (n : ℕ) (hn : 4≤n)
    (c : K) (hc : c≠0) :
    (1/6:ℝ)≤(Nat.card {f : FixedConstant (K:=K) n c // Squarefree f.val.val}:ℝ)/
      (Nat.card K:ℝ)^(n-1) := by
  have hq3 : (3:ℝ)≤Nat.card K := by
    have ho := FiniteField.odd_card_of_char_ne_two hodd
    have hp := Fintype.one_lt_card (α:=K)
    have : 3≤Fintype.card K := by omega
    rw [Nat.card_eq_fintype_card]
    exact_mod_cast this
  have hq : (0:ℝ)<Nat.card K := by linarith
  have hcard : Nat.card (FixedConstant (K:=K) n c)=Nat.card K^(n-1) := by
    simpa only [Nat.sub_add_cancel (by omega : 1≤n)] using fixedConstant_card (K:=K) (n-1) c
  have hs := fixed_squarefree_degree_sieve n c hc
  rw [hcard] at hs
  have hsR : (Nat.card K:ℝ)^(n-1)≤
      (Nat.card {f : FixedConstant (K:=K) n c // Squarefree f.val.val}:ℝ)+
      ∑ d : Fin (n+1),(Nat.card (NonzeroIrreducibleDegree (K:=K) d)*fixedRepeatBound (K:=K) n d:ℕ) := by
    exact_mod_cast hs
  have hh := div_le_div_of_nonneg_right hsR (le_of_lt (pow_pos hq (n-1)))
  rw [div_self (ne_of_gt (pow_pos hq _)),add_div,Nat.cast_sum,Finset.sum_div] at hh
  have ht := fixed_total_contribution_le (K:=K) n hn hq3
  change (∑ d : Fin (n+1),
    (Nat.card (NonzeroIrreducibleDegree (K:=K) d)*fixedRepeatBound (K:=K) n d:ℕ)/
      (Nat.card K:ℝ)^(n-1))≤5/6 at ht
  linarith
end Mathproof.Problem18FixedConstantDensity20260930
end
