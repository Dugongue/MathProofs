section Linear
variable {L : Type*} [Field L] {n : Nat}
noncomputable def linSubst (M : Matrix (Fin n) (Fin n) L) :
    MvPolynomial (Fin n) L →ₐ[L] MvPolynomial (Fin n) L :=
  aeval fun i => ∑ j, C (M i j) * X j
theorem linSubst_X (M : Matrix (Fin n) (Fin n) L) (i : Fin n) :
    linSubst M (X i) = ∑ j, C (M i j) * X j := aeval_X _ _
theorem linSubst_C (M : Matrix (Fin n) (Fin n) L) (a : L) : linSubst M (C a) = C a :=
  aeval_C _ _
theorem linSubst_comp (M N : Matrix (Fin n) (Fin n) L) :
    (linSubst M).comp (linSubst N) = linSubst (N * M) := by
  apply MvPolynomial.algHom_ext
  intro i
  rw [AlgHom.comp_apply, linSubst_X, linSubst_X, map_sum]
  simp only [map_mul, linSubst_C, linSubst_X, Finset.mul_sum, Matrix.mul_apply, map_sum,
    Finset.sum_mul]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun j _ => ?_
  ring
theorem linSubst_one : linSubst (1 : Matrix (Fin n) (Fin n) L) = AlgHom.id L _ := by
  apply MvPolynomial.algHom_ext
  intro i
  rw [linSubst_X, AlgHom.id_apply]
  simp [Matrix.one_apply]
theorem linSubst_totalDegree_le (M : Matrix (Fin n) (Fin n) L) (p : MvPolynomial (Fin n) L) :
    (linSubst M p).totalDegree ≤ p.totalDegree := by
  apply totalDegree_aeval_le
  intro i
  refine (totalDegree_finsetSum _ _).trans (Finset.sup_le fun j _ => ?_)
  refine (totalDegree_mul _ _).trans ?_
  rw [totalDegree_C, zero_add]
  exact (totalDegree_X _).le
noncomputable def linEquiv (M : Matrix (Fin n) (Fin n) L) (hM : IsUnit M.det) :
    MvPolynomial (Fin n) L ≃ₐ[L] MvPolynomial (Fin n) L :=
  AlgEquiv.ofAlgHom (linSubst M) (linSubst M⁻¹)
    (by rw [linSubst_comp, Matrix.nonsing_inv_mul _ hM, linSubst_one])
    (by rw [linSubst_comp, Matrix.mul_nonsing_inv _ hM, linSubst_one])
theorem linEquiv_apply (M : Matrix (Fin n) (Fin n) L) (hM : IsUnit M.det)
    (p : MvPolynomial (Fin n) L) : linEquiv M hM p = linSubst M p := rfl
theorem linEquiv_symm_apply (M : Matrix (Fin n) (Fin n) L) (hM : IsUnit M.det)
    (p : MvPolynomial (Fin n) L) : (linEquiv M hM).symm p = linSubst M⁻¹ p := rfl
theorem linEquiv_totalDegree (M : Matrix (Fin n) (Fin n) L) (hM : IsUnit M.det)
    (p : MvPolynomial (Fin n) L) : (linEquiv M hM p).totalDegree = p.totalDegree := by
  apply le_antisymm (linSubst_totalDegree_le M p)
  have h := linSubst_totalDegree_le M⁻¹ (linEquiv M hM p)
  rwa [← linEquiv_symm_apply M hM, AlgEquiv.symm_apply_apply] at h
theorem eval_linSubst (M : Matrix (Fin n) (Fin n) L) (p : MvPolynomial (Fin n) L)
    (x : Fin n → L) : eval x (linSubst M p) = eval (M.mulVec x) p := by
  have h : (eval x).comp (linSubst M : MvPolynomial (Fin n) L →+* MvPolynomial (Fin n) L) =
      eval (M.mulVec x) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [linSubst_C]
    · intro i
      simp [linSubst_X, Matrix.mulVec, dotProduct]
  exact RingHom.congr_fun h p
end Linear
section Transcendence
variable {L : Type*} [Field L] {m r : ℕ}
theorem isAlgebraic_of_trdeg_le
    (P : Ideal (MvPolynomial (Fin m) (MvPolynomial (Fin r) L))) [P.IsPrime]
    (hbot : P.comap (C : MvPolynomial (Fin r) L →+* MvPolynomial (Fin m) (MvPolynomial (Fin r) L)) = ⊥)
    (htr : Algebra.trdeg L (MvPolynomial (Fin m) (MvPolynomial (Fin r) L) ⧸ P) ≤ r)
    (y : MvPolynomial (Fin m) (MvPolynomial (Fin r) L) ⧸ P) :
    IsAlgebraic (MvPolynomial (Fin r) L) y := by
  have hinj : Function.Injective (algebraMap (MvPolynomial (Fin r) L)
      (MvPolynomial (Fin m) (MvPolynomial (Fin r) L) ⧸ P)) := by
    rw [injective_iff_map_eq_zero]
    intro a ha
    have hmem : a ∈ P.comap (C : MvPolynomial (Fin r) L →+* _) := by
      rw [Ideal.mem_comap, ← Ideal.Quotient.eq_zero_iff_mem]
      exact ha
    rw [hbot, Ideal.mem_bot] at hmem
    exact hmem
  set v : Fin r → MvPolynomial (Fin m) (MvPolynomial (Fin r) L) ⧸ P :=
    fun i => algebraMap (MvPolynomial (Fin r) L) _ (X i) with hv
  have haeval : ∀ a : MvPolynomial (Fin r) L,
      aeval v a = algebraMap (MvPolynomial (Fin r) L)
        (MvPolynomial (Fin m) (MvPolynomial (Fin r) L) ⧸ P) a := by
    intro a
    have hext : (aeval v : MvPolynomial (Fin r) L →ₐ[L] _) =
        IsScalarTower.toAlgHom L (MvPolynomial (Fin r) L)
          (MvPolynomial (Fin m) (MvPolynomial (Fin r) L) ⧸ P) := by
      apply MvPolynomial.algHom_ext
      intro i
      rw [aeval_X, IsScalarTower.coe_toAlgHom']
    rw [hext, IsScalarTower.coe_toAlgHom']
  have hind : AlgebraicIndependent L v := by
    rw [algebraicIndependent_iff_injective_aeval]
    intro a b hab
    apply hinj
    rw [← haeval, ← haeval]
    exact hab
  have hbasis : IsTranscendenceBasis L v :=
    hind.isTranscendenceBasis_of_lift_trdeg_le_of_finite
      (by simpa using htr)
  have halgAll : Algebra.IsAlgebraic (MvPolynomial (Fin r) L)
      (MvPolynomial (Fin m) (MvPolynomial (Fin r) L) ⧸ P) :=
    (hbasis.isAlgebraic_iff (S := MvPolynomial (Fin r) L)).mpr fun i => isAlgebraic_algebraMap (X i)
  exact halgAll.isAlgebraic y
end Transcendence
section Coordinates
variable {L : Type*} [Field L] {n r : ℕ}
noncomputable def splitOf (κ : Fin r ↪ Fin n) : Fin n ≃ Fin (n - r) ⊕ Fin r := by
  classical
  have hcard : Fintype.card {a : Fin n // ¬ a ∈ Set.range κ} = n - r := by
    rw [Fintype.card_subtype_compl, Fintype.card_fin, Set.card_range_of_injective κ.injective,
      Fintype.card_fin]
  exact (Equiv.sumCompl (fun a : Fin n => a ∈ Set.range κ)).symm.trans
    ((Equiv.sumComm _ _).trans (Equiv.sumCongr (Fintype.equivFinOfCardEq hcard)
      (Equiv.ofInjective κ κ.injective).symm))
theorem splitOf_apply (κ : Fin r ↪ Fin n) (i : Fin r) : splitOf κ (κ i) = Sum.inr i := by
  classical
  unfold splitOf
  simp only [Equiv.trans_apply]
  rw [Equiv.sumCompl_symm_apply_of_pos (Set.mem_range_self i)]
  simp only [Equiv.sumComm_apply, Sum.swap_inl, Equiv.sumCongr_apply, Sum.map_inr]
  congr 1
  exact (Equiv.ofInjective_symm_apply κ.injective i)
noncomputable def coordSplit (κ : Fin r ↪ Fin n) :
    MvPolynomial (Fin n) L ≃ₐ[L] MvPolynomial (Fin (n - r)) (MvPolynomial (Fin r) L) :=
  (MvPolynomial.renameEquiv L (splitOf κ)).trans (MvPolynomial.sumAlgEquiv L (Fin (n - r)) (Fin r))
theorem coordSplit_X_kappa (κ : Fin r ↪ Fin n) (i : Fin r) :
    coordSplit (L := L) κ (X (κ i)) = C (X i) := by
  simp [coordSplit, splitOf_apply]
theorem coordSplit_symm_comp_C (κ : Fin r ↪ Fin n) :
    ((coordSplit (L := L) κ).symm : MvPolynomial (Fin (n - r)) (MvPolynomial (Fin r) L) →+*
        MvPolynomial (Fin n) L).comp C = (rename κ : MvPolynomial (Fin r) L →ₐ[L] _).toRingHom := by
  apply MvPolynomial.ringHom_ext
  · intro a
    show (coordSplit (L := L) κ).symm (C (C a)) = rename κ (C a)
    rw [AlgEquiv.symm_apply_eq, rename_C]
    simp [coordSplit]
  · intro i
    show (coordSplit (L := L) κ).symm (C (X i)) = rename κ (X i)
    rw [AlgEquiv.symm_apply_eq, rename_X, coordSplit_X_kappa]
theorem coordSplit_totalDegree_le (κ : Fin r ↪ Fin n) (p : MvPolynomial (Fin n) L) :
    (coordSplit (L := L) κ p).totalDegree ≤ p.totalDegree := by
  have hφ : (coordSplit (L := L) κ).toAlgHom = aeval fun i => coordSplit (L := L) κ (X i) :=
    MvPolynomial.aeval_unique _
  have hp : coordSplit (L := L) κ p = aeval (fun i => coordSplit (L := L) κ (X i)) p := by
    rw [← hφ]
    rfl
  rw [hp]
  apply totalDegree_aeval_le
  intro i
  simp only [coordSplit, AlgEquiv.trans_apply, renameEquiv_apply, rename_X]
  rcases (splitOf κ i) with j | k
  · rw [sumAlgEquiv_X_inl]
    exact (totalDegree_X _).le
  · rw [sumAlgEquiv_X_inr, totalDegree_C]
    exact Nat.zero_le _
end Coordinates
section Transport
variable {L : Type*} [Field L] {n r : ℕ}
def DimLE (G : Finset (MvPolynomial (Fin n) L)) (h : MvPolynomial (Fin n) L) (r : ℕ) : Prop :=
  ∀ P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes, h ∉ P →
    Algebra.trdeg L (MvPolynomial (Fin n) L ⧸ P) ≤ r
noncomputable abbrev csplit (κ : Fin r ↪ Fin n) :
    MvPolynomial (Fin n) L ≃+* MvPolynomial (Fin (n - r)) (MvPolynomial (Fin r) L) :=
  (coordSplit (L := L) κ).toRingEquiv
theorem mk_rename_eq_aeval (κ : Fin r ↪ Fin n) (P : Ideal (MvPolynomial (Fin n) L))
    (a : MvPolynomial (Fin r) L) :
    Ideal.Quotient.mk P (rename κ a) =
      aeval (fun i => Ideal.Quotient.mk P (X (κ i) : MvPolynomial (Fin n) L)) a := by
  have hext : (Ideal.Quotient.mkₐ L P).comp (rename κ) =
      aeval (fun i => Ideal.Quotient.mk P (X (κ i) : MvPolynomial (Fin n) L)) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp
  exact AlgHom.congr_fun hext a
theorem csplit_symm_C (κ : Fin r ↪ Fin n) (a : MvPolynomial (Fin r) L) :
    (csplit (L := L) κ).symm (C a) = rename κ a :=
  RingHom.congr_fun (coordSplit_symm_comp_C (L := L) κ) a
theorem coordSplit_transport (κ : Fin r ↪ Fin n)
    (G : Finset (MvPolynomial (Fin n) L)) (h : MvPolynomial (Fin n) L) (hdim : DimLE G h r)
    (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes) (hhP : h ∉ P)
    (hind : AlgebraicIndependent L
      (fun i => Ideal.Quotient.mk P (X (κ i) : MvPolynomial (Fin n) L))) :
    P.comap (csplit (L := L) κ).symm ∈
        (Ideal.span ((csplit (L := L) κ) '' (G : Set (MvPolynomial (Fin n) L)))).minimalPrimes ∧
      csplit (L := L) κ h ∉ P.comap (csplit (L := L) κ).symm ∧
      (P.comap (csplit (L := L) κ).symm).comap
        (C : MvPolynomial (Fin r) L →+* MvPolynomial (Fin (n - r)) (MvPolynomial (Fin r) L)) = ⊥ ∧
      Algebra.trdeg L (MvPolynomial (Fin (n - r)) (MvPolynomial (Fin r) L) ⧸
        P.comap (csplit (L := L) κ).symm) ≤ r := by
  have hspan : (Ideal.span (G : Set (MvPolynomial (Fin n) L))).comap (csplit (L := L) κ).symm =
      Ideal.span ((csplit (L := L) κ) '' (G : Set (MvPolynomial (Fin n) L))) := by
    rw [Ideal.comap_symm, Ideal.map_span]
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [← hspan]
    exact Ideal.minimalPrimes_comap_of_surjective (f := (csplit (L := L) κ).symm.toRingHom)
      (csplit (L := L) κ).symm.surjective hP
  · intro hmem
    rw [Ideal.mem_comap, RingEquiv.symm_apply_apply] at hmem
    exact hhP hmem
  · rw [eq_bot_iff]
    intro a ha
    rw [Ideal.mem_comap, Ideal.mem_comap, csplit_symm_C, ← Ideal.Quotient.eq_zero_iff_mem,
      mk_rename_eq_aeval] at ha
    rw [Ideal.mem_bot]
    apply hind
    rw [ha, map_zero]
  · have hmapeq : P.comap (csplit (L := L) κ).symm = P.map (csplit (L := L) κ) :=
      Ideal.comap_symm _
    have hiso := Ideal.quotientEquivAlg P (P.comap (csplit (L := L) κ).symm)
      (coordSplit (L := L) κ) hmapeq
    rw [← hiso.trdeg_eq]
    exact hdim P hP hhP
end Transport
section CoordinateCorollaries
variable {L : Type*} [Field L] {n r : ℕ}
theorem coordSplit_away (κ : Fin r ↪ Fin n)
    [DecidableEq (MvPolynomial (Fin (n - r)) (MvPolynomial (Fin r) L))]
    (G : Finset (MvPolynomial (Fin n) L)) (h : MvPolynomial (Fin n) L) (d e : ℕ)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hh : h.totalDegree ≤ e) (hdim : DimLE G h r) :
    (∀ g ∈ G.image (csplit (L := L) κ), g.totalDegree ≤ d) ∧
      (csplit (L := L) κ h).totalDegree ≤ e ∧
      AwayAlgebraic (G.image (csplit (L := L) κ)) (csplit (L := L) κ h) := by
  have hdegψ : ∀ p : MvPolynomial (Fin n) L, (csplit (L := L) κ p).totalDegree ≤ p.totalDegree :=
    fun p => coordSplit_totalDegree_le κ p
  refine ⟨?_, (hdegψ h).trans hh, ?_⟩
  · intro g hg
    rw [Finset.mem_image] at hg
    obtain ⟨g0, hg0, rfl⟩ := hg
    exact (hdegψ g0).trans (hG g0 hg0)
  · intro Q hQ hhQ hbotQ
    haveI : Q.IsPrime := hQ.1.1
    have hspan : (Ideal.span ((G.image (csplit (L := L) κ) : Finset _) :
        Set (MvPolynomial (Fin (n - r)) (MvPolynomial (Fin r) L)))).comap (csplit (L := L) κ) =
        Ideal.span (G : Set (MvPolynomial (Fin n) L)) := by
      rw [Finset.coe_image, ← Ideal.map_span,
        Ideal.comap_map_of_bijective _ (csplit (L := L) κ).bijective]
    have hQ0 : Q.comap (csplit (L := L) κ) ∈
        (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes := by
      rw [← hspan]
      exact Ideal.minimalPrimes_comap_of_surjective (f := (csplit (L := L) κ).toRingHom)
        (csplit (L := L) κ).surjective hQ
    have hhQ0 : h ∉ Q.comap (csplit (L := L) κ) := fun hm => hhQ hm
    have htr0 := hdim _ hQ0 hhQ0
    have hmapeq : Q = (Q.comap (csplit (L := L) κ)).map (csplit (L := L) κ) :=
      (Ideal.map_comap_of_surjective _ (csplit (L := L) κ).surjective Q).symm
    have hiso := Ideal.quotientEquivAlg (Q.comap (csplit (L := L) κ)) Q (coordSplit (L := L) κ)
      hmapeq
    have htr : Algebra.trdeg L (MvPolynomial (Fin (n - r)) (MvPolynomial (Fin r) L) ⧸ Q) ≤ r := by
      rw [← hiso.trdeg_eq]
      exact htr0
    intro i
    exact isAlgebraic_of_trdeg_le Q hbotQ htr _
theorem exists_coordinate_relation
    (G : Finset (MvPolynomial (Fin n) L)) (h : MvPolynomial (Fin n) L) (d e : ℕ)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hh : h.totalDegree ≤ e) (hdim : DimLE G h r)
    (κ : Fin r ↪ Fin n) (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes) (hhP : h ∉ P)
    (hind : AlgebraicIndependent L
      (fun i => Ideal.Quotient.mk P (X (κ i) : MvPolynomial (Fin n) L)))
    (f : MvPolynomial (Fin n) L) :
    ∃ q : Polynomial (MvPolynomial (Fin r) L), q ≠ 0 ∧
      q.natDegree ≤ fiberBound (n - r + 1) (max d (e+1)) ∧
      Polynomial.eval₂ (rename κ : MvPolynomial (Fin r) L →ₐ[L] MvPolynomial (Fin n) L).toRingHom
        f q ∈ P := by
  classical
  obtain ⟨hP', hhP', hbot', htr'⟩ := coordSplit_transport κ G h hdim P hP hhP hind
  obtain ⟨hdeg, hh', halg⟩ := coordSplit_away κ G h d e hG hh hdim
  haveI : (P.comap (csplit (L := L) κ).symm).IsPrime := hP'.1.1
  have hy := isAlgebraic_of_trdeg_le (P.comap (csplit (L := L) κ).symm) hbot' htr'
    (Ideal.Quotient.mk _ (csplit (L := L) κ f))
  obtain ⟨q, hq0, hqdeg, hq⟩ := exists_relation_natDegree_le (G.image (csplit (L := L) κ))
    (csplit (L := L) κ h) d e hdeg hh' halg (P.comap (csplit (L := L) κ).symm)
    ⟨by rw [Finset.coe_image]; exact hP', hhP', hbot'⟩ _ hy
  refine ⟨q, hq0, hqdeg, ?_⟩
  have hmem : Polynomial.eval₂ C (csplit (L := L) κ f) q ∈ P.comap (csplit (L := L) κ).symm := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, Polynomial.hom_eval₂]
    rw [Polynomial.aeval_def] at hq
    exact hq
  rw [Ideal.mem_comap] at hmem
  have h1 := Polynomial.hom_eval₂ (p := q) (f := C) (g := (csplit (L := L) κ).symm.toRingHom)
    (csplit (L := L) κ f)
  have hc : (csplit (L := L) κ).symm.toRingHom.comp C =
      (rename κ : MvPolynomial (Fin r) L →ₐ[L] MvPolynomial (Fin n) L).toRingHom :=
    coordSplit_symm_comp_C (L := L) κ
  have hf : (csplit (L := L) κ).symm.toRingHom (csplit (L := L) κ f) = f :=
    (csplit (L := L) κ).symm_apply_apply f
  rw [hc, hf] at h1
  rw [← h1]
  exact hmem
theorem card_coordinate_components_le
    (G : Finset (MvPolynomial (Fin n) L)) (h : MvPolynomial (Fin n) L) (d e : ℕ)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hh : h.totalDegree ≤ e) (hdim : DimLE G h r)
    (κ : Fin r ↪ Fin n) (S : Finset (Ideal (MvPolynomial (Fin n) L)))
    (hS : ∀ P ∈ S, P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes ∧ h ∉ P ∧
      AlgebraicIndependent L (fun i => Ideal.Quotient.mk P (X (κ i) : MvPolynomial (Fin n) L))) :
    S.card ≤ fiberBound (n - r + 1) (max d (e+1)) := by
  classical
  obtain ⟨hdeg, hh', halg⟩ := coordSplit_away κ G h d e hG hh hdim
  have hinj : Set.InjOn (fun P : Ideal (MvPolynomial (Fin n) L) =>
      P.comap (csplit (L := L) κ).symm) (S : Set (Ideal (MvPolynomial (Fin n) L))) := by
    intro P _ P' _ heq
    exact Ideal.comap_injective_of_surjective _ (csplit (L := L) κ).symm.surjective heq
  rw [← Finset.card_image_of_injOn hinj]
  apply card_components_le (G.image (csplit (L := L) κ)) (csplit (L := L) κ h) d e hdeg hh' halg
  intro Q hQ
  rw [Finset.mem_image] at hQ
  obtain ⟨P, hP, rfl⟩ := hQ
  obtain ⟨hPmin, hhP, hind⟩ := hS P hP
  obtain ⟨hP', hhP', hbot', _⟩ := coordSplit_transport κ G h hdim P hPmin hhP hind
  exact ⟨by rw [Finset.coe_image]; exact hP', hhP', hbot'⟩
end CoordinateCorollaries
section Relations
variable {L : Type*} [Field L] {n r : ℕ}
theorem rename_eq_evalTwo_finSuccEquiv (ν : Fin (r+1) → Fin n) (f : MvPolynomial (Fin (r+1)) L) :
    rename ν f = Polynomial.eval₂
      (rename (ν ∘ Fin.succ) : MvPolynomial (Fin r) L →ₐ[L] MvPolynomial (Fin n) L).toRingHom
      (X (ν 0)) (finSuccEquiv L r f) := by
  have h : (rename ν : MvPolynomial (Fin (r+1)) L →ₐ[L] MvPolynomial (Fin n) L).toRingHom =
      (Polynomial.eval₂RingHom
        (rename (ν ∘ Fin.succ) : MvPolynomial (Fin r) L →ₐ[L] MvPolynomial (Fin n) L).toRingHom
        (X (ν 0))).comp (finSuccEquiv L r : MvPolynomial (Fin (r+1)) L →+* _) := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [finSuccEquiv_apply]
    · intro i
      induction i using Fin.cases with
      | zero => simp [finSuccEquiv_X_zero]
      | succ k => simp [finSuccEquiv_X_succ]
  exact RingHom.congr_fun h f
theorem exists_T_relation
    (G : Finset (MvPolynomial (Fin n) L)) (h : MvPolynomial (Fin n) L) (d e : ℕ)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hh : h.totalDegree ≤ e) (hdim : DimLE G h r)
    (ν : Fin (r+1) ↪ Fin n) (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes) (hhP : h ∉ P)
    (hind : AlgebraicIndependent L
      (fun i : Fin r => Ideal.Quotient.mk P (X (ν i.succ) : MvPolynomial (Fin n) L))) :
    ∃ g : MvPolynomial (Fin (r+1)) L, g ≠ 0 ∧
      degreeOf 0 g ≤ fiberBound (n - r + 1) (max d (e+1)) ∧ rename ν g ∈ P := by
  let κ : Fin r ↪ Fin n := ⟨fun i => ν i.succ, ν.injective.comp (Fin.succ_injective _)⟩
  obtain ⟨q, hq0, hqdeg, hqmem⟩ :=
    exists_coordinate_relation G h d e hG hh hdim κ P hP hhP hind (X (ν 0))
  refine ⟨(finSuccEquiv L r).symm q, ?_, ?_, ?_⟩
  · exact (map_ne_zero_iff _ (finSuccEquiv L r).symm.injective).mpr hq0
  · rw [← natDegree_finSuccEquiv, AlgEquiv.apply_symm_apply]
    exact hqdeg
  · rw [rename_eq_evalTwo_finSuccEquiv, AlgEquiv.apply_symm_apply]
    exact hqmem
theorem totalDegree_le_sum_degreeOf {σ R : Type*} [Fintype σ] [CommSemiring R]
    (f : MvPolynomial σ R) : f.totalDegree ≤ ∑ i, degreeOf i f := by
  classical
  unfold MvPolynomial.totalDegree
  refine Finset.sup_le fun s hs => ?_
  calc (s.sum fun _ e => e) = ∑ i, s i := by
        rw [Finsupp.sum_fintype]
        intro i
        rfl
    _ ≤ ∑ i, degreeOf i f := Finset.sum_le_sum fun i _ => monomial_le_degreeOf i hs
theorem degreeOf_rename_eq_zero {σ τ R : Type*} [CommSemiring R] (k : σ → τ) (j : τ)
    (hj : j ∉ Set.range k) (f : MvPolynomial σ R) : degreeOf j (rename k f) = 0 := by
  classical
  rw [degreeOf_def, Multiset.count_eq_zero]
  intro hmem
  have hmap := degrees_rename k f hmem
  rw [Multiset.mem_map] at hmap
  obtain ⟨a, _, rfl⟩ := hmap
  exact hj ⟨a, rfl⟩
end Relations
section GoodSeparation
variable {L : Type*} [Field L] {n r : ℕ}
theorem mk_rename_eq_aeval' {s : ℕ} (κ : Fin s → Fin n) (P : Ideal (MvPolynomial (Fin n) L))
    (a : MvPolynomial (Fin s) L) :
    Ideal.Quotient.mk P (rename κ a) =
      aeval (fun i => Ideal.Quotient.mk P (X (κ i) : MvPolynomial (Fin n) L)) a := by
  have hext : (Ideal.Quotient.mkₐ L P).comp (rename κ) =
      aeval (fun i => Ideal.Quotient.mk P (X (κ i) : MvPolynomial (Fin n) L)) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp
  exact AlgHom.congr_fun hext a
theorem exists_index_relation
    (G : Finset (MvPolynomial (Fin n) L)) (h : MvPolynomial (Fin n) L) (d e : ℕ)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hh : h.totalDegree ≤ e) (hdim : DimLE G h r)
    (ν : Fin (r+1) ↪ Fin n) (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes) (hhP : h ∉ P)
    (i : Fin (r+1)) :
    ∃ g : MvPolynomial (Fin (r+1)) L, g ≠ 0 ∧
      degreeOf i g ≤ fiberBound (n - r + 1) (max d (e+1)) ∧ rename ν g ∈ P := by
  classical
  let σ : Equiv.Perm (Fin (r+1)) := Equiv.swap 0 i
  let νi : Fin (r+1) ↪ Fin n := ⟨fun k => ν (σ k), ν.injective.comp σ.injective⟩
  by_cases hind : AlgebraicIndependent L
      (fun k : Fin r => Ideal.Quotient.mk P (X (νi k.succ) : MvPolynomial (Fin n) L))
  · obtain ⟨g, hg0, hgdeg, hgmem⟩ := exists_T_relation G h d e hG hh hdim νi P hP hhP hind
    refine ⟨rename σ g, (map_ne_zero_iff _ (rename_injective _ σ.injective)).mpr hg0, ?_, ?_⟩
    · have hσ : degreeOf (σ 0) (rename σ g) = degreeOf 0 g :=
        degreeOf_rename_of_injective σ.injective 0
      have h0 : σ 0 = i := Equiv.swap_apply_left 0 i
      rw [h0] at hσ
      rw [hσ]
      exact hgdeg
    · rw [rename_rename]
      exact hgmem
  · rw [algebraicIndependent_iff_injective_aeval, injective_iff_map_eq_zero] at hind
    push Not at hind
    obtain ⟨a, ha, ha0⟩ := hind
    have hinj : Function.Injective (fun k : Fin r => σ k.succ) :=
      σ.injective.comp (Fin.succ_injective _)
    refine ⟨rename (fun k : Fin r => σ k.succ) a,
      (map_ne_zero_iff _ (rename_injective _ hinj)).mpr ha0, ?_, ?_⟩
    · rw [degreeOf_rename_eq_zero]
      · exact Nat.zero_le _
      · rintro ⟨k, hk⟩
        have hk' : k.succ = σ i := by
          rw [← hk]
          exact (Equiv.swap_apply_self 0 i k.succ).symm
        rw [Equiv.swap_apply_right] at hk'
        exact Fin.succ_ne_zero k hk'
    · rw [rename_rename, ← Ideal.Quotient.eq_zero_iff_mem, mk_rename_eq_aeval']
      exact ha
theorem exists_point_of_ne_top [IsAlgClosed L] (J : Ideal (MvPolynomial (Fin n) L)) (hJ : J ≠ ⊤) :
    ∃ y : Fin n → L, ∀ f ∈ J, eval y f = 0 := by
  obtain ⟨M, hM, hJM⟩ := Ideal.exists_le_maximal J hJ
  rw [MvPolynomial.isMaximal_iff_eq_vanishingIdeal_singleton] at hM
  obtain ⟨y, hy⟩ := hM
  refine ⟨y, fun f hf => ?_⟩
  have hfM := hJM hf
  rw [hy, MvPolynomial.mem_vanishingIdeal_singleton_iff] at hfM
  simpa using hfM
set_option backward.isDefEq.respectTransparency false in
theorem exists_separator_good [IsAlgClosed L]
    (G : Finset (MvPolynomial (Fin n) L)) (h : MvPolynomial (Fin n) L) (d e : ℕ)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hh : h.totalDegree ≤ e) (hdim : DimLE G h r)
    (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes) (hhP : h ∉ P)
    (ν : Fin (r+1) ↪ Fin n)
    (hind : AlgebraicIndependent L
      (fun k : Fin r => Ideal.Quotient.mk P (X (ν k.succ) : MvPolynomial (Fin n) L)))
    (hint : ∀ j : Fin n, ∃ q : Polynomial (MvPolynomial (Fin r) L), q.Monic ∧
      Polynomial.eval₂ (rename (fun k : Fin r => ν k.succ) :
        MvPolynomial (Fin r) L →ₐ[L] MvPolynomial (Fin n) L).toRingHom (X j) q ∈ P)
    (p : Fin n → L)
    (hsep : ∀ y : Fin n → L, (∀ f ∈ P, eval y f = 0) →
      (∀ k : Fin r, y (ν k.succ) = p (ν k.succ)) → y (ν 0) ≠ p (ν 0)) :
    ∃ s ∈ P, s.totalDegree ≤ (r + 1) * fiberBound (n - r + 1) (max d (e+1)) ∧ eval p s ≠ 0 := by
  classical
  haveI hPprime : P.IsPrime := hP.1.1
  set κ : Fin r → Fin n := fun k => ν k.succ with hκ
  letI : Algebra (MvPolynomial (Fin r) L) (MvPolynomial (Fin n) L ⧸ P) :=
    ((Ideal.Quotient.mk P).comp
      (rename κ : MvPolynomial (Fin r) L →ₐ[L] MvPolynomial (Fin n) L).toRingHom).toAlgebra
  have halgMap : ∀ a, algebraMap (MvPolynomial (Fin r) L) (MvPolynomial (Fin n) L ⧸ P) a =
      Ideal.Quotient.mk P (rename κ a) := fun a => rfl
  have hinjA : Function.Injective
      (algebraMap (MvPolynomial (Fin r) L) (MvPolynomial (Fin n) L ⧸ P)) := by
    intro a b hab
    rw [halgMap, halgMap, mk_rename_eq_aeval', mk_rename_eq_aeval'] at hab
    exact (algebraicIndependent_iff_injective_aeval.mp hind) hab
  haveI : Module.IsTorsionFree (MvPolynomial (Fin r) L) (MvPolynomial (Fin n) L ⧸ P) :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr hinjA
  haveI : IsIntegrallyClosed (MvPolynomial (Fin r) L) :=
    UniqueFactorizationMonoid.instIsIntegrallyClosed
  have hXint : ∀ j, IsIntegral (MvPolynomial (Fin r) L)
      (Ideal.Quotient.mk P (X j : MvPolynomial (Fin n) L)) := by
    intro j
    obtain ⟨q, hqm, hq⟩ := hint j
    refine ⟨q, hqm, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, Polynomial.hom_eval₂] at hq
    exact hq
  have hallint : ∀ f : MvPolynomial (Fin n) L,
      IsIntegral (MvPolynomial (Fin r) L) (Ideal.Quotient.mk P f) := by
    intro f
    induction f using MvPolynomial.induction_on with
    | C a =>
      have hC : Ideal.Quotient.mk P (C a : MvPolynomial (Fin n) L) =
          algebraMap (MvPolynomial (Fin r) L) _ (C a) := by
        rw [halgMap, rename_C]
      rw [hC]
      exact isIntegral_algebraMap
    | add p q hp hq =>
      rw [map_add]
      exact hp.add hq
    | mul_X p j hp =>
      rw [map_mul]
      exact hp.mul (hXint j)
  set w := Ideal.Quotient.mk P (X (ν 0) : MvPolynomial (Fin n) L) with hw
  have hwint : IsIntegral (MvPolynomial (Fin r) L) w := hallint _
  set μ := minpoly (MvPolynomial (Fin r) L) w with hμ
  have hev : ∀ g : MvPolynomial (Fin (r+1)) L,
      Ideal.Quotient.mk P (rename ν g) = Polynomial.aeval w (finSuccEquiv L r g) := by
    intro g
    rw [rename_eq_evalTwo_finSuccEquiv, Polynomial.hom_eval₂, Polynomial.aeval_def]
    rfl
  have hdvd : ∀ g : MvPolynomial (Fin (r+1)) L, rename ν g ∈ P →
      (finSuccEquiv L r).symm μ ∣ g := by
    intro g hg
    have h0 : Polynomial.aeval w (finSuccEquiv L r g) = 0 := by
      rw [← hev, Ideal.Quotient.eq_zero_iff_mem]
      exact hg
    obtain ⟨c, hc⟩ := minpoly.isIntegrallyClosed_dvd hwint h0
    refine ⟨(finSuccEquiv L r).symm c, ?_⟩
    apply (finSuccEquiv L r).injective
    rw [map_mul, AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply, hc]
  have hμ0 : μ ≠ 0 := minpoly.ne_zero hwint
  set s' := (finSuccEquiv L r).symm μ with hs'
  have hs'0 : s' ≠ 0 := (map_ne_zero_iff _ (finSuccEquiv L r).symm.injective).mpr hμ0
  have hdeg_i : ∀ i, degreeOf i s' ≤ fiberBound (n - r + 1) (max d (e+1)) := by
    intro i
    obtain ⟨g, hg0, hgdeg, hgmem⟩ := exists_index_relation G h d e hG hh hdim ν P hP hhP i
    obtain ⟨c, hc⟩ := hdvd g hgmem
    have hc0 : c ≠ 0 := by
      rintro rfl
      rw [mul_zero] at hc
      exact hg0 hc
    calc degreeOf i s' ≤ degreeOf i s' + degreeOf i c := Nat.le_add_right _ _
      _ = degreeOf i g := by rw [hc, degreeOf_mul_eq hs'0 hc0]
      _ ≤ _ := hgdeg
  have htot : s'.totalDegree ≤ (r + 1) * fiberBound (n - r + 1) (max d (e+1)) := by
    refine (totalDegree_le_sum_degreeOf s').trans ?_
    calc ∑ i, degreeOf i s' ≤ ∑ _i : Fin (r+1), fiberBound (n - r + 1) (max d (e+1)) :=
          Finset.sum_le_sum fun i _ => hdeg_i i
      _ = (r + 1) * fiberBound (n - r + 1) (max d (e+1)) := by simp
  have hsmem : rename ν s' ∈ P := by
    rw [← Ideal.Quotient.eq_zero_iff_mem, hev, hs', AlgEquiv.apply_symm_apply]
    exact minpoly.aeval _ _
  refine ⟨rename ν s', hsmem, (totalDegree_rename_le _ _).trans htot, ?_⟩
  intro hzero
  rw [eval_rename] at hzero
  letI alg2 : Algebra (MvPolynomial (Fin (r+1)) L) (MvPolynomial (Fin n) L ⧸ P) :=
    ((Ideal.Quotient.mk P).comp
      (rename ν : MvPolynomial (Fin (r+1)) L →ₐ[L] MvPolynomial (Fin n) L).toRingHom).toAlgebra
  have halg2 : ∀ g, algebraMap (MvPolynomial (Fin (r+1)) L) (MvPolynomial (Fin n) L ⧸ P) g =
      Ideal.Quotient.mk P (rename ν g) := fun g => rfl
  haveI : Algebra.IsIntegral (MvPolynomial (Fin (r+1)) L) (MvPolynomial (Fin n) L ⧸ P) := by
    constructor
    intro x
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨q, hqm, hq⟩ := hallint f
    refine ⟨q.map (rename Fin.succ : MvPolynomial (Fin r) L →ₐ[L] _).toRingHom,
      hqm.map _, ?_⟩
    rw [Polynomial.eval₂_map]
    have hcomp : (algebraMap (MvPolynomial (Fin (r+1)) L) (MvPolynomial (Fin n) L ⧸ P)).comp
        (rename Fin.succ : MvPolynomial (Fin r) L →ₐ[L] _).toRingHom =
        @algebraMap (MvPolynomial (Fin r) L) (MvPolynomial (Fin n) L ⧸ P) _ _
          (((Ideal.Quotient.mk P).comp
            (rename κ : MvPolynomial (Fin r) L →ₐ[L] MvPolynomial (Fin n) L).toRingHom).toAlgebra) := by
      ext a
      · simp [halg2, RingHom.algebraMap_toAlgebra]
      · simp [halg2, RingHom.algebraMap_toAlgebra, hκ]
    rw [hcomp]
    exact hq
  set a : Fin (r+1) → L := fun k => p (ν k) with ha
  have hIP : (⊥ : Ideal (MvPolynomial (Fin n) L ⧸ P)).comap
      (algebraMap (MvPolynomial (Fin (r+1)) L) (MvPolynomial (Fin n) L ⧸ P)) ≤
      RingHom.ker (eval a) := by
    intro g hg
    rw [Ideal.mem_comap, Ideal.mem_bot, halg2, Ideal.Quotient.eq_zero_iff_mem] at hg
    obtain ⟨c, hc⟩ := hdvd g hg
    rw [RingHom.mem_ker, hc, map_mul]
    have hs'a : eval a s' = 0 := hzero
    rw [hs'a, zero_mul]
  haveI : (RingHom.ker (eval a : MvPolynomial (Fin (r+1)) L →+* L)).IsPrime := RingHom.ker_isPrime _
  obtain ⟨Q, -, hQprime, hQ⟩ :=
    Ideal.exists_ideal_over_prime_of_isIntegral (RingHom.ker (eval a)) ⊥ hIP
  have hJ : Q.comap (Ideal.Quotient.mk P) ≠ ⊤ := by
    intro htop
    apply hQprime.ne_top
    rw [eq_top_iff]
    intro x _
    obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
    have hf : f ∈ Q.comap (Ideal.Quotient.mk P) := by rw [htop]; trivial
    exact hf
  obtain ⟨y, hy⟩ := exists_point_of_ne_top (Q.comap (Ideal.Quotient.mk P)) hJ
  have hyP : ∀ f ∈ P, eval y f = 0 := by
    intro f hf
    apply hy
    rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hf]
    exact Q.zero_mem
  have hycoord : ∀ k : Fin (r+1), y (ν k) = a k := by
    intro k
    have hmem : (X k - C (a k) : MvPolynomial (Fin (r+1)) L) ∈ RingHom.ker (eval a) := by
      rw [RingHom.mem_ker]
      simp
    rw [← hQ, Ideal.mem_comap, halg2] at hmem
    have hyk := hy _ hmem
    rw [map_sub, rename_X, rename_C] at hyk
    simp only [map_sub, eval_X, eval_C] at hyk
    exact sub_eq_zero.mp hyk
  exact hsep y hyP (fun k => by rw [hycoord k.succ]) (by rw [hycoord 0])
end GoodSeparation
section Shear
variable {L : Type*} [Field L] {k : ℕ}
theorem prod_pow_linear {R ι : Type*} [CommRing R] (t : Finset ι) (p : ι → Polynomial R)
    (e : ι → ℕ) (hp : ∀ j, (p j).natDegree ≤ 1) :
    (∏ j ∈ t, p j ^ e j).natDegree ≤ ∑ j ∈ t, e j ∧
      (∏ j ∈ t, p j ^ e j).coeff (∑ j ∈ t, e j) = ∏ j ∈ t, (p j).coeff 1 ^ e j := by
  classical
  induction t using Finset.induction_on with
  | empty => simp
  | insert a t ha ih =>
    rw [Finset.prod_insert ha, Finset.sum_insert ha, Finset.prod_insert ha]
    have hpow : (p a ^ e a).natDegree ≤ e a :=
      Polynomial.natDegree_pow_le.trans (by simpa using Nat.mul_le_mul_left (e a) (hp a))
    constructor
    · exact Polynomial.natDegree_mul_le.trans (Nat.add_le_add hpow ih.1)
    · rw [Polynomial.coeff_mul_add_eq_of_natDegree_le hpow ih.1, ih.2]
      congr 1
      have hc := Polynomial.coeff_pow_of_natDegree_le (p := p a) (m := e a) (hp a)
      simpa using hc
noncomputable def shearPoly (v : Fin (k+1) → L) :
    MvPolynomial (Fin (k+1)) L →ₐ[L] Polynomial (MvPolynomial (Fin k) L) :=
  aeval fun j => Fin.cases (motive := fun _ => Polynomial (MvPolynomial (Fin k) L))
    (Polynomial.C (C (v 0)) * Polynomial.X)
    (fun i => Polynomial.C (X i) + Polynomial.C (C (v i.succ)) * Polynomial.X) j
theorem shearPoly_X_zero (v : Fin (k+1) → L) :
    shearPoly v (X 0) = Polynomial.C (C (v 0)) * Polynomial.X := by
  simp [shearPoly]
theorem shearPoly_X_succ (v : Fin (k+1) → L) (i : Fin k) :
    shearPoly v (X i.succ) = Polynomial.C (X i) + Polynomial.C (C (v i.succ)) * Polynomial.X := by
  simp [shearPoly]
theorem shearPoly_X_natDegree (v : Fin (k+1) → L) (j : Fin (k+1)) :
    (shearPoly v (X j)).natDegree ≤ 1 := by
  induction j using Fin.cases with
  | zero =>
    rw [shearPoly_X_zero]
    exact (Polynomial.natDegree_C_mul_le _ _).trans Polynomial.natDegree_X_le
  | succ i =>
    rw [shearPoly_X_succ]
    exact (Polynomial.natDegree_add_le _ _).trans
      (max_le (by simp) ((Polynomial.natDegree_C_mul_le _ _).trans Polynomial.natDegree_X_le))
theorem shearPoly_X_coeff (v : Fin (k+1) → L) (j : Fin (k+1)) :
    (shearPoly v (X j)).coeff 1 = C (v j) := by
  induction j using Fin.cases with
  | zero =>
    simp [shearPoly_X_zero]
  | succ i =>
    simp [shearPoly_X_succ]
theorem shearPoly_C (v : Fin (k+1) → L) (a : L) :
    shearPoly v (C a) = Polynomial.C (C a) := by
  rw [shearPoly, aeval_C]
  rfl
theorem shearPoly_monomial (v : Fin (k+1) → L) (s : Fin (k+1) →₀ ℕ) (a : L) :
    (shearPoly v (monomial s a)).natDegree ≤ s.degree ∧
      (shearPoly v (monomial s a)).coeff s.degree =
        C (a * s.prod fun j e => v j ^ e) := by
  classical
  have hdeg : s.degree = ∑ j ∈ s.support, s j := rfl
  have hlin := prod_pow_linear s.support (fun j => shearPoly v (X j)) (fun j => s j)
    (fun j => shearPoly_X_natDegree v j)
  have hmon : shearPoly v (monomial s a) =
      Polynomial.C (C a) * ∏ j ∈ s.support, shearPoly v (X j) ^ s j := by
    rw [monomial_eq, map_mul, shearPoly_C, Finsupp.prod, map_prod]
    simp only [map_pow]
  rw [hmon, hdeg]
  constructor
  · exact (Polynomial.natDegree_C_mul_le _ _).trans hlin.1
  · rw [Polynomial.coeff_C_mul, hlin.2]
    simp only [shearPoly_X_coeff, Finsupp.prod, map_mul, map_prod, map_pow]
theorem shearPoly_top (v : Fin (k+1) → L) (F : MvPolynomial (Fin (k+1)) L) :
    (shearPoly v F).natDegree ≤ F.totalDegree ∧
      (shearPoly v F).coeff F.totalDegree =
        C (eval v (homogeneousComponent F.totalDegree F)) := by
  classical
  have key : shearPoly v F = ∑ s ∈ F.support, shearPoly v (monomial s (coeff s F)) := by
    conv_lhs => rw [F.as_sum]
    rw [map_sum]
  rw [key]
  constructor
  · refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun s hs => ?_
    exact (shearPoly_monomial v s (coeff s F)).1.trans (le_totalDegree hs)
  · rw [Polynomial.finsetSum_coeff, homogeneousComponent_apply, map_sum, map_sum,
      Finset.sum_filter]
    refine Finset.sum_congr rfl fun s hs => ?_
    by_cases hsd : s.degree = F.totalDegree
    · rw [if_pos hsd, ← hsd, (shearPoly_monomial v s (coeff s F)).2, eval_monomial]
    · rw [if_neg hsd]
      apply Polynomial.coeff_eq_zero_of_natDegree_lt
      exact lt_of_le_of_lt (shearPoly_monomial v s (coeff s F)).1
        (lt_of_le_of_ne (le_totalDegree hs) hsd)
end Shear
section Noether
variable {L : Type*} [Field L] {n : ℕ}
noncomputable def linForm (c : Fin n → L) : MvPolynomial (Fin n) L := ∑ j, C (c j) * X j
theorem linForm_add (c c' : Fin n → L) : linForm (c + c') = linForm c + linForm c' := by
  simp only [linForm, Pi.add_apply, map_add, add_mul, Finset.sum_add_distrib]
theorem linForm_smul (a : L) (c : Fin n → L) : linForm (a • c) = C a * linForm c := by
  simp only [linForm, Pi.smul_apply, smul_eq_mul, map_mul, Finset.mul_sum, mul_assoc]
theorem linForm_single (j : Fin n) : linForm (Pi.single j (1 : L)) = X j := by
  classical
  rw [linForm, Finset.sum_eq_single j]
  · simp
  · intro b _ hb
    simp [Pi.single_apply, hb]
  · simp
theorem eval_linForm (c x : Fin n → L) : eval x (linForm c) = ∑ j, c j * x j := by
  simp [linForm]
noncomputable def formAlg (P : Ideal (MvPolynomial (Fin n) L)) {s : ℕ} (c : Fin s → Fin n → L) :
    Algebra (MvPolynomial (Fin s) L) (MvPolynomial (Fin n) L ⧸ P) :=
  ((Ideal.Quotient.mk P).comp (aeval fun k => linForm (c k) :
    MvPolynomial (Fin s) L →ₐ[L] MvPolynomial (Fin n) L).toRingHom).toAlgebra
def IntOver (P : Ideal (MvPolynomial (Fin n) L)) {s : ℕ} (c : Fin s → Fin n → L)
    (f : MvPolynomial (Fin n) L) : Prop :=
  ∃ q : Polynomial (MvPolynomial (Fin s) L), q.Monic ∧
    Polynomial.eval₂ (aeval fun k => linForm (c k) :
      MvPolynomial (Fin s) L →ₐ[L] MvPolynomial (Fin n) L).toRingHom f q ∈ P
theorem intOver_iff (P : Ideal (MvPolynomial (Fin n) L)) {s : ℕ} (c : Fin s → Fin n → L)
    (f : MvPolynomial (Fin n) L) :
    IntOver P c f ↔ @IsIntegral (MvPolynomial (Fin s) L) (MvPolynomial (Fin n) L ⧸ P) _ _
      (formAlg P c) (Ideal.Quotient.mk P f) := by
  letI := formAlg P c
  constructor
  · rintro ⟨q, hqm, hq⟩
    refine ⟨q, hqm, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, Polynomial.hom_eval₂] at hq
    exact hq
  · rintro ⟨q, hqm, hq⟩
    refine ⟨q, hqm, ?_⟩
    rw [← Ideal.Quotient.eq_zero_iff_mem, Polynomial.hom_eval₂]
    exact hq
theorem evalTwo_shearPoly {k : ℕ} {B : Type*} [CommRing B] [Algebra L B] (v : Fin (k+1) → L)
    (y' : Fin k → B) (w : B) (F : MvPolynomial (Fin (k+1)) L) :
    Polynomial.eval₂ (aeval y' : MvPolynomial (Fin k) L →ₐ[L] B).toRingHom w (shearPoly v F) =
      aeval (Fin.cases (motive := fun _ => B) (algebraMap L B (v 0) * w)
        (fun i => y' i + algebraMap L B (v i.succ) * w)) F := by
  have h : (Polynomial.eval₂RingHom (aeval y' : MvPolynomial (Fin k) L →ₐ[L] B).toRingHom w).comp
      (shearPoly v : MvPolynomial (Fin (k+1)) L →ₐ[L] _).toRingHom =
      (aeval (Fin.cases (motive := fun _ => B) (algebraMap L B (v 0) * w)
        (fun i => y' i + algebraMap L B (v i.succ) * w)) :
          MvPolynomial (Fin (k+1)) L →ₐ[L] B).toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [shearPoly_C]
    · intro j
      induction j using Fin.cases with
      | zero => simp [shearPoly_X_zero]
      | succ i => simp [shearPoly_X_succ]
  exact RingHom.congr_fun h F
theorem homogeneousComponent_totalDegree_ne_zero {σ : Type*} {F : MvPolynomial σ L} (hF : F ≠ 0) :
    homogeneousComponent F.totalDegree F ≠ 0 := by
  classical
  obtain ⟨s, hs, hsd⟩ := Finset.exists_mem_eq_sup F.support (support_nonempty.mpr hF)
    (fun s => s.sum fun _ e => e)
  intro h0
  have hc := congrArg (coeff s) h0
  rw [coeff_homogeneousComponent, coeff_zero, if_pos] at hc
  · exact (mem_support_iff.mp hs) hc
  · rw [totalDegree, hsd]
    rfl
theorem exists_good_direction [Infinite L] {k : ℕ} {F : MvPolynomial (Fin (k+1)) L} (hF : F ≠ 0) :
    ∃ v : Fin (k+1) → L, v 0 ≠ 0 ∧ eval v (homogeneousComponent F.totalDegree F) ≠ 0 := by
  have hH := homogeneousComponent_totalDegree_ne_zero hF
  have hprod : (X 0 * homogeneousComponent F.totalDegree F : MvPolynomial (Fin (k+1)) L) ≠ 0 :=
    mul_ne_zero (X_ne_zero 0) hH
  by_contra hall
  push Not at hall
  apply hprod
  apply MvPolynomial.funext
  intro v
  rw [map_mul, eval_X, map_zero]
  by_cases hv : v 0 = 0
  · rw [hv, zero_mul]
  · rw [hall v hv, mul_zero]
theorem shear_monic {k : ℕ} (v : Fin (k+1) → L) {F : MvPolynomial (Fin (k+1)) L}
    (hu : eval v (homogeneousComponent F.totalDegree F) ≠ 0) :
    (Polynomial.C (C (eval v (homogeneousComponent F.totalDegree F))⁻¹) * shearPoly v F).Monic := by
  obtain ⟨hdeg, hcoeff⟩ := shearPoly_top v F
  have hne : (shearPoly v F).coeff F.totalDegree ≠ 0 := by
    rw [hcoeff]
    simpa using hu
  have hnat : (shearPoly v F).natDegree = F.totalDegree :=
    le_antisymm hdeg (Polynomial.le_natDegree_of_ne_zero hne)
  have hunit : (C (eval v (homogeneousComponent F.totalDegree F))⁻¹ :
      MvPolynomial (Fin k) L) ≠ 0 := by simpa using hu
  rw [Polynomial.Monic, Polynomial.leadingCoeff, Polynomial.natDegree_C_mul hunit, hnat,
    Polynomial.coeff_C_mul, hcoeff, ← map_mul, inv_mul_cancel₀ hu, map_one]
end Noether
section NoetherInduction
variable {L : Type*} [Field L] {n : ℕ}
theorem mk_C_eq_algebraMap (P : Ideal (MvPolynomial (Fin n) L)) (a : L) :
    Ideal.Quotient.mk P (C a) = algebraMap L (MvPolynomial (Fin n) L ⧸ P) a := rfl
set_option backward.isDefEq.respectTransparency false in
theorem noether_forms [Infinite L] (P : Ideal (MvPolynomial (Fin n) L)) [hP : P.IsPrime] :
    ∀ (m : ℕ) (y : Fin m → Fin n → L), ∃ (s : ℕ) (c : Fin s → Fin n → L),
      AlgebraicIndependent L (fun k => Ideal.Quotient.mk P (linForm (c k))) ∧
      ∀ i, IntOver P c (linForm (y i)) := by
  intro m
  induction m with
  | zero =>
    intro y
    refine ⟨0, Fin.elim0, ?_, fun i => i.elim0⟩
    haveI : Nontrivial (MvPolynomial (Fin n) L ⧸ P) := inferInstance
    exact algebraicIndependent_empty_type
  | succ m ih =>
    intro y
    by_cases hind : AlgebraicIndependent L (fun i => Ideal.Quotient.mk P (linForm (y i)))
    · refine ⟨m+1, y, hind, fun i => ⟨Polynomial.X - Polynomial.C (X i),
        Polynomial.monic_X_sub_C _, ?_⟩⟩
      simp
    · rw [algebraicIndependent_iff_injective_aeval, injective_iff_map_eq_zero] at hind
      push Not at hind
      obtain ⟨F, hF, hF0⟩ := hind
      obtain ⟨v, hv0, hvu⟩ := exists_good_direction hF0
      set w0 : Fin n → L := (v 0)⁻¹ • y 0 with hw0
      set y' : Fin m → Fin n → L := fun i => y i.succ - v i.succ • w0 with hy'
      obtain ⟨s, c, hc, hint⟩ := ih y'
      refine ⟨s, c, hc, ?_⟩
      letI := formAlg P c
      have hmem : ∀ f, IntOver P c f ↔ Ideal.Quotient.mk P f ∈
          integralClosure (MvPolynomial (Fin s) L) (MvPolynomial (Fin n) L ⧸ P) := by
        intro f
        rw [intOver_iff]
        rfl
      have hy'Int : ∀ i, Ideal.Quotient.mk P (linForm (y' i)) ∈
          integralClosure (MvPolynomial (Fin s) L) (MvPolynomial (Fin n) L ⧸ P) :=
        fun i => (hmem _).mp (hint i)
      have hLInt : ∀ a : L, algebraMap L (MvPolynomial (Fin n) L ⧸ P) a ∈
          integralClosure (MvPolynomial (Fin s) L) (MvPolynomial (Fin n) L ⧸ P) := by
        intro a
        have ha : algebraMap L (MvPolynomial (Fin n) L ⧸ P) a =
            algebraMap (MvPolynomial (Fin s) L) (MvPolynomial (Fin n) L ⧸ P) (C a) := by
          show _ = Ideal.Quotient.mk P (aeval (fun k => linForm (c k)) (C a))
          rw [aeval_C]
          rfl
        rw [ha]
        exact Subalgebra.algebraMap_mem _ _
      have hy0 : linForm (y 0) = C (v 0) * linForm w0 := by
        rw [← linForm_smul, hw0, smul_smul, mul_inv_cancel₀ hv0, one_smul]
      have hysucc : ∀ i : Fin m, linForm (y i.succ) = linForm (y' i) + C (v i.succ) * linForm w0 := by
        intro i
        rw [← linForm_smul, ← linForm_add, hy']
        simp
      have hfam : (Fin.cases (motive := fun _ => MvPolynomial (Fin n) L ⧸ P)
          (algebraMap L _ (v 0) * Ideal.Quotient.mk P (linForm w0))
          (fun i => Ideal.Quotient.mk P (linForm (y' i)) +
            algebraMap L _ (v i.succ) * Ideal.Quotient.mk P (linForm w0))) =
          fun j => Ideal.Quotient.mk P (linForm (y j)) := by
        funext j
        induction j using Fin.cases with
        | zero =>
          rw [Fin.cases_zero, hy0, map_mul]
          rfl
        | succ i =>
          rw [Fin.cases_succ, hysucc i, map_add, map_mul]
          rfl
      have hshear := evalTwo_shearPoly (B := MvPolynomial (Fin n) L ⧸ P) v
        (fun i => Ideal.Quotient.mk P (linForm (y' i))) (Ideal.Quotient.mk P (linForm w0)) F
      rw [hfam, hF] at hshear
      set Int := integralClosure (MvPolynomial (Fin s) L) (MvPolynomial (Fin n) L ⧸ P) with hInt
      let ψ : MvPolynomial (Fin m) L →+* Int :=
        MvPolynomial.eval₂Hom ((algebraMap (MvPolynomial (Fin s) L) Int).comp C)
          (fun i => ⟨_, hy'Int i⟩)
      have hcompψ : (algebraMap Int (MvPolynomial (Fin n) L ⧸ P)).comp ψ =
          (aeval (fun i => Ideal.Quotient.mk P (linForm (y' i))) :
            MvPolynomial (Fin m) L →ₐ[L] MvPolynomial (Fin n) L ⧸ P).toRingHom := by
        apply MvPolynomial.ringHom_ext
        · intro a
          rw [RingHom.comp_apply, eval₂Hom_C, RingHom.comp_apply,
            ← IsScalarTower.algebraMap_apply]
          show Ideal.Quotient.mk P (aeval (fun k => linForm (c k)) (C a)) = _
          rw [aeval_C, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, aeval_C]
          rfl
        · intro i
          rw [RingHom.comp_apply, eval₂Hom_X', AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
            aeval_X]
          rfl
      have hwI : IsIntegral Int (Ideal.Quotient.mk P (linForm w0)) := by
        refine ⟨(Polynomial.C (C (eval v (homogeneousComponent F.totalDegree F))⁻¹) *
          shearPoly v F).map ψ, (shear_monic v hvu).map ψ, ?_⟩
        rw [Polynomial.eval₂_map, hcompψ, Polynomial.eval₂_mul, Polynomial.eval₂_C, hshear,
          mul_zero]
      have hwInt : Ideal.Quotient.mk P (linForm w0) ∈ Int :=
        isIntegral_trans (R := MvPolynomial (Fin s) L) (A := Int) _ hwI
      intro i
      rw [hmem]
      induction i using Fin.cases with
      | zero =>
        rw [hy0, map_mul, mk_C_eq_algebraMap]
        exact Subalgebra.mul_mem _ (hLInt _) hwInt
      | succ j =>
        rw [hysucc j, map_add, map_mul, mk_C_eq_algebraMap]
        exact Subalgebra.add_mem _ (hy'Int j) (Subalgebra.mul_mem _ (hLInt _) hwInt)
theorem exists_noether_forms [Infinite L] (P : Ideal (MvPolynomial (Fin n) L)) [P.IsPrime] :
    ∃ (s : ℕ) (c : Fin s → Fin n → L),
      AlgebraicIndependent L (fun k => Ideal.Quotient.mk P (linForm (c k))) ∧
      ∀ j, IntOver P c (X j) := by
  classical
  obtain ⟨s, c, hc, hint⟩ := noether_forms P n (fun j => Pi.single j 1)
  exact ⟨s, c, hc, fun j => by simpa [linForm_single] using hint j⟩
end NoetherInduction
section EquivTransport
variable {L : Type*} [Field L] {n : ℕ}
theorem minimalPrime_comap_equiv (σ : MvPolynomial (Fin n) L ≃ₐ[L] MvPolynomial (Fin n) L)
    (G : Set (MvPolynomial (Fin n) L)) (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ (Ideal.span G).minimalPrimes) :
    P.comap σ ∈ (Ideal.span (σ.symm '' G)).minimalPrimes := by
  have hspan : (Ideal.span G).comap σ = Ideal.span (σ.symm '' G) := by
    rw [← Ideal.map_span]
    exact (Ideal.map_symm (I := Ideal.span G) σ.toRingEquiv).symm
  rw [← hspan]
  exact Ideal.minimalPrimes_comap_of_surjective (f := σ.toRingEquiv.toRingHom) σ.surjective hP
theorem trdeg_comap_equiv (σ : MvPolynomial (Fin n) L ≃ₐ[L] MvPolynomial (Fin n) L)
    (P : Ideal (MvPolynomial (Fin n) L)) :
    Algebra.trdeg L (MvPolynomial (Fin n) L ⧸ P.comap σ) =
      Algebra.trdeg L (MvPolynomial (Fin n) L ⧸ P) := by
  have hmapeq : P = (P.comap σ).map σ :=
    (Ideal.map_comap_of_surjective _ σ.surjective P).symm
  exact (Ideal.quotientEquivAlg (P.comap σ) P σ hmapeq).trdeg_eq
theorem dimLE_equiv (σ : MvPolynomial (Fin n) L ≃ₐ[L] MvPolynomial (Fin n) L)
    [DecidableEq (MvPolynomial (Fin n) L)]
    (G : Finset (MvPolynomial (Fin n) L)) (h : MvPolynomial (Fin n) L) (r : ℕ)
    (hdim : DimLE G h r) : DimLE (G.image σ.symm) (σ.symm h) r := by
  intro Q hQ hhQ
  rw [Finset.coe_image] at hQ
  have hQ' := minimalPrime_comap_equiv σ.symm _ Q hQ
  have himg : σ.symm.symm '' (σ.symm '' (G : Set (MvPolynomial (Fin n) L))) = G := by
    ext f
    simp
  rw [himg] at hQ'
  have hh' : h ∉ Q.comap σ.symm := by
    intro hm
    rw [Ideal.mem_comap] at hm
    exact hhQ hm
  have := hdim _ hQ' hh'
  rwa [trdeg_comap_equiv] at this
end EquivTransport
section Coords
variable {L : Type*} [Field L] {n : ℕ}
theorem exists_coords {s : ℕ} (b : Fin s → Fin n → L) (hb : LinearIndependent L b) :
    ∃ (M : Matrix (Fin n) (Fin n) L) (_ : IsUnit M.det) (ν : Fin s ↪ Fin n), ∀ k, M (ν k) = b k := by
  classical
  have hs := hb.linearIndepOn_id
  let B := Module.Basis.extend hs
  haveI : Finite (hs.extend (Set.subset_univ (Set.range b))) := Module.Finite.finite_basis B
  letI : Fintype (hs.extend (Set.subset_univ (Set.range b))) := Fintype.ofFinite _
  have hcard : Fintype.card (hs.extend (Set.subset_univ (Set.range b))) = n := by
    rw [← Module.finrank_eq_card_basis B, Module.finrank_fintype_fun_eq_card, Fintype.card_fin]
  let e := Fintype.equivFinOfCardEq hcard
  let M : Matrix (Fin n) (Fin n) L := fun i => B (e.symm i)
  have hMli : LinearIndependent L M.row := by
    have : M.row = B ∘ e.symm := rfl
    rw [this]
    exact B.linearIndependent.comp _ e.symm.injective
  have hmem : ∀ k, b k ∈ hs.extend (Set.subset_univ (Set.range b)) :=
    fun k => Module.Basis.subset_extend hs (Set.mem_range_self k)
  refine ⟨M, (Matrix.isUnit_iff_isUnit_det M).mp (Matrix.linearIndependent_rows_iff_isUnit.mp hMli),
    ⟨fun k => e ⟨b k, hmem k⟩, fun a c hac => hb.injective (congrArg Subtype.val (e.injective hac))⟩,
    fun k => ?_⟩
  show B (e.symm (e ⟨b k, hmem k⟩)) = b k
  rw [Equiv.symm_apply_apply, Module.Basis.extend_apply_self]
end Coords
section Fibers
variable {L : Type*} [Field L] {n : ℕ}
theorem intOver_C (P : Ideal (MvPolynomial (Fin n) L)) {s : ℕ} (c : Fin s → Fin n → L) (a : L) :
    IntOver P c (C a) :=
  ⟨Polynomial.X - Polynomial.C (C a), Polynomial.monic_X_sub_C _, by simp⟩
theorem intOver_all (P : Ideal (MvPolynomial (Fin n) L)) {s : ℕ} (c : Fin s → Fin n → L)
    (hX : ∀ j, IntOver P c (X j)) (f : MvPolynomial (Fin n) L) : IntOver P c f := by
  letI := formAlg P c
  rw [intOver_iff]
  show Ideal.Quotient.mk P f ∈ integralClosure (MvPolynomial (Fin s) L) (MvPolynomial (Fin n) L ⧸ P)
  induction f using MvPolynomial.induction_on with
  | C a =>
    exact (intOver_iff P c (C a)).mp (intOver_C P c a)
  | add p q hp hq =>
    rw [map_add]
    exact Subalgebra.add_mem _ hp hq
  | mul_X p j hp =>
    rw [map_mul]
    exact Subalgebra.mul_mem _ hp ((intOver_iff P c _).mp (hX j))
theorem fiber_finite (P : Ideal (MvPolynomial (Fin n) L)) {s : ℕ} (c : Fin s → Fin n → L)
    (hX : ∀ j, IntOver P c (X j)) (a : Fin s → L) :
    {y : Fin n → L | (∀ f ∈ P, eval y f = 0) ∧ ∀ k, eval y (linForm (c k)) = a k}.Finite := by
  classical
  choose q hqm hq using hX
  have hroot : ∀ j, ({t : L | (q j).map (eval a) |>.IsRoot t} : Set L).Finite := fun j =>
    Polynomial.finite_setOf_isRoot ((hqm j).map _).ne_zero
  refine (Set.Finite.pi (t := fun j => {t : L | ((q j).map (eval a)).IsRoot t}) hroot).subset ?_
  rintro y ⟨hyP, hya⟩
  simp only [Set.mem_pi, Set.mem_univ, Set.mem_setOf_eq, true_implies]
  intro j
  have h0 := hyP _ (hq j)
  rw [Polynomial.hom_eval₂] at h0
  have hcomp : (eval y).comp (aeval (fun k => linForm (c k)) :
      MvPolynomial (Fin s) L →ₐ[L] MvPolynomial (Fin n) L).toRingHom = eval a := by
    apply MvPolynomial.ringHom_ext
    · intro b
      simp
    · intro k
      simp [hya k]
  rw [hcomp, eval_X] at h0
  rw [Polynomial.IsRoot, Polynomial.eval_map]
  exact h0
theorem exists_separating_vector [Infinite L] {s : ℕ} (c : Fin s → Fin n → L) (hs : s < n)
    (p : Fin n → L) (S : Set (Fin n → L)) (hS : S.Finite) (hp : p ∉ S) :
    ∃ w : Fin n → L, w ∉ Submodule.span L (Set.range c) ∧
      ∀ y ∈ S, ∑ j, w j * y j ≠ ∑ j, w j * p j := by
  classical
  let φ : (Fin n → L) → (Fin n → L) →ₗ[L] L := fun y =>
    ∑ j, (y j - p j) • LinearMap.proj (R := L) (φ := fun _ : Fin n => L) j
  have hφ : ∀ y w, φ y w = ∑ j, (y j - p j) * w j := by
    intro y w
    simp [φ]
  let W : Option hS.toFinset → Submodule L (Fin n → L) := fun o =>
    match o with
    | none => Submodule.span L (Set.range c)
    | some y => LinearMap.ker (φ y.1)
  have hW : ∀ o, W o ≠ ⊤ := by
    intro o
    cases o with
    | none =>
      intro htop
      have hle := finrank_range_le_card (R := L) c
      have hfin : (Set.range c).finrank L = n := by
        show Module.finrank L (W none) = n
        rw [htop, finrank_top, Module.finrank_fintype_fun_eq_card, Fintype.card_fin]
      rw [hfin, Fintype.card_fin] at hle
      omega
    | some y =>
      intro htop
      have hyp : y.1 ≠ p := by
        intro hyp
        apply hp
        rw [← hyp]
        exact hS.mem_toFinset.mp y.2
      obtain ⟨j, hj⟩ := Function.ne_iff.mp hyp
      have hmem : (Pi.single j 1 : Fin n → L) ∈ W (some y) := by rw [htop]; trivial
      change Pi.single j 1 ∈ LinearMap.ker (φ y.1) at hmem
      rw [LinearMap.mem_ker, hφ, Finset.sum_eq_single j] at hmem
      · simp only [Pi.single_eq_same, mul_one] at hmem
        exact hj (sub_eq_zero.mp hmem)
      · intro b _ hb
        simp [Pi.single_apply, hb]
      · simp
  obtain ⟨w, hw⟩ := Submodule.exists_forall_notMem_of_forall_ne_top W hW
  refine ⟨w, hw none, fun y hy => ?_⟩
  have hwy := hw (some ⟨y, hS.mem_toFinset.mpr hy⟩)
  change w ∉ LinearMap.ker (φ y) at hwy
  rw [LinearMap.mem_ker, hφ] at hwy
  intro heq
  apply hwy
  rw [← sub_eq_zero] at heq
  rw [← heq, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun j _ => ?_
  ring
end Fibers
section ComponentSeparator
variable {L : Type*} [Field L] {n : ℕ}
theorem linearIndependent_of_algIndep (P : Ideal (MvPolynomial (Fin n) L)) {s : ℕ}
    (c : Fin s → Fin n → L)
    (hc : AlgebraicIndependent L (fun k => Ideal.Quotient.mk P (linForm (c k)))) :
    LinearIndependent L c := by
  classical
  rw [Fintype.linearIndependent_iff]
  intro a ha k
  let g : MvPolynomial (Fin s) L := ∑ i, C (a i) * X i
  have hg : aeval (fun i => Ideal.Quotient.mk P (linForm (c i))) g = 0 := by
    have hlin : linForm (∑ i, a i • c i) = ∑ i, C (a i) * linForm (c i) := by
      simp only [linForm, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, map_sum, map_mul,
        Finset.sum_mul, Finset.mul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun i _ => ?_
      ring
    have h0 : Ideal.Quotient.mk P (linForm (∑ i, a i • c i)) = 0 := by
      rw [ha]
      simp [linForm]
    rw [hlin] at h0
    simp only [g, map_sum, map_mul, aeval_C, aeval_X]
    simpa [mk_C_eq_algebraMap] using h0
  have hg0 : g = 0 := hc (by rw [hg, map_zero])
  have hcoeff := congrArg (coeff (Finsupp.single k 1)) hg0
  simp only [g, coeff_sum, coeff_C_mul, coeff_X, coeff_zero] at hcoeff
  rw [Finset.sum_eq_single k] at hcoeff
  · simpa using hcoeff
  · intro b _ hb
    simp [Finsupp.single_left_inj one_ne_zero, hb]
  · simp
theorem isAlgebraic_adjoin_of_intOver (P : Ideal (MvPolynomial (Fin n) L)) [P.IsPrime] {s : ℕ}
    (c : Fin s → Fin n → L) (hX : ∀ j, IntOver P c (X j)) :
    Algebra.IsAlgebraic (Algebra.adjoin L (Set.range fun k => Ideal.Quotient.mk P (linForm (c k))))
      (MvPolynomial (Fin n) L ⧸ P) := by
  set cb : Fin s → MvPolynomial (Fin n) L ⧸ P := fun k => Ideal.Quotient.mk P (linForm (c k))
    with hcb
  have hmem : ∀ a : MvPolynomial (Fin s) L, aeval cb a ∈ Algebra.adjoin L (Set.range cb) := by
    intro a
    rw [Algebra.adjoin_range_eq_range_aeval]
    exact ⟨a, rfl⟩
  let φ := (aeval cb : MvPolynomial (Fin s) L →ₐ[L] _).codRestrict _ hmem
  have hφ : ∀ a : MvPolynomial (Fin s) L, ((φ a : Algebra.adjoin L (Set.range cb)) : MvPolynomial (Fin n) L ⧸ P) =
      aeval cb a := fun a => rfl
  have hmk : ∀ a : MvPolynomial (Fin s) L,
      Ideal.Quotient.mk P (aeval (fun k => linForm (c k)) a) = aeval cb a := by
    intro a
    have h : (Ideal.Quotient.mkₐ L P).comp (aeval fun k => linForm (c k)) = aeval cb := by
      apply MvPolynomial.algHom_ext
      intro k
      simp [hcb]
    exact AlgHom.congr_fun h a
  haveI : Nontrivial (Algebra.adjoin L (Set.range cb)) := inferInstance
  constructor
  intro x
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective x
  obtain ⟨q, hqm, hq⟩ := intOver_all P c hX f
  refine IsIntegral.isAlgebraic ⟨q.map (φ : MvPolynomial (Fin s) L →+* _), hqm.map _, ?_⟩
  rw [Polynomial.eval₂_map]
  have hcomp : (algebraMap (Algebra.adjoin L (Set.range cb)) (MvPolynomial (Fin n) L ⧸ P)).comp
      (φ : MvPolynomial (Fin s) L →+* _) =
      (Ideal.Quotient.mk P).comp (aeval fun k => linForm (c k) :
        MvPolynomial (Fin s) L →ₐ[L] MvPolynomial (Fin n) L).toRingHom := by
    apply MvPolynomial.ringHom_ext
    · intro a
      show ((φ (C a) : Algebra.adjoin L (Set.range cb)) : MvPolynomial (Fin n) L ⧸ P) =
        Ideal.Quotient.mk P (aeval (fun k => linForm (c k)) (C a))
      rw [hφ, hmk]
    · intro i
      show ((φ (X i) : Algebra.adjoin L (Set.range cb)) : MvPolynomial (Fin n) L ⧸ P) =
        Ideal.Quotient.mk P (aeval (fun k => linForm (c k)) (X i))
      rw [hφ, hmk]
  rw [hcomp, ← Polynomial.hom_eval₂, Ideal.Quotient.eq_zero_iff_mem]
  exact hq
end ComponentSeparator
section MainSeparator
variable {L : Type*} [Field L] {n : ℕ}
theorem eq_bot_of_trdeg_ge (P : Ideal (MvPolynomial (Fin n) L)) [P.IsPrime]
    (h : (n : Cardinal) ≤ Algebra.trdeg L (MvPolynomial (Fin n) L ⧸ P)) : P = ⊥ := by
  classical
  have hX : ∀ j, IntOver P (fun k : Fin n => (Pi.single k 1 : Fin n → L)) (X j) := by
    intro j
    refine ⟨Polynomial.X - Polynomial.C (X j), Polynomial.monic_X_sub_C _, ?_⟩
    simp [linForm_single]
  haveI := isAlgebraic_adjoin_of_intOver P _ hX
  have hbasis := Algebra.IsAlgebraic.isTranscendenceBasis_of_lift_le_trdeg_of_finite (R := L)
    (fun k : Fin n => Ideal.Quotient.mk P (linForm (Pi.single k (1 : L))))
    (by simpa using h)
  have hind := hbasis.1
  rw [eq_bot_iff]
  intro f hf
  rw [Ideal.mem_bot]
  apply hind
  have hmk : aeval (fun k : Fin n => Ideal.Quotient.mk P (linForm (Pi.single k (1 : L)))) f =
      Ideal.Quotient.mk P f := by
    have hext : (aeval fun k : Fin n => Ideal.Quotient.mk P (linForm (Pi.single k (1 : L)))) =
        (Ideal.Quotient.mkₐ L P : MvPolynomial (Fin n) L →ₐ[L] _) := by
      apply MvPolynomial.algHom_ext
      intro k
      simp [linForm_single]
    rw [hext]
    rfl
  rw [hmk, map_zero, Ideal.Quotient.eq_zero_iff_mem]
  exact hf
set_option backward.isDefEq.respectTransparency false in
theorem exists_component_separator [IsAlgClosed L]
    (G : Finset (MvPolynomial (Fin n) L)) (h : MvPolynomial (Fin n) L) (d e r : ℕ)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hh : h.totalDegree ≤ e) (hdim : DimLE G h r)
    (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes) (hhP : h ∉ P)
    (hr : (r : Cardinal) ≤ Algebra.trdeg L (MvPolynomial (Fin n) L ⧸ P))
    (p : Fin n → L) (f : MvPolynomial (Fin n) L) (hfP : f ∈ P) (hfp : eval p f ≠ 0) :
    ∃ s ∈ P, s.totalDegree ≤ (r + 1) * fiberBound (n - r + 1) (max d (e+1)) ∧ eval p s ≠ 0 := by
  classical
  haveI hPprime : P.IsPrime := hP.1.1
  obtain ⟨s', c, hc, hX⟩ := exists_noether_forms P
  have hs'le : (s' : Cardinal) ≤ Algebra.trdeg L (MvPolynomial (Fin n) L ⧸ P) := by
    simpa using hc.lift_cardinalMk_le_trdeg
  haveI := isAlgebraic_adjoin_of_intOver P c hX
  have htrle : Algebra.trdeg L (MvPolynomial (Fin n) L ⧸ P) ≤ s' := by
    refine (Algebra.IsAlgebraic.trdeg_le_cardinalMk (R := L)
      (s := Set.range fun k : Fin s' => Ideal.Quotient.mk P (linForm (c k)))).trans ?_
    have := Cardinal.mk_range_le_lift (f := fun k : Fin s' => Ideal.Quotient.mk P (linForm (c k)))
    simpa using this
  have htrr := hdim P hP hhP
  have hs'r : s' = r := by
    have h1 : (s' : Cardinal) ≤ r := hs'le.trans htrr
    have h2 : (r : Cardinal) ≤ s' := hr.trans htrle
    exact le_antisymm (by exact_mod_cast h1) (by exact_mod_cast h2)
  subst hs'r
  have hfne : f ≠ 0 := by
    rintro rfl
    simp at hfp
  have hlt : s' < n := by
    by_contra hge
    push Not at hge
    have hbot := eq_bot_of_trdeg_ge P
      ((Nat.cast_le.mpr hge).trans hr)
    rw [hbot, Ideal.mem_bot] at hfP
    exact hfne hfP
  set S := {y : Fin n → L | (∀ g ∈ P, eval y g = 0) ∧
    ∀ k, eval y (linForm (c k)) = eval p (linForm (c k))} with hS
  have hSfin : S.Finite := fiber_finite P c hX _
  have hpS : p ∉ S := fun hp => hfp (hp.1 f hfP)
  obtain ⟨w, hwspan, hwsep⟩ := exists_separating_vector c hlt p S hSfin hpS
  have hcli := linearIndependent_of_algIndep P c hc
  have hbli : LinearIndependent L (Fin.cons w c : Fin (s'+1) → Fin n → L) :=
    linearIndependent_finCons.mpr ⟨hcli, hwspan⟩
  obtain ⟨M, hM, ν, hMν⟩ := exists_coords _ hbli
  set σ := linEquiv M hM with hσ
  have hσX : ∀ i, σ (X i) = linForm (M i) := fun i => linSubst_X M i
  have hσν0 : σ (X (ν 0)) = linForm w := by rw [hσX, hMν]; rfl
  have hσνs : ∀ k : Fin s', σ (X (ν k.succ)) = linForm (c k) := by
    intro k
    rw [hσX, hMν]
    rfl
  set Q := P.comap σ with hQ
  haveI : Q.IsPrime := Ideal.IsPrime.comap σ
  have hQmin : Q ∈ (Ideal.span ((G.image σ.symm : Finset _) :
      Set (MvPolynomial (Fin n) L))).minimalPrimes := by
    rw [Finset.coe_image]
    exact minimalPrime_comap_equiv σ _ P hP
  have hhQ : σ.symm h ∉ Q := by
    intro hm
    rw [hQ, Ideal.mem_comap, AlgEquiv.apply_symm_apply] at hm
    exact hhP hm
  have hdegσ : ∀ g, (σ.symm g).totalDegree ≤ g.totalDegree := fun g =>
    linSubst_totalDegree_le M⁻¹ g
  have hG' : ∀ g ∈ G.image σ.symm, g.totalDegree ≤ d := by
    intro g hg
    rw [Finset.mem_image] at hg
    obtain ⟨g0, hg0, rfl⟩ := hg
    exact (hdegσ g0).trans (hG g0 hg0)
  have hdim' := dimLE_equiv σ G h s' hdim
  have hmapeq : P = Q.map σ := (Ideal.map_comap_of_surjective _ σ.surjective P).symm
  let ι := Ideal.quotientEquivAlg Q P σ hmapeq
  have hι : ∀ g, ι (Ideal.Quotient.mk Q g) = Ideal.Quotient.mk P (σ g) := fun g => rfl
  have hind : AlgebraicIndependent L
      (fun k : Fin s' => Ideal.Quotient.mk Q (X (ν k.succ) : MvPolynomial (Fin n) L)) := by
    have := hc.map' (f := ι.symm.toAlgHom) (fun a b hab => ι.symm.injective hab)
    convert this using 1
    all_goals first
      | rfl
      | (funext k
         simp only [Function.comp_apply, AlgEquiv.toAlgHom_eq_coe, AlgEquiv.coe_algHom]
         rw [AlgEquiv.eq_symm_apply, hι, hσνs])
  have hint : ∀ j : Fin n, ∃ q : Polynomial (MvPolynomial (Fin s') L), q.Monic ∧
      Polynomial.eval₂ (rename (fun k : Fin s' => ν k.succ) :
        MvPolynomial (Fin s') L →ₐ[L] MvPolynomial (Fin n) L).toRingHom (X j) q ∈ Q := by
    intro j
    obtain ⟨q, hqm, hq⟩ := intOver_all P c hX (σ (X j))
    refine ⟨q, hqm, ?_⟩
    rw [hQ, Ideal.mem_comap]
    have hcomp : (σ : MvPolynomial (Fin n) L →+* MvPolynomial (Fin n) L).comp
        (rename (fun k : Fin s' => ν k.succ) :
          MvPolynomial (Fin s') L →ₐ[L] MvPolynomial (Fin n) L).toRingHom =
        (aeval fun k => linForm (c k) :
          MvPolynomial (Fin s') L →ₐ[L] MvPolynomial (Fin n) L).toRingHom := by
      apply MvPolynomial.ringHom_ext
      · intro a
        show σ (rename (fun k : Fin s' => ν k.succ) (C a)) = aeval (fun k => linForm (c k)) (C a)
        rw [rename_C, aeval_C]
        exact linSubst_C M a
      · intro k
        simp only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom, rename_X,
          aeval_X]
        exact hσνs k
    have h1 := Polynomial.hom_eval₂ (p := q)
      (f := (rename (fun k : Fin s' => ν k.succ) :
        MvPolynomial (Fin s') L →ₐ[L] MvPolynomial (Fin n) L).toRingHom)
      (g := (σ : MvPolynomial (Fin n) L →+* MvPolynomial (Fin n) L)) (X j)
    rw [hcomp] at h1
    change (σ : MvPolynomial (Fin n) L →+* MvPolynomial (Fin n) L) _ ∈ P
    rw [h1]
    exact hq
  set p' : Fin n → L := M.mulVec p with hp'
  have hevalσ : ∀ (g : MvPolynomial (Fin n) L) (y : Fin n → L),
      eval y (σ g) = eval (M.mulVec y) g := fun g y => eval_linSubst M g y
  have hevalσs : ∀ (g : MvPolynomial (Fin n) L) (y : Fin n → L),
      eval y (σ.symm g) = eval (M⁻¹.mulVec y) g := fun g y => eval_linSubst M⁻¹ g y
  have hrow : ∀ (i : Fin n) (y : Fin n → L), M.mulVec y i = eval y (linForm (M i)) := by
    intro i y
    rw [eval_linForm]
    simp [Matrix.mulVec, dotProduct]
  have hsep : ∀ y' : Fin n → L, (∀ g ∈ Q, eval y' g = 0) →
      (∀ k : Fin s', y' (ν k.succ) = p' (ν k.succ)) → y' (ν 0) ≠ p' (ν 0) := by
    intro y' hy'Q hy'k
    set y := M⁻¹.mulVec y' with hy
    have hMy : M.mulVec y = y' := by
      rw [hy, Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv _ hM, Matrix.one_mulVec]
    have hyP : ∀ g ∈ P, eval y g = 0 := by
      intro g hg
      have hgQ : σ.symm g ∈ Q := by
        rw [hQ, Ideal.mem_comap, AlgEquiv.apply_symm_apply]
        exact hg
      have := hy'Q _ hgQ
      rwa [hevalσs] at this
    have hyS : y ∈ S := by
      refine ⟨hyP, fun k => ?_⟩
      have h1 := hy'k k
      rw [← hMy, hp', hrow, hrow, hMν] at h1
      simpa using h1
    have hne := hwsep y hyS
    rw [← hMy, hp', hrow, hrow, hMν]
    simpa [eval_linForm, Fin.cons_zero] using hne
  obtain ⟨st, hstQ, hstdeg, hstp⟩ := exists_separator_good (G.image σ.symm) (σ.symm h) d e
    hG' ((hdegσ h).trans hh) hdim' Q hQmin hhQ ν hind hint p' hsep
  refine ⟨σ st, hstQ, ?_, ?_⟩
  · rw [linEquiv_totalDegree]
    exact hstdeg
  · rw [hevalσ]
    exact hstp
end MainSeparator
section Peeling
variable {L : Type*} [Field L] {n : ℕ}
noncomputable def rk (P : Ideal (MvPolynomial (Fin n) L)) : ℕ :=
  (Algebra.trdeg L (MvPolynomial (Fin n) L ⧸ P)).toNat
theorem trdeg_le_n (P : Ideal (MvPolynomial (Fin n) L)) [P.IsPrime] :
    Algebra.trdeg L (MvPolynomial (Fin n) L ⧸ P) ≤ n := by
  classical
  have hX : ∀ j, IntOver P (fun k : Fin n => (Pi.single k 1 : Fin n → L)) (X j) := by
    intro j
    refine ⟨Polynomial.X - Polynomial.C (X j), Polynomial.monic_X_sub_C _, ?_⟩
    simp [linForm_single]
  haveI := isAlgebraic_adjoin_of_intOver P _ hX
  refine (Algebra.IsAlgebraic.trdeg_le_cardinalMk (R := L)
    (s := Set.range fun k : Fin n => Ideal.Quotient.mk P (linForm (Pi.single k (1 : L))))).trans ?_
  have := Cardinal.mk_range_le_lift
    (f := fun k : Fin n => Ideal.Quotient.mk P (linForm (Pi.single k (1 : L))))
  simpa using this
theorem rk_cast (P : Ideal (MvPolynomial (Fin n) L)) [P.IsPrime] :
    ((rk P : ℕ) : Cardinal) = Algebra.trdeg L (MvPolynomial (Fin n) L ⧸ P) := by
  rw [rk]
  exact Cardinal.cast_toNat_of_lt_aleph0 ((trdeg_le_n P).trans_lt Cardinal.natCast_lt_aleph0)
theorem rk_le (P : Ideal (MvPolynomial (Fin n) L)) [P.IsPrime] : rk P ≤ n := by
  have h := trdeg_le_n P
  rw [← rk_cast] at h
  exact_mod_cast h
theorem exists_coordinate_basis (P : Ideal (MvPolynomial (Fin n) L)) [P.IsPrime] (r : ℕ)
    (hr : rk P = r) :
    ∃ κ : Fin r ↪ Fin n,
      AlgebraicIndependent L (fun i => Ideal.Quotient.mk P (X (κ i) : MvPolynomial (Fin n) L)) := by
  subst hr
  classical
  have hX : ∀ j, IntOver P (fun k : Fin n => (Pi.single k 1 : Fin n → L)) (X j) := by
    intro j
    refine ⟨Polynomial.X - Polynomial.C (X j), Polynomial.monic_X_sub_C _, ?_⟩
    simp [linForm_single]
  have hrange : (Set.range fun k : Fin n => Ideal.Quotient.mk P (linForm (Pi.single k (1 : L)))) =
      Set.range fun k : Fin n => Ideal.Quotient.mk P (X k : MvPolynomial (Fin n) L) := by
    simp [linForm_single]
  haveI halg := isAlgebraic_adjoin_of_intOver P _ hX
  rw [hrange] at halg
  haveI : Nontrivial (MvPolynomial (Fin n) L ⧸ P) := inferInstance
  obtain ⟨t, hts, htb⟩ := exists_isTranscendenceBasis_subset (R := L)
    (Set.range fun k : Fin n => Ideal.Quotient.mk P (X k : MvPolynomial (Fin n) L))
  have htfin : t.Finite := (Set.finite_range _).subset hts
  haveI : Fintype t := htfin.fintype
  have hcard : Fintype.card t = rk P := by
    have h1 := htb.cardinalMk_eq_trdeg
    rw [← rk_cast, Cardinal.mk_fintype] at h1
    exact_mod_cast h1
  let e : Fin (rk P) ≃ t := (Fintype.equivFinOfCardEq hcard).symm
  have hpre : ∀ τ : t, ∃ j : Fin n, Ideal.Quotient.mk P (X j : MvPolynomial (Fin n) L) = τ :=
    fun τ => hts τ.2
  choose J hJ using hpre
  refine ⟨⟨fun k => J (e k), fun a b hab => e.injective (Subtype.ext ?_)⟩, ?_⟩
  · have := congrArg (fun j => Ideal.Quotient.mk P (X j : MvPolynomial (Fin n) L)) hab
    simp only at this
    rw [hJ, hJ] at this
    exact this
  · have hli : AlgebraicIndependent L (fun k : Fin (rk P) => ((e k : t) : MvPolynomial (Fin n) L ⧸ P)) :=
      htb.1.comp _ e.injective
    convert hli using 1
    funext k
    exact hJ (e k)
theorem card_level_le (G : Finset (MvPolynomial (Fin n) L)) (h : MvPolynomial (Fin n) L)
    (d e r : ℕ) (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hh : h.totalDegree ≤ e) (hdim : DimLE G h r)
    (S : Finset (Ideal (MvPolynomial (Fin n) L)))
    (hS : ∀ P ∈ S, P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes ∧ h ∉ P ∧
      rk P = r) :
    S.card ≤ n ^ r * fiberBound (n - r + 1) (max d (e+1)) := by
  classical
  have hcover : S ⊆ (Finset.univ : Finset (Fin r ↪ Fin n)).biUnion fun κ =>
      S.filter fun P => AlgebraicIndependent L
        (fun i => Ideal.Quotient.mk P (X (κ i) : MvPolynomial (Fin n) L)) := by
    intro P hP
    obtain ⟨hPmin, _, hrk⟩ := hS P hP
    haveI : P.IsPrime := hPmin.1.1
    obtain ⟨κ, hκ⟩ := exists_coordinate_basis P r hrk
    rw [Finset.mem_biUnion]
    exact ⟨κ, Finset.mem_univ _, Finset.mem_filter.mpr ⟨hP, hκ⟩⟩
  calc S.card ≤ ∑ κ : Fin r ↪ Fin n, (S.filter fun P => AlgebraicIndependent L
        (fun i => Ideal.Quotient.mk P (X (κ i) : MvPolynomial (Fin n) L))).card :=
        (Finset.card_le_card hcover).trans Finset.card_biUnion_le
    _ ≤ ∑ _κ : Fin r ↪ Fin n, fiberBound (n - r + 1) (max d (e+1)) := by
        refine Finset.sum_le_sum fun κ _ => ?_
        refine card_coordinate_components_le G h d e hG hh hdim κ _ fun P hP => ?_
        rw [Finset.mem_filter] at hP
        exact ⟨(hS P hP.1).1, (hS P hP.1).2.1, hP.2⟩
    _ = Fintype.card (Fin r ↪ Fin n) * fiberBound (n - r + 1) (max d (e+1)) := by simp
    _ ≤ n ^ r * fiberBound (n - r + 1) (max d (e+1)) := by
        refine Nat.mul_le_mul_right _ ?_
        rw [Fintype.card_embedding_eq, Fintype.card_fin, Fintype.card_fin]
        exact Nat.descFactorial_le_pow n r
end Peeling
def peelAcc (n d : ℕ) : ℕ → ℕ × ℕ × ℕ
  | 0 => (0, 0, 0)
  | k+1 =>
    let acc := peelAcc n d k
    let M := fiberBound (k + 1) (max d (acc.2.1 * acc.1 + 1))
    (max acc.1 ((n - k + 1) * M), acc.2.1 + n ^ (n - k) * M, max acc.2.2 M)
def componentSep (n d : ℕ) : ℕ := (peelAcc n d (n+1)).1
def componentCount (n d : ℕ) : ℕ := (peelAcc n d (n+1)).2.1
