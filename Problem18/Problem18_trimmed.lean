  inv : (F.p + 1) ^ (F.e + 1) < W
theorem Glob.transfer {W Sn bankLen : Nat} {σ τ : Env} (h : Glob F W Sn bankLen σ)
    (he : τ.vars canonical.e = σ.vars canonical.e) (hp : τ.vars canonical.p = σ.vars canonical.p)
    (hm : τ.vars canonical.modBase = σ.vars canonical.modBase)
    (hmod : ∀ i : Fin F.e, (τ.arrs canonical.mem).getD i.val 0 =
      (σ.arrs canonical.mem).getD i.val 0)
    (hlen : ∀ arr, (τ.arrs arr).length = (σ.arrs arr).length) : Glob F W Sn bankLen τ :=
  { e_reg := he.trans h.e_reg, p_reg := hp.trans h.p_reg, mod_reg := hm.trans h.mod_reg,
    modulus := fun i => (hmod i).trans (h.modulus i),
    mem_len := (hlen _).trans h.mem_len, mem_word := (hlen _) ▸ h.mem_word,
    scratch_fit := (hlen canonical.scratch).symm ▸ h.scratch_fit,
    scratch_word := (hlen canonical.scratch).symm ▸ h.scratch_word,
    bank_len := (hlen _).trans h.bank_len, bank_word := h.bank_word,
    arith := h.arith, inv := h.inv }
theorem Glob.valid {W Sn bankLen : Nat} {σ : Env} (h : Glob F W Sn bankLen σ)
    (hcoef : ∀ j < (σ.arrs canonical.mem).length, (σ.arrs canonical.mem).getD j 0 < F.p) :
    ValidMemory F W σ where
  degree := h.e_reg
  prime := h.p_reg
  arithmetic_word := h.arith
  inverse_word := h.inv
  memory_word := h.mem_word
  scratch_word := h.scratch_word
