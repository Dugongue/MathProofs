variable {K σ : Type*} [Field K] [Fintype σ] [DecidableEq σ]
noncomputable def boxExponent (d : σ → ℕ) (a : ∀ i, Fin (d i)) : σ →₀ ℕ :=
  (Finsupp.linearEquivFunOnFinite ℕ ℕ σ).symm (fun i => a i)
@[simp]
theorem boxExponent_apply (d : σ → ℕ) (a : ∀ i, Fin (d i)) (i : σ) :
    boxExponent d a i = a i := by
  simp [boxExponent]
noncomputable def boxResidue (I : Ideal (MvPolynomial σ K)) (d : σ → ℕ)
    (a : ∀ i, Fin (d i)) : (MvPolynomial σ K) ⧸ I :=
  Ideal.Quotient.mk I (monomial (boxExponent d a) 1)
theorem span_boxResidue_eq_top
    (m : MonomialOrder σ) (g : σ → MvPolynomial σ K)
    (I : Ideal (MvPolynomial σ K)) (d : σ → ℕ)
    (hunit : ∀ i, IsUnit (m.leadingCoeff (g i)))
    (hpure : ∀ i, m.degree (g i) = Finsupp.single i (d i))
    (hgI : ∀ i, g i ∈ I) :
    Submodule.span K (Set.range (boxResidue I d)) = ⊤ := by
  classical
  rw [Submodule.eq_top_iff']
  intro y
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
  obtain ⟨q, r, hfr, _hdegree, hreduced⟩ := m.div hunit f
  have hspan : Ideal.span (Set.range g) ≤ I :=
    Ideal.span_le.mpr (by rintro _ ⟨i, rfl⟩; exact hgI i)
  have hcomb : Finsupp.linearCombination (MvPolynomial σ K) g q ∈ I := by
    apply hspan
    rw [Finsupp.mem_ideal_span_range_iff_exists_finsupp]
    refine ⟨q, ?_⟩
    change (q.sum fun i a => a • g i) =
      Finsupp.linearCombination (MvPolynomial σ K) g q
    exact (Finsupp.linearCombination_apply (R := MvPolynomial σ K) q).symm
  have hdiff : f - r ∈ I := by
    rw [hfr, add_sub_cancel_right]
    exact hcomb
  have hmk : Ideal.Quotient.mk I f = Ideal.Quotient.mk I r := by
    apply sub_eq_zero.mp
    rw [← map_sub, Ideal.Quotient.eq_zero_iff_mem]
    exact hdiff
  rw [hmk, MvPolynomial.as_sum r, map_sum]
  apply Submodule.sum_mem
  intro c hc
  have hlt : ∀ i, c i < d i := by
    intro i
    have hnot := hreduced c hc i
    rw [hpure i] at hnot
    simpa only [Finsupp.single_le_iff, not_le] using hnot
  let a : ∀ i, Fin (d i) := fun i => ⟨c i, hlt i⟩
  have ha : boxExponent d a = c := by
    ext i
    simp [a]
  have hbase : boxResidue I d a ∈
      Submodule.span K (Set.range (boxResidue I d)) :=
    Submodule.subset_span ⟨a, rfl⟩
  have hmono : monomial c (coeff c r) = coeff c r • monomial c (1 : K) := by
    rw [MvPolynomial.smul_monomial]
    simp
  change (Ideal.Quotient.mkₐ K I) (monomial c (coeff c r)) ∈
    Submodule.span K (Set.range (boxResidue I d))
  rw [hmono, map_smul, ← ha]
  exact Submodule.smul_mem _ _ hbase
noncomputable def boxCoordinateMap (I : Ideal (MvPolynomial σ K)) (d : σ → ℕ) :
    ((∀ i, Fin (d i)) → K) →ₗ[K] ((MvPolynomial σ K) ⧸ I) :=
  Fintype.linearCombination K (boxResidue I d)
theorem boxCoordinateMap_surjective
    (m : MonomialOrder σ) (g : σ → MvPolynomial σ K)
    (I : Ideal (MvPolynomial σ K)) (d : σ → ℕ)
    (hunit : ∀ i, IsUnit (m.leadingCoeff (g i)))
    (hpure : ∀ i, m.degree (g i) = Finsupp.single i (d i))
    (hgI : ∀ i, g i ∈ I) :
    Function.Surjective (boxCoordinateMap I d) := by
  exact (span_range_eq_top_iff_surjective_fintypeLinearCombination
    (R := K) (v := boxResidue I d)).mp
      (span_boxResidue_eq_top m g I d hunit hpure hgI)
theorem quotient_finrank_le_box
    (m : MonomialOrder σ) (g : σ → MvPolynomial σ K)
    (I : Ideal (MvPolynomial σ K)) (d : σ → ℕ)
    (hunit : ∀ i, IsUnit (m.leadingCoeff (g i)))
    (hpure : ∀ i, m.degree (g i) = Finsupp.single i (d i))
    (hgI : ∀ i, g i ∈ I) :
    Module.finrank K ((MvPolynomial σ K) ⧸ I) ≤ ∏ i, d i := by
  have hs := boxCoordinateMap_surjective m g I d hunit hpure hgI
  have hdim := LinearMap.finrank_le_finrank_of_surjective hs
  simpa only [boxCoordinateMap, Module.finrank_fintype_fun_eq_card,
    Fintype.card_pi, Fintype.card_fin] using hdim
end Mathproof.Problem18BoundedQuotientCoordinates20260930
