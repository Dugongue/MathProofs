    AddHom.coe_mk, hyperbolicPairStrict, Pi.add_apply]
  rw [← Finset.sum_sub_distrib, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro p _
  have htwo : (2 : K) = 0 := CharP.cast_eq_zero K 2
  rw [show x.1 p.1.1 * x.2 p.1.2 + x.1 p.1.2 * x.2 p.1.1 =
      (x.1 p.1.1 + x.2 p.1.1) * (x.1 p.1.2 + x.2 p.1.2) -
        x.1 p.1.1 * x.1 p.1.2 - x.2 p.1.1 * x.2 p.1.2 by
    rw [sub_eq_add_neg, sub_eq_add_neg]
    have hn (a : K) : -a = a := CharTwo.neg_eq a
