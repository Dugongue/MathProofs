variable {K : Type} [Field K]
theorem plane_prime_principal (I : Ideal (MvPolynomial (Fin 2) K)) [I.IsPrime]
    (hne : I ≠ ⊥) (hdim : 1 ≤ Algebra.trdeg K (MvPolynomial (Fin 2) K ⧸ I)) :
    ∃ s : MvPolynomial (Fin 2) K, s ≠ 0 ∧ I = Ideal.span {s} := by
  obtain ⟨s, hs, hp⟩ := Ideal.IsPrime.exists_mem_prime_of_ne_bot ‹I.IsPrime› hne
  let J : Ideal (MvPolynomial (Fin 2) K) := Ideal.span {s}
  haveI : J.IsPrime := (Ideal.span_singleton_prime hp.ne_zero).mpr hp
  have hJ : J ≠ ⊥ := by
    intro h
    exact hp.ne_zero (Ideal.span_singleton_eq_bot.mp h)
  have hJI : J ≤ I := I.span_singleton_le_iff_mem.mpr hs
  have hlt : Algebra.trdeg K (MvPolynomial (Fin 2) K ⧸ J) < 2 := by
    have h := trdeg_quotient_lt (k := K) J hJ
    simpa [MvPolynomial.trdeg_of_isDomain] using h
  obtain ⟨m, hm⟩ := Cardinal.lt_aleph0.mp (hlt.trans (Cardinal.nat_lt_aleph0 2))
  have hm2 : m < 2 := by rw [hm] at hlt; exact_mod_cast hlt
  refine ⟨s, hp.ne_zero, ?_⟩
  by_contra hne'
  have hstrict : J < I := lt_of_le_of_ne hJI (Ne.symm hne')
  obtain ⟨r, hr, he⟩ := exists_trdeg_lt_of_lt J I m hm hstrict
  rw [he] at hdim
  have hr1 : 1 ≤ r := by exact_mod_cast hdim
  omega
theorem bounded_plane_generator (I : Ideal (MvPolynomial (Fin 2) K)) [I.IsPrime]
    (hdim : 1 ≤ Algebra.trdeg K (MvPolynomial (Fin 2) K ⧸ I)) (B : Nat)
    (hrel : ∀ i : Fin 2, ∃ g : MvPolynomial (Fin 2) K,
      g ≠ 0 ∧ g ∈ I ∧ g.degreeOf i ≤ B) :
    ∃ s : MvPolynomial (Fin 2) K, s ≠ 0 ∧ s ∈ I ∧ s.totalDegree ≤ 2*B := by
  have hne : I ≠ ⊥ := by
    obtain ⟨g, hg, hmem, -⟩ := hrel 0
    intro he
    exact hg (by simpa [he] using hmem)
  obtain ⟨s, hs, he⟩ := plane_prime_principal I hne hdim
  have hdeg : ∀ i : Fin 2, s.degreeOf i ≤ B := by
    intro i
    obtain ⟨g, hg, hmem, hB⟩ := hrel i
    rw [he, Ideal.mem_span_singleton] at hmem
    obtain ⟨c, hc⟩ := hmem
    have hc0 : c ≠ 0 := by intro hz; rw [hz, mul_zero] at hc; exact hg hc
    calc
      s.degreeOf i ≤ s.degreeOf i + c.degreeOf i := Nat.le_add_right _ _
      _ = g.degreeOf i := by rw [hc, degreeOf_mul_eq hs hc0]
      _ ≤ B := hB
  refine ⟨s, hs, he ▸ Ideal.subset_span (Set.mem_singleton s), ?_⟩
  calc
    s.totalDegree ≤ ∑ i : Fin 2, s.degreeOf i := totalDegree_le_sum_degreeOf s
    _ ≤ ∑ _i : Fin 2, B := Finset.sum_le_sum fun i _ => hdeg i
    _ = 2*B := by simp [Nat.mul_comm]
end Mathproof.Problem18PlaneRelationBound20261001
