namespace Mathproof.Problem18BoundedEncoding20260930
open MvPolynomial
abbrev OuterVar (a b : ℕ) := (Fin a × Fin a) ⊕ (Fin b × Fin b)
abbrev OuterCoordVar (a b : ℕ) := Fin 2 × OuterVar a b
inductive PolyExpr (σ K : Type*) where
  | const : K → PolyExpr σ K
  | var : σ → PolyExpr σ K
  | add : PolyExpr σ K → PolyExpr σ K → PolyExpr σ K
  | mul : PolyExpr σ K → PolyExpr σ K → PolyExpr σ K
namespace PolyExpr
variable {σ K : Type*}
def zero [Zero K] : PolyExpr σ K := .const 0
def neg [Ring K] (f : PolyExpr σ K) : PolyExpr σ K := .mul (.const (-1)) f
def sub [Ring K] (f g : PolyExpr σ K) : PolyExpr σ K := .add f (neg g)
def sum [Zero K] : List (PolyExpr σ K) → PolyExpr σ K
  | [] => zero
  | f :: fs => .add f (sum fs)
def degree : PolyExpr σ K → ℕ
  | .const _ => 0
  | .var _ => 1
  | .add f g => max f.degree g.degree
  | .mul f g => f.degree + g.degree
def eval [Semiring K] (x : σ → K) : PolyExpr σ K → K
  | .const c => c
  | .var i => x i
  | .add f g => f.eval x + g.eval x
  | .mul f g => f.eval x * g.eval x
end PolyExpr
open PolyExpr
variable {σ K : Type*}
theorem degree_neg [Ring K] (f : PolyExpr σ K) : (neg f).degree = f.degree := by
  simp [neg, degree]
theorem degree_sub [Ring K] (f g : PolyExpr σ K) :
    (sub f g).degree = max f.degree g.degree := by
  simp [sub, degree, degree_neg]
theorem degree_sum_le [Zero K] (fs : List (PolyExpr σ K)) (d : ℕ)
    (h : ∀ f ∈ fs, f.degree ≤ d) : (sum fs).degree ≤ d := by
  induction fs with
  | nil => simp [sum, zero, degree]
  | cons f fs ih =>
      simp only [sum, degree, max_le_iff]
      exact ⟨h f (by simp), ih (fun g hg => h g (by simp [hg]))⟩
@[simp] theorem eval_sum [Semiring K] (x : σ → K) (fs : List (PolyExpr σ K)) :
    (sum fs).eval x = (fs.map (eval x)).sum := by
  induction fs with
  | nil => simp [sum, zero, PolyExpr.eval]
  | cons f fs ih => simp [sum, PolyExpr.eval, ih]
def PolyExpr.sumFin [Zero K] (n : ℕ) (f : Fin n → PolyExpr σ K) : PolyExpr σ K :=
  sum ((List.finRange n).map f)
theorem degree_sumFin_le [Zero K] (n d : ℕ) (f : Fin n → PolyExpr σ K)
    (h : ∀ i, (f i).degree ≤ d) : (sumFin n f).degree ≤ d := by
  apply degree_sum_le
  intro g hg
  simp only [sumFin, List.mem_map, List.mem_finRange, true_and] at hg
  obtain ⟨i, rfl⟩ := hg
  exact h i
@[simp] theorem eval_sumFin [Semiring K] (x : σ → K) (n : ℕ)
    (f : Fin n → PolyExpr σ K) :
    (sumFin n f).eval x =
      ((List.finRange n).map fun i => (f i).eval x).sum := by
  rw [sumFin, eval_sum, List.map_map]
  rfl
variable {K : Type*}
def pEntry {a b : ℕ} (i j : Fin a) : PolyExpr (OuterVar a b) K :=
  .var (.inl (i,j))
def rEntry {a b : ℕ} (i j : Fin b) : PolyExpr (OuterVar a b) K :=
  .var (.inr (i,j))
def tensorEntry {a b : ℕ} (ij uv : Fin a × Fin b) :
    PolyExpr (OuterVar a b) K :=
  .mul (pEntry ij.1 uv.1) (rEntry ij.2 uv.2)
theorem tensorEntry_degree {a b : ℕ} (ij uv : Fin a × Fin b) :
    (tensorEntry (K := K) ij uv).degree = 2 := rfl
@[simp] theorem eval_tensorEntry [Semiring K] {a b : ℕ}
    (x : OuterVar a b → K) (ij uv : Fin a × Fin b) :
    (tensorEntry ij uv).eval x = x (.inl (ij.1,uv.1)) * x (.inr (ij.2,uv.2)) := rfl
def transformedEntry [Semiring K] {a b c : ℕ}
    (F : Fin c → (Fin a × Fin b) → K) (s : Fin c) (ij : Fin a × Fin b) :
    PolyExpr (OuterVar a b) K :=
  sumFin a fun u => sumFin b fun v =>
    PolyExpr.mul (.const (F s (u,v))) (tensorEntry ij (u,v))
theorem transformedEntry_degree_le [Semiring K] {a b c : ℕ}
    (F : Fin c → (Fin a × Fin b) → K) (s : Fin c) (ij : Fin a × Fin b) :
    (transformedEntry F s ij).degree ≤ 2 := by
  apply degree_sumFin_le
  intro u
  apply degree_sumFin_le
  intro v
  simp [degree, tensorEntry_degree]
def preservesPEntry [Ring K] {a b : ℕ} (J : Fin a → Fin a → K) (i j : Fin a) :
    PolyExpr (OuterVar a b) K :=
  sub (sumFin a fun u => sumFin a fun v =>
    .mul (.mul (pEntry u i) (.const (J u v))) (pEntry v j))
    (.const (J i j))
def preservesREntry [Ring K] {a b : ℕ} (J : Fin b → Fin b → K) (i j : Fin b) :
    PolyExpr (OuterVar a b) K :=
  sub (sumFin b fun u => sumFin b fun v =>
    .mul (.mul (rEntry u i) (.const (J u v))) (rEntry v j))
    (.const (J i j))
theorem preservesPEntry_degree_le [Ring K] {a b : ℕ}
    (J : Fin a → Fin a → K) (i j : Fin a) :
    (preservesPEntry (b := b) J i j).degree ≤ 2 := by
  simp only [preservesPEntry, degree_sub, degree]
  apply max_le
  · apply degree_sumFin_le
    intro u
    apply degree_sumFin_le
    intro v
    simp [degree, pEntry]
  · omega
theorem preservesREntry_degree_le [Ring K] {a b : ℕ}
    (J : Fin b → Fin b → K) (i j : Fin b) :
    (preservesREntry (a := a) J i j).degree ≤ 2 := by
  simp only [preservesREntry, degree_sub, degree]
  apply max_le
  · apply degree_sumFin_le
    intro u
    apply degree_sumFin_le
    intro v
    simp [degree, rEntry]
  · omega
def kernelEntry [Ring K] {a b c k : ℕ}
    (F : Fin c → (Fin a × Fin b) → K)
    (ker : Fin k → (Fin a × Fin b) → K) (s : Fin c) (t : Fin k) :
    PolyExpr (OuterVar a b) K :=
  sumFin a fun i => sumFin b fun j =>
    .mul (transformedEntry F s (i,j)) (.const (ker t (i,j)))
def pulledBackEntry [Ring K] {a b c : ℕ}
    (F G : Fin c → (Fin a × Fin b) → K) (J : Fin c → Fin c → K)
    (i j : Fin a × Fin b) : PolyExpr (OuterVar a b) K :=
  sub (sumFin c fun s => sumFin c fun t =>
      .mul (.mul (transformedEntry F s i) (.const (J s t)))
        (transformedEntry F t j))
    (.const (∑ s, ∑ t, G s i * J s t * G t j))
abbrev AugmentedColumn (a b : ℕ) := (Fin a × Fin b) ⊕ Unit
def augmentedScalar [Zero K] {a b c : ℕ} (F : Fin c → (Fin a × Fin b) → K)
    (e : Fin c → K) (s : Fin c) : AugmentedColumn a b → K
  | .inl (i,j) => F s (i,j)
  | .inr _ => e s
def augmentedKernelEntry [Ring K] {a b c k : ℕ}
    (F : Fin c → (Fin a × Fin b) → K) (e : Fin c → K)
    (ker : Fin k → AugmentedColumn a b → K) (s : Fin c) (t : Fin k) :
    PolyExpr (OuterVar a b) K :=
  add (sumFin a fun i => sumFin b fun j =>
      .mul (transformedEntry F s (i,j)) (.const (ker t (.inl (i,j)))))
    (.mul (.const (e s)) (.const (ker t (.inr ()))))
theorem augmentedKernelEntry_degree_le [Ring K] {a b c k : ℕ}
    (F : Fin c → (Fin a × Fin b) → K) (e : Fin c → K)
    (ker : Fin k → AugmentedColumn a b → K) (s : Fin c) (t : Fin k) :
    (augmentedKernelEntry F e ker s t).degree ≤ 2 := by
  simp only [augmentedKernelEntry, degree, max_le_iff]
  constructor
  · apply degree_sumFin_le
    intro i
    apply degree_sumFin_le
    intro j
    simpa only [degree, Nat.add_zero] using transformedEntry_degree_le F s (i,j)
  · omega
theorem ker_eq_of_le_of_finrank_range_eq {𝕜 V W : Type*} [Field 𝕜]
    [AddCommGroup V] [Module 𝕜 V] [AddCommGroup W] [Module 𝕜 W]
    [FiniteDimensional 𝕜 V] (C G : V →ₗ[𝕜] W)
    (hle : LinearMap.ker G ≤ LinearMap.ker C)
    (hrank : Module.finrank 𝕜 (LinearMap.range C) =
      Module.finrank 𝕜 (LinearMap.range G)) :
    LinearMap.ker G = LinearMap.ker C := by
  apply Submodule.eq_of_le_of_finrank_eq hle
  have hC := LinearMap.finrank_range_add_finrank_ker C
  have hG := LinearMap.finrank_range_add_finrank_ker G
  omega
end Mathproof.Problem18BoundedEncoding20260930
