variable {K : Type*} [Field K] [DecidableEq K] [StarRing K] {a b c : ℕ}
def oddNormalizer (card : ℕ) (d : K) : Bool := decide (d^(card/2)=1)
def unitaryFinal (H B : RectTensor a b c K) (d : K) : Bool :=
  check finProdFinEquiv.symm H B && decide (d⁻¹ • (Hᴴ*H)=Bᴴ*B)
def oddFinal (card : ℕ) (H B : RectTensor a b c K) (d : K) : Bool :=
  oddNormalizer card d⁻¹ && check finProdFinEquiv.symm H B &&
    decide (d⁻¹ • (H.transpose*H)=B.transpose*B)
def charTwoFinal (card : ℕ) (H B : RectTensor a b c K) (d : K) : Bool :=
  markedCheck finProdFinEquiv.symm (d⁻¹^(card/2) • H) B (fun _=>1) &&
    decide (d⁻¹ • (H.transpose*H)=B.transpose*B)
theorem scalarNorm_scale_iff (d z : K) (hd : d≠0) : scalarNorm z*d=1 ↔ scalarNorm z=d⁻¹ := by
  constructor
  · intro h
    calc scalarNorm z=(scalarNorm z*d)*d⁻¹ := by rw [mul_assoc,mul_inv_cancel₀ hd,mul_one]
         _=d⁻¹ := by rw [h,one_mul]
  · intro h
    rw [h,inv_mul_cancel₀ hd]
theorem finalScalar_norm_iff (H B : RectTensor a b c K) (d : K) (hd : d≠0) :
    FinalScalar H B d ↔ ∃u : K,star u*u=d⁻¹ ∧ ∃R : Matrix (Fin c) (Fin c) K,
      IsUnitary R ∧ R*(u • H)=B := by
  unfold FinalScalar
  simp_rw [scalarNorm_scale_iff d _ hd]
  rfl
theorem normalizer_iff_square [TrivialStar K] (d : K) (hd : d≠0) :
    (∃z : K,scalarNorm z*d=1) ↔ IsSquare d := by
  simp_rw [scalarNorm_scale_iff d _ hd]
  simp only [scalarNorm,star_trivial]
  rw [←isSquare_inv]
  exact ⟨fun ⟨z,hz⟩=>⟨z,hz.symm⟩,fun ⟨z,hz⟩=>⟨z,hz.symm⟩⟩
theorem oddNormalizer_correct [Fintype K] [TrivialStar K]
    (hchar : ringChar K≠2) (d : K) (hd : d≠0) :
    oddNormalizer (Fintype.card K) d=true ↔ ∃z : K,scalarNorm z*d=1 := by
  rw [oddNormalizer,decide_eq_true_eq,normalizer_iff_square d hd]
  exact (FiniteField.isSquare_iff hchar hd).symm
theorem unitary_normalizer [Fintype K] {F : Type*} [Field F] [Fintype F] [Algebra F K]
    (hc : Nat.card K=Nat.card F^2) (hs : ∀x : K,star x=x^Nat.card F)
    (d : K) (hd : d≠0) (hfix : star d=d) : ∃z : K,scalarNorm z*d=1 := by
  obtain ⟨z,hz⟩:=Problem18HermitianWitt20260929.hermitian_scalar_normalizer hc hs d hd hfix
  exact ⟨z,hz⟩
theorem charTwo_normalizer [Fintype K] [TrivialStar K] (hchar : ringChar K=2)
    (d : K) (hd : d≠0) : ∃z : K,scalarNorm z*d=1 :=
  (normalizer_iff_square d hd).mpr (FiniteField.isSquare_of_char_two hchar d)
theorem unitaryFinal_correct [Fintype K] {F : Type*} [Field F] [Fintype F] [Algebra F K]
    (hc : Nat.card K=Nat.card F^2) (hs : ∀x : K,star x=x^Nat.card F)
    (H B : RectTensor a b c K) (d : K) (hd : d≠0) (hfix : star d=d) :
    unitaryFinal H B d=true ↔ FinalScalar H B d := by
  rw [unitaryFinal,Bool.and_eq_true,check_correct,decide_eq_true_eq,finalScalar_norm_iff H B d hd]
  exact (scaled_unitary_factor_iff hc hs H B d⁻¹ (inv_ne_zero hd)
    (by simp only [star_inv₀,hfix])).symm
theorem oddFinal_correct [Fintype K] [TrivialStar K] [NeZero (2 : K)]
    (hchar : ringChar K≠2) (H B : RectTensor a b c K) (d : K) (hd : d≠0) :
    oddFinal (Fintype.card K) H B d=true ↔ FinalScalar H B d := by
  rw [oddFinal,Bool.and_eq_true,Bool.and_eq_true,oddNormalizer,decide_eq_true_eq,
    check_correct,decide_eq_true_eq,finalScalar_norm_iff H B d hd]
  rw [←FiniteField.isSquare_iff hchar (inv_ne_zero hd)]
  simp only [star_trivial,FiniteFieldOrthogonalUnitaryTI.IsUnitary,
    Matrix.conjTranspose_eq_transpose_of_trivial]
  exact and_assoc.trans (scaled_odd_factor_iff H B d⁻¹ (inv_ne_zero hd)).symm
theorem charTwoFinal_correct [Fintype K] [TrivialStar K] [CharP K 2]
    (H B : RectTensor a b c K) (d : K) (hd : d≠0) :
    charTwoFinal (Fintype.card K) H B d=true ↔ FinalScalar H B d := by
  rw [charTwoFinal,Bool.and_eq_true,markedCheck_correct,decide_eq_true_eq,
    finalScalar_norm_iff H B d hd]
  simp only [star_trivial,FiniteFieldOrthogonalUnitaryTI.IsUnitary,
    Matrix.conjTranspose_eq_transpose_of_trivial]
  simpa only [Problem18CharTwoScaledRecovery20260930.squareRoot,
    Problem18CharTwoOrthogonalColumn20260930.standardMarker_eq_one,
    Problem18OrthogonalAssembly.IsOrthogonal] using
    (Problem18CharTwoScaledRecovery20260930.explicit_scaled_factor_iff H B d⁻¹).symm
end Mathproof.Problem18LargeFinalChecks20261001
