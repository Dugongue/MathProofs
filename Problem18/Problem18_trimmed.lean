  ext i k
  have hx : (fun k : Fin n=>if k.val=i.val then (1:K) else 0) ∈ Submodule.span K (Set.range (fun a b=>V a b)) := by
    have hrow : ∀x : Fin n → K,x ∈ Submodule.span K (Set.range (fun a b=>V a b)) := by
      intro x
      have hx' : x=∑ j,(Matrix.vecMul x V⁻¹) j • (fun b=>V j b) := by
        funext b
