      Problem18RecursiveWorkspaceChain20261002.cost F n M l (collDeg n d) ≤
      (stepCoefficient n d+coefficient n l (collDeg n d))*scale F M
    nlinarith
theorem run_bounded (F : FieldPresentation K) (n l d S B M : Nat)
    (rows : List (DenseInput n d K)) (σ : Env)
    (h : Problem18RecursiveWorkspace20261002.Loaded F n l d S B M rows σ) :
