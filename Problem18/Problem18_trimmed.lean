        (N*(coordinateCost F q+20)+1) ∧
      ValidMemory F B τ ∧ Slots F canonical names.q.WS S B τ ∧
      (∀i:Fin N,
        (val F canonical names.q.WS τ (o+2*i.val),val F canonical names.q.WS τ (o+2*i.val+1))=
        (((rootCoordinates F d (val F canonical names.q.WS σ (s+i.val))).1:K),
         ((rootCoordinates F d (val F canonical names.q.WS σ (s+i.val))).2:K))) ∧
