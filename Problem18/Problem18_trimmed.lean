    Matrix.mul_smul]
theorem scalar_corrected_second (B : RectTensor a b c K) (Q : Matrix (Fin b) (Fin b) K)
    (hQ : IsUnitary Q) (z : K) (hz : z≠0) (kl : Fin b×Fin b) :
    (star z*z) • secondFamily (undoFirst B (z • Q)) kl=secondFamily (undoFirst B Q) kl := by
  rw [undoFirst_scalar B Q hQ z hz]
  have he : middleSlice (z⁻¹ • undoFirst B Q)=fun k=>z⁻¹ • middleSlice (undoFirst B Q) k := rfl
  simp only [secondFamily,he,Problem18CorrectedCrossGram20260930.crossGram_smul,smul_smul]
  have hc : (star z*z)*(star (z⁻¹)*z⁻¹)=1 := by
    rw [star_inv₀]
    field_simp [hz,star_ne_zero.mpr hz]
  rw [hc,one_smul]
theorem gramScalar_smul_unitary (hb : 0 < b) (Q : Matrix (Fin b) (Fin b) K)
    (hQ : IsUnitary Q) (z : K) : gramScalar hb (z • Q)=star z*z := by
  change Qᴴ*Q=1 at hQ
  simp only [gramScalar,Matrix.conjTranspose_smul,Matrix.smul_mul,Matrix.mul_smul,
    smul_smul,hQ]
  simp [mul_comm]
theorem actual_second_correction (hb : 0 < b) (A B : RectTensor a b c K)
    (hA : Good A) (X Q : Matrix (Fin b) (Fin b) K)
    (hx : firstSolution A B=some X) (hQ : IsUnitary Q)
    (hQi : ∀j,Q*firstFamily A j=firstFamily B j*Q) :
    secondTarget B X (gramScalar hb X)=secondIndexed (undoFirst B Q) := by
  letI : Nonempty (Fin b):=⟨⟨0,hb⟩⟩
  have hh:=intertwiner_some _ _ X hx
  have hQ0 : Q≠0 := by
    intro he
    have hz : Qᴴ*Q=1:=hQ
    rw [he,Matrix.mul_zero] at hz
    exact zero_ne_one hz
  obtain ⟨z,hz⟩:=intertwiner_line (firstFamily A) (firstFamily B) Q X hQ0 hA.1 hQi hh.2
  have hz0 : z≠0 := by
    intro he
    apply hh.1
    simpa [he] using hz
  subst X
  ext t i j
  change (gramScalar hb (z • Q) • secondFamily (undoFirst B (z • Q))
    (finProdFinEquiv.symm t)) i j = _
  rw [gramScalar_smul_unitary hb Q hQ z,scalar_corrected_second B Q hQ z hz0]
  rfl
end Mathproof.Problem18TwoIntertwinerRecovery20261001
end
