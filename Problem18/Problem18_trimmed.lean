  exact h1
end AutFacts
theorem liftNormal_constants {C M E L : Type*} [Field C] [Field M] [Field E] [Field L]
    [Algebra C M] [Algebra C L] [Algebra M L] [IsScalarTower C M L] [Normal C L]
    [Algebra E M] [Algebra E L] [IsScalarTower E M L]
    (φ : M ≃ₐ[C] M) (τ : E → E) (hφ : ∀ c, φ (algebraMap E M c) = algebraMap E M (τ c))
    (c : E) : φ.liftNormal L (algebraMap E L c) = algebraMap E L (τ c) := by
  have h1 := IsScalarTower.algebraMap_apply E M L c
  have h2 := IsScalarTower.algebraMap_apply E M L (τ c)
  rw [h1, h2, AlgEquiv.liftNormal_commutes, hφ]
section GenusPiece
theorem genus_of_cover {E₀ M E L : Type*} [Field E₀] [Field M] [Field E] [Field L]
    [Fintype E₀] [Finite E] [Algebra E₀ M] [Algebra E₀ E] [Algebra E₀ L]
    [Algebra M L] [Algebra E L] [IsScalarTower E₀ M L] [IsScalarTower E₀ E L]
    [FiniteDimensional M L] [IsGalois M L] [FunctionField.IsFullConstantField E₀ M]
    [Algebra E₀[X] M] [Algebra E₀⟮X⟯ M] [IsScalarTower E₀ E₀[X] M]
    [IsScalarTower E₀[X] E₀⟮X⟯ M] [IsScalarTower E₀ E₀⟮X⟯ M] [_root_.FunctionField E₀ M]
    [Algebra.IsSeparable E₀⟮X⟯ M]
    [Algebra E[X] L] [Algebra E⟮X⟯ L] [IsScalarTower E E[X] L]
    [IsScalarTower E[X] E⟮X⟯ L] [IsScalarTower E E⟮X⟯ L] [_root_.FunctionField E L]
    [Algebra.IsSeparable E⟮X⟯ L]
    (hgen : constantCompositum M E L = ⊤) (hx : algebraMap M L (XK E₀ M) = XK E L) :
    letI := full_constant_extension_exact E₀ M E L hgen
    genus E L = genus E₀ M := by
  letI : Algebra E₀⟮X⟯ L := ((algebraMap M L).comp (algebraMap E₀⟮X⟯ M)).toAlgebra
  haveI : IsScalarTower E₀⟮X⟯ M L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : IsScalarTower E₀ E₀⟮X⟯ L := IsScalarTower.of_algebraMap_eq fun c => by
    change algebraMap E₀ L c = algebraMap M L (algebraMap E₀⟮X⟯ M (algebraMap E₀ E₀⟮X⟯ c))
    rw [← IsScalarTower.algebraMap_apply E₀ E₀⟮X⟯ M, ← IsScalarTower.algebraMap_apply E₀ M L]
  have hX0 : algebraMap E₀⟮X⟯ L RatFunc.X = algebraMap E⟮X⟯ L RatFunc.X := hx
  haveI := chart_tower E₀ E L hX0
  exact genus_extension_eq E₀ M E L hgen hx
end GenusPiece
section CurvePieces
variable (k F K0 E L : Type*) [Field k] [Field F] [Field K0] [Field E] [Field L]
  [Fintype k] [Algebra k F] [Algebra k[X] F] [Algebra k⟮X⟯ F] [IsScalarTower k k[X] F]
  [IsScalarTower k[X] k⟮X⟯ F] [_root_.FunctionField k F] [Algebra.IsSeparable k⟮X⟯ F]
  [FunctionField.IsFullConstantField k F] [Algebra k K0]
  [Fintype K0] [Finite E] [Algebra K0 E] [Algebra K0 L] [Algebra E L]
  [IsScalarTower K0 E L]
  [Algebra K0⟮X⟯ L] [IsScalarTower K0 K0⟮X⟯ L] [IsGalois K0⟮X⟯ L]
  [Algebra F L] [Algebra k L] [IsScalarTower k F L] [IsScalarTower k K0 L] [FiniteDimensional F L]
  [hXC : Fact (algebraMap K0⟮X⟯ L RatFunc.X ∈ constantCompositum F K0 L)]
def curveField : IntermediateField K0⟮X⟯ L :=
  (constantCompositum F K0 L).toSubfield.toIntermediateField
    (ratFunc_mem ((constantCompositum F K0 L).toSubfield.toIntermediateField
      fun c => algebraMap_mem_constantCompositum F K0 L c) hXC.out)
def curveAlgF : Algebra F (curveField F K0 L) :=
  ((algebraMap F L).codRestrict (curveField F K0 L).toSubring
    (fun x => (constantCompositum F K0 L).algebraMap_mem x)).toAlgebra
attribute [local instance] curveAlgF
theorem curveTowerF : IsScalarTower F (curveField F K0 L) L :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl
attribute [local instance] curveTowerF
def curveAlgk : Algebra k (curveField F K0 L) :=
  ((algebraMap F (curveField F K0 L)).comp (algebraMap k F)).toAlgebra
attribute [local instance] curveAlgk
theorem curveTowerkF : IsScalarTower k F (curveField F K0 L) :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl
theorem curveTowerkK0 : IsScalarTower k K0 (curveField F K0 L) :=
  IsScalarTower.of_algebraMap_eq fun c => by
    apply Subtype.ext
    change algebraMap F L (algebraMap k F c) = algebraMap K0 L (algebraMap k K0 c)
    rw [← IsScalarTower.algebraMap_apply k F L, ← IsScalarTower.algebraMap_apply k K0 L]
attribute [local instance] curveTowerkF curveTowerkK0
theorem curveFinite : FiniteDimensional F (curveField F K0 L) :=
  FiniteDimensional.of_injective
    (IsScalarTower.toAlgHom F (curveField F K0 L) L).toLinearMap
    (algebraMap (curveField F K0 L) L).injective
attribute [local instance] curveFinite
theorem curve_gen : constantCompositum F K0 (curveField F K0 L) = ⊤ := by
  apply top_unique
  intro y _
  let ι : curveField F K0 L →ₐ[F] L := IsScalarTower.toAlgHom F (curveField F K0 L) L
  have hmap : (constantCompositum F K0 (curveField F K0 L)).map ι = constantCompositum F K0 L := by
    rw [constantCompositum_def, IntermediateField.adjoin_map, constantCompositum_def]
    congr 1
    ext x
    constructor
    · rintro ⟨z, ⟨c, rfl⟩, rfl⟩
      exact ⟨c, rfl⟩
    · rintro ⟨c, rfl⟩
      exact ⟨algebraMap K0 (curveField F K0 L) c, ⟨c, rfl⟩, rfl⟩
  have hy : (y : L) ∈ (constantCompositum F K0 (curveField F K0 L)).map ι := by
    rw [hmap]
    exact y.property
  obtain ⟨z, hz, hzy⟩ := (IntermediateField.mem_map _).mp hy
  have hzy' : z = y := Subtype.ext hzy
  rw [← hzy']
  exact hz
include k in
theorem curveFull : FunctionField.IsFullConstantField K0 (curveField F K0 L) :=
  full_constant_extension_exact k F K0 (curveField F K0 L) (curve_gen F K0 L)
theorem curveExtTower :
    IsScalarTower (curveField F K0 L) (curveExt K0 E L (curveField F K0 L)) L :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl
theorem curveGalois : IsGalois (curveField F K0 L) L :=
  IsGalois.tower_top_of_isGalois K0⟮X⟯ (curveField F K0 L) L
attribute [local instance] curveExtTower curveGalois
def frobFE : curveExt K0 E L (curveField F K0 L) ≃ₐ[curveField F K0 L]
    curveExt K0 E L (curveField F K0 L) :=
  haveI := curveFull k F K0 L
  AlgEquiv.ofRingEquiv
    (f := (tensorTwist K0 (curveField F K0 L) E (curveExt K0 E L (curveField F K0 L))
      (compositum_generated (curveField F K0 L) E L) AlgEquiv.refl
      (FiniteField.frobeniusAlgEquivOfAlgebraic K0 E)).toRingEquiv)
    (fun x => tensorTwist_left K0 (curveField F K0 L) E (curveExt K0 E L (curveField F K0 L))
      (compositum_generated (curveField F K0 L) E L) AlgEquiv.refl
      (FiniteField.frobeniusAlgEquivOfAlgebraic K0 E) x)
theorem frobFE_const (c : E) :
    frobFE k F K0 E L (algebraMap E (curveExt K0 E L (curveField F K0 L)) c) =
      algebraMap E (curveExt K0 E L (curveField F K0 L))
        (FiniteField.frobeniusAlgEquivOfAlgebraic K0 E c) := by
  haveI := curveFull k F K0 L
  exact tensorTwist_right K0 (curveField F K0 L) E (curveExt K0 E L (curveField F K0 L))
    (compositum_generated (curveField F K0 L) E L) AlgEquiv.refl
    (FiniteField.frobeniusAlgEquivOfAlgebraic K0 E) c
def frobLiftC : L ≃ₐ[curveField F K0 L] L := (frobFE k F K0 E L).liftNormal L
def frobLift : L ≃ₐ[K0] L := (frobLiftC k F K0 E L).restrictScalars K0
theorem frobLift_curve (c : curveField F K0 L) : frobLift k F K0 E L (c : L) = c :=
  (frobLiftC k F K0 E L).commutes c
theorem frobLift_X :
    frobLift k F K0 E L (algebraMap K0⟮X⟯ L RatFunc.X) = algebraMap K0⟮X⟯ L RatFunc.X :=
  frobLift_curve k F K0 E L ⟨_, (curveField F K0 L).algebraMap_mem _⟩
theorem frobLift_const (c : E) :
    frobLift k F K0 E L (algebraMap E L c) =
      algebraMap E L (FiniteField.frobeniusAlgEquivOfAlgebraic K0 E c) :=
  liftNormal_constants (M := curveExt K0 E L (curveField F K0 L)) (frobFE k F K0 E L)
    (FiniteField.frobeniusAlgEquivOfAlgebraic K0 E) (frobFE_const k F K0 E L) c
end CurvePieces
section Cover
variable (k F : Type) [Field k] [Field F] [Fintype k]
  [Algebra k F] [Algebra k[X] F] [Algebra k⟮X⟯ F] [IsScalarTower k k[X] F]
  [IsScalarTower k[X] k⟮X⟯ F] [IsScalarTower k k⟮X⟯ F] [_root_.FunctionField k F]
