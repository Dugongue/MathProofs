        (matrix F σ (σ.vars q.N)).mulVec (vector F σ (σ.vars q.i) (σ.vars q.N)) i+
          val F canonical q.WS σ (σ.vars q.c+σ.vars q.pv)*
            val F canonical q.WS σ (σ.vars q.w+i.val)) ∧
      (∀s<σ.vars q.i,s≠2 → s≠3 → s≠4 → val F canonical q.WS τ s=val F canonical q.WS σ s) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hfit:=h.work_fit
  have hac:=h.acc_before
  have hma:=h.matrix_before
  have hsv:=h.source_before
  have hco:=h.coeff_before
  have h5:=h.coeff5
  have hword:=h.slots.slots_word
