theorem length : (queryWords F u q A T).length=8+F.e+2*(a*b*c*F.e) := by
  simp [queryWords,header,List.length_append,tensorCoordinates_length]
  ring
theorem bounds (hv : validSize K u q) (ha : 0<a) (hb : 0<b) (hc : 0<c) :
    let x:=bitSize (queryWords F u q A T)
    a ≤ x ∧ b ≤ x ∧ c ≤ x ∧ a*b*c ≤ x ∧ F.e ≤ x ∧
    q.size+1 ≤ x ∧ bits (K:=K) ≤ 2*x+1 ∧ 2*(a*b*c*F.e) ≤ x := by
