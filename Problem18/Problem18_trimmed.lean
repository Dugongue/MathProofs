namespace Mathproof.Problem18RootNormalizedWordCodec20261001
open Problem18FiniteTransducer20261001 Problem18RootWordCodec20261001
open Problem18RootSyntaxMachine20261001 BitstringEncoding Turing
open Lax51.BinaryWordEncoding (Symbol)
inductive State | start | header (last : Bool) | payload deriving DecidableEq,Fintype
def complete (last : Bool) : List Bool → List Bool
  | []=>if last then [] else [true]
  | b::bs=>b::complete b bs
def normalized : Transducer Bool Symbol State where
  initial:=.start
  next q b:=match q with
    | .start=>(if b then .payload else .start,[.separator])
    | .header last=>(if b then .payload else .start,if b || last then [] else [.one])
    | .payload=>(.header b,[digit b])
  finish q:=match q with
    | .header false=>[.one]
    | _=>[]
  next_bound q b:=by
    cases q with
    | start=>cases b <;> simp
    | payload=>simp
    | header last=>cases last <;> cases b <;> simp
  finish_bound q:=by cases q with
    | start=>simp
    | payload=>simp
    | header b=>cases b <;> simp
theorem encode_decode_pos (b : Bool) (bs : List Bool) :
    Computability.encodePosNum (Computability.decodePosNum (b::bs))=b::complete b bs := by
  induction bs generalizing b with
  | nil=>cases b <;> rfl
  | cons c cs ih=>
    cases b <;> simp [Computability.decodePosNum,Computability.encodePosNum,complete,ih]
theorem decoded_bits (bs : List Bool) :
    (Computability.decodeNat bs).bits=match bs with
      | []=>[]
      | b::rest=>b::complete b rest := by
  cases bs with
  | nil=>rfl
  | cons b bs=>
    simp only [Computability.decodeNat,Computability.decodeNum,List.cons_ne_nil,if_false,
      PosNum.cast_to_num,Num.cast_pos]
    change Nat.bits (Computability.decodePosNum (b::bs) : Nat)=_
    rw [←encodePosNum_eq_bits,encode_decode_pos]
theorem header_block (last : Bool) (bs rest : List Bool) :
    run normalized (.header last) (delimit bs++rest)=
      (complete last bs).map digit++run normalized .start rest := by
  induction bs generalizing last with
  | nil=>cases last <;> rfl
  | cons b bs ih=>
    change digit b::run normalized (.header b) (delimit bs++rest)=
      digit b::((complete b bs).map digit++run normalized .start rest)
    rw [ih]
theorem start_block (bs rest : List Bool) :
    run normalized .start (delimit bs++rest)=
      Symbol.separator::((Computability.decodeNat bs).bits.map digit++run normalized .start rest) := by
  rw [decoded_bits]
  cases bs with
  | nil=>rfl
  | cons b bs=>
    change Symbol.separator::digit b::run normalized (.header b) (delimit bs++rest)=_
    rw [header_block]
    rfl
theorem normalized_blocks (fuel : Nat) (xs : List Bool) (blocks : List (List Bool))
    (h : undelimitBlocksAux fuel xs=some blocks) :
    run normalized .start xs=Lax51.BinaryWordEncoding.encode (blocks.map Computability.decodeNat) := by
  induction fuel generalizing xs blocks with
