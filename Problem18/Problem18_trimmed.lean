    simp only [commitNames,workNames,List.mem_cons,List.mem_singleton] at hx
    exact hregs x (by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false]; tauto)
  · exact hp
  · exact he
  · exact hword
  · exact hmem
  · change σ.vars r.e+σ.vars r.e ≤ (σ.arrs r.scratch).length
    omega
  · change σ.vars r.e+σ.vars r.e ≤ (σ.arrs r.scratch).length
    omega
  · change σ.vars r.k+σ.vars r.e ≤ (σ.arrs r.scratch).length
    omega
  · left; change σ.vars r.k+σ.vars r.e ≤ σ.vars r.e; omega
  · left; change σ.vars r.k+σ.vars r.e ≤ σ.vars r.e; omega
  · intro j hj
    exact ⟨hcoeff j hj,hcoeff j hj⟩
