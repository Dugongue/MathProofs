open Mathproof.Problem18PairLargeWords20261004
def bank : String := "P18.pair.bank"
theorem bank_ne_mem : bank ≠ canonical.mem := by decide
theorem bank_ne_scratch : bank ≠ canonical.scratch := by decide
def copyBlock (src dst : String) (s d n : Expr) : Com :=
  .seq (.assign wcSrc s) (.seq (.assign wcDst d) (.seq (.assign wcCnt n) (wordCopy src dst)))
def zeroBlock (dst : String) (d n : Expr) : Com :=
  .seq (.assign wcDst d) (.seq (.assign wcCnt n) (zeroFill dst))
def wcRegs : List String := [wcIdx, wcSrc, wcDst, wcCnt]
def Clean (e : Expr) : Prop :=
  Problem18ClaudeIMPSlots20261001.NoVar wcSrc e ∧ Problem18ClaudeIMPSlots20261001.NoVar wcDst e ∧
    Problem18ClaudeIMPSlots20261001.NoVar wcCnt e
theorem copyBlock_run {B : Nat} (src dst : String) (hsd : src ≠ dst) (σ : Env)
    {s d n : Expr} {sv dv nv : Nat} (hcs : Clean s) (hcd : Clean d) (hcn : Clean n)
    (hs : s.evalB B σ = some sv) (hd : d.evalB B σ = some dv) (hn : n.evalB B σ = some nv)
    (hsl : sv + nv ≤ (σ.arrs src).length) (hdl : dv + nv ≤ (σ.arrs dst).length)
    (hsB : (σ.arrs src).length < B) (hdB : (σ.arrs dst).length < B)
    (hval : ∀ j < nv, (σ.arrs src).getD (sv + j) 0 < B) (hB2 : 1 < B) :
    ∃ τ, Run B (copyBlock src dst s d n) σ τ (20 * nv + 13 + s.size + d.size + n.size) ∧
      (∀ x, x ∉ wcRegs → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ dst → τ.arrs a = σ.arrs a) ∧
      (τ.arrs dst).length = (σ.arrs dst).length ∧
      (∀ j, (τ.arrs dst).getD j 0 =
        if dv ≤ j ∧ j < dv + nv then (σ.arrs src).getD (sv + (j - dv)) 0
        else (σ.arrs dst).getD j 0) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  let σ1 := σ.setVar wcSrc sv
  let σ2 := σ1.setVar wcDst dv
  let σ3 := σ2.setVar wcCnt nv
  have h1 : Run B (.assign wcSrc s) σ σ1 (1 + s.size) := Run.assign hs
  have hd1 : d.evalB B σ1 = some dv := by
    rw [Problem18ClaudeIMPSlots20261001.evalB_setVar_noVar d hcd.1]; exact hd
  have h2 : Run B (.assign wcDst d) σ1 σ2 (1 + d.size) := Run.assign hd1
  have hn2 : n.evalB B σ2 = some nv := by
    rw [Problem18ClaudeIMPSlots20261001.evalB_setVar_noVar n hcn.2.1,
      Problem18ClaudeIMPSlots20261001.evalB_setVar_noVar n hcn.1]; exact hn
  have h3 : Run B (.assign wcCnt n) σ2 σ3 (1 + n.size) := Run.assign hn2
  obtain ⟨τ, hr, hv, hidx, ha, hl, hdata, hi, ho⟩ := wordCopy_run (B := B) src dst hsd σ3
    (s := sv) (d := dv) (n := nv) (by simp [σ3, σ2, σ1, Env.setVar, wcSrc, wcDst, wcCnt])
    (by simp [σ3, σ2, σ1, Env.setVar, wcDst, wcCnt])
    (by simp [σ3, Env.setVar]) hsl hdl hsB hdB hval hB2
  refine ⟨τ, (h1.seq (h2.seq (h3.seq hr))).mono (by omega), ?_, ha, hl, ?_, hi, ho⟩
  · intro x hx
    simp only [wcRegs, List.mem_cons, List.not_mem_nil, or_false, not_or] at hx
    rw [hv x hx.1]
    simp [σ3, σ2, σ1, Env.setVar, hx.2.1, hx.2.2.1, hx.2.2.2]
  · intro j; rw [hdata j]; rfl
theorem zeroBlock_run {B : Nat} (dst : String) (σ : Env)
    {d n : Expr} {dv nv : Nat} (hcn : Clean n)
    (hd : d.evalB B σ = some dv) (hn : n.evalB B σ = some nv)
    (hdl : dv + nv ≤ (σ.arrs dst).length) (hdB : (σ.arrs dst).length < B) (hB2 : 1 < B) :
    ∃ τ, Run B (zeroBlock dst d n) σ τ (20 * nv + 12 + d.size + n.size) ∧
      (∀ x, x ∉ wcRegs → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ dst → τ.arrs a = σ.arrs a) ∧
      (τ.arrs dst).length = (σ.arrs dst).length ∧
      (∀ j, (τ.arrs dst).getD j 0 =
        if dv ≤ j ∧ j < dv + nv then 0 else (σ.arrs dst).getD j 0) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  let σ2 := σ.setVar wcDst dv
  let σ3 := σ2.setVar wcCnt nv
  have h2 : Run B (.assign wcDst d) σ σ2 (1 + d.size) := Run.assign hd
  have hn2 : n.evalB B σ2 = some nv := by
    rw [Problem18ClaudeIMPSlots20261001.evalB_setVar_noVar n hcn.2.1]; exact hn
  have h3 : Run B (.assign wcCnt n) σ2 σ3 (1 + n.size) := Run.assign hn2
  obtain ⟨τ, hr, hv, hidx, ha, hl, hdata, hi, ho⟩ := zeroFill_run (B := B) dst σ3
    (d := dv) (n := nv) (by simp [σ3, σ2, Env.setVar, wcDst, wcCnt])
    (by simp [σ3, Env.setVar]) hdl hdB hB2
  refine ⟨τ, (h2.seq (h3.seq hr)).mono (by omega), ?_, ha, hl, ?_, hi, ho⟩
  · intro x hx
    simp only [wcRegs, List.mem_cons, List.not_mem_nil, or_false, not_or] at hx
    rw [hv x hx.1]
    simp [σ3, σ2, Env.setVar, hx.2.2.1, hx.2.2.2]
  · intro j; rw [hdata j]; rfl
variable {K : Type} [Field K] (F : FieldPresentation K)
def Vals (arr : String) (σ : Env) (off n : Nat) (v : Nat → K) : Prop :=
  ∀ i < n, ∀ t : Fin F.e, (σ.arrs arr).getD (off + F.e * i + t.val) 0 =
    (F.coordinate (v i) t).val
def MemVals (σ : Env) (base n : Nat) (v : Nat → K) : Prop :=
  ∀ i < n, decode F (slice F σ canonical (base + F.e * i)) = v i
theorem coords_of_canonical {w : Fin F.e → Nat} (hw : Canonical F w) {x : K}
    (hx : decode F w = x) : ∀ t, w t = (F.coordinate x t).val := by
  have hc : Canonical F (fun t => (F.coordinate x t).val) := fun t => (F.coordinate x t).isLt
  have h := (decode_injective F hw hc).mp (by rw [hx, decode_coordinates])
  intro t; exact congrFun h t
theorem decode_of_coords {w : Fin F.e → Nat} {x : K}
    (h : ∀ t, w t = (F.coordinate x t).val) : decode F w = x := by
  have : w = fun t => (F.coordinate x t).val := funext h
  rw [this, decode_coordinates]
theorem index_split {e i t n : Nat} (ht : t < e) (hi : i < n) : e * i + t < e * n := by
  have := Nat.mul_le_mul_left e (Nat.succ_le_of_lt hi)
  rw [Nat.mul_succ] at this; omega
theorem vals_of_copy {σ τ : Env} {src dst : String} {m off n : Nat} {v : Nat → K}
    (hcan : ∀ j < F.e * n, (σ.arrs src).getD (m + j) 0 < F.p)
    (hval : ∀ i < n, decode F (fun t : Fin F.e => (σ.arrs src).getD (m + F.e * i + t.val) 0) = v i)
    (hdata : ∀ j, (τ.arrs dst).getD j 0 =
        if off ≤ j ∧ j < off + F.e * n then (σ.arrs src).getD (m + (j - off)) 0
        else (σ.arrs dst).getD j 0) :
    Vals F dst τ off n v := by
  intro i hi t
  have hs := index_split (e := F.e) t.isLt hi
  rw [hdata, if_pos (by omega)]
  have hcanon : Canonical F (fun t : Fin F.e => (σ.arrs src).getD (m + F.e * i + t.val) 0) := by
    intro t'
    have := index_split (e := F.e) t'.isLt hi
    have h := hcan (F.e * i + t'.val) this
    rwa [← Nat.add_assoc] at h
  have h := coords_of_canonical F hcanon (hval i hi) t
  rw [show m + (off + F.e * i + t.val - off) = m + F.e * i + t.val by omega]
  exact h
theorem decode_of_copy {σ τ : Env} {src dst : String} {s d n : Nat} {v : Nat → K}
    (hv : Vals F src σ s n v)
    (hdata : ∀ j, (τ.arrs dst).getD j 0 =
        if d ≤ j ∧ j < d + F.e * n then (σ.arrs src).getD (s + (j - d)) 0
        else (σ.arrs dst).getD j 0) :
    ∀ i < n, decode F (fun t : Fin F.e => (τ.arrs dst).getD (d + F.e * i + t.val) 0) = v i := by
  intro i hi
  apply decode_of_coords
  intro t
  have hs := index_split (e := F.e) t.isLt hi
  rw [hdata, if_pos (by omega), show s + (d + F.e * i + t.val - d) = s + F.e * i + t.val by omega]
  exact hv i hi t
theorem vals_frame {σ τ : Env} {arr : String} {off n : Nat} {v : Nat → K}
    (hv : Vals F arr σ off n v) (h : τ.arrs arr = σ.arrs arr) : Vals F arr τ off n v := by
  intro i hi t; rw [h]; exact hv i hi t
theorem vals_lt {σ : Env} {arr : String} {off n : Nat} {v : Nat → K}
    (hv : Vals F arr σ off n v) : ∀ j < F.e * n, (σ.arrs arr).getD (off + j) 0 < F.p := by
  intro j hj
  have he := F.degree_pos
  have hi : j / F.e < n := by
    rw [Nat.div_lt_iff_lt_mul he]; rw [Nat.mul_comm] at hj; exact hj
  have ht : j % F.e < F.e := Nat.mod_lt _ he
  have hj' : off + j = off + F.e * (j / F.e) + (⟨j % F.e, ht⟩ : Fin F.e).val := by
    simp only; rw [Nat.add_assoc, Nat.div_add_mod]
  rw [hj', hv _ hi]
  exact (F.coordinate _ _).isLt
end Mathproof.Problem18PairLargeBank20261004
