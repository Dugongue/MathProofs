theorem squarefree_hermitian_operator_isometry
    (σ : K ≃+* K) (hσ : Function.Involutive σ) (hne : σ≠1)
    (B : V →ₛₗ[σ.toRingHom] V →ₗ[K] K)
    (C : W →ₛₗ[σ.toRingHom] W →ₗ[K] K)
    (hB : ∀ x y,B x y=σ (B y x)) (hC : ∀ x y,C x y=σ (C y x))
    (hnB : B.SeparatingLeft) (hnC : C.SeparatingLeft)
    (S : Module.End K V) (R : Module.End K W)
    (hS : Mathproof.Meta.Problem18HermitianSpectral20260930.IsSelfAdjointFor σ B S)
    (hR : Mathproof.Meta.Problem18HermitianSpectral20260930.IsSelfAdjointFor σ C R)
    (hs : Squarefree S.charpoly) (hχ : S.charpoly=R.charpoly)
    (hfix : S.charpoly.map σ.toRingHom=S.charpoly) :
    ∃ T : V ≃ₗ[K] W,(∀ x,T (S x)=R (T x)) ∧ ∀ x y,C (T x) (T y)=B x y := by
  classical
  let I := FactorIndex S.charpoly
  let g : I→K[X] := fun i => i.val
  let L : I→Type _ := fun i => AdjoinRoot (g i)
  letI : ∀ i : I,Fact (Irreducible (g i)) := fun i => ⟨factor_irreducible S.charpoly i⟩
  letI : ∀ i : I,Field (L i) := fun i => inferInstance
  letI : ∀ i : I,FiniteDimensional K (L i) :=
    fun i => (AdjoinRoot.powerBasis (factor_irreducible S.charpoly i).ne_zero).finite
  let τ : I→I := factorConjugate σ S.charpoly S.charpoly_monic.ne_zero hfix
  have hτ : Function.Involutive τ := factorConjugate_involutive σ hσ S.charpoly S.charpoly_monic.ne_zero hfix
  have hm : ∀ i,(g i).Monic := factor_monic S.charpoly
  have hi : ∀ i,Irreducible (g i) := factor_irreducible S.charpoly
  have hf : S.charpoly=∏ i,g i := factor_product S.charpoly S.charpoly_monic hs
  have hfR : R.charpoly=∏ i,g i := hχ.symm.trans hf
  have hsR : Squarefree R.charpoly := hχ ▸ hs
  have hcop (i j : I) (hj : j≠τ i) : IsCoprime ((g i).map σ.toRingHom) (g j) :=
    conjugate_coprime_of_ne σ S.charpoly S.charpoly_monic.ne_zero hfix i j hj
  obtain ⟨e,E,he,hEsum,hE⟩ := simultaneous_coordinates_with_actions S g hm hi hf hs
  obtain ⟨f,F,hf',hFsum,hF⟩ := simultaneous_coordinates_with_actions R g hm hi hfR hsR
  have heval (i : I) (x : L i) : (e i (AdjoinRoot.root (g i)*x):V)=S (e i x) :=
    congrArg Subtype.val (he i x)
  have hfval (i : I) (x : L i) : (f i (AdjoinRoot.root (g i)*x):W)=R (f i x) :=
    congrArg Subtype.val (hf' i x)
  let a (i : I) : Module.End K (L i) := LinearMap.mulLeft K (AdjoinRoot.root (g i))
  let b (i : I) (x : L i) (y : L (τ i)) := B (e i x) (e (τ i) y)
  let c (i : I) (x : L i) (y : L (τ i)) := C (f i x) (f (τ i) y)
  have hformB (x y : ∀ i,L i) : B (E x) (E y)=∑ i,b i (x i) (y (τ i)) := by
    rw [hEsum,hEsum]
    exact primarySum_paired_form B S g τ hS hcop (fun i => e i (x i)) (fun i => e i (y i))
  have hformC (x y : ∀ i,L i) : C (F x) (F y)=∑ i,c i (x i) (y (τ i)) := by
    rw [hFsum,hFsum]
    exact primarySum_paired_form C R g τ hR hcop (fun i => f i (x i)) (fun i => f i (y i))
  have reverse_pair (i : I) (T : ∀ j,L j ≃ₗ[K] L j)
      (hforward : ∀ x y,c i (T i x) (T (τ i) y)=b i x y) :
      ∀ x y,c (τ i) (T (τ i) x) (T (τ (τ i)) y)=b (τ i) x y := by
    have hh (x : L (τ i)) (y : L i) :
        C (f (τ i) (T (τ i) x)) (f i (T i y))=B (e (τ i) x) (e i y) := by
      rw [hC,hB]
      exact congrArg σ (hforward y x)
    have hh' (j : I) (hj : j=i) : ∀ (x : L (τ i)) (y : L j),
        C (f (τ i) (T (τ i) x)) (f j (T j y))=B (e (τ i) x) (e j y) := by
      subst j
      exact hh
    exact hh' (τ (τ i)) (hτ i)
  have hlocal (i : I) : ∃ T : ∀ j,L j ≃ₗ[K] L j,
      (∀ j x,T j (a j x)=a j (T j x)) ∧
      (∀ x y,c i (T i x) (T (τ i) y)=b i x y) ∧
      (∀ x y,c (τ i) (T (τ i) x) (T (τ (τ i)) y)=b (τ i) x y) := by
    by_cases hfixed : τ i=i
    · let Bi := B.domRestrict₁₂ (Primary S g i) (Primary S g i)
      let Ci := C.domRestrict₁₂ (Primary R g i) (Primary R g i)
      let Si := S.restrict (primary_kernel_invariant S (g i))
      let Ri := R.restrict (primary_kernel_invariant R (g i))
      have hgi : (g i).map σ.toRingHom=g i := congrArg Subtype.val hfixed
      have hnBi : Bi.SeparatingLeft := primary_cross_separatingLeft B S g i i hS hnB hm hi hf hs
        (by intro j hj; apply hcop i j; simpa only [hfixed] using hj)
      have hnCi : Ci.SeparatingLeft := primary_cross_separatingLeft C R g i i hR hnC hm hi hfR hsR
        (by intro j hj; apply hcop i j; simpa only [hfixed] using hj)
      have hSi : Si.charpoly=g i := squarefree_primary_restriction_charpoly S (g i) (hm i) (hi i)
        (by rw [hf]; exact Finset.dvd_prod_of_mem g (Finset.mem_univ i)) hs
      have hRi : Ri.charpoly=g i := squarefree_primary_restriction_charpoly R (g i) (hm i) (hi i)
        (by rw [hfR]; exact Finset.dvd_prod_of_mem g (Finset.mem_univ i)) hsR
      obtain ⟨Z,hZ,hZform⟩ := irreducible_hermitian_operator_isometry σ hσ hne (g i) (hm i) (hi i) hgi
        Bi Ci (fun x y => hB x y) (fun x y => hC x y) hnBi hnCi Si Ri
        (fun x y => hS x y) (fun x y => hR x y) hSi hRi
      let D : L i ≃ₗ[K] L i := (e i).trans (Z.trans (f i).symm)
      have hD (x : L i) : D (a i x)=a i (D x) := by
        apply (f i).injective
        change f i ((f i).symm (Z (e i (a i x))))=f i (a i ((f i).symm (Z (e i x))))
        rw [LinearEquiv.apply_symm_apply]
        change Z (e i (AdjoinRoot.root (g i)*x))=
          f i (AdjoinRoot.root (g i)*(f i).symm (Z (e i x)))
        rw [he,hf',hZ,LinearEquiv.apply_symm_apply]
      have hDf (x y : L i) : C (f i (D x)) (f i (D y))=B (e i x) (e i y) := by
        change C (f i ((f i).symm (Z (e i x)))) (f i ((f i).symm (Z (e i y))))=B (e i x) (e i y)
        rw [LinearEquiv.apply_symm_apply,LinearEquiv.apply_symm_apply]
        exact hZform _ _
      let T : ∀ j,L j ≃ₗ[K] L j := Function.update (fun j => LinearEquiv.refl K (L j)) i D
      have hcomm (j : I) (x : L j) : T j (a j x)=a j (T j x) := by
        by_cases hj : j=i
        · subst j; simpa only [T,Function.update_self] using hD x
        · simp only [T,Function.update_of_ne hj,LinearEquiv.refl_apply]
      have hforward : ∀ x y,c i (T i x) (T (τ i) y)=b i x y := by
        have hh (j : I) (hj : j=i) : ∀ (x : L i) (y : L j),
            C (f i (T i x)) (f j (T j y))=B (e i x) (e j y) := by
          subst j
          simpa only [T,Function.update_self] using hDf
        exact hh (τ i) hfixed
      exact ⟨T,hcomm,hforward,reverse_pair i T hforward⟩
    · have hp : Associated ((g i).map σ.toRingHom) (g (τ i)) := by rfl
      obtain ⟨cb,hcb,hcbform⟩ := actual_primary_cross_trace B S g i (τ i) hS hnB hm hi hf hs
        (hcop i) hp (e i) (e (τ i)) (heval i) (heval (τ i))
      obtain ⟨cc,hcc,hccform⟩ := actual_primary_cross_trace C R g i (τ i) hR hnC hm hi hfR hsR
        (hcop i) hp (f i) (f (τ i)) (hfval i) (hfval (τ i))
      let w : L (τ i) := cb/cc
      have hw : w≠0 := div_ne_zero hcb hcc
      let D : L (τ i) ≃ₗ[K] L (τ i) := scalarEquiv (K:=K) w hw
      let T : ∀ j,L j ≃ₗ[K] L j := Function.update (fun j => LinearEquiv.refl K (L j)) (τ i) D
      have hcomm (j : I) (x : L j) : T j (a j x)=a j (T j x) := by
        by_cases hj : j=τ i
        · subst j
          simp only [T,Function.update_self]
          change w*(AdjoinRoot.root (g (τ i))*x)=AdjoinRoot.root (g (τ i))*(w*x)
          ring
        · simp only [T,Function.update_of_ne hj,LinearEquiv.refl_apply]
      have hforward : ∀ x y,c i (T i x) (T (τ i) y)=b i x y := by
        intro x y
        simp only [c,b,T,Function.update_self,Function.update_of_ne (Ne.symm hfixed),LinearEquiv.refl_apply]
        change C (f i x) (f (τ i) (w*y))=B (e i x) (e (τ i) y)
        rw [hccform,hcbform]
        apply congrArg (Algebra.trace K (AdjoinRoot (g (τ i))))
        have hcw : cc*w=cb := mul_div_cancel₀ _ hcc
        calc
          cc*AdjoinRoot.mapRingEquiv σ (g i) (g (τ i)) hp x*(w*y)=
              (cc*w)*AdjoinRoot.mapRingEquiv σ (g i) (g (τ i)) hp x*y := by ring
          _ = _ := by rw [hcw]
      exact ⟨T,hcomm,hforward,reverse_pair i T hforward⟩
  exact assemble_paired_primary_isometry L σ τ hτ S R a B C E F hE hF b c hformB hformC hlocal
end Mathproof.Problem18HermitianSquarefreeIsometry20260930
end
