variable {K ι : Type*} [Field K] [Fintype K] [Fintype ι]
theorem selected_coprime (g : ι→K[X]) (hm : ∀i,(g i).Monic) (hi : ∀i,Irreducible (g i))
    (hinj : Function.Injective g) : Pairwise (fun i j=>IsCoprime (g i) (g j)) := by
  intro i j hij
  apply (hi i).coprime_iff_not_dvd.mpr
  intro hd
  exact hij (hinj (eq_of_monic_of_associated (hm i) (hm j) ((hi i).associated_of_dvd (hi j) hd)))
noncomputable def selectedFactorEquiv (g : ι→K[X]) (hm : ∀i,(g i).Monic) (hi : ∀i,Irreducible (g i))
    (hinj : Function.Injective g) : ι≃FactorIndex (∏i,g i) := by
  have hp : (∏i,g i)≠0 := Finset.prod_ne_zero_iff.mpr (fun i _=>(hi i).ne_zero)
  let F : ι→FactorIndex (∏i,g i) := fun i=>⟨g i,by
    apply Multiset.mem_toFinset.mpr
    apply (mem_normalizedFactors_iff' hp).mpr
    exact ⟨hi i,(hm i).normalize_eq_self,Finset.dvd_prod_of_mem g (Finset.mem_univ i)⟩⟩
  apply Equiv.ofBijective F
  constructor
  · intro i j he
    exact hinj (congrArg Subtype.val he)
  · intro p
    have hp' := (mem_normalizedFactors_iff' hp).mp (Multiset.mem_toFinset.mp p.property)
    obtain ⟨i,_,hd⟩ := hp'.1.prime.dvd_finsetProd_iff g |>.mp hp'.2.2
    refine ⟨i,Subtype.ext ?_⟩
    exact (eq_of_monic_of_associated (factor_monic _ p) (hm i)
      (hp'.1.associated_of_dvd (hi i) hd)).symm
@[simp] theorem selectedFactorEquiv_val (g : ι→K[X]) (hm : ∀i,(g i).Monic) (hi : ∀i,Irreducible (g i))
    (hinj : Function.Injective g) (i : ι) : (selectedFactorEquiv g hm hi hinj i).val=g i := rfl
theorem selected_weight_product {M : Type*} [CommMonoid M]
    (g : ι→K[X]) (hm : ∀i,(g i).Monic) (hi : ∀i,Irreducible (g i))
    (hinj : Function.Injective g) (w : K[X]→M) :
    (∏p : FactorIndex (∏i,g i),w p.val)=∏i,w (g i) := by
  simpa only [selectedFactorEquiv_val] using ((selectedFactorEquiv g hm hi hinj).prod_comp (fun p=>w p.val)).symm
theorem selected_factor_card (g : ι→K[X]) (hm : ∀i,(g i).Monic) (hi : ∀i,Irreducible (g i))
    (hinj : Function.Injective g) : Nat.card (FactorIndex (∏i,g i))=Nat.card ι :=
  (Nat.card_congr (selectedFactorEquiv g hm hi hinj)).symm
end
end Mathproof.Problem18SelectedFactorIndex20261001
