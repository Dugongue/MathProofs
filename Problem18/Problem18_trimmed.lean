    (hv : ValidMemory F B tau)
    (hc : tau.vars powerCursor = k+1)
    (hg : Problem18IMPMatrixMemory20261001.matrix F tau gram n n = G)
    (hold : forall j, j < k ->
      powerMatrix F n base j tau = powerMatrix F n base j rho)
    (hnew :
      powerMatrix F n base k tau =
        powerMatrix F n base (k-1) rho * G) :
    PowerInvariant F (B:=B) n base gram (k+1) G tau := by
  refine ⟨hv,hc,hg,?_⟩
  intro j hj
  by_cases hjk : j < k
  · rw [hold j hjk]
    exact hrho.powers j hjk
  · have hjeq : j = k := by omega
    subst j
    rw [hnew,hrho.powers (k-1) (by omega)]
    simpa [Nat.sub_add_cancel hk] using (pow_succ G k).symm
theorem matrix_of_word_copy {n src dst : Nat} {sigma tau : Env}
