    intro y
    exact mul_nonneg (by positivity) (norm_nonneg _)
  have hρ2 : ∑ y, (ρ y) ^ 2 ≤ C * Fintype.card G := by
    have hm := mul_le_mul_of_nonneg_left hsecond
      (show (0 : ℝ) ≤ Fintype.card G by positivity)
    dsimp only [ρ]
    simp only [mul_pow, ← Finset.mul_sum]
