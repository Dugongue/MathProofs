variable {K : Type*} [Field K] [Fintype K] {n : ℕ}
theorem krylov_candidate_intertwines (S R : Module.End K (Fin n→K))
    (v w : Fin n→K) (hv : PolynomiallyCyclic S v) (hw : PolynomiallyCyclic R w)
    (hχ : S.charpoly=R.charpoly) :
    ∃ T : (Fin n→K) ≃ₗ[K] (Fin n→K),
      (∀ x,T (S x)=R (T x)) ∧ T v=w ∧
      LinearMap.toMatrix' T.toLinearMap=krylovMatrix R w*(krylovMatrix S v)⁻¹ := by
  have hd : Module.finrank K (Fin n→K)=n := by simp
  have hvs := (polynomiallyCyclic_iff_cyclicEvalMap_bijective S v).mp hv
  have hws := (polynomiallyCyclic_iff_cyclicEvalMap_bijective R w).mp hw
  rw [hd] at hvs hws
  let E := LinearEquiv.ofBijective (cyclicEvalMap S v n) hvs
  let F := LinearEquiv.ofBijective (cyclicEvalMap R w n) hws
  let T := E.symm.trans F
  have hcommon (p : K[X]) : T ((aeval S p) v)=(aeval R p) w := by
    have hdeg : p %ₘ S.charpoly∈Polynomial.degreeLT K n := by
      rw [Polynomial.mem_degreeLT]
      have hh := degree_modByMonic_lt p S.charpoly_monic
      simpa only [degree_eq_natDegree S.charpoly_monic.ne_zero,S.charpoly_natDegree,hd] using hh
    let q : Polynomial.degreeLT K n := ⟨p %ₘ S.charpoly,hdeg⟩
    have hEq : E q=(aeval S p) v := by
      change (aeval S (p %ₘ S.charpoly)) v=(aeval S p) v
      rw [aeval_modByMonic_eq_self_of_root S.aeval_self_charpoly]
    have hFq : F q=(aeval R p) w := by
      change (aeval R (p %ₘ S.charpoly)) w=(aeval R p) w
      rw [hχ,aeval_modByMonic_eq_self_of_root R.aeval_self_charpoly]
    change F (E.symm ((aeval S p) v))=(aeval R p) w
    rw [← hEq,E.symm_apply_apply,hFq]
  have hT : ∀ x,T (S x)=R (T x) := by
    intro x
    obtain ⟨p,rfl⟩ := hv x
    have he : S ((aeval S p) v)=(aeval S (X*p)) v := by
      simp only [aeval_mul,aeval_X,Module.End.mul_apply]
    rw [he,hcommon,hcommon]
    simp only [aeval_mul,aeval_X,Module.End.mul_apply]
  have hTv : T v=w := by simpa only [map_one,Module.End.one_apply] using hcommon 1
  exact ⟨T,hT,hTv,intertwiner_eq_krylov_candidate S R v w hv T hT hTv⟩
