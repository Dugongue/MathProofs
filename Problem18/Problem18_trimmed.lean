  letI : Finite ((Fin n → K) →ₛₗ[(τ : K →+* K)] (Fin n → K) →ₗ[K] K) :=
    Finite.of_injective
      (fun C : (Fin n → K) →ₛₗ[(τ : K →+* K)] (Fin n → K) →ₗ[K] K =>
        fun x y => C x y) (by
          intro B C h
          apply LinearMap.ext
          intro x
          apply LinearMap.ext
          intro y
