theorem preservingSample_card_mul_le_crossZero
    (B : LinearMap.BilinForm K V) (hB : B.Nondegenerate)
    (eps : K) (heps : eps ^ 2 = 1)
    (W : Submodule K V) {k z m : ℕ}
    (E : (Fin (k + z) → K) →ₗ[K] V)
    (hE : Function.Injective E)
    (hw : ∀ i, leftTestVector E i ∈ W)
    (hv : ∀ l, RightOrthogonalTo B W (rightTestVector E l)) :
    Nat.card {u : Fin m → V × V //
        Preserves W (∑ j,
          Mathproof.Problem18AnchorBilinear20260930.anchorPair
            B eps (u j).1 (u j).2)} *
      Nat.card
        (Matrix (Fin k) (Fin (m + m)) K ×
          Matrix (Fin z) (Fin (m + m)) K) ≤
      Nat.card (CrossZeroPairs (K := K) k (m + m) z) *
        Nat.card (Fin m → V × V) := by
  let g :
      {u : Fin m → V × V //
        Preserves W (∑ j,
          Mathproof.Problem18AnchorBilinear20260930.anchorPair
            B eps (u j).1 (u j).2)} →
      {u : Fin m → V × V //
        ∀ i, (anchorMatrixMap B eps E u).1.mulVec
          ((anchorMatrixMap B eps E u).2 i) = 0} :=
    fun u => ⟨u.1,
      (invariantSampleToCrossZero B eps
        (leftTestVector E) (rightTestVector E) hw hv u.1 u.2).property⟩
  have hg : Function.Injective g := by
    intro a b hab
    exact Subtype.ext (congrArg (fun x => x.1) hab)
  have hle :
      Nat.card {u : Fin m → V × V //
        Preserves W (∑ j,
          Mathproof.Problem18AnchorBilinear20260930.anchorPair
            B eps (u j).1 (u j).2)} ≤
      Nat.card {u : Fin m → V × V //
        ∀ i, (anchorMatrixMap B eps E u).1.mulVec
          ((anchorMatrixMap B eps E u).2 i) = 0} :=
    Nat.card_le_card_of_injective g hg
  calc
    _ ≤ Nat.card {u : Fin m → V × V //
          ∀ i, (anchorMatrixMap B eps E u).1.mulVec
            ((anchorMatrixMap B eps E u).2 i) = 0} *
        Nat.card
          (Matrix (Fin k) (Fin (m + m)) K ×
            Matrix (Fin z) (Fin (m + m)) K) :=
      Nat.mul_le_mul_right _ hle
    _ = _ := anchorMatrixMap_crossZero_card_mul B hB eps heps E hE
end Mathproof.Problem18AnchorFixedEvent20260930
