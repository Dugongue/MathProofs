open Problem18TensorSorting20261001
open Problem18DimensionOneBoundary20260930
variable {K : Type} [Field K] [Fintype K] [BEq K] [LawfulBEq K] [DecidableEq K]
variable {n d : Nat}
noncomputable def gramOf (u : Bool) (q : Nat) (s : RectTensor 1 n d K) :
    Matrix (Fin n) (Fin n) K :=
  Problem18IMPBoundaryDispatchAdapter20261002.boundaryGram u q s
noncomputable def sweepOf (S : Matrix (Fin n) (Fin n) K) : (Fin n → K) × K[X] :=
  Problem18DeterministicCyclicSweep20261001.sweep S.toLin' n
noncomputable def modeAnswer (u : Bool) (p q : Nat) (sA sT : RectTensor 1 n d K) : Bool :=
  let SA := gramOf u q sA
  let SB := gramOf u q sT
  let rT := Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck SB
  if u then rT && decide ((sweepOf SA).2=(sweepOf SB).2)
  else if p=2 then Problem18CharTwoBooleanQuery20261001.queryCheck (matrixOf sA) (matrixOf sT)
  else rT && decide ((sweepOf SA).2=(sweepOf SB).2) &&
    Problem18OddBooleanTrial20261001.passedCheck q (matrixOf sA) (matrixOf sT)
      (sweepOf SA).1 (sweepOf SB).1
theorem guarded_squarefree (S : Matrix (Fin n) (Fin n) K)
    (h : Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck S=true) :
    Squarefree S.charpoly :=
  ((Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck_correct S).mp h).2
theorem sweep_charpoly (S : Matrix (Fin n) (Fin n) K) (hs : Squarefree S.charpoly) :
    (sweepOf S).2=S.charpoly := by
  have h:=Problem18DeterministicCyclicSweep20261001.final_polynomial_eq_charpoly S.toLin'
    (by rwa [Matrix.charpoly_toLin'])
  rw [Matrix.charpoly_toLin'] at h
  exact h
theorem characteristic_beq (X Y : Matrix (Fin n) (Fin n) K) :
    (Problem18BoundaryBooleanChecks20260930.matrixCharacteristic X==
      Problem18BoundaryBooleanChecks20260930.matrixCharacteristic Y)=
      decide (X.charpoly=Y.charpoly) := by
  apply Bool.eq_iff_iff.mpr
  rw [beq_iff_eq,decide_eq_true_iff,
    ← Problem18BoundaryBooleanChecks20260930.matrixCharacteristic_correct,
    ← Problem18BoundaryBooleanChecks20260930.matrixCharacteristic_correct]
  exact CompPoly.CPolynomial.ringEquiv.injective.eq_iff.symm
theorem sweep_cyclic (S : Matrix (Fin n) (Fin n) K) (hs : Squarefree S.charpoly) :
    Problem18ArrayKrylov20261001.cyclicCheck S (sweepOf S).1=true := by
  apply (Problem18ArrayKrylov20261001.cyclicCheck_correct _ _).mpr
  exact (Problem18KrylovCandidate20260930.krylovMatrix_isUnit_det _ _
    (Problem18DeterministicCyclicSweep20261001.cyclicVector_correct S.toLin'
      (by rwa [Matrix.charpoly_toLin']))).ne_zero
theorem gramOf_false (q : Nat) (s : RectTensor 1 n d K) :
    gramOf false q s=(matrixOf s).transpose*matrixOf s := rfl
theorem gramOf_true (q : Nat) (s : RectTensor 1 n d K) :
    gramOf true q s=Problem18UnitaryRawQuery20261001.gram q (matrixOf s) := rfl
theorem trial_eq (u : Bool) (p q : Nat) (sA sT : RectTensor 1 n d K) (hnd : n ≤ d)
    (hA : Problem18BoundaryRawChecks20261001.firstCheck u q sA=true) :
    Problem18BoundaryQueryAssembly20261001.trial u q p (matrixOf sA) (matrixOf sT)
      (sweepOf (gramOf u q sA)).1 (sweepOf (gramOf u q sT)).1=
      some (modeAnswer u p q sA sT) := by
  have hraw : Problem18BoundaryRawChecks20261001.rawCheck u q (matrixOf sA)=true := by
    simpa [Problem18BoundaryRawChecks20261001.firstCheck,
      Problem18BoundaryRawChecks20261001.orientedCheck,hnd] using hA
  have hsA : Squarefree (gramOf u q sA).charpoly := by
    apply guarded_squarefree
    rw [Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck_eq]
    cases u <;> simpa [Problem18BoundaryRawChecks20261001.rawCheck,gramOf,
      Problem18IMPBoundaryDispatchAdapter20261002.boundaryGram] using hraw
  cases u with
  | true =>
    simp only [Problem18BoundaryQueryAssembly20261001.trial,modeAnswer,if_true,
      Option.some.injEq]
    unfold Problem18UnitaryRawQuery20261001.queryCheck
    rw [characteristic_beq,← gramOf_true q sA,← gramOf_true q sT]
    have hr : Problem18BoundaryRawChecks20261001.rawCheck true q (matrixOf sT)=
        Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck (gramOf true q sT) := by
      rw [Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck_eq]
      rfl
    rw [hr]
    cases hT : Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck (gramOf true q sT)
    · simp
    · simp [sweep_charpoly _ hsA,sweep_charpoly _ (guarded_squarefree _ hT)]
  | false =>
    by_cases hp : p=2
    · simp [Problem18BoundaryQueryAssembly20261001.trial,modeAnswer,hp]
    · simp only [Problem18BoundaryQueryAssembly20261001.trial,modeAnswer,
        Bool.false_eq_true,if_false,hp]
      unfold Problem18OddBooleanTrial20261001.trial
      have hr : Problem18BoundaryBooleanChecks20260930.orthogonalSourceCheck (matrixOf sT)=
          Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck (gramOf false q sT) := by
        rw [Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck_eq]
        rfl
      unfold Problem18OddBooleanTrial20261001.characteristicCheck
      rw [hr,characteristic_beq,← gramOf_false q sA,← gramOf_false q sT]
      cases hT : Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck (gramOf false q sT)
      · simp
      · rw [sweep_charpoly _ hsA,sweep_charpoly _ (guarded_squarefree _ hT)]
        by_cases hc : (gramOf false q sA).charpoly=(gramOf false q sT).charpoly
        · have h1:=sweep_cyclic _ hsA
          have h2:=sweep_cyclic _ (guarded_squarefree _ hT)
          simp [hc,h1,h2]
        · simp [hc]
theorem modeAnswer_correct (u : Bool) (p q : Nat) [CharP K p] (hv : validSize K u q)
    (sA sT : RectTensor 1 n d K) (hnd : n ≤ d)
    (hA : Problem18BoundaryRawChecks20261001.firstCheck u q sA=true) :
    modeAnswer u p q sA sT=true ↔ equivalent u q sA sT := by
  have ht:=trial_eq u p q sA sT hnd hA
  have ho : Problem18BoundaryQueryAssembly20261001.firstTrial u q p sA sT
      (sweepOf (gramOf u q sA)).1 (sweepOf (gramOf u q sT)).1 0 0=
      some (modeAnswer u p q sA sT) := by
    simp only [Problem18BoundaryQueryAssembly20261001.firstTrial,
      Problem18BoundaryQueryAssembly20261001.orientedTrial,if_pos hnd]
    exact ht
  exact Problem18BoundaryQueryAssembly20261001.firstTrial_zero_error u q p hv sA sT hA
    _ _ 0 0 _ ho
theorem pair_correct {a b c : Nat} (u : Bool) (p q : Nat) [CharP K p] (hv : validSize K u q)
    (A T : RectTensor a b c K) (hfirst : (shape (sortOrder a b c) a b c).1=1)
    (hA : Problem18BoundaryRawChecks20261001.firstCheck u q
      (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
        (sortOrder a b c) A hfirst)=true) :
    modeAnswer u p q
      (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
        (sortOrder a b c) A hfirst)
      (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
        (sortOrder a b c) T hfirst)=true ↔ equivalent u q A T := by
  have hnd := (sorted_shape a b c).2
  rw [modeAnswer_correct u p q hv _ _ hnd hA]
  exact (Problem18P35BoundaryCompleteSemantics20261003.sortedBoundaryTensor_equivalent
    (sortOrder a b c) u q A T hfirst).trans (tensorEquiv_equivalent _ u q A T).symm
end Mathproof.Problem18PairBoundarySemantics20261004
