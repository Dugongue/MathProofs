theorem division_remainder_degree_bound (m : MonomialOrder (Fin N))
    (b : ι → MvPolynomial (Fin N) K) (q : ι →₀ MvPolynomial (Fin N) K)
    (f r : MvPolynomial (Fin N) K)
    (heq : f = Finsupp.linearCombination _ b q + r)
    (hq : ∀ i, m.toSyn (m.degree (b i * q i)) ≤ m.toSyn (m.degree f)) :
    m.toSyn (m.degree r) ≤ m.toSyn (m.degree f) := by
