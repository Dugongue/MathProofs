    ((fun o : Option divMachine.Cfg => o.bind divMachine.step)^[divisorBackup.length])
      (some (divPhaseCfg .restoreDivisor selected borrow dividend divisor [] quotient
        divisorBackup remainderBackup differenceReverse [])) =
