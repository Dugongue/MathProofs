theorem valid_of_mem {n d : ℕ} {rows : List (DenseInput n d K)} {fs : List (MvPolynomial (Fin n) K)}
    (h : List.Forall₂ (ValidDenseInput d) rows fs) :
    ∀ v ∈ rows, ∃ f, ValidDenseInput d v f := by
  induction h with
  | nil => simp
  | cons hv _ ih =>
    intro v hv'
    rcases List.mem_cons.mp hv' with rfl | hv'
