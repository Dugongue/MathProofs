    calc _ ≤ ∑ a ∈ Finset.univ \ badSet P,
          (({a} : Finset K) ×ˢ (specialize P a).roots.toFinset).card := Finset.card_biUnion_le
      _ ≤ ∑ a ∈ Finset.univ \ badSet P, D := by
          apply Finset.sum_le_sum
