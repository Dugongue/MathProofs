        change AdjoinRoot.map σ.toRingHom (g i) (g j) hp.symm.dvd
          (AdjoinRoot.root (g i))=AdjoinRoot.root (g j)
        exact AdjoinRoot.map_root σ.toRingHom (g i) (g j) hp.symm.dvd
      rw [hroot,he,hf']
