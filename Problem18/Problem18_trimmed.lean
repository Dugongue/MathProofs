def nom (σ : Env) : Expr → Nat
  | .lit n => n
  | .var x => σ.vars x
  | .bin .add e f => nom σ e + nom σ f
  | .bin .mul e f => nom σ e * nom σ f
  | _ => 0
def Pos (σ : Env) : Expr → Prop
  | .lit n => 1 ≤ n
  | .var x => 1 ≤ σ.vars x
  | .bin .add e f => Pos σ e ∧ Pos σ f
  | .bin .mul e f => Pos σ e ∧ Pos σ f
  | _ => False
theorem one_le_nom (σ : Env) : ∀ e : Expr, Pos σ e → 1 ≤ nom σ e
  | .lit n, h => h
  | .var x, h => h
  | .bin .add e f, h => by
      have := one_le_nom σ e h.1
      simp only [nom]; omega
  | .bin .mul e f, h => by
      have h1 := one_le_nom σ e h.1
      have h2 := one_le_nom σ f h.2
      simp only [nom]; exact Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega) (by omega))
  | .bin .sub _ _, h => h.elim
  | .bin .div _ _, h => h.elim
  | .bin .and _ _, h => h.elim
  | .bin .or _ _, h => h.elim
  | .bin .xor _ _, h => h.elim
  | .bin .shiftl _ _, h => h.elim
  | .bin .shiftr _ _, h => h.elim
  | .get _ _, h => h.elim
theorem evalB_pos {B : Nat} (σ : Env) :
    ∀ e : Expr, Pos σ e → nom σ e < B → e.evalB B σ = some (nom σ e)
  | .lit n, _, hB => evalB_lit hB
  | .var x, _, hB => evalB_var hB
  | .bin .add e f, h, hB => by
      have he := one_le_nom σ e h.1
      have hf := one_le_nom σ f h.2
      simp only [nom] at hB ⊢
      exact evalB_bin (op:=Bop.add) (evalB_pos σ e h.1 (by omega))
        (evalB_pos σ f h.2 (by omega)) hB
  | .bin .mul e f, h, hB => by
      have he := one_le_nom σ e h.1
      have hf := one_le_nom σ f h.2
      simp only [nom] at hB ⊢
      have hle1 : nom σ e ≤ nom σ e * nom σ f := Nat.le_mul_of_pos_right _ hf
      have hle2 : nom σ f ≤ nom σ e * nom σ f := Nat.le_mul_of_pos_left _ he
      exact evalB_bin (op:=Bop.mul) (evalB_pos σ e h.1 (by omega))
        (evalB_pos σ f h.2 (by omega)) hB
  | .bin .sub _ _, h, _ => h.elim
  | .bin .div _ _, h, _ => h.elim
  | .bin .and _ _, h, _ => h.elim
  | .bin .or _ _, h, _ => h.elim
  | .bin .xor _ _, h, _ => h.elim
  | .bin .shiftl _ _, h, _ => h.elim
  | .bin .shiftr _ _, h, _ => h.elim
  | .get _ _, h, _ => h.elim
end Mathproof.Problem18P36PosEval20261004
