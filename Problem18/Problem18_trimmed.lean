  have hf := (le_div_iff₀ hq).mp (bounded_weight_good_density_ge (K:=F) n hn)
  change (1/48:ℝ)*q^n≤Nat.card I at hf
  have hL := mul_le_mul_of_nonneg_right hf (show 0≤Real.exp (-72)*U by dsimp [U]; positivity)
  have hR := mul_le_mul_of_nonneg_right hc hq.le
  apply (mul_le_mul_iff_left₀ hq).mp
  change (Real.exp (-72)/48*U)*q^n≤_
  nlinarith
