  unfold loadCost; have := Nat.mul_le_mul_left (4 + loadStep M q cc Nv) h; omega
theorem elimCost_mono (M : FieldMacros F r) (q : RNames) (Nv : ℕ) {a b : ℕ} (h : a ≤ b) :
    elimCost M q Nv a ≤ elimCost M q Nv b := by
  unfold elimCost
  have := Nat.mul_le_mul_left
    (60 + M.costMul + axpyCost M (rowBase q (.var q.w)) (rowBase q (.var q.u)) Nv) h
  omega
