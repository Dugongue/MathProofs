variable {K M V : Type*} [Field K] [NeZero (2 : K)]
  [AddCommGroup M] [Module K M]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
theorem ambient_isometry_of_kernel_and_gram
    (B : LinearMap.BilinForm K V)
    (hsym : ∀ x y, B x y = B y x) (hnd : B.Nondegenerate)
    (C D : M →ₗ[K] V)
    (hker : LinearMap.ker C = LinearMap.ker D)
    (hgram : ∀ x y, B (C x) (C y) = B (D x) (D y)) :
    ∃ Q : V ≃ₗ[K] V,
      (∀ x, Q (C x) = D x) ∧ (∀ v w, B (Q v) (Q w) = B v w) := by
  obtain ⟨e, he, hiso⟩ :=
    Problem18GeneralPairingRecovery20260929.exists_range_equiv_preserving_pairing
      C D (fun v w => B v w) hker hgram
  have horth : B.orthogonal ⊤ = ⊥ := B.orthogonal_top_eq_bot hnd
  obtain ⟨Q, hQ, hext⟩ :=
    Problem18OwnWitt20261004.witt_extension B hsym horth horth
      (LinearMap.range C) (LinearMap.range D) e (fun u v => (hiso u v).symm)
  refine ⟨Q, ?_, hQ⟩
  intro x
  have hx := hext ⟨C x, LinearMap.mem_range_self C x⟩
  simpa only [he x] using hx
theorem exists_ambient_isometry_iff_kernel_and_gram
    (B : LinearMap.BilinForm K V)
    (hsym : ∀ x y, B x y = B y x) (hnd : B.Nondegenerate)
    (C D : M →ₗ[K] V) :
    (∃ Q : V ≃ₗ[K] V,
      (∀ x, Q (C x) = D x) ∧ (∀ v w, B (Q v) (Q w) = B v w)) ↔
    LinearMap.ker C = LinearMap.ker D ∧
      ∀ x y, B (C x) (C y) = B (D x) (D y) := by
  constructor
  · rintro ⟨Q, hQ, hpres⟩
    constructor
    · ext x
      simp only [LinearMap.mem_ker]
      rw [← hQ x]
      exact (Q.map_eq_zero_iff).symm
    · intro x y
      rw [← hQ x, ← hQ y, hpres]
  · rintro ⟨hker, hgram⟩
    exact ambient_isometry_of_kernel_and_gram B hsym hnd C D hker hgram
end Problem18FullOddWittRecovery20260929
