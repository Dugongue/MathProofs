theorem bank_rows {n m : ℕ} (g : ℕ → K) (v : Fin m → Fin n → K)
    (hp : ∀ (a : Fin m) (t : Fin n), g (rowStart (n + m) a.val + t.val) = v a t)
    (hs : ∀ (a u : Fin m), g (rowStart (n + m) a.val + n + u.val) = if u = a then 1 else 0) :
    restRows g (n + m) m 0 = (rows v).map Problem18ArrayElimination20260929.read := by
  have key : ∀ (k : ℕ) (J : Fin m), J.val = k →
      rowVec g (rowStart (n + m) (0 + k)) (n + m) = Problem18ArrayElimination20260929.read (augmented v J) := by
    intro k J hJ
    subst hJ
    funext i
    induction i using Fin.addCases with
    | left a =>
      simp [rowVec, Problem18ArrayElimination20260929.read, augmented, hp]
      show v J a = Fin.addCases (v J) (Pi.single J 1) (Fin.castAdd m a)
      rw [Fin.addCases_left (motive := fun _ => K)]
    | right u =>
      simp [rowVec, Problem18ArrayElimination20260929.read, augmented, ← Nat.add_assoc, hs]
      show (if u = J then (1 : K) else 0) =
        Fin.addCases (motive := fun _ => K) (v J) (Pi.single J 1) (Fin.natAdd n u)
      rw [Fin.addCases_right (motive := fun _ => K), Pi.single_apply]
  unfold restRows rows
  rw [List.map_map]
  apply List.ext_getElem (by simp)
  intro k h1 h2
  simp only [List.getElem_map, List.getElem_range, Function.comp_apply]
  exact key k _ (by simp)
omit [Fintype K] [DecidableEq K] in
theorem bank_query {n m : ℕ} (g : ℕ → K) (x : Fin n → K)
    (hx : ∀ t : Fin n, g (5 + t.val) = x t) (hz : ∀ u < m, g (5 + n + u) = 0) :
    rowVec g 5 (n + m) = Problem18ArrayElimination20260929.read (query (m := m) x) := by
  funext i
  induction i using Fin.addCases with
  | left a =>
    simp [rowVec, Problem18ArrayElimination20260929.read, query, hx]
    show x a = Fin.addCases x 0 (Fin.castAdd m a)
    rw [Fin.addCases_left (motive := fun _ => K)]
  | right u =>
    have := hz u.val u.isLt
    simp [rowVec, Problem18ArrayElimination20260929.read, query, ← Nat.add_assoc, this]
    show (0 : K) = Fin.addCases x (0 : Fin m → K) (Fin.natAdd n u)
    rw [Fin.addCases_right (motive := fun _ => K)]; rfl
theorem load_bank_trial (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (L : LNames)
    (hL : L.Valid r q) {B Sn : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ) {bb xb vb n m : ℕ}
    (hb : σ.vars L.bank = bb) (hxb : σ.vars L.xs = xb) (hvb : σ.vars L.vs = vb)
    (hn : σ.vars L.nr = n) (hm : σ.vars L.mr = m)
    (hfit : bb + rowStart (n + m) m ≤ Sn) (hxfit : xb + n ≤ Sn) (hvfit : vb + m * n ≤ Sn)
    (hxdisj : xb + n ≤ bb ∨ bb + rowStart (n + m) m ≤ xb)
    (hvdisj : vb + m * n ≤ bb ∨ bb + rowStart (n + m) m ≤ vb)
    (x : Fin n → K) (v : Fin m → Fin n → K)
    (hx : ∀ t : Fin n, val F r q.WS σ (xb + t.val) = x t)
    (hv : ∀ (a : Fin m) (t : Fin n), val F r q.WS σ (vb + a.val * n + t.val) = v a t) :
    ∃ τ, Run B (loadCom M q L) σ τ (loadCost M.costPoint F.e n m) ∧ Slots F r q.WS Sn B τ ∧
      val F r q.WS τ bb = 0 ∧
      restRows (fun s => val F r q.WS τ (bb + s)) (n + m) m 0 = (rows v).map Problem18ArrayElimination20260929.read ∧
      rowVec (fun s => val F r q.WS τ (bb + s)) 5 (n + m) = Problem18ArrayElimination20260929.read (query (m := m) x) ∧
      τ.vars q.N = n + m ∧ τ.vars L.bank = bb ∧
      (∀ s < Sn, (s < bb ∨ bb + rowStart (n + m) m ≤ s) →
        val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ y, y ∉ regNames r → y ≠ q.j → y ≠ q.N → y ∉ L.work → τ.vars y = σ.vars y) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  obtain ⟨τ, hr, hSτ, ha, hbq, hc, hd, he, hf, hvars, hN, harr, hi, ho⟩ :=
    load_run M q hq L hL hS hb hxb hvb hn hm hfit hxfit hvfit hxdisj hvdisj x v hx hv
  have hbank : L.bank ∈ L.list := by simp [LNames.list]
  have hbw : L.bank ∉ L.work := by
    have hnd := hL.nodup
