namespace Mathproof.Problem18CharTwoGram20260930
open scoped BigOperators Matrix
open Matrix
open Mathproof.Problem18AlternatingCounts20260930
open Mathproof.Problem18AlternatingEnergy20260930
open Mathproof.Problem18FourierCore20260930
open Mathproof.Problem18CharTwoDiagonal20260930
variable {K : Type*} [Field K] [Fintype K] [CharP K 2]
def symMatSubmodule (n : ℕ) (K : Type*) [Field K] :
    Submodule K (Matrix (Fin n) (Fin n) K) where
  carrier := {A | A.IsSymm}
  zero_mem' := Matrix.isSymm_zero
  add_mem' := Matrix.IsSymm.add
  smul_mem' := fun a _ hA => hA.smul a
abbrev SymMat (n : ℕ) (K : Type*) [Field K] := symMatSubmodule n K
abbrev StrictPair (n : ℕ) := {p : Fin n × Fin n // p.1 < p.2}
def rankOneSymm {n : ℕ} (x : Fin n → K) : SymMat n K :=
  ⟨Matrix.vecMulVec x x, Matrix.IsSymm.ext (by
    intro i j
    simp [Matrix.vecMulVec, mul_comm])⟩
def gramSymm {n m : ℕ} (x : Fin m → (Fin n → K)) : SymMat n K :=
  ∑ b, rankOneSymm (x b)
theorem sum_rankOneSymm_eq_gram {n m : ℕ} (x : Fin m → (Fin n → K)) :
    (∑ b, rankOneSymm (x b)) =
      ⟨fun i j => ∑ b, x b i * x b j, by
        apply Matrix.IsSymm.ext
        intro i j
        apply Finset.sum_congr rfl
        intro b _
        exact mul_comm _ _⟩ := by
  apply Subtype.ext
  change (symMatSubmodule n K).subtype (∑ b, rankOneSymm (x b)) = _
  rw [map_sum]
  ext i j
  rw [Matrix.sum_apply]
  rfl
noncomputable def upperFunctional {n : ℕ}
    (f : StrictPair n → K) (d : Fin n → K) : SymMat n K →ₗ[K] K where
  toFun B := (∑ p, f p * B.val p.1.1 p.1.2) + ∑ i, d i * B.val i i
  map_add' B C := by
    change (∑ p, f p * (B.val p.1.1 p.1.2 + C.val p.1.1 p.1.2)) +
      ∑ i, d i * (B.val i i + C.val i i) = _
    simp only [mul_add, Finset.sum_add_distrib]
    ring
  map_smul' a B := by
    change (∑ p, f p * (a * B.val p.1.1 p.1.2)) +
      ∑ i, d i * (a * B.val i i) = a * _
    rw [mul_add, Finset.mul_sum, Finset.mul_sum]
    apply congrArg₂ (· + ·)
    · apply Finset.sum_congr rfl
      intro p _
      ring
    · apply Finset.sum_congr rfl
      intro i _
      ring
def offdiagBasis {n : ℕ} (p : StrictPair n) : SymMat n K :=
  ⟨Matrix.single p.1.1 p.1.2 1 + Matrix.single p.1.2 p.1.1 1,
    by
      change (Matrix.single p.1.1 p.1.2 1 +
        Matrix.single p.1.2 p.1.1 1 : Matrix (Fin n) (Fin n) K).IsSymm
      simpa [Matrix.transpose_single] using
        Matrix.isSymm_add_transpose_self
          (Matrix.single p.1.1 p.1.2 1 : Matrix (Fin n) (Fin n) K)⟩
def diagBasis {n : ℕ} (i : Fin n) : SymMat n K :=
  ⟨Matrix.single i i 1, by
    change (Matrix.single i i 1 : Matrix (Fin n) (Fin n) K).IsSymm
    rw [Matrix.IsSymm]
    simp [Matrix.transpose_single]⟩
theorem upperFunctional_offdiag {n : ℕ} (f : StrictPair n → K) (d : Fin n → K)
    (p : StrictPair n) : upperFunctional f d (offdiagBasis p) = f p := by
  classical
  let M : Matrix (Fin n) (Fin n) K :=
    Matrix.single p.1.1 p.1.2 1 + Matrix.single p.1.2 p.1.1 1
  change (∑ q, f q * M q.1.1 q.1.2) + ∑ i, d i * M i i = f p
  dsimp only [M]
  simp only [Matrix.add_apply, Matrix.single_apply]
  rw [Finset.sum_eq_single p]
  · have hd : (∑ i, d i *
        ((if p.1.1 = i ∧ p.1.2 = i then 1 else 0) +
          if p.1.2 = i ∧ p.1.1 = i then 1 else 0)) = 0 := by
      apply Finset.sum_eq_zero
      intro i _
      have h₁ : ¬(p.1.1 = i ∧ p.1.2 = i) := by
        intro h
        exact p.property.ne (h.1.trans h.2.symm)
      have h₂ : ¬(p.1.2 = i ∧ p.1.1 = i) := by
        intro h
        exact p.property.ne (h.2.trans h.1.symm)
      simp [h₁, h₂]
    rw [hd]
    simp [p.property.ne]
  · intro q _ hqp
    have hdirect : ¬(p.1.1 = q.1.1 ∧ p.1.2 = q.1.2) := by
      intro h
      apply hqp
      apply Subtype.ext
      exact Prod.ext h.1.symm h.2.symm
    have hswap : ¬(p.1.2 = q.1.1 ∧ p.1.1 = q.1.2) := by
      intro h
      have hp := p.property
      have hq := q.property
      omega
    simp [hdirect, hswap]
  · simp
theorem upperFunctional_diag {n : ℕ} (f : StrictPair n → K) (d : Fin n → K)
    (i : Fin n) : upperFunctional f d (diagBasis i) = d i := by
  classical
  change (∑ p, f p * (Matrix.single i i 1 : Matrix (Fin n) (Fin n) K) p.1.1 p.1.2) +
    ∑ j, d j * (Matrix.single i i 1 : Matrix (Fin n) (Fin n) K) j j = d i
  simp only [Matrix.single_apply]
  have hs : (∑ p, f p * (if i = p.1.1 ∧ i = p.1.2 then 1 else 0)) = 0 := by
    apply Finset.sum_eq_zero
    intro p _
    have hn : ¬(i = p.1.1 ∧ i = p.1.2) := by
      intro h
      have hp := p.property
      omega
    simp [hn]
  rw [hs]
  simp
def strictUpperMatrix {n : ℕ} (A : AltMat n K) : Matrix (Fin n) (Fin n) K :=
  fun i j => if i < j then A.val i j else 0
noncomputable def canonicalQuadratic {n : ℕ} (A : AltMat n K) :
    QuadraticForm K (Fin n → K) :=
  (strictUpperMatrix A).toBilin'.toQuadraticMap
theorem canonicalQuadratic_polar {n : ℕ} (A : AltMat n K) :
    (canonicalQuadratic A).polarBilin = A.val.toBilin' := by
  apply LinearMap.BilinForm.toMatrix'.injective
  ext i j
  simp only [canonicalQuadratic, LinearMap.BilinMap.polarBilin_toQuadraticMap,
    map_add, LinearMap.BilinForm.toMatrix'_apply, LinearMap.add_apply,
    LinearMap.flip_apply, Matrix.toBilin'_single,
    LinearMap.BilinForm.toMatrix'_toBilin']
  rcases lt_trichotomy i j with hij | hij | hij
  · simp [strictUpperMatrix, hij, hij.not_gt]
  · subst j
    have hdiag := A.property.self_eq_zero (Pi.single i 1)
    simpa [strictUpperMatrix] using hdiag.symm
  · have hskew : -A.val i j = A.val j i := by
      simpa using A.property.neg_eq (Pi.single i 1) (Pi.single j 1)
    simpa [strictUpperMatrix, hij, hij.not_gt, CharTwo.neg_eq] using hskew.symm
theorem canonicalQuadratic_polar_rank {n : ℕ} (A : AltMat n K) :
    Module.finrank K (LinearMap.range (canonicalQuadratic A).polarBilin) =
      A.val.rank := by
  rw [canonicalQuadratic_polar]
  exact (alternating_rank_eq_finrank_range A).symm
noncomputable def strictQuadratic {n : ℕ} (f : StrictPair n → K) :
    QuadraticForm K (Fin n → K) :=
  ∑ p, f p • QuadraticMap.proj p.1.1 p.1.2
@[simp] theorem strictQuadratic_apply {n : ℕ} (f : StrictPair n → K)
    (x : Fin n → K) :
    strictQuadratic f x = ∑ p, f p * (x p.1.1 * x p.1.2) := by
  simp [strictQuadratic, smul_eq_mul]
theorem upperFunctional_rankOne {n : ℕ}
    (f : StrictPair n → K) (d : Fin n → K) (x : Fin n → K) :
    upperFunctional f d (rankOneSymm x) =
      strictQuadratic f x + ∑ i, d i * (x i)^2 := by
  simp [upperFunctional, rankOneSymm, Matrix.vecMulVec,
    strictQuadratic_apply, pow_two]
theorem strictQuadratic_polar_basis {n : ℕ} (f : StrictPair n → K)
    (p : StrictPair n) :
    (strictQuadratic f).polarBilin (Pi.single p.1.1 1)
      (Pi.single p.1.2 1) = f p := by
  classical
  have hsingle (a : Fin n) :
      strictQuadratic f (Pi.single a 1) = 0 := by
    rw [strictQuadratic_apply]
    apply Finset.sum_eq_zero
    intro q _
    by_cases h₁ : q.1.1 = a
    · have h₂ : q.1.2 ≠ a := by
        intro h
        exact q.property.ne (h₁.trans h.symm)
      simp [Pi.single_apply, h₁, h₂]
    · simp [Pi.single_apply, h₁]
