section Degree
theorem totalDegree_aeval_le {σ τ R S : Type*} [CommSemiring R] [CommSemiring S] [Algebra R S]
    (φ : σ → MvPolynomial τ S) (hφ : ∀ i, (φ i).totalDegree ≤ 1) (p : MvPolynomial σ R) :
    (aeval φ p).totalDegree ≤ p.totalDegree := by
  classical
  conv_lhs => rw [MvPolynomial.as_sum p]
  rw [map_sum]
  refine le_trans (MvPolynomial.totalDegree_finsetSum _ _) ?_
  refine Finset.sup_le fun s hs => ?_
  rw [MvPolynomial.aeval_monomial]
  refine le_trans (MvPolynomial.totalDegree_mul _ _) ?_
  have hC : (algebraMap R (MvPolynomial τ S) (coeff s p)).totalDegree = 0 := by
    rw [MvPolynomial.algebraMap_apply]
    exact totalDegree_C _
  rw [hC, zero_add]
  change (∏ i ∈ s.support, (φ i) ^ (s i)).totalDegree ≤ _
  refine le_trans (MvPolynomial.totalDegree_finsetProd _ _) ?_
  calc
    ∑ i ∈ s.support, ((φ i) ^ (s i)).totalDegree ≤ ∑ i ∈ s.support, s i := by
      apply Finset.sum_le_sum
      intro i _
      exact (MvPolynomial.totalDegree_pow _ _).trans
        ((Nat.mul_le_mul_left _ (hφ i)).trans (by rw [mul_one]))
    _ = s.sum fun _ e => e := rfl
    _ ≤ p.totalDegree := MvPolynomial.le_totalDegree hs
end Degree
