variable {K : Type*} [Field K] [Fintype K] [DecidableEq K]
theorem rank_stratum_cross_weight_balanced
    (p z r s t : ℕ) (hsp : s ≤ p) (hsr : s ≤ r)
    (ht : t = p + z) (hpz : p ≤ z) (hzp : z ≤ p + 1)
    (ht4 : 4 ≤ t) (hrt : r ≤ 2 * t) :
    (Nat.card {A : Matrix (Fin p) (Fin r) K // A.rank = s} : ℝ) /
          Fintype.card (Matrix (Fin p) (Fin r) K) *
        ((Fintype.card K : ℝ) ^ (s * z))⁻¹ ≤
      4 * ((Fintype.card K : ℝ) ^ ((t * r) / 16))⁻¹ := by
  let q : ℝ := Fintype.card K
  let E : ℕ := (p - s) * (r - s) + s * z
  have hterm := rank_stratum_cross_weight_bound (K := K)
    p r z s hsp hsr
  have hcross := Mathproof.Problem18BalancedCrossExponent20260930.balanced_cross_exponent
    (p : ℝ) (z : ℝ) (r : ℝ) (s : ℝ) (t : ℝ)
    (by positivity) (by positivity) (by positivity) (by positivity)
    (by exact_mod_cast hsp) (by exact_mod_cast hsr)
    (by exact_mod_cast ht)
    (by
      have hpzR : (p : ℝ) ≤ z := by exact_mod_cast hpz
      linarith)
    (by
      have hzpR : (z : ℝ) ≤ p + 1 := by exact_mod_cast hzp
      linarith)
    (by exact_mod_cast ht4) (by exact_mod_cast hrt)
  have hE : (E : ℝ) =
      ((p : ℝ) - s) * ((r : ℝ) - s) + s * z := by
    dsimp only [E]
    push_cast [hsp, hsr]
    rfl
  have hmulR : (t * r : ℝ) ≤ 16 * (E : ℝ) := by
    rw [hE]
    exact hcross
  have hmul : t * r ≤ 16 * E := by exact_mod_cast hmulR
  have hdiv : (t * r) / 16 ≤ E := Nat.div_le_of_le_mul hmul
  have hq : 0 < q := by positivity
  have hq1 : (1 : ℝ) ≤ q := by
    have hq2 : (2 : ℝ) ≤ q := by
      dsimp only [q]
      exact_mod_cast Fintype.one_lt_card (α := K)
    linarith
  have hpow : q ^ ((t * r) / 16) ≤ q ^ E :=
    pow_le_pow_right₀ hq1 hdiv
  have hinv : (q ^ E)⁻¹ ≤ (q ^ ((t * r) / 16))⁻¹ := by
    simpa only [one_div] using one_div_le_one_div_of_le (pow_pos hq _) hpow
  calc
    _ ≤ 4 * (q ^ E)⁻¹ := by simpa only [q, E] using hterm
    _ ≤ 4 * (q ^ ((t * r) / 16))⁻¹ :=
      mul_le_mul_of_nonneg_left hinv (by norm_num)
theorem cross_rank_sum_balanced
    (p z r t : ℕ) (ht : t = p + z) (hpz : p ≤ z) (hzp : z ≤ p + 1)
    (ht4 : 4 ≤ t) (hrt : r ≤ 2 * t) :
    (∑ s : Fin (min p r + 1),
      (Nat.card {A : Matrix (Fin p) (Fin r) K // A.rank = s.val} : ℝ) /
          Fintype.card (Matrix (Fin p) (Fin r) K) *
        ((Fintype.card K : ℝ) ^ (s.val * z))⁻¹) ≤
      4 * (p + 1) *
        ((Fintype.card K : ℝ) ^ ((t * r) / 16))⁻¹ := by
  have hterm (s : Fin (min p r + 1)) :
      (Nat.card {A : Matrix (Fin p) (Fin r) K // A.rank = s.val} : ℝ) /
            Fintype.card (Matrix (Fin p) (Fin r) K) *
          ((Fintype.card K : ℝ) ^ (s.val * z))⁻¹ ≤
        4 * ((Fintype.card K : ℝ) ^ ((t * r) / 16))⁻¹ := by
    have hsmin : s.val ≤ min p r := by omega
    exact rank_stratum_cross_weight_balanced (K := K)
      p z r s.val t (hsmin.trans (min_le_left _ _))
      (hsmin.trans (min_le_right _ _)) ht hpz hzp ht4 hrt
  calc
    _ ≤ ∑ _s : Fin (min p r + 1),
          4 * ((Fintype.card K : ℝ) ^ ((t * r) / 16))⁻¹ :=
      Finset.sum_le_sum fun s _ => hterm s
    _ = (min p r + 1) *
          (4 * ((Fintype.card K : ℝ) ^ ((t * r) / 16))⁻¹) := by simp
    _ ≤ (p + 1) *
          (4 * ((Fintype.card K : ℝ) ^ ((t * r) / 16))⁻¹) := by
      gcongr
      exact_mod_cast min_le_left p r
    _ = _ := by ring
theorem crossZero_probability_balanced
    (p z r t : ℕ) (ht : t = p + z) (hpz : p ≤ z) (hzp : z ≤ p + 1)
    (ht4 : 4 ≤ t) (hrt : r ≤ 2 * t) :
    (Nat.card (CrossZeroPairs (K := K) p r z) : ℝ) /
        Fintype.card
          (Matrix (Fin p) (Fin r) K × Matrix (Fin z) (Fin r) K) ≤
      4 * (p + 1) *
        ((Fintype.card K : ℝ) ^ ((t * r) / 16))⁻¹ := by
  rw [crossZero_probability_eq_rank_sum]
  exact cross_rank_sum_balanced p z r t ht hpz hzp ht4 hrt
end Mathproof.Problem18AnchorBalancedCross20260930
