theorem list_eq_of_getD (l₁ l₂ : List Nat) (hlen : l₁.length = l₂.length)
    (h : ∀ j, j < l₁.length → l₁.getD j 0 = l₂.getD j 0) : l₁ = l₂ := by
  apply List.ext_getElem hlen
  intro j h1 h2
  have := h j h1
  rw [List.getD_eq_getElem?_getD, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h1,
    List.getElem?_eq_getElem h2] at this
  simpa using this
theorem Run.eq_of_runs {B K₁ K₂ : Nat} {c : Com} {σ τ₁ τ₂ : Env}
    (h₁ : Run B c σ τ₁ K₁) (h₂ : Run B c σ τ₂ K₂) : τ₁ = τ₂ := by
  obtain ⟨k₁, -, hb₁⟩ := h₁.bigStep
  obtain ⟨k₂, -, hb₂⟩ := h₂.bigStep
  exact (BigStep.unique hb₁ hb₂).1
theorem canonical_nodup : (scalarNames canonical).Nodup := canonical_valid.1
theorem canonical_mem_ne_scratch : canonical.mem ≠ canonical.scratch := canonical_valid.2
theorem canonical_names_ne_i :
