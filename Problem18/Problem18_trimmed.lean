  have ha':a ≤ a*b*c:=(Nat.le_mul_of_pos_right _ hb).trans (Nat.le_mul_of_pos_right _ hc)
  have hb':b ≤ a*b*c:=(Nat.le_mul_of_pos_left _ ha).trans (Nat.le_mul_of_pos_right _ hc)
  have hc':c ≤ a*b*c:=Nat.le_mul_of_pos_left _ (Nat.mul_pos ha hb)
  have hq:=bits_length_add_one_le_bitSize_of_mem
    (show q∈queryWords F u q A T by simp [queryWords,header])
