open Polynomial
open Mathproof.Problem18BinaryPower20260930
variable {K : Type*} [Field K] [DecidableEq K]
def modBits (f x : K[X]) : List Bool → K[X] × ℕ
  | [] => (1 % f, 0)
  | b :: bs =>
    let r := modBits f x bs
    let s := (r.1 * r.1) % f
    if b then ((s * (x % f)) % f, r.2 + 2) else (s, r.2 + 1)
def modularPower (f x : K[X]) (n : ℕ) : K[X] × ℕ := modBits f x n.bits
theorem map_mod_eq {R : Type*} [CommRing R] (φ : K[X] →+* R)
    (f : K[X]) (hf : φ f = 0) (p : K[X]) : φ (p % f) = φ p := by
  rw [EuclideanDomain.mod_eq_sub_mul_div, map_sub, map_mul, hf, zero_mul, sub_zero]
theorem modBits_map {R : Type*} [CommRing R] (φ : K[X] →+* R)
    (f x : K[X]) (hf : φ f = 0) (bs : List Bool) :
    φ (modBits f x bs).1 = (φ x) ^ bitsValue bs := by
  induction bs with
  | nil => simp only [modBits, map_mod_eq φ f hf, map_one, bitsValue, pow_zero]
  | cons b bs ih =>
    cases b <;> simp [modBits, map_mod_eq φ f hf, map_mul, ih,
      bitsValue, Nat.bit_val, Nat.mul_comm 2, pow_add, pow_mul, pow_two]
theorem modularPower_map {R : Type*} [CommRing R] (φ : K[X] →+* R)
    (f x : K[X]) (hf : φ f = 0) (n : ℕ) :
    φ (modularPower f x n).1 = (φ x)^n := by
  simpa only [modularPower, bitsValue_bits] using modBits_map φ f x hf n.bits
theorem modularPower_dvd_difference (f x : K[X]) (n : ℕ) :
    f ∣ (modularPower f x n).1 - x^n := by
  let I : Ideal K[X] := Ideal.span {f}
  have hf : Ideal.Quotient.mk I f = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton f))
  have hm := modularPower_map (Ideal.Quotient.mk I) f x hf n
  have hz : Ideal.Quotient.mk I ((modularPower f x n).1 - x^n) = 0 := by
    rw [map_sub, map_pow, hm, sub_self]
  exact Ideal.mem_span_singleton.mp (Ideal.Quotient.eq_zero_iff_mem.mp hz)
end
end Mathproof.Problem18UnivariateSolver20260930
