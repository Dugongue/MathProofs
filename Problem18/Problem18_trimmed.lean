theorem coords_indep_L : AlgebraicIndependent L (coords L) :=
  (MvPolynomial.algebraicIndependent_X (Fin 2) L).map' (coords_injective_map L)
theorem coords_indep_K : AlgebraicIndependent K (coords L) :=
  (coords_indep_L L).restrictScalars (algebraMap K L).injective
theorem trans_range {R : Type u} [Field R] [Algebra R (Ambient L)]
    (h : AlgebraicIndependent R (coords L)) :
    Transcendental (Polynomial.aeval (coords L 0) : R[X] →ₐ[R] Ambient L).range (coords L 1) := by
  have hs : (Polynomial.aeval (coords L 0) : R[X] →ₐ[R] Ambient L).range =
      Algebra.adjoin R (coords L '' {0}) := by
    rw [Set.image_singleton, Algebra.adjoin_singleton_eq_range_aeval]
  rw [hs]
  exact h.transcendental_adjoin (s := {0}) (i := 1) (by simp)
noncomputable def genericPair : GenericPair K L where
  Ω := Ambient L
  u := coords L 0
  u₀ := coords L 1
  trans_L := (coords_indep_L L).transcendental 0
  trans_L₀ := trans_range L (coords_indep_L L)
  trans_K := (coords_indep_K K L).transcendental 0
  trans_K₀ := trans_range L (coords_indep_K K L)
