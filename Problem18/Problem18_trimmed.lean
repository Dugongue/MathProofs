namespace Mathproof.Problem18RationalPlaceDescent20260930
open scoped WithZero
open Problem18PlaceRestriction20260930
variable {k K : Type*} [Field k] [Field K] [Algebra k K]
theorem residue_zero_iff (P : FunctionField.Place k K) (a : P.toValuationSubring) :
    IsLocalRing.residue P.toValuationSubring a = 0 ↔ P.valuation (a : K) < 1 := by
  rw [IsLocalRing.residue_eq_zero_iff, ValuationSubring.valuation_lt_one_iff]
  exact P.valuation_isEquiv_canonical.lt_one_iff_lt_one.symm
theorem degree_one_iff_surjective (P : FunctionField.Place k K) :
    P.degree = 1 ↔ Function.Surjective (algebraMap k P.residueField) := by
  rw [FunctionField.Place.degree, Algebra.finrank_eq_one_iff_bijective_algebraMap]
  exact ⟨And.right, fun h => ⟨(algebraMap k P.residueField).injective, h⟩⟩
theorem degree_one_iff_approximation (P : FunctionField.Place k K) :
    P.degree = 1 ↔ ∀ x ∈ P, ∃ c : k, P.valuation (x - algebraMap k K c) < 1 := by
  letI : IsScalarTower k P.toValuationSubring K := .of_algebraMap_eq fun _ => rfl
  have hsub : ∀ (a : P.toValuationSubring) (c : k),
      ((a - algebraMap k P.toValuationSubring c : P.toValuationSubring) : K) =
        (a : K) - algebraMap k K c := fun a c => by
    rw [← ValuationSubring.algebraMap_apply P.toValuationSubring
      (a - algebraMap k P.toValuationSubring c), map_sub,
      ← IsScalarTower.algebraMap_apply k P.toValuationSubring K,
      ValuationSubring.algebraMap_apply]
  have key : ∀ (a : P.toValuationSubring) (c : k),
      P.valuation ((a : K) - algebraMap k K c) < 1 ↔
        IsLocalRing.residue P.toValuationSubring a = algebraMap k P.residueField c := by
    intro a c
    rw [← hsub a c, ← residue_zero_iff, map_sub, sub_eq_zero]
    rw [IsScalarTower.algebraMap_apply k P.toValuationSubring P.residueField,
      IsLocalRing.ResidueField.algebraMap_eq]
  rw [degree_one_iff_surjective]
  constructor
  · intro h x hx
    obtain ⟨c,hc⟩ := h (IsLocalRing.residue P.toValuationSubring ⟨x,hx⟩)
    exact ⟨c,(key ⟨x,hx⟩ c).mpr hc.symm⟩
  · intro h y
    obtain ⟨a,rfl⟩ := IsLocalRing.residue_surjective y
    obtain ⟨c,hc⟩ := h (a : K) a.property
    exact ⟨c,((key a c).mp hc).symm⟩
variable (k E L : Type*) [Field k] [Field E] [Field L]
  [Algebra k E] [Algebra k L] [Algebra E L] [IsScalarTower k E L]
def forgetConstants (Q : FunctionField.Place E L) : FunctionField.Place k L where
  toValuationSubring := Q.toValuationSubring
  ne_top := Q.ne_top
  triv_on_k c := by
    rw [IsScalarTower.algebraMap_apply k E L]
    exact Q.triv_on_k _
  isDiscrete := Q.isDiscrete
@[simp] theorem forgetConstants_valuation (Q : FunctionField.Place E L) :
    (forgetConstants k E L Q).valuation = Q.valuation := rfl
theorem rational_restrict_of_frobenius [Fintype k] [Finite E]
    (H : IntermediateField k L) [Algebra.IsAlgebraic H L]
    (θ : L ≃ₐ[k] L)
    (hH : ∀ x : H, θ (x : L) = x)
    (hE : ∀ c : E, θ (algebraMap E L c) =
      algebraMap E L (FiniteField.frobeniusAlgEquivOfAlgebraic k E c))
    (Q : FunctionField.Place E L) (hQ : Q.degree = 1)
    (hθ : ∀ x : L, Q.valuation (θ x) = Q.valuation x) :
    (restrictPlace k H L (forgetConstants k E L Q)).degree = 1 := by
  apply (degree_one_iff_approximation _).mpr
  intro x hx
  have hxQ : (x : L) ∈ Q := (mem_restrictPlace k H L _ x).mp hx
  obtain ⟨c,hc⟩ := (degree_one_iff_approximation Q).mp hQ (x : L) hxQ
  have hc' : Q.valuation ((x : L) - algebraMap E L
      (FiniteField.frobeniusAlgEquivOfAlgebraic k E c)) < 1 := by
    have h := hθ ((x : L) - algebraMap E L c)
    rw [map_sub, hH, hE] at h
    exact h.symm ▸ hc
  have hdiff : Q.valuation (algebraMap E L
      (FiniteField.frobeniusAlgEquivOfAlgebraic k E c - c)) < 1 := by
    have h := Q.valuation.map_sub_lt hc hc'
    convert h using 1
    congr 1
    rw [map_sub]
    ring
  have hcf : FiniteField.frobeniusAlgEquivOfAlgebraic k E c = c := by
    by_contra hne
    rw [Valuation.IsTrivialOn.eq_one _ (sub_ne_zero.mpr hne)] at hdiff
    exact lt_irrefl _ hdiff
  obtain ⟨a,ha⟩ := Problem18FrobeniusTwistField20260930.frobenius_fixed_mem_range k E c hcf
  refine ⟨a,?_⟩
  apply (restrictPlace_valuation_isEquiv k H L _).lt_one_iff_lt_one.mpr
  change Q.valuation (algebraMap H L (x - algebraMap k H a)) < 1
  rw [map_sub, ← IsScalarTower.algebraMap_apply k H L,
    IsScalarTower.algebraMap_apply k E L, ha]
  exact hc
end Mathproof.Problem18RationalPlaceDescent20260930
end
end
