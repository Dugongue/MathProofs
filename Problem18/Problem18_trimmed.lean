    (hwo : σ.vars coordinateNames.workBase+8*F.e ≤ σ.vars target)
    (hof : σ.vars target+(2*N)*F.e ≤ (σ.arrs canonical.mem).length)
    (hq : σ.vars canonical.exp=q) (hqB : q<B) (k : Nat) (hk : k ≤ N) :
    ∃τ,Run B (program k) σ τ (k*(coordinateCost F q+20)+1) ∧ ValidMemory F B τ ∧
      (∀i<k,(decode F (slice F τ canonical (σ.vars target+(2*i)*F.e)),
        decode F (slice F τ canonical (σ.vars target+(2*i+1)*F.e)))=
        (((rootCoordinates F d (decode F (slice F σ canonical (σ.vars source+i*F.e)))).1:K),
         ((rootCoordinates F d (decode F (slice F σ canonical (σ.vars source+i*F.e)))).2:K))) ∧
      (∀j<(σ.arrs canonical.mem).length,
        (j<σ.vars coordinateNames.workBase ∨ σ.vars coordinateNames.workBase+8*F.e ≤ j) →
