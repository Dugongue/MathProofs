namespace Mathproof.Problem18DimensionOneBoundary20260930
open Matrix Problem18OrthogonalAssembly
variable {K : Type} [Field K] {b c : ℕ}
def matrixOf (A : RectTensor 1 b c K) : Matrix (Fin c) (Fin b) K :=
  fun i j => A i (0,j)
theorem matrixOf_injective : Function.Injective (matrixOf (K := K) (b := b) (c := c)) := by
  intro A B h
  ext i j
  rcases j with ⟨j,k⟩
  have hj : j = 0 := Subsingleton.elim _ _
  subst j
  exact congrFun (congrFun h i) k
theorem matrixOf_action (A : RectTensor 1 b c K)
    (P : Matrix (Fin 1) (Fin 1) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) :
    matrixOf (rectAction P Q R A) = R * matrixOf A * (P 0 0 • Q).transpose := by
  ext i j
  simp only [matrixOf, rectAction, Matrix.mul_apply, Matrix.transpose_apply,
    Matrix.kronecker, Matrix.kronecker_apply, Fintype.sum_prod_type, Fin.sum_univ_one,
    Matrix.smul_apply, smul_eq_mul]
theorem orthogonal_one_scalar (P : Matrix (Fin 1) (Fin 1) K)
    (hP : IsOrthogonal P) : P 0 0 * P 0 0 = 1 := by
  have h := congrFun (congrFun hP 0) 0
  simpa [Matrix.mul_apply] using h
theorem orthogonal_smul {n : ℕ} (z : K) (Q : Matrix (Fin n) (Fin n) K)
    (hz : z*z = 1) (hQ : IsOrthogonal Q) : IsOrthogonal (z • Q) := by
  unfold IsOrthogonal at *
  rw [Matrix.transpose_smul, Matrix.smul_mul, Matrix.mul_smul, smul_smul, hz, one_smul, hQ]
theorem orthogonal_transpose {n : ℕ} (Q : Matrix (Fin n) (Fin n) K)
    (hQ : IsOrthogonal Q) : IsOrthogonal Q.transpose := by
  simpa only [IsOrthogonal, Matrix.transpose_transpose] using (mul_eq_one_comm.mp hQ)
def MatrixOrthogonalEquivalent (F G : Matrix (Fin c) (Fin b) K) : Prop :=
  ∃ (R : Matrix (Fin c) (Fin c) K) (Q : Matrix (Fin b) (Fin b) K),
    IsOrthogonal R ∧ IsOrthogonal Q ∧ R*F*Q=G
theorem orthogonal_dimension_one_iff (A B : RectTensor 1 b c K) :
    RectOrthogonalEquivalent A B ↔ MatrixOrthogonalEquivalent (matrixOf A) (matrixOf B) := by
  constructor
  · rintro ⟨P,Q,R,hP,hQ,hR,hact⟩
    refine ⟨R, (P 0 0 • Q).transpose, hR,
      orthogonal_transpose _ (orthogonal_smul _ Q (orthogonal_one_scalar P hP) hQ), ?_⟩
    rw [← matrixOf_action, hact]
  · rintro ⟨R,Q,hR,hQ,hact⟩
    refine ⟨1,Q.transpose,R,?_,orthogonal_transpose Q hQ,hR,?_⟩
    · simp [IsOrthogonal]
    · apply matrixOf_injective
      simpa [matrixOf_action] using hact
theorem root_orthogonal_dimension_one_iff (q : ℕ) (A B : RectTensor 1 b c K) :
    Mathproof.Problem18AllFormatRoot20260930.equivalent false q A B ↔
      MatrixOrthogonalEquivalent (matrixOf A) (matrixOf B) :=
  (Mathproof.Problem18AllFormatRoot20260930.equivalent_orthogonal q A B).trans
    (orthogonal_dimension_one_iff A B)
section Unitary
variable [StarRing K]
theorem unitary_one_scalar (P : Matrix (Fin 1) (Fin 1) K)
    (hP : Problem18Assembly.IsUnitary P) : star (P 0 0) * P 0 0 = 1 := by
  have h := congrFun (congrFun hP 0) 0
  simpa [Matrix.mul_apply] using h
theorem unitary_smul {n : ℕ} (z : K) (Q : Matrix (Fin n) (Fin n) K)
    (hz : star z*z = 1) (hQ : Problem18Assembly.IsUnitary Q) :
    Problem18Assembly.IsUnitary (z • Q) := by
  unfold Problem18Assembly.IsUnitary at *
  rw [Matrix.conjTranspose_smul, Matrix.smul_mul, Matrix.mul_smul, smul_smul, hz, one_smul, hQ]
theorem unitary_transpose {n : ℕ} (Q : Matrix (Fin n) (Fin n) K)
    (hQ : Problem18Assembly.IsUnitary Q) : Problem18Assembly.IsUnitary Q.transpose := by
  have h := congrArg Matrix.transpose (mul_eq_one_comm.mp hQ)
  simpa [Problem18Assembly.IsUnitary, Matrix.transpose_mul, Matrix.conjTranspose,
    Matrix.transpose_map] using h
def MatrixUnitaryEquivalent (F G : Matrix (Fin c) (Fin b) K) : Prop :=
  ∃ (R : Matrix (Fin c) (Fin c) K) (Q : Matrix (Fin b) (Fin b) K),
    Problem18Assembly.IsUnitary R ∧ Problem18Assembly.IsUnitary Q ∧ R*F*Q=G
theorem unitary_dimension_one_iff (A B : RectTensor 1 b c K) :
    Problem18Assembly.RectUnitaryEquivalent A B ↔
      MatrixUnitaryEquivalent (matrixOf A) (matrixOf B) := by
  constructor
  · rintro ⟨P,Q,R,hP,hQ,hR,hact⟩
    refine ⟨R, (P 0 0 • Q).transpose, hR,
      unitary_transpose _ (unitary_smul _ Q (unitary_one_scalar P hP) hQ), ?_⟩
    rw [← matrixOf_action]
    exact congrArg matrixOf hact
  · rintro ⟨R,Q,hR,hQ,hact⟩
    refine ⟨1,Q.transpose,R,?_,unitary_transpose Q hQ,hR,?_⟩
    · simp [Problem18Assembly.IsUnitary]
    · apply matrixOf_injective
      change matrixOf (rectAction 1 Q.transpose R A) = matrixOf B
      simpa [matrixOf_action] using hact
theorem root_unitary_dimension_one_iff (q : ℕ) (hstar : ∀ x : K, star x=x^q)
    (A B : RectTensor 1 b c K) :
    Mathproof.Problem18AllFormatRoot20260930.equivalent true q A B ↔
