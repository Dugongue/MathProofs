variable {K V W Z : Type*} [Field K] [AddCommGroup V] [Module K V]
  [AddCommGroup W] [Module K W] [AddCommGroup Z] [Module K Z]
set_option backward.isDefEq.respectTransparency false
theorem aeval_intertwines (A : Module.End K V) (D : Module.End K W) (j : V →ₗ[K] W)
    (hj : ∀ x,j (A x)=D (j x)) (p : K[X]) (x : V) :
    j ((Polynomial.aeval A p) x)=(Polynomial.aeval D p) (j x) := by
  have hpow (n : ℕ) (x : V) : j ((A^n) x)=(D^n) (j x) := by
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ',pow_succ',Module.End.mul_apply,Module.End.mul_apply,hj,ih]
  induction p using Polynomial.induction_on' with
  | add p q ih iq => simp only [map_add,LinearMap.add_apply,ih,iq]
  | monomial n a =>
      simp only [Polynomial.aeval_monomial,← Algebra.smul_def,LinearMap.smul_apply,j.map_smul,hpow]
theorem eq_zero_of_coprime_charpoly [FiniteDimensional K W]
    (D : Module.End K W) (p : K[X]) (hc : IsCoprime p D.charpoly)
    (x : W) (hx : (Polynomial.aeval D p) x=0) : x=0 := by
  obtain ⟨u,v,h⟩ := hc
  have hh := congrArg (fun r : K[X] => (Polynomial.aeval D r) x) h
  simpa only [map_add,map_mul,map_one,LinearMap.add_apply,Module.End.mul_apply,hx,
    D.aeval_self_charpoly,LinearMap.zero_apply,map_zero,add_zero,Module.End.one_apply] using hh.symm
theorem block_primary_kernel [FiniteDimensional K V] [FiniteDimensional K W]
    (A : Module.End K V) (D : Module.End K W) (hc : IsCoprime A.charpoly D.charpoly) :
    LinearMap.ker (Polynomial.aeval (A.prodMap D) A.charpoly)=
      LinearMap.range (LinearMap.inl K V W) := by
  ext z
  constructor
  · intro hz
    rcases z with ⟨x,y⟩
    have hh := aeval_intertwines (A.prodMap D) D (LinearMap.snd K V W)
      (fun _ => rfl) A.charpoly (x,y)
    rw [LinearMap.mem_ker.mp hz,map_zero] at hh
    have hy : y=0 := eq_zero_of_coprime_charpoly D A.charpoly hc y hh.symm
    exact ⟨x,Prod.ext rfl hy.symm⟩
  · rintro ⟨x,rfl⟩
    apply LinearMap.mem_ker.mpr
    have hh := aeval_intertwines A (A.prodMap D) (LinearMap.inl K V W)
      (fun x => by simp only [LinearMap.inl_apply,LinearMap.prodMap_apply,map_zero]) A.charpoly x
    rw [A.aeval_self_charpoly,LinearMap.zero_apply,map_zero] at hh
    exact hh.symm
theorem conjugate_primary_kernel [FiniteDimensional K V] [FiniteDimensional K W]
    (A : Module.End K V) (D : Module.End K W) (e : (V × W) ≃ₗ[K] Z)
    (hc : IsCoprime A.charpoly D.charpoly) :
    LinearMap.ker (Polynomial.aeval (e.conj (A.prodMap D)) A.charpoly)=
      LinearMap.range (e.toLinearMap.comp (LinearMap.inl K V W)) := by
  have he (x : V × W) : e ((A.prodMap D) x)=(e.conj (A.prodMap D)) (e x) := by
    simp only [LinearEquiv.conj_apply_apply,LinearEquiv.symm_apply_apply]
  have hp := aeval_intertwines (A.prodMap D) (e.conj (A.prodMap D)) e.toLinearMap he A.charpoly
  ext z
  constructor
  · intro hz
    have hh := hp (e.symm z)
    simp only [LinearEquiv.coe_coe,LinearEquiv.apply_symm_apply,LinearMap.mem_ker.mp hz] at hh
    have hker : e.symm z ∈ LinearMap.ker (Polynomial.aeval (A.prodMap D) A.charpoly) := by
      apply LinearMap.mem_ker.mpr
      exact e.injective (hh.trans (map_zero e).symm)
    rw [block_primary_kernel A D hc] at hker
    obtain ⟨x,hx⟩ := hker
    refine ⟨x,?_⟩
    change e (LinearMap.inl K V W x)=z
    rw [hx,e.apply_symm_apply]
  · rintro ⟨x,rfl⟩
    apply LinearMap.mem_ker.mpr
    have hz : (Polynomial.aeval (A.prodMap D) A.charpoly) (LinearMap.inl K V W x)=0 := by
      apply LinearMap.mem_ker.mp
      rw [block_primary_kernel A D hc]
      exact ⟨x,rfl⟩
    have hh := hp (LinearMap.inl K V W x)
    rw [hz,map_zero] at hh
    exact hh.symm
theorem marked_primary_range [FiniteDimensional K V] [FiniteDimensional K W]
    (σ : K ≃+* K) (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft)
    (A : SelfAdjointOperators σ B) (j : EmbeddingOrbit σ B C)
    (T : MarkedFiber σ B C A j.val)
    (hc : IsCoprime A.val.charpoly (T.val.val.charpoly/A.val.charpoly)) :
    LinearMap.ker (Polynomial.aeval T.val.val A.val.charpoly)=LinearMap.range j.val := by
  let Q : Isometries σ (sumForm σ B C) := Classical.choose j.property
  let D := markedFiberEquiv σ B C hB A j T
  have hT : T.val.val=Q.val.conj (A.val.prodMap D.val) := by
    have hh := congrArg (fun U : MarkedFiber σ B C A j.val => U.val.val)
      ((markedFiberEquiv σ B C hB A j).symm_apply_apply T)
    exact hh.symm
  have hD : IsCoprime A.val.charpoly D.val.charpoly := by
    rw [markedFiber_charpoly σ B C hB A j T,
      mul_div_cancel_left₀ _ A.val.charpoly_monic.ne_zero] at hc
    exact hc
  have hj : Q.val.toLinearMap.comp (LinearMap.inl K V W)=j.val := Classical.choose_spec j.property
  rw [hT,← hj]
  exact conjugate_primary_kernel A.val D.val Q.val hD
end
