    (ha : a.evalB B sigma = some s) (hb : b.evalB B sigma = some d)
    (hc : c.evalB B sigma = some n)
    (hn : n < B) (hsB : s+n < B) (hdB : d+n < B)
    (hsep : s+n <= d)
    (hmodsep : sigma.vars canonical.modBase + F.e <= d)
    (hsrc : s+n <= (sigma.arrs canonical.mem).length)
    (hdst : d+n <= (sigma.arrs canonical.mem).length) :
