  letI : q.LiesOver p.asIdeal := hqp
  let Q : HeightOneSpectrum B := ⟨q, inferInstance, Ideal.ne_bot_of_liesOver_of_ne_bot p.ne_bot q⟩
  have hval : ∀ a : A, Q.valuation L (algebraMap F L a) ≤ 1 := by
