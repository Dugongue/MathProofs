  have eb:ρ.vars savedB=σ.vars canonical.bBase:=by
    simpa [initialized,savedA,savedB,savedOut,acc,prod,next,strideA,strideB,total,outputIndex,canonical]
      using regs savedB (by simp [protectedRegisters])
  have eo:ρ.vars savedOut=σ.vars canonical.outBase:=by
    simpa [initialized,savedA,savedB,savedOut,acc,prod,next,strideA,strideB,total,outputIndex,canonical]
      using regs savedOut (by simp [protectedRegisters])
  have hrest:=restore_run ρ (by rw [ea];exact ha) (by rw [eb];exact hb) (by rw [eo];exact ho)
  have hall:=prefix_run F
    (.seq (.while (.lt (.var outputIndex) (.var total)) Problem18IMPMatrixProductLoop20261001.body) restore)
    he ha hb ho hw hm hn hmn (hr.seq hrest)
  have hsame:τ=restored ρ:=by
    obtain ⟨k,hk,hks⟩:=hrun.bigStep
    obtain ⟨l,hl,hls⟩:=hall.bigStep
    exact (hks.unique hls).1
  rw [hsame]
  change (ρ.arrs canonical.mem).getD j 0=_
  apply hρ.memory j hj
  constructor
  · simpa [initialized,savedOut,total,outputIndex,acc,prod,next,strideA,strideB] using hout
  · intro x hx
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hx
    rcases hx with rfl|rfl|rfl
    all_goals
      simp [initialized,Env.setVar,acc,prod,next,strideA,strideB,total,outputIndex,savedA,savedB,savedOut]
      rcases hwork with hh|hh
      · exact Or.inl (by omega)
      · exact Or.inr (by omega)
