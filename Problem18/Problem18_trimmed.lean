  · obtain ⟨m, hm⟩ := mem_nilradical.mp h1
    rw [one_pow] at hm
    exact one_ne_zero hm
  · rcases h x with hn | hu
    · exact absurd (mem_nilradical.mpr hn) hx
    · obtain ⟨y, hy⟩ := hu.exists_right_inv
      rw [← hy]
      exact J.mul_mem_right y hxJ
