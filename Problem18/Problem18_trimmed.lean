    (heps : eps*τ eps=1) (B : Form (V := Fin n → K) τ) (hB : B.SeparatingLeft)
    (hsym : ∀x y,B y x=eps*τ (B x y))
    (E : (Fin s → K) →ₗ[K] (Fin n → K)) (hE : Function.Injective E)
    (Z : Finset (Upper s)) : Function.Surjective (coordinates τ B E Z) := by
