    · exact hV.coefficients j (by rw [← hl]; exact hj)
  · intro i hi'
    have := decode_of_copy F hbank hdata i hi'
    exact this
theorem store_run {W Sn bankLen : Nat} {σ : Env} (hG : Glob F W Sn bankLen σ)
    {s d n : Expr} {sv dv nv : Nat} {v : Nat → K}
    (hcs : Clean s) (hcd : Clean d) (hcn : Clean n)
