    [Module E (Fin n → K)] [IsScalarTower K E (Fin n → K)]
    (T : Module.End K (Fin n → K)) (hT : ∀ a : E, ∀ x, T (a•x)=a•T x) :
    ExtensionStable (E := E) (LinearMap.range T) := by
  intro a y hy
