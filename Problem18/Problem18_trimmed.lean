    ∀ β' ∈ ((minpoly F β).map ((algebraMap E (SplittingField ((minpoly F β).map (algebraMap F E)))).comp
      (algebraMap F E))).roots,
      -(α' - algebraMap E (SplittingField ((minpoly F β).map (algebraMap F E))) α) /
        (β' - algebraMap E (SplittingField ((minpoly F β).map (algebraMap F E))) β) ≠
