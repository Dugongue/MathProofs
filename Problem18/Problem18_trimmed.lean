  funext i
  induction i using Fin.addCases with
  | left i => simp [Fin.append_left]
  | right i => simp [Fin.append_right]
theorem pivots_injective {L : Type*} [Field L] {s k : ℕ} (n d E T D : ℕ)
    (F : Fin s → Fin (boxSize n d) → L) (S : Fin k → Fin (boxSize n E))
    (U : Fin k → Fin (boxSize n E) → L) (h : IsParam n d E T D F S U) : Function.Injective S := by
  intro j j' hjj
  have h1 := h.1 j j
  have h2 := h.1 j j'
  rw [← hjj, h1] at h2
  by_contra hne
  rw [if_neg hne, if_pos rfl] at h2
  exact one_ne_zero h2
