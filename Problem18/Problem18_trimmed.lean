variable {K : Type*} [Field K] [Fintype K] {n : ℕ}
theorem nondegenerate_preservation_card_mul_le (B : LinearMap.BilinForm K (Fin n → K)) (hB : B.Nondegenerate)
    (hsym : ∀x y,B y x= -B x y) (W : Submodule K (Fin n → K))
    (hW : W ⊓ W.orthogonalBilin B=⊥) :
    Nat.card {T : alternatingSpace B // Preserves W T.val} *
      Fintype.card K^(finrank K W*(n-finrank K W)) ≤ Nat.card (alternatingSpace B) := by
  classical
  let k := finrank K W
  let O := W.orthogonalBilin B
  let z := finrank K O
  obtain ⟨E,hE,hw,hv⟩ := exists_adaptedCoordinateMap B W O le_rfl
    (disjoint_iff.mpr hW)
  have hf (i : Fin (k+z)) (hi : i.val<k) : E (Pi.single i 1)∈W := by
    let j : Fin k := ⟨i.val,hi⟩
    have he : Fin.castAdd z j=i := Fin.ext rfl
    have hh := hw j
    change E (Pi.single (Fin.castAdd z j) 1)∈W at hh
    rwa [he] at hh
  have hl (i : Fin (k+z)) (hi : k ≤ i.val) : ∀w∈W,B w (E (Pi.single i 1))=0 := by
    let j : Fin z := ⟨i.val-k,by have := i.isLt; omega⟩
    have he : Fin.natAdd k j=i := Fin.ext (by simp only [Fin.val_natAdd,j]; omega)
    have hh := hv j
    change (∀w∈W,B w (E (Pi.single (Fin.natAdd k j) 1))=0) at hh
    rwa [he] at hh
  have hg := preservation_card_mul_le B hB.1 hsym W
    (t := 0) (a := k) (c := z)
  rw [Nat.zero_add] at hg
  simp only [Nat.choose_zero_succ,zero_mul] at hg
  have hh := hg E hE hf (by simpa only [Nat.not_lt_zero,false_or] using hl)
  have hd := Mathproof.Problem18SesquiOrthogonalDimension20260930.finrank_add_orthogonal (RingEquiv.refl K) B hB W
  have hz : z=n-k := by dsimp [z,O,k]; omega
  simpa only [Nat.choose_zero_succ,zero_mul,zero_add,hz,k] using hh
theorem isotropic_preservation_card_mul_le (B : LinearMap.BilinForm K (Fin n → K)) (hB : B.Nondegenerate)
    (hsym : ∀x y,B y x= -B x y) (W : Submodule K (Fin n → K))
    (hW : W≤W.orthogonalBilin B) :
    Nat.card {T : alternatingSpace B // Preserves W T.val} *
      Fintype.card K^((finrank K W).choose 2+finrank K W*(n-2*finrank K W)) ≤
      Nat.card (alternatingSpace B) := by
  classical
  let k := finrank K W
  obtain ⟨C,hCO,hWC,hCdim⟩ := exists_orthogonal_complement B W
  let z := finrank K C
  obtain ⟨E,hE,hw,hv⟩ := exists_adaptedCoordinateMap B W C hCO hWC
  have hf (i : Fin (k+z)) (hi : i.val<k) : E (Pi.single i 1)∈W := by
    let j : Fin k := ⟨i.val,hi⟩
    have he : Fin.castAdd z j=i := Fin.ext rfl
    have hh := hw j
    change E (Pi.single (Fin.castAdd z j) 1)∈W at hh
    rwa [he] at hh
  have hl (i : Fin (k+z)) : ∀w∈W,B w (E (Pi.single i 1))=0 := by
    by_cases hi : i.val<k
    · exact hW (hf i hi)
    · let j : Fin z := ⟨i.val-k,by have := i.isLt; omega⟩
      have he : Fin.natAdd k j=i := Fin.ext (by simp only [Fin.val_natAdd,j]; omega)
      have hh := hv j
      change (∀w∈W,B w (E (Pi.single (Fin.natAdd k j) 1))=0) at hh
      rwa [he] at hh
  have hg := preservation_card_mul_le B hB.1 hsym W
    (t := k) (a := 0) (c := z)
  simp only [Nat.add_zero,mul_zero] at hg
  have hh := hg E hE hf (fun j _ => hl j)
  have hd := Mathproof.Problem18SesquiOrthogonalDimension20260930.finrank_add_orthogonal (RingEquiv.refl K) B hB W
  rw [inf_eq_left.mpr hW] at hCdim
  have hz : z=n-2*k := by dsimp [z,k]; omega
  simpa only [mul_zero,add_zero,hz,k] using hh
end Mathproof.Problem18AlternatingGeometricPreservation20260930
end
