variable {K V : Type*} [Field K] [Fintype K]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
theorem exists_diagonal_coordinates (B : LinearMap.BilinForm K V)
    (hB : B.IsSymm) (hn : B.Nondegenerate) (h2 : (2:K)≠0) :
    ∃ (a : Fin (Module.finrank K V) → K) (e : (Fin (Module.finrank K V) → K) ≃ₗ[K] V),
      (∀ i,a i≠0) ∧ ∀ x y,B (e x) (e y)=diagonalForm a x y := by
  classical
  letI := invertibleOfNonzero h2
  obtain ⟨b,hb⟩ := LinearMap.BilinForm.exists_orthogonal_basis (LinearMap.BilinForm.isSymm_iff.mp hB)
  let a := fun i => B (b i) (b i)
  have hm : B.toMatrix b=Matrix.diagonal a := by
    ext i j
    rw [LinearMap.BilinForm.toMatrix_apply]
    by_cases hij : i=j
    · subst j; simp [a]
    · simpa [Matrix.diagonal,hij] using hb hij
  refine ⟨a,b.equivFun.symm,?_,?_⟩
  · exact fun i => hb.not_isOrtho_basis_self_of_separatingLeft hn.1 i
  · intro x y
    rw [← B.dotProduct_toMatrix_mulVec b,hm]
    exact (Matrix.toBilin'_apply' _ x y).symm
theorem exists_diagonal_order (B : LinearMap.BilinForm K V)
    (hB : B.IsSymm) (hn : B.Nondegenerate) (h2 : (2:K)≠0) :
    ∃ a : Fin (Module.finrank K V) → K,(∀ i,a i≠0) ∧
      Nat.card (Isometries (RingEquiv.refl K) B)=
        Nat.card (Isometries (RingEquiv.refl K) (diagonalForm a)) := by
  obtain ⟨a,e,ha,he⟩ := exists_diagonal_coordinates B hB hn h2
  exact ⟨a,ha,(isometry_card_eq (RingEquiv.refl K) (diagonalForm a) B e he).symm⟩
end Mathproof.Problem18OddFormCoordinates20260930
end
