namespace Mathproof.Problem18KernelBoolean20261001
open Matrix Problem18ArrayElimination20260929 Problem18Elimination20260929
variable {K : Type*} [Field K] [DecidableEq K] {r s n : ℕ}
theorem dot_annihilates_kernel_iff {ι κ : Type*} [Fintype ι] [Fintype κ]
    [DecidableEq ι] [DecidableEq κ] (M : Matrix κ ι K) (c : ι → K) :
    (∀ x ∈ LinearMap.ker M.mulVecLin, dotProduct c x = 0) ↔
      c ∈ LinearMap.range Mᵀ.mulVecLin := by
  constructor
  · intro hc
    have hmem : dotProductEquiv K ι c ∈ (LinearMap.ker M.mulVecLin).dualAnnihilator :=
      (Submodule.mem_dualAnnihilator _).mpr hc
    rw [← LinearMap.range_dualMap_eq_dualAnnihilator_ker] at hmem
    obtain ⟨φ, hφ⟩ := hmem
    let v := (dotProductEquiv K κ).symm φ
    refine ⟨v, ?_⟩
    apply (dotProductEquiv K ι).injective
    apply LinearMap.ext
    intro x
    have he := congrArg (fun L : Module.Dual K (ι → K) => L x) hφ
    change φ (M *ᵥ x) = dotProduct c x at he
    change dotProduct (Mᵀ *ᵥ v) x = dotProduct c x
    rw [dotProduct_comm, Matrix.dotProduct_transpose_mulVec]
    have hv : dotProduct v (M *ᵥ x) = φ (M *ᵥ x) :=
      congrArg (fun L : Module.Dual K (κ → K) => L (M *ᵥ x))
        ((dotProductEquiv K κ).apply_symm_apply φ)
    exact hv.trans he
  · rintro ⟨v, rfl⟩ x hx
    change dotProduct (Mᵀ *ᵥ v) x = 0
    rw [dotProduct_comm, Matrix.dotProduct_transpose_mulVec]
    change M *ᵥ x = 0 at hx
    rw [hx, dotProduct_zero]
def rowCheck (A : Matrix (Fin r) (Fin n) K) (v : Fin n→K) : Bool×ℕ :=
  spanCheck ((List.finRange r).map (fun i=>Vector.ofFn (A i))) (Vector.ofFn v)
theorem rowCheck_correct (A : Matrix (Fin r) (Fin n) K) (v : Fin n→K) :
    (rowCheck A v).1=true ↔ ∀x∈LinearMap.ker A.toLin',dotProduct v x=0 := by
  rw [rowCheck,spanCheck_iff]
  simp only [read_ofFn,rowSpan,List.map_map,Function.comp_def]
  have he : {v | v∈(List.finRange r).map (fun i=>A i)}=Set.range (fun i=>A i) := by
    ext w
    simp only [Set.mem_setOf_eq,List.mem_map,List.mem_finRange,true_and,Set.mem_range]
  rw [he,Matrix.toLin'_apply',dot_annihilates_kernel_iff,Matrix.range_mulVecLin]
  rfl
def kernelLeCheck (A : Matrix (Fin r) (Fin n) K) (B : Matrix (Fin s) (Fin n) K) : Bool :=
  (List.finRange s).all (fun i=>(rowCheck A (B i)).1)
theorem kernelLeCheck_correct (A : Matrix (Fin r) (Fin n) K) (B : Matrix (Fin s) (Fin n) K) :
    kernelLeCheck A B=true ↔ LinearMap.ker A.toLin' ≤ LinearMap.ker B.toLin' := by
  simp only [kernelLeCheck,List.all_eq_true,List.mem_finRange,forall_true_left,rowCheck_correct]
  constructor
  · intro h x hx
    apply funext
    intro i
    exact h i x hx
  · intro h i x hx
    exact congrFun (h hx) i
def kernelEqCheck (A : Matrix (Fin r) (Fin n) K) (B : Matrix (Fin s) (Fin n) K) : Bool :=
  kernelLeCheck A B && kernelLeCheck B A
theorem kernelEqCheck_correct (A : Matrix (Fin r) (Fin n) K) (B : Matrix (Fin s) (Fin n) K) :
    kernelEqCheck A B=true ↔ LinearMap.ker A.toLin'=LinearMap.ker B.toLin' := by
  rw [kernelEqCheck,Bool.and_eq_true,kernelLeCheck_correct,kernelLeCheck_correct]
  exact ⟨fun h=>le_antisymm h.1 h.2,fun h=>⟨h.le,h.ge⟩⟩
end Mathproof.Problem18KernelBoolean20261001
end
