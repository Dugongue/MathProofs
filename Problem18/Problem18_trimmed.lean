namespace Mathproof.Problem18RootWordCodec20261001
open Problem18FiniteTransducer20261001 Turing
open Lax51.BinaryWordEncoding (Symbol)
inductive ReadState | start | header | payload deriving DecidableEq, Fintype
def digit (b : Bool) : Symbol := if b then .one else .zero
def toRAM : Transducer Bool Symbol ReadState where
  initial:=.start
  next q b:=match q with
    | .start=>(if b then .payload else .start,[.separator])
    | .header=>(if b then .payload else .start,[])
    | .payload=>(.header,[digit b])
  finish _:=[]
  next_bound q b:=by cases q <;> simp
  finish_bound _:=by simp
def fromRAM : Transducer Symbol Bool Bool where
  initial:=false
  next seen s:=match s with
    | .separator=>(true,if seen then [false] else [])
    | .zero=>(seen,[true,false])
    | .one=>(seen,[true,true])
  finish seen:=if seen then [false] else []
  next_bound seen s:=by cases s <;> cases seen <;> simp
  finish_bound seen:=by cases seen <;> simp
def payload (bs : List Bool) : List Bool := bs.flatMap (fun b=>[true,b])
theorem delimit_eq_payload (bs : List Bool) :
    BitstringEncoding.delimit bs=payload bs++[false] := by
  induction bs with
  | nil=>rfl
  | cons b bs ih=>simp [BitstringEncoding.delimit,payload,ih]
theorem encodePosNum_eq_bits (value : PosNum) :
    Computability.encodePosNum value = Nat.bits (value : ℕ) := by
  induction value with
  | one => rfl
  | bit0 value ih =>
      change false :: Computability.encodePosNum value =
        Nat.bits ((value : ℕ) + (value : ℕ))
      rw [← two_mul, Nat.bit0_bits]
      · exact congrArg (List.cons false) ih
      · exact Nat.ne_of_gt (PosNum.cast_pos value)
  | bit1 value ih =>
      change true :: Computability.encodePosNum value =
        Nat.bits ((value : ℕ) + (value : ℕ) + 1)
      rw [← two_mul, Nat.bit1_bits]
      exact congrArg (List.cons true) ih
theorem encodeNat_eq_bits (value : ℕ) :
    Computability.encodeNat value = Nat.bits value := by
  change Computability.encodeNum (value : Num) = Nat.bits value
  generalize hnum : (value : Num) = numeral
  have hvalue : (numeral : ℕ) = value := by
    rw [← hnum]
    exact Num.to_of_nat value
  cases numeral with
  | zero =>
      have hz : value = 0 := by simpa using hvalue.symm
      subst value
      rfl
  | pos positive =>
      change Computability.encodePosNum positive = Nat.bits value
      rw [← hvalue]
      exact encodePosNum_eq_bits positive
theorem rootEncode_cons (n : Nat) (ns : List Nat) :
    BitstringEncoding.bitEncode (n::ns)=
      BitstringEncoding.delimit n.bits++BitstringEncoding.bitEncode ns := by
  change BitstringEncoding.delimit (Computability.encodeNat n)++_=_
  rw [encodeNat_eq_bits]
  rfl
theorem toRAM_header_block (bs rest : List Bool) :
    run toRAM .header (BitstringEncoding.delimit bs++rest)=
      bs.map digit++run toRAM .start rest := by
  induction bs with
  | nil=>rfl
  | cons b bs ih=>
    change digit b::run toRAM .header (BitstringEncoding.delimit bs++rest)=digit b::(bs.map digit++run toRAM .start rest)
    rw [ih]
theorem toRAM_start_block (bs rest : List Bool) :
    run toRAM .start (BitstringEncoding.delimit bs++rest)=
      .separator::(bs.map digit++run toRAM .start rest) := by
  cases bs with
  | nil=>rfl
  | cons b bs=>
    change Symbol.separator::digit b::run toRAM .header (BitstringEncoding.delimit bs++rest)=Symbol.separator::digit b::(bs.map digit++run toRAM .start rest)
    rw [toRAM_header_block]
theorem toRAM_encode (ns : List Nat) :
    run toRAM .start (BitstringEncoding.bitEncode ns)=Lax51.BinaryWordEncoding.encode ns := by
  induction ns with
  | nil=>rfl
  | cons n ns ih=>
    rw [rootEncode_cons,toRAM_start_block,ih]
    rfl
theorem fromRAM_digits (bs : List Bool) (rest : List Symbol) :
    run fromRAM true (bs.map digit++rest)=payload bs++run fromRAM true rest := by
  induction bs with
  | nil=>rfl
  | cons b bs ih=>
    cases b <;> change true::_::run fromRAM true (bs.map digit++rest)=true::_::(payload bs++run fromRAM true rest) <;> rw [ih]
theorem fromRAM_encode_state (seen : Bool) (ns : List Nat) :
    run fromRAM seen (Lax51.BinaryWordEncoding.encode ns)=
      (if seen then [false] else [])++BitstringEncoding.bitEncode ns := by
  induction ns generalizing seen with
  | nil=>cases seen <;> rfl
  | cons n ns ih=>
    change run fromRAM seen (.separator::(n.bits.map digit++Lax51.BinaryWordEncoding.encode ns))=_
    rw [run]
    change (if seen then [false] else [])++run fromRAM true (n.bits.map digit++Lax51.BinaryWordEncoding.encode ns)=_
    rw [fromRAM_digits,ih,rootEncode_cons,delimit_eq_payload]
    simp [List.append_assoc]
theorem fromRAM_encode (ns : List Nat) :
    run fromRAM false (Lax51.BinaryWordEncoding.encode ns)=BitstringEncoding.bitEncode ns := by
  simpa using fromRAM_encode_state false ns
noncomputable def rootToRAM : TM2ComputableInPolyTime
    (BitstringEncoding.bitEncode : List Nat→List Bool) Lax51.BinaryWordEncoding.encode id where
  tm:=(computable toRAM).tm
  inputAlphabet:=(computable toRAM).inputAlphabet
  outputAlphabet:=(computable toRAM).outputAlphabet
  time:=(computable toRAM).time
  outputsFun ns:=by
    have hi : toRAM.initial=ReadState.start:=rfl
    simpa only [id_eq,hi,toRAM_encode] using (computable toRAM).outputsFun (BitstringEncoding.bitEncode ns)
noncomputable def ramToRoot : TM2ComputableInPolyTime
    Lax51.BinaryWordEncoding.encode (BitstringEncoding.bitEncode : List Nat→List Bool) id where
  tm:=(computable fromRAM).tm
  inputAlphabet:=(computable fromRAM).inputAlphabet
  outputAlphabet:=(computable fromRAM).outputAlphabet
  time:=(computable fromRAM).time
  outputsFun ns:=by
    have hi : fromRAM.initial=false:=rfl
    simpa only [id_eq,hi,fromRAM_encode] using (computable fromRAM).outputsFun (Lax51.BinaryWordEncoding.encode ns)
