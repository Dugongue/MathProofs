theorem restrict_trans (v : Place k L) :
    restrictPlace k F M (restrictPlace k M L v) = restrictPlace k F L v := by
  ext x
  change x ∈ restrictPlace k F M (restrictPlace k M L v) ↔ x ∈ restrictPlace k F L v
  rw [mem_restrictPlace, mem_restrictPlace, mem_restrictPlace,
    ← IsScalarTower.algebraMap_apply F M L]
