  have h5 : s / b * b ≤ s := Nat.div_mul_le_self _ _
  have h6 : r / b < a := (Nat.div_lt_iff_lt_mul hb).mpr h1
  have h7 : r / b * b ≤ r := Nat.div_mul_le_self _ _
  have h8 : s / b * a + r / b < a * a := by
    have := Nat.mul_le_mul_right a (Nat.succ_le_of_lt h4)
    rw [Nat.succ_mul] at this; omega
  have h9 : s < s / b * b + b := Nat.lt_div_mul_add hb
  have h10 : r < r / b * b + b := Nat.lt_div_mul_add hb
