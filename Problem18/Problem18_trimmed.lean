    rw [h1024] at hh
    linarith
  have hlogt : Real.log (t:ℝ) ≤ Real.log 2+Real.log (1+Real.log (b:ℝ)) := by
    have hh := Real.log_le_log htR hthi
    rwa [Real.log_mul (by norm_num) (by positivity)] at hh
  have hlogD : Real.log (D:ℝ)=12*Real.log 2+Real.log (t:ℝ) := by
    dsimp [D]
    push_cast
    rw [Real.log_mul (by norm_num) (ne_of_gt htR)]
