theorem raw_failure_union (u : Bool) (q a b c : ℕ) :
    probability (fun A : RectTensor a b c K=>¬RawGood u q A)≤
      probability (fun A : RectTensor a b c K=>Algebra.adjoin K (Set.range (rawFirst u q A))≠⊤)+
      probability (fun A : RectTensor a b c K=>Algebra.adjoin K (Set.range (rawSecond u q A))≠⊤) := by
  simpa only [RawGood,not_and_or] using
    (Mathproof.Problem18AnchorSubspaceUnion20261001.probability_or_le
      (fun A : RectTensor a b c K=>Algebra.adjoin K (Set.range (rawFirst u q A))≠⊤)
      (fun A : RectTensor a b c K=>Algebra.adjoin K (Set.range (rawSecond u q A))≠⊤))
theorem raw_check_acceptance (u : Bool) (q a b c : ℕ) :
    probability (fun A : RectTensor a b c K=>rawCheck u q A=true)=
      1-probability (fun A : RectTensor a b c K=>¬RawGood u q A) := by
  simp_rw [rawCheck_correct]
