      rw [hf4 s hs oa, hf3 s hs n1 n2 n3 n4 os o1 o2, keep2 s hs n1 n2 n3 n4 oa os o1 o2]
    · intro x hxs hxj hxn hxm hxx'
      rw [hx4 x hxs hxj, hx3 x hxs hxj hxn hxm hxx', hx2 x hxs hxj, hx1 x hxs hxj hxn hxm hxx']
    · intro a h1 h2
      rw [ha4 a h1 h2, ha3 a h1 h2, ha2 a h1 h2, ha1 a h1 h2]
    · rw [hi4, hi3, hi2, hi1]
    · rw [ho4, ho3, ho2, ho1]
  · have hcond' : (Cond.eq (.var fn.b) (.lit 1)).evalB B τ2 = some false := by
      rw [hcond]; simp [hb1]
    refine ⟨τ2, ?_, hS2, ?_, keep2, ?_, ?_, ?_, ?_⟩
    · refine (hr1.seq (hr2.seq (Run.ite_false hcond' Run.skip))).mono ?_
      simp only [sqmulCost, Cond.size, Expr.size]
      have : 1 ≤ mulModCost M C A Xv S X1 X2 D + copyCost M A S D := by
        simp only [copyCost]; omega
      omega
    · intro k hk
      rw [sqmulVal, if_neg hb1]; exact hsq k hk
    · intro x hxs hxj hxn hxm hxx'
      rw [hx2 x hxs hxj, hx1 x hxs hxj hxn hxm hxx']
    · intro a h1 h2
      rw [ha2 a h1 h2, ha1 a h1 h2]
    · rw [hi2, hi1]
    · rw [ho2, ho1]
def stepBody (M : FieldMacros F r) (q : RNames) (fn : FNames) (qr : String)
    (C Xv A S X1 X2 : Expr) (D : ℕ) : Com :=
  .seq (.assign fn.k (.bin .sub (.var fn.k) (.lit 1)))
  (.seq (.assign fn.t (.bin .shiftr (.var qr) (.var fn.k)))
  (.seq (.assign fn.b (.bin .sub (.var fn.t) (.bin .mul (.bin .div (.var fn.t) (.lit 2)) (.lit 2))))
    (sqmulCom M q fn C Xv A S X1 X2 D)))
def stepCost (M : FieldMacros F r) (C Xv A S X1 X2 : Expr) (D : ℕ) : ℕ :=
  4 + (4 + (8 + sqmulCost M C Xv A S X1 X2 D))
def loopCom (M : FieldMacros F r) (q : RNames) (fn : FNames) (qr : String)
    (C Xv A S X1 X2 : Expr) (D : ℕ) : Com :=
  .while (.lt (.lit 0) (.var fn.k)) (stepBody M q fn qr C Xv A S X1 X2 D)
theorem loop_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (fn : FNames)
    (hfn : fn.Valid r q) (qr : String)
    (hqr : qr ∉ regNames r ∧ qr ≠ q.j ∧ qr ≠ q.N ∧ qr ∉ fn.list) (l : List String)
    (hl : ∀ x ∈ l, x ∉ regNames r ∧ x ≠ q.j ∧ x ≠ q.N ∧ x ∉ fn.list)
    (C Xv A S X1 X2 : Expr) (hC : VarsIn l C) (hXv : VarsIn l Xv) (hA : VarsIn l A)
    (hSe : VarsIn l S) (hX1 : VarsIn l X1) (hX2 : VarsIn l X2)
    {B Sn : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ) {cv xv av sv x1 x2 D : ℕ}
    (ecv : C.evalB B σ = some cv) (exv : Xv.evalB B σ = some xv) (eav : A.evalB B σ = some av)
    (esv : S.evalB B σ = some sv) (ex1 : X1.evalB B σ = some x1) (ex2 : X2.evalB B σ = some x2)
    (hD : 1 ≤ D) (hz : val F r q.WS σ 0 = 0)
    (h5 : 5 ≤ cv) (hcx : cv + D ≤ xv) (hxa : xv + D ≤ av) (has : av + D ≤ sv)
    (hs1 : sv + D ≤ x1) (h12 : x1 + D ≤ x2) (hfit : x2 + D ≤ Sn)
    (cs xx : Vector K D) (hcs : SlotVec (val F r q.WS σ) cv cs)
    (hxx : SlotVec (val F r q.WS σ) xv xx) {Q k0 : ℕ} (hQ : σ.vars qr = Q) (hQB : Q < B)
    (hk : σ.vars fn.k = k0) (hkQ : ∀ j < k0, Q / 2 ^ j ≠ 0) (hkB : k0 < B)
    (hpa : SlotVec (val F r q.WS σ) av (powP cs xx (Q / 2 ^ k0))) :
    ∃ τ, Run B (loopCom M q fn qr C Xv A S X1 X2 D) σ τ
        ((4 + stepCost M C Xv A S X1 X2 D) * k0 + 4) ∧
      Slots F r q.WS Sn B τ ∧ SlotVec (val F r q.WS τ) av (powP cs xx Q) ∧
      (∀ s < Sn, s ≠ 1 → s ≠ 2 → s ≠ 3 → s ≠ 4 → (s < av ∨ av + D ≤ s) →
        (s < sv ∨ sv + D ≤ s) → (s < x1 ∨ x1 + D ≤ s) → (s < x2 ∨ x2 + D ≤ s) →
        val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ≠ q.j → x ≠ q.N → x ∉ fn.list → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hSB := hS.slots_word
  have hB1 : (2 : ℕ) < B := by
    have := hS.base.arithmetic_word; have := F.prime.two_le; nlinarith
  have hkS : fn.k ∉ regNames r := hfn.reg _ (fn.mem 5 (by omega))
  have htS : fn.t ∉ regNames r := hfn.reg _ (fn.mem 3 (by omega))
  have hbS : fn.b ∉ regNames r := hfn.reg _ (fn.mem 6 (by omega))
  have hkW : fn.k ≠ q.WS := hfn.ws _ (fn.mem 5 (by omega))
  have htW : fn.t ≠ q.WS := hfn.ws _ (fn.mem 3 (by omega))
  have hbW : fn.b ≠ q.WS := hfn.ws _ (fn.mem 6 (by omega))
  have hkJ : fn.k ≠ q.j := hfn.j _ (fn.mem 5 (by omega))
  have hkN : fn.k ≠ q.N := hfn.N _ (fn.mem 5 (by omega))
  have hkm : fn.k ≠ fn.mj := hfn.ne 5 0 (by omega) (by omega) (by omega)
  have hkx : fn.k ≠ fn.xj := hfn.ne 5 1 (by omega) (by omega) (by omega)
  have hkt : fn.k ≠ fn.t := hfn.ne 5 3 (by omega) (by omega) (by omega)
  have hkb : fn.k ≠ fn.b := hfn.ne 5 6 (by omega) (by omega) (by omega)
  have htb : fn.t ≠ fn.b := hfn.ne 3 6 (by omega) (by omega) (by omega)
  have hnl : ∀ x, x ∉ fn.list → x ≠ fn.k ∧ x ≠ fn.t ∧ x ≠ fn.b ∧ x ≠ fn.mj ∧ x ≠ fn.xj :=
    fun x hx => ⟨fun e => hx (e ▸ fn.mem 5 (by omega)), fun e => hx (e ▸ fn.mem 3 (by omega)),
      fun e => hx (e ▸ fn.mem 6 (by omega)), fun e => hx (e ▸ fn.mem 0 (by omega)),
      fun e => hx (e ▸ fn.mem 1 (by omega))⟩
  let I : Env → Prop := fun τ =>
    Slots F r q.WS Sn B τ ∧ τ.vars fn.k ≤ k0 ∧
    SlotVec (val F r q.WS τ) av (powP cs xx (Q / 2 ^ τ.vars fn.k)) ∧
    (∀ s < Sn, s ≠ 1 → s ≠ 2 → s ≠ 3 → s ≠ 4 → (s < av ∨ av + D ≤ s) →
      (s < sv ∨ sv + D ≤ s) → (s < x1 ∨ x1 + D ≤ s) → (s < x2 ∨ x2 + D ≤ s) →
      val F r q.WS τ s = val F r q.WS σ s) ∧
    (∀ x, x ∉ regNames r → x ≠ q.j → x ≠ q.N → x ∉ fn.list → τ.vars x = σ.vars x) ∧
    (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out
  have hI0 : I σ := ⟨hS, by omega, by rw [hk]; exact hpa, fun _ _ _ _ _ _ _ _ _ _ => rfl,
    fun _ _ _ _ _ => rfl, fun _ _ _ => rfl, rfl, rfl⟩
  have hdef : ∀ τ, I τ → ∃ v, (Cond.lt (.lit 0) (.var fn.k)).evalB B τ = some v := by
    intro τ hτ
    exact ⟨_, evalB_condLt (evalB_lit (by omega)) (evalB_var (by have := hτ.2.1; omega))⟩
  have hstep : ∀ τ, I τ → (Cond.lt (.lit 0) (.var fn.k)).evalB B τ = some true →
      ∃ τ', Run B (stepBody M q fn qr C Xv A S X1 X2 D) τ τ' (stepCost M C Xv A S X1 X2 D) ∧
        I τ' ∧ τ'.vars fn.k < τ.vars fn.k := by
    intro τ hτ hc
    obtain ⟨hSτ, hkτ, hpτ, hfτ, hxτ, haτ, hiτ, hoτ⟩ := hτ
    have hpos : 0 < τ.vars fn.k := by
      rw [evalB_condLt (evalB_lit (by omega)) (evalB_var (by omega))] at hc
      simpa using hc
    obtain ⟨k1, hk1⟩ : ∃ k1, τ.vars fn.k = k1 + 1 := ⟨τ.vars fn.k - 1, by omega⟩
    have hqτ : τ.vars qr = Q := by rw [hxτ qr hqr.1 hqr.2.1 hqr.2.2.1 hqr.2.2.2, hQ]
    set tq := Q / 2 ^ k1 with htq
    have htqB : tq ≤ Q := Nat.div_le_self _ _
    have htq0 : tq ≠ 0 := hkQ k1 (by omega)
    have e1 : (Expr.bin .sub (.var fn.k) (.lit 1)).evalB B τ = some k1 := by
      have := evalB_bin (op := .sub) (evalB_var (σ := τ) (x := fn.k) (lt_of_le_of_lt hkτ hkB))
        (evalB_lit (σ := τ) (n := 1) (by omega)) (by simp only [Bop.apply]; omega)
      simpa [Bop.apply, hk1] using this
    set τa := τ.setVar fn.k k1 with hτa
    have e2 : (Expr.bin .shiftr (.var qr) (.var fn.k)).evalB B τa = some tq := by
      have hq' : τa.vars qr = Q := by
        have hqk : qr ≠ fn.k := fun e => hqr.2.2.2 (by rw [e]; exact fn.mem 5 (by omega))
        simp only [hτa, vars_setVar, if_neg hqk]
        exact hqτ
      have hk' : τa.vars fn.k = k1 := by simp [hτa]
      have h := evalB_bin (op := .shiftr) (evalB_var (σ := τa) (x := qr) (by rw [hq']; omega))
        (evalB_var (σ := τa) (x := fn.k) (by rw [hk']; omega))
        (by rw [hq', hk']; exact lt_of_le_of_lt (Nat.div_le_self _ _) hQB)
      rw [hq', hk'] at h
      exact h
    set τb := τa.setVar fn.t tq with hτb
    have hbq : tq - tq / 2 * 2 = tq % 2 := by omega
    have e3 : (Expr.bin .sub (.var fn.t) (.bin .mul (.bin .div (.var fn.t) (.lit 2)) (.lit 2))).evalB
        B τb = some (tq % 2) := by
      have ht' : τb.vars fn.t = tq := by simp [hτb]
      have h1 := evalB_bin (op := .div) (evalB_var (σ := τb) (x := fn.t) (by rw [ht']; exact lt_of_le_of_lt htqB hQB))
        (evalB_lit (σ := τb) (n := 2) (by omega))
        (by simp only [Bop.apply, ht']; exact lt_of_le_of_lt (Nat.div_le_self _ _) (lt_of_le_of_lt htqB hQB))
      have h2 := evalB_bin (op := .mul) h1 (evalB_lit (σ := τb) (n := 2) (by omega))
        (by simp only [Bop.apply, ht']; exact lt_of_le_of_lt (Nat.div_mul_le_self _ _) (lt_of_le_of_lt htqB hQB))
      have h3 := evalB_bin (op := .sub) (evalB_var (σ := τb) (x := fn.t) (by rw [ht']; exact lt_of_le_of_lt htqB hQB)) h2
        (by simp only [Bop.apply, ht']; exact lt_of_le_of_lt (Nat.sub_le _ _) (lt_of_le_of_lt htqB hQB))
      simp only [Bop.apply, ht'] at h3
      rw [hbq] at h3
      exact h3
    set τc := τb.setVar fn.b (tq % 2) with hτc
    have hSc : Slots F r q.WS Sn B τc :=
      Slots.setVar F r (Slots.setVar F r (Slots.setVar F r hSτ hkS hkW k1) htS htW tq) hbS hbW
        (tq % 2)
    have hvc : ∀ s, val F r q.WS τc s = val F r q.WS τ s := fun s => by
      rw [hτc, val_setVar F r hbW, hτb, val_setVar F r htW, hτa, val_setVar F r hkW]
    have hxc : ∀ x, x ≠ fn.k → x ≠ fn.t → x ≠ fn.b → τc.vars x = τ.vars x := fun x h1 h2 h3 => by
      simp [hτc, hτb, hτa, vars_setVar, h1, h2, h3]
    have hlc : ∀ x ∈ l, τc.vars x = σ.vars x := fun x hx => by
      obtain ⟨n1, n2, n3, n4⟩ := hl x hx
      obtain ⟨a1, a2, a3, -, -⟩ := hnl x n4
      rw [hxc x a1 a2 a3, hxτ x n1 n2 n3 n4]
    have hcg : ∀ E : Expr, VarsIn l E → E.evalB B τc = E.evalB B σ := fun E hE =>
      evalB_congr_varsIn hlc E hE
    have keepσ : ∀ s < Sn, s ≠ 1 → s ≠ 2 → s ≠ 3 → s ≠ 4 → (s < av ∨ av + D ≤ s) →
        (s < sv ∨ sv + D ≤ s) → (s < x1 ∨ x1 + D ≤ s) → (s < x2 ∨ x2 + D ≤ s) →
        val F r q.WS τc s = val F r q.WS σ s := by
      intro s hs n1 n2 n3 n4 oa os o1 o2
      rw [hvc s, hfτ s hs n1 n2 n3 n4 oa os o1 o2]
    have hzc : val F r q.WS τc 0 = 0 := by
      rw [keepσ 0 (by omega) (by omega) (by omega) (by omega) (by omega) (Or.inl (by omega))
        (Or.inl (by omega)) (Or.inl (by omega)) (Or.inl (by omega))]; exact hz
    have hcsc : SlotVec (val F r q.WS τc) cv cs := by
      intro j hj
      rw [keepσ (cv + j) (by omega) (by omega) (by omega) (by omega) (by omega)
        (Or.inl (by omega)) (Or.inl (by omega)) (Or.inl (by omega)) (Or.inl (by omega))]
      exact hcs j hj
    have hxxc : SlotVec (val F r q.WS τc) xv xx := by
      intro j hj
      rw [keepσ (xv + j) (by omega) (by omega) (by omega) (by omega) (by omega)
        (Or.inl (by omega)) (Or.inl (by omega)) (Or.inl (by omega)) (Or.inl (by omega))]
      exact hxx j hj
    have hpac : SlotVec (val F r q.WS τc) av (powP cs xx (Q / 2 ^ (k1 + 1))) := by
      intro j hj; rw [hvc, ← hk1]; exact hpτ j hj
    obtain ⟨τ', hr', hS', hv', hf', hx', ha', hi', ho'⟩ :=
      sqmul_run M q hq fn hfn l hl C Xv A S X1 X2 hC hXv hA hSe hX1 hX2 hSc
        (by rw [hcg C hC]; exact ecv) (by rw [hcg Xv hXv]; exact exv)
        (by rw [hcg A hA]; exact eav) (by rw [hcg S hSe]; exact esv)
        (by rw [hcg X1 hX1]; exact ex1) (by rw [hcg X2 hX2]; exact ex2) hD hzc h5 hcx hxa has
        hs1 h12 hfit cs xx _ hcsc hxxc hpac (bq := tq % 2) (by simp [hτc]) (by omega)
    have hk' : τ'.vars fn.k = k1 := by
      rw [hx' fn.k hkS hkJ hkN hkm hkx]; simp [hτc, hτb, hτa, hkt, hkb]
    refine ⟨τ', ?_, ⟨hS', by omega, ?_, ?_, ?_, ?_, ?_, ?_⟩, by omega⟩
    · refine ((Run.assign e1).seq ((Run.assign e2).seq ((Run.assign e3).seq hr'))).mono ?_
      simp only [stepCost, Expr.size]; omega
    · rw [hk']
      intro j hj
      rw [hv' j hj, sqmulVal, powP_ne_zero cs xx htq0, htq, div_pow_succ]
    · intro s hs n1 n2 n3 n4 oa os o1 o2
      rw [hf' s hs n1 n2 n3 n4 oa os o1 o2, keepσ s hs n1 n2 n3 n4 oa os o1 o2]
    · intro x n1 n2 n3 n4
      obtain ⟨a1, a2, a3, a4, a5⟩ := hnl x n4
      rw [hx' x n1 n2 n3 a4 a5, hxc x a1 a2 a3, hxτ x n1 n2 n3 n4]
    · intro a h1 h2
      rw [ha' a h1 h2, ← haτ a h1 h2]; simp [hτc, hτb, hτa]
    · rw [hi', ← hiτ]; simp [hτc, hτb, hτa]
    · rw [ho', ← hoτ]; simp [hτc, hτb, hτa]
  obtain ⟨τ, hr, hI, hc⟩ := Run.while_count I (fun τ => τ.vars fn.k)
    (stepCost M C Xv A S X1 X2 D) hdef hstep hI0
  obtain ⟨hSτ, hkτ, hpτ, hfτ, hxτ, haτ, hiτ, hoτ⟩ := hI
  have hk0' : τ.vars fn.k = 0 := by
    rw [evalB_condLt (evalB_lit (by omega)) (evalB_var (by omega))] at hc
    simpa using hc
  refine ⟨τ, hr.mono ?_, hSτ, ?_, hfτ, hxτ, haτ, hiτ, hoτ⟩
  · apply le_of_eq; simp only [hk, Cond.size, Expr.size]; try ring
  · intro j hj
    have := hpτ j hj
    rw [hk0', pow_zero, Nat.div_one] at this
    exact this
def frobCom (M : FieldMacros F r) (q : RNames) (fn : FNames) (qr : String)
    (C Xv A S X1 X2 : Expr) (D : ℕ) : Com :=
  .seq (oneCom M q fn.ci S D)
  (.seq (mulXCom M q fn.xj C S Xv D 1)
  (.seq (oneCom M q fn.ci A D)
  (.seq (.assign fn.t (.var qr))
  (.seq (.assign fn.s (.lit 0))
  (.seq (halveCom fn.t fn.s)
  (.seq (.assign fn.k (.var fn.s))
    (loopCom M q fn qr C Xv A S X1 X2 D)))))))
def frobCost (M : FieldMacros F r) (C Xv A S X1 X2 : Expr) (D sz : ℕ) : ℕ :=
  oneCost M S D + (mulXCost M C S Xv D + (oneCost M A D + (2 + (2 + (12 * sz + 4 +
    (2 + ((4 + stepCost M C Xv A S X1 X2 D) * sz + 4)))))))
theorem frob_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (fn : FNames)
    (hfn : fn.Valid r q) (qr : String)
    (hqr : qr ∉ regNames r ∧ qr ≠ q.j ∧ qr ≠ q.N ∧ qr ∉ fn.list) (l : List String)
    (hl : ∀ x ∈ l, x ∉ regNames r ∧ x ≠ q.j ∧ x ≠ q.N ∧ x ∉ fn.list)
    (C Xv A S X1 X2 : Expr) (hC : VarsIn l C) (hXv : VarsIn l Xv) (hA : VarsIn l A)
    (hSe : VarsIn l S) (hX1 : VarsIn l X1) (hX2 : VarsIn l X2)
    {B Sn : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ) {cv xv av sv x1 x2 D : ℕ}
    (ecv : C.evalB B σ = some cv) (exv : Xv.evalB B σ = some xv) (eav : A.evalB B σ = some av)
    (esv : S.evalB B σ = some sv) (ex1 : X1.evalB B σ = some x1) (ex2 : X2.evalB B σ = some x2)
    (hD : 1 ≤ D) (hz : val F r q.WS σ 0 = 0)
    (h5 : 5 ≤ cv) (hcx : cv + D ≤ xv) (hxa : xv + D ≤ av) (has : av + D ≤ sv)
    (hs1 : sv + D ≤ x1) (h12 : x1 + D ≤ x2) (hfit : x2 + D ≤ Sn)
    {Q : ℕ} (hQ : σ.vars qr = Q) (hQB : Q < B)
    (cs : Vector K D) (hcs : SlotVec (val F r q.WS σ) cv cs) :
    ∃ τ, Run B (frobCom M q fn qr C Xv A S X1 X2 D) σ τ
        (frobCost M C Xv A S X1 X2 D (Nat.size Q)) ∧
      Slots F r q.WS Sn B τ ∧ SlotVec (val F r q.WS τ) av (frobeniusResidue cs Q).1 ∧
      (∀ s < Sn, s ≠ 1 → s ≠ 2 → s ≠ 3 → s ≠ 4 → (s < xv ∨ xv + D ≤ s) →
        (s < av ∨ av + D ≤ s) → (s < sv ∨ sv + D ≤ s) → (s < x1 ∨ x1 + D ≤ s) →
        (s < x2 ∨ x2 + D ≤ s) → val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ≠ q.j → x ≠ q.N → x ∉ fn.list → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hSB := hS.slots_word
  have hB2 : (2 : ℕ) < B := by
    have := hS.base.arithmetic_word; have := F.prime.two_le; nlinarith
  have hciS : fn.ci ∉ regNames r := hfn.reg _ (fn.mem 2 (by omega))
  have hxS : fn.xj ∉ regNames r := hfn.reg _ (fn.mem 1 (by omega))
  have htS : fn.t ∉ regNames r := hfn.reg _ (fn.mem 3 (by omega))
  have hsS : fn.s ∉ regNames r := hfn.reg _ (fn.mem 4 (by omega))
  have hkS : fn.k ∉ regNames r := hfn.reg _ (fn.mem 5 (by omega))
  have hciW : fn.ci ≠ q.WS := hfn.ws _ (fn.mem 2 (by omega))
  have hxW : fn.xj ≠ q.WS := hfn.ws _ (fn.mem 1 (by omega))
  have htW : fn.t ≠ q.WS := hfn.ws _ (fn.mem 3 (by omega))
  have hsW : fn.s ≠ q.WS := hfn.ws _ (fn.mem 4 (by omega))
  have hkW : fn.k ≠ q.WS := hfn.ws _ (fn.mem 5 (by omega))
  have hts : fn.t ≠ fn.s := hfn.ne 3 4 (by omega) (by omega) (by omega)
  have hks : fn.k ≠ fn.s := hfn.ne 5 4 (by omega) (by omega) (by omega)
  have hkt : fn.k ≠ fn.t := hfn.ne 5 3 (by omega) (by omega) (by omega)
  have hnl : ∀ x, x ∉ fn.list → x ≠ fn.ci ∧ x ≠ fn.xj ∧ x ≠ fn.t ∧ x ≠ fn.s ∧ x ≠ fn.k :=
    fun x hx => ⟨fun e => hx (e ▸ fn.mem 2 (by omega)), fun e => hx (e ▸ fn.mem 1 (by omega)),
      fun e => hx (e ▸ fn.mem 3 (by omega)), fun e => hx (e ▸ fn.mem 4 (by omega)),
      fun e => hx (e ▸ fn.mem 5 (by omega))⟩
  have hl1 : ∀ x ∈ l, x ∉ regNames r ∧ x ≠ fn.ci := fun x hx =>
    ⟨(hl x hx).1, (hnl x (hl x hx).2.2.2).1⟩
  have hlx : ∀ x ∈ l, x ∉ regNames r ∧ x ≠ fn.xj := fun x hx =>
