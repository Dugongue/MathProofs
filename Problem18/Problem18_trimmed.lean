variable {K : Type*}
def augmentedRightFactor [Semiring K] {a b : ℕ} (x : OuterVar a b → K) :
    Matrix (AugmentedColumn a b) (AugmentedColumn a b) K
  | .inl i, .inl j => (Matrix.kronecker (pMatrix x) (rMatrix x)).transpose i j
  | .inr _, .inr _ => 1
  | _, _ => 0
def augmentedRightInverse [Semiring K] {a b : ℕ} (x : OuterVar a b → K) :
    Matrix (AugmentedColumn a b) (AugmentedColumn a b) K
  | .inl i, .inl j => Matrix.kronecker (pMatrix x) (rMatrix x) i j
  | .inr _, .inr _ => 1
  | _, _ => 0
theorem augmentedTransformed_eq_mul_factor [CommSemiring K] {a b c : ℕ}
    (x : OuterVar a b → K) (F : Matrix (Fin c) (Fin a × Fin b) K)
    (e : Fin c → K) :
    augmentedTransformedMatrix x F e =
      augmentedConstantMatrix F e * augmentedRightFactor x := by
  ext s j
  rcases j with (j | j)
  · simp [augmentedTransformedMatrix, augmentedConstantMatrix, augmentedRightFactor,
      transformedMatrix, augmentedScalar, Matrix.mul_apply, Fintype.sum_sum_type]
  · simp [augmentedTransformedMatrix, augmentedConstantMatrix, augmentedRightFactor,
      augmentedScalar, Matrix.mul_apply, Fintype.sum_sum_type]
private theorem kronecker_transpose_mul_self_m0904 [Field K] {a b : ℕ}
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (hP : P.transpose * P = 1) (hQ : Q.transpose * Q = 1) :
    (Matrix.kronecker P Q).transpose * Matrix.kronecker P Q = 1 := by
  unfold Matrix.kronecker
  rw [← Matrix.kroneckerMap_transpose, ← Matrix.mul_kronecker_mul,
    hP, hQ, Matrix.one_kronecker_one]
theorem augmentedRightFactor_mul_inverse [Field K] {a b : ℕ}
    (x : OuterVar a b → K)
    (hP : (pMatrix x).transpose * pMatrix x = 1)
    (hQ : (rMatrix x).transpose * rMatrix x = 1) :
    augmentedRightFactor x * augmentedRightInverse x = 1 := by
  have hW := kronecker_transpose_mul_self_m0904 (pMatrix x) (rMatrix x) hP hQ
  ext i j
  rcases i with (i | i) <;> rcases j with (j | j)
  · simpa [augmentedRightFactor, augmentedRightInverse, Matrix.mul_apply,
      Fintype.sum_sum_type, Matrix.one_apply] using congrFun (congrFun hW i) j
  · simp [augmentedRightFactor, augmentedRightInverse, Matrix.mul_apply,
      Fintype.sum_sum_type]
  · simp [augmentedRightFactor, augmentedRightInverse, Matrix.mul_apply,
      Fintype.sum_sum_type]
  · simp [augmentedRightFactor, augmentedRightInverse, Matrix.mul_apply,
      Fintype.sum_sum_type]
theorem augmentedTransformed_rank_eq [Field K] {a b c : ℕ}
    (x : OuterVar a b → K) (F : Matrix (Fin c) (Fin a × Fin b) K)
    (e : Fin c → K)
    (hP : (pMatrix x).transpose * pMatrix x = 1)
    (hQ : (rMatrix x).transpose * rMatrix x = 1) :
    (augmentedTransformedMatrix x F e).rank =
      (augmentedConstantMatrix F e).rank := by
  rw [augmentedTransformed_eq_mul_factor]
  have hdet : IsUnit (augmentedRightFactor x).det :=
    Matrix.isUnit_det_of_right_inverse
      (augmentedRightFactor_mul_inverse x hP hQ)
  exact Matrix.rank_mul_eq_left_of_isUnit_det
    (augmentedRightFactor x) (augmentedConstantMatrix F e) hdet
theorem augmented_range_finrank_eq_of_fixed_ranks [Field K] {a b c : ℕ}
    (x : OuterVar a b → K) (F G : Matrix (Fin c) (Fin a × Fin b) K)
    (e : Fin c → K)
    (hfixed : (augmentedConstantMatrix F e).rank =
      (augmentedConstantMatrix G e).rank)
    (hP : (pMatrix x).transpose * pMatrix x = 1)
    (hQ : (rMatrix x).transpose * rMatrix x = 1) :
    Module.finrank K (LinearMap.range (augmentedTransformedMatrix x F e).toLin') =
      Module.finrank K (LinearMap.range (augmentedConstantMatrix G e).toLin') := by
  rw [Matrix.toLin'_apply', Matrix.toLin'_apply']
  exact (augmentedTransformed_rank_eq x F e hP hQ).trans hfixed
theorem bilinearSystem_zero_iff_root_augment_of_fixed_augmented_ranks [Field K]
    {a b c k : ℕ} (F G : Matrix (Fin c) (Fin a × Fin b) K)
    (e : Fin c → K) (ker : Fin k → (AugmentedColumn a b → K))
    (hspan : Submodule.span K (Set.range ker) =
      LinearMap.ker (augmentedConstantMatrix G e).toLin')
    (hfixed : (augmentedConstantMatrix F e).rank =
      (augmentedConstantMatrix G e).rank)
    (x : OuterVar a b → K) :
    BilinearSystemZero F G 1 1 1 e ker x ↔
      (pMatrix x).transpose * pMatrix x = 1 ∧
      (rMatrix x).transpose * rMatrix x = 1 ∧
      LinearMap.ker (Problem18MarkedRecovery20260929.augment
        (transformedMatrix x F).toLin' e) =
        LinearMap.ker (Problem18MarkedRecovery20260929.augment G.toLin' e) ∧
      (transformedMatrix x F).transpose * transformedMatrix x F =
        G.transpose * G := by
  constructor
  · intro h
    have hP : (pMatrix x).transpose * pMatrix x = 1 := by
      simpa using (preservesP_zero_iff x (1 : Matrix (Fin a) (Fin a) K)).mp
        (fun i j => h (.inl (.inl (i, j))))
    have hQ : (rMatrix x).transpose * rMatrix x = 1 := by
      simpa using (preservesR_zero_iff x (1 : Matrix (Fin b) (Fin b) K)).mp
        (fun i j => h (.inl (.inr (i, j))))
    have hrank := augmented_range_finrank_eq_of_fixed_ranks
      x F G e hfixed hP hQ
    simpa using (bilinearSystem_zero_iff_root_augment F G 1 1 1 e ker
      hspan x hrank).mp h
  · rintro ⟨hP, hQ, hker, hgram⟩
    have hrank := augmented_range_finrank_eq_of_fixed_ranks
      x F G e hfixed hP hQ
    apply (bilinearSystem_zero_iff_root_augment F G 1 1 1 e ker
      hspan x hrank).mpr
    simpa using And.intro hP (And.intro hQ (And.intro hker hgram))
end Mathproof.Problem18BoundedAllRankRecovery20260930
end
