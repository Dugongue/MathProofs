theorem restriction_block (S : Module.End K (Fin c→K)) (hS : ∀x∈W,S x∈W) :
    (U W hc f g*S.toMatrix'*E W hc f g).toBlocks₁₁=
      (f.symm.conj (S.restrict hS)).toMatrix' := by
  let e := adaptedEquiv W hc f g
