  have hzL : z ∈ algebraicClosure P Ω := mem_algebraicClosure_iff'.mpr hz.isIntegral
  have hwL : w ∈ algebraicClosure P Ω := mem_algebraicClosure_iff'.mpr hw.isIntegral
  set z' : algebraicClosure P Ω := ⟨z, hzL⟩ with hz'def
  set w' : algebraicClosure P Ω := ⟨w, hwL⟩ with hw'def
  have hz' : IsSeparable P z' := by
    unfold IsSeparable
    rw [← minpoly.algHom_eq (algebraicClosure P Ω).val Subtype.val_injective]
    exact hz
  have hw' : IsSeparable P w' := by
    unfold IsSeparable
    rw [← minpoly.algHom_eq (algebraicClosure P Ω).val Subtype.val_injective]
    exact hw
  set S := separableClosure P (algebraicClosure P Ω) with hSdef
  have hzS : z' ∈ S := mem_separableClosure_iff.mpr hz'
  have hwS : w' ∈ S := mem_separableClosure_iff.mpr hw'
  set z'' : S := ⟨z', hzS⟩ with hz''def
  set w'' : S := ⟨w', hwS⟩ with hw''def
  have hz'' : IsSeparable P z'' := by
    unfold IsSeparable
    rw [← minpoly.algHom_eq S.val Subtype.val_injective]
    exact hz'
  have hw'' : IsSeparable P w'' := by
    unfold IsSeparable
    rw [← minpoly.algHom_eq S.val Subtype.val_injective]
    exact hw'
  set K₁ : IntermediateField P S := IntermediateField.adjoin P {z'', w''} with hK₁
  haveI : FiniteDimensional P K₁ := by
    apply IntermediateField.finiteDimensional_adjoin
    intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact hz''.isIntegral
    · rw [Set.mem_singleton_iff.mp hx]
      exact hw''.isIntegral
  set Q := normalClosure P K₁ S with hQdef
  have hzQ : z'' ∈ Q := IntermediateField.le_normalClosure K₁
    (IntermediateField.subset_adjoin P _ (Set.mem_insert _ _))
  have hwQ : w'' ∈ Q := IntermediateField.le_normalClosure K₁
    (IntermediateField.subset_adjoin P _ (Set.mem_insert_of_mem _ (Set.mem_singleton _)))
  set zQ : Q := ⟨z'', hzQ⟩ with hzQdef
  set wQ : Q := ⟨w'', hwQ⟩ with hwQdef
  have hcomm : ∀ (g : Q ≃ₐ[P] Q) (x : Q),
      ((g.liftNormal S).liftNormal (algebraicClosure P Ω)) ((x : S) : algebraicClosure P Ω) =
        ((g x : S) : algebraicClosure P Ω) := by
    intro g x
    have e1 := (g.liftNormal S).liftNormal_commutes (algebraicClosure P Ω) (x : S)
    have e2 := g.liftNormal_commutes S x
    simp only [IntermediateField.algebraMap_apply] at e1 e2
    rw [e1, e2]
  have hmemQ : wQ ∈ IntermediateField.adjoin P {zQ} := by
    rw [← IsGalois.fixedField_fixingSubgroup (IntermediateField.adjoin P {zQ}),
      IntermediateField.mem_fixedField_iff]
    intro g hg
    have hgz : g zQ = zQ :=
      (_root_.mem_fixingSubgroup_iff _).mp hg zQ (IntermediateField.mem_adjoin_simple_self P zQ)
    have hz2 : ((g.liftNormal S).liftNormal (algebraicClosure P Ω)) z' = z' := by
      have e := hcomm g zQ
      rw [hgz] at e
      exact e
    have hw2 := h _ z' w' rfl rfl hz2
    have e := hcomm g wQ
    rw [show ((wQ : S) : algebraicClosure P Ω) = w' from rfl, hw2] at e
    exact Subtype.ext (Subtype.ext e.symm)
  let φ : Q →ₐ[P] Ω := (algebraicClosure P Ω).val.comp (S.val.comp Q.val)
  have hφ := IntermediateField.adjoin_map P {zQ} φ
  rw [Set.image_singleton] at hφ
  have hw_mem : w ∈ (IntermediateField.adjoin P {zQ}).map φ := ⟨wQ, hmemQ, rfl⟩
  rw [hφ] at hw_mem
  exact hw_mem
