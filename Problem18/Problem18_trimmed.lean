theorem total_eval (B a b c e : Nat) (σ : Env) (ha : 0<a) (hb : 0<b) (hc : 0<c) (he : 0<e)
    (hbound : 2*(a*b*c*e)<B) (h2 : 2<B)
    (hva : σ.vars "a"=a) (hvb : σ.vars "b"=b) (hvc : σ.vars "c"=c) (hve : σ.vars canonical.e=e) :
    totalExpr.evalB B σ=some (2*(a*b*c*e)) := by
  have hab:=Nat.mul_pos ha hb
  have habc:=Nat.mul_pos hab hc
  have habce:=Nat.mul_pos habc he
  have habL : a*b≤a*b*c*e := (Nat.le_mul_of_pos_right _ hc).trans (Nat.le_mul_of_pos_right _ he)
  have habcL : a*b*c≤a*b*c*e := Nat.le_mul_of_pos_right _ he
  have haL : a≤a*b*c*e := (Nat.le_mul_of_pos_right _ hb).trans habL
  have hbL : b≤a*b*c*e := (Nat.le_mul_of_pos_left _ ha).trans habL
  have hcL : c≤a*b*c*e := (Nat.le_mul_of_pos_left _ hab).trans habcL
  have heL : e≤a*b*c*e := Nat.le_mul_of_pos_left _ habc
  have ev (x : String) (v : Nat) (hv : σ.vars x=v) (hb' : v<B) : (Expr.var x).evalB B σ=some v := by
    rw [←hv]; exact evalB_var (by rwa [hv])
  exact evalB_bin (op:=.mul) (evalB_lit h2)
    (evalB_bin (op:=.mul)
      (evalB_bin (op:=.mul)
        (evalB_bin (op:=.mul) (ev "a" a hva (by omega)) (ev "b" b hvb (by omega)) (by change a*b<B; omega))
        (ev "c" c hvc (by omega)) (by change a*b*c<B; omega))
      (ev canonical.e e hve (by omega)) (by change a*b*c*e<B; omega)) hbound
theorem run (u : Bool) (q : Nat) {a b c B : Nat} (A T : RectTensor a b c K) (ext : String→Nat)
    (ha : 0<a) (hb : 0<b) (hc : 0<c) (h2 : 2<B) (hp : F.p<B)
    (hcount : 2*(a*b*c*F.e)<B)
    (hmem : F.e≤ext canonical.mem) (hmemB : ext canonical.mem<B)
    (hsource : 2*(a*b*c*F.e)≤ext memory) (hsourceB : ext memory<B) :
    Run B program (initEnv ext ((queryWords F u q A T).length::queryWords F u q A T))
      (result F u q A T ext) (100*(F.e+2*(a*b*c*F.e)+1)) := by
  have hhead:=Problem18P34Input20261002Header.run F u q A T ext B
  have hmod:=Run.assign (x:=canonical.modBase) (σ:=after F u q A T ext) (evalB_lit (B:=B) (by omega : 0<B))
  have hmodNames : modIO.Valid := by unfold modIO Names.Valid; decide
  have hloadmod:=readBlock_run modIO hmodNames (B:=B) (modPrepared F u q A T ext) (modWords F)
    (tensorCoordinates F A++tensorCoordinates F T)
    (by simpa [modPrepared,modWords,List.append_assoc] using Problem18P34Input20261002Header.input F u q A T ext)
    (by simp [modWords]; omega)
    (by simp [modPrepared,after,readEnv,headerNames,queryWords,header,List.append_assoc,canonical,modIO,modWords])
    (by simpa [modPrepared,after,readEnv,headerNames,queryWords,header,List.append_assoc,canonical,modIO,modWords,initEnv] using hmem)
    (by simpa [modPrepared,after,readEnv,headerNames,queryWords,header,List.append_assoc,canonical,modIO,initEnv] using hmemB)
    (by intro v hv; obtain ⟨i,hi,rfl⟩:=List.mem_map.mp hv; exact (F.modulus i).isLt.trans hp)
  simp only [modWords,List.length_map,List.length_finRange] at hloadmod
  have hbase:=Run.assign (x:=base) (σ:=modLoaded F u q A T ext) (evalB_lit (B:=B) (by omega : 0<B))
  have ht:=Run.assign (x:=total) (σ:=(modLoaded F u q A T ext).setVar base 0)
    (total_eval B a b c F.e _ ha hb hc F.degree_pos hcount h2
      (by simp [modLoaded,readState,pointState,Names.point,modIO,modPrepared,after,readEnv,headerNames,queryWords,header,List.append_assoc,canonical,loadIndex,loadValue,base])
      (by simp [modLoaded,readState,pointState,Names.point,modIO,modPrepared,after,readEnv,headerNames,queryWords,header,List.append_assoc,canonical,loadIndex,loadValue,base])
      (by simp [modLoaded,readState,pointState,Names.point,modIO,modPrepared,after,readEnv,headerNames,queryWords,header,List.append_assoc,canonical,loadIndex,loadValue,base])
      (by simp [modLoaded,readState,pointState,Names.point,modIO,modPrepared,after,readEnv,headerNames,queryWords,header,List.append_assoc,canonical,loadIndex,loadValue,base]))
  have hlen : (tensorCoordinates F A++tensorCoordinates F T).length=2*(a*b*c*F.e) := by
    simp [Problem18TensorGatherRefinement20261002.tensorCoordinates_length]; omega
  have hdata:=readBlock_run loadNames loadNames_valid (B:=B) (prepared F u q A T ext)
    (tensorCoordinates F A++tensorCoordinates F T) []
    (by simp [prepared,modLoaded,readState,modWords]) (by rwa [hlen])
    (by simp [prepared,loadNames,hlen])
    (by simpa [prepared,modLoaded,readState,pointState,Names.point,modIO,modPrepared,after,readEnv,headerNames,queryWords,header,List.append_assoc,canonical,initEnv,loadNames,memory,base,total,Problem18TensorGatherRefinement20261002.tensorCoordinates_length,two_mul] using hsource)
    (by simpa [prepared,modLoaded,readState,pointState,Names.point,modIO,modPrepared,after,readEnv,headerNames,queryWords,header,List.append_assoc,canonical,initEnv,loadNames,memory] using hsourceB)
    (by
      intro v hv
      rcases List.mem_append.mp hv with hv|hv
      all_goals
        simp only [tensorCoordinates,List.mem_flatMap,List.mem_map,List.mem_finRange,true_and] at hv
        obtain ⟨k,i,j,t,rfl⟩:=hv
        exact (F.coordinate _ t).isLt.trans hp)
  rw [hlen] at hdata
  apply (hhead.seq (hmod.seq (hloadmod.seq (hbase.seq (ht.seq hdata))))).mono
