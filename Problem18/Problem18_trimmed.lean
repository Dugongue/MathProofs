open Finset Matrix
open FiniteFieldOrthogonalUnitaryTI
open Mathproof.Problem18HermitianSecondMoment20260930
open Classical in
theorem rectangular_hermitian_gram_density_second_moment_le
    {F K : Type*} [Field F] [Fintype F] [Field K] [Fintype K]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F) (n m : ℕ) (hm : n ≤ m) :
    (Fintype.card (selfAdjoint (Matrix (Fin n) (Fin n) K)) : ℝ) *
        ∑ y, ‖uniformImageWeight
          (fun x : Fin m → (Fin n → K) =>
            gramHermitian (fun a b => x b a)) y‖ ^ 2 ≤ 5 / 2 := by
  classical
  have hp : 0 < ringChar F :=
    Nat.pos_of_ne_zero (CharP.ringChar_ne_zero_of_finite F)
  obtain ⟨ψ, hψ⟩ := Fintype.exists_ne_of_one_lt_card
    (show 1 < Fintype.card (AddChar F ℂ) by
      rw [AddChar.card_eq]
      exact Fintype.one_lt_card)
    (1 : AddChar F ℂ)
  have hparseval :=
    uniform_sum_density_second_moment
      (rankOneHermitian (K := K) (i := Fin n)) m
  simp only [sum_rankOneHermitian_eq_gram] at hparseval
  let e := Equiv.ofBijective (hermitianTraceCharacter hstar ψ)
    (hermitianTraceCharacter_bijective (i := Fin n) hcard hstar ψ hψ)
  rw [← Equiv.sum_comp e] at hparseval
  have he (Z : selfAdjoint (Matrix (Fin n) (Fin n) K)) :
      (‖(∑ x, e Z (rankOneHermitian x)) /
          (Fintype.card (Fin n → K) : ℂ)‖ ^ 2) ^ m =
        (((Fintype.card F : ℝ) ^ Z.val.rank)⁻¹) ^ (2 * m) := by
    change
      (‖(∑ x, hermitianTraceCharacter hstar ψ Z (rankOneHermitian x)) /
          (Fintype.card (Fin n → K) : ℂ)‖ ^ 2) ^ m = _
    have hd : instDecidableEqFin n = Classical.decEq (Fin n) := Subsingleton.elim _ _
    rw [hd]
    rw [rankOneGram_fourier_exact hcard hstar hp ψ hψ Z]
    have hK : Fintype.card K = Fintype.card F ^ 2 := by
      simpa only [Nat.card_eq_fintype_card] using hcard
    simp only [hK, Nat.cast_pow, inv_pow, ← pow_mul]
    congr 1 <;> ring
  simp_rw [he] at hparseval
  rw [hparseval]
  exact hermitian_point_energy_sum_bound hcard hstar n (2 * m) (by omega)
open Classical in
theorem rectangular_hermitian_gram_event_probability_le
    {F K : Type*} [Field F] [Fintype F] [Field K] [Fintype K]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F) (n m : ℕ) (hm : n ≤ m)
    (E : Finset (selfAdjoint (Matrix (Fin n) (Fin n) K))) :
    ((Finset.univ.filter (fun x : Fin m → (Fin n → K) =>
      gramHermitian (fun a b => x b a) ∈ E)).card : ℝ) /
        Fintype.card (Fin m → (Fin n → K)) ≤
      Real.sqrt ((5 / 2 : ℝ) *
        ((E.card : ℝ) /
          Fintype.card (selfAdjoint (Matrix (Fin n) (Fin n) K)))) := by
  have h := image_event_probability_le_sqrt
    (fun x : Fin m → (Fin n → K) =>
      gramHermitian (fun a b => x b a)) E (5 / 2)
    (by norm_num)
    (rectangular_hermitian_gram_density_second_moment_le hcard hstar n m hm)
  convert h using 1
  congr 2
  apply congrArg Finset.card
  ext x
  simp
end Mathproof.Problem18RectangularHermitianTransfer20260930
end
