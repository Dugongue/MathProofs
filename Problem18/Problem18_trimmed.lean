open IntermediateField Module Problem18ConstantFieldDegree20260930
variable (k F E L : Type*) [Field k] [Field F] [Field E] [Field L]
  [Algebra k F] [Algebra k E] [Algebra k L] [Algebra F L] [Algebra E L]
  [IsScalarTower k F L] [IsScalarTower k E L]
  [PerfectField k] [FiniteDimensional k E] [FunctionField.IsFullConstantField k F]
include k in
theorem full_constant_extension_exact (hgen : constantCompositum F E L = ⊤) :
    FunctionField.IsFullConstantField E L := by
  constructor
  intro x hx
  let C : IntermediateField E L := E⟮x⟯
  have hxint : IsIntegral E x := isAlgebraic_iff_isIntegral.mp hx
  letI : FiniteDimensional E C := IntermediateField.adjoin.finiteDimensional hxint
  letI : FiniteDimensional k C := Module.Finite.trans E C
  letI : IsScalarTower k C L := IsScalarTower.of_algebraMap_eq fun a => by
    rw [IsScalarTower.algebraMap_apply k E C, ← IsScalarTower.algebraMap_apply E C L]
    exact IsScalarTower.algebraMap_apply k E L a
  have hgenC : constantCompositum F C L = ⊤ := by
    apply top_unique
    rw [← hgen]
    apply (constantCompositum_le_iff F E L).mpr
    intro c
    have hc := algebraMap_mem_constantCompositum F C L (algebraMap E C c)
    simpa only [← IsScalarTower.algebraMap_apply E C L] using hc
  have hE := full_constant_extension_degree k F E L
  have hC := full_constant_extension_degree k F C L
  rw [hgen, IntermediateField.finrank_top'] at hE
  rw [hgenC, IntermediateField.finrank_top'] at hC
  have hkc : finrank k C = finrank k E := hC.symm.trans hE
  have hec : finrank E C = 1 := by
    have ht := finrank_mul_finrank k E C
    rw [hkc] at ht
    exact Nat.eq_of_mul_eq_mul_left (finrank_pos (R := k) (M := E)) (by simpa using ht)
  have hbot : C = ⊥ := IntermediateField.finrank_eq_one_iff.mp hec
  have hxbot : x ∈ (⊥ : IntermediateField E L) := hbot ▸ mem_adjoin_simple_self E x
  obtain ⟨c, hc⟩ := IntermediateField.mem_bot.mp hxbot
  exact ⟨c, hc.symm⟩
end Mathproof.Problem18ConstantExtensionExact20260930
