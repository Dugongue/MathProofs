      rw [Nat.add_comm, hc, h2, Nat.mod_eq_of_lt ht] at h1
      exact h1.symm
    subst ht0
    have h3 : i*n+j=(n+1)*c := by
      have : E*(i*n+j)=E*((n+1)*c) := by rw [Nat.add_zero] at hc; rw [hc]; ring
      exact Nat.eq_of_mul_eq_mul_left hE this
    have hcn : c<n := by
      by_contra hc'
      push_neg at hc'
      have : (n+1)*n ≤ (n+1)*c := Nat.mul_le_mul_left _ hc'
      nlinarith
    have hic : i=c := by
      have e1 : (j+i*n)/n=i := by
        rw [Nat.add_mul_div_right _ _ (by omega), Nat.div_eq_of_lt hj, Nat.zero_add]
      have e2 : (c+c*n)/n=c := by
        rw [Nat.add_mul_div_right _ _ (by omega), Nat.div_eq_of_lt hcn, Nat.zero_add]
      have e3 : j+i*n=c+c*n := by rw [Nat.add_comm, h3]; ring
