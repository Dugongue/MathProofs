variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
theorem slot_index {n s i : Nat} (hs : s< slots n) (hi : i<F.e) :
    F.e+1+s*F.e+i< memLen n F.e := slot_lt hs hi
theorem first_add_lt {n j : Nat} (hj : j<capacity n) : first n+j< slots n := by
  obtain ⟨_,_,_,_,_,hf,hg,hd,hcand,hseed,hm,ha,ht,hp,hw,hor,hsl⟩:=allocation n
  omega
theorem words_iff_poly {σ : Env} {n : Nat} {SA SB : Matrix (Fin n) (Fin n) K}
    (hA : Snap F σ 0 SA) (hB : Snap F σ (memLen n F.e) SB) :
    (∀k<capacity n*F.e,(σ.arrs pairBank).getD (offset n F.e+k) 0=
        (σ.arrs pairBank).getD (memLen n F.e+offset n F.e+k) 0) ↔
      (Problem18PairBoundarySemantics20261004.sweepOf SA).2=
        (Problem18PairBoundarySemantics20261004.sweepOf SB).2 := by
  have he : 0<F.e := F.degree_pos
  have hslot : ∀ j<capacity n,
      ((∀i<F.e,(σ.arrs pairBank).getD (offset n F.e+(j*F.e+i)) 0=
        (σ.arrs pairBank).getD (memLen n F.e+offset n F.e+(j*F.e+i)) 0) ↔
       pairSlot F σ 0 (first n+j)=pairSlot F σ (memLen n F.e) (first n+j)) := by
    intro j hj
    have hidx : ∀ i<F.e, F.e+1+(first n+j)*F.e+i< memLen n F.e :=
      fun i hi=>slot_index F (first_add_lt hj) hi
    have hoff : ∀ i, offset n F.e+(j*F.e+i)=F.e+1+(first n+j)*F.e+i := by
      intro i;unfold offset;ring
    have h1 : ∀ i, offset n F.e+(j*F.e+i)=0+(F.e+1)+(first n+j)*F.e+i := by
      intro i;unfold offset;ring
    have h2 : ∀ i, memLen n F.e+offset n F.e+(j*F.e+i)=memLen n F.e+(F.e+1)+(first n+j)*F.e+i := by
      intro i;unfold offset;ring
    have hv : Problem18IMPFieldPresentation20261001.Canonical F
        (fun i : Fin F.e=>(σ.arrs pairBank).getD (0+(F.e+1)+(first n+j)*F.e+i.val) 0) := by
      intro i
      have := hA.canonical _ (hidx i.val i.isLt)
      dsimp only
      convert this using 2
      ring
    have hw : Problem18IMPFieldPresentation20261001.Canonical F
        (fun i : Fin F.e=>(σ.arrs pairBank).getD (memLen n F.e+(F.e+1)+(first n+j)*F.e+i.val) 0) := by
      intro i
      have := hB.canonical _ (hidx i.val i.isLt)
      dsimp only
      convert this using 2
      ring
    unfold pairSlot
    rw [Problem18IMPFieldPresentation20261001.decode_injective F hv hw]
    constructor
    · intro h
      funext i
      have := h i.val i.isLt
      rwa [h1,h2] at this
    · intro h i hi
      have := congrFun h ⟨i,hi⟩
      rw [h1,h2]
      exact this
  have hdeg : ∀ (S : Matrix (Fin n) (Fin n) K),
      (Problem18PairBoundarySemantics20261004.sweepOf S).2.natDegree<capacity n := by
    intro S
    have:=Problem18DeterministicCyclicSweep20261001.sweep_degree_le S.toLin' n
    unfold capacity
    unfold Problem18PairBoundarySemantics20261004.sweepOf
    nlinarith
  constructor
  · intro h
    ext m
    by_cases hm : m<capacity n
    · have hj : capacity n-1-m<capacity n := by omega
      have hs:=(hslot _ hj).mp (fun i hi=>h _ (by
        have : (capacity n-1-m)*F.e+i<(capacity n-1-m+1)*F.e := by nlinarith
        have h2 : (capacity n-1-m+1)*F.e≤ capacity n*F.e :=
          Nat.mul_le_mul_right _ (by omega)
        omega))
      rw [hA.polynomial _ hj,hB.polynomial _ hj] at hs
      have hm' : capacity n-1-(capacity n-1-m)=m := by omega
      rwa [hm'] at hs
    · rw [coeff_eq_zero_of_natDegree_lt (by have:=hdeg SA;omega),
        coeff_eq_zero_of_natDegree_lt (by have:=hdeg SB;omega)]
  · intro h k hk
    have hj : k/F.e<capacity n := by
      rw [Nat.div_lt_iff_lt_mul he];exact hk
    have hk' : k=k/F.e*F.e+k%F.e := by
      have:=Nat.div_add_mod k F.e;rw [Nat.mul_comm] at this;omega
    have hs:=(hslot _ hj).mpr (by
      rw [hA.polynomial _ hj,hB.polynomial _ hj,h])
    rw [hk']
    exact hs _ (Nat.mod_lt _ he)
theorem vars_set_ne {σ : Env} {x y : String} {v : Nat} (h : y≠x) :
    (σ.setVar x v).vars y=σ.vars y := by simp [h]
theorem unitaryMode_run {B n : Nat} {SA SB : Matrix (Fin n) (Fin n) K} {σ : Env}
    (hA : Snap F σ 0 SA) (hB : Snap F σ (memLen n F.e) SB)
    (hcols : σ.vars colsReg=n) (he : σ.vars canonical.e=F.e)
    (hbit : σ.vars rTReg=0 ∨ σ.vars rTReg=1)
    (hlen : 2*memLen n F.e≤(σ.arrs pairBank).length)
    (hpB : F.p<B) (hB1 : 1<B)
    (hwc : majorant cntSize n F.e<B) (hwo : majorant o2Size n F.e<B)
    (hwl : 2*memLen n F.e<B) :
    ∃τ,Run B unitaryMode σ τ (unitaryCost n F.e) ∧
      (τ.vars modeResult=0 ∨ τ.vars modeResult=1) ∧
      (τ.vars modeResult=1 ↔ (σ.vars rTReg=1 ∧
        (Problem18PairBoundarySemantics20261004.sweepOf SA).2=
          (Problem18PairBoundarySemantics20261004.sweepOf SB).2)) ∧
      τ.arrs=σ.arrs ∧ (∀x,x∉unitaryRegs→τ.vars x=σ.vars x) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  let L:=memLen n F.e
  let o:=offset n F.e
  let c:=capacity n*F.e
  have hcl : first n+capacity n≤ slots n := by
    obtain ⟨_,_,_,_,_,hf,hg,hd,hcand,hseed,hm,ha,ht,hp,hw,hor,hsl⟩:=allocation n
    omega
  have hoc : o+c≤L := by
    have : (first n+capacity n)*F.e≤ slots n*F.e := Nat.mul_le_mul_right _ hcl
    simp only [o,c,L,offset,memLen]
    nlinarith
  let s0:=σ.setVar modeResult 0
  have hr0 : Run B (.assign modeResult (.lit 0)) σ s0 2 :=
    (Run.assign (evalB_lit (by omega : 0<B)))
  have hrT0 : s0.vars rTReg=σ.vars rTReg := vars_set_ne (by decide)
  rcases hbit with hz|hone
  ·
    have hc : (Cond.eq (.var rTReg) (.lit 1)).evalB B s0=some false := by
      have:=evalB_condEq (evalB_var (σ:=s0) (x:=rTReg) (B:=B) (by rw [hrT0,hz];omega))
        (evalB_lit (σ:=s0) (B:=B) (n:=1) hB1)
      rw [this,hrT0,hz];rfl
    have hr:=hr0.seq (Run.ite_false (c:=(.seq (.assign cntR (ex cntSize)) <|
        .seq (.assign o1R (ex o1Size)) <| .seq (.assign o2R (ex o2Size)) <|
        .seq (segEq pairBank idxR cntR o1R o2R flagR) (.assign modeResult (.var flagR))))
      hc Run.skip)
    refine ⟨s0,hr.mono (by simp [unitaryCost,Cond.size,Expr.size];omega),
      Or.inl (by simp [s0]),?_,rfl,?_,rfl,rfl⟩
    · rw [show s0.vars modeResult=0 by simp [s0],hz];simp
    · intro x hx
      have : x≠modeResult := fun h=>hx (by simp [unitaryRegs,h])
      simp [s0,this]
  · have hc : (Cond.eq (.var rTReg) (.lit 1)).evalB B s0=some true := by
      have:=evalB_condEq (evalB_var (σ:=s0) (x:=rTReg) (B:=B) (by rw [hrT0,hone];omega))
        (evalB_lit (σ:=s0) (B:=B) (n:=1) hB1)
      rw [this,hrT0,hone];rfl
    have hs0c : s0.vars colsReg=n := (vars_set_ne (by decide)).trans hcols
    have hs0e : s0.vars canonical.e=F.e := (vars_set_ne (by decide)).trans he
    have hmo1 : majorant o1Size n F.e<B := by
      have := hwo;simp only [o2Size,majorant] at this;omega
    let s1:=s0.setVar cntR c
    have hr1 : Run B (.assign cntR (ex cntSize)) s0 s1 (1+(ex cntSize).size) :=
      Run.assign (by
        rw [show c=value cntSize n F.e from (cntSize_value _ _).symm]
        exact expression_eval cntSize _ _ hs0c hs0e hwc)
    let s2:=s1.setVar o1R o
    have hr2 : Run B (.assign o1R (ex o1Size)) s1 s2 (1+(ex o1Size).size) :=
      Run.assign (by
        rw [show o=value o1Size n F.e from (o1Size_value _ _).symm]
        exact expression_eval o1Size _ _ ((vars_set_ne (by decide)).trans hs0c)
          ((vars_set_ne (by decide)).trans hs0e) hmo1)
    let s3:=s2.setVar o2R (L+o)
    have hr3 : Run B (.assign o2R (ex o2Size)) s2 s3 (1+(ex o2Size).size) :=
      Run.assign (by
        rw [show L+o=value o2Size n F.e from (o2Size_value _ _).symm]
        exact expression_eval o2Size _ _ ((vars_set_ne (by decide)).trans ((vars_set_ne (by decide)).trans hs0c))
          ((vars_set_ne (by decide)).trans ((vars_set_ne (by decide)).trans hs0e)) hwo)
    have hs3arr : s3.arrs=σ.arrs := rfl
    obtain ⟨s4,hr4,hfl,hflag,harr4,hvars4,hi4,ho4⟩:=
      segEq_run (arr:=pairBank) (idx:=idxR) (cnt:=cntR) (o1:=o1R) (o2:=o2R) (flag:=flagR)
        (by decide) (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
        (B:=B) (n:=c) (b1:=o) (b2:=L+o) s3 hB1 (by omega)
        ((vars_set_ne (by decide)).trans ((vars_set_ne (by decide)).trans (by simp [s1]))) ((vars_set_ne (by decide)).trans (by simp [s2])) (by simp [s3])
        (by omega) (by omega) (by rw [hs3arr];omega) (by rw [hs3arr];omega)
        (by
          intro k hk
          rw [hs3arr]
          have h1:=hA.canonical (o+k) (by omega)
          have h2:=hB.canonical (o+k) (by omega)
          simp only [Nat.zero_add] at h1
          constructor
          · omega
          · show (σ.arrs pairBank).getD (memLen n F.e+offset n F.e+k) 0<B
            rw [Nat.add_assoc]
            exact lt_trans h2 hpB)
    let s5:=s4.setVar modeResult (s4.vars flagR)
    have hr5 : Run B (.assign modeResult (.var flagR)) s4 s5 2 :=
      Run.assign (evalB_var (by rcases hfl with h|h <;> rw [h] <;> omega))
    have hr:=hr0.seq (Run.ite_true (d:=.skip) hc
      (hr1.seq (hr2.seq (hr3.seq (hr4.seq hr5)))))
    refine ⟨s5,hr.mono (by simp [unitaryCost,Cond.size,Expr.size,c];omega),?_,?_,?_,?_,?_,?_⟩
    · simpa [s5] using hfl
    · have hwords := words_iff_poly F hA hB
      simp only [s5,vars_setVar,if_pos rfl,ite_true]
      rw [hflag,hs3arr]
      constructor
      · intro h
        refine ⟨hone,hwords.mp ?_⟩
        intro k hk
        have := h k hk
        simpa [Nat.add_assoc] using this
      · rintro ⟨-,h⟩ k hk
        have := hwords.mpr h k hk
        simpa [Nat.add_assoc] using this
    · simp [s5,harr4,hs3arr]
    · intro x hx
      have h1 : x≠modeResult := fun h=>hx (by simp [unitaryRegs,h])
      have h2 : x≠cntR := fun h=>hx (by simp [unitaryRegs,h])
      have h3 : x≠o1R := fun h=>hx (by simp [unitaryRegs,h])
      have h4 : x≠o2R := fun h=>hx (by simp [unitaryRegs,h])
      have h5 : x≠idxR := fun h=>hx (by simp [unitaryRegs,h])
      have h6 : x≠flagR := fun h=>hx (by simp [unitaryRegs,h])
      simp only [s5,vars_setVar,if_neg h1]
      rw [hvars4 x h5 h6]
      simp [s3,s2,s1,s0,h1,h2,h3,h4]
    · exact hi4
    · exact ho4
variable [BEq K] [LawfulBEq K]
theorem modeAnswer_true_eq {n d : Nat} (p q : Nat) (sA sT : RectTensor 1 n d K) (hnd : n ≤ d)
    (hfirst : Problem18BoundaryRawChecks20261001.firstCheck true q sA=true) :
    Problem18PairBoundarySemantics20261004.modeAnswer true p q sA sT=
      Problem18UnitaryRawQuery20261001.queryCheck q
        (Problem18DimensionOneBoundary20260930.matrixOf sA)
        (Problem18DimensionOneBoundary20260930.matrixOf sT) := by
  have h:=Problem18PairBoundarySemantics20261004.trial_eq true p q sA sT hnd hfirst
  simp only [Problem18BoundaryQueryAssembly20261001.trial,if_true,Option.some.injEq] at h
  exact h.symm
theorem unitaryMode_query {B n d : Nat} (p q : Nat) {sA sT : RectTensor 1 n d K} {σ : Env}
    (hA : Snap F σ 0 (Problem18PairBoundarySemantics20261004.gramOf true q sA))
    (hB : Snap F σ (memLen n F.e) (Problem18PairBoundarySemantics20261004.gramOf true q sT))
    (hcols : σ.vars colsReg=n) (he : σ.vars canonical.e=F.e)
    (hbit : σ.vars rTReg=0 ∨ σ.vars rTReg=1)
    (hrT : σ.vars rTReg=1 ↔ Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck
      (Problem18PairBoundarySemantics20261004.gramOf true q sT)=true)
    (hlen : 2*memLen n F.e ≤ (σ.arrs pairBank).length)
    (hpB : F.p<B) (hB1 : 1<B)
    (hwc : majorant cntSize n F.e<B) (hwo : majorant o2Size n F.e<B)
    (hwl : 2*memLen n F.e<B)
    (hnd : n ≤ d) (hfirst : Problem18BoundaryRawChecks20261001.firstCheck true q sA=true) :
    ∃τ,Run B unitaryMode σ τ (unitaryCost n F.e) ∧
      (τ.vars modeResult=0 ∨ τ.vars modeResult=1) ∧
      (τ.vars modeResult=1 ↔
        Problem18UnitaryRawQuery20261001.queryCheck q
          (Problem18DimensionOneBoundary20260930.matrixOf sA)
          (Problem18DimensionOneBoundary20260930.matrixOf sT)=true) ∧
      τ.arrs=σ.arrs ∧ (∀x,x∉unitaryRegs→τ.vars x=σ.vars x) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  obtain ⟨τ,hr,hb,hres,ha,hv,hi,ho⟩:=unitaryMode_run F hA hB hcols he hbit hlen hpB hB1 hwc hwo hwl
  refine ⟨τ,hr,hb,?_,ha,hv,hi,ho⟩
  rw [hres,← modeAnswer_true_eq p q sA sT hnd hfirst,hrT]
  simp [Problem18PairBoundarySemantics20261004.modeAnswer]
end Mathproof.Problem18PairBoundaryModeUnitary20261004
