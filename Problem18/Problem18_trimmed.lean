open CompPoly
open scoped Polynomial
variable {K : Type*} [Field K] [BEq K] [LawfulBEq K] [DecidableEq K]
def remainder (f p : CPolynomial K) : CPolynomial K := p - f * CPolynomial.div p f
theorem remainder_toPoly (f p : CPolynomial K) :
    (remainder f p).toPoly = p.toPoly % f.toPoly := by
  rw [remainder, CPolynomial.toPoly_sub, CPolynomial.toPoly_mul,
    CPolynomial.div_toPoly_eq_div, EuclideanDomain.mod_eq_sub_mul_div]
def modBits (f x : CPolynomial K) : List Bool → CPolynomial K × ℕ
  | [] => (remainder f 1, 0)
  | b :: bs =>
    let r := modBits f x bs
    let s := remainder f (r.1*r.1)
    if b then (remainder f (s * remainder f x), r.2+2) else (s,r.2+1)
def modularPower (f x : CPolynomial K) (n : ℕ) : CPolynomial K × ℕ :=
  modBits f x n.bits
theorem modBits_toPoly (f x : CPolynomial K) (bs : List Bool) :
    ((modBits f x bs).1.toPoly, (modBits f x bs).2) =
      Problem18UnivariateSolver20260930.modBits f.toPoly x.toPoly bs := by
  induction bs with
  | nil => simp only [modBits, Problem18UnivariateSolver20260930.modBits,
      remainder_toPoly, CPolynomial.toPoly_one]
  | cons b bs ih =>
    have ih1 := congrArg Prod.fst ih
    have ih2 := congrArg Prod.snd ih
    dsimp only at ih1 ih2
    cases b <;> simp only [modBits, Problem18UnivariateSolver20260930.modBits,
      Bool.false_eq_true, ↓reduceIte, remainder_toPoly, CPolynomial.toPoly_mul,
      ih1, ih2]
theorem modularPower_toPoly (f x : CPolynomial K) (n : ℕ) :
    (modularPower f x n).1.toPoly =
      (Problem18UnivariateSolver20260930.modularPower f.toPoly x.toPoly n).1 :=
  congrArg Prod.fst (modBits_toPoly f x n.bits)
end Mathproof.Problem18CompPolySolver20260930
