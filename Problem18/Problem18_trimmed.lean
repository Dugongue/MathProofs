open Mathproof.Problem18MacaulayAlgorithm20260930
open Mathproof.Problem18PolynomialCompression20261001
open Mathproof.Problem18DenseMonomialEnumeration20260930
open Mathproof.Meta.Problem18BoundedControlledDicksonEnumeration20260930
open Mathproof.Problem18BinaryPower20260930
open Problem18ArrayElimination20260929
variable {K : Type} [Field K] [DecidableEq K]
def powFold {n : Nat} (x : Fin n → K) (a : FinExponent n) : List (Fin n) → K × Nat
  | [] => (1, 0)
  | j :: js =>
    let r := powFold x a js
    let p := binaryPower (x j) (a j)
    (p.1 * r.1, p.2 + r.2 + 1)
theorem powFold_value {n : Nat} (x : Fin n → K) (a : FinExponent n) (l : List (Fin n)) :
    (powFold x a l).1 = (l.map fun j => x j ^ a j).prod := by
  induction l with
  | nil => rfl
  | cons j js ih => simp [powFold, ih, binaryPower_correct]
def monomialValue {n : Nat} (x : Fin n → K) (a : FinExponent n) : K × Nat :=
  powFold x a (List.finRange n)
theorem monomialValue_value {n : Nat} (x : Fin n → K) (a : FinExponent n) :
    (monomialValue x a).1 = ∏ j, x j ^ a j := by
  rw [monomialValue, powFold_value, Fin.prod_univ_def]
def rowFold {n d : Nat} (x : Fin n → K) (v : DenseInput n d K) :
    List (Fin (boundedExponents n d).length) → K × Nat
  | [] => (0, 0)
  | i :: is =>
    let r := rowFold x v is
    let m := monomialValue x ((boundedExponents n d)[i.val])
    (m.1 * v[i.val] + r.1, m.2 + r.2 + 2)
theorem rowFold_value {n d : Nat} (x : Fin n → K) (v : DenseInput n d K)
    (l : List (Fin (boundedExponents n d).length)) :
    (rowFold x v l).1 =
      (l.map fun i => (∏ j, x j ^ ((boundedExponents n d)[i.val]) j) * v[i.val]).sum := by
  induction l with
  | nil => rfl
  | cons i is ih => simp [rowFold, ih, monomialValue_value]
def rowValue {n d : Nat} (x : Fin n → K) (v : DenseInput n d K) : K × Nat :=
  rowFold x v (List.finRange (boundedExponents n d).length)
theorem rowValue_eq_denseEval {n d : Nat} (x : Fin n → K) (v : DenseInput n d K) :
    (rowValue x v).1 = denseEval x (read v) := by
  rw [rowValue, rowFold_value, denseEval, LinearMap.sum_apply, Fin.sum_univ_def]
  simp only [LinearMap.smul_apply, LinearMap.proj_apply, smul_eq_mul]
  rfl
def rowBudget (n d : Nat) : Nat := (d + 1) ^ n * (n * (2 * d.size + 1) + 2)
def rowsZero {n d : Nat} (x : Fin n → K) : List (DenseInput n d K) → Bool × Nat
  | [] => (true, 0)
  | v :: vs =>
    let r := rowsZero x vs
    let e := rowValue x v
    (decide (e.1 = 0) && r.1, e.2 + r.2 + 1)
theorem rowsZero_correct {n d : Nat} (x : Fin n → K) (rows : List (DenseInput n d K)) :
    (rowsZero x rows).1 = true ↔ ∀ v ∈ rows, denseEval x (read v) = 0 := by
  induction rows with
  | nil => simp [rowsZero]
  | cons v vs ih =>
    simp only [rowsZero, Bool.and_eq_true, decide_eq_true_eq, List.mem_cons, forall_eq_or_imp,
      rowValue_eq_denseEval, ih]
def scan {n d : Nat} (F : FieldPresentation K) (rows : List (DenseInput n d K)) :
    Nat → Bool × Nat
  | 0 => (false, 0)
  | t + 1 =>
    let r := scan F rows t
    let x := vector F n t
    let z := rowsZero x.1 rows
    (r.1 || z.1, r.2 + x.2 + z.2)
theorem scan_correct {n d : Nat} (F : FieldPresentation K) (rows : List (DenseInput n d K))
    (N : Nat) :
    (scan F rows N).1 = true ↔ ∃ t < N, (rowsZero (vector F n t).1 rows).1 = true := by
  induction N with
  | zero => simp [scan]
  | succ N ih =>
    simp only [scan, Bool.or_eq_true, ih]
    constructor
    · rintro (⟨t, ht, h⟩ | h)
      · exact ⟨t, Nat.lt_succ_of_lt ht, h⟩
      · exact ⟨N, Nat.lt_succ_self N, h⟩
    · rintro ⟨t, ht, h⟩
      rcases Nat.lt_succ_iff_lt_or_eq.mp ht with ht | rfl
      · exact Or.inl ⟨t, ht, h⟩
      · exact Or.inr h
def smallFieldDecide {n d : Nat} (F : FieldPresentation K) (rows : List (DenseInput n d K)) :
    Bool × Nat :=
  let q := binaryPower F.p F.e
  let N := binaryPower q.1 n
  let s := scan F rows N.1
  (s.1, q.2 + N.2 + s.2)
theorem smallFieldDecide_correct {n d : Nat} (F : FieldPresentation K)
    (rows : List (DenseInput n d K)) :
    (smallFieldDecide F rows).1 = true ↔ ∃ x : Fin n → K, ∀ v ∈ rows, denseEval x (read v) = 0 := by
  simp only [smallFieldDecide, binaryPower_correct, scan_correct, rowsZero_correct]
  constructor
  · rintro ⟨t, ht, h⟩
    exact ⟨(vector F n t).1, h⟩
  · rintro ⟨x, hx⟩
    refine ⟨((vectorEquiv F n) x).val, ((vectorEquiv F n) x).isLt, ?_⟩
    have hv := vector_value F n ((vectorEquiv F n) x)
    rw [Equiv.symm_apply_apply] at hv
    rw [hv]
    exact hx
def enumerationBudget (n d e cardK rowCount : Nat) : Nat :=
  2 * e.size + 2 * n.size + cardK ^ n * (vectorBudget n e + rowCount * (rowBudget n d + 1))
end Mathproof.Problem18SmallFieldEnumeration20261001
end
