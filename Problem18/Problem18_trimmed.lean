    {V W : Type*} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    [AddCommGroup W] [Module K W] [FiniteDimensional K W]
    (hodd : ringChar K≠2) {n : ℕ}
    (C : LinearMap.BilinForm K V) (B : LinearMap.BilinForm K W)
    (bC : Module.Basis (Fin n) K V) (bB : Module.Basis (Fin n) K W)
    (hsC : C.IsSymm) (hsB : B.IsSymm) (hnC : C.Nondegenerate) (hnB : B.Nondegenerate) :
    determinantClass C hnC bC=determinantClass B hnB bB ↔
      ∃ e : V ≃ₗ[K] W,∀ x y,B (e x) (e y)=C x y := by
  rw [Mathproof.Problem18OddFormDeterminantIsometry20260930.isometry_iff_square_determinant_ratio
    hodd C B bC bB hsC hsB hnC hnB]
  exact squareClass_eq_iff_isSquare_ratio (gramUnit C hnC bC) (gramUnit B hnB bB)
end
