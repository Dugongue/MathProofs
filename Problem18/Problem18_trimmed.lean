    simpa only [Problem18Assembly.IsUnitary,Matrix.star_eq_conjTranspose,Matrix.conjTranspose_one,Matrix.one_mul] using h)⟩
  invFun U := ⟨unitaryEquiv U.val (Matrix.mem_unitaryGroup_iff'.mp U.property),
