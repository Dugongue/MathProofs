theorem product_exists_probability_le {S Ω I : Type*}
    [Fintype S] [Nonempty S] [Fintype Ω] [Nonempty Ω] [Fintype I]
    (A : I → S → Prop) (B : I → Ω → Prop) (C ε : ℝ)
    (hε : 0 ≤ ε)
    (hA : (∑ i : I, (Nat.card {s : S // A i s} : ℝ)/Fintype.card S) ≤ C)
    (hB : ∀ i, (Nat.card {x : Ω // B i x} : ℝ)/Fintype.card Ω ≤ ε) :
    (Nat.card {z : S×Ω // ∃ i, A i z.1 ∧ B i z.2} : ℝ)/Fintype.card (S×Ω) ≤ C*ε := by
  classical
  let E : I → Finset (S×Ω) := fun i =>
    (Finset.univ.filter (A i)) ×ˢ (Finset.univ.filter (B i))
  have heq : Finset.univ.filter (fun z : S×Ω => ∃ i, A i z.1 ∧ B i z.2) =
      Finset.univ.biUnion E := by ext z; simp [E]
  have hc (i : I) : ((E i).card : ℝ)/Fintype.card (S×Ω) =
      ((Nat.card {s : S // A i s} : ℝ)/Fintype.card S) *
      ((Nat.card {x : Ω // B i x} : ℝ)/Fintype.card Ω) := by
    simp only [E,Finset.card_product,Fintype.card_prod,Nat.cast_mul,
      Nat.card_eq_fintype_card,Fintype.card_subtype]
    ring
  calc
    _ = ((Finset.univ.biUnion E).card : ℝ)/Fintype.card (S×Ω) := by
      simp only [Nat.card_eq_fintype_card,Fintype.card_subtype,heq]
    _ ≤ ∑ i : I, ((E i).card : ℝ)/Fintype.card (S×Ω) := family_union_probability_le E
    _ ≤ ∑ i : I, ((Nat.card {s : S // A i s} : ℝ)/Fintype.card S)*ε := by
      apply Finset.sum_le_sum
      intro i hi
      rw [hc]
      exact mul_le_mul_of_nonneg_left (hB i) (by positivity)
    _ = (∑ i : I, (Nat.card {s : S // A i s} : ℝ)/Fintype.card S)*ε :=
      (Finset.sum_mul _ _ _).symm
    _ ≤ C*ε := mul_le_mul_of_nonneg_right hA hε
variable {K E : Type*} [Field K] [Fintype K] [Field E] [Fintype E]
