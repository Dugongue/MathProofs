    irreducible_quotient_units_card g hgi,irreducible_quotient_units_card h hhi] using hp
theorem irreducible_base_unit_weight {K : Type*} [Field K] [Fintype K]
    (σ : K ≃+* K) (hσ : Function.Involutive σ) (hne : σ≠1)
    (f : (fixedField σ)[X]) (hm : f.Monic) (hi : Irreducible f) :
    Nat.card (AdjoinRoot (f.map (algebraMap (fixedField σ) K)))ˣ=
      (Nat.card (fixedField σ)^f.natDegree-1)*
        (if Odd f.natDegree then Nat.card (fixedField σ)^f.natDegree+1
         else Nat.card (fixedField σ)^f.natDegree-1) := by
  classical
  letI : Fintype (fixedField σ) := Fintype.ofFinite _
  let q := Nat.card (fixedField σ)
  have hK : Nat.card K=q^2 := card_fixedField σ hσ hne
  rcases irreducible_parity_factorization σ hσ hne q hK f hm hi with ⟨ho,hfi⟩ | ⟨he,g,hgm,hgi,hfg,hgne,hdeg⟩
  · rw [if_pos ho,irreducible_quotient_units_card _ hfi,hm.natDegree_map,hK,pow_right_comm]
