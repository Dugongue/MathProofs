variable {K : Type*} [Field K] [BEq K] [LawfulBEq K] [DecidableEq K]
def frobeniusGcd (f : CPolynomial K) (q d : ℕ) : CPolynomial K×ℕ :=
  let e := binaryPower q d
  let r := modularPower f CPolynomial.X e.1
  let s := sub r.1 CPolynomial.X
  let g := Mathproof.Problem18CountedPolynomialLoops20261001.gcd f s.1
  (g.1,e.2+r.2+s.2+g.2)
def frobeniusBudget (n q d : ℕ) := 2*d.size+(d*q.size+2)*modularBudget n+2*(n+1)+(n+1)*remainderBudget n
def zeroCheck {n : ℕ} (M : Matrix (Fin n) (Fin n) K) : Bool×ℕ :=
  let rows := List.ofFn fun i:Fin n => List.ofFn fun j:Fin n => M i j==0
  (rows.all (fun row => row.all id),(rows.map List.length).sum)
def degreeCheck (n : ℕ) (A D : Array K) (f : CPolynomial K) (q d : ℕ) : Bool×ℕ :=
  let g := frobeniusGcd f q d
  let h := divide f g.1
  let H := evaluate n A h.1
  let e := binaryPower q d
  let P := power n D (e.1/2)
  let S := addScalar n P.1 (-1)
  let M := multiply n S.1 H.1
  let Z := zeroCheck (matrix n M.1)
  (Z.1,g.2+h.2+H.2+e.2+P.2+1+S.2+M.2+Z.2)
def divideBudget (n : ℕ) := (n+1)+(n+1)*(3*(n+1)+1)+(n+1)+2
def degreeBudget (n q d : ℕ) := frobeniusBudget n q d+divideBudget n+
  (n+1)*(2*n*n*n+n*n)+2*d.size+(d*q.size+1)*(4*n*n*n)+1+n*n+2*n*n*n+n*n
def allChecks (n : ℕ) (A D : Array K) (f : CPolynomial K) (q : ℕ) : Bool×ℕ :=
  let results := List.ofFn fun i:Fin n => degreeCheck n A D f q (i.val+1)
  (results.all Prod.fst,(results.map Prod.snd).sum)
end Mathproof.Problem18CountedBoundaryDegreeTests20261001
