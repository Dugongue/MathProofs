def geoE (n d : ℕ) : ℕ := 2 * d * 2 ^ (controlledDepth n d)
def constTbl (n B : ℕ) : List ℕ := (boundedExponents n B).map fun b => if b = 0 then 1 else 0
structure GNames where
  t : String
  R : String
  inB : String
  oB : String
  z : String
  k : String
def GNames.list (gn : GNames) : List String := [gn.t, gn.R, gn.inB, gn.oB, gn.z, gn.k]
def GNames.mn (gn : GNames) : MNames := ⟨gn.t, gn.R, gn.inB, gn.oB⟩
structure GNames.Valid (r : FieldNames) (q : RNames) (gn : GNames) : Prop where
  nodup : (q.list ++ gn.list).Nodup
  avoid : ∀ x ∈ gn.list, x ∉ regNames r
theorem GNames.Valid.ne_of {r : FieldNames} {q : RNames} {gn : GNames} (h : gn.Valid r q)
    {x y : String} (hxy : x = y → ¬ (q.list ++ gn.list).Nodup) : x ≠ y := fun e => hxy e h.1
theorem GNames.Valid.mn {r : FieldNames} {q : RNames} {gn : GNames} (h : gn.Valid r q) :
    gn.mn.Valid r q := by
  refine ⟨?_, ?_⟩
  · have := h.nodup
    simp only [GNames.list, MNames.list, GNames.mn] at this ⊢
    have hs : (q.list ++ [gn.t, gn.R, gn.inB, gn.oB]).Sublist
        (q.list ++ [gn.t, gn.R, gn.inB, gn.oB, gn.z, gn.k]) :=
      List.Sublist.append_left (by simp) _
    exact this.sublist hs
  · intro x hx
    exact h.avoid x (by simp only [MNames.list, GNames.mn, List.mem_cons] at hx; simp [GNames.list]; tauto)
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] {F : FieldPresentation K}
  {r : FieldNames}
def geoCom (M : FieldMacros F r) (q : RNames) (gn : GNames) (n d : ℕ) : Com :=
  .seq (.assign gn.oB (.lit (5 + lenL n d (geoE n d))))
  (.seq (macLoop M q gn.mn n d (geoE n d))
  (.seq (constsCom r q gn.t (.lit 5) (constTbl n (d + geoE n d)) 0)
  (.seq (.assign q.N (.lit (lenL n d (geoE n d))))
  (.seq (.assign q.n (.lit (lenL n d (geoE n d))))
  (.seq (.assign q.c (.bin .mul (.var gn.R) (.lit (lenM n (geoE n d)))))
  (.seq (reduceLoop M q)
    (zeroTest M q gn.z gn.k)))))))
def geoCost (M : FieldMacros F r) (q : RNames) (gn : GNames) (n d e R : ℕ) : ℕ :=
  2 + macCost M gn.mn n d (geoE n d) R + constsCost (.lit 5) e (lenL n d (geoE n d)) + 2 + 2 + 4 +
    reduceCost M q (lenL n d (geoE n d)) (lenL n d (geoE n d)) (R * lenM n (geoE n d)) +
    zeroCost M (lenL n d (geoE n d))
def geoMoving (q : RNames) (gn : GNames) : List String :=
  [q.N, q.n, q.c, q.u, q.w, q.j, q.i, q.pv, q.f, gn.t, gn.oB, gn.z, gn.k]
theorem castLE_refl_id (N : ℕ) : (Fin.castLE (le_refl N) : Fin N → Fin N) = id := by
  funext i; rfl
theorem geo_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (gn : GNames)
    (hg : gn.Valid r q) (n d : ℕ) (vs : List (DenseInput n d K)) {B Sn iv : ℕ} {σ : Env}
    (hS : Slots F r q.WS Sn B σ) (hz : val F r q.WS σ 0 = 0)
    (hR : σ.vars gn.R = vs.length) (hi : σ.vars gn.inB = iv)
    (hlay : rowStart (lenL n d (geoE n d)) (vs.length * lenM n (geoE n d)) ≤ iv)
    (hfit : iv + vs.length * lenD n d ≤ Sn)
    (hRB : vs.length < B) (hmB : lenM n (geoE n d) < B) (hLdB : lenD n d < B)
    (hin : ∀ t (ht : t < vs.length) k (hk : k < lenD n d),
      val F r q.WS σ (iv + t * lenD n d + k) = read vs[t] ⟨k, hk⟩) :
    ∃ τ, Run B (geoCom M q gn n d) σ τ (geoCost M q gn n d F.e vs.length) ∧
      Slots F r q.WS Sn B τ ∧
      (τ.vars gn.z = 1 ↔ (geometricFeasible d vs).1 = true) ∧ τ.vars gn.z ≤ 1 ∧
      (∀ s < Sn, (s = 0 ∨ rowStart (lenL n d (geoE n d)) (vs.length * lenM n (geoE n d)) ≤ s) →
        val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ y, y ∉ regNames r → y ∉ geoMoving q gn → τ.vars y = σ.vars y) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  set E := geoE n d with hE
  set L := lenL n d E with hL
  set mc := lenM n E with hmc
  set R := vs.length with hRdef
  have hSB := hS.slots_word
  have hr0 : rowStart L 0 ≤ rowStart L (R * mc) := rowStart_mono (Nat.zero_le _)
  have hr0' : rowStart L 0 = 5 + L := by unfold rowStart; omega
  have hp2 := F.prime.two_le
  have htS : gn.t ∉ regNames r := hg.avoid _ (by simp [GNames.list])
  have hzS : gn.z ∉ regNames r := hg.avoid _ (by simp [GNames.list])
  have hkS : gn.k ∉ regNames r := hg.avoid _ (by simp [GNames.list])
  have hRS : gn.R ∉ regNames r := hg.avoid _ (by simp [GNames.list])
