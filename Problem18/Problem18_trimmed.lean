theorem sideOut_keep {n d sb : Nat} {X : Matrix (Fin d) (Fin n) K} {τ τ' : Env}
    (h : SideOut F n d sb X τ) (hk : Keep τ τ' sb (sb + F.e*sideN n d)) : SideOut F n d sb X τ' := by
  have L := fun a b c (hh : a + b ≤ c) => lay F.e sb a b c hh
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [← h.gram]; apply matrix_keep F
    exact keep_mono hk (by omega) (L _ _ _ (by simp only [tN, k2N, sideN]; omega))
  · rw [← h.trow]; apply matrix_keep F
    exact keep_mono hk (by omega) (L _ _ _ (by simp only [k2N, sideN]; omega))
  · rw [← h.ones]; apply matrix_keep F
    exact keep_mono hk (by omega) (L _ _ _ (by
      simp only [sideN, k2N, tN, gN, utN, k1N, uN, wN, sN, xN]; omega))
  · rw [← h.xt]; apply matrix_keep F
    exact keep_mono hk (by omega) (L _ _ _ (by
      simp only [sideN, k2N, tN, gN, utN, k1N, uN, wN, sN, xN, xtN]; omega))
theorem sides_run {B a b c : Nat} (A T : RectTensor a b c K) (ρ : Env)
    (hv : ValidMemory F B ρ)
    (hn : ρ.vars nR = boundaryWidth a b c) (hd : ρ.vars dR = boundaryHeight a b c)
    (he : ρ.vars eR = F.e) (hmod0 : ρ.vars canonical.modBase = 0) (hexp : ρ.vars canonical.exp < B)
    (hlen : charTwoMemLen (boundaryWidth a b c) (boundaryHeight a b c) F.e ≤ (ρ.arrs canonical.mem).length)
    (hn0 : 0 < boundaryWidth a b c) (hd0 : 0 < boundaryHeight a b c)
    (hA : GatherInput F B a b c kBank A ρ) (hT : GatherInput F B a b c tBank T ρ)
    (hWA : SideWords B (boundaryWidth a b c) (boundaryHeight a b c) F.e (F.e+1))
    (hWB : SideWords B (boundaryWidth a b c) (boundaryHeight a b c) F.e
      (F.e+1+F.e*sideN (boundaryWidth a b c) (boundaryHeight a b c)))
    (hsA : Sz.majorant sbA (boundaryWidth a b c) (boundaryHeight a b c) F.e 0 < B)
    (hsB : Sz.majorant sbB (boundaryWidth a b c) (boundaryHeight a b c) F.e 0 < B) :
    ∃ τ, Run B sides ρ τ (sidesCost F (boundaryWidth a b c) (boundaryHeight a b c) a b c) ∧
