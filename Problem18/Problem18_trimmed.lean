theorem intersection_range_finrank_eq_ker_comp
    {V W Z : Type*} [AddCommGroup V] [Module K V]
    [AddCommGroup W] [Module K W] [AddCommGroup Z] [Module K Z]
    (f : W →ₗ[K] Z) (g : V →ₗ[K] W) (hg : Function.Injective g) :
    finrank K ↥(LinearMap.range g ⊓ LinearMap.ker f) =
      finrank K (LinearMap.ker (f.comp g)) := by
  let L : LinearMap.ker (f.comp g) →ₗ[K]
      ↥(LinearMap.range g ⊓ LinearMap.ker f) :=
    { toFun := fun x => ⟨g x.val, ⟨x.val, rfl⟩, x.property⟩
      map_add' := by intros; apply Subtype.ext; exact g.map_add _ _
      map_smul' := by intros; apply Subtype.ext; exact g.map_smul _ _ }
  have hi : Function.Injective L := by
    intro x y h
    apply Subtype.ext
    apply hg
    exact congrArg Subtype.val h
  have hs : Function.Surjective L := by
    intro y
    obtain ⟨x, hx⟩ := y.property.1
    refine ⟨⟨x, ?_⟩, ?_⟩
    · change f (g x) = 0
      rw [hx]
      exact y.property.2
    · apply Subtype.ext
      exact hx
  exact (LinearEquiv.ofBijective L ⟨hi, hs⟩).finrank_eq.symm
