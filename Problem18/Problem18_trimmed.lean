  refine ⟨η.setVar q.pv (σ.vars q.pv+1),hrall,?_,by simp,?_,hprefix,
    hin1.trans hin0,hout1.trans hout0⟩
  · exact input_transport F h hslots (fun x hx=>(run_frame hrall).1 x (keep_safe x hx))
      ((run_frame hrall).2.2.1 _) ((hprefix 0 (by omega) (by decide) (by decide) (by decide)).trans h.zero)
  · have hm : Problem18IMPMatrixMemory20261001.matrix F ρ (byte F ρ (ρ.vars q.n))
        (σ.vars q.N) (σ.vars q.N)=matrix F σ (σ.vars q.N) := by
      ext i j
      rw [matrix_slot,hregs0]
      apply hvals0
      have hh:=row_entry_bound i.isLt j.isLt
      omega
    have hv : (fun j:Fin (σ.vars q.N)=>Problem18IMPMatrixMemory20261001.matrix F ρ
        (byte F ρ (ρ.vars q.i)) (σ.vars q.N) 1 j 0)=vector F σ (σ.vars q.i) (σ.vars q.N) := by
      funext j
      rw [matrix_slot,hregs0]
      simp only [Fin.val_zero,Nat.mul_one,Nat.add_zero,vector]
      exact hvals0 _ (by have hh:=j.isLt;omega)
