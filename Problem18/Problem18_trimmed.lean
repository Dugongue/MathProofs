      unfold Problem18P36LargeFirstFullExecution20261004.traceAt
        Problem18P36LargeFirstFullExecution20261004.flatIndex
        Problem18P36LargeFirstFullExecution20261004.strideAt
      rw [Lpow, d1, d2, d3]
      have eq : F.e*(t.val*(2*((a*b)*(a*b))) + s.val*(a*b) + r.val) =
          F.e*(t.val*(2*((a*b)*(a*b))) + (s.val*(a*b)+r.val)) := by ring
      rw [eq]; pomega
    refine ⟨rfl, rfl, hI, hp.gram, taddr, ?_, ?_, ?_, ?_, ?_⟩
    · intro t r s i
      have := tbound t r s i
      unfold Fits; rw [hLlen]; pomega
    · intro t r s i z
      have := tbound t r s i
      have hz := z.isLt
      refine ⟨Or.inl ?_, Or.inl ?_⟩
      · rw [Lfam]; pomega
      · rw [Lscr]; pomega
    · unfold Fits Problem18P36LargeFirstFullExecution20261004.oneAt; rw [Lone, hLlen]; pomega
    · intro z
      have hz := z.isLt
      unfold Problem18P36LargeFirstFullExecution20261004.oneAt
      refine ⟨Or.inl ?_, Or.inl ?_⟩
      · rw [Lone, Lfam]; pomega
      · rw [Lone, Lscr]; pomega
    · unfold Problem18P36LargeFirstFullExecution20261004.oneAt
      rw [Lone, ← hp.one]
      apply congrArg (decode F)
      funext z
      unfold slice
      rw [Larr]
      have hz := z.isLt
      apply hmem _ (by rw [hlenτ]; pomega)
      unfold Problem18P36LargeFirstFullExecution20261004.PowerOutside
        Problem18P36LargeFirstLayout20261003.blockWords
