  refine ⟨τ,hrun,hacc,?_,hg.valid,hg.slots,hg.ws_eq,hg.mod_eq,hzero,hg.frame,?_,hg.arrays,
    hg.lengths,hg.inp,hg.out⟩
  · apply matrix_of_cells
