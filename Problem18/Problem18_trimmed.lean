  apply Mathproof.Problem18EulerProductBounds20260930.finite_product_lower_sum36
    Finset.univ (fun i : FactorIndex f.val => ((Nat.card K:ℝ)^i.val.natDegree)⁻¹)
  · intro i _; positivity
  · intro i _
    have hq : (2:ℝ)≤Nat.card K := by exact_mod_cast (show 2≤Nat.card K from Finite.one_lt_card)
    have hd : (1 : ℕ) ≤ (i.val : K[X]).natDegree := (factor_irreducible f.val i).natDegree_pos
    have hp : (2:ℝ)≤(Nat.card K:ℝ)^i.val.natDegree :=
      hq.trans (le_self_pow₀ (by linarith) (by omega))
    simpa only [one_div] using one_div_le_one_div_of_le (by norm_num : (0:ℝ)<2) hp
  · exact hY
