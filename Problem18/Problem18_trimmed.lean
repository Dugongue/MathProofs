variable {K : Type*} [Field K] [Fintype K]
noncomputable def representativeUnit (c : SquareClass K) : Kˣ := Quotient.out c
@[simp] theorem representativeUnit_class (c : SquareClass K) :
    squareClass K (representativeUnit c)=c := Quotient.out_eq' c
noncomputable def modelCoefficients (n : ℕ) (c : SquareClass K) : Fin (n+1) → K :=
  Fin.cons (representativeUnit c : K) (fun _ => 1)
noncomputable def modelForm (n : ℕ) (c : SquareClass K) :
    LinearMap.BilinForm K (Fin (n+1) → K) := diagonalForm (modelCoefficients n c)
theorem modelCoefficients_nonzero (n : ℕ) (c : SquareClass K) :
    ∀ j,modelCoefficients n c j≠0 := by
  intro j
  cases j using Fin.cases
  · exact (representativeUnit c).ne_zero
  · exact one_ne_zero
theorem modelForm_symmetric (n : ℕ) (c : SquareClass K) : (modelForm n c).IsSymm :=
  diagonalForm_symmetric _
theorem modelForm_nondegenerate (n : ℕ) (c : SquareClass K) : (modelForm n c).Nondegenerate :=
  diagonalForm_nondegenerate _ (modelCoefficients_nonzero n c)
theorem modelForm_determinantClass (n : ℕ) (c : SquareClass K) :
    determinantClass (modelForm n c) (modelForm_nondegenerate n c)
