  · intro s hs hsTail hsBank hsg hsd
    rw [val_setVar F canonical (by decide : q.n≠q.WS),hquotmem s hs hsBank hsg,hvals₃,hm s hs hsTail hsd]
  · intro x hx hxq hxci hxc hxt
