variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V]
noncomputable def finAddCoordinateEquiv (k z : ℕ) :
    (Fin (k + z) → K) ≃ₗ[K] (Fin k → K) × (Fin z → K) where
  toFun a := (fun i => a (Fin.castAdd z i), fun l => a (Fin.natAdd k l))
  invFun p := Fin.addCases p.1 p.2
  left_inv a := by
    funext c
    refine Fin.addCases (fun i => ?_) (fun l => ?_) c <;> simp
  right_inv p := by
    apply Prod.ext <;> funext i <;> simp
  map_add' x y := by
    apply Prod.ext <;> funext i <;> rfl
  map_smul' a x := by
    apply Prod.ext <;> funext i <;> rfl
noncomputable def finBasisFunEquiv (W : Submodule K V) :
    (Fin (finrank K W) → K) ≃ₗ[K] W :=
  (Finsupp.linearEquivFunOnFinite K K (Fin (finrank K W))).symm.trans
    (Module.finBasis K W).repr.symm
theorem exists_adaptedCoordinateMap
    (B : LinearMap.BilinForm K V) (W C : Submodule K V)
    (hCO : C ≤ B.orthogonal W) (hWC : Disjoint W C) :
    ∃ E :
        (Fin (finrank K W + finrank K C) → K) →ₗ[K] V,
      Function.Injective E ∧
      (∀ i, leftTestVector E i ∈ W) ∧
      (∀ l, RightOrthogonalTo B W (rightTestVector E l)) := by
  let split := finAddCoordinateEquiv (K := K) (finrank K W) (finrank K C)
  let bases :
      ((Fin (finrank K W) → K) × (Fin (finrank K C) → K)) ≃ₗ[K] W × C :=
    (finBasisFunEquiv W).prodCongr (finBasisFunEquiv C)
  let E :
      (Fin (finrank K W + finrank K C) → K) →ₗ[K] V :=
    (W.subtype.coprod C.subtype).comp
      (bases.toLinearMap.comp split.toLinearMap)
  refine ⟨E, ?_, ?_, ?_⟩
  · exact (subtype_coprod_injective hWC).comp
      (bases.injective.comp split.injective)
  · intro i
    have hsplit :
        split (Pi.single (Fin.castAdd (finrank K C) i) 1) =
          (Pi.single i 1, 0) := by
      apply Prod.ext
      · funext j
        simp [split, finAddCoordinateEquiv, Pi.single_apply]
      · funext j
        have hne :
            Fin.natAdd (finrank K W) j ≠
              Fin.castAdd (finrank K C) i := by
          intro h
          have hv := congrArg Fin.val h
          simp only [Fin.val_natAdd, Fin.val_castAdd] at hv
          omega
        simp [split, finAddCoordinateEquiv, Pi.single_apply, hne]
    have hi :
        leftTestVector E i =
          W.subtype (finBasisFunEquiv W (Pi.single i 1)) := by
      simp [leftTestVector, E, bases, hsplit, LinearMap.coprod_apply]
    rw [hi]
    exact (finBasisFunEquiv W (Pi.single i 1)).property
  · intro l
    have hsplit :
        split (Pi.single (Fin.natAdd (finrank K W) l) 1) =
          (0, Pi.single l 1) := by
      apply Prod.ext
      · funext j
        have hne :
            Fin.castAdd (finrank K C) j ≠
              Fin.natAdd (finrank K W) l := by
          intro h
