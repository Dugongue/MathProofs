      simp only [mul_zero, zero_smul, add_zero, mul_one]
      have : c * ((c - 1) / c - 1) = -1 := by field_simp; ring
      rw [smul_add, smul_smul, this]
      module
  · obtain ⟨w, hwT, hwa⟩ := exists_sep hnd hmem
    have hwS : ∀ s ∈ S, B w s = 0 := fun s hs =>
      hwT s (Submodule.mem_sup_left hs)
    have hwz : B w z = 0 :=
      hwT z (Submodule.mem_sup_right (Submodule.mem_span_singleton_self z))
    have hzw : B z w = 0 := by rw [hsym]; exact hwz
    refine ⟨_, eichler_isom B hsym z w hzz hzw, ?_, ?_⟩
    · intro s hs
      simp [eichler_apply, hwS s hs, hzS s hs]
    · simp only [eichler_apply, hza0, hwa]
      rw [hb']
      simp
theorem extend_family (hsym : ∀ x y, B x y = B y x) (hnd : B.Nondegenerate)
    (hR : ∀ v, (∀ w, B w v = 0) → v = 0) :
    ∀ (n : ℕ) (x y : Fin n → V), LinearIndependent K x → LinearIndependent K y →
      (∀ i j, B (x i) (x j) = B (y i) (y j)) →
      ∃ Q : V →ₗ[K] V, (∀ v w, B (Q v) (Q w) = B v w) ∧ ∀ i, Q (x i) = y i := by
  intro n
  induction n with
  | zero =>
    intro x y _ _ _
    exact ⟨LinearMap.id, fun _ _ => rfl, fun i => i.elim0⟩
  | succ n ih =>
    intro x y hx hy hg
    have hx' := (linearIndependent_finCons (x := x 0) (v := Fin.tail x)).1
      (by rwa [Fin.cons_self_tail])
    have hy' := (linearIndependent_finCons (x := y 0) (v := Fin.tail y)).1
      (by rwa [Fin.cons_self_tail])
    obtain ⟨ρ, hρ, hρx⟩ := ih (Fin.tail x) (Fin.tail y) hx'.1 hy'.1
      (fun i j => hg i.succ j.succ)
    have hρinj := injective_of_isom hR hρ
    set S := span K (Set.range (Fin.tail y)) with hSdef
    have hSeq : S = (span K (Set.range (Fin.tail x))).map ρ := by
      have hfun : (ρ ∘ Fin.tail x) = Fin.tail y := funext hρx
      rw [Submodule.map_span, ← Set.range_comp, hfun]
    have ha : ρ (x 0) ∉ S := by
      rw [hSeq]
      rintro ⟨v, hv, hve⟩
      exact hx'.2 (hρinj hve ▸ hv)
    have hq : B (ρ (x 0)) (ρ (x 0)) = B (y 0) (y 0) := by rw [hρ]; exact hg 0 0
    have hS : ∀ s ∈ S, B (ρ (x 0)) s = B (y 0) s := by
      have hle : S ≤ LinearMap.ker (B (ρ (x 0)) - B (y 0)) := by
        rw [hSdef, Submodule.span_le]
        rintro _ ⟨i, rfl⟩
        simp only [SetLike.mem_coe, LinearMap.mem_ker, LinearMap.sub_apply]
        rw [sub_eq_zero]
        conv_lhs => rw [← hρx i, hρ]
        exact hg 0 i.succ
      intro s hs
      exact sub_eq_zero.1 (LinearMap.mem_ker.1 (hle hs))
    obtain ⟨τ, hτ, hτS, hτa⟩ := step hsym hnd S _ _ ha hy'.2 hq hS
    refine ⟨τ ∘ₗ ρ, fun v w => by simp only [LinearMap.comp_apply, hτ, hρ], ?_⟩
    intro i
    refine Fin.cases ?_ (fun i => ?_) i
    · simpa using hτa
    · simp only [LinearMap.comp_apply]
      have := hρx i
      simp only [Fin.tail] at this
      rw [this]
      exact hτS _ (subset_span ⟨i, rfl⟩)
theorem witt_extension (B : LinearMap.BilinForm K V) (hsym : ∀ x y, B x y = B y x)
    (hrad : B.orthogonal ⊤ = ⊥) (_hrad' : B.orthogonal ⊤ = ⊥)
    (U W : Submodule K V) (e : U ≃ₗ[K] W)
    (he : ∀ u v : U, B (e u) (e v) = B u v) :
    ∃ Q : V ≃ₗ[K] V, (∀ v w, B (Q v) (Q w) = B v w) ∧ ∀ u : U, Q u = e u := by
  have hR : ∀ v, (∀ w, B w v = 0) → v = 0 := by
    intro v hv
    have : v ∈ B.orthogonal ⊤ := fun n _ => hv n
    rw [hrad] at this
    exact (Submodule.mem_bot K).1 this
  have hnd : B.Nondegenerate :=
    ⟨fun v hv => hR v (fun w => by rw [hsym]; exact hv w), fun v hv => hR v hv⟩
  let b := Module.finBasis K U
  have hx : LinearIndependent K (fun i => (b i : V)) :=
    b.linearIndependent.map' U.subtype U.ker_subtype
  have hy : LinearIndependent K (fun i => (e (b i) : V)) :=
    (b.linearIndependent.map' e.toLinearMap e.ker).map' W.subtype W.ker_subtype
  obtain ⟨Q₀, hQ₀, hQx⟩ := extend_family hsym hnd hR _ _ _ hx hy
    (fun i j => (he (b i) (b j)).symm)
  refine ⟨LinearEquiv.ofInjectiveEndo Q₀ (injective_of_isom hR hQ₀), hQ₀, ?_⟩
  have hcomp : Q₀ ∘ₗ U.subtype = W.subtype ∘ₗ e.toLinearMap :=
    b.ext (fun i => hQx i)
  intro u
  exact LinearMap.congr_fun hcomp u
end Problem18OwnWitt20261004
end
