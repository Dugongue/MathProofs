open Classical
open scoped BigOperators
variable {K : Type*} [Field K] [Fintype K] [CharP K 2]
abbrev UnitSphere (n : ℕ) := {v : Fin n → K // ∑ i,(v i)^2=1}
theorem unit_iff_sum_eq_one {n : ℕ} (v : Fin n → K) :
    (∑ i,(v i)^2=1) ↔ ∑ i,v i=1 := by
  rw [← CharTwo.sum_sq]
  constructor
  · intro h
    have hs : (∑ i,v i)^2=(1:K)^2 := by simpa using h
    rcases sq_eq_sq_iff_eq_or_eq_neg.mp hs with he | he
    · exact he
    · simpa only [CharTwo.neg_eq] using he
  · intro h; simp [h]
noncomputable def unitSphereEquiv (n : ℕ) : UnitSphere (K := K) (n+1) ≃ (Fin n → K) where
  toFun v := Fin.tail v.val
  invFun w := ⟨Fin.cons (1-∑ i,w i) w,by
    apply (unit_iff_sum_eq_one _).mpr
    simp only [Fin.sum_univ_succ,Fin.cons_zero,Fin.cons_succ]
    exact sub_add_cancel _ _⟩
  left_inv v := by
    apply Subtype.ext
    funext i
    refine Fin.cases ?_ (fun j => ?_) i
    · have h := (unit_iff_sum_eq_one v.val).mp v.property
      rw [Fin.sum_univ_succ] at h
      exact (eq_sub_iff_add_eq.mpr h).symm
    · rfl
  right_inv w := rfl
theorem unit_sphere_card (n : ℕ) : Nat.card (UnitSphere (K := K) (n+1))=Nat.card K^n := by
  rw [Nat.card_congr (unitSphereEquiv (K := K) n)]
  simp only [Nat.card_eq_fintype_card,Fintype.card_fun,Fintype.card_fin]
theorem canonical_mem_iff (n : ℕ) : (∑ _i : Fin n,(1:K)^2=1) ↔ Odd n := by
  simp only [one_pow,Finset.sum_const,Finset.card_univ,Fintype.card_fin,nsmul_eq_mul,mul_one]
  rcases Nat.even_or_odd n with he | ho
  · simp [CharTwo.natCast_eq_ite,he,Nat.not_odd_iff_even.mpr he]
  · simp [CharTwo.natCast_eq_ite,Nat.not_even_iff_odd.mpr ho,ho]
theorem noncanonical_unit_sphere_card (n : ℕ) :
    Nat.card {v : Fin (n+1) → K // (∑ i,(v i)^2=1) ∧ v ≠ fun _ => 1} =
      Nat.card K^n - (if Odd (n+1) then 1 else 0) := by
  let S := Finset.univ.filter (fun v : Fin (n+1) → K => ∑ i,(v i)^2=1)
  have hcard : S.card=Nat.card K^n := by
    simpa only [UnitSphere,Nat.card_eq_fintype_card,Fintype.card_subtype,S] using unit_sphere_card (K := K) n
  have he : (Finset.univ.filter (fun v : Fin (n+1) → K =>
      (∑ i,(v i)^2=1) ∧ v ≠ fun _ => 1))=S.erase (fun _ => 1) := by
    ext v
    simp only [Finset.mem_filter,Finset.mem_univ,true_and,Finset.mem_erase,S]
    tauto
  rw [Nat.card_eq_fintype_card,Fintype.card_subtype,he]
  by_cases ho : Odd (n+1)
  · have hm : (fun _ : Fin (n+1) => (1:K)) ∈ S := by
      simp only [S,Finset.mem_filter,Finset.mem_univ,true_and]
      exact (canonical_mem_iff (K := K) (n+1)).mpr ho
    rw [Finset.card_erase_of_mem hm,hcard,if_pos ho]
  · have hm : (fun _ : Fin (n+1) => (1:K)) ∉ S := by
      simp only [S,Finset.mem_filter,Finset.mem_univ,true_and]
      exact fun h => ho ((canonical_mem_iff (K := K) (n+1)).mp h)
    rw [Finset.erase_eq_of_notMem hm,hcard,if_neg ho,Nat.sub_zero]
end
end Mathproof.Problem18CharTwoSphereCard20260930
