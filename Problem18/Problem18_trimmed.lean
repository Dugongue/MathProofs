theorem restricted_replacement_le
    {Ω G : Type*} [Fintype Ω] [Nonempty Ω] [Fintype G] [Nonempty G]
    {V : Ω → Type*} [∀ x, Fintype (V x)] [∀ x, Nonempty (V x)]
    (P : ∀ x, V x → G) (A : Ω → Finset G) (S : Finset Ω) :
    (∑ x ∈ S, ((Finset.univ.filter (fun y => P x y ∈ A x)).card : ℝ) /
      Fintype.card (V x)) / Fintype.card Ω ≤
    (∑ x, ((A x).card : ℝ) / Fintype.card G) / Fintype.card Ω +
    (∑ x, (∑ y, ‖uniformImageWeight (P x) y -
      (Fintype.card G : ℂ)⁻¹‖) / 2) / Fintype.card Ω := by
  let u : Ω → ℝ := fun x => (A x).card / (Fintype.card G : ℝ)
  let t : Ω → ℝ := fun x =>
    (∑ y, ‖uniformImageWeight (P x) y - (Fintype.card G : ℂ)⁻¹‖) / 2
  have hp (x : Ω) := uniform_image_event_probability_bound (P x) (A x)
  have hnon (x : Ω) : 0 ≤ u x + t x := by dsimp [u, t]; positivity
  have hs : (∑ x ∈ S,
      ((Finset.univ.filter (fun y => P x y ∈ A x)).card : ℝ) /
        Fintype.card (V x)) ≤ ∑ x, (u x + t x) := by
    calc
      _ ≤ ∑ x ∈ S, (u x + t x) := Finset.sum_le_sum (fun x _ => hp x)
      _ ≤ ∑ x, (u x + t x) :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ S)
          (fun x _ _ => hnon x)
  calc
    _ ≤ (∑ x, (u x + t x)) / Fintype.card Ω :=
      div_le_div_of_nonneg_right hs (by positivity)
    _ = _ := by rw [Finset.sum_add_distrib, add_div]
theorem restricted_sum_replacement_le_sqrt
    {Ω G : Type*} [Fintype Ω] [Nonempty Ω] [DecidableEq Ω]
    [AddCommGroup G] [Fintype G]
    {V : Ω → Type*} [∀ x, Fintype (V x)] [∀ x, Nonempty (V x)]
    (P : ∀ x, V x → G) (m : ℕ) (A : Ω → Finset G) (S : Finset Ω)
    (E : ℝ) (hE : 0 ≤ E)
    (henergy :
      (∑ x, ∑ χ : AddChar G ℂ, if χ = 1 then 0 else
        (‖(∑ y : V x, χ (P x y)) / (Fintype.card (V x) : ℂ)‖^2)^m) /
        (Fintype.card Ω : ℝ) ≤ E) :
    (∑ x ∈ S, ((Finset.univ.filter
        (fun y : Fin m → V x => (∑ j, P x (y j)) ∈ A x)).card : ℝ) /
      Fintype.card (Fin m → V x)) / Fintype.card Ω ≤
    (∑ x, ((A x).card : ℝ) / Fintype.card G) / Fintype.card Ω +
      Real.sqrt (E / 4) := by
  exact (restricted_replacement_le (fun x (y : Fin m → V x) => ∑ j, P x (y j))
    A S).trans (add_le_add_right
      (averaged_uniform_sum_variation_le P m E hE henergy) _)
end Mathproof.Problem18SelectionSafeAssembly20260930
