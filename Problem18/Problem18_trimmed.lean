    intro x hx
    funext i
    have hz : c i*x i=0 := (traceForm_nondegenerate K (AdjoinRoot (g i))).1 _ (by
      intro y
      have hh := hx (Pi.single i y)
      simpa only [modelTraceForm_single_right,Algebra.traceForm_apply] using hh)
    exact (mul_eq_zero.mp hz).resolve_left (hc i)
  refine ⟨hl,?_⟩
  intro y hy
  apply hl
  intro x
  rw [(modelTraceForm_symmetric g c).eq]
  exact hy x
theorem modelTraceForm_nonalternating [CharP K 2] [Nonempty ι]
    (c : ∀ i,AdjoinRoot (g i)) (hc : ∀ i,c i≠0) : ¬(modelTraceForm g c).IsAlt := by
  classical
  let i : ι := Classical.choice inferInstance
  letI : Finite (AdjoinRoot (g i)) := Finite.of_injective
    (Module.finBasis K (AdjoinRoot (g i))).equivFun
    (Module.finBasis K (AdjoinRoot (g i))).equivFun.injective
  letI : CharP (AdjoinRoot (g i)) 2 :=
    charP_of_injective_algebraMap (algebraMap K (AdjoinRoot (g i))).injective 2
  intro ha
  apply Mathproof.Problem18PrimaryNonalternating20260930.scalarTraceForm_not_alternating (K:=K) (c i) (hc i)
  intro x
  have hh := ha (Pi.single i x)
  simpa only [modelTraceForm_single_right,Pi.single_eq_same,scalarTraceForm_apply] using hh
theorem modelTraceForm_selfAdjoint (c : ∀ i,AdjoinRoot (g i))
    (x y : ∀ i,AdjoinRoot (g i)) :
    modelTraceForm g c (modelOperator g x) y=modelTraceForm g c x (modelOperator g y) := by
  simp only [modelTraceForm_apply]
  apply Finset.sum_congr rfl
  intro i _
  change Algebra.trace K (AdjoinRoot (g i)) (c i*(AdjoinRoot.root (g i)*x i)*y i)=
    Algebra.trace K (AdjoinRoot (g i)) (c i*x i*(AdjoinRoot.root (g i)*y i))
  congr 1
  ring
end
