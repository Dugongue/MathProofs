variable {K E : Type*} [Field K] [Fintype K] [Field E] [Fintype E]
  [Algebra K E] [FiniteDimensional K E]
theorem stable_fraction_high_rank {n r s : ℕ}
    [Module E (Fin n → K)] [IsScalarTower K E (Fin n → K)]
    (he : 2 ≤ Module.finrank K E) (hrn : 2*r ≤ n) (hrs : r ≤ 2*s) (hsr : s ≤ r) :
    (Nat.card {W : Submodule K (Fin n → K) //
      Module.finrank K W=s ∧ ExtensionStable (E := E) W} : ℝ) /
      Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W=s} ≤
    16*((Fintype.card K : ℝ)^(n*r/8))⁻¹ := by
  classical
  letI : FiniteDimensional E (Fin n → K) :=
    Module.Finite.of_restrictScalars_finite K E _
  by_cases hne : Nonempty {W : Submodule K (Fin n → K) //
      Module.finrank K W=s ∧ ExtensionStable (E := E) W}
  · let W := hne.some
    let U := extendStable W.val W.property.2
    let e := Module.finrank K E
    let d := Module.finrank E (Fin n → K)
    let t := Module.finrank E U
    have hs : s=e*t := W.property.1.symm.trans (stable_finrank W.val W.property.2)
    have hn : n=e*d := by
      simpa only [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] using
        (Module.finrank_mul_finrank K E (Fin n → K)).symm
    have ht : t ≤ d := U.finrank_le
    have hb := stable_subspace_fraction_le (K := K) (E := E) (V := Fin n → K) t ht
    have hc : Nat.card {W : Submodule K (Fin n → K) //
        Module.finrank K W=s ∧ ExtensionStable (E := E) W} =
      Nat.card {W : Submodule K (Fin n → K) //
        ExtensionStable (E := E) W ∧ Module.finrank K W=e*t} := by
      apply Nat.card_congr (Equiv.subtypeEquivRight _)
      intro W
      rw [hs, and_comm]
    rw [hc, hs]
    apply hb.trans
    have hns : n-s=e*(d-t) := by rw [hn, hs, Nat.mul_sub_left_distrib]
    have h1 : n ≤ 2*(n-s) := by omega
    have hm := Nat.mul_le_mul h1 hrs
    have h2 : e ≤ 2*(e-1) := by dsimp [e]; omega
    have hp := Nat.mul_le_mul_right (e*t*(d-t)) h2
    have hexp : n*r/8 ≤ e*(e-1)*t*(d-t) := by
      apply Nat.div_le_of_le_mul
      have hh : s*(n-s) ≤ 2*(e*(e-1)*t*(d-t)) := by
        rw [hns,hs]
        nlinarith only [hp]
      nlinarith only [hm,hh]
    have hq : (1 : ℝ) ≤ Fintype.card K := by exact_mod_cast (Nat.one_le_of_lt Fintype.one_lt_card)
    apply mul_le_mul_of_nonneg_left _ (by norm_num)
    exact inv_anti₀ (by positivity) (pow_le_pow_right₀ hq hexp)
  · letI : IsEmpty {W : Submodule K (Fin n → K) //
      Module.finrank K W=s ∧ ExtensionStable (E := E) W} := not_nonempty_iff.mp hne
    simp only [Nat.card_eq_fintype_card, Fintype.card_eq_zero, Nat.cast_zero, zero_div]
    positivity
noncomputable def eventFibersEquiv {Ω I : Type*} (f : Ω → I) (P : Ω → Prop) :
    {x : Ω // P x} ≃ ((i : I) × {x : Ω // f x=i ∧ P x}) where
  toFun x := ⟨f x.val, ⟨x.val, rfl, x.property⟩⟩
  invFun z := ⟨z.2.val, z.2.property.2⟩
  left_inv x := rfl
  right_inv z := by rcases z with ⟨i,⟨x,hx,hP⟩⟩; subst i; rfl
open Classical in
theorem event_card_sum {Ω I : Type*} [Finite Ω] [Fintype I]
    (f : Ω → I) (P : Ω → Prop) :
    (Nat.card {x : Ω // P x} : ℝ) = ∑ i : I, (Nat.card {x : Ω // f x=i ∧ P x} : ℝ) := by
  rw [Nat.card_congr (eventFibersEquiv f P), Nat.card_sigma, Nat.cast_sum]
theorem high_rank_stable_card_le {n r : ℕ}
    [Module E (Fin n → K)] [IsScalarTower K E (Fin n → K)]
    {Ω : Type*} [Fintype Ω] (f : Ω → Submodule K (Fin n → K))
    (hrank : ∀ x, Module.finrank K (f x) ≤ r)
    (hf : ∀ W W' : Submodule K (Fin n → K), Module.finrank K W=Module.finrank K W' →
      Nat.card {x : Ω // f x=W}=Nat.card {x : Ω // f x=W'})
    (he : 2 ≤ Module.finrank K E) (hrn : 2*r ≤ n) :
    (Nat.card {x : Ω // r ≤ 2*Module.finrank K (f x) ∧ ExtensionStable (E := E) (f x)} : ℝ) ≤
      16*((Fintype.card K : ℝ)^(n*r/8))⁻¹*Fintype.card Ω := by
  classical
  let d : Ω → Fin (r+1) := fun x => ⟨Module.finrank K (f x), by have := hrank x; omega⟩
  let P : Ω → Prop := fun x => r ≤ 2*Module.finrank K (f x) ∧ ExtensionStable (E := E) (f x)
  let ε : ℝ := 16*((Fintype.card K : ℝ)^(n*r/8))⁻¹
  have hterm (i : Fin (r+1)) :
      (Nat.card {x : Ω // d x=i ∧ P x} : ℝ) ≤ ε*Nat.card {x : Ω // d x=i} := by
    by_cases hi : r ≤ 2*i.val
    · have heq : Nat.card {x : Ω // d x=i ∧ P x} =
        Nat.card {x : Ω // Module.finrank K (f x)=i.val ∧ ExtensionStable (E := E) (f x)} := by
        apply Nat.card_congr (Equiv.subtypeEquivRight _)
        intro x
        simp only [P, d, Fin.ext_iff]
        constructor
        · intro h; exact ⟨h.1,h.2.2⟩
        · intro h; exact ⟨h.1,by omega,h.2⟩
      rw [heq, stratum_event_card_factor f (fun W => Module.finrank K W=i.val)
        (ExtensionStable (E := E)) (fun W W' hW hW' => hf W W' (hW.trans hW'.symm))]
      have hb := stable_fraction_high_rank (K := K) (E := E) he hrn hi (Nat.le_of_lt_succ i.isLt)
      have hc : Nat.card {x : Ω // Module.finrank K (f x)=i.val} = Nat.card {x : Ω // d x=i} := by
        apply Nat.card_congr (Equiv.subtypeEquivRight _)
        intro x
        change (d x).val=i.val ↔ d x=i
        exact Fin.ext_iff.symm
      rw [hc, mul_comm]
      exact mul_le_mul_of_nonneg_right hb (by positivity)
    · have hz : IsEmpty {x : Ω // d x=i ∧ P x} := ⟨fun x => by
        have hd : Module.finrank K (f x.val)=i.val := congrArg Fin.val x.property.1
        exact hi (by rw [← hd]; exact x.property.2.1)⟩
      letI := hz
      simp only [Nat.card_eq_fintype_card, Fintype.card_eq_zero, Nat.cast_zero]
      positivity
  rw [event_card_sum d P]
  calc
    _ ≤ ∑ i : Fin (r+1), ε*Nat.card {x : Ω // d x=i} := Finset.sum_le_sum (fun i _ => hterm i)
    _ = ε*(Fintype.card Ω) := by
      rw [← Finset.mul_sum]
      have hc := event_card_sum d (fun _ => True)
      simp only [and_true, Nat.card_eq_fintype_card, Fintype.card_subtype_true] at hc
      simpa only [Nat.card_eq_fintype_card] using congrArg (fun z : ℝ => ε*z) hc.symm
theorem stable_image_probability_le {n r : ℕ}
    [Module E (Fin n → K)] [IsScalarTower K E (Fin n → K)]
    {Ω : Type*} [Fintype Ω] [Nonempty Ω] (f : Ω → Submodule K (Fin n → K))
    (hrank : ∀ x, Module.finrank K (f x) ≤ r)
    (hf : ∀ W W' : Submodule K (Fin n → K), Module.finrank K W=Module.finrank K W' →
      Nat.card {x : Ω // f x=W}=Nat.card {x : Ω // f x=W'})
    (he : 2 ≤ Module.finrank K E) (hrn : 2*r ≤ n) (L : ℝ)
    (hL : (Nat.card {x : Ω // 2*Module.finrank K (f x)< r} : ℝ)/Fintype.card Ω ≤ L) :
    (Nat.card {x : Ω // ExtensionStable (E := E) (f x)} : ℝ)/Fintype.card Ω ≤
