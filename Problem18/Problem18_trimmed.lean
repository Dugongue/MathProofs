    (hcard : Nat.card K=Nat.card F^2)
    (hstar : ∀ x : K,star x=x^Nat.card F) (n : ℕ) :
    Nat.card (Matrix.unitaryGroup (Fin (n+1)) K)=
      Nat.card (UnitSphere (K := K) (n+1))*Nat.card (Matrix.unitaryGroup (Fin n) K) := by
  classical
