variable {K : Type*} [Field K]
abbrev SymMat (n : ℕ) (K : Type*) [Field K] :=
  {A : Matrix (Fin n) (Fin n) K // A.IsSymm}
theorem finite_field_subspace_count_bound_four [Fintype K] (n k : ℕ)
    (hk : k ≤ n) :
    (Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = k} : ℝ) ≤
      4 * (Fintype.card K : ℝ) ^ (k * (n - k)) :=
  Mathproof.Problem18Grassmann20260929.subspace_card_bound n k hk
theorem subspace_matrix_retraction_narrow {n r : ℕ}
    (W : Submodule K (Fin n → K)) (hW : Module.finrank K W = r) :
    ∃ (X : Matrix (Fin n) (Fin r) K) (E : Matrix (Fin r) (Fin n) K),
      ∀ v ∈ W, X *ᵥ (E *ᵥ v) = v := by
  classical
  let b := Module.finBasisOfFinrankEq K W hW
  obtain ⟨p, hp⟩ := W.subtype.exists_leftInverse_of_injective W.ker_subtype
  let x := W.subtype.comp b.equivFun.symm.toLinearMap
  let e := b.equivFun.toLinearMap.comp p
  refine ⟨x.toMatrix', e.toMatrix', ?_⟩
  intro v hv
  simp only [LinearMap.toMatrix'_mulVec]
  change ((b.equivFun.symm (b.equivFun (p v)) : W) : Fin n → K) = v
  rw [b.equivFun.symm_apply_apply]
  have hh := LinearMap.congr_fun hp (⟨v, hv⟩ : W)
  exact congrArg Subtype.val hh
theorem symmetric_image_card_le [Fintype K] {n r : ℕ}
    (W : Submodule K (Fin n → K)) (hW : Module.finrank K W = r) :
    Nat.card {A : SymMat n K // LinearMap.range A.val.mulVecLin ≤ W} ≤
      Nat.card (SymMat r K) := by
  classical
  obtain ⟨X, E, hXE⟩ := subspace_matrix_retraction_narrow W hW
  let S := {A : SymMat n K // LinearMap.range A.val.mulVecLin ≤ W}
  have hleft (A : S) : X * E * A.val.val = A.val.val := by
    apply Matrix.toLin'.injective
    apply LinearMap.ext
    intro v
    change (X * E * A.val.val) *ᵥ v = A.val.val *ᵥ v
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
    exact hXE _ (A.property ⟨v, rfl⟩)
  have hrec (A : S) : X * (E * A.val.val * Eᵀ) * Xᵀ = A.val.val := by
    have ha : A.val.valᵀ = A.val.val := A.val.property.eq
    have hr := congrArg Matrix.transpose (hleft A)
    simp only [Matrix.transpose_mul, ha] at hr
    calc
      _ = (X * E * A.val.val) * Eᵀ * Xᵀ := by simp only [Matrix.mul_assoc]
      _ = A.val.val * Eᵀ * Xᵀ := by rw [hleft A]
      _ = A.val.val := by simpa only [Matrix.mul_assoc] using hr
  let f : S → SymMat r K := fun A =>
    ⟨E * A.val.val * Eᵀ, by
      change (E * A.val.val * Eᵀ)ᵀ = E * A.val.val * Eᵀ
      simp only [Matrix.transpose_mul, Matrix.transpose_transpose,
        A.val.property.eq, Matrix.mul_assoc]⟩
