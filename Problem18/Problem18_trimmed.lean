  have cq := hl6 a.ci (by simp [AMNames.list])
  have dq := hl6 a.d (by simp [AMNames.list])
  have Nq := hl6 a.N (by simp [AMNames.list])
  have sq := hl6 a.src (by simp [AMNames.list])
  have oq := hl6 a.out (by simp [AMNames.list])
  have dS : a.d ∉ regNames r := (mem _ (by simp [AMNames.list])).1
  have NS : a.N ∉ regNames r := (mem _ (by simp [AMNames.list])).1
  have sS : a.src ∉ regNames r := (mem _ (by simp [AMNames.list])).1
  have oS : a.out ∉ regNames r := (mem _ (by simp [AMNames.list])).1
  have kc : a.k ≠ a.ci := ha.ne_of (by intro h; simp [AMNames.list, h])
  have ok : a.out ≠ a.k := ha.ne_of (by intro h; simp [AMNames.list, h])
