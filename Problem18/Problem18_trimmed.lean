theorem boxPoly_read_valid {n d : ℕ} (v : DenseInput n d K) (f : MvPolynomial (Fin n) K)
    (hv : ValidDenseInput d v f) : boxPoly n d (read v) = f := by
  have hread : read v = fun j => coeff ((boundedExponents n d)[j.val]) f := by
    funext j
    exact hv.2 j
  rw [hread]
  exact boxPoly_coeffs n d f fun _ ha => bounded_support_mem f hv.1 ha
theorem forall2_mem {n d : ℕ} {rows : List (DenseInput n d K)} {fs : List (MvPolynomial (Fin n) K)}
    (h : List.Forall₂ (ValidDenseInput d) rows fs) :
    ∀ f, f ∈ fs ↔ ∃ v ∈ rows, boxPoly n d (read v) = f := by
  induction h with
  | nil => simp
  | cons hv _ ih =>
    intro f
    simp only [List.mem_cons, exists_eq_or_imp, ih]
