theorem adapted_apply (x : (Fin d⊕Fin l)→K) :
    adaptedEquiv W hc f g x=(f (x∘Sum.inl)).val+(g (x∘Sum.inr)).val := rfl
def E : Matrix (Fin c) (Fin d⊕Fin l) K := (adaptedEquiv W hc f g).toLinearMap.toMatrix'
def U : Matrix (Fin d⊕Fin l) (Fin c) K := (adaptedEquiv W hc f g).symm.toLinearMap.toMatrix'
theorem inverse_left : U W hc f g*E W hc f g=1 := by
  rw [U,E,←LinearMap.toMatrix'_comp]
  have hh : (adaptedEquiv W hc f g).symm.toLinearMap.comp (adaptedEquiv W hc f g).toLinearMap=LinearMap.id := by
    ext x; simp
  rw [hh,LinearMap.toMatrix'_id]
theorem inverse_right : E W hc f g*U W hc f g=1 := by
  rw [U,E,←LinearMap.toMatrix'_comp]
  have hh : (adaptedEquiv W hc f g).toLinearMap.comp (adaptedEquiv W hc f g).symm.toLinearMap=LinearMap.id := by
    ext x; simp
  rw [hh,LinearMap.toMatrix'_id]
theorem adapted_gram (B : Matrix (Fin d) (Fin d) K) (C : Matrix (Fin l) (Fin l) K)
    (hf : ∀x y,standardHermitian c (f x).val (f y).val=star x ⬝ᵥ (B*ᵥy))
    (hg : ∀x y,standardHermitian c (g x).val (g y).val=star x ⬝ᵥ (C*ᵥy)) :
    (E W hc f g)ᴴ*E W hc f g=fromBlocks B 0 0 C := by
  have hp (x y : (Fin d⊕Fin l)→K) :
      standardHermitian c (adaptedEquiv W hc f g x) (adaptedEquiv W hc f g y)=
        star x ⬝ᵥ ((fromBlocks B 0 0 C)*ᵥy) := by
    rw [adapted_apply,adapted_apply]
    have hxy : standardHermitian c (f (x∘Sum.inl)).val (g (y∘Sum.inr)).val=0 :=
      (g (y∘Sum.inr)).property _ (f (x∘Sum.inl)).property
