      _ ≤ 8*(2:ℝ)^(b/8) := by exact_mod_cast linear_le_eight_pow_div b
      _ ≤ _ := by gcongr
  have hexp : 8*(b/8)+b ≤ 8*(2*b/5) := by omega
  have hexpR : ((b/8 : ℕ) : ℝ) - ((2*b/5 : ℕ) : ℝ) ≤ -((b : ℝ)/8) := by
    have h : 8*((b/8 : ℕ):ℝ)+(b : ℝ) ≤ 8*((2*b/5 : ℕ):ℝ) := by exact_mod_cast hexp
    linarith
  have hr := pow_ratio_le hq (b/8) (2*b/5) ((b:ℝ)/8) hexpR
  have hfirst : 64*(b-1 : ℕ)*(d+1 : ℕ)*(q^(2*b/5))⁻¹ ≤
      512*(b:ℝ)*q^(-((b:ℝ)/8)) := by
    calc
      _ ≤ 64*(b:ℝ)*(8*q^(b/8))*(q^(2*b/5))⁻¹ := by gcongr
      _ = 512*(b:ℝ)*(q^(b/8)*(q^(2*b/5))⁻¹) := by ring
