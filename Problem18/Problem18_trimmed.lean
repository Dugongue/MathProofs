namespace Mathproof.Problem18AffinePlaceSpecialization20261001
open FunctionField MvPolynomial
open Mathproof.Problem18RationalPlaceDescent20260930
variable {k F : Type*} [Field k] [Field F] [Algebra k F]
def residueToBase (P : Place k F) (hP : P.degree = 1) : P.toValuationSubring →ₐ[k] k :=
  (AlgEquiv.ofBijective (Algebra.ofId k P.residueField)
    ⟨(algebraMap k P.residueField).injective, (degree_one_iff_surjective P).mp hP⟩).symm.toAlgHom.comp
      (IsScalarTower.toAlgHom k P.toValuationSubring P.residueField)
theorem exists_affine_specialization {ι : Type*} (P : Place k F) (hP : P.degree = 1)
    (y : ι → F) (hy : ∀ i, y i ∈ P) :
    ∃ x : ι → k, ∀ f : MvPolynomial ι k, aeval y f = 0 → eval x f = 0 := by
  classical
  letI : IsScalarTower k P.toValuationSubring F := .of_algebraMap_eq fun _ => rfl
  let z : ι → P.toValuationSubring := fun i => ⟨y i, hy i⟩
  let r := residueToBase P hP
  let inc := IsScalarTower.toAlgHom k P.toValuationSubring F
  have he : inc.comp (aeval z) = aeval y := by
    ext i
    simp [inc, z]
  have hr : r.comp (aeval z) = aeval (fun i => r (z i)) := by
    ext i
    simp
  refine ⟨fun i => r (z i), ?_⟩
  intro f hf
  have hz : aeval z f = 0 := by
    apply Subtype.val_injective
    change inc (aeval z f) = inc 0
    rw [map_zero]
    change (inc.comp (aeval z)) f = 0
    rw [he]
    exact hf
  have hx := congrArg r hz
  rw [map_zero] at hx
  change (r.comp (aeval z)) f = 0 at hx
  rw [hr] at hx
  simpa only [MvPolynomial.aeval_eq_eval] using hx
theorem rational_point_of_regular_place {ι : Type*} (P : Place k F) (hP : P.degree = 1)
    (y : ι → F) (hy : ∀ i, y i ∈ P) (S : Set (MvPolynomial ι k))
    (hS : ∀ f ∈ S, aeval y f = 0) : ∃ x : ι → k, ∀ f ∈ S, eval x f = 0 := by
  obtain ⟨x, hx⟩ := exists_affine_specialization P hP y hy
  exact ⟨x, fun f hf => hx f (hS f hf)⟩
end Mathproof.Problem18AffinePlaceSpecialization20261001
end
end
