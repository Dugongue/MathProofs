    | zero => rfl
    | pos m => exact encodePosNum_length_eq_natSize m
  rw [hnum, Num.natSize_to_nat]
  simp
theorem encoded_list_length_le (l : List ℕ) (s : ℕ)
    (hs : ∀ x ∈ l, x.size ≤ s) :
    (BitstringEncoding.bitEncode l).length ≤ l.length * (2*s+1) := by
  induction l with
  | nil => simp [BitstringEncoding.bitEncode] <;> rfl
  | cons x xs ih =>
    have hx := hs x (by simp)
    have hxs := ih (fun y hy => hs y (by simp [hy]))
    change (BitstringEncoding.delimit (Computability.encodeNat x) ++
      BitstringEncoding.bitEncode xs).length ≤ (x :: xs).length * (2*s+1)
    rw [List.length_append, BitstringEncoding.length_delimit, encodeNat_length_eq_size]
    simp only [List.length_cons]
    nlinarith
theorem tensorCoordinates_length (F : FieldPresentation K) {a b c : ℕ}
    (A : RectTensor a b c K) : (tensorCoordinates F A).length = a*b*c*F.e := by
  simp [tensorCoordinates, List.length_flatMap, List.sum_const_nat, mul_assoc, mul_comm,
    mul_left_comm]
theorem tensorCoordinates_entry_lt (F : FieldPresentation K) {a b c : ℕ}
    (A : RectTensor a b c K) (x : ℕ) (hx : x ∈ tensorCoordinates F A) : x < F.p := by
  simp only [tensorCoordinates, List.mem_flatMap, List.mem_map] at hx
  rcases hx with ⟨k, _, i, _, j, _, t, _, rfl⟩
  exact (F.coordinate (A k (i,j)) t).isLt
end Mathproof.Problem18PresentationSize20260930
