theorem applyValues_of_mem (xs : List (String × Expr)) (v : Expr → Nat) (σ : Env)
    (hnd : (xs.map Prod.fst).Nodup) (x : String) (e : Expr) (h : (x, e) ∈ xs) :
    (applyValues xs v σ).vars x = v e := by
  induction xs generalizing σ with
  | nil => simp at h
  | cons p rest ih =>
    rw [applyValues_cons]
    simp only [List.map_cons, List.nodup_cons] at hnd
    rcases List.mem_cons.mp h with h | h
    · subst h
      rw [applyValues_vars rest v _ x hnd.1]
      simp
    · exact ih _ hnd.2 h
