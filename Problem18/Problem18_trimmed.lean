def reads : List String → Com
  | []=>.skip
  | x::xs=>.seq (.read x) (reads xs)
theorem reads_run (ns : List String) (ws : List Nat) (σ : Env) (B : Nat)
    (hlen : ns.length≤ws.length) (hin : σ.inp=ws) :
    Run B (reads ns) σ (readEnv ns ws σ) (ns.length+1) := by
  induction ns generalizing ws σ with
  | nil=>exact Run.skip
  | cons x xs ih=>
    cases ws with
    | nil=>simp at hlen
    | cons w ws=>
      have hr : Run B (.read x) σ {σ.setVar x w with inp:=ws} 1 := Run.read hin
      have ht := ih ws {σ.setVar x w with inp:=ws} (by simpa using hlen) rfl
      simpa only [reads,readEnv,List.length_cons,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using hr.seq ht
def headerNames : List String :=
  ["P34.input.length","tag","u","q",canonical.p,canonical.e,"a","b","c"]
def program : Com := reads headerNames
def after {K : Type} [Field K] (F : FieldPresentation K) (u : Bool) (q : Nat)
    {a b c : Nat} (A T : RectTensor a b c K) (ext : String→Nat) : Env :=
  readEnv headerNames ((queryWords F u q A T).length::queryWords F u q A T)
    (initEnv ext ((queryWords F u q A T).length::queryWords F u q A T))
theorem run {K : Type} [Field K] (F : FieldPresentation K) (u : Bool) (q : Nat)
    {a b c : Nat} (A T : RectTensor a b c K) (ext : String→Nat) (B : Nat) :
    Run B program (initEnv ext ((queryWords F u q A T).length::queryWords F u q A T))
      (after F u q A T ext) 10 := by
  apply reads_run
  · simp [headerNames,queryWords,header]
  · rfl
theorem input {K : Type} [Field K] (F : FieldPresentation K) (u : Bool) (q : Nat)
    {a b c : Nat} (A T : RectTensor a b c K) (ext : String→Nat) :
    (after F u q A T ext).inp=
      (List.finRange F.e).map (fun i=>(F.modulus i).val)++tensorCoordinates F A++tensorCoordinates F T := by
  simp [after,readEnv,headerNames,queryWords,header,List.append_assoc]
theorem fields {K : Type} [Field K] (F : FieldPresentation K) (u : Bool) (q : Nat)
    {a b c : Nat} (A T : RectTensor a b c K) (ext : String→Nat) :
    let σ:=after F u q A T ext
    σ.vars "tag"=1 ∧ σ.vars "u"=u.toNat ∧ σ.vars "q"=q ∧
    σ.vars canonical.p=F.p ∧ σ.vars canonical.e=F.e ∧
    σ.vars "a"=a ∧ σ.vars "b"=b ∧ σ.vars "c"=c ∧
    (∀ arr,σ.arrs arr=List.replicate (ext arr) 0) ∧ σ.out=[] := by
  simp [after,readEnv,headerNames,queryWords,header,List.append_assoc,canonical,initEnv]
end Mathproof.Problem18P34Input20261002Header
