section
set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000
namespace Mathproof.Problem18IMPPolynomialSwap20261001
open Lax13Proofs.Imp Lax13Proofs.Reasoning Polynomial
open Problem18AllFormatRoot20260930 Problem18IMPFieldLayout20261001
open Problem18ClaudeIMPSlots20261001 Problem18ClaudeIMPAxpy20261001
open Problem18ClaudeIMPCopy20261001 Problem18IMPPolynomialRemainderSetup20261001
open Problem18ClaudeFieldMacrosInstancePow20261001
def first (q : RNames) : Expr := plus (.lit 5) (.var q.n)
def second (q : RNames) : Expr := plus (first q) (.var q.n)
def temporary (q : RNames) : Expr := plus (second q) (.var q.n)
def copyBody (q : RNames) (D S : Expr) : Com :=
  .seq (mcall canonical q (Problem18IMPFieldAddition20261001.copyRoutine canonical)
    (plus S (.var q.j)) (plus S (.var q.j)) (plus D (.var q.j)))
    (.assign q.j (plus (.var q.j) (.lit 1)))
def copy (q : RNames) (D S : Expr) : Com :=
  .seq (.assign q.j (.lit 0)) (.while (.lt (.var q.j) (.var q.N)) (copyBody q D S))
def routine (q : RNames) : Com :=
  .seq (copy q (temporary q) (first q))
    (.seq (copy q (first q) (second q)) (copy q (second q) (temporary q)))
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
theorem copy_eq (q : RNames) (D S : Expr) :
    copy q D S = copyLoop (fieldMacros F) q D S := rfl
theorem addresses (q : RNames) {σ : Env} {N Sn B : Nat}
    (hn : σ.vars q.n = N) (hfit : 5+N+N+N+N ≤ Sn) (hSB : Sn < B) :
    (first q).evalB B σ = some (5+N) ∧
    (second q).evalB B σ = some (5+N+N) ∧
    (temporary q).evalB B σ = some (5+N+N+N) := by
  have en : (Expr.var q.n).evalB B σ = some N := by
    simpa only [hn] using evalB_var (B:=B) (σ:=σ) (x:=q.n) (by rw [hn];omega)
  have e5 : (Expr.lit 5).evalB B σ = some 5 := evalB_lit (by omega)
  have h1 := evalB_bin (op:=Bop.add) e5 en (by change 5+N<B;omega)
  have h2 := evalB_bin (op:=Bop.add) h1 en (by change 5+N+N<B;omega)
  have h3 := evalB_bin (op:=Bop.add) h2 en (by change 5+N+N+N<B;omega)
  exact ⟨h1,h2,h3⟩
noncomputable def budget (q : RNames) (N : Nat) : Nat :=
  copyCost (fieldMacros F) (temporary q) (first q) N+
    (copyCost (fieldMacros F) (first q) (second q) N+
      copyCost (fieldMacros F) (second q) (temporary q) N)
theorem routine_run (q : RNames) (hq : q.Valid canonical)
    {Sn B N : Nat} {P Q : K[X]} {σ : Env} (h : Buffers F q Sn B N P Q σ)
    (hw : σ.vars q.N = N) (hfit : 5+N+N+N+N ≤ Sn) :
    ∃ τ, Run B (routine q) σ τ (budget F q N) ∧
      Buffers F q Sn B N Q P τ ∧ τ.vars q.N = N ∧
      (∀ x, x ∉ regNames canonical → x ≠ q.j → τ.vars x = σ.vars x) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hl : ∀ x ∈ q.fixed, x ∉ regNames canonical ∧ x ≠ q.j := by
    intro x hx
    refine ⟨hq.2 x (q.fixed_sub x hx),?_⟩
    simp only [RNames.fixed,List.mem_cons,List.not_mem_nil,or_false] at hx
    rcases hx with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;>
      exact hq.ne_of (by intro he;simp [RNames.list,he])
  have e1 : VarsIn q.fixed (first q) := by simp [first,plus,VarsIn,RNames.fixed]
  have e2 : VarsIn q.fixed (second q) := by simp [second,first,plus,VarsIn,RNames.fixed]
  have e3 : VarsIn q.fixed (temporary q) := by simp [temporary,second,first,plus,VarsIn,RNames.fixed]
  have had := addresses q h.capacity hfit h.slots.slots_word
  obtain ⟨σ1,hr1,hs1,hv1,hf1,hreg1,_,_,hi1,ho1⟩ :=
    copy_run (fieldMacros F) q hq q.fixed hl (temporary q) (first q) e3 e1
      h.slots had.2.2 had.1 hw hfit (by omega) (Or.inr (by omega))
  have hn1 : σ1.vars q.n = N := (hreg1 _ (hq.2 _ (by simp [RNames.list]))
    (hq.ne_of (by intro he;simp [RNames.list,he]))).trans h.capacity
  have hw1 : σ1.vars q.N = N := (hreg1 _ (hq.2 _ (by simp [RNames.list]))
    (hq.ne_of (by intro he;simp [RNames.list,he]))).trans hw
  have had1 := addresses q hn1 hfit hs1.slots_word
  obtain ⟨σ2,hr2,hs2,hv2,hf2,hreg2,_,_,hi2,ho2⟩ :=
    copy_run (fieldMacros F) q hq q.fixed hl (first q) (second q) e1 e2
      hs1 had1.1 had1.2.1 hw1 (by omega) (by omega) (Or.inl (by omega))
  have hn2 : σ2.vars q.n = N := (hreg2 _ (hq.2 _ (by simp [RNames.list]))
    (hq.ne_of (by intro he;simp [RNames.list,he]))).trans hn1
  have hw2 : σ2.vars q.N = N := (hreg2 _ (hq.2 _ (by simp [RNames.list]))
    (hq.ne_of (by intro he;simp [RNames.list,he]))).trans hw1
  have had2 := addresses q hn2 hfit hs2.slots_word
  obtain ⟨τ,hr3,hs3,hv3,hf3,hreg3,_,_,hi3,ho3⟩ :=
    copy_run (fieldMacros F) q hq q.fixed hl (second q) (temporary q) e2 e3
      hs2 had2.2.1 had2.2.2 hw2 (by omega) (by omega) (Or.inl (by omega))
  have hreg (x : String) (hx : x ∉ regNames canonical) (hj : x ≠ q.j) :
      τ.vars x = σ.vars x := (hreg3 x hx hj).trans ((hreg2 x hx hj).trans (hreg1 x hx hj))
  have hzero : val F canonical q.WS τ 0 = 0 := by
    rw [hf3 0 (by omega) (Or.inl (by omega)),hf2 0 (by omega) (Or.inl (by omega)),
