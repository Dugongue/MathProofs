  rw [adjoint_spec, hS, hc, hS, adjoint_spec]
theorem full_commutant_adjoint_stable (B : HermitianForm (K := K) (V := V))
    (hB : B.SeparatingLeft) (H T : Module.End K V)
    (hH : HermitianSelfAdjoint B H) (hT : HermitianSelfAdjoint B T)
    (f : Module.End K V)
    (hf : f ∈ Subalgebra.centralizer K
