theorem gram_recovery
    (X Y : Matrix i j K) (E F : Matrix j i K)
    (hE : X*E=1) (hF : Y*F=1) (hg : Xᴴ*X=Yᴴ*Y) :
    (Y*E)ᴴ*(Y*E)=1 ∧ (Y*E)*X=Y := by
  have hFy : Fᴴ*Yᴴ=1 := by
    rw [← Matrix.conjTranspose_mul, hF, Matrix.conjTranspose_one]
  have hy : Y=Fᴴ*(Xᴴ*X) := by
    rw [hg, ← Matrix.mul_assoc, hFy, Matrix.one_mul]
  constructor
  · calc
      (Y*E)ᴴ*(Y*E) = Eᴴ*(Yᴴ*Y)*E := by
        simp only [Matrix.conjTranspose_mul, Matrix.mul_assoc]
      _ = Eᴴ*(Xᴴ*X)*E := by rw [hg]
      _ = (X*E)ᴴ*(X*E) := by
        simp only [Matrix.conjTranspose_mul, Matrix.mul_assoc]
      _ = 1 := by rw [hE]; simp
  · calc
      (Y*E)*X = ((Fᴴ*(Xᴴ*X))*E)*X := by rw [← hy]
      _ = Fᴴ*Xᴴ*(X*E)*X := by simp only [Matrix.mul_assoc]
      _ = Fᴴ*(Xᴴ*X) := by rw [hE, Matrix.mul_one, Matrix.mul_assoc]
      _ = Y := hy.symm
end Gram
