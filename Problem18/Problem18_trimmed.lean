namespace Mathproof.Problem18LargeRecoveryCriterion20261001
open Matrix FiniteFieldOrthogonalUnitaryTI
open Problem18OrthogonalAssembly (RectTensor rectAction)
open Problem18LargeSourcePredicate20261001 Problem18LargeSourceCovariance20261001
open Problem18TwoIntertwinerRecovery20261001 Problem18ExecutableIntertwiner20261001
open Problem18ExecutableAlgebra20261001 Problem18OrderedRecovery20260930
variable {K : Type*} [Field K] [DecidableEq K] [StarRing K] {a b c : ℕ}
def Equivalent (A B : RectTensor a b c K) : Prop :=
  ∃P Q R,IsUnitary P ∧ IsUnitary Q ∧ IsUnitary R ∧ rectAction P Q R A=B
theorem action_comp (A : RectTensor a b c K)
    (P P' : Matrix (Fin a) (Fin a) K) (Q Q' : Matrix (Fin b) (Fin b) K)
    (R R' : Matrix (Fin c) (Fin c) K) :
    rectAction P' Q' R' (rectAction P Q R A)=rectAction (P'*P) (Q'*Q) (R'*R) A := by
  simp only [rectAction,Matrix.kronecker,Matrix.mul_kronecker_mul,
    Matrix.transpose_mul,Matrix.mul_assoc]
theorem undoFirst_action (A : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (hQ : IsUnitary Q) :
    undoFirst (rectAction P Q R A) Q=rectAction P 1 R A := by
  rw [undoFirst,computedInverse_eq,Matrix.inv_eq_left_inv hQ,action_comp]
  change rectAction (1*P) (Qᴴ*Q) (1*R) A=rectAction P 1 R A
  rw [show Qᴴ*Q=1 from hQ]
  simp
theorem second_undo_action (A : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (hQ : IsUnitary Q) (hR : IsUnitary R)
    (t : Fin (b*b)) :
    secondIndexed (undoFirst (rectAction P Q R A) Q) t=P*secondIndexed A t*Pᴴ := by
  rw [undoFirst_action A P Q R hQ]
  unfold secondIndexed
  rw [secondFamily_action A P 1 R hR]
  simp [Matrix.one_apply,apply_ite]
theorem unitary_ne_zero {n : ℕ} (hn : 0 < n) (P : Matrix (Fin n) (Fin n) K)
    (hP : IsUnitary P) : P≠0 := by
  letI : Nonempty (Fin n):=⟨⟨0,hn⟩⟩
  intro hz
  have h : Pᴴ*P=1:=hP
  simp [hz] at h
theorem returned_pair_lines (ha : 0 < a) (hb : 0 < b)
    (A B : RectTensor a b c K) (hA : Good A)
    (X : Matrix (Fin b) (Fin b) K) (Y : Matrix (Fin a) (Fin a) K)
    (hx : firstSolution A B=some X) (hy : secondSolution hb A B X=some Y)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (hP : IsUnitary P) (hQ : IsUnitary Q)
    (hR : IsUnitary R) (hact : rectAction P Q R A=B) :
    ∃z w : K,z≠0 ∧ w≠0 ∧ X=z • Q ∧ Y=w • P := by
  letI : Nonempty (Fin a):=⟨⟨0,ha⟩⟩
  letI : Nonempty (Fin b):=⟨⟨0,hb⟩⟩
  have hQi : ∀j,Q*firstFamily A j=firstFamily B j*Q := by
    intro j
    rw [←hact,firstFamily_action A P Q R hP hQ hR]
    rw [Matrix.mul_assoc,show Qᴴ*Q=1 from hQ,Matrix.mul_one]
  have hxx:=intertwiner_some _ _ X hx
  obtain ⟨z,hz⟩:=intertwiner_line _ _ Q X (unitary_ne_zero hb Q hQ) hA.1 hQi hxx.2
  have he:=actual_second_correction hb A B hA X Q hx hQ hQi
  have hPi : ∀t,P*secondIndexed A t=secondTarget B X (gramScalar hb X) t*P := by
    intro t
    rw [he,←hact,second_undo_action A P Q R hQ hR]
    rw [Matrix.mul_assoc,show Pᴴ*P=1 from hP,Matrix.mul_one]
  have hyy:=intertwiner_some _ _ Y hy
  obtain ⟨w,hw⟩:=intertwiner_line _ _ P Y (unitary_ne_zero ha P hP)
    (secondIndexed_generates A hA) hPi hyy.2
  refine ⟨z,w,?_,?_,hz,hw⟩
  · intro h; apply hxx.1; simpa [h] using hz
  · intro h; apply hyy.1; simpa [h] using hw
theorem equivalent_iff_selected_lines (ha : 0 < a) (hb : 0 < b)
    (A B : RectTensor a b c K) (hA : Good A)
    (X : Matrix (Fin b) (Fin b) K) (Y : Matrix (Fin a) (Fin a) K)
    (hx : firstSolution A B=some X) (hy : secondSolution hb A B X=some Y) :
    Equivalent A B ↔ ∃z w : K,∃R : Matrix (Fin c) (Fin c) K,
      IsUnitary (z • Y) ∧ IsUnitary (w • X) ∧ IsUnitary R ∧
        rectAction (z • Y) (w • X) R A=B := by
  constructor
  · rintro ⟨P,Q,R,hP,hQ,hR,hact⟩
    obtain ⟨z,w,hz0,hw0,hz,hw⟩:=returned_pair_lines ha hb A B hA X Y hx hy P Q R hP hQ hR hact
    refine ⟨w⁻¹,z⁻¹,R,?_,?_,hR,?_⟩
    all_goals simp only [hz,hw,smul_smul,inv_mul_cancel₀ hz0,inv_mul_cancel₀ hw0,one_smul]
    · exact hP
    · exact hQ
    · exact hact
  · rintro ⟨z,w,R,hP,hQ,hR,hact⟩
    exact ⟨z • Y,w • X,R,hP,hQ,hR,hact⟩
def scalarNorm (z : K) : K := star z*z
theorem scalarNorm_mul (z w : K) : scalarNorm (z*w)=scalarNorm z*scalarNorm w := by
  simp only [scalarNorm,star_mul]
  ring
theorem scalarNorm_div (z w : K) : scalarNorm (z/w)=scalarNorm z/scalarNorm w := by
  simp only [scalarNorm,star_div₀]
  ring
theorem unitary_smul_of_norm {n : ℕ} (z : K) (R : Matrix (Fin n) (Fin n) K)
    (hz : scalarNorm z=1) (hR : IsUnitary R) : IsUnitary (z • R) := by
  change (z • R)ᴴ*(z • R)=1
  rw [Matrix.conjTranspose_smul,Matrix.smul_mul,Matrix.mul_smul,smul_smul,
    show Rᴴ*R=1 from hR,show star z*z=1 from hz,one_smul]
theorem unitary_smul_iff {n : ℕ} (hn : 0 < n) (Y : Matrix (Fin n) (Fin n) K)
    (d : K) (hd : Yᴴ*Y=d • 1) (z : K) : IsUnitary (z • Y) ↔ scalarNorm z*d=1 := by
  change (z • Y)ᴴ*(z • Y)=1 ↔ _
  rw [Matrix.conjTranspose_smul,Matrix.smul_mul,Matrix.mul_smul,smul_smul,hd,smul_smul]
  constructor
  · intro h
    have hh:=congrArg (fun M : Matrix (Fin n) (Fin n) K=>M ⟨0,hn⟩ ⟨0,hn⟩) h
    simpa [scalarNorm] using hh
  · intro h
    rw [show star z*z*d=1 from h,one_smul]
def outerImage (A : RectTensor a b c K) (Y : Matrix (Fin a) (Fin a) K)
    (X : Matrix (Fin b) (Fin b) K) : RectTensor a b c K :=
  A*(Matrix.kronecker Y X).transpose
theorem action_scalars (A : RectTensor a b c K) (Y : Matrix (Fin a) (Fin a) K)
    (X : Matrix (Fin b) (Fin b) K) (R : Matrix (Fin c) (Fin c) K) (z w : K) :
    rectAction (z • Y) (w • X) R A=R*((z*w) • outerImage A Y X) := by
  simp only [rectAction,outerImage,Matrix.kronecker,Matrix.smul_kronecker,
    Matrix.kronecker_smul,smul_smul,Matrix.transpose_smul,Matrix.mul_smul,Matrix.mul_assoc]
  rw [mul_comm w z]
def FinalScalar (H B : RectTensor a b c K) (d : K) : Prop :=
  ∃u : K,scalarNorm u*d=1 ∧ ∃R : Matrix (Fin c) (Fin c) K,
    IsUnitary R ∧ R*(u • H)=B
theorem finalScalar_iff_fixed (H B : RectTensor a b c K) (d v : K)
    (hv : scalarNorm v*d=1) :
    FinalScalar H B d ↔ ∃R : Matrix (Fin c) (Fin c) K,IsUnitary R ∧ R*(v • H)=B := by
  have hv0 : v≠0 := by intro h; simp [h,scalarNorm] at hv
  have hd0 : d≠0 := by intro h; simp [h] at hv
  have hn0 : scalarNorm v≠0 := by intro h; simp [h] at hv
  constructor
  · rintro ⟨u,hu,R,hR,he⟩
    have hn : scalarNorm u=scalarNorm v:=mul_right_cancel₀ hd0 (hu.trans hv.symm)
    refine ⟨(u/v) • R,unitary_smul_of_norm _ R ?_ hR,?_⟩
    · rw [scalarNorm_div,hn,div_self hn0]
    · rw [Matrix.smul_mul,Matrix.mul_smul,smul_smul,div_mul_cancel₀ _ hv0]
      simpa only [Matrix.mul_smul] using he
  · rintro ⟨R,hR,he⟩
    exact ⟨v,hv,R,hR,he⟩
theorem equivalent_iff_scalar_tests (ha : 0 < a) (hb : 0 < b)
    (A B : RectTensor a b c K) (hA : Good A)
    (X : Matrix (Fin b) (Fin b) K) (Y : Matrix (Fin a) (Fin a) K)
    (hx : firstSolution A B=some X) (hy : secondSolution hb A B X=some Y) :
    Equivalent A B ↔ (∃z : K,scalarNorm z*gramScalar ha Y=1) ∧
      (∃w : K,scalarNorm w*gramScalar hb X=1) ∧
      FinalScalar (outerImage A Y X) B (gramScalar ha Y*gramScalar hb X) := by
  have hgY:=(secondSolution_correct ha hb A B hA X hx Y hy).2.2.2
  have hgX:=(firstSolution_correct hb A B hA X hx).2.2.2
  rw [equivalent_iff_selected_lines ha hb A B hA X Y hx hy]
  constructor
  · rintro ⟨z,w,R,hz,hw,hR,he⟩
    have hz':=(unitary_smul_iff ha Y _ hgY z).mp hz
    have hw':=(unitary_smul_iff hb X _ hgX w).mp hw
    refine ⟨⟨z,hz'⟩,⟨w,hw'⟩,z*w,?_,R,hR,?_⟩
    · rw [scalarNorm_mul]
      calc scalarNorm z*scalarNorm w*(gramScalar ha Y*gramScalar hb X)
          =(scalarNorm z*gramScalar ha Y)*(scalarNorm w*gramScalar hb X) := by ring
           _=1 := by rw [hz',hw',one_mul]
    · simpa only [action_scalars] using he
  · rintro ⟨⟨z,hz⟩,⟨w,hw⟩,hf⟩
    have hv : scalarNorm (z*w)*(gramScalar ha Y*gramScalar hb X)=1 := by
      rw [scalarNorm_mul]
      calc scalarNorm z*scalarNorm w*(gramScalar ha Y*gramScalar hb X)
          =(scalarNorm z*gramScalar ha Y)*(scalarNorm w*gramScalar hb X) := by ring
           _=1 := by rw [hz,hw,one_mul]
    obtain ⟨R,hR,he⟩:=(finalScalar_iff_fixed _ _ _ (z*w) hv).mp hf
    refine ⟨z,w,R,(unitary_smul_iff ha Y _ hgY z).mpr hz,
      (unitary_smul_iff hb X _ hgX w).mpr hw,hR,?_⟩
    simpa only [action_scalars] using he
end Mathproof.Problem18LargeRecoveryCriterion20261001
end
