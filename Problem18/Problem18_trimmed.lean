set_option backward.isDefEq.respectTransparency false
noncomputable def operatorIsometryEquiv
    (B : LinearMap.BilinForm K V) (C : LinearMap.BilinForm K W)
    (e : V ≃ₗ[K] W) (he : ∀ x y,C (e x) (e y)=B x y) :
    SelfAdjointOperators (RingEquiv.refl K) B ≃ SelfAdjointOperators (RingEquiv.refl K) C :=
  Equiv.subtypeEquiv e.conj.toEquiv (fun T => by
    constructor
    · intro h x y
      obtain ⟨x,rfl⟩ := e.surjective x
      obtain ⟨y,rfl⟩ := e.surjective y
      change C (e (T (e.symm (e x)))) (e y)=C (e x) (e (T (e.symm (e y))))
      simpa only [e.symm_apply_apply,he] using h x y
    · intro h x y
      have hh := h (e x) (e y)
      change C (e (T (e.symm (e x)))) (e y)=C (e x) (e (T (e.symm (e y)))) at hh
      simpa only [e.symm_apply_apply,he] using hh)
theorem sample_card (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hnB : B.Nondegenerate) :
    Nat.card (SelfAdjointOperators (RingEquiv.refl K) B)=
      Nat.card K^((Module.finrank K V).choose 2+Module.finrank K V) := by
  let e := (Module.finBasis K V).equivFun
  let C := form e B
  have hnC : C.Nondegenerate := form_nondegenerate e B hnB
  have hsC (x y) : C y x=C x y := hB.eq (e.symm y) (e.symm x)
  let E := operatorIsometryEquiv B C e (fun x y => by
    change B (e.symm (e x)) (e.symm (e y))=B x y
    rw [e.symm_apply_apply,e.symm_apply_apply])
  let Ec : SelfAdjointOperators (RingEquiv.refl K) C ≃
      Mathproof.Problem18SelfAdjointCoordinateRestriction20260930.selfAdjointSpace (RingEquiv.refl K) C :=
    { toFun := fun S => ⟨S.val,S.property⟩
      invFun := fun S => ⟨S.val,S.property⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  rw [Nat.card_congr E,Nat.card_congr Ec]
  exact Mathproof.Problem18ExactSelfAdjointCard20260930.symmetric_card_exact C hnC.1 hsC
end
end Mathproof.Problem18OrdinarySampleNormalization20261001
