      (Fintype.card G : ℝ) * ∑ y, ‖uniformImageWeight P y‖ ^ 2 ≤ C) :
    ((Finset.univ.filter (fun x => P x ∈ E)).card : ℝ) / Fintype.card V ≤
      Real.sqrt (C * ((E.card : ℝ) / Fintype.card G)) := by
