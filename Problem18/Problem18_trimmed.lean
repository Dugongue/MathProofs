  · intro r
    by_cases h : r.val < k
    · simp only [dif_pos h]
      exact (boxPoly_mem_of_span n _ fs d hfs hdE _ (hU _)).2
    · simp only [dif_neg h, boxPoly, map_zero, totalDegree_zero]
      exact Nat.zero_le _
noncomputable def encRows (n d : ℕ) (fs : List (MvPolynomial (Fin n) K)) :
    Fin (secBox n d) → Fin (secBox n d) → K := by
  classical
  exact if h : ∀ f ∈ fs, f.totalDegree ≤ d then Classical.choose (exists_encRows n d fs h) else 0
theorem encRows_spec (n d : ℕ) (fs : List (MvPolynomial (Fin n) K))
    (h : ∀ f ∈ fs, f.totalDegree ≤ d) :
    Ideal.span (Set.range fun r => boxPoly n (secDeg d) (encRows n d fs r)) =
        Ideal.span {f | f ∈ fs} ∧
      ∀ r, (boxPoly n (secDeg d) (encRows n d fs r)).totalDegree ≤ d := by
  classical
  have he : encRows n d fs = Classical.choose (exists_encRows n d fs h) := by
    unfold encRows
    rw [dif_pos h]
  rw [he]
  exact Classical.choose_spec (exists_encRows n d fs h)
