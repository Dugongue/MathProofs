theorem smallCom_run (q : RNames) (cn : CNames) (zn : ZNames) (sn : SNames) (pn : PNames)
    (rs : RowSlots) {n d : ℕ} (rows : List (DenseInput n d K)) {S B : ℕ} {σ : Env}
    (hz : zn.Valid r q cn) (hsn : sn.Valid r q cn zn) (hpn : pn.Valid r q cn zn sn)
    (hd : RowDistinct rs n) (hb : RowBelow rs n (inStart (boxSize n d) 0)) (hcb : CoordBlock rs n)
    (hone_pos : 0 < rs.ONE) (hdB : d < B) (hnB : n < B) (hqvB : F.p ^ F.e < B)
    (hQB : (F.p ^ F.e) ^ n < B)
    (hL : Loaded F r q cn d rows σ) (hP : Pre F r q cn B S σ) (hqr : σ.vars pn.qr = F.p ^ F.e) :
    ∃ τ : Env, Run B (smallCom M q cn zn sn pn rs n d) σ τ
        (smallCost M rs n d rows.length F.e ((F.p ^ F.e) ^ n)) ∧
      τ.vars sn.ans = (if (smallFieldDecide F rows).1 then 1 else 0) ∧
      Slots F r q.WS S B τ ∧
      (∀ y, y ∉ clobbered r → y ≠ r.aBase → y ≠ r.bBase → y ≠ r.outBase → y ≠ r.exp →
        y ≠ zn.t → y ≠ zn.z → y ≠ sn.c → y ≠ sn.ans → y ≠ sn.w → y ≠ sn.k → y ≠ sn.Q →
        y ≠ pn.ne → y ≠ pn.idx → τ.vars y = σ.vars y) ∧
      (∀ arr, arr ≠ r.mem → arr ≠ r.scratch → τ.arrs arr = σ.arrs arr) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  obtain ⟨hN, hR, hin⟩ := hL
  obtain ⟨hS, hz0, hq, hcn, hRB, hfit⟩ := hP
  rw [hN, hR] at hfit
  rw [hR] at hRB
  set qv := F.p ^ F.e with hqv
  set Qv := qv ^ n with hQv
  have hSB := hS.slots_word
  have hX0 := inStart_zero_le (boxSize n d) rows.length
  have hpos : 0 < S := by have := hb.a0; omega
  have hB1 : 1 < B := by omega
  have hONE : rs.ONE < S := by have := hb.one; omega
  have hq1 : 1 ≤ qv := Nat.one_le_pow _ _ F.prime.pos
  obtain ⟨τ₁, hrun₁, hS₁, hone₁, hoth₁, hv₁, ha₁, hi₁, ho₁⟩ :=
    const_run (F := F) (r := r) q sn.k hsn.k_reg hsn.k_WS [] (by simp) (.lit rs.ONE) trivial hS
      (evalB_lit (by omega)) hONE F.prime.one_lt
  rw [Nat.cast_one] at hone₁
  have hrun₂ := Run.assign (B := B) (σ := τ₁) (x := sn.ans) (evalB_lit (n := 0) (by omega))
  set τ₂ := τ₁.setVar sn.ans 0 with hτ₂
  have hrun₃ := Run.assign (B := B) (σ := τ₂) (x := pn.ne) (evalB_lit (n := n) hnB)
  set τ₃ := τ₂.setVar pn.ne n with hτ₃
  have hqr₃ : τ₃.vars pn.qr = qv := by
    simp only [τ₃, τ₂, vars_setVar, if_neg hpn.qr_ne, if_neg hpn.qr_ans]
    rw [hv₁ _ hpn.qr_k]; exact hqr
