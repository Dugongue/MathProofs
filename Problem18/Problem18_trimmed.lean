      ‖(∑ x : E, ψ (Q x) * χ x) / (Fintype.card E : ℂ)‖ ^ 2 ≠ 0)).card =
      Fintype.card K ^ (Module.finrank K V - Module.finrank K E +
        Module.finrank K (LinearMap.range (Q.comp E.subtype).polarBilin)) := by
  let a (χ : AddChar V ℂ) : ℝ :=
    ‖(∑ x : E, ψ (Q x) * χ x) / (Fintype.card E : ℂ)‖ ^ 2
  let r := Module.finrank K (LinearMap.range (Q.comp E.subtype).polarBilin)
  have hd (χ : AddChar V ℂ) :
      a χ = if a χ ≠ 0 then ((Fintype.card K : ℝ)^r)⁻¹ else 0 := by
    have h := quadratic_twist_dichotomy (Q.comp E.subtype) ψ hψ
      (χ.compAddMonoidHom E.subtype.toAddMonoidHom)
    change a χ = 0 ∨ a χ = ((Fintype.card K : ℝ)^r)⁻¹ at h
    split_ifs with hz
    · exact h.resolve_left hz
    · exact not_ne_iff.mp hz
  have hp := restricted_quadratic_twist_moment Q E ψ hψ 1 (by decide)
  simp only [pow_one, Nat.sub_self, pow_zero, mul_one] at hp
  rw [subspace_card_ratio E] at hp
