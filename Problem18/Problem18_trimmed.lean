variable {K : Type} [Field K] [Fintype K] [DecidableEq K] {q a b c : Nat}
def compileList (P : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) :
    List (StarExpr (OuterVar a b) K)→
      List (PolyExpr (OuterCoordVar a b) (Problem18InvolutionNorm20260930.fixedField d.automorphism))×Nat
  | []=>([],0)
  | p::ps=>let r:=compileCounted P d p; let t:=compileList P d ps
