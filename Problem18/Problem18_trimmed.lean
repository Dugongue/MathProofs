  simp only [transformedEntry]
  rw [eval_sumFin_eq_finset_sum]
  apply Finset.sum_congr rfl
  intro u _
  rw [eval_sumFin_eq_finset_sum]
  apply Finset.sum_congr rfl
  intro v _
  rfl
