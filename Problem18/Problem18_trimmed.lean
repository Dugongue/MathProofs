  (Cₛ 5 +ₛ Cₛ 4 *ₛ capacity) +ₛ (Cₛ 5 +ₛ Cₛ 3 *ₛ capacity +ₛ capacity *ₛ (Cₛ 3 *ₛ capacity))
def factor := first +ₛ capacity
def divisor := factor +ₛ capacity
def candidate := divisor +ₛ capacity
def seed := candidate +ₛ SizeExpr.dim
def matrix := seed +ₛ SizeExpr.dim
def action := matrix +ₛ SizeExpr.dim *ₛ SizeExpr.dim
def temp := action +ₛ SizeExpr.dim
def product := temp +ₛ SizeExpr.dim
def productWork := product +ₛ Cₛ 3 *ₛ capacity
def orbit := productWork +ₛ Cₛ 3
def orbitWork := orbit +ₛ (SizeExpr.dim +ₛ Cₛ 1) *ₛ SizeExpr.dim
