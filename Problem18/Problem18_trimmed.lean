    fun k => (coefficient_degree_le f k.val).trans hB, ?_⟩
  have hev : q.eval₂ (Polynomial.aeval t).toRingHom y = 0 :=
    (asPolynomial_eval f t y).trans he
  rw [Polynomial.eval₂_eq_sum_range, Finset.sum_range_succ] at hev
  rw [← Fin.sum_univ_eq_sum_range] at hev
  simpa only [Polynomial.leadingCoeff, AlgHom.toRingHom_eq_coe,
    AlgHom.coe_toRingHom, add_comm] using hev
