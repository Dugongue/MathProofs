structure RunResult where
  answer : Bool
  fieldOps : Nat
  controlOps : Nat
  maxLiveCells : Nat
  maxIndexBits : Nat
variable {K : Type} [Field K] [DecidableEq K] [Fintype K]
variable {L : Type} [Field L] [Algebra K L] [IsAlgClosed L] [Algebra.IsAlgebraic K L]
def inputWords (F : FieldPresentation K) (n d : Nat) (rows : List (DenseInput n d K)) :
    List Nat :=
  [n, d, rows.length, F.p, F.e] ++ (List.finRange F.e).map (fun i => (F.modulus i).val) ++
    rows.flatMap (fun v => v.toList.flatMap (fun c =>
      (List.finRange F.e).map (fun t => (F.coordinate c t).val)))
def run {n : Nat} (B : GeometryBackend (K := K) L n) (F : FieldPresentation K) (d : Nat)
    (rows : List (DenseInput n d K)) : RunResult :=
  let s := decide B F d rows
  { answer := s.1, fieldOps := s.2, controlOps := 0, maxLiveCells := 0, maxIndexBits := 0 }
theorem exists_represents {n d : Nat} (rows : List (DenseInput n d K))
    (hv : ∀ v ∈ rows, ∃ p : MvPolynomial (Fin n) K, ValidDenseInput d v p) :
    ∃ fs, Represents rows fs := by
  induction rows with
  | nil => exact ⟨[], List.Forall₂.nil⟩
  | cons v vs ih =>
    obtain ⟨p, hp⟩ := hv v List.mem_cons_self
    obtain ⟨fs, hfs⟩ := ih fun w hw => hv w (List.mem_cons_of_mem v hw)
    exact ⟨p :: fs, List.Forall₂.cons hp hfs⟩
theorem run_correct {n : Nat} (B : GeometryBackend (K := K) L n) (F : FieldPresentation K)
    (d : Nat) (rows : List (DenseInput n d K))
    (hv : ∀ v ∈ rows, ∃ p : MvPolynomial (Fin n) K, ValidDenseInput d v p)
    (hcard : Fintype.card K = F.p ^ F.e) :
    (run B F d rows).answer = true ↔
      ∃ x : Fin n → K, ∀ v ∈ rows, denseEval x (read v) = 0 := by
  obtain ⟨fs, hfs⟩ := exists_represents rows hv
  exact decide_correct B F d rows fs hfs hcard
end Mathproof.Problem18ClaudeUnrestrictedSolver20261001
end
