    ((algebraMap (ringOfIntegers k K) A).comp
      (algebraMap k (ringOfIntegers k K))).toAlgebra
  letI : IsScalarTower k (ringOfIntegers k K) A :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  {
