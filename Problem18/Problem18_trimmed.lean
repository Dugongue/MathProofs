theorem BufferInput.multiply_other {K : Type} [Field K]
    {F : Problem18AllFormatRoot20260930.FieldPresentation K}
    {r : FieldNames} {B : Nat} {σ : Env} (h : BufferInput F r B σ)
    {a b out n : Nat} (ha : a∈[2,3,4]) (hb : b∈[2,3,4]) (ho : out∈[2,3,4])
    (hn : n∈[2,3,4]) (hne : n≠out) :
    bufferCoeffs F r (callResult r σ a b out) n=bufferCoeffs F r σ n := by
  have hs (x : String) (hx : x∈scalarNames r):
      (callState r σ a b out).vars x=σ.vars x := callState_shared h.private_names σ a b out x hx
  have heq:(callState r σ a b out).vars (innerNames r).e=F.e:=
    (hs r.e (by simp [scalarNames])).trans h.degree
  have hov: (callState r σ a b out).vars (innerNames r).outBase=out*F.e:=by
    simpa only [h.degree] using (callState_arguments h.inner_names σ a b out).2.2
  have hnb:2≤n ∧ n≤4:=by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hn; omega
  funext i
  apply completed_read_preserved (h.mulInput ha hb ho) r.scratch (n*F.e+i.val)
  · change n*F.e+i.val < (σ.arrs r.scratch).length
    have hf:=h.scratch_fit; have hi:=i.isLt; nlinarith
  · right; rw [heq]; nlinarith
  · right
    rw [heq,hov]
    have hi:=i.isLt
    rcases lt_or_gt_of_ne hne with hl|hl
    · left; nlinarith
    · right; nlinarith
theorem BufferInput.multiply_preserves {K : Type} [Field K]
    {F : Problem18AllFormatRoot20260930.FieldPresentation K}
    {r : FieldNames} {B : Nat} {σ : Env} (h : BufferInput F r B σ)
    {a b out : Nat} (ha : a∈[2,3,4]) (hb : b∈[2,3,4]) (ho : out∈[2,3,4]) :
    BufferInput F r B (callResult r σ a b out) := by
  have hv (x : String) (hx : x∈scalarNames r):
      (callResult r σ a b out).vars x=σ.vars x :=
    callResult_vars r σ a b out x (h.private_names x hx)
  refine {
    degree:=(hv r.e (by simp [scalarNames])).trans h.degree,
    prime:=(hv r.p (by simp [scalarNames])).trans h.prime,
    separate:=h.separate, outer_names:=h.outer_names,inner_names:=h.inner_names,
    private_names:=h.private_names,arithmetic_word:=h.arithmetic_word,
    memory_word:=?_,scratch_word:=?_,scratch_fit:=?_,modulus_fit:=?_,modulus_value:=?_,
    buffer_canonical:=?_,exponent_word:=?_ }
  · rw [callResult_lengths]; exact h.memory_word
  · rw [callResult_lengths]; exact h.scratch_word
  · rw [callResult_lengths]; exact h.scratch_fit
  · rw [hv r.modBase (by simp [scalarNames]),callResult_lengths]; exact h.modulus_fit
  · intro i
    unfold sourceCoeff
    rw [hv r.modBase (by simp [scalarNames]),h.multiply_memory ha hb ho]
    exact h.modulus_value i
  · intro n hn j hj
    by_cases heq:n=out
    · subst n
      exact (h.multiply_value ha hb ho).2 ⟨j,hj⟩
    · have hh:=congrFun (h.multiply_other ha hb ho hn heq) ⟨j,hj⟩
      exact hh.trans_lt (h.buffer_canonical n hn j hj)
  · rw [hv r.exponent (by simp [scalarNames])]; exact h.exponent_word
