  have hS3 : Slots F canonical names.q.WS Sn B σ3 := by
    refine ((hS2.setVar F canonical (hg.avoid _ (by simp [gatherNames,MNames.list]))
      (by decide) c).setVar F canonical
      (hg.avoid _ (by simp [gatherNames,MNames.list])) (by decide) (inStart N 0)).setVar F canonical
      (hg.avoid _ (by simp [gatherNames,MNames.list])) (by decide) 5
  have hNpos : 0 < N := by
    rw [hNdef]
    exact (by simp [boxSize, boundedExponents_length])
  have hz3 : val F canonical names.q.WS σ3 0 = 0 := by
    dsimp [σ3]
    rw [val_setVar F canonical (by decide), val_setVar F canonical (by decide),
      val_setVar F canonical (by decide)]
    rw [hframe2 0 (by omega) (Or.inl (by unfold inStart rowStart; omega))]
    rw [hframe1 0 (by omega) (Or.inl (by omega)), hv0]
