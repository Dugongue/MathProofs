    simp only [zArgs, List.map_cons, List.map_nil]; decide
  obtain ⟨ν3, r3, vals3, rest3, arr3, i3, o3⟩ := asg_run cArgs ν2
    ((rv2 _ (hz12 _ (by simp)).1 (hz12 _ (by simp)).2).trans hn)
    ((rv2 _ (hz12 _ (by simp)).1 (hz12 _ (by simp)).2).trans hd)
    ((rv2 _ (hz12 _ (by simp)).1 (hz12 _ (by simp)).2).trans he)
