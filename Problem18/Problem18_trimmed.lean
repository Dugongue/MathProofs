namespace Mathproof.Problem18TensorSorting20261001
open Problem18OrthogonalAssembly (RectTensor)
open Problem18AllFormatRoot20260930 Problem18DimensionOnePermutation20260930
inductive Order where
  | abc | acb | bac | bca | cab | cba
  deriving DecidableEq
def shape : Order → ℕ → ℕ → ℕ → ℕ×ℕ×ℕ
  | .abc,a,b,c => (a,b,c)
  | .acb,a,b,c => (a,c,b)
  | .bac,a,b,c => (b,a,c)
  | .bca,a,b,c => (b,c,a)
  | .cab,a,b,c => (c,a,b)
  | .cba,a,b,c => (c,b,a)
def sortOrder (a b c : ℕ) : Order :=
  if a≤b then
    if b≤ c then .abc else if a≤ c then .acb else .cab
  else if a≤ c then .bac else if b≤ c then .bca else .cba
variable {K : Type} [Field K] {a b c : ℕ}
def swapABEquiv : RectTensor a b c K ≃ RectTensor b a c K :=
  ⟨swapAB,swapAB,swapAB_involutive,swapAB_involutive⟩
def swapACEquiv : RectTensor a b c K ≃ RectTensor c b a K :=
  ⟨swapAC,swapAC,swapAC_involutive,swapAC_involutive⟩
def tensorEquiv : (o : Order) → RectTensor a b c K ≃
    RectTensor (shape o a b c).1 (shape o a b c).2.1 (shape o a b c).2.2 K
  | .abc => Equiv.refl _
  | .acb => swapABEquiv.trans (swapACEquiv.trans swapABEquiv)
  | .bac => swapABEquiv
  | .bca => swapACEquiv.trans swapABEquiv
  | .cab => swapABEquiv.trans swapACEquiv
  | .cba => swapACEquiv
theorem tensorEquiv_equivalent (o : Order) (u : Bool) (q : ℕ)
    (A B : RectTensor a b c K) :
    equivalent u q A B ↔ equivalent u q (tensorEquiv o A) (tensorEquiv o B) := by
  cases o with
  | abc => rfl
  | acb =>
    exact (root_swapAB_iff u q A B).trans
      ((root_swapAC_iff u q (swapAB A) (swapAB B)).trans
        (root_swapAB_iff u q (swapAC (swapAB A)) (swapAC (swapAB B))))
  | bac => exact root_swapAB_iff u q A B
  | bca =>
    exact (root_swapAC_iff u q A B).trans
      (root_swapAB_iff u q (swapAC A) (swapAC B))
  | cab =>
    exact (root_swapAB_iff u q A B).trans
      (root_swapAC_iff u q (swapAB A) (swapAB B))
  | cba => exact root_swapAC_iff u q A B
theorem shape_product (o : Order) (a b c : ℕ) :
    (shape o a b c).1*(shape o a b c).2.1*(shape o a b c).2.2=a*b*c := by
  cases o <;> simp [shape,mul_comm,mul_assoc,mul_left_comm]
theorem shape_median (o : Order) (a b c : ℕ) :
    median (shape o a b c).1 (shape o a b c).2.1 (shape o a b c).2.2=median a b c := by
  cases o <;> simp only [shape,median] <;> omega
theorem sorted_shape (a b c : ℕ) :
    let s:=shape (sortOrder a b c) a b c
    s.1 ≤ s.2.1 ∧ s.2.1 ≤ s.2.2 := by
  simp only [sortOrder]
  split_ifs <;> simp_all [shape] <;> omega
theorem sorted_middle_median (a b c : ℕ) :
    (shape (sortOrder a b c) a b c).2.1=median a b c := by
  have hs:=sorted_shape a b c
  have hm:=shape_median (sortOrder a b c) a b c
  dsimp at hs
  rw [←hm]
  simp only [median,min_eq_left hs.2,min_eq_left hs.1,max_eq_right hs.2,
    max_eq_right (le_trans hs.1 hs.2)]
  omega
theorem shape_positive (o : Order) (ha : 0<a) (hb : 0<b) (hc : 0<c) :
    0<(shape o a b c).1 ∧ 0<(shape o a b c).2.1 ∧ 0<(shape o a b c).2.2 := by
  cases o <;> simp_all [shape]
end Mathproof.Problem18TensorSorting20261001
