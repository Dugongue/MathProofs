    apply LinearMap.ext_basis (Pi.basisFun K (Fin n)) (Pi.basisFun K (Fin n))
    intro i j
    simpa only [LinearMap.comp_apply,Pi.basisFun_apply] using hentry i j
  apply Subtype.ext
  apply LinearMap.ext
  intro x
  apply (formEquiv τ B hB).injective
  exact DFunLike.congr_fun hform x
theorem selfAdjoint_card_exact (hτ : Function.Involutive τ) (heps : eps*τ eps=1)
    (B : Form (V := Fin n → K) τ) (hB : B.SeparatingLeft)
    (hsym : ∀ x y,B y x=eps*τ (B x y)) :
    Nat.card (selfAdjointSpace τ B)=
      Nat.card K^n.choose 2*Nat.card (diagonalSpace τ eps)^n := by
  let e := Equiv.ofBijective
    (mixedCoordinates τ eps B hsym (LinearMap.id : Module.End K (Fin n → K))
      Finset.univ Finset.univ)
    ⟨fullCoordinates_injective τ eps B hB hsym,
      mixedCoordinates_surjective τ eps hτ heps B hB hsym _ Function.injective_id _ _⟩
  have hc := Nat.card_congr e
  simpa only [Nat.card_eq_fintype_card,Fintype.card_prod,Fintype.card_fun,
    Fintype.card_coe,Finset.card_univ,Fintype.card_fin,Upper,
    Mathproof.Problem18AlternatingCounts20260930.card_strictPairs] using hc
theorem symmetric_card_exact (B : LinearMap.BilinForm K (Fin n → K))
    (hB : B.SeparatingLeft) (hsym : ∀ x y,B y x=B x y) :
    Nat.card (selfAdjointSpace (RingEquiv.refl K) B)=Nat.card K^(n.choose 2+n) := by
  have hc := selfAdjoint_card_exact (RingEquiv.refl K) (1:K) (fun _ => rfl) (by simp)
    B hB (by simpa only [one_mul,RingEquiv.refl_apply] using hsym)
  rw [diagonalSpace_id_card,← pow_add] at hc
  exact hc
theorem hermitian_card_exact (hτ : Function.Involutive τ) (hne : τ ≠ 1)
    (q : ℕ) (hq : Nat.card K=q^2) (B : Form (V := Fin n → K) τ)
    (hB : B.SeparatingLeft) (hsym : ∀ x y,B y x=τ (B x y)) :
    Nat.card (selfAdjointSpace τ B)=q^(n*n) := by
  have hc := selfAdjoint_card_exact τ (1:K) hτ (by simp)
    B hB (by simpa only [one_mul] using hsym)
  rw [diagonalSpace_quadratic_card τ hτ hne q hq,hq,← pow_mul,← pow_add] at hc
  have he : 2*n.choose 2+n=n*n := by
    clear B hB hsym hc
    induction n with
    | zero => norm_num
    | succ n ih =>
      rw [Nat.choose_succ_succ,Nat.choose_one_right]
      nlinarith
  simpa only [he] using hc
end
