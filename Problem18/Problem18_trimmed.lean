def bitAssigns (x : String) : Com → Bool
  | .assign y e => if y = x then (match e with | .lit v => decide (v ≤ 1) | _ => false) else true
  | .read y => !(decide (y = x))
  | .seq c d => bitAssigns x c && bitAssigns x d
  | .ite _ c d => bitAssigns x c && bitAssigns x d
  | .while _ c => bitAssigns x c
  | _ => true
theorem bigStep_bit {x : String} : ∀ {c : Com} {σ τ : Env} {k : Nat}, BigStep c σ τ k →
    bitAssigns x c = true → σ.vars x ≤ 1 → τ.vars x ≤ 1 := by
  intro c σ τ k h
  induction h with
  | skip => exact fun _ h => h
  | @assign σ y e v he =>
    intro hb h1
    simp only [Env.setVar]
    by_cases hy : x = y
    · subst hy
      simp only [bitAssigns, if_true] at hb
      rw [if_pos rfl]
      cases e with
      | lit w =>
        simp only [decide_eq_true_eq] at hb
        simp [Expr.eval] at he; omega
      | _ => simp at hb
    · rw [if_neg hy]; exact h1
  | store => exact fun _ h => h
  | seq _ _ ih1 ih2 =>
    intro hb h1
    simp only [bitAssigns, Bool.and_eq_true] at hb
    exact ih2 hb.2 (ih1 hb.1 h1)
  | ite_true _ _ ih =>
    intro hb h1
    simp only [bitAssigns, Bool.and_eq_true] at hb
    exact ih hb.1 h1
  | ite_false _ _ ih =>
    intro hb h1
    simp only [bitAssigns, Bool.and_eq_true] at hb
    exact ih hb.2 h1
  | while_true _ _ _ ih1 ih2 =>
    intro hb h1
    exact ih2 hb (ih1 (by simpa [bitAssigns] using hb) h1)
  | while_false => exact fun _ h => h
  | @read σ y v rest hin =>
    intro hb h1
    simp only [bitAssigns, Bool.not_eq_true', decide_eq_false_iff_not] at hb
    show (σ.setVar y v).vars x ≤ 1
    simp only [Env.setVar, if_neg (Ne.symm hb)]; exact h1
  | write => exact fun _ h => h
theorem run_bit {B K : Nat} {c : Com} {σ τ : Env} {x : String} (h : Run B c σ τ K)
    (hb : bitAssigns x c = true) (h1 : σ.vars x ≤ 1) : τ.vars x ≤ 1 := by
  obtain ⟨k, -, hk⟩ := h.bigStep
  exact bigStep_bit hk hb h1
end Mathproof.Problem18PairLargeFlag20261004
