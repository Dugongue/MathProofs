set_option backward.isDefEq.respectTransparency false
abbrev SelfAdjointOperators (B : Form σ V) :=
  {T : Module.End K V // ∀ x y,B (T x) y=B x (T y)}
abbrev PreservedFirst (B : Form σ V) (C : Form σ W) :=
  {T : SelfAdjointOperators σ (sumForm σ B C) // ∀ x,(T.val (x,0)).2=0}
noncomputable def firstOperator (B : Form σ V) (C : Form σ W)
    (T : PreservedFirst σ B C) : SelfAdjointOperators σ B :=
  ⟨(LinearMap.fst K V W).comp (T.val.val.comp (LinearMap.inl K V W)),by
    intro x y
    have h := T.val.property (x,0) (y,0)
    simpa [sumForm_apply] using h⟩
noncomputable def secondOperator (B : Form σ V) (C : Form σ W)
    (T : PreservedFirst σ B C) : SelfAdjointOperators σ C :=
  ⟨(LinearMap.snd K V W).comp (T.val.val.comp (LinearMap.inr K V W)),by
    intro x y
    have h := T.val.property (0,x) (0,y)
    simpa [sumForm_apply] using h⟩
theorem preservedFirst_first_zero (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingLeft) (T : PreservedFirst σ B C) (w : W) :
    (T.val.val (0,w)).1=0 := by
  apply hB
  intro x
  have h := T.val.property (0,w) (x,0)
  simpa [sumForm_apply,T.property x] using h
theorem block_formula (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingLeft) (T : PreservedFirst σ B C) (x : V) (w : W) :
    T.val.val (x,w)=((firstOperator σ B C T).val x,(secondOperator σ B C T).val w) := by
  have hl : T.val.val (x,0)=((firstOperator σ B C T).val x,0) :=
    Prod.ext rfl (T.property x)
  have hr : T.val.val (0,w)=(0,(secondOperator σ B C T).val w) :=
    Prod.ext (preservedFirst_first_zero σ B C hB T w) rfl
  have h := T.val.val.map_add (x,0) (0,w)
  simpa only [Prod.mk_add_mk,add_zero,zero_add,hl,hr] using h
noncomputable def combineOperators (B : Form σ V) (C : Form σ W)
    (A : SelfAdjointOperators σ B) (D : SelfAdjointOperators σ C) : PreservedFirst σ B C :=
  ⟨⟨A.val.prodMap D.val,by
    intro x y
    change B (A.val x.1) y.1+C (D.val x.2) y.2=B x.1 (A.val y.1)+C x.2 (D.val y.2)
    rw [A.property,D.property]⟩,by intro x; exact map_zero D.val⟩
noncomputable def blockEquiv (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft) :
    PreservedFirst σ B C ≃ (SelfAdjointOperators σ B × SelfAdjointOperators σ C) where
  toFun T := (firstOperator σ B C T,secondOperator σ B C T)
  invFun P := combineOperators σ B C P.1 P.2
  left_inv T := by
    apply Subtype.ext
    apply Subtype.ext
    apply LinearMap.ext
    rintro ⟨x,w⟩
    exact (block_formula σ B C hB T x w).symm
  right_inv P := by
    apply Prod.ext
    · apply Subtype.ext; apply LinearMap.ext; intro x; rfl
    · apply Subtype.ext; apply LinearMap.ext; intro w; rfl
noncomputable def fixedFirstEquiv (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingLeft) (A : SelfAdjointOperators σ B) :
    {T : PreservedFirst σ B C // firstOperator σ B C T=A} ≃ SelfAdjointOperators σ C where
  toFun T := secondOperator σ B C T.val
  invFun D := ⟨combineOperators σ B C A D,by apply Subtype.ext; ext x; rfl⟩
  left_inv T := by
    apply Subtype.ext
    apply (blockEquiv σ B C hB).injective
    apply Prod.ext
    · exact T.property.symm
    · rfl
  right_inv D := by apply Subtype.ext; ext x; rfl
end
