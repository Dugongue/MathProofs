    (boxPoly n d (fun j => algebraMap K L (rowData n d rows r j))).totalDegree ≤ d := by
  rw [← boxPoly_map]
  refine (Finset.sup_mono (support_map_subset _ _)).trans ?_
  by_cases hr : r.val < (compress rows).1.length
  · have hmem := compress_mem rows _ (List.getElem_mem hr)
    obtain ⟨f, hf⟩ := valid_of_mem h _ hmem
    rw [rowData_of_lt n d rows r hr, boxPoly_read_valid _ _ hf]
    exact hf.1
  · rw [rowData_of_ge n d rows r hr, boxPoly_zero]
    simp
theorem geometricIdeal_eq_of_span {L : Type*} [Field L] [Algebra K L] {n : ℕ}
