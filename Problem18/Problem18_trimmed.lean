  have hvu := hm u (by simp); have hvq := hm q (by simp); have hvp := hm p (by simp)
  have hve := hm e (by simp); have hva := hm a (by simp); have hvb := hm b (by simp)
  have hvc := hm c (by simp)
  have hab : a*b ≤ N := by
    have : a*b ≤ a*b*c := Nat.le_mul_of_pos_right _ hc
    have : a*b*c ≤ a*b*c*e := Nat.le_mul_of_pos_right _ he
    omega
  have habc : a*b*c ≤ N := by
    have : a*b*c ≤ a*b*c*e := Nat.le_mul_of_pos_right _ he
    omega
  have hcells : cells.evalB W σ = some N := by
    simp [cells, qw, Expr.evalB, fit, hq, hva, hvb, hvc, hve, show 5 < W by omega,
      show 6 < W by omega, show 7 < W by omega, show 8 < W by omega,
      show a*b < W by omega, show a*b*c < W by omega, show a*b*c*e < W by omega,
      show e + a*b*c*e < W by omega, hN]
  have h0 : (Expr.add (.lit 10) cells).evalB W σ = some (10 + N) := by
    simp only [Expr.evalB, hcells]; simp [fit, show 10 < W by omega, show 10 + N < W by omega]
  have hlen0 : (σ.arrs sA).length = 11 + N := by simp [hs]
  have s0 : Run W (.store sA (.lit 0) (.add (.lit 10) cells)) σ (σ.setArr sA 0 (10+N))
      (1 + 1 + (Expr.add (.lit 10) cells).size) :=
    Run.store (evalB_lit' (by omega)) h0 (by omega)
  let σ0 := σ.setArr sA 0 (10+N)
