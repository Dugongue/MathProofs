section Cands
abbrev childBox (n d : ℕ) : ℕ := boxSize n (collDeg n d)
@[irreducible]
def childTemplate (n d : ℕ) (pat : Σ k : ℕ, Fin k → Fin (childBox n d)) :
    Formula ℤ (boxSize n d * boxSize n d + pat.1 * childBox n d) :=
  chiF n d (collDeg n d) (boxSize n d) pat.2
abbrev Cand (n d : ℕ) := Σ pat : (Σ k : ℕ, Fin k → Fin (childBox n d)),
  Clause (Fin (boxSize n d * boxSize n d + pat.1 * childBox n d)) ℤ
def childCands (n d : ℕ) : List (Cand n d) :=
  (patterns (childBox n d)).flatMap fun pat =>
    (clauses (qe (childTemplate n d pat))).map fun c => ⟨pat, c⟩
theorem mem_childCands {n d : ℕ} (pat : Σ k : ℕ, Fin k → Fin (childBox n d))
    (c : Clause (Fin (boxSize n d * boxSize n d + pat.1 * childBox n d)) ℤ)
    (hpat : pat ∈ patterns (childBox n d)) (hc : c ∈ clauses (qe (childTemplate n d pat))) :
    (⟨pat, c⟩ : Cand n d) ∈ childCands n d := by
  simp only [childCands, List.mem_flatMap, List.mem_map]
  exact ⟨pat, hpat, c, hc, rfl⟩
theorem of_mem_childCands {n d : ℕ} (pc : Cand n d) (h : pc ∈ childCands n d) :
    pc.1 ∈ patterns (childBox n d) ∧ pc.2 ∈ clauses (qe (childTemplate n d pc.1)) := by
  simp only [childCands, List.mem_flatMap, List.mem_map] at h
  obtain ⟨pat, hpat, c, hc, rfl⟩ := h
  exact ⟨hpat, hc⟩
theorem patterns_le {c : ℕ} (pat : Σ k : ℕ, Fin k → Fin c) (h : pat ∈ patterns c) :
    pat.1 ≤ c := by
  simp only [patterns, List.mem_flatMap, List.mem_range, List.mem_map] at h
  obtain ⟨k, hk, S, -, rfl⟩ := h
  exact Nat.lt_succ_iff.mp hk
theorem isCB_pivots_injective {L : Type*} [Field L] {s k : ℕ} (n d D : ℕ)
    (F : Fin s → Fin (boxSize n d) → L) (S : Fin k → Fin (boxSize n D))
    (U : Fin k → Fin (boxSize n D) → L) (h : IsCB n d D F S U) : Function.Injective S := by
  intro j j' hjj
  have h1 := h.1 j j
  have h2 := h.1 j j'
  rw [← hjj, h1] at h2
  by_contra hne
  rw [if_neg hne, if_pos rfl] at h2
  exact one_ne_zero h2
end Cands
section Child
variable {K : Type*} [Field K] [DecidableEq K] [Fintype K]
def candRun (n d : ℕ) (a : Fin (boxSize n d * boxSize n d) → K) (pc : Cand n d) : Bool × ℕ :=
  clauseRun pc.2 a
def childRowsOf {n d : ℕ} (k : ℕ) (u : Fin (k * childBox n d) → K) :
    List (DenseInput n (collDeg n d) K) :=
  List.ofFn fun i => Vector.ofFn (unflat u i)
def childFrom (n d : ℕ) (a : Fin (boxSize n d * boxSize n d) → K) (pc : Cand n d) :
    List (DenseInput n (collDeg n d) K) × ℕ :=
  let e := extractPoint (Fintype.card K) (clauseDeg pc.2) ((clauseRows pc.2 a).map Prod.fst)
  (childRowsOf pc.1.1 (Fin.init e.1), e.2)
def child (n d : ℕ) (rows : List (DenseInput n d K)) :
    List (DenseInput n (collDeg n d) K) × ℕ :=
  let a := flatData (rowData n d rows)
  let cost := (compress rows).2 + ((childCands n d).map fun pc => (candRun n d a pc).2).sum
  match (childCands n d).find? (fun pc => (candRun n d a pc).1) with
  | some pc => ((childFrom n d a pc).1, cost + (childFrom n d a pc).2)
  | none => ([], cost)
theorem unflat_algebraMap_flatData {L : Type*} [Field L] [Algebra K L] {s c : ℕ}
    (F : Fin s → Fin c → K) :
    unflat (fun t => algebraMap K L (flatData F t)) = fun r j => algebraMap K L (F r j) := by
  funext r j
  simp only [unflat, flatData, Equiv.symm_apply_apply]
theorem template_finite {L : Type*} [Field L] [Algebra K L] (n d : ℕ)
    (pat : Σ k : ℕ, Fin k → Fin (childBox n d)) (FK : Fin (boxSize n d) → Fin (boxSize n d) → K) :
    {u : Fin (pat.1 * childBox n d) → L | (childTemplate n d pat).Holds (Int.castRingHom L)
      (Fin.append (fun i => algebraMap K L (flatData FK i)) u)}.Finite := by
  apply Set.Subsingleton.finite
  intro u hu u' hu'
  simp only [Set.mem_setOf_eq] at hu hu'
  rw [childTemplate, holds_chi, unflat_algebraMap_flatData] at hu hu'
  exact unflat_injective (isCB_unique _ _ _ _ _ _ _ hu hu')
theorem childFrom_spec {L : Type*} [Field L] [Algebra K L] [IsAlgClosed L]
    [Algebra.IsAlgebraic K L] (n d : ℕ) (FK : Fin (boxSize n d) → Fin (boxSize n d) → K)
    (pc : Cand n d) (hpc : pc ∈ childCands n d)
    (hrun : (candRun n d (flatData FK) pc).1 = true) :
    ∃ UK : Fin pc.1.1 → Fin (childBox n d) → K,
      (childFrom n d (flatData FK) pc).1 = List.ofFn (fun i => Vector.ofFn (UK i)) ∧
      IsCB n d (collDeg n d) (fun r j => algebraMap K L (FK r j)) pc.1.2
        (fun i j => algebraMap K L (UK i j)) := by
  classical
  obtain ⟨-, hc⟩ := of_mem_childCands pc hpc
  have hfin := clause_locus_finite (L := L) _ pc.2 hc (flatData FK) (template_finite n d pc.1 FK)
  rw [candRun, clauseRun_correct (L := L) pc.2 (flatData FK) hfin] at hrun
  obtain ⟨y, hy⟩ := (exists_sys_zero_iff pc.2 (flatData FK)).mpr hrun
  have hyroot : ∀ f ∈ clausePolys pc.2 (flatData FK), eval y f = 0 := by
    intro f hf
    simp only [clausePolys, List.mem_map] at hf
    obtain ⟨p, hp, rfl⟩ := hf
    rw [eval_clausePoly]
    exact hy p hp
  have hroot_cb : ∀ x : Fin (pc.1.1 * childBox n d + 1) → L,
      (∀ f ∈ clausePolys pc.2 (flatData FK), aeval x f = 0) →
      IsCB n d (collDeg n d) (fun r j => algebraMap K L (FK r j)) pc.1.2 (unflat (Fin.init x)) ∧
        x (Fin.last _) * interpret (Int.castRingHom L)
          (Fin.append (fun i => algebraMap K L (flatData FK i)) (Fin.init x))
          (exprProduct (nonzeroExpressions pc.2)) = 1 := by
    intro x hx
    have hsys : ∀ p ∈ sysExprs pc.2, interpret (Int.castRingHom L)
        (Sum.elim (fun i => algebraMap K L (flatData FK i)) x) p = 0 := by
      intro p hp
      rw [← aeval_clausePoly]
      apply hx
      simp only [clausePolys, List.mem_map]
      exact ⟨p, hp, rfl⟩
    obtain ⟨hcl, hprod⟩ := (sysExprs_zero_iff pc.2 _ x).mp hsys
    have hhold : (childTemplate n d pc.1).Holds (Int.castRingHom L)
        (Fin.append (fun i => algebraMap K L (flatData FK i)) (Fin.init x)) := by
      rw [← qe_correct, ← clauses_correct]
      exact ⟨pc.2, hc, hcl⟩
    rw [childTemplate, holds_chi, unflat_algebraMap_flatData] at hhold
    exact ⟨hhold, hprod⟩
  have hyL : ∀ f ∈ clausePolys pc.2 (flatData FK), aeval (fun i => algebraMap K L (y i)) f = 0 := by
    intro f hf
    rw [show (fun i => algebraMap K L (y i)) = algebraMap K L ∘ y from rfl,
      MvPolynomial.aeval_algebraMap_apply, aeval_self, hyroot f hf, map_zero]
  have huniq : ∀ x : Fin (pc.1.1 * childBox n d + 1) → L,
      (∀ f ∈ clausePolys pc.2 (flatData FK), aeval x f = 0) →
        x = fun i => algebraMap K L (y i) := by
    intro x hx
    obtain ⟨h1, h1p⟩ := hroot_cb x hx
    obtain ⟨h2, h2p⟩ := hroot_cb _ hyL
    have hinit : Fin.init x = Fin.init (fun i => algebraMap K L (y i)) :=
      unflat_injective (isCB_unique _ _ _ _ _ _ _ h1 h2)
    have hlast : x (Fin.last _) = algebraMap K L (y (Fin.last _)) := by
      rw [hinit] at h1p
      exact mul_right_cancel₀ (right_ne_zero_of_mul_eq_one h2p) (h1p.trans h2p.symm)
    rw [← Fin.snoc_init_self x, hinit, hlast]
    exact Fin.snoc_init_self _
  have hext := extractPoint_eq (L := L) (Fintype.card K) (clauseDeg pc.2) rfl
    ((clauseRows pc.2 (flatData FK)).map Prod.fst) (clausePolys pc.2 (flatData FK))
    (clauseRows_valid pc.2 (flatData FK)) y hyroot huniq
  refine ⟨unflat (Fin.init y), ?_, ?_⟩
  · simp only [childFrom, hext, childRowsOf]
  · exact (hroot_cb _ hyL).1
theorem exists_passing {L : Type*} [Field L] [Algebra K L] [IsAlgClosed L]
    [Algebra.IsAlgebraic K L] (n d : ℕ) (FK : Fin (boxSize n d) → Fin (boxSize n d) → K) :
    ∃ pc ∈ childCands n d, (candRun n d (flatData FK) pc).1 = true := by
  classical
  obtain ⟨k, S, U, hU⟩ := exists_isCB (L := L) n d (collDeg n d)
    (fun r j => algebraMap K L (FK r j))
  have hk : k ≤ childBox n d := by
    simpa using Fintype.card_le_of_injective S (isCB_pivots_injective _ _ _ _ _ _ hU)
  have hrat := isCB_rational n d (collDeg n d) FK S U hU
  choose UK hUK using hrat
  have hhold : (childTemplate n d ⟨k, S⟩).Holds (Int.castRingHom L)
      (Fin.append (fun t => algebraMap K L (flatData FK t))
        (fun t => algebraMap K L (flatData UK t))) := by
    rw [childTemplate, holds_chi, unflat_algebraMap_flatData, unflat_algebraMap_flatData]
    have hUeq : (fun i j => algebraMap K L (UK i j)) = U := by
      funext i j
      exact hUK i j
    rw [hUeq]
    exact hU
  rw [← append_map, ← qe_clauses_correct] at hhold
  obtain ⟨c, hc, hcl⟩ := hhold
  refine ⟨⟨⟨k, S⟩, c⟩, mem_childCands _ _ (mem_patterns S hk) hc, ?_⟩
  rw [candRun, clauseRun_correct (L := L) c (flatData FK)
    (clause_locus_finite _ c hc _ (template_finite n d ⟨k, S⟩ FK))]
  exact ⟨flatData UK, (clauseHolds_map (algebraMap K L) _ c).mp hcl⟩
theorem valid_child_row {L : Type*} [Field L] [Algebra K L] (n d : ℕ) {s : ℕ}
    (F : Fin s → Fin (boxSize n d) → L) (v : Fin (childBox n d) → K)
    (hv : InW n d (collDeg n d) F (fun j => algebraMap K L (v j))) :
    ValidDenseInput (collDeg n d) (Vector.ofFn v : DenseInput n (collDeg n d) K)
      (boxPoly n (collDeg n d) v) := by
  refine ⟨totalDegree_boxPoly_low n _ v fun j hj => ?_, fun j => ?_⟩
  · exact (map_eq_zero_iff _ (algebraMap K L).injective).mp (hv.1 j hj)
  · rw [Vector.getElem_ofFn]
    exact (coeff_boxPoly n _ v j).symm
theorem child_spec {L : Type*} [Field L] [Algebra K L] [IsAlgClosed L]
    [Algebra.IsAlgebraic K L] (n d : ℕ) (rows : List (DenseInput n d K))
    (fs : List (MvPolynomial (Fin n) K)) (h : List.Forall₂ (ValidDenseInput d) rows fs) :
    ∃ gs : List (MvPolynomial (Fin n) K),
      List.Forall₂ (ValidDenseInput (collDeg n d)) (child n d rows).1 gs ∧
      (geometricIdeal (L := L) {g | g ∈ gs}).radical =
        (collisionIdeal (geometricIdeal (L := L) {f | f ∈ fs})).radical := by
  classical
  obtain ⟨pc, hfind⟩ : ∃ pc, (childCands n d).find?
      (fun pc => (candRun n d (flatData (rowData n d rows)) pc).1) = some pc := by
    cases hf : (childCands n d).find?
        (fun pc => (candRun n d (flatData (rowData n d rows)) pc).1) with
    | none =>
      exfalso
      rw [List.find?_eq_none] at hf
      obtain ⟨pc, hpc, hr⟩ := exists_passing (L := L) n d (rowData n d rows)
      exact hf pc hpc (by simpa using hr)
    | some pc => exact ⟨pc, rfl⟩
  have hpc := List.mem_of_find?_eq_some hfind
  have hrun : (candRun n d (flatData (rowData n d rows)) pc).1 = true := by
    simpa using List.find?_some hfind
  obtain ⟨UK, hrows, hCB⟩ := childFrom_spec (L := L) n d (rowData n d rows) pc hpc hrun
  have hchild : (child n d rows).1 = List.ofFn (fun i => Vector.ofFn (UK i)) := by
    simp only [child, hfind]
    exact hrows
  refine ⟨List.ofFn fun i => boxPoly n (collDeg n d) (UK i), ?_, ?_⟩
  · rw [hchild, List.ofFn_eq_map, List.ofFn_eq_map, List.forall₂_map_left_iff,
      List.forall₂_map_right_iff, List.forall₂_same]
    intro i _
    exact valid_child_row n d _ (UK i) (hCB.2.1 i)
  · rw [geometricIdeal_eq_of_span _ _ (rowData_ideal n d rows fs h), geometricIdeal_rowSys]
    have hg : geometricIdeal (L := L) {g | g ∈ List.ofFn fun i => boxPoly n (collDeg n d) (UK i)} =
        Ideal.span (rowSys n (collDeg n d) (fun i j => algebraMap K L (UK i j)) :
          Set (MvPolynomial (Fin n) L)) := by
      rw [← geometricIdeal_rowSys]
      congr 1
      ext g
      simp only [Set.mem_setOf_eq, List.mem_ofFn, Set.mem_range]
    rw [hg]
    exact radical_isCB n d _ (rowData_degree n d rows fs h) pc.1.2 _ hCB
theorem child_length (n d : ℕ) (rows : List (DenseInput n d K)) :
    (child n d rows).1.length ≤ childBox n d := by
  classical
  simp only [child]
  split
  · next pc hfind =>
    simp only [childFrom, childRowsOf, List.length_ofFn]
    exact patterns_le _ (of_mem_childCands pc (List.mem_of_find?_eq_some hfind)).1
  · exact Nat.zero_le _
end Child
section Cost
variable {K : Type*} [Field K] [DecidableEq K] [Fintype K]
def candConst {n d : ℕ} (pc : Cand n d) : ℕ :=
  clauseConst pc.2 + extractConst (pc.1.1 * childBox n d + 1) (clauseDeg pc.2) (sysExprs pc.2).length
def childConst (n d : ℕ) : ℕ := ((childCands n d).map fun pc => candConst pc).sum
def childBudget (n d r : ℕ) : ℕ := r * testBudget (boxSize n d) + childConst n d
theorem childBudget_mono (n d r r' : ℕ) (h : r ≤ r') : childBudget n d r ≤ childBudget n d r' :=
  Nat.add_le_add_right (Nat.mul_le_mul_right _ h) _
theorem childFrom_cost (n d : ℕ) (a : Fin (boxSize n d * boxSize n d) → K) (pc : Cand n d) :
    (childFrom n d a pc).2 ≤ extractConst (pc.1.1 * childBox n d + 1) (clauseDeg pc.2)
      (sysExprs pc.2).length * (Nat.size (Fintype.card K) + 1) := by
  refine extractPoint_cost _ _ _ _ ?_
  simp [clauseRows]
theorem runs_cost (n d : ℕ) (a : Fin (boxSize n d * boxSize n d) → K) :
    ((childCands n d).map fun pc => (candRun n d a pc).2).sum ≤
      ((childCands n d).map fun pc => clauseConst pc.2).sum * (Nat.size (Fintype.card K) + 1) := by
  rw [← List.sum_map_mul_right]
  exact List.sum_le_sum fun pc _ => clauseRun_cost_le pc.2 a
theorem child_cost (n d : ℕ) (rows : List (DenseInput n d K)) :
    (child n d rows).2 ≤ childBudget n d rows.length * (Nat.size (Fintype.card K) + 1) := by
  classical
  have hcomp : (compress rows).2 ≤ rows.length * testBudget (boxSize n d) *
      (Nat.size (Fintype.card K) + 1) :=
    (compress_cost rows).trans (Nat.le_mul_of_pos_right _ (Nat.succ_pos _))
  have hruns := runs_cost n d (flatData (rowData n d rows))
  have hsplit : ((childCands n d).map fun pc => clauseConst pc.2).sum ≤ childConst n d := by
    unfold childConst candConst
    exact List.sum_le_sum fun pc _ => Nat.le_add_right _ _
  have hsum : ((childCands n d).map fun pc => clauseConst pc.2).sum +
      ((childCands n d).map fun pc => extractConst (pc.1.1 * childBox n d + 1) (clauseDeg pc.2)
        (sysExprs pc.2).length).sum = childConst n d := by
    unfold childConst candConst
    rw [← List.sum_map_add]
  simp only [child]
  split
  · next pc hfind =>
    have hpc := List.mem_of_find?_eq_some hfind
    have hext := childFrom_cost n d (flatData (rowData n d rows)) pc
    have hone : extractConst (pc.1.1 * childBox n d + 1) (clauseDeg pc.2) (sysExprs pc.2).length ≤
        ((childCands n d).map fun pc => extractConst (pc.1.1 * childBox n d + 1)
          (clauseDeg pc.2) (sysExprs pc.2).length).sum :=
      List.single_le_sum (fun _ _ => Nat.zero_le _) _ (List.mem_map_of_mem hpc)
    rw [childBudget, ← hsum]
    nlinarith [hcomp, hruns, hext, hone, Nat.zero_le (Nat.size (Fintype.card K))]
  · rw [childBudget]
    nlinarith [hcomp, hruns, hsplit, Nat.zero_le (Nat.size (Fintype.card K))]
end Cost
