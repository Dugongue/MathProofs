variable (k F : Type) [Field k] [Field F] [Fintype k]
  [Algebra k F] [Algebra k[X] F] [Algebra k⟮X⟯ F] [IsScalarTower k k[X] F]
  [IsScalarTower k[X] k⟮X⟯ F] [_root_.FunctionField k F]
  [Algebra.IsSeparable k⟮X⟯ F] [FunctionField.IsFullConstantField k F]
theorem half_power_le (p a n : ℕ) (hp : 1 ≤ p) :
    ((p : ℝ))^(a*n - a*n/2) ≤ Real.sqrt p * Real.sqrt ((p : ℝ)^a) ^ n := by
  have hp0 : (0 : ℝ) ≤ p := Nat.cast_nonneg p
  have hp1 : (1 : ℝ) ≤ p := by exact_mod_cast hp
  have hR : 0 ≤ Real.sqrt p * Real.sqrt ((p : ℝ)^a) ^ n :=
    mul_nonneg (Real.sqrt_nonneg _) (pow_nonneg (Real.sqrt_nonneg _) _)
  apply (pow_le_pow_iff_left₀ (pow_nonneg hp0 _) hR two_ne_zero).mp
  have h1 : Real.sqrt (p : ℝ) ^ 2 = p := Real.sq_sqrt hp0
  have h2 : Real.sqrt ((p : ℝ)^a) ^ 2 = (p : ℝ)^a := Real.sq_sqrt (pow_nonneg hp0 _)
  have hsq : (Real.sqrt p * Real.sqrt ((p : ℝ)^a) ^ n)^2 = (p : ℝ)^(a*n+1) := by
    calc (Real.sqrt p * Real.sqrt ((p : ℝ)^a) ^ n)^2
        = Real.sqrt (p : ℝ) ^ 2 * (Real.sqrt ((p : ℝ)^a) ^ 2) ^ n := by ring
      _ = (p : ℝ) * ((p : ℝ)^a) ^ n := by rw [h1, h2]
      _ = (p : ℝ)^(a*n+1) := by rw [← pow_mul, pow_succ, mul_comm]
  rw [hsq, ← pow_mul]
  apply pow_le_pow_right₀ hp1
  generalize a*n = t
  omega
theorem eventual_two_sided_error :
    ∃ C : ℝ, ∃ N : ℕ, ∀ n : ℕ, N ≤ n →
      ‖(closedPointSum k F n : ℂ) - ((Nat.card k : ℂ)^n + 1)‖ ≤
        C * Real.sqrt (Nat.card k) ^ n := by
  classical
  haveI := ratFuncTower k F
  obtain ⟨p, hchar⟩ : ∃ p, CharP k p := ⟨ringChar k, inferInstance⟩
  haveI := hchar
  obtain ⟨a', hpr, hcard⟩ := FiniteField.card k p
  haveI : Fact p.Prime := ⟨hpr⟩
  set a : ℕ := (a' : ℕ) with ha_def
  have ha : 1 ≤ a := a'.pos
  have hq : Fintype.card k = p^a := hcard
  have hp1 : 1 < p := hpr.one_lt
  set g := coverGenus k F with hg
  set D := coverDegree k F with hDdef
  have hD1 : 1 ≤ D := coverDegree_pos k F
  refine ⟨(D : ℝ) * (2*g+3) * Real.sqrt p, 2*(g+2)^2 + 1, fun n hn => ?_⟩
  have hn0 : 0 < n := lt_of_lt_of_le (Nat.succ_pos _) hn
  have ht : (g + 2)^2 < p^((a*n)/2) := by
    have hle : n ≤ a*n := Nat.le_mul_of_pos_left n ha
    have h1 : (g + 2)^2 ≤ (a*n)/2 := by
      generalize (g + 2)^2 = G at hn ⊢
      generalize a*n = an at hle ⊢
      omega
    exact lt_of_le_of_lt h1 (Nat.lt_pow_self hp1)
  obtain ⟨hup, hlow⟩ := level_bounds k F p a hq n hn0 ht
  set S := closedPointSum k F n
  set e := a*n - a*n/2
  have hqn : (Nat.card k : ℝ)^n = (p : ℝ)^(a*n) := by
    rw [Nat.card_eq_fintype_card, hq]
    push_cast
    rw [← pow_mul]
  have hupR : (S : ℝ) ≤ (Nat.card k : ℝ)^n + (2*g+3) * (p : ℝ)^e := by
    rw [hqn]
    exact_mod_cast hup
  have hlowR : (Nat.card k : ℝ)^n + 1 ≤ S + (D - 1 : ℝ) * ((2*g+3) * (p : ℝ)^e) := by
    rw [hqn]
    have h := hlow
    have h' : ((p^(a*n) + 1 : ℕ) : ℝ) ≤ ((S + (D - 1)*((2*g+3)*p^e) : ℕ) : ℝ) :=
      by exact_mod_cast h
    push_cast [Nat.cast_sub hD1] at h'
    linarith
  have hpe : (p : ℝ)^e ≤ Real.sqrt p * Real.sqrt (Nat.card k) ^ n := by
    have h := half_power_le p a n hp1.le
    rw [Nat.card_eq_fintype_card, hq]
    push_cast
    exact h
  have hB : 0 ≤ (2*g+3 : ℝ) * (p : ℝ)^e := by positivity
  have hD1R : (1 : ℝ) ≤ D := by exact_mod_cast hD1
  have hnorm : ‖(S : ℂ) - ((Nat.card k : ℂ)^n + 1)‖ =
      |(S : ℝ) - ((Nat.card k : ℝ)^n + 1)| := by
    have he : (S : ℂ) - ((Nat.card k : ℂ)^n + 1) =
        (((S : ℝ) - ((Nat.card k : ℝ)^n + 1) : ℝ) : ℂ) := by push_cast; ring
    rw [he, Complex.norm_real, Real.norm_eq_abs]
  rw [hnorm, abs_le]
  have hbig : (2*g+3 : ℝ) * (p : ℝ)^e ≤ (2*g+3) * (Real.sqrt p * Real.sqrt (Nat.card k) ^ n) :=
    mul_le_mul_of_nonneg_left hpe (by positivity)
  have hfin : (D : ℝ) * ((2*g+3) * (p : ℝ)^e) ≤
      (D : ℝ) * (2*g+3) * Real.sqrt p * Real.sqrt (Nat.card k) ^ n := by
    have := mul_le_mul_of_nonneg_left hbig (by positivity : (0 : ℝ) ≤ D)
    linarith
  constructor
  · nlinarith [mul_nonneg (sub_nonneg.mpr hD1R) hB, hfin, hupR, hlowR]
  · nlinarith [mul_nonneg (sub_nonneg.mpr hD1R) hB, hfin, hupR, hlowR]
theorem weil_closed_point (n : ℕ) (hn : n ≠ 0) :
    ‖(closedPointSum k F n : ℂ) - ((Nat.card k : ℂ)^n + 1)‖ ≤
      (2 * genus k F : ℕ) * Real.sqrt (Nat.card k) ^ n := by
  obtain ⟨C, N, hb⟩ := eventual_two_sided_error k F
  have hq1 : 1 < Nat.card k := by
    rw [Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  have hR : 0 < Real.sqrt (Nat.card k) := Real.sqrt_pos.mpr (by exact_mod_cast (by omega : 0 < Nat.card k))
  have hRq : Real.sqrt (Nat.card k) < (Nat.card k : ℝ) :=
    Real.sqrt_lt_self_iff.mpr (by exact_mod_cast hq1)
  exact closed_point_uniform_error_of_eventual k F (Real.sqrt (Nat.card k)) C hR hRq N hb n hn
theorem degree_one_card_eq :
    Nat.card {P : Place k F // P.degree = 1} = closedPointSum k F 1 := by
  have hgen : constantCompositum F k F = ⊤ :=
    top_unique fun x _ => (constantCompositum F k F).algebraMap_mem x
  rw [constant_rational_place_count k F k F hgen, Module.finrank_self]
theorem weil_degree_one :
    |(Nat.card {P : Place k F // P.degree = 1} : ℝ) - ((Nat.card k : ℝ) + 1)| ≤
      2 * (genus k F : ℝ) * Real.sqrt (Nat.card k) := by
  have h := weil_closed_point k F 1 one_ne_zero
  rw [← degree_one_card_eq k F] at h
  have he : ((Nat.card {P : Place k F // P.degree = 1} : ℕ) : ℂ) - ((Nat.card k : ℂ)^1 + 1) =
      ((((Nat.card {P : Place k F // P.degree = 1} : ℕ) : ℝ) - ((Nat.card k : ℝ) + 1) : ℝ) : ℂ) := by
    push_cast; ring
  rw [he, Complex.norm_real, Real.norm_eq_abs, pow_one] at h
  push_cast at h
  linarith
theorem degree_one_lower :
    (Nat.card k : ℝ) + 1 - 2 * (genus k F : ℝ) * Real.sqrt (Nat.card k) ≤
      (Nat.card {P : Place k F // P.degree = 1} : ℝ) := by
  have h := weil_degree_one k F
  rw [abs_le] at h
  linarith [h.1]
end Final
end Mathproof.Problem18CurvePointLowerBound20261001
