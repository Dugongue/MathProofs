namespace Mathproof.Problem18VectorAnnihilator20261001
open Polynomial
open scoped BigOperators
open Problem18ArrayElimination20260929 Problem18EliminationCoordinates20260929
variable {K : Type*} [Field K] [DecidableEq K] {n : ℕ}
def orbit (S : Module.End K (Fin n→K)) (z : Fin n→K) (i : ℕ) : Fin n→K := (S^i) z
def dependence (S : Module.End K (Fin n→K)) (z : Fin n→K) (d : ℕ) : Bool :=
  (spanCheck ((List.finRange d).map (fun j=>Vector.ofFn (orbit S z j.val)))
    (Vector.ofFn (orbit S z d))).1
theorem dependence_iff (S : Module.End K (Fin n→K)) (z : Fin n→K) (d : ℕ) :
    dependence S z d=true ↔ orbit S z d∈Submodule.span K (Set.range (fun j:Fin d=>orbit S z j.val)) := by
  rw [dependence,spanCheck_iff]
  simp only [read_ofFn,Problem18Elimination20260929.rowSpan,List.map_map,Function.comp_def]
  have he : {v | v ∈ List.map (fun x : Fin d => orbit S z x.val) (List.finRange d)} =
      Set.range (fun j : Fin d => orbit S z j.val) := by ext y; simp
  rw [he]
theorem independent_before (S : Module.End K (Fin n→K)) (z : Fin n→K) (d : ℕ)
    (h : ∀j<d,dependence S z j≠true) : LinearIndependent K (fun j:Fin d=>orbit S z j.val) := by
  induction d with
  | zero=>exact linearIndependent_empty_type
  | succ d ih=>
    rw [linearIndependent_finSucc']
    refine ⟨?_,?_⟩
    · exact ih (fun j hj=>h j (by omega))
    · exact fun hz=>h d (by omega) ((dependence_iff S z d).mpr hz)
theorem exists_dependence (S : Module.End K (Fin n→K)) (z : Fin n→K) :
    ∃d:Fin (n+1),dependence S z d.val=true := by
  by_contra h
  have hi:=independent_before S z (n+1) (by
    intro j hj he; exact h ⟨⟨j,hj⟩,he⟩)
  have hd:=hi.fintype_card_le_finrank
  simp only [Module.finrank_pi,Fintype.card_fin] at hd
  omega
def firstDegree (S : Module.End K (Fin n→K)) (z : Fin n→K) : Fin (n+1) :=
  (((List.ofFn (fun j:Fin (n+1)=>j)).find? (fun j=>dependence S z j.val))).getD (Fin.last n)
theorem firstDegree_spec (S : Module.End K (Fin n→K)) (z : Fin n→K) :
    dependence S z (firstDegree S z).val=true ∧
      ∀j<(firstDegree S z).val,dependence S z j≠true := by
  obtain ⟨d,hd⟩:=exists_dependence S z
  cases hh : (List.ofFn (fun j:Fin (n+1)=>j)).find? (fun j=>dependence S z j.val) with
  | none=>
    have hno:=List.find?_eq_none.mp hh d (List.mem_ofFn.mpr ⟨d,rfl⟩)
    simp [hd] at hno
  | some k=>
    have hk:=List.find?_ofFn_eq_some_of_injective Function.injective_id |>.mp hh
    simp only [firstDegree,hh,Option.getD_some]
    refine ⟨hk.1,?_⟩
    intro j hj
    exact hk.2 ⟨j,by omega⟩ hj
def coefficients (S : Module.End K (Fin n→K)) (z : Fin n→K) (d : ℕ) : Fin d→K :=
  read (coordinates (fun j:Fin d=>orbit S z j.val) (orbit S z d))
noncomputable def relation (S : Module.End K (Fin n→K)) (z : Fin n→K) (d : ℕ) : K[X] :=
  X^d - ∑j:Fin d,C (coefficients S z d j)*X^j.val
noncomputable def vectorAnnihilator (S : Module.End K (Fin n→K)) (z : Fin n→K) : K[X] :=
  relation S z (firstDegree S z).val
def IsVectorAnnihilator (S : Module.End K (Fin n→K)) (z : Fin n→K) (f : K[X]) : Prop :=
  f.Monic ∧ ∀p:K[X],(aeval S p) z=0 ↔ f∣p
theorem relation_monic (S : Module.End K (Fin n→K)) (z : Fin n→K) (d : ℕ) :
    (relation S z d).Monic := monic_X_pow_sub (degree_sum_fin_lt _)
theorem relation_degree (S : Module.End K (Fin n→K)) (z : Fin n→K) (d : ℕ) :
    (relation S z d).degree=d := by
  unfold relation
  rw [degree_sub_eq_left_of_degree_lt (by simpa using degree_sum_fin_lt (coefficients S z d))]
  simp
theorem relation_annihilates (S : Module.End K (Fin n→K)) (z : Fin n→K) (d : ℕ)
    (hd:dependence S z d=true) : (aeval S (relation S z d)) z=0 := by
  have hc:=coordinates_solution (fun j:Fin d=>orbit S z j.val) (orbit S z d)
    ((dependence_iff S z d).mp hd)
  simp only [relation,map_sub,map_sum,map_mul,map_pow,aeval_X,aeval_C,
    LinearMap.sub_apply,LinearMap.sum_apply,Module.End.mul_apply,Module.algebraMap_end_apply]
  change orbit S z d - ∑j:Fin d,coefficients S z d j • orbit S z j.val=0
  exact sub_eq_zero.mpr hc.symm
theorem small_annihilator_zero (S : Module.End K (Fin n→K)) (z : Fin n→K) (d : ℕ)
    (hi:LinearIndependent K (fun j:Fin d=>orbit S z j.val))
    (p:K[X]) (hd:p.degree<d) (hp:(aeval S p) z=0) : p=0 := by
  by_cases hz:p=0
  · exact hz
  have hnat:p.natDegree<d:=by exact_mod_cast (show (p.natDegree : WithBot ℕ) < d by simpa only [degree_eq_natDegree hz] using hd)
  have he : ∑j:Fin d,p.coeff j.val • orbit S z j.val=0 := by
    rw [aeval_eq_sum_range' hnat S] at hp
    simpa only [LinearMap.sum_apply,LinearMap.smul_apply,← Fin.sum_univ_eq_sum_range,orbit] using hp
  have hc:∀j:Fin d,p.coeff j.val=0:=(Fintype.linearIndependent_iff.mp hi) _ he
  ext j
  by_cases hj:j<d
  · simpa using hc ⟨j,hj⟩
  · simp only [coeff_zero]
    exact coeff_eq_zero_of_natDegree_lt (by omega)
theorem relation_isVectorAnnihilator (S : Module.End K (Fin n→K)) (z : Fin n→K) (d : ℕ)
    (hd:dependence S z d=true) (hi:LinearIndependent K (fun j:Fin d=>orbit S z j.val)) :
    IsVectorAnnihilator S z (relation S z d) := by
  let f:=relation S z d
  have hm:f.Monic:=relation_monic S z d
  have hf:(aeval S f) z=0:=relation_annihilates S z d hd
  refine ⟨hm,fun p=>⟨?_,?_⟩⟩
  · intro hp
    apply (modByMonic_eq_zero_iff_dvd hm).mp
    apply small_annihilator_zero S z d hi
    · simpa only [f,relation_degree] using degree_modByMonic_lt p hm
    · rw [modByMonic_eq_sub_mul_div,mul_comm f,map_sub,map_mul,LinearMap.sub_apply,
        Module.End.mul_apply,hf,map_zero,hp,sub_self]
  · rintro ⟨q,rfl⟩
    rw [mul_comm f,map_mul,Module.End.mul_apply,hf,map_zero]
theorem vectorAnnihilator_correct (S : Module.End K (Fin n→K)) (z : Fin n→K) :
    IsVectorAnnihilator S z (vectorAnnihilator S z) :=
  relation_isVectorAnnihilator S z _ (firstDegree_spec S z).1
    (independent_before S z _ (firstDegree_spec S z).2)
theorem vectorAnnihilator_degree_le (S : Module.End K (Fin n→K)) (z : Fin n→K) :
    (vectorAnnihilator S z).natDegree≤n := by
  have hd:=relation_degree S z (firstDegree S z).val
  rw [degree_eq_natDegree (relation_monic S z _).ne_zero] at hd
  have he:(vectorAnnihilator S z).natDegree=(firstDegree S z).val:=by exact_mod_cast hd
  rw [he]
  exact Nat.le_of_lt_succ (firstDegree S z).isLt
end Mathproof.Problem18VectorAnnihilator20261001
end
