    (g : InjectiveSample K (Fin (b*a) → K) d) (ψ : AddChar F ℂ) (hψ : ψ ≠ 1) (m : ℕ) :
    (∑χ : AddChar (selfAdjoint (Matrix (Fin b) (Fin b) K)) ℂ,
      if χ=1 then 0 else
      (‖(∑x : constraintSpace g.val,χ (repeatedGram x.val)) /
        (Fintype.card (constraintSpace g.val) : ℂ)‖^2)^m) =
    ∑A : {A : selfAdjoint (Matrix (Fin b) (Fin b) K) // A.val.rank ≠ 0},
      (‖(∑x : constraintSpace g.val,
        FiniteFieldOrthogonalUnitaryTI.hermitianTraceCharacter hstar ψ A.val (repeatedGram x.val)) /
        (Fintype.card (constraintSpace g.val) : ℂ)‖^2)^m := by
  let e := Equiv.ofBijective (FiniteFieldOrthogonalUnitaryTI.hermitianTraceCharacter hstar ψ)
    (FiniteFieldOrthogonalUnitaryTI.hermitianTraceCharacter_bijective (i := Fin b) hcard hstar ψ hψ)
  rw [←Equiv.sum_comp e]
  have hz (A : selfAdjoint (Matrix (Fin b) (Fin b) K)) : e A=1 ↔ A.val.rank=0 := by
    change FiniteFieldOrthogonalUnitaryTI.hermitianTraceCharacter hstar ψ A=1 ↔ _
    rw [FiniteFieldOrthogonalUnitaryTI.hermitianTraceCharacter_eq_one_iff hcard hstar ψ hψ]
    constructor
    · rintro rfl; exact Matrix.rank_zero
    · intro h; apply Subtype.ext
      exact Mathproof.Problem18AlternatingEnergy20260930.matrix_eq_zero_of_rank_eq_zero h
  simp_rw [hz]
  rw [Finset.sum_ite,Finset.sum_const_zero,zero_add]
  exact Finset.sum_subtype _ (by intro A; simp) _
theorem conditioned_energy_more_rows (a b d m : ℕ)
    (ha : 2 ≤ a) (hb : 8 ≤ b) (hdb : 64*d ≤ b) (hm : b - d ≤ m) :
    (∑g : InjectiveSample K (Fin (b*a) → K) d,
      ∑χ : AddChar (selfAdjoint (Matrix (Fin b) (Fin b) K)) ℂ,
      if χ=1 then 0 else
      (‖(∑x : constraintSpace g.val,χ (repeatedGram x.val)) /
        (Fintype.card (constraintSpace g.val) : ℂ)‖^2)^m) /
      Fintype.card (InjectiveSample K (Fin (b*a) → K) d)  ≤
      64*(b : ℝ)*(d+1 : ℕ)*((Fintype.card K : ℝ)^(b/4))⁻¹ := by
  obtain ⟨ψ,hψ⟩ := Fintype.exists_ne_of_one_lt_card
    (show 1<Fintype.card (AddChar F ℂ) by rw [AddChar.card_eq]; exact Fintype.one_lt_card)
    (1 : AddChar F ℂ)
  have he :
      (∑g : InjectiveSample K (Fin (b*a) → K) d,
        ∑χ : AddChar (selfAdjoint (Matrix (Fin b) (Fin b) K)) ℂ,
        if χ=1 then 0 else
        (‖(∑x : constraintSpace g.val,χ (repeatedGram x.val)) /
          (Fintype.card (constraintSpace g.val) : ℂ)‖^2)^(b - d)) /
        Fintype.card (InjectiveSample K (Fin (b*a) → K) d)  ≤ 64*(b : ℝ)*(d+1 : ℕ)*((Fintype.card K : ℝ)^(b/4))⁻¹ := by
    simp_rw [character_energy_eq hcard hstar _ ψ hψ]
    apply le_trans ?_ (hermitian_weighted_average_bound hcard hstar a b d ha hb hdb)
    rw [Finset.sum_comm,Finset.sum_div]
    apply Finset.sum_le_sum
    intro A hA
    have hp := repeated_character_average_le hcard hstar a b d (by nlinarith) A.val ψ hψ
    simp only [Nat.card_eq_fintype_card] at hp
    convert! hp using 1 <;> congr! (postTransparency := .reducible)
  apply le_trans (div_le_div_of_nonneg_right _ (by positivity)) he
  apply Finset.sum_le_sum
  intro g hg
  apply Finset.sum_le_sum
  intro χ hχ
  split_ifs
  · rfl
  · exact character_energy_antitone _ χ hm
theorem conditioned_replacement_more_rows (a b d m : ℕ)
    (ha : 2 ≤ a) (hb : 8 ≤ b) (hdb : 64*d ≤ b) (hm : b - d ≤ m)
    (A : InjectiveSample K (Fin (b*a) → K) d → Finset (selfAdjoint (Matrix (Fin b) (Fin b) K)))
    (S : Finset (InjectiveSample K (Fin (b*a) → K) d)) :
    (∑g∈S,((Finset.univ.filter (fun x : Fin m → constraintSpace g.val =>
      (∑j,repeatedGram (x j).val)∈A g)).card : ℝ) /
      Fintype.card (Fin m → constraintSpace g.val)) /
      Fintype.card (InjectiveSample K (Fin (b*a) → K) d)  ≤
    (∑g,((A g).card : ℝ)/Fintype.card (selfAdjoint (Matrix (Fin b) (Fin b) K))) /
      Fintype.card (InjectiveSample K (Fin (b*a) → K) d) +
      Real.sqrt ((64*(b : ℝ)*(d+1 : ℕ)*((Fintype.card K : ℝ)^(b/4))⁻¹)/4) := by
  have hdim : Module.finrank K (Fin d → K) ≤ Module.finrank K (Fin (b*a) → K) := by
    simp only [Module.finrank_fintype_fun_eq_card,Fintype.card_fin]
    nlinarith
  obtain ⟨g,hg⟩ := finrank_le_iff_exists_linearMap.mp hdim
  letI : Nonempty (InjectiveSample K (Fin (b*a) → K) d) := ⟨⟨g,hg⟩⟩
  have hh := restricted_sum_replacement_le_sqrt
    (Ω := InjectiveSample K (Fin (b*a) → K) d)
    (G := selfAdjoint (Matrix (Fin b) (Fin b) K))
    (V := fun g => constraintSpace g.val)
    (fun g x => repeatedGram (x : constraintSpace g.val).val) m A S
    (64*(b : ℝ)*(d+1 : ℕ)*((Fintype.card K : ℝ)^(b/4))⁻¹) (by positivity)
    (conditioned_energy_more_rows hcard hstar a b d m ha hb hdb hm)
  convert! hh using 1 <;> congr! (postTransparency := .reducible)
end Mathproof.Problem18HermitianConditionedGram20260930
