variable {K σ τ : Type*} [Field K] [DecidableEq K] {n d a b c : Nat}
theorem reindex_degree (u : σ→τ) (p : PolyExpr σ K) : (reindex u p).degree=p.degree := by
  induction p <;> simp_all [reindex,PolyExpr.degree]
theorem reindex_mass (u : σ→τ) (p : PolyExpr σ K) : expansionMass (reindex u p)=expansionMass p := by
  induction p <;> simp_all [reindex,expansionMass]
theorem interpret_identity (x : σ→K) (p : PolyExpr σ K) : interpret (RingHom.id K) x p=p.eval x := by
  induction p <;> simp_all [interpret,PolyExpr.eval]
def expressionRow (e : σ≃Fin n) (p : PolyExpr σ K) (d : Nat) : DenseInput n d K×Nat :=
  evaluateTemplate (RingHom.id K) Empty.elim (reindex (fun i=>(Sum.inr (e i):Empty⊕Fin n)) p) d
def compileSystem (e : σ≃Fin n) (ps : List (PolyExpr σ K)) (d : Nat) : List (DenseInput n d K)×Nat :=
  compressTemplates (RingHom.id K) Empty.elim (ps.map (reindex (fun i=>(Sum.inr (e i):Empty⊕Fin n)))) d
theorem expressionRow_valid (e : σ≃Fin n) (p : PolyExpr σ K) (d : Nat) (hd : p.degree ≤ d) :
    ValidDenseInput d (expressionRow e p d).1
      (sparsePolynomial (RingHom.id K) Empty.elim (expand id (reindex (fun i=>(Sum.inr (e i):Empty⊕Fin n)) p))) :=
  evaluateTemplate_valid _ _ _ _ (fun a ha=>(expand_bound id _ a ha).trans
    ((reindex_degree _ p).trans_le hd))
theorem compileSystem_correct (e : σ≃Fin n) (ps : List (PolyExpr σ K)) (d M : Nat)
    (hd : ∀p∈ps,p.degree ≤ d) (hm : ∀p∈ps,expansionMass p ≤ M) :
    (compileSystem e ps d).1.length ≤ (d+1)^n ∧
    (compileSystem e ps d).2 ≤ ps.length*((d+1)^n*M+testBudget ((d+1)^n)) ∧
    (∀v∈(compileSystem e ps d).1,∃p,ValidDenseInput d v p) ∧
    ((∃y:Fin n→K,∀v∈(compileSystem e ps d).1,denseEval y (read v)=0) ↔
      ∃x:σ→K,∀p∈ps,p.eval x=0) := by
  have hdeg : ∀p∈ps.map (reindex (fun i=>(Sum.inr (e i):Empty⊕Fin n))),p.degree ≤ d := by
    intro p hp
    obtain ⟨r,hr,rfl⟩:=List.mem_map.mp hp
    simpa only [reindex_degree] using hd r hr
  have hh:=compressTemplates_correct (RingHom.id K) Empty.elim
    (ps.map (reindex (fun i=>(Sum.inr (e i):Empty⊕Fin n)))) d hdeg
  refine ⟨hh.1,?_,?_,?_⟩
  · have hs : ((ps.map (reindex (fun i=>(Sum.inr (e i):Empty⊕Fin n)))).map (fun p=>templateCost p d)).sum ≤
        ps.length*((d+1)^n*M) := by
      rw [List.map_map]
      calc
        _ ≤ (ps.map (fun _=>(d+1)^n*M)).sum := List.sum_le_sum (by
          intro p hp
          exact (templateCost_bound _ d).trans (Nat.mul_le_mul_left _
            ((reindex_mass _ p).trans_le (hm p hp))))
        _=ps.length*((d+1)^n*M) := by simp
    have hb:=hh.2.1
    simp only [List.length_map] at hb
    exact hb.trans (by rw [Nat.mul_add]; exact Nat.add_le_add_right hs _)
  · intro v hv
    have hv':v∈(((ps.map (reindex (fun i=>(Sum.inr (e i):Empty⊕Fin n)))).map
        (fun p=>evaluateTemplate (RingHom.id K) Empty.elim p d)).map Prod.fst) :=
      compress_sublist_values _ v hv
    obtain ⟨z,hz,rfl⟩:=List.mem_map.mp hv'
    obtain ⟨r,hr,rfl⟩:=List.mem_map.mp hz
    obtain ⟨p,hp,rfl⟩:=List.mem_map.mp hr
    exact ⟨_,expressionRow_valid e p d (hd p hp)⟩
  · have he (y : Fin n→K) :
        (∀v∈(compileSystem e ps d).1,denseEval y (read v)=0) ↔ ∀p∈ps,p.eval (y∘e)=0 := by
      rw [show (compileSystem e ps d).1=(compressTemplates (RingHom.id K) Empty.elim
        (ps.map (reindex (fun i=>(Sum.inr (e i):Empty⊕Fin n)))) d).1 from rfl,hh.2.2 y]
      simp only [List.forall_mem_map]
      simp_rw [interpret_reindex]
      simp only [Function.comp_def,Sum.elim_inr,interpret_identity]
    simp_rw [he]
    constructor
    · rintro ⟨y,hy⟩; exact ⟨y∘e,hy⟩
    · rintro ⟨x,hx⟩
      refine ⟨x∘e.symm,?_⟩
      simpa only [Function.comp_def,Equiv.symm_apply_apply] using hx
def outerIndex (a b : Nat) : OuterVar a b≃Fin (a*a+b*b) :=
  (Equiv.sumCongr finProdFinEquiv finProdFinEquiv).trans finSumFinEquiv
def outerCoordinateIndex (a b : Nat) : OuterCoordVar a b≃Fin (2*(a*a+b*b)) :=
  (Equiv.prodCongr (Equiv.refl (Fin 2)) (outerIndex a b)).trans finProdFinEquiv
