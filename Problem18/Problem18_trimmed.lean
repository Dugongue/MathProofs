  change D+principalDivisorA k K (Additive.ofMul (rrUnit k K D ⟨f,hf⟩)) = A.val
  have he : rrUnit k K D ⟨f,hf⟩ = u.toMul := by ext; rfl
  rw [he]
  exact hu
def projectiveDivisorEquiv (D : DivisorA k K) :
    ℙ k (RRspace k K D) ≃ EffectiveClass k K D :=
  Equiv.ofBijective (projectiveDivisor k K D)
    ⟨projectiveDivisor_injective k K D,projectiveDivisor_surjective k K D⟩
theorem effective_class_card [Finite k] (D : DivisorA k K) :
    Nat.card (EffectiveClass k K D)*(Nat.card k-1)+1 = (Nat.card k)^(ell k K D) := by
  let W := RRspace k K D
