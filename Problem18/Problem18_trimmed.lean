variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
theorem bilinear_restriction_rank_loss (B : V →ₗ[K] V →ₗ[K] K)
    (hB : B.IsSymm) (E : Submodule K V) :
    finrank K (LinearMap.range B) ≤
      finrank K (LinearMap.range (E.subtype.dualMap.comp (B.comp E.subtype))) +
        2*finrank K ↥(LinearMap.range B ⊓ LinearMap.ker E.subtype.dualMap) := by
  let T := B.comp E.subtype
  have ht : T.flip = E.subtype.dualMap.comp B := by
    ext x y
    exact hB.eq _ _
  have hp : (E.subtype.dualMap.comp (B.comp E.subtype)) = E.subtype.dualMap.comp T := by
    ext x y
    rfl
  have h₁ : finrank K (LinearMap.range (E.subtype.dualMap.comp B)) +
      finrank K ↥(LinearMap.range B ⊓ LinearMap.ker E.subtype.dualMap) =
      finrank K (LinearMap.range B) :=
    finrank_comp_add_intersection E.subtype.dualMap B
  have h₂ : finrank K (LinearMap.range (E.subtype.dualMap.comp T)) +
      finrank K ↥(LinearMap.range T ⊓ LinearMap.ker E.subtype.dualMap) =
      finrank K (LinearMap.range T) :=
    finrank_comp_add_intersection E.subtype.dualMap T
  have hle : LinearMap.range T ≤ LinearMap.range B :=
    LinearMap.range_comp_le_range _ _
  have hi : finrank K ↥(LinearMap.range T ⊓ LinearMap.ker E.subtype.dualMap) ≤
      finrank K ↥(LinearMap.range B ⊓ LinearMap.ker E.subtype.dualMap) :=
    Submodule.finrank_mono (inf_le_inf_right (LinearMap.ker E.subtype.dualMap) hle)
  have hr : finrank K (LinearMap.range (E.subtype.dualMap.comp B)) =
      finrank K (LinearMap.range T) := by
    rw [← ht]
    exact finrank_range_flip T
  rw [← hp] at h₂
  calc
    _ = finrank K (LinearMap.range (E.subtype.dualMap.comp B)) +
        finrank K ↥(LinearMap.range B ⊓ LinearMap.ker E.subtype.dualMap) := h₁.symm
    _ = finrank K (LinearMap.range T) +
        finrank K ↥(LinearMap.range B ⊓ LinearMap.ker E.subtype.dualMap) := by rw [hr]
    _ = (finrank K (LinearMap.range (E.subtype.dualMap.comp (B.comp E.subtype))) +
        finrank K ↥(LinearMap.range T ⊓ LinearMap.ker E.subtype.dualMap)) +
        finrank K ↥(LinearMap.range B ⊓ LinearMap.ker E.subtype.dualMap) := by rw [h₂]
    _ ≤ (finrank K (LinearMap.range (E.subtype.dualMap.comp (B.comp E.subtype))) +
        finrank K ↥(LinearMap.range B ⊓ LinearMap.ker E.subtype.dualMap)) +
        finrank K ↥(LinearMap.range B ⊓ LinearMap.ker E.subtype.dualMap) :=
      Nat.add_le_add_right (Nat.add_le_add_left hi _) _
    _ = _ := by omega
variable [Fintype K] [Fintype V]
theorem constrained_pair_moment_le (B : V →ₗ[K] V →ₗ[K] K) (hB : B.IsSymm)
    {d : ℕ} (g : (Fin d → K) →ₗ[K] Module.Dual K V)
    (ψ : AddChar K ℂ) (hψ : ψ ≠ 1) (s : ℕ) :
    (‖(∑p : constraintKernel g × constraintKernel g,ψ (B p.1.val p.2.val)) /
      (Fintype.card (constraintKernel g × constraintKernel g) : ℂ)‖^2)^s ≤
      (((Fintype.card K : ℝ)^(finrank K (LinearMap.range B)-
        2*finrank K ↥(LinearMap.range g ⊓ LinearMap.range B)))⁻¹)^(2*s) := by
  let E := constraintKernel g
  let C := E.subtype.dualMap.comp (B.comp E.subtype)
  have he := bilinear_pair_norm_sq C ψ hψ
  have hr := bilinear_restriction_rank_loss B hB E
  rw [constraintKernel_annihilator,inf_comm] at hr
  change (‖(∑p : E×E,ψ (C p.1 p.2))/(Fintype.card (E×E) : ℂ)‖^2)^s ≤ _
  rw [he,←pow_mul]
  apply pow_le_pow_left₀ (by positivity)
  apply inv_anti₀ (by positivity)
  apply pow_le_pow_right₀ (by exact_mod_cast Fintype.card_pos (α := K))
  exact Nat.sub_le_iff_le_add.mpr hr
theorem averaged_pair_moment_le (B : V →ₗ[K] V →ₗ[K] K) (hB : B.IsSymm)
    (d : ℕ) (hd : d ≤ finrank K V) (ψ : AddChar K ℂ) (hψ : ψ ≠ 1) (s : ℕ) :
    (∑g : InjectiveSample K (Module.Dual K V) d,
      (‖(∑p : constraintKernel g.val × constraintKernel g.val,
        ψ (B p.1.val p.2.val)) /
          (Fintype.card (constraintKernel g.val × constraintKernel g.val) : ℂ)‖^2)^s) /
      Nat.card (InjectiveSample K (Module.Dual K V) d) ≤
    ∑u : Fin (d+1),
      (16*(Fintype.card K : ℝ)^(u.val*(d-u.val)) *
        ((Fintype.card K : ℝ)^(u.val*(finrank K V-finrank K (LinearMap.range B))))⁻¹) *
      (((Fintype.card K : ℝ)^(finrank K (LinearMap.range B)-2*u.val))⁻¹)^(2*s) := by
  let U := LinearMap.range B
  let f : ℕ → ℝ := fun u => (((Fintype.card K : ℝ)^(finrank K U-2*u))⁻¹)^(2*s)
  have hb := invariant_intersection_weight_average_le U d
    (by rwa [Subspace.dual_finrank_eq]) f (fun _ => by dsimp [f]; positivity)
  rw [Subspace.dual_finrank_eq] at hb
  apply le_trans ?_ hb
  apply div_le_div_of_nonneg_right _ (by positivity)
  exact Finset.sum_le_sum (fun g _ => constrained_pair_moment_le B hB g.val ψ hψ s)
