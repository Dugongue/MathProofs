    simpleFactorWeight .hermitian q d = (q ^ d - (-1 : ℝ) ^ d)⁻¹ := rfl
@[simp] theorem simpleFactorWeight_pfaffian (q : ℝ) (d : ℕ) :
    simpleFactorWeight .pfaffian q d =
      q ^ (-(d : ℤ)) / (1 - q ^ (-(2 * d : ℕ) : ℤ)) := rfl
