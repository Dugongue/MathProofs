  have hj₀ (x : V) : j₀.val x=Q.val (x,0) := congrArg (fun f : V →ₗ[K] V × W => f x) hQ.symm
  exact (hj₀ (U.val x)).symm.trans he
theorem same_range_embeddingOrbit_card (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingLeft) (j₀ : EmbeddingOrbit σ B C) :
