  obtain ⟨τ,hrt,hτ,hti,hto⟩:=Problem18IMPBoundaryUpdateTail20261002.update_run F stateξ hi hseedξ hann hb.newFactor hb.action hb.product
  exact ⟨τ,hrs.seq (hra.seq hrt),hτ,hti.trans (hxi.trans hri),hto.trans (hxo.trans hro)⟩
end Mathproof.Problem18IMPBoundarySweepStep20261002
