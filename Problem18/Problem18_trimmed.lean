variable {K : Type} [Field K] [Fintype K] [BEq K] [LawfulBEq K] [DecidableEq K]
def boundaryLayoutCost (F : FieldPresentation K) (a b c : Nat) : Nat :=
  20*F.e+13+100+210*(a*b*c*F.e+1)+100
structure BoundaryAfterLayout (F : FieldPresentation K) (B a b c : Nat)
    (u : Bool) (q : Nat) (A : RectTensor a b c K)
    (sigma gamma : Env) : Prop where
  run : Run B (.seq modulusCopy (.seq boundaryGather gramLayoutSetup))
    sigma gamma (boundaryLayoutCost F a b c)
  first : (shape (sortOrder a b c) a b c).1=1
  gramReady : OrdinaryReady F B 0 (boundaryHeight a b c)
    (boundaryWidth a b c) gamma
  adjBase : (externalState gamma).vars
      Problem18P34AssemblyMatrixGramSetup20261003.adj=
    plainBase F.e
  sourceBase : (externalState gamma).vars
      Problem18P34AssemblyMatrixGramSetup20261003.src=
    gatheredBase F.e (boundaryHeight a b c) (boundaryWidth a b c)
  destBase : (externalState gamma).vars
      Problem18P34AssemblyMatrixGramSetup20261003.dst=
    gramBase F.e (boundaryHeight a b c) (boundaryWidth a b c)
  workBase : (externalState gamma).vars
      Problem18P34AssemblyMatrixGramSetup20261003.work=
    gramScratchBase F.e (boundaryHeight a b c) (boundaryWidth a b c)
  modBase : gamma.vars canonical.modBase=0
  workspace : gamma.vars Problem18P34AssemblyMatrixGramSetup20261003.ws=plainBase F.e
  sourceMatrix : matrix F (externalState gamma)
      (gatheredBase F.e (boundaryHeight a b c) (boundaryWidth a b c))
      (boundaryHeight a b c) (boundaryWidth a b c)=
    Problem18DimensionOneBoundary20260930.matrixOf
      (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
        (sortOrder a b c) A first)
  native_memory : gamma.arrs canonical.mem=sigma.arrs canonical.mem
  work_length : ((externalState gamma).arrs canonical.mem).length=
    (sigma.arrs workBank).length
  dimC : gamma.vars Problem18P36LargeCovariantController20261003.dimC=
    boundaryHeight a b c
  cols : gamma.vars Problem18IMPTensorGather20261002.cols=boundaryWidth a b c
  unitary : gamma.vars "u"=u.toNat
  exponent : gamma.vars "q"=q
  exp_word : gamma.vars canonical.exp<B
  input : gamma.inp=sigma.inp
  output : gamma.out=sigma.out
theorem boundary_layout_run (F : FieldPresentation K)
    {B a b c : Nat} {u : Bool} {q : Nat} {A : RectTensor a b c K}
    (sigma : Env) (h : BoundaryInput F B a b c u q A sigma) :
    ∃gamma, BoundaryAfterLayout F B a b c u q A sigma gamma := by
  let n:=boundaryWidth a b c
  let d:=boundaryHeight a b c
  obtain ⟨rho,hrho⟩:=boundary_modulus_run F sigma h
  have he : rho.vars canonical.e=F.e := hrho.externalValid.degree
  have er:=rectangularCellsExpr_eval he hrho.dimC hrho.cols h.degree_word
    h.height_word h.width_word h.height_width_word h.rectangular_word
  have ep:=plainAdjointExpr_eval he h.degree_word h.plain_word
  have epow:=poweredAdjointExpr_eval ep er h.powered_word
  have esource:=sourceExpr_eval epow er h.gathered_word
  let delta:=rho.setVar Problem18IMPTensorGatherStore20261002.dest
    (gatheredBase F.e d n)
  have hdestRun : Run B
      (.assign Problem18IMPTensorGatherStore20261002.dest sourceExpr)
      rho delta 100 := by
    exact (Run.assign esource).mono (by
      simp [sourceExpr,poweredAdjointExpr,plainAdjointExpr,
        rectangularCellsExpr,Expr.size])
  have hvalidDelta : ValidMemory F B (externalState delta) := by
    simpa [delta,externalState] using
      (Problem18IMPMatrixDot20261001.validMemory_setVar F hrho.externalValid
        Problem18IMPTensorGatherStore20261002.dest (gatheredBase F.e d n)
        (by decide) (by decide) (by decide))
  have hslotsDelta : Slots F canonical
      Problem18IMPBoundaryPhaseState20261002.workspaceName 0 B
      (externalState delta) := by
    simpa [delta,externalState] using
      (Problem18P34AssemblyMatrixSetup20261003.slots_set F hrho.externalSlots
        Problem18IMPTensorGatherStore20261002.dest (gatheredBase F.e d n)
        (by decide) (by decide) (by decide) (by decide) (by decide))
  have hdeltaKeep (x : String)
      (hx : x≠Problem18IMPTensorGatherStore20261002.dest) :
      (externalState delta).vars x=(externalState rho).vars x := by
    simp [delta,externalState,hx]
  have hloadedDelta : (parameters 0 (sortOrder a b c) a b c F.e).loaded
      (externalState delta) := by
    rcases hrho.loaded with ⟨h0,h1,h2,h3,h4,h5,h6⟩
    refine ⟨(hdeltaKeep _ (by decide)).trans h0,
      (hdeltaKeep _ (by decide)).trans h1,
      (hdeltaKeep _ (by decide)).trans h2,
      (hdeltaKeep _ (by decide)).trans h3,
      (hdeltaKeep _ (by decide)).trans h4,
      (hdeltaKeep _ (by decide)).trans h5,
      (hdeltaKeep _ (by decide)).trans h6⟩
  have htotalDelta : (externalState delta).vars
      Problem18IMPTensorGather20261002.total=a*b*c*F.e :=
    (hdeltaKeep _ (by decide)).trans hrho.total
  have htensorDelta :
      (externalState delta).arrs tensorBank=(externalState rho).arrs tensorBank := rfl
  have hworkDelta : ((externalState delta).arrs canonical.mem).length=
      (sigma.arrs workBank).length := by
    simpa [delta,externalState,bankSwap,workBank] using hrho.external_length
  have hpB : F.p<B := by
    have hh:=h.nativeValid.arithmetic_word
    nlinarith
  have hdestFit : gatheredBase F.e d n+a*b*c*F.e≤
      ((externalState delta).arrs canonical.mem).length := by
    rw [hworkDelta,h.cells_eq]
    have hh:=h.work_fit
    simp only [d,n] at hh ⊢
    have hle : gatheredBase F.e (boundaryHeight a b c) (boundaryWidth a b c)+
        boundaryHeight a b c*boundaryWidth a b c*F.e≤
        gramScratchBase F.e (boundaryHeight a b c) (boundaryWidth a b c)+3*F.e := by
      unfold gramScratchBase gramBase rectangularCells
      ring_nf
      omega
    exact hle.trans hh
  obtain ⟨eta,hgather,hgvalid,hgslots,hgmatrix,hgframe,hgvars,hgnative,
      hgarrays,hgi,hgo⟩:=
    gather_full_run F delta 0 (gatheredBase F.e d n)
      (sortOrder a b c) h.a_pos h.b_pos h.c_pos A
      hloadedDelta hrho.bounded (by
        rw [h.cells_eq]
        simpa [rectangularCells,d,n,Nat.mul_assoc,Nat.mul_comm,Nat.mul_left_comm] using
          h.rectangular_word)
      htotalDelta (by simp [delta,externalState])
      hdestFit
      (by rw [htensorDelta];simpa only [Nat.zero_add] using hrho.tensor_fit)
      (by rw [htensorDelta];exact hrho.tensor_word)
      (by
        intro x hx
        rw [htensorDelta] at hx ⊢
        exact hrho.tensor_coefficients x hx)
      (by
        intro x hx
        rw [htensorDelta]
        simpa only [Nat.zero_add] using hrho.tensor_value x hx)
      hvalidDelta hslotsDelta (by decide)
      (Or.inr (by
        rw [hdeltaKeep _ (by decide),hrho.modBase]
        unfold gatheredBase poweredBase plainBase rectangularCells
        omega))
  obtain ⟨eta',hgather',hboundary,-,-⟩:=
    gather_run F delta 0 (gatheredBase F.e d n)
      h.a_pos h.b_pos h.c_pos A h.first hloadedDelta hrho.bounded
      (by
        rw [h.cells_eq]
        simpa [rectangularCells,d,n,Nat.mul_assoc,Nat.mul_comm,Nat.mul_left_comm] using
          h.rectangular_word) htotalDelta
      (by simp [delta,externalState])
      hdestFit
      (by rw [htensorDelta];simpa only [Nat.zero_add] using hrho.tensor_fit)
      (by rw [htensorDelta];exact hrho.tensor_word)
      (by
        change (rho.arrs workBank).length<B
        simpa [externalState,bankSwap,workBank] using
          (show ((externalState rho).arrs canonical.mem).length<B by
            rw [hrho.external_length]
            exact h.work_word))
      (by
        intro x hx
        exact (hrho.tensor_coefficients x hx).trans hpB)
      (by
        intro x hx
        rw [htensorDelta]
        simpa only [Nat.zero_add] using hrho.tensor_value x hx)
  have heta : eta'=eta := by
    obtain ⟨k,hk,hkr⟩:=hgather.bigStep
    obtain ⟨l,hl,hlr⟩:=hgather'.bigStep
    exact (hlr.unique hkr).1
  subst eta'
  have hdimEta : eta.vars Problem18P36LargeCovariantController20261003.dimC=d :=
