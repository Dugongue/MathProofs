    y ≠ zn.t → y ≠ zn.z → y ≠ sn.c → y ≠ sn.ans → y ≠ sn.w → y ≠ sn.k → τ.vars y = σ.vars y
  arrays : ∀ arr, arr ≠ r.mem → arr ≠ r.scratch → τ.arrs arr = σ.arrs arr
