theorem rectangular_sandwich_power {m n : Type} [Fintype m] [Fintype n]
    [DecidableEq m] [DecidableEq n] (A : Matrix m n K) (B : Matrix n m K) (t : Nat) :
    B*(A*B)^t*A=(B*A)^(t+1) := by
  induction t with
  | zero => simp
  | succ t ih =>
    calc B*(A*B)^(t+1)*A = (B*(A*B)^t*A)*(B*A) := by
          rw [pow_succ]
          simp only [Matrix.mul_assoc]
      _ = (B*A)^(t+1)*(B*A) := by rw [ih]
      _ = (B*A)^(t+1+1) := (pow_succ _ _).symm
theorem rawFirst_gram (u : Bool) (q : Nat) (A : RectTensor a b c K) (t : Fin c) :
    rawFirst u q A t=FiniteFieldOrthogonalUnitaryTI.partialTraceRight
      (((rawAdjoint u q A*A)^(t.val+1)).transpose) := by
  unfold rawFirst
  rw [rectangular_sandwich_power]
theorem rawFirst_entry (u : Bool) (q : Nat) (A : RectTensor a b c K)
    (t : Fin c) (r s : Fin b) :
    rawFirst u q A t r s=FiniteFieldOrthogonalUnitaryTI.partialTraceRight
      ((rawAdjoint u q A*A)^(t.val+1)) s r := by
  rw [rawFirst_gram]
