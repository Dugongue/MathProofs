def appendCoordinates (n m : ℕ) : ((Fin n→K)×(Fin m→K)) ≃ₗ[K] (Fin (n+m)→K) where
  toFun z := Fin.append z.1 z.2
  invFun x := (fun i => x (Fin.castAdd m i),fun j => x (Fin.natAdd n j))
