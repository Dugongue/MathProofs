section Fixed
variable {A L : Type*} [Field A] [Field L] [Algebra A L]
def fixedPoints (τ : L ≃ₐ[A] L) : IntermediateField A L :=
  IntermediateField.fixedField (Subgroup.zpowers τ)
theorem mem_fixedPoints (τ : L ≃ₐ[A] L) (x : L) : x ∈ fixedPoints τ ↔ τ x = x := by
  rw [fixedPoints, IntermediateField.mem_fixedField_iff]
  constructor
  · intro h
    exact h τ (Subgroup.mem_zpowers τ)
  · intro h f hf
    have hs := (Subgroup.zpowers_le.mpr
      (show τ ∈ MulAction.stabilizer (L ≃ₐ[A] L) x from h)) hf
    exact hs
def restrictEquiv (S : IntermediateField A L) (θ : L ≃+* L)
    (h1 : ∀ x ∈ S, θ x ∈ S) (h2 : ∀ x ∈ S, θ.symm x ∈ S) : S ≃+* S where
  toFun x := ⟨θ x, h1 x x.2⟩
  invFun x := ⟨θ.symm x, h2 x x.2⟩
  left_inv x := Subtype.ext (θ.symm_apply_apply x)
  right_inv x := Subtype.ext (θ.apply_symm_apply x)
  map_mul' x y := Subtype.ext (map_mul θ (x : L) (y : L))
  map_add' x y := Subtype.ext (map_add θ (x : L) (y : L))
theorem restrictEquiv_apply (S : IntermediateField A L) (θ : L ≃+* L)
    (h1 : ∀ x ∈ S, θ x ∈ S) (h2 : ∀ x ∈ S, θ.symm x ∈ S) (x : S) :
    ((restrictEquiv S θ h1 h2 x : S) : L) = θ x := rfl
end Fixed
section RatFuncFixed
variable {K0 L : Type*} [Field K0] [Field L] [Algebra K0 L] [Algebra K0⟮X⟯ L]
  [IsScalarTower K0 K0⟮X⟯ L]
theorem fixes_ratFunc (θ : L ≃ₐ[K0] L)
    (hx : θ (algebraMap K0⟮X⟯ L RatFunc.X) = algebraMap K0⟮X⟯ L RatFunc.X) (b : K0⟮X⟯) :
    θ (algebraMap K0⟮X⟯ L b) = algebraMap K0⟮X⟯ L b := by
  let f := IsScalarTower.toAlgHom K0 K0⟮X⟯ L
  have ht : (fixedPoints θ).comap f = ⊤ := by
    apply top_unique
    rw [← RatFunc.adjoin_X]
    apply IntermediateField.adjoin_le_iff.mpr
    rintro x (rfl : x = RatFunc.X)
    exact (mem_fixedPoints θ _).mpr hx
  have hb : b ∈ (fixedPoints θ).comap f := by rw [ht]; trivial
  exact (mem_fixedPoints θ _).mp hb
theorem ratFunc_mem (S : IntermediateField K0 L)
    (hX : algebraMap K0⟮X⟯ L RatFunc.X ∈ S) (b : K0⟮X⟯) : algebraMap K0⟮X⟯ L b ∈ S := by
  let f := IsScalarTower.toAlgHom K0 K0⟮X⟯ L
  have ht : S.comap f = ⊤ := by
    apply top_unique
    rw [← RatFunc.adjoin_X]
    apply IntermediateField.adjoin_le_iff.mpr
    rintro x (rfl : x = RatFunc.X)
    exact hX
  have hb : b ∈ S.comap f := by rw [ht]; trivial
  exact hb
end RatFuncFixed
section DegreeBound
variable (K0 H : Type*) [Field K0] [Field H] [Algebra K0 H] [Algebra K0⟮X⟯ H]
  [IsScalarTower K0 K0⟮X⟯ H] [FiniteDimensional K0⟮X⟯ H]
theorem residue_card_le (R : Place K0 H)
    (hP : (restrictPlace K0 K0⟮X⟯ H R).degree = 1) (s : Finset R.residueField)
    (hs : LinearIndependent K0 (fun i : s => (i : R.residueField))) :
    s.card ≤ finrank K0⟮X⟯ H := by
  classical
  let P := restrictPlace K0 K0⟮X⟯ H R
  have hlift : ∀ i : s, ∃ b : R.toValuationSubring, IsLocalRing.residue R.toValuationSubring b = (i : R.residueField) :=
    fun i => IsLocalRing.residue_surjective _
  choose b hb using hlift
  let w : s → H := fun i => (b i : H)
  have hwR : ∀ i, R.valuation (w i) ≤ 1 := by
    intro i
    rw [← Valuation.mem_valuationSubring_iff, R.valuationSubring_valuation]
    exact (b i).property
  have hequiv := restrictPlace_valuation_isEquiv K0 K0⟮X⟯ H R
  have hlt : ∀ z : K0⟮X⟯, P.valuation z < 1 ↔ R.valuation (algebraMap K0⟮X⟯ H z) < 1 :=
    fun z => hequiv.lt_one_iff_lt_one
  have hmemP : ∀ z : K0⟮X⟯, P.valuation z ≤ 1 → z ∈ P := by
    intro z hz
    rw [← Valuation.mem_valuationSubring_iff, P.valuationSubring_valuation] at hz
    exact hz
  have hind : LinearIndependent K0⟮X⟯ w := by
    rw [linearIndependent_iff']
    intro t g hg i0 hi0
    by_contra hg0
    obtain ⟨i1,hi1,hmax⟩ := Finset.exists_max_image t (fun i => P.valuation (g i)) ⟨i0,hi0⟩
    have hg1 : g i1 ≠ 0 := by
      intro h
      have h0 := hmax i0 hi0
      rw [h, map_zero] at h0
      exact hg0 ((Valuation.zero_iff _).mp (le_antisymm h0 zero_le))
    let d : s → K0⟮X⟯ := fun i => g i / g i1
    have hdP : ∀ i ∈ t, d i ∈ P := by
      intro i hi
      apply hmemP
      change P.valuation (g i / g i1) ≤ 1
      rw [map_div₀]
      exact div_le_one_of_le₀ (hmax i hi) zero_le
    have hd1 : d i1 = 1 := div_self hg1
    have hdsum : ∑ i ∈ t, algebraMap K0⟮X⟯ H (d i) * w i = 0 := by
      have he : ∑ i ∈ t, algebraMap K0⟮X⟯ H (d i) * w i =
          algebraMap K0⟮X⟯ H (g i1)⁻¹ * ∑ i ∈ t, g i • w i := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro i _
        simp only [d, div_eq_mul_inv, map_mul, Algebra.smul_def, map_inv₀]
        ring
      rw [he, hg, mul_zero]
    have happrox : ∀ i : s, ∃ c : K0, i ∈ t →
        P.valuation (d i - algebraMap K0 K0⟮X⟯ c) < 1 := by
      intro i
      by_cases hi : i ∈ t
      · obtain ⟨c,hc⟩ := (degree_one_iff_approximation P).mp hP (d i) (hdP i hi)
        exact ⟨c, fun _ => hc⟩
      · exact ⟨0, fun h => absurd h hi⟩
    choose a ha using happrox
    have ha1 : a i1 ≠ 0 := by
      intro h
      have h1 := ha i1 hi1
      rw [hd1, h, map_zero, sub_zero, map_one] at h1
      exact lt_irrefl _ h1
    have hterm : ∀ i ∈ t, R.valuation
        (algebraMap K0⟮X⟯ H (algebraMap K0 K0⟮X⟯ (a i) - d i) * w i) < 1 := by
      intro i hi
      have h1 : R.valuation (algebraMap K0⟮X⟯ H (algebraMap K0 K0⟮X⟯ (a i) - d i)) < 1 := by
        rw [← hlt, Valuation.map_sub_swap]
        exact ha i hi
      rw [map_mul]
      calc R.valuation (algebraMap K0⟮X⟯ H (algebraMap K0 K0⟮X⟯ (a i) - d i)) *
            R.valuation (w i)
          ≤ R.valuation (algebraMap K0⟮X⟯ H (algebraMap K0 K0⟮X⟯ (a i) - d i)) * 1 :=
            mul_le_mul_right (hwR i) _
        _ < 1 := by rw [mul_one]; exact h1
    have hsumlt : R.valuation (∑ i ∈ t, algebraMap K0 H (a i) * w i) < 1 := by
      have he : ∑ i ∈ t, algebraMap K0 H (a i) * w i = ∑ i ∈ t,
          algebraMap K0⟮X⟯ H (algebraMap K0 K0⟮X⟯ (a i) - d i) * w i := by
        have h2 : ∑ i ∈ t, algebraMap K0⟮X⟯ H (algebraMap K0 K0⟮X⟯ (a i) - d i) * w i =
            ∑ i ∈ t, algebraMap K0 H (a i) * w i -
              ∑ i ∈ t, algebraMap K0⟮X⟯ H (d i) * w i := by
          rw [← Finset.sum_sub_distrib]
          apply Finset.sum_congr rfl
          intro i _
          rw [map_sub, ← IsScalarTower.algebraMap_apply K0 K0⟮X⟯ H]
          ring
        rw [h2, hdsum, sub_zero]
      rw [he]
      exact Valuation.map_sum_lt' _ zero_lt_one hterm
    let y : R.toValuationSubring := ∑ i ∈ t, algebraMap K0 R.toValuationSubring (a i) * b i
    have hy : algebraMap R.toValuationSubring H y =
        ∑ i ∈ t, algebraMap K0 H (a i) * w i := by
      simp only [y, map_sum, map_mul]
      rfl
    have hres : IsLocalRing.residue R.toValuationSubring y = 0 := by
      rw [residue_zero_iff R y]
      change R.valuation (algebraMap R.toValuationSubring H y) < 1
      rw [hy]
      exact hsumlt
    have hsum0 : ∑ i ∈ t, a i • (i : R.residueField) = 0 := by
      rw [← hres]
      simp only [y, map_sum, map_mul, hb]
      apply Finset.sum_congr rfl
      intro i _
      rw [Algebra.smul_def, IsScalarTower.algebraMap_apply K0 R.toValuationSubring R.residueField,
        IsLocalRing.ResidueField.algebraMap_eq]
    exact ha1 (linearIndependent_iff'.mp hs t a hsum0 i1 hi1)
  have hc := hind.fintype_card_le_finrank
  simpa only [Fintype.card_coe] using hc
theorem degree_le_of_rational_restrict (R : Place K0 H)
    (hP : (restrictPlace K0 K0⟮X⟯ H R).degree = 1) :
    0 < R.degree ∧ R.degree ≤ finrank K0⟮X⟯ H := by
  have hrank : Module.rank K0 R.residueField ≤ (finrank K0⟮X⟯ H : Cardinal) :=
    rank_le (fun s hs => residue_card_le K0 H R hP s hs)
  haveI hfin : Module.Finite K0 R.residueField :=
    Module.rank_lt_aleph0_iff.mp (lt_of_le_of_lt hrank Cardinal.natCast_lt_aleph0)
  refine ⟨?_, Module.finrank_le_of_rank_le hrank⟩
  exact Module.finrank_pos
end DegreeBound
section DegreeOne
variable (k E L : Type*) [Field k] [Field E] [Field L]
  [Fintype k] [Finite E] [Algebra k E] [Algebra k L] [Algebra E L]
  [IsScalarTower k E L] [FunctionField.IsFullConstantField E L]
  [Algebra k⟮X⟯ L] [IsScalarTower k k⟮X⟯ L] [_root_.FunctionField k L]
  [Algebra.IsSeparable k⟮X⟯ L]
theorem degree_one_of_invariant (θ : L ≃ₐ[k] L)
    (hx : θ (algebraMap k⟮X⟯ L RatFunc.X) = algebraMap k⟮X⟯ L RatFunc.X)
    (hθ : ∀ c : E, θ (algebraMap E L c) =
      algebraMap E L (FiniteField.frobeniusAlgEquivOfAlgebraic k E c))
    (ho : orderOf θ = finrank k E) (D : ℕ)
    (hD : finrank k⟮X⟯ L ≤ D * finrank k E) (hfact : D.factorial ∣ finrank k E)
    (Q : Place E L) (hQ : ∀ x, Q.valuation (θ x) = Q.valuation x)
    (hP : (restrictPlace k k⟮X⟯ L (forgetConstants k E L Q)).degree = 1) :
    Q.degree = 1 := by
  classical
  let H := arithmeticFixedField k L θ
  letI := arithmeticRatFuncAlgebra k E L θ hx
