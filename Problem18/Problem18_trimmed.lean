attribute [-instance] FunLike.toDecidableEq CommSemiRingCat.FilteredColimits.colimitCommSemiring SemiRingCat.instSemiringObjForgetRingHomCarrier AddMonoidAlgebra.instHopfAlgebraStruct AddMonoidAlgebra.instBialgebra Bialgebra.toAlgebra
namespace Problem18EliminationCoordinates20260929
open Problem18Elimination20260929 Problem18ArrayElimination20260929
variable {K : Type*} [Field K] [DecidableEq K] {n m : ℕ}
def synthesis (v : Fin m → Fin n → K) : (Fin m → K) →ₗ[K] (Fin n → K) :=
  ∑ j, (LinearMap.proj j).smulRight (v j)
@[simp] theorem synthesis_apply (v : Fin m → Fin n → K) (c : Fin m → K) :
    synthesis v c = ∑ j, c j • v j := by simp [synthesis]
def augmented (v : Fin m → Fin n → K) (j : Fin m) : Vector K (n + m) :=
  Vector.ofFn (Fin.addCases (v j) (Pi.single j 1))
def query (x : Fin n → K) : Vector K (n + m) := Vector.ofFn (Fin.addCases x 0)
def rows (v : Fin m → Fin n → K) : List (Vector K (n + m)) :=
  (List.finRange m).map (augmented v)
@[simp] theorem augmented_prefix (v : Fin m → Fin n → K) (j : Fin m) :
    observe (Fin.castAdd m) (read (augmented v j)) = v j := by
  ext i
  simp [augmented]
@[simp] theorem augmented_suffix (v : Fin m → Fin n → K) (j : Fin m) :
    observe (Fin.natAdd n) (read (augmented v j)) = Pi.single j 1 := by
  ext i
  simp [augmented]
@[simp] theorem query_prefix (x : Fin n → K) :
    observe (Fin.castAdd m) (read (query (m := m) x)) = x := by
  ext i
  simp [query]
@[simp] theorem query_suffix (x : Fin n → K) :
    observe (Fin.natAdd n) (read (query (m := m) x)) = 0 := by
  ext i
  simp [query]
lemma observed_rowSpan (v : Fin m → Fin n → K) :
    (rowSpan (K := K) ((rows v).map read)).map (observe (Fin.castAdd m)) =
      Submodule.span K (Set.range v) := by
  rw [rowSpan, Submodule.map_span]
  congr 1
  ext y
  simp only [Set.mem_image, Set.mem_setOf_eq, List.mem_map, rows, List.mem_finRange,
    true_and, Set.mem_range]
  constructor
  · rintro ⟨z, ⟨w, ⟨j, rfl⟩, rfl⟩, rfl⟩
    exact ⟨j, (augmented_prefix v j).symm⟩
  · rintro ⟨j, rfl⟩
    exact ⟨read (augmented v j), ⟨augmented v j, ⟨j, rfl⟩, rfl⟩, augmented_prefix v j⟩
def coordinates (v : Fin m → Fin n → K) (x : Fin n → K) : Vector K m :=
  let r := reduceArray (List.finRange n) (Fin.castAdd m) (rows v) (query x)
  Vector.ofFn (fun j => -read r.1 (j.natAdd n))
theorem coordinates_solution (v : Fin m → Fin n → K) (x : Fin n → K)
    (hx : x ∈ Submodule.span K (Set.range v)) :
    ∑ j, read (coordinates v x) j • v j = x := by
  let p : (Fin (n + m) → K) →ₗ[K] (Fin n → K) := observe (Fin.castAdd m)
  let s : (Fin (n + m) → K) →ₗ[K] (Fin m → K) := observe (Fin.natAdd n)
  let R := reduce (List.finRange n) p ((rows v).map read)
  let z := R (read (query (m := m) x))
  have hz : p z = 0 := by
    apply (reduce_eq_zero_iff (List.finRange n) (by simp) p
      ((rows v).map read) (read (query x))).mpr
    simpa only [p, query_prefix, observed_rowSpan] using hx
  let g : (Fin (n + m) → K) →ₗ[K] (Fin n → K) := p - (synthesis v).comp s
  have hg : rowSpan (K := K) ((rows v).map read) ≤ LinearMap.ker g := by
    apply Submodule.span_le.mpr
    intro w hw
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hw
    obtain ⟨j, _, rfl⟩ := List.mem_map.mp ha
    change p (read (augmented v j)) - synthesis v (s (read (augmented v j))) = 0
    simp [p, s, synthesis_apply, Pi.single_apply]
  have hd := (reduce_spec (List.finRange n) (by simp) p ((rows v).map read)).1
    (read (query (m := m) x))
  have heq := hg hd
  change p (read (query (m := m) x) - z) -
    synthesis v (s (read (query (m := m) x) - z)) = 0 at heq
  have hpq : p (read (query (m := m) x)) = x := query_prefix x
  have hsq : s (read (query (m := m) x)) = 0 := query_suffix x
  rw [map_sub, hpq, hz, sub_zero, map_sub, hsq, zero_sub] at heq
  have hc : read (coordinates v x) = -(s z) := by
    ext j
    simp only [coordinates, read_ofFn, reduceArray_read, Pi.neg_apply, s, observe_apply]
    rfl
  rw [hc, ← synthesis_apply]
  exact (sub_eq_zero.mp heq).symm
theorem coordinates_eq_basis_repr (b : Module.Basis (Fin m) K (Fin n → K)) (x : Fin n → K) :
