def body : Com := .seq core (.assign q.j (plus (.var q.j) (.lit 1)))
def loop : Com := .while (.lt (.var q.j) (.var sizeReg)) body
def program : Com := .seq (constLoadE canonical q ci (.var output) (.lit 0))
