namespace Mathproof.Problem18IMPFieldPresentation20261001
open scoped BigOperators
open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Problem18IMPFieldLayout20261001 Problem18IMPFieldAddition20261001
open Problem18IMPFieldEquality20261001 Problem18AllFormatRoot20260930
open Problem18IMPFieldMultiplication20261001 Problem18IMPFieldMultiplicationLoop20261001
variable {K : Type} [Field K] (F : FieldPresentation K)
def decode (v : Fin F.e → Nat) : K :=
  ∑ i : Fin F.e, (v i : K) * F.generator ^ i.val
def slice (σ : Env) (r : FieldNames) (base : Nat) : Fin F.e → Nat :=
  fun i => (σ.arrs r.mem).getD (base+i.val) 0
def Canonical (v : Fin F.e → Nat) : Prop := ∀i,v i<F.p
theorem decode_coordinates (x : K) : decode F (fun i => (F.coordinate x i).val)=x :=
  (F.coordinate_spec x).symm
theorem decode_injective {v w : Fin F.e → Nat} (hv : Canonical F v) (hw : Canonical F w) :
    decode F v=decode F w ↔ v=w := by
  let cv : Fin F.e → Fin F.p := fun i => ⟨v i,hv i⟩
  let cw : Fin F.e → Fin F.p := fun i => ⟨w i,hw i⟩
  have hcv : decode F v=F.coordinate.symm cv := by
    simpa [decode,cv] using (F.coordinate_spec (F.coordinate.symm cv)).symm
  have hcw : decode F w=F.coordinate.symm cw := by
    simpa [decode,cw] using (F.coordinate_spec (F.coordinate.symm cw)).symm
  constructor
  · intro h
    rw [hcv,hcw] at h
    have hc:=F.coordinate.symm.injective h
    funext i
    exact congrArg Fin.val (congrFun hc i)
  · rintro rfl; rfl
def fieldValue (op : PointOp) (x y : K) : K :=
  match op with
  | .copy => x
  | .add => x+y
  | .neg => -x
  | .sub => x-y
theorem cast_pointValue (op : PointOp) {a b : Nat} (ha : a<F.p) (hb : b<F.p) :
    (pointValue op F.p a b : K)=fieldValue op (a : K) (b : K) := by
  letI : CharP K F.p := F.characteristic
  have hp : (F.p : K)=0 := CharP.cast_eq_zero K F.p
  cases op with
  | copy => rfl
  | add =>
    change (((a+b)%F.p : Nat) : K)=(a : K)+b
    rw [←CharP.cast_eq_mod K F.p (a+b),Nat.cast_add]
  | neg =>
    change (((F.p-a)%F.p : Nat) : K)=-(a : K)
    rw [←CharP.cast_eq_mod K F.p (F.p-a),Nat.cast_sub (Nat.le_of_lt ha),hp,zero_sub]
  | sub =>
    change (((a+F.p-b)%F.p : Nat) : K)=(a : K)-b
    rw [←CharP.cast_eq_mod K F.p (a+F.p-b),Nat.cast_sub (by omega),Nat.cast_add,hp,add_zero]
theorem decode_pointValue (op : PointOp) {v w : Fin F.e → Nat}
    (hv : Canonical F v) (hw : Canonical F w) :
    decode F (fun i => pointValue op F.p (v i) (w i))=
      fieldValue op (decode F v) (decode F w) := by
  unfold decode
  simp_rw [cast_pointValue F op (hv _) (hw _)]
  cases op <;> simp [fieldValue,add_mul,sub_mul,Finset.sum_add_distrib,Finset.sum_sub_distrib]
theorem pointState_slice (r : FieldNames) (σ : Env) (f : Nat→Nat)
    (he : σ.vars r.e=F.e)
    (ho : σ.vars r.outBase+σ.vars r.e ≤ (σ.arrs r.mem).length) :
    slice F (pointState σ r f (σ.vars r.e)) r (σ.vars r.outBase)=fun i=>f i.val := by
  funext i
  simpa [slice,pointState] using writeValues_inside (σ.arrs r.mem) (σ.vars r.outBase)
    (σ.vars r.e) i.val f ho (by simpa only [he] using i.isLt)
theorem pointState_decodes (r : FieldNames) (op : PointOp) (σ : Env)
    (he : σ.vars r.e=F.e) (hp : σ.vars r.p=F.p)
    (ho : σ.vars r.outBase+σ.vars r.e ≤ (σ.arrs r.mem).length)
    (ha : Canonical F (slice F σ r (σ.vars r.aBase)))
    (hb : Canonical F (slice F σ r (σ.vars r.bBase))) :
    decode F (slice F (pointState σ r (resultValues σ r op) (σ.vars r.e)) r (σ.vars r.outBase))=
      fieldValue op (decode F (slice F σ r (σ.vars r.aBase)))
        (decode F (slice F σ r (σ.vars r.bBase))) := by
  rw [pointState_slice F r σ _ he ho]
  simpa only [resultValues,hp,slice] using decode_pointValue F op ha hb
theorem pointState_canonical (r : FieldNames) (op : PointOp) (σ : Env)
    (he : σ.vars r.e=F.e) (hp : σ.vars r.p=F.p)
    (ho : σ.vars r.outBase+σ.vars r.e ≤ (σ.arrs r.mem).length)
    (ha : Canonical F (slice F σ r (σ.vars r.aBase))) :
    Canonical F (slice F (pointState σ r (resultValues σ r op) (σ.vars r.e)) r (σ.vars r.outBase)) := by
  rw [pointState_slice F r σ _ he ho]
  intro i
  simp only [resultValues,hp]
  exact pointValue_lt op F.prime.pos (ha i)
theorem equality_decodes (r : FieldNames) (σ : Env) (he : σ.vars r.e=F.e)
    (ha : Canonical F (slice F σ r (σ.vars r.aBase)))
    (hb : Canonical F (slice F σ r (σ.vars r.bBase))) :
    (eqState σ r (σ.vars r.e)).vars r.flag=1 ↔
      decode F (slice F σ r (σ.vars r.aBase))=decode F (slice F σ r (σ.vars r.bBase)) := by
  rw [eqState_flag,decode_injective F ha hb]
  constructor
  · intro h
    funext i
    exact h i.val (by simpa [he] using i.isLt)
  · intro h j hj
    exact congrFun h ⟨j,by simpa [he] using hj⟩
structure PointInput (r : FieldNames) (B : Nat) (σ : Env) : Prop where
  degree : σ.vars r.e=F.e
  prime : σ.vars r.p=F.p
  names : ∀x∈[r.p,r.e,r.aBase,r.bBase,r.outBase],x≠r.i
  degree_word : σ.vars r.e<B
  arithmetic_word : (σ.vars r.p+1)^2<B
  memory_word : (σ.arrs r.mem).length<B
  first_fits : σ.vars r.aBase+σ.vars r.e ≤ (σ.arrs r.mem).length
  second_fits : σ.vars r.bBase+σ.vars r.e ≤ (σ.arrs r.mem).length
  output_fits : σ.vars r.outBase+σ.vars r.e ≤ (σ.arrs r.mem).length
  first_disjoint : σ.vars r.outBase+σ.vars r.e ≤ σ.vars r.aBase ∨
    σ.vars r.aBase+σ.vars r.e ≤ σ.vars r.outBase
  second_disjoint : σ.vars r.outBase+σ.vars r.e ≤ σ.vars r.bBase ∨
    σ.vars r.bBase+σ.vars r.e ≤ σ.vars r.outBase
  first_canonical : Canonical F (slice F σ r (σ.vars r.aBase))
  second_canonical : Canonical F (slice F σ r (σ.vars r.bBase))
theorem pointRoutine_correct (r : FieldNames) (op : PointOp) {B : Nat} (σ : Env)
    (h : PointInput F r B σ) :
    ∃τ,Run B (pointRoutine r op) σ τ (1000*(F.e+1)) ∧
      decode F (slice F τ r (σ.vars r.outBase))=
        fieldValue op (decode F (slice F σ r (σ.vars r.aBase)))
          (decode F (slice F σ r (σ.vars r.bBase))) ∧
      Canonical F (slice F τ r (σ.vars r.outBase)) ∧
      (∀x,x≠r.i → τ.vars x=σ.vars x) ∧
      (∀arr,arr≠r.mem → τ.arrs arr=σ.arrs arr) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  let τ:=pointState σ r (resultValues σ r op) (σ.vars r.e)
  have hp:0<σ.vars r.p:=by rw [h.prime]; exact F.prime.pos
  have hc : ∀j<σ.vars r.e,(σ.arrs r.mem).getD (σ.vars r.aBase+j) 0<σ.vars r.p ∧
      (σ.arrs r.mem).getD (σ.vars r.bBase+j) 0<σ.vars r.p := by
    intro j hj
    let i:Fin F.e:=⟨j,by simpa [h.degree] using hj⟩
    simpa only [Canonical,slice,i,h.prime] using
      And.intro (h.first_canonical i) (h.second_canonical i)
  refine ⟨τ,?_,pointState_decodes F r op σ h.degree h.prime h.output_fits
    h.first_canonical h.second_canonical,
    pointState_canonical F r op σ h.degree h.prime h.output_fits h.first_canonical,?_,?_,rfl,rfl⟩
  · simpa only [τ,h.degree] using pointRoutine_run (B:=B) r op σ h.names hp h.degree_word
      h.arithmetic_word h.memory_word h.first_fits h.second_fits h.output_fits
      h.first_disjoint h.second_disjoint hc
  · intro x hx; simp [τ,pointState,hx]
  · intro arr harr; simp [τ,pointState,harr]
theorem weighted_decode (v : Nat→Nat) :
    weighted F.generator F.e (fun j=>(v j : K))=decode F (fun i=>v i.val) := by
  unfold weighted decode
  rw [Finset.sum_range]
theorem productCoeffs_decodes (r : FieldNames) (modArray : String) (σ : Env)
    (he : σ.vars r.e=F.e) (hp : σ.vars r.p=F.p)
    (hm : ∀i:Fin F.e,sourceCoeff σ modArray r.modBase i.val=(F.modulus i).val) :
    decode F (fun i=>productCoeffs r modArray σ i.val)=
      decode F (slice F σ r (σ.vars r.aBase))*decode F (slice F σ r (σ.vars r.bBase)) := by
  letI : CharP K F.p:=F.characteristic
  unfold slice
  have hroot : F.generator^F.e+weighted F.generator F.e
      (fun j=>(sourceCoeff σ modArray r.modBase j : K))=0 := by
    rw [weighted_decode]
    simpa [decode,hm] using F.modulus_spec
  have hh:=hornerCoeffs_mul F.p F.e F.generator (sourceCoeff σ modArray r.modBase)
    (sourceCoeff σ r.mem r.aBase) (sourceCoeff σ r.mem r.bBase) F.prime.pos F.degree_pos hroot
  simpa only [productCoeffs,he,hp,weighted_decode,slice,sourceCoeff] using hh
theorem mulCore_field_correct (r : FieldNames) (modArray : String) {B : Nat} (σ : Env)
    (h : MulInput r modArray B σ) (he : σ.vars r.e=F.e) (hp : σ.vars r.p=F.p)
    (hm : ∀i:Fin F.e,sourceCoeff σ modArray r.modBase i.val=(F.modulus i).val) :
    Run B (mulCore r modArray) σ (completed r modArray σ) (10000*(F.e+1)^2) ∧
      decode F (slice F (completed r modArray σ) r (σ.vars r.outBase))=
        decode F (slice F σ r (σ.vars r.aBase))*decode F (slice F σ r (σ.vars r.bBase)) ∧
      Canonical F (slice F (completed r modArray σ) r (σ.vars r.outBase)) := by
  have hc:=mulCore_correct h
  refine ⟨by simpa only [he] using hc.1,?_,?_⟩
  · have hs : slice F (completed r modArray σ) r (σ.vars r.outBase)=
        fun i=>productCoeffs r modArray σ i.val := by
      funext i
      exact (hc.2 i.val (by simpa only [he] using i.isLt)).1
    rw [hs]
    exact productCoeffs_decodes F r modArray σ he hp hm
  · intro i
    have hh:=hc.2 i.val (by simpa only [he] using i.isLt)
    change ((completed r modArray σ).arrs r.mem).getD (σ.vars r.outBase+i.val) 0<F.p
    rw [hh.1]
    simpa only [hp] using hh.2
end Mathproof.Problem18IMPFieldPresentation20261001
