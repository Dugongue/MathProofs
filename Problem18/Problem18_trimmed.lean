    augmentedKernelEntry,transformedEntry,PolyExpr.eval,eval_sumFin_eq_finset_sum,
    tensorEntry,pEntry,rEntry,Finset.sum_mul,mul_assoc]
def finiteTemplate {P V : Type} [Fintype P] [Fintype V]
    (p : PolyExpr (P ⊕ V) Int) : PolyExpr (Fin (Fintype.card P) ⊕ Fin (Fintype.card V)) Int :=
  reindex (Sum.map (Fintype.equivFin P) (Fintype.equivFin V)) p
theorem finite_eval {P V : Type} [Fintype P] [Fintype V]
    (p : PolyExpr (P ⊕ V) Int) (z : P→K) (x : V→K) :
    interpret (Int.castRingHom K)
      (Sum.elim (z ∘ (Fintype.equivFin P).symm) (x ∘ (Fintype.equivFin V).symm))
