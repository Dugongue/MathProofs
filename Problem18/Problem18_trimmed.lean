def asPolynomial : MvPolynomial (Fin 2) K ≃ₐ[K] Polynomial (Polynomial K) :=
  (finSuccEquiv K 1).trans (Polynomial.mapAlgEquiv (uniqueAlgEquiv K (Fin 1)))
theorem unique_degree_le (f : MvPolynomial (Fin 1) K) :
    (uniqueAlgEquiv K (Fin 1) f).natDegree ≤ f.totalDegree := by
  apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
  intro k hk
  rw [coeff_uniqueAlgEquiv]
  apply coeff_eq_zero_of_totalDegree_lt
  change f.totalDegree < (Finsupp.single (0 : Fin 1) k).sum (fun _ m => m)
  rw [Finsupp.sum_single_index]
  · exact hk
  · rfl
theorem coefficient_degree_le (f : MvPolynomial (Fin 2) K) (i : Nat) :
    ((asPolynomial f).coeff i).natDegree ≤ f.totalDegree := by
  change ((Polynomial.map (uniqueAlgEquiv K (Fin 1)).toRingHom
    (finSuccEquiv K 1 f)).coeff i).natDegree ≤ _
  rw [Polynomial.coeff_map]
  apply (unique_degree_le _).trans
  by_cases hi : (finSuccEquiv K 1 f).coeff i = 0
  · simp [hi]
  · exact (Nat.le_add_right _ _).trans (totalDegree_coeff_finSuccEquiv_add_le f i hi)
theorem asPolynomial_degree_le (f : MvPolynomial (Fin 2) K) :
    (asPolynomial f).natDegree ≤ f.totalDegree := by
  change (Polynomial.map (uniqueAlgEquiv K (Fin 1)).toRingHom
    (finSuccEquiv K 1 f)).natDegree ≤ _
  apply Polynomial.natDegree_map_le.trans
  rw [natDegree_finSuccEquiv]
