variable {K : Type} [Field K] [Fintype K] [SolverSize K] [DecidableEq K]
structure Config where
  depth : Nat → Nat
  memoryCap : Nat → Nat → Nat
  memoryCap_mono : ∀ d R R', R ≤ R' → memoryCap d R ≤ memoryCap d R'
  memoryBank : String
  layoutBank : String
  idx : String
  count : String
  clauseFlag : String
  patternFlag : String
  fixedFlag : String
structure Config.Valid (P : Config) : Prop where
  memory_name : P.memoryBank ≠ canonical.mem
  memory_scratch : P.memoryBank ≠ canonical.scratch
  layout_name : P.layoutBank ≠ canonical.mem
  layout_scratch : P.layoutBank ≠ canonical.scratch
  idx_count : P.idx ≠ P.count
  idx_protected : ∀ x ∈ protectedNames P.count, P.idx ≠ x
  count_fresh : P.count ∉ fixedTargets
  clause_flag :
    P.clauseFlag = Problem18P34Subfield20261003NConcreteFiniteParameterSolver.geoNames.z
  clause_pattern : P.clauseFlag ≠ P.patternFlag
  pattern_reg : P.patternFlag ∉ regNames canonical
  pattern_fixed : P.patternFlag ≠ P.fixedFlag
  fixed_reg : P.fixedFlag ∉ regNames canonical
def Config.program (P : Config) (n d : Nat) : Com :=
  Problem18P34Subfield20261003NConcreteFixedTestProgram.program n d (P.depth d)
    P.memoryBank P.layoutBank P.idx P.count P.clauseFlag P.patternFlag P.fixedFlag
theorem existsMappedCost_mono {α : Type} (f g : α → Nat) :
    ∀ xs : List α, (∀ x ∈ xs, f x ≤ g x) →
      existsMappedCost f xs ≤ existsMappedCost g xs := by
  intro xs
  induction xs with
  | nil => intro _; rfl
  | cons x xs ih =>
      intro h
      have hx := h x List.mem_cons_self
      have ht := ih (fun y hy => h y (List.mem_cons_of_mem x hy))
      simp only [existsMappedCost]
      omega
def clauseCostBound (F : FieldPresentation K) (D M : Nat)
    {c0 m : Nat} (cl : Clause (Fin (c0 + m)) Int) : Nat :=
  22 + (12 * M + 6 + Problem18P34Subfield20261003NConcreteClauseDecision.cost F cl D)
def patternCostBound (F : FieldPresentation K) (n d D M : Nat)
    (pat : Σ k : Nat, Fin k → Fin (boxSize n (cpE n d))) : Nat :=
  2 + existsMappedCost (clauseCostBound F D M)
    (clauses (qe (template n d pat)))
def fixedCostBound (F : FieldPresentation K) (n d D M : Nat) : Nat :=
  2 + existsMappedCost (patternCostBound F n d D M)
    (patterns (boxSize n (cpE n d)))
theorem clauseCostBound_mono (F : FieldPresentation K) (D : Nat) {M M' : Nat}
    (hM : M ≤ M') {c0 m : Nat} (cl : Clause (Fin (c0 + m)) Int) :
    clauseCostBound F D M cl ≤ clauseCostBound F D M' cl := by
  unfold clauseCostBound
  omega
theorem patternCostBound_mono (F : FieldPresentation K) (n d D : Nat)
    {M M' : Nat} (hM : M ≤ M')
    (pat : Σ k : Nat, Fin k → Fin (boxSize n (cpE n d))) :
    patternCostBound F n d D M pat ≤ patternCostBound F n d D M' pat := by
  unfold patternCostBound
  have h := existsMappedCost_mono
    (clauseCostBound F D M) (clauseCostBound F D M')
    (clauses (qe (template n d pat)))
    (fun cl _ => clauseCostBound_mono F D hM cl)
  omega
theorem fixedCostBound_mono (F : FieldPresentation K) (n d D : Nat)
    {M M' : Nat} (hM : M ≤ M') :
    fixedCostBound F n d D M ≤ fixedCostBound F n d D M' := by
  unfold fixedCostBound
  have h := existsMappedCost_mono
    (patternCostBound F n d D M) (patternCostBound F n d D M')
    (patterns (boxSize n (cpE n d)))
    (fun pat _ => patternCostBound_mono F n d D hM pat)
  omega
def Config.fixedCost (P : Config) (F : FieldPresentation K)
    (n d R : Nat) : Nat :=
  fixedCostBound F n d (P.depth d) (P.memoryCap d R)
theorem Config.fixedCost_mono (P : Config) (F : FieldPresentation K)
    (n d R R' : Nat) (hR : R ≤ R') :
    P.fixedCost F n d R ≤ P.fixedCost F n d R' :=
  fixedCostBound_mono F n d (P.depth d) (P.memoryCap_mono d R R' hR)
structure Reference (P : Config) (F : FieldPresentation K)
    (n d B : Nat) (rows : List (DenseInput n d K)) (ρ : Env) : Prop where
  slots : ∀ pat ∈ patterns (boxSize n (cpE n d)),
    ∀ cl ∈ clauses (qe (template n d pat)),
      Slots F canonical names.q.WS (size cl (P.depth d)) B ρ
  memory_words : ∀ k (hk : k < (ρ.arrs canonical.mem).length),
    (ρ.arrs canonical.mem)[k] < B
  memory_length : (ρ.arrs canonical.mem).length ≤ P.memoryCap d rows.length
  count_value : ρ.vars P.count = (ρ.arrs canonical.mem).length
  seven : 7 < B
  image_bound : ∀ v ∈ image P.count ρ, v < B
  zero : val F canonical names.q.WS ρ 0 = 0
  cardinal : ρ.vars names.qr = SolverSize.card K
  cardinal_word : SolverSize.card K < B
  expressions : ∀ pat ∈ patterns (boxSize n (cpE n d)),
    ∀ cl ∈ clauses (qe (template n d pat)), ∀ p ∈ sysExprs cl,
      ∀ e ∈ rowExprs p (clauseDeg cl),
        polyDepth e ≤ P.depth d ∧ constBound e < B
  data : ∀ i : Fin (boxSize n d * boxSize n d),
    val F canonical names.q.WS ρ (5 + i.val) =
      flatData (rowData n d rows) i
  words : ∀ pat ∈ patterns (boxSize n (cpE n d)),
    ∀ cl ∈ clauses (qe (template n d pat)),
      (sysExprs cl).length + (pat.1 * boxSize n (cpE n d) + 1) +
        lenM (pat.1 * boxSize n (cpE n d) + 1)
          (eliminantShift (pat.1 * boxSize n (cpE n d) + 1) (clauseDeg cl)) +
        lenD (pat.1 * boxSize n (cpE n d) + 1) (clauseDeg cl) +
        lenM (pat.1 * boxSize n (cpE n d) + 1)
          (geoE (pat.1 * boxSize n (cpE n d) + 1)
            (frobeniusDegree (pat.1 * boxSize n (cpE n d) + 1) (clauseDeg cl))) +
        rowLength (pat.1 * boxSize n (cpE n d) + 1) (clauseDeg cl) < B
  tape : ρ.InpBounded B
def Loaded (P : Config) (F : FieldPresentation K) (n l d B : Nat)
    (rows : List (DenseInput n d K)) (σ : Env) : Prop :=
  ∃ ρ, Reference P F n d B rows ρ ∧
    Ready F B ρ P.memoryBank P.layoutBank P.count σ
theorem patternCost_le_bound (P : Config) (F : FieldPresentation K)
    (n d B : Nat) (rows : List (DenseInput n d K)) (ρ : Env)
    (href : Reference P F n d B rows ρ)
    (pat : Σ k : Nat, Fin k → Fin (boxSize n (cpE n d))) :
    Problem18P34Subfield20261003NConcreteFixedTestProgram.patternCost F ρ n d (P.depth d) pat ≤
      patternCostBound F n d (P.depth d) (P.memoryCap d rows.length) pat := by
  unfold Problem18P34Subfield20261003NConcreteFixedTestProgram.patternCost patternCostBound
  have hc : ∀ cl ∈ clauses (qe (template n d pat)),
      22 + (12 * (ρ.arrs canonical.mem).length + 6 +
        Problem18P34Subfield20261003NConcreteClauseDecision.cost F cl (P.depth d)) ≤
      clauseCostBound F (P.depth d) (P.memoryCap d rows.length) cl := by
    intro cl _
    unfold clauseCostBound
    have hm := href.memory_length
    omega
  have h := existsMappedCost_mono
    (fun cl => 22 + (12 * (ρ.arrs canonical.mem).length + 6 +
      Problem18P34Subfield20261003NConcreteClauseDecision.cost F cl (P.depth d)))
    (clauseCostBound F (P.depth d) (P.memoryCap d rows.length))
    (clauses (qe (template n d pat))) hc
  omega
theorem exactCost_le_fixedCost (P : Config) (F : FieldPresentation K)
    (n d B : Nat) (rows : List (DenseInput n d K)) (ρ : Env)
    (href : Reference P F n d B rows ρ) :
    2 + existsMappedCost
      (Problem18P34Subfield20261003NConcreteFixedTestProgram.patternCost F ρ n d (P.depth d))
      (patterns (boxSize n (cpE n d))) ≤
      P.fixedCost F n d rows.length := by
  unfold Config.fixedCost fixedCostBound
  have h := existsMappedCost_mono
    (Problem18P34Subfield20261003NConcreteFixedTestProgram.patternCost F ρ n d (P.depth d))
    (patternCostBound F n d (P.depth d) (P.memoryCap d rows.length))
    (patterns (boxSize n (cpE n d)))
    (fun pat _ => patternCost_le_bound P F n d B rows ρ href pat)
  omega
theorem fixed_spec_at_B (P : Config) (hP : P.Valid) (F : FieldPresentation K)
    (n d B : Nat) (rows : List (DenseInput n d K)) (σ : Env)
    (hload : Loaded P F n 1 d B rows σ) :
    ∃ τ, Run B (P.program n d) σ τ (P.fixedCost F n d rows.length) ∧
      τ.vars P.fixedFlag = (if (Problem18P34Subfield20261003Semantics.fixedTest n d rows).1 then 1 else 0) ∧
      Loaded P F n 1 d B rows τ := by
  obtain ⟨ρ, href, hready⟩ := hload
  obtain ⟨τ, hr, hready', hflag⟩ :=
    Problem18P34Subfield20261003NConcreteFixedTestProgram.run F n d (P.depth d) B rows
      P.memoryBank P.layoutBank P.idx P.count P.clauseFlag P.patternFlag P.fixedFlag
      ρ σ hready href.slots href.memory_words href.count_value
      hP.memory_name hP.memory_scratch hP.layout_name hP.layout_scratch
      hP.idx_count hP.idx_protected hP.count_fresh href.seven href.image_bound
      href.zero href.cardinal href.cardinal_word href.expressions href.data
      href.words href.tape hP.clause_flag hP.clause_pattern hP.pattern_reg
      hP.pattern_fixed hP.fixed_reg
  refine ⟨τ, hr.mono (exactCost_le_fixedCost P F n d B rows ρ href),
    hflag, ⟨ρ, href, hready'⟩⟩
theorem fixed_spec (P : Config) (hP : P.Valid) (F : FieldPresentation K)
    (n d0 l d B : Nat) (rows : List (DenseInput n d K)) (σ : Env)
    (hload : Loaded P F n (l + 1) d B rows σ) :
    ∃ τ, Run B (P.program n d) σ τ (P.fixedCost F n d rows.length) ∧
      τ.vars P.fixedFlag = (if (Problem18P34Subfield20261003Semantics.fixedTest n d rows).1 then 1 else 0) ∧
      Loaded P F n (l + 1) d B rows τ := by
  simpa only [Loaded] using fixed_spec_at_B P hP F n d B rows σ hload
end
end Mathproof.Problem18P34Subfield20261003NConcreteFixedLevelRoutine
