    (∀ s < Sn, (s < dv ∨ dv + Nv ≤ s) → val F r q.WS τ s = val F r q.WS σ s) ∧
    (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out
  have hI0 : I (σ.setVar q.j 0) := by
    refine ⟨Slots.setVar F r hS hjS hjW 0, by simp, ?_, ?_, ?_, fun _ _ _ => rfl, rfl, rfl⟩
    · intro x _ hxj; simp only [vars_setVar, if_neg hxj]
    · intro k _
      simp only [vars_setVar, if_true, Nat.not_lt_zero, if_false]
      exact val_setVar F r hjW σ 0 _
    · intro s _ _; exact val_setVar F r hjW σ 0 s
  have hNτ : ∀ τ, I τ → τ.vars q.N = Nv := fun τ hτ => by rw [hτ.2.2.1 q.N hNS hNj, hN]
  have hdef : ∀ τ, I τ → ∃ v, (Cond.lt (.var q.j) (.var q.N)).evalB B τ = some v := by
    intro τ hτ
    exact evalB_condLt_vars (by have := hτ.2.1; omega) (by rw [hNτ τ hτ]; omega)
  have hstep : ∀ τ, I τ → (Cond.lt (.var q.j) (.var q.N)).evalB B τ = some true →
      ∃ τ', Run B (rcopyBody M q D S) τ τ' (rcopyStep M D S) ∧ I τ' ∧
        Nv - τ'.vars q.j < Nv - τ.vars q.j := by
    intro τ hτ hc
    have hN' := hNτ τ hτ
    obtain ⟨hSτ, hjle, hfix, hdst, hfr, harr, hinp, hout⟩ := hτ
    have hkN : τ.vars q.j < Nv := by
      rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hN']; omega))] at hc
      simp only [Option.some.injEq, decide_eq_true_eq] at hc
      rw [hN'] at hc; exact hc
    set j := τ.vars q.j with hjdef
    have hDτ : D.evalB B τ = some dv := by
      rw [evalB_congr_varsIn (toL τ hfix) D hDp]; exact hDv
    have hSτv : S.evalB B τ = some sv := by
      rw [evalB_congr_varsIn (toL τ hfix) S hSp]; exact hSv
    have eidx : (Expr.bin .sub (.bin .sub (.var q.N) (.lit 1)) (.var q.j)).evalB B τ =
        some (Nv - 1 - j) := by
      have e1 : (Expr.bin .sub (.var q.N) (.lit 1)).evalB B τ = some (Nv - 1) :=
        evalB_bin (by rw [← hN']; exact evalB_var (by rw [hN']; omega)) (evalB_lit (by omega))
          (by change Nv - 1 < B; omega)
      exact evalB_bin e1 (evalB_var (by omega)) (by change Nv - 1 - j < B; omega)
    have esrc : (plus S (.bin .sub (.bin .sub (.var q.N) (.lit 1)) (.var q.j))).evalB B τ =
        some (sv + (Nv - 1 - j)) := by
      unfold plus; exact evalB_bin hSτv eidx (by change sv + (Nv - 1 - j) < B; omega)
    have hsrc : sv + (Nv - 1 - j) < dv ∨ dv + Nv ≤ sv + (Nv - 1 - j) := by
      rcases hds with h | h
      · exact Or.inr (by omega)
      · exact Or.inl (by omega)
    have hne : dv + j ≠ sv + (Nv - 1 - j) := by rcases hsrc with h | h <;> omega
    obtain ⟨τ1, hr1, hv1, hc1⟩ := slot_call F r M.copy_spec hSτ
      (plus S (.bin .sub (.bin .sub (.var q.N) (.lit 1)) (.var q.j)))
      (plus S (.bin .sub (.bin .sub (.var q.N) (.lit 1)) (.var q.j))) (plus D (.var q.j))
      esrc esrc (evalB_plus_var hDτ rfl (by omega))
      ⟨hlA S hSp, ⟨hNA, trivial⟩, hjA⟩ ⟨hlA D hDp, hjA⟩ ⟨hlB D hDp, hjB⟩ (by omega) (by omega)
      (by omega) hne hne
    have hj1 : τ1.vars q.j = j := call_regs_all hc1 q.j hjS
    have hinc : (plus (.var q.j) (.lit 1)).evalB B τ1 = some (j + 1) := by
      unfold plus
      exact evalB_bin (by rw [← hj1]; exact evalB_var (by rw [hj1]; omega)) (evalB_lit (by omega))
        (by change j + 1 < B; omega)
    refine ⟨τ1.setVar q.j (j + 1), ?_, ⟨Slots.setVar F r hc1.slots hjS hjW _, ?_, ?_,
      ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
    · refine (hr1.seq (Run.assign hinc)).mono (le_of_eq ?_)
      have e1 : (plus S (Expr.bin .sub (Expr.bin .sub (Expr.var q.N) (Expr.lit 1))
          (Expr.var q.j))).size = S.size + 6 := rfl
      have e2 : (plus D (Expr.var q.j)).size = D.size + 2 := rfl
      have e3 : (plus (Expr.var q.j) (Expr.lit 1)).size = 3 := rfl
      rw [e1, e2, e3]; unfold rcopyStep; omega
    · simp only [vars_setVar, if_true]; omega
    · intro x hx hxj
      simp only [vars_setVar, if_neg hxj]
      rw [call_regs_all hc1 x hx]; exact hfix x hx hxj
    · intro m hm
      rw [val_setVar F r hjW]
      simp only [vars_setVar, if_true]
      by_cases hmk : m = j
      · rw [hmk, if_pos (Nat.lt_succ_self _), hv1, hfr _ (by omega) hsrc]
      · rw [call_val hc1 (by omega) (by omega : dv + m ≠ dv + j), hdst m hm]
        by_cases hlt : m < j
        · rw [if_pos hlt, if_pos (by omega)]
        · rw [if_neg hlt, if_neg (by omega)]
    · intro s hs hout'
      have hsne : s ≠ dv + j := by rcases hout' with h | h <;> omega
      rw [val_setVar F r hjW, call_val hc1 hs hsne]
      exact hfr s hs hout'
    · intro a h1 h2
      simp only [arrs_setVar]; rw [hc1.arrays a h1 h2]; exact harr a h1 h2
    · simp only [inp_setVar]; rw [hc1.inp]; exact hinp
    · simp only [out_setVar]; rw [hc1.out]; exact hout
    · simp only [vars_setVar, if_true]; omega
  obtain ⟨τf, hrf, hIf, hcf⟩ := Run.while_count I (fun τ => Nv - τ.vars q.j) (rcopyStep M D S)
    hdef hstep hI0
  have hNf := hNτ τf hIf
  obtain ⟨hSf, hjf, hfixf, hdstf, hfrf, harrf, hinpf, houtf⟩ := hIf
  have hjeq : τf.vars q.j = Nv := by
    rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hNf]; omega))] at hcf
    simp only [Option.some.injEq, decide_eq_false_iff_not, not_lt] at hcf
    rw [hNf] at hcf; omega
  refine ⟨τf, ?_, hSf, ?_, hfrf, hfixf, hjeq, harrf, hinpf, houtf⟩
  · refine ((Run.assign (x := q.j) (evalB_lit (σ := σ) (by omega : 0 < B))).seq hrf).mono ?_
    simp only [vars_setVar, eq_self_iff_true, if_true, ite_true, Nat.sub_zero]
