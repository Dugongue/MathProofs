variable {k : Type*} [Field k] [DecidableEq k] {M : ℕ}
section Coordinate
abbrev coordRows (B : ℕ) (sys : List (DenseInput M B k)) :
    List (Vector k (boundedExponents M (B + certificateDegree M B 1)).length) :=
  macaulayRows B (certificateDegree M B 1) sys ++
    [targetRow 0 (B + certificateDegree M B 1) (unitTarget M)]
def coordCertificate (B : ℕ) (sys : List (DenseInput M B k)) (t : Fin M) :
    CertificateResult k (coordRows B sys).length :=
  arrayCertificate (coordRows B sys) (powerRow (B + certificateDegree M B 1) t 1)
def coordValue (B : ℕ) (sys : List (DenseInput M B k)) (t : Fin M) : k :=
  vget (coordCertificate B sys t).coefficients
    (macaulayRows B (certificateDegree M B 1) sys).length
noncomputable def coordRowPoly (B : ℕ) (sys : List (DenseInput M B k))
    (gs : List (MvPolynomial (Fin M) k)) (j : ℕ) : MvPolynomial (Fin M) k :=
  if j < (macaulayRows B (certificateDegree M B 1) sys).length then
    (polynomialRows (certificateDegree M B 1) gs).getD j 0
  else 1
theorem coordRow_read (B : ℕ) (sys : List (DenseInput M B k))
    (gs : List (MvPolynomial (Fin M) k)) (hv : List.Forall₂ (ValidDenseInput B) sys gs)
    (j : Fin (coordRows B sys).length) :
    rowFamily (coordRows B sys) j =
      observePolynomial (B + certificateDegree M B 1) (coordRowPoly B sys gs j.val) := by
  unfold coordRowPoly
  by_cases h : j.val < (macaulayRows B (certificateDegree M B 1) sys).length
  · rw [if_pos h]
    refine Eq.trans ?_ (polynomialRows_observation B (certificateDegree M B 1) sys gs hv ⟨j.val, h⟩)
    simp only [rowFamily, coordRows, List.getElem_append_left h]
  · rw [if_neg h]
    simp only [rowFamily, coordRows, List.getElem_append_right (Nat.le_of_not_lt h),
      List.getElem_singleton]
    exact targetRow_correct 0 _ (unitTarget M) 1 (unitTarget_valid M)
theorem coordRows_length (B : ℕ) (sys : List (DenseInput M B k)) :
    (coordRows B sys).length = (macaulayRows B (certificateDegree M B 1) sys).length + 1 := by
  simp only [coordRows, List.length_append, List.length_singleton]
theorem coordValue_sound (B : ℕ) (sys : List (DenseInput M B k))
    (gs : List (MvPolynomial (Fin M) k)) (hv : List.Forall₂ (ValidDenseInput B) sys gs)
    (t : Fin M) (h : (coordCertificate B sys t).member = true) :
    X t - C (coordValue B sys t) ∈ generatedIdeal (gs.toFinset : Set (MvPolynomial (Fin M) k)) := by
  have hF := valid_family_degrees B sys gs hv
  have hc := arrayCertificate_coefficients (coordRows B sys)
    (powerRow (B + certificateDegree M B 1) t 1) h
  rw [powerRow_read, pow_one] at hc
  have hsum : observePolynomial (B + certificateDegree M B 1)
      (∑ j ∈ Finset.range ((macaulayRows B (certificateDegree M B 1) sys).length + 1),
        vget (coordCertificate B sys t).coefficients j • coordRowPoly B sys gs j) =
      observePolynomial (B + certificateDegree M B 1) (X t) := by
    rw [← hc, map_sum, ← coordRows_length, ← Fin.sum_univ_eq_sum_range]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    rw [map_smul, coordRow_read B sys gs hv j]
    congr 1
    unfold vget
    exact dif_pos j.isLt
  have hlast : coordRowPoly B sys gs (macaulayRows B (certificateDegree M B 1) sys).length = 1 := by
    rw [coordRowPoly, if_neg (lt_irrefl _)]
  rw [Finset.sum_range_succ, hlast] at hsum
  have hsplit : ∑ j ∈ Finset.range (macaulayRows B (certificateDegree M B 1) sys).length,
      vget (coordCertificate B sys t).coefficients j • coordRowPoly B sys gs j =
      ∑ j ∈ Finset.range (macaulayRows B (certificateDegree M B 1) sys).length,
        vget (coordCertificate B sys t).coefficients j •
          (polynomialRows (certificateDegree M B 1) gs).getD j 0 := by
    refine Finset.sum_congr rfl (fun j hj => ?_)
    rw [coordRowPoly, if_pos (Finset.mem_range.mp hj)]
  rw [hsplit] at hsum
  have hP1 : ∑ j ∈ Finset.range (macaulayRows B (certificateDegree M B 1) sys).length,
      vget (coordCertificate B sys t).coefficients j •
        (polynomialRows (certificateDegree M B 1) gs).getD j 0 ∈
      macaulaySpan (gs.toFinset : Set (MvPolynomial (Fin M) k)) (certificateDegree M B 1) :=
    Submodule.sum_mem _ (fun j _ => Submodule.smul_mem _ _ (polynomialRow_mem _ gs j))
  have hone : vget (coordCertificate B sys t).coefficients
      (macaulayRows B (certificateDegree M B 1) sys).length • (1 : MvPolynomial (Fin M) k) =
      C (coordValue B sys t) := by
    rw [smul_eq_C_mul, mul_one]
    rfl
  rw [hone] at hsum
  have heq := observePolynomial_injective_bounded (B + certificateDegree M B 1) _ _
    ((totalDegree_add _ _).trans (max_le
      (macaulay_span_degree B (certificateDegree M B 1) _ hF hP1)
      (by rw [totalDegree_C]; exact Nat.zero_le _)))
    (by rw [totalDegree_X]; dsimp [certificateDegree]; omega) hsum
  rw [← heq, add_sub_cancel_right]
  exact macaulaySpan_le_ideal (N := M) (K := k) _ _ hP1
theorem coordCertificate_member (B : ℕ) (sys : List (DenseInput M B k))
    (gs : List (MvPolynomial (Fin M) k)) (hv : List.Forall₂ (ValidDenseInput B) sys gs)
    (t : Fin M) (c : k)
    (hc : X t - C c ∈ generatedIdeal (gs.toFinset : Set (MvPolynomial (Fin M) k))) :
    (coordCertificate B sys t).member = true := by
  classical
  have hF := valid_family_degrees B sys gs hv
  rw [coordCertificate, arrayCertificate_member, powerRow_read, pow_one]
  have hdeg : (X t - C c : MvPolynomial (Fin M) k).totalDegree ≤ 1 :=
    (totalDegree_sub _ _).trans (max_le (totalDegree_X _).le (by rw [totalDegree_C]; omega))
  have hmac := (mem_ideal_iff_uniform_macaulay gs.toFinset B hF _).mp hc
  have hmac' : X t - C c ∈ macaulaySpan (gs.toFinset : Set (MvPolynomial (Fin M) k))
      (certificateDegree M B 1) :=
    macaulaySpan_mono (by dsimp [certificateDegree, completionDepth]; omega) hmac
  have hspan : rowSpan (K := k) ((macaulayRows B (certificateDegree M B 1) sys).map read) =
      (macaulaySpan (gs.toFinset : Set _) (certificateDegree M B 1)).map
        (observePolynomial (B + certificateDegree M B 1)) := by
    rw [macaulayRows_read B _ sys gs hv, ← polynomialRows_span _ gs]
    simp only [rowSpan, Submodule.map_span]
    congr 1
    ext x
    simp
  have hsub : rowSpan (K := k) ((macaulayRows B (certificateDegree M B 1) sys).map read) ≤
      rowSpan (K := k) ((coordRows B sys).map read) := by
    apply Submodule.span_mono
    intro x hx
    simp only [Set.mem_setOf_eq, coordRows, List.map_append, List.mem_append] at hx ⊢
    exact Or.inl hx
  have h1 : observePolynomial (B + certificateDegree M B 1) (X t - C c) ∈
      rowSpan (K := k) ((coordRows B sys).map read) :=
    hsub (by rw [hspan]; exact ⟨_, hmac', rfl⟩)
  have h2 : observePolynomial (B + certificateDegree M B 1) (C c : MvPolynomial (Fin M) k) ∈
      rowSpan (K := k) ((coordRows B sys).map read) := by
    have hC : (C c : MvPolynomial (Fin M) k) = c • 1 := by rw [smul_eq_C_mul, mul_one]
    rw [hC, map_smul]
    refine Submodule.smul_mem _ _ (Submodule.subset_span ?_)
    simp only [Set.mem_setOf_eq, coordRows, List.map_append, List.mem_append, List.map_cons,
      List.map_nil, List.mem_singleton]
    right
    exact (targetRow_correct 0 _ (unitTarget M) 1 (unitTarget_valid M)).symm
  have hX : observePolynomial (B + certificateDegree M B 1) (X t : MvPolynomial (Fin M) k) =
      observePolynomial (B + certificateDegree M B 1) (X t - C c) +
        observePolynomial (B + certificateDegree M B 1) (C c) := by
    rw [← map_add, sub_add_cancel]
  rw [hX]
  exact Submodule.add_mem _ h1 h2
end Coordinate
section FiniteField
variable [Fintype k]
theorem prod_X_sub_C_eq : ∏ c : k, (Polynomial.X - Polynomial.C c) =
    (Polynomial.X ^ Fintype.card k - Polynomial.X : Polynomial k) := by
  classical
  have hm : (Polynomial.X ^ Fintype.card k - Polynomial.X : Polynomial k).Monic :=
    Polynomial.monic_X_pow_sub (by rw [Polynomial.degree_X]; exact_mod_cast Fintype.one_lt_card)
  have hr := Polynomial.prod_multiset_X_sub_C_of_monic_of_roots_card_eq hm (by
    rw [FiniteField.roots_X_pow_card_sub_X, FiniteField.X_pow_card_sub_X_natDegree_eq k
      Fintype.one_lt_card]
    rfl)
  rw [FiniteField.roots_X_pow_card_sub_X] at hr
  rw [← hr, Finset.prod_eq_multiset_prod]
theorem sub_mem_of_excluded (J : Ideal (MvPolynomial (Fin M) k)) (t : Fin M) (u : k)
    (hQ : X t ^ Fintype.card k - X t ∈ J)
    (hex : ∀ c, c ≠ u → (1 : MvPolynomial (Fin M) k) ∈ J ⊔ Ideal.span {X t - C c}) :
    X t - C u ∈ J := by
  classical
  rw [← Ideal.Quotient.eq_zero_iff_mem]
  set f : k → MvPolynomial (Fin M) k ⧸ J := fun c => Ideal.Quotient.mk J (X t - C c) with hf
  have hunit : ∀ c ∈ Finset.univ.erase u, IsUnit (f c) := by
    intro c hc
    obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp (hex c (Finset.ne_of_mem_erase hc))
    obtain ⟨e, rfl⟩ := Ideal.mem_span_singleton'.mp hb
    refine IsUnit.of_mul_eq_one (Ideal.Quotient.mk J e) ?_
    have h1 := congrArg (Ideal.Quotient.mk J) hab
    rw [map_add, map_one, Ideal.Quotient.eq_zero_iff_mem.mpr ha, zero_add, map_mul] at h1
    rw [hf, mul_comm]
    exact h1
  have hprod : ∏ c, f c = 0 := by
    have h := congrArg (fun p => Ideal.Quotient.mk J (Polynomial.aeval (X t : MvPolynomial (Fin M) k) p))
      (prod_X_sub_C_eq (k := k))
    simp only [map_prod, map_sub, Polynomial.aeval_X, Polynomial.aeval_C, map_pow,
      MvPolynomial.algebraMap_eq] at h
    rw [hf]
    simp only [map_sub]
    have h2 : Ideal.Quotient.mk J (X t ^ Fintype.card k - X t) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr hQ
    rw [map_sub, map_pow] at h2
    rw [← h2]
    convert h using 2
    all_goals simp [MvPolynomial.algebraMap_eq]
  rw [← Finset.mul_prod_erase Finset.univ f (Finset.mem_univ u)] at hprod
  have hu : IsUnit (∏ c ∈ Finset.univ.erase u, f c) :=
    Finset.prod_induction _ IsUnit (fun _ _ ha hb => ha.mul hb) isUnit_one hunit
  exact (hu.mul_left_eq_zero).mp hprod
end FiniteField
section Point
def extractPoint (Q d : ℕ) (vs : List (DenseInput M d k)) : (Fin M → k) × ℕ :=
  let steps := coordinateSteps Q d vs
  let sys := frobeniusSystem Q d vs
  (fun t => coordValue (frobeniusDegree M d) sys t,
    (steps.map fun s => s.2.2).sum +
      ((List.finRange M).map fun t => (coordCertificate (frobeniusDegree M d) sys t).fieldOps).sum)
variable [Fintype k]
theorem aeval_self (y : Fin M → k) (f : MvPolynomial (Fin M) k) : aeval y f = eval y f := rfl
theorem eval_eq_aeval_self (y : Fin M → k) (f : MvPolynomial (Fin M) k) :
    eval y f = aeval y f := rfl
theorem frobenius_sub_mem (Q d : ℕ) (vs : List (DenseInput M d k))
    (fs : List (MvPolynomial (Fin M) k)) (hv : List.Forall₂ (ValidDenseInput d) vs fs)
    (hpass : ∀ i, (eliminantCertificate d vs i).member = true) (t : Fin M) :
    X t ^ Q - X t ∈ generatedIdeal ((frobeniusPolys Q d vs fs).toFinset :
      Set (MvPolynomial (Fin M) k)) := by
  classical
  have hfsJ : generatedIdeal (fs.toFinset : Set (MvPolynomial (Fin M) k)) ≤
      generatedIdeal ((frobeniusPolys Q d vs fs).toFinset : Set (MvPolynomial (Fin M) k)) := by
    unfold generatedIdeal
    apply Ideal.span_mono
    intro f hf
    simp only [Finset.mem_coe, List.mem_toFinset] at hf ⊢
    exact List.mem_append_left _ hf
  have hmod := hfsJ (eliminant_mem d vs fs hv t (hpass t))
  have hrow : frobeniusPoly t (frobeniusResidue (eliminantCoefficients d vs t) Q).1 ∈
      generatedIdeal ((frobeniusPolys Q d vs fs).toFinset : Set (MvPolynomial (Fin M) k)) := by
    apply Ideal.subset_span
    simp only [Finset.mem_coe, List.mem_toFinset, frobeniusPolys, List.mem_append, List.mem_map,
      List.mem_finRange, true_and]
    exact Or.inr ⟨t, rfl⟩
  have h := frobeniusResidue_spec (eliminantDegree_pos M d) (eliminantCoefficients d vs t) Q
  rw [← map_pow] at h
  obtain ⟨g, hg⟩ := Ideal.mem_span_singleton.mp (Ideal.Quotient.eq.mp h)
  have h2 := congrArg (Polynomial.aeval (X t : MvPolynomial (Fin M) k)) hg
  rw [map_sub, map_mul, map_pow, Polynomial.aeval_X] at h2
  have hdecomp : (X t : MvPolynomial (Fin M) k) ^ Q - X t =
      frobeniusPoly t (frobeniusResidue (eliminantCoefficients d vs t) Q).1 -
        Polynomial.aeval (X t : MvPolynomial (Fin M) k)
            (modulus (eliminantCoefficients d vs t)) *
          Polynomial.aeval (X t : MvPolynomial (Fin M) k) g := by
    rw [frobeniusPoly, ← h2]
    ring
  rw [hdecomp]
  exact Ideal.sub_mem _ hrow (Ideal.mul_mem_right _ _ hmod)
theorem rational_root_frobenius (Q d : ℕ) (hQ : Q = Fintype.card k) (vs : List (DenseInput M d k))
    (fs : List (MvPolynomial (Fin M) k)) (hv : List.Forall₂ (ValidDenseInput d) vs fs)
    (hpass : ∀ i, (eliminantCertificate d vs i).member = true)
    (y : Fin M → k) (hy : ∀ f ∈ fs, eval y f = 0) :
    ∀ f ∈ frobeniusPolys Q d vs fs, eval y f = 0 := by
  intro f hf
  simp only [frobeniusPolys, List.mem_append, List.mem_map, List.mem_finRange, true_and] at hf
  rcases hf with hf | ⟨i, rfl⟩
  · exact hy f hf
  · have hm : Polynomial.aeval (y i) (modulus (eliminantCoefficients d vs i)) = 0 := by
      have h0 := aeval_generatedIdeal (L := k) y fs (fun f hf => by
        rw [aeval_self]; exact hy f hf) _ (eliminant_mem d vs fs hv i (hpass i))
      rw [aeval_aeval_X] at h0
      exact h0
    have hfe := frobenius_eval (eliminantDegree_pos M d) (eliminantCoefficients d vs i) Q (y i) hm
    rw [frobeniusPoly, map_sub]
    simp only [eval_eq_aeval_self]
    rw [aeval_aeval_X, hfe, hQ, FiniteField.pow_card,
      aeval_X, sub_self]
theorem extractPoint_eq {L : Type*} [Field L] [Algebra k L] [IsAlgClosed L]
    [Algebra.IsAlgebraic k L] (Q d : ℕ) (hQ : Q = Fintype.card k)
    (vs : List (DenseInput M d k)) (fs : List (MvPolynomial (Fin M) k))
    (hv : List.Forall₂ (ValidDenseInput d) vs fs) (y0 : Fin M → k)
    (hy0 : ∀ f ∈ fs, eval y0 f = 0)
    (huniq : ∀ x : Fin M → L, (∀ f ∈ fs, aeval x f = 0) → x = fun i => algebraMap k L (y0 i)) :
    (extractPoint Q d vs).1 = y0 := by
  classical
  have hfin : (zeroLocus L (generatedIdeal (fs.toFinset : Set (MvPolynomial (Fin M) k)))).Finite := by
    refine (Set.finite_singleton (fun i => algebraMap k L (y0 i))).subset ?_
    intro x hx
    rw [mem_zeroLocus_iff] at hx
    exact huniq x (fun f hf => hx f (Ideal.subset_span (by simpa using hf)))
  have hpass := gate_of_finite d vs fs hv hfin
  have hv' := frobeniusSystem_valid Q d vs fs hv
  have hroot := rational_root_frobenius Q d hQ vs fs hv hpass y0 hy0
  funext t
  have hJ : X t - C (y0 t) ∈ generatedIdeal ((frobeniusPolys Q d vs fs).toFinset :
      Set (MvPolynomial (Fin M) k)) := by
    apply sub_mem_of_excluded _ t (y0 t) (hQ ▸ frobenius_sub_mem Q d vs fs hv hpass t)
    intro c hc
    have h1 : (1 : MvPolynomial (Fin M) k) ∈ generatedIdeal
        ((frobeniusPolys Q d vs fs ++ [X t - C c]).toFinset : Set (MvPolynomial (Fin M) k)) := by
      rw [one_mem_ideal_iff_no_geometric_root (L := L)]
      rintro ⟨x, hx⟩
      have hxfs : ∀ f ∈ fs, aeval x f = 0 := fun f hf =>
        hx f (List.mem_append_left _ (List.mem_append_left _ hf))
      have hxt := hx (X t - C c) (List.mem_append_right _ (List.mem_singleton_self _))
      rw [huniq x hxfs, map_sub, aeval_X, aeval_C, sub_eq_zero] at hxt
      exact hc (FaithfulSMul.algebraMap_injective k L hxt).symm
