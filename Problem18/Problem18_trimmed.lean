variable {σ R K : Type*} [CommRing R] [Field K]
def interpret (f : R →+* K) (x : σ→K) : PolyExpr σ R → K
  | .const c => f c
  | .var i => x i
  | .add a b => interpret f x a+interpret f x b
  | .mul a b => interpret f x a*interpret f x b
@[simp] theorem interpret_sub (f : R →+* K) (x : σ→K) (a b : PolyExpr σ R) :
    interpret f x (PolyExpr.sub a b)=interpret f x a-interpret f x b := by
  simp [PolyExpr.sub,PolyExpr.neg,interpret,sub_eq_add_neg]
inductive TestTree (σ R : Type*) where
  | accept
  | reject
  | test (p : PolyExpr σ R) (zero nonzero : TestTree σ R)
def TestTree.Holds (f : R →+* K) (x : σ→K) : TestTree σ R → Prop
  | .accept => True
  | .reject => False
  | .test p z n => (interpret f x p=0 ∧ z.Holds f x) ∨
      (interpret f x p≠0 ∧ n.Holds f x)
def zeroTree {c : Nat} (v : Fin c→PolyExpr σ R) : List (Fin c) → TestTree σ R
  | [] => .accept
  | i::is => .test (v i) (zeroTree v is) .reject
def pivotTree {c : Nat} (v : Fin c→PolyExpr σ R)
    (zero : TestTree σ R) (nonzero : Fin c→TestTree σ R) :
    List (Fin c) → TestTree σ R
  | [] => zero
  | i::is => .test (v i) (pivotTree v zero nonzero is) (nonzero i)
def fractionFreeExpr {c : Nat} (v x : Fin c→PolyExpr σ R) (i : Fin c) :
    Fin c→PolyExpr σ R :=
  fun j => PolyExpr.sub (.mul (v i) (x j)) (.mul (x i) (v j))
def spanTree {c : Nat} : Nat → List (Fin c→PolyExpr σ R) →
    (Fin c→PolyExpr σ R) → TestTree σ R
  | 0, _, x => zeroTree x (List.finRange c)
  | _+1, [], x => zeroTree x (List.finRange c)
  | fuel+1, v::vs, x => pivotTree v (spanTree fuel vs x)
      (fun i => spanTree fuel (vs.map (fun w => fractionFreeExpr v w i))
        (fractionFreeExpr v x i)) (List.finRange c)
def interpretRow {c : Nat} (f : R→+*K) (x : σ→K) (v : Fin c→PolyExpr σ R) : Fin c→K :=
  fun i => interpret f x (v i)
theorem zeroTree_correct {c : Nat} (f : R→+*K) (x : σ→K)
    (v : Fin c→PolyExpr σ R) (cs : List (Fin c)) :
    (zeroTree v cs).Holds f x ↔ ∀ i∈cs, interpretRow f x v i=0 := by
  induction cs with
  | nil => simp [zeroTree,TestTree.Holds]
  | cons i cs ih => simp [zeroTree,TestTree.Holds,ih,interpretRow]
theorem zeroTree_full_correct {c : Nat} (f : R→+*K) (x : σ→K)
    (v : Fin c→PolyExpr σ R) :
    (zeroTree v (List.finRange c)).Holds f x ↔ interpretRow f x v=0 := by
  rw [zeroTree_correct]
  simp [funext_iff]
variable [DecidableEq K]
theorem pivotTree_correct {c : Nat} (f : R→+*K) (x : σ→K)
    (v : Fin c→PolyExpr σ R) (z : TestTree σ R) (n : Fin c→TestTree σ R)
    (cs : List (Fin c)) :
    (pivotTree v z n cs).Holds f x ↔
      match pivot cs LinearMap.id (interpretRow f x v) with
      | none => z.Holds f x
      | some i => (n i).Holds f x := by
  induction cs with
  | nil => rfl
  | cons i cs ih =>
    by_cases hi : interpret f x (v i)=0
    · simpa [pivotTree,TestTree.Holds,pivot,List.find?_cons,interpretRow,hi] using ih
    · simp [pivotTree,TestTree.Holds,pivot,List.find?_cons,interpretRow,hi]
@[simp] theorem fractionFreeExpr_correct {c : Nat} (f : R→+*K) (x : σ→K)
    (v w : Fin c→PolyExpr σ R) (i : Fin c) :
    interpretRow f x (fractionFreeExpr v w i)=
      fractionFree LinearMap.id i (interpretRow f x v) (interpretRow f x w) := by
  ext j
  simp [interpretRow,fractionFreeExpr,interpret,fractionFree_apply]
theorem spanTree_correct {c : Nat} (f : R→+*K) (x : σ→K)
    (fuel : Nat) (rs : List (Fin c→PolyExpr σ R)) (v : Fin c→PolyExpr σ R)
    (hf : rs.length≤fuel) :
    (spanTree fuel rs v).Holds f x ↔
      interpretRow f x v∈rowSpan (K:=K) (rs.map (interpretRow f x)) := by
  induction fuel generalizing rs v with
  | zero =>
    have hr : rs=[] := List.length_eq_zero_iff.mp (Nat.eq_zero_of_le_zero hf)
    subst rs
    simp [spanTree,zeroTree_full_correct,rowSpan]
  | succ fuel ih =>
    cases rs with
    | nil => simp [spanTree,zeroTree_full_correct,rowSpan]
    | cons w ws =>
      have hlen : ws.length≤fuel := by simpa using hf
      rw [spanTree,pivotTree_correct]
      cases hp : pivot (List.finRange c) LinearMap.id (interpretRow f x w) with
      | none =>
        have hw : interpretRow f x w=0 :=
          pivot_none (List.finRange c) (by simp)
            (LinearMap.id : (Fin c→K)→ₗ[K](Fin c→K)) (interpretRow f x w) hp
        simpa only [List.map_cons,hw,rowSpan_zero_cons] using ih ws v hlen
      | some i =>
        have hi : interpretRow f x w i≠0 :=
          pivot_some (List.finRange c)
            (LinearMap.id : (Fin c→K)→ₗ[K](Fin c→K)) (interpretRow f x w) i hp
        have hh := ih (ws.map (fun z => fractionFreeExpr w z i))
          (fractionFreeExpr w v i) (by simpa using hlen)
        apply hh.trans
        simpa only [List.map_map,Function.comp_def,fractionFreeExpr_correct,List.map_cons] using
          (fractionFree_span_iff LinearMap.id i (interpretRow f x w)
            (interpretRow f x v) (ws.map (interpretRow f x)) hi).symm
end Syntax
