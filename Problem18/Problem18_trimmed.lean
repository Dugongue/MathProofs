theorem expression {B B' : Nat} (hB : B ≤ B') {σ : Env} (e : Expr) {v : Nat}
    (h : e.evalB B σ=some v) : e.evalB B' σ=some v := by
  induction e generalizing v with
  | lit n =>
    obtain ⟨rfl,hn⟩:=evalB_lit_iff.mp h
    exact evalB_lit (hn.trans_le hB)
  | var x =>
    obtain ⟨rfl,hx⟩:=evalB_var_iff.mp h
    exact evalB_var (hx.trans_le hB)
  | get a i ih =>
    obtain ⟨k,hk,hval,hv⟩:=evalB_get_iff.mp h
    exact evalB_get_iff.mpr ⟨k,ih hk,hval,hv.trans_le hB⟩
  | bin op e f ie iff =>
    obtain ⟨m,n,hm,hn,hv,hlt⟩:=evalB_bin_iff.mp h
    exact evalB_bin_iff.mpr ⟨m,n,ie hm,iff hn,hv,hlt.trans_le hB⟩
theorem condition {B B' : Nat} (hB : B ≤ B') {σ : Env} (c : Cond) {v : Bool}
    (h : c.evalB B σ=some v) : c.evalB B' σ=some v := by
  cases c with
  | eq e f =>
    obtain ⟨m,n,hm,hn,hv⟩:=evalB_condEq_iff.mp h
    exact evalB_condEq_iff.mpr ⟨m,n,expression hB e hm,expression hB f hn,hv⟩
  | lt e f =>
    obtain ⟨m,n,hm,hn,hv⟩:=evalB_condLt_iff.mp h
    exact evalB_condLt_iff.mpr ⟨m,n,expression hB e hm,expression hB f hn,hv⟩
theorem bigStep {B B' : Nat} (hB : B ≤ B') {σ τ : Env} {c : Com} {t : Nat}
    (h : BigStepB B c σ τ t) : BigStepB B' c σ τ t := by
  induction h with
  | skip => exact .skip
  | assign h => exact .assign (expression hB _ h)
  | store hi he hk => exact .store (expression hB _ hi) (expression hB _ he) hk
  | seq h1 h2 ih1 ih2 => exact .seq ih1 ih2
  | ite_true hb hc ih => exact .ite_true (condition hB _ hb) ih
  | ite_false hb hc ih => exact .ite_false (condition hB _ hb) ih
  | while_true hb hc hw ic iw => exact .while_true (condition hB _ hb) ic iw
  | while_false hb => exact .while_false (condition hB _ hb)
  | read h => exact .read h
  | write h => exact .write (expression hB _ h)
theorem run {B B' : Nat} (hB : B ≤ B') {σ τ : Env} {c : Com} {t : Nat}
    (h : Run B c σ τ t) : Run B' c σ τ t := by
  obtain ⟨k,hk,hr⟩:=h
  exact ⟨k,hk,bigStep hB hr⟩
