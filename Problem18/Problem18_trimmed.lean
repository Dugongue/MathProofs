        (Problem18P34Frontend20261003FiniteSystem.source F (marker c))
        (Problem18P34Frontend20261003FiniteSystem.mark F (marker c))
        (augmentedKernel G) s t).eval x := by
  simp only [row,interpret,interpret_sumFin,Sum.elim_inl,Sum.elim_inr,tensorT,
    augmentedKernelEntry,transformedEntry,PolyExpr.eval,eval_sumFin_eq_finset_sum,
    tensorEntry,pEntry,rEntry,Finset.sum_mul,mul_assoc]
  simp [data,col,last,Problem18P34Frontend20261003FiniteSystem.source,
    Problem18P34Frontend20261003FiniteSystem.mark]
theorem isoP_eval (F G : Matrix (Fin c) (Fin a × Fin b) K)
