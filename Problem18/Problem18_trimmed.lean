    (E (Pi.single p.val.val.2 1))=u p
  rw [formOperator_spec]
  change C (L (E (Pi.single p.val.val.1 1))) (L (E (Pi.single p.val.val.2 1)))=u p
  have hLE (x : Fin s → K) : L (E x)=x := LinearMap.congr_fun hL x
  rw [hLE,hLE]
  simp only [C,upperForm,Matrix.toLinearMapₛₗ₂'_single,upperMatrix,dif_pos p.val.property]
  simp [c,p.property]
theorem zero_coordinates_card_mul (eps : K) (hτ : Function.Involutive τ)
    (heps : eps*τ eps=1) (B : Form (V := Fin n → K) τ) (hB : B.SeparatingLeft)
    (hsym : ∀x y,B y x=eps*τ (B x y))
    (E : (Fin s → K) →ₗ[K] (Fin n → K)) (hE : Function.Injective E)
    (Z : Finset (Upper s)) :
    Nat.card {T : selfAdjointSpace τ B // ∀p∈Z,
      B (T.val (E (Pi.single p.val.1 1))) (E (Pi.single p.val.2 1))=0}*
      Fintype.card K^Z.card=Nat.card (selfAdjointSpace τ B) := by
