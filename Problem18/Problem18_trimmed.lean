  refine ⟨τ,?_,⟨hτ,hframe,?_,?_,?_⟩,?_⟩
  · apply (hr.seq (Run.assign heinc)).mono
    simp only [Expr.size,addressExpr]
    omega
  · intro j hj ho
    have hmξ := hm j (by rw [hρ.frame.2.2.1]; exact hj)
      (by rw [regs acc (by simp)]; exact ho acc (by simp))
