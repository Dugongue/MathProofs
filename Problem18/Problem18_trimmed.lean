theorem loop_run {B : Nat} {σ : Env} (h : Input F B σ) (hz : σ.vars index=0) :
    ∃τ,Run B (.while (.lt (.var index) (.var count)) body) σ τ
        ((38+10000*(F.e+1)^2+2000*(F.e+1))*σ.vars count+4) ∧
      ValidMemory F B τ ∧ Frame σ τ ∧ MemoryFrame F σ τ ∧
      decode F (slice F τ canonical (σ.vars acc))=
        decode F (slice F σ canonical (σ.vars acc))+∑i∈Finset.range (σ.vars count),term F σ i := by
  let I:=Invariant F B σ
  let V:=fun τ:Env=>σ.vars count-τ.vars index
  have hdef : ∀τ,I τ → ∃v,(Cond.lt (.var index) (.var count)).evalB B τ=some v := by
    intro τ ht
    have ec:=frame_register ht.frame count (by simp)
    exact evalB_condLt_vars (ht.progress.trans_lt (h.words count (by simp)))
      (by rw [ec]; exact h.words count (by simp))
  have step : ∀ρ,I ρ → (Cond.lt (.var index) (.var count)).evalB B ρ=some true →
      ∃τ,Run B body ρ τ (34+10000*(F.e+1)^2+2000*(F.e+1)) ∧ I τ ∧ V τ<V ρ := by
    intro ρ ht hh
    have ec:=frame_register ht.frame count (by simp)
    have htest:=evalB_condLt
      (evalB_var (ht.progress.trans_lt (h.words count (by simp))) :
        (Expr.var index).evalB B ρ=some (ρ.vars index))
      (evalB_var (by rw [ec]; exact h.words count (by simp)) :
        (Expr.var count).evalB B ρ=some (ρ.vars count))
    rw [hh,ec] at htest
    have hi : ρ.vars index<σ.vars count:=by simpa using htest.symm
    obtain ⟨τ,hr,hτ,he⟩:=body_run F h ht hi
    refine ⟨τ,hr,hτ,?_⟩
    dsimp [V]
    rw [he]
    omega
  have hstart : I σ:=⟨h.valid,frame_refl σ,fun _ _ _=>rfl,by rw [hz]; omega,by simp [hz]⟩
  obtain ⟨τ,hr,ht,hfalse⟩:=Run.while_count I V _ hdef step hstart
  have ec:=frame_register ht.frame count (by simp)
  have htest:=evalB_condLt
    (evalB_var (ht.progress.trans_lt (h.words count (by simp))) :
      (Expr.var index).evalB B τ=some (τ.vars index))
    (evalB_var (by rw [ec]; exact h.words count (by simp)) :
      (Expr.var count).evalB B τ=some (τ.vars count))
  rw [hfalse,ec] at htest
  have hnot : ¬τ.vars index<σ.vars count:=by simpa using htest.symm
  have hn : τ.vars index=σ.vars count:=by have hh:=ht.progress; omega
  refine ⟨τ,?_,ht.valid,ht.frame,ht.memory,?_⟩
  · convert hr using 1 <;>
      simp only [V,hz,Nat.sub_zero,Cond.size,Expr.size] <;> ring
  · simpa only [hn] using ht.value
theorem Input.preserved {B : Nat} {σ τ : Env} (h : Input F B σ)
    (hv : ValidMemory F B τ) (hf : Frame σ τ) : Input F B τ := by
  have regs:=frame_register hf
  have ea (i:Nat) : address F τ baseA strideA i=address F σ baseA strideA i := by
    simp only [address,regs baseA (by simp),regs strideA (by simp)]
  have eb (i:Nat) : address F τ baseB strideB i=address F σ baseB strideB i := by
    simp only [address,regs baseB (by simp),regs strideB (by simp)]
  refine ⟨hv,?_,?_,?_,?_,?_,?_,?_,?_,?_⟩
  · intro x hx
    rw [regs x (by simp only [List.mem_cons,List.not_mem_nil,or_false] at hx ⊢; tauto)]
    exact h.words x hx
  · rw [regs canonical.exp (by simp)]; exact h.exponent
  · intro x hx
    unfold Fits
    rw [regs x (by simp only [List.mem_cons,List.not_mem_nil,or_false] at hx ⊢; tauto),hf.2.2.1]
    exact h.buffers x hx
  · rw [regs acc (by simp),regs prod (by simp),regs next (by simp)]
    exact h.separated
  · intro x hx
    rw [regs x (by simp only [List.mem_cons,List.not_mem_nil,or_false] at hx ⊢; tauto),regs canonical.modBase (by simp)]
    exact h.modulus x hx
  · intro i hi
    rw [regs count (by simp)] at hi
    unfold Fits
    rw [ea,hf.2.2.1]
    exact h.leftFits i hi
  · intro i hi
    rw [regs count (by simp)] at hi
    unfold Fits
    rw [eb,hf.2.2.1]
    exact h.rightFits i hi
  · intro i hi x hx
    rw [regs count (by simp)] at hi
    rw [regs x (by simp only [List.mem_cons,List.not_mem_nil,or_false] at hx ⊢; tauto),ea]
    exact h.leftSeparate i hi x hx
  · intro i hi x hx
    rw [regs count (by simp)] at hi
    rw [regs x (by simp only [List.mem_cons,List.not_mem_nil,or_false] at hx ⊢; tauto),eb]
    exact h.rightSeparate i hi x hx
theorem memoryFrame_trans {σ τ ξ : Env} (hf : Frame σ τ)
    (hm : MemoryFrame F σ τ) (hn : MemoryFrame F τ ξ) : MemoryFrame F σ ξ := by
  intro j hj ho
  apply (hn j (by rw [hf.2.2.1]; exact hj) ?_).trans (hm j hj ho)
  intro x hx
  rw [frame_register hf x (by simp only [List.mem_cons,List.not_mem_nil,or_false] at hx ⊢; tauto)]
  exact ho x hx
theorem term_preserved {B : Nat} {σ τ : Env} (h : Input F B σ)
    (hf : Frame σ τ) (hm : MemoryFrame F σ τ) {i : Nat} (hi : i<σ.vars count) :
    term F τ i=term F σ i := by
  have ea : address F τ baseA strideA i=address F σ baseA strideA i := by
    simp only [address,frame_register hf baseA (by simp),frame_register hf strideA (by simp)]
  have eb : address F τ baseB strideB i=address F σ baseB strideB i := by
    simp only [address,frame_register hf baseB (by simp),frame_register hf strideB (by simp)]
  simp only [term,ea,eb,memoryFrame_read F hm _ (h.leftFits i hi) (h.leftSeparate i hi),
    memoryFrame_read F hm _ (h.rightFits i hi) (h.rightSeparate i hi)]
theorem zero_run {B : Nat} {σ : Env} (h : Input F B σ) :
    ∃τ,Run B (zeroCode acc) σ τ (6+1000*(F.e+1)) ∧
      ValidMemory F B τ ∧ CallPreserves σ τ ∧ MemoryFrame F σ τ ∧
      decode F (slice F τ canonical (σ.vars acc))=0 := by
  have wm : σ.vars canonical.modBase<B:=lt_of_le_of_lt (Nat.le_add_right _ _)
    (h.valid.modulus_fit.trans_lt h.valid.memory_word)
  have wc : σ.vars acc<B:=lt_of_le_of_lt (Nat.le_add_right _ _)
    ((h.buffers acc (by simp)).trans_lt h.valid.memory_word)
  have hea : (Expr.var canonical.modBase).evalB B σ=some (σ.vars canonical.modBase):=evalB_var wm
  have heb : (Expr.var canonical.modBase).evalB B
      (σ.setVar canonical.aBase (σ.vars canonical.modBase))=some (σ.vars canonical.modBase) := by
    simpa [Expr.evalB,canonical] using hea
  have heo : (Expr.var acc).evalB B
      ((σ.setVar canonical.aBase (σ.vars canonical.modBase)).setVar canonical.bBase (σ.vars canonical.modBase))=
      some (σ.vars acc) := by
    simpa [Expr.evalB,acc,canonical] using
      (evalB_var wc : (Expr.var acc).evalB B σ=some (σ.vars acc))
  obtain ⟨τ,hr,hτ,hv,hm,hf⟩:=dynamic_call_run F (.point .sub)
    (.var canonical.modBase) (.var canonical.modBase) (.var acc) h.valid hea heb heo
    h.valid.modulus_fit h.valid.modulus_fit (h.buffers acc (by simp))
    (h.modulus acc (by simp)) (h.modulus acc (by simp)) (h.modulus acc (by simp)) h.exponent
  refine ⟨τ,?_,hτ,hf,?_,?_⟩
  · simpa only [zeroCode,Expr.size,Primitive.cost] using hr
  · intro j hj ho
    exact hm j hj (ho acc (by simp))
  · simpa [Primitive.value,fieldValue] using hv
theorem routine_run {B : Nat} {σ : Env} (h : Input F B σ) :
    ∃τ,Run B routine σ τ
        ((38+10000*(F.e+1)^2+2000*(F.e+1))*σ.vars count+1000*(F.e+1)+12) ∧
      ValidMemory F B τ ∧ Frame σ τ ∧ MemoryFrame F σ τ ∧
      decode F (slice F τ canonical (σ.vars acc))=
        ∑i∈Finset.range (σ.vars count),term F σ i := by
  obtain ⟨ξ,hr,hξ,hf,hm,hzero⟩:=zero_run F h
  let ρ:=ξ.setVar index 0
  have hρ : ValidMemory F B ρ:=validMemory_setVar F hξ index 0 (by decide) (by decide) (by decide)
  have hframe : Frame σ ρ:=frame_trans (frame_of_call hf) (frame_setIndex ξ 0)
  have hmem : MemoryFrame F σ ρ:=hm
  have hinput:=Input.preserved F h hρ hframe
  obtain ⟨τ,hl,ht,hft,hmt,hv⟩:=loop_run F hinput (by simp [ρ])
  have hn : ρ.vars count=σ.vars count:=frame_register hframe count (by simp)
  have ha : ρ.vars acc=σ.vars acc:=frame_register hframe acc (by simp)
  have hB : 0<B:=by have hw:=h.valid.memory_word; omega
  have hassign:=Run.assign (x:=index) (evalB_lit hB : (Expr.lit 0).evalB B ξ=some 0)
  refine ⟨τ,?_,ht,frame_trans hframe hft,memoryFrame_trans F hframe hmem hmt,?_⟩
  · apply (hr.seq (hassign.seq hl)).mono
    simp only [Expr.size,hn]
    omega
  · rw [ha,hn] at hv
    have h0 : decode F (slice F ρ canonical (σ.vars acc))=0:=hzero
    rw [h0,zero_add] at hv
    refine hv.trans (Finset.sum_congr rfl ?_)
    intro i hi
    exact term_preserved F h hframe hmem (Finset.mem_range.mp hi)
