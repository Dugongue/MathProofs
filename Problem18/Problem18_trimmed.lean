    obtain ⟨j,hj⟩ := hj
    obtain ⟨i,hi⟩ := unit_lines_isometric B C x y hx hy
    let v : (P×Q) ≃ₗ[K] V := Submodule.prodEquivOfIsCompl P Q hcV
    let w : (P'×Q') ≃ₗ[K] W := Submodule.prodEquivOfIsCompl P' Q' hcW
    refine ⟨v.symm.trans ((i.prodCongr j).trans w),?_⟩
    intro a b
    obtain ⟨a,rfl⟩ := v.surjective a
    obtain ⟨b,rfl⟩ := v.surjective b
    simp only [LinearEquiv.trans_apply,LinearEquiv.symm_apply_apply,LinearEquiv.prodCongr_apply]
    change C ((i a.1:W)+j a.2) ((i b.1:W)+j b.2)=B ((a.1:V)+a.2) ((b.1:V)+b.2)
    rw [Mathproof.Problem18AlternatingClassification20260930.pairing_add_orthogonal C hC.isRefl P' (i a.1,j a.2) (i b.1,j b.2),
      Mathproof.Problem18AlternatingClassification20260930.pairing_add_orthogonal B hB.isRefl P a b]
    exact congrArg₂ (·+·) (hi a.1 b.1) (hj a.2 b.2)
end Mathproof.Problem18CharTwoNonalternating20260930
