  rw [Mathproof.Problem18FormIsometryTransport20260930.isometry_card_eq (RingEquiv.refl K) B C e he]
  exact Nat.card_congr (Mathproof.Problem18OddOrderBounds20260930.standardIsometryEquiv n)
theorem nonalternating_order_ratio_error {K V W : Type*} [Field K] [Fintype K] [CharP K 2]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    [AddCommGroup W] [Module K W] [FiniteDimensional K W]
    (B : LinearMap.BilinForm K V) (C : LinearMap.BilinForm K W)
    (hB : B.IsSymm) (hC : C.IsSymm) (hnB : B.Nondegenerate) (hnC : C.Nondegenerate)
    (haB : ¬B.IsAlt) (haC : ¬C.IsAlt)
    (hc : 2≤Module.finrank K W) (hcn : Module.finrank K W≤Module.finrank K V) :
    |(Nat.card (Mathproof.Problem18FormEmbeddingFiber20260930.Isometries (RingEquiv.refl K) B):ℝ)/
      ((Nat.card (Mathproof.Problem18FormEmbeddingFiber20260930.Isometries (RingEquiv.refl K) C):ℝ)*
        (Nat.card K:ℝ)^((Module.finrank K V).choose 2-(Module.finrank K W).choose 2))-1| ≤
