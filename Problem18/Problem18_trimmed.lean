namespace Mathproof.Meta.Problem18BoundedQuadraticCoordinates20260930
variable {F K : Type*} [Field F] [Field K] [Algebra F K]
def pairVector (p : F × F) : Fin 2 → F := ![p.1, p.2]
noncomputable def basisEval (b : Module.Basis (Fin 2) F K) (p : F × F) : K :=
  b.equivFun.symm (pairVector p)
theorem pairVector_injective : Function.Injective (pairVector (F := F)) := by
  intro p q h
  apply Prod.ext
  · exact congrFun h 0
  · exact congrFun h 1
theorem pairVector_surjective : Function.Surjective (pairVector (F := F)) := by
  intro v
  refine ⟨(v 0, v 1), ?_⟩
  funext i
  fin_cases i <;> rfl
theorem basisEval_bijective (b : Module.Basis (Fin 2) F K) :
    Function.Bijective (basisEval b) := by
  constructor
  · exact b.equivFun.symm.injective.comp pairVector_injective
  · exact b.equivFun.symm.surjective.comp pairVector_surjective
theorem basisEval_eq (b : Module.Basis (Fin 2) F K) (theta : K)
    (hb0 : b 0 = 1) (hb1 : b 1 = theta) (p : F × F) :
    basisEval b p = algebraMap F K p.1 + algebraMap F K p.2 * theta := by
  rw [basisEval, Module.Basis.equivFun_symm_apply, Fin.sum_univ_two, hb0, hb1]
  simp [pairVector, Algebra.smul_def]
def coordinateMul (s t : F) (p q : F × F) : F × F :=
  (p.1 * q.1 + t * p.2 * q.2,
    p.1 * q.2 + p.2 * q.1 + s * p.2 * q.2)
def coordinateConj (s : F) (p : F × F) : F × F :=
  (p.1 + s * p.2, -p.2)
theorem basisEval_coordinateMul (b : Module.Basis (Fin 2) F K) (theta : K)
    (hb0 : b 0 = 1) (hb1 : b 1 = theta) (s t : F)
    (htheta : theta ^ 2 = algebraMap F K s * theta + algebraMap F K t)
    (p q : F × F) :
    basisEval b (coordinateMul s t p q) = basisEval b p * basisEval b q := by
  simp only [basisEval_eq b theta hb0 hb1, coordinateMul, map_add, map_mul,
    Prod.fst, Prod.snd]
  ring_nf
  rw [htheta]
  ring
theorem basisEval_coordinateConj (b : Module.Basis (Fin 2) F K) (theta : K)
    (hb0 : b 0 = 1) (hb1 : b 1 = theta) (sigma : K ≃ₐ[F] K) (s : F)
    (hsigma : sigma theta = algebraMap F K s - theta) (p : F × F) :
    basisEval b (coordinateConj s p) = sigma (basisEval b p) := by
  simp only [basisEval_eq b theta hb0 hb1, coordinateConj, map_add, map_mul,
    map_neg, AlgEquiv.commutes, Prod.fst, Prod.snd, hsigma]
  ring
end Mathproof.Meta.Problem18BoundedQuadraticCoordinates20260930
end
