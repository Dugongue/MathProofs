def checkedWords (xs : List Nat) : List Nat :=
  if (parseNumbers xs).isSome then xs else []
def parsedWords (bits : List Bool) : List Nat := checkedWords (decodedWords bits)
theorem validate_success (xs : List Nat) (h : (parseNumbers xs).isSome=true) :
    validate xs=xs++[1] := by
  unfold parseNumbers at h
  split at h
  · rename_i tag u q p e a b c data he
    dsimp only at h
    split_ifs at h with hv
    · simp only [ParsedInput.Valid] at hv
      simp [validate,hv.1,hv.2.1,hv.2.2.1,hv.2.2.2.1,hv.2.2.2.2.1,
        hv.2.2.2.2.2.1,hv.2.2.2.2.2.2.1,hv.2.2.2.2.2.2.2.1]
      exact hv.2.2.2.2.2.2.2.2
    · contradiction
  · contradiction
theorem validate_failure (xs : List Nat) (h : (parseNumbers xs).isSome=false) :
    ∃ pre,validate xs=pre++[0] := by
  by_cases hs : xs.length<8
  · exact ⟨[],short_validate xs hs⟩
  obtain ⟨tag,u,q,p,e,a,b,c,data,rfl⟩:=header_exists xs (by omega)
  dsimp only [validate]
  split_ifs with hh hd
  · have hv : (⟨tag,u,q,p,e,a,b,c,data⟩ : ParsedInput).Valid:=⟨hh.1,hh.2.1,
      hh.2.2.1,hh.2.2.2.1,hh.2.2.2.2.1,hh.2.2.2.2.2.1,
      hh.2.2.2.2.2.2.1,hh.2.2.2.2.2.2.2,hd⟩
    simp [parseNumbers,hv] at h
  · exact ⟨[tag,u,q,p,e,a,b,c]++data,rfl⟩
  · exact ⟨[tag,u,q,p,e,a,b,c],rfl⟩
theorem filtered_validate (xs : List Nat) :
    guardedRun Problem18RootParserFlagFilter20261001.delay
      Problem18RootParserFlagFilter20261001.accept
      (Lax51.BinaryWordEncoding.encode (validate xs))=
        Lax51.BinaryWordEncoding.encode (checkedWords xs) := by
  cases h : (parseNumbers xs).isSome with
  | true=>rw [validate_success xs h]; simpa [checkedWords,h] using
      Problem18RootParserFlagFilter20261001.accepted xs
  | false=>obtain ⟨pre,hp⟩:=validate_failure xs h
           rw [hp,Problem18RootParserFlagFilter20261001.rejected]
           simp [checkedWords,h,Lax51.BinaryWordEncoding.encode]
theorem decoded_parse (bits : List Bool) : parseNumbers (decodedWords bits)=parseBits bits := by
  cases h : (BitstringEncoding.bitDecode bits : Option (List Nat)) <;>
    simp [decodedWords,parseBits,h,parseNumbers]
theorem parsedWords_rejected (bits : List Bool) (h : parseBits bits=none) : parsedWords bits=[] := by
  simp [parsedWords,checkedWords,decoded_parse,h]
def serialize (d : ParsedInput) : List Nat :=
  [d.tag,d.unitary,d.q,d.p,d.e,d.a,d.b,d.c]++d.data
theorem accepted_allocation (bits : List Bool) (d : ParsedInput)
    (h : parseBits bits=some d) : d.e≤bits.length ∧ d.a*d.b*d.c*d.e≤bits.length :=
  Problem18RootParserBounds20261001.parsed_allocation_bound bits d h
open Problem18AllFormatRoot20260930
open Problem18OrthogonalAssembly (RectTensor)
variable {K : Type} [Field K] [Fintype K]
theorem parsed_source (F : FieldPresentation K) (u : Bool) (q : Nat)
    {a b c : Nat} (ha : 0<a) (hb : 0<b) (hc : 0<c) (A : RectTensor a b c K) :
    parsedWords (sourceBits F u q A)=0::(header F u q a b c++tensorCoordinates F A) := by
  unfold parsedWords checkedWords
  rw [decoded_parse, parse_sourceBits F u q ha hb hc A]
  simp only [Option.isSome_some, ite_true, sourceBits, decoder_roundtrip]
end Mathproof.Problem18RootParserSemantics20261001
