      Algebra.IsSeparable K⟮coordinate (K := K) P i⟯ (CoordinateField (K := K) P) := by
  classical
  letI := Fintype.ofFinite σ
  let s := Finset.univ.image (coordinate (K := K) P)
  have hs : (s : Set (CoordinateField (K := K) P)) =
      Set.range (coordinate (K := K) P) := by simp [s]
  obtain ⟨t, ht, htrans, hfinite, hsep⟩ :=
    Problem18SeparatingGenerator20261001.exists_separating_generator s
