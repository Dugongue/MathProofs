namespace Mathproof.Problem18LargeSourcePredicate20261001
open scoped BigOperators Matrix
open Matrix FiniteFieldOrthogonalUnitaryTI
open Problem18OrthogonalAssembly (RectTensor rectAction)
open Problem18PolynomialCovariantSpan20261001
variable {K : Type*} [Field K] [StarRing K] {a b c : ℕ}
def firstFamily (A : RectTensor a b c K) (t : Fin c) : Matrix (Fin b) (Fin b) K :=
  rightMoment A t.val
def middleSlice (A : RectTensor a b c K) (k : Fin b) : Matrix (Fin a) (Fin c) K :=
  fun i j => A j (i,k)
def secondFamily (A : RectTensor a b c K) (kl : Fin b×Fin b) : Matrix (Fin a) (Fin a) K :=
  Problem18CorrectedCrossGram20260930.crossGram (middleSlice A) kl
def Good (A : RectTensor a b c K) : Prop :=
  Algebra.adjoin K (Set.range (firstFamily A))=⊤ ∧
  Algebra.adjoin K (Set.range (secondFamily A))=⊤
theorem secondFamily_mate (A : RectTensor a b c K) (kl : Fin b×Fin b) :
    (secondFamily A kl.swap)ᴴ=secondFamily A kl :=
  Problem18CorrectedCrossGram20260930.crossGram_mate _ _
theorem rectangular_columnGram_hermitian (A : RectTensor a b c K) :
    (columnGramRecord A)ᴴ=columnGramRecord A := by
  simp only [columnGramRecord,Matrix.conjTranspose_transpose_eq_transpose_conjTranspose,
    Matrix.conjTranspose_mul,Matrix.conjTranspose_conjTranspose]
theorem firstFamily_mate (A : RectTensor a b c K) (t : Fin c) :
    (firstFamily A t)ᴴ=firstFamily A t := by
  unfold firstFamily
  rw [rightMoment_eq_partialTrace,←partialTraceRight_conjTranspose,
    Matrix.conjTranspose_pow,rectangular_columnGram_hermitian]
theorem secondFamily_eq_block (A : RectTensor a b c K) (k l : Fin b) (i j : Fin a) :
    secondFamily A (k,l) i j=columnGramRecord A (i,k) (j,l) := by
  simp [secondFamily,middleSlice,Problem18CorrectedCrossGram20260930.crossGram,
    columnGramRecord,Matrix.mul_apply,mul_comm]
theorem rectangular_columnGram_action (A : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (hR : IsUnitary R) :
    columnGramRecord (rectAction P Q R A)=
      Matrix.kronecker P Q*columnGramRecord A*(Matrix.kronecker P Q)ᴴ := by
  have hg : ∀ X : RectTensor a b c K,columnGramRecord (R*X)=columnGramRecord X := by
    intro X
    unfold columnGramRecord
    congr 1
    rw [Matrix.conjTranspose_mul,Matrix.mul_assoc,←Matrix.mul_assoc Rᴴ R,
      hR,Matrix.one_mul]
  rw [rectAction,Matrix.mul_assoc,hg,columnGramRecord_right]
theorem firstFamily_action (A : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (hP : IsUnitary P) (hQ : IsUnitary Q)
    (hR : IsUnitary R) (t : Fin c) :
    firstFamily (rectAction P Q R A) t=Q*firstFamily A t*Qᴴ := by
  simp only [firstFamily,rightMoment_eq_partialTrace]
  rw [rectangular_columnGram_action A P Q R hR,
    unitary_conjugate_pow _ _ (unitary_kronecker P Q hP hQ),
    partialTraceRight_covariant _ P Q hP]
theorem first_generation_action (A : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (hP : IsUnitary P) (hQ : IsUnitary Q)
    (hR : IsUnitary R) (hgen : Algebra.adjoin K (Set.range (firstFamily A))=⊤) :
    Algebra.adjoin K (Set.range (firstFamily (rectAction P Q R A)))=⊤ := by
  have he : firstFamily (rectAction P Q R A)=fun t=>Q*firstFamily A t*Qᴴ := by
    funext t
    exact firstFamily_action A P Q R hP hQ hR t
  rw [he]
  exact generating_family_unitary_conjugate _ Q hQ hgen
end Mathproof.Problem18LargeSourcePredicate20261001
