noncomputable def preimageFibersEquiv {Ω S : Type*} (f : Ω → S) (p : S → Prop) :
    {x : Ω // p (f x)} ≃ ((y : {y : S // p y}) × {x : Ω // f x = y.val}) where
  toFun x := ⟨⟨f x.val, x.property⟩, ⟨x.val, rfl⟩⟩
  invFun z := ⟨z.2.val, by rw [z.2.property]; exact z.1.property⟩
  left_inv x := rfl
  right_inv z := by rcases z with ⟨⟨y, hy⟩, ⟨x, hx⟩⟩; dsimp at hx; subst y; rfl
open Classical in
theorem preimage_card_eq_sum {Ω S : Type*} [Finite Ω] [Fintype S]
    (f : Ω → S) (p : S → Prop) :
    Nat.card {x : Ω // p (f x)} = ∑ y : {y : S // p y}, Nat.card {x : Ω // f x = y.val} := by
  rw [Nat.card_congr (preimageFibersEquiv f p), Nat.card_sigma]
open Classical in
theorem preimage_card_of_constant_fibers {Ω S : Type*} [Finite Ω] [Fintype S]
    (f : Ω → S) (p : S → Prop) (c : ℕ)
    (hc : ∀ y, p y → Nat.card {x : Ω // f x=y} = c) :
    Nat.card {x : Ω // p (f x)} = c*Nat.card {y : S // p y} := by
  rw [preimage_card_eq_sum]
  simp_rw [hc _ (Subtype.property _)]
  simp [Nat.card_eq_fintype_card, Nat.mul_comm]
theorem stratum_event_card_factor {Ω S : Type*} [Finite Ω] [Fintype S]
    (f : Ω → S) (p q : S → Prop)
    (hf : ∀ y z, p y → p z →
      Nat.card {x : Ω // f x=y} = Nat.card {x : Ω // f x=z}) :
    (Nat.card {x : Ω // p (f x) ∧ q (f x)} : ℝ) =
      (Nat.card {x : Ω // p (f x)} : ℝ) *
        ((Nat.card {y : S // p y ∧ q y} : ℝ) / Nat.card {y : S // p y}) := by
  classical
  by_cases hp : Nonempty {y : S // p y}
  · let y₀ := hp.some
    let c := Nat.card {x : Ω // f x=y₀.val}
    have hc (y : S) (hy : p y) : Nat.card {x : Ω // f x=y}=c :=
      hf y y₀.val hy y₀.property
    have h1 := preimage_card_of_constant_fibers f p c hc
    have h2 := preimage_card_of_constant_fibers f (fun y => p y ∧ q y) c
      (fun y hy => hc y hy.1)
    have hpos : (0 : ℝ)<Nat.card {y : S // p y} := by
      letI := hp
      exact_mod_cast Nat.card_pos
    rw [h1,h2]
    push_cast
    field_simp
  · have hempty (y : S) : ¬p y := fun hy => hp ⟨⟨y,hy⟩⟩
    simp only [hempty, false_and]
    simp
variable {K : Type*} [Field K] [Fintype K]
end Mathproof.Problem18UniformFiberProbability20260930
