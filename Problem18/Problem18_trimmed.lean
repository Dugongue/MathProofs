section Level
variable (k F : Type) [Field k] [Field F] [Fintype k]
  [Algebra k F] [Algebra k[X] F] [Algebra k⟮X⟯ F] [IsScalarTower k k[X] F]
  [IsScalarTower k[X] k⟮X⟯ F] [IsScalarTower k k⟮X⟯ F] [_root_.FunctionField k F]
  [Algebra.IsSeparable k⟮X⟯ F] [FunctionField.IsFullConstantField k F]
variable (p : ℕ) [Fact p.Prime] [CharP k p]
variable (K0 E : Type) [Field K0] [Field E] [Fintype K0] [Finite E]
  [Algebra k K0] [Algebra K0 E] [Algebra k E] [IsScalarTower k K0 E]
  [Algebra (CoverConstants k F) E] [IsScalarTower k (CoverConstants k F) E]
local notation "E₀" => CoverConstants k F
local notation "𝓜" => NormalCover k F
local notation "Ωc" => AlgebraicClosure (NormalCover k F)
local notation "Lc" => ConstantExtension (CoverConstants k F) (NormalCover k F) E
theorem lc_tower_kE0 : IsScalarTower k E₀ Lc := IsScalarTower.of_algebraMap_eq fun c => by
  apply Subtype.ext
  exact IsScalarTower.algebraMap_apply k E₀ Ωc c
attribute [local instance] lc_tower_kE0
theorem lc_tower_kE : IsScalarTower k E Lc := IsScalarTower.of_algebraMap_eq fun c => by
  rw [IsScalarTower.algebraMap_apply k E₀ E c, ← IsScalarTower.algebraMap_apply E₀ E Lc,
    ← IsScalarTower.algebraMap_apply k E₀ Lc]
theorem lc_tower_kX : IsScalarTower k k⟮X⟯ Lc := IsScalarTower.of_algebraMap_eq fun c => by
