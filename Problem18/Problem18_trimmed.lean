theorem embedding_gram_commuting_probability_le
    (ρ : E →ₐ[K] Module.End K (Fin n → K))
    (he : 2 ≤ Module.finrank K E) (hrn : 2*r ≤ n)
    (J : Matrix (Fin r) (Fin r) K) (hJ : J.det≠0)
    (G : Matrix (Fin n) (Fin n) K) (hG : G.det≠0) :
    (Nat.card {X : Matrix (Fin n) (Fin r) K // ∀ a x,
      (X*J*X.transpose*G).mulVecLin (ρ a x)=ρ a ((X*J*X.transpose*G).mulVecLin x)} : ℝ)/
      Fintype.card (Matrix (Fin n) (Fin r) K) ≤
      4*(r+5)*((Fintype.card K : ℝ)^(n*r/8))⁻¹ := by
  letI : Module E (Fin n → K) := Module.compHom _ ρ.toRingHom
  letI : IsScalarTower K E (Fin n → K) := ⟨by
    intro k a x
    change ρ (k•a) x = k•ρ a x
    rw [map_smul]
    rfl⟩
  have hGi := Matrix.mul_nonsing_inv G (isUnit_iff_ne_zero.mpr hG)
