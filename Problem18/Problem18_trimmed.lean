variable {N : Nat} {K : Type*} [Field K]
noncomputable def lowPowers (i : Fin N) (Q : Nat) : Submodule K (MvPolynomial (Fin N) K) :=
  Submodule.span K (Set.range fun j : Fin Q => (X i : MvPolynomial (Fin N) K)^j.val)
theorem lowPowers_degree (i : Fin N) (Q : Nat) {p : MvPolynomial (Fin N) K}
    (hp : p ∈ lowPowers i Q) : p.totalDegree ≤ Q := by
  induction hp using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨j,rfl⟩ := hz
      simpa only [totalDegree_X_pow] using Nat.le_of_lt j.isLt
  | zero => simp
  | add x y hx hy ihx ihy => exact (totalDegree_add x y).trans (max_le ihx ihy)
  | smul c x hx ih => exact (totalDegree_smul_le c x).trans ih
theorem lowPowers_quotient (I : Ideal (MvPolynomial (Fin N) K)) (i : Fin N) (Q : Nat) :
    (lowPowers (K := K) i Q).map (Ideal.Quotient.mkₐ K I).toLinearMap =
      Submodule.span K (Set.range fun j : Fin Q => (Ideal.Quotient.mk I (X i))^j.val) := by
  rw [lowPowers,Submodule.map_span]
  congr 1
  ext x
  simp only [Set.mem_image,Set.mem_range,AlgHom.toLinearMap_apply]
  constructor
  · rintro ⟨p,⟨j,rfl⟩,rfl⟩
    exact ⟨j,by simp⟩
  · rintro ⟨j,rfl⟩
    exact ⟨(X i)^j.val,⟨j,rfl⟩,by simp⟩
theorem coordinate_relations_of_finrank_bound (I : Ideal (MvPolynomial (Fin N) K))
    [FiniteDimensional K ((MvPolynomial (Fin N) K) ⧸ I)] (Q : Nat)
    (hdim : Module.finrank K ((MvPolynomial (Fin N) K) ⧸ I) ≤ Q) :
    ∀ i : Fin N, ∃ p ∈ lowPowers (K := K) i Q, (X i)^Q-p ∈ I := by
  intro i
  let x := Ideal.Quotient.mk I (X i)
  have hx : IsIntegral K x := IsIntegral.of_finite K x
  have hm := hx.mem_span_pow (y := x^Q) ⟨Polynomial.X^Q,by simp⟩
  have hmin : (minpoly K x).natDegree ≤ Q := (minpoly.natDegree_le x).trans hdim
  have hspan : x^Q ∈ Submodule.span K (Set.range fun j : Fin Q => x^j.val) := by
    apply (Submodule.span_mono ?_) hm
    rintro y ⟨j,rfl⟩
    exact ⟨⟨j.val,lt_of_lt_of_le j.isLt hmin⟩,rfl⟩
  rw [← lowPowers_quotient I i Q] at hspan
  obtain ⟨p,hp,heq⟩ := hspan
  refine ⟨p,hp,Ideal.Quotient.eq_zero_iff_mem.mp ?_⟩
  change Ideal.Quotient.mk I ((X i)^Q-p) = 0
  simp only [map_sub,map_pow]
  exact sub_eq_zero.mpr heq.symm
theorem coordinate_relation_iff_macaulay
    (F : Finset (MvPolynomial (Fin N) K)) (d Q : Nat)
    (hF : ∀ f ∈ F, f.totalDegree ≤ d) (i : Fin N) :
    (∃ p ∈ lowPowers (K := K) i Q, (X i)^Q-p ∈ generatedIdeal (F : Set (MvPolynomial (Fin N) K))) ↔
      (X i)^Q ∈ macaulaySpan (F : Set (MvPolynomial (Fin N) K)) (2*d*2^(controlledDepth N d)+Q) ⊔ lowPowers i Q := by
  constructor
  · rintro ⟨p,hp,hrel⟩
    have hdeg : ((X i)^Q-p).totalDegree ≤ Q :=
      (totalDegree_sub _ _).trans (max_le
        (by simp only [totalDegree_X_pow,le_refl])
        (lowPowers_degree i Q hp))
    have hmac := (mem_ideal_iff_uniform_macaulay F d hF ((X i)^Q-p)).mp hrel
    exact Submodule.mem_sup.mpr ⟨(X i)^Q-p,
      macaulaySpan_mono (Nat.add_le_add_left hdeg _) hmac,p,hp,sub_add_cancel _ _⟩
  · rintro h
    obtain ⟨a,ha,p,hp,heq⟩ := Submodule.mem_sup.mp h
    refine ⟨p,hp,?_⟩
    have hrel := macaulaySpan_le_ideal (F : Set (MvPolynomial (Fin N) K)) (2*d*2^(controlledDepth N d)+Q) ha
    have heq' : (X i)^Q-p = a := by rw [← heq]; abel
    change a ∈ generatedIdeal (F : Set (MvPolynomial (Fin N) K)) at hrel
    rw [heq']
    exact hrel
def powerRow (B : Nat) (i : Fin N) (j : Nat) : Vector K (boundedExponents N B).length :=
  Vector.ofFn fun a => if (boundedExponents N B)[a.val] =
    functionToExponent (fun k => if k = i then j else 0) then 1 else 0
def lowPowerRows (B : Nat) (i : Fin N) (Q : Nat) : List (Vector K (boundedExponents N B).length) :=
  (List.range Q).map (powerRow B i)
def coordinateFiniteCheck [DecidableEq K] (d Q : Nat)
    (vs : List (DenseInput N d K)) (i : Fin N) : Bool × Nat :=
  let E := 2*d*2^(controlledDepth N d)+Q
  spanCheck (macaulayRows d E vs ++ lowPowerRows (d+E) i Q) (powerRow (d+E) i Q)
theorem powerRow_read (B : Nat) (i : Fin N) (j : Nat) :
    read (powerRow (K := K) B i j) = observePolynomial B ((X i)^j) := by
  classical
  have hexp : functionToExponent (fun k : Fin N => if k = i then j else 0) =
      Finsupp.single i j := by
    ext k
    change (if k = i then j else 0) = (Finsupp.single i j) k
    simp [Finsupp.single_apply,eq_comm]
  rw [powerRow,read_ofFn]
  simp only [hexp]
  funext a
  simp [observePolynomial,coeff_X_pow,eq_comm]
theorem lowPowerRows_span (B : Nat) (i : Fin N) (Q : Nat) :
    rowSpan (K := K) ((lowPowerRows B i Q).map read) =
      (lowPowers (K := K) i Q).map (observePolynomial B) := by
  rw [lowPowers,Submodule.map_span,rowSpan]
  congr 1
  ext y
  simp only [lowPowerRows,List.mem_map,List.mem_range,Set.mem_setOf_eq,
    Set.mem_image,Set.mem_range]
  constructor
  · rintro ⟨v,⟨j,hj,rfl⟩,rfl⟩
    exact ⟨(X i)^j,⟨⟨j,hj⟩,rfl⟩,(powerRow_read B i j).symm⟩
  · rintro ⟨p,⟨j,rfl⟩,rfl⟩
    exact ⟨powerRow B i j.val,⟨j.val,j.isLt,rfl⟩,powerRow_read B i j.val⟩
theorem valid_inputs_degree (d : Nat) (vs : List (DenseInput N d K))
    (fs : List (MvPolynomial (Fin N) K)) (hv : List.Forall₂ (ValidDenseInput d) vs fs) :
    ∀ f ∈ fs, f.totalDegree ≤ d := by
  induction hv with
  | nil => simp
  | @cons v f vs fs hv hvs ih =>
      intro p hp
      rcases List.mem_cons.mp hp with rfl | hp
      · exact hv.1
      · exact ih p hp
theorem coordinateFiniteCheck_correct [DecidableEq K] (d Q : Nat)
    (vs : List (DenseInput N d K)) (fs : List (MvPolynomial (Fin N) K))
    (hv : List.Forall₂ (ValidDenseInput d) vs fs) (i : Fin N) :
    (coordinateFiniteCheck d Q vs i).1 = true ↔
      ∃ p ∈ lowPowers (K := K) i Q, (X i)^Q-p ∈ generatedIdeal (fs.toFinset : Set (MvPolynomial (Fin N) K)) := by
  classical
  let E := 2*d*2^(controlledDepth N d)+Q
  let S := macaulaySpan (fs.toFinset : Set (MvPolynomial (Fin N) K)) E ⊔ lowPowers i Q
  have hF : ∀ f ∈ fs.toFinset, f.totalDegree ≤ d :=
    fun f hf => valid_inputs_degree d vs fs hv f (List.mem_toFinset.mp hf)
  have hmac : rowSpan (K := K) ((macaulayRows d E vs).map read) =
      (macaulaySpan (fs.toFinset : Set (MvPolynomial (Fin N) K)) E).map (observePolynomial (d+E)) := by
    rw [macaulayRows_read d E vs fs hv,← polynomialRows_span E fs]
    simp only [rowSpan,Submodule.map_span]
    congr 1
    ext y
    simp
  have hrows : rowSpan (K := K)
      ((macaulayRows d E vs ++ lowPowerRows (d+E) i Q).map read) =
        S.map (observePolynomial (d+E)) := by
    rw [List.map_append]
    have happ : ∀ (a b : List (Fin (boundedExponents N (d+E)).length → K)),
        rowSpan (K := K) (a++b) = rowSpan (K := K) a ⊔ rowSpan (K := K) b := by
      intro a b
      simp only [rowSpan,List.mem_append,Set.setOf_or,Submodule.span_union]
    rw [happ,hmac,lowPowerRows_span,← Submodule.map_sup]
  have hdegree : ∀ p ∈ S, p.totalDegree ≤ d+E := by
    intro p hp
    obtain ⟨a,ha,b,hb,rfl⟩ := Submodule.mem_sup.mp hp
    apply (totalDegree_add _ _).trans
    exact max_le (macaulay_span_degree (N := N) (K := K) d E (fs.toFinset : Set (MvPolynomial (Fin N) K)) hF (p := a) ha)
      ((lowPowers_degree i Q hb).trans (by dsimp [E]; omega))
  change (spanCheck (macaulayRows d E vs ++ lowPowerRows (d+E) i Q)
    (powerRow (d+E) i Q)).1 = true ↔ _
  rw [spanCheck_iff,powerRow_read,hrows,coordinate_relation_iff_macaulay fs.toFinset d Q hF i]
  change observePolynomial (d+E) ((X i)^Q) ∈ S.map (observePolynomial (d+E)) ↔ (X i)^Q ∈ S
  constructor
  · rintro ⟨p,hp,heq⟩
    have heqp := observePolynomial_injective_bounded (d+E) p ((X i)^Q) (hdegree p hp)
      (by rw [totalDegree_X_pow]; dsimp [E]; omega) heq
    rw [← heqp]
    exact hp
  · intro hp
    exact ⟨_,hp,rfl⟩
end Mathproof.Problem18FiniteLocusRecognition20260930
