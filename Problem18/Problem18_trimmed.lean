def Bounded {n : Nat} (d : Nat) (fs : List (MvPolynomial (Fin n) K)) : Prop :=
  ∀ f ∈ fs, f.totalDegree ≤ d
def IrredDim {n : Nat} (fs : List (MvPolynomial (Fin n) K)) (r : Nat) : Prop :=
  ∃ P : Ideal (MvPolynomial (Fin n) L),
    (geometricIdeal (L := L) (systemSet fs)).minimalPrimes = {P} ∧
    ringKrullDim (MvPolynomial (Fin n) L ⧸ P) = (r : WithBot ℕ∞)
theorem unique_component_fixed {n : Nat} (fs : List (MvPolynomial (Fin n) K))
    (P : Ideal (MvPolynomial (Fin n) L))
    (hP : (geometricIdeal (L := L) (systemSet fs)).minimalPrimes = {P}) :
    P.comap (coefficientAutomorphism (FiniteField.frobeniusAlgEquivOfAlgebraic K L)) = P := by
  have hmem : P ∈ (geometricIdeal (L := L) (systemSet fs)).minimalPrimes := by
    rw [hP]; exact Set.mem_singleton P
  have h := comap_minimalPrime (coefficientAutomorphism (FiniteField.frobeniusAlgEquivOfAlgebraic K L))
    (geometricIdeal_fixed (FiniteField.frobeniusAlgEquivOfAlgebraic K L) (systemSet fs)) hmem
  rw [hP] at h
  exact Set.mem_singleton_iff.mp h
structure PointBridge (n d : Nat) where
  Qcurve : Nat
  Qpencil : Nat
  one_le_d : 1 ≤ d
  curve_point : ∀ fs : List (MvPolynomial (Fin n) K), Bounded d fs → IrredDim L fs 1 →
    Qcurve < Fintype.card K → ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0
  section_step : ∀ (fs : List (MvPolynomial (Fin n) K)) (r : Nat), Bounded d fs → 2 ≤ r →
    IrredDim L fs r → Qpencil < Fintype.card K →
    ∃ (i j : Fin n) (a b : K), IrredDim L (fs ++ [X i + C a * X j - C b]) (r - 1)
  descent : ∀ (fs : List (MvPolynomial (Fin n) K)), Bounded d fs → HasFixedComponent L fs →
    ∃ (gs : List (MvPolynomial (Fin n) K)) (r : Nat), Bounded d gs ∧ IrredDim L gs r ∧
      ∀ x : Fin n → K, (∀ g ∈ gs, eval x g = 0) → ∀ f ∈ fs, eval x f = 0
theorem bounded_append_linear {n d : Nat} (hd : 1 ≤ d) (fs : List (MvPolynomial (Fin n) K))
    (hfs : Bounded d fs) (i j : Fin n) (a b : K) :
    Bounded d (fs ++ [X i + C a * X j - C b]) := by
  intro f hf
  rcases List.mem_append.mp hf with hf | hf
  · exact hfs f hf
  · rw [List.mem_singleton] at hf
    subst hf
    calc (X i + C a * X j - C b).totalDegree
        ≤ max (X i + C a * X j).totalDegree (C b).totalDegree := totalDegree_sub _ _
      _ ≤ 1 := by
        apply max_le
        · calc (X i + C a * X j).totalDegree
              ≤ max (X i).totalDegree (C a * X j).totalDegree := totalDegree_add _ _
            _ ≤ 1 := by
              apply max_le
              · exact (totalDegree_X i).le
              · calc (C a * X j).totalDegree ≤ (C a).totalDegree + (X j).totalDegree :=
                    totalDegree_mul _ _
                  _ ≤ 0 + 1 := Nat.add_le_add (totalDegree_C a).le (totalDegree_X j).le
                  _ = 1 := by norm_num
        · exact (totalDegree_C b).le.trans (Nat.zero_le 1)
      _ ≤ d := hd
