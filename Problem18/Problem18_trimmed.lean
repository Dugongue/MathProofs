        simp only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,Nat.card_eq_fintype_card,Nat.cast_id]
      _ ≤ _ := Finset.sum_le_sum (fun T _ =>
        markings_card_lower σ B C hB.1 f T.val (Classical.choice T.property))
  have he : Nat.card (AllIncidences σ B C f)*Nat.card (Isometries σ C)=
      Nat.card (SourceOperators σ B f)*Nat.card (Isometries σ (sumForm σ B C))*
        Nat.card (SelfAdjointOperators σ C) := by
    rw [AllIncidences,Nat.card_sigma,Finset.sum_mul]
    simp_rw [marked_card_mul_complement_isometries σ B C hB]
    simp only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,Nat.card_eq_fintype_card,Nat.cast_id]
    ring
  exact (Nat.mul_le_mul_right (Nat.card (Isometries σ C)) hl).trans_eq he
