variable {K V W U : Type*} [Field K]
  [AddCommGroup V] [Module K V] [Finite V]
  [AddCommGroup W] [Module K W] [Finite W]
  [AddCommGroup U] [Module K U] [Finite U]
abbrev GramMaps (σ : K ≃+* K) (B : Form σ V) (A : Form σ U) :=
  {j : V →ₗ[K] U // ∀ x y,A (j x) (j y)=B x y}
noncomputable def orbitToGram (σ : K ≃+* K)
    (B : Form σ V) (C : Form σ W) (A : Form σ U)
    (e : (V×W) ≃ₗ[K] U) (he : ∀ x y,A (e x) (e y)=sumForm σ B C x y)
    (p : EmbeddingOrbit σ B C) : GramMaps σ B A :=
  ⟨e.toLinearMap.comp p.val,by
    intro x y
    obtain ⟨Q,hQ⟩ := p.property
    change A (e (p.val x)) (e (p.val y))=B x y
    rw [← hQ]
    change A (e (Q.val (x,0))) (e (Q.val (y,0)))=B x y
    rw [he,Q.property]
    simp [sumForm_apply]⟩
theorem orbitToGram_injective (σ : K ≃+* K)
    (B : Form σ V) (C : Form σ W) (A : Form σ U)
    (e : (V×W) ≃ₗ[K] U) (he : ∀ x y,A (e x) (e y)=sumForm σ B C x y) :
    Function.Injective (orbitToGram σ B C A e he) := by
  intro p q hpq
  apply Subtype.ext
  apply LinearMap.ext
  intro x
  apply e.injective
  exact LinearMap.congr_fun (congrArg Subtype.val hpq) x
theorem gram_maps_mul_complement_card_lower (σ : K ≃+* K)
    (B : Form σ V) (C : Form σ W) (A : Form σ U) (hB : B.SeparatingRight)
    (e : (V×W) ≃ₗ[K] U) (he : ∀ x y,A (e x) (e y)=sumForm σ B C x y) :
    Nat.card (Isometries σ A) ≤ Nat.card (GramMaps σ B A)*Nat.card (Isometries σ C) := by
  letI : Finite (V →ₗ[K] U) := Finite.of_injective (fun j : V →ₗ[K] U => (j : V → U)) DFunLike.coe_injective
  have hi := Nat.card_le_card_of_injective (orbitToGram σ B C A e he)
    (orbitToGram_injective σ B C A e he)
  have hh := Nat.mul_le_mul_right (Nat.card (Isometries σ C)) hi
  rw [embeddingOrbit_mul_complement_card σ B C hB] at hh
  rw [← isometry_card_eq σ (sumForm σ B C) A e he]
  exact hh
theorem gram_family_count_lower {ι : Type*} [Fintype ι]
    (σ : K ≃+* K) (B : ι → Form σ V) (C : Form σ W) (A : Form σ U)
    (hB : ∀ i,(B i).SeparatingRight) (hinj : Function.Injective B)
    (e : ∀ i,(V×W) ≃ₗ[K] U)
    (he : ∀ i x y,A (e i x) (e i y)=sumForm σ (B i) C x y)
    (P : (V →ₗ[K] U) → Prop) (hP : ∀ i j, (∀ x y,A (j x) (j y)=B i x y) → P j) :
    Nat.card ι*Nat.card (Isometries σ A) ≤
      Nat.card {j : V →ₗ[K] U // P j}*Nat.card (Isometries σ C) := by
  classical
  letI : Finite (V →ₗ[K] U) := Finite.of_injective (fun j : V →ₗ[K] U => (j : V → U)) DFunLike.coe_injective
  let f : (Σ i,GramMaps σ (B i) A) → {j : V →ₗ[K] U // P j} :=
    fun z => ⟨z.2.val,hP z.1 z.2.val z.2.property⟩
  have hf : Function.Injective f := by
    rintro ⟨i,j⟩ ⟨k,l⟩ h
    have hj : j.val=l.val := congrArg Subtype.val h
    have hik : i=k := by
      apply hinj
      apply LinearMap.ext
      intro x
      apply LinearMap.ext
      intro y
      exact (j.property x y).symm.trans ((congrArg (fun t : V →ₗ[K] U => A (t x) (t y)) hj).trans (l.property x y))
    subst k
    exact congrArg (Sigma.mk i) (Subtype.ext hj)
  have hcard := Nat.card_le_card_of_injective f hf
  have hh := Nat.mul_le_mul_right (Nat.card (Isometries σ C)) hcard
  rw [Nat.card_sigma,Finset.sum_mul] at hh
  have hl := Finset.sum_le_sum (s:=Finset.univ) (fun i _ =>
    gram_maps_mul_complement_card_lower σ (B i) C A (hB i) (e i) (he i))
  have ht := hl.trans hh
  simpa only [Finset.sum_const,Finset.card_univ,smul_eq_mul,Nat.card_eq_fintype_card] using ht
def operatorForm (B : LinearMap.BilinForm K V) (S : Module.End K V) : LinearMap.BilinForm K V :=
  B.comp S LinearMap.id
@[simp] theorem operatorForm_apply (B : LinearMap.BilinForm K V) (S : Module.End K V) (x y : V) :
    operatorForm B S x y=B (S x) y := rfl
theorem operatorForm_injective (B : LinearMap.BilinForm K V) (hn : B.Nondegenerate) :
    Function.Injective (operatorForm B) := by
  intro S R h
  apply LinearMap.ext
  intro x
  apply sub_eq_zero.mp
  apply hn.1
  intro y
  rw [map_sub,LinearMap.sub_apply]
  exact sub_eq_zero.mpr (LinearMap.congr_fun (LinearMap.congr_fun h x) y)
theorem operatorForm_symmetric (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (S : Module.End K V) (hS : B.IsSelfAdjoint S) : (operatorForm B S).IsSymm := by
  constructor
  intro x y
  change B (S x) y=B (S y) x
  exact (hS x y).trans (hB.eq _ _)
theorem operatorForm_nondegenerate (B : LinearMap.BilinForm K V) (hn : B.Nondegenerate)
    (S : Module.End K V) (hS : Function.Bijective S) : (operatorForm B S).Nondegenerate := by
  constructor
  · intro x hx
    apply hS.injective
    rw [map_zero]
    exact hn.1 (S x) hx
  · intro y hy
    apply hn.2
    intro x
    obtain ⟨x,rfl⟩ := hS.surjective x
    exact hy x
theorem operatorForm_selfAdjoint (B : LinearMap.BilinForm K V) (S : Module.End K V)
    (hS : B.IsSelfAdjoint S) : (operatorForm B S).IsSelfAdjoint S := by
  intro x y
  exact hS (S x) y
