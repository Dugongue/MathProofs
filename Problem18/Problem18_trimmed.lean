def keepBank : String := "P18.pairBoundary.keepBank"
def memLenSize : SizeExpr :=
  Problem18IMPBoundaryPhaseMetadata20261002.S.byte Problem18IMPBoundaryPhaseMetadata20261002.S.slots
def memLen (n e : Nat) : Nat := e+1+slots n*e
theorem memLenSize_value (n e : Nat) : value memLenSize n e=memLen n e := by
  simp [memLenSize,memLen,value,Problem18IMPBoundaryPhaseMetadata20261002.S.byte,
    Problem18IMPBoundaryPhaseMetadata20261002.S.slots,
    Problem18IMPBoundaryPhaseMetadata20261002.S.workspace,
    Problem18IMPBoundaryPhaseMetadata20261002.S.orbitWork,
    Problem18IMPBoundaryPhaseMetadata20261002.S.orbit,
    Problem18IMPBoundaryPhaseMetadata20261002.S.productWork,
    Problem18IMPBoundaryPhaseMetadata20261002.S.product,
    Problem18IMPBoundaryPhaseMetadata20261002.S.temp,
    Problem18IMPBoundaryPhaseMetadata20261002.S.action,
    Problem18IMPBoundaryPhaseMetadata20261002.S.matrix,
    Problem18IMPBoundaryPhaseMetadata20261002.S.seed,
    Problem18IMPBoundaryPhaseMetadata20261002.S.candidate,
    Problem18IMPBoundaryPhaseMetadata20261002.S.divisor,
    Problem18IMPBoundaryPhaseMetadata20261002.S.factor,
    Problem18IMPBoundaryPhaseMetadata20261002.S.first,
    Problem18IMPBoundaryPhaseMetadata20261002.S.capacity,
    Problem18IMPBoundaryPhaseMetadata20261002.S.bankLength,
    slots,orbitWork,orbit,productWork,product,temp,action,matrix,seed,candidate,divisor,
    factor,first,scratchEnd,capacity,Problem18IMPBoundaryDependence20261001.maxLength,
    Problem18ClaudeIMPPivot20261001.rowStart]
  try ring
def memLenExpr : Expr :=
  expression Problem18IMPTensorGather20261002.cols canonical.e memLenSize
theorem memLenExpr_eval {B n e : Nat} {σ : Env}
    (hn : σ.vars Problem18IMPTensorGather20261002.cols=n)
    (he : σ.vars canonical.e=e) (hb : majorant memLenSize n e<B) :
    memLenExpr.evalB B σ=some (memLen n e) := by
  rw [← memLenSize_value]
  exact expression_eval memLenSize _ _ hn he hb
def zeroGap : Com := .store canonical.mem (.var canonical.e) (.lit 0)
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
noncomputable def pairSlot (σ : Env) (off s : Nat) : K :=
  Problem18IMPFieldPresentation20261001.decode F
    (fun i => (σ.arrs pairBank).getD (off+(F.e+1)+s*F.e+i.val) 0)
structure Snap (σ : Env) (off : Nat) {n : Nat} (S : Matrix (Fin n) (Fin n) K) : Prop where
  matrix : ∀i j:Fin n,pairSlot F σ off (matrix n+i.val*n+j.val)=S i j
  vector : ∀j:Fin n,pairSlot F σ off (candidate n+j.val)=
    (Problem18PairBoundarySemantics20261004.sweepOf S).1 j
  polynomial : ∀j<capacity n,pairSlot F σ off (first n+j)=
    (Problem18PairBoundarySemantics20261004.sweepOf S).2.coeff (capacity n-1-j)
  canonical : ∀k < memLen n F.e,(σ.arrs pairBank).getD (off+k) 0<F.p
theorem slot_lt {n s i e : Nat} (hs : s < slots n) (hi : i<e) :
    e+1+s*e+i < memLen n e := by
  unfold memLen
  have : s*e+i < slots n*e := by
    calc s*e+i < s*e+e := by omega
      _=(s+1)*e := by ring
      _ ≤ slots n*e := Nat.mul_le_mul_right _ hs
  omega
theorem snap_of_state {B n off : Nat} {S : Matrix (Fin n) (Fin n) K} {σ0 σ : Env}
    (hs : Problem18IMPBoundarySweepState20261002.State F B S n σ0)
    (hv : ValidMemory F B σ0)
    (hcopy : ∀k < memLen n F.e,(σ.arrs pairBank).getD (off+k) 0=
      (σ0.arrs canonical.mem).getD k 0) :
    Snap F σ off S := by
  have hval : ∀s < slots n,pairSlot F σ off s=val F canonical WS σ0 s := by
    intro s hsl
    unfold pairSlot Problem18ClaudeIMPSlots20261001.val
    congr 1
    funext i
    unfold Problem18IMPFieldPresentation20261001.slice
    rw [hs.workspace]
    have := hcopy (F.e+1+s*F.e+i.val) (slot_lt hsl i.isLt)
    rw [← this]
    congr 1
    omega
  obtain ⟨_,_,_,_,_,hf,hg,hd,hcand,hseed,hm,ha,ht,hp,hw,hor,hsl⟩:=allocation n
  refine ⟨?_,?_,?_,?_⟩
  · intro i j
    rw [hval _ (by
      have h1:=Nat.mul_le_mul_right n (Nat.succ_le_of_lt i.isLt)
      have h2:=j.isLt
      simp only [Nat.succ_mul] at h1
      omega)]
    exact hs.matrix i j
  · intro j
    rw [hval _ (by have:=j.isLt;omega)]
    exact hs.vector j
  · intro j hj
    rw [hval _ (by omega)]
    exact hs.polynomial j hj
  · intro k hk
    rw [hcopy k hk]
    apply hv.coefficients
    rw [hs.length]
    exact hk
theorem state_transfer {B n i j : Nat} {S : Matrix (Fin n) (Fin n) K} {σ τ : Env}
    (hs : Problem18IMPBoundarySweepState20261002.State F B S i σ)
    (hm : MemAgree F WS j σ τ)
    (hdim : τ.vars dimName=σ.vars dimName)
    (hidx : τ.vars indexName=σ.vars indexName) :
    Problem18IMPBoundarySweepState20261002.State F B S i τ := by
  refine ⟨⟨hm.slots F hs.slots,?_,?_,?_,?_,?_⟩,?_,hs.index_le,?_,?_⟩
  · rw [hm.ws];exact hs.workspace
  · rw [hdim];exact hs.dimension
  · rw [hm.modBase];exact hs.modulus
  · rw [hm.length];exact hs.length
  · intro a b;rw [hm.val F];exact hs.matrix a b
  · rw [hidx];exact hs.index
  · intro a;rw [hm.val F];exact hs.vector a
  · intro a ha;rw [hm.val F];exact hs.polynomial a ha
theorem memAgree_of_eq {B n i : Nat} {S : Matrix (Fin n) (Fin n) K} {σ τ : Env}
    (hs : Problem18IMPBoundarySweepState20261002.State F B S i σ)
    (hmem : τ.arrs canonical.mem=σ.arrs canonical.mem)
    (hscr : τ.arrs canonical.scratch=σ.arrs canonical.scratch)
    (hregs : ∀x∈[canonical.e,canonical.p,canonical.modBase,canonical.exp,WS],
      τ.vars x=σ.vars x) :
    MemAgree F WS F.e σ τ := by
  refine ⟨by rw [hmem],fun k _=>by rw [hmem],?_,?_,by rw [hscr],
    hregs _ (by simp),hregs _ (by simp),hregs _ (by simp),hregs _ (by simp),
    hregs _ (by simp)⟩
  · rw [hs.workspace];omega
  · rw [hs.modulus];omega
theorem zeroGap_run {B n i : Nat} {S : Matrix (Fin n) (Fin n) K} {σ : Env}
    (hs : Problem18IMPBoundarySweepState20261002.State F B S i σ) :
    ∃τ,Run B zeroGap σ τ 3 ∧
      Problem18IMPBoundarySweepState20261002.State F B S i τ ∧
      ValidMemory F B τ ∧
      τ.vars=σ.vars ∧ (∀a,a≠canonical.mem→τ.arrs a=σ.arrs a) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  have he : σ.vars canonical.e=F.e := hs.slots.base.degree
  have hB : F.e+1<B := by
    have h1:=hs.slots.base.memory_word
    rw [hs.length] at h1
    omega
  have hlen : F.e<(σ.arrs canonical.mem).length := by rw [hs.length];omega
  let τ:=σ.setArr canonical.mem F.e 0
  have hr : Run B zeroGap σ τ 3 := by
    have h:=Run.store (a:=canonical.mem) (B:=B) (σ:=σ)
      (by rw [evalB_var (by rw [he];omega),he]) (evalB_lit (by omega : 0<B)) hlen
    simpa [zeroGap,Expr.size] using h
  have hagree : MemAgree F WS F.e σ τ := by
    refine ⟨by simp [τ],?_,?_,?_,by simp [τ,show canonical.scratch≠canonical.mem by decide],rfl,rfl,rfl,rfl,rfl⟩
    · intro k hk
      simp only [τ,arrs_setArr,if_pos rfl]
      exact getD_set_ne (Ne.symm hk)
    · rw [hs.workspace];omega
    · rw [hs.modulus];omega
  have hst:=state_transfer F hs hagree rfl rfl
  refine ⟨τ,hr,hst,?_,rfl,?_,rfl,rfl⟩
  · apply validMemory_of_slots F hst.slots hst.workspace hst.modulus hst.length
    · rw [show τ.arrs canonical.mem=(σ.arrs canonical.mem).set F.e 0 by simp [τ]]
      rw [getD_set_self hlen]
      exact Nat.pos_of_ne_zero F.prime.ne_zero
    · have h:=hst.slots.base.scratch_fit
      omega
  · intro a ha
    simp [τ,ha]
end Mathproof.Problem18PairBoundaryPrefix20261004
