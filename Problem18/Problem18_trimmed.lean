namespace Problem18OrthogonalAssembly
open Matrix
variable {K : Type*} [Field K]
variable {a b c : ℕ}
def IsOrthogonal {n : Type*} [Fintype n] [DecidableEq n]
    (P : Matrix n n K) : Prop := P.transpose * P = 1
private theorem orthogonal_mul_transpose {n : Type*} [Fintype n] [DecidableEq n]
    {P : Matrix n n K} (hP : IsOrthogonal P) :
    P * P.transpose = 1 := mul_eq_one_comm.mp hP
private theorem orthogonal_transpose_m0032 {n : Type*} [Fintype n] [DecidableEq n]
    (P : Matrix n n K) (hP : IsOrthogonal P) :
    IsOrthogonal P.transpose := by
  simpa only [IsOrthogonal, Matrix.transpose_transpose] using
    orthogonal_mul_transpose hP
private theorem matrix_rightInverse_exists_m0032
    {i j : Type*} [Fintype i] [Fintype j] [DecidableEq i] [DecidableEq j]
    (X : Matrix i j K) (hX : X.rank = Fintype.card i) :
    ∃ E : Matrix j i K, X * E = 1 := by
  have hr : (Matrix.toLin' X).range = ⊤ := by
    apply Submodule.eq_top_of_finrank_eq
    rw [Matrix.toLin'_apply']
    change X.rank = Module.finrank K (i → K)
    simpa only [Module.finrank_pi] using hX
  obtain ⟨g, hg⟩ := LinearMap.exists_rightInverse_of_surjective (Matrix.toLin' X) hr
  refine ⟨LinearMap.toMatrix' g, ?_⟩
  apply Matrix.toLin'.injective
  rw [Matrix.toLin'_mul, Matrix.toLin'_toMatrix', Matrix.toLin'_one]
  exact hg
private theorem gram_recovery_from_source_m0032
    {i j : Type*} [Fintype i] [Fintype j] [DecidableEq i]
    (X Y : Matrix i j K) (E : Matrix j i K)
    (hE : X * E = 1) (hg : X.transpose * X = Y.transpose * Y) :
    IsOrthogonal (Y * E) ∧ (Y * E) * X = Y := by
  have hQ : (Y * E).transpose * (Y * E) = 1 := by
    calc
      (Y * E).transpose * (Y * E) =
          E.transpose * (Y.transpose * Y) * E := by
        simp only [Matrix.transpose_mul, Matrix.mul_assoc]
      _ = E.transpose * (X.transpose * X) * E := by rw [hg]
      _ = (X * E).transpose * (X * E) := by
        simp only [Matrix.transpose_mul, Matrix.mul_assoc]
      _ = 1 := by rw [hE]; simp
  have hF : Y * (E * (Y * E).transpose) = 1 := by
    rw [← Matrix.mul_assoc]
    exact mul_eq_one_comm.mp hQ
  have hFy : (E * (Y * E).transpose).transpose * Y.transpose = 1 := by
    rw [← Matrix.transpose_mul, hF, Matrix.transpose_one]
  have hy : Y = (E * (Y * E).transpose).transpose * (X.transpose * X) := by
    rw [hg, ← Matrix.mul_assoc, hFy, Matrix.one_mul]
  refine ⟨hQ, ?_⟩
  calc
    (Y * E) * X =
        (((E * (Y * E).transpose).transpose * (X.transpose * X)) * E) * X := by
          rw [← hy]
    _ = (E * (Y * E).transpose).transpose * X.transpose * (X * E) * X := by
      simp only [Matrix.mul_assoc]
    _ = (E * (Y * E).transpose).transpose * (X.transpose * X) := by
      rw [hE, Matrix.mul_one, Matrix.mul_assoc]
    _ = Y := hy.symm
abbrev RectTensor (a b c : ℕ) (K : Type*) :=
  Matrix (Fin c) (Fin a × Fin b) K
def rectAction (P : Matrix (Fin a) (Fin a) K)
    (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K)
    (A : RectTensor a b c K) : RectTensor a b c K :=
  R * A * (Matrix.kronecker P Q).transpose
def RectOrthogonalEquivalent (A B : RectTensor a b c K) : Prop :=
  ∃ (P : Matrix (Fin a) (Fin a) K)
    (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K),
    IsOrthogonal P ∧ IsOrthogonal Q ∧ IsOrthogonal R ∧ rectAction P Q R A = B
end Problem18OrthogonalAssembly
