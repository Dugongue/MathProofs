    exact this.mono (by simp [cells, qw, Expr.size])
  · simp only [σ8, σ7, σ6, σ5, σ4, σ3, σ2, σ0, Env.setArr, if_true, hs]
    rw [show 11 + N = (N + 2) + 1 + 1 + 1 + 1 + 1 + 1 + 1 + 1 + 1 by omega]
    simp [List.replicate_succ]
  · intro y hy; simp [σ8, σ7, σ6, σ5, σ4, σ3, σ2, σ0, Env.setArr, hy]
  · simp [σ8, σ7, σ6, σ5, σ4, σ3, σ2, σ0, Env.setArr]
  · simp [σ8, σ7, σ6, σ5, σ4, σ3, σ2, σ0, Env.setArr]
  · simp [σ8, σ7, σ6, σ5, σ4, σ3, σ2, σ0, Env.setArr]
def CInv (N : Nat) (Q P : List Nat) (σ0 : Env) (σ : Env) : Prop :=
  ∃ j, j ≤ N ∧ σ.vars ri = j ∧ σ.vars rn = N ∧ σ.arrs qA = Q ∧
    σ.arrs sA = P ++ (Q.drop 9).take j ++ List.replicate (N - j) 0 ∧
    (∀ y, y ≠ ri → y ≠ rn → σ.vars y = σ0.vars y) ∧
    (∀ a, a ≠ sA → σ.arrs a = σ0.arrs a) ∧ σ.inp = σ0.inp ∧ σ.out = σ0.out
theorem copy_run {W N : Nat} {σ : Env} {Q P : List Nat}
    (hq : σ.arrs qA = Q) (hs : σ.arrs sA = P ++ List.replicate N 0) (hP : P.length = 11)
    (hQ : 9 + N ≤ Q.length) (hQW : Q.length + 12 < W) (hval : ∀ v ∈ Q, v < W)
    (hcells : cells.evalB W σ = some N) :
    ∃ σ', Run W copy σ σ' (20 * (N + 2) + 40) ∧
      σ'.arrs sA = P ++ (Q.drop 9).take N ∧
      (∀ y, y ≠ ri → y ≠ rn → σ'.vars y = σ.vars y) ∧
      (∀ a, a ≠ sA → σ'.arrs a = σ.arrs a) ∧ σ'.inp = σ.inp ∧ σ'.out = σ.out := by
  have hNW : N < W := by omega
  have r1 : Run W (.assign rn cells) σ (σ.setVar rn N) (1 + cells.size) := Run.assign hcells
  let σa := σ.setVar rn N
  have r2 : Run W (.assign ri (.lit 0)) σa (σa.setVar ri 0) (1 + 1) := by
    simpa [Expr.size] using Run.assign (B := W) (x := ri) (σ := σa) (evalB_lit' (n := 0) (by omega))
  let σb := σa.setVar ri 0
  have hI0 : CInv N Q P σ σb := by
    refine ⟨0, by omega, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · simp [σb, Env.setVar]
    · simp [σb, σa, Env.setVar]
    · simp [σb, σa, Env.setVar, hq]
    · simp [σb, σa, Env.setVar, hs]
    · intro y h1 h2; simp [σb, σa, Env.setVar, h1, h2]
    · intro a _; simp [σb, σa, Env.setVar]
    · simp [σb, σa, Env.setVar]
    · simp [σb, σa, Env.setVar]
  have hcond : ∀ τ : Env, τ.vars ri < W → τ.vars rn < W →
      copyCond.evalB W τ = some (decide (τ.vars ri < τ.vars rn)) := by
    intro τ h1 h2; simp [copyCond, Cond.evalB, Expr.evalB, fit, h1, h2]
  have hdef : ∀ τ, CInv N Q P σ τ → ∃ v, copyCond.evalB W τ = some v := by
    rintro τ ⟨j, hj, hi, hn, -⟩
    exact ⟨_, hcond τ (by omega) (by omega)⟩
  have hstep : ∀ τ, CInv N Q P σ τ → copyCond.evalB W τ = some true →
      ∃ τ', Run W copyBody τ τ' 12 ∧ CInv N Q P σ τ' ∧ N - τ'.vars ri < N - τ.vars ri := by
    rintro τ ⟨j, hj, hi, hn, hqa, hsa, hvars, harrs, hinp, hout⟩ hc
    rw [hcond τ (by omega) (by omega), hi, hn] at hc
    have hjN : j < N := by simpa using hc
    have hjQ : 9 + j < Q.length := by omega
    have hv : Q[9 + j] < W := hval _ (List.getElem_mem hjQ)
    have e1 : (Expr.add (.lit 11) (.var ri)).evalB W τ = some (11 + j) := by
      simp [Expr.evalB, fit, hi, show 11 < W by omega, show j < W by omega,
        show 11 + j < W by omega]
    have e2 : (Expr.get qA (.add (.lit 9) (.var ri))).evalB W τ = some Q[9 + j] := by
      simp [Expr.evalB, fit, hi, hqa, show 9 < W by omega, show j < W by omega,
        show 9 + j < W by omega, hjQ, hv]
    have hlen : 11 + j < (τ.arrs sA).length := by rw [hsa]; simp [hP]; omega
    have s1 := Run.store (B := W) (a := sA) e1 e2 hlen
    let τ1 := τ.setArr sA (11 + j) Q[9 + j]
    have hτ1i : τ1.vars ri = j := by simpa [τ1, Env.setArr] using hi
    have e3 : (Expr.add (.var ri) (.lit 1)).evalB W τ1 = some (j + 1) := by
      simp only [Expr.evalB, hτ1i]
      simp [fit, show j < W by omega, show 1 < W by omega, show j + 1 < W by omega]
    have s2 := Run.assign (B := W) (x := ri) e3
    refine ⟨τ1.setVar ri (j+1), (s1.seq s2).mono (by simp [Expr.size]), ?_, ?_⟩
    · refine ⟨j+1, by omega, by simp [Env.setVar], ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · simp [τ1, Env.setVar, Env.setArr, hn]
      · simp [τ1, Env.setVar, Env.setArr, hqa]
      · simp only [τ1, Env.setVar, Env.setArr, if_true]
        rw [hsa, show N - j = (N - (j+1)) + 1 by omega]
        have hl2 : (P ++ List.take j (List.drop 9 Q)).length = 11 + j := by
          simp [hP]; omega
        have hs2 := set_append_replicate (P ++ List.take j (List.drop 9 Q)) (N - (j+1)) Q[9 + j]
        rw [hl2] at hs2
        rw [hs2]
        have hjd : j < (List.drop 9 Q).length := by simp; omega
        rw [List.take_succ_eq_append_getElem hjd]
        simp [List.append_assoc, Nat.add_comm]
      · intro y h1 h2; simp [τ1, Env.setVar, Env.setArr, h1, hvars y h1 h2]
      · intro a ha; simp [τ1, Env.setVar, Env.setArr, ha, harrs a ha]
      · simp [τ1, Env.setVar, Env.setArr, hinp]
      · simp [τ1, Env.setVar, Env.setArr, hout]
    · simp [Env.setVar, hi]; omega
  obtain ⟨σ1, hr, hI1, hf⟩ := Run.while_count (B := W) (CInv N Q P σ) (fun τ => N - τ.vars ri) 12
    hdef hstep hI0
  obtain ⟨j, hj, hi, hn, hqa, hsa, hvars, harrs, hinp, hout⟩ := hI1
  rw [hcond σ1 (by omega) (by omega), hi, hn] at hf
  have hjN : j = N := by simp at hf; omega
  subst hjN
  refine ⟨σ1, ?_, ?_, hvars, harrs, hinp, hout⟩
  · have := r1.seq (r2.seq hr)
    refine this.mono ?_
    have hb : σb.vars ri = 0 := by simp [σb, Env.setVar]
    simp only [hb, copyCond, Cond.size, Expr.size, cells, qw]
    omega
  · rw [hsa]; simp
theorem cells_evalB {W : Nat} {σ : Env} {L t u q p e a b c : Nat} {rest : List Nat}
    (hq : σ.arrs qA = L :: t :: u :: q :: p :: e :: a :: b :: c :: rest)
    (hval : ∀ v ∈ L :: t :: u :: q :: p :: e :: a :: b :: c :: rest, v < W)
    (hNW : 11 + (e + a*b*c*e) < W) (he : 0 < e) (hc : 0 < c) :
    cells.evalB W σ = some (e + a*b*c*e) := by
  have hm : ∀ v ∈ L :: t :: u :: q :: p :: e :: a :: b :: c :: rest, v < W := hval
  have hve := hm e (by simp); have hva := hm a (by simp); have hvb := hm b (by simp)
  have hvc := hm c (by simp)
  have h1 : a*b ≤ a*b*c := Nat.le_mul_of_pos_right _ hc
  have h2 : a*b*c ≤ a*b*c*e := Nat.le_mul_of_pos_right _ he
  simp [cells, qw, Expr.evalB, fit, hq, hva, hvb, hvc, hve, show 5 < W by omega,
    show 6 < W by omega, show 7 < W by omega, show 8 < W by omega,
    show a*b < W by omega, show a*b*c < W by omega, show a*b*c*e < W by omega,
    show e + a*b*c*e < W by omega]
theorem host_not_pre (s tag z : String) : "P37#" ++ s ≠ pre tag z :=
  fun h => pre_ne_host tag z s h.symm
theorem build_run {W B : Nat} {σ : Env} {L t u q p e a b c : Nat} {rest : List Nat}
    (extR : String → Nat)
    (hq : σ.arrs qA = L :: t :: u :: q :: p :: e :: a :: b :: c :: rest)
    (hs : σ.arrs sA = List.replicate (11 + (e + a*b*c*e)) 0)
    (hval : ∀ v ∈ L :: t :: u :: q :: p :: e :: a :: b :: c :: rest, v < W)
    (hQW : rest.length + 30 < W) (hN : e + a*b*c*e ≤ rest.length)
    (he : 0 < e) (hc : 0 < c) (hB : B < W)
    (hRv : ∀ y, σ.vars (pre "R" y) = 0)
    (hRa : ∀ y, σ.arrs (pre "R" y) = List.replicate (extR y) 0)
    (hrin : σ.vars "P37#rin" = 0) :
    ∃ σ', Run W (build B) σ σ' (20 * (rest.length + 2) + 500) ∧
      σ'.arrs sA = (10 + (e + a*b*c*e)) :: 0 :: u :: q :: p :: e :: a :: b :: c ::
        (Mathproof.Problem18IMPSourceDispatch20261001.routeWords B 0 a b c ++
          rest.take (e + a*b*c*e)) ∧
      σ'.arrs qA = L :: t :: u :: q :: p :: e :: a :: b :: c :: rest ∧
      σ'.inp = σ.inp ∧ σ'.out = σ.out ∧
      (∀ y, y ≠ sA → y ≠ ri → y ≠ rn → y ≠ "P37#pr" → y ≠ "P37#rin" →
        (∀ z, y ≠ pre "R" z) → σ'.vars y = σ.vars y ∧ σ'.arrs y = σ.arrs y) := by
  set N := e + a*b*c*e with hNdef
  set Q := L :: t :: u :: q :: p :: e :: a :: b :: c :: rest with hQdef
  have hQl : Q.length = rest.length + 9 := by simp [Q]
  obtain ⟨σh, rh, hsh, harrh, hvarsh, hinph, houth⟩ :=
    header_run (W := W) hq hs hval (by omega) he hc
  have rp := Run.assign (B := W) (x := "P37#pr") (σ := σh) (evalB_lit' (n := 9) (by omega))
  let σp := σh.setVar "P37#pr" 9
  have hqp : σp.arrs qA = Q := by simp [σp, Env.setVar]; rw [harrh qA (by decide), hq]
  have hsp : σp.arrs sA = [10 + N, 0, u, q, p, e, a, b, c] ++ List.replicate (N + 2) 0 := by
    simp [σp, Env.setVar, hsh, hNdef]
  obtain ⟨τR, rR, hoR⟩ := routeProg_run (W := W) B extR hval hB (by omega)
  rw [← hQdef] at rR
  have hR := iso_run fresh_IR rR σp [10 + N, 0, u, q, p, e, a, b, c]
    ([10 + N, 0, u, q, p, e, a, b, c] ++ List.replicate (N + 2) 0)
    (fun y => by
      have : pre "R" y ≠ "P37#pr" := pre_ne_host "R" y "pr"
      simp [σp, Env.setVar, IR, this, hvarsh, hRv])
    (fun y => by
      have : pre "R" y ≠ sA := pre_ne_host "R" y "s"
      simp [σp, Env.setVar, IR]; rw [harrh _ this, hRa])
    (by simp [σp, Env.setVar, IR, hvarsh, hrin])
    ⟨[], by simp [IR, hqp]⟩
    (by simp [IR, hqp, hQl]; omega)
    (by simpa [IR, hqp] using hval)
    (fun h => by simp [IR] at h)
    (fun _ => by simp [σp, Env.setVar, IR])
    (fun _ => by simp [IR, hsp])
    (fun _ => by simp [IR, hsp])
    (fun _ => by simp; omega)
    (fun _ => by simp [IR, hsp])
    (fun _ => by
      simp [hoR, Mathproof.Problem18IMPSourceDispatch20261001.routeWords_source])
  obtain ⟨τ', rI, hinv, hfr⟩ := hR
  have hptr : τ'.vars "P37#pr" = 11 := by
    have := hinv.outPtr rfl
    simpa [IR, hoR, Mathproof.Problem18IMPSourceDispatch20261001.routeWords_source] using this
  have htake := hinv.outArr rfl
  have hdrop := hinv.outRest rfl
  simp only [IR] at htake hdrop
  rw [hptr] at htake hdrop
  have hsR : τ'.arrs sA = ([10 + N, 0, u, q, p, e, a, b, c] ++
      Mathproof.Problem18IMPSourceDispatch20261001.routeWords B 0 a b c) ++
      List.replicate N 0 := by
    rw [← List.take_append_drop 11 (τ'.arrs sA), htake, hdrop, hoR]
    simp
  have hqR : τ'.arrs qA = Q := by
    rw [hfr.arrs qA (fun z => host_not_pre "q" "R" z) (by decide)]; exact hqp
  obtain ⟨σc, rc, hsc, hvc', harrc, hinpc, houtc⟩ := copy_run (W := W) (N := N) (σ := τ')
    (Q := Q) hqR hsR (by simp [Mathproof.Problem18IMPSourceDispatch20261001.routeWords_source])
    (by simp [Q]; omega) (by simp [Q]; omega) hval
    (by rw [hNdef]; exact cells_evalB hqR hval (by omega) he hc)
  refine ⟨σc, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · have := rh.seq (rp.seq (rI.seq rc))
    exact this.mono (by simp [Expr.size]; omega)
  · rw [hsc]; simp [Q]
  · rw [harrc qA (by decide), hqR]
  · rw [hinpc, hfr.inp]; simp [σp, Env.setVar, hinph]
  · rw [houtc, hfr.out rfl]; simp [σp, Env.setVar, houth]
  · intro y h1 h2 h3 h4 h5 h6
    have hv1 := hvc' y h2 h3
    have hv2 := hfr.vars y (fun z => h6 z) h5 h4
    have ha1 := harrc y h1
    have ha2 := hfr.arrs y (fun z => h6 z) h1
    refine ⟨?_, ?_⟩
    · rw [hv1, hv2]; simp [σp, Env.setVar, h4, hvarsh]
    · rw [ha1, ha2]; simp [σp, Env.setVar]; exact harrh y h1
end Mathproof.Problem18P37HostBuild20261004
