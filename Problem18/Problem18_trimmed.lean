variable {K : Type*} [Semiring K]
def dot : {n : ℕ} → (Fin n→K) → (Fin n→K) → K×ℕ
  | 0,_,_ => (0,0)
  | n+1,x,y =>
    let r := dot (fun i:Fin n => x i.succ) (fun i:Fin n => y i.succ)
    (x 0*y 0+r.1,r.2+2)
theorem dot_correct {n : ℕ} (x y : Fin n→K) : (dot x y).1=∑i,x i*y i := by
  induction n with
  | zero => simp [dot]
  | succ n ih => simp only [dot,ih,Fin.sum_univ_succ]
theorem dot_cost {n : ℕ} (x y : Fin n→K) : (dot x y).2=2*n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [dot,ih]; omega
def mulEntries {m k n : ℕ} (A : Matrix (Fin m) (Fin k) K)
    (B : Matrix (Fin k) (Fin n) K) : Array (K×ℕ) :=
  Array.ofFn fun ij:Fin (m*n) => dot (A (finProdFinEquiv.symm ij).1) (fun t => B t (finProdFinEquiv.symm ij).2)
def mul {m k n : ℕ} (A : Matrix (Fin m) (Fin k) K)
    (B : Matrix (Fin k) (Fin n) K) : Matrix (Fin m) (Fin n) K × ℕ :=
  let entries := mulEntries A B
  ((fun i j => (entries[(finProdFinEquiv (i,j)).val]'(by simpa [entries,mulEntries] using (finProdFinEquiv (i,j)).isLt)).1),
   ∑ij:Fin (m*n), (entries[ij.val]'(by simpa [entries,mulEntries] using ij.isLt)).2)
def mulValue {m k n : ℕ} (A : Matrix (Fin m) (Fin k) K)
    (B : Matrix (Fin k) (Fin n) K) := (mul A B).1
def mulCost {m k n : ℕ} (A : Matrix (Fin m) (Fin k) K)
    (B : Matrix (Fin k) (Fin n) K) := (mul A B).2
theorem mulValue_correct {m k n : ℕ} (A : Matrix (Fin m) (Fin k) K)
    (B : Matrix (Fin k) (Fin n) K) : mulValue A B=A*B := by
  ext i j
  simp only [mulValue,mul,mulEntries,Array.getElem_ofFn,Fin.eta,Equiv.symm_apply_apply,dot_correct,Matrix.mul_apply]
theorem mulCost_eq {m k n : ℕ} (A : Matrix (Fin m) (Fin k) K)
    (B : Matrix (Fin k) (Fin n) K) : mulCost A B=2*m*k*n := by
  simp [mulCost,mul,mulEntries,dot_cost]
  ring
def powerEntries {m n : ℕ} (q : ℕ) (A : Matrix (Fin m) (Fin n) K) : Array (K×ℕ) :=
  Array.ofFn fun ij:Fin (m*n) => binaryPower (A (finProdFinEquiv.symm ij).1 (finProdFinEquiv.symm ij).2) q
def power {m n : ℕ} (q : ℕ) (A : Matrix (Fin m) (Fin n) K) :
    Matrix (Fin m) (Fin n) K × ℕ :=
  let entries := powerEntries q A
  ((fun i j => (entries[(finProdFinEquiv (i,j)).val]'(by simpa [entries,powerEntries] using (finProdFinEquiv (i,j)).isLt)).1),
   ∑ij:Fin (m*n), (entries[ij.val]'(by simpa [entries,powerEntries] using ij.isLt)).2)
def powerValue {m n : ℕ} (q : ℕ) (A : Matrix (Fin m) (Fin n) K) := (power q A).1
def powerCost {m n : ℕ} (q : ℕ) (A : Matrix (Fin m) (Fin n) K) := (power q A).2
theorem powerValue_correct {m n : ℕ} (q : ℕ) (A : Matrix (Fin m) (Fin n) K) :
    powerValue q A=A.map (·^q) := by
  ext i j
  simp only [powerValue,power,powerEntries,Array.getElem_ofFn,Fin.eta,Equiv.symm_apply_apply,binaryPower_correct,Matrix.map_apply]
theorem powerCost_le {m n : ℕ} (q : ℕ) (A : Matrix (Fin m) (Fin n) K) :
    powerCost q A≤2*m*n*q.size := by
  dsimp only [powerCost,power]
  calc
    _ ≤ ∑_ij:Fin (m*n),2*q.size := by
      apply Finset.sum_le_sum
      intro i hi
      simpa only [powerEntries,Array.getElem_ofFn] using binaryPower_cost (A (finProdFinEquiv.symm i).1 (finProdFinEquiv.symm i).2) q
    _ = _ := by simp; ring
def gram {c b : ℕ} (unitary : Bool) (q : ℕ) (A : Matrix (Fin c) (Fin b) K) :
    Matrix (Fin b) (Fin b) K×ℕ :=
  if unitary then
    let S := power q A
    let R := mul S.1.transpose A
    (R.1,S.2+R.2)
  else mul A.transpose A
theorem gram_correct {c b : ℕ} (u : Bool) (q : ℕ) (A : Matrix (Fin c) (Fin b) K) :
    (gram u q A).1=(if u then (A.map (·^q)).transpose*A else A.transpose*A) := by
  cases u <;> simp only [gram, Bool.false_eq_true, Bool.true_eq, ↓reduceIte]
  · exact mulValue_correct _ _
  · change mulValue (powerValue q A).transpose A = _
    rw [mulValue_correct,powerValue_correct]
theorem gram_cost {c b : ℕ} (u : Bool) (q : ℕ) (A : Matrix (Fin c) (Fin b) K) :
    (gram u q A).2≤2*c*b*b+2*c*b*q.size := by
  cases u <;> simp only [gram,Bool.false_eq_true,↓reduceIte,Bool.true_eq]
  · change mulCost A.transpose A ≤ _
    rw [mulCost_eq]
    have he : 2*b*c*b=2*c*b*b := by ring
    rw [he]
    omega
  · change powerCost q A + mulCost (powerValue q A).transpose A ≤ _
    rw [mulCost_eq]
    have h := powerCost_le q A
    have he : 2*b*c*b=2*c*b*b := by ring
    rw [he]
    omega
end Mathproof.Problem18CountedMatrixProducts20261001
