        rowData n d rows r j := by
    intro r j
    by_cases hr : r.val < c
    · rw [hout r.val (by simpa only [hlen] using hr) j, targetRow_self]
      rw [rowData_of_lt n d rows r (by simpa only [hlen] using hr)]
    · have hidx := hindex r j
      have haddr : 5 + r.val * boxSize n d + j.val < Sn := by omega
