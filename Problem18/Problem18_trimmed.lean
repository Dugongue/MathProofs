  constructor
  · intro hz
    have he := e.apply_symm_apply x
    rw [adapted_apply,hz,map_zero,ZeroMemClass.coe_zero,add_zero] at he
    exact he ▸ (f (e.symm x∘Sum.inl)).property
  · intro hx
    have he : e.symm x=Sum.elim (f.symm ⟨x,hx⟩) 0 := by
      apply e.injective
      rw [e.apply_symm_apply,adapted_apply]
      simp only [Function.comp_def,Sum.elim_inl,Sum.elim_inr,map_zero,
        ZeroMemClass.coe_zero,add_zero,LinearEquiv.apply_symm_apply]
    rw [he]
    rfl
