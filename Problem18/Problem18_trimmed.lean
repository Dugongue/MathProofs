    exact (hr.seq (Run.ite_false hc Run.skip)).mono (by simp only [budget,Cond.size,Expr.size];omega)
  · have hf1 : (Expr.var q.f).evalB B ξ = some 1 := by
      simpa only [hf] using evalB_var (B:=B) (σ:=ξ) (x:=q.f) (by rw [hf];exact h1B)
    have hc : (Cond.eq (.var q.f) (.lit 1)).evalB B ξ = some true :=
      evalB_condEq hf1 (evalB_lit h1B)
    obtain ⟨τ,ha,ht,hva,hia,hoa⟩ := active_run F q hq hb hfit
    refine ⟨τ,Q,P%Q,?_,ht,Or.inr ⟨hQ,rfl,rfl⟩,?_,hia.trans hi,hoa.trans ho⟩
    · exact (hr.seq (Run.ite_true hc ha)).mono (by simp only [budget,Cond.size,Expr.size];omega)
