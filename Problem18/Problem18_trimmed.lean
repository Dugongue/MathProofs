    have hcond := evalB_condEq hsub (evalB_lit (σ:=ρ) (B:=B) (n:=0) (by omega))
    have haddr : (Expr.bin .add (.var fbase) (.var fj)).evalB B ρ = some (b + j) := by
      have := evalB_bin (op:=.add) (evalB_var (σ:=ρ) (x:=fbase) (B:=B) (by rw [hbase]; omega))
