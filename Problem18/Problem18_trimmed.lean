variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}
def halveCom (t s : String) : Com :=
  .while (.lt (.lit 0) (.var t))
    (.seq (.assign t (.bin .div (.var t) (.lit 2))) (.assign s (plus (.var s) (.lit 1))))
theorem size_half_lt {t : ℕ} (ht : 0 < t) : Nat.size (t / 2) < Nat.size t := by
  have h1 : 0 < Nat.size t := Nat.size_pos.mpr ht
  have h2 := Nat.lt_size_self t
  have h3 : t / 2 < 2 ^ (Nat.size t - 1) := by
    rw [Nat.div_lt_iff_lt_mul (by omega), ← pow_succ, Nat.sub_add_cancel h1]; exact h2
  have := Nat.size_le.mpr h3
  omega
theorem size_le_self (Q : ℕ) : Nat.size Q ≤ Q := Nat.size_le.mpr Nat.lt_two_pow_self
theorem halve_run (q : RNames) (t s : String) (htS : t ∉ regNames r) (hsS : s ∉ regNames r)
    (htW : t ≠ q.WS) (hsW : s ≠ q.WS) (hts : t ≠ s) {B Sn Q : ℕ} {σ : Env}
    (hS : Slots F r q.WS Sn B σ) (ht : σ.vars t = Q) (hs : σ.vars s = 0) (hQB : Q < B) (hB2 : 2 < B) :
    ∃ τ sv, Run B (halveCom t s) σ τ (12 * Nat.size Q + 4) ∧ Slots F r q.WS Sn B τ ∧
      τ.vars s = sv ∧ Q / 2 ^ sv = 0 ∧ (∀ k < sv, Q / 2 ^ k ≠ 0) ∧ sv ≤ Nat.size Q ∧
      (∀ x, x ≠ t → x ≠ s → τ.vars x = σ.vars x) ∧ (∀ u, val F r q.WS τ u = val F r q.WS σ u) ∧
      τ.arrs = σ.arrs ∧ τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hsz := size_le_self Q
  let I : Env → Prop := fun τ =>
    Slots F r q.WS Sn B τ ∧ τ.vars t = Q / 2 ^ τ.vars s ∧ (∀ k < τ.vars s, Q / 2 ^ k ≠ 0) ∧
    τ.vars s ≤ Nat.size Q ∧
    (∀ x, x ≠ t → x ≠ s → τ.vars x = σ.vars x) ∧ (∀ u, val F r q.WS τ u = val F r q.WS σ u) ∧
    τ.arrs = σ.arrs ∧ τ.inp = σ.inp ∧ τ.out = σ.out
  have hI0 : I σ := by
