    (hcard : Nat.card K=Nat.card F^2) (hstar : ∀ x : K,star x=x^Nat.card F) :
    Nat.card (GoodGram (K:=K) n)*
      Nat.card (Isometries (starRingAut : K ≃+* K) (standardHermitian (K:=K) (n+m))) ≤
      Nat.card {A : Matrix (Fin (n+m)) (Fin n) K // UnitaryGood A}*
