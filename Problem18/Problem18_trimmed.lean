variable {K : Type*} [Field K] [Fintype K] [StarRing K]
noncomputable def standardHermitian (n : ℕ) :
    (Fin n → K) →ₛₗ[starRingEnd K] (Fin n → K) →ₗ[K] K :=
  (1 : Matrix (Fin n) (Fin n) K).toLinearMap₂'Aux (starRingEnd K) (RingHom.id K)
theorem standardHermitian_apply {n : ℕ} (x y : Fin n → K) :
    standardHermitian n x y = star x ⬝ᵥ y := by
  simp [standardHermitian, Matrix.toLinearMap₂'Aux, LinearMap.mk₂'ₛₗ_apply,
    Matrix.one_apply, dotProduct, mul_comm, starRingEnd_apply]
theorem standardHermitian_symm (n : ℕ) : (standardHermitian (K := K) n).IsSymm := by
  constructor
  intro x y
  simp only [standardHermitian_apply, starRingEnd_apply]
  exact (Matrix.star_dotProduct y x).symm
theorem standardHermitian_separating (n : ℕ) :
    (standardHermitian (K := K) n).SeparatingLeft := by
  intro x hx
  funext i
  have h := hx (Pi.single i 1)
  simpa [standardHermitian_apply] using h
theorem standardHermitian_pullback {n : ℕ} {ι : Type*} [Fintype ι]
    (C : Matrix (Fin n) ι K) (x y : ι → K) :
    standardHermitian n (C *ᵥ x) (C *ᵥ y) = star x ⬝ᵥ ((Cᴴ*C) *ᵥ y) := by
  rw [standardHermitian_apply, Matrix.star_mulVec]
  simp only [Matrix.dotProduct_mulVec, Matrix.vecMul_vecMul]
theorem gram_eq_iff_pairing_eq {n : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]
    (C D : Matrix (Fin n) ι K) :
    (∀ x y, standardHermitian n (C *ᵥ x) (C *ᵥ y) =
      standardHermitian n (D *ᵥ x) (D *ᵥ y)) ↔ Cᴴ*C=Dᴴ*D := by
  constructor
  · intro h
    ext i j
    have hij := h (Pi.single i 1) (Pi.single j 1)
    rw [standardHermitian_pullback, standardHermitian_pullback] at hij
    simpa using hij
  · intro h x y
    simp only [standardHermitian_pullback, h]
noncomputable def unitaryEquiv {n : ℕ} (R : Matrix (Fin n) (Fin n) K)
    (hR : IsUnitary R) : (Fin n → K) ≃ₗ[K] (Fin n → K) :=
  { R.toLin' with
    invFun := Rᴴ.toLin'
    left_inv := by
      intro x
      change Rᴴ *ᵥ (R *ᵥ x) = x
      rw [Matrix.mulVec_mulVec, (show Rᴴ * R = 1 from hR), Matrix.one_mulVec]
    right_inv := by
      intro x
      change R *ᵥ (Rᴴ *ᵥ x) = x
      rw [Matrix.mulVec_mulVec, (show R * Rᴴ = 1 from mul_eq_one_comm.mp hR), Matrix.one_mulVec] }
theorem unitaryEquiv_preserves {n : ℕ} (R : Matrix (Fin n) (Fin n) K)
    (hR : IsUnitary R) (x y : Fin n → K) :
    standardHermitian n (unitaryEquiv R hR x) (unitaryEquiv R hR y) =
      standardHermitian n x y := by
  change standardHermitian n (R *ᵥ x) (R *ᵥ y) = _
  rw [standardHermitian_pullback, (show Rᴴ * R = 1 from hR),
    Matrix.one_mulVec, standardHermitian_apply]
variable {F : Type*} [Field F] [Fintype F] [Algebra F K]
theorem final_unitary_factor_iff
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    {n : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]
    (C D : Matrix (Fin n) ι K) :
    (∃ R : Matrix (Fin n) (Fin n) K, IsUnitary R ∧ R*C = D) ↔
