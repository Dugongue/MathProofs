    change e (t*e.symm (e x))=se.1.val (e x)
    rw [e.symm_apply_apply]
    exact se.2.property x
  apply Sigma.ext hS
  apply (Subtype.heq_iff_coe_eq (by intro z; simp only [incidenceMap,hS])).mpr
  rfl
noncomputable def incidenceEquiv (hφ : Function.Involutive φ)
    (htr : (Algebra.traceForm K E).Nondegenerate)
    (t : E) (ht : φ t=t) (hgen : Algebra.adjoin K ({t}:Set E)=⊤)
