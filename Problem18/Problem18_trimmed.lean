theorem hyperbolic_shift_fiber_card_le
    {X G Q : Type*} [AddCommGroup X] [Fintype X]
    [AddCommGroup G] [AddCommGroup Q] [Fintype Q]
    (h : X → X →+ G) (m : ℕ) (π : G →+ Q) (z : G) :
    Nat.card {u : Fin m → X×X // π (∑ j, h (u j).1 (u j).2)=π z} ≤
      Nat.card {u : Fin m → X×X // π (∑ j, h (u j).1 (u j).2)=0} := by
  classical
  have hb := hyperbolic_uniform_coset_shift_le h m π z
  simp only [uniformImageWeight, norm_div, Complex.norm_natCast] at hb
  have hc := (div_le_div_iff_of_pos_right (by positivity :
    (0 : ℝ)<Fintype.card (Fin m → X×X))).mp hb
  simpa only [Nat.card_eq_fintype_card,Fintype.card_subtype] using
    (show (Finset.univ.filter (fun u : Fin m → X×X =>
      π (∑ j, h (u j).1 (u j).2)=π z)).card ≤
      (Finset.univ.filter (fun u : Fin m → X×X =>
      π (∑ j, h (u j).1 (u j).2)=0)).card from by exact_mod_cast hc)
theorem hyperbolic_shift_submodule_card_le
    {K X M : Type*} [Field K] [AddCommGroup X] [Fintype X]
    [AddCommGroup M] [Module K M] [Fintype M]
    (h : X → X →+ M) (m : ℕ) (L : Submodule K M) (shift : M) :
    Nat.card {u : Fin m → X×X // shift+(∑ j, h (u j).1 (u j).2) ∈ L} ≤
      Nat.card {u : Fin m → X×X // (∑ j, h (u j).1 (u j).2) ∈ L} := by
  classical
  letI : Finite (M ⧸ L) := Finite.of_surjective L.mkQ
    (LinearMap.range_eq_top.mp L.range_mkQ)
  letI : Fintype (M ⧸ L) := Fintype.ofFinite _
  have hb := hyperbolic_shift_fiber_card_le h m L.mkQ.toAddMonoidHom (-shift)
  have hshift (v : M) : L.mkQ v=L.mkQ (-shift) ↔ shift+v∈L := by
    change (Submodule.Quotient.mk v : M ⧸ L)=Submodule.Quotient.mk (-shift) ↔ _
    rw [Submodule.Quotient.eq]
    simp [sub_neg_eq_add,add_comm]
  change Nat.card {u : Fin m → X×X // L.mkQ (∑ j, h (u j).1 (u j).2)=L.mkQ (-shift)} ≤
    Nat.card {u : Fin m → X×X // L.mkQ (∑ j, h (u j).1 (u j).2)=0} at hb
  simp only [hshift] at hb
  simpa only [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] using hb
end Mathproof.Problem18AnchorShiftCard20260930
end
