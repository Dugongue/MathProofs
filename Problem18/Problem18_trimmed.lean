    physN F.e (poweredN a b c) + F.e*(c*(a*b)) = physN F.e (transposedN a b c) ∧
    physN F.e (transposedN a b c) + F.e*(c*(a*b)) = physN F.e (firstGramN a b c) ∧
    physN F.e (firstGramN a b c) + F.e*((a*b)*(a*b)) ≤ physN F.e (firstPowerN a b c) ∧
    physN F.e (firstPowerN a b c) + c*(2*(F.e*((a*b)*(a*b)))) ≤
      physN F.e (firstProductWorkN a b c) ∧
    physN F.e (firstProductWorkN a b c) + 3*F.e = physN F.e (firstOneN a b c) ∧
    physN F.e (firstOneN a b c) + F.e = physN F.e (firstFamilyN a b c) ∧
    physN F.e (firstFamilyN a b c) + F.e*(c*b*b) ≤ physN F.e (firstScratchN a b c) ∧
    physN F.e (firstScratchN a b c) + 3*F.e ≤ F.e + 1 + Sn*F.e ∧
    F.e + 1 ≤ physN F.e (sortedN a b c) ∧
    F.e + 1 + Sn*F.e < W := by
  intro S
  have hc := layout_chain a b c
  have ht := pg_tensor_le F h
  have hlen := pg_len_lt F h
  have hfit := h.fit
  have ha := h.a_pos; have hb := h.b_pos; have hc0 := h.c_pos
  have hS : 1 ≤ S := by pomega
  have haS : a ≤ S := by pomega
  have hbS : b ≤ S := by pomega
  have hcS : c ≤ S := by pomega
  have hab : a*b ≤ S*S := Nat.mul_le_mul haS hbS
  have habab : (a*b)*(a*b) ≤ S*S*(S*S) := Nat.mul_le_mul hab hab
  have hcbb : c*b*b ≤ S*S*(S*S) := by
    have h1 : c*b*b ≤ S*S*S := Nat.mul_le_mul (Nat.mul_le_mul hcS hbS) hbS
    have h2 : S*S*S ≤ S*S*(S*S) := by
      have := Nat.mul_le_mul_left (S*S) (show S ≤ S*S from Nat.le_mul_of_pos_left _ hS)
      simpa [Nat.mul_assoc] using this
    pomega
  have hpow : c*(2*((a*b)*(a*b))) ≤ (2*S)*(S*S*(S*S)) := by
    have := Nat.mul_le_mul hcS (Nat.mul_le_mul_left 2 habab)
    have e : S*(2*(S*S*(S*S))) = (2*S)*(S*S*(S*S)) := by ring
    pomega
  have p4 : physN F.e (firstPowerN a b c) =
      physN F.e (firstGramN a b c) + F.e*(S*S*(S*S)) := by
    rw [← hc.2.2.2.1, physN_add]; try ring
  have p5 : physN F.e (firstProductWorkN a b c) =
      physN F.e (firstPowerN a b c) + F.e*((2*S)*(S*S*(S*S))) := by
    rw [← hc.2.2.2.2.1, physN_add]; try ring
  have p6 : physN F.e (firstOneN a b c) = physN F.e (firstProductWorkN a b c) + 3*F.e := by
    rw [← hc.2.2.2.2.2.1, physN_add]; try ring
  have p7 : physN F.e (firstFamilyN a b c) = physN F.e (firstOneN a b c) + F.e := by
    rw [← hc.2.2.2.2.2.2.1, physN_add]; try ring
  have p8 : physN F.e (firstScratchN a b c) =
      physN F.e (firstFamilyN a b c) + F.e*(S*S*(S*S)) := by
    rw [← hc.2.2.2.2.2.2.2.1, physN_add]; try ring
  have p9 : physN F.e (firstRightN a b c) = physN F.e (firstScratchN a b c) + 3*F.e := by
    rw [← hc.2.2.2.2.2.2.2.2.1, physN_add]; try ring
  have p10 := pg_phys_le F h (n := firstRightN a b c) (by pomega)
  have m1 := Nat.mul_le_mul_left F.e habab
  have m2 := Nat.mul_le_mul_left F.e hpow
  have m3 := Nat.mul_le_mul_left F.e hcbb
  have e2 : F.e*(c*(2*((a*b)*(a*b)))) = c*(2*(F.e*((a*b)*(a*b)))) := by ring
  refine ⟨ht.1, ht.2.1, ht.2.2, by pomega, by pomega, p6.symm, p7.symm, by pomega, by pomega,
    physN_ge _ _, hlen⟩
