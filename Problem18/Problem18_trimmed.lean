  simp only [Nat.card_eq_fintype_card] at hf ⊢
  rw [← he]
  calc
    _ ≤ ∑ _W : G, Fintype.card (SymMat r K) := Finset.sum_le_sum (fun W _ => hf W)
    _ = _ := by simp [G]
theorem symmetric_rank_count_bound [Fintype K] (n r : ℕ) (hr : r ≤ n) :
    (Nat.card {A : SymMat n K // A.val.rank = r} : ℝ) ≤
      4 * (Fintype.card K : ℝ) ^
