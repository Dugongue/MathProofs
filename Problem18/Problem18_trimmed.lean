variable {K σ : Type*} [Field K]
noncomputable def standardResidue (m : MonomialOrder σ)
    (I : Ideal (MvPolynomial σ K)) (G : Set (MvPolynomial σ K))
    (d : standardMonomials m G) : (MvPolynomial σ K) ⧸ I :=
  Ideal.Quotient.mk I (monomial d.val 1)
theorem standardResidue_linearIndependent (m : MonomialOrder σ)
    (I : Ideal (MvPolynomial σ K)) (G : Set (MvPolynomial σ K))
    (hG : IsBasisFor m I G) : LinearIndependent K (standardResidue m I G) := by
  classical
  rw [linearIndependent_iff']
  intro s c hzero a ha
  let f : MvPolynomial σ K := ∑ d ∈ s, monomial d.val (c d)
  have hq : Ideal.Quotient.mk I f = 0 := by
    change (Ideal.Quotient.mkₐ K I) f = 0
    rw [show f = ∑ d ∈ s, c d • monomial d.val (1 : K) by simp [f, smul_monomial]]
    simp only [map_sum, map_smul]
    exact hzero
  have hmem : f ∈ generatedIdeal G := by
    rw [hG.2]
    exact (Ideal.Quotient.eq_zero_iff_mem).mp hq
  have hred : IsReduced m G f := by
    intro d hd
    by_contra hns
    have hc : coeff d f = 0 := by
      simp only [f, coeff_sum]
      apply Finset.sum_eq_zero
      intro b hb
      have hne : b.val ≠ d := by
        intro h
        exact hns (h ▸ b.property)
      simp [coeff_monomial, hne]
    exact (MvPolynomial.mem_support_iff.mp hd) hc
  have hf0 := reduced_mem_eq_zero_checked m G hG.1 f hred hmem
  have hc := congrArg (coeff a.val) hf0
  have heq : ∀ b : standardMonomials m G, (b.val = a.val) ↔ b = a := fun b =>
    ⟨Subtype.ext, congrArg Subtype.val⟩
  simpa [f, coeff_sum, coeff_monomial, heq, ha] using hc
theorem pure_power_leaders_of_finiteDimensional
    (m : MonomialOrder σ) (I : Ideal (MvPolynomial σ K))
    (G : Set (MvPolynomial σ K)) (hG : IsBasisFor m I G)
    [FiniteDimensional K ((MvPolynomial σ K) ⧸ I)] :
    ∀ i : σ, ∃ g ∈ G, g ≠ 0 ∧ ∃ d : ℕ, m.degree g = Finsupp.single i d := by
  classical
  have hs : (standardMonomials m G).Finite := (standardResidue_linearIndependent m I G hG).finite
  intro i
  let N := hs.toFinset.sup (fun d => d i) + 1
  have hnot : Finsupp.single i N ∉ standardMonomials m G := by
    intro h
    have hle := Finset.le_sup (f := fun d : σ →₀ ℕ => d i) (hs.mem_toFinset.mpr h)
    simp only [Finsupp.single_eq_same] at hle
    exact Nat.not_succ_le_self _ hle
  change ¬ (∀ g ∈ G, g ≠ 0 → ¬ ExponentDivides (m.degree g) (Finsupp.single i N)) at hnot
  push Not at hnot
  obtain ⟨g,hg,hg0,hdiv⟩ := hnot
  refine ⟨g,hg,hg0,m.degree g i,?_⟩
  ext j
  by_cases hij : i = j
  · subst j
    simp
  · have hj := hdiv j
    rw [Finsupp.single_eq_of_ne (Ne.symm hij)] at hj
    have hz := Nat.eq_zero_of_le_zero hj
    simp [hij,hz]
variable {L : Type*} [Field L] [Algebra K L] [IsAlgClosed L]
  [Algebra.IsAlgebraic K L] [Fintype σ] [DecidableEq σ]
end Mathproof.Problem18BoundedGroundGroebner20260930
