  have h2 := Q.polarBilin.finrank_range_add_finrank_ker
  have h3 := (LinearMap.ker Q.polarBilin).finrank_sup_add_finrank_inf_eq (E.comap f)
  have h4 := (LinearMap.ker Q.polarBilin ⊔ E.comap f).finrank_le
  have h5 := (E.comap f).finrank_le
  omega
variable [CharP K 2] {n : ℕ}
noncomputable def completion (Q : QuadraticForm K (Fin n → K))
