  have he : reference (fun M : SourceRows K m r a b=>fun T : Mathproof.Problem18CharTwoGram20260930.SymMat b K=>
      Algebra.adjoin K ({tensorGram (sourceMetric C) M,T.val}:Set (Matrix (Fin b) (Fin b) K))≠⊤)=
