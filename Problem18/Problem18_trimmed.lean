theorem columnGramRecord_power
    {K i j : Type*} [Field K] [StarRing K] [Fintype i] [Fintype j]
    [DecidableEq i] [DecidableEq j] (A : Matrix i j K) (t : ℕ) :
    (columnGramRecord A)^(t+1) = (Aᴴ * (A * Aᴴ)^t * A).transpose := by
  have h : (Aᴴ * A)^(t+1) = Aᴴ * (A * Aᴴ)^t * A := by
    induction t with
    | zero => simp
    | succ t ih =>
      rw [pow_succ (Aᴴ * A), ih, pow_succ]
      simp only [Matrix.mul_assoc]
  rw [columnGramRecord, ← Matrix.transpose_pow, h]
