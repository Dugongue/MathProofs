variable {K : Type*} [Field K] [DecidableEq K] {n m : Nat}
def kernelColumn (v : Fin m→Fin n→K) (j : Fin m) : Vector K m×Nat :=
  let r:=reduceArray (List.finRange n) (Fin.castAdd m) (rows v) (query (v j))
  (Vector.ofFn (fun i=>(if i=j then 1 else 0)-(-read r.1 (i.natAdd n))),r.2+2*m)
theorem kernelColumn_correct (v : Fin m→Fin n→K) (j : Fin m) :
    (kernelColumn v j).1=kernelArray v j := by
  ext i hi
  simp only [kernelColumn,kernelArray,coordinates,Vector.getElem_ofFn,read_ofFn]
theorem kernelColumn_cost (v : Fin m→Fin n→K) (j : Fin m) :
    (kernelColumn v j).2 ≤ m*n+(2*(n+m)+1)*m^2+2*m := by
  have h:=reduceArray_cost_le (List.finRange n) (Fin.castAdd m) (rows v) (query (v j))
  simp only [rows,List.length_map,List.length_finRange] at h
  exact Nat.add_le_add_right h _
def kernel (A : Matrix (Fin n) (Fin m) K) : Matrix (Fin m) (Fin m) K×Nat :=
  let entries:=Vector.ofFn (fun j=>kernelColumn (fun j i=>A i j) j)
  ((fun j i=>read entries[j.val].1 i),∑j:Fin m,entries[j.val].2)
theorem kernel_correct (A : Matrix (Fin n) (Fin m) K) : (kernel A).1=matrixKernelFamily A := by
  ext j i
  simp only [kernel,Vector.getElem_ofFn,kernelColumn_correct,matrixKernelFamily,kernelFamily]
theorem kernel_cost (A : Matrix (Fin n) (Fin m) K) :
    (kernel A).2 ≤ m*(m*n+(2*(n+m)+1)*m^2+2*m) := by
  change (∑j:Fin m,(Vector.ofFn (fun j=>kernelColumn (fun j i=>A i j) j))[j.val].2) ≤ _
  simp only [Vector.getElem_ofFn,Fin.eta]
  calc
    _ ≤ ∑_j:Fin m,(m*n+(2*(n+m)+1)*m^2+2*m) := by
      apply Finset.sum_le_sum
      intro j hj
      exact kernelColumn_cost (fun j i=>A i j) j
    _=_:=by simp
def rank (A : Matrix (Fin n) (Fin m) K) : Nat×Nat :=
  let r:=compress ((List.finRange m).map (fun j=>Vector.ofFn (fun i=>A i j)))
  (r.1.length,r.2)
theorem rank_cost (A : Matrix (Fin n) (Fin m) K) : (rank A).2 ≤ m*testBudget n := by
  simpa only [rank,List.length_map,List.length_finRange] using
    compress_cost ((List.finRange m).map (fun j=>Vector.ofFn (fun i=>A i j)))
