def ExponentDivides (d e : Finsupp σ Nat) : Prop :=
  ∀ i : σ, d i ≤ e i
def generatedIdeal (G : Set (MvPolynomial σ K)) : Ideal (MvPolynomial σ K) :=
  Ideal.span G
def leadingIdeal (G : Set (MvPolynomial σ K)) : Ideal (MvPolynomial σ K) :=
  Ideal.span (Set.image m.leadingTerm G)
