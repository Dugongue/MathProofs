namespace Mathproof.Problem18IMPAssignments20261002
open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Problem18ClaudeIMPSlots20261001
def program : List (String × Expr) → Com
  | [] => .skip
  | (x,e)::xs => .seq (.assign x e) (program xs)
def cost : List (String × Expr) → ℕ
  | [] => 1
  | (_,e)::xs => 1+e.size+cost xs
def applyValues (xs : List (String × Expr)) (v : Expr→ℕ) (σ : Env) : Env :=
  xs.foldl (fun τ p=>τ.setVar p.1 (v p.2)) σ
def Independent (xs : List (String × Expr)) : Prop :=
  ∀p∈xs,∀q∈xs,NoVar p.1 q.2
@[simp] theorem applyValues_nil (v : Expr→ℕ) (σ : Env) : applyValues [] v σ=σ := rfl
@[simp] theorem applyValues_cons (p : String × Expr) (xs : List (String × Expr))
    (v : Expr→ℕ) (σ : Env) :
    applyValues (p::xs) v σ=applyValues xs v (σ.setVar p.1 (v p.2)) := rfl
theorem run_assignments {B : ℕ} (xs : List (String × Expr)) (v : Expr→ℕ) (σ : Env)
    (heval : ∀p∈xs,p.2.evalB B σ=some (v p.2)) (hfree : Independent xs) :
    Run B (program xs) σ (applyValues xs v σ) (cost xs) := by
  induction xs generalizing σ with
  | nil => exact Run.skip
  | cons p xs ih =>
    have hh:=heval p (by simp)
    have ht:∀a∈xs,a.2.evalB B (σ.setVar p.1 (v p.2))=some (v a.2):=by
      intro a ha
      rw [evalB_setVar_noVar a.2 (hfree p (by simp) a (by simp [ha]))]
      exact heval a (by simp [ha])
    have htail:Independent xs:=by
      intro a ha b hb
      exact hfree a (by simp [ha]) b (by simp [hb])
    exact (Run.assign hh).seq (ih _ ht htail)
theorem applyValues_vars (xs : List (String × Expr)) (v : Expr→ℕ) (σ : Env)
    (x : String) (hx : x∉xs.map Prod.fst) : (applyValues xs v σ).vars x=σ.vars x := by
  induction xs generalizing σ with
  | nil => rfl
  | cons p xs ih =>
    have hp:x≠p.1:=by simp only [List.map_cons,List.mem_cons,not_or] at hx; exact hx.1
    have ht:x∉xs.map Prod.fst:=by simp only [List.map_cons,List.mem_cons,not_or] at hx; exact hx.2
    rw [applyValues_cons,ih _ ht,vars_setVar,if_neg hp]
@[simp] theorem applyValues_arrs (xs : List (String × Expr)) (v : Expr→ℕ) (σ : Env) :
    (applyValues xs v σ).arrs=σ.arrs := by
  induction xs generalizing σ with
  | nil => rfl
  | cons p xs ih => rw [applyValues_cons,ih,arrs_setVar]
@[simp] theorem applyValues_inp (xs : List (String × Expr)) (v : Expr→ℕ) (σ : Env) :
    (applyValues xs v σ).inp=σ.inp := by
  induction xs generalizing σ with
  | nil => rfl
  | cons p xs ih => rw [applyValues_cons,ih,inp_setVar]
@[simp] theorem applyValues_out (xs : List (String × Expr)) (v : Expr→ℕ) (σ : Env) :
    (applyValues xs v σ).out=σ.out := by
  induction xs generalizing σ with
  | nil => rfl
  | cons p xs ih => rw [applyValues_cons,ih,out_setVar]
end Mathproof.Problem18IMPAssignments20261002
end
