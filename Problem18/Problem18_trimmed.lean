  have hsecond : ((iterCopied r modArray σ).arrs arr).getD j 0=
      ((iterCopyStart r modArray σ).arrs arr).getD j 0 := by
    apply pointState_read_preserved (commitNames r) (iterCopyStart r modArray σ)
    · rw [hlen]; exact hj
    · change arr≠r.scratch ∨ j<(iterCopyStart r modArray σ).vars r.k ∨
        (iterCopyStart r modArray σ).vars r.k+σ.vars r.e ≤ j
      rcases hsep with h | h
      · exact Or.inl h
      · right; right
        simp only [iterCopyStart,vars_setVar,if_pos rfl,ite_true]
        omega
  exact hsecond.trans hfirst
theorem iterEnd_vars (r : FieldNames) (modArray : String) (σ : Env) (x : String)
    (hxi : x≠r.i) (hxv : x≠r.value) (hxk : x≠r.k) (hxj : x≠r.j) :
    (iterEnd r modArray σ).vars x=σ.vars x := by
  simpa [iterEnd,hxi] using iterCopied_vars r modArray σ x hxv hxk hxj
theorem iterEnd_counter (r : FieldNames) (modArray : String) (σ : Env) :
    (iterEnd r modArray σ).vars r.i=σ.vars r.i+1 := by simp [iterEnd]
theorem iterEnd_first {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulLayout r modArray B σ) {j : Nat} (hj : j<σ.vars r.e) :
    ((iterEnd r modArray σ).arrs r.scratch).getD j 0=
      stepValues r modArray (iterStart r σ) j := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hev:r.e≠r.value:=by tauto
  have hek:r.e≠r.k:=by tauto
  have hej:r.e≠r.j:=by tauto
  have heq:=iterCopyStart_vars r modArray σ r.e hev hek hej
  have hk:(iterCopyStart r modArray σ).vars r.k=0:=by simp [iterCopyStart]
  have hlen:=iterCopyStart_length r modArray σ
  have hr:=writeValues_inside ((iterCopyStart r modArray σ).arrs r.scratch) 0
    (σ.vars r.e) j (resultValues (iterCopyStart r modArray σ) (commitNames r) .copy)
    (by rw [hlen]; have hs:=h.scratch_fit; omega) hj
  have hout : ((iterEnd r modArray σ).arrs r.scratch).getD j 0=
      resultValues (iterCopyStart r modArray σ) (commitNames r) .copy j := by
    simpa [iterEnd,iterCopied,pointState,commitNames,workNames,hk] using hr
  rw [hout]
  change ((iterCopyStart r modArray σ).arrs r.scratch).getD
    ((iterCopyStart r modArray σ).vars r.e+j) 0=_
  rw [heq]
  exact iterNext_second r modArray σ h.scratch_fit hj
theorem stepValues_iterStart {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulLayout r modArray B σ) :
    stepValues r modArray (iterStart r σ)=stepValues r modArray σ := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  funext j
  simp_all [stepValues,hornerStep,sourceCoeff,iterStart,iterLead]
theorem iterEnd_layout {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulLayout r modArray B σ) : MulLayout r modArray B (iterEnd r modArray σ) := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hv (x : String) (hx : x∈[r.p,r.e,r.aBase,r.bBase,r.modBase]) :
      (iterEnd r modArray σ).vars x=σ.vars x := by
    apply iterEnd_vars
    all_goals simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hx
    all_goals rcases hx with rfl|rfl|rfl|rfl|rfl <;> tauto
  have hpq:=hv r.p (by simp)
  have heq:=hv r.e (by simp)
  have haq:=hv r.aBase (by simp)
  have hbq:=hv r.bBase (by simp)
  have hmq:=hv r.modBase (by simp)
  have hget (arr base : String) (hx : base∈[r.p,r.e,r.aBase,r.bBase,r.modBase])
      (hfit : σ.vars base+σ.vars r.e ≤ (σ.arrs arr).length)
      (hsep : arr≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars base) (j : Nat) (hj : j<σ.vars r.e) :
      sourceCoeff (iterEnd r modArray σ) arr base j=sourceCoeff σ arr base j := by
    unfold sourceCoeff
    rw [hv base hx]
    apply iterEnd_read_preserved
    · omega
    · rcases hsep with h | h
      · exact Or.inl h
      · exact Or.inr (by omega)
  constructor
  · exact h.scalar_names
  · rw [heq]; exact h.degree_pos
  · rw [hpq]; exact h.arithmetic_word
  · rw [iterEnd_lengths]; exact h.memory_word
  · rw [iterEnd_lengths]; exact h.modulus_word
  · rw [iterEnd_lengths]; exact h.scratch_word
  · rw [heq,iterEnd_lengths]; exact h.scratch_fit
  · rw [haq,heq,iterEnd_lengths]; exact h.first_fit
  · rw [hbq,heq,iterEnd_lengths]; exact h.second_fit
  · rw [hmq,heq,iterEnd_lengths]; exact h.modulus_fit
  · rw [haq,heq]; exact h.first_separate
  · rw [hbq,heq]; exact h.second_separate
  · rw [hmq,heq]; exact h.modulus_separate
  · intro j hj
    rw [heq] at hj
    rw [hpq,hget r.mem r.aBase (by simp) h.first_fit h.first_separate j hj,
      hget r.mem r.bBase (by simp) h.second_fit h.second_separate j hj,
      hget modArray r.modBase (by simp) h.modulus_fit h.modulus_separate j hj,
      iterEnd_first h hj,stepValues_iterStart h]
    refine ⟨(h.coefficients j hj).1,(h.coefficients j hj).2.1,(h.coefficients j hj).2.2.1,?_⟩
    have hp:0<σ.vars r.p:=by have hh:=(h.coefficients 0 h.degree_pos).1; omega
    exact Nat.mod_lt _ hp
