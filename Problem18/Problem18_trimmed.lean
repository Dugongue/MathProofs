namespace Mathproof.Problem18PairLargeWords20261004
open Lax13Proofs.Imp Lax13Proofs.Reasoning
def wcIdx : String := "P18.pair.wc.idx"
def wcSrc : String := "P18.pair.wc.src"
def wcDst : String := "P18.pair.wc.dst"
def wcCnt : String := "P18.pair.wc.cnt"
theorem getD_set (l : List Nat) (k v j : Nat) :
    (l.set k v).getD j 0 = if k = j ∧ k < l.length then v else l.getD j 0 := by
  simp only [List.getD_eq_getElem?_getD, List.getElem?_set]
  by_cases h1 : k = j
  · subst h1
    by_cases h2 : k < l.length
    · simp [h2]
    · have : l[k]? = none := List.getElem?_eq_none (by omega)
      simp [h2, this]
  · simp [h1]
def copyBody (src dst : String) : Com :=
  .seq (.store dst (.add (.var wcDst) (.var wcIdx))
      (.get src (.add (.var wcSrc) (.var wcIdx))))
    (.assign wcIdx (.add (.var wcIdx) (.lit 1)))
def wordCopy (src dst : String) : Com :=
  .seq (.assign wcIdx (.lit 0))
    (.while (.lt (.var wcIdx) (.var wcCnt)) (copyBody src dst))
def copiedD (σ : Env) (src dst : String) (s d i j : Nat) : Nat :=
  if d ≤ j ∧ j < d + i then (σ.arrs src).getD (s + (j - d)) 0 else (σ.arrs dst).getD j 0
structure CopyInv (B : Nat) (src dst : String) (σ : Env) (s d n : Nat) (ρ : Env) : Prop where
  idx_le : ρ.vars wcIdx ≤ n
  vars : ∀ x, x ≠ wcIdx → ρ.vars x = σ.vars x
  arrs : ∀ a, a ≠ dst → ρ.arrs a = σ.arrs a
  len : (ρ.arrs dst).length = (σ.arrs dst).length
  data : ∀ j, (ρ.arrs dst).getD j 0 = copiedD σ src dst s d (ρ.vars wcIdx) j
  inp : ρ.inp = σ.inp
  out : ρ.out = σ.out
theorem wordCopy_run {B : Nat} (src dst : String) (hsd : src ≠ dst) (σ : Env)
    {s d n : Nat} (hs : σ.vars wcSrc = s) (hd : σ.vars wcDst = d) (hn : σ.vars wcCnt = n)
    (hsl : s + n ≤ (σ.arrs src).length) (hdl : d + n ≤ (σ.arrs dst).length)
    (hsB : (σ.arrs src).length < B) (hdB : (σ.arrs dst).length < B)
    (hval : ∀ j < n, (σ.arrs src).getD (s + j) 0 < B) (hB2 : 1 < B) :
    ∃ τ, Run B (wordCopy src dst) σ τ (20 * n + 10) ∧
      (∀ x, x ≠ wcIdx → τ.vars x = σ.vars x) ∧
      τ.vars wcIdx = n ∧
      (∀ a, a ≠ dst → τ.arrs a = σ.arrs a) ∧
      (τ.arrs dst).length = (σ.arrs dst).length ∧
      (∀ j, (τ.arrs dst).getD j 0 = copiedD σ src dst s d n j) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hB : 1 < B := hB2
  let ρ0 := σ.setVar wcIdx 0
  have h0 : Run B (.assign wcIdx (.lit 0)) σ ρ0 2 := Run.assign (evalB_lit (by omega))
  have hnB : n < B := by omega
  have hsrc_ne : wcSrc ≠ wcIdx := by decide
  have hdst_ne : wcDst ≠ wcIdx := by decide
  have hcnt_ne : wcCnt ≠ wcIdx := by decide
  let I := CopyInv B src dst σ s d n
  have hI0 : I ρ0 := by
    refine ⟨by simp [ρ0], fun x hx => by simp [ρ0, Env.setVar, hx], fun a _ => rfl, rfl,
      ?_, rfl, rfl⟩
    intro j
    have h0v : ρ0.vars wcIdx = 0 := by simp [ρ0, Env.setVar]
    show (σ.arrs dst).getD j 0 = _
    simp only [copiedD, h0v]; rw [if_neg (by omega)]
  have hdef : ∀ ρ, I ρ → ∃ v, (Cond.lt (.var wcIdx) (.var wcCnt)).evalB B ρ = some v := by
    intro ρ hρ
    exact evalB_condLt_vars (by have := hρ.idx_le; omega)
      (by rw [hρ.vars wcCnt hcnt_ne, hn]; exact hnB)
  have hstep : ∀ ρ, I ρ → (Cond.lt (.var wcIdx) (.var wcCnt)).evalB B ρ = some true →
      ∃ ρ', Run B (copyBody src dst) ρ ρ' 12 ∧ I ρ' ∧
        n - ρ'.vars wcIdx < n - ρ.vars wcIdx := by
    intro ρ hρ hc
    have hcv := evalB_condLt (B := B)
      (evalB_var (σ := ρ) (x := wcIdx) (by have := hρ.idx_le; omega))
      (evalB_var (σ := ρ) (x := wcCnt) (by rw [hρ.vars wcCnt hcnt_ne, hn]; exact hnB))
    rw [hc, hρ.vars wcCnt hcnt_ne, hn] at hcv
    have hi : ρ.vars wcIdx < n := by simpa using hcv.symm
    obtain ⟨i, hi_def⟩ : ∃ i, i = ρ.vars wcIdx := ⟨_, rfl⟩
    rw [← hi_def] at hi
    have hsρ : ρ.vars wcSrc = s := (hρ.vars _ hsrc_ne).trans hs
    have hdρ : ρ.vars wcDst = d := (hρ.vars _ hdst_ne).trans hd
    have hsrcA : ρ.arrs src = σ.arrs src := hρ.arrs src hsd
    have eS : (Expr.add (.var wcSrc) (.var wcIdx)).evalB B ρ = some (s + i) := by
      have := evalB_bin (op := Bop.add) (evalB_var (σ := ρ) (x := wcSrc) (B := B)
        (by rw [hsρ]; omega)) (evalB_var (σ := ρ) (x := wcIdx) (B := B) (by omega))
        (by show ρ.vars wcSrc + ρ.vars wcIdx < B; rw [hsρ]; omega)
      simpa [hsρ, ← hi_def] using this
    have eD : (Expr.add (.var wcDst) (.var wcIdx)).evalB B ρ = some (d + i) := by
      have := evalB_bin (op := Bop.add) (evalB_var (σ := ρ) (x := wcDst) (B := B)
        (by rw [hdρ]; omega)) (evalB_var (σ := ρ) (x := wcIdx) (B := B) (by omega))
        (by show ρ.vars wcDst + ρ.vars wcIdx < B; rw [hdρ]; omega)
      simpa [hdρ, ← hi_def] using this
    have hsi : s + i < (ρ.arrs src).length := by rw [hsrcA]; omega
    have hget : (ρ.arrs src)[s + i]? = some ((σ.arrs src).getD (s + i) 0) := by
      rw [hsrcA, List.getD_eq_getElem?_getD]
      rw [List.getElem?_eq_getElem (by rw [← hsrcA]; exact hsi)]
      rfl
    have eG : (Expr.get src (.add (.var wcSrc) (.var wcIdx))).evalB B ρ =
        some ((σ.arrs src).getD (s + i) 0) := evalB_get eS hget (hval i hi)
    have hdi : d + i < (ρ.arrs dst).length := by rw [hρ.len]; omega
    let ρ1 := ρ.setArr dst (d + i) ((σ.arrs src).getD (s + i) 0)
    have h1 := Run.store (a := dst) eD eG hdi
    have eI : (Expr.add (.var wcIdx) (.lit 1)).evalB B ρ1 = some (i + 1) := by
      have := evalB_bin (op := Bop.add) (evalB_var (σ := ρ1) (x := wcIdx) (B := B)
        (by simp [ρ1, Env.setArr]; omega)) (evalB_lit (σ := ρ1) (B := B) (n := 1) (by omega))
        (by show ρ1.vars wcIdx + 1 < B; simp [ρ1, Env.setArr]; omega)
      simpa [ρ1, Env.setArr, ← hi_def] using this
    have h2 := Run.assign (x := wcIdx) eI
    refine ⟨ρ1.setVar wcIdx (i + 1), (h1.seq h2).mono (by simp [Expr.size]), ?_, ?_⟩
    · refine ⟨by simp [Env.setVar]; omega, ?_, ?_, ?_, ?_, ?_, ?_⟩
      · intro x hx
        simp only [Env.setVar, if_neg hx, ρ1, Env.setArr]
        exact hρ.vars x hx
      · intro a ha
        simp only [Env.setVar, ρ1, Env.setArr, if_neg ha]
        exact hρ.arrs a ha
      · simp [Env.setVar, ρ1, Env.setArr]
        exact hρ.len
      · intro j
        have hA : (ρ1.setVar wcIdx (i + 1)).arrs dst = (ρ.arrs dst).set (d + i) ((σ.arrs src).getD (s + i) 0) := by
          simp [Env.setVar, ρ1, Env.setArr]
        rw [hA, getD_set, hρ.data j]
        rw [show (ρ1.setVar wcIdx (i + 1)).vars wcIdx = i + 1 by simp [Env.setVar], ← hi_def]
        unfold copiedD
        by_cases hj : j = d + i
        · subst hj
          simp only [true_and, hdi, and_true, if_true]
          rw [if_pos (by omega)]
          congr 1; omega
        · have hne : ¬(d + i = j ∧ d + i < (ρ.arrs dst).length) := fun h => hj h.1.symm
          rw [if_neg hne]
          by_cases hr : d ≤ j ∧ j < d + i
          · rw [if_pos hr, if_pos (by omega)]
          · rw [if_neg hr, if_neg (by omega)]
      · simp [Env.setVar, ρ1, Env.setArr, hρ.inp]
      · simp [Env.setVar, ρ1, Env.setArr, hρ.out]
    · simp [Env.setVar]; omega
  obtain ⟨τ, hr, hτ, hf⟩ := Run.while_count I (fun ρ => n - ρ.vars wcIdx) 12 hdef hstep hI0
  have hcv := evalB_condLt (B := B)
    (evalB_var (σ := τ) (x := wcIdx) (by have := hτ.idx_le; omega))
    (evalB_var (σ := τ) (x := wcCnt) (by rw [hτ.vars wcCnt hcnt_ne, hn]; exact hnB))
  rw [hf, hτ.vars wcCnt hcnt_ne, hn] at hcv
  have hge : ¬ τ.vars wcIdx < n := by simpa using hcv.symm
  have hidx : τ.vars wcIdx = n := by have := hτ.idx_le; omega
  refine ⟨τ, (h0.seq hr).mono ?_, hτ.vars, hidx, hτ.arrs, hτ.len, ?_, hτ.inp, hτ.out⟩
  · simp [ρ0, Env.setVar, Cond.size, Expr.size]; nlinarith
  · intro j; rw [hτ.data j, hidx]
def zeroBody (dst : String) : Com :=
  .seq (.store dst (.add (.var wcDst) (.var wcIdx)) (.lit 0))
    (.assign wcIdx (.add (.var wcIdx) (.lit 1)))
def zeroFill (dst : String) : Com :=
  .seq (.assign wcIdx (.lit 0))
    (.while (.lt (.var wcIdx) (.var wcCnt)) (zeroBody dst))
def zeroedD (σ : Env) (dst : String) (d i j : Nat) : Nat :=
  if d ≤ j ∧ j < d + i then 0 else (σ.arrs dst).getD j 0
