    (a : Fin n → K) (b : Fin c → K) (ha : ∀ i,a i≠0) (hb : ∀ i,b i≠0) :
    |(order a:ℝ)/((order b:ℝ)*(Nat.card K:ℝ)^(n.choose 2-c.choose 2))-1| ≤
      8*((Nat.card K:ℝ)^(c/4))⁻¹ := by
  classical
