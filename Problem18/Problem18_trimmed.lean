variable {K : Type*} [Field K] [BEq K] [LawfulBEq K] [DecidableEq K]
def frobeniusGcd (f : CPolynomial K) (q d : ℕ) : CPolynomial K :=
  (CPolynomial.xgcd f ((modularPower f CPolynomial.X (q^d)).1-CPolynomial.X)).1
theorem frobeniusGcd_dvd_iff (f : CPolynomial K) (q d : ℕ) (p : K[X]) :
    p ∣ (frobeniusGcd f q d).toPoly ↔ p ∣ f.toPoly ∧ p ∣ X^(q^d)-X := by
  unfold frobeniusGcd
  rw [CPolynomial.xgcd_toPoly_eq_gcd]
  have hg (a b : K[X]) : p ∣ EuclideanDomain.gcd a b ↔ p ∣ a ∧ p ∣ b :=
    ⟨fun h => ⟨h.trans (EuclideanDomain.gcd_dvd_left _ _),h.trans (EuclideanDomain.gcd_dvd_right _ _)⟩,
      fun h => EuclideanDomain.dvd_gcd h.1 h.2⟩
  rw [hg]
  rw [CPolynomial.toPoly_sub,CPolynomial.X_toPoly,modularPower_toPoly,CPolynomial.X_toPoly]
  let r := (Mathproof.Problem18UnivariateSolver20260930.modularPower f.toPoly X (q^d)).1
  have hm : f.toPoly ∣ r-X^(q^d) :=
    Mathproof.Problem18UnivariateSolver20260930.modularPower_dvd_difference f.toPoly X (q^d)
  constructor
  · rintro ⟨hf,hp⟩
    refine ⟨hf,?_⟩
    have hh := dvd_sub hp (hf.trans hm)
    convert hh using 1 <;> ring
  · rintro ⟨hf,hp⟩
    refine ⟨hf,?_⟩
    have hh := dvd_add (hf.trans hm) hp
    convert hh using 1 <;> ring
