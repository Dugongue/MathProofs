open Mathproof.Problem18SquarefreeDensityBoundary20260930
variable {K : Type*} [Field K] [Finite K]
attribute [local instance] Classical.propDecidable
noncomputable def weight {n : ℕ} (f : MonicDegree (K := K) n) : ℝ := by
  classical
  exact ∑ d : Fin (n+1), ∑ g : IrreducibleDegree (K := K) d,
    if g.1.1 ∣ f.1 then ((Nat.card K : ℝ)⁻¹)^d.val else 0
noncomputable def mass (d : ℕ) : ℝ :=
  (Nat.card (IrreducibleDegree (K := K) d) : ℝ) /
    ((Nat.card K : ℝ)^d * (Nat.card K : ℝ)^d)
theorem weight_nonneg {n : ℕ} (f : MonicDegree (K := K) n) : 0 ≤ weight f := by
  classical
  unfold weight
  positivity
theorem irreducible_card_zero : Nat.card (IrreducibleDegree (K := K) 0)=0 := by
  apply Nat.card_eq_zero.mpr
  left
  refine ⟨fun g => ?_⟩
  have h := g.2.natDegree_pos
  rw [g.1.2.2] at h
  omega
theorem divisor_weight_sum {n d : ℕ} (hd : d ≤ n)
    (g : IrreducibleDegree (K := K) d) :
    (∑ f : MonicDegree (K := K) n,
      if g.1.1 ∣ f.1 then ((Nat.card K : ℝ)⁻¹)^d else 0) /
      (Nat.card K : ℝ)^n = 1 / ((Nat.card K : ℝ)^d*(Nat.card K : ℝ)^d) := by
  classical
  have hq : (0 : ℝ) < Nat.card K := lt_of_lt_of_le (by norm_num) (field_card_real_two (K := K))
  have hc := card_monic_divisible (n := n) g.1.1 g.1.2.1 (by simpa only [g.1.2.2] using hd)
  rw [g.1.2.2] at hc
  have he : (∑ f : MonicDegree (K := K) n,
      if g.1.1 ∣ f.1 then ((Nat.card K : ℝ)⁻¹)^d else 0) =
      (Nat.card {f : MonicDegree (K := K) n // g.1.1 ∣ f.1} : ℝ)*((Nat.card K : ℝ)⁻¹)^d := by
    simp [Nat.card_eq_fintype_card,Fintype.card_subtype,← Finset.sum_filter]
  rw [he,hc,Nat.cast_pow]
  have hp : (Nat.card K : ℝ)^(n-d)*(Nat.card K : ℝ)^d=(Nat.card K : ℝ)^n := by
    rw [← pow_add,Nat.sub_add_cancel hd]
  rw [← hp,inv_pow]
  field_simp [ne_of_gt hq]
theorem weight_expectation_eq (n : ℕ) :
    (∑ f : MonicDegree (K := K) n, weight f)/(Nat.card K : ℝ)^n =
      ∑ d : Fin (n+1), mass (K := K) d := by
  classical
  unfold weight
  rw [Finset.sum_comm,Finset.sum_div]
  apply Finset.sum_congr rfl
  intro d hd
  rw [Finset.sum_comm,Finset.sum_div]
  simp_rw [divisor_weight_sum (by omega : d.val ≤ n)]
  simp [mass,Nat.card_eq_fintype_card,div_eq_mul_inv]
theorem mass_le (d : ℕ) (hd : 0 < d) :
    mass (K := K) d ≤ ((Nat.card K : ℝ)⁻¹)^d/d := by
  have hq : (0 : ℝ) < Nat.card K := lt_of_lt_of_le (by norm_num) (field_card_real_two (K := K))
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd
  have hc : (Nat.card (IrreducibleDegree (K := K) d) : ℝ)*d ≤ (Nat.card K : ℝ)^d := by
    exact_mod_cast irreducible_card_mul_degree_le (K := K) d hd
  unfold mass
  rw [inv_pow,inv_eq_one_div,div_div]
  apply (div_le_div_iff₀ (mul_pos (pow_pos hq _) (pow_pos hq _))
    (mul_pos (pow_pos hq _) hdR)).mpr
  have hh := mul_le_mul_of_nonneg_left hc (le_of_lt (pow_pos hq d))
  nlinarith
theorem mass_zero : mass (K := K) 0=0 := by
  unfold mass
  rw [irreducible_card_zero,Nat.cast_zero,zero_div]
theorem mass_one_le : mass (K := K) 1 ≤ 1/2 := by
  have hq2 := field_card_real_two (K := K)
  have hq : (0 : ℝ) < Nat.card K := by linarith
  simp only [mass,irreducible_card_one,pow_one]
  apply (div_le_iff₀ (mul_pos hq hq)).mpr
  nlinarith
theorem mass_tail_le (d : ℕ) (hd : 2 ≤ d) : mass (K := K) d ≤ (1/2 : ℝ)^d/2 := by
  have hq2 := field_card_real_two (K := K)
  have hqi : (Nat.card K : ℝ)⁻¹ ≤ 1/2 := by
    rw [inv_eq_one_div]
    apply (div_le_iff₀ (by linarith : (0 : ℝ) < Nat.card K)).mpr
    linarith
  have hdR : (2 : ℝ) ≤ d := by exact_mod_cast hd
  refine (mass_le d (by omega)).trans ?_
  calc
    ((Nat.card K : ℝ)⁻¹)^d/d ≤ ((Nat.card K : ℝ)⁻¹)^d/2 :=
      div_le_div_of_nonneg_left (by positivity) (by norm_num) hdR
    _ ≤ (1/2 : ℝ)^d/2 := by gcongr
theorem geometric_weight_tail_le (m : ℕ) :
    (∑ i ∈ Finset.range m, (1/2 : ℝ)^(2+i)/2) ≤ 1/4 := by
  have hg := geom_sum_mul_neg (1/2 : ℝ) m
  have hp := pow_nonneg (by norm_num : (0 : ℝ) ≤ 1/2) m
  have hsum : (∑ i ∈ Finset.range m, (1/2 : ℝ)^(2+i)/2) =
      (1/8 : ℝ)*∑ i ∈ Finset.range m, (1/2 : ℝ)^i := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [pow_add]
    ring
  rw [hsum]
  linarith
theorem weight_expectation_le (n : ℕ) (hn : 1 ≤ n) :
    (∑ f : MonicDegree (K := K) n, weight f)/(Nat.card K : ℝ)^n ≤ 3/4 := by
  rw [weight_expectation_eq,Fin.sum_univ_eq_sum_range]
  rw [show n+1=2+(n-1) by omega,Finset.sum_range_add]
  have hprefix : (∑ d ∈ Finset.range 2, mass (K := K) d) ≤ 1/2 := by
    simpa [Finset.sum_range_succ,mass_zero] using mass_one_le (K := K)
  have htail : (∑ d ∈ Finset.range (n-1), mass (K := K) (2+d)) ≤ 1/4 := by
    apply le_trans _ (geometric_weight_tail_le (n-1))
    apply Finset.sum_le_sum
    intro d hd
    exact mass_tail_le (2+d) (by omega)
  linarith
theorem heavy_weight_density_le (n : ℕ) (hn : 1 ≤ n) :
    (Nat.card {f : MonicDegree (K := K) n // 36 < weight f} : ℝ) /
      (Nat.card K : ℝ)^n ≤ 1/48 := by
  classical
  have hq : (0 : ℝ) < Nat.card K := lt_of_lt_of_le (by norm_num) (field_card_real_two (K := K))
  have hsum : (36 : ℝ)*Nat.card {f : MonicDegree (K := K) n // 36 < weight f} ≤
      ∑ f : MonicDegree (K := K) n, weight f := by
    rw [Nat.card_eq_fintype_card,Fintype.card_subtype,mul_comm]
    calc
      _ = ∑ f ∈ Finset.univ.filter (fun f : MonicDegree (K := K) n => 36 < weight f), (36 : ℝ) := by simp
      _ ≤ ∑ f ∈ Finset.univ.filter (fun f : MonicDegree (K := K) n => 36 < weight f), weight f := by
        apply Finset.sum_le_sum
        intro f hf
        exact le_of_lt (Finset.mem_filter.mp hf).2
      _ ≤ ∑ f : MonicDegree (K := K) n, weight f :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _) (by intros; exact weight_nonneg _)
  have hh := div_le_div_of_nonneg_right hsum (le_of_lt (pow_pos hq n))
  rw [mul_div_assoc] at hh
  linarith [weight_expectation_le (K := K) n hn]
theorem bounded_weight_good_density_ge (n : ℕ) (hn : 2 ≤ n) :
    (1/48 : ℝ) ≤
      (Nat.card {f : MonicDegree (K := K) n // Good f ∧ weight f ≤ 36} : ℝ) /
        (Nat.card K : ℝ)^n := by
  classical
  have hc : Nat.card {f : MonicDegree (K := K) n // Good f} ≤
      Nat.card {f : MonicDegree (K := K) n // Good f ∧ weight f ≤ 36} +
      Nat.card {f : MonicDegree (K := K) n // 36 < weight f} := by
    simp only [Nat.card_eq_fintype_card,Fintype.card_subtype]
    apply le_trans _ (Finset.card_union_le _ _)
    apply Finset.card_le_card
    intro f hf
    have hg := (Finset.mem_filter.mp hf).2
    by_cases hw : weight f ≤ 36
    · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨Finset.mem_univ _,hg,hw⟩)
    · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨Finset.mem_univ _,lt_of_not_ge hw⟩)
  have hcR : (Nat.card {f : MonicDegree (K := K) n // Good f} : ℝ) ≤
      (Nat.card {f : MonicDegree (K := K) n // Good f ∧ weight f ≤ 36} : ℝ) +
      (Nat.card {f : MonicDegree (K := K) n // 36 < weight f} : ℝ) := by exact_mod_cast hc
  have hq : (0 : ℝ) < Nat.card K := lt_of_lt_of_le (by norm_num) (field_card_real_two (K := K))
  have hh := div_le_div_of_nonneg_right hcR (le_of_lt (pow_pos hq n))
  rw [add_div] at hh
  linarith [squarefree_nonzero_density_ge (K := K) n hn,heavy_weight_density_le (K := K) n (by omega)]
end Mathproof.Problem18PolynomialWeightBoundary20260930
