      simp only [monoStepsCost, stepCost, Expr.size]
      omega
    · rw [List.length_cons, flip_succ, hval₃, hval₂, hval₁, hacc₁, List.map_cons, List.prod_cons]
      rw [List.map_congr_left (fun j _ => by rw [hx₂ j])]
      ring
    · intro s hs h0 h1 ht
      rw [hoth₃ s hs h0 h1 ht, val_of_slice_eq (hres₂.others s hs (ne_a0_a1_of_acc h0 h1 (!b))),
        hoth₁ s hs ht]
