    hS hn hp hg hd hfit hps hgs hds hpf hgf hdf hP hQ hPd (Or.inr hQd)
  have hgsξ : ξ.vars gReg=gs := (hv gReg (by decide) (by decide) (by decide) (by decide)).trans hg
  have hdsξ : ξ.vars outReg=ds := (hv outReg (by decide) (by decide) (by decide) (by decide)).trans hd
