    explicitCandidate A B=boundaryCandidate A B := by
  rw [explicitCandidate,candidate_correct,matrix_arrayOf,matrix_arrayOf]
  rfl
def queryCheck (A B : Matrix (Fin c) (Fin b) K) : Bool :=
  let Q := explicitCandidate A B
  orthogonalSourceCheck B && decide (Q.transpose*Q=1) &&
    markerCheck (A*Q) B (fun _ => 1) &&
    decide (Q.transpose*(A.transpose*A)*Q=B.transpose*B)
theorem queryCheck_correct [CharP K 2] (A B : Matrix (Fin c) (Fin b) K)
    (hA : orthogonalSourceCheck A=true) :
    queryCheck A B=true ↔ MatrixOrthogonalEquivalent A B := by
  have hAg := (orthogonalSourceCheck_correct A).mp hA
  have hmark : standardMarker (K:=K) c=(fun _ => 1) :=
    Mathproof.Problem18CharTwoOrthogonalColumn20260930.standardMarker_eq_one c
  constructor
  · intro h
    simp only [queryCheck,Bool.and_eq_true,decide_eq_true_eq] at h
    obtain ⟨⟨⟨hB,hQ⟩,hM⟩,hG⟩ := h
    have hBg := (orthogonalSourceCheck_correct B).mp hB
    have hC : ((A*explicitCandidate A B).transpose*(A*explicitCandidate A B)).det≠0 := by
      have he : (A*explicitCandidate A B).transpose*(A*explicitCandidate A B)=B.transpose*B := by
        simpa only [Matrix.transpose_mul,Matrix.mul_assoc] using hG
      rw [he]
      exact hBg.1
    have hm := (markerCheck_correct _ _ hC hBg.1 _).mp hM
    apply (orthogonal_boundary_recovery A B).mpr
    exact ⟨explicitCandidate A B,hQ,by simpa only [hmark] using hm,hG⟩
  · intro h
    have hBg := (orthogonal_good_invariant A B h).mp hAg
    obtain ⟨_,hQ,hM,hG⟩ := (charTwo_boundary_iff_candidate_checks A B hAg).mp h
    have hC : ((A*explicitCandidate A B).transpose*(A*explicitCandidate A B)).det≠0 := by
      rw [explicitCandidate_correct]
      have he : (A*boundaryCandidate A B).transpose*(A*boundaryCandidate A B)=B.transpose*B := by
        simpa only [Matrix.transpose_mul,Matrix.mul_assoc] using hG
      rw [he]
      exact hBg.1
    have hm : markerCheck (A*explicitCandidate A B) B (fun _ => 1)=true :=
      (markerCheck_correct _ _ hC hBg.1 _).mpr (by
        simpa only [explicitCandidate_correct,hmark] using hM)
    simp only [queryCheck,Bool.and_eq_true,decide_eq_true_eq]
    exact ⟨⟨⟨(orthogonalSourceCheck_correct B).mpr hBg,
      by simpa only [explicitCandidate_correct,Problem18OrthogonalAssembly.IsOrthogonal] using hQ⟩,hm⟩,
      by simpa only [explicitCandidate_correct] using hG⟩
