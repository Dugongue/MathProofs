      apply Subtype.ext
      exact congrFun hh i
    apply Sigma.ext hc
    exact (Subtype.heq_iff_coe_eq (by intro e; simp only [hc])).mpr rfl
noncomputable def traceIsometriesEquiv (c : Coefficients g) (e : TraceIsometries g B c) :
    TraceIsometries g B c ≃ isometrySubgroup (fun x y => B x y) where
