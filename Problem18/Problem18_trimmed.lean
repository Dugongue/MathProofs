  refine ⟨τw, ?_, hSw, fun u hu j hj => hrows u hu j hj, hfr, hregs, harr, hinp, hout⟩
  refine ((Run.assign (x := mn.t) (evalB_lit (σ := σ) (B := B) (by omega : 0 < B))).seq
    hrw).mono ?_
  have h0 : (σ.setVar mn.t 0).vars mn.t = 0 := by simp
  have e1 : (Expr.lit 0).size = 1 := rfl
  have e2 : (Cond.lt (Expr.var mn.t) (Expr.var mn.R)).size = 3 := rfl
  rw [h0, Nat.sub_zero, e1, e2, show (1 : ℕ) + 3 = 4 from rfl]
  unfold rgCost
  omega
def targetTbl (n t Bd : ℕ) : List (Option ℕ) :=
  (boundedExponents n Bd).map fun b =>
    if (boundedExponents n t).idxOf b < (boundedExponents n t).length then
      some ((boundedExponents n t).idxOf b) else none
theorem targetTbl_length (n t Bd : ℕ) : (targetTbl n t Bd).length = (boundedExponents n Bd).length := by
  simp [targetTbl]
theorem targetTbl_some_lt {n t Bd k : ℕ} (h : some k ∈ targetTbl n t Bd) :
    k < (boundedExponents n t).length := by
  simp only [targetTbl, List.mem_map] at h
  obtain ⟨b, _, hb⟩ := h
  split_ifs at hb with h1
  · cases hb; exact h1
theorem targetRow_gval {n t Bd : ℕ} (v : DenseInput n t K) (g : ℕ → K) (sv : ℕ)
    (hg : ∀ k (hk : k < (boundedExponents n t).length), g (sv + k) = read v ⟨k, hk⟩)
    (i : Fin (boundedExponents n Bd).length) :
    read (targetRow t Bd v) i =
      gval g sv ((targetTbl n t Bd)[i.val]'(by rw [targetTbl_length]; exact i.isLt)) := by
  simp only [targetRow, read_ofFn, targetTbl, List.getElem_map]
  split_ifs with h
  · simp only [gval, inputCoefficient, dif_pos h]
    rw [hg _ h]; rfl
  · simp only [gval, inputCoefficient, dif_neg h]
theorem target_run (M : FieldMacros F r) (q : RNames) (mn : MNames) (hmn : mn.Valid r q)
    (n t Bd : ℕ) (vs : List (DenseInput n t K)) {B Sn iv ov : ℕ} {σ : Env}
    (hS : Slots F r q.WS Sn B σ) (hz : val F r q.WS σ 0 = 0)
    (hR : σ.vars mn.R = vs.length) (hi : σ.vars mn.inB = iv) (ho : σ.vars mn.oB = ov)
    (hov : 1 ≤ ov) (hlay : ov + vs.length * (boundedExponents n Bd).length ≤ iv)
    (hfit : iv + vs.length * (boundedExponents n t).length ≤ Sn)
    (hRB : vs.length < B) (hLsB : (boundedExponents n t).length < B)
    (hLoB : (boundedExponents n Bd).length < B)
    (hin : ∀ u (hu : u < vs.length) k (hk : k < (boundedExponents n t).length),
      val F r q.WS σ (iv + u * (boundedExponents n t).length + k) = read vs[u] ⟨k, hk⟩) :
    ∃ τ, Run B (rgLoop M q mn (boundedExponents n t).length (targetTbl n t Bd)) σ τ
        (rgCost M mn (boundedExponents n t).length (targetTbl n t Bd) vs.length) ∧
      Slots F r q.WS Sn B τ ∧
      (∀ u (hu : u < vs.length) (j : Fin (boundedExponents n Bd).length),
        val F r q.WS τ (ov + u * (boundedExponents n Bd).length + j.val) =
          read (targetRow t Bd vs[u]) j) ∧
      (∀ s < Sn, (s < ov ∨ ov + vs.length * (boundedExponents n Bd).length ≤ s) →
        val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ≠ mn.t → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hlen := targetTbl_length n t Bd
  have hL1 : 1 ≤ (targetTbl n t Bd).length := by
    rw [hlen, boundedExponents_length]; exact Nat.one_le_pow _ _ (by omega)
  obtain ⟨τ, hr, hSτ, hv, hfr, hreg, harr, hinp, hout⟩ :=
    rg_run M q mn hmn (boundedExponents n t).length (targetTbl n t Bd)
      (fun k hk => targetTbl_some_lt hk) hL1 hS hz hR hi ho hov (by rw [hlen]; exact hlay) hfit
      hRB hLsB (by rw [hlen]; exact hLoB)
  refine ⟨τ, hr, hSτ, ?_, ?_, hreg, harr, hinp, hout⟩
  · intro u hu j
    have h1 := hv u hu j.val (by rw [hlen]; exact j.isLt)
    have hidx : ov + u * (boundedExponents n Bd).length + j.val =
        ov + u * (targetTbl n t Bd).length + j.val := by rw [hlen]
    rw [hidx, h1, targetRow_gval vs[u] (val F r q.WS σ) (iv + u * (boundedExponents n t).length)
      (fun k hk => hin u hu k hk) j]
  · intro s hs h
    exact hfr s hs (by rw [hlen]; exact h)
end Mathproof.Problem18ClaudeIMPRowGather20261001
