  let r:=compileSystem (outerCoordinateIndex a b) s.1 4
  (r.1,p.2+s.2+r.2)
def unitaryEquationCount (a b c : Nat) := a*a+b*b+c*(a*b)+(a*b)*(a*b)+1
theorem groundEquationCount_bound (P : FieldPresentation K) (d : UnitaryFieldData (K:=K) q)
    (F G : RectTensor a b c K) :
    (groundEquations P d F G).length ≤ 2*unitaryEquationCount a b c := by
  have h:=equations_length d F G
  simp only [groundEquations,List.length_flatMap]
  simpa [unitaryEquationCount,Nat.mul_comm] using Nat.mul_le_mul_left 2 h
def unitaryBudget (a b c q : Nat) := unitaryPreprocessBudget a b c q+
  unitaryEquationCount a b c*(2*q.size+3+unitaryMass a b*(4*q.size+5))+
  2*unitaryEquationCount a b c*(5^(2*(a*a+b*b))*unitaryMass a b+testBudget (5^(2*(a*a+b*b))))
theorem unitary_cost (P : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) (F G : RectTensor a b c K) :
    (unitary P d F G).2 ≤ unitaryBudget a b c q := by
  have hp:=unitaryPrepared_cost q F G
  have hc:=compileList_cost P d (equations d F G) (unitaryMass a b) (equations_mass d F G)
  have he: (compileList P d (equations d F G)).1=groundEquations P d F G :=compileList_correct _ _ _
  have hlen:=equations_length d F G
  have hc':(compileList P d (equations d F G)).2 ≤
      unitaryEquationCount a b c*(2*q.size+3+unitaryMass a b*(4*q.size+5)) :=
    hc.trans (Nat.mul_le_mul_right _ hlen)
  have hh:=(compileSystem_correct (outerCoordinateIndex a b) (groundEquations P d F G) 4 (unitaryMass a b)
    (groundEquations_degree P d F G) (groundEquations_mass P d F G)).2.1
  have hg:=groundEquationCount_bound P d F G
  have hh':(compileSystem (outerCoordinateIndex a b) (groundEquations P d F G) 4).2 ≤
      2*unitaryEquationCount a b c*(5^(2*(a*a+b*b))*unitaryMass a b+testBudget (5^(2*(a*a+b*b)))) :=
    hh.trans (Nat.mul_le_mul_right _ hg)
  simpa only [unitary,unitaryPrepared_correct d,he,unitaryBudget] using
    Nat.add_le_add (Nat.add_le_add hp hc') hh'
theorem nat_expression_bound {σ : Type*} (p : PolyExpr σ Nat) (x : σ→Nat) (L : Nat)
    (hL : 1 ≤ L) (hx : ∀i,x i ≤ L) : p.eval x ≤ p.eval (fun _=>1)*L^p.degree := by
  induction p with
  | const c=>simp [PolyExpr.eval,PolyExpr.degree]
  | var i=>simpa [PolyExpr.eval,PolyExpr.degree] using hx i
  | add a b iha ihb=>
    have ha:=Nat.pow_le_pow_right hL (Nat.le_max_left a.degree b.degree)
    have hb:=Nat.pow_le_pow_right hL (Nat.le_max_right a.degree b.degree)
    have h1:=iha.trans (Nat.mul_le_mul_left _ ha)
    have h2:=ihb.trans (Nat.mul_le_mul_left _ hb)
    simpa only [PolyExpr.eval,PolyExpr.degree,add_mul] using Nat.add_le_add h1 h2
  | mul a b iha ihb=>
    have hh:=Nat.mul_le_mul iha ihb
    simpa only [PolyExpr.eval,PolyExpr.degree,pow_add,mul_mul_mul_comm] using hh
local infixl:65 " +ₚ " => PolyExpr.add
local infixl:70 " *ₚ " => PolyExpr.mul
local notation "Cₚ" => (PolyExpr.const (σ:=Fin 2) (K:=Nat))
open Problem18TensorSorting20261001
end Mathproof.Problem18BoundedMedianReduction20261001
