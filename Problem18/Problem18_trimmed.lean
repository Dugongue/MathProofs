def coefficientPolynomial {d:ℕ} (c:Fin d→K) : CPolynomial K :=
  (Problem18CountedPolynomialArithmetic20261001.tabulate d (fun j=>(c j,0))).1
theorem coefficientPolynomial_toPoly {d:ℕ} (c:Fin d→K) :
    (coefficientPolynomial c).toPoly=∑j:Fin d,C (c j)*X^j.val := by
  ext i
  rw [←CPolynomial.coeff_toPoly,coefficientPolynomial,
    Problem18CountedPolynomialArithmetic20261001.tabulate_coeff,finsetSum_coeff]
  simp only [coeff_C_mul_X_pow]
  by_cases hi:i < d
  · rw [dif_pos hi]
    symm
    rw [Finset.sum_eq_single (⟨i,hi⟩:Fin d)]
    · simp
    · intro j hj hji
      have hne:i≠j.val:=by intro he; apply hji; exact Fin.ext he.symm
      simp [hne]
    · simp
  · rw [dif_neg hi]
    symm
    apply Finset.sum_eq_zero
    intro j hj
    have hne:i≠j.val:=by intro he; subst i; exact hi j.isLt
    simp [hne]
def annihilator {n:ℕ} (A:Matrix (Fin n) (Fin n) K) (z:Fin n→K) : CPolynomial K×ℕ :=
  let d:=firstDegree A z
  let es:=family A z d.1.val
  let c:=coordinatesCounted (fun j:Fin d.1.val=>read es[j.val].1) (read es[d.1.val].1)
