theorem pb_add {X a b c₁ c₂ d₁ d₂ : Nat} (hX : 1 ≤ X) (ha : a ≤ c₁*X^d₁)
    (hb : b ≤ c₂*X^d₂) : a+b ≤ (c₁+c₂)*X^(max d₁ d₂) := by
  have h1 : X^d₁ ≤ X^(max d₁ d₂) := Nat.pow_le_pow_right hX (le_max_left _ _)
  have h2 : X^d₂ ≤ X^(max d₁ d₂) := Nat.pow_le_pow_right hX (le_max_right _ _)
  calc a+b ≤ c₁*X^d₁+c₂*X^d₂ := Nat.add_le_add ha hb
    _ ≤ c₁*X^(max d₁ d₂)+c₂*X^(max d₁ d₂) :=
        Nat.add_le_add (Nat.mul_le_mul_left _ h1) (Nat.mul_le_mul_left _ h2)
    _ = _ := by rw [Nat.add_mul]
theorem pb_mul {X a b c₁ c₂ d₁ d₂ : Nat} (ha : a ≤ c₁*X^d₁) (hb : b ≤ c₂*X^d₂) :
    a*b ≤ (c₁*c₂)*X^(d₁+d₂) := by
  calc a*b ≤ (c₁*X^d₁)*(c₂*X^d₂) := Nat.mul_le_mul ha hb
    _ = _ := by rw [Nat.pow_add]; ac_rfl
theorem pb_pow {X a c d : Nat} (k : Nat) (ha : a ≤ c*X^d) : a^k ≤ c^k*X^(d*k) := by
  calc a^k ≤ (c*X^d)^k := Nat.pow_le_pow_left ha k
