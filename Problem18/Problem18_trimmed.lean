variable {K : Type} [Field K] [Fintype K] {n b c : ℕ}
theorem krylov_det_ne_zero_iff (S : Module.End K (Fin n→K)) (v : Fin n→K) :
    (krylovMatrix S v).det≠0 ↔ PolynomiallyCyclic S v := by
  constructor
  · intro h
    have hm : Function.Injective (fun x => krylovMatrix S v*ᵥx) :=
      Matrix.mulVec_injective_iff_isUnit.mpr
        ((Matrix.isUnit_iff_isUnit_det _).mpr (isUnit_iff_ne_zero.mpr h))
    have hi : Function.Injective (cyclicEvalMap S v n) := by
      intro x y hxy
      apply (Polynomial.degreeLT.basis K n).repr.injective
      have he : krylovMatrix S v*ᵥ(Polynomial.degreeLT.basis K n).repr x=
          krylovMatrix S v*ᵥ(Polynomial.degreeLT.basis K n).repr y := by
        dsimp only [krylovMatrix]
        rw [LinearMap.toMatrix_mulVec_repr,LinearMap.toMatrix_mulVec_repr,hxy]
      have hh := hm he
      ext i
      exact congrFun hh i
    have hd : Module.finrank K (Polynomial.degreeLT K n)=Module.finrank K (Fin n→K) := by
      rw [Module.finrank_eq_card_basis (Polynomial.degreeLT.basis K n)]
      simp
    have hs := (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hd).mp hi
    apply (polynomiallyCyclic_iff_cyclicEvalMap_bijective S v).mpr
    have hdn : Module.finrank K (Fin n→K)=n := by simp
    rw [hdn]
    exact ⟨hi,hs⟩
  · intro hv
    exact isUnit_iff_ne_zero.mp (krylovMatrix_isUnit_det S v hv)
theorem odd_trial_correct (hodd : ringChar K≠2)
    (F G : Matrix (Fin c) (Fin b) K) (hG : OrthogonalGood G)
    (hχ : (G.transpose*G).charpoly=(F.transpose*F).charpoly)
    (v w : Fin b→K)
    (hv : (krylovMatrix (G.transpose*G).toLin' v).det≠0)
    (hw : (krylovMatrix (F.transpose*F).toLin' w).det≠0) :
    MatrixOrthogonalEquivalent F G ↔ KernelSquareTests (G.transpose*G).toLin'
      ((boundaryCandidate F G v w).transpose*boundaryCandidate F G v w).toLin' :=
  odd_boundary_iff_kernel_checks hodd F G hG hχ v w
    ((krylov_det_ne_zero_iff _ _).mp hv) ((krylov_det_ne_zero_iff _ _).mp hw)
theorem matrix_orthogonal_reverse (F G : Matrix (Fin c) (Fin b) K)
    (h : MatrixOrthogonalEquivalent F G) : MatrixOrthogonalEquivalent G F := by
  obtain ⟨R,Q,hR,hQ,he⟩ := h
  refine ⟨R.transpose,Q.transpose,orthogonal_transpose _ hR,orthogonal_transpose _ hQ,?_⟩
  rw [← he]
  calc
    _=(R.transpose*R)*F*(Q*Q.transpose) := by simp only [Matrix.mul_assoc]
    _=F := by rw [show R.transpose*R=1 from hR,show Q*Q.transpose=1 from mul_eq_one_comm.mp hQ]; simp
theorem matrix_orthogonal_symm (F G : Matrix (Fin c) (Fin b) K) :
    MatrixOrthogonalEquivalent F G ↔ MatrixOrthogonalEquivalent G F :=
  ⟨matrix_orthogonal_reverse F G,matrix_orthogonal_reverse G F⟩
theorem odd_source_trial_correct (hodd : ringChar K≠2)
    (A B : Matrix (Fin c) (Fin b) K) (hA : OrthogonalGood A)
    (hχ : (A.transpose*A).charpoly=(B.transpose*B).charpoly)
    (v w : Fin b→K)
    (hv : (krylovMatrix (A.transpose*A).toLin' v).det≠0)
    (hw : (krylovMatrix (B.transpose*B).toLin' w).det≠0) :
    MatrixOrthogonalEquivalent A B ↔ KernelSquareTests (A.transpose*A).toLin'
      ((boundaryCandidate B A v w).transpose*boundaryCandidate B A v w).toLin' :=
  (matrix_orthogonal_symm A B).trans (odd_trial_correct hodd B A hA hχ v w hv hw)
end Mathproof.Problem18BoundaryTrialChecks20260930
