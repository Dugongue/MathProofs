def padded (A : Matrix (Fin c) (Fin m) K) : Matrix (Fin m) (Fin m) K :=
  fun i=>read ((compress (rowFamily A)).1.getD i.val (Vector.ofFn fun _=>0))
theorem padded_constraints (A : Matrix (Fin c) (Fin m) K) (Z : Matrix (Fin m) (Fin k) K) :
    (∀i:Fin m,padded A i ᵥ* Z=0) ↔
      ∀v∈(compress (rowFamily A)).1,read v ᵥ* Z=0 := by
  constructor
  · intro h v hv
    obtain ⟨i,hi,he⟩:=List.getElem_of_mem hv
    have him : i < m :=hi.trans_le (compressed_length A)
    have hh:=h ⟨i,him⟩
    simpa [padded,List.getD,hi,he] using hh
  · intro h i
    by_cases hi : i.val<(compress (rowFamily A)).1.length
    · simpa [padded,List.getD,hi] using
        h ((compress (rowFamily A)).1[i.val]) (List.getElem_mem hi)
    · simp [padded,List.getD,hi]
      exact Matrix.zero_vecMul Z
theorem right_zero (A : Matrix (Fin c) (Fin m) K) (Z : Matrix (Fin m) (Fin k) K) :
    padded A*Z=0 ↔ A*Z=0 := by
  have h : padded A*Z=0 ↔ ∀i:Fin m,padded A i ᵥ*Z=0 := by
    constructor
    · intro h i
      funext j
      exact congrFun (congrFun h i) j
    · intro h
      ext i j
      exact congrFun (h i) j
  rw [h,padded_constraints,compressed_constraints_iff]
