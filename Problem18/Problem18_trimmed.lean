      (τ.vars zR = 0 ↔ Mathproof.Problem18PairBoundaryModeCharTwoMath20261004.Mem MX) ∧
      τ.arrs canonical.mem = ρ.arrs canonical.mem ∧
      (∀ a, a ≠ spanMem → a ≠ canonical.scratch → τ.arrs a = ρ.arrs a) ∧
      (∀ i (hi : i < F.e), (τ.arrs spanMem).getD i 0 = (F.modulus ⟨i, hi⟩).val) ∧
      (τ.arrs spanMem).length = (ρ.arrs spanMem).length ∧
      (τ.arrs canonical.scratch).length = (ρ.arrs canonical.scratch).length ∧
      (∀ x, x ∉ scalarWrites spanInner → τ.vars x = ρ.vars x) ∧
      τ.inp = ρ.inp ∧ τ.out = ρ.out := by
  let ν := renameEnv spanSwap ρ
  have hνmem : ν.arrs canonical.mem = ρ.arrs spanMem := by
    show ρ.arrs (spanSwap.symm canonical.mem) = _
    simp [spanSwap]
  have hνspan : ν.arrs spanMem = ρ.arrs canonical.mem := by
    show ρ.arrs (spanSwap.symm spanMem) = _
    simp [spanSwap]
  have hνscr : ν.arrs canonical.scratch = ρ.arrs canonical.scratch := by
    show ρ.arrs (spanSwap.symm canonical.scratch) = _
    simp [spanSwap, Equiv.swap_apply_of_ne_of_ne (show canonical.scratch ≠ canonical.mem by decide)
      (show canonical.scratch ≠ spanMem by decide)]
  have hb : Base F canonical B ν := by
    refine ⟨canonical_valid, hv.degree, hv.prime, hv.arithmetic_word, hv.inverse_word, ?_, ?_, ?_, ?_,
      ?_, hexp, by decide⟩
    · rw [hνmem]; exact hPB
    · rw [hνscr]; exact hv.scratch_word
    · rw [hνscr]; exact hscr
    · show ρ.vars canonical.modBase + F.e + 1 ≤ _
      rw [hνmem, hmod0]; omega
    · intro i
      show (ν.arrs canonical.mem).getD (ρ.vars canonical.modBase + i.val) 0 = _
      rw [hνmem, hmod0, Nat.zero_add]; exact hPmod i.val i.isLt
  have hMcan : ∀ k < F.e*(d+n*d), (ν.arrs spanMem).getD (sb+k) 0 < F.p := by
    intro k hk; rw [hνspan]
    exact hv.coefficients _ (lt_of_lt_of_le (Nat.add_lt_add_left hk sb) hMlen)
  have hone' : ∀ t < d, decode F (fun i => (ν.arrs spanMem).getD (sb + F.e*t + i.val) 0) = 1 := by
    intro t ht
    have := congrFun (congrFun hone ⟨0, by omega⟩) ⟨t, ht⟩
    unfold Problem18IMPMatrixMemory20261001.matrix slice Problem18IMPMatrixMemory20261001.address at this
    rw [hνspan]
    simpa using this
  have hxt' : ∀ u (hu : u < n) (t : Fin d),
      decode F (fun i => (ν.arrs spanMem).getD (sb + F.e*(d + u*d + t.val) + i.val) 0) =
        MX t ⟨u, hu⟩ := by
    intro u hu t
    have := congrFun (congrFun hxt ⟨u, hu⟩) t
    unfold Problem18IMPMatrixMemory20261001.matrix slice Problem18IMPMatrixMemory20261001.address at this
    rw [hνspan]
    simp only [Matrix.transpose_apply] at this
    rw [← this]
    congr 1; funext i; congr 1; unfold xtN; ring
  obtain ⟨τv, r, hz, hzero, hS, hws, harr, hi, ho⟩ :=
    spanInner_run F ν MX hb hn hd he hsb hmod0 (by rw [hνmem]; exact hPlen) hW
      (by rw [hνspan]; exact hMlen) hMcan hone' hxt'
  have hfr := run_frame r
  let τ := renameEnv spanSwap τv
  have hrun : Run B spanBlock ρ τ (spanCost F n d) := by
    have := rename_run spanSwap r
    have h2 : renameEnv spanSwap ν = ρ := swap_involutive _ _ ρ
    rwa [h2] at this
  have hτmem : τ.arrs canonical.mem = τv.arrs spanMem := by
    show τv.arrs (spanSwap.symm canonical.mem) = _; simp [spanSwap]
  have hτspan : τ.arrs spanMem = τv.arrs canonical.mem := by
    show τv.arrs (spanSwap.symm spanMem) = _; simp [spanSwap]
  have hmodτ : τv.vars canonical.modBase = 0 := by
    rw [hfr.1 _ (spanInner_safe _ (by simp))]; exact hmod0
  refine ⟨τ, hrun, hz, hzero, ?_, ?_, ?_, ?_, ?_, hfr.1, hi, ho⟩
  · rw [hτmem, harr _ (by decide) (by decide)]; exact hνspan
  · intro a h1 h2
    by_cases hm : a = canonical.mem
    · subst hm; rw [hτmem, harr _ (by decide) (by decide)]; exact hνspan
    · show τv.arrs (spanSwap.symm a) = ρ.arrs a
      have : spanSwap.symm a = a := by
        simp [spanSwap, Equiv.swap_apply_of_ne_of_ne hm h1]
      rw [this, harr a hm h2]
      show ρ.arrs (spanSwap.symm a) = ρ.arrs a
      rw [this]
  · intro i hi'
    rw [hτspan]
    have := hS.base.modulus_value ⟨i, hi'⟩
    rwa [hmodτ, Nat.zero_add] at this
  · rw [hτspan, hfr.2.2.1, hνmem]
  · show (τv.arrs (spanSwap.symm canonical.scratch)).length = _
    have : spanSwap.symm canonical.scratch = canonical.scratch := by
      simp [spanSwap, Equiv.swap_apply_of_ne_of_ne (show canonical.scratch ≠ canonical.mem by decide)
        (show canonical.scratch ≠ spanMem by decide)]
    rw [this, hfr.2.2.1, hνscr]
end Mathproof.Problem18PairBoundaryModeC2Glue20261004
