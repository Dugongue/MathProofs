    ⟨Classical.choose (hcover x.val x.property),x.val,Classical.choose_spec (hcover x.val x.property)⟩
  have hM : Function.Injective M := by
    intro x y he
    exact Subtype.ext (congrArg (fun z : (i : I) × {x : X//Q i x}=>z.2.val) he)
  have hc := Nat.card_le_card_of_injective M hM
