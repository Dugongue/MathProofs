theorem gcd_unit_run {B Sn N : Nat} {σ : Env} {P Q : K[X]}
    (h : Buffers F q Sn B N P Q σ) (hfit : 5+N+N+N+N ≤ Sn) :
    ∃τ,Run B gcdUnit σ τ (gcdCost F N) ∧ Slots F canonical WS Sn B τ ∧
      (τ.vars q.w=1 ↔ IsUnit (gcd P Q)) ∧
      (τ.vars q.w=0 ∨ τ.vars q.w=1) ∧
      (∀s<Sn,5+N+N+N+N ≤ s → val F canonical WS τ s=val F canonical WS σ s) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hword:=h.slots.slots_word
  obtain ⟨ξ,R,hr,hb,hvars,hin,hout,hmem⟩:=
    Problem18IMPPolynomialGCDFullFrame20261002.routine_run_framed F q names_valid counter
      (by constructor <;> decide) h hfit
