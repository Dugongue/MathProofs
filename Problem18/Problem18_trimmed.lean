noncomputable def adjoint (B : HermitianForm (K := K) (V := V))
    (hB : B.SeparatingLeft) (f : Module.End K V) : Module.End K V where
  toFun x := (formEquiv B hB).symm ((B x).comp f)
  map_add' x y := by
    apply (formEquiv B hB).injective
    simp only [LinearEquiv.apply_symm_apply, map_add]
    rfl
  map_smul' a x := by
    apply (formEquiv B hB).injective
    simp only [LinearEquiv.apply_symm_apply, map_smulₛₗ, RingHom.id_apply]
    rfl
