  have hx' : |x| ≤ δ := hx.trans (inv_le_inv₀ (pow_pos hq0 _) (pow_pos hq0 _) |>.mpr
    (pow_le_pow_right₀ hq1 (by omega : c/4 ≤ n/2)))
  have hy' : |y| ≤ δ := hy.trans (inv_le_inv₀ (pow_pos hq0 _) (pow_pos hq0 _) |>.mpr
    (pow_le_pow_right₀ hq1 (by omega : c/4 ≤ c/2)))
