def alternatingSpace (B : LinearMap.BilinForm K (Fin n → K)) :
    AddSubgroup (Module.End K (Fin n → K)) where
  carrier := {T | (∀x y,B (T x) y=B x (T y)) ∧ ∀x,B x (T x)=0}
  zero_mem' := by constructor <;> intros <;> simp
  add_mem' := by
    intro T U hT hU
    constructor
    · intro x y; simp only [LinearMap.add_apply,map_add]; rw [hT.1,hU.1]
    · intro x; simp only [LinearMap.add_apply,map_add,hT.2,hU.2,add_zero]
  neg_mem' := by
    intro T hT
    constructor
    · intro x y; simp only [LinearMap.neg_apply,map_neg]; rw [hT.1]
    · intro x; simp only [LinearMap.neg_apply,map_neg,hT.2,neg_zero]
local instance : Finite (Module.End K (Fin n → K)) :=
  Finite.of_injective (fun T : Module.End K (Fin n → K) => (T : _ → _)) DFunLike.coe_injective
def coordinates (B : LinearMap.BilinForm K (Fin n → K))
    (E : (Fin s → K) →ₗ[K] (Fin n → K)) (Z : Finset (Upper s)) :
    alternatingSpace B →+ (Z → K) where
  toFun T p := B (T.val (E (Pi.single p.val.val.1 1))) (E (Pi.single p.val.val.2 1))
  map_zero' := by funext p; simp
  map_add' T U := by
    funext p
    change B (T.val (E (Pi.single p.val.val.1 1)) + U.val (E (Pi.single p.val.val.1 1)))
      (E (Pi.single p.val.val.2 1)) = _
    exact LinearMap.congr_fun (map_add B _ _) _
theorem coordinates_surjective
    (B : LinearMap.BilinForm K (Fin n → K)) (hB : B.SeparatingLeft)
    (hsym : ∀x y,B y x= -B x y)
    (E : (Fin s → K) →ₗ[K] (Fin n → K)) (hE : Function.Injective E)
    (Z : Finset (Upper s)) : Function.Surjective (coordinates B E Z) := by
  classical
  intro u
  obtain ⟨L,hL⟩ := E.exists_leftInverse_of_injective (LinearMap.ker_eq_bot.mpr hE)
  let c : Upper s → K := fun p => if h : p∈Z then u ⟨p,h⟩ else 0
  let A : AltMat s K := ⟨altOfFun c,altOfFun_isAlt c⟩
  let C := A.val.toBilin'
  let D := pullback (RingEquiv.refl K) C L
  have hD : ∀x y,D y x=(-1 : K)*(RingEquiv.refl K) (D x y) := by
    intro x y
    simpa only [D,pullback_apply,RingEquiv.refl_apply,neg_one_mul,C]
      using ((toBilin_isAlt A).neg_eq (L x) (L y)).symm
  have hs : ∀x y,B y x=(-1 : K)*(RingEquiv.refl K) (B x y) := by
    intro x y; simpa only [RingEquiv.refl_apply,neg_one_mul] using hsym x y
  let T : alternatingSpace B := ⟨formOperator (RingEquiv.refl K) B hB D,
    formOperator_selfAdjoint (RingEquiv.refl K) B hB (-1 : K) (neg_ne_zero.mpr one_ne_zero) hs D hD,
    formOperator_alternating (RingEquiv.refl K) B hB (-1 : K) (neg_ne_zero.mpr one_ne_zero) hs D hD
      (fun x => toBilin_isAlt A (L x))⟩
  refine ⟨T,?_⟩
  funext p
  change B (formOperator (RingEquiv.refl K) B hB D (E (Pi.single p.val.val.1 1)))
    (E (Pi.single p.val.val.2 1))=u p
  rw [formOperator_spec (RingEquiv.refl K) B hB D]
  change C (L (E (Pi.single p.val.val.1 1))) (L (E (Pi.single p.val.val.2 1)))=u p
  have hLE (x : Fin s → K) : L (E x)=x := LinearMap.congr_fun hL x
  rw [hLE,hLE]
  simp only [C,Matrix.toBilin'_single,A,altOfFun_apply_lt p.val.property]
  simp [c,p.property]
theorem zero_coordinates_card_mul
    (B : LinearMap.BilinForm K (Fin n → K)) (hB : B.SeparatingLeft)
    (hsym : ∀x y,B y x= -B x y)
    (E : (Fin s → K) →ₗ[K] (Fin n → K)) (hE : Function.Injective E)
    (Z : Finset (Upper s)) :
    Nat.card {T : alternatingSpace B // ∀p∈Z,
      B (T.val (E (Pi.single p.val.1 1))) (E (Pi.single p.val.2 1))=0}*
      Fintype.card K^Z.card=Nat.card (alternatingSpace B) := by
  have h := Mathproof.Problem18AdditiveFiberCount20260930.surjective_fiber_card_mul
    (coordinates B E Z) (coordinates_surjective B hB hsym E hE Z) 0
  have hc : Nat.card {T : alternatingSpace B // coordinates B E Z T=0}=
      Nat.card {T : alternatingSpace B // ∀p∈Z,
        B (T.val (E (Pi.single p.val.1 1))) (E (Pi.single p.val.2 1))=0} := by
    apply Nat.card_congr
    exact Equiv.subtypeEquivRight (fun T => by
      constructor
      · intro h p hp; exact congrFun h ⟨p,hp⟩
      · intro h; funext p; exact h p.val p.property)
  rw [hc] at h
  simpa only [Nat.card_eq_fintype_card,Fintype.card_fun,Fintype.card_coe] using h
end Mathproof.Problem18AlternatingCoordinateRestriction20260930
