universe u v w
variable {E : Type v} {U : Type w} [Field E] [AddCommGroup U] [Module E U]
abbrev UpperPair (n : ℕ) := {p : Fin n × Fin n // p.1 ≤ p.2}
abbrev TwistedSymmetricForms (σ : E →+* E) (eps : E) (U : Type w)
    [AddCommGroup U] [Module E U] :=
  {B : U →ₛₗ[σ] U →ₗ[E] E // ∀ u v : U, B v u = eps * σ (B u v)}
noncomputable def upperRestriction {n : ℕ} (b : Module.Basis (Fin n) E U)
    {σ : E →+* E} {eps : E} (B : TwistedSymmetricForms σ eps U) : UpperPair n → E :=
  fun p => B.1 (b p.1.1) (b p.1.2)
theorem upperRestriction_injective {n : ℕ} (b : Module.Basis (Fin n) E U)
    (σ : E →+* E) (eps : E) :
    Function.Injective (upperRestriction b (σ := σ) (eps := eps)) := by
  intro B C h
  apply Subtype.ext
  apply b.ext
  intro i
  apply b.ext
  intro j
  rcases le_total i j with hij | hji
  · exact congrFun h ⟨(i, j), hij⟩
  · have hji' : B.1 (b j) (b i) = C.1 (b j) (b i) := congrFun h ⟨(j, i), hji⟩
    rw [B.2 (b j) (b i), C.2 (b j) (b i), hji']
theorem card_upperPair (n : ℕ) : Nat.card (UpperPair n) = (n + 1).choose 2 := by
  calc
    Nat.card (UpperPair n) = Nat.card (Sym2 (Fin n)) :=
      Nat.card_congr (Sym2.sortEquiv (α := Fin n)).symm
    _ = (n + 1).choose 2 := by
      rw [Nat.card_eq_fintype_card, Sym2.card, Fintype.card_fin]
theorem twisted_symmetric_forms_card_le [Fintype E] {n : ℕ}
    (b : Module.Basis (Fin n) E U) (σ : E →+* E) (eps : E) :
    Nat.card (TwistedSymmetricForms σ eps U) ≤ Nat.card E ^ ((n + 1).choose 2) := by
  calc
    Nat.card (TwistedSymmetricForms σ eps U) ≤ Nat.card (UpperPair n → E) :=
      Nat.card_le_card_of_injective (upperRestriction b) (upperRestriction_injective b σ eps)
    _ = Nat.card E ^ ((n + 1).choose 2) := by rw [Nat.card_fun, card_upperPair]
section Compatible
variable {F : Type u} [Field F] [Algebra F E]
  [FiniteDimensional F E] [Algebra.IsSeparable F E]
  [Module F U] [IsScalarTower F E U]
abbrev CompatibleForms (τ : F ≃+* F) (σ : E ≃+* E) (eps : F) :=
  {B : U →ₛₗ[(τ : F →+* F)] U →ₗ[F] F //
    (∀ (a : E) (u v : U), B (a • u) v = B u (σ a • v)) ∧
    (∀ u v : U, B v u = eps * τ (B u v))}
theorem compatible_forms_card_le [Fintype E] {n : ℕ}
    (b : Module.Basis (Fin n) E U) (τ : F ≃+* F) (σ : E ≃+* E)
    (hcompat : (algebraMap F E).comp (τ : F →+* F) =
      (σ : E →+* E).comp (algebraMap F E))
    (hσ : Function.Involutive σ) (eps : F) :
    Nat.card (CompatibleForms (U := U) τ σ eps) ≤ Nat.card E ^ ((n + 1).choose 2) := by
  let lift : CompatibleForms (U := U) τ σ eps →
      TwistedSymmetricForms (σ : E →+* E) (algebraMap F E eps) U := fun B =>
    ⟨twistedTraceForm (σ : E →+* E) B.1 B.2.1,
      twistedTraceForm_symmetry τ σ hcompat hσ B.1 B.2.1 eps B.2.2⟩
  have hinj : Function.Injective lift := by
    intro B C h
    apply Subtype.ext
    exact twistedTraceForm_injective (σ : E →+* E) B.2.1 C.2.1 (congrArg Subtype.val h)
  letI : Finite (TwistedSymmetricForms (σ : E →+* E) (algebraMap F E eps) U) :=
    Finite.of_injective (upperRestriction b)
      (upperRestriction_injective b (σ : E →+* E) (algebraMap F E eps))
  exact (Nat.card_le_card_of_injective lift hinj).trans
    (twisted_symmetric_forms_card_le b (σ : E →+* E) (algebraMap F E eps))
end Compatible
end Mathproof.Problem18CompatibleFormCard20260930
