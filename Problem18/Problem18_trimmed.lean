variable {K : Type*} [Field K]
theorem squareClass_eq_iff_isSquare_ratio (a b : Kˣ) :
    squareClass K a=squareClass K b ↔ IsSquare ((a:K)/(b:K)) := by
  constructor
  · intro he
    have hh : squareClass K (a/b)=1 := by rw [map_div,he,div_self']
    obtain ⟨u,hu⟩ := (squareClass_eq_one K (a/b)).mp hh
    refine ⟨(u:K),?_⟩
    simpa only [Units.val_div_eq_div_val,Units.val_pow_eq_pow_val,Units.val_mul,pow_two] using (congrArg Units.val hu).symm
  · intro hh
    obtain ⟨s,hs⟩ := hh.exists_sq
    have hs0 : s≠0 := by
      intro hz
      apply div_ne_zero a.ne_zero b.ne_zero
      simpa only [hz,zero_pow (by decide : 2≠0)] using hs
    let u : Kˣ := Units.mk0 s hs0
    have hu : u^2=a/b := by
      apply Units.ext
      simp only [Units.val_pow_eq_pow_val,Units.val_div_eq_div_val]
      change s^2=(a:K)/(b:K)
      exact hs.symm
    have he := (squareClass_eq_one K (a/b)).mpr ⟨u,hu⟩
    rw [map_div] at he
    exact div_eq_one.mp he
