  let πu : v.Uniformizer := ⟨π, hπ⟩
  obtain ⟨n, u, hau⟩ := Valuation.exists_pow_Uniformizer ha πu
  have hassocA : Associated a (π ^ n) := by
    have hauA : a = π ^ n * (u : v.valuationSubring) := by
      apply Subtype.ext
