      {M : Matrix (Fin d) ι K // M.rank = d ∧ rootCoefficients z ∈ LinearMap.range Mᵀ.mulVecLin} :=
    { toFun := fun M => ⟨M.val.val, M.val.property, M.property⟩
      invFun := fun M => ⟨⟨M.val, M.property.1⟩, M.property.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  have hcard := Nat.card_congr e
  have hs : (∑ M : ConstraintSample K d ι, diagonalWeight ψ M.val z m) =
      (Nat.card {M : Matrix (Fin d) ι K // M.rank = d ∧
        rootCoefficients z ∈ LinearMap.range Mᵀ.mulVecLin} : ℝ) := by
    simp_rw [diagonalWeight_eq_indicator ψ hψ _ z m hm]
    rw [← hcard, Nat.card_eq_fintype_card, Fintype.card_subtype]
    simp [P]
  rw [hs]
  exact fixed_nonzero_mem_transpose_range_probability_le hd (rootCoefficients_ne_zero hz)
theorem repeated_pure_diagonal_energy_average_le (a b d : ℕ) (i₀ : Fin a)
