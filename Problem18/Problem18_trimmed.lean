theorem automorphism_card_congr {R U W : Type*} [Field R]
    [AddCommGroup U] [AddCommGroup W] [Module R U] [Module R W]
    (e : U ≃ₗ[R] W) : Nat.card (U ≃ₗ[R] U) = Nat.card (W ≃ₗ[R] W) := by
  exact Nat.card_congr
    (((LinearMap.GeneralLinearGroup.generalLinearEquiv R U).symm.trans
      ((LinearMap.GeneralLinearGroup.congrLinearEquiv e).trans
        (LinearMap.GeneralLinearGroup.generalLinearEquiv R W))).toEquiv)
theorem automorphism_card_ge_quarter {R U : Type*} [Field R] [Fintype R]
    [AddCommGroup U] [Module R U] [FiniteDimensional R U] :
    (1 / 4 : ℝ) * (Fintype.card R : ℝ) ^ (Module.finrank R U * Module.finrank R U) ≤
      Nat.card (U ≃ₗ[R] U) := by
  rw [automorphism_card_congr (Module.finBasis R U).equivFun]
  exact linearEquiv_card_ge_quarter
theorem coordinate_automorphism_card_le {K : Type*} [Field K] [Fintype K] (n : ℕ) :
    Nat.card ((Fin n → K) ≃ₗ[K] (Fin n → K)) ≤ Fintype.card K ^ (n * n) := by
  rw [linearEquiv_card_eq_fullRank]
  have h := Nat.card_le_card_of_injective
    (fun M : {M : Matrix (Fin n) (Fin n) K // M.rank = n} => M.1)
    Subtype.val_injective
  simpa [Matrix, Nat.card_eq_fintype_card, ← pow_mul] using h
theorem embedding_card_scaled_bound {K E : Type*} [Field K] [Field E]
    [Algebra K E] [Fintype K] [Fintype E] [FiniteDimensional K E]
    {n : ℕ} (ρ : E →ₐ[K] Module.End K (Fin n → K)) :
    (Nat.card (E →ₐ[K] Module.End K (Fin n → K)) : ℝ) *
        (Fintype.card E : ℝ) ^
          (Module.finrank E (ActionSpace ρ) * Module.finrank E (ActionSpace ρ)) ≤
      4 * (Fintype.card K : ℝ) ^ (n * n) := by
  have heq :
      (Nat.card (E →ₐ[K] Module.End K (Fin n → K)) : ℝ) *
          Nat.card (ActionSpace ρ ≃ₗ[E] ActionSpace ρ) =
        Nat.card ((Fin n → K) ≃ₗ[K] (Fin n → K)) := by
    exact_mod_cast embedding_card_mul_extensionAut ρ
  have hlo := automorphism_card_ge_quarter (R := E) (U := ActionSpace ρ)
  have hup : (Nat.card ((Fin n → K) ≃ₗ[K] (Fin n → K)) : ℝ) ≤
      (Fintype.card K : ℝ) ^ (n * n) := by
    exact_mod_cast coordinate_automorphism_card_le (K := K) n
  calc
    (Nat.card (E →ₐ[K] Module.End K (Fin n → K)) : ℝ) *
        (Fintype.card E : ℝ) ^
          (Module.finrank E (ActionSpace ρ) * Module.finrank E (ActionSpace ρ)) =
        4 * ((Nat.card (E →ₐ[K] Module.End K (Fin n → K)) : ℝ) *
          ((1 / 4 : ℝ) * (Fintype.card E : ℝ) ^
            (Module.finrank E (ActionSpace ρ) * Module.finrank E (ActionSpace ρ)))) := by ring
    _ ≤ 4 * ((Nat.card (E →ₐ[K] Module.End K (Fin n → K)) : ℝ) *
          Nat.card (ActionSpace ρ ≃ₗ[E] ActionSpace ρ)) := by
      gcongr
    _ = 4 * Nat.card ((Fin n → K) ≃ₗ[K] (Fin n → K)) := by rw [heq]
    _ ≤ 4 * (Fintype.card K : ℝ) ^ (n * n) := by gcongr
end Mathproof.Problem18FieldEmbeddingBound20260930
