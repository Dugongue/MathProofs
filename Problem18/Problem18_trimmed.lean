    (renameEnv rho sigma).arrs a=sigma.arrs (rho.symm a) := rfl
@[simp] theorem renameEnv_inp (rho : String ≃ String) (sigma : Env) :
    (renameEnv rho sigma).inp=sigma.inp := rfl
