    (hps : 5+N+N+N+N ≤ ps) (hgs : 5+N+N+N+N ≤ gs) (hos : 5+N+N+N+N ≤ os)
    (hpf : ps+N ≤ Sn) (hgf : gs+N ≤ Sn) (hof : os+N ≤ Sn)
    (hP : ∀i<N,val F canonical q.WS σ (ps+i)=P.coeff (N-1-i))
    (hQ : ∀i<N,val F canonical q.WS σ (gs+i)=Q.coeff (N-1-i))
    (hPd : P=0 ∨ P.natDegree<N) (hQd : Q=0 ∨ Q.natDegree<N) :
    ∃τ,Run B program σ τ (cost F N) ∧ Slots F canonical q.WS Sn B τ ∧
      (∀i<N,val F canonical q.WS τ (os+i)=(gcd P Q).coeff (N-1-i)) ∧
      (∀s<Sn,5+N+N+N+N ≤ s → (s<os ∨ os+N ≤ s) →
        val F canonical q.WS τ s=val F canonical q.WS σ s) ∧
      (∀x,x∉regNames canonical → x∉q.list → x≠ci → x≠counter → τ.vars x=σ.vars x) ∧
      τ.vars q.n=N ∧ τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hword:=hS.slots_word
  obtain ⟨ξ,hl,hb,hm,hv,hi,hu⟩:=load_run F hS hn hp hg hfit hps hgs hpf hgf hP hQ hPd hQd
  obtain ⟨ζ,R,hr,hz,hvr,hir,hur,hmr⟩:=
    Problem18IMPPolynomialGCDFullFrame20261002.routine_run_framed F q names_valid counter
      (by constructor <;> decide) hb hfit
  have hoξ : ξ.vars outReg=os := (hv outReg (by decide) (by decide) (by decide) (by decide)).trans ho
  have hoζ : ζ.vars outReg=os := (hvr outReg (by decide) (by decide) (by decide)).trans hoξ
  let ζ₁:=ζ.setVar q.N N
  have hs₁ : Slots F canonical q.WS Sn B ζ₁ :=
    Slots.setVar F canonical hz.slots (by decide) (by decide) N
  have hn₁ : ζ₁.vars q.n=N := by simpa only [ζ₁,vars_setVar,if_neg (by decide : q.n≠q.N)] using hz.capacity
  have hN₁ : ζ₁.vars q.N=N := by simp [ζ₁]
  have ho₁ : ζ₁.vars outReg=os := by simpa only [ζ₁,vars_setVar,if_neg (by decide : outReg≠q.N)] using hoζ
  have hassign : Run B (.assign q.N (.var q.n)) ζ ζ₁ 2 :=
    Run.assign (by simpa only [hz.capacity] using evalB_var (B:=B) (σ:=ζ) (x:=q.n) (by rw [hz.capacity];omega))
  have hfirst : firstExpr.evalB B ζ₁=some (5+N) := by
    unfold firstExpr
    exact evalB_plus (evalB_lit (by omega)) (by simpa only [hn₁] using evalB_var (B:=B) (σ:=ζ₁) (x:=q.n) (by rw [hn₁];omega)) (by omega)
  obtain ⟨τ,hcopy,hτ,hvalue,hmem,hvars,_,_,hin,hout⟩ :=
    copy_run (fieldMacros F) q names_valid stable (by decide) (.var outReg) firstExpr (by simp [VarsIn,stable]) (by simp [VarsIn,stable,firstExpr,plus])
      hs₁ (by simpa only [ho₁] using evalB_var (B:=B) (σ:=ζ₁) (x:=outReg) (by rw [ho₁];omega))
