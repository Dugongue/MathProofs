theorem raw_second_failure_le (u : Bool) (q : ℕ) (hv : validSize K u q)
    (a b c : ℕ) (ha : 2≤a) (hac : a≤ c) :
    probability (fun A : RectTensor a b c K=>
      Algebra.adjoin K (Set.range (rawSecond u q A))≠⊤)≤(29/32:ℝ)^(b/5) := by
  cases u with
  | false =>
    letI : StarRing K := identityStar
    have he : (fun A : RectTensor a b c K=>
        Algebra.adjoin K (Set.range (rawSecond false q A))≠⊤)=
        (fun A=>Algebra.adjoin K (Set.range (secondFamily A))≠⊤) := by
      funext A
      rw [rawSecond_eq false q (fun _=>rfl)]
    rw [he]
    simpa only [probability,Nat.card_eq_fintype_card] using
      (Mathproof.Problem18LargeCrossGramDensity20261001.second_generation_failure_probability
        (K:=K) (b:=b) ha hac)
  | true =>
    let d := Classical.choice (Mathproof.Problem18UnitaryRootField20260930.exists_unitaryFieldData q hv)
    letI : StarRing K := d.starRing
