        · exact Or.inl (by omega)
        · exact Or.inr (by omega)
      rw [val_setVar F r tW, hoth s hs hso', hvalb]
      exact hkeep s hs (by rcases hso with h | h
                           · exact Or.inl h
                           · exact Or.inr (by omega))
    · intro a h1 h2
      simp only [arrs_setVar]; rw [harrc a h1 h2, hτb, arrs_setVar, hτa, arrs_setVar]
