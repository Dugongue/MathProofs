theorem mkExt_S (z : String) : mkExt base extS extP extB extL (pre "S" z) = extS z := by
  have h : ∃ w, pre "S" z = pre "S" w := ⟨z, rfl⟩
  simp only [mkExt, dif_pos h]
  exact congrArg extS (pre_inj "S" h.choose_spec).symm
theorem mkExt_P (z : String) : mkExt base extS extP extB extL (pre "P" z) = extP z := by
  have h : ∃ w, pre "P" z = pre "P" w := ⟨z, rfl⟩
  have h0 : ¬ ∃ w, pre "P" z = pre "S" w := fun ⟨w, hw⟩ => pre_S_ne_P z w hw
  simp only [mkExt, dif_neg h0, dif_pos h]
  exact congrArg extP (pre_inj "P" h.choose_spec).symm
theorem mkExt_B (z : String) : mkExt base extS extP extB extL (pre "B" z) = extB z := by
  have h : ∃ w, pre "B" z = pre "B" w := ⟨z, rfl⟩
  have h0 : ¬ ∃ w, pre "B" z = pre "S" w := fun ⟨w, hw⟩ => pre_S_ne_B z w hw
  have h1 : ¬ ∃ w, pre "B" z = pre "P" w := fun ⟨w, hw⟩ => pre_P_ne_B z w hw
  simp only [mkExt, dif_neg h0, dif_neg h1, dif_pos h]
  exact congrArg extB (pre_inj "B" h.choose_spec).symm
theorem mkExt_L (z : String) : mkExt base extS extP extB extL (pre "L" z) = extL z := by
  have h : ∃ w, pre "L" z = pre "L" w := ⟨z, rfl⟩
  have h0 : ¬ ∃ w, pre "L" z = pre "S" w := fun ⟨w, hw⟩ => pre_S_ne_L z w hw
  have h1 : ¬ ∃ w, pre "L" z = pre "P" w := fun ⟨w, hw⟩ => pre_P_ne_L z w hw
  have h2 : ¬ ∃ w, pre "L" z = pre "B" w := fun ⟨w, hw⟩ => pre_B_ne_L z w hw
  simp only [mkExt, dif_neg h0, dif_neg h1, dif_neg h2, dif_pos h]
  exact congrArg extL (pre_inj "L" h.choose_spec).symm
theorem mkExt_host (s : String) :
    mkExt base extS extP extB extL ("P37#" ++ s) = base ("P37#" ++ s) := by
  have h : ∀ t, ¬ ∃ w, "P37#" ++ s = pre t w := fun t ⟨w, hw⟩ => host_not_pre s t w hw
  simp only [mkExt, dif_neg (h "S"), dif_neg (h "P"), dif_neg (h "B"), dif_neg (h "L")]
end
def selectBranch (k : Nat) (p34 bnd lrg : Com) : Com :=
  if k = 1 then p34 else if k = 2 then bnd else lrg
theorem selectBranch_1 (p34 bnd lrg : Com) : selectBranch 1 p34 bnd lrg = p34 := rfl
theorem selectBranch_2 (p34 bnd lrg : Com) : selectBranch 2 p34 bnd lrg = bnd := rfl
theorem selectBranch_3 (p34 bnd lrg : Com) : selectBranch 3 p34 bnd lrg = lrg := rfl
def isoOf (k : Nat) : Iso := if k = 1 then IP else if k = 2 then IB else IL
theorem dispatch_false {W : Nat} (p34 bnd lrg : Com) {σ : Env}
    (hso : σ.arrs soA = [0]) (hW : 10 < W) :
    Run W (dispatch p34 bnd lrg) σ σ 10 := by
  have hc : (Cond.eq (.get soA (.lit 0)) (.lit 1)).evalB W σ = some false := by
    simp [Cond.evalB, Expr.evalB, fit, hso, show 0 < W by omega, show 1 < W by omega]
  have := Run.ite_false (c := .ite (.eq (.get sA (.lit 10)) (.lit 1)) (iso IP p34)
      (.ite (.eq (.get sA (.lit 10)) (.lit 2)) (iso IB bnd) (iso IL lrg))) hc Run.skip
  exact this.mono (by simp [Cond.size, Expr.size])
theorem dispatch_true {W : Nat} (p34 bnd lrg : Com) {σ τ : Env} {k T : Nat}
    (hso : σ.arrs soA = [1]) (hk : (σ.arrs sA)[10]? = some k) (hk1 : 1 ≤ k) (hk3 : k ≤ 3)
    (hW : 10 < W)
    (hr : Run W (iso (isoOf k) (selectBranch k p34 bnd lrg)) σ τ T) :
    Run W (dispatch p34 bnd lrg) σ τ (T + 20) := by
  have hc : (Cond.eq (.get soA (.lit 0)) (.lit 1)).evalB W σ = some true := by
    simp [Cond.evalB, Expr.evalB, fit, hso, show 0 < W by omega, show 1 < W by omega]
  have hkW : k < W := by omega
  have hc1 : (Cond.eq (.get sA (.lit 10)) (.lit 1)).evalB W σ = some (k == 1) := by
    simp [Cond.evalB, Expr.evalB, fit, hk, hkW, show 10 < W by omega, show 1 < W by omega]
  have hc2 : (Cond.eq (.get sA (.lit 10)) (.lit 2)).evalB W σ = some (k == 2) := by
    simp [Cond.evalB, Expr.evalB, fit, hk, hkW, show 10 < W by omega, show 2 < W by omega]
  have hsz : (Cond.eq (.get soA (.lit 0)) (.lit 1)).size = 4 := rfl
  have hsz1 : (Cond.eq (.get sA (.lit 10)) (.lit 1)).size = 4 := rfl
  have hsz2 : (Cond.eq (.get sA (.lit 10)) (.lit 2)).size = 4 := rfl
  rcases (show k = 1 ∨ k = 2 ∨ k = 3 by omega) with rfl | rfl | rfl
  · have h1 := Run.ite_true (d := .ite (.eq (.get sA (.lit 10)) (.lit 2)) (iso IB bnd) (iso IL lrg))
      (hc1.trans rfl) (by simpa [isoOf, selectBranch] using hr)
    have h0 := Run.ite_true (d := Com.skip) hc h1
    exact h0.mono (by rw [hsz, hsz1]; omega)
  · have h2 := Run.ite_true (d := iso IL lrg) (hc2.trans rfl)
      (by simpa [isoOf, selectBranch] using hr)
    have h1 := Run.ite_false (c := iso IP p34) (hc1.trans rfl) h2
    have h0 := Run.ite_true (d := Com.skip) hc h1
    exact h0.mono (by rw [hsz, hsz1, hsz2]; omega)
  · have h2 := Run.ite_false (c := iso IB bnd) (hc2.trans rfl)
      (by simpa [isoOf, selectBranch] using hr)
    have h1 := Run.ite_false (c := iso IP p34) (hc1.trans rfl) h2
    have h0 := Run.ite_true (d := Com.skip) hc h1
    exact h0.mono (by rw [hsz, hsz1, hsz2]; omega)
theorem fresh_isoOf (k : Nat) : Fresh (isoOf k) := by
  unfold isoOf; split_ifs
  · exact fresh_IP
  · exact fresh_IB
  · exact fresh_IL
theorem isoOf_redirect (k : Nat) : (isoOf k).redirect = false := by
  unfold isoOf; split_ifs <;> rfl
theorem isoOf_tin (k : Nat) : (isoOf k).tin = qA := by
  unfold isoOf; split_ifs <;> rfl
def tagOf (k : Nat) : String := if k = 1 then "P" else if k = 2 then "B" else "L"
theorem isoOf_ren (k : Nat) : (isoOf k).ren = pre (tagOf k) := by
  unfold isoOf tagOf; split_ifs <;> rfl
theorem isoOf_pin' (k : Nat) : ∃ s ∈ ["pP", "pB", "pL"], (isoOf k).pin = "P37#" ++ s := by
  unfold isoOf; split_ifs
  · exact ⟨"pP", by simp, rfl⟩
  · exact ⟨"pB", by simp, rfl⟩
  · exact ⟨"pL", by simp, rfl⟩
theorem tagOf_ne_S (k : Nat) (y z : String) : pre (tagOf k) y ≠ pre "S" z := by
  unfold tagOf; split_ifs
  · exact pre_S_ne_P y z
  · exact pre_S_ne_B y z
  · exact pre_S_ne_L y z
theorem tagOf_ne_R (k : Nat) (y z : String) : pre (tagOf k) y ≠ pre "R" z := by
  unfold tagOf; split_ifs
  · exact pre_R_ne_P y z
  · exact pre_R_ne_B y z
  · exact pre_R_ne_L y z
theorem mkExt_tag (base extS extX : String → Nat) (k : Nat) (z : String) :
    mkExt base extS extX extX extX (pre (tagOf k) z) = extX z := by
  unfold tagOf; split_ifs
  · exact mkExt_P _ _ _ _ _ z
  · exact mkExt_B _ _ _ _ _ z
  · exact mkExt_L _ _ _ _ _ z
theorem answerWords_some (r : Bool) :
    Mathproof.Problem18RAMAnswerCodec20261001.answerWords (some r) = [if r then 1 else 0] := by
