  classical
  simp only [Module.Basis.equivFun_symm_apply, map_sum, map_smul, map_smulₛₗ, LinearMap.sum_apply, LinearMap.smul_apply, smul_eq_mul]
  simp [hb, mul_comm, starRingEnd_apply]
theorem exists_star_add_eq
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    {z : K} (hz : star z = z) : ∃ c : K, c + star c = z := by
  obtain ⟨a, ha⟩ := finite_field_trace_nonzero_m0010 (K := K) hcard hstar
  let t := a + star a
  have ht : t ≠ 0 := ha
  have htf : star t = t := by simp [t, add_comm]
  refine ⟨(z / t) * a, ?_⟩
  have hdiv : star (z / t) = z / t := by
    rw [star_div₀, hz, htf]
  rw [star_mul, hdiv]
  field_simp
  simp [t]
