    (fun j : V →ₗ[K] V × W => (j : V → V × W)) DFunLike.coe_injective
  letI : Fintype (EmbeddingOrbit σ B C) := Fintype.ofFinite _
  rw [ConditionedMarked,Nat.card_sigma]
  simp_rw [conditioned_marked_fiber_card σ B C hB A _ P]
