  (σ.setVar P.count M).setVar names.qr Q
theorem run (P : Config) (hP : P.Valid) (F : FieldPresentation K) (S B M Q : Nat)
    (capacity : String) (σ : Env) (hS : Slots F canonical names.q.WS S B σ)
