theorem aeval_ker_le_of_dvd (S : Module.End K (Fin n → K)) {g h : K[X]} (hgh : g ∣ h) :
    LinearMap.ker (aeval S g) ≤ LinearMap.ker (aeval S h) := by
  obtain ⟨k,rfl⟩:=hgh
  intro x hx
  rw [LinearMap.mem_ker] at hx ⊢
  rw [mul_comm,map_mul,Module.End.mul_apply,hx,map_zero]
theorem ker_frobenius (S : Matrix (Fin n) (Fin n) K) (f : CPolynomial K)
    (hf : f.toPoly=S.charpoly) (q d : Nat) :
    LinearMap.ker (aeval S.toLin'
      (Problem18CompPolyBoundaryTests20260930.frobeniusGcd f q d).toPoly)=
      LinearMap.ker (S^(q^d)-S).toLin' := by
  set g:=(Problem18CompPolyBoundaryTests20260930.frobeniusGcd f q d).toPoly
  have hdvd:=(Problem18CompPolyBoundaryTests20260930.frobeniusGcd_dvd_iff f q d g).mp dvd_rfl
  have hE : ∀M : Matrix (Fin n) (Fin n) K,M.toLin'=Matrix.toLinAlgEquiv' M := fun M=>rfl
  have hh : aeval S.toLin' (X^(q^d)-X : K[X])=(S^(q^d)-S).toLin' := by
    rw [hE (S^(q^d)-S)];simp only [map_sub,map_pow,aeval_X];rfl
  apply le_antisymm
  · rw [← hh]
    exact aeval_ker_le_of_dvd _ hdvd.2
  · intro x hx
    rw [LinearMap.mem_ker] at hx ⊢
    rw [← hh] at hx
    let G:=EuclideanDomain.gcd f.toPoly (X^(q^d)-X : K[X])
    have hG : G ∣ g := ((Problem18CompPolyBoundaryTests20260930.frobeniusGcd_dvd_iff f q d G).mpr
      ⟨EuclideanDomain.gcd_dvd_left _ _,EuclideanDomain.gcd_dvd_right _ _⟩)
    have hzero : aeval S.toLin' G x=0 := by
      have hb:=EuclideanDomain.gcd_eq_gcd_ab f.toPoly (X^(q^d)-X : K[X])
      change aeval S.toLin' (EuclideanDomain.gcd f.toPoly (X^(q^d)-X)) x=0
      rw [hb,mul_comm (X^(q^d)-X : K[X]),map_add,map_mul,map_mul,LinearMap.add_apply,
        Module.End.mul_apply,Module.End.mul_apply]
      have hf0 : aeval S.toLin' f.toPoly=0 := by
        rw [hf,← Matrix.charpoly_toLin']
        exact LinearMap.aeval_self_charpoly _
      rw [hf0,LinearMap.zero_apply,zero_add,hx,map_zero]
    exact (aeval_ker_le_of_dvd _ hG) hzero
def stack (M N : Matrix (Fin n) (Fin n) K) : Matrix (Fin (n+n)) (Fin n) K :=
  Matrix.of fun i j => if h : i.val<n then M ⟨i.val,h⟩ j else N ⟨i.val-n,by omega⟩ j
theorem stack_mulVec (M N : Matrix (Fin n) (Fin n) K) (x : Fin n → K) :
    (stack M N).mulVec x=0 ↔ M.mulVec x=0 ∧ N.mulVec x=0 := by
  constructor
  · intro h
    constructor
    · funext i
      have := congrFun h ⟨i.val,by omega⟩
      simpa [stack,Matrix.mulVec,dotProduct,i.isLt] using this
    · funext i
      have := congrFun h ⟨n+i.val,by omega⟩
      simpa [stack,Matrix.mulVec,dotProduct] using this
  · rintro ⟨h1,h2⟩
    funext i
    by_cases hi : i.val<n
    · have := congrFun h1 ⟨i.val,hi⟩
      simpa [stack,Matrix.mulVec,dotProduct,hi] using this
    · have := congrFun h2 ⟨i.val-n,by omega⟩
      simpa [stack,Matrix.mulVec,dotProduct,hi] using this
theorem rank_eq_finrank_ker {m : Nat} (M : Matrix (Fin m) (Fin n) K) :
    M.rank+Module.finrank K (LinearMap.ker M.mulVecLin)=n := by
  have h:=LinearMap.finrank_range_add_finrank_ker M.mulVecLin
  simpa [Matrix.rank] using h
theorem ker_le_iff_rank (M N : Matrix (Fin n) (Fin n) K) :
    LinearMap.ker M.toLin' ≤ LinearMap.ker N.toLin' ↔ M.rank=(stack M N).rank := by
  have hker : LinearMap.ker (stack M N).mulVecLin=
      LinearMap.ker M.mulVecLin ⊓ LinearMap.ker N.mulVecLin := by
    ext x
    simp only [LinearMap.mem_ker,Submodule.mem_inf,Matrix.mulVecLin_apply]
    exact stack_mulVec M N x
  have h1:=rank_eq_finrank_ker M
  have h2:=rank_eq_finrank_ker (stack M N)
  rw [hker] at h2
  rw [Matrix.toLin'_apply' M,Matrix.toLin'_apply' N]
  constructor
  · intro h
    rw [inf_eq_left.mpr h] at h2
    omega
  · intro h
    have hf : Module.finrank K (LinearMap.ker M.mulVecLin ⊓ LinearMap.ker N.mulVecLin : Submodule K _)=
