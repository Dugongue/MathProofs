    · simp only [arrs_setVar, hτ1, arrs_setArr, if_true, List.length_set]; exact hlenτ
    · intro j
      simp only [arrs_setVar, hτ1, arrs_setArr, if_true, vars_setVar, eq_self_iff_true]
