variable {K : Type*} [Field K] [Finite K]
noncomputable instance fixedFintype (n : ℕ) (c : K) : Fintype (FixedConstant (K:=K) n c) :=
  Fintype.ofFinite _
noncomputable def fixedDivisorSwap {n : ℕ} (c : K) (g : K[X]) :
    {f : FixedConstant (K:=K) n c // g ∣ f.val.val} ≃
      {f : {f : MonicDegree (K:=K) n // g ∣ f.val} // f.val.val.coeff 0=c} where
  toFun f := ⟨⟨f.val.val,f.property⟩,f.val.property⟩
  invFun f := ⟨⟨f.val.val,f.property⟩,f.val.property⟩
  left_inv f := rfl
  right_inv f := rfl
theorem fixed_repeat_card {n d : ℕ} (c : K)
    (g : NonzeroIrreducibleDegree (K:=K) d) (hgn : 2*d<n) :
    Nat.card {f : FixedConstant (K:=K) n c // g.val.val.val^2 ∣ f.val.val}=
      Nat.card K^(n-2*d-1) := by
  have hg0 : g.val.val.val.coeff 0≠0 := by
    intro hh
    have hx : (X:K[X]) ∣ g.val.val.val := (X_dvd_iff).mpr hh
    have he := irreducible_X.dvd_irreducible_iff_associated g.val.property |>.mp hx
    exact g.property (Polynomial.eq_of_monic_of_associated g.val.val.property.1 monic_X he.symm)
  rw [Nat.card_congr (fixedDivisorSwap c (g.val.val.val^2))]
  have hd : (g.val.val.val^2).natDegree=2*d := by
    rw [natDegree_pow,g.val.val.property.2]
  simpa only [hd] using fixedConstant_divisor_card (g.val.val.val^2)
    (g.val.val.property.1.pow 2) (by simpa only [hd] using hgn) (by rw [pow_two,mul_coeff_zero]; exact mul_ne_zero hg0 hg0) c
noncomputable def fixedRepeatBound (n d : ℕ) : ℕ :=
  if 2*d<n then Nat.card K^(n-2*d-1) else if 2*d=n then 1 else 0
theorem fixed_repeat_card_le {n d : ℕ} (c : K)
    (g : NonzeroIrreducibleDegree (K:=K) d) :
    Nat.card {f : FixedConstant (K:=K) n c // g.val.val.val^2 ∣ f.val.val}≤
      fixedRepeatBound (K:=K) n d := by
  classical
  unfold fixedRepeatBound
  split_ifs with hl he
  · exact le_of_eq (fixed_repeat_card c g hl)
  · have hi : Function.Injective (fun f : {f : FixedConstant (K:=K) n c // g.val.val.val^2 ∣ f.val.val} =>
        (⟨f.val.val,f.property⟩ : {f : MonicDegree (K:=K) n // g.val.val.val^2 ∣ f.val})) := by
      intro f h hh
      apply Subtype.ext
      apply Subtype.ext
      exact congrArg (fun z : {f : MonicDegree (K:=K) n // g.val.val.val^2 ∣ f.val} => z.val) hh
    have hh := Nat.card_le_card_of_injective _ hi
    have hcount := card_monic_square_divisible (n:=n) g.val.val.val g.val.val.property.1
      (by rw [g.val.val.property.2,he])
    rw [g.val.val.property.2,he,Nat.sub_self,pow_zero] at hcount
    exact hh.trans_eq hcount
  · apply le_of_eq
    apply Nat.card_eq_zero.mpr
    left
    refine ⟨fun f => ?_⟩
    have hd := natDegree_le_of_dvd f.property f.val.val.property.1.ne_zero
    rw [natDegree_pow,g.val.val.property.2,f.val.val.property.2] at hd
    omega
theorem fixed_bad_covered {n : ℕ} (c : K) (hc : c≠0)
    (f : FixedConstant (K:=K) n c) (hf : ¬Squarefree f.val.val) :
    ∃ (d : Fin (n+1)) (g : NonzeroIrreducibleDegree (K:=K) d),
      g.val.val.val^2 ∣ f.val.val := by
  have hn : ¬Good f.val := fun h => hf h.1
  rcases bad_covered f.val hn with hx | h
  · have hz := X_dvd_iff.mp hx
    exact (hc (f.property.symm.trans hz)).elim
  · exact h
theorem fixed_squarefree_sieve (n : ℕ) (c : K) (hc : c≠0) :
    Nat.card (FixedConstant (K:=K) n c)≤
      Nat.card {f : FixedConstant (K:=K) n c // Squarefree f.val.val}+
      ∑ d : Fin (n+1),∑ g : NonzeroIrreducibleDegree (K:=K) d,
        Nat.card {f : FixedConstant (K:=K) n c // g.val.val.val^2 ∣ f.val.val} := by
  let I := Σ d : Fin (n+1),NonzeroIrreducibleDegree (K:=K) d
  have h := card_le_good_add_sum_bad
    (fun f : FixedConstant (K:=K) n c => Squarefree f.val.val)
    (fun i : I => fun f : FixedConstant (K:=K) n c => i.2.val.val.val^2 ∣ f.val.val)
    (by intro f hf; obtain ⟨d,g,hg⟩ := fixed_bad_covered c hc f hf; exact ⟨⟨d,g⟩,hg⟩)
  simpa only [I,Fintype.sum_sigma] using h
theorem fixed_squarefree_degree_sieve (n : ℕ) (c : K) (hc : c≠0) :
    Nat.card (FixedConstant (K:=K) n c)≤
      Nat.card {f : FixedConstant (K:=K) n c // Squarefree f.val.val}+
      ∑ d : Fin (n+1),Nat.card (NonzeroIrreducibleDegree (K:=K) d)*fixedRepeatBound (K:=K) n d := by
  classical
  apply (fixed_squarefree_sieve n c hc).trans
  apply Nat.add_le_add_left
  apply Finset.sum_le_sum
  intro d _
  have hh := Finset.sum_le_sum (s:=Finset.univ) (fun (g : NonzeroIrreducibleDegree (K:=K) d) _ =>
    fixed_repeat_card_le (n:=n) c g)
  simpa only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,Nat.card_eq_fintype_card,Nat.cast_id] using hh
