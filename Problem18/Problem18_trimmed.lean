theorem unitary_conjugate_pow (V S : Matrix j j K) (hV : IsUnitary V) (t : ℕ) :
    (V * S * Vᴴ)^t = V * S^t * Vᴴ := by
  induction t with
  | zero => simpa using (unitary_mul_conjTranspose hV).symm
  | succ t ih =>
    rw [pow_succ, ih, pow_succ]
    calc
      (V * S^t * Vᴴ) * (V * S * Vᴴ) = V * S^t * (Vᴴ * V) * S * Vᴴ := by
        simp only [Matrix.mul_assoc]
      _ = V * (S^t * S) * Vᴴ := by rw [hV]; simp only [Matrix.mul_one, Matrix.mul_assoc]
end SpectralRecovery
