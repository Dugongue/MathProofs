namespace Mathproof.Problem18UnitaryRootField20260930
open Polynomial
open Mathproof.Problem18InvolutionNorm20260930
variable {K : Type} [Field K] [Fintype K]
structure UnitaryFieldData (q : ℕ) where
  automorphism : K ≃+* K
  involutive : Function.Involutive automorphism
  nontrivial : automorphism≠1
  frobenius : ∀ x,automorphism x=x^q
  fixed_card : Nat.card (fixedField automorphism)=q
  ambient_card : Nat.card K=q^2
theorem exists_unitaryFieldData (q : ℕ)
    (hv : Mathproof.Problem18AllFormatRoot20260930.validSize K true q) :
    Nonempty (UnitaryFieldData (K:=K) q) := by
  classical
  change (∃ p k : ℕ,p.Prime ∧ 0<k ∧ q=p^k) ∧ Fintype.card K=q*q at hv
  rcases hv with ⟨⟨p,k,hp,hk,rfl⟩,hc⟩
  have hpc : (p:K)=0 := by
    have hh := FiniteField.cast_card_eq_zero K
    simp only [hc,Nat.cast_mul,Nat.cast_pow] at hh
    exact eq_zero_of_pow_eq_zero (show (p:K)^k=0 from mul_self_eq_zero.mp hh)
  letI : Fact p.Prime := ⟨hp⟩
  letI : CharP K p := (CharP.charP_iff_prime_eq_zero (R:=K) hp).mpr hpc
  let σ : K ≃+* K := iterateFrobeniusEquiv K p k
  have hσ (x : K) : σ x=x^(p^k) := by rfl
  have hinv : Function.Involutive σ := by
    intro x
    rw [hσ,hσ,← pow_mul,← hc]
    exact FiniteField.pow_card x
  have hq : 1<p^k := Nat.one_lt_pow hk.ne' hp.one_lt
  have hne : σ≠1 := by
    intro h
    have he (x : K) : x^(p^k)=x := by
      have hh := congrArg (fun τ : K ≃+* K => τ x) h
      change σ x=x at hh
      exact (hσ x).symm.trans hh
    have hz : (X^(p^k)-X : K[X])=0 :=
      Polynomial.eq_zero_of_natDegree_lt_card_of_eval_eq_zero _ Function.injective_id
        (fun x => by simp only [eval_sub,eval_pow,eval_X,he,sub_self]) (by
          rw [FiniteField.X_pow_card_sub_X_natDegree_eq K hq,hc]
          nlinarith)
    exact FiniteField.X_pow_card_sub_X_ne_zero K hq hz
  have hfixed : Nat.card (fixedField σ)=p^k := by
    apply Nat.pow_left_injective (show (2:ℕ)≠0 by decide)
    change Nat.card (fixedField σ)^2=(p^k)^2
    rw [← card_fixedField σ hinv hne]
    simpa only [Nat.card_eq_fintype_card,pow_two] using hc
  exact ⟨⟨σ,hinv,hne,hσ,hfixed,by simpa only [Nat.card_eq_fintype_card,pow_two] using hc⟩⟩
def UnitaryFieldData.starRing {q : ℕ} (d : UnitaryFieldData (K:=K) q) : StarRing K where
  star := d.automorphism
  star_involutive := d.involutive
  star_mul x y := (d.automorphism.map_mul x y).trans (mul_comm _ _)
  star_add := d.automorphism.map_add
theorem UnitaryFieldData.star_eq_power {q : ℕ} (d : UnitaryFieldData (K:=K) q) :
    letI : StarRing K := d.starRing
    ∀ x : K,star x=x^q := d.frobenius
theorem UnitaryFieldData.quadratic_card {q : ℕ} (d : UnitaryFieldData (K:=K) q) :
    Nat.card K=Nat.card (fixedField d.automorphism)^2 := by
  rw [d.fixed_card,d.ambient_card]
theorem UnitaryFieldData.star_eq_fixed_card {q : ℕ} (d : UnitaryFieldData (K:=K) q) :
    letI : StarRing K := d.starRing
    ∀ x : K,star x=x^Nat.card (fixedField d.automorphism) := by
  rw [d.fixed_card]
  exact d.frobenius
end Mathproof.Problem18UnitaryRootField20260930
