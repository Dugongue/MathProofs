variable {K : Type*} [Field K] [Fintype K] [StarRing K]
set_option backward.isDefEq.respectTransparency false
private theorem matrix_selfAdjoint {n : ℕ} (S : Module.End K (Fin n→K))
    (hS : ∀ x y,standardHermitian n (S x) y=standardHermitian n x (S y)) :
    IsSelfAdjoint S.toMatrix' := by
  change S.toMatrix'.IsHermitian
  ext i j
  have h := hS (Pi.single i 1) (Pi.single j 1)
  simpa [standardHermitian_apply,Matrix.conjTranspose_apply,LinearMap.toMatrix'_apply] using h
private theorem operator_selfAdjoint {n : ℕ} (M : selfAdjoint (Matrix (Fin n) (Fin n) K)) :
    ∀ x y,standardHermitian n (M.val.toLin' x) y=standardHermitian n x (M.val.toLin' y) := by
  intro x y
  rw [standardHermitian_apply,standardHermitian_apply]
  change star (M.val*ᵥx) ⬝ᵥ y=star x ⬝ᵥ (M.val*ᵥy)
  rw [Matrix.star_mulVec,←Matrix.dotProduct_mulVec]
  have hM : M.valᴴ=M.val := M.property
  rw [hM]
def standardMatrixEquiv (n : ℕ) :
    SelfAdjointOperators (starRingAut : K ≃+* K) (standardHermitian (K:=K) n) ≃
      selfAdjoint (Matrix (Fin n) (Fin n) K) where
  toFun S := ⟨S.val.toMatrix',matrix_selfAdjoint S.val S.property⟩
  invFun M := ⟨M.val.toLin',operator_selfAdjoint M⟩
  left_inv S := Subtype.ext (Matrix.toLin'_toMatrix' S.val)
  right_inv M := Subtype.ext (LinearMap.toMatrix'_toLin' M.val)
theorem standardMatrixEquiv_charpoly (n : ℕ)
    (S : SelfAdjointOperators (starRingAut : K ≃+* K) (standardHermitian (K:=K) n)) :
    (standardMatrixEquiv n S).val.charpoly=S.val.charpoly := by
  change S.val.toMatrix'.charpoly=S.val.charpoly
  rw [←Matrix.charpoly_toLin',Matrix.toLin'_toMatrix']
theorem window_constant_ne_zero {F : Type*} [Field F] [Fintype F] {D L : ℕ}
    (hD : 2 ≤ D) (z : Window F D L) : (windowPolynomial z).coeff 0≠0 := by
  intro hz
  have he : (X:F[X])=windowPolynomial z := Polynomial.eq_of_monic_of_associated
    monic_X z.2.val.property.1 (irreducible_X.associated_of_dvd z.2.property (X_dvd_iff.mpr hz))
  have hd := congrArg Polynomial.natDegree he
  rw [natDegree_X] at hd
  change 1=z.2.val.val.natDegree at hd
  rw [z.2.val.property.2] at hd
  have hlo := (Finset.mem_Icc.mp z.1.property).1
  omega
theorem matrix_spectral_failure_le
    (hcard : Nat.card K=Nat.card (fixedField (starRingAut : K ≃+* K))^2)
    (hstar : ∀ x : K,star x=x^Nat.card (fixedField (starRingAut : K ≃+* K)))
    (n b : ℕ) (hb : 1 ≤ b) (hbn : b ≤ n)
    (hlarge : (2:ℝ)^80*(1+Real.log (b:ℝ))^2 ≤ b) :
    let D := 4096*(Nat.ceil (Real.log (b:ℝ))+1)
    let L := b/(1024*(Nat.ceil (Real.log (b:ℝ))+1))
    density (fun H : selfAdjoint (Matrix (Fin n) (Fin n) K)=>
      NoPrimary (fun z : Window (fixedField (starRingAut : K ≃+* K)) D L=>
        (windowPolynomial z).map (algebraMap (fixedField (starRingAut : K ≃+* K)) K)) H.val) ≤
      (Real.exp 64+2)*(1+Real.log (b:ℝ))^2/b := by
  dsimp only
  let F := fixedField (starRingAut : K ≃+* K)
  let D := 4096*(Nat.ceil (Real.log (b:ℝ))+1)
  let L := b/(1024*(Nat.ceil (Real.log (b:ℝ))+1))
  let B := standardHermitian (K:=K) n
  have hnB : B.Nondegenerate := by
    have hl := standardHermitian_separating (K:=K) n
    exact ⟨hl,fun x hx=>hl x (fun y=>(standardHermitian_symm n).isRefl.eq_zero (hx y))⟩
  have hs := spectral_window_failure_le hcard hstar B (standardHermitian_symm n) hnB b hb (by simpa using hbn) hlarge
  have hc : Nat.card {S : SelfAdjointOperators (starRingAut : K ≃+* K) B //
      ∀ z : Window F D L,¬PrimaryEvent ((windowPolynomial z).map (algebraMap F K)) S.val}=
    Nat.card {H : selfAdjoint (Matrix (Fin n) (Fin n) K) //
      NoPrimary (fun z : Window F D L=>(windowPolynomial z).map (algebraMap F K)) H.val} := by
    apply Nat.card_congr
    apply (standardMatrixEquiv n).subtypeEquiv
    intro S
    simp only [NoPrimary,PrimaryEvent,standardMatrixEquiv_charpoly]
  have hfull := Nat.card_congr (standardMatrixEquiv (K:=K) n)
  change (Nat.card {S : SelfAdjointOperators (starRingAut : K ≃+* K) B //
      ∀ z : Window F D L,¬PrimaryEvent ((windowPolynomial z).map (algebraMap F K)) S.val}:ℝ)/
