namespace Mathproof.Problem18IMPFieldAddition20261001
open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Problem18IMPFieldLayout20261001 Problem18IMPModularArithmetic20261001
inductive PointOp | copy | add | neg | sub
  deriving DecidableEq
def pointValue : PointOp→Nat→Nat→Nat→Nat
  | .copy,_,a,_=>a
  | .add,p,a,b=>(a+b)%p
  | .neg,p,a,_=>(p-a)%p
  | .sub,p,a,b=>(a+p-b)%p
def pointExpr (op : PointOp) (x y p : Expr) : Expr :=
  match op with
  | .copy=>x
  | .add=>modExpr (.add x y) p
  | .neg=>modExpr (.sub p x) p
  | .sub=>modExpr (.sub (.add x p) y) p
def address (base idx : String) : Expr:=.add (.var base) (.var idx)
def pointBody (r : FieldNames) (op : PointOp) : Com:=
  .seq (.store r.mem (address r.outBase r.i)
    (pointExpr op (.get r.mem (address r.aBase r.i))
      (.get r.mem (address r.bBase r.i)) (.var r.p)))
    (.assign r.i (.add (.var r.i) (.lit 1)))
def pointRoutine (r : FieldNames) (op : PointOp) : Com:=
  .seq (.assign r.i (.lit 0)) (.while (.lt (.var r.i) (.var r.e)) (pointBody r op))
def copyRoutine (r : FieldNames) : Com:=pointRoutine r .copy
def negRoutine (r : FieldNames) : Com:=pointRoutine r .neg
def subRoutine (r : FieldNames) : Com:=pointRoutine r .sub
def eqBody (r : FieldNames) : Com:=
  .seq (.ite (.eq (.get r.mem (address r.aBase r.i)) (.get r.mem (address r.bBase r.i)))
    .skip (.assign r.flag (.lit 0))) (.assign r.i (.add (.var r.i) (.lit 1)))
def eqRoutine (r : FieldNames) : Com:=
  .seq (.assign r.flag (.lit 1)) (.seq (.assign r.i (.lit 0))
    (.while (.lt (.var r.i) (.var r.e)) (eqBody r)))
def writeValues (xs : List Nat) (base : Nat) (f : Nat→Nat) : Nat→List Nat
  | 0=>xs
  | n+1=>(writeValues xs base f n).set (base+n) (f n)
theorem writeValues_length (xs : List Nat) (base : Nat) (f : Nat→Nat) (n : Nat) :
    (writeValues xs base f n).length=xs.length := by
  induction n <;> simp_all [writeValues]
theorem getD_set_other (xs : List Nat) (i j v : Nat) (hj : j<xs.length) (hij : i≠j) :
    (xs.set i v).getD j 0=xs.getD j 0 := by
  rw [List.getD_eq_getElem _ _ (by simpa using hj),List.getD_eq_getElem _ _ hj]
  exact List.getElem_set_of_ne hij v _
theorem getD_set_same (xs : List Nat) (i v : Nat) (hi : i<xs.length) :
    (xs.set i v).getD i 0=v := by
  rw [List.getD_eq_getElem _ _ (by simpa using hi)]
  simp
theorem writeValues_outside (xs : List Nat) (base n j : Nat) (f : Nat→Nat)
    (hj : j<xs.length) (hout : j<base ∨ base+n ≤ j) :
    (writeValues xs base f n).getD j 0=xs.getD j 0 := by
  induction n with
  | zero=>rfl
  | succ n ih=>
    rw [writeValues,getD_set_other _ _ _ _ (by simpa [writeValues_length] using hj) (by omega)]
    exact ih (by omega)
theorem writeValues_inside (xs : List Nat) (base n j : Nat) (f : Nat→Nat)
    (hfit : base+n ≤ xs.length) (hj : j<n) :
    (writeValues xs base f n).getD (base+j) 0=f j := by
  induction n with
  | zero=>omega
  | succ n ih=>
    rw [writeValues]
    by_cases h:j=n
    · subst j
      exact getD_set_same _ _ _ (by rw [writeValues_length]; omega)
    · rw [getD_set_other _ _ _ _ (by rw [writeValues_length]; omega) (by omega)]
      exact ih (by omega) (by omega)
def pointState (σ : Env) (r : FieldNames) (f : Nat→Nat) (j : Nat) : Env:=
  { σ with vars := (fun x => if x=r.i then j else σ.vars x)
           arrs := (fun a => if a=r.mem then writeValues (σ.arrs r.mem) (σ.vars r.outBase) f j else σ.arrs a) }
theorem pointState_zero (σ : Env) (r : FieldNames) (f : Nat→Nat) :
    pointState σ r f 0=σ.setVar r.i 0 := by
  cases σ
  simp only [pointState,writeValues,Env.setVar]
  congr 1
  funext a
  split_ifs with h
  · subst a; rfl
  · rfl
theorem pointState_next (σ : Env) (r : FieldNames) (f : Nat→Nat) (j : Nat) :
    ((pointState σ r f j).setArr r.mem (σ.vars r.outBase+j) (f j)).setVar r.i (j+1)=
      pointState σ r f (j+1) := by
  cases σ
  simp only [pointState,Env.setArr,Env.setVar]
  congr 1
  · funext x; split_ifs <;> rfl
  · funext a; split_ifs with h
    · subst a; simp [writeValues]
    · rfl
theorem pointValue_lt (op : PointOp) {p a b : Nat} (hp : 0<p) (ha : a<p) :
    pointValue op p a b<p := by
  cases op
  · exact ha
  all_goals exact Nat.mod_lt _ hp
theorem pointExpr_evalB (op : PointOp) {B p a b : Nat} {σ : Env} {x y z : Expr}
    (hx : x.evalB B σ=some a) (hy : y.evalB B σ=some b) (hz : z.evalB B σ=some p)
    (ha : a<p) (hb : b<p) (hword : (p+1)^2<B) :
    (pointExpr op x y z).evalB B σ=some (pointValue op p a b) := by
  have hpB:=Expr.lt_of_evalB hz
  have hab:a+b<B:=by nlinarith
  have hap:a+p<B:=by nlinarith
  cases op with
  | copy=>exact hx
  | add=>exact modExpr_evalB (evalB_bin (op:=Bop.add) hx hy hab) hz
  | neg=>exact modExpr_evalB (evalB_bin (op:=Bop.sub) hz hx (by change p-a<B; omega)) hz
  | sub=>exact modExpr_evalB (evalB_bin (op:=Bop.sub)
      (evalB_bin (op:=Bop.add) hx hz hap) hy (by change a+p-b<B; omega)) hz
theorem getElem_some_getD (xs : List Nat) (j : Nat) (hj : j<xs.length) :
    xs[j]?=some (xs.getD j 0) := by
  rw [List.getElem?_eq_getElem hj,List.getD_eq_getElem _ _ hj]
def resultValues (σ : Env) (r : FieldNames) (op : PointOp) (j : Nat) : Nat:=
  pointValue op (σ.vars r.p) ((σ.arrs r.mem).getD (σ.vars r.aBase+j) 0)
    ((σ.arrs r.mem).getD (σ.vars r.bBase+j) 0)
theorem pointRoutine_run (r : FieldNames) (op : PointOp) {B : Nat} (σ : Env)
    (hregs : ∀x∈[r.p,r.e,r.aBase,r.bBase,r.outBase],x≠r.i)
    (hp : 0<σ.vars r.p) (he : σ.vars r.e<B)
    (hword : (σ.vars r.p+1)^2<B) (hmem : (σ.arrs r.mem).length<B)
    (ha : σ.vars r.aBase+σ.vars r.e ≤ (σ.arrs r.mem).length)
    (hb : σ.vars r.bBase+σ.vars r.e ≤ (σ.arrs r.mem).length)
    (ho : σ.vars r.outBase+σ.vars r.e ≤ (σ.arrs r.mem).length)
    (hda : σ.vars r.outBase+σ.vars r.e ≤ σ.vars r.aBase ∨
      σ.vars r.aBase+σ.vars r.e ≤ σ.vars r.outBase)
    (hdb : σ.vars r.outBase+σ.vars r.e ≤ σ.vars r.bBase ∨
      σ.vars r.bBase+σ.vars r.e ≤ σ.vars r.outBase)
    (hcoeff : ∀j<σ.vars r.e,(σ.arrs r.mem).getD (σ.vars r.aBase+j) 0<σ.vars r.p ∧
      (σ.arrs r.mem).getD (σ.vars r.bBase+j) 0<σ.vars r.p) :
    Run B (pointRoutine r op) σ
      (pointState σ r (resultValues σ r op) (σ.vars r.e)) (1000*(σ.vars r.e+1)) := by
  let f:=resultValues σ r op
  let states:=pointState σ r f
  have hv (j : Nat) (x : String) (hx : x∈[r.p,r.e,r.aBase,r.bBase,r.outBase]) :
      (states j).vars x=σ.vars x := by simp [states,pointState,hregs x hx]
  have hi (j : Nat) : (states j).vars r.i=j := by simp [states,pointState]
  have hlen (j : Nat) : ((states j).arrs r.mem).length=(σ.arrs r.mem).length := by
    simp [states,pointState,writeValues_length]
  have hpB:σ.vars r.p<B:=by nlinarith
  have hzero:0<B:=by omega
  have hstep : ∀j<σ.vars r.e,Run B (pointBody r op) (states j) (states (j+1)) 40 := by
    intro j hj
    have hjB:j<B:=by omega
    have hj1:j+1<B:=by omega
    have hjlenA:σ.vars r.aBase+j<(σ.arrs r.mem).length:=by omega
    have hjlenB:σ.vars r.bBase+j<(σ.arrs r.mem).length:=by omega
    have hjlenO:σ.vars r.outBase+j<(σ.arrs r.mem).length:=by omega
    have haddr (x : String) (hx : x∈[r.p,r.e,r.aBase,r.bBase,r.outBase])
        (hxj : σ.vars x+j<B) :
        (address x r.i).evalB B (states j)=some (σ.vars x+j) := by
      have hxB:σ.vars x<B:=by omega
      have hx' : (Expr.var x).evalB B (states j)=some (σ.vars x) := by
        simpa only [hv j x hx] using evalB_var (σ:=states j) (x:=x) (by rw [hv j x hx]; exact hxB)
      have hi' : (Expr.var r.i).evalB B (states j)=some j := by
        simpa only [hi j] using evalB_var (σ:=states j) (x:=r.i) (by rw [hi]; exact hjB)
      exact evalB_bin (op:=Bop.add) hx' hi' hxj
    have hreadA : ((states j).arrs r.mem).getD (σ.vars r.aBase+j) 0=
        (σ.arrs r.mem).getD (σ.vars r.aBase+j) 0 := by
      simpa [states,pointState] using
        writeValues_outside (σ.arrs r.mem) (σ.vars r.outBase) j (σ.vars r.aBase+j) f hjlenA (by omega)
    have hreadB : ((states j).arrs r.mem).getD (σ.vars r.bBase+j) 0=
        (σ.arrs r.mem).getD (σ.vars r.bBase+j) 0 := by
      simpa [states,pointState] using
        writeValues_outside (σ.arrs r.mem) (σ.vars r.outBase) j (σ.vars r.bBase+j) f hjlenB (by omega)
    have hlookupA:=getElem_some_getD ((states j).arrs r.mem) (σ.vars r.aBase+j) (by rw [hlen]; exact hjlenA)
    have hlookupB:=getElem_some_getD ((states j).arrs r.mem) (σ.vars r.bBase+j) (by rw [hlen]; exact hjlenB)
    rw [hreadA] at hlookupA
    rw [hreadB] at hlookupB
    have hxa:=evalB_get (haddr r.aBase (by simp) (by omega)) hlookupA ((hcoeff j hj).1.trans hpB)
    have hxb:=evalB_get (haddr r.bBase (by simp) (by omega)) hlookupB ((hcoeff j hj).2.trans hpB)
    have hxp : (Expr.var r.p).evalB B (states j)=some (σ.vars r.p) := by
      simpa only [hv j r.p (by simp)] using
        evalB_var (σ:=states j) (x:=r.p) (by rw [hv j r.p (by simp)]; exact hpB)
    have hexpr:=pointExpr_evalB op hxa hxb hxp (hcoeff j hj).1 (hcoeff j hj).2 hword
    have hout:=Run.store (a:=r.mem) (haddr r.outBase (by simp) (by omega)) hexpr (by rw [hlen]; exact hjlenO)
    let τ:=(states j).setArr r.mem (σ.vars r.outBase+j) (f j)
    have hτi:τ.vars r.i=j := by simpa [τ] using hi j
    have hinc : (Expr.add (.var r.i) (.lit 1)).evalB B τ=some (j+1) := by
      have hv' : (Expr.var r.i).evalB B τ=some j := by
        simpa only [hτi] using evalB_var (σ:=τ) (x:=r.i) (by rw [hτi]; exact hjB)
      exact evalB_bin (op:=Bop.add) hv' (evalB_lit (by omega)) hj1
    have hrun:=hout.seq (Run.assign (x:=r.i) hinc)
    have hfinal : τ.setVar r.i (j+1)=states (j+1) := pointState_next σ r f j
    apply (hrun.congr hfinal).mono
    cases op <;> norm_num [pointExpr,address,modExpr,Expr.size]
  have hloop:=countedLoop_run r.i r.e (pointBody r op) states
    (fun j _=>hi j) (fun j _=>hv j r.e (by simp)) he hstep
  have hinit : Run B (.assign r.i (.lit 0)) σ (states 0) 2 := by
    simpa only [states,pointState_zero,Expr.size] using Run.assign (x:=r.i) (σ:=σ) (evalB_lit hzero)
  exact (hinit.seq hloop).mono (by omega)
end Mathproof.Problem18IMPFieldAddition20261001
