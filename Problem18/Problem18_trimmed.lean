open Problem18IMPPolynomialCompiler20261001 Lax51.BinaryWordEncoding Lax51.RamPolytime
def guards : List Cond → Com → Com
  | [],yes=>yes
  | c::cs,yes=>.ite c (guards cs yes) (.write (.lit 0))
def guardsCost (cs : List Cond) : Nat := (cs.map (fun c=>1+c.size)).sum
theorem guards_run (B : Nat) (σ : Env) (cs : List Cond) (bs : List Bool)
    (he : List.Forall₂ (fun c b=>c.evalB B σ=some b) cs bs) (hB : 0<B)
    (yes : Com) (T : Nat) (tail : List Nat)
    (hy : bs.all id=true → ∃τ,Run B yes σ τ T ∧ τ.out=σ.out++tail) :
    ∃τ,Run B (guards cs yes) σ τ (guardsCost cs+T+2) ∧
      τ.out=σ.out++(if bs.all id then tail else [0]) := by
  induction he with
  | nil=>
    obtain ⟨τ,hr,ho⟩:=hy rfl
    exact ⟨τ,hr.mono (by simp [guardsCost]),ho⟩
  | cons hc ht ih=>
    rename_i c b cs bs
    cases b with
    | false=>
      have hw:=Run.write (σ:=σ) (evalB_lit hB)
      refine ⟨_,(Run.ite_false hc hw).mono ?_,?_⟩
      · simp [guardsCost,Expr.size]; omega
      · simp
    | true=>
      obtain ⟨τ,hr,ho⟩:=ih (by simpa using hy)
      refine ⟨τ,(Run.ite_true hc hr).mono ?_,?_⟩
      · simp [guardsCost]; omega
      · simpa using ho
def headerNames : List String := ["tag","u","q","p","e","a","b","c"]
def expected : Expr := .add (.var "e")
  (.mul (.mul (.mul (.mul (.add (.var "tag") (.lit 1)) (.var "a")) (.var "b")) (.var "c")) (.var "e"))
def headerGuards : List Cond :=
  [.lt (.var "tag") (.lit 2),.lt (.var "u") (.lit 2),.lt (.lit 1) (.var "p"),
   .lt (.lit 0) (.var "e"),.lt (.lit 0) (.var "a"),.lt (.lit 0) (.var "b"),
   .lt (.lit 0) (.var "c"),.eq (.var "left") expected]
def acceptScan : Com := .seq (.assign "ok" (.lit 1)) (.seq scan (.write (.var "ok")))
def headerBody : Com := .seq (readFields headerNames)
  (.seq (.assign "left" (.sub (.var "len") (.lit 8))) (guards headerGuards acceptScan))
def validator : Com := .seq (.read "len")
  (.ite (.lt (.var "len") (.lit 8)) (.write (.lit 0)) headerBody)
def validatorLayout : Layout := ⟨["len","tag","u","q","p","e","a","b","c","left","ok","v"],[],64⟩
def validate : List Nat → List Nat
  | tag::u::q::p::e::a::b::c::data =>
    let head:=[tag,u,q,p,e,a,b,c]
    if tag≤1 ∧ u≤1 ∧ 2≤p ∧ 0<e ∧ 0<a ∧ 0<b ∧ 0<c ∧
        data.length=e+(tag+1)*(a*b*c*e) then
      head++data++[if ∀v∈data,v<p then 1 else 0]
    else head++[0]
  | _=>[0]
theorem validator_ok : Com.Ok validatorLayout validator := by
  simp [validatorLayout,validator,headerBody,headerNames,readFields,guards,headerGuards,
    expected,acceptScan,scan,scanBody,echoRead,Com.Ok,Cond.Ok,Expr.Ok,condExpr]
theorem acceptScan_run (B p : Nat) (xs : List Nat) (σ : Env)
    (hB : 1<B) (hp : p<B) (hi : σ.inp=xs) (hl : σ.vars "left"=xs.length)
    (hpp : σ.vars "p"=p) (hlen : xs.length<B) (hv : ∀v∈xs,v<B) :
    ∃τ,Run B acceptScan σ τ (30*xs.length+20) ∧
      τ.out=σ.out++xs++[if ∀v∈xs,v<p then 1 else 0] := by
  have hi' : (σ.setVar "ok" 1).inp=xs:=hi
  obtain ⟨τ,ht,ho,hp',hl',hout⟩:=scan_run B p xs (σ.setVar "ok" 1) hB hp hi'
    (by simpa using hl) (by simpa using hpp) hlen hv
  have hok : τ.vars "ok"<B := by rw [ho]; split_ifs <;> simp_all <;> omega
  have ha:=Run.assign (x:="ok") (σ:=σ) (evalB_lit hB)
  have hw:=Run.write (σ:=τ) (evalB_var hok)
  refine ⟨_,(ha.seq (ht.seq hw)).mono ?_,?_⟩
  · simp [Expr.size]; omega
  · simp [hout,ho]
theorem expected_eval (B M : Nat) (σ : Env) (hM : 2≤M)
    (hB : M^6<B) (hv : ∀x∈["e","tag","a","b","c"],σ.vars x<M) :
    expected.evalB B σ=some (σ.vars "e"+(σ.vars "tag"+1)*σ.vars "a"*σ.vars "b"*σ.vars "c"*σ.vars "e") := by
  have hpow (j : Nat) (hj : j≤6) : M^j<B:=
    (Nat.pow_le_pow_right (by omega) hj).trans_lt hB
  have hm : M<B:=by simpa using hpow 1 (by omega)
  have he:=hv "e" (by simp)
  have ht:=hv "tag" (by simp)
  have ha:=hv "a" (by simp)
  have hb:=hv "b" (by simp)
  have hc:=hv "c" (by simp)
  have h1 : σ.vars "tag"+1≤M:=by omega
  have h2 : (σ.vars "tag"+1)*σ.vars "a"≤M^2:=by
    simpa [pow_two] using Nat.mul_le_mul h1 ha.le
  have h3 : (σ.vars "tag"+1)*σ.vars "a"*σ.vars "b"≤M^3:=by
    simpa [pow_succ] using Nat.mul_le_mul h2 hb.le
  have h4 : (σ.vars "tag"+1)*σ.vars "a"*σ.vars "b"*σ.vars "c"≤M^4:=by
    simpa [pow_succ] using Nat.mul_le_mul h3 hc.le
  have h5 : (σ.vars "tag"+1)*σ.vars "a"*σ.vars "b"*σ.vars "c"*σ.vars "e"≤M^5:=by
    simpa [pow_succ] using Nat.mul_le_mul h4 he.le
  have h6 : σ.vars "e"+(σ.vars "tag"+1)*σ.vars "a"*σ.vars "b"*σ.vars "c"*σ.vars "e"≤M^6:=by
    have hM5 : M≤M^5:=by simpa using Nat.pow_le_pow_right (by omega : 1≤M) (show 1≤5 by omega)
    have hsum:=Nat.add_le_add (he.le.trans hM5) h5
    have hh : M^5+M^5≤M^6:=by rw [pow_succ]; nlinarith
    exact hsum.trans hh
  simp only [expected,evalB_bin_iff,evalB_var_iff,evalB_lit_iff,Bop.apply_add,Bop.apply_mul]
  exact ⟨_,_,⟨rfl,he.trans hm⟩,⟨_,_,⟨_,_,⟨_,_,⟨_,_,⟨_,_,⟨rfl,ht.trans hm⟩,
    ⟨rfl,by omega⟩,rfl,h1.trans_lt hm⟩,⟨rfl,ha.trans hm⟩,rfl,h2.trans_lt (hpow 2 (by omega))⟩,
    ⟨rfl,hb.trans hm⟩,rfl,h3.trans_lt (hpow 3 (by omega))⟩,⟨rfl,hc.trans hm⟩,rfl,h4.trans_lt (hpow 4 (by omega))⟩,
    ⟨rfl,he.trans hm⟩,rfl,h5.trans_lt (hpow 5 (by omega))⟩,rfl,h6.trans_lt hB⟩
def headerBools (σ : Env) : List Bool :=
  [decide (σ.vars "tag"<2),decide (σ.vars "u"<2),decide (1<σ.vars "p"),
   decide (0<σ.vars "e"),decide (0<σ.vars "a"),decide (0<σ.vars "b"),decide (0<σ.vars "c"),
   σ.vars "left" == σ.vars "e"+(σ.vars "tag"+1)*σ.vars "a"*σ.vars "b"*σ.vars "c"*σ.vars "e"]
theorem header_eval (B M : Nat) (σ : Env) (hM : 2≤M) (hB : M^6<B)
    (hv : ∀x,σ.vars x<M) :
    List.Forall₂ (fun c b => c.evalB B σ=some b) headerGuards (headerBools σ) := by
  have hm : M<B := (show M≤M^6 by simpa using Nat.pow_le_pow_right (by omega : 1≤M) (show 1≤6 by omega)).trans_lt hB
  have htwo : 2<B := lt_of_le_of_lt hM hm
  have hvar (x : String) : σ.vars x<B := (hv x).trans hm
  have he:=expected_eval B M σ hM hB (fun x _=>hv x)
  simp only [headerGuards,headerBools,List.forall₂_cons]
  refine ⟨?_,?_,?_,?_,?_,?_,?_,?_,List.Forall₂.nil⟩
  all_goals simp [evalB_condLt_iff,evalB_condEq_iff,hvar,he,htwo,show 1<B by omega,show 0<B by omega]
theorem guarded_scan_run (B M : Nat) (σ : Env) (xs : List Nat)
    (hM : 2≤M) (hB : M^6<B) (hv : ∀x,σ.vars x<M)
    (hi : σ.inp=xs) (hl : σ.vars "left"=xs.length) (hxs : ∀v∈xs,v<M) :
    ∃τ,Run B (guards headerGuards acceptScan) σ τ (30*xs.length+200) ∧
      τ.out=σ.out++(if (headerBools σ).all id then xs++[if ∀v∈xs,v<σ.vars "p" then 1 else 0] else [0]) := by
  have hm : M<B := (show M≤M^6 by simpa using Nat.pow_le_pow_right (by omega : 1≤M) (show 1≤6 by omega)).trans_lt hB
  have hyes := acceptScan_run B (σ.vars "p") xs σ (by omega) ((hv "p").trans hm)
    hi hl rfl (by rw [←hl]; exact (hv "left").trans hm) (fun v h=>(hxs v h).trans hm)
  obtain ⟨τ,hr,ho⟩:=guards_run B σ headerGuards (headerBools σ) (header_eval B M σ hM hB hv)
    (by omega) acceptScan (30*xs.length+20) (xs++[if ∀v∈xs,v<σ.vars "p" then 1 else 0]) (fun _=>by simpa [List.append_assoc] using hyes)
  refine ⟨τ,hr.mono ?_,?_⟩
  · norm_num [guardsCost,headerGuards,expected,Expr.size,Cond.size]; omega
  · rw [ho]
theorem readEnv_bounded (names : List String) (values : List Nat) (σ : Env) (M : Nat)
    (hv : ∀v∈values,v<M) (hσ : ∀x,σ.vars x<M) :
    ∀x,(readEnv names values σ).vars x<M := by
  induction names generalizing values σ with
  | nil=>exact hσ
  | cons name names ih=>
    cases values with
    | nil=>exact hσ
    | cons v vs=>
      apply ih vs _ (fun v h=>hv v (by simp [h]))
      intro x
      simp only [Env.setVar]
      split_ifs <;> first | exact hv v (by simp) | exact hσ x
theorem header_exists (xs : List Nat) (h : 8≤xs.length) :
    ∃tag u q p e a b c data,xs=tag::u::q::p::e::a::b::c::data := by
  cases xs with
  | nil=>simp at h
  | cons tag xs=>
    cases xs with
    | nil=>simp at h
    | cons u xs=>
      cases xs with
      | nil=>simp at h
      | cons q xs=>
        cases xs with
        | nil=>simp at h
        | cons p xs=>
          cases xs with
          | nil=>simp at h
          | cons e xs=>
            cases xs with
            | nil=>simp at h
            | cons a xs=>
              cases xs with
              | nil=>simp at h
              | cons b xs=>
                cases xs with
                | nil=>simp at h
                | cons c xs=>
                  exact ⟨tag,u,q,p,e,a,b,c,xs,rfl⟩
theorem short_validate (xs : List Nat) (h : xs.length<8) : validate xs=[0] := by
  unfold validate
  split
  · simp only [List.length_cons] at h
    omega
  · rfl
theorem validator_run (B M : Nat) (xs : List Nat) (hM : 9≤M) (hB : M^6<B)
    (hlen : xs.length<M) (hv : ∀v∈xs,v<M) :
    ∃τ,Run B validator (initEnv (fun _=>0) (xs.length::xs)) τ (30*xs.length+400) ∧
      τ.out=validate xs := by
  let σ := initEnv (fun _=>0) (xs.length::xs)
  let σ₁ : Env:={σ.setVar "len" xs.length with inp:=xs}
  have hm : M<B := (show M≤M^6 by simpa using Nat.pow_le_pow_right (by omega : 1≤M) (show 1≤6 by omega)).trans_lt hB
  have hr : Run B (.read "len") σ σ₁ 1:=Run.read rfl
  have ht : (Cond.lt (.var "len") (.lit 8)).evalB B σ₁=some (decide (xs.length<8)) := by
    simp [evalB_condLt_iff,σ₁,hlen.trans hm]; omega
  by_cases hshort : xs.length<8
  · have hw:=Run.write (σ:=σ₁) (evalB_lit (by omega : 0<B))
    have hh:=hr.seq (Run.ite_true (b:=.lt (.var "len") (.lit 8)) (d:=headerBody)
      (by simpa only [hshort,decide_true] using ht) hw)
    refine ⟨_,hh.mono (by simp [Expr.size,Cond.size] <;> omega),?_⟩
    simp [σ₁,σ,initEnv,short_validate xs hshort]
  · obtain ⟨tag,u,q,p,e,a,b,c,data,rfl⟩:=header_exists xs (by omega)
    let σ₂ : Env:= {readEnv headerNames (tag::u::q::p::e::a::b::c::data) σ₁ with out:=[tag,u,q,p,e,a,b,c]}
    let σ₃ := σ₂.setVar "left" data.length
    have hrh:=readFields_run headerNames (tag::u::q::p::e::a::b::c::data) σ₁
      (by simp [headerNames]) rfl B (fun v h=>(hv v h).trans hm)
    have hσ₁ : ∀x,σ₁.vars x<M := by
      intro x
      simp only [σ₁,Env.setVar]
      split_ifs <;> first | exact hlen | exact (by dsimp [σ,initEnv]; omega)
    have hσ₂ : ∀x,σ₂.vars x<M:=readEnv_bounded headerNames _ _ _ hv hσ₁
    have hdata : data.length<M:=by simp only [List.length_cons] at hlen; omega
    have hσ₃ : ∀x,σ₃.vars x<M := by
      intro x
      simp only [σ₃,Env.setVar]
      split_ifs <;> first | exact hdata | exact hσ₂ x
    have hlength : data.length+8<M:=by simpa only [List.length_cons,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using hlen
    have hd : (Expr.sub (.var "len") (.lit 8)).evalB B σ₂=some data.length := by
      simp [evalB_bin_iff,σ₂,readEnv,headerNames,σ₁,σ,initEnv,Bop.apply]
      constructor <;> omega
    have ha:=Run.assign (x:="left") hd
    have hinput : σ₃.inp=data:=rfl
    obtain ⟨τ,hg,hout⟩:=guarded_scan_run B M σ₃ data (by omega) hB hσ₃ hinput
      (by simp [σ₃]) (fun v h=>hv v (by simp [h]))
    have hbody:=hrh.seq (ha.seq hg)
    have hh:=hr.seq (Run.ite_false (b:=.lt (.var "len") (.lit 8)) (c:=.write (.lit 0))
      (by simpa only [hshort,decide_false] using ht) hbody)
    refine ⟨τ,hh.mono ?_,?_⟩
    · simp [headerNames,Expr.size,Cond.size]; omega
    · rw [hout]
      simp [σ₃,σ₂,σ₁,σ,readEnv,headerNames,initEnv,headerBools,validate,parseNumbers,
        ParsedInput.Valid,Nat.lt_succ_iff,Nat.succ_le_iff,mul_assoc,and_assoc] <;> split_ifs <;> simp_all
theorem validate_ramPolytime : RamPolytime validate := by
  apply ramPolytime_of_bounded_imp validatorLayout validator validate
    (7*Polynomial.X+60) (30*Polynomial.X+400) validator_ok
  intro xs
  let n:=bitSize xs
  let M:=2^(n+4)
  let B:=2^(8*n+61)
  have hM : 9≤M := by
    have hh : 2^4≤M:=Nat.pow_le_pow_right (by omega) (by omega)
    norm_num at hh
    omega
  have hB : M^6<B := by
    dsimp [M,B]
    rw [←pow_mul]
    exact Nat.pow_lt_pow_right (by omega) (by omega)
  have hpow : 2^(n+1)≤M:=Nat.pow_le_pow_right (by omega) (by omega)
  have hlen : xs.length<M:=
    (Lax51Proofs.Encoding.length_lt_two_pow_bitSize_add_one xs).trans_le hpow
  have hv : ∀v∈xs,v<M:=fun v h=>
    (Lax51Proofs.Encoding.mem_lt_two_pow_bitSize_add_one h).trans_le hpow
  obtain ⟨τ,hr,ho⟩:=validator_run B M xs hM hB hlen hv
  have hcost : 30*xs.length+400≤30*n+400:=by
    have hh:=Lax51Proofs.Encoding.length_le_bitSize xs
    dsimp [n]
    omega
  refine ⟨(fun _=>0),τ,?_,ho⟩
  convert hr.mono hcost using 1
  · dsimp [B]
    congr 1
    simp [n]
    omega
  · simp [n]
end Mathproof.Problem18RootRetainedHeaderIMP20261001
