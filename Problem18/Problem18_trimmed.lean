variable {N : Nat} {K : Type*} [Field K]
def observePolynomial (B : Nat) : MvPolynomial (Fin N) K →ₗ[K]
    (Fin (boundedExponents N B).length → K) where
  toFun f i := coeff ((boundedExponents N B)[i.val]) f
  map_add' f g := by funext i; exact coeff_add _ _ _
  map_smul' c f := by funext i; exact coeff_smul _ _ _
theorem observePolynomial_injective_bounded (B : Nat)
    (f g : MvPolynomial (Fin N) K) (hf : f.totalDegree ≤ B) (hg : g.totalDegree ≤ B)
    (heq : observePolynomial B f = observePolynomial B g) : f = g := by
  apply coefficients_determine_bounded_polynomial f g hf hg
  intro a ha
  have hpos := List.idxOf_lt_length_of_mem ha
  have h := congrFun heq ⟨(boundedExponents N B).idxOf a,hpos⟩
  simpa only [observePolynomial,LinearMap.coe_mk,AddHom.coe_mk,List.getElem_idxOf hpos] using h
def polynomialRows (E : Nat) (fs : List (MvPolynomial (Fin N) K)) :
    List (MvPolynomial (Fin N) K) :=
  fs.flatMap fun f => (multiplierExponents N E).map (fun a => monomial a (1 : K)*f)
theorem polynomialRows_span [DecidableEq K] (E : Nat) (fs : List (MvPolynomial (Fin N) K)) :
    rowSpan (K := K) (polynomialRows E fs) = macaulaySpan (fs.toFinset : Set _) E := by
  classical
  rw [rowSpan,macaulaySpan_eq_monomial_span]
  congr 1
  ext z
  simp only [polynomialRows,List.mem_flatMap,List.mem_map,Finset.mem_coe,List.mem_toFinset,
    mem_multiplierExponents_iff,Set.mem_setOf_eq]
  constructor
  · rintro ⟨f,hf,a,ha,rfl⟩
    exact ⟨f,hf,a,ha,rfl⟩
  · rintro ⟨f,hf,a,ha,rfl⟩
    exact ⟨f,hf,a,ha,rfl⟩
theorem macaulayRows_read (d E : Nat)
    (vs : List (DenseInput N d K)) (fs : List (MvPolynomial (Fin N) K))
    (hvalid : List.Forall₂ (ValidDenseInput d) vs fs) :
    (macaulayRows d E vs).map read =
      (polynomialRows E fs).map (observePolynomial (d+E)) := by
  induction hvalid with
  | nil => simp [macaulayRows,polynomialRows]
  | @cons v f vs fs hv hvalid ih =>
      simp only [macaulayRows,polynomialRows,List.flatMap_cons,List.map_append,List.map_map] at *
      rw [ih]
      congr 1
      apply List.map_congr_left
      intro a ha
      exact shiftedRow_correct d (d+E) v f hv a
theorem macaulay_span_degree (d E : Nat)
    (F : Set (MvPolynomial (Fin N) K)) (hF : ∀ f ∈ F, f.totalDegree ≤ d)
    {p : MvPolynomial (Fin N) K} (hp : p ∈ macaulaySpan F E) :
    p.totalDegree ≤ d+E := by
  induction hp using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨f,hf,q,hq,rfl⟩ := hz
      exact (totalDegree_mul q f).trans (by have h := hF f hf; omega)
  | zero => simp
  | add x y hx hy ihx ihy =>
      exact (totalDegree_add x y).trans (max_le ihx ihy)
  | smul c x hx ih => exact (totalDegree_smul_le c x).trans ih
theorem unitIdealCheck_correct [DecidableEq K] (d : Nat)
    (vs : List (DenseInput N d K)) (fs : List (MvPolynomial (Fin N) K))
    (hvalid : List.Forall₂ (ValidDenseInput d) vs fs) :
    (unitIdealCheck d vs).1 = true ↔
      (1 : MvPolynomial (Fin N) K) ∈ generatedIdeal (fs.toFinset : Set _) := by
  classical
  let E := 2*d*2^(controlledDepth N d)
  have hall : ∀ g ∈ fs, g.totalDegree ≤ d := by
    induction hvalid with
    | nil => simp
    | @cons v g vs fs hv hvalid ih =>
        intro p hp
        rcases List.mem_cons.mp hp with rfl | hp
        · exact hv.1
        · exact ih p hp
  have hF : ∀ f ∈ fs.toFinset, f.totalDegree ≤ d :=
    fun f hf => hall f (List.mem_toFinset.mp hf)
  have htarget : read (constantRow N (d+E) : Vector K _) = observePolynomial (d+E) 1 := by
    rw [constantRow,read_ofFn]
    funext i
    simp [observePolynomial,coeff_one,eq_comm]
  have hrowspan : rowSpan (K := K) ((macaulayRows d E vs).map read) =
      (macaulaySpan (fs.toFinset : Set _) E).map (observePolynomial (d+E)) := by
    rw [macaulayRows_read d E vs fs hvalid,← polynomialRows_span E fs]
    simp only [rowSpan,Submodule.map_span]
    congr 1
    ext x
    simp
  change (spanCheck (macaulayRows d E vs) (constantRow N (d+E))).1 = true ↔ _
  rw [spanCheck_iff,htarget,hrowspan,one_mem_ideal_iff_uniform_macaulay fs.toFinset d hF]
  constructor
  · rintro ⟨p,hp,heq⟩
    have hpdeg : p.totalDegree ≤ d+E :=
      macaulay_span_degree (N := N) (K := K) d E (fs.toFinset : Set (MvPolynomial (Fin N) K)) hF (p := p) hp
    have hp1 : p = 1 := observePolynomial_injective_bounded (d+E) p 1 hpdeg (by simp) heq
    simpa [hp1] using hp
  · intro h
    exact ⟨1,h,rfl⟩
