          (Fintype.card (constraintKernel g.val) : ℂ)‖^2)^(b-d)) /
      Nat.card (InjectiveSample K (Module.Dual K (Fin a → Fin b → K)) d) ≤
      64 * (b-1 : ℕ) * (d+1 : ℕ) * ((Fintype.card K : ℝ)^(2*b/5))⁻¹ +
      4 * (Fintype.card K : ℝ)^(b+d) / (Fintype.card K : ℝ)^(a*b) := by
  simp_rw [nontrivial_character_energy_eq _ ψ hψ]
  exact conditioned_completion_energy_average_le a b d ha hb hdb ψ hψ
theorem injectiveSample_nonempty (a b d : ℕ) (hd : d ≤ a*b) :
    Nonempty (InjectiveSample K (Module.Dual K (Fin a → Fin b → K)) d) := by
  have hdim : Module.finrank K (Fin d → K) ≤
      Module.finrank K (Module.Dual K (Fin a → Fin b → K)) := by
    simpa [Subspace.dual_finrank_eq, Module.finrank_pi_fintype] using hd
  obtain ⟨g,hg⟩ := finrank_le_iff_exists_linearMap.mp hdim
  exact ⟨⟨g,hg⟩⟩
noncomputable def energyBound (K : Type*) [Fintype K] (a b d : ℕ) : ℝ :=
  64 * (b-1 : ℕ) * (d+1 : ℕ) * ((Fintype.card K : ℝ)^(2*b/5))⁻¹ +
