  change ((aeval S ((Polynomial.degreeLT.basis K n j):K[X])) v) i=((S^j.val) v) i
  rw [Polynomial.degreeLT.basis_val,aeval_X_pow]
theorem krylovMatrix_isUnit_det (S : Module.End K (Fin n→K)) (v : Fin n→K)
