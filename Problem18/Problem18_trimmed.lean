variable {σ K L : Type*} [Finite σ] [Field K] [Fintype K] [Field L]
  [Algebra K L] [Algebra.IsAlgebraic K L]
theorem exists_nonzero_bounded_relation (I : Ideal (MvPolynomial σ L)) (D : Nat)
    (hI : I.comap (MvPolynomial.map
      (FiniteField.frobeniusAlgEquivOfAlgebraic K L).toRingEquiv.toRingHom) = I)
    (f : MvPolynomial σ L) (hf : f ≠ 0) (hfI : f ∈ I) (hfD : f.totalDegree ≤ D) :
    ∃ g : MvPolynomial σ K, g ≠ 0 ∧ g.totalDegree ≤ D ∧
      MvPolynomial.map (algebraMap K L) g ∈ I := by
  classical
  obtain ⟨gs, hgs, hspan⟩ := exists_bounded_equations_of_comap I D hI
  have hex : ∃ g ∈ gs, g ≠ 0 := by
    by_contra hn
    push_neg at hn
    have hzero : Ideal.span (MvPolynomial.map (algebraMap K L) ''
        (gs : Set (MvPolynomial σ K))) = ⊥ := by
      apply bot_unique
      apply Ideal.span_le.mpr
      rintro p ⟨g, hg, rfl⟩
      simp [hn g hg]
    have hmem : f ∈ Ideal.span {p | p ∈ I ∧ p.totalDegree ≤ D} :=
      Ideal.subset_span ⟨hfI, hfD⟩
    rw [← hspan, hzero, Ideal.mem_bot] at hmem
    exact hf hmem
  obtain ⟨g, hg, hg0⟩ := hex
  exact ⟨g, hg0, (hgs g hg).1, (hgs g hg).2⟩
end Mathproof.Problem18BoundedRelationDescent20261001
