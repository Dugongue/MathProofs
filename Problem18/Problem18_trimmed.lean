      (∀ i < Nv, val F r q.WS τ (ov + i) =
        if i = Nv - 1 - dv then (1 : K)
        else if Nv - 1 - i < dv then val F r q.WS σ (sv + (Nv - 1 - i)) else 0) ∧
      (∀ s < Sn, (s < ov ∨ ov + Nv ≤ s) → val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ≠ q.j → x ≠ q.N → x ≠ a.k → x ≠ a.ci →
