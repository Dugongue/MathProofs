theorem subspace_card_bound (n k : ℕ) (hk : k ≤ n) :
    (Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = k} : ℝ) ≤
      4 * (Fintype.card K : ℝ) ^ (k * (n - k)) := by
  classical
  let S := {W : Submodule K (Fin n → K) // Module.finrank K W = k}
  let B := {M : Matrix (Fin k) (Fin k) K // M.rank = k}
  let R := {M : Matrix (Fin k) (Fin n) K // M.rank = k}
  have he : Nat.card S * Nat.card B = Nat.card R := by
    dsimp only [S, B, R]
    rw [Mathproof.Problem18RankDensity20260929.fullRowRank_card (Nat.le_refl k),
      Mathproof.Problem18RankDensity20260929.fullRowRank_card hk]
    exact subspace_card_mul_bases hk
  have htotal (a b : ℕ) : Nat.card (Matrix (Fin a) (Fin b) K) =
      Fintype.card K ^ (a * b) := by
    simp [Matrix, Nat.card_eq_fintype_card, ← pow_mul, Nat.mul_comm]
  have hr : Nat.card R ≤ Fintype.card K ^ (k * n) := by
    rw [← htotal k n]
    exact Nat.card_le_card_of_injective Subtype.val Subtype.val_injective
  have hb : (1 / 4 : ℝ) * (Fintype.card K : ℝ) ^ (k * k) ≤ Nat.card B := by
    have hP := fullRowRank_density_ge_quarter (K := K) (d := k) (n := k) (Nat.le_refl k)
    rw [htotal k k, Nat.cast_pow] at hP
    exact (le_div_iff₀ (by positivity)).mp hP
  have her : (Nat.card S : ℝ) * Nat.card B = (Nat.card R : ℝ) := by
    exact_mod_cast he
  have hrr : (Nat.card R : ℝ) ≤ (Fintype.card K : ℝ) ^ (k * n) := by
    exact_mod_cast hr
  have hh : (Nat.card S : ℝ) * ((1 / 4 : ℝ) * (Fintype.card K : ℝ) ^ (k * k)) ≤
      (Fintype.card K : ℝ) ^ (k * n) := by
    calc
      _ ≤ (Nat.card S : ℝ) * Nat.card B :=
        mul_le_mul_of_nonneg_left hb (by positivity)
      _ = _ := her
      _ ≤ _ := hrr
  have hepow : (Fintype.card K : ℝ) ^ (k * n) =
      (Fintype.card K : ℝ) ^ (k * (n - k)) *
        (Fintype.card K : ℝ) ^ (k * k) := by
    rw [← pow_add]
    congr 1
    rw [← Nat.mul_add, Nat.sub_add_cancel hk]
  calc
    _ ≤ (Fintype.card K : ℝ) ^ (k * n) /
        ((1 / 4 : ℝ) * (Fintype.card K : ℝ) ^ (k * k)) :=
      (le_div_iff₀ (by positivity)).2 hh
    _ = _ := by
      have hq : (Fintype.card K : ℝ) ≠ 0 := by positivity
      rw [hepow]
      field_simp
end Mathproof.Problem18Grassmann20260929
