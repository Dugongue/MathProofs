  have hp:σ.vars r.p<B:=by have hw:=h.arithmetic_word; nlinarith
  have hone:1<B:=by have hw:=h.arithmetic_word; nlinarith
  have heval : (Expr.var r.e).evalB B σ=some (σ.vars r.e) := evalB_var he
  have hidx : (Expr.sub (.var r.e) (.lit 1)).evalB B σ=some (σ.vars r.e-1) :=
