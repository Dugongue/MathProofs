theorem nilradical_isPrime_tensor_of
    (hE : ∀ a : F, IsIntegral E a → a ∈ Set.range (algebraMap E F))
    {Eb Ω : Type*} [Field Eb] [IsAlgClosed Eb] [Algebra E Eb] [Algebra.IsAlgebraic E Eb]
    [Field Ω] [Algebra E Ω] [Algebra Eb Ω] [IsScalarTower E Eb Ω] :
    (nilradical (Ω ⊗[E] F)).IsPrime := by
