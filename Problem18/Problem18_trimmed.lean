namespace Mathproof.Problem18LargeDecision20261001
open Matrix FiniteFieldOrthogonalUnitaryTI
open Problem18OrthogonalAssembly (RectTensor rectAction)
open Problem18LargeSourcePredicate20261001 Problem18TwoIntertwinerRecovery20261001
open Problem18LargeRecoveryCriterion20261001 Problem18LargeFinalChecks20261001
open Problem18ExecutableIntertwiner20261001 Problem18ExecutableAlgebra20261001
variable {K : Type*} [Field K] [DecidableEq K] [StarRing K] {a b c : ℕ}
def largeCheck (ha : 0 < a) (hb : 0 < b) (u : Bool) (char card : ℕ)
    (A B : RectTensor a b c K) : Bool :=
  match firstSolution A B with
  | none=>false
  | some X=>match secondSolution hb A B X with
    | none=>false
    | some Y=>
      let dx:=gramScalar hb X
      let dy:=gramScalar ha Y
      let H:=outerImage A Y X
      if u then unitaryFinal H B (dy*dx)
      else if char=2 then charTwoFinal card H B (dy*dx)
      else oddNormalizer card dy && oddNormalizer card dx && oddFinal card H B (dy*dx)
theorem first_equivalent_intertwiner (A B : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (hP : IsUnitary P) (hQ : IsUnitary Q)
    (hR : IsUnitary R) (he : rectAction P Q R A=B) :
    ∀j,Q*firstFamily A j=firstFamily B j*Q := by
  intro j
  rw [←he,firstFamily_action A P Q R hP hQ hR j,Matrix.mul_assoc,
    show Qᴴ*Q=1 from hQ,Matrix.mul_one]
theorem first_failure (hb : 0 < b) (A B : RectTensor a b c K)
    (hx : firstSolution A B=none) : ¬Equivalent A B := by
  rintro ⟨P,Q,R,hP,hQ,hR,he⟩
  exact unitary_ne_zero hb Q hQ ((intertwiner_none_iff _ _).mp hx Q
    (first_equivalent_intertwiner A B P Q R hP hQ hR he))
theorem second_failure (ha : 0 < a) (hb : 0 < b) (A B : RectTensor a b c K)
    (hA : Good A) (X : Matrix (Fin b) (Fin b) K)
    (hx : firstSolution A B=some X) (hy : secondSolution hb A B X=none) : ¬Equivalent A B := by
  rintro ⟨P,Q,R,hP,hQ,hR,he⟩
  have hi:=first_equivalent_intertwiner A B P Q R hP hQ hR he
  have hc:=actual_second_correction hb A B hA X Q hx hQ hi
  apply unitary_ne_zero ha P hP
  apply (intertwiner_none_iff _ _).mp hy P
  intro t
  rw [hc,←he,second_undo_action A P Q R hQ hR,Matrix.mul_assoc,
    show Pᴴ*P=1 from hP,Matrix.mul_one]
theorem largeCheck_unitary [Fintype K] {F : Type*} [Field F] [Fintype F] [Algebra F K]
    (hc : Nat.card K=Nat.card F^2) (hs : ∀x : K,star x=x^Nat.card F)
    (ha : 0 < a) (hb : 0 < b) (char card : ℕ)
    (A B : RectTensor a b c K) (hA : Good A) :
    largeCheck ha hb true char card A B=true ↔ Equivalent A B := by
  cases hx : firstSolution A B with
  | none => simp only [largeCheck,hx,Bool.false_eq_true]; exact (iff_false_intro (first_failure hb A B hx)).symm
  | some X =>
    cases hy : secondSolution hb A B X with
    | none => simp only [largeCheck,hx,hy,Bool.false_eq_true]; exact (iff_false_intro (second_failure ha hb A B hA X hx hy)).symm
    | some Y =>
      have hX:=firstSolution_correct hb A B hA X hx
      have hY:=secondSolution_correct ha hb A B hA X hx Y hy
      simp only [largeCheck,hx,hy,ite_true]
      rw [unitaryFinal_correct hc hs _ _ _ (mul_ne_zero hY.2.1 hX.2.1)
        (by simp only [star_mul,hY.2.2.1,hX.2.2.1]; ring)]
      rw [equivalent_iff_scalar_tests ha hb A B hA X Y hx hy]
      exact ⟨fun h=>⟨unitary_normalizer hc hs _ hY.2.1 hY.2.2.1,
        unitary_normalizer hc hs _ hX.2.1 hX.2.2.1,h⟩,fun h=>h.2.2⟩
theorem largeCheck_odd [Fintype K] [TrivialStar K] [NeZero (2 : K)]
    (hchar : ringChar K≠2) (ha : 0 < a) (hb : 0 < b)
    (A B : RectTensor a b c K) (hA : Good A) :
    largeCheck ha hb false (ringChar K) (Fintype.card K) A B=true ↔ Equivalent A B := by
  cases hx : firstSolution A B with
  | none => simp only [largeCheck,hx,Bool.false_eq_true]; exact (iff_false_intro (first_failure hb A B hx)).symm
  | some X =>
    cases hy : secondSolution hb A B X with
    | none => simp only [largeCheck,hx,hy,Bool.false_eq_true]; exact (iff_false_intro (second_failure ha hb A B hA X hx hy)).symm
    | some Y =>
      have hX:=firstSolution_correct hb A B hA X hx
      have hY:=secondSolution_correct ha hb A B hA X hx Y hy
      simp only [largeCheck,hx,hy,Bool.false_eq_true,ite_false,if_neg hchar,
        Bool.and_eq_true]
      rw [oddNormalizer_correct hchar _ hY.2.1,oddNormalizer_correct hchar _ hX.2.1,
        oddFinal_correct hchar _ _ _ (mul_ne_zero hY.2.1 hX.2.1),
        equivalent_iff_scalar_tests ha hb A B hA X Y hx hy]
      exact and_assoc
theorem largeCheck_charTwo [Fintype K] [TrivialStar K] [CharP K 2]
    (ha : 0 < a) (hb : 0 < b) (A B : RectTensor a b c K) (hA : Good A) :
    largeCheck ha hb false 2 (Fintype.card K) A B=true ↔ Equivalent A B := by
  cases hx : firstSolution A B with
  | none => simp only [largeCheck,hx,Bool.false_eq_true]; exact (iff_false_intro (first_failure hb A B hx)).symm
  | some X =>
    cases hy : secondSolution hb A B X with
    | none => simp only [largeCheck,hx,hy,Bool.false_eq_true]; exact (iff_false_intro (second_failure ha hb A B hA X hx hy)).symm
    | some Y =>
      have hX:=firstSolution_correct hb A B hA X hx
      have hY:=secondSolution_correct ha hb A B hA X hx Y hy
      simp only [largeCheck,hx,hy,Bool.false_eq_true,ite_false,ite_true]
      rw [charTwoFinal_correct _ _ _ (mul_ne_zero hY.2.1 hX.2.1),
        equivalent_iff_scalar_tests ha hb A B hA X Y hx hy]
      exact ⟨fun h=>⟨charTwo_normalizer (ringChar.eq K 2) _ hY.2.1,
        charTwo_normalizer (ringChar.eq K 2) _ hX.2.1,h⟩,fun h=>h.2.2⟩
end Mathproof.Problem18LargeDecision20261001
