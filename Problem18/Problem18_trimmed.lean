theorem program_run {B S : Nat} (L : Layout) (σ : Env) (hok : L.Ok S)
    (hv : ValidMemory F B σ) (hs : Slots F canonical ws S B σ)
    (hmb : σ.vars canonical.modBase+F.e ≤ σ.vars ws) (hexp : σ.vars exponentReg<B) :
    ∃τ, Run B (program L) σ τ (programCost F.e L.n (Nat.size (σ.vars exponentReg))) ∧
      Problem18IMPMatrixMemory20261001.matrix F τ (σ.vars ws+L.acc*F.e) L.n L.n=
        (Problem18IMPMatrixMemory20261001.matrix F σ (σ.vars ws+L.input*F.e) L.n L.n)^
          (σ.vars exponentReg) ∧
      Problem18IMPMatrixMemory20261001.matrix F τ (σ.vars ws+L.input*F.e) L.n L.n=
        Problem18IMPMatrixMemory20261001.matrix F σ (σ.vars ws+L.input*F.e) L.n L.n ∧
      ValidMemory F B τ ∧ Slots F canonical ws S B τ ∧
      τ.vars ws=σ.vars ws ∧ τ.vars canonical.modBase=σ.vars canonical.modBase ∧
      τ.vars exponentReg=0 ∧
      (∀k,Outside L (σ.vars ws) F.e k →
        (τ.arrs canonical.mem).getD k 0=(σ.arrs canonical.mem).getD k 0) ∧
      (∀x,x∉scalarWrites Problem18P34AssemblyMatrixMultiply20261003.program →
        x∉controlNames → τ.vars x=σ.vars x) ∧
      (∀a,a≠canonical.mem → a≠canonical.scratch → τ.arrs a=σ.arrs a) ∧
      (∀a,(τ.arrs a).length=(σ.arrs a).length) ∧ τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hE := F.degree_pos
  have hsc := hok.scaled F.e
  have hlen := hv.memory_word
  have hfit := hs.fit
  have hn := hok.n_pos
  have hnn : L.n ≤ L.n*L.n := Nat.le_mul_of_pos_right _ hn
  have hstride : (L.n+1)*F.e<B := by
    have h1 : L.n+1 ≤ S := by
      have := hok.acc_base; have := hok.base_copy; have := hok.copy_out; have := hok.out_work
      have := hok.work_fit; omega
    have h2 := Nat.mul_le_mul_right F.e h1
    omega
  obtain ⟨τ1,hr1,hv1,hs1,hc1,hf1,ha1,hx1,hl1,hi1,ho1⟩ := copy_run F L.n L.input L.base σ hv hs hmb
    hok.input_fit
    (by have := hok.base_copy; have := hok.copy_out; have := hok.out_work; have := hok.work_fit; omega)
    hok.input_base
  have hg1 := (Good.refl (L:=L) F hv hs).after_copy F L.base (fun k hk => hk.2.1)
    hv1 hs1 hf1 ha1 hx1 hl1 hi1 ho1
  have hw1 : τ1.vars ws=σ.vars ws := hx1 _ ws_ne_index
  have hm1 : τ1.vars canonical.modBase+F.e ≤ τ1.vars ws := by
    rw [hx1 canonical.modBase (by decide), hw1]; exact hmb
  obtain ⟨τ2,hr2,hv2,hs2,hc2,hf2,ha2,hx2,hl2,hi2,ho2⟩ := identity_run F L.n L.acc τ1 hv1 hs1 hm1
    (by have := hok.acc_base; have := hok.base_copy; have := hok.copy_out; have := hok.out_work;
        have := hok.work_fit; omega) hstride
  have hg2 := hg1.after_copy F L.acc (fun k hk => hk.1) hv2 hs2 hf2 ha2 hx2 hl2 hi2 ho2
  have hw2 : τ2.vars ws=σ.vars ws := by rw [hx2 _ ws_ne_index, hw1]
  have he2 : τ2.vars exponentReg=σ.vars exponentReg := by
    rw [hx2 exponentReg (by decide), hx1 exponentReg (by decide)]
  have hacc2 : mat F L (σ.vars ws) L.acc τ2=1 := by
    simp only [mat]; rw [← hw1]; exact hc2
  have hbase2 : mat F L (σ.vars ws) L.base τ2=
      Problem18IMPMatrixMemory20261001.matrix F σ (σ.vars ws+L.input*F.e) L.n L.n := by
    simp only [mat]
    rw [← hc1]
    apply matrix_of_cells
    intro k hk
    have hb1 := hsc.1
    exact hf2 _ (by rw [hw1]; right; omega)
  obtain ⟨τ,K,hr3,hK,hg,hzero,hacc⟩ := loop_run F L σ hok hmb
    (Problem18IMPMatrixMemory20261001.matrix F σ (σ.vars ws+L.input*F.e) L.n L.n)
    (σ.vars exponentReg) τ2 hg2 (by rw [he2]; exact hexp)
    (by rw [hacc2, hbase2, he2, one_mul])
  have hrun : Run B (program L) σ τ (programCost F.e L.n (Nat.size (σ.vars exponentReg))) := by
    have hall := hr1.seq (hr2.seq hr3)
