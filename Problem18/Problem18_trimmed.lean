namespace Mathproof.Problem18HermitianPairedBoundary20260930
open Polynomial Module
open Mathproof.Meta.Problem18SpectralBlocks20260930
open Mathproof.Problem18PrimaryAssemblyBoundary20260930
open Mathproof.Meta.Problem18HermitianSpectral20260930
variable {K V ι : Type*} [Field K] [AddCommGroup V] [Module K V]
theorem conjugate_coprime_pairing_zero
    {σ : K ≃+* K} {B : V →ₛₗ[σ.toRingHom] V →ₗ[K] K}
    {S : Module.End K V} {p q : K[X]}
    (hS : Mathproof.Meta.Problem18HermitianSpectral20260930.IsSelfAdjointFor σ B S)
    (hc : IsCoprime (p.map σ.toRingHom) q)
    {x y : V} (hx : x ∈ primarySpace S p) (hy : y ∈ primarySpace S q) :
    B x y = 0 := by
  obtain ⟨a,b,hab⟩ := hc
  have hpx : polyEval S p x = 0 := LinearMap.mem_ker.mp hx
  have hqy : polyEval S q y = 0 := LinearMap.mem_ker.mp hy
  have hyproject : y = polyEval S (p.map σ.toRingHom) (polyEval S a y) := by
    calc
      y = polyEval S 1 y := by simp [polyEval]
      _ = polyEval S (a * p.map σ.toRingHom + b*q) y := by rw [hab]
      _ = polyEval S (a * p.map σ.toRingHom) y := by
        simp only [polyEval,Polynomial.aeval_add,Polynomial.aeval_mul,
          LinearMap.add_apply,Module.End.mul_apply]
        change _ + (aeval S b) (polyEval S q y) = _
        rw [hqy,map_zero,add_zero]
      _ = polyEval S (p.map σ.toRingHom) (polyEval S a y) := by
        rw [mul_comm]
        simp only [polyEval,Polynomial.aeval_mul,Module.End.mul_apply]
  rw [hyproject,← pairing_polyEval_eq_map hS,hpx,map_zero,LinearMap.zero_apply]
variable [Fintype ι] [DecidableEq ι]
theorem primarySum_paired_form
    {σ : K ≃+* K} (B : V →ₛₗ[σ.toRingHom] V →ₗ[K] K)
    (S : Module.End K V) (g : ι → K[X]) (τ : ι → ι)
    (hS : Mathproof.Meta.Problem18HermitianSpectral20260930.IsSelfAdjointFor σ B S)
    (hc : ∀ i j, j ≠ τ i → IsCoprime ((g i).map σ.toRingHom) (g j))
    (x y : ∀ i,Primary S g i) :
    B (primarySum S g x) (primarySum S g y)=
      ∑ i,B (x i).val (y (τ i)).val := by
  change B (∑ i,(x i : V)) (∑ j,(y j : V))=_
  rw [B.map_sum₂]
  apply Finset.sum_congr rfl
  intro i _
  rw [map_sum,Finset.sum_eq_single (τ i)]
  · intro j _ hji
    exact conjugate_coprime_pairing_zero hS (hc i j hji) (x i).property (y j).property
  · intro h
    exact False.elim (h (Finset.mem_univ _))
section CrossTrace
open Mathproof.Problem18PrimaryTraceBoundary20260930
variable {E L : Type*} [Field E] [Field L] [Algebra K E] [Algebra K L]
  [FiniteDimensional K L] [Algebra.IsSeparable K L]
variable (σ : K ≃+* K) (φ : E ≃+* L)
abbrev CrossForm := E →ₛₗ[σ.toRingHom] L →ₗ[K] K
def CrossBalanced (B : CrossForm (E := E) (L := L) σ) : Prop :=
  ∀ t x y,B (t*x) y=B x (φ t*y)
noncomputable def crossCoefficient (B : CrossForm (E := E) (L := L) σ) : L :=
  ((Algebra.traceForm K L).toDual (traceForm_nondegenerate K L)).symm (B 1)
theorem crossCoefficient_spec (B : CrossForm (E := E) (L := L) σ) (y : L) :
    Algebra.trace K L (crossCoefficient σ B*y)=B 1 y :=
  LinearMap.BilinForm.apply_toDual_symm_apply (B := Algebra.traceForm K L) (B 1) y
theorem cross_trace_representation (B : CrossForm (E := E) (L := L) σ)
    (hB : CrossBalanced σ φ B) (x : E) (y : L) :
    B x y=Algebra.trace K L (crossCoefficient σ B*φ x*y) := by
  have h := hB x 1 y
  rw [mul_one] at h
  rw [h,← crossCoefficient_spec σ B (φ x*y),mul_assoc]
theorem cross_balanced_of_generator (B : CrossForm (E := E) (L := L) σ)
    (t : E) (ht : Algebra.adjoin K ({t} : Set E)=⊤)
    (hc : ∀ a : K,φ (algebraMap K E a)=algebraMap K L (σ a))
    (hS : ∀ x y,B (t*x) y=B x (φ t*y)) : CrossBalanced σ φ B := by
  intro z
  have hz : z∈Algebra.adjoin K ({t} : Set E) := by rw [ht]; trivial
  induction hz using Algebra.adjoin_induction with
  | mem z hz =>
    have he : z=t := Set.mem_singleton_iff.mp hz
    subst z
    exact hS
  | algebraMap a =>
    intro x y
    rw [hc]
    simp only [← Algebra.smul_def,map_smulₛₗ,map_smul,LinearMap.smul_apply,
      RingEquiv.toRingHom_eq_coe,RingHom.coe_coe,RingHom.id_apply]
  | add u v hu hv ihu ihv =>
    intro x y
    simp only [add_mul,map_add,LinearMap.add_apply,ihu,ihv]
  | mul u v hu hv ihu ihv =>
    intro x y
    rw [mul_assoc,ihu,ihv,φ.map_mul]
    congr 1
    ring
theorem cross_coefficient_ne_zero (B : CrossForm (E := E) (L := L) σ)
    (hB : CrossBalanced σ φ B) (hsep : B.SeparatingLeft) :
    crossCoefficient σ B≠0 := by
  intro hc
  have h : (1:E)=0 := hsep 1 (by
    intro y
    rw [cross_trace_representation σ φ B hB,hc,zero_mul,zero_mul,map_zero])
  exact one_ne_zero h
theorem cross_scalar_isometry_iff (c d : L) (z : E) (w : L) :
    (∀ x y,Algebra.trace K L (c*φ (z*x)*(w*y))=
      Algebra.trace K L (d*φ x*y)) ↔ c*φ z*w=d := by
  constructor
  · intro h
    apply trace_coefficient_ext (K := K)
    intro y
    simpa only [mul_one,map_one,mul_assoc] using h 1 y
  · intro h x y
    have he : c*φ (z*x)*(w*y)=(c*φ z*w)*φ x*y := by rw [map_mul]; ring
    rw [he,h]
end CrossTrace
section ActualPrimary
variable [Fintype K] [FiniteDimensional K V]
theorem primary_cross_separatingLeft
    {σ : K ≃+* K} (B : V →ₛₗ[σ.toRingHom] V →ₗ[K] K)
    (S : Module.End K V) (g : ι → K[X]) (i j : ι)
    (hS : Mathproof.Meta.Problem18HermitianSpectral20260930.IsSelfAdjointFor σ B S)
    (hB : B.SeparatingLeft)
    (hm : ∀ k,(g k).Monic) (hi : ∀ k,Irreducible (g k))
    (hf : S.charpoly=∏ k,g k) (hs : Squarefree S.charpoly)
    (hc : ∀ k,k≠j → IsCoprime ((g i).map σ.toRingHom) (g k)) :
    (B.domRestrict₁₂ (Primary S g i) (Primary S g j)).SeparatingLeft := by
  intro x hx
  apply Subtype.ext
  apply hB x.val
  intro y
  obtain ⟨v,rfl⟩ := (primarySum_bijective S g hm hi hf hs).surjective y
  change B x.val (∑ k,(v k : V))=0
  rw [map_sum]
  apply Finset.sum_eq_zero
  intro k _
  by_cases hkj : k=j
  · subst k
    exact hx (v j)
  · exact conjugate_coprime_pairing_zero hS (hc k hkj) x.property (v k).property
theorem actual_primary_cross_trace
    {σ : K ≃+* K} (B : V →ₛₗ[σ.toRingHom] V →ₗ[K] K)
    (S : Module.End K V) (g : ι → K[X]) (i j : ι)
    (hS : Mathproof.Meta.Problem18HermitianSpectral20260930.IsSelfAdjointFor σ B S)
    (hB : B.SeparatingLeft)
    (hm : ∀ k,(g k).Monic) (hi : ∀ k,Irreducible (g k))
    (hf : S.charpoly=∏ k,g k) (hs : Squarefree S.charpoly)
    (hc : ∀ k,k≠j → IsCoprime ((g i).map σ.toRingHom) (g k))
    (hp : Associated ((g i).map σ.toRingHom) (g j))
    (e : AdjoinRoot (g i) ≃ₗ[K] Primary S g i)
    (f : AdjoinRoot (g j) ≃ₗ[K] Primary S g j)
    (he : ∀ x,(e (AdjoinRoot.root (g i)*x) : V)=S (e x))
    (hf' : ∀ y,(f (AdjoinRoot.root (g j)*y) : V)=S (f y)) :
