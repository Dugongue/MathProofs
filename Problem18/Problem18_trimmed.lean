def certCom (M : FieldMacros F r) (q : RNames) (an : ANames) : Com :=
  .seq (.assign an.Nw (plus (.var an.c) (.var an.m)))
  (.seq (.assign q.N (.var an.c))
  (.seq (buildLoop M q an)
  (.seq (copyLoop M q (.lit 5) (.var an.xB))
  (.seq (.assign an.a (.var an.m))
  (.seq (fillLoop r q an (plus (.lit 5) (.var an.c)))
  (.seq (.assign q.N (.var an.Nw))
  (.seq (.assign q.n (.var an.c))
  (.seq (.assign q.c (.var an.m))
  (.seq (reduceLoop M q)
  (.seq (.assign q.N (.var an.c))
  (.seq (zeroTest M q an.z an.k)
  (.seq (.assign q.N (.var an.m))
    (mapLoop r q M.neg (.var an.oB) (plus (.lit 5) (.var an.c)))))))))))))))
def certCost (M : FieldMacros F r) (q : RNames) (an : ANames) (e cv mv : ℕ) : ℕ :=
  4 + 2 + buildCost M an e cv mv + copyCost M (.lit 5) (.var an.xB) cv + 2 +
    fillCost (plus (.lit 5) (.var an.c)) e mv + 2 + 2 + 2 + reduceCost M q (cv + mv) cv mv + 2 +
    zeroCost M cv + 2 + mapCost (.var an.oB) (plus (.lit 5) (.var an.c)) M.costPoint mv
def certMoving (q : RNames) (an : ANames) : List String :=
  [q.N, q.n, q.c, q.u, q.w, q.j, q.i, q.pv, q.f, an.Nw, an.a, an.b, an.z, an.k]
theorem cert_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (an : ANames)
    (ha : an.Valid r q) {B Sn : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ)
    (hz0 : val F r q.WS σ 0 = 0) {c : ℕ} (rs : List (Vector K c)) (x : Vector K c)
    {sv xv ov : ℕ} (hc : σ.vars an.c = c) (hm : σ.vars an.m = rs.length)
    (hsB : σ.vars an.sB = sv) (hxB : σ.vars an.xB = xv) (hoB : σ.vars an.oB = ov)
    (hlay : rowStart (c + rs.length) rs.length ≤ sv) (hsx : sv + rs.length * c ≤ xv)
    (hxo : xv + c ≤ ov) (hoS : ov + rs.length ≤ Sn)
    (hrs : ∀ u (hu : u < rs.length) (k : Fin c), val F r q.WS σ (sv + u * c + k.val) = read rs[u] k)
    (hx : ∀ k : Fin c, val F r q.WS σ (xv + k.val) = read x k) :
    ∃ τ, Run B (certCom M q an) σ τ (certCost M q an F.e c rs.length) ∧
      Slots F r q.WS Sn B τ ∧
      (τ.vars an.z = 0 ↔ (arrayCertificate rs x).member = true) ∧ τ.vars an.z ≤ 1 ∧
      (∀ j : Fin rs.length,
        val F r q.WS τ (ov + j.val) = read (arrayCertificate rs x).coefficients j) ∧
      (∀ s < Sn, (s = 0 ∨ sv ≤ s) → (s < ov ∨ ov + rs.length ≤ s) →
        val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ y, y ∉ regNames r → y ∉ certMoving q an → τ.vars y = σ.vars y) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  set m := rs.length with hmdef
