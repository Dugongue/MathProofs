  refine ⟨_,((Run.assign (x:=canonical.flag) heval).seq hwrite.1).mono ?_,?_⟩
  · simp [Expr.size,Expr.mul,coefficients]; omega
  · simpa [ξ] using hwrite.2
theorem coordinate_program_run [Fintype K] {q : Nat} (d : UnitaryFieldData (K:=K) q)
    (a b : K) (B : Nat) (hmem : 16*(F.e+1)<B) (hq : q<B)
    (harith : (F.p+1)^2<B) (hinverse : (F.p+1)^(F.e+1)<B) :
    ∃τ,Run B (fieldProgram .coordinates) (initialState F a b q) τ
        (260*(F.e+1)+coordinateCost F q) ∧
      τ.out=coefficients F ((rootCoordinates F d a).1:K)++
        coefficients F ((rootCoordinates F d a).2:K) := by
  have hp : F.p<B := by nlinarith only [harith]
  have hload:=load_run F a b q B hmem hp
  obtain ⟨μ,hr,hvalid,hvalue,hptr,hout,hlen⟩:=coordinate_loaded_run F d a b B hmem hq harith hinverse
  have hx:=congrArg Prod.fst hvalue
