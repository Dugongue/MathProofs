  set d := boundaryHeight a b c with hddef
  have hE := F.degree_pos
  have hsbA : Sz.value sbA n d F.e 0 = F.e + 1 := rfl
  have hsbB : Sz.value sbB n d F.e 0 = F.e + 1 + F.e*sideN n d := rfl
  have ev1 := Sz.expr_eval sbA hn hd he (b := ρ.vars sbR) rfl
    (by have := hsA; simp only [sbA, Sz.majorant] at this ⊢; omega)
  have vs : ∀ (σ : Env) (v : Nat) (x : String), x ≠ sbR → (σ.setVar sbR v).vars x = σ.vars x :=
    fun σ v x hx => by simp [hx]
