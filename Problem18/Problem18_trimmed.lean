  a : Nat
  b : Nat
  c : Nat
  valid : validSize fieldData.carrier unitary q
  positiveA : 0 < a
  positiveB : 0 < b
  positiveC : 0 < c
  source : RectTensor a b c fieldData.carrier
  target : RectTensor a b c fieldData.carrier
def words (x : Query) : List Nat :=
  queryWords x.fieldData.presentation x.unitary x.q x.source x.target
noncomputable def sourceAnswer (B : Nat) (x : Query) : Option Bool := by
  classical
  letI : BEq x.fieldData.carrier := instBEqOfDecidableEq
  exact if Mathproof.Problem18TypedSourceCheck20261001.sourceCheck B x.unitary x.q x.source
    then some (decide (equivalent x.unitary x.q x.source x.target)) else none
structure QueryProgram (B : Nat) where
  layout : Lax13Proofs.Compile.Layout
  program : Com
  wordPolynomial : Polynomial Nat
  timePolynomial : Polynomial Nat
  ok : Lax13Proofs.Compile.Com.Ok layout program
  run : ∀ x : Query, ∃ (ext : String → Nat) (σ : Env),
    Run (2 ^ (wordPolynomial.eval (bitSize (words x)) + bitSize (words x) + 1))
      program (initEnv ext ((words x).length :: words x)) σ
      (timePolynomial.eval (bitSize (words x))) ∧
    σ.out = Mathproof.Problem18RAMAnswerCodec20261001.answerWords (sourceAnswer B x)
theorem requiredAnswer_eq {B : Nat} {recognize : List Bool → Bool}
    (href : Mathproof.Problem18EncodedDensityClosure20261001.EncodedRefines B recognize)
    (x : Query) :
    requiredAnswer x.fieldData.presentation recognize x.unitary x.q x.source x.target =
      sourceAnswer B x := by
  classical
  let _ : BEq x.fieldData.carrier := instBEqOfDecidableEq
  have h := href x.fieldData.carrier x.fieldData.presentation x.unitary x.q x.a x.b x.c
    x.valid x.positiveA x.positiveB x.positiveC x.source
  unfold requiredAnswer sourceAnswer
  rw [h]
theorem p37_of_queryPrograms (prog : ∀ B, 8 ≤ B → QueryProgram B) :
    Mathproof.Problem18P37Frozen20261004.P37 := by
  intro B hB
  let p := prog B hB
  obtain ⟨M, Q, hdet, hM⟩ :=
    Mathproof.Problem18P34Machine20261002.compile_query (ι := Query) words (sourceAnswer B)
      p.layout p.program p.wordPolynomial p.timePolynomial p.ok p.run
  obtain ⟨C, d, _, _, hQ⟩ := polynomial_query_bound Q
  refine ⟨M, C, d, hdet, ?_⟩
  intro recognize href K _ _ F unitary q a b c hv ha hb hc A T
  let x : Query := ⟨⟨K, inferInstance, inferInstance, F⟩, unitary, q, a, b, c, hv,
    ha, hb, hc, A, T⟩
  have hx := hM x
  have hr := requiredAnswer_eq href x
  change ZeroError M (queryBits F unitary q A T) (sourceAnswer B x) ∧ _ at hx
  change requiredAnswer F recognize unitary q A T = sourceAnswer B x at hr
  rw [hr]
  refine ⟨hx.1, fun N => (hx.2 N).trans ?_⟩
  exact hQ K F unitary q a b c hv ha hb hc A T
theorem p37_of_nonempty (prog : ∀ B, 8 ≤ B → Nonempty (QueryProgram B)) :
    Mathproof.Problem18P37Frozen20261004.P37 :=
  p37_of_queryPrograms (fun B hB => Classical.choice (prog B hB))
end Mathproof.Problem18P37DispatchBridge20261004
