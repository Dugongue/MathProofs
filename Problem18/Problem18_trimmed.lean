variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V]
theorem exists_orthogonal_complement
    (B : LinearMap.BilinForm K V) (W : Submodule K V) :
    ∃ C : Submodule K V,
      C ≤ B.orthogonal W ∧
      Disjoint W C ∧
      finrank K C + finrank K ↥(W ⊓ (B.orthogonal W)) =
        finrank K (B.orthogonal W) := by
  let O := B.orthogonal W
  let R : Submodule K O := W.comap O.subtype
  obtain ⟨C, hRC⟩ := Submodule.exists_isCompl R
  let C' : Submodule K V := C.map O.subtype
  refine ⟨C', ?_, ?_, ?_⟩
  · rintro x ⟨c, hc, rfl⟩
    exact c.property
  · rw [disjoint_iff]
    apply le_antisymm ?_ bot_le
    rintro x ⟨hxW, hxC⟩
    rcases hxC with ⟨c, hcC, rfl⟩
    have hcR : c ∈ R := hxW
    have hc0 : c = 0 := by
      have hcInf : c ∈ R ⊓ C := ⟨hcR, hcC⟩
      have : c ∈ (⊥ : Submodule K O) := hRC.disjoint.le_bot hcInf
      simpa only [Submodule.mem_bot] using this
    simp only [hc0, map_zero, Submodule.zero_mem]
  · have hsum := Submodule.finrank_add_eq_of_isCompl hRC
    have hRmap : R.map O.subtype = W ⊓ O := by
      ext x
      simp only [R, Submodule.mem_map, Submodule.mem_comap,
        Submodule.coe_subtype, Submodule.mem_inf]
      constructor
      · rintro ⟨y, hyW, rfl⟩
        exact ⟨hyW, y.property⟩
      · rintro ⟨hxW, hxO⟩
        exact ⟨⟨x, hxO⟩, hxW, rfl⟩
    have hCdim : finrank K C' = finrank K C := by
      exact Submodule.finrank_map_subtype_eq O C
    have hRdim : finrank K ↥(W ⊓ O) = finrank K R := by
      rw [← hRmap]
      exact Submodule.finrank_map_subtype_eq O R
    dsimp only [C', O] at hCdim ⊢
    rw [hCdim]
    rw [show finrank K ↥(W ⊓ (B.orthogonal W)) = finrank K R by
      simpa only [O] using hRdim]
    simpa only [add_comm, O] using hsum
theorem subtype_coprod_injective
    {W C : Submodule K V} (hWC : Disjoint W C) :
    Function.Injective (W.subtype.coprod C.subtype) := by
  rw [← LinearMap.ker_eq_bot,
    LinearMap.ker_coprod_of_disjoint_range,
    ker_subtype, ker_subtype, Submodule.prod_bot]
  rw [range_subtype, range_subtype]
  exact hWC
end Mathproof.Problem18AnchorAdaptedSubspace20260930
