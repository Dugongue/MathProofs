    rw [hζmem,writeValues_length]
  have hdlt : d < (ζ.arrs canonical.mem).length := by
    rw [hζlen]; omega
  have h4 : Run B (.store canonical.mem (.var resetBase) (.lit 1)) ζ
      (ζ.setArr canonical.mem d 1) 3 := by
    have hv : (Expr.var resetBase).evalB B ζ = some d := by
      simpa only [hζb] using (evalB_var (σ:=ζ) (x:=resetBase) (by rw [hζb]; omega))
