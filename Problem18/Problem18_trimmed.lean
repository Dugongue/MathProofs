variable (k F L : Type*) [Field k] [Field F] [Field L]
  [Algebra k F] [Algebra k L] [Algebra F L] [IsScalarTower k F L]
def galoisPlace (σ : L ≃ₐ[F] L) (P : Place k L) : Place k L :=
  pullbackPlace k L σ.symm.toRingEquiv (RingEquiv.refl k) (fun c => by
    change σ.symm (algebraMap k L c)=algebraMap k L c
    rw [IsScalarTower.algebraMap_apply k F L,σ.symm.commutes]) P
@[simp] theorem mem_galoisPlace (σ : L ≃ₐ[F] L) (P : Place k L) (x : L) :
    x∈galoisPlace k F L σ P ↔ σ.symm x∈P := mem_pullbackPlace _ _ _ _ _ _ _
instance galoisPlaceMulAction : MulAction (L ≃ₐ[F] L) (Place k L) where
  smul := galoisPlace k F L
  one_smul P := by
    ext x
    change x∈galoisPlace k F L 1 P ↔ x∈P
    rw [mem_galoisPlace]
    rfl
  mul_smul σ τ P := by
    ext x
    change x∈galoisPlace k F L (σ*τ) P ↔ x∈galoisPlace k F L σ (galoisPlace k F L τ P)
    simp only [mem_galoisPlace]
    rfl
variable [Algebra.IsAlgebraic F L]
theorem restrict_galoisPlace (σ : L ≃ₐ[F] L) (P : Place k L) :
    restrictPlace k F L (galoisPlace k F L σ P)=restrictPlace k F L P := by
  ext x
  change x∈restrictPlace k F L (galoisPlace k F L σ P) ↔ x∈restrictPlace k F L P
  rw [mem_restrictPlace,mem_galoisPlace,mem_restrictPlace,σ.symm.commutes]
abbrev PlaceFiber (P : Place k F) := {Q : Place k L // restrictPlace k F L Q=P}
instance placeFiberMulAction (P : Place k F) : MulAction (L ≃ₐ[F] L) (PlaceFiber k F L P) where
  smul σ Q := ⟨galoisPlace k F L σ Q.val,(restrict_galoisPlace k F L σ Q.val).trans Q.property⟩
  one_smul Q := by
    apply Subtype.ext
    change galoisPlace k F L 1 Q.val=Q.val
    exact one_smul (L ≃ₐ[F] L) Q.val
  mul_smul σ τ Q := Subtype.ext (mul_smul σ τ Q.val)
variable [FiniteDimensional F L] [IsGalois F L]
instance placeFiberPretransitive (P : Place k F) :
    MulAction.IsPretransitive (L ≃ₐ[F] L) (PlaceFiber k F L P) where
  exists_smul_eq Q R := by
    obtain ⟨σ,hσ⟩ := galois_place_transitive k F L Q.val R.val (Q.property.trans R.property.symm)
    refine ⟨σ.symm,Subtype.ext ?_⟩
    ext x
    change x∈galoisPlace k F L σ.symm Q.val ↔ x∈R.val
    rw [mem_galoisPlace]
    exact hσ x
instance placeFiberNonempty (P : Place k F) : Nonempty (PlaceFiber k F L P) := by
  obtain ⟨Q,hQ⟩ := restrictPlace_surjective k F L P
  exact ⟨Q,hQ⟩
instance placeFiberFinite (P : Place k F) : Finite (PlaceFiber k F L P) := by
  let Q := Classical.choice (inferInstance : Nonempty (PlaceFiber k F L P))
  exact Finite.of_surjective (fun σ : L ≃ₐ[F] L => σ • Q)
    (fun R => MulAction.exists_smul_eq (L ≃ₐ[F] L) Q R)
end Mathproof.Problem18GaloisPlaceAction20260930
