    simp only [dotProduct,Fintype.sum_sum_type,Sum.elim_inl,Sum.elim_inr,Pi.star_apply,Function.comp_apply]
  ext i j
  have hh := hp (Pi.single i 1) (Pi.single j 1)
  have he (x : (Fin d⊕Fin l)→K) : adaptedEquiv W hc f g x=E W hc f g*ᵥx :=
