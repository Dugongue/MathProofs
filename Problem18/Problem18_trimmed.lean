variable {R : Type*} [CommRing R] [IsNoetherianRing R]
theorem exists_pair_below_prime {I M : Ideal R} [M.IsPrime]
    (h : collisionIdeal I ≤ M) :
    ∃ P ∈ I.minimalPrimes, ∃ Q ∈ I.minimalPrimes, P ≠ Q ∧ P ⊔ Q ≤ M := by
  classical
  have hfin := collision_family_finite I
  have hinf : hfin.toFinset.inf id ≤ M := by
    simpa only [Finset.inf_id_eq_sInf,hfin.coe_toFinset,collisionIdeal] using h
  obtain ⟨J,hJ,hJM⟩ := (Ideal.IsPrime.inf_le' (inferInstance : M.IsPrime)).mp hinf
  obtain ⟨P,hP,Q,hQ,hne,rfl⟩ := hfin.mem_toFinset.mp hJ
  exact ⟨P,hP,Q,hQ,hne,hJM⟩
theorem collision_dimension_succ_le (I : Ideal R) :
    ringKrullDim (R ⧸ collisionIdeal I) + 1 ≤ ringKrullDim (R ⧸ I) := by
