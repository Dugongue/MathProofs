    (ψ : AddChar K ℂ) (hψ : ψ ≠ 1) (m : ℕ) (hm : 1 ≤ m) :
    (∑ M : ConstraintSample K d ι, diagonalWeight ψ M.val z m) /
      Nat.card (ConstraintSample K d ι) ≤
        4 * (Fintype.card K : ℝ)^d / (Fintype.card K : ℝ)^(Fintype.card ι) := by
