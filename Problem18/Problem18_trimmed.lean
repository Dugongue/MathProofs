  refine ⟨tau,hrun,?_,?_,?_,?_,?_,?_⟩
  · intro k hk
    exact hτ.2.2.2.2.2.2.1 k (by omega)
  · intro k hk
    exact hτ.2.2.2.2.2.2.2 k (by simpa [hi] using hk)
