  · rw [ha, hb, hc]; exact hA.header.pos
  · rw [ha, hb, hc]; exact hA.header.sum
  · rw [ha, hb, hc]; exact hA.header.prod
  · exact ⟨(prot _ (by decide) (by decide) (by decide)).trans hA.dims.1,
