  | .skip => .skip
  | .assign x e => .assign x (renameExpr rho e)
  | .store a i e => .store (rho a) (renameExpr rho i) (renameExpr rho e)
  | .seq c d => .seq (renameCom rho c) (renameCom rho d)
  | .ite b c d => .ite (renameCond rho b) (renameCom rho c) (renameCom rho d)
  | .while b c => .while (renameCond rho b) (renameCom rho c)
  | .read x => .read x
  | .write e => .write (renameExpr rho e)
def renameEnv (rho : String ≃ String) (sigma : Env) : Env where
