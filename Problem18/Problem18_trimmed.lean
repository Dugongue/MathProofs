def identityStar : StarRing K where
  star := id
  star_involutive := fun _=>rfl
  star_mul := fun x y=>mul_comm x y
  star_add := fun _ _=>rfl
theorem rawGood_invariant [Fintype K] (u : Bool) (q : ℕ) (hv : validSize K u q)
    (A B : RectTensor a b c K) (h : equivalent u q A B) :
    RawGood u q A ↔ RawGood u q B := by
  cases u with
  | false =>
    letI : StarRing K:=identityStar
    exact rawGood_equivalent false q (fun _=>rfl) A B h
  | true =>
    let d:=Classical.choice (Problem18UnitaryRootField20260930.exists_unitaryFieldData q hv)
    letI : StarRing K:=d.starRing
