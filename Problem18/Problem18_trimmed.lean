variable {F K V : Type*} [Field F] [Fintype F] [Field K] [Fintype K]
  [Algebra F K] [StarRing K] [AddCommGroup V] [Module K V] [FiniteDimensional K V]
theorem bounded_weight_operator_mass
    (hcard : Nat.card K=Nat.card F^2) (hstar : ∀ a : K,star a=a^Nat.card F)
    {n : ℕ} (f : MonicDegree (K:=F) n) (hs : Squarefree f.val) (hY : weight f≤36)
    (B : V →ₗ⋆[K] V →ₗ[K] K) (hB : B.IsSymm) (hnB : B.SeparatingLeft)
    (hd : Module.finrank K V=n) :
    Real.exp (-72)*(Nat.card (isometrySubgroup (fun x y => B x y)):ℝ) ≤
      (Nat.card {S : Module.End K V // S.charpoly=f.val.map (algebraMap F K) ∧
        ∀ x y,B (S x) y=B x (S y)}:ℝ)*(Nat.card F:ℝ)^n := by
  classical
  let i := algebraMap F K
  let p := f.val.map i
  have hm : p.Monic := f.property.1.map i
  have hpdeg : p.natDegree=n := (f.property.1.natDegree_map i).trans f.property.2
  have hs' : Squarefree p := ((PerfectField.separable_iff_squarefree.mpr hs).map).squarefree
  let σ : K ≃+* K := starRingAut
  have hfix (a : F) : σ (i a)=i a := by
    change star (i a)=i a
    rw [hstar,← map_pow]
    congr 1
    simpa only [Nat.card_eq_fintype_card] using FiniteField.pow_card a
  have hpfix : p.map σ.toRingHom=p := by
    ext j
    simp only [p,Polynomial.coeff_map]
    exact hfix _
  have hass : Associated (p.map σ.toRingHom) p := by rw [hpfix]
  let φ := AdjoinRoot.mapRingEquiv σ p p hass
  have hφ : Function.Involutive φ := adjoinRoot_conjugation_involutive σ star_involutive p hass
  have hc (a : K) : φ (algebraMap K (AdjoinRoot p) a)=algebraMap K (AdjoinRoot p) (star a) :=
    AdjoinRoot.map_of σ.toRingHom p p hass.symm.dvd a
  have hr : φ (AdjoinRoot.root p)=AdjoinRoot.root p :=
    AdjoinRoot.map_root σ.toRingHom p p hass.symm.dvd
  let pb := AdjoinRoot.powerBasis hm.ne_zero
  letI : FiniteDimensional K (AdjoinRoot p) := pb.finite
  letI : Finite (AdjoinRoot p) := Finite.of_injective pb.basis.equivFun pb.basis.equivFun.injective
  letI : Finite V := Finite.of_injective (Module.finBasis K V).equivFun
    (Module.finBasis K V).equivFun.injective
  letI : Fintype V := Fintype.ofFinite V
  have hedim : Module.finrank K (AdjoinRoot p)=Module.finrank K V := by
    have h : Module.finrank K (AdjoinRoot p)=p.natDegree := finrank_quotient_span_eq_natDegree
    rw [h,hpdeg,hd]
