variable {K : Type} [Field K] [Fintype K] [DecidableEq K] {σ : Type*} {q a b c : Nat}
def sxNeg (p : StarExpr σ K) : StarExpr σ K:=.mul (.const (-1)) p
def sxSub (p r : StarExpr σ K) : StarExpr σ K:=.add p (sxNeg r)
def sxSum : List (StarExpr σ K)→StarExpr σ K
  | []=>.const 0
  | p::ps=>.add p (sxSum ps)
def sxSumFin (n : Nat) (f : Fin n→StarExpr σ K) := sxSum ((List.finRange n).map f)
def sxSumPair (a b : Nat) (f : Fin a×Fin b→StarExpr σ K) :=
  sxSumFin a (fun i=>sxSumFin b (fun j=>f (i,j)))
theorem sxNeg_eval (d : UnitaryFieldData (K:=K) q) (x : σ→K) (p : StarExpr σ K) :
    (sxNeg p).eval d x= -(p.eval d x) := by simp [sxNeg,StarExpr.eval]
theorem sxSub_eval (d : UnitaryFieldData (K:=K) q) (x : σ→K) (p r : StarExpr σ K) :
    (sxSub p r).eval d x=p.eval d x-r.eval d x := by simp [sxSub,StarExpr.eval,sxNeg_eval,sub_eq_add_neg]
theorem sxSum_eval (d : UnitaryFieldData (K:=K) q) (x : σ→K) (ps : List (StarExpr σ K)) :
    (sxSum ps).eval d x=(ps.map (StarExpr.eval d x)).sum := by
  induction ps <;> simp_all [sxSum,StarExpr.eval]
theorem sxSumFin_eval (d : UnitaryFieldData (K:=K) q) (x : σ→K) (n : Nat)
    (f : Fin n→StarExpr σ K) : (sxSumFin n f).eval d x=∑i,(f i).eval d x := by
  rw [sxSumFin,sxSum_eval,List.map_map,←List.sum_toFinset _ (List.nodup_finRange n)]
  simp
theorem sxSumPair_eval (d : UnitaryFieldData (K:=K) q) (x : σ→K) (a b : Nat)
    (f : Fin a×Fin b→StarExpr σ K) : (sxSumPair a b f).eval d x=∑i,(f i).eval d x := by
  simp only [sxSumPair,sxSumFin_eval,Fintype.sum_prod_type]
theorem sxSum_degree (ps : List (StarExpr σ K)) (D : Nat) (h : ∀p∈ps,p.degree≤D) :
    (sxSum ps).degree≤D := by
  induction ps with
  | nil=>simp [sxSum,StarExpr.degree]
  | cons p ps ih=>
    simp only [sxSum,StarExpr.degree,max_le_iff]
    exact ⟨h p (by simp),ih (fun r hr=>h r (by simp [hr]))⟩
theorem sxSumFin_degree (n D : Nat) (f : Fin n→StarExpr σ K) (h : ∀i,(f i).degree≤D) :
    (sxSumFin n f).degree≤D := by
  apply sxSum_degree
  intro p hp
  obtain ⟨i,_,rfl⟩:=List.mem_map.mp hp
  exact h i
theorem sxSumPair_degree (a b D : Nat) (f : Fin a×Fin b→StarExpr σ K) (h : ∀i,(f i).degree≤D) :
    (sxSumPair a b f).degree≤D :=
  sxSumFin_degree a D _ (fun i=>sxSumFin_degree b D _ (fun j=>h (i,j)))
def tensorExpr (ij uv : Fin a×Fin b) : StarExpr (OuterVar a b) K :=
  .mul (.var (.inl (ij.1,uv.1))) (.var (.inr (ij.2,uv.2)))
def transformedExpr (F : RectTensor a b c K) (s : Fin c) (ij : Fin a×Fin b) : StarExpr (OuterVar a b) K :=
  sxSumPair a b (fun uv=>.mul (.const (F s uv)) (tensorExpr ij uv))
def preserveP (i j : Fin a) : StarExpr (OuterVar a b) K :=
  sxSub (sxSumFin a (fun u=>.mul (.conj (.var (.inl (u,i)))) (.var (.inl (u,j)))))
    (.const (if i=j then 1 else 0))
def preserveQ (i j : Fin b) : StarExpr (OuterVar a b) K :=
  sxSub (sxSumFin b (fun u=>.mul (.conj (.var (.inr (u,i)))) (.var (.inr (u,j)))))
    (.const (if i=j then 1 else 0))
def kernelFamily (G : RectTensor a b c K) : Fin (a*b)→(Fin a×Fin b)→K :=
  computedKernel finProdFinEquiv.symm G
def kernelExpr (F G : RectTensor a b c K) (s : Fin c) (t : Fin (a*b)) : StarExpr (OuterVar a b) K :=
  sxSumPair a b (fun ij=>.mul (transformedExpr F s ij) (.const (kernelFamily G t ij)))
def gramExpr (S T : Matrix (Fin a×Fin b) (Fin a×Fin b) K)
    (ij kl : Fin a×Fin b) : StarExpr (OuterVar a b) K :=
  sxSub (sxSumPair a b fun u=>sxSumPair a b fun v=>
    .mul (.mul (.conj (tensorExpr ij u)) (.const (S u v))) (tensorExpr kl v)) (.const (T ij kl))
theorem transformedExpr_eval (d : UnitaryFieldData (K:=K) q) (x : OuterVar a b→K)
    (F : RectTensor a b c K) (s : Fin c) (ij : Fin a×Fin b) :
    (transformedExpr F s ij).eval d x=transformedMatrix x F s ij := by
  simp only [transformedExpr,sxSumPair_eval,StarExpr.eval,tensorExpr,transformedMatrix,
    Matrix.mul_apply,Matrix.transpose_apply,Matrix.kronecker,Matrix.kroneckerMap_apply,pMatrix,rMatrix]
theorem kernelExpr_eval (d : UnitaryFieldData (K:=K) q) (x : OuterVar a b→K)
    (F G : RectTensor a b c K) (s : Fin c) (t : Fin (a*b)) :
    (kernelExpr F G s t).eval d x=(transformedMatrix x F*ᵥkernelFamily G t) s := by
  simp only [kernelExpr,sxSumPair_eval,StarExpr.eval,transformedExpr_eval,Matrix.mulVec,dotProduct]
theorem preserveP_eval (d : UnitaryFieldData (K:=K) q) (x : OuterVar a b→K) (i j : Fin a) :
    letI : StarRing K:=d.starRing
    (preserveP (b:=b) i j).eval d x=((pMatrix x)ᴴ*pMatrix x-1) i j := by
  letI : StarRing K:=d.starRing
  simp only [preserveP,sxSub_eval,sxSumFin_eval,StarExpr.eval,Matrix.sub_apply,
    Matrix.mul_apply,Matrix.conjTranspose_apply,Matrix.one_apply,pMatrix]
  rfl
theorem preserveQ_eval (d : UnitaryFieldData (K:=K) q) (x : OuterVar a b→K) (i j : Fin b) :
    letI : StarRing K:=d.starRing
    (preserveQ (a:=a) i j).eval d x=((rMatrix x)ᴴ*rMatrix x-1) i j := by
  letI : StarRing K:=d.starRing
  simp only [preserveQ,sxSub_eval,sxSumFin_eval,StarExpr.eval,Matrix.sub_apply,
    Matrix.mul_apply,Matrix.conjTranspose_apply,Matrix.one_apply,rMatrix]
  rfl
theorem gramExpr_eval (d : UnitaryFieldData (K:=K) q) (x : OuterVar a b→K)
    (S T : Matrix (Fin a×Fin b) (Fin a×Fin b) K) (ij kl : Fin a×Fin b) :
    letI : StarRing K:=d.starRing
    (gramExpr S T ij kl).eval d x=
      (((Matrix.kronecker (pMatrix x) (rMatrix x)).transpose)ᴴ*S*
        (Matrix.kronecker (pMatrix x) (rMatrix x)).transpose-T) ij kl := by
  letI : StarRing K:=d.starRing
  simp only [gramExpr,sxSub_eval,sxSumPair_eval,StarExpr.eval,tensorExpr,Matrix.sub_apply,
    Matrix.mul_apply,Matrix.conjTranspose_apply,Matrix.transpose_apply,Matrix.kronecker,
    Matrix.kroneckerMap_apply,pMatrix,rMatrix,Finset.sum_mul]
  rw [Finset.sum_comm]
  rfl
theorem transformedExpr_degree (F : RectTensor a b c K) (s : Fin c) (ij : Fin a×Fin b) :
    (transformedExpr F s ij).degree≤2 :=
  sxSumPair_degree a b 2 _ (fun _=>by simp [StarExpr.degree,tensorExpr])
theorem kernelExpr_degree (F G : RectTensor a b c K) (s : Fin c) (t : Fin (a*b)) :
    (kernelExpr F G s t).degree≤2 :=
  sxSumPair_degree a b 2 _ (fun ij=>by simpa [StarExpr.degree] using transformedExpr_degree F s ij)
theorem preserveP_degree (i j : Fin a) : (preserveP (K:=K) (b:=b) i j).degree≤2 := by
  simp only [preserveP,sxSub,sxNeg,StarExpr.degree,max_le_iff]
  exact ⟨sxSumFin_degree a 2 _ (fun _=>by simp [StarExpr.degree]),by decide⟩
theorem preserveQ_degree (i j : Fin b) : (preserveQ (K:=K) (a:=a) i j).degree≤2 := by
  simp only [preserveQ,sxSub,sxNeg,StarExpr.degree,max_le_iff]
  exact ⟨sxSumFin_degree b 2 _ (fun _=>by simp [StarExpr.degree]),by decide⟩
theorem gramExpr_degree (S T : Matrix (Fin a×Fin b) (Fin a×Fin b) K) (ij kl : Fin a×Fin b) :
    (gramExpr S T ij kl).degree≤4 := by
  simp only [gramExpr,sxSub,sxNeg,StarExpr.degree,max_le_iff]
  exact ⟨sxSumPair_degree a b 4 _ (fun _=>sxSumPair_degree a b 4 _
    (fun _=>by simp [StarExpr.degree,tensorExpr])),by decide⟩
def gram (d : UnitaryFieldData (K:=K) q) (F : RectTensor a b c K) :
    Matrix (Fin a×Fin b) (Fin a×Fin b) K := (F.map d.automorphism).transpose*F
def ranksMatch (F G : RectTensor a b c K) : Bool :=
  decide (computedRank finProdFinEquiv.symm F=computedRank finProdFinEquiv.symm G)
def equations (d : UnitaryFieldData (K:=K) q) (F G : RectTensor a b c K) :
    List (StarExpr (OuterVar a b) K) :=
  if ranksMatch F G then
    ((List.finRange a).flatMap fun i=>(List.finRange a).map fun j=>preserveP i j) ++
    ((List.finRange b).flatMap fun i=>(List.finRange b).map fun j=>preserveQ i j) ++
    ((List.finRange c).flatMap fun i=>(List.finRange (a*b)).map fun j=>kernelExpr F G i j) ++
    ((List.finRange (a*b)).flatMap fun i=>(List.finRange (a*b)).map fun j=>
      gramExpr (gram d F) (gram d G) (finProdFinEquiv.symm i) (finProdFinEquiv.symm j))
  else [.const 1]
theorem equations_degree (d : UnitaryFieldData (K:=K) q) (F G : RectTensor a b c K) :
    ∀p∈equations d F G,p.degree≤4 := by
  intro p hp
  unfold equations at hp
  split_ifs at hp with h
  · simp only [List.mem_append,List.mem_flatMap,List.mem_map,List.mem_finRange,true_and] at hp
    rcases hp with (((⟨i,j,rfl⟩|⟨i,j,rfl⟩)|⟨i,j,rfl⟩)|⟨i,j,rfl⟩)
    · exact (preserveP_degree i j).trans (by decide)
    · exact (preserveQ_degree i j).trans (by decide)
    · exact (kernelExpr_degree F G i j).trans (by decide)
    · exact gramExpr_degree _ _ _ _
  · simp only [List.mem_singleton] at hp
    subst p
    exact Nat.zero_le _
theorem transformed_unitary_rank (d : UnitaryFieldData (K:=K) q) (F : RectTensor a b c K)
    (x : OuterVar a b→K) :
    letI : StarRing K:=d.starRing
    (pMatrix x)ᴴ*pMatrix x=1 → (rMatrix x)ᴴ*rMatrix x=1 → (transformedMatrix x F).rank=F.rank := by
  letI : StarRing K:=d.starRing
  intro hP hQ
  have hW:(Matrix.kronecker (pMatrix x) (rMatrix x))ᴴ*Matrix.kronecker (pMatrix x) (rMatrix x)=1 := by
    unfold Matrix.kronecker
    rw [Matrix.conjTranspose_kronecker,←Matrix.mul_kronecker_mul,hP,hQ,Matrix.one_kronecker_one]
  have hu:=Matrix.isUnit_det_of_right_inverse (mul_eq_one_comm.mp hW)
  exact Matrix.rank_mul_eq_left_of_isUnit_det _ F (by simpa only [Matrix.det_transpose] using hu)
theorem kernelEquations_iff (d : UnitaryFieldData (K:=K) q) (F G : RectTensor a b c K)
    (x : OuterVar a b→K) :
    letI : StarRing K:=d.starRing
    (pMatrix x)ᴴ*pMatrix x=1 → (rMatrix x)ᴴ*rMatrix x=1 → F.rank=G.rank →
      ((∀s t,(kernelExpr F G s t).eval d x=0) ↔
        LinearMap.ker (transformedMatrix x F).toLin'=LinearMap.ker G.toLin') := by
  letI : StarRing K:=d.starRing
  intro hP hQ hr
  have hspan:Submodule.span K (Set.range (kernelFamily G))=LinearMap.ker G.toLin':=computedKernel_span _ _
  have hRank:Module.finrank K (LinearMap.range (transformedMatrix x F).toLin')=
      Module.finrank K (LinearMap.range G.toLin') := by
    simp only [Matrix.toLin'_apply']
    exact (transformed_unitary_rank d F x hP hQ).trans hr
  have h:=kernel_equations_iff_kernel_eq x F G (kernelFamily G) hspan hRank
  simpa only [eval_kernelEntry_eq_mulVec,kernelExpr_eval] using h
theorem equations_zero_iff (d : UnitaryFieldData (K:=K) q) (F G : RectTensor a b c K)
    (x : OuterVar a b→K) :
    letI : StarRing K:=d.starRing
    (∀p∈equations d F G,p.eval d x=0) ↔
      (pMatrix x)ᴴ*pMatrix x=1 ∧ (rMatrix x)ᴴ*rMatrix x=1 ∧
      LinearMap.ker (transformedMatrix x F).toLin'=LinearMap.ker G.toLin' ∧
      (transformedMatrix x F)ᴴ*transformedMatrix x F=Gᴴ*G := by
  letI : StarRing K:=d.starRing
  have hPiff:(∀i j,(preserveP (b:=b) i j).eval d x=0) ↔ (pMatrix x)ᴴ*pMatrix x=1 := by
    simp_rw [preserveP_eval]
    exact ⟨fun h=>sub_eq_zero.mp (Matrix.ext h),fun h=>by simp [h]⟩
  have hQiff:(∀i j,(preserveQ (a:=a) i j).eval d x=0) ↔ (rMatrix x)ᴴ*rMatrix x=1 := by
    simp_rw [preserveQ_eval]
    exact ⟨fun h=>sub_eq_zero.mp (Matrix.ext h),fun h=>by simp [h]⟩
  have hGiff:(∀i j,(gramExpr (gram d F) (gram d G) i j).eval d x=0) ↔
      (transformedMatrix x F)ᴴ*transformedMatrix x F=Gᴴ*G := by
    simp_rw [gramExpr_eval]
    have he:(Matrix.kronecker (pMatrix x) (rMatrix x)).transposeᴴ*gram d F*
        (Matrix.kronecker (pMatrix x) (rMatrix x)).transpose-gram d G=
        (transformedMatrix x F)ᴴ*transformedMatrix x F-Gᴴ*G := by
      simp only [transformedMatrix,Matrix.conjTranspose_mul,Matrix.mul_assoc,gram]
      rfl
    rw [he]
    exact ⟨fun h=>sub_eq_zero.mp (Matrix.ext h),fun h=>by simp [h]⟩
  have hlist:(∀p∈equations d F G,p.eval d x=0) ↔ ranksMatch F G=true ∧
      (∀i j,(preserveP (b:=b) i j).eval d x=0) ∧
      (∀i j,(preserveQ (a:=a) i j).eval d x=0) ∧
      (∀s t,(kernelExpr F G s t).eval d x=0) ∧
      (∀i j,(gramExpr (gram d F) (gram d G) i j).eval d x=0) := by
    by_cases h:ranksMatch F G=true
    · simp only [equations,h,ite_true,List.forall_mem_append,List.forall_mem_flatMap,
        List.forall_mem_map,List.mem_finRange,forall_true_left,true_and]
      have hg : (∀i j:Fin (a*b),(gramExpr (gram d F) (gram d G)
          (finProdFinEquiv.symm i) (finProdFinEquiv.symm j)).eval d x=0) ↔
          ∀i j,(gramExpr (gram d F) (gram d G) i j).eval d x=0 := by
        constructor
        · intro h i j
          simpa only [Equiv.symm_apply_apply] using h (finProdFinEquiv i) (finProdFinEquiv j)
        · intro h i j; exact h _ _
      rw [hg]
      tauto
    · simp [equations,h,StarExpr.eval]
  rw [hlist,hPiff,hQiff,hGiff]
  simp only [ranksMatch,decide_eq_true_eq,computedRank_correct]
  constructor
  · rintro ⟨hr,hP,hQ,hk,hg⟩
    exact ⟨hP,hQ,(kernelEquations_iff d F G x hP hQ hr).mp hk,hg⟩
  · rintro ⟨hP,hQ,hk,hg⟩
    have hr:F.rank=G.rank := by
      have h:=rank_eq_of_kernel_eq _ _ hk
      rw [transformed_unitary_rank d F x hP hQ] at h
      exact h
    exact ⟨hr,hP,hQ,(kernelEquations_iff d F G x hP hQ hr).mpr hk,hg⟩
theorem equations_equivalence (d : UnitaryFieldData (K:=K) q) (F G : RectTensor a b c K) :
    letI : StarRing K:=d.starRing
    (∃x:OuterVar a b→K,∀p∈equations d F G,p.eval d x=0) ↔
      Problem18Assembly.RectUnitaryEquivalent F G := by
  classical
  letI : StarRing K:=d.starRing
  letI : Fintype (Problem18InvolutionNorm20260930.fixedField d.automorphism):=Fintype.ofFinite _
  have hf:=Problem18UnitaryFinalFactor20260930.final_unitary_factor_iff
    (K:=K) (F:=Problem18InvolutionNorm20260930.fixedField d.automorphism)
    (n:=c) (ι:=Fin a×Fin b) d.quadratic_card d.star_eq_fixed_card
  simp_rw [equations_zero_iff]
  constructor
  · rintro ⟨x,hP,hQ,hk,hg⟩
    obtain ⟨R,hR,hRG⟩:=(hf (transformedMatrix x F) G).mpr ⟨hk,hg⟩
    refine ⟨pMatrix x,rMatrix x,R,hP,hQ,hR,?_⟩
    simpa only [Problem18Assembly.rectAction,transformedMatrix,Matrix.mul_assoc] using hRG
  · rintro ⟨P,Q,R,hP,hQ,hR,hact⟩
    let x:OuterVar a b→K:=Sum.elim (fun ij=>P ij.1 ij.2) (fun ij=>Q ij.1 ij.2)
    have hxP:pMatrix x=P:=rfl
    have hxQ:rMatrix x=Q:=rfl
    have hFG:R*transformedMatrix x F=G := by
      simpa only [Problem18Assembly.rectAction,transformedMatrix,hxP,hxQ,Matrix.mul_assoc] using hact
    obtain ⟨hk,hg⟩:=(hf (transformedMatrix x F) G).mp ⟨R,hR,hFG⟩
    exact ⟨x,hP,hQ,hk,hg⟩
def groundEquations (P : Problem18AllFormatRoot20260930.FieldPresentation K)
    (d : UnitaryFieldData (K:=K) q) (F G : RectTensor a b c K) :
    List (PolyExpr (OuterCoordVar a b) (Problem18InvolutionNorm20260930.fixedField d.automorphism)) :=
  (equations d F G).flatMap fun p=>[(compile P d p).1,(compile P d p).2]
theorem groundEquations_degree (P : Problem18AllFormatRoot20260930.FieldPresentation K)
    (d : UnitaryFieldData (K:=K) q) (F G : RectTensor a b c K) :
    ∀p∈groundEquations P d F G,p.degree≤4 := by
  intro r hr
  obtain ⟨p,hp,hr⟩:=List.mem_flatMap.mp hr
  have hd:=equations_degree d F G p hp
  have hc:=compile_degree P d p
  simp only [List.mem_cons,List.not_mem_nil,or_false] at hr
  rcases hr with rfl|rfl
  · exact hc.1.trans hd
  · exact hc.2.trans hd
end Mathproof.Problem18BoundedUnitarySystem20261001
end
section
namespace Mathproof.Problem18BoundedEquationWork20261001
open Problem18ExpressionCoefficientBackend20261001 Problem18BoundedEncoding20260930
  Problem18BoundedUnitarySystem20261001 Problem18QuadraticExpressionCompiler20261001
  Problem18CountedQuadraticCompiler20261001 Problem18BoundedComputedPreprocessing20261001
  Problem18BoundedSolverBridge20260930 Problem18UnitaryRootField20260930
  Problem18AllFormatRoot20260930
open Problem18OrthogonalAssembly (RectTensor)
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] {σ : Type*} {a b c q : Nat}
def starMass : StarExpr σ K→Nat
  | .const _=>1
  | .var _=>1
  | .add a b=>starMass a+starMass b
  | .mul a b=>8*starMass a*starMass b
  | .conj a=>3*starMass a
theorem starMass_pos (p : StarExpr σ K) : 1 ≤ starMass p := by
  induction p <;> simp_all only [starMass] <;> nlinarith
theorem constants_le_mass (p : StarExpr σ K) : constantLeaves p ≤ starMass p := by
  induction p with
  | const _=>rfl
  | var _=>exact Nat.zero_le _
  | add a b iha ihb=>exact Nat.add_le_add iha ihb
  | mul a b iha ihb=>
    have ha:=starMass_pos a
    have hb:=starMass_pos b
    simp only [constantLeaves,starMass]
    nlinarith
  | conj a ih=>simp only [constantLeaves,starMass]; omega
theorem compile_mass (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) (p : StarExpr σ K) :
    expansionMass (compile F d p).1 ≤ starMass p ∧ expansionMass (compile F d p).2 ≤ starMass p := by
  induction p with
  | const _=>exact ⟨Nat.le_refl _,Nat.le_refl _⟩
  | var _=>exact ⟨Nat.le_refl _,Nat.le_refl _⟩
  | add a b iha ihb=>exact ⟨Nat.add_le_add iha.1 ihb.1,Nat.add_le_add iha.2 ihb.2⟩
  | mul a b iha ihb=>
    have h11:=Nat.mul_le_mul iha.1 ihb.1
    have h12:=Nat.mul_le_mul iha.1 ihb.2
    have h21:=Nat.mul_le_mul iha.2 ihb.1
    have h22:=Nat.mul_le_mul iha.2 ihb.2
    simp only [compile,expansionMass,starMass]
    constructor <;> nlinarith
  | conj a ih=>
    simp only [compile,expansionMass,starMass,PolyExpr.neg]
    constructor <;> omega
theorem sxSum_mass (ps : List (StarExpr σ K)) (M : Nat) (h : ∀p∈ps,starMass p ≤ M) :
    starMass (sxSum ps) ≤ ps.length*M+1 := by
  induction ps with
  | nil=>simp [sxSum,starMass]
  | cons p ps ih=>
    have hp:=h p List.mem_cons_self
    have ht:=ih (fun t ht=>h t (List.mem_cons_of_mem p ht))
    simp only [sxSum,starMass,List.length_cons]
    nlinarith
theorem sxSumFin_mass (n M : Nat) (f : Fin n→StarExpr σ K) (h : ∀i,starMass (f i) ≤ M) :
    starMass (sxSumFin n f) ≤ n*M+1 := by
  have hh:=sxSum_mass ((List.finRange n).map f) M (by
    intro p hp
    obtain ⟨i,_,rfl⟩:=List.mem_map.mp hp
    exact h i)
  simpa only [sxSumFin,List.length_map,List.length_finRange] using hh
theorem sxSumPair_mass (a b M : Nat) (f : Fin a×Fin b→StarExpr σ K) (h : ∀i,starMass (f i) ≤ M) :
    starMass (sxSumPair a b f) ≤ a*(b*M+1)+1 :=
  sxSumFin_mass a _ _ (fun i=>sxSumFin_mass b M _ (fun j=>h (i,j)))
def transformedMass (a b : Nat) := a*(b*64+1)+1
def unitaryMass (a b : Nat) :=
  (24*a+9)+(24*b+9)+(a*(b*(8*transformedMass a b)+1)+1)+
    (a*(b*(a*(b*12288+1)+1)+1)+9)+1
theorem transformedExpr_mass (F : RectTensor a b c K) (s : Fin c) (ij : Fin a×Fin b) :
    starMass (transformedExpr F s ij) ≤ transformedMass a b := by
  apply sxSumPair_mass
  intro uv
  simp [starMass,tensorExpr]
theorem preserveP_mass (i j : Fin a) : starMass (preserveP (K:=K) (b:=b) i j) ≤ 24*a+9 := by
  have h:=sxSumFin_mass a 24 (fun u=>StarExpr.mul (StarExpr.conj (.var (.inl (u,i)))) (.var (.inl (u,j))))
    (σ:=OuterVar a b) (K:=K) (by intro u; norm_num [starMass])
  change _+8 ≤ _
  nlinarith
theorem preserveQ_mass (i j : Fin b) : starMass (preserveQ (K:=K) (a:=a) i j) ≤ 24*b+9 := by
  have h:=sxSumFin_mass b 24 (fun u=>StarExpr.mul (StarExpr.conj (.var (.inr (u,i)))) (.var (.inr (u,j))))
    (σ:=OuterVar a b) (K:=K) (by intro u; norm_num [starMass])
  change _+8 ≤ _
  nlinarith
theorem kernelExpr_mass (F G : RectTensor a b c K) (s : Fin c) (t : Fin (a*b)) :
    starMass (kernelExpr F G s t) ≤ a*(b*(8*transformedMass a b)+1)+1 := by
  apply sxSumPair_mass
  intro ij
  simp only [starMass,mul_one]
  exact Nat.mul_le_mul_left 8 (transformedExpr_mass F s ij)
theorem gramExpr_mass (S T : Matrix (Fin a×Fin b) (Fin a×Fin b) K) (ij kl : Fin a×Fin b) :
    starMass (gramExpr S T ij kl) ≤ a*(b*(a*(b*12288+1)+1)+1)+9 := by
  have h:=sxSumPair_mass a b (a*(b*12288+1)+1)
    (fun u=>sxSumPair a b fun v=>StarExpr.mul (.mul (.conj (tensorExpr ij u)) (.const (S u v))) (tensorExpr kl v))
    (by intro u; apply sxSumPair_mass; intro v; norm_num [starMass,tensorExpr])
  change _+8 ≤ _
  omega
theorem equations_mass (d : UnitaryFieldData (K:=K) q) (F G : RectTensor a b c K) :
    ∀p∈equations d F G,starMass p ≤ unitaryMass a b := by
  intro p hp
  unfold equations at hp
  split_ifs at hp with h
  · simp only [List.mem_append,List.mem_flatMap,List.mem_map,List.mem_finRange,true_and] at hp
    rcases hp with (((⟨i,j,rfl⟩|⟨i,j,rfl⟩)|⟨i,j,rfl⟩)|⟨i,j,rfl⟩)
    · have hh:=preserveP_mass (K:=K) (b:=b) i j; unfold unitaryMass; omega
    · have hh:=preserveQ_mass (K:=K) (a:=a) i j; unfold unitaryMass; omega
    · have hh:=kernelExpr_mass F G i j; unfold unitaryMass; omega
    · have hh:=gramExpr_mass (gram d F) (gram d G) (finProdFinEquiv.symm i) (finProdFinEquiv.symm j)
      unfold unitaryMass; omega
  · simp only [List.mem_singleton] at hp
    subst p
    simp only [starMass,unitaryMass]
    omega
theorem equations_length (d : UnitaryFieldData (K:=K) q) (F G : RectTensor a b c K) :
    (equations d F G).length ≤ a*a+b*b+c*(a*b)+(a*b)*(a*b)+1 := by
  unfold equations
  split_ifs <;> simp [List.length_flatMap]
  omega
theorem groundEquations_mass (P : FieldPresentation K) (d : UnitaryFieldData (K:=K) q)
    (F G : RectTensor a b c K) :
    ∀p∈groundEquations P d F G,expansionMass p ≤ unitaryMass a b := by
  intro p hp
  obtain ⟨r,hr,hp⟩:=List.mem_flatMap.mp hp
  have h:=equations_mass d F G r hr
  have hc:=compile_mass P d r
  simp only [List.mem_cons,List.not_mem_nil,or_false] at hp
  rcases hp with rfl|rfl
  · exact hc.1.trans h
  · exact hc.2.trans h
end Mathproof.Problem18BoundedEquationWork20261001
end
