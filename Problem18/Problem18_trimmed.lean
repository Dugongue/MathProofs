    (K : Type) [Field K] [Fintype K] [BEq K] [LawfulBEq K]
    [DecidableEq K] (F : FieldPresentation K) (u : Bool)
    (q a b c : Nat) (hv : validSize K u q) (ha : 0 < a) (hb : 0 < b)
    (hc : 0 < c) (A : RectTensor a b c K) :
