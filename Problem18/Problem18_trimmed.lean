  have hB2 : 1 < W := by have := hG.mem_word; have := hG.mem_len; have := F.degree_pos; omega
  have hpW : F.p < W := by
    have : F.p + 1 ≤ (F.p + 1) ^ 2 := Nat.le_self_pow (by norm_num) _
