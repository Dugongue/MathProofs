private theorem finite_union_scaled {X I : Type*} [Finite X] [Fintype I]
    (P : X→Prop) (Q : I→X→Prop) (hcover : ∀ x,P x→∃i,Q i x)
    (w s : ℝ) (hw : 0≤w) (hb : ∀ i,(Nat.card {x : X//Q i x}:ℝ)*w≤ s) :
    (Nat.card {x : X//P x}:ℝ)*w≤(Nat.card I:ℝ)*s := by
