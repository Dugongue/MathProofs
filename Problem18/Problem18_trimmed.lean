theorem rational_restrict_type [Fintype k] [Finite E]
    (H : Type*) [Field H] [Algebra k H] [Algebra H L] [IsScalarTower k H L]
    [Algebra.IsAlgebraic H L] (θ : L ≃ₐ[k] L)
    (hH : ∀ x : H, θ (algebraMap H L x) = algebraMap H L x)
    (hE : ∀ c : E, θ (algebraMap E L c) =
      algebraMap E L (FiniteField.frobeniusAlgEquivOfAlgebraic k E c))
    (Q : Place E L) (hQ : Q.degree = 1)
    (hθ : ∀ x : L, Q.valuation (θ x) = Q.valuation x) :
    (restrictPlace k H L (forgetConstants k E L Q)).degree = 1 := by
  apply (degree_one_iff_approximation _).mpr
  intro x hx
  have hxQ : algebraMap H L x ∈ Q := (mem_restrictPlace k H L _ x).mp hx
  obtain ⟨c,hc⟩ := (degree_one_iff_approximation Q).mp hQ (algebraMap H L x) hxQ
  have hc' : Q.valuation (algebraMap H L x - algebraMap E L
      (FiniteField.frobeniusAlgEquivOfAlgebraic k E c)) < 1 := by
    have h := hθ (algebraMap H L x - algebraMap E L c)
    rw [map_sub, hH, hE] at h
    exact h.symm ▸ hc
  have hdiff : Q.valuation (algebraMap E L
      (FiniteField.frobeniusAlgEquivOfAlgebraic k E c - c)) < 1 := by
    have h := Q.valuation.map_sub_lt hc hc'
    convert h using 1
    congr 1
    rw [map_sub]
    ring
  have hcf : FiniteField.frobeniusAlgEquivOfAlgebraic k E c = c := by
    by_contra hne
    rw [Valuation.IsTrivialOn.eq_one _ (sub_ne_zero.mpr hne)] at hdiff
    exact lt_irrefl _ hdiff
  obtain ⟨a,ha⟩ := Problem18FrobeniusTwistField20260930.frobenius_fixed_mem_range k E c hcf
  refine ⟨a,?_⟩
  apply (restrictPlace_valuation_isEquiv k H L _).lt_one_iff_lt_one.mpr
  change Q.valuation (algebraMap H L (x - algebraMap k H a)) < 1
  rw [map_sub, ← IsScalarTower.algebraMap_apply k H L,
    IsScalarTower.algebraMap_apply k E L, ha]
  exact hc
end Descent
