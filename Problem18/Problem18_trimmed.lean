      simp; omega
  have hI : I (σ.setVar fj 0) := by
    refine ⟨by simp, (vsn (by decide)).trans hN, (vsn (by decide)).trans hb, (vsn (by decide)).trans he,
      rfl, fun _ _ => rfl, by simp, fun _ _ => rfl⟩
  obtain ⟨τ, hr, hτ, hfalse⟩ := Run.while_count I V 26 hdef hstep hI
  obtain ⟨hj, hcnt, -, -, hlen, harr, hin, hout⟩ := hτ
  have ht := evalB_condLt (evalB_var (by omega : τ.vars fj < B))
    (evalB_var (by rw [hcnt]; exact hNB : τ.vars fcnt < B))
  rw [hfalse, hcnt] at ht
  have hjN : τ.vars fj = N := by
    have hh : ¬ τ.vars fj < N := by simpa using ht.symm
    omega
  have hrun : Run B fill σ τ (30*N+8) := by
    have hh := (Run.assign (σ:=σ) (x:=fj) (evalB_lit (by omega : 0 < B))).seq hr
    apply hh.mono
    simp [V, Cond.size, Expr.size]
    omega
  refine ⟨τ, hrun, fun k hk => hin k (by omega), fun j hj' => hout j (by omega), hlen, harr, ?_, ?_, ?_⟩
  · intro x hx
    apply (run_frame hrun).1 x
    simp [fill, fillBody, scalarWrites, hx]
  · exact (run_frame hrun).2.2.2.1 (by simp [fill, fillBody, noRead])
  · exact (run_frame hrun).2.2.2.2 (by simp [fill, fillBody, Com.NoWrite])
variable {K : Type} [Field K] (F : FieldPresentation K)
theorem fill_matrix {σ : Env} {b m c : Nat}
    (h : ∀ k < F.e*(m*c), (σ.arrs canonical.mem).getD (b+k) 0 = unitDigit F.e k) :
    Problem18IMPMatrixMemory20261001.matrix F σ b m c = fun _ _ => 1 := by
  funext i j
  unfold Problem18IMPMatrixMemory20261001.matrix
  rw [← decode_unit F]
  congr 1
  funext t
  unfold slice Problem18IMPMatrixMemory20261001.address
  have h1 := Problem18IMPMatrixMemory20261001.index_lt i j
  have hk : F.e*(i.val*c+j.val) + t.val < F.e*(m*c) := by
    have h2 : i.val*c+j.val+1 ≤ m*c := h1
    have h3 := Nat.mul_le_mul_left F.e h2
    have := t.isLt
    nlinarith
  rw [Nat.add_assoc, h _ hk]
  unfold unitDigit
  have he := F.degree_pos
  have : (F.e*(i.val*c+j.val) + t.val) % F.e = t.val := by
    rw [Nat.add_comm, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt t.isLt]
  rw [this]
