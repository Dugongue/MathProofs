    Finite.of_injective (fun C : V →ₛₗ[(τ : K →+* K)] V →ₗ[K] K =>
      fun x y => C x y) (by
        intro B C h
        apply LinearMap.ext
        intro x
        apply LinearMap.ext
        intro y
        exact congrFun (congrFun h x) y)
  unfold Incidence
  infer_instance
noncomputable def pullback (τ : K ≃+* K)
    (B : V →ₛₗ[(τ : K →+* K)] V →ₗ[K] K) (f : V ≃ₗ[K] V) :
    V →ₛₗ[(τ : K →+* K)] V →ₗ[K] K :=
  (B.comp f.toLinearMap).compl₂ f.toLinearMap
theorem conjugateEmbedding_injective (f : V ≃ₗ[K] V) :
    Function.Injective (fun ρ : E →ₐ[K] Module.End K V => conjugateEmbedding ρ f) := by
  intro ρ η h
  apply AlgHom.ext
  intro a
  apply LinearMap.ext
  intro x
  have hx := congrArg (fun g : E →ₐ[K] Module.End K V => f.symm (g a (f x))) h
  simpa only [conjugateEmbedding_apply, LinearEquiv.symm_apply_apply] using hx
noncomputable def incidenceEncode (τ : K ≃+* K) (σ : E ≃+* E) (eps : K)
    (B : V →ₛₗ[(τ : K →+* K)] V →ₗ[K] K)
    (hsym : ∀ x y, B y x = eps * τ (B x y))
    (z : CompatibleEmbedding σ (fun x y => B x y) × FormOrbit τ B) :
    Incidence (n := n) τ σ eps := by
  let f := orbitRepresentative τ B z.2
  refine ⟨conjugateEmbedding z.1.1 f.symm, pullback τ B f, ?_, ?_⟩
  · intro a x y
    change B (f (f.symm (z.1.1 a (f x)))) (f y) =
      B (f x) (f (f.symm (z.1.1 (σ a) (f y))))
    simpa only [LinearEquiv.apply_symm_apply] using z.1.2 a (f x) (f y)
  · intro x y
    exact hsym (f x) (f y)
theorem incidenceEncode_injective (τ : K ≃+* K) (σ : E ≃+* E) (eps : K)
    (B : V →ₛₗ[(τ : K →+* K)] V →ₗ[K] K)
    (hsym : ∀ x y, B y x = eps * τ (B x y)) :
    Function.Injective (incidenceEncode τ σ eps B hsym) := by
  rintro ⟨ρ, C⟩ ⟨η, D⟩ h
  have hc : C = D := by
    apply Subtype.ext
    funext x y
    have hf := congrArg (fun z : Incidence (n := n) τ σ eps => z.2.1 x y) h
    change B (orbitRepresentative τ B C x) (orbitRepresentative τ B C y) =
      B (orbitRepresentative τ B D x) (orbitRepresentative τ B D y) at hf
    simpa only [orbitRepresentative_spec] using hf
  subst D
  have hr := congrArg Sigma.fst h
  change conjugateEmbedding ρ.1 (orbitRepresentative τ B C).symm =
    conjugateEmbedding η.1 (orbitRepresentative τ B C).symm at hr
  have he : ρ = η := Subtype.ext (conjugateEmbedding_injective _ hr)
  subst η
  rfl
theorem compatible_embedding_card_mul_orbit_le (τ : K ≃+* K) (σ : E ≃+* E) (eps : K)
    (B : V →ₛₗ[(τ : K →+* K)] V →ₗ[K] K)
    (hsym : ∀ x y, B y x = eps * τ (B x y)) :
    Nat.card (CompatibleEmbedding σ (fun x y => B x y)) * Nat.card (FormOrbit τ B) ≤
      Nat.card (Incidence (n := n) τ σ eps) := by
  classical
  rw [← Nat.card_prod]
  exact Nat.card_le_card_of_injective _ (incidenceEncode_injective τ σ eps B hsym)
end Mathproof.Problem18CompatibleEmbeddingIncidence20260930
