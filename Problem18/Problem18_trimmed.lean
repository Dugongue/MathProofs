  unfold rgDst plus
  have h1 : (Expr.var mn.oB).evalB B σ = some ov := by rw [← ho]; exact evalB_var (by omega)
  have h2 : (Expr.var mn.t).evalB B σ = some tv := by rw [← ht]; exact evalB_var (by omega)
  have h3 : (Expr.bin .mul (.var mn.t) (.lit Lo)).evalB B σ = some (tv * Lo) :=
    evalB_bin h2 (evalB_lit hLB) (by change tv * Lo < B; omega)
  exact evalB_bin h1 h3 (by change ov + tv * Lo < B; exact hlt)
theorem gval_congr {g1 g2 : ℕ → K} {sv : ℕ} {o : Option ℕ}
