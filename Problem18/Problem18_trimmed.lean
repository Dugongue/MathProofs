def regularBudget (n : ℕ) := (n+1)*(n+1)+(n+1)*Mathproof.Problem18CountedPolynomialLoops20261001.remainderBudget n+3
def trial {b c : ℕ} (q : ℕ) (A B : Matrix (Fin c) (Fin b) K) (v w : Fin b→K) : Option Bool×ℕ :=
  let SA := Mathproof.Problem18CountedMatrixProducts20261001.mul A.transpose A
  let SB := Mathproof.Problem18CountedMatrixProducts20261001.mul B.transpose B
  let fA := Mathproof.Problem18CountedPolynomialBird20261001.characteristic b (arrayOf SA.1)
  let fB := Mathproof.Problem18CountedPolynomialBird20261001.characteristic b (arrayOf SB.1)
  let regular := regularCheck fB.1
  let eq := coefficientEq fA.1 fB.1
  let cv := Mathproof.Problem18CountedKrylov20261001.cyclicCheck SA.1 v
  let cw := Mathproof.Problem18CountedKrylov20261001.cyclicCheck SB.1 w
  let Q := Mathproof.Problem18CountedKrylov20261001.candidate b (arrayOf SA.1) (arrayOf SB.1) v w
  let D := Mathproof.Problem18CountedMatrixProducts20261001.mul (matrix b Q.1).transpose (matrix b Q.1)
  let checks := Mathproof.Problem18CountedBoundaryDegreeTests20261001.allChecks b (arrayOf SA.1) (arrayOf D.1) fA.1 q
  (if regular.1 && eq.1 then if cv.1 && cw.1 then some checks.1 else none else some false,
    SA.2+SB.2+fA.2+fB.2+regular.2+eq.2+cv.2+cw.2+Q.2+D.2+checks.2+6)
def trialBudget (b c q : ℕ) :=
  4*b*c*b+2*(3*b*b+Mathproof.Problem18CountedPolynomialBird20261001.determinantBudget b)+regularBudget b+
  2*(Mathproof.Problem18CountedKrylov20261001.krylovBudget b+Mathproof.Problem18CountedBoundaryMatrices20261001.detBudget b)+
  (2*Mathproof.Problem18CountedKrylov20261001.krylovBudget b+Mathproof.Problem18CountedBoundaryMatrices20261001.detBudget b+1+
    b*b*(Mathproof.Problem18CountedBoundaryMatrices20261001.detBudget b+1)+2*b*b*b)+2*b*b*b+
  b*Mathproof.Problem18CountedBoundaryDegreeTests20261001.degreeBudget b q b+(b+1)+6
