open Mathproof.LibraryBridges.Claude.GroebnerNormalForms_20260908 (generatedIdeal)
variable {K : Type*} [Field K] [DecidableEq K] [Fintype K]
def clauseRows {c0 m : ℕ} (c : Clause (Fin (c0 + m)) ℤ) (a : Fin c0 → K) :
    List (DenseInput (m + 1) (clauseDeg c) K × ℕ) :=
  (sysExprs c).map fun p => evaluateTemplate (Int.castRingHom K) a p (clauseDeg c)
def clauseRun {c0 m : ℕ} (c : Clause (Fin (c0 + m)) ℤ) (a : Fin c0 → K) : Bool × ℕ :=
  let evs := clauseRows c a
  let r := finiteRationalDecide (Fintype.card K) (clauseDeg c) (evs.map Prod.fst)
  (r.1, (evs.map Prod.snd).sum + r.2)
noncomputable def clausePolys {c0 m : ℕ} (c : Clause (Fin (c0 + m)) ℤ) (a : Fin c0 → K) :
    List (MvPolynomial (Fin (m + 1)) K) :=
  (sysExprs c).map fun p => sparsePolynomial (Int.castRingHom K) a (expand id p)
theorem clauseRows_valid {c0 m : ℕ} (c : Clause (Fin (c0 + m)) ℤ) (a : Fin c0 → K) :
    List.Forall₂ (ValidDenseInput (clauseDeg c)) ((clauseRows c a).map Prod.fst)
      (clausePolys c a) := by
  simp only [clauseRows, clausePolys, List.map_map, List.forall₂_map_left_iff,
    List.forall₂_map_right_iff, Function.comp_apply, List.forall₂_same]
  intro p hp
  exact evaluateTemplate_valid _ _ _ _ fun b hb =>
    (expand_bound id p b hb).trans (sysExprs_degree c p hp)
theorem eval_clausePoly {c0 m : ℕ} (a : Fin c0 → K) (p : PolyExpr (Fin c0 ⊕ Fin (m + 1)) ℤ)
    (y : Fin (m + 1) → K) :
    eval y (sparsePolynomial (Int.castRingHom K) a (expand id p)) =
      interpret (Int.castRingHom K) (Sum.elim a y) p := by
  rw [expand_eval]
  rfl
theorem map_sparsePolynomial {L : Type*} [Field L] (g : K →+* L) {σ : Type*} {N : ℕ}
    (a : σ → K) (s : Sparse N σ ℤ) :
    MvPolynomial.map g (sparsePolynomial (Int.castRingHom K) a s) =
      sparsePolynomial (Int.castRingHom L) (fun i => g (a i)) s := by
  simp only [sparsePolynomial, map_list_sum, List.map_map]
  congr 1
  apply List.map_congr_left
  intro b _
  simp only [Function.comp_apply, map_monomial, interpret_map]
theorem aeval_clausePoly {L : Type*} [Field L] [Algebra K L] {c0 m : ℕ} (a : Fin c0 → K)
    (p : PolyExpr (Fin c0 ⊕ Fin (m + 1)) ℤ) (z : Fin (m + 1) → L) :
    aeval z (sparsePolynomial (Int.castRingHom K) a (expand id p)) =
      interpret (Int.castRingHom L) (Sum.elim (fun i => algebraMap K L (a i)) z) p := by
  rw [MvPolynomial.aeval_def, ← MvPolynomial.eval_map, map_sparsePolynomial, expand_eval]
  rfl
theorem clause_locus_finite {L : Type*} [Field L] [Algebra K L] [IsAlgClosed L]
    {c0 m : ℕ} (φ : Formula ℤ (c0 + m)) (c : Clause (Fin (c0 + m)) ℤ) (hc : c ∈ clauses (qe φ))
    (a : Fin c0 → K)
    (hB : {u : Fin m → L | φ.Holds (Int.castRingHom L)
      (Fin.append (fun i => algebraMap K L (a i)) u)}.Finite) :
    (zeroLocus L (generatedIdeal ((clausePolys c a).toFinset :
      Set (MvPolynomial (Fin (m + 1)) K)))).Finite := by
  classical
  set aL : Fin c0 → L := fun i => algebraMap K L (a i) with haL
  refine (hB.image fun u => Fin.snoc u (interpret (Int.castRingHom L) (Fin.append aL u)
    (exprProduct (nonzeroExpressions c)))⁻¹).subset ?_
  intro z hz
  rw [mem_zeroLocus_iff] at hz
  have hsys : ∀ p ∈ sysExprs c, interpret (Int.castRingHom L) (Sum.elim aL z) p = 0 := by
    intro p hp
    rw [← aeval_clausePoly]
    apply hz
    apply Ideal.subset_span
    simp only [Finset.mem_coe, List.mem_toFinset, clausePolys, List.mem_map]
    exact ⟨p, hp, rfl⟩
  obtain ⟨hcl, hprod⟩ := (sysExprs_zero_iff c aL z).mp hsys
  refine ⟨Fin.init z, ?_, ?_⟩
  · show φ.Holds (Int.castRingHom L) (Fin.append aL (Fin.init z))
    rw [← qe_correct, ← clauses_correct]
    exact ⟨c, hc, hcl⟩
  · simp only
    rw [← eq_inv_of_mul_eq_one_left hprod]
    exact Fin.snoc_init_self z
theorem clauseRun_correct {L : Type*} [Field L] [Algebra K L] [IsAlgClosed L]
    [Algebra.IsAlgebraic K L] {c0 m : ℕ} (c : Clause (Fin (c0 + m)) ℤ) (a : Fin c0 → K)
    (hfin : (zeroLocus L (generatedIdeal ((clausePolys c a).toFinset :
      Set (MvPolynomial (Fin (m + 1)) K)))).Finite) :
    (clauseRun c a).1 = true ↔ ∃ u : Fin m → K, clauseHolds (Int.castRingHom K) (Fin.append a u) c := by
  show (finiteRationalDecide (Fintype.card K) (clauseDeg c)
    ((clauseRows c a).map Prod.fst)).1 = true ↔ _
  rw [finiteRationalDecide_correct (L := L) _ _ rfl _ _ (clauseRows_valid c a) hfin,
    ← exists_sys_zero_iff]
  refine exists_congr fun y => ?_
  simp only [clausePolys, List.mem_map, forall_exists_index, and_imp, forall_apply_eq_imp_iff₂,
    eval_clausePoly]
theorem clauseRun_cost {c0 m : ℕ} (c : Clause (Fin (c0 + m)) ℤ) (a : Fin c0 → K) :
    (clauseRun c a).2 ≤ ((sysExprs c).map fun p => templateCost p (clauseDeg c)).sum +
      decisionConstant (m + 1) (clauseDeg c) (sysExprs c).length *
        (Nat.size (Fintype.card K) + 1) := by
  show ((clauseRows c a).map Prod.snd).sum + (finiteRationalDecide (Fintype.card K) (clauseDeg c)
    ((clauseRows c a).map Prod.fst)).2 ≤ _
  have h1 : ((clauseRows c a).map Prod.snd).sum =
      ((sysExprs c).map fun p => templateCost p (clauseDeg c)).sum := by
    simp only [clauseRows, List.map_map, Function.comp_def, evaluateTemplate_cost]
  rw [h1]
  refine Nat.add_le_add_left (finiteRationalDecide_cost_card _ _ _ ?_) _
  simp [clauseRows]
end ClauseRun
