    B (e.val x) (e.val y)=modelTraceForm g (fun i => (frameCoefficients g hm hcop B hB hnB S e i).val) x y :=
  (Classical.choose_spec (frame_trace_representation g hm hcop B hB hnB
    S.val S.property.1 S.property.2 e)).2 x y
noncomputable def traceOperator (c : Coefficients g) (e : TraceIsometries g B c) : Operators g B :=
  ⟨e.val.conj (modelOperator g),by
    constructor
    · rw [LinearEquiv.charpoly_conj,modelOperator_charpoly g hm hcop]
    · intro x y
      obtain ⟨x,rfl⟩ := e.val.surjective x
      obtain ⟨y,rfl⟩ := e.val.surjective y
      simp only [LinearEquiv.conj_apply_apply,LinearEquiv.symm_apply_apply]
      rw [e.property,e.property]
