theorem cost_le (n m : ℕ) : cost F n m ≤ 3000*Problem18IMPConcreteEliminationBounds20261001.macroBudget F*(n+m+2)*(m+1)^3 := by
  let W := Problem18IMPConcreteEliminationBounds20261001.macroBudget F
  let N := (n+1)+m
  let T := W*(N+1)*(m+1)^2
  have hW : 1 ≤ W := (Problem18IMPConcreteEliminationBounds20261001.concrete_costBound F).one
  have hsq : m+1 ≤ (m+1)^2 := by nlinarith
  have hfactor : N+1 ≤ (N+1)*(m+1)^2 := by nlinarith
  have hT : 1 ≤ T := by dsimp [T]; exact Nat.succ_le_of_lt (Nat.mul_pos (Nat.mul_pos (by omega) (by omega)) (pow_pos (by omega) _))
  have hL : blockSize n m+1 ≤ 6*((N+1)*(m+1)^2) := by
    have hmul:=Nat.mul_le_mul_left N hsq
    unfold blockSize rowStart
    dsimp [N] at *
    nlinarith
  have hc := Problem18ClaudeIMPCostBounds20261001.copyCost_le
    (Problem18IMPConcreteEliminationBounds20261001.concrete_costBound F)
    (Expr.lit 0) (Expr.var bank) (by decide) (by decide) (blockSize n m)
  have hc' : copyCost (fieldMacros F) (.lit 0) (.var bank) (blockSize n m) ≤ 1200*T := by
    calc _ ≤ 200*W*(blockSize n m+1) := hc
         _ ≤ 200*W*(6*((N+1)*(m+1)^2)) := Nat.mul_le_mul_left _ hL
         _ =1200*T := by dsimp [T]; ring
  have hr := Problem18IMPConcreteEliminationBounds20261001.reduce_cost F q N (n+1) m (by dsimp [N]; omega)
  have hr' : reduceCost (fieldMacros F) q N (n+1) m ≤ 1200*T := by simpa [T,mul_assoc] using hr
  have hz := Problem18ClaudeIMPCostBounds20261001.zeroCost_le
    (Problem18IMPConcreteEliminationBounds20261001.concrete_costBound F) (n+1)
  have hz' : zeroCost (fieldMacros F) (n+1) ≤ 50*T := by
    calc _ ≤ 50*W*(n+1+1) := hz
         _ ≤ 50*W*((N+1)*(m+1)^2) := Nat.mul_le_mul_left _ (by dsimp [N] at hfactor ⊢; omega)
         _ =50*T := by dsimp [T]; ring
  have hs : copyCost (fieldMacros F) (.lit 0) (.var bank) (blockSize n m)+
      reduceCost (fieldMacros F) q N (n+1) m+zeroCost (fieldMacros F) (n+1)+58 ≤ 2600*T := by omega
  have hm := Nat.mul_le_mul_right m hs
  unfold cost
  change _ ≤ 3000*W*(n+m+2)*(m+1)^3
  have he : 3000*W*(n+m+2)*(m+1)^3=3000*T*(m+1) := by dsimp [T,N]; ring
  rw [he]
  change _+12 ≤ _
  dsimp only [N] at hm
  nlinarith
end
