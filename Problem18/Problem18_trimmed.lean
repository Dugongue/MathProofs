  let q : ℝ := Nat.card F
  have hq : 2≤q := by
    have hh : 2≤Nat.card F := by simpa only [Nat.card_eq_fintype_card] using Nat.succ_le_of_lt (Fintype.one_lt_card (α:=F))
    change (2:ℝ) ≤ (Nat.card F:ℝ)
    exact_mod_cast hh
  have hq0 : 0<q := by linarith
  have hinv : q⁻¹≤(1/2:ℝ) := by
    rw [inv_eq_one_div]
    apply (div_le_iff₀ hq0).mpr
    linarith
  have hp : (∏ k ∈ Finset.range n,Mathproof.Problem18ClassicalOrderRatios20260930.unitaryFactor q k)≤3 := by
    cases n with
    | zero => norm_num
    | succ n =>
      rw [Finset.prod_range_succ']
      have ht := (abs_le.mp (Mathproof.Problem18ClassicalOrderRatios20260930.unitary_tail_product_le q hq 1 n (by omega))).2
      simp only [pow_one] at ht
      have ht' : (∏ k ∈ Finset.range n,Mathproof.Problem18ClassicalOrderRatios20260930.unitaryFactor q (k+1))≤2 := by
        simpa only [Nat.add_comm,pow_one] using (show
          (∏ k ∈ Finset.range n,Mathproof.Problem18ClassicalOrderRatios20260930.unitaryFactor q (1+k))≤2 by linarith)
