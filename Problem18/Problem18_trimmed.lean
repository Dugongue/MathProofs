open Polynomial
variable {K : Type*} [CommRing K]
def WDeg (D w : ℕ) (p : Polynomial (Polynomial K)) : Prop :=
  ∀ k, (p.coeff k).natDegree + D * k ≤ w ∨ p.coeff k = 0
theorem bound_add {c w : ℕ} {a b : Polynomial K}
    (ha : a.natDegree + c ≤ w ∨ a = 0) (hb : b.natDegree + c ≤ w ∨ b = 0) :
    (a + b).natDegree + c ≤ w ∨ a + b = 0 := by
  rcases ha with ha | rfl
  · rcases hb with hb | rfl
    · left
      have := Polynomial.natDegree_add_le a b
      omega
    · left; simpa using ha
  · simpa using hb
theorem bound_sum {ι : Type*} (s : Finset ι) (f : ι → Polynomial K) {c w : ℕ}
    (h : ∀ i ∈ s, (f i).natDegree + c ≤ w ∨ f i = 0) :
    (∑ i ∈ s, f i).natDegree + c ≤ w ∨ ∑ i ∈ s, f i = 0 :=
  Finset.sum_induction f (fun x => x.natDegree + c ≤ w ∨ x = 0)
    (fun _ _ ha hb => bound_add ha hb) (Or.inr rfl) h
theorem WDeg.zero (D w : ℕ) : WDeg (K := K) D w 0 := fun k => Or.inr (by simp)
theorem WDeg.add {D w : ℕ} {p q : Polynomial (Polynomial K)} (hp : WDeg D w p)
    (hq : WDeg D w q) : WDeg D w (p + q) := fun k => by
  rw [Polynomial.coeff_add]
  exact bound_add (hp k) (hq k)
theorem WDeg.neg {D w : ℕ} {p : Polynomial (Polynomial K)} (hp : WDeg D w p) :
    WDeg D w (-p) := fun k => by
  rw [Polynomial.coeff_neg, Polynomial.natDegree_neg, neg_eq_zero]
  exact hp k
theorem WDeg.sub {D w : ℕ} {p q : Polynomial (Polynomial K)} (hp : WDeg D w p)
    (hq : WDeg D w q) : WDeg D w (p - q) := by
  rw [sub_eq_add_neg]
  exact hp.add hq.neg
theorem WDeg.mono {D w w' : ℕ} {p : Polynomial (Polynomial K)} (hp : WDeg D w p)
    (hw : w ≤ w') : WDeg D w' p := fun k => (hp k).imp (fun h => h.trans hw) id
theorem WDeg.mul {D w w' : ℕ} {p q : Polynomial (Polynomial K)} (hp : WDeg D w p)
    (hq : WDeg D w' q) : WDeg D (w + w') (p * q) := fun k => by
  rw [Polynomial.coeff_mul]
  apply bound_sum
  intro x hx
  rw [Finset.HasAntidiagonal.mem_antidiagonal] at hx
  rcases hp x.1 with h1 | h1
  · rcases hq x.2 with h2 | h2
    · left
      have hm := Polynomial.natDegree_mul_le (p := p.coeff x.1) (q := q.coeff x.2)
      have hk : D * k = D * x.1 + D * x.2 := by rw [← hx, mul_add]
      omega
    · right; rw [h2, mul_zero]
  · right; rw [h1, zero_mul]
theorem WDeg.X (D : ℕ) : WDeg (K := K) D D Polynomial.X := fun k => by
  rw [Polynomial.coeff_X]
  split_ifs with h
  · left; subst h; simp
  · right; rfl
theorem WDeg.C {D : ℕ} {a : Polynomial K} (ha : a.natDegree ≤ D) :
    WDeg D D (Polynomial.C a) := fun k => by
  rw [Polynomial.coeff_C]
  split_ifs with h
  · left; subst h; simpa using ha
  · right; rfl
theorem WDeg.one (D : ℕ) : WDeg (K := K) D 0 1 := fun k => by
  rw [Polynomial.coeff_one]
  split_ifs with h
  · left; subst h; simp
  · right; rfl
theorem WDeg.prod {ι : Type*} (s : Finset ι) (f : ι → Polynomial (Polynomial K)) {D w : ℕ}
    (h : ∀ i ∈ s, WDeg D w (f i)) : WDeg D (s.card * w) (∏ i ∈ s, f i) := by
  classical
  induction s using Finset.induction_on with
  | empty => simpa using WDeg.one (K := K) D
  | @insert i s hi ih =>
    rw [Finset.prod_insert hi, Finset.card_insert_of_notMem hi, add_mul, one_mul, add_comm]
    exact (h i (Finset.mem_insert_self i s)).mul
      (ih fun j hj => h j (Finset.mem_insert_of_mem hj))
theorem WDeg.sum {ι : Type*} (s : Finset ι) (f : ι → Polynomial (Polynomial K)) {D w : ℕ}
    (h : ∀ i ∈ s, WDeg D w (f i)) : WDeg D w (∑ i ∈ s, f i) :=
  Finset.sum_induction f (WDeg D w) (fun _ _ ha hb => ha.add hb) (WDeg.zero D w) h
theorem WDeg.units_smul {D w : ℕ} {p : Polynomial (Polynomial K)} (hp : WDeg D w p) (u : ℤˣ) :
    WDeg D w (u • p) := by
  rcases Int.units_eq_one_or u with rfl | rfl
  · simpa using hp
  · simpa using hp.neg
variable {ι : Type*} [Fintype ι] [DecidableEq ι]
theorem charmatrix_wdeg (M : Matrix ι ι (Polynomial K)) {D : ℕ}
    (hM : ∀ i j, (M i j).natDegree ≤ D) (i j : ι) :
    WDeg D D (Matrix.charmatrix M i j) := by
  rw [Matrix.charmatrix_apply]
  by_cases h : i = j
  · subst h
    rw [Matrix.diagonal_apply_eq]
    exact (WDeg.X D).sub (WDeg.C (hM i i))
  · rw [Matrix.diagonal_apply_ne _ h, zero_sub]
    exact (WDeg.C (hM i j)).neg
theorem charpoly_wdeg (M : Matrix ι ι (Polynomial K)) {D : ℕ}
    (hM : ∀ i j, (M i j).natDegree ≤ D) : WDeg D (Fintype.card ι * D) M.charpoly := by
  rw [Matrix.charpoly, Matrix.det_apply]
  apply WDeg.sum
  intro σ _
  apply WDeg.units_smul
  have h := WDeg.prod (Finset.univ : Finset ι)
    (fun i => Matrix.charmatrix M (σ i) i) (fun i _ => charmatrix_wdeg M hM (σ i) i)
  simpa [Finset.card_univ] using h
theorem charpoly_coeff_natDegree_le' (M : Matrix ι ι (Polynomial K)) {D : ℕ}
    (hM : ∀ i j, (M i j).natDegree ≤ D) (k : ℕ) :
    (M.charpoly.coeff k).natDegree ≤ (Fintype.card ι - k) * D := by
  rcases charpoly_wdeg M hM k with h | h
  · have : D * k + (Fintype.card ι - k) * D ≥ Fintype.card ι * D := by
      rw [mul_comm D k, ← add_mul]
      exact Nat.mul_le_mul_right D (by omega)
    omega
  · rw [h, Polynomial.natDegree_zero]
    exact Nat.zero_le _
end Mathproof.Problem18ClaudeCharpolyDegree20261001
