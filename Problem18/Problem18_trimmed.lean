open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Problem18IMPFieldLayout20261001
def segBody (src dst idx sb db : String) : Com :=
  .seq (.store dst (.bin .add (.var db) (.var idx))
    (.get src (.bin .add (.var sb) (.var idx))))
    (.assign idx (.bin .add (.var idx) (.lit 1)))
def segCopy (src dst idx cnt sb db : String) : Com :=
  .seq (.assign idx (.lit 0))
    (.while (.lt (.var idx) (.var cnt)) (segBody src dst idx sb db))
theorem getD_set_self {l : List Nat} {i v : Nat} (h : i<l.length) :
    (l.set i v).getD i 0=v := by
  simp [List.getD,List.getElem?_set_self h]
theorem getD_set_ne {l : List Nat} {i j v : Nat} (h : i≠j) :
    (l.set i v).getD j 0=l.getD j 0 := by
  simp [List.getD,List.getElem?_set_ne h]
theorem segCopy_run {src dst idx cnt sb db : String}
    (hsd : src≠dst) (hic : idx≠cnt) (his : idx≠sb) (hid : idx≠db)
    {B n sourceBase targetBase : Nat} (sigma : Env)
    (hn : n<B) (hcount : sigma.vars cnt=n)
    (hsource : sigma.vars sb=sourceBase)
    (htarget : sigma.vars db=targetBase)
    (hsourceB : sourceBase+n<B) (htargetB : targetBase+n<B)
    (hfitSource : sourceBase+n≤(sigma.arrs src).length)
    (hfitTarget : targetBase+n≤(sigma.arrs dst).length)
    (hword : ∀k<n,(sigma.arrs src).getD (sourceBase+k) 0<B) :
    ∃tau,Run B (segCopy src dst idx cnt sb db) sigma tau (20*n+6) ∧
      (∀k<n,(tau.arrs dst).getD (targetBase+k) 0=
        (sigma.arrs src).getD (sourceBase+k) 0) ∧
      (∀k,(k<targetBase ∨ targetBase+n≤k) →
        (tau.arrs dst).getD k 0=(sigma.arrs dst).getD k 0) ∧
      (∀a,a≠dst→tau.arrs a=sigma.arrs a) ∧
      ((tau.arrs dst).length=(sigma.arrs dst).length) ∧
      (∀x,x≠idx→tau.vars x=sigma.vars x) ∧
      tau.inp=sigma.inp ∧ tau.out=sigma.out := by
  let I : Env→Prop:=fun rho=>rho.vars idx≤n ∧ rho.vars cnt=n ∧
    rho.vars sb=sourceBase ∧ rho.vars db=targetBase ∧
    rho.arrs src=sigma.arrs src ∧
    (rho.arrs dst).length=(sigma.arrs dst).length ∧
    (∀k< rho.vars idx,
      (rho.arrs dst).getD (targetBase+k) 0=
        (sigma.arrs src).getD (sourceBase+k) 0) ∧
    (∀k,(k<targetBase ∨ targetBase+rho.vars idx≤k)→
      (rho.arrs dst).getD k 0=(sigma.arrs dst).getD k 0)
  let V : Env→Nat:=fun rho=>n-rho.vars idx
  have hdef : ∀rho,I rho →
      ∃v,(Cond.lt (.var idx) (.var cnt)).evalB B rho=some v := by
    intro rho h
    exact evalB_condLt_vars (by have:=h.1;omega) (by rw [h.2.1];exact hn)
  have hstep : ∀rho,I rho →
      (Cond.lt (.var idx) (.var cnt)).evalB B rho=some true →
      ∃tau,Run B (segBody src dst idx sb db) rho tau 12 ∧ I tau ∧ V tau<V rho := by
    intro rho h hc
    have htest:=evalB_condLt
      (evalB_var (by have:=h.1;omega : rho.vars idx<B))
      (evalB_var (by rw [h.2.1];exact hn : rho.vars cnt<B))
    rw [hc,h.2.1] at htest
    have hi : rho.vars idx<n:=by simpa using htest.symm
    let sourceAddress:=sourceBase+rho.vars idx
    let targetAddress:=targetBase+rho.vars idx
    let value:Nat:=(sigma.arrs src).getD sourceAddress 0
    have hv:value<B:=hword _ hi
    have hsa : (Expr.bin .add (.var sb) (.var idx)).evalB B rho=
        some sourceAddress := by
      apply evalB_bin
      · simpa [h.2.2.1] using (evalB_var (by omega : rho.vars sb<B))
      · exact evalB_var (by omega)
      · dsimp [sourceAddress];omega
    have hta : (Expr.bin .add (.var db) (.var idx)).evalB B rho=
        some targetAddress := by
      apply evalB_bin
      · simpa [h.2.2.2.1] using (evalB_var (by omega : rho.vars db<B))
      · exact evalB_var (by omega)
      · dsimp [targetAddress];omega
    have hget : (rho.arrs src)[sourceAddress]?=some value := by
      rw [h.2.2.2.2.1]
      have hs : sourceAddress<(sigma.arrs src).length := by
        dsimp [sourceAddress]
        omega
      simpa [value,List.getD,List.getElem?_eq_getElem hs]
    have hread : (Expr.get src
        (.bin .add (.var sb) (.var idx))).evalB B rho=some value :=
      evalB_get hsa hget hv
    have hr1:=Run.store (a:=dst) hta hread
      (by rw [h.2.2.2.2.2.1];change targetBase+rho.vars idx < _;omega)
    let rho1:=rho.setArr dst targetAddress value
    let tau:=rho1.setVar idx (rho.vars idx+1)
    have hinc : (Expr.bin .add (.var idx) (.lit 1)).evalB B rho1=
        some (rho.vars idx+1) :=
      evalB_bin (evalB_var (by change rho.vars idx<B;omega))
        (evalB_lit (by omega)) (by change rho.vars idx+1<B;omega)
    refine ⟨tau,?_,?_,?_⟩
    · simpa only [segBody,rho1,tau,Expr.size,Nat.reduceAdd] using
        hr1.seq (Run.assign (x:=idx) hinc)
    · refine ⟨by dsimp [tau];simp;omega,?_,?_,?_,?_,?_,?_,?_⟩
      · simpa [tau,rho1,Ne.symm hic] using h.2.1
      · simpa [tau,rho1,Ne.symm his] using h.2.2.1
      · simpa [tau,rho1,Ne.symm hid] using h.2.2.2.1
      · simpa [tau,rho1,hsd] using h.2.2.2.2.1
      · simpa [tau,rho1] using h.2.2.2.2.2.1
      · intro k hk
        have hk' : k< rho.vars idx+1 := by simpa [tau,rho1] using hk
        by_cases heq:k=rho.vars idx
        · subst k
          simp only [tau,rho1,arrs_setVar,arrs_setArr,if_pos rfl,ite_true]
          rw [getD_set_self (by rw [h.2.2.2.2.2.1];omega)]
        · rw [show (tau.arrs dst).getD (targetBase+k) 0=
              (rho.arrs dst).getD (targetBase+k) 0 by
            simp only [tau,rho1,arrs_setVar,arrs_setArr,if_pos rfl,ite_true]
            rw [getD_set_ne (by dsimp [targetAddress];omega)]]
          exact h.2.2.2.2.2.2.1 k (by omega)
      · intro k hk
        have hk' : k<targetBase ∨ targetBase+(rho.vars idx+1)≤k := by
          simpa [tau,rho1] using hk
        have hne:targetAddress≠k:=by
          rcases hk' with hk'|hk' <;> dsimp [targetAddress] <;> omega
        rw [show (tau.arrs dst).getD k 0=
              (rho.arrs dst).getD k 0 by
            simp only [tau,rho1,arrs_setVar,arrs_setArr,if_pos rfl,ite_true]
            rw [getD_set_ne hne]]
        apply h.2.2.2.2.2.2.2
        rcases hk' with hk'|hk'
        · exact Or.inl hk'
        · exact Or.inr (by omega)
    · have htv : tau.vars idx=rho.vars idx+1 := by simp [tau]
      show n-tau.vars idx<n-rho.vars idx
      rw [htv];omega
  have hI : I (sigma.setVar idx 0) := by
    refine ⟨by simp,?_,?_,?_,rfl,rfl,by simp,fun _ _=>rfl⟩
    · simpa [Ne.symm hic] using hcount
    · simpa [Ne.symm his] using hsource
    · simpa [Ne.symm hid] using htarget
  obtain ⟨tau,hr,hτ,hfalse⟩:=Run.while_count I V 12 hdef hstep hI
  have ht:=evalB_condLt
    (evalB_var (by have:=hτ.1;omega : tau.vars idx<B))
    (evalB_var (by rw [hτ.2.1];exact hn : tau.vars cnt<B))
  rw [hfalse,hτ.2.1] at ht
  have hi:tau.vars idx=n:=by
    have hh:¬tau.vars idx<n:=by simpa using ht.symm
    omega
  have hrun:Run B (segCopy src dst idx cnt sb db) sigma tau (20*n+6) := by
    have hh:=(Run.assign (σ:=sigma) (x:=idx)
      (evalB_lit (by omega : 0<B))).seq hr
    apply hh.mono
    simp only [segCopy,V,vars_setVar,if_pos rfl,ite_true,Cond.size,Expr.size]
    omega
  refine ⟨tau,hrun,?_,?_,?_,hτ.2.2.2.2.2.1,?_,?_,?_⟩
  · intro k hk
    exact hτ.2.2.2.2.2.2.1 k (by omega)
  · intro k hk
    exact hτ.2.2.2.2.2.2.2 k (by simpa [hi] using hk)
  · intro a ha
    apply (run_frame hrun).2.1 a
    simp [segCopy,segBody,arrayWrites,ha]
  · intro x hx
    apply (run_frame hrun).1 x
    simp [segCopy,segBody,scalarWrites,hx]
  · exact (run_frame hrun).2.2.2.1 (by simp [segCopy,segBody,noRead])
  · exact (run_frame hrun).2.2.2.2 (by simp [segCopy,segBody,Com.NoWrite])
end Mathproof.Problem18PairBoundaryCopy20261004
namespace Mathproof.Problem18PairBoundaryCopy20261004
open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Problem18IMPFieldLayout20261001
def idxReg : String := "P18.pairBoundary.copy.idx"
def cntReg : String := "P18.pairBoundary.copy.cnt"
def sbReg : String := "P18.pairBoundary.copy.sb"
def dbReg : String := "P18.pairBoundary.copy.db"
def copyBlock (src dst : String) (cntE sbE dbE : Expr) : Com :=
  .seq (.assign cntReg cntE) <| .seq (.assign sbReg sbE) <| .seq (.assign dbReg dbE)
    (segCopy src dst idxReg cntReg sbReg dbReg)
def copyRegs : List String := [idxReg,cntReg,sbReg,dbReg]
theorem copyBlock_run {src dst : String} (hsd : src≠dst) {cntE sbE dbE : Expr}
    {B n sourceBase targetBase : Nat} (sigma : Env)
    (hc : cntE.evalB B sigma=some n)
    (hs : sbE.evalB B (sigma.setVar cntReg n)=some sourceBase)
    (hd : dbE.evalB B ((sigma.setVar cntReg n).setVar sbReg sourceBase)=some targetBase)
    (hn : n<B) (hsourceB : sourceBase+n<B) (htargetB : targetBase+n<B)
    (hfitSource : sourceBase+n≤(sigma.arrs src).length)
    (hfitTarget : targetBase+n≤(sigma.arrs dst).length)
    (hword : ∀k<n,(sigma.arrs src).getD (sourceBase+k) 0<B) :
    ∃tau,Run B (copyBlock src dst cntE sbE dbE) sigma tau
        (20*n+9+cntE.size+sbE.size+dbE.size) ∧
      (∀k<n,(tau.arrs dst).getD (targetBase+k) 0=
        (sigma.arrs src).getD (sourceBase+k) 0) ∧
      (∀k,(k<targetBase ∨ targetBase+n≤k) →
        (tau.arrs dst).getD k 0=(sigma.arrs dst).getD k 0) ∧
      (∀a,a≠dst→tau.arrs a=sigma.arrs a) ∧
      ((tau.arrs dst).length=(sigma.arrs dst).length) ∧
      (∀x,x∉copyRegs→tau.vars x=sigma.vars x) ∧
      tau.inp=sigma.inp ∧ tau.out=sigma.out := by
  let s1:=sigma.setVar cntReg n
  let s2:=s1.setVar sbReg sourceBase
  let s3:=s2.setVar dbReg targetBase
  have r1:Run B (.assign cntReg cntE) sigma s1 (1+cntE.size):=Run.assign hc
  have r2:Run B (.assign sbReg sbE) s1 s2 (1+sbE.size):=Run.assign hs
  have r3:Run B (.assign dbReg dbE) s2 s3 (1+dbE.size):=Run.assign hd
  obtain ⟨tau,hr,hcopy,hout,harr,hlen,hvars,hi,ho⟩:=
    segCopy_run (src:=src) (dst:=dst) (idx:=idxReg) (cnt:=cntReg) (sb:=sbReg) (db:=dbReg)
      hsd (by decide) (by decide) (by decide) (B:=B) (n:=n) (sourceBase:=sourceBase)
      (targetBase:=targetBase) s3 hn (by simp [s3,s2,s1,cntReg,sbReg,dbReg])
      (by simp [s3,s2,s1,cntReg,sbReg,dbReg]) (by simp [s3])
      hsourceB htargetB (by simpa [s3,s2,s1] using hfitSource)
      (by simpa [s3,s2,s1] using hfitTarget) (by simpa [s3,s2,s1] using hword)
  refine ⟨tau,?_,?_,?_,?_,?_,?_,?_,?_⟩
  · exact ((r1.seq (r2.seq (r3.seq hr))).mono (by omega))
  · simpa [s3,s2,s1] using hcopy
  · simpa [s3,s2,s1] using hout
  · intro a ha;rw [harr a ha];simp [s3,s2,s1]
  · rw [hlen];simp [s3,s2,s1]
  · intro x hx
    have h1 : x≠idxReg := fun h=>hx (by simp [copyRegs,h])
    have h2 : x≠cntReg := fun h=>hx (by simp [copyRegs,h])
    have h3 : x≠sbReg := fun h=>hx (by simp [copyRegs,h])
    have h4 : x≠dbReg := fun h=>hx (by simp [copyRegs,h])
    rw [hvars x h1]
    simp [s3,s2,s1,h2,h3,h4,Ne.symm h2,Ne.symm h3,Ne.symm h4]
  · simpa [s3,s2,s1] using hi
  · simpa [s3,s2,s1] using ho
end Mathproof.Problem18PairBoundaryCopy20261004
