      τ.vars workspaceName=F.e+1 ∧ τ.inp=σ.inp ∧ τ.out=σ.out := by
  obtain ⟨hN,h6,h4,hrow,hmax,hfirst,hfactor,hdivisor,hcandidate,hseed,hmatrix,
    haction,htemp,hproduct,hwork,horbit,hslots⟩:=allocation n
  have hSn:=h.slots.slots_word
