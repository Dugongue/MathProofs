    (t y : F) (he : aeval ![y,t] f = 0) (B : Nat) (hB : f.totalDegree ≤ B) :
    ∃ (h : Nat) (c : Fin h → Polynomial K) (a : Polynomial K),
      h ≤ B ∧ a ≠ 0 ∧ a.natDegree ≤ B ∧ (∀ k, (c k).natDegree ≤ B) ∧
