theorem parseNumbers_serialize :
    ∀ (xs : List Nat) (d : Problem18RootParser20261001.ParsedInput),
      parseNumbers xs=some d → xs=serialize d
  | tag::u::q::p::e::a::b::c::data, d, h => by
      simp only [parseNumbers] at h
      split_ifs at h with hv
      cases h
      rfl
  | [], _, h | [_], _, h | [_,_], _, h | [_,_,_], _, h | [_,_,_,_], _, h
  | [_,_,_,_,_], _, h | [_,_,_,_,_,_], _, h | [_,_,_,_,_,_,_], _, h => by
      simp [parseNumbers] at h
theorem dispatch_parse (B : Nat) (bits : List Bool) (d : Problem18RootParser20261001.ParsedInput)
    (o : Problem18TensorSorting20261001.Order) (r : Nat) (h : dispatch B bits=some (d,o,r)) :
    parseBits bits=some d := by
  unfold dispatch at h
  cases hp : parseBits bits with
  | none=>simp [hp] at h
  | some d'=>
    simp only [hp,Option.bind_some] at h
    split_ifs at h
    have he := Option.some.inj h
    simp only [Prod.mk.injEq] at he
    rw [he.1]
theorem parsedWords_accept (bits : List Bool) (d : Problem18RootParser20261001.ParsedInput)
    (hp : parseBits bits=some d) : parsedWords bits=serialize d := by
  have h1 : parseNumbers (decodedWords bits)=some d := by rw [decoded_parse]; exact hp
  unfold parsedWords checkedWords
  rw [h1]
  simp only [Option.isSome_some,if_true]
  exact parseNumbers_serialize _ _ h1
theorem dispatchedWords_accept (B : Nat) (bits : List Bool)
    (d : Problem18RootParser20261001.ParsedInput) (o : Problem18TensorSorting20261001.Order)
    (r : Nat) (h : dispatch B bits=some (d,o,r)) :
    dispatchedWords B bits=
      [d.tag,d.unitary,d.q,d.p,d.e,d.a,d.b,d.c]++[orderCode o,r]++d.data := by
  rw [dispatchedWords,parsedWords_accept bits d (dispatch_parse B bits d o r h),serialize]
  rw [←routeWords_dispatch B bits d o r h]
  simp [routed,List.append_assoc]
theorem dispatch_machine_spec (B : Nat) :
    ∃ M : TM2ComputableInPolyTime id Lax51.BinaryWordEncoding.encode (dispatchedWords B),
      (∀k,Finite (M.tm.Γ k)) ∧
      (∀bits,parseBits bits=none → dispatchedWords B bits=[0]) ∧
      (∀bits d o r,dispatch B bits=some (d,o,r) →
        dispatchedWords B bits=
          [d.tag,d.unitary,d.q,d.p,d.e,d.a,d.b,d.c]++[orderCode o,r]++d.data) := by
  obtain ⟨M,hM⟩ := dispatch_machine B
  exact ⟨M,hM,dispatch_malformed B,dispatchedWords_accept B⟩
