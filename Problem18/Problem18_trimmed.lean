def CoefficientRelation {F : Type*} [Field F] [Algebra K F] (B : Nat) (t y : F) : Prop :=
  ∃ (h : Nat) (c : Fin h → Polynomial K) (a : Polynomial K),
    h ≤ B ∧ a ≠ 0 ∧ a.natDegree ≤ B ∧ (∀ k, (c k).natDegree ≤ B) ∧
    Polynomial.aeval t a * y ^ h +
      ∑ k : Fin h, Polynomial.aeval t (c k) * y ^ k.val = 0
def parameterDegree {F : Type*} [Field F] [Algebra K F] (t : F) : Nat :=
  Module.finrank K⟮t⟯ F
private theorem diagonal_relation {F : Type*} [Field F] [Algebra K F] (t : F) :
    aeval ![t,t] (X (0 : Fin 2) - X 1 : MvPolynomial (Fin 2) K) = 0 := by
  simp
def coefficientBound (n d : Nat) := max 1 (planeBound n d)
theorem coordinate_bivariate_relations
    (G : Finset (MvPolynomial (Fin n) L)) (d : Nat)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hdim : DimLE G 1 1)
    (P : Ideal (MvPolynomial (Fin n) L)) [P.IsPrime]
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes)
    (hfix : P.comap (MvPolynomial.map
      (FiniteField.frobeniusAlgEquivOfAlgebraic K L).toRingEquiv.toRingHom) = P)
    (i : Fin n) (ht : Transcendental K (coordinate (K := K) P i)) :
    ∀ j, ∃ s : MvPolynomial (Fin 2) K, s ≠ 0 ∧
      s.totalDegree ≤ coefficientBound n d ∧
      aeval ![coordinate (K := K) P j, coordinate (K := K) P i] s = 0 := by
  intro j
  by_cases hji : j = i
  · subst j
    refine ⟨X 0 - X 1, ?_, ?_, diagonal_relation (coordinate (K := K) P i)⟩
    · exact sub_ne_zero.mpr (X_injective.ne (by decide))
    · apply (totalDegree_sub _ _).trans
      rw [totalDegree_X, totalDegree_X, max_self]
      exact le_max_left _ _
  · obtain ⟨s, hs, hd, he⟩ := distinct_coordinate_relation G d hG hdim P hP hfix i j hji ht
    exact ⟨s, hs, hd.trans (le_max_right _ _), he⟩
theorem coordinate_coefficients
    (G : Finset (MvPolynomial (Fin n) L)) (d : Nat)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hdim : DimLE G 1 1)
    (P : Ideal (MvPolynomial (Fin n) L)) [P.IsPrime]
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes)
    (hfix : P.comap (MvPolynomial.map
      (FiniteField.frobeniusAlgEquivOfAlgebraic K L).toRingEquiv.toRingHom) = P)
    (i : Fin n) (ht : Transcendental K (coordinate (K := K) P i)) :
    ∀ j, CoefficientRelation (K := K) (coefficientBound n d)
      (coordinate (K := K) P i) (coordinate (K := K) P j) := by
  intro j
  obtain ⟨s, hs, hd, he⟩ := coordinate_bivariate_relations G d hG hdim P hP hfix i ht j
