  have hslots : Slots F canonical q.WS Sn B (η.setVar q.pv (σ.vars q.pv+1)) :=
    Slots.setVar F canonical hs1 (by decide) (by decide) _
  have hprefix : ∀s<σ.vars q.i,s≠2 → s≠3 → s≠4 →
