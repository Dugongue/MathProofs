  change divisorDegree k K (∑ P, Finsupp.single P.val (f P:ℤ))=_
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro P _
  change deg k K (Finsupp.single P.val (f P:ℤ))=_
  rw [deg_single,mul_comm]
theorem effective_coefficient_zero_of_degree_lt (D : DivisorA k K)
