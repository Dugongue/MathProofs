      (Problem18DimensionOneBoundary20260930.matrixOf
        (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
          (sortOrder a b c) T hA'.first)) = true := by
    show σ.vars rTReg = 1 ↔ _
    rw [hrT, Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck_eq]
    rfl
