      b + F.e*(m*c) ≤ (σ.arrs canonical.mem).length →
      Problem18IMPMatrixMemory20261001.address F b c i.val j.val + t.val < (σ.arrs canonical.mem).length := by
    intro i j t b hb
    unfold Problem18IMPMatrixMemory20261001.address
    have h := Problem18IMPMatrixMemory20261001.index_lt i j
    have : F.e*(i.val*c+j.val) + F.e ≤ F.e*(m*c) := by nlinarith
    have := t.isLt
    omega
  constructor
  · intro h k hk
    have hq : k / F.e < m*c := by rw [Nat.div_lt_iff_lt_mul hE]; rw [Nat.mul_comm]; exact hk
    have hc : 0 < c := by
      rcases Nat.eq_zero_or_pos c with h0 | h0
      · subst h0; simp at hq
      · exact h0
    let i : Fin m := ⟨k / F.e / c, by rw [Nat.div_lt_iff_lt_mul hc]; exact hq⟩
    let j : Fin c := ⟨k / F.e % c, Nat.mod_lt _ hc⟩
    let t : Fin F.e := ⟨k % F.e, Nat.mod_lt _ hE⟩
    have hk' : k = F.e*(i.val*c+j.val) + t.val := by
      simp only [i, j, t]
      have h1 := Nat.div_add_mod k F.e
      have h2 := Nat.div_add_mod (k / F.e) c
      conv_lhs => rw [← h1, ← h2]
      ring
    have he := congrFun (congrFun h i) j
    unfold Problem18IMPMatrixMemory20261001.matrix slice at he
    rw [decode_injective F (fun s => hv.coefficients _ (entry i j s b1 h1))
      (fun s => hv.coefficients _ (entry i j s b2 h2))] at he
    have := congrFun he t
    unfold Problem18IMPMatrixMemory20261001.address at this
    rw [hk']
    simpa [Nat.add_assoc] using this
  · intro h
    funext i j
    unfold Problem18IMPMatrixMemory20261001.matrix
    congr 1
    funext t
    unfold slice Problem18IMPMatrixMemory20261001.address
    have h' := h (F.e*(i.val*c+j.val) + t.val) (by
      have := entry i j t 0 (by omega)
      unfold Problem18IMPMatrixMemory20261001.address at this
      have hh := Problem18IMPMatrixMemory20261001.index_lt i j
      have : F.e*(i.val*c+j.val) + F.e ≤ F.e*(m*c) := by nlinarith
      have := t.isLt
      omega)
