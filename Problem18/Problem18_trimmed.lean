def PrimaryEvent (f : K[X]) (T : Module.End K V) : Prop :=
  f∣T.charpoly ∧ IsCoprime f (T.charpoly/f)
theorem ambient_joint_estimate
    (hcard : Nat.card K=Nat.card (fixedField (starRingAut : K ≃+* K))^2)
    (hstar : ∀ a : K,star a=a^Nat.card (fixedField (starRingAut : K ≃+* K)))
    (B : V →ₗ⋆[K] V →ₗ[K] K) (hB : B.IsSymm) (hnB : B.Nondegenerate)
    (g : ι→(fixedField (starRingAut : K ≃+* K))[X])
    (hm : ∀ i,(g i).Monic) (hi : ∀ i,Irreducible (g i)) (hinj : Function.Injective g)
    (hc : (∑ i,(g i).natDegree)+1≤Module.finrank K V)
    (D : ℕ) (hlo : ∀ i,D≤(g i).natDegree)
    (hhi : ∀ i,2*(g i).natDegree≤Module.finrank K V-∑ i,(g i).natDegree) :
    |((Nat.card {T : SelfAdjointOperators (starRingAut : K ≃+* K) B //
        ∀ i,PrimaryEvent ((g i).map (algebraMap (fixedField (starRingAut : K ≃+* K)) K)) T.val} : ℝ)/
      Nat.card (SelfAdjointOperators (starRingAut : K ≃+* K) B))*
      (∏ i,if Odd (g i).natDegree then
        Nat.card (fixedField (starRingAut : K ≃+* K))^(g i).natDegree+1
        else Nat.card (fixedField (starRingAut : K ≃+* K))^(g i).natDegree-1)-1| ≤
    2/((Nat.card (fixedField (starRingAut : K ≃+* K)) : ℝ)^(Module.finrank K V-∑ i,(g i).natDegree))+
      (22*Nat.card ι)/((Nat.card (fixedField (starRingAut : K ≃+* K)) : ℝ)^(D/2)) := by
  let F := fixedField (starRingAut : K ≃+* K)
  letI : Fintype F := Fintype.ofFinite _
  let σ : K ≃+* K := starRingAut
  let d := ∑ i,(g i).natDegree
  let c := Module.finrank K V-d
  let P := Mathproof.Problem18UnitaryFinalFactor20260930.standardHermitian (K:=K) d
  let C := Mathproof.Problem18UnitaryFinalFactor20260930.standardHermitian (K:=K) c
  have hP : P.IsSymm := Mathproof.Problem18UnitaryFinalFactor20260930.standardHermitian_symm d
  have hC : C.IsSymm := Mathproof.Problem18UnitaryFinalFactor20260930.standardHermitian_symm c
  have hnP : P.Nondegenerate := by
    have hs := Mathproof.Problem18UnitaryFinalFactor20260930.standardHermitian_separating (K:=K) d
    exact ⟨hs,fun x hx=>hs x (fun y=>hP.isRefl.eq_zero (hx y))⟩
  have hnC : C.Nondegenerate := by
    have hs := Mathproof.Problem18UnitaryFinalFactor20260930.standardHermitian_separating (K:=K) c
    exact ⟨hs,fun x hx=>hs x (fun y=>hC.isRefl.eq_zero (hx y))⟩
  let A := sumForm σ P C
  have hA : A.IsSymm := sum_symmetric P C hP hC
  have hnA : A.Nondegenerate := sum_nondegenerate P C hnP hnC
  obtain ⟨e,he⟩ := Problem18HermitianRegularWitt20260929.exists_isometry_equiv_of_finrank_eq
    (F:=F) hcard hstar B A hB hA hnB.1 hnA.1 (by
      rw [Module.finrank_prod]
      simp only [Module.finrank_pi,Module.finrank_self,Finset.sum_const,Finset.card_univ,Fintype.card_fin,smul_eq_mul,mul_one]
      dsimp only [c,d]
      omega)
  let E := Mathproof.Problem18HermitianSampleNormalization20261001.operatorIsometryEquiv B A e he
  have hχ (T : SelfAdjointOperators σ B) : (E T).val.charpoly=T.val.charpoly :=
    LinearEquiv.charpoly_conj e T.val
  have hcount : Nat.card {T : SelfAdjointOperators σ B //
      ∀ i,PrimaryEvent ((g i).map (algebraMap F K)) T.val}=
    Nat.card {T : SelfAdjointOperators σ A //
      Mathproof.Problem18HermitianSelectedJoint20261001.SelectedEvent g T.val} := by
    apply Nat.card_congr
    exact E.subtypeEquiv (fun T=>by
      simp only [PrimaryEvent,Mathproof.Problem18HermitianSelectedJoint20261001.SelectedEvent,hχ,F])
  have hsamples := Nat.card_congr E
  have hr := Mathproof.Problem18HermitianSelectedJoint20261001.selected_joint_estimate
    hcard hstar P C hP hnP hC hnC g hm hi hinj (by simp [d])
    (by simp only [Module.finrank_pi,Module.finrank_self,Finset.sum_const,Finset.card_univ,
      Fintype.card_fin,smul_eq_mul,mul_one]; dsimp only [c,d]; omega)
    D hlo (by
      intro i
      simpa only [Module.finrank_pi,Module.finrank_self,Finset.sum_const,Finset.card_univ,
        Fintype.card_fin,smul_eq_mul,mul_one] using hhi i)
  rw [←hcount,←hsamples] at hr
  simpa only [Module.finrank_pi,Module.finrank_self,Finset.sum_const,Finset.card_univ,
    Fintype.card_fin,smul_eq_mul,mul_one] using hr
end
