theorem inStart_succ (N u : ℕ) : inStart N (u + 1) = inStart N u + N := by
  unfold inStart; ring
theorem inStart_mono {N u v : ℕ} (h : u ≤ v) : inStart N u ≤ inStart N v := by
  unfold inStart; have := Nat.mul_le_mul_right N h; omega
theorem stStart_below {N s : ℕ} (h : s + 1 ≤ N) : stStart N s + N ≤ inStart N 0 := by
  unfold stStart inStart; have := Nat.mul_le_mul_right N h; rw [Nat.succ_mul] at this; omega
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] {F : FieldPresentation K}
  {r : FieldNames}
def srcIdx (cc t : String) : Expr := .bin .sub (.bin .sub (.var cc) (.lit 1)) (.var t)
def chosenBody (M : FieldMacros F r) (q : RNames) (cc t src dst : String) : Com :=
  .seq (.assign src (stBase q (srcIdx cc t)))
    (.seq (.assign dst (inBase q (.var t)))
      (.seq (copyLoop M q (.var dst) (.var src)) (.assign t (plus (.var t) (.lit 1)))))
def chosenCom (M : FieldMacros F r) (q : RNames) (cc t src dst : String) : Com :=
  .seq (.assign t (.lit 0)) (.while (.lt (.var t) (.var cc)) (chosenBody M q cc t src dst))
def chosenStep (M : FieldMacros F r) (q : RNames) (cc t src dst : String) (N : ℕ) : ℕ :=
  (1 + (stBase q (srcIdx cc t)).size) + ((1 + (inBase q (.var t)).size) +
    (copyCost M (.var dst) (.var src) N + (1 + (plus (.var t) (.lit 1)).size)))
def chosenCost (M : FieldMacros F r) (q : RNames) (cc t src dst : String) (N c : ℕ) : ℕ :=
  2 + ((4 + chosenStep M q cc t src dst N) * c + 4)
theorem chosen_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (cc t src dst : String)
    (hfr : ∀ x ∈ [cc, t, src, dst], x ∉ regNames r ∧ x ≠ q.WS ∧ x ∉ q.list)
    (hnd : [cc, t, src, dst].Nodup) {B Sn N c : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ)
    (hN : σ.vars q.N = N) (hcc : σ.vars cc = c) (hcN : c ≤ N) (hfit : inStart N c ≤ Sn) :
    ∃ τ, Run B (chosenCom M q cc t src dst) σ τ (chosenCost M q cc t src dst N c) ∧
      Slots F r q.WS Sn B τ ∧
      (∀ u (hu : u < c), ∀ k : Fin N, val F r q.WS τ (inStart N u + k.val) =
        read ((chosenOf (val F r q.WS σ) N c)[u]'(by simp [chosenOf]; exact hu)) k) ∧
      (∀ s < Sn, (s < inStart N 0 ∨ inStart N c ≤ s) → val F r q.WS τ s = val F r q.WS σ s) ∧
      τ.vars q.N = N ∧ τ.vars cc = c ∧
      (∀ x, x ∉ regNames r → x ≠ q.j → x ≠ t → x ≠ src → x ≠ dst → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hSB := hS.slots_word
  obtain ⟨⟨ccS, ccW, ccQ⟩, ⟨tS, tW, tQ⟩, ⟨srcS, srcW, srcQ⟩, ⟨dstS, dstW, dstQ⟩⟩ :
      (cc ∉ regNames r ∧ cc ≠ q.WS ∧ cc ∉ q.list) ∧ (t ∉ regNames r ∧ t ≠ q.WS ∧ t ∉ q.list) ∧
      (src ∉ regNames r ∧ src ≠ q.WS ∧ src ∉ q.list) ∧
      (dst ∉ regNames r ∧ dst ≠ q.WS ∧ dst ∉ q.list) :=
    ⟨hfr cc (by simp), hfr t (by simp), hfr src (by simp), hfr dst (by simp)⟩
  have hd : cc ≠ t ∧ cc ≠ src ∧ cc ≠ dst ∧ t ≠ src ∧ t ≠ dst ∧ src ≠ dst := by
    simp only [List.nodup_cons, List.mem_cons, List.mem_singleton, List.not_mem_nil, or_false,
      not_or] at hnd
    tauto
  obtain ⟨dct, dcs, dcd, dts, dtd, dsd⟩ := hd
  have nq : ∀ {x y : String}, y ∈ q.list → x ∉ q.list → x ≠ y := fun hy hx e => hx (e ▸ hy)
  have tN : t ≠ q.N := nq q.N_mem tQ
  have sN : src ≠ q.N := nq q.N_mem srcQ
  have dN : dst ≠ q.N := nq q.N_mem dstQ
  have cJ : cc ≠ q.j := nq q.j_mem ccQ
  have tJ : t ≠ q.j := nq q.j_mem tQ
  have sJ : src ≠ q.j := nq q.j_mem srcQ
  have dJ : dst ≠ q.j := nq q.j_mem dstQ
  have NS : q.N ∉ regNames r := hq.2 _ q.N_mem
  have NJ : q.N ≠ q.j := hq.ne_of (by intro h; simp [RNames.list, h])
  have hc0 : inStart N 0 ≤ inStart N c := inStart_mono (Nat.zero_le _)
  have hNin : N ≤ inStart N 0 := by unfold inStart rowStart; omega
  let I : Env → Prop := fun τ =>
    Slots F r q.WS Sn B τ ∧ τ.vars t ≤ c ∧
    (∀ x, x ∉ regNames r → x ≠ q.j → x ≠ t → x ≠ src → x ≠ dst → τ.vars x = σ.vars x) ∧
    (∀ u < τ.vars t, ∀ k < N,
      val F r q.WS τ (inStart N u + k) = val F r q.WS σ (stStart N (c - 1 - u) + k)) ∧
    (∀ s < Sn, (s < inStart N 0 ∨ inStart N (τ.vars t) ≤ s) →
      val F r q.WS τ s = val F r q.WS σ s) ∧
    (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out
  have hIN : ∀ τ, I τ → τ.vars q.N = N := fun τ h => by
    rw [h.2.2.1 q.N NS NJ (Ne.symm tN) (Ne.symm sN) (Ne.symm dN)]; exact hN
  have hIc : ∀ τ, I τ → τ.vars cc = c := fun τ h => by
    rw [h.2.2.1 cc ccS cJ dct dcs dcd]; exact hcc
  have hI0 : I (σ.setVar t 0) := by
    refine ⟨Slots.setVar F r hS tS tW 0, by simp, ?_, ?_, ?_, fun _ _ _ => rfl, rfl, rfl⟩
    · intro x _ _ hxt _ _; simp only [vars_setVar, if_neg hxt]
    · intro u hu; simp at hu
    · intro s _ _; exact val_setVar F r tW σ 0 s
  have hcond : ∀ τ, I τ →
      (Cond.lt (.var t) (.var cc)).evalB B τ = some (decide (τ.vars t < c)) := fun τ h => by
    have e := evalB_condLt (B := B) (evalB_var (x := t) (σ := τ) (by have := h.2.1; omega))
      (evalB_var (x := cc) (σ := τ) (by rw [hIc τ h]; omega))
    rw [hIc τ h] at e; exact e
  have hstep : ∀ τ, I τ → (Cond.lt (.var t) (.var cc)).evalB B τ = some true →
      ∃ τ', Run B (chosenBody M q cc t src dst) τ τ' (chosenStep M q cc t src dst N) ∧ I τ' ∧
        c - τ'.vars t < c - τ.vars t := by
    intro τ hτ hc
    rw [hcond τ hτ] at hc
    simp only [Option.some.injEq, decide_eq_true_eq] at hc
    have hτN := hIN τ hτ
    have hτc := hIc τ hτ
    obtain ⟨hSτ, hle, hfix, hrows, hkeep, harr, hinp, hout⟩ := hτ
    set u := τ.vars t with hu
    have hsb := stStart_below (N := N) (s := c - 1 - u) (by omega)
    have hdu := inStart_mono (N := N) (show u + 1 ≤ c by omega)
    have hdu' := inStart_succ N u
    have hu0 := inStart_mono (N := N) (Nat.zero_le u)
    have esi : (srcIdx cc t).evalB B τ = some (c - 1 - u) := by
      unfold srcIdx
      have e1 : (Expr.bin .sub (.var cc) (.lit 1)).evalB B τ = some (c - 1) :=
        evalB_bin (by rw [← hτc]; exact evalB_var (by rw [hτc]; omega)) (evalB_lit (by omega))
          (by change c - 1 < B; omega)
      exact evalB_bin e1 (evalB_var (by omega)) (by change c - 1 - u < B; omega)
    have r1 := Run.assign (x := src) (evalB_stBase q esi hτN (by omega))
    set τa := τ.setVar src (stStart N (c - 1 - u)) with hτa
    have hat : τa.vars t = u := by rw [hτa, vars_setVar, if_neg dts]
    have haN : τa.vars q.N = N := by rw [hτa, vars_setVar, if_neg (Ne.symm sN)]; exact hτN
    have et : (Expr.var t).evalB B τa = some u := by
      rw [← hat]; exact evalB_var (by rw [hat]; omega)
    have r2 := Run.assign (x := dst) (evalB_inBase q et haN (by omega))
    set τb := τa.setVar dst (inStart N u) with hτb
    have hbN : τb.vars q.N = N := by rw [hτb, vars_setVar, if_neg (Ne.symm dN)]; exact haN
    have hbd : τb.vars dst = inStart N u := by rw [hτb, vars_setVar, if_pos rfl]
    have hbs : τb.vars src = stStart N (c - 1 - u) := by
      rw [hτb, vars_setVar, if_neg dsd, hτa, vars_setVar, if_pos rfl]
    have hSb : Slots F r q.WS Sn B τb :=
      Slots.setVar F r (Slots.setVar F r hSτ srcS srcW _) dstS dstW _
    have hvalb : ∀ s, val F r q.WS τb s = val F r q.WS τ s := fun s => by
      rw [hτb, val_setVar F r dstW, hτa, val_setVar F r srcW]
    obtain ⟨τc, r3, hSc, hcp, hoth, hfixc, hjc, harrc, hinpc, houtc⟩ :=
      copy_run M q hq [dst, src] (by simp [dstS, dJ, srcS, sJ]) (.var dst) (.var src)
        (by simp [VarsIn]) (by simp [VarsIn]) hSb
        (show (Expr.var dst).evalB B τb = some (inStart N u) from by
          rw [← hbd]; exact evalB_var (by rw [hbd]; omega))
        (show (Expr.var src).evalB B τb = some (stStart N (c - 1 - u)) from by
          rw [← hbs]; exact evalB_var (by rw [hbs]; omega)) hbN (by omega) (by omega)
        (Or.inr (by omega))
    have hct : τc.vars t = u := by rw [hfixc t tS tJ, hτb, vars_setVar, if_neg dtd, hat]
    have r4 := Run.assign (x := t) (e := plus (.var t) (.lit 1)) (σ := τc)
      (evalB_bin (show (Expr.var t).evalB B τc = some u from by
          rw [← hct]; exact evalB_var (by rw [hct]; omega)) (evalB_lit (by omega))
        (by change u + 1 < B; omega))
    refine ⟨τc.setVar t (u + 1), r1.seq (r2.seq (r3.seq r4)),
      ⟨Slots.setVar F r hSc tS tW _, by simp only [vars_setVar, if_true]; omega, ?_, ?_, ?_, ?_,
        ?_, ?_⟩, by simp only [vars_setVar, if_true]; omega⟩
    · intro x hx hxj hxt hxs hxd
      simp only [vars_setVar, if_neg hxt]
      rw [hfixc x hx hxj, hτb, vars_setVar, if_neg hxd, hτa, vars_setVar, if_neg hxs]
      exact hfix x hx hxj hxt hxs hxd
