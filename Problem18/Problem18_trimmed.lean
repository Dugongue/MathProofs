theorem getD_blocks {α : Type*} (z : α) {n m : Nat} (f : Fin n → List α)
    (hlen : ∀ i, (f i).length = m) (i : Fin n) (j : Fin m) :
    ((List.finRange n).flatMap f).getD (i.val*m+j.val) z = (f i).getD j.val z := by
  induction n with
  | zero => exact Fin.elim0 i
  | succ n ih =>
    rw [List.finRange_succ, List.flatMap_cons, List.flatMap_map]
    refine Fin.cases ?_ (fun i => ?_) i
    · simp only [Fin.val_zero, zero_mul, zero_add]
      exact List.getD_append _ _ z j.val (by rw [hlen]; exact j.isLt)
    · have hm : (f 0).length ≤ i.succ.val*m+j.val := by
        rw [hlen, Fin.val_succ, Nat.add_mul]
        omega
      rw [List.getD_append_right _ _ z _ hm, hlen]
      have he : i.succ.val*m+j.val-m = i.val*m+j.val := by
        simp only [Fin.val_succ, Nat.add_mul, one_mul]
        omega
      rw [he]
      exact ih (fun t => f t.succ) (fun t => hlen t.succ) i
def offset (a b e k i j t : Nat) : Nat := ((k*a+i)*b+j)*e+t
theorem offset_lt {a b c e : Nat} (k : Fin c) (i : Fin a) (j : Fin b) (t : Fin e) :
    offset a b e k.val i.val j.val t.val < c*(a*(b*e)) := by
  have hi : k.val*a+i.val < c*a := by
    calc k.val*a+i.val < (k.val+1)*a := by simp only [Nat.add_mul, one_mul]; omega
      _ ≤ c*a := Nat.mul_le_mul_right a k.isLt
  have hj : (k.val*a+i.val)*b+j.val < (c*a)*b := by
    calc _ < (k.val*a+i.val+1)*b := by simp only [Nat.add_mul, one_mul]; omega
      _ ≤ _ := Nat.mul_le_mul_right b hi
  have ht : ((k.val*a+i.val)*b+j.val)*e+t.val < ((c*a)*b)*e := by
    calc _ < ((k.val*a+i.val)*b+j.val+1)*e := by simp only [Nat.add_mul, one_mul]; omega
      _ ≤ _ := Nat.mul_le_mul_right e hj
  simpa only [offset, Nat.mul_assoc] using ht
theorem tensorCoordinates_getD {K : Type} [Field K] (F : FieldPresentation K)
    {a b c : Nat} (A : RectTensor a b c K)
    (k : Fin c) (i : Fin a) (j : Fin b) (t : Fin F.e) :
    (tensorCoordinates F A).getD (offset a b F.e k.val i.val j.val t.val) 0 =
      (F.coordinate (A k (i,j)) t).val := by
  have hj : j.val*F.e+t.val < b*F.e := by
    calc _ < (j.val+1)*F.e := by simp only [Nat.add_mul, one_mul]; omega
      _ ≤ _ := Nat.mul_le_mul_right F.e j.isLt
  have hi : i.val*(b*F.e)+(j.val*F.e+t.val) < a*(b*F.e) := by
    calc _ < (i.val+1)*(b*F.e) := by simp only [Nat.add_mul, one_mul]; omega
      _ ≤ _ := Nat.mul_le_mul_right (b*F.e) i.isLt
  have he : offset a b F.e k.val i.val j.val t.val =
      k.val*(a*(b*F.e))+(i.val*(b*F.e)+(j.val*F.e+t.val)) := by unfold offset; ring
  unfold tensorCoordinates
  rw [he, getD_blocks 0 _ (fun _ => by simp [List.length_flatMap]) k ⟨_,hi⟩]
  rw [getD_blocks 0 _ (fun _ => by simp [List.length_flatMap]) i ⟨_,hj⟩]
  rw [getD_blocks 0 _ (fun _ => by simp) j t]
  simp [List.getD_eq_getElem?_getD, t.isLt]
def originalIndex {a b c : Nat} (o : Order) :
    Fin (shape o a b c).2.2 → Fin (shape o a b c).1 →
      Fin (shape o a b c).2.1 → Fin c × Fin a × Fin b :=
  match o with
  | .abc => fun k i j => (k,i,j)
  | .acb => fun k i j => (j,i,k)
  | .bac => fun k i j => (k,j,i)
  | .bca => fun k i j => (j,k,i)
  | .cab => fun k i j => (i,j,k)
  | .cba => fun k i j => (i,k,j)
theorem tensorEquiv_apply {K : Type} [Field K] {a b c : Nat}
    (o : Order) (A : RectTensor a b c K)
    (k : Fin (shape o a b c).2.2) (i : Fin (shape o a b c).1)
    (j : Fin (shape o a b c).2.1) :
    tensorEquiv o A k (i,j) =
      A (originalIndex o k i j).1 ((originalIndex o k i j).2.1,(originalIndex o k i j).2.2) := by
  cases o <;> rfl
def reorder (o : Order) (a b c e : Nat) (xs : List Nat) : List Nat :=
  let s := shape o a b c
  (List.finRange s.2.2).flatMap fun k =>
    (List.finRange s.1).flatMap fun i =>
      (List.finRange s.2.1).flatMap fun j =>
        (List.finRange e).map fun t =>
          let p := originalIndex o k i j
          xs.getD (offset a b e p.1.val p.2.1.val p.2.2.val t.val) 0
def sortedSource (bits : List Bool) : Option ParsedInput :=
  (parseBits bits).bind fun d =>
    if d.tag = 0 then
      let o := sortOrder d.a d.b d.c
      let s := shape o d.a d.b d.c
      some ⟨d.tag, d.unitary, d.q, d.p, d.e, s.1, s.2.1, s.2.2,
        d.modulus ++ reorder o d.a d.b d.c d.e d.coordinates⟩
    else none
def decodeTensor {K : Type} [Field K] (F : FieldPresentation K)
    (a b c : Nat) (xs : List Nat) : RectTensor a b c K :=
  fun k ij => ∑ t : Fin F.e,
    (xs.getD (offset a b F.e k.val ij.1.val ij.2.val t.val) 0 : K) * F.generator^t.val
end Mathproof.Problem18EncodedTensorSort20261001
