def powerFunction : List ℕ → List ℕ
  | [p,a,e] => if p=0 then [0] else [a^e%p]
  | _ => [0]
def finishPower : Com := .ite (.eq (.var "p") (.lit 0))
  (.write (.lit 0)) (.seq modPowRoutine (.write (.var "r")))
def readPower : Com := .seq (.read "p")
  (.seq (.read "a") (.seq (.read "e") finishPower))
def powerProgram : Com := .seq (.read "len")
  (.ite (.eq (.var "len") (.lit 3)) readPower (.write (.lit 0)))
def powerLayout : Layout := ⟨["len","p","a","e","r"],[],32⟩
theorem powerProgram_ok : Com.Ok powerLayout powerProgram := by
  simp [powerLayout,powerProgram,readPower,finishPower,modPowRoutine,powLoop,
    powBody,modExpr,Com.Ok,Cond.Ok,Expr.Ok,condExpr,Expr.mul,Expr.div]
theorem powerProgram_run {B n : ℕ} (xs : List ℕ)
    (h3 : 3<B) (hlen : xs.length<B)
    (hvalues : ∀v∈xs,v<B) (hsquare : ∀v∈xs,v*v≤B)
    (hsize : ∀v∈xs,v.size≤n) :
    ∃ τ,Run B powerProgram (initEnv (fun _ => 0) (xs.length::xs)) τ (100*n+100) ∧
      τ.out=powerFunction xs := by
  let σ := initEnv (fun _ => 0) (xs.length::xs)
  let σ₁ : Env := {σ.setVar "len" xs.length with inp:=xs}
  have hr : Run B (.read "len") σ σ₁ 1 := Run.read rfl
  by_cases hl : xs.length=3
  · obtain ⟨p,a,e,rfl⟩ := List.length_eq_three.mp hl
    let σ₂ : Env := {σ₁.setVar "p" p with inp:=[a,e]}
    let σ₃ : Env := {σ₂.setVar "a" a with inp:=[e]}
    let σ₄ : Env := {σ₃.setVar "e" e with inp:=[]}
    have h₂ : Run B (.read "p") σ₁ σ₂ 1 := Run.read rfl
    have h₃ : Run B (.read "a") σ₂ σ₃ 1 := Run.read rfl
    have h₄ : Run B (.read "e") σ₃ σ₄ 1 := Run.read rfl
    have hpB : p<B := hvalues p (by simp)
    have haB : a<B := hvalues a (by simp)
    have heB : e<B := hvalues e (by simp)
    have hpp : p*p≤B := hsquare p (by simp)
    have hen : e.size≤n := hsize e (by simp)
    have hvp : σ₄.vars "p"=p := by simp [σ₄,σ₃,σ₂]
    have hva : σ₄.vars "a"=a := by simp [σ₄,σ₃]
    have hve : σ₄.vars "e"=e := by simp [σ₄]
    have hout₄ : σ₄.out=[] := rfl
    have hb : (Cond.eq (.var "len") (.lit 3)).evalB B σ₁=some true := by
      simp [σ₁,σ,initEnv,Expr.evalB,Cond.evalB,fit,h3]
    have hf : ∃ τ,Run B finishPower σ₄ τ (84*e.size+40) ∧
        τ.out=powerFunction [p,a,e] := by
      by_cases hp : p=0
      · have htest : (Cond.eq (.var "p") (.lit 0)).evalB B σ₄=some true := by
          simp [evalB_condEq_iff,hvp,hp] <;> omega
        have hw := Run.write (σ:=σ₄) (evalB_lit (by omega : 0<B))
        refine ⟨_,(Run.ite_true htest hw).mono ?_,?_⟩
        · simp [Cond.size,Expr.size] <;> omega
        · simp [powerFunction,hp,hout₄]
      · obtain ⟨τ,ht,ho⟩ := modPowRoutine_run (B:=B) σ₄ (by omega)
          (by simpa only [hvp] using Nat.pos_of_ne_zero hp)
          (by simpa only [hvp] using hpB) (by simpa only [hvp] using hpp)
          (by simpa only [hva] using haB) (by simpa only [hve] using heB)
        rw [hvp,hva,hve] at ho
        have hτr : τ.vars "r"<B := by rw [ho]; exact (Nat.mod_lt _ (Nat.pos_of_ne_zero hp)).trans hpB
        have hτout : τ.out=[] := (ht.out_eq (by simp [Com.NoWrite,modPowRoutine,powLoop,powBody])).trans hout₄
        have hw := Run.write (evalB_var hτr)
        have htest : (Cond.eq (.var "p") (.lit 0)).evalB B σ₄=some false := by
          simp [evalB_condEq_iff,hvp,hp,hpB]; omega
        refine ⟨_,(Run.ite_false htest (ht.seq hw)).mono ?_,?_⟩
        · simp [Cond.size,Expr.size,hve]; omega
        · simp [powerFunction,hp,hτout,ho]
    obtain ⟨τ,ht,ho⟩ := hf
    refine ⟨τ,?_,ho⟩
    have hh := hr.seq (Run.ite_true (d:=.write (.lit 0)) hb (h₂.seq (h₃.seq (h₄.seq ht))))
    exact hh.mono (by simp [Cond.size,Expr.size] <;> omega)
  · have hb : (Cond.eq (.var "len") (.lit 3)).evalB B σ₁=some false := by
      simp [evalB_condEq_iff,σ₁,hlen,h3,hl]
    have hw := Run.write (σ:=σ₁) (evalB_lit (by omega : 0<B))
    refine ⟨_,(hr.seq (Run.ite_false hb hw)).mono ?_,?_⟩
    · simp [Cond.size,Expr.size] <;> omega
    · have hf : powerFunction xs=[0] := by
        cases xs with
        | nil => rfl
        | cons a xs => cases xs with
          | nil => rfl
          | cons b xs => cases xs with
            | nil => rfl
            | cons c xs => cases xs with
              | nil => simp at hl
              | cons d xs => rfl
      simpa [σ₁,σ,initEnv] using hf.symm
theorem powerFunction_ramPolytime : RamPolytime powerFunction := by
  apply ramPolytime_of_bounded_imp powerLayout powerProgram powerFunction
    (2*Polynomial.X+4) (100*Polynomial.X+100) powerProgram_ok
  intro xs
  let n := bitSize xs
  let B := 2^(3*n+5)
  have hpow : 2^(n+1)≤B := Nat.pow_le_pow_right (by omega) (by omega)
  have h3 : 3<B := by
    have hh : 2^2≤B := Nat.pow_le_pow_right (by omega) (by omega)
    norm_num at hh ⊢
    omega
  have hlen : xs.length<B :=
    (Lax51Proofs.Encoding.length_lt_two_pow_bitSize_add_one xs).trans_le hpow
  have hv : ∀v∈xs,v<B := fun v h =>
    (Lax51Proofs.Encoding.mem_lt_two_pow_bitSize_add_one h).trans_le hpow
  have hs : ∀v∈xs,v*v≤B := by
    intro v h
    have hh := (Lax51Proofs.Encoding.mem_lt_two_pow_bitSize_add_one h).le
    calc v*v≤2^(n+1)*2^(n+1) := Nat.mul_le_mul hh hh
         _=2^((n+1)+(n+1)) := (pow_add _ _ _).symm
         _≤B := Nat.pow_le_pow_right (by omega) (by omega)
  have hz : ∀v∈xs,v.size≤n := by
    intro v h
    have hh := Lax51Proofs.Encoding.bits_length_add_one_le_bitSize_of_mem h
    rw [Nat.size_eq_bits_len] at hh
    omega
  obtain ⟨τ,hr,ho⟩ := powerProgram_run xs h3 hlen hv hs hz
  refine ⟨(fun _ => 0),τ,?_,ho⟩
  convert hr using 1
  · change 2^((2*Polynomial.X+4 : Polynomial ℕ).eval (bitSize xs)+bitSize xs+1)=2^(3*n+5)
    apply congrArg (2^·)
    simp only [Polynomial.eval_add,Polynomial.eval_mul,Polynomial.eval_X,Polynomial.eval_ofNat]
    dsimp [n]
    omega
  · simp only [Polynomial.eval_add,Polynomial.eval_mul,Polynomial.eval_X,Polynomial.eval_ofNat]
    rfl
end Mathproof.Problem18IMPModularPowerProgram20261001
