  · rw [hx2 exponentReg (by decide), hx1 exponentReg (by decide)]
  · rw [hx2 halfReg (by decide), hx1 halfReg (by decide)]
theorem square_step_run {B S : Nat} (L : Layout) (σ0 ρ : Env) (hok : L.Ok S)
    (hR : Regs L σ0)
    (hmb : σ0.vars canonical.modBase+F.e ≤ σ0.vars ws) (hg : Good F L S B σ0 ρ) :
    ∃τ, Run B squareStep ρ τ (productCost F.e L.n+2*copyCost F.e L.n) ∧
      Good F L S B σ0 τ ∧
      mat F L (σ0.vars ws) L.acc τ=mat F L (σ0.vars ws) L.acc ρ ∧
      mat F L (σ0.vars ws) L.base τ=mat F L (σ0.vars ws) L.base ρ * mat F L (σ0.vars ws) L.base ρ ∧
      τ.vars exponentReg=ρ.vars exponentReg ∧ τ.vars halfReg=ρ.vars halfReg := by
  have hsc := hok.scaled F.e
  have hRρ := hg.regsL F hR
  have hw0 : ρ.vars ws=σ0.vars ws := hg.ws_eq
  have hmb' : ρ.vars canonical.modBase+F.e ≤ ρ.vars ws := by rw [hg.ws_eq, hg.mod_eq]; exact hmb
  obtain ⟨τ1,hr1,hv1,hs1,hc1,hf1,ha1,hx1,hl1,hi1,ho1⟩ := copy_run F L.n L.base L.copy baseR copyR ρ
    hRρ.base hRρ.copy hRρ.nn (by decide) (by decide) hg.valid hg.slots hmb'
    (by have := hok.base_copy; have := hok.copy_out; have := hok.out_work; have := hok.work_fit; omega)
    (by have := hok.copy_out; have := hok.out_work; have := hok.work_fit; omega)
    (Or.inl hok.base_copy)
  have hg1 := hg.after_copy F L.copy (fun k hk => hk.2.2.1) hv1 hs1 hf1 ha1 hx1 hl1 hi1 ho1
  have hR1 := hg1.regsL F hR
  have hw1 : τ1.vars ws=ρ.vars ws := hx1 _ ws_ne_index
  have hm1 : τ1.vars canonical.modBase+F.e ≤ τ1.vars ws := by
    rw [hx1 canonical.modBase (by decide), hw1]; exact hmb'
  obtain ⟨τ2,hr2,hv2,hs2,hp2,hf2,hx2,ha2,hl2,hi2,ho2⟩ := product_call_run F L.n L.base L.copy L.out
    L.work baseR copyR outR workR τ1 hR1.base hR1.copy hR1.out hR1.work hR1.n
    (by simp [layoutRegs]) (by simp [layoutRegs]) (by simp [layoutRegs]) (by simp [layoutRegs])
    hv1 hs1 hm1 hok.n_pos hok.base_copy hok.copy_out hok.out_work hok.work_fit
  have hg2 := hg1.after_product F hv2 hs2 hf2 hx2 ha2 hl2 hi2 ho2
  have hR2 := hg2.regsL F hR
  have hw2 : τ2.vars ws=τ1.vars ws := hx2 ws (by decide)
  have hm2 : τ2.vars canonical.modBase+F.e ≤ τ2.vars ws := by
    rw [hx2 canonical.modBase (by decide), hw2]; exact hm1
  obtain ⟨τ3,hr3,hv3,hs3,hc3,hf3,ha3,hx3,hl3,hi3,ho3⟩ := copy_run F L.n L.out L.base outR baseR τ2
    hR2.out hR2.base hR2.nn (by decide) (by decide) hv2 hs2 hm2
    (by have := hok.out_work; have := hok.work_fit; omega)
    (by have := hok.base_copy; have := hok.copy_out; have := hok.out_work; have := hok.work_fit; omega)
    (Or.inr (by have := hok.base_copy; have := hok.copy_out; omega))
  have hg3 := hg2.after_copy F L.base (fun k hk => hk.2.1) hv3 hs3 hf3 ha3 hx3 hl3 hi3 ho3
  have hcopyX : Problem18IMPMatrixMemory20261001.matrix F τ1 (ρ.vars ws+L.copy*F.e) L.n L.n=
      Problem18IMPMatrixMemory20261001.matrix F ρ (ρ.vars ws+L.base*F.e) L.n L.n := hc1
  have hbaseX : Problem18IMPMatrixMemory20261001.matrix F τ1 (ρ.vars ws+L.base*F.e) L.n L.n=
      Problem18IMPMatrixMemory20261001.matrix F ρ (ρ.vars ws+L.base*F.e) L.n L.n := by
    apply matrix_of_cells
    intro k hk
    have hb2 := hsc.2.1
    exact hf1 _ (by left; omega)
  refine ⟨τ3,(hr1.seq (hr2.seq hr3)).mono (by simp only [copyCost]; omega),hg3,?_,?_,?_,?_⟩
  · simp only [mat]
    rw [← hw0]
    apply matrix_of_cells
    intro k hk
    have hb1 := hsc.1
    have hb2 := hsc.2.1
    have hb3 := hsc.2.2.1
    have hb4 := hsc.2.2.2.1
    have e3 : (τ3.arrs canonical.mem).getD (ρ.vars ws+L.acc*F.e+k) 0=
        (τ2.arrs canonical.mem).getD (ρ.vars ws+L.acc*F.e+k) 0 :=
      hf3 _ (by rw [hw2, hw1]; left; omega)
    have e2 : (τ2.arrs canonical.mem).getD (ρ.vars ws+L.acc*F.e+k) 0=
        (τ1.arrs canonical.mem).getD (ρ.vars ws+L.acc*F.e+k) 0 :=
      getD_frame (hl2 _) (fun _ => hf2 _ (by rw [hw1]; left; omega) (by rw [hw1]; left; omega))
    have e1 : (τ1.arrs canonical.mem).getD (ρ.vars ws+L.acc*F.e+k) 0=
        (ρ.arrs canonical.mem).getD (ρ.vars ws+L.acc*F.e+k) 0 :=
      hf1 _ (by left; omega)
    rw [e3, e2, e1]
  · simp only [mat]
    rw [← hw0]
    rw [hw2, hw1] at hc3
    rw [hc3]
    rw [hw1] at hp2
    rw [hp2, hcopyX, hbaseX]
  · rw [hx3 exponentReg (by decide), hx2 exponentReg (by decide), hx1 exponentReg (by decide)]
  · rw [hx3 halfReg (by decide), hx2 halfReg (by decide), hx1 halfReg (by decide)]
def bodyCost (E n : Nat) : Nat := 20+2*productCost E n+3*copyCost E n
theorem body_run {B S : Nat} (L : Layout) (σ0 ρ : Env) (hok : L.Ok S) (hR : Regs L σ0)
    (hmb : σ0.vars canonical.modBase+F.e ≤ σ0.vars ws) (hg : Good F L S B σ0 ρ)
    (hvB : ρ.vars exponentReg<B) :
    ∃τ, Run B body ρ τ (bodyCost F.e L.n) ∧ Good F L S B σ0 τ ∧
      τ.vars exponentReg=ρ.vars exponentReg/2 ∧
      mat F L (σ0.vars ws) L.acc τ=(if ρ.vars exponentReg%2=1 then
        mat F L (σ0.vars ws) L.acc ρ * mat F L (σ0.vars ws) L.base ρ
        else mat F L (σ0.vars ws) L.acc ρ) ∧
      (ρ.vars exponentReg/2=0 ∨ mat F L (σ0.vars ws) L.base τ=
        mat F L (σ0.vars ws) L.base ρ * mat F L (σ0.vars ws) L.base ρ) := by
  have hB2 : 2<B := by have := p_lt F hg.valid; have := F.prime.two_le; omega
  have hhalf : (Expr.bin .div (.var exponentReg) (.lit 2)).evalB B ρ=
      some (ρ.vars exponentReg/2) :=
    evalB_bin (evalB_var hvB) (evalB_lit hB2) (show ρ.vars exponentReg/2<B by omega)
  have r1 : Run B (.assign halfReg (.bin .div (.var exponentReg) (.lit 2))) ρ
      (ρ.setVar halfReg (ρ.vars exponentReg/2)) 4 := (Run.assign hhalf).mono (by simp)
  have hg1 : Good F L S B σ0 (ρ.setVar halfReg (ρ.vars exponentReg/2)) :=
    hg.setVar F halfReg _ (by decide) (by decide)
  have hx1 : (ρ.setVar halfReg (ρ.vars exponentReg/2)).vars exponentReg=ρ.vars exponentReg := by
    simp only [vars_setVar, if_neg (by decide : exponentReg≠halfReg)]
  have hh1 : (ρ.setVar halfReg (ρ.vars exponentReg/2)).vars halfReg=ρ.vars exponentReg/2 := by
    simp only [vars_setVar, if_pos rfl, eq_self_iff_true, if_true, ite_true]
  obtain ⟨ρ2,r2,hg2,hacc2,hbase2,hx2,hh2⟩ : ∃ρ2, Run B
      (.ite (.eq (.var exponentReg) (.bin .mul (.var halfReg) (.lit 2))) .skip multiplyStep)
      (ρ.setVar halfReg (ρ.vars exponentReg/2)) ρ2 (6+(productCost F.e L.n+copyCost F.e L.n)) ∧
      Good F L S B σ0 ρ2 ∧
      mat F L (σ0.vars ws) L.acc ρ2=(if ρ.vars exponentReg%2=1 then
        mat F L (σ0.vars ws) L.acc ρ * mat F L (σ0.vars ws) L.base ρ
        else mat F L (σ0.vars ws) L.acc ρ) ∧
      mat F L (σ0.vars ws) L.base ρ2=mat F L (σ0.vars ws) L.base ρ ∧
      ρ2.vars exponentReg=ρ.vars exponentReg ∧ ρ2.vars halfReg=ρ.vars exponentReg/2 := by
    have htest := evalB_condEq (evalB_var_eq hx1 hvB)
      (evalB_bin (op:=.mul) (evalB_var_eq hh1 (show ρ.vars exponentReg/2<B by omega))
        (evalB_lit hB2) (show ρ.vars exponentReg/2*2<B by omega))
    by_cases hpar : ρ.vars exponentReg%2=1
    · have hb : (ρ.vars exponentReg==Bop.apply .mul (ρ.vars exponentReg/2) 2)=false := by
        simp only [Bop.apply, beq_eq_false_iff_ne]; omega
      rw [hb] at htest
      obtain ⟨τ,hr,hgτ,hacc,hbase,hx,hh⟩ := multiply_step_run F L σ0 _ hok hR hmb hg1
      refine ⟨τ,(Run.ite_false htest hr).mono ?_,hgτ,?_,?_,?_,?_⟩
      · simp only [Cond.size, Expr.size]; omega
      · rw [if_pos hpar, hacc]; rfl
      · rw [hbase]; rfl
      · rw [hx, hx1]
      · rw [hh, hh1]
    · have hb : (ρ.vars exponentReg==Bop.apply .mul (ρ.vars exponentReg/2) 2)=true := by
        simp only [Bop.apply, beq_iff_eq]; omega
      rw [hb] at htest
      refine ⟨_,(Run.ite_true htest Run.skip).mono ?_,hg1,?_,rfl,hx1,hh1⟩
      · simp only [Cond.size, Expr.size, productCost, copyCost]; omega
      · rw [if_neg hpar]; rfl
  have r3 : Run B (.assign exponentReg (.var halfReg)) ρ2
      (ρ2.setVar exponentReg (ρ.vars exponentReg/2)) 2 :=
    (Run.assign (evalB_var_eq hh2 (show ρ.vars exponentReg/2<B by omega))).mono (by simp)
  have hg3 : Good F L S B σ0 (ρ2.setVar exponentReg (ρ.vars exponentReg/2)) :=
    hg2.setVar F exponentReg _ (by decide) (by decide)
  have hx3 : (ρ2.setVar exponentReg (ρ.vars exponentReg/2)).vars exponentReg=
      ρ.vars exponentReg/2 := by
    simp only [vars_setVar, if_pos rfl, eq_self_iff_true, if_true, ite_true]
  have htest4 := evalB_condLt (evalB_lit (σ:=ρ2.setVar exponentReg (ρ.vars exponentReg/2))
    (show 0<B by omega)) (evalB_var_eq hx3 (show ρ.vars exponentReg/2<B by omega))
  by_cases hpos : 0<ρ.vars exponentReg/2
  · have hb : decide (0<ρ.vars exponentReg/2)=true := by simp [hpos]
    rw [hb] at htest4
    obtain ⟨τ,hr,hgτ,hacc,hbase,hx,_⟩ := square_step_run F L σ0 _ hok hR hmb hg3
    refine ⟨τ,?_,hgτ,?_,?_,Or.inr ?_⟩
    · have hall := r1.seq (r2.seq (r3.seq (Run.ite_true (d:=.skip) htest4 hr)))
      exact hall.mono (by simp only [bodyCost, Cond.size, Expr.size]; omega)
    · rw [hx, hx3]
    · rw [hacc]; exact hacc2
    · rw [hbase]; rw [show mat F L (σ0.vars ws) L.base (ρ2.setVar exponentReg (ρ.vars exponentReg/2))=
        mat F L (σ0.vars ws) L.base ρ2 from rfl, hbase2]
  · have hb : decide (0<ρ.vars exponentReg/2)=false := by simp [hpos]
    rw [hb] at htest4
    refine ⟨_,?_,hg3,hx3,?_,Or.inl (by omega)⟩
    · have hall := r1.seq (r2.seq (r3.seq (Run.ite_false (c:=squareStep) htest4 Run.skip)))
      exact hall.mono (by simp only [bodyCost, Cond.size, Expr.size]; omega)
    · exact hacc2
theorem loop_run {B S : Nat} (L : Layout) (σ0 : Env) (hok : L.Ok S) (hR : Regs L σ0)
    (hmb : σ0.vars canonical.modBase+F.e ≤ σ0.vars ws)
    (D : Matrix (Fin L.n) (Fin L.n) K) (total : Nat) (ρ : Env)
    (hg : Good F L S B σ0 ρ) (hvB : ρ.vars exponentReg<B)
    (hinv : mat F L (σ0.vars ws) L.acc ρ * (mat F L (σ0.vars ws) L.base ρ)^(ρ.vars exponentReg)=
      D^total) :
    ∃τ K, Run B loop ρ τ K ∧ K ≤ (4+bodyCost F.e L.n)*Nat.size (ρ.vars exponentReg)+4 ∧
      Good F L S B σ0 τ ∧ τ.vars exponentReg=0 ∧ mat F L (σ0.vars ws) L.acc τ=D^total := by
  let I : Env → Prop := fun ρ => Good F L S B σ0 ρ ∧ ρ.vars exponentReg<B ∧
    mat F L (σ0.vars ws) L.acc ρ * (mat F L (σ0.vars ws) L.base ρ)^(ρ.vars exponentReg)=D^total
  let Φ : Env → Nat := fun ρ => (4+bodyCost F.e L.n)*Nat.size (ρ.vars exponentReg)
  have hdef : ∀ρ, I ρ → ∃v, (Cond.lt (.lit 0) (.var exponentReg)).evalB B ρ=some v := by
    intro ρ h
    exact ⟨_, evalB_condLt (evalB_lit (show 0<B by have := h.2.1; omega)) (evalB_var h.2.1)⟩
  have hstep : ∀ρ, I ρ → (Cond.lt (.lit 0) (.var exponentReg)).evalB B ρ=some true →
      ∃τ K, Run B body ρ τ K ∧ I τ ∧
        1+(Cond.lt (.lit 0) (.var exponentReg)).size+K+Φ τ ≤ Φ ρ := by
    intro ρ h ht
    obtain ⟨hgρ,hvρ,hiρ⟩ := h
    have htest := evalB_condLt (evalB_lit (σ:=ρ) (show 0<B by omega)) (evalB_var hvρ)
    rw [ht] at htest
    have hpos : 0<ρ.vars exponentReg := by simpa using htest.symm
    obtain ⟨τ,hr,hgτ,hx,hacc,hbase⟩ := body_run F L σ0 ρ hok hR hmb hgρ hvρ
    refine ⟨τ,_,hr,⟨hgτ,by rw [hx]; omega,?_⟩,?_⟩
    · rw [hx, hacc]
      rw [← hiρ]
      exact invariant_step _ _ _ _ hbase
    · simp only [Φ, Cond.size, Expr.size]
      rw [hx, ← size_half hpos, Nat.mul_add, Nat.mul_one]
      omega
  obtain ⟨τ,K,hr,⟨hgτ,hvτ,hiτ⟩,hfalse,hK⟩ := Run.while_potential I Φ hdef hstep ⟨hg,hvB,hinv⟩
  have htest := evalB_condLt (evalB_lit (σ:=τ) (show 0<B by omega)) (evalB_var hvτ)
  rw [hfalse] at htest
  have hzero : τ.vars exponentReg=0 := by
    have hh : ¬0<τ.vars exponentReg := by simpa using htest.symm
    omega
  refine ⟨τ,K,hr,?_,hgτ,hzero,?_⟩
  · simp only [Φ, Cond.size, Expr.size] at hK
    omega
  · rw [hzero, pow_zero, mul_one] at hiτ
    exact hiτ
def controlNames : List String := [exponentReg,halfReg,indexReg]++setupNames
theorem program_writes (x : String)
    (h1 : x∉scalarWrites Problem18P34AssemblyMatrixMultiply20261003.program)
    (h2 : x∉controlNames) : x∉scalarWrites program := by
  simp only [controlNames, setupNames, List.mem_append, List.mem_cons, List.not_mem_nil,
    or_false, not_or] at h2
  obtain ⟨⟨n1,n2,n3⟩,n4,n5,n6,n7,n8,n9⟩ := h2
  simp [program, loop, body, multiplyStep, squareStep, productCall, copyMatrix, copyBody,
    identityMatrix, identityBody, scalarWrites, h1, n1, n2, n3, n4, n5, n6, n7, n8, n9]
