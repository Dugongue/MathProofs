  obtain ⟨τ2,hr2,hv2,hs2,hc2,hf2,ha2,hx2,hl2,hi2,ho2⟩ := copy_run F L.n L.out L.acc outR accR τ1
    hR1.out hR1.acc hR1.nn (by decide) (by decide) hv1 hs1 hm1
    (by have := hok.out_work; have := hok.work_fit; omega)
    (by have := hok.acc_base; have := hok.base_copy; have := hok.copy_out; have := hok.out_work;
        have := hok.work_fit; omega)
    (Or.inr (by have := hok.acc_base; have := hok.base_copy; have := hok.copy_out; omega))
  have hg2 := hg1.after_copy F L.acc (fun k hk => hk.1) hv2 hs2 hf2 ha2 hx2 hl2 hi2 ho2
  have hw0 : ρ.vars ws=σ0.vars ws := hg.ws_eq
  refine ⟨τ2,(hr1.seq hr2).mono (by simp only [copyCost]; omega),hg2,?_,?_,?_,?_⟩
  · simp only [mat]
    rw [← hw0]
    rw [hw1] at hc2
    rw [hc2, hp1]
  · simp only [mat]
    rw [← hw0]
    apply matrix_of_cells
    intro k hk
    have hb1 := hsc.1
    have hb2 := hsc.2.1
    have hb3 := hsc.2.2.1
    have hb4 := hsc.2.2.2.1
