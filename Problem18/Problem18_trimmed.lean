  have hunit : Nat.card (AdjoinRoot f.val)ˣ≤Nat.card (FixedUnits φ) :=
    Nat.card_le_card_of_injective u u.injective
  have hchar : (LinearMap.mulLeft K (AdjoinRoot.root p)).charpoly=p := by
    rw [← LinearMap.charpoly_toMatrix _ pb.basis]
    change (Algebra.leftMulMatrix pb.basis pb.gen).charpoly=p
    rw [charpoly_leftMulMatrix,AdjoinRoot.minpoly_powerBasis_gen_of_monic hm]
  have hv : Nat.card V=Nat.card F^n*Nat.card F^n := by
    rw [Nat.card_eq_fintype_card,Module.card_eq_pow_finrank (K:=K),hd,
      ← Nat.card_eq_fintype_card,hcard,pow_two,mul_pow]
  have hqF : (0:ℝ)<Nat.card F := by exact_mod_cast (Nat.card_pos (α := F))
  have hq : (0:ℝ)<(Nat.card F:ℝ)^n := pow_pos hqF n
  have hbase : Real.exp (-72)*(Nat.card F:ℝ)^n≤(Nat.card (AdjoinRoot f.val)ˣ:ℝ) :=
    (le_div_iff₀ hq).mp (squarefree_quotient_units_lower f hs hY)
  have hlo' : (Nat.card (FixedUnits φ):ℝ)*(Nat.card (isometrySubgroup (fun x y => B x y)):ℝ) ≤
      (Nat.card {S : Module.End K V // S.charpoly=p ∧ ∀ x y,B (S x) y=B x (S y)}:ℝ)*
        ((Nat.card F:ℝ)^n*(Nat.card F:ℝ)^n) := by
    have hh : (Nat.card (FixedUnits φ):ℝ)*(Nat.card (isometrySubgroup (fun x y => B x y)):ℝ) ≤
        (Nat.card (Operators (AdjoinRoot.root p) B):ℝ)*(Nat.card V:ℝ) := by exact_mod_cast hlo
    simpa only [Operators,hchar,hv,Nat.cast_mul,Nat.cast_pow] using hh
  apply (mul_le_mul_iff_left₀ hq).mp
  calc
    _ = (Real.exp (-72)*(Nat.card F:ℝ)^n)*(Nat.card (isometrySubgroup (fun x y => B x y)):ℝ) := by ring
    _ ≤ (Nat.card (FixedUnits φ):ℝ)*(Nat.card (isometrySubgroup (fun x y => B x y)):ℝ) :=
      mul_le_mul_of_nonneg_right (hbase.trans (by exact_mod_cast hunit)) (Nat.cast_nonneg _)
    _ ≤ _ := hlo'
