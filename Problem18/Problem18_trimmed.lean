  obtain ⟨τ, hr, hv, ha, hl, hdata, hi, ho⟩ := copyBlock_run (B := W) canonical.mem bank
    (Ne.symm bank_ne_mem) σ hcs hcd hcn hs hd hn (by rw [hG.mem_len]; exact hsl)
    (by rw [hG.bank_len]; exact hdl) hG.mem_word (by rw [hG.bank_len]; exact hG.bank_word)
    (by intro j hj; have := hcan j hj; omega) hB2
  have hregs : ∀ x ∈ [canonical.e, canonical.p, canonical.modBase], x ∉ wcRegs := by decide
  have hG' : Glob F W Sn bankLen τ := Glob.transfer F hG
    (hv _ (hregs _ (by simp))) (hv _ (hregs _ (by simp))) (hv _ (hregs _ (by simp)))
