open Problem18ClaudeIMPSlots20261001 Problem18ClaudeIMPAxpy20261001
open Problem18IMPPolynomialShift20261001 Problem18IMPPolynomialRemainder20261001
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
structure Buffers (q : RNames) (Sn B N : Nat) (P Q : K[X]) (σ : Env) : Prop where
  slots : Slots F canonical q.WS Sn B σ
  capacity : σ.vars q.n = N
  zero : val F canonical q.WS σ 0 = 0
  first : ∀ i < N, val F canonical q.WS σ (5+N+i) = P.coeff (N-1-i)
  second : ∀ i < N, val F canonical q.WS σ (5+N+N+i) = Q.coeff (N-1-i)
  fit : 5+N+N+N ≤ Sn
  firstCapacity : P = 0 ∨ P.natDegree < N
  secondCapacity : Q = 0 ∨ Q.natDegree < N
theorem Buffers.setVar (q : RNames) {Sn B N v : Nat} {P Q : K[X]} {σ : Env}
    (h : Buffers F q Sn B N P Q σ) {x : String}
    (hx : x ∉ regNames canonical) (hW : x ≠ q.WS) (hn : q.n ≠ x) :
    Buffers F q Sn B N P Q (σ.setVar x v) := by
  refine ⟨Slots.setVar F canonical h.slots hx hW v,?_,?_,?_,?_,h.fit,h.firstCapacity,h.secondCapacity⟩
  · simpa only [vars_setVar,if_neg hn] using h.capacity
  · rw [val_setVar F canonical hW];exact h.zero
  · intro i hi;rw [val_setVar F canonical hW];exact h.first i hi
  · intro i hi;rw [val_setVar F canonical hW];exact h.second i hi
def scanDivisor (q : RNames) : Com :=
  .seq (.assign q.N (.var q.n)) (.seq (.assign q.u (.lit 1)) (leadingProgram q))
theorem scanDivisor_run (q : RNames) (hq : q.Valid canonical)
    {Sn B N : Nat} {P Q : K[X]} {σ : Env} (h : Buffers F q Sn B N P Q σ) :
    ∃ τ, Run B (scanDivisor q) σ τ ((52+1000*(F.e+1))*(N+1)+4) ∧
      Buffers F q Sn B N P Q τ ∧ τ.vars q.N = N ∧
      ((τ.vars q.f = 0 ∧ Q = 0) ∨
        (τ.vars q.f = 1 ∧ Q ≠ 0 ∧ τ.vars q.pv = N-1-Q.natDegree)) ∧
      (∀ x, x ∉ regNames canonical → x ∉ [q.N,q.u,q.i,q.f,q.pv] → τ.vars x = σ.vars x) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hNB : N < B := by have := h.fit;have := h.slots.slots_word;omega
  have h1B : 1 < B := by have := h.fit;have := h.slots.slots_word;omega
  have nN : q.N ∉ regNames canonical := hq.2 _ (by simp [RNames.list])
  have nu : q.u ∉ regNames canonical := hq.2 _ (by simp [RNames.list])
  have hNW : q.N ≠ q.WS := hq.ne_of (by intro he;simp [RNames.list,he])
  have huW : q.u ≠ q.WS := hq.ne_of (by intro he;simp [RNames.list,he])
  have hnN : q.n ≠ q.N := hq.ne_of (by intro he;simp [RNames.list,he])
  have hnu : q.n ≠ q.u := hq.ne_of (by intro he;simp [RNames.list,he])
  have hNu : q.N ≠ q.u := hq.ne_of (by intro he;simp [RNames.list,he])
  let σ1 := σ.setVar q.N N
  let σ2 := σ1.setVar q.u 1
  have hs1 : Buffers F q Sn B N P Q σ1 := Buffers.setVar F q h nN hNW hnN
  have hs2 : Buffers F q Sn B N P Q σ2 := Buffers.setVar F q hs1 nu huW hnu
  have hN2 : σ2.vars q.N = N := by simp [σ2,σ1,vars_setVar,hNu]
  have hu2 : σ2.vars q.u = 1 := by simp [σ2]
  have htail : ∀ i, N ≤ i → Q.coeff i = 0 := by
    intro i hi
    rcases h.secondCapacity with hz|hd
    · simp [hz]
    · exact coeff_eq_zero_of_natDegree_lt (by omega)
  have hcoeff : ∀ i < N, val F canonical q.WS σ2 (Problem18ClaudeIMPPivot20261001.rowStart N 1+i) = Q.coeff (N-1-i) := by
    simpa only [Problem18ClaudeIMPPivot20261001.rowStart,one_mul] using hs2.second
  obtain ⟨τ,hr,hs,hm,hscan,hv,hin,hout⟩ := leading_run F q hq hs2.slots
    hN2 hs2.capacity hu2 (by simpa only [Problem18ClaudeIMPPivot20261001.rowStart,one_mul] using h.fit)
    hs2.zero h1B Q htail hcoeff
  have hn : τ.vars q.n = N := (hv _ (hq.2 _ (by simp [RNames.list]))
    (hq.ne_of (by intro he;simp [RNames.list,he]))
    (hq.ne_of (by intro he;simp [RNames.list,he]))
    (hq.ne_of (by intro he;simp [RNames.list,he]))).trans hs2.capacity
  have hwidth : τ.vars q.N = N := (hv _ nN
    (hq.ne_of (by intro he;simp [RNames.list,he]))
    (hq.ne_of (by intro he;simp [RNames.list,he]))
    (hq.ne_of (by intro he;simp [RNames.list,he]))).trans hN2
  have ha : Run B (.assign q.N (.var q.n)) σ σ1 2 :=
    Run.assign (by simpa only [h.capacity] using evalB_var (B:=B) (σ:=σ) (x:=q.n) (by rw [h.capacity];exact hNB))
  have hb : Run B (.assign q.u (.lit 1)) σ1 σ2 2 := Run.assign (evalB_lit h1B)
  refine ⟨τ,?_,⟨hs,hn,(hm 0).trans hs2.zero,fun i hi => (hm _).trans (hs2.first i hi),
    fun i hi => (hm _).trans (hs2.second i hi),h.fit,h.firstCapacity,h.secondCapacity⟩,
    hwidth,?_,?_,hin,hout⟩
  · exact (ha.seq (hb.seq hr)).mono (by omega)
  · rcases hscan with hz|⟨hf,hpv,hq0,hd,_⟩
    · exact Or.inl hz
    · exact Or.inr ⟨hf,hq0,by omega⟩
  · intro x hx hxs
    have hh : x ≠ q.N ∧ x ≠ q.u ∧ x ≠ q.i ∧ x ≠ q.f ∧ x ≠ q.pv := by simpa using hxs
    rw [hv x hx hh.2.2.1 hh.2.2.2.1 hh.2.2.2.2]
    simp only [σ2,σ1,vars_setVar,if_neg hh.1,if_neg hh.2.1]
def finishSetup (q : RNames) : Com :=
  .seq (.assign q.w (.var q.pv))
    (.seq (.assign q.u (.lit 0)) (.assign q.c (.lit 0)))
theorem finishSetup_run (q : RNames) (hq : q.Valid canonical)
    {Sn B N : Nat} {P Q : K[X]} {σ : Env} (h : Buffers F q Sn B N P Q σ)
    (hw : σ.vars q.N = N) (hpv : σ.vars q.pv < B) :
    ∃ τ, Run B (finishSetup q) σ τ 6 ∧ Buffers F q Sn B N P Q τ ∧
      τ.vars q.N = N ∧ τ.vars q.u = 0 ∧ τ.vars q.c = 0 ∧
      τ.vars q.w = σ.vars q.pv ∧ τ.vars q.f = σ.vars q.f ∧
      (∀ x, x ∉ [q.w,q.u,q.c] → τ.vars x = σ.vars x) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hzB : 0 < B := by have := h.slots.slots_word;omega
  have nw : q.w ∉ regNames canonical := hq.2 _ (by simp [RNames.list])
  have nu : q.u ∉ regNames canonical := hq.2 _ (by simp [RNames.list])
  have nc : q.c ∉ regNames canonical := hq.2 _ (by simp [RNames.list])
  let σ1 := σ.setVar q.w (σ.vars q.pv)
  let σ2 := σ1.setVar q.u 0
  let τ := σ2.setVar q.c 0
  have h1 : Buffers F q Sn B N P Q σ1 := Buffers.setVar F q h nw
    (hq.ne_of (by intro he;simp [RNames.list,he]))
    (hq.ne_of (by intro he;simp [RNames.list,he]))
  have h2 : Buffers F q Sn B N P Q σ2 := Buffers.setVar F q h1 nu
    (hq.ne_of (by intro he;simp [RNames.list,he]))
    (hq.ne_of (by intro he;simp [RNames.list,he]))
  have ht : Buffers F q Sn B N P Q τ := Buffers.setVar F q h2 nc
    (hq.ne_of (by intro he;simp [RNames.list,he]))
    (hq.ne_of (by intro he;simp [RNames.list,he]))
  have huc : q.u ≠ q.c := hq.ne_of (by intro he;simp [RNames.list,he])
  have hwc : q.w ≠ q.c := hq.ne_of (by intro he;simp [RNames.list,he])
  have hwu : q.w ≠ q.u := hq.ne_of (by intro he;simp [RNames.list,he])
  have hframe (x : String) (hx : x ∉ [q.w,q.u,q.c]) : τ.vars x = σ.vars x := by
    have hx' : x ≠ q.w ∧ x ≠ q.u ∧ x ≠ q.c := by simpa using hx
    simp only [τ,σ2,σ1,vars_setVar,if_neg hx'.1,if_neg hx'.2.1,if_neg hx'.2.2]
  have hNframe : τ.vars q.N = σ.vars q.N := hframe _ (by
    simp only [List.mem_cons,List.not_mem_nil,not_false_eq_true,not_or,and_true]
    exact ⟨hq.ne_of (by intro he;simp [RNames.list,he]),
      hq.ne_of (by intro he;simp [RNames.list,he]),
      hq.ne_of (by intro he;simp [RNames.list,he])⟩)
  have hfFrame : τ.vars q.f = σ.vars q.f := hframe _ (by
    simp only [List.mem_cons,List.not_mem_nil,not_false_eq_true,not_or,and_true]
    exact ⟨hq.ne_of (by intro he;simp [RNames.list,he]),
      hq.ne_of (by intro he;simp [RNames.list,he]),
      hq.ne_of (by intro he;simp [RNames.list,he])⟩)
  have ha : Run B (.assign q.w (.var q.pv)) σ σ1 2 := Run.assign (evalB_var hpv)
  have hb : Run B (.assign q.u (.lit 0)) σ1 σ2 2 := Run.assign (evalB_lit hzB)
  have hc : Run B (.assign q.c (.lit 0)) σ2 τ 2 := Run.assign (evalB_lit hzB)
  refine ⟨τ,ha.seq (hb.seq hc),ht,hNframe.trans hw,?_,?_,?_,hfFrame,hframe,rfl,rfl⟩
  · simp only [τ,σ2,vars_setVar,if_neg huc,ite_true]
  · simp [τ]
  · simp only [τ,σ2,σ1,vars_setVar,if_neg hwc,if_neg hwu,ite_true]
def routine (q : RNames) : Com :=
  .seq (scanDivisor q) (.ite (.eq (.var q.f) (.lit 1))
    (.seq (finishSetup q) (.while (.lt (.var q.c) (.var q.n)) (body q))) .skip)
def routineBudget (q : RNames) (N : Nat) : Nat :=
  (52+1000*(F.e+1))*(N+1)+20+
    (4+Problem18IMPPolynomialRemainderControl20261001.bodyBudget F q N)*N+4
theorem routine_run (q : RNames) (hq : q.Valid canonical)
    {Sn B N : Nat} {P Q : K[X]} {σ : Env} (h : Buffers F q Sn B N P Q σ) :
    ∃ τ, Run B (routine q) σ τ (routineBudget F q N) ∧
      Buffers F q Sn B N (P % Q) Q τ ∧
      (∀ x, x ∉ regNames canonical → x ∉ [q.N,q.u,q.i,q.f,q.pv,q.w,q.c,q.j] →
        τ.vars x = σ.vars x) ∧ τ.inp = σ.inp ∧ τ.out = σ.out := by
  have h1B : 1 < B := by have := h.fit;have := h.slots.slots_word;omega
  obtain ⟨ξ,hs,hbuf,hw,hflag,hvars,hin,hout⟩ := scanDivisor_run F q hq h
  rcases hflag with ⟨hf,hQ⟩|⟨hf,hQ,hpv⟩
  · have hc : (Cond.eq (.var q.f) (.lit 1)).evalB B ξ = some false := by
      have hv : (Expr.var q.f).evalB B ξ = some 0 := by
        simpa only [hf] using evalB_var (B:=B) (σ:=ξ) (x:=q.f) (by rw [hf];omega)
      exact evalB_condEq hv (evalB_lit h1B)
    have hr := hs.seq (Run.ite_false (c:=.seq (finishSetup q) (.while (.lt (.var q.c) (.var q.n)) (body q))) hc (Run.skip (B:=B) (σ:=ξ)))
    refine ⟨ξ,hr.mono ?_,?_,?_,hin,hout⟩
    · simp only [routineBudget,Cond.size,Expr.size]
      omega
    · simpa only [hQ,EuclideanDomain.mod_zero] using hbuf
    · intro x hx hxs
      apply hvars x hx
      simp only [List.mem_cons,List.not_mem_nil,not_false_eq_true,not_or,and_true] at hxs ⊢
      tauto
  · have hQN : Q.natDegree < N := h.secondCapacity.resolve_left hQ
    have hpvB : ξ.vars q.pv < B := by rw [hpv];have := h.slots.slots_word;have := h.fit;omega
    obtain ⟨ζ,hfin,hb,hwz,huz,hcz,hwv,hfz,hfr,hinz,houtz⟩ := finishSetup_run F q hq hbuf hw hpvB
    have hstored : Stored F q Sn B N P Q ζ :=
      ⟨hb.slots,hb.capacity,hwz,huz,hwv.trans hpv,hb.zero,hb.first,hb.second,
        hb.fit,hb.firstCapacity,hQN,hQ⟩
    obtain ⟨τ,hl,ht,hcount,hlframe,hinl,houtl⟩ :=
      Problem18IMPPolynomialRemainderControl20261001.loop_run F q hq hstored hcz
    have hc : (Cond.eq (.var q.f) (.lit 1)).evalB B ξ = some true := by
      have hv : (Expr.var q.f).evalB B ξ = some 1 := by
        simpa only [hf] using evalB_var (B:=B) (σ:=ξ) (x:=q.f) (by rw [hf];exact h1B)
      exact evalB_condEq hv (evalB_lit h1B)
    refine ⟨τ,(hs.seq (Run.ite_true hc (hfin.seq hl))).mono ?_,
      ⟨ht.slots,ht.capacity,ht.zero,ht.first,ht.second,ht.fit,ht.firstCapacity,Or.inr ht.secondCapacity⟩,
      ?_,hinl.trans (hinz.trans hin),houtl.trans (houtz.trans hout)⟩
    · simp only [routineBudget,Cond.size,Expr.size]
      omega
    · intro x hx hxs
      simp only [List.mem_cons,List.mem_singleton,not_or] at hxs
      rw [hlframe x hx (by simp only [RNames.moving,List.mem_cons,List.mem_singleton,not_or];tauto)
        (by tauto)]
      rw [hfr x (by simp only [List.mem_cons,List.mem_singleton,not_or];tauto)]
      exact hvars x hx (by simp only [List.mem_cons,List.mem_singleton,not_or];tauto)
end Mathproof.Problem18IMPPolynomialRemainderSetup20261001
