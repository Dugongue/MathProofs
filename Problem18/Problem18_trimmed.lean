def firstFamilyN (a b c : Nat) : Nat := firstOneN a b c + 1
def firstScratchN (a b c : Nat) : Nat := firstFamilyN a b c + capGenN a b c * capFlatN a b c
def firstRightN (a b c : Nat) : Nat := firstScratchN a b c + 3
def firstOutputN (a b c : Nat) : Nat := firstRightN a b c + capFlatN a b c
def firstAlgScratchN (a b c : Nat) : Nat := firstOutputN a b c + capFlatN a b c
