theorem eq_sum_tmul_right {K : Type*} [CommRing K] [Algebra E K] {ι : Type*}
    (bF : Module.Basis ι E F) (z : K ⊗[E] F) :
    z = ∑ i ∈ ((Algebra.TensorProduct.basis K bF).repr z).support,
      ((Algebra.TensorProduct.basis K bF).repr z i) ⊗ₜ[E] bF i := by
  conv_lhs => rw [← (Algebra.TensorProduct.basis K bF).linearCombination_repr z]
  rw [Finsupp.linearCombination_apply, Finsupp.sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  exact Algebra.TensorProduct.basis_repr_symm_apply' bF _ i
theorem map_val_injective_field {K : Type*} [Field K] [Algebra E K]
    (L : IntermediateField E K) :
    Function.Injective (Algebra.TensorProduct.map L.val (AlgHom.id E F)) := by
  have heq : (Algebra.TensorProduct.map L.val (AlgHom.id E F) : L ⊗[E] F → K ⊗[E] F) =
      (L.val.toLinearMap.rTensor F : L ⊗[E] F → K ⊗[E] F) := by
    funext z
    induction z using TensorProduct.induction_on with
    | zero => rw [map_zero, map_zero]
    | tmul b a => rw [Algebra.TensorProduct.map_tmul, LinearMap.rTensor_tmul]; rfl
    | add z w hz hw => rw [map_add, map_add, hz, hw]
  rw [heq]
  exact Module.Flat.rTensor_preserves_injective_linearMap (M := F) L.val.toLinearMap
    Subtype.val_injective
theorem isNilpotent_or_isUnit
    (hE : ∀ a : F, IsIntegral E a → a ∈ Set.range (algebraMap E F))
    {K : Type*} [Field K] [Algebra E K] [Algebra.IsAlgebraic E K] (z : K ⊗[E] F) :
    IsNilpotent z ∨ IsUnit z := by
  classical
  obtain ⟨q, hq⟩ := ExpChar.exists E
  haveI : Nontrivial (K ⊗[E] F) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_flat_right E K F
      (algebraMap E K).injective
  haveI : ExpChar (K ⊗[E] F) q :=
    expChar_of_injective_algebraMap (algebraMap E (K ⊗[E] F)).injective q
  have bF : Module.Basis _ E F := Module.Basis.ofVectorSpace E F
  have hsep : ∀ i, ∃ n : ℕ, (Algebra.TensorProduct.basis K bF).repr z i ^ q ^ n ∈
      separableClosure E K := by
    intro i
    obtain ⟨n, y, hy⟩ := IsPurelyInseparable.pow_mem (separableClosure E K) q
      ((Algebra.TensorProduct.basis K bF).repr z i)
    refine ⟨n, ?_⟩
    rw [← hy]
    exact y.2
  choose n hn using hsep
  obtain ⟨N, hN⟩ : ∃ N, N = ((Algebra.TensorProduct.basis K bF).repr z).support.sup n := ⟨_, rfl⟩
  have hNmem : ∀ i ∈ ((Algebra.TensorProduct.basis K bF).repr z).support,
      (Algebra.TensorProduct.basis K bF).repr z i ^ q ^ N ∈ separableClosure E K := by
    intro i hi
    have hle : n i ≤ N := hN ▸ Finset.le_sup (f := n) hi
    have hpow : q ^ N = q ^ n i * q ^ (N - n i) := by
      rw [← pow_add]
      congr 1
      omega
    rw [hpow, pow_mul]
    exact pow_mem (hn i) _
  obtain ⟨S, hS⟩ : ∃ S : Finset K, S = ((Algebra.TensorProduct.basis K bF).repr z).support.image
      (fun i => (Algebra.TensorProduct.basis K bF).repr z i ^ q ^ N) := ⟨_, rfl⟩
  haveI : FiniteDimensional E (IntermediateField.adjoin E (S : Set K)) :=
    IntermediateField.finiteDimensional_adjoin
      (fun x _ => (Algebra.IsAlgebraic.isAlgebraic (R := E) x).isIntegral)
  haveI : Algebra.IsSeparable E (IntermediateField.adjoin E (S : Set K)) := by
    rw [IntermediateField.isSeparable_adjoin_iff_isSeparable]
    intro x hx
    rw [hS] at hx
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp (Finset.mem_coe.mp hx)
    exact mem_separableClosure_iff.mp (hNmem i hi)
  obtain ⟨α, hα⟩ := Field.exists_primitive_element E (IntermediateField.adjoin E (S : Set K))
  have hfield : IsField (IntermediateField.adjoin E (S : Set K) ⊗[E] F) :=
    isField_tensor_of_adjoin_eq_top hE α (Algebra.IsIntegral.isIntegral α) hα
  have hιinj := map_val_injective_field (F := F) (IntermediateField.adjoin E (S : Set K))
  have hmemL : ∀ i ∈ ((Algebra.TensorProduct.basis K bF).repr z).support,
      (Algebra.TensorProduct.basis K bF).repr z i ^ q ^ N ∈
        IntermediateField.adjoin E (S : Set K) := fun i hi =>
    IntermediateField.subset_adjoin E _
      (Finset.mem_coe.mpr (hS ▸ Finset.mem_image_of_mem _ hi))
  obtain ⟨w, hw⟩ : ∃ w : IntermediateField.adjoin E (S : Set K) ⊗[E] F,
      Algebra.TensorProduct.map (IntermediateField.adjoin E (S : Set K)).val (AlgHom.id E F) w =
        z ^ q ^ N := by
    refine ⟨∑ i ∈ ((Algebra.TensorProduct.basis K bF).repr z).support.attach,
      (⟨(Algebra.TensorProduct.basis K bF).repr z i ^ q ^ N, hmemL i i.2⟩ :
        IntermediateField.adjoin E (S : Set K)) ⊗ₜ[E] (bF i ^ q ^ N), ?_⟩
    rw [map_sum]
    have hz : z ^ q ^ N = iterateFrobenius (K ⊗[E] F) q N z := by
      rw [iterateFrobenius_def]
    rw [hz]
    conv_rhs => rw [eq_sum_tmul_right bF z, map_sum, ← Finset.sum_attach]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [iterateFrobenius_def, Algebra.TensorProduct.tmul_pow, Algebra.TensorProduct.map_tmul,
      AlgHom.id_apply]
    rfl
  by_cases hw0 : w = 0
  · left
    exact ⟨q ^ N, by rw [← hw, hw0, map_zero]⟩
  · right
    obtain ⟨w', hw'⟩ := hfield.mul_inv_cancel hw0
    have hu : IsUnit (z ^ q ^ N) := by
      rw [← hw]
      exact IsUnit.of_mul_eq_one
        (Algebra.TensorProduct.map (IntermediateField.adjoin E (S : Set K)).val (AlgHom.id E F) w')
        (by rw [← map_mul, hw', map_one])
    exact (isUnit_pow_iff (pow_ne_zero _ (expChar_pos E q).ne')).mp hu
theorem nilradical_isMaximal_of_forall {R : Type*} [CommRing R] [Nontrivial R]
    (h : ∀ z : R, IsNilpotent z ∨ IsUnit z) : (nilradical R).IsMaximal := by
  rw [Ideal.isMaximal_iff]
