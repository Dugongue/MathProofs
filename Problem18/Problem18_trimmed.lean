  have hS1 : 1 ≤ dimSumN a b c := by unfold dimSumN; omega
  have hN : b*b ≤ capFlatN a b c := by
    unfold capFlatN; exact Nat.mul_le_mul hbS hbS
  have hG : c ≤ capGenN a b c := by
    unfold capGenN
    calc c ≤ dimSumN a b c := hcS
      _ = dimSumN a b c * 1 := by ring
      _ ≤ dimSumN a b c * dimSumN a b c := Nat.mul_le_mul_left _ hS1
