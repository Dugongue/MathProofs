      intro x hx
      simp only [List.mem_cons,List.not_mem_nil,or_false] at hx
      rcases hx with rfl|rfl|rfl
      · rw [hv.2.2.2.2.1]; omega
      · rw [hv.2.2.2.2.2.1]; omega
      · rw [hv.2.2.2.2.2.2.1]; omega) hv.2.2.1 hq
