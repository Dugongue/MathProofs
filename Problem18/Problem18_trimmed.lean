def RamPolytimeOn (valid : List ℕ → Prop) (f : List ℕ → List ℕ) : Prop :=
  ∃ (p : Lax13.Ram.Program) (wordBound timeBound : Polynomial ℕ),
    ∀ x, valid x →
      FitsInWords (wordBound.eval (bitSize x)) ((x.length::x)++f x) ∧
      ∀ w, wordBound.eval (bitSize x) ≤ w →
        ∃ t ≤ timeBound.eval (bitSize x), Lax13.Ram.RunsTo w p (x.length::x) (f x) t
theorem ramPolytimeOn_of_bounded_imp
    (valid : List ℕ → Prop) (L : Layout) (c : Com) (f : List ℕ → List ℕ) (P T : Polynomial ℕ)
    (hok : Com.Ok L c)
    (hrun : ∀ x : List ℕ, valid x → ∃ (ext : String → ℕ) (σ : Env),
      Run (2^(P.eval (bitSize x)+bitSize x+1)) c
        (initEnv ext (x.length::x)) σ (T.eval (bitSize x)) ∧ σ.out=f x) :
    RamPolytimeOn valid f := by
  let C := L.temps+2+L.scalars.length+L.arrays.length+1
  let W : Polynomial ℕ := P+Polynomial.X+Polynomial.C (1+C)
  let U : Polynomial ℕ := Polynomial.C L.const*T
  refine ⟨compileProgram L c,W,U,?_⟩
  intro x hx
  let n := bitSize x
  let s := P.eval n+n
  let B := 2^(s+1)
  have hW : W.eval n=s+1+C := by simp [W,s]; omega
  have hT : U.eval n=L.const*T.eval n := by simp [U]
  have hinput : ∀v ∈ x.length::x,v<B := by
    intro v hv
    have hp : 2^(bitSize x+1) ≤ B := Nat.pow_le_pow_right (by omega) (by dsimp [s,n]; omega)
    rcases List.mem_cons.mp hv with rfl | hv
    · exact (Lax51Proofs.Encoding.length_lt_two_pow_bitSize_add_one x).trans_le hp
    · exact (Lax51Proofs.Encoding.mem_lt_two_pow_bitSize_add_one hv).trans_le hp
  obtain ⟨ext,σ,⟨k,hk,hbs⟩,hout⟩ := hrun x hx
  have hfit : L.FitsWords B (W.eval n) := by
    rw [hW]
    exact layoutFitsWords L s
  have houtput : ∀v ∈ f x,v<B := by
    rw [←hout]
    exact output_bounded hbs (by simp [initEnv])
  constructor
  · intro v hv
    rcases List.mem_append.mp hv with hv | hv
    · exact (hinput v hv).trans_le hfit.bound
    · exact (houtput v hv).trans_le hfit.bound
  · intro w hw
    have hfitw : L.FitsWords B w :=
      ⟨hfit.one_lt,hfit.bound.trans (Nat.pow_le_pow_right (by omega) hw),
        hfit.span.trans (Nat.pow_le_pow_right (by omega) hw)⟩
    obtain ⟨t,ht,htRun⟩ := compileProgram_runsTo hfitw hok hinput hbs
    refine ⟨t,?_,?_⟩
    · change t ≤ U.eval n
      rw [hT]
      exact ht.trans (Nat.mul_le_mul_left _ hk)
    · simpa only [hout] using htRun
end Mathproof.Problem18IMPPartialCompiler20261001
end
