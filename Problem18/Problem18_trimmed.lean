theorem kernel_event_iff (B : LinearMap.BilinForm K V) (C : LinearMap.BilinForm K W)
    (hB : B.SeparatingLeft) (p : K[X]) (hp : p.Monic)
    (T : SelfAdjointOperators (RingEquiv.refl K) (sumForm (RingEquiv.refl K) B C)) :
    KernelEvent B C p T ↔
