inductive Buffer
  | empty | one (a : Symbol) | two (a b : Symbol)
  deriving DecidableEq, Fintype
def buffered : Buffer → List Symbol
  | .empty=>[] | .one a=>[a] | .two a b=>[a,b]
def delay : Transducer Symbol Symbol Buffer where
  initial:=.empty
  next q a:=match q with
    | .empty=>(.one a,[])
    | .one b=>(.two b a,[])
    | .two b c=>(.two c a,[b])
  finish _:=[]
  next_bound q a:=by cases q <;> simp
  finish_bound _:=by simp
def accept : Buffer→Bool
  | .two .separator .one=>true
  | _=>false
theorem run_flag_one (q : Buffer) (xs : List Symbol) :
    run delay q (xs++[.separator,.one])=buffered q++xs := by
  induction xs generalizing q with
  | nil=>cases q <;> rfl
  | cons a xs ih=>
    change (delay.next q a).2++run delay (delay.next q a).1 (xs++[.separator,.one])=_
    rw [ih]
    cases q <;> rfl
theorem final_flag_one (q : Buffer) (xs : List Symbol) :
    finalState delay q (xs++[.separator,.one])=.two .separator .one := by
  induction xs generalizing q with
  | nil=>cases q <;> rfl
  | cons a xs ih=>simpa [finalState,delay] using ih (delay.next q a).1
theorem final_flag_zero (q : Buffer) (xs : List Symbol) :
    accept (finalState delay q (xs++[.separator]))=false := by
  induction xs generalizing q with
  | nil=>cases q with
    | empty=>rfl
    | one a=>cases a <;> rfl
    | two a b=>cases b <;> rfl
  | cons a xs ih=>simpa [finalState,delay] using ih (delay.next q a).1
theorem accepted (xs : List Nat) :
    guardedRun delay accept (encode (xs++[1]))=encode xs := by
  have he : encode (xs++[1])=encode xs++[.separator,.one] := by
    simp [encode,encodeNat,Nat.bits]
  rw [he,guardedRun,final_flag_one]
  simpa [accept,delay,buffered] using run_flag_one Buffer.empty (encode xs)
theorem rejected (xs : List Nat) :
    guardedRun delay accept (encode (xs++[0]))=[] := by
  have he : encode (xs++[0])=encode xs++[.separator] := by
    simp [encode,encodeNat,Nat.bits]
  rw [he,guardedRun,final_flag_zero]
  rfl
noncomputable def filterMachine := computable delay accept
theorem filter_finite (k : filterMachine.tm.K) : Finite (filterMachine.tm.Γ k) := by
  change Finite (Alphabet Symbol Symbol k)
  infer_instance
end Mathproof.Problem18RootParserFlagFilter20261001
