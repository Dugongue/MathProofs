  apply Finset.prod_congr rfl
  intro a _
  rw [Nat.cast_sub (hn a), Nat.cast_pow, Nat.cast_pow]
  field_simp
private theorem glFactor_eq_squareProduct
    (q : ℝ) (hq : 0 < q) (d : ℕ) :
    glFactor q d = ∏ a : Fin d, (1 - q ^ a.val / q ^ d) := by
