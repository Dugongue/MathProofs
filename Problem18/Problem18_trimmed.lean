theorem interpret_map {σ F G : Type*} [Field F] [Field G] (g : F →+* G) (x : σ → F)
    (p : PolyExpr σ ℤ) :
    interpret (Int.castRingHom G) (fun i => g (x i)) p = g (interpret (Int.castRingHom F) x p) := by
  induction p with
  | const c => simp [interpret]
  | var i => simp [interpret]
  | add a b ha hb => simp [interpret, ha, hb]
  | mul a b ha hb => simp [interpret, ha, hb]
theorem clauseHolds_map {σ F G : Type*} [Field F] [Field G] (g : F →+* G) (x : σ → F)
    (c : Clause σ ℤ) :
    clauseHolds (Int.castRingHom G) (fun i => g (x i)) c ↔ clauseHolds (Int.castRingHom F) x c := by
  simp only [clauseHolds, literalHolds, interpret_map]
  refine forall₂_congr fun l _ => ?_
  split_ifs
  · exact map_eq_zero_iff g g.injective
  · exact not_congr (map_eq_zero_iff g g.injective)
theorem degree_reindex {σ τ : Type*} (u : σ → τ) (p : PolyExpr σ ℤ) :
    (reindex u p).degree = p.degree := by
  induction p with
  | const c => rfl
  | var i => rfl
  | add a b ha hb => simp [reindex, PolyExpr.degree, ha, hb]
  | mul a b ha hb => simp [reindex, PolyExpr.degree, ha, hb]
def splitVar {c0 m : ℕ} : Fin (c0 + m) ⊕ Unit → Fin c0 ⊕ Fin (m + 1)
  | .inl i => Fin.addCases (fun a => .inl a) (fun b => .inr (Fin.castSucc b)) i
  | .inr _ => .inr (Fin.last m)
def sysExprs {c0 m : ℕ} (c : Clause (Fin (c0 + m)) ℤ) : List (PolyExpr (Fin c0 ⊕ Fin (m + 1)) ℤ) :=
  (equationExpressions c).map (reindex splitVar)
def clauseDeg {c0 m : ℕ} (c : Clause (Fin (c0 + m)) ℤ) : ℕ := maxDegree (equationExpressions c)
theorem sysExprs_degree {c0 m : ℕ} (c : Clause (Fin (c0 + m)) ℤ) :
    ∀ p ∈ sysExprs c, p.degree ≤ clauseDeg c := by
  intro p hp
  simp only [sysExprs, List.mem_map] at hp
  obtain ⟨q, hq, rfl⟩ := hp
  rw [degree_reindex]
  exact degree_le_maxDegree _ q hq
theorem elim_splitVar {F : Type*} {c0 m : ℕ} (x : Fin c0 → F) (y : Fin (m + 1) → F) :
    (fun i => Sum.elim x y (splitVar i)) =
      Sum.elim (Fin.append x (Fin.init y)) (fun _ : Unit => y (Fin.last m)) := by
  funext i
  rcases i with i | u
  · induction i using Fin.addCases with
    | left a => simp [splitVar, Fin.append_left]
    | right b => simp [splitVar, Fin.append_right, Fin.init]
  · rfl
theorem sysExprs_zero_iff {F : Type*} [Field F] {c0 m : ℕ} (c : Clause (Fin (c0 + m)) ℤ)
    (x : Fin c0 → F) (y : Fin (m + 1) → F) :
    (∀ p ∈ sysExprs c, interpret (Int.castRingHom F) (Sum.elim x y) p = 0) ↔
      clauseHolds (Int.castRingHom F) (Fin.append x (Fin.init y)) c ∧
      y (Fin.last m) * interpret (Int.castRingHom F) (Fin.append x (Fin.init y))
        (exprProduct (nonzeroExpressions c)) = 1 := by
  have h := equationExpressions_correct (Int.castRingHom F) (Fin.append x (Fin.init y))
    (y (Fin.last m)) c
  rw [clauseHolds_product]
  constructor
  · intro hall
    have hall' : ∀ p ∈ equationExpressions c, interpret (Int.castRingHom F)
        (Sum.elim (Fin.append x (Fin.init y)) fun _ => y (Fin.last m)) p = 0 := by
      intro p hp
      have := hall _ (List.mem_map_of_mem (f := reindex splitVar) hp)
      rwa [interpret_reindex, Function.comp_def, elim_splitVar] at this
    obtain ⟨hz, hprod⟩ := h.mp hall'
    refine ⟨⟨hz, ?_⟩, hprod⟩
    intro h0
    rw [h0, mul_zero] at hprod
    exact zero_ne_one hprod
  · rintro ⟨⟨hz, _⟩, hprod⟩ p hp
    simp only [sysExprs, List.mem_map] at hp
    obtain ⟨q, hq, rfl⟩ := hp
    rw [interpret_reindex, Function.comp_def, elim_splitVar]
    exact h.mpr ⟨hz, hprod⟩ q hq
theorem exists_sys_zero_iff {F : Type*} [Field F] {c0 m : ℕ} (c : Clause (Fin (c0 + m)) ℤ)
    (x : Fin c0 → F) :
    (∃ y : Fin (m + 1) → F, ∀ p ∈ sysExprs c, interpret (Int.castRingHom F) (Sum.elim x y) p = 0) ↔
      ∃ u : Fin m → F, clauseHolds (Int.castRingHom F) (Fin.append x u) c := by
  constructor
  · rintro ⟨y, hy⟩
    exact ⟨Fin.init y, ((sysExprs_zero_iff c x y).mp hy).1⟩
  · rintro ⟨u, hu⟩
    have hne := ((clauseHolds_product _ _ c).mp hu).2
    refine ⟨Fin.snoc u (interpret (Int.castRingHom F) (Fin.append x u)
      (exprProduct (nonzeroExpressions c)))⁻¹, ?_⟩
    rw [sysExprs_zero_iff]
    simp only [Fin.init_snoc, Fin.snoc_last]
    exact ⟨hu, inv_mul_cancel₀ hne⟩
end Clauses
section ClauseRun
open Mathproof.Problem18BoundedEncoding20260930
open Mathproof.Problem18SpecializationSafeElimination20261001
