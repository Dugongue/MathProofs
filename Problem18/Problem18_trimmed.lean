  fun j t=>(augmentedRightFactor x *ᵥ ker t) (augmentedIndex a b j)
theorem entry (F : Matrix (Fin c) (Fin a × Fin b) K) (e : Fin c → K)
    (x : OuterVar a b → K) (ker : Fin k → AugmentedColumn a b → K) (s : Fin c) (t : Fin k) :
    (matrix F e*tests x ker) s t=(augmentedKernelEntry F e ker s t).eval x := by
  rw [eval_augmentedKernelEntry_eq_mulVec,augmentedTransformed_eq_mul_factor,←Matrix.mulVec_mulVec]
  change ((augmentedConstantMatrix F e).submatrix id (augmentedIndex a b) *ᵥ
    ((augmentedRightFactor x *ᵥ ker t) ∘ augmentedIndex a b)) s=_
  simp only [Matrix.submatrix_mulVec_equiv,Function.comp_def,id_eq,Equiv.apply_symm_apply]
