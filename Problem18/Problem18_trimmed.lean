variable {K : Type} [Field K] [DecidableEq K]
noncomputable def polyOf {N : Nat} (a : Fin N → K) : K[X] :=
  ((Polynomial.degreeLTEquiv K N).symm a).1
theorem polyOf_degree {N : Nat} (a : Fin N → K) : (polyOf a).degree < N :=
  Polynomial.mem_degreeLT.mp ((Polynomial.degreeLTEquiv K N).symm a).2
theorem polyOf_coeff {N : Nat} (a : Fin N → K) (i : Fin N) :
    (polyOf a).coeff i = a i := by
  change (Polynomial.degreeLTEquiv K N ((Polynomial.degreeLTEquiv K N).symm a)) i = a i
  rw [LinearEquiv.apply_symm_apply]
theorem polyOf_coefficients {N : Nat} (P : K[X]) (hP : P.degree < N) :
    polyOf (fun i : Fin N => P.coeff i) = P := by
  have h := (Polynomial.degreeLTEquiv K N).symm_apply_apply
    (⟨P, Polynomial.mem_degreeLT.mpr hP⟩ : Polynomial.degreeLT K N)
  exact congrArg Subtype.val h
noncomputable def generators (N : Nat) (Q : K[X]) : Fin N → Fin (2*N) → K :=
  fun j i => (Q * X^(j:Nat)).coeff i
def target (N : Nat) (P : K[X]) : Fin (2*N) → K := fun i => P.coeff i
theorem synthesis_product {N : Nat} (Q : K[X]) (a : Fin N → K) :
    ∑ j, a j • generators N Q j = target N (Q * polyOf a) := by
  have he : polyOf a = ∑ j : Fin N, monomial (j:Nat) (a j) := rfl
  ext i
  simp only [generators,target,Pi.smul_apply,smul_eq_mul,Finset.sum_apply,
    he,Finset.mul_sum,finsetSum_coeff,← C_mul_X_pow_eq_monomial]
  simp only [← mul_assoc, mul_comm Q, mul_assoc, coeff_C_mul]
theorem target_injective {N : Nat} {P Q : K[X]}
    (hP : P.degree < (2*N : Nat)) (hQ : Q.degree < (2*N : Nat))
    (h : target N P = target N Q) : P=Q := by
  ext i
  by_cases hi : i < 2*N
  · exact congrFun h ⟨i,hi⟩
  · have hi' : ((2*N : Nat) : WithBot Nat) ≤ i := by exact_mod_cast (Nat.le_of_not_gt hi)
    rw [coeff_eq_zero_of_degree_lt (hP.trans_le hi'),
      coeff_eq_zero_of_degree_lt (hQ.trans_le hi')]
theorem product_degree {N : Nat} {P Q : K[X]}
    (hP : P.degree < N) (hQ : Q.degree < N) : (P*Q).degree < (2*N : Nat) := by
  by_cases hp : P=0
  · subst P
    simpa only [zero_mul] using
      (Polynomial.mem_degreeLT.mp ((Polynomial.degreeLT K (2*N)).zero_mem))
  by_cases hq : Q=0
  · subst Q
    simpa only [mul_zero] using
      (Polynomial.mem_degreeLT.mp ((Polynomial.degreeLT K (2*N)).zero_mem))
  have hp' : P.natDegree<N := (natDegree_lt_iff_degree_lt hp).mpr hP
  have hq' : Q.natDegree<N := (natDegree_lt_iff_degree_lt hq).mpr hQ
  exact (natDegree_lt_iff_degree_lt (mul_ne_zero hp hq)).mp
    (lt_of_le_of_lt natDegree_mul_le (by omega))
theorem target_mem_span {N : Nat} {P Q : K[X]} (hQ : Q≠0)
    (hdiv : Q∣P) (hP : P.degree<N) :
    target N P ∈ Submodule.span K (Set.range (generators N Q)) := by
  have hd : (P/Q).degree<N := (degree_div_le P Q).trans_lt hP
  have he := synthesis_product Q (fun j : Fin N => (P/Q).coeff j)
  rw [polyOf_coefficients _ hd, EuclideanDomain.mul_div_cancel' hQ hdiv] at he
  rw [← he]
  exact Submodule.sum_mem _ fun j _ =>
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨j,rfl⟩)
theorem coordinates_exact_quotient {N : Nat} {P Q : K[X]} (hQ : Q≠0)
    (hdiv : Q∣P) (hP : P.degree<N) (hqd : Q.degree<N) :
    ∀ j : Fin N, read (coordinates (generators N Q) (target N P)) j = (P/Q).coeff j := by
  let a := read (coordinates (generators N Q) (target N P))
  have hs := coordinates_solution (generators N Q) (target N P)
    (target_mem_span hQ hdiv hP)
  have he : target N (Q*polyOf a) = target N P :=
    (synthesis_product Q a).symm.trans hs
  have hn : (N : WithBot Nat) ≤ ((2*N : Nat) : WithBot Nat) := by exact_mod_cast (show N≤2*N by omega)
  have hm : Q*polyOf a=P := target_injective
    (product_degree hqd (polyOf_degree a)) (hP.trans_le hn) he
  have ha : polyOf a=P/Q := (mul_left_cancel₀ hQ)
    (hm.trans (EuclideanDomain.mul_div_cancel' hQ hdiv).symm)
  intro j
  change a j=(P/Q).coeff j
  rw [← polyOf_coeff a j,ha]
end Mathproof.Problem18PolynomialExactQuotient20261002
