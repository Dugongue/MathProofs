    (hx : x+c  ≤  S) (ho : o+ps.length*(boundedExponents n d).length  ≤  S)
    (ht : t+D  ≤  S) (hxB : x<B) (hoB : o<B) (htB : t<B)
    (hxt : ∀i<c,∀j<D,x+i ≠ t+j)
    (hxo : ∀i<c,∀j<ps.length*(boundedExponents n d).length,x+i ≠ o+j)
