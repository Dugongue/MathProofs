namespace Mathproof.Problem18IMPBoundaryInitialization20261002
open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Problem18AllFormatRoot20260930 Problem18IMPFieldLayout20261001
open Problem18ClaudeIMPSlots20261001 Problem18ClaudeIMPAxpy20261001
open Problem18ClaudeIMPBankLoad20261001 Problem18IMPBoundaryBasisVector20261002
open Problem18IMPBoundarySizeExpressions20261002 Problem18IMPBoundaryInstall20261002
open Problem18IMPBoundaryPhaseState20261002 Problem18IMPBoundaryPhaseMetadata20261002
open Problem18IMPBoundaryCyclicLayout20261002
def q : RNames := {Problem18IMPBoundaryDependence20261001.gauss with WS:=workspaceName}
def entries : Bool→List Entry
  | false=>[(L.bank,S.first),(L.Lr,S.capacity),
      (Problem18IMPBoundaryBasisVector20261002.indexReg,.add (.mul .dim .dim) .dim)]
  | true=>[(L.bank,S.candidate),(L.Lr,.dim)]
def allEntries := entries false++entries true
def boundExpression := allEntries.foldr (fun p s=>SizeExpr.add p.2 s) (.lit 0)
def setup (b : Bool) : Com := Problem18IMPBoundaryInstall20261002.program dimName canonical.e (entries b)
def state (b : Bool) (n e : Nat) (σ : Env) := configured (entries b) n e σ
def protectedNames := [workspaceName,dimName,indexName,canonical.e,canonical.p,canonical.modBase]
noncomputable def program : Com := .seq (setup false)
  (.seq (Problem18IMPBoundaryBasisVector20261002.program q)
    (.seq (setup true) (fillCom canonical q L)))
def setupCost (b : Bool) := Problem18IMPAssignments20261002.cost (commands dimName canonical.e (entries b))
def cost (e n : Nat) := setupCost false+
  (Problem18IMPBoundaryBasisVector20261002.cost e (capacity n)+(setupCost true+fillCost e n))
variable {K : Type} [Field K] [Fintype K] (F : FieldPresentation K)
theorem setup_run (b : Bool) {B n : Nat} {σ : Env}
    (hs : Slots F canonical workspaceName (slots n) B σ) (hn : σ.vars dimName=n)
    (hb : majorant boundExpression n F.e<B) :
    Run B (setup b) σ (state b n F.e σ) (setupCost b) ∧
      Slots F canonical workspaceName (slots n) B (state b n F.e σ) ∧
      (∀s,val F canonical workspaceName (state b n F.e σ) s=val F canonical workspaceName σ s) ∧
      (∀x∈protectedNames,(state b n F.e σ).vars x=σ.vars x) ∧
      (state b n F.e σ).inp=σ.inp ∧ (state b n F.e σ).out=σ.out := by
  have hword:∀p∈entries b,majorant p.2 n F.e<B:=by
    intro p hp
    apply (entry_majorant_le allEntries n F.e p ?_).trans_lt hb
    cases b
    · exact List.mem_append_left _ hp
    · exact List.mem_append_right _ hp
  obtain ⟨hr,hvars,ha,hi,ho⟩:=install_run dimName canonical.e (entries b) hn hs.base.degree
    (by cases b <;> decide) hword
  refine ⟨hr,configured_slots F _ _ _ hs (by cases b <;> decide),?_,?_,hi,ho⟩
  · intro s
    exact configured_val F _ _ _ σ s (by cases b <;> decide)
  · intro x hx
    apply configured_vars
    cases b <;> simp only [protectedNames,List.mem_cons,List.not_mem_nil,or_false] at hx <;>
      rcases hx with rfl|rfl|rfl|rfl|rfl|rfl <;> decide
theorem polynomial_values (n e : Nat) (σ : Env) :
    (state false n e σ).vars L.bank=first n ∧
    (state false n e σ).vars L.Lr=capacity n ∧
    (state false n e σ).vars Problem18IMPBoundaryBasisVector20261002.indexReg=n*n+n := by
  exact ⟨rfl,rfl,rfl⟩
theorem vector_values (n e : Nat) (σ : Env) :
    (state true n e σ).vars L.bank=candidate n ∧ (state true n e σ).vars L.Lr=n := by
  exact ⟨rfl,rfl⟩
theorem initialize_run {B n : Nat} {σ : Env}
    (hs : Slots F canonical workspaceName (slots n) B σ)
    (hw : σ.vars workspaceName=F.e+1) (hn : σ.vars dimName=n)
    (hb : majorant boundExpression n F.e<B) :
    ∃τ,Run B program σ τ (cost F.e n) ∧
      Slots F canonical workspaceName (slots n) B τ ∧
      (∀i<capacity n,val F canonical workspaceName τ (first n+i)=
        (1:Polynomial K).coeff (capacity n-1-i)) ∧
      (∀i<n,val F canonical workspaceName τ (candidate n+i)=0) ∧
      (∀s<slots n,(s<first n ∨ first n+capacity n ≤ s) →
        (s<candidate n ∨ candidate n+n ≤ s) →
        val F canonical workspaceName τ s=val F canonical workspaceName σ s) ∧
      τ.vars workspaceName=F.e+1 ∧ τ.vars dimName=n ∧ τ.vars indexName=σ.vars indexName ∧
      (∀x∈protectedNames,τ.vars x=σ.vars x) ∧ τ.inp=σ.inp ∧ τ.out=σ.out := by
  let ξ:=state false n F.e σ
  obtain ⟨hsetup,hξ,hvξ,hvarsξ,hiξ,hoξ⟩:=setup_run F false hs hn hb
  obtain ⟨hp,hlen,hindex⟩:=polynomial_values n F.e σ
  have hlast:n*n+n<capacity n:=by unfold capacity;omega
  have hpolyfit:first n+capacity n ≤ slots n:=by
    simp only [slots,orbitWork,orbit,productWork,product,temp,action,matrix,seed,candidate,divisor,factor]
    omega
  have hvecfit:candidate n+n ≤ slots n:=by
    simp only [slots,orbitWork,orbit,productWork,product,temp,action,matrix,seed]
    omega
