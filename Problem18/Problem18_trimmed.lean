theorem symmetric_ones_cyclic (M : Matrix (Fin b) (Fin b) K)
    (hm : M.IsSymm) (hs : Squarefree M.charpoly) :
    PolynomiallyCyclic M.toLin' (fun _ => 1) := by
  have hself : Mathproof.Meta.Problem18SpectralBlocks20260930.IsSelfAdjointFor
      (standardForm b) M.toLin' := by
    intro x y
    simp only [standardForm,Matrix.toBilin'_apply',Matrix.one_mulVec]
    change (M*ᵥx) ⬝ᵥ y=x ⬝ᵥ (M*ᵥy)
    have hh := Matrix.dotProduct_transpose_mulVec M y x
    rw [hm] at hh
    exact (dotProduct_comm _ _).trans hh
  have he : Problem18CharTwoMarkedWitt20260929.canonicalVector (standardForm (K:=K) b)
      (standardForm_nondegenerate b) (standardForm_symm b)=(fun _ => 1) := by
    have ht : (2:K)=0 := CharP.cast_eq_zero K 2
    have hh := standardMarker_eq_one (K:=K) b
    simpa only [standardMarker,Problem18FiniteSymmetricRecovery20260929.recoveryMarker,dif_pos ht] using hh
  rw [← he]
  apply canonicalMarker_polynomiallyCyclic M.toLin' (standardForm b)
    (standardForm_symm b) (standardForm_nondegenerate b) hself
  simpa only [Matrix.charpoly_toLin'] using hs
def boundaryCandidate (F G : Matrix (Fin c) (Fin b) K) : Matrix (Fin b) (Fin b) K :=
  krylovMatrix (F.transpose*F).toLin' (fun _ => 1)*
    (krylovMatrix (G.transpose*G).toLin' (fun _ => 1))⁻¹
theorem charTwo_boundary_iff_candidate_checks (F G : Matrix (Fin c) (Fin b) K)
    (hF : OrthogonalGood F) :
    MatrixOrthogonalEquivalent F G ↔
      (krylovMatrix (G.transpose*G).toLin' (fun _ => 1)).det≠0 ∧
      IsOrthogonal (boundaryCandidate F G) ∧
      LinearMap.ker (Problem18MarkedRecovery20260929.augment (F*boundaryCandidate F G).toLin'
        (standardMarker c))=
      LinearMap.ker (Problem18MarkedRecovery20260929.augment G.toLin' (standardMarker c)) ∧
      (boundaryCandidate F G).transpose*(F.transpose*F)*boundaryCandidate F G=G.transpose*G := by
  constructor
  · intro h
    have hG := (orthogonal_good_invariant F G h).mp hF
    have hcyc : PolynomiallyCyclic (G.transpose*G).toLin' (fun _ => 1) :=
      symmetric_ones_cyclic _ (by simp [Matrix.IsSymm,Matrix.transpose_mul]) hG.2
    obtain ⟨Q,hQ,hker,hgram⟩ := (orthogonal_boundary_recovery F G).mp h
    let T := orthogonalEquiv Q hQ
    have hcomm : Q*(G.transpose*G)=(F.transpose*F)*Q := by
      rw [← hgram,← Matrix.mul_assoc,← Matrix.mul_assoc,
        show Q*Q.transpose=1 from mul_eq_one_comm.mp hQ,Matrix.one_mul]
    have hT : ∀ x,T ((G.transpose*G).toLin' x)=(F.transpose*F).toLin' (T x) := by
      intro x
      change Q*ᵥ((G.transpose*G)*ᵥx)=(F.transpose*F)*ᵥ(Q*ᵥx)
      rw [Matrix.mulVec_mulVec,Matrix.mulVec_mulVec,hcomm]
    have hTv : T (fun _ => 1)=fun _ => 1 :=
      orthogonal_fixes_one ⟨Q,Matrix.mem_unitaryGroup_iff'.mpr hQ⟩
    have he := intertwiner_eq_krylov_candidate (G.transpose*G).toLin' (F.transpose*F).toLin'
      (fun _ => 1) (fun _ => 1) hcyc T hT hTv
    have heq : Q=boundaryCandidate F G := by
      simpa only [T,orthogonalEquiv,LinearMap.toMatrix'_toLin',boundaryCandidate] using he
    rw [← heq]
    exact ⟨(isUnit_iff_ne_zero.mp (krylovMatrix_isUnit_det _ _ hcyc)),hQ,hker,hgram⟩
  · rintro ⟨_,hQ,hker,hgram⟩
    exact (orthogonal_boundary_recovery F G).mpr ⟨boundaryCandidate F G,hQ,hker,hgram⟩
end Mathproof.Problem18CharTwoBoundaryDecision20260930
