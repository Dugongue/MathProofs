namespace Mathproof.Problem18OddFormDeterminantIsometry20260930
open scoped BigOperators
open Mathproof.Problem18DiagonalFormOrder20260930
open Mathproof.Problem18OddDiagonalNormalization20260930
open Mathproof.Problem18OddFormCoordinates20260930
variable {K V W : Type*} [Field K] [Fintype K]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  [AddCommGroup W] [Module K W] [FiniteDimensional K W]
theorem gram_determinant_congruence {n : ℕ}
    (C : LinearMap.BilinForm K V) (B : LinearMap.BilinForm K W)
    (bC : Module.Basis (Fin n) K V) (bB : Module.Basis (Fin n) K W)
    (e : V ≃ₗ[K] W) (he : ∀ x y,B (e x) (e y)=C x y) :
    (C.toMatrix bC).det=(LinearMap.toMatrix bC bB e.toLinearMap).det^2*(B.toMatrix bB).det := by
  have hf : B.comp e.toLinearMap e.toLinearMap=C := by ext x y; exact he x y
  have hm := LinearMap.BilinForm.toMatrix_comp bB bC B e.toLinearMap e.toLinearMap
  rw [hf] at hm
  have hd := congrArg Matrix.det hm
  rw [Matrix.det_mul,Matrix.det_mul,Matrix.det_transpose] at hd
  rw [hd]
  ring
theorem isSquare_determinant_ratio_of_isometry {n : ℕ}
    (C : LinearMap.BilinForm K V) (B : LinearMap.BilinForm K W)
    (bC : Module.Basis (Fin n) K V) (bB : Module.Basis (Fin n) K W)
    (hB : B.Nondegenerate) (e : V ≃ₗ[K] W)
    (he : ∀ x y,B (e x) (e y)=C x y) :
    IsSquare ((C.toMatrix bC).det/(B.toMatrix bB).det) := by
  have hb := (LinearMap.BilinForm.nondegenerate_iff_det_ne_zero bB).mp hB
  rw [gram_determinant_congruence C B bC bB e he,mul_div_cancel_right₀ _ hb]
  exact IsSquare.sq _
@[simp] theorem diagonal_gram_det {n : ℕ} (a : Fin n→K) :
    ((diagonalForm a).toMatrix (Pi.basisFun K (Fin n))).det=∏ i,a i := by
  rw [LinearMap.BilinForm.toMatrix_basisFun,diagonalForm,
    LinearMap.BilinForm.toMatrix'_toBilin',Matrix.det_diagonal]
theorem diagonal_isometry_of_square_ratio (hodd : ringChar K≠2) (n : ℕ)
    (a b : Fin (n+1)→K) (ha : ∀ i,a i≠0) (hb : ∀ i,b i≠0)
    (hsq : IsSquare ((∏ i,a i)/(∏ i,b i))) :
    ∃ e : (Fin (n+1)→K) ≃ₗ[K] (Fin (n+1)→K),∀ x y,
      diagonalForm b (e x) (e y)=diagonalForm a x y := by
  classical
  obtain ⟨A,hA⟩ := exists_diagonal_normalization hodd n a ha
  obtain ⟨B,hB⟩ := exists_diagonal_normalization hodd n b hb
  obtain ⟨s,hs⟩ := hsq.exists_sq
  have hpa : (∏ i,a i)≠0 := Finset.prod_ne_zero_iff.mpr (fun i _ => ha i)
  have hpb : (∏ i,b i)≠0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hb i)
  have hs0 : s≠0 := by
    intro hh
    apply div_ne_zero hpa hpb
    simpa only [hh,zero_pow (by decide : 2≠0)] using hs
  have hprod : (∏ i,b i)*s^2=∏ i,a i := by
    have hh := (eq_div_iff hpb).mp hs.symm
    simpa only [mul_comm] using hh
  let D : (Fin (n+1)→K) ≃ₗ[K] (Fin (n+1)→K) :=
    LinearEquiv.piCongrRight (fun i => Fin.cases
      (Mathproof.Problem18PrimaryIntertwinerBoundary20260930.scalarEquiv (K:=K) s hs0)
      (fun _ => LinearEquiv.refl K K) i)
  have hD (x y : Fin (n+1)→K) :
      diagonalForm (normalCoeffs n (∏ i,b i)) (D x) (D y)=
        diagonalForm (normalCoeffs n (∏ i,a i)) x y := by
    rw [diagonalForm_apply,diagonalForm_apply]
    apply Finset.sum_congr rfl
    intro i _
    cases i using Fin.cases
    · change (∏ i,b i)*(s*x 0)*(s*y 0)=(∏ i,a i)*x 0*y 0
      rw [← hprod]
      ring
    · rfl
  let e := A.symm.trans (D.trans B)
  refine ⟨e,?_⟩
  intro x y
  obtain ⟨x,rfl⟩ := A.surjective x
  obtain ⟨y,rfl⟩ := A.surjective y
  simp only [e, LinearEquiv.trans_apply, LinearEquiv.symm_apply_apply]
  change diagonalForm b (B (D x)) (B (D y))=diagonalForm a (A x) (A y)
  rw [hB,hA,hD]
theorem isometry_iff_square_determinant_ratio (hodd : ringChar K≠2) {n : ℕ}
    (C : LinearMap.BilinForm K V) (B : LinearMap.BilinForm K W)
    (bC : Module.Basis (Fin n) K V) (bB : Module.Basis (Fin n) K W)
    (hsC : C.IsSymm) (hsB : B.IsSymm) (hnC : C.Nondegenerate) (hnB : B.Nondegenerate) :
    (∃ e : V ≃ₗ[K] W,∀ x y,B (e x) (e y)=C x y) ↔
      IsSquare ((C.toMatrix bC).det/(B.toMatrix bB).det) := by
  constructor
  · rintro ⟨e,he⟩
    exact isSquare_determinant_ratio_of_isometry C B bC bB hnB e he
  · intro hsq
    have hdV : Module.finrank K V=n := by
      simpa using Module.finrank_eq_card_basis bC
    have hdW : Module.finrank K W=n := by
      simpa using Module.finrank_eq_card_basis bB
    cases n with
    | zero =>
      letI : Subsingleton V := Module.finrank_zero_iff.mp hdV
      letI : Subsingleton W := Module.finrank_zero_iff.mp hdW
      exact ⟨LinearEquiv.ofSubsingleton V W,by intro x y; have hx : x=0 := Subsingleton.elim _ _; simp [hx]⟩
    | succ n =>
      have hC := exists_diagonal_coordinates C hsC hnC (Ring.two_ne_zero hodd)
      have hB := exists_diagonal_coordinates B hsB hnB (Ring.two_ne_zero hodd)
      rw [hdV] at hC
      rw [hdW] at hB
      obtain ⟨a,A,ha,hA⟩ := hC
      obtain ⟨b,B',hb,hB'⟩ := hB
      have hsa := isSquare_determinant_ratio_of_isometry (diagonalForm a) C
        (Pi.basisFun K (Fin (n+1))) bC hnC A hA
      have hsb := isSquare_determinant_ratio_of_isometry (diagonalForm b) B
        (Pi.basisFun K (Fin (n+1))) bB hnB B' hB'
      rw [diagonal_gram_det] at hsa hsb
      have hcb := (LinearMap.BilinForm.nondegenerate_iff_det_ne_zero bC).mp hnC
      have hbb := (LinearMap.BilinForm.nondegenerate_iff_det_ne_zero bB).mp hnB
      have hpb : (∏ i,b i)≠0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hb i)
      have hsab : IsSquare ((∏ i,a i)/(∏ i,b i)) := by
        have hh := (hsa.mul hsq).div hsb
        have he : (((∏ i,a i)/(C.toMatrix bC).det)*
            ((C.toMatrix bC).det/(B.toMatrix bB).det))/
            ((∏ i,b i)/(B.toMatrix bB).det)=(∏ i,a i)/(∏ i,b i) := by
          field_simp
        rw [he] at hh
        exact hh
      obtain ⟨D,hD⟩ := diagonal_isometry_of_square_ratio hodd n a b ha hb hsab
      refine ⟨A.symm.trans (D.trans B'),?_⟩
      intro x y
      obtain ⟨x,rfl⟩ := A.surjective x
      obtain ⟨y,rfl⟩ := A.surjective y
      simp only [LinearEquiv.trans_apply, LinearEquiv.symm_apply_apply]
      change B (B' (D x)) (B' (D y))=C (A x) (A y)
      rw [hB',hA,hD]
end Mathproof.Problem18OddFormDeterminantIsometry20260930
end
