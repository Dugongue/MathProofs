namespace Mathproof.Problem18ExecutableAlgebra20261001
open scoped BigOperators Matrix
open Matrix FiniteFieldOrthogonalUnitaryTI
open Problem18MatrixSpanCheck20261001
variable {K : Type*} [Field K] [DecidableEq K] {n m : ℕ}
def selectWordsExec (S : Fin m → Matrix (Fin n) (Fin n) K)
    (chosen candidates : List (List (Fin m))) : List (List (Fin m)) :=
  candidates.foldl (fun ws w=>
    if (matrixSpanCheck (ws.map (matrixWord S)) (matrixWord S w)).1 then ws else w::ws) chosen
theorem checkedWordSpan (S : Fin m → Matrix (Fin n) (Fin n) K)
    (ws : List (List (Fin m))) (M : Matrix (Fin n) (Fin n) K) :
    (matrixSpanCheck (ws.map (matrixWord S)) M).1=true ↔ M∈selectedWordSpan S ws := by
  rw [matrixSpanCheck_correct,selectedWordSpan]
  have he : {A | A ∈ ws.map (matrixWord S)}=matrixWord S '' {w | w∈ws} := by
    ext X
    simp only [Set.mem_setOf_eq,List.mem_map,Set.mem_image]
  rw [he]
theorem selectWordsExec_eq (S : Fin m → Matrix (Fin n) (Fin n) K)
    (chosen candidates : List (List (Fin m))) :
    selectWordsExec S chosen candidates=selectWords S chosen candidates := by
  classical
  unfold selectWordsExec selectWords
  apply congrArg (fun f=>candidates.foldl f chosen)
  funext ws w
  by_cases h : matrixWord S w∈selectedWordSpan S ws
  · have hh := (checkedWordSpan S ws (matrixWord S w)).mpr h
    simp only [hh,if_pos h,ite_true]
  · have hh : (matrixSpanCheck (ws.map (matrixWord S)) (matrixWord S w)).1=false := by
      cases he : (matrixSpanCheck (ws.map (matrixWord S)) (matrixWord S w)).1
      · rfl
      · exact False.elim (h ((checkedWordSpan S ws _).mp he))
    simp only [hh,if_neg h,Bool.false_eq_true,ite_false]
def wordSearch (S : Fin m → Matrix (Fin n) (Fin n) K) : ℕ → List (List (Fin m))
  | 0 => selectWordsExec S [] [[]]
  | k+1 => selectWordsExec S (wordSearch S k) (generatorWordCandidates (wordSearch S k))
theorem wordSearch_eq (S : Fin m → Matrix (Fin n) (Fin n) K) (k : ℕ) :
    wordSearch S k=wordBasisSearch S k := by
  induction k with
  | zero => exact selectWordsExec_eq S [] [[]]
  | succ k ih => simp only [wordSearch,selectWordsExec_eq,ih,wordBasisSearch]
def generationCheck (S : Fin m → Matrix (Fin n) (Fin n) K) : Bool :=
  let ms:=(wordSearch S (n^2+1)).map (matrixWord S)
  (List.finRange n).all fun i=>(List.finRange n).all fun j=>
    (matrixSpanCheck ms (Matrix.single i j 1)).1
theorem generationCheck_correct (S : Fin m → Matrix (Fin n) (Fin n) K) :
    generationCheck S=true ↔ Algebra.adjoin K (Set.range S)=⊤ := by
  have ht : generationCheck S=true ↔ ∀ i j : Fin n,
      Matrix.single i j 1∈selectedWordSpan S (wordSearch S (n^2+1)) := by
    simp only [generationCheck,List.all_eq_true,List.mem_finRange,forall_true_left,
      checkedWordSpan]
  rw [ht,wordSearch_eq]
  constructor
  · intro h
    have hs : selectedWordSpan S (wordBasisSearch S (n^2+1))=⊤ := by
      apply Submodule.eq_top_iff'.mpr
      intro M
      rw [Matrix.matrix_eq_sum_single M]
      apply Submodule.sum_mem
      intro i _
      apply Submodule.sum_mem
      intro j _
      have hh := (selectedWordSpan S (wordBasisSearch S (n^2+1))).smul_mem (M i j) (h i j)
      simpa only [Matrix.smul_single,smul_eq_mul,mul_one] using hh
    have hh := algebraWordSpace_le_adjoin (K := K) S (n^2+1)
    rw [←wordBasisSearch_span,hs] at hh
    apply top_unique
    intro M _
    exact hh (Submodule.mem_top)
  · intro h i j
    have hs := wordBasisSearch_full S h
    simp only [Fintype.card_fin] at hs
    rw [hs]
    exact Submodule.mem_top
