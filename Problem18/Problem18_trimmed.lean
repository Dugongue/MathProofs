theorem rowData_of_lt (n d : ℕ) (rows : List (DenseInput n d K)) (r : Fin (boxSize n d))
    (hr : r.val < (compress rows).1.length) :
    rowData n d rows r = Problem18ArrayElimination20260929.read ((compress rows).1[r.val]) := by
  funext j
  simp only [rowData, List.getD_eq_getElem?_getD, List.getElem?_eq_getElem hr, Option.getD_some]
theorem rowData_of_ge (n d : ℕ) (rows : List (DenseInput n d K)) (r : Fin (boxSize n d))
    (hr : ¬ r.val < (compress rows).1.length) : rowData n d rows r = 0 := by
  funext j
  simp only [rowData, List.getD_eq_getElem?_getD, List.getElem?_eq_none (Nat.le_of_not_lt hr),
    Option.getD_none]
  simp [Problem18ArrayElimination20260929.read]
theorem boxPoly_zero (n d : ℕ) : boxPoly n d (0 : Fin (boxSize n d) → K) = 0 := by
  simp [boxPoly]
theorem rowData_span (n d : ℕ) (rows : List (DenseInput n d K)) :
    Ideal.span (Set.range fun r => boxPoly n d (rowData n d rows r)) =
      Ideal.span (boxPoly n d '' {w | w ∈ (compress rows).1.map Problem18ArrayElimination20260929.read}) := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨r, rfl⟩
    show boxPoly n d (rowData n d rows r) ∈ _
    by_cases hr : r.val < (compress rows).1.length
    · apply Ideal.subset_span
      refine ⟨Problem18ArrayElimination20260929.read ((compress rows).1[r.val]),
        List.mem_map_of_mem (List.getElem_mem hr), ?_⟩
      rw [rowData_of_lt n d rows r hr]
    · rw [rowData_of_ge n d rows r hr, boxPoly_zero]
      exact Ideal.zero_mem _
  · rw [Ideal.span_le]
    rintro _ ⟨w, hw, rfl⟩
    obtain ⟨v, hv, rfl⟩ := List.mem_map.mp hw
    obtain ⟨i, hi, rfl⟩ := List.getElem_of_mem hv
    have hlen : (compress rows).1.length ≤ boxSize n d := compress_length rows
    apply Ideal.subset_span
    refine ⟨⟨i, by omega⟩, ?_⟩
    show boxPoly n d (rowData n d rows ⟨i, _⟩) = _
    rw [rowData_of_lt n d rows ⟨i, by omega⟩ hi]
theorem rowData_ideal (n d : ℕ) (rows : List (DenseInput n d K)) (fs : List (MvPolynomial (Fin n) K))
    (h : List.Forall₂ (ValidDenseInput d) rows fs) :
    Ideal.span {f | f ∈ fs} = Ideal.span (Set.range fun r => boxPoly n d (rowData n d rows r)) := by
  rw [rowData_span]
  have hfs : {f | f ∈ fs} = boxPoly n d '' {w | w ∈ rows.map Problem18ArrayElimination20260929.read} := by
    ext f
    simp only [Set.mem_setOf_eq, forall2_mem h, Set.mem_image, List.mem_map]
    constructor
    · rintro ⟨v, hv, rfl⟩
      exact ⟨Problem18ArrayElimination20260929.read v, ⟨v, hv, rfl⟩, rfl⟩
    · rintro ⟨_, ⟨v, hv, rfl⟩, rfl⟩
      exact ⟨v, hv, rfl⟩
  rw [hfs, ← span_boxPoly_span]
  conv_rhs => rw [← span_boxPoly_span]
  have hs := compress_span rows
