    exact ⟨⟨k, S⟩, mem_patterns S hk, (patternRun_correct (L := L) n d ⟨k, S⟩ _).mpr ⟨U, hU⟩⟩
def clauseConst {c0 m : ℕ} (c : Clause (Fin (c0 + m)) ℤ) : ℕ :=
  ((sysExprs c).map fun p => templateCost p (clauseDeg c)).sum +
    decisionConstant (m + 1) (clauseDeg c) (sysExprs c).length
def patternConst (n d : ℕ) (pat : Σ k : ℕ, Fin k → Fin (boxSize n (cpE n d))) : ℕ :=
  ((clauses (qe (template n d pat))).map clauseConst).sum
def fixedConst (n d : ℕ) : ℕ := ((patterns (boxSize n (cpE n d))).map (patternConst n d)).sum
def fixedBudget (n d r : ℕ) : ℕ := r * testBudget (boxSize n d) + fixedConst n d
theorem fixedBudget_mono (n d r r' : ℕ) (h : r ≤ r') : fixedBudget n d r ≤ fixedBudget n d r' :=
  Nat.add_le_add_right (Nat.mul_le_mul_right _ h) _
theorem clauseRun_cost_le {c0 m : ℕ} (c : Clause (Fin (c0 + m)) ℤ) (a : Fin c0 → K) :
    (clauseRun c a).2 ≤ clauseConst c * (Nat.size (Fintype.card K) + 1) := by
  refine (clauseRun_cost c a).trans ?_
  rw [clauseConst, Nat.add_mul]
  exact Nat.add_le_add_right (Nat.le_mul_of_pos_right _ (Nat.succ_pos _)) _
theorem patternRun_cost (n d : ℕ) (pat : Σ k : ℕ, Fin k → Fin (boxSize n (cpE n d)))
    (a : Fin (boxSize n d * boxSize n d) → K) :
    (patternRun n d pat a).2 ≤ patternConst n d pat * (Nat.size (Fintype.card K) + 1) := by
  show (((clauses (qe (template n d pat))).map fun c => clauseRun c a).map (·.2)).sum ≤ _
  rw [patternConst, ← List.sum_map_mul_right, List.map_map]
  exact List.sum_le_sum fun c _ => clauseRun_cost_le c a
theorem fixedTest_cost (n d : ℕ) (rows : List (DenseInput n d K)) :
    (fixedTest n d rows).2 ≤ fixedBudget n d rows.length * (Nat.size (Fintype.card K) + 1) := by
  show (compress rows).2 + (((patterns (boxSize n (cpE n d))).map fun pat =>
      patternRun n d pat (flatData (rowData n d rows))).map (·.2)).sum ≤ _
  rw [fixedBudget, Nat.add_mul]
  refine Nat.add_le_add ?_ ?_
  · refine (compress_cost rows).trans ?_
    exact Nat.le_mul_of_pos_right _ (Nat.succ_pos _)
  · rw [fixedConst, ← List.sum_map_mul_right, List.map_map]
