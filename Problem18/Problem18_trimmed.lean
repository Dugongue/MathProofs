  let V : Env → Nat := fun ρ => N - ρ.vars fj
  have hdef : ∀ ρ, I ρ → ∃ v, (Cond.lt (.var fj) (.var fcnt)).evalB B ρ = some v := by
    intro ρ h
    exact evalB_condLt_vars (by have := h.1; omega) (by rw [h.2.1]; exact hNB)
