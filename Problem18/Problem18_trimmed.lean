  let J := complementMetric W g
  have hJ : J.IsHermitian := complement_hermitian W g
  have hnJ : J.det≠0 := complement_det_ne_zero W hcomp g
  have hGram : (E W hcomp f g)ᴴ*E W hcomp f g=
      fromBlocks (sourceMetric (m:=m) (1 : Matrix (Fin r) (Fin r) K)) 0 0 J :=
    full_adapted_gram W hcomp g f _ hf
  have hbound := hermitian_coordinate_bound hcard hstar hc ha hb hd (Nat.sub_le_sub_right hbc _)
    (1 : Matrix (Fin r) (Fin r) K) (by simp) (by simp) J hJ hnJ
    (E W hcomp f g) (U W hcomp f g) (inverse_left W hcomp f g) (inverse_right W hcomp f g)
    hGram (sourceMetric_isUnit _ (by simp)) hr hrb
  apply le_trans _ hbound
  apply probability_mono
  intro A hA
  rcases hA.1 with ⟨p,hm,hp,hdvd,hcop,hfix,hχfix,hW⟩
  exact ⟨primary_event_coordinates W hcomp f g hnW A p hm hp hdvd hcop hfix hχfix hW,hA.2⟩
end
