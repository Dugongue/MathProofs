  have hπval : v (π : k⟮X⟯) = WithZero.exp (-1 : ℤ) := by
    exact RatFunc.inftyValuation.X_inv k
  have hπ : v.IsUniformizer (π : k⟮X⟯) := by
    rw [Valuation.IsUniformizer.iff, hgen]
