theorem unifiedCleanLookupProgram_preservesDispatch
    {N : Nat} {R : Type} (returnLabel : R)
    (right : R → TM2.Stmt (fun _ : CoreStack => SparseSymbol) R
      (FullInterpreterState N)) (hright : ProgramPreservesDispatch right) :
