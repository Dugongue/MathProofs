        _ ≤ stStart N c := by unfold stStart; nlinarith
        _ ≤ inStart N c := by unfold stStart inStart rowStart; nlinarith
    rw [hframe1 _ (lt_of_lt_of_le hsc hfitNc)
      (Or.inr (by unfold stStart rowStart; omega)), ← hv0]
  obtain ⟨σ2,hr2,hS2,hrows2,hframe2,hN2,hcc2,hvars2,harr2,hi2,ho2⟩ :=
