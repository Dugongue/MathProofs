section SearchRounds
variable {i : Type*} [Fintype i] [DecidableEq i] {m : ℕ}
def generatorWordCandidates (ws : List (List (Fin m))) : List (List (Fin m)) :=
  ws.flatMap (fun w => List.ofFn (fun a : Fin m => a :: w))
theorem generatorWordCandidates_span (S : Fin m → Matrix i i K) (ws : List (List (Fin m))) :
    selectedWordSpan S (generatorWordCandidates ws) =
      ⨆ a, (selectedWordSpan S ws).map (LinearMap.mulLeft K (S a)) := by
  have he : matrixWord S '' {w | w ∈ generatorWordCandidates ws} =
      ⋃ a : Fin m, (LinearMap.mulLeft K (S a)) '' (matrixWord S '' {w | w ∈ ws}) := by
    ext X
    simp only [generatorWordCandidates, Set.mem_image, Set.mem_ofPred_eq, List.mem_flatMap,
      List.mem_ofFn, Set.mem_iUnion, LinearMap.mulLeft_apply]
    constructor
    · rintro ⟨w, ⟨v,hv,a,rfl⟩,rfl⟩
      exact ⟨a,matrixWord S v,⟨v,hv,rfl⟩,rfl⟩
    · rintro ⟨a,Y,⟨v,hv,rfl⟩,rfl⟩
      exact ⟨a::v,⟨v,hv,a,rfl⟩,rfl⟩
  unfold selectedWordSpan
  rw [he, Submodule.span_iUnion]
  congr 1
  funext a
  exact (Submodule.map_span _ _).symm
noncomputable def wordBasisSearch (S : Fin m → Matrix i i K) : ℕ → List (List (Fin m))
  | 0 => selectWords S [] [[]]
  | k+1 => selectWords S (wordBasisSearch S k) (generatorWordCandidates (wordBasisSearch S k))
theorem wordBasisSearch_span (S : Fin m → Matrix i i K) (k : ℕ) :
    selectedWordSpan S (wordBasisSearch S k) = algebraWordSpace (K := K) S k := by
  induction k with
  | zero =>
    rw [wordBasisSearch, selectWords_span]
    simp [selectedWordSpan, matrixWord, algebraWordSpace]
  | succ k ih =>
    rw [wordBasisSearch, selectWords_span, generatorWordCandidates_span, ih, algebraWordSpace]
theorem wordBasisSearch_full (S : Fin m → Matrix i i K)
    (hgen : Algebra.adjoin K (Set.range S) = ⊤) :
    selectedWordSpan S (wordBasisSearch S ((Fintype.card i)^2+1)) = ⊤ := by
  rw [wordBasisSearch_span, matrixWordSpace_full S hgen]
end SearchRounds
