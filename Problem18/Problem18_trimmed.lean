theorem exists_pair_coefficient (K : Type*) [Field K] [Fintype K] [Algebra K F]
    [Algebra.IsSeparable F E]
    (hq : (minpoly F α).natDegree * (minpoly F β).natDegree < Fintype.card K) :
    ∃ c : K, F⟮α, β⟯ = F⟮α + algebraMap K F c • β⟯ := by
  classical
  obtain ⟨c, hc⟩ := exists_good_coefficient
    (((algebraMap E (SplittingField ((minpoly F β).map (algebraMap F E)))).comp
      (algebraMap F E)).comp (algebraMap K F))
    (algebraMap E (SplittingField ((minpoly F β).map (algebraMap F E))) α)
    (algebraMap E (SplittingField ((minpoly F β).map (algebraMap F E))) β)
    ((minpoly F α).map ((algebraMap E (SplittingField ((minpoly F β).map (algebraMap F E)))).comp
      (algebraMap F E))).roots
    ((minpoly F β).map ((algebraMap E (SplittingField ((minpoly F β).map (algebraMap F E)))).comp
      (algebraMap F E))).roots
    (minpoly F α).natDegree (minpoly F β).natDegree
    ((card_roots' _).trans natDegree_map_le) ((card_roots' _).trans natDegree_map_le) hq
