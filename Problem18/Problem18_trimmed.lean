    {n : ℕ} (S : Set (MvPolynomial (Fin n) K)) (P : Ideal (MvPolynomial (Fin n) L))
    (hP : (Ideal.span (MvPolynomial.map (algebraMap K L) '' S)).minimalPrimes = {P})
    (i j : Fin n)
    (hind : AlgebraicIndependent L ![Ideal.Quotient.mk P (X i), Ideal.Quotient.mk P (X j)])
    (u u₀ : E) (hu : Transcendental L u)
    (hu₀ : Transcendental (Polynomial.aeval u : Polynomial L →ₐ[L] E).range u₀) :
    ∃ Q : Ideal (MvPolynomial (Fin n) E),
      (Ideal.span (MvPolynomial.map (algebraMap K E) '' S) ⊔
          Ideal.span {(X i + C u * X j - C u₀ : MvPolynomial (Fin n) E)}).minimalPrimes = {Q} ∧
        Ideal.map (MvPolynomial.map (algebraMap L E)) P < Q := by
  classical
  set IL := Ideal.span (MvPolynomial.map (algebraMap K L) '' S) with hIL
  set IE := Ideal.span (MvPolynomial.map (algebraMap K E) '' S) with hIE
  have hradL : IL.radical = P := by
    rw [← Ideal.sInf_minimalPrimes, hP, sInf_singleton]
  haveI hPprime : P.IsPrime := by
    have : P ∈ IL.minimalPrimes := by
      rw [hP]
      exact Set.mem_singleton _
    exact this.1.1
  have huu : AlgebraicIndependent L ![u, u₀] := indep_pair_of_transcendental hu hu₀
  have hprime := radical_section_isPrime P i j hind u u₀ huu
  set ℓ : MvPolynomial (Fin n) E := X i + C u * X j - C u₀ with hℓ
  set PE := Ideal.map (MvPolynomial.map (algebraMap L E)) P with hPE
  set J := IE ⊔ Ideal.span {ℓ} with hJ
  set J' := PE ⊔ Ideal.span {ℓ} with hJ'
  have hIE_eq : IE = Ideal.map (MvPolynomial.map (algebraMap L E)) IL := by
    rw [hIE, hIL, Ideal.map_span, ← Set.image_comp]
    congr 1
    ext q
    simp only [Set.mem_image, Function.comp_apply, MvPolynomial.map_map]
    rw [← IsScalarTower.algebraMap_eq]
  have hILP : IL ≤ P := by
    rw [← hradL]
    exact Ideal.le_radical
  have hIEP : IE ≤ PE := by
    rw [hIE_eq]
    exact Ideal.map_mono hILP
  have hrad : J.radical = J'.radical := by
    apply le_antisymm
    · exact Ideal.radical_mono (sup_le_sup_right hIEP _)
    · rw [Ideal.radical_le_radical_iff]
      refine sup_le ?_ (le_trans le_sup_right Ideal.le_radical)
      obtain ⟨N, hN⟩ := Ideal.exists_pow_le_of_le_radical_of_fg (le_of_eq hradL.symm)
        (IsNoetherian.noetherian P)
      intro f hf
      rw [Ideal.mem_radical_iff]
      have hpow : PE ^ N ≤ J := by
        rw [hPE, ← Ideal.map_pow]
        refine le_trans (Ideal.map_mono hN) ?_
        rw [← hIE_eq]
        exact le_sup_left
      exact ⟨N, hpow (Ideal.pow_mem_pow hf N)⟩
  refine ⟨J.radical, ?_, ?_⟩
  · apply Problem18AlgClosedTensorDomain20261001.minimalPrimes_eq_radical
    rw [hrad]
    exact hprime
  · rw [SetLike.lt_iff_le_and_exists]
    refine ⟨?_, ℓ, Ideal.le_radical (Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton _))),
      fun hmem => ell_not_mem P i j u u₀ huu hmem⟩
    rw [hrad]
    exact le_trans le_sup_left Ideal.le_radical
