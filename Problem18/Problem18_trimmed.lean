theorem mulModBody_congr (q : RNames) (mj xj : String) (C Qe A X1 X2 : Expr) (D : ℕ) :
    mulModBody M₁ q mj xj C Qe A X1 X2 D = mulModBody M₂ q mj xj C Qe A X1 X2 D := by
  simp only [mulModBody, hc.neg, axpyLoop_congr hc, mulXCom_congr hc, copyLoop_congr hc]
