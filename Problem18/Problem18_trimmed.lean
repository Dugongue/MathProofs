    · refine (hr1.seq (Run.assign hinc)).mono ?_
      have e : (plus (Expr.var q.u) (Expr.lit 1)).size = 3 := rfl
      rw [e]; unfold loadStep; omega
    · simp only [vars_setVar, if_true]; omega
    · intro x hx h1 h2
      simp only [vars_setVar, if_neg h1]
