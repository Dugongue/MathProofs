namespace Mathproof.Problem18ClaudeIMPSlots20261001
open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Mathproof.Problem18IMPFieldLayout20261001
open Mathproof.Problem18IMPFieldPresentation20261001
open Mathproof.Problem18AllFormatRoot20260930
open Mathproof.Problem18ClaudeFieldMacros20261001
def regNames (r : FieldNames) : List String := scalarNames r ++ extraNames r
theorem clobbered_reg (r : FieldNames) (x : String) (hx : x ∈ clobbered r) : x ∈ regNames r := by
  rw [mem_clobbered_iff] at hx
  unfold regNames
  rcases hx with hx | hx
  · apply List.mem_append_left
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
    simp only [scalarNames, List.mem_cons, List.not_mem_nil, or_false]
    tauto
  · exact List.mem_append_right _ hx
def NoVar (x : String) : Expr → Prop
  | .lit _ => True
  | .var y => y ≠ x
  | .get _ i => NoVar x i
  | .bin _ e f => NoVar x e ∧ NoVar x f
theorem evalB_setVar_noVar {B : ℕ} {x : String} {v : ℕ} :
    ∀ (e : Expr), NoVar x e → ∀ σ : Env, e.evalB B (σ.setVar x v) = e.evalB B σ
  | .lit _, _, _ => rfl
  | .var y, h, σ => by
    simp only [Expr.evalB, vars_setVar]
    rw [if_neg h]
  | .get a i, h, σ => by
    simp only [Expr.evalB, arrs_setVar]
    rw [evalB_setVar_noVar i h σ]
  | .bin op e f, h, σ => by
    simp only [Expr.evalB]
    rw [evalB_setVar_noVar e h.1 σ, evalB_setVar_noVar f h.2 σ]
variable {K : Type} [Field K] [Fintype K] (F : FieldPresentation K) (r : FieldNames)
structure Base (B : ℕ) (σ : Env) : Prop where
  names : ValidNames r
  degree : σ.vars r.e = F.e
  prime : σ.vars r.p = F.p
  arithmetic_word : (F.p + 1) ^ 2 < B
  inverse_word : (F.p + 1) ^ (F.e + 1) < B
  memory_word : (σ.arrs r.mem).length < B
  scratch_word : (σ.arrs r.scratch).length < B
  scratch_fit : 16 * (F.e + 1) ≤ (σ.arrs r.scratch).length
  modulus_fit : σ.vars r.modBase + F.e + 1 ≤ (σ.arrs r.mem).length
  modulus_value : ∀ i : Fin F.e,
    (σ.arrs r.mem).getD (σ.vars r.modBase + i.val) 0 = (F.modulus i).val
  exp_word : σ.vars r.exp < B
  priv : ∀ x ∈ scalarNames r, x ∉ extraNames r
def addr (WS : String) (s : Expr) : Expr :=
  .bin .add (.var WS) (.bin .mul s (.var r.e))
theorem addr_size (WS : String) (s : Expr) : (addr r WS s).size = s.size + 4 := by
  simp only [addr, Expr.size]
  omega
structure Slots (WS : String) (S : ℕ) (B : ℕ) (σ : Env) : Prop where
  base : Base F r B σ
  ws_reg : WS ∉ regNames r
  fit : σ.vars WS + S * F.e ≤ (σ.arrs r.mem).length
  modulus_apart : σ.vars r.modBase + F.e + 1 ≤ σ.vars WS ∨
    σ.vars WS + S * F.e ≤ σ.vars r.modBase
  canon : ∀ s < S, Canonical F (slice F σ r (σ.vars WS + s * F.e))
  slots_word : S < B
noncomputable def val (WS : String) (σ : Env) (s : ℕ) : K :=
  decode F (slice F σ r (σ.vars WS + s * F.e))
theorem names_ne (h : ValidNames r) (hpv : ∀ x ∈ scalarNames r, x ∉ extraNames r) :
    r.e ≠ r.aBase ∧ r.e ≠ r.bBase ∧ r.e ≠ r.outBase ∧
    r.p ≠ r.aBase ∧ r.p ≠ r.bBase ∧ r.p ≠ r.outBase ∧
    r.modBase ≠ r.aBase ∧ r.modBase ≠ r.bBase ∧ r.modBase ≠ r.outBase ∧
    r.exp ≠ r.aBase ∧ r.exp ≠ r.bBase ∧ r.exp ≠ r.outBase ∧
    r.aBase ≠ r.bBase ∧ r.aBase ≠ r.outBase ∧ r.bBase ≠ r.outBase ∧
    r.e ∉ clobbered r ∧ r.p ∉ clobbered r ∧ r.modBase ∉ clobbered r ∧ r.exp ∉ clobbered r := by
  have hn := h.1
  have x1 : r.e ∉ extraNames r := hpv _ (by simp [scalarNames])
  have x2 : r.p ∉ extraNames r := hpv _ (by simp [scalarNames])
  have x3 : r.modBase ∉ extraNames r := hpv _ (by simp [scalarNames])
  have x4 : r.exp ∉ extraNames r := hpv _ (by simp [scalarNames])
  clear hpv
  simp only [scalarNames, List.nodup_cons, List.mem_cons, List.not_mem_nil, or_false,
    not_or] at hn
  simp only [clobbered, List.mem_append, List.mem_cons, List.not_mem_nil, or_false, not_or]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩ <;>
    first
    | (intro heq; simp_all)
    | (refine ⟨⟨?_, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩ <;> first | assumption | (intro heq; simp_all))
theorem e_lt {B : ℕ} {σ : Env} (hb : Base F r B σ) : F.e < B := by
  have h1 : F.e + 1 < (F.p + 1) ^ (F.e + 1) := by
    calc F.e + 1 < 2 ^ (F.e + 1) := Nat.lt_two_pow_self
      _ ≤ (F.p + 1) ^ (F.e + 1) := Nat.pow_le_pow_left (by have := F.prime.two_le; omega) _
  have := hb.inverse_word
  omega
theorem evalB_addr {WS : String} {S B : ℕ} {σ : Env} (hS : Slots F r WS S B σ) {s : Expr}
    {sv : ℕ} (hs : s.evalB B σ = some sv) (hlt : sv < S) :
    (addr r WS s).evalB B σ = some (σ.vars WS + sv * F.e) := by
  have hfit := hS.fit
  have hmw := hS.base.memory_word
  have hle : sv * F.e + F.e ≤ S * F.e := by
    have := Nat.mul_le_mul_right F.e (Nat.succ_le_of_lt hlt)
    rw [Nat.succ_mul] at this
    exact this
  have hlen : σ.vars WS + sv * F.e < B := by omega
  have he : σ.vars r.e = F.e := hS.base.degree
  unfold addr
  have h1 : (Expr.var r.e).evalB B σ = some F.e := by
    rw [← he]; exact evalB_var (by rw [he]; exact e_lt F r hS.base)
  have h2 : (Expr.bin .mul s (.var r.e)).evalB B σ = some (sv * F.e) :=
    evalB_bin hs h1 (by change sv * F.e < B; omega)
  exact evalB_bin (evalB_var (by omega)) h2 (by change σ.vars WS + sv * F.e < B; omega)
structure CallResult (WS : String) (S B : ℕ) (σ τ : Env) (so : ℕ) : Prop where
  slots : Slots F r WS S B τ
  others : ∀ s < S, s ≠ so → slice F τ r (τ.vars WS + s * F.e) = slice F σ r (σ.vars WS + s * F.e)
  vars : ∀ x, x ∉ clobbered r → x ≠ r.aBase → x ≠ r.bBase → x ≠ r.outBase →
    τ.vars x = σ.vars x
  arrays : ∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a
  inp : τ.inp = σ.inp
  out : τ.out = σ.out
theorem slot_disjoint {e a b : ℕ} (h : a ≠ b) (W : ℕ) :
    W + a * e + e ≤ W + b * e ∨ W + b * e + e ≤ W + a * e := by
  rcases Nat.lt_or_gt_of_ne h with h | h
  · left
    have := Nat.mul_le_mul_right e (Nat.succ_le_of_lt h)
    rw [Nat.succ_mul] at this
    omega
  · right
    have := Nat.mul_le_mul_right e (Nat.succ_le_of_lt h)
    rw [Nat.succ_mul] at this
    omega
theorem slot_call {c : Com} {f : K → K → K} {cost : ℕ} (hspec : BinarySpec F r c f cost)
    {WS : String} {S B : ℕ} {σ : Env} (hS : Slots F r WS S B σ)
    (a b o : Expr) {sa sb so : ℕ}
    (ha : a.evalB B σ = some sa) (hb : b.evalB B σ = some sb) (ho : o.evalB B σ = some so)
    (hba : NoVar r.aBase b) (hoa : NoVar r.aBase o) (hob : NoVar r.bBase o)
    (hsa : sa < S) (hsb : sb < S) (hso : so < S) (hne1 : so ≠ sa) (hne2 : so ≠ sb) :
    ∃ τ, Run B (call r (addr r WS a) (addr r WS b) (addr r WS o) c) σ τ
        (15 + a.size + b.size + o.size + cost) ∧
      val F r WS τ so = f (val F r WS σ sa) (val F r WS σ sb) ∧
      CallResult F r WS S B σ τ so := by
  obtain ⟨heA, heB, heO, hpA, hpB, hpO, hmA, hmB, hmO, hxA, hxB, hxO, hAB, hAO, hBO, heC, hpC,
    hmC, hxC⟩ := names_ne r hS.base.names hS.base.priv
  have hws := hS.ws_reg
  have hwsA : WS ≠ r.aBase := by
    intro h; apply hws; rw [h]; simp [regNames, scalarNames]
  have hwsB : WS ≠ r.bBase := by
    intro h; apply hws; rw [h]; simp [regNames, scalarNames]
  have hwsO : WS ≠ r.outBase := by
    intro h; apply hws; rw [h]; simp [regNames, scalarNames]
  have hwsC : WS ∉ clobbered r := fun h => hws (clobbered_reg r WS h)
  set av := σ.vars WS + sa * F.e
  set bv := σ.vars WS + sb * F.e
  set ov := σ.vars WS + so * F.e
  have hA := evalB_addr F r hS ha hsa
  have hnoAb : NoVar r.aBase (addr r WS b) := ⟨hwsA, hba, heA⟩
  have hnoAo : NoVar r.aBase (addr r WS o) := ⟨hwsA, hoa, heA⟩
  have hnoBo : NoVar r.bBase (addr r WS o) := ⟨hwsB, hob, heB⟩
  have hB : (addr r WS b).evalB B (σ.setVar r.aBase av) = some bv := by
    rw [evalB_setVar_noVar _ hnoAb σ]; exact evalB_addr F r hS hb hsb
  have hO : (addr r WS o).evalB B ((σ.setVar r.aBase av).setVar r.bBase bv) = some ov := by
    rw [evalB_setVar_noVar _ hnoBo, evalB_setVar_noVar _ hnoAo σ]; exact evalB_addr F r hS ho hso
  have hw : ∀ x, x ≠ r.aBase → x ≠ r.bBase → x ≠ r.outBase →
      (withArgs r σ av bv ov).vars x = σ.vars x := by
    intro x h1 h2 h3
    simp only [withArgs, vars_setVar, if_neg h1, if_neg h2, if_neg h3]
  have hwA : (withArgs r σ av bv ov).vars r.aBase = av := by
    simp only [withArgs, vars_setVar, if_neg hAO, if_neg hAB,
      if_true]
  have hwB : (withArgs r σ av bv ov).vars r.bBase = bv := by
    simp only [withArgs, vars_setVar, if_neg hBO, if_true]
  have hwO : (withArgs r σ av bv ov).vars r.outBase = ov := by
    simp only [withArgs, vars_setVar, if_true]
  have hsa' : sa * F.e + F.e ≤ S * F.e := by
    have := Nat.mul_le_mul_right F.e (Nat.succ_le_of_lt hsa); rw [Nat.succ_mul] at this; exact this
  have hsb' : sb * F.e + F.e ≤ S * F.e := by
    have := Nat.mul_le_mul_right F.e (Nat.succ_le_of_lt hsb); rw [Nat.succ_mul] at this; exact this
  have hso' : so * F.e + F.e ≤ S * F.e := by
    have := Nat.mul_le_mul_right F.e (Nat.succ_le_of_lt hso); rw [Nat.succ_mul] at this; exact this
  have hfit := hS.fit
  have hmod : ov + F.e ≤ σ.vars r.modBase ∨ σ.vars r.modBase + F.e + 1 ≤ ov := by
    rcases hS.modulus_apart with h | h
    · right; omega
    · left; omega
  have hin : MacroInput F r B (withArgs r σ av bv ov) := by
    refine ⟨hS.base.names, ?_, ?_, hS.base.arithmetic_word, hS.base.inverse_word,
      hS.base.memory_word, hS.base.scratch_word, hS.base.scratch_fit, ?_, ?_, ?_, ?_, ?_, ?_, ?_,
      ?_, ?_, ?_, ?_⟩
    · rw [hw _ heA heB heO]; exact hS.base.degree
    · rw [hw _ hpA hpB hpO]; exact hS.base.prime
    · rw [withArgs_arrs, hw _ hmA hmB hmO]
      exact hS.base.modulus_fit
    · intro i
      rw [withArgs_arrs, hw _ hmA hmB hmO]
      exact hS.base.modulus_value i
    · rw [withArgs_arrs, hwA]; omega
    · rw [withArgs_arrs, hwB]; omega
    · rw [withArgs_arrs, hwO]; omega
    · rw [hwO, hwA]; exact slot_disjoint hne1 _
    · rw [hwO, hwB]; exact slot_disjoint hne2 _
    · rw [hwO, hw _ hmA hmB hmO]; exact hmod
    · rw [hwA, slice_withArgs]; exact hS.canon sa hsa
    · rw [hwB, slice_withArgs]; exact hS.canon sb hsb
    · rw [hw _ hxA hxB hxO]
      exact hS.base.exp_word
  obtain ⟨τ, hrun, hval, hcan, hfr⟩ := BinarySpec.call F r hspec (addr r WS a) (addr r WS b)
    (addr r WS o) hA hB hO hin
  have hvar : ∀ x, x ∉ clobbered r → x ≠ r.aBase → x ≠ r.bBase → x ≠ r.outBase →
      τ.vars x = σ.vars x := fun x h0 h1 h2 h3 => (hfr.vars x h0).trans (hw x h1 h2 h3)
  have hWS : τ.vars WS = σ.vars WS := hvar WS hwsC hwsA hwsB hwsO
  have hlen : (τ.arrs r.mem).length = (σ.arrs r.mem).length := by
    rw [hfr.mem_length, withArgs_arrs]
  have hcell : ∀ j, j < (σ.arrs r.mem).length → (j < ov ∨ ov + F.e ≤ j) →
      (τ.arrs r.mem).getD j 0 = (σ.arrs r.mem).getD j 0 := by
    intro j hj hsep
    have := hfr.mem_outside j (by rw [withArgs_arrs]; exact hj) (by rw [hwO]; exact hsep)
    rw [withArgs_arrs] at this
    exact this
  have hothers : ∀ s < S, s ≠ so →
      slice F τ r (τ.vars WS + s * F.e) = slice F σ r (σ.vars WS + s * F.e) := by
    intro s hs hne
    have hs' : s * F.e + F.e ≤ S * F.e := by
      have := Nat.mul_le_mul_right F.e (Nat.succ_le_of_lt hs); rw [Nat.succ_mul] at this; exact this
    funext i
    simp only [slice, hWS]
    apply hcell
    · have := i.isLt; omega
    · have := i.isLt
      rcases slot_disjoint hne (σ.vars WS) (e := F.e) with h | h <;> [left; right] <;> omega
  refine ⟨τ, ?_, ?_, ?_⟩
  · have hsz := addr_size r WS a; have hsz2 := addr_size r WS b; have hsz3 := addr_size r WS o
    exact hrun.mono (by omega)
  · unfold val; rw [hWS]; exact hval
  · refine ⟨⟨⟨hS.base.names, ?_, ?_, hS.base.arithmetic_word, hS.base.inverse_word, ?_, ?_, ?_,
      ?_, ?_, ?_, hS.base.priv⟩, hS.ws_reg, ?_, ?_, ?_, hS.slots_word⟩, hothers, hvar, ?_, ?_, ?_⟩
    · rw [hvar _ heC heA heB heO]; exact hS.base.degree
    · rw [hvar _ hpC hpA hpB hpO]
      exact hS.base.prime
    · rw [hlen]; exact hS.base.memory_word
    · rw [hfr.scratch_length, withArgs_arrs]; exact hS.base.scratch_word
    · rw [hfr.scratch_length, withArgs_arrs]; exact hS.base.scratch_fit
    · rw [hlen, hvar _ hmC hmA hmB
        hmO]
      exact hS.base.modulus_fit
    · intro i
      rw [hvar _ hmC hmA hmB
        hmO]
      rw [hcell]
      · exact hS.base.modulus_value i
      · have := hS.base.modulus_fit; have := i.isLt; omega
      · have := i.isLt
        rcases hmod with h | h
        · right; omega
        · left; omega
    · rw [hvar _ hxC hxA hxB
        hxO]
      exact hS.base.exp_word
    · rw [hWS, hlen]; exact hfit
    · rw [hWS, hvar _ hmC hmA hmB
        hmO]
      exact hS.modulus_apart
    · intro s hs
      by_cases hss : s = so
      · subst hss; rw [hWS]; exact hcan
      · rw [hothers s hs hss]; exact hS.canon s hs
    · intro arr h1 h2; rw [hfr.arrays arr h1 h2, withArgs_arrs]
    · rw [hfr.inp, withArgs_inp]
    · rw [hfr.out, withArgs_out]
theorem Slots.setVar {WS : String} {S B : ℕ} {σ : Env} (hS : Slots F r WS S B σ) {x : String}
    (hx : x ∉ regNames r) (hxw : x ≠ WS) (v : ℕ) : Slots F r WS S B (σ.setVar x v) := by
  have hne : ∀ y ∈ regNames r, y ≠ x := fun y hy h => hx (h ▸ hy)
  have he : r.e ≠ x := hne _ (by simp [regNames, scalarNames])
  have hp : r.p ≠ x := hne _ (by simp [regNames, scalarNames])
  have hm : r.modBase ≠ x := hne _ (by simp [regNames, scalarNames])
  have hx' : r.exp ≠ x := hne _ (by simp [regNames, scalarNames])
  have hw : WS ≠ x := fun h => hxw h.symm
  obtain ⟨⟨h1, h2, h3, h4, h5, h6, h7, h8, h9, h10, h11, h12⟩, hws, hfit, hmod, hcan, hsw⟩ := hS
  refine ⟨⟨h1, ?_, ?_, h4, h5, h6, h7, h8, ?_, ?_, ?_, h12⟩, hws, ?_, ?_, ?_, hsw⟩ <;>
    simp only [vars_setVar, arrs_setVar, if_neg he, if_neg hp, if_neg hm, if_neg hx', if_neg hw] <;>
    first | assumption | (intro i; exact h10 i) | (intro s hs; exact hcan s hs)
theorem val_setVar {WS x : String} (hxw : x ≠ WS) (σ : Env) (v s : ℕ) :
    val F r WS (σ.setVar x v) s = val F r WS σ s := by
  unfold val slice
  simp only [vars_setVar, arrs_setVar, if_neg (Ne.symm hxw)]
structure EqResult (WS : String) (S B : ℕ) (σ τ : Env) : Prop where
  slots : Slots F r WS S B τ
  vals : ∀ s, val F r WS τ s = val F r WS σ s
  vars : ∀ x, x ∉ clobbered r → x ≠ r.aBase → x ≠ r.bBase → x ≠ r.outBase →
    τ.vars x = σ.vars x
  arrays : τ.arrs = σ.arrs
  inp : τ.inp = σ.inp
  out : τ.out = σ.out
open Classical in
theorem slot_eq {c : Com} {cost : ℕ} (hspec : EqSpec F r c cost)
    {WS : String} {S B : ℕ} {σ : Env} (hS : Slots F r WS S B σ)
    (a b o : Expr) {sa sb so : ℕ}
    (ha : a.evalB B σ = some sa) (hb : b.evalB B σ = some sb) (ho : o.evalB B σ = some so)
    (hba : NoVar r.aBase b) (hoa : NoVar r.aBase o) (hob : NoVar r.bBase o)
    (hsa : sa < S) (hsb : sb < S) (hso : so < S) (hne1 : so ≠ sa) (hne2 : so ≠ sb) :
    ∃ τ, Run B (call r (addr r WS a) (addr r WS b) (addr r WS o) c) σ τ
        (15 + a.size + b.size + o.size + cost) ∧
      τ.vars r.flag = (if val F r WS σ sa = val F r WS σ sb then 1 else 0) ∧
      EqResult F r WS S B σ τ := by
  obtain ⟨heA, heB, heO, hpA, hpB, hpO, hmA, hmB, hmO, hxA, hxB, hxO, hAB, hAO, hBO, heC, hpC,
    hmC, hxC⟩ := names_ne r hS.base.names hS.base.priv
  have hws := hS.ws_reg
  have hwsA : WS ≠ r.aBase := by
    intro h; apply hws; rw [h]; simp [regNames, scalarNames]
  have hwsB : WS ≠ r.bBase := by
    intro h; apply hws; rw [h]; simp [regNames, scalarNames]
  have hwsO : WS ≠ r.outBase := by
    intro h; apply hws; rw [h]; simp [regNames, scalarNames]
  have hwsC : WS ∉ clobbered r := fun h => hws (clobbered_reg r WS h)
  set av := σ.vars WS + sa * F.e
  set bv := σ.vars WS + sb * F.e
  set ov := σ.vars WS + so * F.e
  have hA := evalB_addr F r hS ha hsa
  have hnoAb : NoVar r.aBase (addr r WS b) := ⟨hwsA, hba, heA⟩
  have hnoAo : NoVar r.aBase (addr r WS o) := ⟨hwsA, hoa, heA⟩
  have hnoBo : NoVar r.bBase (addr r WS o) := ⟨hwsB, hob, heB⟩
  have hB : (addr r WS b).evalB B (σ.setVar r.aBase av) = some bv := by
    rw [evalB_setVar_noVar _ hnoAb σ]; exact evalB_addr F r hS hb hsb
  have hO : (addr r WS o).evalB B ((σ.setVar r.aBase av).setVar r.bBase bv) = some ov := by
    rw [evalB_setVar_noVar _ hnoBo, evalB_setVar_noVar _ hnoAo σ]; exact evalB_addr F r hS ho hso
  have hw : ∀ x, x ≠ r.aBase → x ≠ r.bBase → x ≠ r.outBase →
      (withArgs r σ av bv ov).vars x = σ.vars x := by
    intro x h1 h2 h3
    simp only [withArgs, vars_setVar, if_neg h1, if_neg h2, if_neg h3]
  have hwA : (withArgs r σ av bv ov).vars r.aBase = av := by
    simp only [withArgs, vars_setVar, if_neg hAO, if_neg hAB, if_true]
  have hwB : (withArgs r σ av bv ov).vars r.bBase = bv := by
    simp only [withArgs, vars_setVar, if_neg hBO, if_true]
  have hwO : (withArgs r σ av bv ov).vars r.outBase = ov := by
    simp only [withArgs, vars_setVar, if_true]
  have hsa' : sa * F.e + F.e ≤ S * F.e := by
    have := Nat.mul_le_mul_right F.e (Nat.succ_le_of_lt hsa); rw [Nat.succ_mul] at this; exact this
  have hsb' : sb * F.e + F.e ≤ S * F.e := by
    have := Nat.mul_le_mul_right F.e (Nat.succ_le_of_lt hsb); rw [Nat.succ_mul] at this; exact this
  have hso' : so * F.e + F.e ≤ S * F.e := by
    have := Nat.mul_le_mul_right F.e (Nat.succ_le_of_lt hso); rw [Nat.succ_mul] at this; exact this
  have hfit := hS.fit
  have hmod : ov + F.e ≤ σ.vars r.modBase ∨ σ.vars r.modBase + F.e + 1 ≤ ov := by
    rcases hS.modulus_apart with h | h
    · right; omega
    · left; omega
  have hin : MacroInput F r B (withArgs r σ av bv ov) := by
    refine ⟨hS.base.names, ?_, ?_, hS.base.arithmetic_word, hS.base.inverse_word,
      hS.base.memory_word, hS.base.scratch_word, hS.base.scratch_fit, ?_, ?_, ?_, ?_, ?_, ?_, ?_,
      ?_, ?_, ?_, ?_⟩
    · rw [hw _ heA heB heO]; exact hS.base.degree
    · rw [hw _ hpA hpB hpO]; exact hS.base.prime
    · rw [withArgs_arrs, hw _ hmA hmB hmO]
      exact hS.base.modulus_fit
    · intro i
      rw [withArgs_arrs, hw _ hmA hmB hmO]
      exact hS.base.modulus_value i
    · rw [withArgs_arrs, hwA]; omega
    · rw [withArgs_arrs, hwB]; omega
    · rw [withArgs_arrs, hwO]; omega
    · rw [hwO, hwA]; exact slot_disjoint hne1 _
    · rw [hwO, hwB]; exact slot_disjoint hne2 _
    · rw [hwO, hw _ hmA hmB hmO]; exact hmod
    · rw [hwA, slice_withArgs]; exact hS.canon sa hsa
    · rw [hwB, slice_withArgs]; exact hS.canon sb hsb
    · rw [hw _ hxA hxB hxO]
      exact hS.base.exp_word
  obtain ⟨τ, hrun, hflag, hfr⟩ := hspec B (withArgs r σ av bv ov) hin
  have hvar : ∀ x, x ∉ clobbered r → x ≠ r.aBase → x ≠ r.bBase → x ≠ r.outBase →
      τ.vars x = σ.vars x := fun x h0 h1 h2 h3 => (hfr.vars x h0).trans (hw x h1 h2 h3)
  have hWS : τ.vars WS = σ.vars WS := hvar WS hwsC hwsA hwsB hwsO
  have harr : τ.arrs = σ.arrs := by rw [hfr.arrays, withArgs_arrs]
  have hvals : ∀ s, val F r WS τ s = val F r WS σ s := by
    intro s; unfold val slice; rw [hWS, harr]
  refine ⟨τ, ?_, ?_, ?_⟩
  · have hsz := addr_size r WS a; have hsz2 := addr_size r WS b; have hsz3 := addr_size r WS o
    exact (call_run r _ _ _ c hA hB hO hrun).mono (by omega)
  · rw [hflag, hwA, hwB, slice_withArgs, slice_withArgs]; rfl
  · refine ⟨⟨⟨hS.base.names, ?_, ?_, hS.base.arithmetic_word, hS.base.inverse_word, ?_, ?_, ?_,
      ?_, ?_, ?_, hS.base.priv⟩, hS.ws_reg, ?_, ?_, ?_, hS.slots_word⟩, hvals, hvar, harr, ?_, ?_⟩
    · rw [hvar _ heC heA heB heO]; exact hS.base.degree
    · rw [hvar _ hpC hpA hpB hpO]; exact hS.base.prime
    · rw [harr]; exact hS.base.memory_word
    · rw [harr]; exact hS.base.scratch_word
    · rw [harr]; exact hS.base.scratch_fit
    · rw [harr, hvar _ hmC hmA hmB hmO]; exact hS.base.modulus_fit
    · intro i; rw [harr, hvar _ hmC hmA hmB hmO]; exact hS.base.modulus_value i
    · rw [hvar _ hxC hxA hxB hxO]; exact hS.base.exp_word
    · rw [hWS, harr]; exact hfit
    · rw [hWS, hvar _ hmC hmA hmB hmO]; exact hS.modulus_apart
    · intro s hs; unfold slice; rw [hWS, harr]; exact hS.canon s hs
    · rw [hfr.inp, withArgs_inp]
    · rw [hfr.out, withArgs_out]
end Mathproof.Problem18ClaudeIMPSlots20261001
