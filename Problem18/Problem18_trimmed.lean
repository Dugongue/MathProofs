  have hbR : (1:ℝ) ≤ b := by exact_mod_cast hb
  have hb0 : (0:ℝ) < b := by linarith
  have hz : 0 ≤ Real.log (b:ℝ) := Real.log_nonneg hbR
  have ht0 : 0<t := by dsimp [t]; omega
  have htR : (0:ℝ)<t := by exact_mod_cast ht0
  have htlo : Real.log (b:ℝ) ≤ (t:ℝ) := by
    have hh := Nat.le_ceil (Real.log (b:ℝ))
    dsimp [t]
    push_cast
    linarith
  have hthi : (t:ℝ) ≤ 2*(1+Real.log (b:ℝ)) := by
    have hh := Nat.ceil_le_floor_add_one (Real.log (b:ℝ))
    have hhR : (Nat.ceil (Real.log (b:ℝ)):ℝ) ≤ (Nat.floor (Real.log (b:ℝ)):ℝ)+1 := by exact_mod_cast hh
    have hf := Nat.floor_le hz
    dsimp [t]
    push_cast
    linarith
  have hlog2lo : (1/2:ℝ) ≤ Real.log 2 := by
    have hh := Real.one_sub_inv_le_log_of_pos (by norm_num : (0:ℝ)<2)
    norm_num at hh ⊢
    linarith
  have hlog2hi : Real.log 2 ≤ 1 := by
    have hh := Real.log_le_sub_one_of_pos (by norm_num : (0:ℝ)<2)
    norm_num at hh
    exact hh
  have hbhuge : (2:ℝ)^80 ≤ b := by
    have hsq : (1:ℝ) ≤ (1+Real.log (b:ℝ))^2 := by nlinarith
    nlinarith [mul_nonneg (show (0:ℝ)≤2^80 by positivity) (sub_nonneg.mpr hsq)]
  have hlogb : 40 ≤ Real.log (b:ℝ) := by
    have hh := Real.log_le_log (by positivity : (0:ℝ)<2^80) hbhuge
    rw [Real.log_pow] at hh
    norm_num at hh
    linarith
  have hden : 0<1024*t := by omega
  have hD2 : 2≤D := by dsimp [D]; omega
  have hDL : D≤L := by
    apply (Nat.le_div_iff_mul_le hden).mpr
    have hsq : (t:ℝ)^2 ≤ 4*(1+Real.log (b:ℝ))^2 := by
      calc (t:ℝ)^2 ≤ (2*(1+Real.log (b:ℝ)))^2 := pow_le_pow_left₀ htR.le hthi 2
           _ = _ := by ring
    have hh : ((D*(1024*t):ℕ):ℝ) ≤ b := by
      dsimp [D]
      push_cast
      nlinarith [sq_nonneg (1+Real.log (b:ℝ))]
    exact_mod_cast hh
  have hL0 : 0<L := by omega
  have hLR : (0:ℝ)<L := by exact_mod_cast hL0
  have hmass : k*L ≤ b/128 := by
    apply (Nat.le_div_iff_mul_le (by norm_num : 0<128)).mpr
    have hh := Nat.div_mul_le_self b (1024*t)
    change L*(1024*t)≤b at hh
    dsimp [k]
    nlinarith
  have hdiv : (b:ℝ) < ((L:ℝ)+1)*(1024*(t:ℝ)) := by
    have hr := Nat.mod_lt b hden
    have he := Nat.mod_add_div b (1024*t)
    have hh : b<(L+1)*(1024*t) := by dsimp [L]; nlinarith
    exact_mod_cast hh
  have hlogdiv : Real.log (b:ℝ) ≤ Real.log ((L:ℝ)+1)+10*Real.log 2+Real.log (t:ℝ) := by
    have hh := Real.log_le_log hb0 hdiv.le
    rw [Real.log_mul (by positivity) (by positivity),Real.log_mul (by norm_num) (ne_of_gt htR)] at hh
    have h1024 : Real.log (1024:ℝ)=10*Real.log 2 := by
      rw [show (1024:ℝ)=2^10 by norm_num,Real.log_pow]
