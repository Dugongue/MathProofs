namespace Mathproof.Problem18ClaudeIMPIntertwinerEquations20261002
open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Mathproof.Problem18IMPFieldLayout20261001
open Mathproof.Problem18IMPFieldPresentation20261001
open Mathproof.Problem18AllFormatRoot20260930
open Mathproof.Problem18ClaudeFieldMacros20261001
open Mathproof.Problem18ClaudeIMPSlots20261001
open Mathproof.Problem18ClaudeIMPAxpy20261001
open Problem18ExecutableIntertwiner20261001 (equationMatrix)
open Mathproof.Problem18IMPIntertwinerEquationEntries20261002 (equationMatrix_entry)
def dC (n m t : ℕ) : ℕ := t / (m * (n * n))
def dR (n m t : ℕ) : ℕ := t - dC n m t * (m * (n * n))
def dU (n m t : ℕ) : ℕ := dC n m t / n
def dV (n m t : ℕ) : ℕ := dC n m t - dU n m t * n
def dJ (n m t : ℕ) : ℕ := dR n m t / (n * n)
def dW (n m t : ℕ) : ℕ := dR n m t - dJ n m t * (n * n)
def dA (n m t : ℕ) : ℕ := dW n m t / n
def dB (n m t : ℕ) : ℕ := dW n m t - dA n m t * n
theorem sub_div_mul (t R : ℕ) : t - t / R * R = t % R := by
  have h := Nat.div_add_mod t R; rw [Nat.mul_comm] at h; omega
theorem pair_div {x y R : ℕ} (hy : y < R) : (x * R + y) / R = x := by
  have hR : 0 < R := by omega
  rw [Nat.add_comm, Nat.add_mul_div_right _ _ hR, Nat.div_eq_of_lt hy, Nat.zero_add]
theorem pair_sub {x y R : ℕ} (hy : y < R) : (x * R + y) - (x * R + y) / R * R = y := by
  rw [pair_div hy]; omega
theorem lt_mul_of {x y k K : ℕ} (hx : x < K) (hy : y < k) : x * k + y < K * k := by
  have := Nat.mul_le_mul_right k (Nat.succ_le_of_lt hx)
  rw [Nat.succ_mul] at this; omega
theorem decode {n m t : ℕ} (ht : t < n * n * (m * (n * n))) :
    dU n m t < n ∧ dV n m t < n ∧ dJ n m t < m ∧ dA n m t < n ∧ dB n m t < n ∧
    t = (dU n m t * n + dV n m t) * (m * (n * n)) +
      (dJ n m t * (n * n) + dA n m t * n + dB n m t) := by
  have hRpos : 0 < m * (n * n) := by
    rcases Nat.eq_zero_or_pos (m * (n * n)) with h | h
    · rw [h, Nat.mul_zero] at ht; omega
    · exact h
  have hnn : 0 < n * n := Nat.pos_of_mul_pos_left hRpos
  have hn : 0 < n := Nat.pos_of_mul_pos_left hnn
  have hC : dC n m t < n * n := by unfold dC; rw [Nat.div_lt_iff_lt_mul hRpos]; exact ht
  have hRr : dR n m t = t % (m * (n * n)) := by unfold dR dC; rw [sub_div_mul]
  have hRlt : dR n m t < m * (n * n) := by rw [hRr]; exact Nat.mod_lt _ hRpos
  have hU : dU n m t < n := by unfold dU; rw [Nat.div_lt_iff_lt_mul hn]; exact hC
  have hV : dV n m t = dC n m t % n := by unfold dV dU; rw [sub_div_mul]
  have hJ : dJ n m t < m := by unfold dJ; rw [Nat.div_lt_iff_lt_mul hnn]; exact hRlt
  have hW : dW n m t = dR n m t % (n * n) := by unfold dW dJ; rw [sub_div_mul]
  have hWlt : dW n m t < n * n := by rw [hW]; exact Nat.mod_lt _ hnn
  have hA : dA n m t < n := by unfold dA; rw [Nat.div_lt_iff_lt_mul hn]; exact hWlt
  have hB : dB n m t = dW n m t % n := by unfold dB dA; rw [sub_div_mul]
  refine ⟨hU, by rw [hV]; exact Nat.mod_lt _ hn, hJ, hA, by rw [hB]; exact Nat.mod_lt _ hn, ?_⟩
  have e1 : t = dC n m t * (m * (n * n)) + dR n m t := by
    have := Nat.div_add_mod t (m * (n * n)); rw [hRr]; unfold dC; rw [Nat.mul_comm]; omega
  have e2 : dC n m t = dU n m t * n + dV n m t := by
    have := Nat.div_add_mod (dC n m t) n; rw [hV]; unfold dU; rw [Nat.mul_comm]; omega
  have e3 : dR n m t = dJ n m t * (n * n) + dW n m t := by
    have := Nat.div_add_mod (dR n m t) (n * n); rw [hW]; unfold dJ; rw [Nat.mul_comm]; omega
  have e4 : dW n m t = dA n m t * n + dB n m t := by
    have := Nat.div_add_mod (dW n m t) n; rw [hB]; unfold dA; rw [Nat.mul_comm]; omega
  obtain ⟨C, hCe⟩ : ∃ C, dC n m t = C := ⟨_, rfl⟩
  obtain ⟨Rr, hRe⟩ : ∃ Rr, dR n m t = Rr := ⟨_, rfl⟩
  obtain ⟨U, hUe⟩ : ∃ U, dU n m t = U := ⟨_, rfl⟩
  obtain ⟨V, hVe⟩ : ∃ V, dV n m t = V := ⟨_, rfl⟩
  obtain ⟨J, hJe⟩ : ∃ J, dJ n m t = J := ⟨_, rfl⟩
  obtain ⟨W, hWe⟩ : ∃ W, dW n m t = W := ⟨_, rfl⟩
  obtain ⟨A, hAe⟩ : ∃ A, dA n m t = A := ⟨_, rfl⟩
  obtain ⟨Bv, hBe⟩ : ∃ Bv, dB n m t = Bv := ⟨_, rfl⟩
  rw [hCe, hRe] at e1
  rw [hCe, hUe, hVe] at e2
  rw [hRe, hJe, hWe] at e3
  rw [hWe, hAe, hBe] at e4
  rw [hUe, hVe, hJe, hAe, hBe]
  rw [e1, e2, e3, e4]; ring
theorem encode {n m u v j a b : ℕ} (hu : u < n) (hv : v < n) (hj : j < m) (ha : a < n)
    (hb : b < n) :
    (u * n + v) * (m * (n * n)) + (j * (n * n) + a * n + b) < n * n * (m * (n * n)) ∧
    dU n m ((u * n + v) * (m * (n * n)) + (j * (n * n) + a * n + b)) = u ∧
    dV n m ((u * n + v) * (m * (n * n)) + (j * (n * n) + a * n + b)) = v ∧
    dJ n m ((u * n + v) * (m * (n * n)) + (j * (n * n) + a * n + b)) = j ∧
    dA n m ((u * n + v) * (m * (n * n)) + (j * (n * n) + a * n + b)) = a ∧
    dB n m ((u * n + v) * (m * (n * n)) + (j * (n * n) + a * n + b)) = b := by
  have hab : a * n + b < n * n := lt_mul_of ha hb
  have hy : j * (n * n) + (a * n + b) < m * (n * n) := lt_mul_of hj hab
  have hx : u * n + v < n * n := lt_mul_of hu hv
  have hya : j * (n * n) + a * n + b = j * (n * n) + (a * n + b) := by ring
  rw [hya]
  have hC : dC n m ((u * n + v) * (m * (n * n)) + (j * (n * n) + (a * n + b))) = u * n + v := by
    unfold dC; exact pair_div hy
  have hR : dR n m ((u * n + v) * (m * (n * n)) + (j * (n * n) + (a * n + b))) =
      j * (n * n) + (a * n + b) := by
    unfold dR; rw [hC]; have := pair_sub (x := u * n + v) hy; rw [pair_div hy] at this; exact this
  have hU : dU n m ((u * n + v) * (m * (n * n)) + (j * (n * n) + (a * n + b))) = u := by
    unfold dU; rw [hC]; exact pair_div hv
  have hV : dV n m ((u * n + v) * (m * (n * n)) + (j * (n * n) + (a * n + b))) = v := by
    unfold dV; rw [hU, hC]; omega
  have hJ : dJ n m ((u * n + v) * (m * (n * n)) + (j * (n * n) + (a * n + b))) = j := by
    unfold dJ; rw [hR]; exact pair_div hab
  have hW : dW n m ((u * n + v) * (m * (n * n)) + (j * (n * n) + (a * n + b))) = a * n + b := by
    unfold dW; rw [hJ, hR]; omega
  have hA : dA n m ((u * n + v) * (m * (n * n)) + (j * (n * n) + (a * n + b))) = a := by
    unfold dA; rw [hW]; exact pair_div hb
  have hB : dB n m ((u * n + v) * (m * (n * n)) + (j * (n * n) + (a * n + b))) = b := by
    unfold dB; rw [hA, hW]; omega
  exact ⟨lt_mul_of hx hy, hU, hV, hJ, hA, hB⟩
structure IWNames where
  n : String
  m : String
  sB : String
  tB : String
  aB : String
  t : String
def IWNames.list (w : IWNames) : List String := [w.n, w.m, w.sB, w.tB, w.aB, w.t]
structure IWNames.Valid (r : FieldNames) (q : RNames) (w : IWNames) : Prop where
  nodup : (q.WS :: w.list).Nodup
  avoid : ∀ x ∈ w.list, x ∉ regNames r
theorem IWNames.Valid.ne_of {r : FieldNames} {q : RNames} {w : IWNames} (h : w.Valid r q)
    {x y : String} (hxy : x = y → ¬ (q.WS :: w.list).Nodup) : x ≠ y := fun e => hxy e h.1
def nnE (w : IWNames) : Expr := .bin .mul (.var w.n) (.var w.n)
def RE (w : IWNames) : Expr := .bin .mul (.var w.m) (nnE w)
def NE (w : IWNames) : Expr := .bin .mul (nnE w) (RE w)
def cE (w : IWNames) : Expr := .bin .div (.var w.t) (RE w)
def rrE (w : IWNames) : Expr := .bin .sub (.var w.t) (.bin .mul (cE w) (RE w))
def uE (w : IWNames) : Expr := .bin .div (cE w) (.var w.n)
def vE (w : IWNames) : Expr := .bin .sub (cE w) (.bin .mul (uE w) (.var w.n))
def jE (w : IWNames) : Expr := .bin .div (rrE w) (nnE w)
def wE (w : IWNames) : Expr := .bin .sub (rrE w) (.bin .mul (jE w) (nnE w))
def aE (w : IWNames) : Expr := .bin .div (wE w) (.var w.n)
def bE (w : IWNames) : Expr := .bin .sub (wE w) (.bin .mul (aE w) (.var w.n))
def SA (w : IWNames) : Expr :=
  plus (plus (plus (.var w.sB) (.bin .mul (jE w) (nnE w))) (.bin .mul (vE w) (.var w.n))) (bE w)
def TA (w : IWNames) : Expr :=
  plus (plus (plus (.var w.tB) (.bin .mul (jE w) (nnE w))) (.bin .mul (aE w) (.var w.n))) (uE w)
def OA (w : IWNames) : Expr := plus (.var w.aB) (.var w.t)
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] {F : FieldPresentation K}
  {r : FieldNames}
def condCopy (M : FieldMacros F r) (q : RNames) (c : Cond) (X : Expr) (k : ℕ) : Com :=
  .ite c (mcall r q M.copy X X (.lit k)) (mcall r q M.copy (.lit 0) (.lit 0) (.lit k))
def eqBody (M : FieldMacros F r) (q : RNames) (w : IWNames) : Com :=
  .seq (condCopy M q (.eq (aE w) (uE w)) (SA w) 1)
    (.seq (condCopy M q (.eq (bE w) (vE w)) (TA w) 2)
      (.seq (mcall r q M.sub (.lit 1) (.lit 2) (OA w))
        (.assign w.t (plus (.var w.t) (.lit 1)))))
def eqCom (M : FieldMacros F r) (q : RNames) (w : IWNames) : Com :=
  .seq (.assign w.t (.lit 0)) (.while (.lt (.var w.t) (NE w)) (eqBody M q w))
def eqStep (M : FieldMacros F r) : ℕ := 1000 + 3 * M.costPoint
def eqCost (M : FieldMacros F r) (N : ℕ) : ℕ := 2 + (100 + eqStep M) * N + 100
theorem cond_copy_run (M : FieldMacros F r) (q : RNames) (c : Cond) (X : Expr) (k : ℕ)
    {B Sn : ℕ} {τ : Env} (hS : Slots F r q.WS Sn B τ) (hz : val F r q.WS τ 0 = 0) {xv : ℕ}
    (bb : Bool) (hc : c.evalB B τ = some bb) (hX : X.evalB B τ = some xv)
    (hXa : NoVar r.aBase X) (hxS : xv < Sn) (hk : k < Sn) (hk0 : k ≠ 0) (hkx : k ≠ xv) :
    ∃ τ', Run B (condCopy M q c X k) τ τ' (1 + c.size + (18 + 2 * X.size + M.costPoint)) ∧
      val F r q.WS τ' k = (if bb then val F r q.WS τ xv else 0) ∧
      CallResult F r q.WS Sn B τ τ' k := by
  have hSB := hS.slots_word
  cases bb with
  | true =>
    obtain ⟨τ', hr, hv, hcr⟩ := slot_call F r M.copy_spec hS X X (.lit k) hX hX
      (evalB_lit (by omega)) hXa trivial trivial hxS hxS hk hkx hkx
    refine ⟨τ', (Run.ite_true hc hr).mono ?_, by rw [hv]; rfl, hcr⟩
    simp only [Expr.size]; omega
  | false =>
    obtain ⟨τ', hr, hv, hcr⟩ := slot_call F r M.copy_spec hS (.lit 0) (.lit 0) (.lit k)
      (evalB_lit (by omega)) (evalB_lit (by omega)) (evalB_lit (by omega)) trivial trivial trivial
      (by omega) (by omega) hk hk0 hk0
    refine ⟨τ', (Run.ite_false hc hr).mono ?_, by rw [hv]; exact hz, hcr⟩
    have : 1 ≤ X.size := by cases X <;> simp [Expr.size]
    simp only [Expr.size]; omega
theorem evals (w : IWNames) {B : ℕ} {σ : Env} {n m t sb tb ab : ℕ}
    (hn : σ.vars w.n = n) (hm : σ.vars w.m = m) (ht : σ.vars w.t = t) (hs : σ.vars w.sB = sb)
    (htb : σ.vars w.tB = tb) (ha : σ.vars w.aB = ab) (htN : t < n * n * (m * (n * n)))
    (hnB : n < B) (hmB : m < B) (hnnB : n * n < B) (hRB : m * (n * n) < B)
    (hsB : sb + m * (n * n) < B) (htbB : tb + m * (n * n) < B)
    (haB : ab + n * n * (m * (n * n)) < B) :
    (aE w).evalB B σ = some (dA n m t) ∧ (uE w).evalB B σ = some (dU n m t) ∧
    (bE w).evalB B σ = some (dB n m t) ∧ (vE w).evalB B σ = some (dV n m t) ∧
    (SA w).evalB B σ = some (sb + dJ n m t * (n * n) + dV n m t * n + dB n m t) ∧
    (TA w).evalB B σ = some (tb + dJ n m t * (n * n) + dA n m t * n + dU n m t) ∧
    (OA w).evalB B σ = some (ab + t) := by
  obtain ⟨hU, hV, hJ, hA, hBb, -⟩ := decode htN
  have tB : t < B := by omega
  have en : (Expr.var w.n).evalB B σ = some n := by rw [← hn]; exact evalB_var (by omega)
  have em : (Expr.var w.m).evalB B σ = some m := by rw [← hm]; exact evalB_var (by omega)
  have et : (Expr.var w.t).evalB B σ = some t := by rw [← ht]; exact evalB_var (by omega)
  have es : (Expr.var w.sB).evalB B σ = some sb := by rw [← hs]; exact evalB_var (by omega)
  have etb : (Expr.var w.tB).evalB B σ = some tb := by rw [← htb]; exact evalB_var (by omega)
  have ea : (Expr.var w.aB).evalB B σ = some ab := by rw [← ha]; exact evalB_var (by omega)
  have hnn : (nnE w).evalB B σ = some (n * n) := evalB_bin en en hnnB
  have hR : (RE w).evalB B σ = some (m * (n * n)) := evalB_bin em hnn hRB
  have hCt : dC n m t ≤ t := Nat.div_le_self _ _
  have hCR : dC n m t * (m * (n * n)) ≤ t := Nat.div_mul_le_self _ _
  have hRt : dR n m t ≤ t := Nat.sub_le _ _
  have hUC : dU n m t * n ≤ dC n m t := Nat.div_mul_le_self _ _
  have hUt : dU n m t ≤ dC n m t := Nat.div_le_self _ _
  have hVt : dV n m t ≤ dC n m t := Nat.sub_le _ _
  have hJR : dJ n m t * (n * n) ≤ dR n m t := Nat.div_mul_le_self _ _
  have hJt : dJ n m t ≤ dR n m t := Nat.div_le_self _ _
  have hWt : dW n m t ≤ dR n m t := Nat.sub_le _ _
  have hAW : dA n m t * n ≤ dW n m t := Nat.div_mul_le_self _ _
  have hAt : dA n m t ≤ dW n m t := Nat.div_le_self _ _
  have hBt : dB n m t ≤ dW n m t := Nat.sub_le _ _
  have hc : (cE w).evalB B σ = some (dC n m t) := evalB_bin et hR (by change dC n m t < B; omega)
  have hcr : (Expr.bin .mul (cE w) (RE w)).evalB B σ = some (dC n m t * (m * (n * n))) :=
    evalB_bin hc hR (by change dC n m t * (m * (n * n)) < B; omega)
  have hrr : (rrE w).evalB B σ = some (dR n m t) :=
    evalB_bin et hcr (by change dR n m t < B; omega)
  have hu : (uE w).evalB B σ = some (dU n m t) := evalB_bin hc en (by change dU n m t < B; omega)
  have hun : (Expr.bin .mul (uE w) (.var w.n)).evalB B σ = some (dU n m t * n) :=
    evalB_bin hu en (by change dU n m t * n < B; omega)
  have hv : (vE w).evalB B σ = some (dV n m t) := evalB_bin hc hun (by change dV n m t < B; omega)
  have hj : (jE w).evalB B σ = some (dJ n m t) := evalB_bin hrr hnn (by change dJ n m t < B; omega)
  have hjn : (Expr.bin .mul (jE w) (nnE w)).evalB B σ = some (dJ n m t * (n * n)) :=
    evalB_bin hj hnn (by change dJ n m t * (n * n) < B; omega)
  have hw : (wE w).evalB B σ = some (dW n m t) := evalB_bin hrr hjn (by change dW n m t < B; omega)
  have ha' : (aE w).evalB B σ = some (dA n m t) := evalB_bin hw en (by change dA n m t < B; omega)
  have han : (Expr.bin .mul (aE w) (.var w.n)).evalB B σ = some (dA n m t * n) :=
    evalB_bin ha' en (by change dA n m t * n < B; omega)
  have hb : (bE w).evalB B σ = some (dB n m t) := evalB_bin hw han (by change dB n m t < B; omega)
  have hvn : (Expr.bin .mul (vE w) (.var w.n)).evalB B σ = some (dV n m t * n) := by
    have := lt_mul_of hV hBb
    exact evalB_bin hv en (by change dV n m t * n < B; omega)
  have hS1 : dJ n m t * (n * n) + (dV n m t * n + dB n m t) < m * (n * n) :=
    lt_mul_of hJ (lt_mul_of hV hBb)
  have hT1 : dJ n m t * (n * n) + (dA n m t * n + dU n m t) < m * (n * n) :=
    lt_mul_of hJ (lt_mul_of hA hU)
  refine ⟨ha', hu, hb, hv, ?_, ?_, ?_⟩
  · unfold SA plus
    have h1 := evalB_bin (op := .add) es hjn (by change sb + dJ n m t * (n * n) < B; omega)
    have h2 := evalB_bin (op := .add) h1 hvn
      (by change sb + dJ n m t * (n * n) + dV n m t * n < B; omega)
    exact evalB_bin h2 hb (by change sb + dJ n m t * (n * n) + dV n m t * n + dB n m t < B; omega)
  · unfold TA plus
    have h1 := evalB_bin (op := .add) etb hjn (by change tb + dJ n m t * (n * n) < B; omega)
    have h2 := evalB_bin (op := .add) h1 han
      (by change tb + dJ n m t * (n * n) + dA n m t * n < B; omega)
    exact evalB_bin h2 hu (by change tb + dJ n m t * (n * n) + dA n m t * n + dU n m t < B; omega)
  · unfold OA plus
    exact evalB_bin ea et (by change ab + t < B; omega)
def entryE (g : ℕ → K) (n m sb tb t : ℕ) : K :=
  (if dA n m t = dU n m t then g (sb + dJ n m t * (n * n) + dV n m t * n + dB n m t) else 0) -
    (if dB n m t = dV n m t then g (tb + dJ n m t * (n * n) + dA n m t * n + dU n m t) else 0)
theorem eq_run (M : FieldMacros F r) (q : RNames) (w : IWNames) (hw : w.Valid r q)
    {B Sn n m sb tb ab : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ)
    (hz : val F r q.WS σ 0 = 0)
    (hn : σ.vars w.n = n) (hm : σ.vars w.m = m) (hs : σ.vars w.sB = sb)
    (htb : σ.vars w.tB = tb) (ha : σ.vars w.aB = ab)
    (hnB : n < B) (hmB : m < B) (hnn : n * n ≤ Sn)
    (hs3 : 3 ≤ sb) (ht3 : 3 ≤ tb) (ha3 : 3 ≤ ab)
    (hsS : sb + m * (n * n) ≤ Sn) (htS : tb + m * (n * n) ≤ Sn)
    (haS : ab + n * n * (m * (n * n)) ≤ Sn)
    (hSo : ab + n * n * (m * (n * n)) ≤ sb ∨ sb + m * (n * n) ≤ ab)
    (hTo : ab + n * n * (m * (n * n)) ≤ tb ∨ tb + m * (n * n) ≤ ab)
    (S T : Fin m → Matrix (Fin n) (Fin n) K)
    (hSv : ∀ (j : Fin m) (a b : Fin n),
      val F r q.WS σ (sb + j.val * (n * n) + a.val * n + b.val) = S j a b)
    (hTv : ∀ (j : Fin m) (a b : Fin n),
      val F r q.WS σ (tb + j.val * (n * n) + a.val * n + b.val) = T j a b) :
    ∃ τ, Run B (eqCom M q w) σ τ (eqCost M (n * n * (m * (n * n)))) ∧
      Slots F r q.WS Sn B τ ∧
      (∀ (j : Fin m) (a b u v : Fin n),
        val F r q.WS τ (ab + (u.val * n + v.val) * (m * (n * n)) +
          (j.val * (n * n) + a.val * n + b.val)) =
        equationMatrix S T (finProdFinEquiv (j, finProdFinEquiv (a, b)))
          (finProdFinEquiv (u, v))) ∧
      (∀ s < Sn, s ≠ 1 → s ≠ 2 → (s < ab ∨ ab + n * n * (m * (n * n)) ≤ s) →
        val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ≠ w.t → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  set N := n * n * (m * (n * n)) with hN
  have hSB := hS.slots_word
  have hwl : ∀ x ∈ w.list, x ∉ regNames r := hw.avoid
  have rt : w.t ∉ regNames r := hwl _ (by simp [IWNames.list])
  have dtW : w.t ≠ q.WS := hw.ne_of (by intro h; simp [IWNames.list, h])
  have dnt : w.n ≠ w.t := hw.ne_of (by intro h; simp [IWNames.list, h])
  have dmt : w.m ≠ w.t := hw.ne_of (by intro h; simp [IWNames.list, h])
  have dst : w.sB ≠ w.t := hw.ne_of (by intro h; simp [IWNames.list, h])
  have dtt : w.tB ≠ w.t := hw.ne_of (by intro h; simp [IWNames.list, h])
  have dat : w.aB ≠ w.t := hw.ne_of (by intro h; simp [IWNames.list, h])
  have rn : w.n ∉ regNames r := hwl _ (by simp [IWNames.list])
  have rm : w.m ∉ regNames r := hwl _ (by simp [IWNames.list])
  have rs : w.sB ∉ regNames r := hwl _ (by simp [IWNames.list])
  have rtb : w.tB ∉ regNames r := hwl _ (by simp [IWNames.list])
  have ra : w.aB ∉ regNames r := hwl _ (by simp [IWNames.list])
  have hnoA : r.aBase ∉ w.list := fun h => hwl _ h (by simp [regNames, scalarNames])
  have hnoB : r.bBase ∉ w.list := fun h => hwl _ h (by simp [regNames, scalarNames])
  have vSA : VarsIn w.list (SA w) := by
    simp [VarsIn, SA, plus, jE, rrE, cE, RE, nnE, vE, uE, bE, wE, aE, IWNames.list]
  have vTA : VarsIn w.list (TA w) := by
    simp [VarsIn, TA, plus, jE, rrE, cE, RE, nnE, uE, wE, aE, IWNames.list]
  have vOA : VarsIn w.list (OA w) := by simp [VarsIn, OA, plus, IWNames.list]
  have hnnB : n * n < B := by omega
  have hRB : m * (n * n) < B := by omega
  let I : Env → Prop := fun τ =>
    Slots F r q.WS Sn B τ ∧ τ.vars w.t ≤ N ∧
    (∀ x, x ∉ regNames r → x ≠ w.t → τ.vars x = σ.vars x) ∧
    (∀ s < τ.vars w.t, val F r q.WS τ (ab + s) = entryE (val F r q.WS σ) n m sb tb s) ∧
    (∀ s < Sn, s ≠ 1 → s ≠ 2 → (s < ab ∨ ab + τ.vars w.t ≤ s) →
      val F r q.WS τ s = val F r q.WS σ s) ∧
    (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out
  have hI0 : I (σ.setVar w.t 0) := by
    refine ⟨Slots.setVar F r hS rt dtW 0, by simp, ?_, ?_, ?_, fun _ _ _ => rfl, rfl, rfl⟩
    · intro x _ hx; simp only [vars_setVar, if_neg hx]
    · intro s hs'; simp at hs'
    · intro s _ _ _ _; exact val_setVar F r dtW σ 0 s
  have regs : ∀ τ, I τ → τ.vars w.n = n ∧ τ.vars w.m = m ∧ τ.vars w.sB = sb ∧
      τ.vars w.tB = tb ∧ τ.vars w.aB = ab := fun τ hτ =>
    ⟨by rw [hτ.2.2.1 _ rn dnt, hn], by rw [hτ.2.2.1 _ rm dmt, hm],
      by rw [hτ.2.2.1 _ rs dst, hs], by rw [hτ.2.2.1 _ rtb dtt, htb],
      by rw [hτ.2.2.1 _ ra dat, ha]⟩
  have hNE : ∀ τ, I τ → (NE w).evalB B τ = some N := by
    intro τ hτ
    obtain ⟨h1, h2, -, -, -⟩ := regs τ hτ
    have en : (Expr.var w.n).evalB B τ = some n := by rw [← h1]; exact evalB_var (by omega)
    have em : (Expr.var w.m).evalB B τ = some m := by rw [← h2]; exact evalB_var (by omega)
    exact evalB_bin (evalB_bin en en hnnB) (evalB_bin em (evalB_bin en en hnnB) hRB)
      (by change n * n * (m * (n * n)) < B; omega)
  have hdef : ∀ τ, I τ → ∃ b, (Cond.lt (.var w.t) (NE w)).evalB B τ = some b := by
    intro τ hτ
    exact ⟨_, evalB_condLt (evalB_var (by have := hτ.2.1; omega)) (hNE τ hτ)⟩
  have hstep : ∀ τ, I τ → (Cond.lt (.var w.t) (NE w)).evalB B τ = some true →
      ∃ τ', Run B (eqBody M q w) τ τ' (eqStep M) ∧ I τ' ∧
        N - τ'.vars w.t < N - τ.vars w.t := by
    intro τ hτ hc
    obtain ⟨rn', rm', rs', rtb', ra'⟩ := regs τ hτ
    have hNτ := hNE τ hτ
    obtain ⟨hSτ, hle, hregs, hdone, hfr, harr, hinp, hout⟩ := hτ
    obtain ⟨tv, htv⟩ : ∃ tv, τ.vars w.t = tv := ⟨_, rfl⟩
    rw [htv] at hle hdone hfr
    have htN : tv < N := by
      rw [evalB_condLt (evalB_var (by omega)) hNτ, htv] at hc
      simpa using hc
    obtain ⟨hU, hV, hJ, hA, hBb, -⟩ := decode htN
    have hS1 := lt_mul_of hJ (lt_mul_of hV hBb)
    have hT1 := lt_mul_of hJ (lt_mul_of hA hU)
    set sa := sb + dJ n m tv * (n * n) + dV n m tv * n + dB n m tv with hsa
    set ta := tb + dJ n m tv * (n * n) + dA n m tv * n + dU n m tv with hta
    obtain ⟨eA, eU, eB, eV, eS, eT, eO⟩ := evals w rn' rm' htv rs' rtb' ra' htN hnB hmB hnnB hRB
      (by omega) (by omega) (by omega)
    have hz' : val F r q.WS τ 0 = 0 := by
      rw [hfr 0 (by omega) (by omega) (by omega) (Or.inl (by omega))]; exact hz
    obtain ⟨τ1, hr1, hv1, hc1⟩ := cond_copy_run M q (.eq (aE w) (uE w)) (SA w) 1 hSτ hz'
      (dA n m tv == dU n m tv) (evalB_condEq eA eU) eS (noVar_of_varsIn hnoA _ vSA)
      (by omega) (by omega) (by omega) (by omega)
