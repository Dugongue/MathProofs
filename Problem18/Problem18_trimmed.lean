  | .or o, s =>
      some { s with pc := s.pc + 1, acc := Nat.lor s.acc (sparseValue w o s.mem) % 2 ^ w }
  | .xor o, s =>
      some { s with pc := s.pc + 1, acc := Nat.xor s.acc (sparseValue w o s.mem) % 2 ^ w }
