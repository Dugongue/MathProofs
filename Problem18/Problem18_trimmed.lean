theorem Ready.setVar (F : FieldPresentation K) {B : Nat} {ρ σ : Env}
    {memoryBank layoutBank count found : String}
    (h : Ready F B ρ memoryBank layoutBank count σ)
    (hfound : found ∉ regNames canonical) (v : Nat) :
    Ready F B ρ memoryBank layoutBank count (σ.setVar found v) := by
  have hne (x : String) (hx : x ∈ scalarNames canonical) : found ≠ x := by
    intro heq
    apply hfound
    rw [heq]
    exact List.mem_append_left _ hx
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · apply Mathproof.Problem18ConcreteSlotTransport20261002.Base.transport h.base
    · rw [vars_setVar, if_neg (hne canonical.e (by simp [scalarNames])).symm]
    · rw [vars_setVar, if_neg (hne canonical.p (by simp [scalarNames])).symm]
    · rw [vars_setVar, if_neg (hne canonical.modBase (by simp [scalarNames])).symm]
    · rw [vars_setVar, if_neg (hne canonical.exp (by simp [scalarNames])).symm]
    · simp
    · simp
  · simpa using h.memory
  · simpa using h.layout
  · simpa using h.memLength
  · simpa using h.input
