  have hsep : C.SeparatingLeft := by
    intro x hx
    apply e.injective
    rw [map_zero]
    apply primary_cross_separatingLeft B S g i j hS hB hm hi hf hs hc
    intro y
    obtain ⟨z,rfl⟩ := f.surjective y
    exact hx z
  exact ⟨crossCoefficient σ C,cross_coefficient_ne_zero σ φ C hC hsep,
    cross_trace_representation σ φ C hC⟩
