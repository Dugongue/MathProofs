  have hlenE : F.e*spanSlots n d = F.e*5 + F.e*(d+n*d) := by unfold spanSlots; ring
  have hEle : F.e ≤ F.e*spanSlots n d := Nat.le_mul_of_pos_right _ (by omega)
  have htop := hW.top
  obtain ⟨ν1, r1, vals1, rest1, arr1, i1, o1⟩ := asg_run zArgs ν hn hd he hsb
    (by intro p hp; simp only [zArgs, List.mem_cons, List.not_mem_nil, or_false] at hp
        rcases hp with rfl|rfl <;> (dsimp only; decide))
    (by simp only [zArgs, List.map_cons, List.map_nil]; decide)
    (by intro x hx; simp only [zArgs, List.mem_cons, List.not_mem_nil, or_false] at hx
        rcases hx with rfl|rfl; exact hW.ws; exact hW.ve)
