  unfold equations at hp
  split_ifs at hp with h
  · simp only [List.mem_append,List.mem_flatMap,List.mem_map,List.mem_finRange,true_and] at hp
    rcases hp with (((⟨i,j,rfl⟩|⟨i,j,rfl⟩)|⟨i,j,rfl⟩)|⟨i,j,rfl⟩)
    · exact (preservesPEntry_degree_le _ _ _).trans (by omega)
    · exact (preservesREntry_degree_le _ _ _).trans (by omega)
    · exact (augmentedKernelEntry_degree_le _ _ _ _ _).trans (by omega)
    · exact Problem18P34Frontend20261003Gram.degree _ _ _ _
