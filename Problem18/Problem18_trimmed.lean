variable {K : Type} [Field K] (F : FieldPresentation K)
structure Glob (W Sn bankLen : Nat) (σ : Env) : Prop where
  e_reg : σ.vars canonical.e = F.e
  p_reg : σ.vars canonical.p = F.p
  mod_reg : σ.vars canonical.modBase = 0
  modulus : ∀ i : Fin F.e, (σ.arrs canonical.mem).getD i.val 0 = (F.modulus i).val
  mem_len : (σ.arrs canonical.mem).length = F.e + 1 + Sn * F.e
  mem_word : (σ.arrs canonical.mem).length < W
  scratch_fit : 16 * (F.e + 1) ≤ (σ.arrs canonical.scratch).length
