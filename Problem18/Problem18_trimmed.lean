theorem regular_occurrence_bound
    (hcard : Nat.card K=Nat.card (fixedField (starRingAut : K ≃+* K))^2)
    (hstar : ∀ a : K,star a=a^Nat.card (fixedField (starRingAut : K ≃+* K)))
    (B : V →ₗ⋆[K] V →ₗ[K] K) (C : W →ₗ⋆[K] W →ₗ[K] K)
    (hB : B.IsSymm) (hnB : B.Nondegenerate) (hC : C.IsSymm) (hnC : C.Nondegenerate)
    (hsA : (sumForm (starRingAut : K ≃+* K) B C).IsSymm)
    (hnA : (sumForm (starRingAut : K ≃+* K) B C).Nondegenerate)
    (hc : 1≤Module.finrank K W) (h : K[X]) (hm : h.Monic) (hi : Irreducible h)
    (hd : Module.finrank K V=h.natDegree) :
    (Nat.card (Mathproof.Problem18SpectralOccurrenceCount20261001.OccurrenceOperators
      (starRingAut : K ≃+* K) B C h) : ℝ)*
      (Nat.card (fixedField (starRingAut : K ≃+* K)) : ℝ)^h.natDegree ≤
        3*Nat.card (SelfAdjointOperators (starRingAut : K ≃+* K) (sumForm (starRingAut : K ≃+* K) B C)) := by
