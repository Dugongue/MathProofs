def coordinatesCounted {n m:ℕ} (v:Fin m→Fin n→K) (x:Fin n→K) : Vector K m×ℕ :=
  let r:=reduceArray (List.finRange n) (Fin.castAdd m) (rows v) (query x)
  (Vector.ofFn (fun j=> -read r.1 (j.natAdd n)),r.2+m)
theorem coordinatesCounted_value {n m:ℕ} (v:Fin m→Fin n→K) (x:Fin n→K) :
