    Problem18P34Frontend20261003PadRank.run_from_compressed F 1 d B S rows ξ
    hξ (by rw [hframe 0 (by have :=hsquare;omega) (Or.inl rfl),hz])
    hNξ hchosen hcc hfitξ hsquare hNB
  have hrbound:=compress_cost F names.q cn (boxSize 1 d) rows.length
  have hlbound:=loader_bound F 1 d (ξ.vars cn.cc) (macroBudget F)
    (by unfold macroBudget;omega) le_rfl (concrete_costBound F).one
  have hmon:=Nat.mul_le_mul_right (macroBudget F) (loaderCoefficient_mono 1 d _ _ hcc)
  refine ⟨τ,(hr.seq ht).mono ?_,hτ,?_,hi'.trans hi,ho'.trans ho,hrank.trans hcount,hzero,?_,?_⟩
  · rw [hrlen] at hrbound ⊢
    unfold coefficient
    nlinarith
  · intro i j
    exact hpad i j
  · intro s hs he
    rw [hext s hs he,hframe s hs (Or.inr ?_)]
    exact le_trans (by unfold inStart;omega) he
  · intro arr hm hs
    have hscope : Scoped canonical (Problem18ConcreteFixedDataLoader20261002.program F 1 d) := by
      simp [Problem18ConcreteFixedDataLoader20261002.program,setupFill,setupGather,
        Problem18ClaudeIMPBankLoad20261001.fillCom,
        Problem18ClaudeIMPBankLoad20261001.fillBody,
        Problem18ClaudeIMPChosenPrefix20261002.chosenCom,
        Problem18ClaudeIMPChosenPrefix20261002.chosenBody,field_scoped]
    exact (caller_array_preserved hscope ht arr hm hs).trans (harr arr hm hs)
end
