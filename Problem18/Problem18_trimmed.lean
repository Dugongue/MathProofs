      (1 + (Expr.bin .div (.var w) (.var r.p)).size) +
      (1 + (Expr.bin .add (.var k) (.lit 1)).size) = s.size + 22 := by
  simp only [Expr.size, addr_size, remExpr_size]
  omega
def digitState (σ : Env) (WS w k : String) (base mv p : Nat) (i : Nat) : Env :=
  { σ with
    vars := fun x => if x = k then i else if x = w then mv / p ^ i else σ.vars x
    arrs := fun a => if a = r.mem then writeValues (σ.arrs r.mem) base (fun j => mv / p ^ j % p) i
      else σ.arrs a }
