namespace Mathproof.Problem18SquarefreeQuotientAlgebra20260930
noncomputable section
set_option backward.isDefEq.respectTransparency false
open Classical Polynomial
open scoped BigOperators
variable {K ι : Type*} [Field K] [Fintype K] [Fintype ι]
variable (g : ι → K[X]) [∀ i, Fact (Irreducible (g i))]
noncomputable local instance (i : ι) : FiniteDimensional K (AdjoinRoot (g i)) :=
  (AdjoinRoot.powerBasis (Fact.out : Irreducible (g i)).ne_zero).finite
theorem product_aeval_root (i : ι) :
    Polynomial.aeval (AdjoinRoot.root (g i)) (∏ j,g j)=0 := by
  classical
  rw [map_prod]
  apply Finset.prod_eq_zero (Finset.mem_univ i)
  rw [AdjoinRoot.aeval_eq]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton (g i)))
noncomputable def quotientEvaluation :
    AdjoinRoot (∏ i,g i) →ₐ[K] (∀ i,AdjoinRoot (g i)) :=
  AlgHom.pi fun i => AdjoinRoot.liftAlgHom (∏ i,g i)
    (Algebra.ofId K (AdjoinRoot (g i))) (AdjoinRoot.root (g i)) (by
      change Polynomial.aeval (AdjoinRoot.root (g i)) (∏ j,g j)=0
      exact product_aeval_root g i)
theorem quotientEvaluation_mk (p : K[X]) (i : ι) :
    quotientEvaluation g (AdjoinRoot.mk (∏ j,g j) p) i=AdjoinRoot.mk (g i) p := by
  change Polynomial.aeval (AdjoinRoot.root (g i)) p=AdjoinRoot.mk (g i) p
  rw [AdjoinRoot.aeval_eq]
theorem quotientEvaluation_surjective
    (hcop : Pairwise (fun i j => IsCoprime (g i) (g j))) :
    Function.Surjective (quotientEvaluation g) := by
  intro x
  have hc : Pairwise (fun i j => IsCoprime
      (Ideal.span ({g i} : Set K[X])) (Ideal.span ({g j} : Set K[X]))) := by
    intro i j hij
    exact (Ideal.isCoprime_span_singleton_iff _ _).mpr (hcop hij)
  obtain ⟨p,hp⟩ := Ideal.pi_quotient_surjective hc x
  refine ⟨AdjoinRoot.mk (∏ j,g j) p,?_⟩
  funext i
  rw [quotientEvaluation_mk]
  exact hp i
noncomputable def quotientPrimaryEquiv (hm : ∀ i,(g i).Monic)
    (hcop : Pairwise (fun i j => IsCoprime (g i) (g j))) :
    AdjoinRoot (∏ i,g i) ≃ₐ[K] (∀ i,AdjoinRoot (g i)) := by
  have hfm : (∏ i,g i).Monic := Polynomial.monic_prod_of_monic _ _ (fun i _ => hm i)
  letI : FiniteDimensional K (AdjoinRoot (∏ i,g i)) := (AdjoinRoot.powerBasis hfm.ne_zero).finite
  have hd : Module.finrank K (AdjoinRoot (∏ i,g i))=
      Module.finrank K (∀ i,AdjoinRoot (g i)) := by
    have hr : Module.finrank K (AdjoinRoot (∏ i,g i))=(∏ i,g i).natDegree := finrank_quotient_span_eq_natDegree
    rw [hr,Module.finrank_pi_fintype]
    have hgi (i : ι) : Module.finrank K (AdjoinRoot (g i))=(g i).natDegree := finrank_quotient_span_eq_natDegree
    simp_rw [hgi]
