      r.e≠(innerNames r).outBase)
    (hw : σ.vars r.e<B) (hn : a<B ∧ b<B ∧ out<B)
    (hv : a*σ.vars r.e<B ∧ b*σ.vars r.e<B ∧ out*σ.vars r.e<B)
    (h : MulInput (innerNames r) r.mem B (callState r σ a b out)) :
    Run B (multiplyInto r a b out) σ (callResult r σ a b out)
      (11000*(σ.vars r.e+1)^2) := by
  have hs:=callSetup_run r σ a b out ⟨he.1,he.2.1⟩ hw hn hv
  have hm:=mulCore_run h
  have heq:(callState r σ a b out).vars (innerNames r).e=σ.vars r.e:=
    callState_vars r σ a b out r.e he.1 he.2.1 he.2.2
  apply (hs.seq hm).mono
  rw [heq]
  nlinarith
def callWrites (r : FieldNames) : List String :=
  [(innerNames r).aBase,(innerNames r).bBase,(innerNames r).outBase,
    (innerNames r).i,(innerNames r).j,(innerNames r).k,(innerNames r).value]
def PrivateNames (r : FieldNames) : Prop :=
  ∀x∈scalarNames r,x∉callWrites r
theorem canonical_privateNames : PrivateNames canonical := by
  unfold PrivateNames scalarNames canonical callWrites innerNames
  decide
theorem canonical_innerNames : (scalarNames (innerNames canonical)).Nodup := by decide
theorem callState_shared {r : FieldNames} (h : PrivateNames r) (σ : Env)
    (a b out : Nat) (x : String) (hx : x∈scalarNames r) :
    (callState r σ a b out).vars x=σ.vars x := by
  have hh:=h x hx
  simp only [callWrites,List.mem_cons,List.not_mem_nil,or_false,not_or] at hh
  exact callState_vars r σ a b out x (by tauto) (by tauto) (by tauto)
theorem callResult_vars (r : FieldNames) (σ : Env) (a b out : Nat) (x : String)
    (hx : x∉callWrites r) : (callResult r σ a b out).vars x=σ.vars x := by
  simp only [callWrites,List.mem_cons,List.not_mem_nil,or_false,not_or] at hx
  exact (completed_vars (innerNames r) r.mem _ x (by tauto) (by tauto) (by tauto)
    (by tauto)).trans (callState_vars r σ a b out x (by tauto) (by tauto) (by tauto))
theorem callResult_lengths (r : FieldNames) (σ : Env) (a b out : Nat) (arr : String) :
    ((callResult r σ a b out).arrs arr).length=(σ.arrs arr).length := by
  exact completed_lengths (innerNames r) r.mem (callState r σ a b out) arr
structure BufferInput {K : Type} [Field K]
    (F : Problem18AllFormatRoot20260930.FieldPresentation K)
    (r : FieldNames) (B : Nat) (σ : Env) : Prop where
  degree : σ.vars r.e=F.e
  prime : σ.vars r.p=F.p
  separate : r.mem≠r.scratch
  outer_names : (scalarNames r).Nodup
  inner_names : (scalarNames (innerNames r)).Nodup
  private_names : PrivateNames r
  arithmetic_word : (F.p+1)^2<B
  memory_word : (σ.arrs r.mem).length<B
  scratch_word : (σ.arrs r.scratch).length<B
  scratch_fit : 5*F.e ≤ (σ.arrs r.scratch).length
  modulus_fit : σ.vars r.modBase+F.e ≤ (σ.arrs r.mem).length
  modulus_value : ∀i:Fin F.e,sourceCoeff σ r.mem r.modBase i.val=(F.modulus i).val
  buffer_canonical : ∀n∈[2,3,4],∀j<F.e,(σ.arrs r.scratch).getD (n*F.e+j) 0<F.p
  exponent_word : σ.vars r.exponent<B
theorem callState_arguments {r : FieldNames}
    (hn : (scalarNames (innerNames r)).Nodup) (σ : Env) (a b out : Nat) :
    (callState r σ a b out).vars (innerNames r).aBase=a*σ.vars r.e ∧
    (callState r σ a b out).vars (innerNames r).bBase=b*σ.vars r.e ∧
    (callState r σ a b out).vars (innerNames r).outBase=out*σ.vars r.e := by
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hn
  have hab:(innerNames r).aBase≠(innerNames r).bBase:=by tauto
  have hao:(innerNames r).aBase≠(innerNames r).outBase:=by tauto
  have hbo:(innerNames r).bBase≠(innerNames r).outBase:=by tauto
  simp [callState,hab,hao,hbo]
theorem BufferInput.mulInput {K : Type} [Field K]
    {F : Problem18AllFormatRoot20260930.FieldPresentation K}
    {r : FieldNames} {B : Nat} {σ : Env} (h : BufferInput F r B σ)
    {a b out : Nat} (ha : a∈[2,3,4]) (hb : b∈[2,3,4]) (ho : out∈[2,3,4]) :
    MulInput (innerNames r) r.mem B (callState r σ a b out) := by
  have hs (x : String) (hx : x∈scalarNames r):
      (callState r σ a b out).vars x=σ.vars x := callState_shared h.private_names σ a b out x hx
  have heq:(callState r σ a b out).vars (innerNames r).e=F.e:=
    (hs r.e (by simp [scalarNames])).trans h.degree
  have hpq:(callState r σ a b out).vars (innerNames r).p=F.p:=
    (hs r.p (by simp [scalarNames])).trans h.prime
  have hmq:(callState r σ a b out).vars (innerNames r).modBase=σ.vars r.modBase:=
    hs r.modBase (by simp [scalarNames])
  have hav:=callState_arguments h.inner_names σ a b out
  rw [h.degree] at hav
  have hab:2≤a ∧ a≤4:=by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at ha; omega
  have hbb:2≤b ∧ b≤4:=by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hb; omega
  have hob:2≤out ∧ out≤4:=by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at ho; omega
  refine {
    scalar_names:=h.inner_names, degree_pos:=?_, arithmetic_word:=?_,
    memory_word:=h.scratch_word, modulus_word:=h.memory_word, scratch_word:=h.scratch_word,
    scratch_fit:=?_, first_fit:=?_, second_fit:=?_, modulus_fit:=?_, output_fit:=?_,
    first_separate:=?_, second_separate:=?_, modulus_separate:=Or.inl h.separate,
    output_separate:=?_, coefficients:=?_ }
  · simpa only [heq] using F.degree_pos
  · simpa only [hpq] using h.arithmetic_word
  · change 2*(callState r σ a b out).vars (innerNames r).e ≤ (σ.arrs r.scratch).length
    rw [heq]; have hf:=h.scratch_fit; omega
  · change (callState r σ a b out).vars (innerNames r).aBase+
      (callState r σ a b out).vars (innerNames r).e ≤ (σ.arrs r.scratch).length
    rw [hav.1,heq]; have hf:=h.scratch_fit; nlinarith
  · change (callState r σ a b out).vars (innerNames r).bBase+
      (callState r σ a b out).vars (innerNames r).e ≤ (σ.arrs r.scratch).length
    rw [hav.2.1,heq]; have hf:=h.scratch_fit; nlinarith
  · change (callState r σ a b out).vars (innerNames r).modBase+
      (callState r σ a b out).vars (innerNames r).e ≤ (σ.arrs r.mem).length
    rw [hmq,heq]; exact h.modulus_fit
  · change (callState r σ a b out).vars (innerNames r).outBase+
      (callState r σ a b out).vars (innerNames r).e ≤ (σ.arrs r.scratch).length
    rw [hav.2.2,heq]; have hf:=h.scratch_fit; nlinarith
  · exact Or.inr (by rw [heq,hav.1]; nlinarith)
  · exact Or.inr (by rw [heq,hav.2.1]; nlinarith)
  · exact Or.inr (by rw [heq,hav.2.2]; nlinarith)
  · intro j hj
    rw [heq] at hj
    change (σ.arrs r.scratch).getD ((callState r σ a b out).vars (innerNames r).aBase+j) 0<
      (callState r σ a b out).vars (innerNames r).p ∧
      (σ.arrs r.scratch).getD ((callState r σ a b out).vars (innerNames r).bBase+j) 0<
      (callState r σ a b out).vars (innerNames r).p ∧
      (σ.arrs r.mem).getD ((callState r σ a b out).vars (innerNames r).modBase+j) 0<
      (callState r σ a b out).vars (innerNames r).p
    rw [hav.1,hav.2.1,hpq,hmq]
    refine ⟨h.buffer_canonical a ha j hj,h.buffer_canonical b hb j hj,?_⟩
    have hm:=h.modulus_value ⟨j,hj⟩
    exact hm.trans_lt (F.modulus ⟨j,hj⟩).isLt
theorem BufferInput.multiply_run {K : Type} [Field K]
    {F : Problem18AllFormatRoot20260930.FieldPresentation K}
    {r : FieldNames} {B : Nat} {σ : Env} (h : BufferInput F r B σ)
    {a b out : Nat} (ha : a∈[2,3,4]) (hb : b∈[2,3,4]) (ho : out∈[2,3,4]) :
    Run B (multiplyInto r a b out) σ (callResult r σ a b out) (11000*(F.e+1)^2) := by
  have hn:=h.private_names r.e (by simp [scalarNames])
  simp only [callWrites,List.mem_cons,List.not_mem_nil,or_false,not_or] at hn
  have hab:2≤a ∧ a≤4:=by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at ha; omega
  have hbb:2≤b ∧ b≤4:=by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hb; omega
  have hob:2≤out ∧ out≤4:=by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at ho; omega
  have he:=F.degree_pos
  have hf:=h.scratch_fit
  have hw:=h.scratch_word
  have hr:=multiplyInto_run r (B:=B) σ a b out ⟨by tauto,by tauto,by tauto⟩
    (by rw [h.degree]; omega) (by omega)
    (by rw [h.degree]; constructor; nlinarith; constructor <;> nlinarith)
    (h.mulInput ha hb ho)
  simpa only [h.degree] using hr
