theorem primary_restrictions_nondegenerate
    (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hn : B.Nondegenerate)
    (S : Module.End K V) (hS : ∀ x y,B (S x) y=B x (S y))
    (f g : K[X]) (hc : IsCoprime f g) (hχ : S.charpoly=f*g) :
    (B.restrict (LinearMap.ker (aeval S f))).Nondegenerate ∧
      (B.restrict (LinearMap.ker (aeval S g))).Nondegenerate := by
  have h := bilinear_primarySpaces_nondegenerate_of_charpoly_eq_mul hB.isRefl hn hS hc 1 1
    (by simpa only [pow_one] using hχ)
  change (B.domRestrict₁₂ (LinearMap.ker (aeval S (f^1))) (LinearMap.ker (aeval S (f^1)))).Nondegenerate ∧
    (B.domRestrict₁₂ (LinearMap.ker (aeval S (g^1))) (LinearMap.ker (aeval S (g^1)))).Nondegenerate at h
  rw [pow_one,pow_one] at h
  exact h
theorem exists_intrinsic_primary_coordinates
    (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hn : B.Nondegenerate)
    (S : Module.End K V) (hS : ∀ x y,B (S x) y=B x (S y))
    (f g : K[X]) (hf : f.Monic) (hg : g.Monic) (hc : IsCoprime f g)
    (hχ : S.charpoly=f*g) :
    ∃ e : (LinearMap.ker (aeval S f) × LinearMap.ker (aeval S g)) ≃ₗ[K] V,
      (∀ x y,B (e x) (e y)=B x.1.val y.1.val+B x.2.val y.2.val) ∧
      (∀ x,e ((S.restrict (primary_kernel_invariant S f)) x.1,
          (S.restrict (primary_kernel_invariant S g)) x.2)=S (e x)) ∧
      (S.restrict (primary_kernel_invariant S f)).charpoly=f ∧
      (S.restrict (primary_kernel_invariant S g)).charpoly=g ∧
      (B.restrict (LinearMap.ker (aeval S f))).Nondegenerate ∧
      (B.restrict (LinearMap.ker (aeval S g))).Nondegenerate := by
  let e := Submodule.prodEquivOfIsCompl (LinearMap.ker (aeval S f))
    (LinearMap.ker (aeval S g)) (isCompl_primarySpaces_of_charpoly_eq_mul hc hχ)
  refine ⟨e,?_,?_,coprime_primary_charpoly S f g hf hg hc hχ,
    coprime_primary_charpoly S g f hg hf hc.symm (hχ.trans (mul_comm f g)),
    primary_restrictions_nondegenerate B hB hn S hS f g hc hχ⟩
  · intro x y
    change B (x.1.val+x.2.val) (y.1.val+y.2.val)=_
    have hfg : B x.1.val y.2.val=0 := coprime_kernels_pairing_eq_zero hS hc x.1.property y.2.property
    have hgf : B x.2.val y.1.val=0 := coprime_kernels_pairing_eq_zero hS hc.symm x.2.property y.1.property
    simp only [map_add,LinearMap.add_apply,hfg,hgf,add_zero,zero_add]
  · intro x
    change S x.1.val+S x.2.val=S (x.1.val+x.2.val)
    exact (S.map_add _ _).symm
