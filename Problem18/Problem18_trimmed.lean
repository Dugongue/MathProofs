theorem actual_primary_projector (S : Module.End K V) (p q : K[X])
    (hc : IsCoprime p q) (hχ : S.charpoly=p*q) :
    ∃ e : K[X],e.degree<(Module.finrank K V:WithBot ℕ) ∧
      LinearMap.range (aeval S e)=LinearMap.ker (aeval S p) ∧
      (aeval S e).comp (aeval S e)=aeval S e ∧
      (∀ x∈LinearMap.ker (aeval S p),(aeval S e) x=x) ∧
      (∀ x∈LinearMap.ker (aeval S q),(aeval S e) x=0) := by
  obtain ⟨e,he,hp,hq⟩ := exists_finrank_bounded_crt_projector_polynomial (S:=S) hc
  change ∀ x ∈ LinearMap.ker (aeval S p),(aeval S e) x=x at hp
  change ∀ x ∈ LinearMap.ker (aeval S q),(aeval S e) x=0 at hq
  let U := LinearMap.ker (aeval S p)
  let Z := LinearMap.ker (aeval S q)
  have hcomp : IsCompl U Z := isCompl_primarySpaces_of_charpoly_eq_mul hc hχ
  let E := Submodule.prodEquivOfIsCompl U Z hcomp
  have hrange : LinearMap.range (aeval S e)=U := by
    ext y
    constructor
    · rintro ⟨x,rfl⟩
      obtain ⟨⟨u,z⟩,rfl⟩ := E.surjective x
      change (aeval S e) (u.val+z.val)∈U
      rw [map_add,hp u.val u.property,hq z.val z.property,add_zero]
      exact u.property
    · intro hy
      exact ⟨y,hp y hy⟩
  refine ⟨e,he,hrange,?_,hp,hq⟩
  apply LinearMap.ext
  intro x
  apply hp
  change (aeval S e) x∈U
  rw [←hrange]
  exact LinearMap.mem_range_self (aeval S e) x
theorem primary_operator_properties (S : Module.End K V) (p : K[X])
    (hm : p.Monic) (hp : p.coeff 0≠0) (hdvd : p∣S.charpoly)
    (hc : IsCoprime p (S.charpoly/p)) :
    Module.finrank K (LinearMap.ker (aeval S p))=p.natDegree ∧
      (S.restrict (primary_kernel_invariant S p)).charpoly=p ∧
      Function.Bijective (S.restrict (primary_kernel_invariant S p)) ∧
      ∃ e : K[X],e.degree<(Module.finrank K V:WithBot ℕ) ∧
        LinearMap.range (aeval S e)=LinearMap.ker (aeval S p) ∧
        (aeval S e).comp (aeval S e)=aeval S e := by
  have hχ : S.charpoly=p*(S.charpoly/p) := (EuclideanDomain.mul_div_cancel' hm.ne_zero hdvd).symm
  have hq : (S.charpoly/p).Monic := hm.of_mul_monic_left (hχ ▸ S.charpoly_monic)
  have hr := coprime_primary_charpoly S p (S.charpoly/p) hm hq hc hχ
  obtain ⟨e,he,her,hei,_,_⟩ := actual_primary_projector S p (S.charpoly/p) hc hχ
  refine ⟨?_,hr,primary_restriction_bijective S p hp (primary_kernel_invariant S p),e,he,her,hei⟩
  simpa only [LinearMap.charpoly_natDegree] using congrArg Polynomial.natDegree hr
theorem ordinary_primary_regular (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (hnB : B.Nondegenerate) (S : Module.End K V) (hS : ∀ x y,B (S x) y=B x (S y))
    (p : K[X]) (hdvd : p∣S.charpoly) (hc : IsCoprime p (S.charpoly/p)) (hp : p≠0) :
    (B.restrict (LinearMap.ker (aeval S p))).Nondegenerate := by
  have hχ : S.charpoly=p*(S.charpoly/p) := (EuclideanDomain.mul_div_cancel' hp hdvd).symm
  exact (Mathproof.Problem18IntrinsicPrimarySplit20261001.primary_restrictions_nondegenerate
    B hB hnB S hS p (S.charpoly/p) hc hχ).1
theorem hermitian_primary_regular [Fintype K] [StarRing K]
    {F : Type*} [Field F] [Fintype F] [Algebra F K]
    (hcard : Nat.card K=Nat.card F^2) (hstar : ∀ x : K,star x=x^Nat.card F)
    (B : V →ₗ⋆[K] V →ₗ[K] K) (hB : B.IsSymm) (hnB : B.Nondegenerate)
    (S : Module.End K V) (hS : ∀ x y,B (S x) y=B x (S y))
    (p : K[X]) (hp : p≠0) (hfix : p.map (starRingAut : K ≃+* K).toRingHom=p)
    (hdvd : p∣S.charpoly) (hc : IsCoprime p (S.charpoly/p)) :
    (B.domRestrict₁₂ (LinearMap.ker (aeval S p)) (LinearMap.ker (aeval S p))).Nondegenerate := by
  have hχ : S.charpoly=p*(S.charpoly/p) := (EuclideanDomain.mul_div_cancel' hp hdvd).symm
