namespace Mathproof.Problem18PolynomialCovariantSpan20261001
open scoped BigOperators Polynomial Matrix
open Matrix FiniteFieldOrthogonalUnitaryTI
variable {K W : Type*} [Field K] [AddCommGroup W] [Module K W]
theorem linear_aeval_mem_span {c : ℕ} (hc : 0<c)
    (S : Matrix (Fin c) (Fin c) K) (L : Matrix (Fin c) (Fin c) K →ₗ[K] W)
    (p : K[X]) : L (Polynomial.aeval S p)∈
      Submodule.span K (Set.range (fun t : Fin c => L (S^t.val))) := by
  classical
  have hχ : S.charpoly≠1 := by
    intro he
    have hh := congrArg Polynomial.natDegree he
    simp only [Matrix.charpoly_natDegree_eq_dim,Fintype.card_fin,Polynomial.natDegree_one] at hh
    omega
  have hd : (p%ₘS.charpoly).natDegree<c := by
    simpa only [Matrix.charpoly_natDegree_eq_dim,Fintype.card_fin] using
      Polynomial.natDegree_modByMonic_lt p S.charpoly_monic hχ
  rw [Matrix.aeval_eq_aeval_mod_charpoly,Polynomial.aeval_eq_sum_range' hd,map_sum]
  apply Submodule.sum_mem
  intro i hi
  rw [map_smul]
  apply Submodule.smul_mem
  exact Submodule.subset_span ⟨⟨i,Finset.mem_range.mp hi⟩,rfl⟩
variable [StarRing K]
def weightedContraction {a b c : ℕ} (A : Matrix (Fin c) (Fin a×Fin b) K) :
    Matrix (Fin c) (Fin c) K →ₗ[K] Matrix (Fin b) (Fin b) K where
  toFun X := partialTraceRight ((Aᴴ*X*A).transpose)
  map_add' X Y := by
    simp only [Matrix.mul_add,Matrix.add_mul,Matrix.transpose_add,map_add]
  map_smul' k X := by
    simp only [Matrix.mul_smul,Matrix.smul_mul,Matrix.transpose_smul,map_smul,RingHom.id_apply]
def rightMoment {a b c : ℕ} (A : Matrix (Fin c) (Fin a×Fin b) K) (t : ℕ) :=
  weightedContraction A ((A*Aᴴ)^t)
theorem rightMoment_eq_partialTrace {a b c : ℕ}
    (A : Matrix (Fin c) (Fin a×Fin b) K) (t : ℕ) :
    rightMoment A t=partialTraceRight ((columnGramRecord A)^(t+1)) := by
  rw [columnGramRecord_power]
  rfl
theorem polynomial_contraction_mem_adjoin {a b c : ℕ} (hc : 0<c)
    (A : Matrix (Fin c) (Fin a×Fin b) K) (p : K[X]) :
    weightedContraction A (Polynomial.aeval (A*Aᴴ) p) ∈
      Algebra.adjoin K (Set.range (fun t : Fin c => rightMoment A t.val)) := by
  have h := linear_aeval_mem_span hc (A*Aᴴ) (weightedContraction A) p
  apply (show Submodule.span K (Set.range (fun t : Fin c => rightMoment A t.val)) ≤
      (Algebra.adjoin K (Set.range (fun t : Fin c => rightMoment A t.val))).toSubmodule from
    Submodule.span_le.mpr (fun _ hx => Algebra.subset_adjoin hx))
  exact h
theorem projector_pair_generation_suffices {a b c : ℕ} (hc : 0<c)
    (A : Matrix (Fin c) (Fin a×Fin b) K) (p : K[X])
    (hgen : Algebra.adjoin K
      ({weightedContraction A (Polynomial.aeval (A*Aᴴ) p),rightMoment A 0} :
        Set (Matrix (Fin b) (Fin b) K))=⊤) :
    Algebra.adjoin K (Set.range (fun t : Fin c => rightMoment A t.val))=⊤ := by
  apply top_unique
  rw [←hgen]
  apply Algebra.adjoin_le
  intro X hX
  rcases hX with rfl | hX
  · exact polynomial_contraction_mem_adjoin hc A p
  · have he : X=rightMoment A 0 := Set.mem_singleton_iff.mp hX
    rw [he]
    exact Algebra.subset_adjoin ⟨⟨0,hc⟩,rfl⟩
end Mathproof.Problem18PolynomialCovariantSpan20261001
end
