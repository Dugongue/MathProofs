  (hφ : ∀ c, φ (algebraMap k F c)=algebraMap k F (τ c))
  (hcompat : ∀ x, θ (algebraMap F L x)=algebraMap F L (φ x))
include hcompat in
theorem restrict_pullback (Q : Place k L) :
    restrictPlace k F L (pullbackPlace k L θ τ hθ Q)=
      pullbackPlace k F φ τ hφ (restrictPlace k F L Q) := by
  ext x
  change x∈restrictPlace k F L (pullbackPlace k L θ τ hθ Q) ↔
    x∈pullbackPlace k F φ τ hφ (restrictPlace k F L Q)
  simp only [mem_restrictPlace,mem_pullbackPlace,hcompat]
def semilinearFiberEquiv (P : Place k F) (hP : pullbackPlace k F φ τ hφ P=P) :
    PlaceFiber k F L P ≃ PlaceFiber k F L P :=
  (placePullbackEquiv k L θ τ hθ).subtypeEquiv fun Q => by
    change restrictPlace k F L Q=P ↔
      restrictPlace k F L (pullbackPlace k L θ τ hθ Q)=P
    calc
      _ ↔ pullbackPlace k F φ τ hφ (restrictPlace k F L Q) = pullbackPlace k F φ τ hφ P :=
        (placePullbackEquiv k F φ τ hφ).injective.eq_iff.symm
      _ ↔ _ := by rw [restrict_pullback k F L θ φ τ hθ hφ hcompat,hP]
variable [FiniteDimensional F L] [IsGalois F L]
theorem semilinear_fiber_fixed_sum (P : Place k F)
    (hP : pullbackPlace k F φ τ hφ P=P) :
    ∑ σ : L ≃ₐ[F] L, Nat.card {Q : PlaceFiber k F L P //
      semilinearFiberEquiv k F L θ φ τ hθ hφ hcompat P hP (σ • Q)=Q}
      =Nat.card (L ≃ₐ[F] L) := by
  letI : Fintype (PlaceFiber k F L P) := Fintype.ofFinite _
  exact twisted_fixed_point_sum (L ≃ₐ[F] L) (PlaceFiber k F L P)
    (semilinearFiberEquiv k F L θ φ τ hθ hφ hcompat P hP)
theorem semilinear_fiber_fixed_iff (P : Place k F)
    (hP : pullbackPlace k F φ τ hφ P=P) (σ : L ≃ₐ[F] L) (Q : PlaceFiber k F L P) :
    semilinearFiberEquiv k F L θ φ τ hθ hφ hcompat P hP (σ • Q)=Q ↔
      ∀ x, Q.val.valuation (σ.symm (θ x))=Q.val.valuation x := by
  let ψ := θ.trans σ.symm.toRingEquiv
  have hψ (c : k) : ψ (algebraMap k L c)=algebraMap k L (τ c) := by
    change σ.symm (θ (algebraMap k L c))=algebraMap k L (τ c)
    rw [hθ,IsScalarTower.algebraMap_apply k F L,σ.symm.commutes]
  have he : (semilinearFiberEquiv k F L θ φ τ hθ hφ hcompat P hP (σ • Q)).val=
      pullbackPlace k L ψ τ hψ Q.val := by
    ext x
    change x∈pullbackPlace k L θ τ hθ (galoisPlace k F L σ Q.val) ↔
      x∈pullbackPlace k L ψ τ hψ Q.val
    simp only [mem_pullbackPlace,mem_galoisPlace]
    rfl
  rw [Subtype.ext_iff,he,pullback_eq_iff_valuation_invariant]
  rfl
