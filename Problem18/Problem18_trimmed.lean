local instance [Finite V] : Finite (Module.End K V) := Finite.of_injective
  (fun A : Module.End K V => (A : V → V)) DFunLike.coe_injective
local instance [Finite V] [Finite W] : Finite (V →ₗ[K] V × W) := Finite.of_injective
  (fun j : V →ₗ[K] V × W => (j : V → V × W)) DFunLike.coe_injective
theorem markings_card_lower [Finite V] [Finite W]
    (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft) (f : K[X])
    (T : SelfAdjointOperators σ (sumForm σ B C)) (M : SpectralMarkings σ B C f T) :
    Nat.card (Isometries σ B) ≤ Nat.card (SpectralMarkings σ B C f T) := by
  let X := {j : EmbeddingOrbit σ B C // LinearMap.range j.val=LinearMap.range M.1.val}
  let F : X → SpectralMarkings σ B C f T := fun j =>
    ⟨j.val,⟨Classical.choose (same_range_marking_exists σ B C hB f T M j.val j.property),
      Classical.choose_spec (same_range_marking_exists σ B C hB f T M j.val j.property)⟩⟩
  have hi : Function.Injective F := by
    intro j k he
    apply Subtype.ext
