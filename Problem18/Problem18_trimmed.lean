section
set_option backward.isDefEq.respectTransparency false
namespace Mathproof.Problem18IMPSourceDispatch20261001
open Lax13Proofs.Imp Lax13Proofs.Reasoning Lax13Proofs.Compile
open Problem18TensorSorting20261001 Problem18EncodedSourceCheck20261001
def leCom (x y : String) (yes no : Com) : Com :=
  .ite (.lt (.var y) (.var x)) no yes
def sortCom (f : Order → Com) : Com :=
  leCom "a" "b"
    (leCom "b" "c" (f .abc) (leCom "a" "c" (f .acb) (f .cab)))
    (leCom "a" "c" (f .bac) (leCom "b" "c" (f .bca) (f .cba)))
def orderCode : Order → Nat
  | .abc=>0 | .acb=>1 | .bac=>2 | .bca=>3 | .cab=>4 | .cba=>5
def minimumName : Order → String
  | .abc | .acb=>"a" | .bac | .bca=>"b" | .cab | .cba=>"c"
def middleName : Order → String
  | .abc | .cba=>"b" | .acb | .bca=>"c" | .bac | .cab=>"a"
def branchCom (B : Nat) (o : Order) : Com :=
  .ite (.lt (.var (middleName o)) (.lit B)) (.write (.lit 1))
    (.ite (.eq (.var (minimumName o)) (.lit 1)) (.write (.lit 2)) (.write (.lit 3)))
def leafCom (B : Nat) (o : Order) : Com :=
  .seq (.write (.lit (orderCode o))) (branchCom B o)
def routeCom (B : Nat) : Com :=
  .ite (.eq (.var "tag") (.lit 0)) (sortCom (leafCom B)) (.write (.lit 0))
def routeWords (B tag a b c : Nat) : List Nat :=
  if tag=0 then [orderCode (sortOrder a b c),branch B a b c] else [0]
theorem leCom_run (W : Nat) (σ τ : Env) (x y : String) (yes no : Com)
    (T : Nat) (hx : σ.vars x<W) (hy : σ.vars y<W)
    (h : Run W (if σ.vars x≤σ.vars y then yes else no) σ τ T) :
    Run W (leCom x y yes no) σ τ (T+4) := by
  have he := evalB_condLt (evalB_var hy) (evalB_var hx)
  by_cases hh : σ.vars x≤σ.vars y
  · have hc : (Cond.lt (.var y) (.var x)).evalB W σ=some false := by
      simpa only [show ¬σ.vars y<σ.vars x by omega,decide_false] using he
    have hr := Run.ite_false (c:=no) hc (by simpa only [if_pos hh] using h)
    simpa [leCom,Cond.size,Expr.size,Nat.add_comm] using hr
  · have hc : (Cond.lt (.var y) (.var x)).evalB W σ=some true := by
      simpa only [show σ.vars y<σ.vars x by omega,decide_true] using he
    have hr := Run.ite_true (d:=yes) hc (by simpa only [if_neg hh] using h)
    simpa [leCom,Cond.size,Expr.size,Nat.add_comm] using hr
theorem sortCom_run (W : Nat) (σ τ : Env) (f : Order → Com) (T : Nat)
    (ha : σ.vars "a"<W) (hb : σ.vars "b"<W) (hc : σ.vars "c"<W)
    (h : Run W (f (sortOrder (σ.vars "a") (σ.vars "b") (σ.vars "c"))) σ τ T) :
    Run W (sortCom f) σ τ (T+12) := by
  unfold sortCom
  apply leCom_run W σ τ "a" "b" _ _ (T+8) ha hb
  by_cases hab : σ.vars "a"≤σ.vars "b"
  · simp only [if_pos hab]
    apply leCom_run W σ τ "b" "c" _ _ (T+4) hb hc
    by_cases hbc : σ.vars "b"≤σ.vars "c"
    · have hh : Run W (f .abc) σ τ T := by simpa only [sortOrder,if_pos hab,if_pos hbc] using h
      simpa only [if_pos hbc] using hh.mono (Nat.le_add_right T 4)
    · simp only [if_neg hbc]
      apply leCom_run W σ τ "a" "c" _ _ T ha hc
      simpa only [sortOrder,if_pos hab,if_neg hbc,apply_ite f] using h
  · simp only [if_neg hab]
    apply leCom_run W σ τ "a" "c" _ _ (T+4) ha hc
    by_cases hac : σ.vars "a"≤σ.vars "c"
    · have hh : Run W (f .bac) σ τ T := by simpa only [sortOrder,if_neg hab,if_pos hac] using h
      simpa only [if_pos hac] using hh.mono (Nat.le_add_right T 4)
    · simp only [if_neg hac]
      apply leCom_run W σ τ "b" "c" _ _ T hb hc
      simpa only [sortOrder,if_neg hab,if_neg hac,apply_ite f] using h
def branchValue (B : Nat) (o : Order) (σ : Env) : Nat :=
  if σ.vars (middleName o)<B then 1 else if σ.vars (minimumName o)=1 then 2 else 3
theorem branchCom_run (B W : Nat) (σ : Env) (o : Order)
    (hW : 5<W) (hB : B<W) (hv : ∀x,σ.vars x<W) :
    Run W (branchCom B o) σ {σ with out:=σ.out++[branchValue B o σ]} 10 := by
  have ht := evalB_condLt (evalB_var (hv (middleName o))) (evalB_lit hB)
  have he := evalB_condEq (evalB_var (hv (minimumName o))) (evalB_lit (by omega : 1<W))
  have hw (n : Nat) (hn : n<W) : Run W (.write (.lit n)) σ {σ with out:=σ.out++[n]} 2 :=
    Run.write (evalB_lit hn)
  by_cases hs : σ.vars (middleName o)<B
  · have hc : (Cond.lt (.var (middleName o)) (.lit B)).evalB W σ=some true := by simpa [hs] using ht
    have hr := Run.ite_true (d:=.ite (.eq (.var (minimumName o)) (.lit 1)) (.write (.lit 2)) (.write (.lit 3))) hc (hw 1 (by omega))
    simpa only [branchCom,branchValue,if_pos hs] using hr.mono (by simp [Cond.size,Expr.size])
  · have hc : (Cond.lt (.var (middleName o)) (.lit B)).evalB W σ=some false := by simpa [hs] using ht
    by_cases heq : σ.vars (minimumName o)=1
    · have hc' : (Cond.eq (.var (minimumName o)) (.lit 1)).evalB W σ=some true := by simpa [heq] using he
      have hr := Run.ite_false (c:=.write (.lit 1)) hc (Run.ite_true (d:=.write (.lit 3)) hc' (hw 2 (by omega)))
      simpa only [branchCom,branchValue,if_neg hs,if_pos heq] using hr.mono (by simp [Cond.size,Expr.size])
    · have hc' : (Cond.eq (.var (minimumName o)) (.lit 1)).evalB W σ=some false := by simpa [heq] using he
      have hr := Run.ite_false (c:=.write (.lit 1)) hc (Run.ite_false (c:=.write (.lit 2)) hc' (hw 3 (by omega)))
      simpa only [branchCom,branchValue,if_neg hs,if_neg heq] using hr.mono (by simp [Cond.size,Expr.size])
theorem branchValue_sorted (B : Nat) (σ : Env) :
    branchValue B (sortOrder (σ.vars "a") (σ.vars "b") (σ.vars "c")) σ=
      branch B (σ.vars "a") (σ.vars "b") (σ.vars "c") := by
  generalize ho : sortOrder (σ.vars "a") (σ.vars "b") (σ.vars "c")=o
  cases o <;> simp [branchValue,branch,ho,shape,minimumName,middleName]
theorem leafCom_run (B W : Nat) (σ : Env) (o : Order)
    (hW : 5<W) (hB : B<W) (hv : ∀x,σ.vars x<W) :
    Run W (leafCom B o) σ
      {σ with out:=σ.out++[orderCode o,branchValue B o σ]} 12 := by
  have ho : orderCode o<W := by cases o <;> simp [orderCode] <;> omega
  have hw := Run.write (σ:=σ) (evalB_lit ho)
  have hb := branchCom_run B W {σ with out:=σ.out++[orderCode o]} o hW hB hv
  simpa [leafCom,branchValue,List.append_assoc] using hw.seq hb
theorem routeCom_run (B W : Nat) (σ : Env) (hW : 5<W) (hB : B<W)
    (hv : ∀x,σ.vars x<W) :
    Run W (routeCom B) σ
      {σ with out:=σ.out++routeWords B (σ.vars "tag") (σ.vars "a") (σ.vars "b") (σ.vars "c")} 40 := by
  have ht := evalB_condEq (evalB_var (hv "tag")) (evalB_lit (by omega : 0<W))
  by_cases htag : σ.vars "tag"=0
  · have hc : (Cond.eq (.var "tag") (.lit 0)).evalB W σ=some true := by simpa [htag] using ht
    have hl := leafCom_run B W σ (sortOrder (σ.vars "a") (σ.vars "b") (σ.vars "c")) hW hB hv
    have hs := sortCom_run W σ _ (leafCom B) 12 (hv "a") (hv "b") (hv "c") hl
    have hr := Run.ite_true (d:=.write (.lit 0)) hc hs
    simpa [routeCom,routeWords,htag,branchValue_sorted] using hr.mono (by simp [Cond.size,Expr.size])
  · have hc : (Cond.eq (.var "tag") (.lit 0)).evalB W σ=some false := by simpa [htag] using ht
    have hw := Run.write (σ:=σ) (evalB_lit (by omega : 0<W))
    have hr := Run.ite_false (c:=sortCom (leafCom B)) hc hw
    simpa [routeCom,routeWords,htag] using hr.mono (by simp [Cond.size,Expr.size])
theorem orderCode_lt (o : Order) : orderCode o<6 := by cases o <;> simp [orderCode]
theorem routeWords_source (B a b c : Nat) :
