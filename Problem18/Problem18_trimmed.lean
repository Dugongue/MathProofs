variable {K : Type*} [Field K] [BEq K] [LawfulBEq K] [DecidableEq K]
def degreeCheck (n : ℕ) (A D : Array K) (f : CPolynomial K) (q d : ℕ) : Bool :=
  let g := frobeniusGcd f q d
  let H := evaluate n A (CPolynomial.div f g)
  let P := (power n D (q^d/2)).1
  decide ((matrix n P-1)*matrix n H=0)
theorem toLin_product_zero_iff {n : ℕ} (S D : Matrix (Fin n) (Fin n) K)
    (p : K[X]) (e : ℕ) :
    (D^e-1)*aeval S p=0 ↔ (D.toLin'^e-1)*aeval S.toLin' p=0 := by
  let E := Matrix.toLinAlgEquiv' (n:=Fin n) (R:=K)
  have hh : E ((D^e-1)*aeval S p)=(D.toLin'^e-1)*aeval S.toLin' p := by
    rw [map_mul,map_sub,map_pow,map_one,← aeval_algHom_apply]
    rfl
  rw [← hh,← map_zero E]
  exact E.injective.eq_iff.symm
theorem degreeCheck_correct (n : ℕ) (A D : Array K) (f : CPolynomial K)
    (hf : f.toPoly=(matrix n A).charpoly) (hs : Squarefree (matrix n A).charpoly)
    (q d : ℕ) :
    degreeCheck n A D f q d=true ↔
      LinearMap.ker (aeval (matrix n A).toLin' (frobeniusGcd f q d).toPoly) ≤
        LinearMap.ker ((matrix n D).toLin'^(q^d/2)-1) := by
  rw [degreeCheck,decide_eq_true_eq,power_correct,evaluate_correct,CPolynomial.div_toPoly_eq_div,
    toLin_product_zero_iff]
  have hg : (frobeniusGcd f q d).toPoly ∣ (matrix n A).toLin'.charpoly := by
    rw [Matrix.charpoly_toLin',← hf]
    exact ((frobeniusGcd_dvd_iff f q d _).mp dvd_rfl).1
  rw [hf,← Matrix.charpoly_toLin']
  have hk := ker_eq_range_complement (matrix n A).toLin'
    (by simpa only [Matrix.charpoly_toLin'] using hs)
    (frobeniusGcd f q d).toPoly
    ((matrix n A).toLin'.charpoly/(frobeniusGcd f q d).toPoly)
    (EuclideanDomain.mul_div_cancel'
      (ne_zero_of_dvd_ne_zero (matrix n A).toLin'.charpoly_monic.ne_zero hg) hg).symm
  rw [hk]
  exact LinearMap.range_le_ker_iff.symm
def allChecks (n : ℕ) (A D : Array K) (f : CPolynomial K) (q : ℕ) : Bool :=
  (List.range n).all (fun i => degreeCheck n A D f q (i+1))
theorem allChecks_correct [Fintype K] (n : ℕ) (A D : Array K) (f : CPolynomial K)
    (hf : f.toPoly=(matrix n A).charpoly) (hs : Squarefree (matrix n A).charpoly) :
    allChecks n A D f (Nat.card K)=true ↔
      Mathproof.Problem18OddCyclicFormDecision20260930.KernelSquareTests
        (matrix n A).toLin' (matrix n D).toLin' := by
  rw [allChecks,List.all_eq_true]
  simp only [List.mem_range,degreeCheck_correct n A D f hf hs]
  have hh := finite_computed_tests_iff (matrix n A).toLin' (matrix n D).toLin' f
    (by simpa only [Matrix.charpoly_toLin'] using hf)
  refine Iff.trans ?_ hh
  constructor
  · intro h i
    exact h i.val (by simpa using i.isLt)
  · intro h i hi
    exact h ⟨i,by simpa using hi⟩
end Mathproof.Problem18ArrayBoundaryProducts20260930
end
section
