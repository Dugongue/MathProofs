  · simpa [W,ext,words] using hfull
  · have hsigmaOut : (afterRoutedHeader ext words).out = [] := by
      simpa [words] using hf.2.2.2.2.2.2.2.2.2.2.2.2
    simpa [Mathproof.Problem18RAMAnswerCodec20261001.answerWords,hsigmaOut]
      using hout
