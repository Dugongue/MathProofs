          modelTraceForm g (fun i => (ce.1 i).val) := by
        apply LinearMap.ext
        intro x
        apply LinearMap.ext
        intro y
        have hh := frame_trace g hm hcop B hB hnB (traceOperator g hm hcop B ce.1 ce.2)
