  have hcn:=Nat.mul_le_mul_right n (show 37+(fieldMacros F).costPoint ≤ 38*macroBudget F by omega)
  have hn:=Nat.mul_le_mul_right n (show 39+(fieldMacros F).costPoint ≤ 40*macroBudget F by omega)
  have hs:47+21*F.e+(37+(fieldMacros F).costPoint)*n ≤ (68+38*n)*macroBudget F:=by nlinarith
