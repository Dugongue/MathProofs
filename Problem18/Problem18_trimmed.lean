variable {K : Type*} [Field K] [DecidableEq K] {n m : ℕ}
def equationMap (S T : Fin m→Matrix (Fin n) (Fin n) K) :
    Matrix (Fin n) (Fin n) K→ₗ[K](Fin (m*(n*n))→K) where
  toFun X t :=
    let sj:=finProdFinEquiv.symm t
    let ij:=finProdFinEquiv.symm sj.2
    (X*S sj.1-T sj.1*X) ij.1 ij.2
  map_add' X Y := by
    funext t
    simp only [Matrix.add_mul,Matrix.mul_add,Matrix.sub_apply,Matrix.add_apply,Pi.add_apply]
    ring
  map_smul' c X := by
    funext t
    simp only [Matrix.smul_mul,Matrix.mul_smul,Matrix.sub_apply,Matrix.smul_apply,Pi.smul_apply,
      smul_eq_mul,RingHom.id_apply]
    ring
def equationMatrix (S T : Fin m→Matrix (Fin n) (Fin n) K) :
    Matrix (Fin (m*(n*n))) (Fin (n*n)) K :=
  LinearMap.toMatrix' ((equationMap S T).comp encoding.symm.toLinearMap)
theorem equationMap_zero_iff (S T : Fin m→Matrix (Fin n) (Fin n) K)
    (X : Matrix (Fin n) (Fin n) K) :
    equationMap S T X=0 ↔ ∀j,X*S j=T j*X := by
  constructor
  · intro h j
    apply sub_eq_zero.mp
    ext i k
    have he:=congrFun h (finProdFinEquiv (j,finProdFinEquiv (i,k)))
    simpa only [equationMap,LinearMap.coe_mk,AddHom.coe_mk,Equiv.symm_apply_apply,
      Pi.zero_apply,Matrix.zero_apply] using he
  · intro h
    funext t
    simp only [equationMap,LinearMap.coe_mk,AddHom.coe_mk,h,sub_self,Matrix.zero_apply,
      Pi.zero_apply]
theorem equationMatrix_zero_iff (S T : Fin m→Matrix (Fin n) (Fin n) K)
    (x : Fin (n*n)→K) :
    (equationMatrix S T).mulVec x=0 ↔ ∀j,encoding.symm x*S j=T j*encoding.symm x := by
  rw [equationMatrix,LinearMap.toMatrix'_mulVec]
  exact equationMap_zero_iff S T _
def intertwiner (S T : Fin m→Matrix (Fin n) (Fin n) K) :
    Option (Matrix (Fin n) (Fin n) K) :=
  (Problem18EliminationKernelWitness20261001.witness (equationMatrix S T)).map encoding.symm
theorem intertwiner_some (S T : Fin m→Matrix (Fin n) (Fin n) K)
    (X : Matrix (Fin n) (Fin n) K) (h : intertwiner S T=some X) :
    X≠0 ∧ ∀j,X*S j=T j*X := by
  obtain ⟨x,hx,rfl⟩:=Option.map_eq_some_iff.mp h
  have hh:=Problem18EliminationKernelWitness20261001.witness_some _ x hx
  refine ⟨?_,(equationMatrix_zero_iff S T x).mp hh.2⟩
  intro hz
  apply hh.1
  exact encoding.symm.injective (hz.trans (map_zero _).symm)
theorem intertwiner_none_iff (S T : Fin m→Matrix (Fin n) (Fin n) K) :
    intertwiner S T=none ↔ ∀X,(∀j,X*S j=T j*X) → X=0 := by
  rw [intertwiner,Option.map_eq_none_iff,
    Problem18EliminationKernelWitness20261001.witness_none_iff]
  constructor
  · intro h X hx
    have he:=h (encoding X) ((equationMatrix_zero_iff S T _).mpr (by simpa using hx))
    exact encoding.injective (he.trans (map_zero _).symm)
  · intro h x hx
    have he:=h (encoding.symm x) ((equationMatrix_zero_iff S T x).mp hx)
    exact encoding.symm.injective (he.trans (map_zero _).symm)
theorem intertwiner_isUnit [Nonempty (Fin n)] (S T : Fin m→Matrix (Fin n) (Fin n) K)
    (hgen : Algebra.adjoin K (Set.range S)=⊤) (X : Matrix (Fin n) (Fin n) K)
    (h : intertwiner S T=some X) : IsUnit X :=
  Problem18OrderedRecovery20260930.matrix_intertwiner_isUnit S T X
    (intertwiner_some S T X h).1 hgen (intertwiner_some S T X h).2
end Mathproof.Problem18ExecutableIntertwiner20261001
