open scoped TensorProduct
section GCore
variable {R0 : Type*} [CommRing R0]
noncomputable def ellM (a b : R0) : MvPolynomial (Fin 2) R0 :=
  MvPolynomial.X 1 - (MvPolynomial.C a + MvPolynomial.X 0 * MvPolynomial.C b)
noncomputable def sigmaP (a b : R0) : MvPolynomial (Fin 2) R0 →ₐ[R0] Polynomial R0 :=
  MvPolynomial.aeval ![Polynomial.X, Polynomial.C a + Polynomial.X * Polynomial.C b]
theorem sub_mem_span_ellM (a b : R0) (p : MvPolynomial (Fin 2) R0) :
    p - Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) R0) (sigmaP a b p) ∈
      Ideal.span {ellM a b} := by
  induction p using MvPolynomial.induction_on with
  | C r =>
    have h : Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) R0)
        (sigmaP a b (MvPolynomial.C r)) = MvPolynomial.C r := by
      simp [sigmaP, MvPolynomial.algebraMap_eq]
    rw [h, sub_self]
    exact zero_mem _
  | add p q hp hq =>
    rw [map_add, map_add, add_sub_add_comm]
    exact add_mem hp hq
  | mul_X p m hp =>
    have h : p * MvPolynomial.X m - Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) R0)
        (sigmaP a b (p * MvPolynomial.X m)) =
        (p - Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) R0) (sigmaP a b p)) *
          MvPolynomial.X m +
        Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) R0) (sigmaP a b p) *
          (MvPolynomial.X m - Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) R0)
            (sigmaP a b (MvPolynomial.X m))) := by
      rw [map_mul, map_mul]
      ring
    rw [h]
    refine add_mem (Ideal.mul_mem_right _ _ hp) (Ideal.mul_mem_left _ _ ?_)
    fin_cases m
    · have h0 : Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) R0)
          (sigmaP a b (MvPolynomial.X 0)) = MvPolynomial.X 0 := by
        rw [sigmaP, MvPolynomial.aeval_X]
        simp
      simp only [Fin.zero_eta]
      rw [h0, sub_self]
      exact zero_mem _
    · have h1 : Polynomial.aeval (MvPolynomial.X 0 : MvPolynomial (Fin 2) R0)
          (sigmaP a b (MvPolynomial.X 1)) =
          MvPolynomial.C a + MvPolynomial.X 0 * MvPolynomial.C b := by
        rw [sigmaP, MvPolynomial.aeval_X]
        simp [MvPolynomial.algebraMap_eq]
        ring
      simp only [Fin.mk_one]
      rw [h1]
      exact Ideal.subset_span (Set.mem_singleton _)
theorem mem_span_ellM_of_sigmaP_eq_zero (a b : R0) (p : MvPolynomial (Fin 2) R0)
    (hp : sigmaP a b p = 0) : p ∈ Ideal.span {ellM a b} := by
  have h := sub_mem_span_ellM a b p
  rwa [hp, map_zero, sub_zero] at h
end GCore
section Rho
variable {k : Type*} [Field k] {R0 : Type*} [CommRing R0] [IsDomain R0] [Algebra k R0]
noncomputable def kappa : Polynomial R0 →+* RatFunc (FractionRing R0) :=
  (algebraMap (Polynomial (FractionRing R0)) (RatFunc (FractionRing R0))).comp
    (Polynomial.mapRingHom (algebraMap R0 (FractionRing R0)))
theorem kappa_injective : Function.Injective (kappa (R0 := R0)) :=
  (RatFunc.algebraMap_injective (FractionRing R0)).comp
    (Polynomial.map_injective _ (IsFractionRing.injective R0 (FractionRing R0)))
noncomputable def genV (a b : R0) : Fin 2 → RatFunc (FractionRing R0) :=
  ![RatFunc.X, RatFunc.C (algebraMap R0 (FractionRing R0) a) +
    RatFunc.X * RatFunc.C (algebraMap R0 (FractionRing R0) b)]
variable (k) in
noncomputable def fR : R0 →ₐ[k] RatFunc (FractionRing R0) :=
  IsScalarTower.toAlgHom k R0 (RatFunc (FractionRing R0))
theorem fR_apply (r : R0) : fR k r = kappa (Polynomial.C r) := by
  simp [fR, kappa, IsScalarTower.algebraMap_apply R0 (Polynomial (FractionRing R0))
    (RatFunc (FractionRing R0)), Polynomial.algebraMap_apply]
noncomputable def fE (a b : R0) (hv : AlgebraicIndependent k (genV a b)) :
    FractionRing (MvPolynomial (Fin 2) k) →ₐ[k] RatFunc (FractionRing R0) :=
  (IntermediateField.adjoin k (Set.range (genV a b))).val.comp hv.aevalEquivField
theorem fE_algebraMap (a b : R0) (hv : AlgebraicIndependent k (genV a b))
    (p : MvPolynomial (Fin 2) k) :
    fE a b hv (algebraMap _ _ p) = MvPolynomial.aeval (genV a b) p := by
  simp [fE]
noncomputable def rho (a b : R0) (hv : AlgebraicIndependent k (genV a b)) :
    FractionRing (MvPolynomial (Fin 2) k) ⊗[k] R0 →ₐ[k] RatFunc (FractionRing R0) :=
  Algebra.TensorProduct.lift (fE a b hv) (fR k) (fun _ _ => Commute.all _ _)
variable (k) in
noncomputable def jj : MvPolynomial (Fin 2) R0 →+* FractionRing (MvPolynomial (Fin 2) k) ⊗[k] R0 :=
  MvPolynomial.eval₂Hom
    (Algebra.TensorProduct.includeRight : R0 →ₐ[k] FractionRing (MvPolynomial (Fin 2) k) ⊗[k] R0)
    (fun m => algebraMap (MvPolynomial (Fin 2) k) (FractionRing (MvPolynomial (Fin 2) k))
      (MvPolynomial.X m) ⊗ₜ[k] (1 : R0))
theorem rho_jj (a b : R0) (hv : AlgebraicIndependent k (genV a b)) (w : MvPolynomial (Fin 2) R0) :
    rho a b hv (jj k w) = kappa (sigmaP a b w) := by
  have h : (rho a b hv : _ →+* RatFunc (FractionRing R0)).comp (jj k) =
      (kappa (R0 := R0)).comp (sigmaP a b : MvPolynomial (Fin 2) R0 →+* Polynomial R0) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp only [RingHom.comp_apply, jj, MvPolynomial.eval₂Hom_C, RingHom.coe_coe]
      rw [Algebra.TensorProduct.includeRight_apply,
        rho, Algebra.TensorProduct.lift_tmul, map_one, one_mul, fR_apply, sigmaP,
        MvPolynomial.aeval_C]
      rfl
    · intro m
      simp only [RingHom.comp_apply, jj, MvPolynomial.eval₂Hom_X', RingHom.coe_coe]
      rw [rho, Algebra.TensorProduct.lift_tmul, map_one, mul_one, fE_algebraMap,
        MvPolynomial.aeval_X, sigmaP, MvPolynomial.aeval_X]
      fin_cases m
      · simp [genV, kappa, RatFunc.algebraMap_X]
      · simp [genV, kappa, RatFunc.algebraMap_X, RatFunc.algebraMap_C]
        ring
  exact congrArg (fun f => f w) h
theorem jj_map (p : MvPolynomial (Fin 2) k) :
    jj k (MvPolynomial.map (algebraMap k R0) p) =
      (Algebra.TensorProduct.includeLeft : FractionRing (MvPolynomial (Fin 2) k) →ₐ[k]
        FractionRing (MvPolynomial (Fin 2) k) ⊗[k] R0)
        (algebraMap (MvPolynomial (Fin 2) k) (FractionRing (MvPolynomial (Fin 2) k)) p) := by
  induction p using MvPolynomial.induction_on with
  | C c =>
    rw [MvPolynomial.map_C, jj, MvPolynomial.eval₂Hom_C]
    have hL : algebraMap (MvPolynomial (Fin 2) k) (FractionRing (MvPolynomial (Fin 2) k))
        (MvPolynomial.C c) = algebraMap k (FractionRing (MvPolynomial (Fin 2) k)) c := by
      rw [IsScalarTower.algebraMap_apply k (MvPolynomial (Fin 2) k)
        (FractionRing (MvPolynomial (Fin 2) k)), MvPolynomial.algebraMap_eq]
    rw [hL, AlgHom.commutes]
    exact (Algebra.TensorProduct.includeRight : R0 →ₐ[k] FractionRing (MvPolynomial (Fin 2) k) ⊗[k] R0).commutes c
  | add p q hp hq => rw [map_add, map_add, hp, hq, map_add, map_add]
  | mul_X p m hp =>
    rw [map_mul, MvPolynomial.map_X, map_mul, hp, map_mul, map_mul]
    congr 1
    rw [jj, MvPolynomial.eval₂Hom_X']
    rfl
end Rho
section Kernel
variable {k : Type*} [Field k] {R0 : Type*} [CommRing R0] [IsDomain R0] [Algebra k R0]
local notation "Ek" => FractionRing (MvPolynomial (Fin 2) k)
theorem exists_denom (z : Ek ⊗[k] R0) :
    ∃ s : MvPolynomial (Fin 2) k, s ≠ 0 ∧ ∃ w : MvPolynomial (Fin 2) R0,
      z = (Algebra.TensorProduct.includeLeft : Ek →ₐ[k] Ek ⊗[k] R0) ((algebraMap _ Ek s)⁻¹) *
        jj k w := by
  classical
  have hinj : Function.Injective (algebraMap (MvPolynomial (Fin 2) k) Ek) :=
    IsFractionRing.injective _ _
  induction z using TensorProduct.induction_on with
  | zero => exact ⟨1, one_ne_zero, 0, by rw [map_zero, mul_zero]⟩
  | tmul e r =>
    obtain ⟨p, s, hs, rfl⟩ := IsFractionRing.div_surjective (MvPolynomial (Fin 2) k) e
    refine ⟨s, nonZeroDivisors.ne_zero hs,
      MvPolynomial.map (algebraMap k R0) p * MvPolynomial.C r, ?_⟩
    rw [map_mul, jj_map]
    have hC : jj k (MvPolynomial.C r) = (1 : Ek) ⊗ₜ[k] r := by
      rw [jj, MvPolynomial.eval₂Hom_C]
      rfl
    rw [hC, Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.includeLeft_apply,
      Algebra.TensorProduct.tmul_mul_tmul, Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one,
      div_eq_inv_mul, one_mul]
  | add x y hx hy =>
    obtain ⟨s1, hs1, w1, rfl⟩ := hx
    obtain ⟨s2, hs2, w2, rfl⟩ := hy
    have h1 : algebraMap _ Ek s1 ≠ 0 := fun h => hs1 (hinj (h.trans (map_zero _).symm))
    have h2 : algebraMap _ Ek s2 ≠ 0 := fun h => hs2 (hinj (h.trans (map_zero _).symm))
    refine ⟨s1 * s2, mul_ne_zero hs1 hs2,
      w1 * MvPolynomial.map (algebraMap k R0) s2 + w2 * MvPolynomial.map (algebraMap k R0) s1, ?_⟩
    simp only [map_add, map_mul, jj_map]
    have e1 : (algebraMap _ Ek s1 * algebraMap _ Ek s2)⁻¹ * algebraMap _ Ek s2 =
        (algebraMap _ Ek s1)⁻¹ := by
      field_simp
    have e2 : (algebraMap _ Ek s1 * algebraMap _ Ek s2)⁻¹ * algebraMap _ Ek s1 =
        (algebraMap _ Ek s2)⁻¹ := by
      field_simp
    have g1 := congrArg (Algebra.TensorProduct.includeLeft (R := k) (S := k) (A := Ek) (B := R0)) e1
    have g2 := congrArg (Algebra.TensorProduct.includeLeft (R := k) (S := k) (A := Ek) (B := R0)) e2
    rw [map_mul] at g1 g2
    rw [← g1, ← g2]
    ring
theorem mem_span_of_rho_eq_zero (a b : R0) (hv : AlgebraicIndependent k (genV a b))
    (z : Ek ⊗[k] R0) (hz : rho a b hv z = 0) : z ∈ Ideal.span {jj k (ellM a b)} := by
  obtain ⟨s, hs, w, rfl⟩ := exists_denom z
  have hinj : Function.Injective (algebraMap (MvPolynomial (Fin 2) k) Ek) :=
    IsFractionRing.injective _ _
  have hs' : (algebraMap _ Ek s)⁻¹ ≠ 0 :=
    inv_ne_zero (fun h => hs (hinj (h.trans (map_zero _).symm)))
  rw [map_mul] at hz
  have hw : rho a b hv (jj k w) = 0 := by
    rcases mul_eq_zero.mp hz with h | h
    · exfalso
      apply hs'
      have h' : fE a b hv ((algebraMap _ Ek s)⁻¹) = 0 := by
        rw [← h, rho, Algebra.TensorProduct.includeLeft_apply, Algebra.TensorProduct.lift_tmul,
          map_one, mul_one]
      exact (map_eq_zero_iff _ (fE a b hv).toRingHom.injective).mp h'
    · exact h
  rw [rho_jj] at hw
  have hσ : sigmaP a b w = 0 := kappa_injective (hw.trans (map_zero _).symm)
  have hmem := mem_span_ellM_of_sigmaP_eq_zero a b w hσ
  have hmap : jj k w ∈ Ideal.span {jj k (ellM a b)} := by
    have := Ideal.mem_map_of_mem (jj k) hmem
    rwa [Ideal.map_span, Set.image_singleton] at this
  exact Ideal.mul_mem_left _ _ hmap
end Kernel
section Indep
open Mathproof.Problem18BertiniTwoVariable20261001
variable {k : Type*} [Field k]
theorem ratFunc_indep {F : Type*} [Field F] [Algebra k F] {x y : F}
    (hxy : AlgebraicIndependent k ![x, y]) :
    AlgebraicIndependent k ![(RatFunc.X : RatFunc F), RatFunc.C x + RatFunc.X * RatFunc.C y] := by
  classical
  let c : F →ₐ[k] RatFunc F := IsScalarTower.toAlgHom k F (RatFunc F)
  have hc : ∀ z : F, c z = RatFunc.C z := fun z => by
    rw [← RatFunc.algebraMap_eq_C]
    rfl
  have hcinj : Function.Injective c := c.toRingHom.injective
  have h2 : AlgebraicIndependent k ![RatFunc.C x, RatFunc.C y] := by
    have h := hxy.map' (f := c) hcinj
    convert h using 1
    funext m
    fin_cases m <;> simp [hc]
  have hne' : x ≠ y := by
    have := hxy.injective.ne (show (0 : Fin 2) ≠ 1 by decide)
    simpa using this
  have hne : (RatFunc.C x : RatFunc F) ≠ RatFunc.C y := fun h => hne' (by
    rw [← hc, ← hc] at h
    exact hcinj h)
  have h2' : AlgebraicIndepOn k id ({RatFunc.C x, RatFunc.C y} : Set (RatFunc F)) := by
    refine h2.to_subtype_range' ?_
    ext a
    simp only [Set.mem_range, Fin.exists_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one,
      Set.mem_insert_iff, Set.mem_singleton_iff]
    exact ⟨fun h => h.imp Eq.symm Eq.symm, fun h => h.imp Eq.symm Eq.symm⟩
  have hXF : Transcendental F (RatFunc.X : RatFunc F) := RatFunc.transcendental_X
  have hrange : ∀ z : RatFunc F, z ∈ c.fieldRange → IsAlgebraic F z := by
    rintro z ⟨w, rfl⟩
    exact isAlgebraic_algebraMap w
  have hle : IntermediateField.adjoin k ({RatFunc.C x, RatFunc.C y} : Set (RatFunc F)) ≤
      c.fieldRange := by
    rw [IntermediateField.adjoin_le_iff]
    intro z hz
    rcases hz with rfl | rfl
    · exact ⟨x, hc x⟩
    · exact ⟨y, hc y⟩
  have hFeq : ∀ z : RatFunc F, IsAlgebraic c.fieldRange z → IsAlgebraic F z := by
    intro z hz
    let e : F ≃+* c.fieldRange := (AlgEquiv.ofInjectiveField c).toRingEquiv
    exact (isAlgebraic_ringHom_iff_of_comp_eq e (RingHom.id (RatFunc F)) Function.injective_id
      (RingHom.ext fun _ => rfl)).mp hz
  have htr : Transcendental (IntermediateField.adjoin k
      ({RatFunc.C x, RatFunc.C y} : Set (RatFunc F))) (RatFunc.X : RatFunc F) := fun h =>
    hXF (hFeq _ (isAlgebraic_of_le hle h))
  have h3 := algebraicIndepOn_insert_of_transcendental h2' htr
  have hux : (RatFunc.X : RatFunc F) ∉ ({RatFunc.C x, RatFunc.C y} : Set (RatFunc F)) := by
    rintro (h | h)
    · exact hXF (by rw [h, ← hc]; exact isAlgebraic_algebraMap x)
    · exact hXF (by rw [h, ← hc]; exact isAlgebraic_algebraMap y)
  exact indep_u_t h3 hux hne
end Indep
