      simpa only [ξ₂,ξ₁,vars_setVar,if_neg (by decide : outReg≠tw.Nr),if_neg (by decide : outReg≠tw.pS)] using hdsξ
    simpa only [hvv] using evalB_var (B:=B) (σ:=ξ₂) (x:=outReg) (by rw [hvv];omega)
  have hdegreeQ : Q.degree<N := by
    rw [degree_eq_natDegree hQ0]
