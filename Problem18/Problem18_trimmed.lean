variable {K : Type} [Field K] [Fintype K]
def bits : Nat := (Fintype.card K).size+1
theorem field_bounds (F : FieldPresentation K) :
    1 ≤ bits (K:=K) ∧ F.e+1 ≤ bits (K:=K) ∧ F.p.size+1 ≤ bits (K:=K) ∧
    F.p+1 ≤ 2^bits (K:=K) ∧ Fintype.card K < 2^bits (K:=K) := by
  have he:=presentation_degree_lt_size F
  have hp:=Nat.size_le_size (presentation_prime_le_card F)
  have hc:=Nat.lt_size_self (Fintype.card K)
  have hpow:=Nat.pow_le_pow_right (by omega : 1≤2)
    (show (Fintype.card K).size ≤ bits (K:=K) by unfold bits;omega)
  have hpc:=presentation_prime_le_card F
  unfold bits at *
  omega
theorem macro_bound (F : FieldPresentation K) :
    macroBudget F ≤ 2012001*(bits (K:=K))^4 := by
  obtain ⟨ht,he,hp,_,_⟩:=field_bounds F
  let t:=bits (K:=K)
  have het:F.e≤t:=by dsimp [t];omega
  have ht2:t≤t^2:=by nlinarith
  have ht4:t^2≤t^4:=Nat.pow_le_pow_right ht (by omega)
  have hm:F.e*(F.p.size+1)≤t*t:=Nat.mul_le_mul het hp
  have hin:F.e*(F.p.size+1)+1≤2*t^2:=by nlinarith
  have hs:(F.e+1)^2≤t^2:=Nat.pow_le_pow_left he 2
  have hp4:(F.e+1)^2*(F.e*(F.p.size+1)+1)≤2*t^4:=by
    have hh:=Nat.mul_le_mul hs hin
    nlinarith [hh]
  unfold macroBudget
  change 1+2000*(F.e+1)+10000*(F.e+1)^2+
    1000000*(F.e+1)^2*(F.e*(F.p.size+1)+1)≤2012001*t^4
  nlinarith
def memory (F : FieldPresentation K) (S : Nat) : Nat := F.e+1+S*F.e
theorem memory_bound (F : FieldPresentation K) (S : Nat) :
    memory F S ≤ (S+2)*bits (K:=K) := by
  obtain ⟨ht,he,_,_,_⟩:=field_bounds F
  have hh:=Nat.mul_le_mul_left S (show F.e≤bits (K:=K) by omega)
  unfold memory
  nlinarith
theorem scale_bound (F : FieldPresentation K) (S : Nat) :
    scale F (memory F S) ≤ (S+2012004)*(bits (K:=K))^5 := by
  have hm:=memory_bound F S
  have hb:=macro_bound F
  have ht:1≤bits (K:=K):=(field_bounds F).1
  let t:=bits (K:=K)
  have h15:1≤t^5:=one_le_pow₀ ht
  have ht5:t≤t^5:=by
    have h14:1≤t^4:=one_le_pow₀ ht
    nlinarith [show t^5=t^4*t by ring]
  have hh:=Nat.mul_le_mul_right t hb
  have hmem:memory F S≤(S+2)*t^5:=(memory_bound F S).trans (Nat.mul_le_mul_left _ ht5)
  change memory F S+1+macroBudget F*t≤(S+2012004)*t^5
  nlinarith [show t^4*t=t^5 by ring]
def exponent (S W t : Nat) : Nat := W+(S+3)*(t+1)^2+4
theorem word_bounds (F : FieldPresentation K) (S W : Nat) :
    let B:=2^exponent S W (bits (K:=K))
    memory F S < B ∧ W < B ∧ Fintype.card K < B ∧
    (F.p+1)^2 < B ∧ (F.p+1)^(F.e+1) < B := by
  obtain ⟨ht,he,hp,hpword,hcard⟩:=field_bounds F
  let t:=bits (K:=K)
  have hmem:=memory_bound F S
  have hm:memory F S≤exponent S W t:=by unfold exponent; nlinarith
  have hw:W≤exponent S W t:=by unfold exponent;omega
  have htE:t≤exponent S W t:=by unfold exponent;nlinarith
  have h2:2*t<exponent S W t:=by unfold exponent;nlinarith
  have htt:t*t<exponent S W t:=by unfold exponent;nlinarith
  have har:(F.p+1)^2≤2^(2*t):=by
    calc (F.p+1)^2≤(2^t)^2:=Nat.pow_le_pow_left hpword 2
         _=2^(2*t):=by rw [←pow_mul];congr 1;omega
  have hiv:(F.p+1)^(F.e+1)≤2^(t*t):=by
    calc (F.p+1)^(F.e+1)≤(2^t)^(F.e+1):=Nat.pow_le_pow_left hpword _
         _≤(2^t)^t:=Nat.pow_le_pow_right (by positivity) he
         _=2^(t*t):=by rw [←pow_mul]
  refine ⟨(Nat.lt_two_pow_self).trans_le (Nat.pow_le_pow_right (by omega) hm),
    (Nat.lt_two_pow_self).trans_le (Nat.pow_le_pow_right (by omega) hw),
    hcard.trans_le (Nat.pow_le_pow_right (by omega) htE),?_,?_⟩
  · exact har.trans_lt (Nat.pow_lt_pow_right (by omega) h2)
  · exact hiv.trans_lt (Nat.pow_lt_pow_right (by omega) htt)
end Mathproof.Problem18P34Machine20261002Resources
