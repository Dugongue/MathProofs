variable {K : Type*} [Field K] [BEq K] [LawfulBEq K] [DecidableEq K]
def sum (n lo : ℕ) (f : ℕ → CPolynomial K×ℕ) : CPolynomial K×ℕ :=
  if lo<n then
    let a := f lo
    let r := sum n (lo+1) f
    let s := add a.1 r.1
    (s.1,a.2+r.2+s.2)
  else (0,0)
termination_by n-lo
def step (n : ℕ) (A F : Array (CPolynomial K)) (i j : ℕ) : CPolynomial K×ℕ :=
  let d := sum n (i+1) (fun k => (BirdDet.get n F k k,0))
  let e := neg d.1
  let a := mul e.1 (BirdDet.get n A i j)
  let r := sum n (i+1) (fun k => mul (BirdDet.get n F i k) (BirdDet.get n A k j))
  let s := add a.1 r.1
  (s.1,d.2+e.2+a.2+r.2+s.2)
def stepBudget (n D : ℕ) := 20*(n+1)*(D+2)*(D+2)
def stage (n : ℕ) (A F : Array (CPolynomial K)) : Array (CPolynomial K)×ℕ :=
  let es := Array.ofFn fun ij:Fin (n*n) => step n A F ij.divNat.val ij.modNat.val
  (es.map Prod.fst,∑ij:Fin (n*n),(es[ij.val]'(by simpa [es] using ij.isLt)).2)
def stages (n : ℕ) (A : Array (CPolynomial K)) : ℕ → Array (CPolynomial K)×ℕ
  | 0 => (A,0)
  | t+1 =>
    let r := stages n A t
    let s := stage n A r.1
    (s.1,r.2+s.2)
def sign : ℕ → CPolynomial K×ℕ
  | 0 => (1,0)
  | t+1 =>
    let r := sign t
    let a := neg r.1
    (a.1,r.2+a.2)
def determinant (n : ℕ) (A : Array (CPolynomial K)) : CPolynomial K×ℕ :=
  match n with
  | 0 => (1,0)
  | t+1 =>
    let r := stages (t+1) A t
    let s := sign t
    let m := mul s.1 (BirdDet.get (t+1) r.1 0 0)
    (m.1,r.2+s.2+m.2)
def determinantBudget (n : ℕ) := n*(n*n*stepBudget n (n+1))+n+2*(n+1)*(n+1)
def inputEntry (n : ℕ) (A : Array K) (i j : Fin n) : CPolynomial K×ℕ :=
  sub (if i=j then CPolynomial.X else 0) (CPolynomial.C (BirdDet.get n A i.val j.val))
def input (n : ℕ) (A : Array K) : Array (CPolynomial K)×ℕ :=
  let es := Array.ofFn fun ij:Fin (n*n) => inputEntry n A ij.divNat ij.modNat
  (es.map Prod.fst,∑ij:Fin (n*n),(es[ij.val]'(by simpa [es] using ij.isLt)).2)
def characteristic (n : ℕ) (A : Array K) : CPolynomial K×ℕ :=
  let p := input n A
  let d := determinant n p.1
  (d.1,p.2+d.2)
end Mathproof.Problem18CountedPolynomialBird20261001
