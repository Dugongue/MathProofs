namespace Mathproof.Problem18FormEmbeddingFiber20260930
variable {K V W : Type*} [Field K]
  [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
variable (σ : K ≃+* K)
abbrev Form (V : Type*) [AddCommGroup V] [Module K V] :=
  V →ₛₗ[σ.toRingHom] V →ₗ[K] K
abbrev Isometries (B : Form σ V) :=
  {T : V ≃ₗ[K] V // ∀ x y,B (T x) (T y)=B x y}
noncomputable def sumForm (B : Form σ V) (C : Form σ W) : Form σ (V × W) :=
  (B.comp (LinearMap.fst K V W)).compl₂ (LinearMap.fst K V W) +
    (C.comp (LinearMap.snd K V W)).compl₂ (LinearMap.snd K V W)
@[simp] theorem sumForm_apply (B : Form σ V) (C : Form σ W) (x y : V × W) :
    sumForm σ B C x y=B x.1 y.1+C x.2 y.2 := rfl
abbrev FixedLeft (B : Form σ V) (C : Form σ W) :=
  {Q : Isometries σ (sumForm σ B C) // ∀ x,Q.val (x,0)=(x,0)}
set_option backward.isDefEq.respectTransparency false in
theorem fixedLeft_first_zero (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingRight) (Q : FixedLeft σ B C) (w : W) :
    (Q.val.val (0,w)).1=0 := by
  apply hB
  intro x
  have h := Q.val.property (x,0) (0,w)
  rw [Q.property] at h
  simpa [sumForm_apply] using h
noncomputable def complementMap (B : Form σ V) (C : Form σ W)
    (Q : FixedLeft σ B C) : W →ₗ[K] W :=
  (LinearMap.snd K V W).comp (Q.val.val.toLinearMap.comp (LinearMap.inr K V W))
theorem fixedLeft_formula (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingRight) (Q : FixedLeft σ B C) (x : V) (w : W) :
    Q.val.val (x,w)=(x,complementMap σ B C Q w) := by
  have hz : Q.val.val (0,w)=(0,complementMap σ B C Q w) :=
    Prod.ext (fixedLeft_first_zero σ B C hB Q w) rfl
  have h := Q.val.val.map_add (x,0) (0,w)
  simpa only [Prod.mk_add_mk,add_zero,zero_add,Q.property,hz] using h
theorem complementMap_bijective (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingRight) (Q : FixedLeft σ B C) :
    Function.Bijective (complementMap σ B C Q) := by
  constructor
  · intro x y h
    have he : Q.val.val (0,x)=Q.val.val (0,y) := by
      rw [fixedLeft_formula σ B C hB,fixedLeft_formula σ B C hB,h]
    exact congrArg Prod.snd (Q.val.val.injective he)
  · intro y
    obtain ⟨⟨x,w⟩,h⟩ := Q.val.val.surjective (0,y)
    rw [fixedLeft_formula σ B C hB] at h
    exact ⟨w,congrArg Prod.snd h⟩
