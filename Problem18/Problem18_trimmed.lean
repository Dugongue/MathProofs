  have hf := vectorAnnihilator_correct S z
  have hdiv : vectorAnnihilator S z ∣ S.charpoly := (hf.2 _).mp (by rw [S.aeval_self_charpoly];rfl)
  apply eq_of_dvd_of_natDegree_le_of_leadingCoeff hdiv
  · rw [annihilator_natDegree,hd,S.charpoly_natDegree]
    simp
  · exact hf.1.trans S.charpoly_monic.symm
theorem firstDegree_eq_of_cyclic (S : Module.End K (Fin n→K)) (z : Fin n→K)
    (hc : PolynomiallyCyclic S z) : (firstDegree S z).val=n := by
  have hf := vectorAnnihilator_correct S z
  have hle : (firstDegree S z).val ≤ n := Nat.le_of_lt_succ (firstDegree S z).isLt
  by_contra hh
  have hlt : (firstDegree S z).val<n := by omega
  have hd : (vectorAnnihilator S z).degree<Module.finrank K (Fin n→K) := by
    rw [degree_eq_natDegree hf.1.ne_zero,annihilator_natDegree]
    simpa using hlt
  let p : Polynomial.degreeLT K (Module.finrank K (Fin n→K)) :=
    ⟨vectorAnnihilator S z,mem_degreeLT.mpr hd⟩
  have he : cyclicEvalMap S z (Module.finrank K (Fin n→K)) p=
      cyclicEvalMap S z (Module.finrank K (Fin n→K)) 0 := by
    change (aeval S (vectorAnnihilator S z)) z=(aeval S 0) z
    rw [show (aeval S (vectorAnnihilator S z)) z=0 from (hf.2 _).mpr dvd_rfl,map_zero]
    rfl
  have hz := ((polynomiallyCyclic_iff_cyclicEvalMap_bijective S z).mp hc).injective he
