    simpa [sigma1,sourceModPrepared,Env.setVar] using hin
  have h1e : sigma1.vars canonical.e = F.e := by
    simpa [sigma1,sourceModPrepared,Env.setVar,canonical] using hef
  have h1base : sigma1.vars canonical.modBase = 0 := by
    simp [sigma1,sourceModPrepared,Env.setVar]
  have h1arr : ∀ arr, sigma1.arrs arr = List.replicate (ext arr) 0 := by
    intro arr
    simpa [sigma1,sourceModPrepared,Env.setVar] using harr arr
  have hmodAssign : Run W (.assign canonical.modBase (.lit 0)) sigma sigma1 2 := by
    simpa [sigma1,sourceModPrepared,sigma] using
      (Run.assign (x:=canonical.modBase) (σ:=sigma) (evalB_lit (by omega : 0<W)))
  have hmodNames : Problem18P34Input20261002Payload.modIO.Valid := by
    unfold Problem18P34Input20261002Payload.modIO
      Problem18IMPFieldIO20261001.Names.Valid
    decide
  have hmodRead := Problem18IMPFieldIO20261001.readBlock_run
    Problem18P34Input20261002Payload.modIO hmodNames (B:=W) sigma1 modList coords
    h1inp (by rw [hmodLen]; omega)
    (by simpa [Problem18P34Input20261002Payload.modIO,hmodLen] using h1e)
    (by simp [Problem18P34Input20261002Payload.modIO,h1base,h1arr,hmodLen]; omega)
    (by simp [Problem18P34Input20261002Payload.modIO,h1arr]; omega)
    (by
      intro v hv
