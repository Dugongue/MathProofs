      (∀ x y,c i (T i x) (T (τ i) y)=b i x y) ∧
      (∀ x y,c (τ i) (T (τ i) x) (T (τ (τ i)) y)=b (τ i) x y)) :
    ∃ T : V ≃ₗ[K] W,(∀ x,T (S x)=R (T x)) ∧ ∀ x y,C (T x) (T y)=B x y := by
  classical
