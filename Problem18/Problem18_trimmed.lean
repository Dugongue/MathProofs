  have Lx : sb + F.e*xN n d + F.e*(d*n) ≤ sb + F.e*sN n d := lay _ _ _ _ _ (by simp [sN])
  have Ls : sb + F.e*sN n d + F.e*(n*n) ≤ sb + F.e*wN n d := lay _ _ _ _ _ (by simp [wN])
  have Lw : sb + F.e*wN n d + F.e*(1*n) ≤ sb + F.e*uN n d := lay _ _ _ _ _ (by simp [uN])
