  apply Nat.eq_of_mul_eq_mul_right (show 0<Nat.card k-1 by omega)
  nlinarith
theorem rational_function_chart_card [Finite k] :
    Nat.card {P : PlaceA k k⟮X⟯ // placeDegree k k⟮X⟯ P=1}=Nat.card k+1 := by
  apply genus_zero_rational_card k k⟮X⟯ (genus_ratFunc k) (polarDivisor k k⟮X⟯ (XK k k⟮X⟯))
  rw [deg_polarX_eq_finrank,Module.finrank_self]
  rfl
end Mathproof.Problem18RationalFunctionPointCount20260930
