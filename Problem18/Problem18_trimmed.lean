    have hpot' : R' = 0 ∨ R'.natDegree < Q.natDegree ∨ R'.natDegree+ζ.vars q.c < N := by
      rcases htrans with ⟨hR,ht⟩ | ⟨hR,hR0,hd⟩
      · rw [hR]
