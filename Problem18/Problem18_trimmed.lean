  have hc : (σ.arrs r.scratch).getD (σ.vars r.e-1) 0<B :=
    ((h.coefficients _ (by have he0:=h.degree_pos; omega)).2.2.2).trans hp
  have hlead:=Run.assign (x:=r.value) (evalB_get hidx hl hc)
  have hle:(iterLead r σ).vars r.e=σ.vars r.e:=by simp [iterLead,hev]
  have hset : (Expr.var r.e).evalB B (iterLead r σ)=some (σ.vars r.e) := by
    simpa only [hle] using evalB_var (σ:=iterLead r σ) (x:=r.e) (by rw [hle]; exact he)
  have hk:=Run.assign (x:=r.k) hset
  have hmap:=iter_map_run h hi
  have hzero:=Run.assign (σ:=iterNext r modArray σ) (x:=r.k) (evalB_lit (by omega : 0<B))
  have hcopy:=iter_commit_run h
