namespace Mathproof.Problem18FiniteTransducer20261001
open Turing StateTransition
variable {A B Q : Type} [Fintype A] [Fintype B] [Fintype Q] [Inhabited A] [Inhabited B]
structure Transducer (A B Q : Type) where
  initial : Q
  next : Q→A→Q×List B
  finish : Q→List B
  next_bound : ∀q a,(next q a).2.length ≤ 2
  finish_bound : ∀q,(finish q).length ≤ 2
def run (T : Transducer A B Q) (q : Q) : List A→List B
  | []=>T.finish q
  | a::xs=>(T.next q a).2++run T (T.next q a).1 xs
theorem run_length (T : Transducer A B Q) (q : Q) (xs : List A) :
    (run T q xs).length ≤ 2*xs.length+2 := by
  induction xs generalizing q with
  | nil => exact T.finish_bound q
  | cons a xs ih =>
    simp only [run,List.length_append,List.length_cons]
    have h:=ih (T.next q a).1
    have hh:=T.next_bound q a
    omega
inductive Stack | input | buffer | output deriving DecidableEq,Fintype
abbrev Alphabet (A B : Type) : Stack→Type
  | .input=>A
  | _=>B
instance alphabetFinite (k : Stack) : Fintype (Alphabet A B k) := by
  cases k <;> dsimp [Alphabet] <;> infer_instance
abbrev State (A B Q : Type) := Q×Option A×Option B
abbrev Statement (A B Q : Type) := TM2.Stmt (Alphabet A B) Bool (State A B Q)
def emit (f : State A B Q→List B) (cont : Statement A B Q) : Statement A B Q :=
  .branch (fun v=>decide (0<(f v).length))
    (.push .buffer (fun v=>(f v).headD default)
      (.branch (fun v=>decide (1<(f v).length))
        (.push .buffer (fun v=>(f v).tail.headD default) cont) cont)) cont
theorem stepAux_emit (f : State A B Q→List B) (cont : Statement A B Q)
    (v : State A B Q) (S : ∀k,List (Alphabet A B k)) (h : (f v).length ≤ 2) :
    TM2.stepAux (emit f cont) v S=
      TM2.stepAux cont v (Function.update S .buffer ((f v).reverse++S .buffer)) := by
  cases hf : f v with
  | nil => simp [emit,TM2.stepAux,hf]
  | cons b xs =>
    cases xs with
    | nil => simp [emit,TM2.stepAux,hf]
    | cons c xs =>
      cases xs with
      | nil => simp [emit,TM2.stepAux,hf]
      | cons d xs => simp only [hf,List.length_cons] at h; omega
def scanStatement (T : Transducer A B Q) : Statement A B Q :=
  .pop .input (fun v x=>(v.1,x,none))
    (.branch (fun v=>v.2.1.isSome)
      (emit (fun v=>(T.next v.1 (v.2.1.getD default)).2)
        (.load (fun v=>((T.next v.1 (v.2.1.getD default)).1,none,none)) (.goto (fun _=>true))))
      (emit (fun v=>T.finish v.1)
        (.load (fun _=>(T.initial,none,none)) (.goto (fun _=>false)))))
def reverseStatement (T : Transducer A B Q) : Statement A B Q :=
  .pop .buffer (fun _ x=>(T.initial,none,x))
    (.branch (fun v=>v.2.2.isSome)
      (.push .output (fun v=>v.2.2.getD default)
        (.load (fun _=>(T.initial,none,none)) (.goto (fun _=>false))))
      (.load (fun _=>(T.initial,none,none)) .halt))
def machine (T : Transducer A B Q) : FinTM2 where
  K:=Stack
  k₀:=.input
  k₁:=.output
  Γ:=Alphabet A B
  Λ:=Bool
  main:=true
  σ:=State A B Q
  initialState:=(T.initial,none,none)
  m p:=if p then scanStatement T else reverseStatement T
def scanCfg (T : Transducer A B Q) (q : Q) (xs : List A) (ys out : List B) : (machine T).Cfg where
  l:=some true
  var:=(q,none,none)
  stk k:=match k with | .input=>xs | .buffer=>ys | .output=>out
def reverseCfg (T : Transducer A B Q) (ys out : List B) : (machine T).Cfg where
  l:=some false
  var:=(T.initial,none,none)
  stk k:=match k with | .input=>[] | .buffer=>ys | .output=>out
theorem initial_eq (T : Transducer A B Q) (xs : List A) :
    initList (machine T) xs=scanCfg T T.initial xs [] [] := by
  simp [initList,machine,scanCfg]
  congr 1
  funext k
  cases k <;> rfl
theorem scan_step (T : Transducer A B Q) (q : Q) (a : A) (xs : List A) (ys out : List B) :
    (machine T).step (scanCfg T q (a::xs) ys out)=
      some (scanCfg T (T.next q a).1 xs ((T.next q a).2.reverse++ys) out) := by
  simp only [machine,FinTM2.step,TM2.step,scanCfg,scanStatement,ite_true,TM2.stepAux,
    List.head?_cons,List.tail_cons,Option.isSome_some,Bool.cond_true,Option.getD_some]
  rw [stepAux_emit _ _ _ _ (T.next_bound q a)]
  simp only [TM2.stepAux]
  congr 2
  funext k
  cases k <;> simp [Function.update]
theorem scan_finish (T : Transducer A B Q) (q : Q) (ys out : List B) :
    (machine T).step (scanCfg T q [] ys out)=
      some (reverseCfg T ((T.finish q).reverse++ys) out) := by
  simp only [machine,FinTM2.step,TM2.step,scanCfg,reverseCfg,scanStatement,ite_true,TM2.stepAux,
    List.head?_nil,List.tail_nil,Option.isSome_none,Bool.cond_false]
  rw [stepAux_emit _ _ _ _ (T.finish_bound q)]
  simp only [TM2.stepAux]
  congr 2
  funext k
  cases k <;> simp [Function.update]
theorem reverse_step (T : Transducer A B Q) (b : B) (ys out : List B) :
    (machine T).step (reverseCfg T (b::ys) out)=some (reverseCfg T ys (b::out)) := by
  simp [machine,FinTM2.step,TM2.step,reverseCfg,reverseStatement,TM2.stepAux]
  congr 2
  funext k
  cases k <;> simp [Function.update]
theorem reverse_finish (T : Transducer A B Q) (out : List B) :
    (machine T).step (reverseCfg T [] out)=some (haltList (machine T) out) := by
  simp [machine,FinTM2.step,TM2.step,reverseCfg,reverseStatement,TM2.stepAux,haltList]
  congr 2
  funext k
  cases k <;> simp [Function.update]
def oneStep {S : Type} (f : S→Option S) (x y : S) (h : f x=some y) :
    EvalsToInTime f x (some y) 1 where
  steps:=1
  evals_in_steps:=h
  steps_le_m:=le_rfl
def scanTrace (T : Transducer A B Q) (q : Q) (xs : List A) (ys out : List B) :
    EvalsToInTime (machine T).step (scanCfg T q xs ys out)
      (some (reverseCfg T ((run T q xs).reverse++ys) out)) (xs.length+1) := by
  induction xs generalizing q ys with
  | nil => exact oneStep _ _ _ (scan_finish T q ys out)
  | cons a xs ih =>
    have h1:=oneStep _ _ _ (scan_step T q a xs ys out)
    have h2:=ih (T.next q a).1 ((T.next q a).2.reverse++ys)
    have h:=EvalsToInTime.trans (machine T).step _ _ _ _ _ h1 h2
    simpa [run,List.reverse_append,List.append_assoc,Nat.add_assoc] using h
def reverseTrace (T : Transducer A B Q) (ys out : List B) :
    EvalsToInTime (machine T).step (reverseCfg T ys out)
      (some (haltList (machine T) (ys.reverse++out))) (ys.length+1) := by
  induction ys generalizing out with
  | nil => exact oneStep _ _ _ (reverse_finish T out)
  | cons b ys ih =>
    have h1:=oneStep _ _ _ (reverse_step T b ys out)
    have h2:=ih (b::out)
    have h:=EvalsToInTime.trans (machine T).step _ _ _ _ _ h1 h2
    simpa [List.reverse_cons,List.append_assoc,Nat.add_assoc] using h
noncomputable def computable (T : Transducer A B Q) :
    TM2ComputableInPolyTime id id (run T T.initial) where
  tm:=machine T
  inputAlphabet:=Equiv.refl A
  outputAlphabet:=Equiv.refl B
  time:=Polynomial.C 3*Polynomial.X+Polynomial.C 4
  outputsFun xs:=by
    have h1:=scanTrace T T.initial xs [] []
    have h2:=reverseTrace T (run T T.initial xs).reverse []
    simp only [List.append_nil] at h1
    have h:=EvalsToInTime.trans (machine T).step _ _ _ _ _ h1 h2
    have hh : EvalsToInTime (machine T).step (initList (machine T) xs)
        (some (haltList (machine T) (run T T.initial xs)))
        (xs.length+1+((run T T.initial xs).length+1)) := by
      simpa only [initial_eq,List.reverse_reverse,List.append_nil,List.length_reverse,Nat.add_comm] using h
    have hb:=run_length T T.initial xs
    have hbound := hh.steps_le_m.trans (show xs.length+1+((run T T.initial xs).length+1) ≤ 3*xs.length+4 by omega)
    simpa [TM2OutputsInTime,Equiv.refl,Equiv.symm] using (show EvalsToInTime (machine T).step (initList (machine T) xs) (some (haltList (machine T) (run T T.initial xs))) (3*xs.length+4) from {hh with steps_le_m := hbound})
end Mathproof.Problem18FiniteTransducer20261001
end
