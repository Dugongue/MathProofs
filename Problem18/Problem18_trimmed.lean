    LinearMap.coe_mk,AddHom.coe_mk]
theorem rawSecond_eq (A : RectTensor a b c K) : rawSecond u q A=secondFamily A := by
  funext kl
  simp only [rawSecond,rawAdjoint_eq u q hs,secondFamily,
    Problem18CorrectedCrossGram20260930.crossGram]
theorem rawGood_iff (A : RectTensor a b c K) : RawGood u q A ↔ Good A := by
  simp only [RawGood,Good,rawFirst_eq u q hs,rawSecond_eq u q hs]
theorem root_isometry_iff {n : ℕ} (P : Matrix (Fin n) (Fin n) K) :
    isometry u q P ↔ IsUnitary P := by
  have he := rawAdjoint_eq u q hs P
  change (if u then _ else _) ↔ _
  cases u <;> simp only [rawAdjoint,Bool.false_eq_true,ite_false,ite_true] at he ⊢
  all_goals change _*P=1 ↔ Pᴴ*P=1; rw [he]
