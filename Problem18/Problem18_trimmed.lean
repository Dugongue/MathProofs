    (B : V →ₗ⋆[K] V →ₗ[K] K) (C : W →ₗ⋆[K] W →ₗ[K] K)
    (hB : B.IsSymm) (hnB : B.Nondegenerate) (hC : C.IsSymm) (hnC : C.Nondegenerate)
    (h : K[X]) (hm : h.Monic) (hi : Irreducible h)
    (hd : Module.finrank K V=h.natDegree) (hc : h.natDegree≤Module.finrank K W) :
    (Nat.card {T : SelfAdjointOperators (starRingAut : K ≃+* K) (sumForm (starRingAut : K ≃+* K) B C) //
      h∣T.val.charpoly} : ℝ)*(Nat.card (fixedField (starRingAut : K ≃+* K)) : ℝ)^h.natDegree ≤
