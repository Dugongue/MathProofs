variable {K : Type*} [Field K]
theorem fixed_scalar_descends {F : Type*} [Field F] [Fintype F] [Finite K]
    [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F) (x : K) (hx : star x = x) :
    ∃ d : F, algebraMap F K d = x := by
  apply (IsGalois.mem_range_algebraMap_iff_fixed x).mpr
  intro σ
  obtain ⟨j, rfl⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow F K).2 σ
  have hf : FiniteField.frobeniusAlgEquivOfAlgebraic F K x = x := by
    change x ^ Fintype.card F = x
    rw [Fintype.card_eq_nat_card, ← hstar x]
    exact hx
  have hp : ∀ m : ℕ, (FiniteField.frobeniusAlgEquivOfAlgebraic F K ^ m) x = x := by
    intro m
    induction m with
    | zero => rfl
    | succ m ih => rw [pow_succ, AlgEquiv.mul_apply, hf, ih]
  exact hp j.val
theorem quadratic_trace
    {F : Type*} [Field F] [Fintype F] [Finite K] [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F) (x : K) :
    algebraMap F K (Algebra.trace F K x) = x + star x := by
  have hd : Module.finrank F K = 2 := by
    apply Nat.pow_right_injective (show 2 ≤ Nat.card F from Finite.one_lt_card)
    change Nat.card F ^ Module.finrank F K = Nat.card F ^ 2
    rw [← Module.natCard_eq_pow_finrank, hcard]
  rw [FiniteField.algebraMap_trace_eq_sum_pow, hd]
  simp [Finset.sum_range_succ, hstar]
theorem hermitian_pairing_star
    {i : Type*} [Fintype i] [StarRing K]
    (A : Matrix i i K) (hA : Aᴴ = A) (x y : i → K) :
    star (star x ⬝ᵥ (A *ᵥ y)) = star y ⬝ᵥ (A *ᵥ x) := by
  rw [← star_dotProduct_star, star_star, star_mulVec, hA, ← dotProduct_mulVec]
noncomputable def hermitianQuadratic
    {F i : Type*} [Field F] [Fintype F] [Finite K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (A : Matrix i i K) (hA : Aᴴ = A) (x : i → K) : F :=
  (fixed_scalar_descends hstar (star x ⬝ᵥ (A *ᵥ x))
    (hermitian_pairing_star A hA x x)).choose
theorem hermitian_quadratic_spec
    {F i : Type*} [Field F] [Fintype F] [Finite K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (A : Matrix i i K) (hA : Aᴴ = A) (x : i → K) :
    algebraMap F K (hermitianQuadratic hstar A hA x) = star x ⬝ᵥ (A *ᵥ x) :=
  (fixed_scalar_descends hstar (star x ⬝ᵥ (A *ᵥ x))
    (hermitian_pairing_star A hA x x)).choose_spec
theorem hermitian_quadratic_fourier
    {F i : Type*} [Field F] [Fintype F] [Fintype K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (hp : 0 < ringChar F) (ψ : AddChar F ℂ) (hψ : ψ ≠ 1)
    (A : Matrix i i K) (hA : Aᴴ = A) :
    ‖(∑ x, ψ (hermitianQuadratic hstar A hA x)) / (Fintype.card (i → K) : ℂ)‖ ^ 2 =
      ((Fintype.card K : ℝ) ^ A.rank)⁻¹ := by
  refine trace_matrix_quadratic_fourier hp ψ hψ A (hermitianQuadratic hstar A hA) ?_ ?_
  · intro x h
    apply FaithfulSMul.algebraMap_injective F K
    simp only [map_add, hermitian_quadratic_spec, quadratic_trace hcard hstar]
    change star (x + h) ⬝ᵥ (A *ᵥ (x + h)) =
      star x ⬝ᵥ (A *ᵥ x) + star h ⬝ᵥ (A *ᵥ h) +
        (star x ⬝ᵥ (A *ᵥ h) + star (star x ⬝ᵥ (A *ᵥ h)))
    simp only [star_add, mulVec_add, add_dotProduct, dotProduct_add]
    rw [hermitian_pairing_star A hA x h]
    ring
  · intro h hh
    apply FaithfulSMul.algebraMap_injective F K
    rw [hermitian_quadratic_spec, map_zero, hh, dotProduct_zero]
end Mathproof.Problem18HermitianFourierCore20260930
