theorem finrank_range_flip (B : V →ₗ[K] W →ₗ[K] K) :
    finrank K (LinearMap.range B.flip) = finrank K (LinearMap.range B) := by
  have he : B.flip = B.dualMap.comp (Module.evalEquiv K W).toLinearMap := rfl
  rw [he, LinearMap.range_comp_of_range_eq_top _ (LinearEquiv.range _)]
  exact LinearMap.finrank_range_dualMap_eq_finrank_range B
theorem polar_restriction_rank_loss (Q : QuadraticForm K V) (E : Submodule K V) :
    finrank K (LinearMap.range Q.polarBilin) ≤
      finrank K (LinearMap.range (Q.comp E.subtype).polarBilin) +
        2 * finrank K ↥(LinearMap.range Q.polarBilin ⊓
          LinearMap.ker E.subtype.dualMap) := by
  let T := Q.polarBilin.comp E.subtype
  have ht : T.flip = E.subtype.dualMap.comp Q.polarBilin := by
    ext x y
    exact QuadraticMap.polar_comm Q _ _
  have hp : (Q.comp E.subtype).polarBilin = E.subtype.dualMap.comp T := by
    ext x y
    rfl
  have h₁ : finrank K (LinearMap.range (E.subtype.dualMap.comp Q.polarBilin)) +
      finrank K ↥(LinearMap.range Q.polarBilin ⊓ LinearMap.ker E.subtype.dualMap) =
      finrank K (LinearMap.range Q.polarBilin) :=
    finrank_comp_add_intersection E.subtype.dualMap Q.polarBilin
  have h₂ : finrank K (LinearMap.range (E.subtype.dualMap.comp T)) +
      finrank K ↥(LinearMap.range T ⊓ LinearMap.ker E.subtype.dualMap) =
      finrank K (LinearMap.range T) :=
    finrank_comp_add_intersection E.subtype.dualMap T
  have hle : LinearMap.range T ≤ LinearMap.range Q.polarBilin :=
    LinearMap.range_comp_le_range _ _
  have hi : finrank K ↥(LinearMap.range T ⊓ LinearMap.ker E.subtype.dualMap) ≤
      finrank K ↥(LinearMap.range Q.polarBilin ⊓ LinearMap.ker E.subtype.dualMap) :=
    Submodule.finrank_mono (inf_le_inf_right (LinearMap.ker E.subtype.dualMap) hle)
  have hr : finrank K (LinearMap.range (E.subtype.dualMap.comp Q.polarBilin)) =
      finrank K (LinearMap.range T) := by
    rw [← ht]
    exact finrank_range_flip T
  rw [← hp] at h₂
  calc
    _ = finrank K (LinearMap.range (E.subtype.dualMap.comp Q.polarBilin)) +
        finrank K ↥(LinearMap.range Q.polarBilin ⊓ LinearMap.ker E.subtype.dualMap) := h₁.symm
    _ = finrank K (LinearMap.range T) +
        finrank K ↥(LinearMap.range Q.polarBilin ⊓ LinearMap.ker E.subtype.dualMap) := by rw [hr]
    _ = (finrank K (LinearMap.range (Q.comp E.subtype).polarBilin) +
        finrank K ↥(LinearMap.range T ⊓ LinearMap.ker E.subtype.dualMap)) +
        finrank K ↥(LinearMap.range Q.polarBilin ⊓ LinearMap.ker E.subtype.dualMap) := by rw [h₂]
    _ ≤ (finrank K (LinearMap.range (Q.comp E.subtype).polarBilin) +
        finrank K ↥(LinearMap.range Q.polarBilin ⊓ LinearMap.ker E.subtype.dualMap)) +
        finrank K ↥(LinearMap.range Q.polarBilin ⊓ LinearMap.ker E.subtype.dualMap) :=
      Nat.add_le_add_right (Nat.add_le_add_left hi _) _
    _ = _ := by omega
