  exact IsScalarTower.algebraMap_apply k k⟮X⟯ Ωc c
theorem lc_tower_kF : IsScalarTower k F Lc := IsScalarTower.of_algebraMap_eq fun c => by
  apply Subtype.ext
  change algebraMap k Ωc c = algebraMap F Ωc (algebraMap k F c)
  rw [IsScalarTower.algebraMap_apply k k⟮X⟯ Ωc c, IsScalarTower.algebraMap_apply k⟮X⟯ F Ωc,
    ← IsScalarTower.algebraMap_apply k k⟮X⟯ F]
attribute [local instance] lc_tower_kE lc_tower_kX lc_tower_kF
theorem lc_finite : FiniteDimensional k⟮X⟯ Lc := Module.Finite.trans 𝓜 Lc
theorem lc_finite_F : FiniteDimensional F Lc := by
  haveI : FiniteDimensional F 𝓜 := (normalCover_finite_galois k F).1
  exact Module.Finite.trans 𝓜 Lc
theorem lc_sep : Algebra.IsSeparable k⟮X⟯ Lc := Algebra.IsSeparable.trans k⟮X⟯ 𝓜 Lc
attribute [local instance] lc_finite lc_finite_F lc_sep
theorem lc_galois : IsGalois k⟮X⟯ Lc := by
  letI := ambientConstantsAlgebra E₀ 𝓜 E
  letI := ambientConstantsTower E₀ 𝓜 E
  haveI : IsScalarTower k E Ωc := IsScalarTower.of_algebraMap_eq fun c => by
    rw [IsScalarTower.algebraMap_apply k E₀ E c, ← IsScalarTower.algebraMap_apply E₀ E Ωc,
      ← IsScalarTower.algebraMap_apply k E₀ Ωc]
  exact galois_compositum_base_change k k⟮X⟯ 𝓜 E Ωc
theorem lc_charP : CharP Lc p := charP_of_injective_algebraMap (algebraMap k Lc).injective p
attribute [local instance] lc_galois lc_charP
set_option maxHeartbeats 1500000 in
theorem level_core (a : ℕ) (hq : Fintype.card k = p^a)
    (hfrE : finrank K0 E = (coverDegree k F).factorial)
    (ht : (coverGenus k F + 2)^2 < p^((a * finrank k K0)/2)) :
    closedPointSum k F (finrank k K0) ≤ p^(a * finrank k K0) +
        (2*coverGenus k F+3)*p^(a * finrank k K0 - a * finrank k K0/2) ∧
    p^(a * finrank k K0) + 1 ≤ closedPointSum k F (finrank k K0) +
      (coverDegree k F - 1)*((2*coverGenus k F+3)*p^(a * finrank k K0 - a * finrank k K0/2)) := by
  classical
  set n := finrank k K0 with hn_def
  let m := (coverDegree k F).factorial
  haveI : CharP K0 p := charP_of_injective_algebraMap (algebraMap k K0).injective p
  letI : Fintype E₀ := Fintype.ofFinite _
  letI : Algebra K0 Lc := ((algebraMap E Lc).comp (algebraMap K0 E)).toAlgebra
  haveI : IsScalarTower K0 E Lc := IsScalarTower.of_algebraMap_eq fun _ => rfl
  haveI : IsScalarTower k K0 Lc := IsScalarTower.of_algebraMap_eq fun c => by
    rw [IsScalarTower.algebraMap_apply k E Lc, IsScalarTower.algebraMap_apply k K0 E]
    rfl
  letI : Algebra K0⟮X⟯ Lc := constantRatAlgebra k K0 Lc
  haveI : IsScalarTower K0 K0⟮X⟯ Lc := constant_chart_rat_constants_tower k K0 Lc
  haveI : _root_.FunctionField K0 Lc := (constant_chart_finite_separable k K0 Lc).1
  haveI : Algebra.IsSeparable K0⟮X⟯ Lc := (constant_chart_finite_separable k K0 Lc).2
  haveI : IsScalarTower k⟮X⟯ K0⟮X⟯ Lc := constant_chart_base_tower k K0 Lc
  haveI : IsGalois K0⟮X⟯ Lc := IsGalois.tower_top_of_isGalois k⟮X⟯ K0⟮X⟯ Lc
  letI : Algebra E[X] Lc := constantPolyAlgebra k E Lc
  letI : Algebra E⟮X⟯ Lc := constantRatAlgebra k E Lc
  haveI : IsScalarTower E[X] E⟮X⟯ Lc := constant_chart_poly_tower k E Lc
  haveI : IsScalarTower E E[X] Lc := constant_chart_constants_tower k E Lc
  haveI : IsScalarTower E E⟮X⟯ Lc := constant_chart_rat_constants_tower k E Lc
  haveI : _root_.FunctionField E Lc := (constant_chart_finite_separable k E Lc).1
  haveI : Algebra.IsSeparable E⟮X⟯ Lc := (constant_chart_finite_separable k E Lc).2
  have hXK0 : algebraMap K0⟮X⟯ Lc RatFunc.X = algebraMap k⟮X⟯ Lc RatFunc.X :=
    constantRatHom_X k K0 Lc
  have hXEk : algebraMap E⟮X⟯ Lc RatFunc.X = algebraMap k⟮X⟯ Lc RatFunc.X :=
    constantRatHom_X k E Lc
  have hXK0E : algebraMap K0⟮X⟯ Lc RatFunc.X = algebraMap E⟮X⟯ Lc RatFunc.X := hXK0.trans hXEk.symm
  have hgenL : constantCompositum 𝓜 E Lc = ⊤ := constantExtension_generated E₀ 𝓜 E
  have hxgen : algebraMap 𝓜 Lc (XK E₀ 𝓜) = XK E Lc := by
    change algebraMap 𝓜 Lc (algebraMap E₀⟮X⟯ 𝓜 RatFunc.X) = algebraMap E⟮X⟯ Lc RatFunc.X
    have hXM : algebraMap E₀⟮X⟯ 𝓜 RatFunc.X = algebraMap k⟮X⟯ 𝓜 RatFunc.X :=
      constantRatHom_X k E₀ 𝓜
    rw [hXM, ← IsScalarTower.algebraMap_apply k⟮X⟯ 𝓜 Lc]
    exact hXEk.symm
  have hgenus : genus E Lc = coverGenus k F := genus_of_cover hgenL hxgen
  have hXF : algebraMap K0⟮X⟯ Lc RatFunc.X = algebraMap F Lc (algebraMap k⟮X⟯ F RatFunc.X) := by
    rw [hXK0]
    apply Subtype.ext
    exact IsScalarTower.algebraMap_apply k⟮X⟯ F Ωc RatFunc.X
  haveI : Fact (algebraMap K0⟮X⟯ Lc RatFunc.X ∈ constantCompositum F K0 Lc) :=
    ⟨by rw [hXF]; exact (constantCompositum F K0 Lc).algebraMap_mem _⟩
  letI := curveAlgF F K0 Lc
  haveI := curveTowerF F K0 Lc
  letI := curveAlgk k F K0 Lc
  haveI := curveTowerkF k F K0 Lc
  haveI := curveTowerkK0 k F K0 Lc
  haveI := curveFinite F K0 Lc
  haveI := curveFull k F K0 Lc
  have hord : ∀ ψ : Lc ≃ₐ[K0] Lc,
      ψ (algebraMap K0⟮X⟯ Lc RatFunc.X) = algebraMap K0⟮X⟯ Lc RatFunc.X →
      (∀ c : E, ψ (algebraMap E Lc c) = algebraMap E Lc c) →
      orderOf ((frobLift k F K0 E Lc).trans ψ) = finrank K0 E := fun ψ hψX hψE =>
    twist_order (B := k⟮X⟯) (M := 𝓜) (algebraMap K0⟮X⟯ Lc RatFunc.X)
      (fun γ hγX b => by
        rw [IsScalarTower.algebraMap_apply k⟮X⟯ K0⟮X⟯ Lc]
        exact fixes_ratFunc γ hγX _)
      hgenL m (Nat.factorial_pos _) (Nat.dvd_factorial (coverDegree_pos k F) le_rfl) hfrE
      (frobLift k F K0 E Lc) (frobLift_X k F K0 E Lc) (frobLift_const k F K0 E Lc) ψ hψX hψE
  have hkB : ∀ r : k⟮X⟯, algebraMap k⟮X⟯ Lc r ∈ baseField K0 E Lc := by
    intro r
    rw [IsScalarTower.algebraMap_apply k⟮X⟯ K0⟮X⟯ Lc]
    exact (baseField K0 E Lc).algebraMap_mem _
  have hD : finrank (baseField K0 E Lc) Lc ≤ coverDegree k F :=
    finrank_le_of_compositum (k0 := E₀) (B := k⟮X⟯) (M := 𝓜) (E := E)
      (fun r => ⟨⟨_, hkB r⟩, rfl⟩)
      (fun c => ⟨⟨_, algebraMap_mem_constantCompositum K0⟮X⟯ E Lc c⟩, rfl⟩) hgenL
  have hqK0 : Fintype.card K0 = p^(a*n) := by
    rw [Module.card_eq_pow_finrank (K := k) (V := K0), hq, ← pow_mul]
  exact level_final k F K0 E Lc (curveField F K0 Lc) (curve_gen F K0 Lc)
    (hRatTower := chart_tower K0 E Lc hXK0E) (frobLift k F K0 E Lc) (frobLift_X k F K0 E Lc)
    (frobLift_const k F K0 E Lc) (frobLift_curve k F K0 E Lc) hord (coverDegree k F) hD
    (Dvd.intro 1 (by rw [hfrE, mul_one])) hXK0E p (a*n) hqK0 (coverGenus k F) hgenus ht
    n hn_def.symm
end Level
section Wrap
variable (k F : Type) [Field k] [Field F] [Fintype k]
  [Algebra k F] [Algebra k[X] F] [Algebra k⟮X⟯ F] [IsScalarTower k k[X] F]
  [IsScalarTower k[X] k⟮X⟯ F] [IsScalarTower k k⟮X⟯ F] [_root_.FunctionField k F]
  [Algebra.IsSeparable k⟮X⟯ F] [FunctionField.IsFullConstantField k F]
theorem level_bounds (p : ℕ) [Fact p.Prime] [CharP k p] (a : ℕ)
    (hq : Fintype.card k = p^a) (n : ℕ) (hn : 0 < n)
    (ht : (coverGenus k F + 2)^2 < p^((a*n)/2)) :
    closedPointSum k F n ≤ p^(a*n) + (2*coverGenus k F+3)*p^(a*n - a*n/2) ∧
    p^(a*n) + 1 ≤ closedPointSum k F n +
      (coverDegree k F - 1)*((2*coverGenus k F+3)*p^(a*n - a*n/2)) := by
  classical
  haveI : NeZero n := ⟨hn.ne'⟩
  haveI : NeZero (coverDegree k F).factorial := ⟨Nat.factorial_ne_zero _⟩
  letI : Fintype (FiniteField.Extension k p n) := Fintype.ofFinite _
  haveI : CharP (FiniteField.Extension k p n) p :=
    charP_of_injective_algebraMap (algebraMap k (FiniteField.Extension k p n)).injective p
  letI : Algebra k (FiniteField.Extension (FiniteField.Extension k p n) p
      (coverDegree k F).factorial) :=
    ((algebraMap (FiniteField.Extension k p n) (FiniteField.Extension
      (FiniteField.Extension k p n) p (coverDegree k F).factorial)).comp
      (algebraMap k (FiniteField.Extension k p n))).toAlgebra
  haveI : IsScalarTower k (FiniteField.Extension k p n) (FiniteField.Extension
      (FiniteField.Extension k p n) p (coverDegree k F).factorial) :=
    IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hfrK0 : finrank k (FiniteField.Extension k p n) = n := FiniteField.finrank_extension k p n
  have hfrE : finrank (FiniteField.Extension k p n) (FiniteField.Extension
      (FiniteField.Extension k p n) p (coverDegree k F).factorial) = (coverDegree k F).factorial :=
    FiniteField.finrank_extension _ p _
  have hdvd : finrank k (CoverConstants k F) ∣ finrank k (FiniteField.Extension
      (FiniteField.Extension k p n) p (coverDegree k F).factorial) := by
    rw [← Module.finrank_mul_finrank k (FiniteField.Extension k p n) (FiniteField.Extension
      (FiniteField.Extension k p n) p (coverDegree k F).factorial), hfrE]
    apply Dvd.dvd.mul_left
    exact Nat.dvd_factorial (Module.finrank_pos (R := k) (M := CoverConstants k F))
      (coverConstants_degree_le k F)
  obtain ⟨f0⟩ := FiniteField.nonempty_algHom_of_finrank_dvd (F := k) (K := CoverConstants k F)
    (L := FiniteField.Extension (FiniteField.Extension k p n) p (coverDegree k F).factorial) hdvd
  letI := f0.toAlgebra
  haveI := IsScalarTower.of_algHom f0
  have h := level_core k F p (FiniteField.Extension k p n) (FiniteField.Extension
      (FiniteField.Extension k p n) p (coverDegree k F).factorial) a hq hfrE (by rw [hfrK0]; exact ht)
  rw [hfrK0] at h
  exact h
end Wrap
