    calc 70 ≤ 10^41 * 1 := by norm_num
      _ ≤ 10^41 * (n+1)^40 := Nat.mul_le_mul_left _ h1
  have hsum := sum_le_largeTimeBound (n := n) [cP, cS, cR, cF, cC, 70]
    (by simp) (by
      intro x hx
      simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
