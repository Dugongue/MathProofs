namespace Mathproof.Problem18CyclicPrimaryDensity20260930
open Polynomial
open scoped BigOperators
open Mathproof.Problem18CyclicPrimaryVectors20260930
open Mathproof.Problem18DistinctDegreeSquare20260930
variable {K V ι : Type*} [Field K] [Fintype K] [Fintype ι]
  [AddCommGroup V] [Module K V]
theorem cyclic_vector_fraction (S : Module.End K V) (g : ι → K[X])
    [∀ i,Fact (Irreducible (g i))]
    (hcop : Pairwise (fun i j => IsCoprime (g i) (g j)))
    (E : (∀ i,AdjoinRoot (g i)) ≃ₗ[K] V)
    (hE : ∀ x,E (fun i => AdjoinRoot.root (g i)*x i)=S (E x)) :
    (Nat.card {x : V // PolynomiallyCyclic S x} : ℝ)/(Nat.card V:ℝ)=
      ∏ i,(1-((Nat.card K:ℝ)^(g i).natDegree)⁻¹) := by
  classical
  have hc := cyclic_vector_card S g hcop E hE
  have hv : Nat.card V=∏ i,Nat.card K^(g i).natDegree := by
