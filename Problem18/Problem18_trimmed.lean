variable {K : Type} [Field K] [Fintype K] [DecidableEq K]
def thresholdValue (thresholdBank : String) (σ : Env) : Nat :=
  (σ.arrs thresholdBank).getD 0 0
structure RawReady (F : FieldPresentation K) (q : RNames) (cn : CNames)
    (n d B : Nat) (rows : List (DenseInput n d K)) (S : Nat)
    (ρ : Env) : Prop where
  loaded : Mathproof.Problem18ClaudeIMPLoaded20261001.Loaded
    F canonical q cn d rows ρ
  slots : Slots F canonical q.WS S B ρ
  zero : val F canonical q.WS ρ 0 = 0
  workspace : rowStart (lenL n d (geoE n d))
      (rows.length * lenM n (geoE n d)) +
      rows.length * boxSize n d ≤ S
  separated : inStart (boxSize n d) 0 + rows.length * boxSize n d ≤
      rowStart (lenL n d (geoE n d))
        (rows.length * lenM n (geoE n d))
  rows_word : rows.length < B
  monomials_word : lenM n (geoE n d) < B
  dense_word : lenD n d < B
  rowsize_word : lenL n d (geoE n d) < B
  memory_words : ∀ k (hk : k < (ρ.arrs canonical.mem).length),
    (ρ.arrs canonical.mem)[k] < B
theorem RawReady.of_equiv
    {F : FieldPresentation K} {q : RNames} {cn : CNames}
    {n d B S : Nat} {rows : List (DenseInput n d K)} {ρ τ : Env}
    (h : RawReady F q cn n d B rows S ρ)
    (he : τ.vars canonical.e = ρ.vars canonical.e)
    (hp : τ.vars canonical.p = ρ.vars canonical.p)
    (hm : τ.vars canonical.modBase = ρ.vars canonical.modBase)
    (hx : τ.vars canonical.exp = ρ.vars canonical.exp)
    (hws : τ.vars q.WS = ρ.vars q.WS)
    (hN : τ.vars q.N = ρ.vars q.N)
    (hR : τ.vars cn.R = ρ.vars cn.R)
    (hmem : τ.arrs canonical.mem = ρ.arrs canonical.mem)
    (hscratch : (τ.arrs canonical.scratch).length =
      (ρ.arrs canonical.scratch).length)
    (hinp : τ.inp = ρ.inp) :
    RawReady F q cn n d B rows S τ := by
  have hval : ∀ s, val F canonical q.WS τ s = val F canonical q.WS ρ s := by
    intro s
    unfold val
    apply congrArg (Mathproof.Problem18IMPFieldPresentation20261001.decode F)
    funext i
    simp only [Mathproof.Problem18IMPFieldPresentation20261001.slice, hws, hmem]
  refine
    { loaded := ?_
      slots := ?_
      zero := by simpa [hval] using h.zero
      workspace := h.workspace
      separated := h.separated
      rows_word := h.rows_word
      monomials_word := h.monomials_word
      dense_word := h.dense_word
      rowsize_word := h.rowsize_word
      memory_words := ?_ }
  · refine ⟨?_, ?_, ?_⟩
    · rw [hN]
      exact h.loaded.1
    · rw [hR]
      exact h.loaded.2.1
    · intro t ht k
      rw [hval]
      exact h.loaded.2.2 t ht k
  · exact
      { base :=
          { names := h.slots.base.names
            degree := he.trans h.slots.base.degree
            prime := hp.trans h.slots.base.prime
            arithmetic_word := h.slots.base.arithmetic_word
            inverse_word := h.slots.base.inverse_word
            memory_word := by simpa [hmem] using h.slots.base.memory_word
            scratch_word := by
              rw [hscratch]
              exact h.slots.base.scratch_word
            scratch_fit := by
              rw [hscratch]
              exact h.slots.base.scratch_fit
            modulus_fit := by
              rw [hm, hmem]
              exact h.slots.base.modulus_fit
            modulus_value := by
              intro i
              rw [hm, hmem]
              exact h.slots.base.modulus_value i
            exp_word := by rw [hx]; exact h.slots.base.exp_word
            priv := h.slots.base.priv }
        ws_reg := h.slots.ws_reg
        fit := by rw [hws, hmem]; exact h.slots.fit
        modulus_apart := by rw [hm, hws]; exact h.slots.modulus_apart
        canon := by
          intro s hs
          intro i
          change (τ.arrs canonical.mem).getD
            (τ.vars q.WS + s * F.e + i.val) 0 < F.p
          rw [hws, hmem]
          exact h.slots.canon s hs i
        slots_word := h.slots.slots_word }
  · intro k hk
    have hk' : k < (ρ.arrs canonical.mem).length := by
      simpa only [hmem] using hk
    simpa only [hmem] using h.memory_words k hk'
def RestorableRawBank (P : Config) (F : FieldPresentation K) (cn : CNames)
    (thresholdBank rowCountBank rawRowsBank : String) (n l d : Nat)
    (rows : List (DenseInput n d K)) (σ : Env) : Prop :=
  ∃ ρ : Env,
    (∀ B, thresholdValue thresholdBank σ < B →
      ∃ S, RawReady F names.q cn n d B rows S ρ) ∧
    σ.arrs rawRowsBank = ρ.arrs canonical.mem ∧
    σ.arrs P.layoutBank = image P.count ρ ∧
    ρ.vars P.count = (ρ.arrs canonical.mem).length ∧
    (σ.arrs canonical.mem).length = (ρ.arrs canonical.mem).length ∧
    (σ.arrs canonical.scratch).length = (ρ.arrs canonical.scratch).length ∧
    σ.inp = ρ.inp ∧
    (σ.arrs rowCountBank)[0]? = some rows.length
def rawMaterializeCost (P : Config) (d R : Nat) : Nat :=
  12 * P.memoryCap d R + 33
theorem rawMaterializeCost_mono (P : Config) (d R R' : Nat) (h : R ≤ R') :
    rawMaterializeCost P d R ≤ rawMaterializeCost P d R' := by
  unfold rawMaterializeCost
  have := P.memoryCap_mono d R R' h
  omega
def CertifiedBankLoaded (P : Config) (F : FieldPresentation K)
    (rowCountBank thresholdBank : String) (n l d : Nat)
    (rows : List (DenseInput n d K)) (σ : Env) : Prop :=
  ∃ ρ : Env,
    (∀ B, thresholdValue thresholdBank σ < B →
      Reference P F n d B rows ρ) ∧
    σ.arrs P.memoryBank = ρ.arrs canonical.mem ∧
    σ.arrs P.layoutBank = image P.count ρ ∧
    (σ.arrs canonical.mem).length = (ρ.arrs canonical.mem).length ∧
    σ.inp = ρ.inp ∧
    (σ.arrs rowCountBank)[0]? = some rows.length ∧
    0 < (σ.arrs thresholdBank).length
def materializeProgram : Com := .skip
def materializeCost (_d _R : Nat) : Nat := 1
theorem materializeCost_mono (d R R' : Nat) (h : R ≤ R') :
    materializeCost d R ≤ materializeCost d R' := by
  rfl
theorem materialize_details
    (P : Config) (F : FieldPresentation K)
    (rowCountBank thresholdBank : String)
    (n l d B : Nat) (rows : List (DenseInput n d K)) (σ : Env)
    (h : CertifiedBankLoaded P F rowCountBank thresholdBank n l d rows σ)
    (hbase : Base F canonical B σ)
    (hbound : thresholdValue thresholdBank σ < B) :
    ∃ ξ ρ, Run B materializeProgram σ ξ (materializeCost d rows.length) ∧
      Reference P F n d B rows ρ ∧
      Ready F B ρ P.memoryBank P.layoutBank P.count ξ ∧
      (ξ.arrs rowCountBank)[0]? = some rows.length ∧
      thresholdValue thresholdBank ξ < B := by
  obtain ⟨ρ, href, hm, hl, hml, hi, hrc, _⟩ := h
  refine ⟨σ, ρ, ?_, href B hbound, ?_, hrc, hbound⟩
  · simpa only [materializeProgram, materializeCost] using
      (Run.skip (B := B) (σ := σ))
  · exact
      { base := hbase
        memory := hm
        layout := hl
        memLength := hml
        input := hi }
theorem materialize_run
    (P : Config) (F : FieldPresentation K)
    (rowCountBank thresholdBank : String)
    (n l d B : Nat) (rows : List (DenseInput n d K)) (σ : Env)
    (h : CertifiedBankLoaded P F rowCountBank thresholdBank n l d rows σ)
    (hbase : Base F canonical B σ)
    (hbound : thresholdValue thresholdBank σ < B) :
    ∃ ξ, Run B materializeProgram σ ξ (materializeCost d rows.length) ∧
      Loaded P F n l d B rows ξ ∧
      (ξ.arrs rowCountBank)[0]? = some rows.length ∧
      thresholdValue thresholdBank ξ < B := by
  obtain ⟨ξ, ρ, hr, href, hready, hrow, hthreshold⟩ :=
    materialize_details P F rowCountBank thresholdBank n l d B rows σ
      h hbase hbound
  exact ⟨ξ, hr, ⟨ρ, href, hready⟩, hrow, hthreshold⟩
end
