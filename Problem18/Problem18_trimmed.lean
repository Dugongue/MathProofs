variable {K a b t : Type*} [Field K] [StarRing K]
  [Fintype a] [DecidableEq a] [Fintype b] [DecidableEq b]
def crossGram (A : t → Matrix a b K) (kl : t × t) : Matrix a a K :=
  A kl.1 * (A kl.2)ᴴ
theorem crossGram_mate (A : t → Matrix a b K) (kl : t × t) :
    (crossGram A kl.swap)ᴴ = crossGram A kl := by
  simp [crossGram, Matrix.conjTranspose_mul]
theorem crossGram_smul (A : t → Matrix a b K) (z : K) (kl : t × t) :
    crossGram (fun k => z • A k) kl = (star z * z) • crossGram A kl := by
  simp only [crossGram, Matrix.conjTranspose_smul, Matrix.smul_mul, Matrix.mul_smul,
    smul_smul, mul_comm z (star z)]
end Problem18CorrectedCrossGram20260930
