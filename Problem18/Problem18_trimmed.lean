variable {K V W Z : Type*} [Field K] [Fintype K]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  [AddCommGroup W] [Module K W] [FiniteDimensional K W]
  [AddCommGroup Z] [Module K Z] [FiniteDimensional K Z]
noncomputable def conjugateKernelEquiv (e : V ≃ₗ[K] W) (S : Module.End K V) (p : K[X]) :
    LinearMap.ker (aeval S p) ≃ₗ[K] LinearMap.ker (aeval (e.conj S) p) := by
  have h (x : V) : aeval (e.conj S) p (e x)=e (aeval S p x) := by
    have heq : e.conj S=(e.conjAlgEquiv K) S := by
      apply LinearMap.ext
      intro z
      rfl
    rw [heq,aeval_algHom_apply (e.conjAlgEquiv K) S p]
    change e (aeval S p (e.symm (e x)))=e (aeval S p x)
    rw [e.symm_apply_apply]
  refine {
    toFun := fun x=>⟨e x.val,by rw [LinearMap.mem_ker,h,x.property,map_zero]⟩
    invFun := fun y=>⟨e.symm y.val,by
      apply e.injective
      rw [map_zero,←h,e.apply_symm_apply]
      exact y.property⟩
    left_inv := fun x=>Subtype.ext (e.symm_apply_apply x.val)
    right_inv := fun y=>Subtype.ext (e.apply_symm_apply y.val)
    map_add' := fun x y=>Subtype.ext (e.map_add x.val y.val)
    map_smul' := fun c x=>Subtype.ext (e.map_smul c x.val) }
theorem kernel_coordinates_conj_iff (B : LinearMap.BilinForm K V)
    (C : LinearMap.BilinForm K W) (D : LinearMap.BilinForm K Z)
    (e : V ≃ₗ[K] W) (he : ∀ x y,C (e x) (e y)=B x y)
    (S : Module.End K V) (p : K[X]) :
    (∃ j : Z ≃ₗ[K] LinearMap.ker (aeval S p),∀ x y,B (j x).val (j y).val=D x y) ↔
    (∃ j : Z ≃ₗ[K] LinearMap.ker (aeval (e.conj S) p),∀ x y,C (j x).val (j y).val=D x y) := by
  let E := conjugateKernelEquiv e S p
  constructor
  · rintro ⟨j,hj⟩
    refine ⟨j.trans E,fun x y=>?_⟩
    change C (e (j x).val) (e (j y).val)=D x y
    rw [he,hj]
  · rintro ⟨j,hj⟩
    refine ⟨j.trans E.symm,fun x y=>?_⟩
    change B (e.symm (j x).val) (e.symm (j y).val)=D x y
    rw [←he,e.apply_symm_apply,e.apply_symm_apply,hj]
noncomputable def classifiedOperatorsEquiv
    (H : LinearMap.BilinForm K V) (p : K[X])
    (cd : FormClass K p.natDegree × FormClass K (Module.finrank K V-p.natDegree))
    (e : ((Fin p.natDegree→K) × (Fin (Module.finrank K V-p.natDegree)→K)) ≃ₗ[K] V)
    (he : ∀ x y,H (e x) (e y)=(representative K cd.1).val x.1 y.1+(representative K cd.2).val x.2 y.2) :
    KernelOperators (representative K cd.1).val (representative K cd.2).val p ≃
      {S : SelfAdjointOperators (RingEquiv.refl K) H // ClassifiedEvent H p cd S} := by
  let B := (representative K cd.1).val
  let C := (representative K cd.2).val
  let A := sumForm (RingEquiv.refl K) B C
  let E := operatorIsometryEquiv A H e he
  refine E.subtypeEquiv (fun S=>?_)
  have hχ : (E S).val.charpoly=S.val.charpoly := LinearEquiv.charpoly_conj e S.val
  have hp := kernel_coordinates_conj_iff A H B e he S.val p
  have hq := kernel_coordinates_conj_iff A H C e he S.val (S.val.charpoly/p)
  change (p∣S.val.charpoly ∧ IsCoprime p (S.val.charpoly/p) ∧ _ ∧ _) ↔
    (p∣(E S).val.charpoly ∧ IsCoprime p ((E S).val.charpoly/p) ∧ _ ∧ _)
  rw [hχ]
  exact and_congr Iff.rfl (and_congr Iff.rfl (and_congr hp hq))
theorem classified_event_has_model (H : LinearMap.BilinForm K V)
    (p : K[X]) (hm : p.Monic)
    (cd : FormClass K p.natDegree × FormClass K (Module.finrank K V-p.natDegree))
    (S : SelfAdjointOperators (RingEquiv.refl K) H) (hS : ClassifiedEvent H p cd S) :
    ∃ e : ((Fin p.natDegree→K) × (Fin (Module.finrank K V-p.natDegree)→K)) ≃ₗ[K] V,
      ∀ x y,H (e x) (e y)=(representative K cd.1).val x.1 y.1+(representative K cd.2).val x.2 y.2 := by
  obtain ⟨hd,hc,⟨e,he⟩,⟨k,hk⟩⟩ := hS
  let q := S.val.charpoly/p
  have hχ : S.val.charpoly=p*q := (EuclideanDomain.mul_div_cancel' hm.ne_zero hd).symm
  let U := LinearMap.ker (aeval S.val p)
  let Z := LinearMap.ker (aeval S.val q)
  let E := Submodule.prodEquivOfIsCompl U Z (isCompl_primarySpaces_of_charpoly_eq_mul hc hχ)
  refine ⟨(e.prodCongr k).trans E,fun x y=>?_⟩
  change H ((e x.1).val+(k x.2).val) ((e y.1).val+(k y.2).val)=_
  have hfg : H (e x.1).val (k y.2).val=0 :=
    coprime_kernels_pairing_eq_zero S.property hc (e x.1).property (k y.2).property
  have hgf : H (k x.2).val (e y.1).val=0 :=
    coprime_kernels_pairing_eq_zero S.property hc.symm (k x.2).property (e y.1).property
  simp only [map_add,LinearMap.add_apply,hfg,hgf,add_zero,zero_add]
  exact congrArg₂ (·+·) (he x.1 y.1) (hk x.2 y.2)
theorem odd_classified_event_card {ι : Type*} [Fintype ι] [Nonempty ι]
    (g : ι → K[X]) [∀ i,Fact (Irreducible (g i))] (hodd : ringChar K ≠ 2)
    (hm : ∀ i,(g i).Monic) (hc : Pairwise (fun i j=>IsCoprime (g i) (g j)))
    (H : LinearMap.BilinForm K V)
    (cd : FormClass K (∏ i,g i).natDegree × FormClass K (Module.finrank K V-(∏ i,g i).natDegree))
    (e : ((Fin (∏ i,g i).natDegree→K) × (Fin (Module.finrank K V-(∏ i,g i).natDegree)→K)) ≃ₗ[K] V)
    (he : ∀ x y,H (e x) (e y)=(representative K cd.1).val x.1 y.1+(representative K cd.2).val x.2 y.2) :
    Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) H // ClassifiedEvent H (∏ i,g i) cd S} *
        2*Nat.card (Isometries (RingEquiv.refl K) (representative K cd.2).val)=
      Nat.card (Isometries (RingEquiv.refl K) H)*
        Nat.card {D : SelfAdjointOperators (RingEquiv.refl K) (representative K cd.2).val //
          IsCoprime (∏ i,g i) D.val.charpoly} := by
  rw [←Nat.card_congr (classifiedOperatorsEquiv H (∏ i,g i) cd e he)]
  have h := odd_kernel_event_card g hodd hm hc (representative K cd.1).val
    (representative K cd.2).val (representative K cd.1).property.1
    (representative K cd.1).property.2 (by
      simpa using Polynomial.natDegree_prod_of_monic _ _ (fun i _=>hm i))
  rw [Mathproof.Problem18FormIsometryTransport20260930.isometry_card_eq
    (RingEquiv.refl K) _ H e he] at h
  exact h
theorem charTwo_classified_event_card [CharP K 2]
    {ι : Type*} [Fintype ι] [Nonempty ι]
    (g : ι → K[X]) [∀ i,Fact (Irreducible (g i))]
    (hm : ∀ i,(g i).Monic) (hc : Pairwise (fun i j=>IsCoprime (g i) (g j)))
    (H : LinearMap.BilinForm K V)
    (cd : FormClass K (∏ i,g i).natDegree × FormClass K (Module.finrank K V-(∏ i,g i).natDegree))
    (ha : ¬(representative K cd.1).val.IsAlt)
    (e : ((Fin (∏ i,g i).natDegree→K) × (Fin (Module.finrank K V-(∏ i,g i).natDegree)→K)) ≃ₗ[K] V)
    (he : ∀ x y,H (e x) (e y)=(representative K cd.1).val x.1 y.1+(representative K cd.2).val x.2 y.2) :
    Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) H // ClassifiedEvent H (∏ i,g i) cd S} *
        Nat.card (Isometries (RingEquiv.refl K) (representative K cd.2).val)=
      Nat.card (Isometries (RingEquiv.refl K) H)*
        Nat.card {D : SelfAdjointOperators (RingEquiv.refl K) (representative K cd.2).val //
          IsCoprime (∏ i,g i) D.val.charpoly} := by
  rw [←Nat.card_congr (classifiedOperatorsEquiv H (∏ i,g i) cd e he)]
  have h := charTwo_kernel_event_card g hm hc (representative K cd.1).val
    (representative K cd.2).val (representative K cd.1).property.1
    (representative K cd.1).property.2 ha (by
      simpa using Polynomial.natDegree_prod_of_monic _ _ (fun i _=>hm i))
  rw [Mathproof.Problem18FormIsometryTransport20260930.isometry_card_eq
    (RingEquiv.refl K) _ H e he] at h
  exact h
end
