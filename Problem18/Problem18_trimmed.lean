variable {K : Type} [Field K] [Fintype K] (F : FieldPresentation K)
theorem slots_of_valid {W Sn : Nat} {σ : Env} {WS : String} (hv : ValidMemory F W σ)
    (hlen : (σ.arrs canonical.mem).length = F.e + 1 + Sn * F.e)
    (hws : σ.vars WS = F.e + 1) (hmod : σ.vars canonical.modBase = 0)
    (hscr : 16 * (F.e + 1) ≤ (σ.arrs canonical.scratch).length)
    (hexp : σ.vars canonical.exp < W) (hSn : Sn < W) (hwsr : WS ∉ regNames canonical) :
    Slots F canonical WS Sn W σ where
  base := {
    names := canonical_valid
    degree := hv.degree
    prime := hv.prime
    arithmetic_word := hv.arithmetic_word
    inverse_word := hv.inverse_word
    memory_word := hv.memory_word
    scratch_word := hv.scratch_word
    scratch_fit := hscr
    modulus_fit := by rw [hmod, hlen]; omega
    modulus_value := by
      intro i
      have := hv.modulus_value i
      unfold Problem18IMPFieldMultiplication20261001.sourceCoeff at this
      exact this
    exp_word := hexp
    priv := by decide }
  ws_reg := hwsr
  fit := by rw [hws, hlen] <;> omega
  modulus_apart := Or.inl (by rw [hmod, hws]; omega)
  canon := by
    intro s hs t
    simp only [slice]
    apply hv.coefficients
    rw [hlen, hws]
    have ht := t.isLt
    have := Nat.mul_le_mul_right F.e (Nat.succ_le_of_lt hs)
    rw [Nat.succ_mul] at this
    omega
  slots_word := hSn
