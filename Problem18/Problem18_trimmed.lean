    change (∑y,(ψ.compAddMonoidHom (B x).toAddMonoidHom) y)=_
    rw [AddChar.sum_eq_ite]
    change (if ψ.compAddMonoidHom (B x).toAddMonoidHom=1 then _ else _)=_
    simp only [he]
