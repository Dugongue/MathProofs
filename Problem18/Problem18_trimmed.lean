variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
theorem krylovStage_run_band {B n : Nat} (mS tS : SizeExpr) {m t : Nat}
    (hmv : value mS n F.e=m) (htv : value tS n F.e=t)
    (hmt : m+n*n ≤ t) (htw : t+n*n ≤ sKW n) (hwe : sKW n+3 ≤ oddEnd n)
    (hn : 0<n) (σ : Env) (hv : ValidMemory F B σ)
    (hc : σ.vars colsR=n) (hexp : σ.vars canonical.exp<B) (hmod : σ.vars canonical.modBase=0)
    (hlen : (σ.arrs canonical.mem).length=memLen n F.e)
    (hbm : majorant (byteS mS) n F.e<B) (hbt : majorant (byteS tS) n F.e<B)
    (hbw : majorant (byteS sKWS) n F.e<B) :
    ∃τ c, Run B (krylovStage mS tS) σ τ c ∧
      c ≤ 60+(byteE mS).size+(byteE tS).size+(byteE sKWS).size+
        Problem18IMPBoundaryKrylov20261001.loopCost F.e n (n-1) ∧
      ValidMemory F B τ ∧
      (∀j<phys F.e t+F.e*n,(τ.arrs canonical.mem).getD j 0=(σ.arrs canonical.mem).getD j 0) ∧
      (∀j,phys F.e t+F.e*(n*n) ≤ j → j<phys F.e (sKW n) →
        (τ.arrs canonical.mem).getD j 0=(σ.arrs canonical.mem).getD j 0) ∧
      (∀j<n,∀i:Fin n,Problem18IMPBoundaryKrylov20261001.value F τ (phys F.e t) n i.val j=
        ((Problem18IMPMatrixMemory20261001.matrix F σ (phys F.e m) n n)^j).mulVec
          (fun k=>Problem18IMPBoundaryKrylov20261001.value F σ (phys F.e t) n k.val 0) i) ∧
      (∀a,(τ.arrs a).length=(σ.arrs a).length) ∧
      (∀x,x∉scalarWrites (krylovStage mS tS) → τ.vars x=σ.vars x) ∧
      (∀a,a∉arrayWrites (krylovStage mS tS) → τ.arrs a=σ.arrs a) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hE := F.degree_pos
  have he := hv.degree
  have hL : memLen n F.e=F.e+1+Problem18IMPBoundaryCyclicLayout20261002.slots n*F.e := rfl
  have hLB := hv.memory_word
  rw [hlen] at hLB
  obtain ⟨_,_,hEnd⟩:=layout_facts n
  have hwE := Nat.mul_le_mul_right F.e (hwe.trans hEnd)
  have hmtE := Nat.mul_le_mul_right F.e hmt
  have htwE := Nat.mul_le_mul_right F.e htw
  simp only [Nat.add_mul] at hwE hmtE htwE
  have hcm : F.e*(n*n)=n*n*F.e := by ring
  have hnE : n ≤ n*F.e := Nat.le_mul_of_pos_right n hE
  have hnB : n<B := by rw [hL] at hLB;nlinarith
  let s1:=σ.setVar KR n
  let s2:=s1.setVar KL (n-1)
  let s3:=s2.setVar KM (phys F.e m)
  let s4:=s3.setVar KT (phys F.e t)
  let s5:=s4.setVar KW (phys F.e (sKW n))
  have hc1 : s1.vars colsR=n := by simp only [s1];rw [setVar_cols (by decide)];exact hc
  have hc2 : s2.vars colsR=n := by simp only [s2];rw [setVar_cols (by decide)];exact hc1
  have hc3 : s3.vars colsR=n := by simp only [s3];rw [setVar_cols (by decide)];exact hc2
  have hc4 : s4.vars colsR=n := by simp only [s4];rw [setVar_cols (by decide)];exact hc3
  have he1 : s1.vars canonical.e=F.e := by simp only [s1];rw [setVar_e (by decide)];exact he
  have he2 : s2.vars canonical.e=F.e := by simp only [s2];rw [setVar_e (by decide)];exact he1
  have he3 : s3.vars canonical.e=F.e := by simp only [s3];rw [setVar_e (by decide)];exact he2
  have he4 : s4.vars canonical.e=F.e := by simp only [s4];rw [setVar_e (by decide)];exact he3
  have r1 : Run B (.assign KR (.var colsR)) σ s1 2 := Run.assign (by
    rw [← hc];exact evalB_var (by rw [hc];exact hnB))
  have r2 : Run B (.assign KL (.bin .sub (.var colsR) (.lit 1))) s1 s2 4 := Run.assign
    (evalB_bin (op:=.sub) (by rw [← hc1];exact evalB_var (by rw [hc1];exact hnB))
      (evalB_lit (by omega)) (by show n-1<B;omega))
  have r3 : Run B (.assign KM (byteE mS)) s2 s3 (1+(byteE mS).size) := Run.assign (by
    rw [← hmv];exact byteEval mS hc2 he2 hbm)
  have r4 : Run B (.assign KT (byteE tS)) s3 s4 (1+(byteE tS).size) := Run.assign (by
    rw [← htv];exact byteEval tS hc3 he3 hbt)
  have r5 : Run B (.assign KW (byteE sKWS)) s4 s5 (1+(byteE sKWS).size) := Run.assign (by
    rw [← v_sKW n F.e];exact byteEval sKWS hc4 he4 hbw)
  have hv5 : ValidMemory F B s5 := by
    simp only [s5,s4,s3,s2,s1]
    repeat' apply Problem18IMPMatrixDot20261001.validMemory_setVar F
    all_goals first | exact hv | decide
  have hin : Problem18IMPBoundaryKrylov20261001.Input F B s5 := {
    valid:=hv5
    n_word:=by simp (config := {decide := true}) [s5,s4,s3,s2,s1,KR,KL,KM,KT,KW];exact hnB
    limit_le:=by simp (config := {decide := true}) [s5,s4,s3,s2,s1,KR,KL,KM,KT,KW]
    exponent:=by simp (config := {decide := true}) [s5,s4,s3,s2,s1,KR,KL,KM,KT,KW,canonical];exact hexp
    matrix_after_modulus:=by
      simp (config := {decide := true}) [s5,s4,s3,s2,s1,KR,KL,KM,KT,KW,canonical]
      rw [show σ.vars "P18.modBase"=σ.vars canonical.modBase from rfl,hmod];unfold phys;omega
    table_after_matrix:=by
      simp (config := {decide := true}) [s5,s4,s3,s2,s1,KR,KL,KM,KT,KW];unfold phys;rw [hcm];omega
    work_after_table:=by
      simp (config := {decide := true}) [s5,s4,s3,s2,s1,KR,KL,KM,KT,KW]
      rw [show n-1+1=n by omega];unfold phys;rw [hcm];omega
    work_fit:=by
      simp (config := {decide := true}) [s5,s4,s3,s2,s1,KR,KL,KM,KT,KW]
      rw [hlen];unfold phys memLen;omega }
  obtain ⟨τ,hr,hI,hband,hidx⟩:=routine_run_band F hin
  have hrun : Run B (krylovStage mS tS) σ τ
      (2+(4+((1+(byteE mS).size)+((1+(byteE tS).size)+(1+(byteE sKWS).size))))+
        Problem18IMPBoundaryKrylov20261001.loopCost F.e (s5.vars KR) (s5.vars KL)) :=
    (r1.seq (r2.seq (r3.seq (r4.seq r5)))).seq hr
  have hKR : s5.vars KR=n := by simp (config := {decide := true}) [s5,s4,s3,s2,s1,KR,KL,KM,KT,KW]
  have hKL : s5.vars KL=n-1 := by simp (config := {decide := true}) [s5,s4,s3,s2,s1,KR,KL,KM,KT,KW]
  have hKM : s5.vars KM=phys F.e m := by simp (config := {decide := true}) [s5,s4,s3,s2,s1,KR,KL,KM,KT,KW]
  have hKT : s5.vars KT=phys F.e t := by simp (config := {decide := true}) [s5,s4,s3,s2,s1,KR,KL,KM,KT,KW]
  have hKW : s5.vars KW=phys F.e (sKW n) := by simp (config := {decide := true}) [s5,s4,s3,s2,s1,KR,KL,KM,KT,KW]
  refine ⟨τ,_,hrun,?_,hI.valid,?_,?_,?_,?_,?_,?_,hI.input_tape.trans rfl,hI.output_tape.trans rfl⟩
  · rw [hKR,hKL];omega
  · intro j hj
    have := hI.memory_prefix j (by rw [hKT,hKR];exact hj)
    simpa [s5,s4,s3,s2,s1] using this
  · intro j hj1 hj2
    have hb := hband j
      (by
        show s5.vars KT+F.e*((s5.vars KL+1)*s5.vars KR) ≤ j
        rw [hKT,hKL,hKR,show n-1+1=n by omega];exact hj1)
      (by show j<s5.vars KW;rw [hKW];exact hj2)
    simpa [s5,s4,s3,s2,s1] using hb
  · intro j hj i
    have h:=orbits_at F hI hidx hKR j (by rw [hKL];omega) i
    rw [hKT,hKM] at h
    simpa [s5,s4,s3,s2,s1] using h
  · intro a;rw [hI.lengths a];simp [s5,s4,s3,s2,s1]
  · intro x hx;exact (run_frame hrun).1 x hx
  · intro a ha;exact (run_frame hrun).2.1 a ha
end Mathproof.Problem18PairBoundaryOddComposeKrylov20261004
