variable {N : Nat} {K : Type*} [Field K]
def geometricFeasible [DecidableEq K] (d : Nat) (vs : List (DenseInput N d K)) : Bool × Nat :=
  let r := unitIdealCheck d vs
  (!r.1,r.2+1)
theorem one_mem_ideal_iff_no_geometric_root
    {L : Type*} [Field L] [Algebra K L] [IsAlgClosed L]
    [DecidableEq K] (fs : List (MvPolynomial (Fin N) K)) :
    (1 : MvPolynomial (Fin N) K) ∈ generatedIdeal (fs.toFinset : Set (MvPolynomial (Fin N) K)) ↔
      ¬ ∃ x : Fin N → L, ∀ f ∈ fs, aeval x f = 0 := by
  classical
  constructor
  · intro h1 ⟨x,hx⟩
    have hxI : x ∈ zeroLocus L (generatedIdeal (fs.toFinset : Set (MvPolynomial (Fin N) K))) := by
      rw [generatedIdeal,zeroLocus_span]
      intro f hf
      exact hx f (List.mem_toFinset.mp hf)
    have hz := hxI 1 h1
    simpa using hz
  · intro hnone
    by_contra h1
    have hne : generatedIdeal (fs.toFinset : Set (MvPolynomial (Fin N) K)) ≠ ⊤ := by
      intro htop
      exact h1 (htop ▸ Submodule.mem_top)
    obtain ⟨M,hmax,hIM⟩ := Ideal.exists_le_maximal _ hne
    obtain ⟨x,hMx⟩ := eq_vanishingIdeal_singleton_of_isMaximal L hmax
    apply hnone
    refine ⟨x,?_⟩
    intro f hf
    have hfM := hIM (Ideal.subset_span (List.mem_toFinset.mpr hf))
    rw [hMx] at hfM
    exact (mem_vanishingIdeal_singleton_iff x f).mp hfM
theorem geometricFeasible_correct
    {L : Type*} [Field L] [Algebra K L] [IsAlgClosed L]
    [DecidableEq K] (d : Nat) (vs : List (DenseInput N d K))
    (fs : List (MvPolynomial (Fin N) K))
    (hvalid : List.Forall₂ (ValidDenseInput d) vs fs) :
    (geometricFeasible d vs).1 = true ↔
      ∃ x : Fin N → L, ∀ f ∈ fs, aeval x f = 0 := by
  classical
  change (!(unitIdealCheck d vs).1) = true ↔ _
  rw [Bool.not_eq_true',← Bool.eq_false_eq_not_eq_true,unitIdealCheck_correct d vs fs hvalid,
    one_mem_ideal_iff_no_geometric_root (L := L) fs]
  exact not_not
theorem geometricFeasible_elimination_cost [DecidableEq K]
    (d : Nat) (vs : List (DenseInput N d K)) :
    (geometricFeasible d vs).2 ≤
      let E := 2*d*2^(controlledDepth N d)
      let r := vs.length*(multiplierExponents N E).length
      let c := (d+E+1)^N
      r*c+(2*c+1)*r^2+c+1 := by
  exact Nat.add_le_add_right (unitIdealCheck_cost d vs) 1
end Mathproof.Problem18GeometricEmptinessAlgorithm20260930
