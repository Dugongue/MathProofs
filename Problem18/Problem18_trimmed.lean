  letI : IsDedekindDomain S := integralClosure.isDedekindDomain A F L
  letI : IsFractionRing S L := IsIntegralClosure.isFractionRing_of_finite_extension A F L S
  letI : FaithfulSMul A S := (faithfulSMul_iff_algebraMap_injective A S).mpr (by
    intro a b h
    apply Subtype.ext
    apply (algebraMap F L).injective
    exact congrArg (algebraMap S L) h)
  have hcontains (W : Place k L) (hW : restrictPlace k F L W=P) :
      ∀ s : S, algebraMap S L s∈W.toValuationSubring := by
    have hA (a : A) : algebraMap A L a∈W.toValuationSubring := by
      have ha := a.property
