variable {V : Type*} [AddCommGroup V]
def Line (a b : V) : Set V := {a, b, a + b}
def LinePreserving (σ : V → V) : Prop :=
  ∀ a b : V, a ≠ 0 → b ≠ 0 → a ≠ b → σ '' Line a b = Line (σ a) (σ b)
theorem third_point_distinct {a b : V} (ha : a ≠ 0) (hb : b ≠ 0) :
    a + b ≠ a ∧ a + b ≠ b := by
  constructor
  · intro h
    have : b = 0 := by
      have h' : a + b = a + 0 := by rw [h, add_zero]
      exact add_left_cancel h'
    exact hb this
  · intro h
    have : a = 0 := by
      have h' : a + b = 0 + b := by rw [h, zero_add]
      exact add_right_cancel h'
    exact ha this
theorem third_point_identity (σ : V → V) (hinj : Function.Injective σ)
    (hline : LinePreserving σ) {a b : V} (ha : a ≠ 0) (hb : b ≠ 0) (hab : a ≠ b) :
    σ (a + b) = σ a + σ b := by
  have hmem : σ (a + b) ∈ σ '' Line a b :=
    Set.mem_image_of_mem σ (by simp [Line])
  rw [hline a b ha hb hab] at hmem
  simp only [Line, Set.mem_insert_iff, Set.mem_singleton_iff] at hmem
  obtain ⟨hne1, hne2⟩ := third_point_distinct ha hb
  rcases hmem with h | h | h
  · exact absurd (hinj h) hne1
  · exact absurd (hinj h) hne2
  · exact h
theorem additive_of_linePreserving (σ : V → V) (h2 : ∀ v : V, v + v = 0)
    (hinj : Function.Injective σ) (h0 : σ 0 = 0) (hline : LinePreserving σ) (a b : V) :
    σ (a + b) = σ a + σ b := by
  by_cases ha : a = 0
  · subst ha; rw [zero_add, h0, zero_add]
  by_cases hb : b = 0
  · subst hb; rw [add_zero, h0, add_zero]
  by_cases hab : a = b
  · subst hab
    rw [h2 a, h0, h2 (σ a)]
  · exact third_point_identity σ hinj hline ha hb hab
noncomputable def toAddAut (σ : V → V) (h2 : ∀ v : V, v + v = 0)
    (hbij : Function.Bijective σ) (h0 : σ 0 = 0) (hline : LinePreserving σ) : V ≃+ V :=
  { Equiv.ofBijective σ hbij with
    map_add' := additive_of_linePreserving σ h2 hbij.injective h0 hline }
theorem toAddAut_apply (σ : V → V) (h2 : ∀ v : V, v + v = 0)
    (hbij : Function.Bijective σ) (h0 : σ 0 = 0) (hline : LinePreserving σ) (v : V) :
    toAddAut σ h2 hbij h0 hline v = σ v := rfl
