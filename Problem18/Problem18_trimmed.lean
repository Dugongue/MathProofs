def discardProgram : DiscardLabel →
    TM2.Stmt (fun _ : DiscardStack => SparseSymbol)
      DiscardLabel SymbolMoveControl
  | .loop =>
      .pop .data (fun _ a => ⟨a⟩) <|
        .branch (fun s => s.held.isNone)
          (.load (fun _ => default) <| .goto fun _ => .done)
          (.load (fun _ => default) <| .goto fun _ => .loop)
  | .done => .halt
