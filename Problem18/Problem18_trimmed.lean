variable {K : Type*} [Field K] [Fintype K] [StarRing K] [TrivialStar K]
noncomputable def symmetricTraceCharacter {n : ℕ} (ψ : AddChar K ℂ)
    (A : selfAdjoint (Matrix (Fin n) (Fin n) K)) :
    AddChar (selfAdjoint (Matrix (Fin n) (Fin n) K)) ℂ :=
  ψ.compAddMonoidHom {
    toFun := fun B => Matrix.trace (A.val * B.val)
    map_zero' := by simp
    map_add' := by intro B C; simp [Matrix.mul_add] }
theorem symmetricTraceCharacter_eq_one_iff {n : ℕ}
    (h2 : (2 : K) ≠ 0) (ψ : AddChar K ℂ) (hψ : ψ ≠ 1)
    (A : selfAdjoint (Matrix (Fin n) (Fin n) K)) :
    symmetricTraceCharacter ψ A = 1 ↔ A = 0 := by
  classical
  constructor
  · intro hh
    apply Subtype.ext
    ext a b
    have hA : A.val.IsSymm := Matrix.isHermitian_iff_isSymm.mp A.property.isHermitian
    have hab : A.val b a = A.val a b := congrFun (congrFun hA.eq a) b
    have hz : ∀ x : K, ψ ((2 * A.val a b) * x) = 1 := by
      intro x
      let C : selfAdjoint (Matrix (Fin n) (Fin n) K) :=
        ⟨Matrix.single a b x + Matrix.single b a x, by
          change (Matrix.single a b x + Matrix.single b a x)ᴴ = _
          simp [Matrix.conjTranspose_single, add_comm]⟩
      have he := congrArg (fun χ => χ C) hh
      change ψ (Matrix.trace (A.val *
        (Matrix.single a b x + Matrix.single b a x))) = 1 at he
      rw [Matrix.trace_mul_comm] at he
      simp only [Matrix.add_mul, Matrix.trace_add, Matrix.trace_single_mul,
        smul_eq_mul, hab] at he
      convert he using 1 <;> congr 1 <;> ring
    have hn : 2 * A.val a b = 0 :=
      (trace_character_nondegenerate (F := K) ψ hψ (2 * A.val a b)).mp
        (by simpa using hz)
    exact (mul_eq_zero.mp hn).resolve_left h2
  · rintro rfl
    ext B
    simp [symmetricTraceCharacter, AddChar.map_zero_eq_one]
theorem symmetricTraceCharacter_bijective {n : ℕ}
    (h2 : (2 : K) ≠ 0) (ψ : AddChar K ℂ) (hψ : ψ ≠ 1) :
    Function.Bijective (symmetricTraceCharacter ψ :
      selfAdjoint (Matrix (Fin n) (Fin n) K) →
        AddChar (selfAdjoint (Matrix (Fin n) (Fin n) K)) ℂ) := by
  classical
  apply (Fintype.bijective_iff_injective_and_card _).2
  refine ⟨?_, by simp only [AddChar.card_eq]⟩
  intro A B hAB
  have hz : symmetricTraceCharacter ψ (A-B) = 1 := by
    ext C
    change ψ (Matrix.trace ((A.val-B.val) * C.val)) = 1
    rw [Matrix.sub_mul, Matrix.trace_sub, sub_eq_add_neg,
      AddChar.map_add_eq_mul, AddChar.map_neg_eq_inv]
    have he := congrArg (fun χ => χ C) hAB
    change ψ (Matrix.trace (A.val*C.val)) = ψ (Matrix.trace (B.val*C.val)) at he
    rw [he]
    apply mul_inv_cancel₀
    intro hzero
    have hn := ψ.norm_apply (Matrix.trace (B.val*C.val))
    rw [hzero, norm_zero] at hn
    norm_num at hn
  exact sub_eq_zero.mp ((symmetricTraceCharacter_eq_one_iff h2 ψ hψ (A-B)).mp hz)
theorem symmetricTraceCharacter_rankOne {n : ℕ} (ψ : AddChar K ℂ)
    (A : selfAdjoint (Matrix (Fin n) (Fin n) K)) (x : Fin n → K) :
    symmetricTraceCharacter ψ A (rankOneHermitian x) =
      ψ (x ⬝ᵥ (A.val *ᵥ x)) := by
  change ψ (Matrix.trace (A.val * (rankOneHermitian x).val)) = _
  congr 1
  simp only [rankOneHermitian, Matrix.trace, Matrix.diag, Matrix.mul_apply, Matrix.mulVec, dotProduct,
    star_trivial]
  apply Finset.sum_congr rfl
  intro a _
  change (∑ b, A.val a b * (x b * x a)) = _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro b _
  change A.val a b * (x b * x a) = x a * (A.val a b * x b)
  ring
open Classical in
theorem symmetric_rankOne_fourier_exact {n : ℕ}
    (h2 : (2 : K) ≠ 0) (ψ : AddChar K ℂ) (hψ : ψ ≠ 1)
    (A : selfAdjoint (Matrix (Fin n) (Fin n) K)) :
    ‖(∑ x, symmetricTraceCharacter ψ A (rankOneHermitian x)) /
        (Fintype.card (Fin n → K) : ℂ)‖ ^ 2 =
      ((Fintype.card K : ℝ) ^ A.val.rank)⁻¹ := by
  classical
  simp_rw [symmetricTraceCharacter_rankOne]
  have hA : A.val.IsSymm := Matrix.isHermitian_iff_isSymm.mp A.property.isHermitian
  have hp : 0 < ringChar K :=
    Nat.pos_of_ne_zero (CharP.ringChar_ne_zero_of_finite K)
  have he := trace_matrix_quadratic_fourier (F := K) hp ψ hψ
    ((2 : K) • A.val) (fun x => x ⬝ᵥ (A.val *ᵥ x)) ?_ ?_
  · rw [Matrix.rank_smul_of_mem_nonZeroDivisors A.val
      (mem_nonZeroDivisors_of_ne_zero h2)] at he
    have hd : instDecidableEqFin n = (fun a b => Classical.propDecidable (a = b)) := Subsingleton.elim _ _
    convert! he using 1
    congr 5 <;> exact Subsingleton.elim _ _
  · intro x h
    have hs : h ⬝ᵥ (A.val *ᵥ x) = x ⬝ᵥ (A.val *ᵥ h) := by
      simpa only [hA.eq] using Matrix.dotProduct_transpose_mulVec A.val h x
    simp only [Matrix.mulVec_add, add_dotProduct, dotProduct_add,
      Algebra.trace_self, LinearMap.id_apply, star_trivial, Matrix.smul_mulVec,
      Pi.smul_apply, smul_eq_mul]
    change _ = _ + _ + ∑ j, x j * (2 * (A.val *ᵥ h) j)
    have heq : (∑ j, x j * (2 * (A.val *ᵥ h) j)) =
        2 * (x ⬝ᵥ (A.val *ᵥ h)) := by
      simp only [dotProduct, Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j _
      ring
    rw [heq, hs]
    ring
  · intro h hh
    rw [Matrix.smul_mulVec] at hh
    have hz : A.val *ᵥ h = 0 := (smul_eq_zero.mp hh).resolve_left h2
    simp [hz]
open Classical in
theorem orthogonal_gram_density_second_moment_le
    (h2 : (2 : K) ≠ 0) (n m : ℕ) (hm : n ≤ m) :
    (Fintype.card (selfAdjoint (Matrix (Fin n) (Fin n) K)) : ℝ) *
        ∑ y, ‖uniformImageWeight
          (fun x : Fin m → (Fin n → K) =>
            gramHermitian (fun a b => x b a)) y‖ ^ 2 ≤ 12 := by
  obtain ⟨ψ, hψ⟩ := Fintype.exists_ne_of_one_lt_card
    (show 1 < Fintype.card (AddChar K ℂ) by
      rw [AddChar.card_eq]; exact Fintype.one_lt_card) (1 : AddChar K ℂ)
  have hp := uniform_sum_density_second_moment
    (rankOneHermitian (K := K) (i := Fin n)) m
  simp only [sum_rankOneHermitian_eq_gram] at hp
  let e := Equiv.ofBijective (symmetricTraceCharacter (n := n) ψ)
    (symmetricTraceCharacter_bijective h2 ψ hψ)
  rw [← Equiv.sum_comp e] at hp
  have he (A : selfAdjoint (Matrix (Fin n) (Fin n) K)) :
      (‖(∑ x, e A (rankOneHermitian x)) /
        (Fintype.card (Fin n → K) : ℂ)‖ ^ 2)^m =
      (((Fintype.card K : ℝ)^A.val.rank)⁻¹)^m := by
    rw [show e A = symmetricTraceCharacter ψ A from rfl,
      symmetric_rankOne_fourier_exact h2 ψ hψ]
  simp_rw [he] at hp
  rw [hp]
  let es : selfAdjoint (Matrix (Fin n) (Fin n) K) ≃ SymMat n K :=
    Equiv.subtypeEquivRight (fun A =>
      Matrix.isHermitian_iff_isSelfAdjoint.symm.trans Matrix.isHermitian_iff_isSymm)
  have hs := Mathproof.Problem18SymmetricEnergy20260930.symmetric_rank_energy_le
    (K := K) n m hm
  rw [← Equiv.sum_comp es] at hs
  exact hs
open Classical in
theorem orthogonal_gram_event_probability_le
    (h2 : (2 : K) ≠ 0) (n m : ℕ) (hm : n ≤ m)
    (E : Finset (selfAdjoint (Matrix (Fin n) (Fin n) K))) :
    ((Finset.univ.filter (fun x : Fin m → (Fin n → K) =>
      gramHermitian (fun a b => x b a) ∈ E)).card : ℝ) /
        Fintype.card (Fin m → (Fin n → K)) ≤
      Real.sqrt (12 * ((E.card : ℝ) /
        Fintype.card (selfAdjoint (Matrix (Fin n) (Fin n) K)))) := by
  have ht := image_event_probability_le_sqrt
    (fun x : Fin m → (Fin n → K) => gramHermitian (fun a b => x b a))
    E 12 (by norm_num) (orthogonal_gram_density_second_moment_le h2 n m hm)
  convert ht using 1
  congr 2
  apply congrArg Finset.card
  ext x
  simp
