  have hmod:τ.vars canonical.modBase=σ.vars canonical.modBase:=hfr.1 _ (by unfold Protected;decide)
  have hexp:τ.vars canonical.exp=σ.vars canonical.exp:=hfr.1 _ (by unfold Protected;decide)
