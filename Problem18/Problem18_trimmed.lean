def digitBody (WS w k : String) (s : Expr) : Com :=
  .seq (.store r.mem (.bin .add (addr r WS s) (.var k)) (remExpr r w))
    (.seq (.assign w (.bin .div (.var w) (.var r.p))) (.assign k (.bin .add (.var k) (.lit 1))))
def digitsCom (WS w k m : String) (s len : Expr) : Com :=
  .seq (.assign w (.var m)) (.seq (.assign k (.lit 0))
