variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}
def reverseNegateBody (M : FieldMacros F r) (q : RNames) (D S : Expr) : Com :=
  .seq (mcall r q M.neg (plus S (.bin .sub (.bin .sub (.var q.N) (.lit 1)) (.var q.j)))
          (plus S (.bin .sub (.bin .sub (.var q.N) (.lit 1)) (.var q.j))) (plus D (.var q.j)))
    (.assign q.j (plus (.var q.j) (.lit 1)))
def reverseNegateLoop (M : FieldMacros F r) (q : RNames) (D S : Expr) : Com :=
  .seq (.assign q.j (.lit 0)) (.while (.lt (.var q.j) (.var q.N)) (reverseNegateBody M q D S))
def reverseNegateStep (M : FieldMacros F r) (D S : Expr) : ℕ := 33 + D.size + 2 * S.size + M.costPoint
def reverseNegateCost (M : FieldMacros F r) (D S : Expr) (N : ℕ) : ℕ :=
  2 + (4 + reverseNegateStep M D S) * N + 4
theorem reverseNegate_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (l : List String)
    (hl : ∀ x ∈ l, x ∉ regNames r ∧ x ≠ q.j) (D S : Expr) (hDp : VarsIn l D)
    (hSp : VarsIn l S) {B Sn : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ)
    {dv sv Nv : ℕ} (hDv : D.evalB B σ = some dv) (hSv : S.evalB B σ = some sv)
    (hN : σ.vars q.N = Nv) (hdfit : dv + Nv ≤ Sn) (hsfit : sv + Nv ≤ Sn)
    (hds : dv + Nv ≤ sv ∨ sv + Nv ≤ dv) :
    ∃ τ, Run B (reverseNegateLoop M q D S) σ τ (reverseNegateCost M D S Nv) ∧ Slots F r q.WS Sn B τ ∧
      (∀ k < Nv, val F r q.WS τ (dv + k) = -val F r q.WS σ (sv + (Nv - 1 - k))) ∧
      (∀ s < Sn, (s < dv ∨ dv + Nv ≤ s) → val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ≠ q.j → τ.vars x = σ.vars x) ∧ τ.vars q.j = Nv ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hSB := hS.slots_word
  have hjS : q.j ∉ regNames r := hq.2 _ q.j_mem
  have hjW : q.j ≠ q.WS := fun h => hq.WS_ne_j h.symm
  have hjA : q.j ≠ r.aBase := (hq.reg_ok q.j_mem).2.1
  have hjB : q.j ≠ r.bBase := (hq.reg_ok q.j_mem).2.2.1
  have hNA : q.N ≠ r.aBase := (hq.reg_ok q.N_mem).2.1
  have hNB : Nv < B := by omega
  have hNj : q.N ≠ q.j := hq.ne_of (by intro h; simp [RNames.list, h])
  have hNS : q.N ∉ regNames r := hq.2 _ q.N_mem
  have hlA : ∀ e, VarsIn l e → NoVar r.aBase e := fun e he =>
    noVar_of_varsIn (fun h => (hl _ h).1 (by simp [regNames, scalarNames])) e he
  have hlB : ∀ e, VarsIn l e → NoVar r.bBase e := fun e he =>
    noVar_of_varsIn (fun h => (hl _ h).1 (by simp [regNames, scalarNames])) e he
  have toL : ∀ τ : Env, (∀ x, x ∉ regNames r → x ≠ q.j → τ.vars x = σ.vars x) →
      ∀ x ∈ l, τ.vars x = σ.vars x := fun τ h x hx => h x (hl x hx).1 (hl x hx).2
  let I : Env → Prop := fun τ =>
    Slots F r q.WS Sn B τ ∧ τ.vars q.j ≤ Nv ∧
    (∀ x, x ∉ regNames r → x ≠ q.j → τ.vars x = σ.vars x) ∧
    (∀ k < Nv, val F r q.WS τ (dv + k) =
      if k < τ.vars q.j then -val F r q.WS σ (sv + (Nv - 1 - k)) else val F r q.WS σ (dv + k)) ∧
    (∀ s < Sn, (s < dv ∨ dv + Nv ≤ s) → val F r q.WS τ s = val F r q.WS σ s) ∧
