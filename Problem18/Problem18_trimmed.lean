noncomputable section
def opCoefficient {c : Nat} (X T : Expr) : PolyExpr (Fin c) Int → Nat → Nat
  | .var _, _ => 1
  | .const z,k => constCostE (plus T (.lit k)) (resExpr (.var canonical.p) z) 1
  | .add a b,k => opCoefficient X T a k+opCoefficient X T b (k+polyDepth a)+
      (16+(opExpr X T a k).size+(opExpr X T b (k+polyDepth a)).size+
        (plus T (.lit (k+polyDepth a+polyDepth b))).size)
  | .mul a b,k => opCoefficient X T a k+opCoefficient X T b (k+polyDepth a)+
      (16+(opExpr X T a k).size+(opExpr X T b (k+polyDepth a)).size+
        (plus T (.lit (k+polyDepth a+polyDepth b))).size)
def exprCoefficient {c : Nat} (X O T : Expr) (e : PolyExpr (Fin c) Int) : Nat :=
  opCoefficient X T e 0+16+2*(opExpr X T e 0).size+O.size
def vecCoefficient {c : Nat} (X T : Expr) : Expr→List (PolyExpr (Fin c) Int)→Nat
  | _,[]=>1
  | O,e::es=>exprCoefficient X O T e+vecCoefficient X T (plus O (.lit 1)) es
def clauseCoefficient {c n : Nat} (X T O : Expr) (L d : Nat) :
    List (PolyExpr (Fin c ⊕ Fin n) Int)→Nat→Nat
  | [],_=>1
  | p::ps,u=>vecCoefficient X T (plus O (.lit (u*L))) (rowExprs p d)+clauseCoefficient X T O L d ps (u+1)
variable {K : Type} [Field K] [Fintype K] (F : FieldPresentation K)
theorem constant_costE (S V : Expr) :
    constCostE S V F.e ≤ macroBudget F*constCostE S V 1 := by
  have he : F.e ≤ macroBudget F := (Nat.le_succ _).trans (degree_budget F)
  have h1: 1 ≤ macroBudget F := (concrete_costBound F).one
  have hm:=Nat.mul_le_mul_left (4+(S.size+12)) he
  have hc:=Nat.mul_le_mul_left (2+4+(S.size+5+V.size)) h1
  unfold constCostE
  nlinarith
theorem op_cost {c : Nat} (X T : Expr) (e : PolyExpr (Fin c) Int) (k : Nat) :
    opCost (fieldMacros F) X T e k ≤ macroBudget F*opCoefficient X T e k := by
  induction e generalizing k with
  | var i => simpa only [opCost,opCoefficient,Nat.mul_one] using (concrete_costBound F).one
  | const z => exact constant_costE F _ _
  | add a b ia ib =>
    have ha:=ia k
    have hb:=ib (k+polyDepth a)
    have hp:=(concrete_costBound F).point
    have h1:=(concrete_costBound F).one
    have hc:=Nat.mul_le_mul_left (15+(opExpr X T a k).size+(opExpr X T b (k+polyDepth a)).size+
      (plus T (.lit (k+polyDepth a+polyDepth b))).size) h1
    simp only [opCost,opCoefficient]
    nlinarith
  | mul a b ia ib =>
    have ha:=ia k
    have hb:=ib (k+polyDepth a)
    have hp:=(concrete_costBound F).mul
    have h1:=(concrete_costBound F).one
    have hc:=Nat.mul_le_mul_left (15+(opExpr X T a k).size+(opExpr X T b (k+polyDepth a)).size+
      (plus T (.lit (k+polyDepth a+polyDepth b))).size) h1
    simp only [opCost,opCoefficient]
    nlinarith
theorem expression_cost {c : Nat} (X O T : Expr) (e : PolyExpr (Fin c) Int) :
    polyExprCost (fieldMacros F) X O T e ≤ macroBudget F*exprCoefficient X O T e := by
  have ho:=op_cost F X T e 0
  have hp:=(concrete_costBound F).point
  have hc:=Nat.mul_le_mul_left (15+2*(opExpr X T e 0).size+O.size) (concrete_costBound F).one
  unfold polyExprCost exprCoefficient
  nlinarith
theorem vector_cost {c : Nat} (X T O : Expr) (es : List (PolyExpr (Fin c) Int)) :
    polyVecCost (fieldMacros F) X T O es ≤ macroBudget F*vecCoefficient X T O es := by
  induction es generalizing O with
  | nil => simpa only [polyVecCost,vecCoefficient,Nat.mul_one] using (concrete_costBound F).one
  | cons e es ih =>
    have he:=expression_cost F X O T e
    have ht:=ih (plus O (.lit 1))
    simp only [polyVecCost,vecCoefficient]
    nlinarith
theorem clause_cost {c n : Nat} (X T O : Expr) (L d : Nat)
    (ps : List (PolyExpr (Fin c ⊕ Fin n) Int)) (u : Nat) :
    clauseLoadCost (fieldMacros F) X T O L d ps u ≤ macroBudget F*clauseCoefficient X T O L d ps u := by
  induction ps generalizing u with
  | nil => simpa only [clauseLoadCost,clauseCoefficient,Nat.mul_one] using (concrete_costBound F).one
  | cons p ps ih =>
    have hv:=vector_cost F X T (plus O (.lit (u*L))) (rowExprs p d)
    have ht:=ih (u+1)
    simp only [clauseLoadCost,clauseCoefficient]
    nlinarith
end
end Mathproof.Problem18ConcreteClauseCost20261002
