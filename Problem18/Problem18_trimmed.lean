variable {K : Type*} [Field K] [Fintype K]
attribute [local instance] Classical.propDecidable
theorem degree_weight_le_reciprocal {n : ℕ} (f : MonicDegree (K:=K) n)
    (d : ℕ) (hd : 0<d) :
    (∑ g : IrreducibleDegree (K:=K) d,
      if g.val.val ∣ f.val then ((Nat.card K:ℝ)⁻¹)^d else 0)≤(d:ℝ)⁻¹ := by
  classical
  have hq : (0:ℝ)<Nat.card K := by exact_mod_cast Nat.card_pos (α:=K)
  have hdR : (0:ℝ)<d := by exact_mod_cast hd
  have hsum := Finset.sum_le_sum (s:=Finset.univ)
    (fun (g : IrreducibleDegree (K:=K) d) _ =>
      show (if g.val.val ∣ f.val then ((Nat.card K:ℝ)⁻¹)^d else 0)≤((Nat.card K:ℝ)⁻¹)^d by
        split_ifs
        · exact le_rfl
        · positivity)
  have hs : (∑ g : IrreducibleDegree (K:=K) d,
      if g.val.val ∣ f.val then ((Nat.card K:ℝ)⁻¹)^d else 0)≤
      (Nat.card (IrreducibleDegree (K:=K) d):ℝ)*((Nat.card K:ℝ)⁻¹)^d := by
    simpa only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,Nat.card_eq_fintype_card] using hsum
  have hc : (Nat.card (IrreducibleDegree (K:=K) d):ℝ)*d≤(Nat.card K:ℝ)^d := by
    exact_mod_cast irreducible_card_mul_degree_le (K:=K) d hd
  apply hs.trans
  rw [inv_pow,← div_eq_mul_inv,inv_eq_one_div]
  apply (div_le_div_iff₀ (pow_pos hq _) hdR).mpr
  simpa only [one_mul] using hc
theorem weight_le_harmonic {n : ℕ} (f : MonicDegree (K:=K) n) :
    weight f≤(harmonic n:ℝ) := by
  classical
  have hz : (∑ g : IrreducibleDegree (K:=K) 0,
      if g.val.val ∣ f.val then ((Nat.card K:ℝ)⁻¹)^0 else 0)=0 := by
    apply Finset.sum_eq_zero
    intro g _
    have hh := g.property.natDegree_pos
    rw [g.val.property.2] at hh
    omega
  unfold weight
  rw [Fin.sum_univ_succ]
  change (∑ g : IrreducibleDegree (K:=K) 0, if g.val.val ∣ f.val then ((Nat.card K:ℝ)⁻¹)^0 else 0) +
    (∑ d : Fin n, ∑ g : IrreducibleDegree (K:=K) (d.val+1),
      if g.val.val ∣ f.val then ((Nat.card K:ℝ)⁻¹)^(d.val+1) else 0) ≤ (harmonic n:ℝ)
  rw [hz,zero_add]
  have hb := Finset.sum_le_sum (s:=Finset.univ)
    (fun (d : Fin n) _ => degree_weight_le_reciprocal f (d.val+1) (by omega))
  have he : (∑ d : Fin n,((d.val+1:ℕ):ℝ)⁻¹)=(harmonic n:ℝ) := by
    rw [Fin.sum_univ_eq_sum_range (fun d : ℕ => ((d+1:ℕ):ℝ)⁻¹) n]
    simp only [harmonic,Rat.cast_sum,Rat.cast_inv,Rat.cast_natCast]
  simpa only [he] using hb
theorem weight_le_log {n : ℕ} (f : MonicDegree (K:=K) n) :
    weight f≤1+Real.log ((n:ℝ)+1) := by
  have hh : (harmonic n:ℝ)≤harmonic (n+1) := by
    rw [harmonic_succ,Rat.cast_add,Rat.cast_inv,Rat.cast_natCast]
    have hpos : (0:ℝ)≤((n+1:ℕ):ℝ)⁻¹ := by positivity
    linarith
  have hl := harmonic_le_one_add_log (n+1)
  push_cast at hl
  exact (weight_le_harmonic f).trans (hh.trans hl)
theorem squarefree_cyclic_fraction_polynomial {V : Type*} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] (S : Module.End K V) (hs : Squarefree S.charpoly) :
    Real.exp (-2)/((Module.finrank K V:ℝ)+1)^2≤
      (Nat.card {x : V // PolynomiallyCyclic S x}:ℝ)/(Nat.card V:ℝ) := by
  classical
  let g : FactorIndex S.charpoly → K[X] := fun p => p.val
  have hf : S.charpoly=∏ p : FactorIndex S.charpoly,g p := factor_product S.charpoly S.charpoly_monic hs
  letI : ∀ p : FactorIndex S.charpoly,Fact (Irreducible (g p)) := fun p => ⟨factor_irreducible S.charpoly p⟩
  have hcop : Pairwise (fun i j => IsCoprime (g i) (g j)) := by
    intro i j hij
    exact (Mathproof.Problem18PrimaryAssemblyBoundary20260930.factor_coprime_complement S g hf hs i).of_prod_right
      j (Finset.mem_erase.mpr ⟨hij.symm,Finset.mem_univ _⟩)
  obtain ⟨e,E,he,hE⟩ := Mathproof.Problem18PrimaryAssemblyBoundary20260930.exists_simultaneous_primary_coordinates
    S g (factor_monic S.charpoly) (factor_irreducible S.charpoly) hf hs
  rw [Mathproof.Problem18CyclicPrimaryDensity20260930.cyclic_vector_fraction S g hcop E hE]
  have hlog := weight_le_log (⟨S.charpoly,S.charpoly_monic,S.charpoly_natDegree⟩ :
    MonicDegree (K:=K) (Module.finrank K V))
  rw [weight_eq_primary_sum] at hlog
  have hb := Mathproof.Problem18EulerProductBounds20260930.finite_product_lower_of_sum
    Finset.univ (fun p : FactorIndex S.charpoly => ((Nat.card K:ℝ)^p.val.natDegree)⁻¹)
    (by intro p _; positivity) (by
      intro p _
      have hq : (2:ℝ)≤Nat.card K := by
        exact_mod_cast (show 2≤Nat.card K from Finite.one_lt_card)
      have hd : 1≤p.val.natDegree := (factor_irreducible S.charpoly p).natDegree_pos
      have hp : (2:ℝ)≤(Nat.card K:ℝ)^p.val.natDegree :=
        hq.trans (le_self_pow₀ (by linarith) (by omega))
      simpa only [one_div] using one_div_le_one_div_of_le (by norm_num : (0:ℝ)<2) hp)
    (1+Real.log ((Module.finrank K V:ℝ)+1)) hlog
  have hp : 0<(Module.finrank K V:ℝ)+1 := by positivity
  have he : Real.exp (-2*(1+Real.log ((Module.finrank K V:ℝ)+1)))=
      Real.exp (-2)/((Module.finrank K V:ℝ)+1)^2 := by
    rw [show -2*(1+Real.log ((Module.finrank K V:ℝ)+1))=
      -2-(Real.log ((Module.finrank K V:ℝ)+1)+Real.log ((Module.finrank K V:ℝ)+1)) by ring]
    rw [Real.exp_sub,Real.exp_add]
    simp only [Real.exp_log hp,pow_two]
  simpa only [he] using hb
end Mathproof.Problem18UniversalCyclicDensity20260930
end
