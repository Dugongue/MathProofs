variable {K : Type*} [Field K] [Fintype K]
noncomputable def splitTwo (n : ℕ) : ((K×K)×(Fin n→K)) ≃ₗ[K] (Fin (n+2)→K) where
  toFun z := Fin.cons z.1.1 (Fin.cons z.1.2 z.2)
  invFun v := ((v 0,v 1),Fin.tail (Fin.tail v))
  left_inv z := by ext <;> rfl
  right_inv v := by
    ext i
    cases i using Fin.cases
    · rfl
    · rename_i i
      cases i using Fin.cases <;> rfl
  map_add' z w := by
    ext i
    cases i using Fin.cases
    · rfl
    · rename_i i
      cases i using Fin.cases <;> rfl
  map_smul' c z := by
    ext i
    cases i using Fin.cases
    · rfl
    · rename_i i
      cases i using Fin.cases <;> rfl
theorem splitTwo_pairing {n : ℕ} (a b : K) (r : Fin n→K) (z w : (K×K)×(Fin n→K)) :
    diagonalForm (Fin.cons a (Fin.cons b r)) (splitTwo n z) (splitTwo n w)=
      a*z.1.1*w.1.1+b*z.1.2*w.1.2+diagonalForm r z.2 w.2 := by
  rw [diagonalForm_apply,Fin.sum_univ_succ,Fin.sum_univ_succ,diagonalForm_apply]
  change a*z.1.1*w.1.1+(b*z.1.2*w.1.2+∑ i,r i*z.2 i*w.2 i)=
    a*z.1.1*w.1.1+b*z.1.2*w.1.2+∑ i,r i*z.2 i*w.2 i
  ring
theorem diagonal_head_transport {n : ℕ} (a : K) (b c : Fin n→K)
    (e : (Fin n→K) ≃ₗ[K] (Fin n→K))
    (he : ∀ x y,diagonalForm b (e x) (e y)=diagonalForm c x y) :
    ∃ E : (Fin (n+1)→K) ≃ₗ[K] (Fin (n+1)→K),∀ x y,
      diagonalForm (Fin.cons a b) (E x) (E y)=diagonalForm (Fin.cons a c) x y := by
  let D := LinearEquiv.prodCongr (LinearEquiv.refl K K) e
  let E := (consEquiv (K:=K) n).symm.trans (D.trans (consEquiv n))
  refine ⟨E,?_⟩
  intro x y
  obtain ⟨x,rfl⟩ := (consEquiv (K:=K) n).surjective x
  obtain ⟨y,rfl⟩ := (consEquiv (K:=K) n).surjective y
  change diagonalForm (Fin.cons a b) (consEquiv n (D x)) (consEquiv n (D y))=
    diagonalForm (Fin.cons a c) (consEquiv n x) (consEquiv n y)
  rw [cons_pairing,cons_pairing]
  change scalarForm a x.1 y.1+diagonalForm b (e x.2) (e y.2)=
    scalarForm a x.1 y.1+diagonalForm c x.2 y.2
  rw [he]
theorem diagonal_binary_transport {n : ℕ} (a b c d : K) (r : Fin n→K)
    (e : (K×K) ≃ₗ[K] (K×K))
    (he : ∀ z w,a*(e z).1*(e w).1+b*(e z).2*(e w).2=c*z.1*w.1+d*z.2*w.2) :
    ∃ E : (Fin (n+2)→K) ≃ₗ[K] (Fin (n+2)→K),∀ x y,
      diagonalForm (Fin.cons a (Fin.cons b r)) (E x) (E y)=
        diagonalForm (Fin.cons c (Fin.cons d r)) x y := by
  let D := LinearEquiv.prodCongr e (LinearEquiv.refl K (Fin n→K))
  let E := (splitTwo (K:=K) n).symm.trans (D.trans (splitTwo n))
  refine ⟨E,?_⟩
  intro x y
  obtain ⟨x,rfl⟩ := (splitTwo (K:=K) n).surjective x
  obtain ⟨y,rfl⟩ := (splitTwo (K:=K) n).surjective y
  change diagonalForm (Fin.cons a (Fin.cons b r)) (splitTwo n (D x)) (splitTwo n (D y))=
    diagonalForm (Fin.cons c (Fin.cons d r)) (splitTwo n x) (splitTwo n y)
  rw [splitTwo_pairing,splitTwo_pairing]
  change a*(e x.1).1*(e y.1).1+b*(e x.1).2*(e y.1).2+diagonalForm r x.2 y.2=
    c*x.1.1*y.1.1+d*x.1.2*y.1.2+diagonalForm r x.2 y.2
  rw [he]
def normalCoeffs (n : ℕ) (c : K) : Fin (n+1)→K := Fin.cons c (fun _ => 1)
theorem exists_diagonal_normalization (hodd : ringChar K≠2) (n : ℕ)
    (a : Fin (n+1)→K) (ha : ∀ i,a i≠0) :
    ∃ E : (Fin (n+1)→K) ≃ₗ[K] (Fin (n+1)→K),∀ x y,
      diagonalForm a (E x) (E y)=diagonalForm (normalCoeffs n (∏ i,a i)) x y := by
  induction n with
  | zero =>
    have he : a=normalCoeffs 0 (∏ i,a i) := by
      ext i
      have hi : i=0 := Fin.ext (by omega)
      subst i
      simp [normalCoeffs,Fin.prod_univ_succ]
    exact ⟨LinearEquiv.refl K _,by intro x y; exact congrArg (fun b => diagonalForm b x y) he⟩
  | succ n ih =>
    obtain ⟨eT,hT⟩ := ih (Fin.tail a) (fun i => ha i.succ)
    let b := ∏ i,Fin.tail a i
    have hb : b≠0 := Finset.prod_ne_zero_iff.mpr (fun i _ => ha i.succ)
    obtain ⟨eH,hH⟩ := diagonal_head_transport (a 0) (Fin.tail a) (normalCoeffs n b) eT hT
    obtain ⟨eB,hB⟩ := exists_binary_normalization hodd (a 0) b (ha 0) hb
    let e := (LinearEquiv.prodComm K K K).trans eB
    have hpair (z w : K×K) :
        a 0*(e z).1*(e w).1+b*(e z).2*(e w).2=(a 0*b)*z.1*w.1+1*z.2*w.2 := by
      have hh := hB (z.2,z.1) (w.2,w.1)
      change a 0*((e z).1*(e w).1)+b*((e z).2*(e w).2)=1*(z.2*w.2)+(a 0*b)*(z.1*w.1) at hh
      simpa only [mul_assoc,add_comm] using hh
    obtain ⟨eP,hP⟩ := diagonal_binary_transport (a 0) b (a 0*b) 1 (fun _ : Fin n => 1) e hpair
    have hnorm : normalCoeffs (n+1) (∏ i,a i)=
        Fin.cons (a 0*b) (Fin.cons 1 (fun _ : Fin n => 1)) := by
      rw [Fin.prod_univ_succ]
      ext i
      cases i using Fin.cases
      · rfl
      · rename_i i
        cases i using Fin.cases <;> rfl
    refine ⟨eP.trans eH,?_⟩
    intro x y
    change diagonalForm a (eH (eP x)) (eH (eP y))=_
    have hh := hH (eP x) (eP y)
    rw [Fin.cons_self_tail] at hh
    rw [hh,hnorm]
    exact hP x y
end Mathproof.Problem18OddDiagonalNormalization20260930
