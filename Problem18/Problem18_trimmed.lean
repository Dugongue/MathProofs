variable {k Ω : Type*} [Field k] [Field Ω] [Algebra k Ω]
theorem exists_pow_char_of_pderiv_eq_zero {σ : Type*} (p : ℕ) [hp : Fact p.Prime] [CharP k p]
    [PerfectField k] (H : MvPolynomial σ k) (hH : ∀ i, MvPolynomial.pderiv i H = 0) :
    ∃ H₀ : MvPolynomial σ k, H = H₀ ^ p := by
  classical
  have hp0 : p ≠ 0 := hp.out.ne_zero
  have hdiv : ∀ m ∈ H.support, ∀ i, p ∣ m i := by
    intro m hm i
    by_cases hmi : m i = 0
    · rw [hmi]
      exact dvd_zero p
    · have hle : Finsupp.single i 1 ≤ m := by
        rw [Finsupp.single_le_iff]
        omega
      have hc := MvPolynomial.coeff_pderiv (i := i) H (m - Finsupp.single i 1)
      rw [hH i, MvPolynomial.coeff_zero, tsub_add_cancel_of_le hle] at hc
      have hmi' : (m - Finsupp.single i 1 : σ →₀ ℕ) i + 1 = m i := by
        rw [Finsupp.tsub_apply, Finsupp.single_eq_same]
        omega
      have hcast : (((m - Finsupp.single i 1 : σ →₀ ℕ) i : ℕ) : k) + 1 = ((m i : ℕ) : k) := by
        rw [← hmi', Nat.cast_add, Nat.cast_one]
      rw [hcast] at hc
      have hcm : MvPolynomial.coeff m H ≠ 0 := MvPolynomial.mem_support_iff.mp hm
      have hz : (m i : k) = 0 := by
        rcases mul_eq_zero.mp hc.symm with h | h
        · exact absurd h hcm
        · exact h
      exact (CharP.cast_eq_zero_iff k p (m i)).mp hz
  let H₁ : MvPolynomial σ k := ∑ m ∈ H.support,
    MvPolynomial.monomial (Finsupp.mapRange (fun n => n / p) (Nat.zero_div p) m)
      (MvPolynomial.coeff m H)
  have hexp : MvPolynomial.expand p H₁ = H := by
    rw [map_sum]
    conv_rhs => rw [← MvPolynomial.support_sum_monomial_coeff H]
    refine Finset.sum_congr rfl (fun m hm => ?_)
    have hm' : p • Finsupp.mapRange (fun n => n / p) (Nat.zero_div p) m = m := by
      ext i
      simp only [Finsupp.smul_apply, Finsupp.mapRange_apply, smul_eq_mul]
      exact Nat.mul_div_cancel' (hdiv m hm i)
    rw [MvPolynomial.expand_monomial, hm']
  refine ⟨MvPolynomial.map ((frobeniusEquiv k p).symm : k →+* k) H₁, ?_⟩
  rw [← MvPolynomial.map_frobenius_expand p, MvPolynomial.map_expand, MvPolynomial.map_map]
  have hid : (frobenius k p).comp ((frobeniusEquiv k p).symm : k →+* k) = RingHom.id k := by
    ext a
    simp
  rw [hid, MvPolynomial.map_id, hexp]
end F3
