  calc xs.sum ≤ xs.length * (10^41 * (n+1)^40) := hsum
    _ ≤ 100 * (10^41 * (n+1)^100) := by
        apply Nat.mul_le_mul hlen
        exact Nat.mul_le_mul_left _ hpow
    _ ≤ 10^100 * (n+1)^100 := by
        rw [← Nat.mul_assoc]
        exact Nat.mul_le_mul_right _ (by norm_num)
