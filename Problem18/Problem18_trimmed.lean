variable {K : Type} [Field K] [BEq K] [LawfulBEq K] [DecidableEq K] {b c : ℕ}
def matrixCharacteristic (S : Matrix (Fin b) (Fin b) K) : CPolynomial K :=
  characteristic b (arrayOf S)
theorem matrixCharacteristic_correct (S : Matrix (Fin b) (Fin b) K) :
    (matrixCharacteristic S).toPoly=S.charpoly := by
  rw [matrixCharacteristic,characteristic_correct _ (arrayOf_size S)]
  exact congrArg Matrix.charpoly (Matrix.ofArray_ofFn S)
def regularCheck (S : Matrix (Fin b) (Fin b) K) : Bool :=
  regularSquarefreeCheck (matrixCharacteristic S)
theorem regularCheck_correct [PerfectField K] (S : Matrix (Fin b) (Fin b) K) :
    regularCheck S=true ↔ S.det≠0 ∧ Squarefree S.charpoly := by
  rw [regularCheck,regularSquarefreeCheck_correct,matrixCharacteristic_correct]
  constructor
  · rintro ⟨hs,hc⟩
    refine ⟨?_,hs⟩
    rw [Matrix.det_eq_sign_charpoly_coeff]
    exact mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)) hc
  · rintro ⟨hd,hs⟩
    refine ⟨hs,?_⟩
    intro hc
    apply hd
    rw [Matrix.det_eq_sign_charpoly_coeff,hc,mul_zero]
def orthogonalSourceCheck (A : Matrix (Fin c) (Fin b) K) : Bool :=
  regularCheck (A.transpose*A)
theorem orthogonalSourceCheck_correct [PerfectField K] (A : Matrix (Fin c) (Fin b) K) :
    orthogonalSourceCheck A=true ↔ OrthogonalGood A := regularCheck_correct _
section Unitary
variable [StarRing K]
def unitarySourceCheck (A : Matrix (Fin c) (Fin b) K) : Bool :=
  regularCheck (A.conjTranspose*A)
theorem unitarySourceCheck_correct [PerfectField K] (A : Matrix (Fin c) (Fin b) K) :
    unitarySourceCheck A=true ↔ UnitaryGood A := regularCheck_correct _
def unitaryQueryCheck (A B : Matrix (Fin c) (Fin b) K) : Bool :=
  unitarySourceCheck B &&
    (matrixCharacteristic (A.conjTranspose*A)==matrixCharacteristic (B.conjTranspose*B))
theorem unitaryQueryCheck_correct {F : Type} [Field F] [Fintype F] [Fintype K]
    [Algebra F K] (hcard : Nat.card K=Nat.card F^2)
    (hstar : ∀ x : K,star x=x^Nat.card F)
    (A B : Matrix (Fin c) (Fin b) K) (hA : unitarySourceCheck A=true) :
    unitaryQueryCheck A B=true ↔ MatrixUnitaryEquivalent A B := by
  rw [unitaryQueryCheck,Bool.and_eq_true,unitarySourceCheck_correct,beq_iff_eq]
  have hp : matrixCharacteristic (A.conjTranspose*A)=matrixCharacteristic (B.conjTranspose*B) ↔
      (A.conjTranspose*A).charpoly=(B.conjTranspose*B).charpoly := by
    rw [← matrixCharacteristic_correct,← matrixCharacteristic_correct]
    exact CPolynomial.ringEquiv.injective.eq_iff.symm
  rw [hp]
  exact (unitary_boundary_iff_checks hcard hstar A B
    ((unitarySourceCheck_correct A).mp hA)).symm
end Unitary
end Mathproof.Problem18BoundaryBooleanChecks20260930
