theorem geometric_coordinate_transcendental
    (P : Ideal (MvPolynomial (Fin n) L)) [P.IsPrime] (i : Fin n)
    (ht : Transcendental K (coordinate (K := K) P i)) :
    Transcendental L (Ideal.Quotient.mk P (X i)) := by
  let φ : CoordinateRing (K := K) P →ₐ[K] (MvPolynomial (Fin n) L ⧸ P) :=
    Ideal.quotientMapₐ P (MvPolynomial.mapAlgHom (Algebra.ofId K L)) le_rfl
  have hφ : Function.Injective φ := Ideal.quotientMap_injective
  have ht0 : Transcendental K (Ideal.Quotient.mk (descendedIdeal (K := K) P) (X i)) := by
    intro ha
    apply ht
    exact ha.algHom (IsScalarTower.toAlgHom K (CoordinateRing (K := K) P)
      (CoordinateField (K := K) P))
  have ht1 : Transcendental K (Ideal.Quotient.mk P (X i)) := by
    have h := (isAlgebraic_algHom_iff φ hφ).not.mpr ht0
    simpa [Transcendental, φ, MvPolynomial.mapAlgHom_apply] using h
  exact ht1.extendScalars L
theorem distinct_coordinate_relation
    (G : Finset (MvPolynomial (Fin n) L)) (d : Nat)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hdim : DimLE G 1 1)
    (P : Ideal (MvPolynomial (Fin n) L)) [P.IsPrime]
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes)
    (hfix : P.comap (MvPolynomial.map
      (FiniteField.frobeniusAlgEquivOfAlgebraic K L).toRingEquiv.toRingHom) = P)
    (i j : Fin n) (hji : j ≠ i)
    (ht : Transcendental K (coordinate (K := K) P i)) :
    ∃ s : MvPolynomial (Fin 2) K, s ≠ 0 ∧ s.totalDegree ≤ planeBound n d ∧
      aeval ![coordinate (K := K) P j, coordinate (K := K) P i] s = 0 := by
  classical
  let ν : Fin 2 ↪ Fin n := ⟨![j,i], by
    intro a b hab
    fin_cases a <;> fin_cases b <;> simp_all⟩
  have htrans : Transcendental L (Ideal.Quotient.mk P (X (ν 1))) := by
    simpa [ν] using geometric_coordinate_transcendental P i ht
  obtain ⟨s, hs, hdeg, hmem⟩ := fixed_plane_projection_relation
    (K := K) G d hG hdim P hP hfix ν htrans
  refine ⟨s, hs, hdeg, ?_⟩
  have hmem' : MvPolynomial.map (algebraMap K L) (rename ν s) ∈ P := by
    simpa only [map_rename] using hmem
  have hz := coordinate_relation P (rename ν s) hmem'
  rw [aeval_rename] at hz
  have hv : (coordinate (K := K) P) ∘ ν =
      ![coordinate (K := K) P j, coordinate (K := K) P i] := by
    funext k
    fin_cases k <;> rfl
  rwa [hv] at hz
end Mathproof.Problem18ActualCoordinateRelation20261001
