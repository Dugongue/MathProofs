      calc
        B d a + star (B d a) + B d d =
            B d a + B a d + B d d := by rw [hsym]
        _ = B (a + d) (a + d) - B a a := by
          simp only [map_add, LinearMap.add_apply]
          ring
        _ = B b b - B a a := by rw [show a + d = b by simp [d]]
