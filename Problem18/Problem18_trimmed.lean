  | .inl label => mapLabelStmt embedWidth (inputWidthProgram q label)
  | .inr (.inl .raw) =>
      .pop (.core .work0) (fun s a => {s with heldSparse := a}) <|
      .branch (fun s => s.heldSparse.isNone)
        (.goto fun _ => .inr (.inl .separator)) <|
      .push .output (fun s => physicalOfSparse (s.heldSparse.getD default)) <|
      .load clearHeld <| .goto fun _ => .inr (.inl .raw)
  | .inr (.inl .separator) =>
      .push .output (fun _ => .separator) <|
      .goto fun _ => .inr (.inl .drop)
  | .inr (.inl .drop) =>
      .pop (.core .work3) (fun s _ => s) <|
      .goto fun _ => .inr (.inl .clock)
