    have h := majorant_le memLenSize (n:=n) (e:=e) (X:=N+1) hX1 (by omega) (by omega)
    exact h.trans (Nat.mul_le_mul
      (show majorant memLenSize 0 0 ≤ 10^30 by decide +kernel)
      (Nat.pow_le_pow_right hX1 (show sdeg memLenSize ≤ 30 by decide +kernel)))
  have hml : 2*memLen n e ≤ 10^30*(N+1)^30 := by
    unfold memLen; polyfit
