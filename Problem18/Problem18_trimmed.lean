theorem compatible_involution_degree_odd {K E : Type*}
    [Field K] [Fintype K] [Field E] [Fintype E] [Algebra K E]
    (σ : K ≃+* K) (φ : E ≃+* E) (hσ : σ ≠ 1)
    (hφ : Function.Involutive φ) (hφne : φ ≠ 1)
    (hc : ∀ a : K,φ (algebraMap K E a)=algebraMap K E (σ a))
    (q d : ℕ) (hK : Nat.card K=q^2) (hE : Nat.card E=q^(2*d)) : Odd d := by
  by_contra hodd
  obtain ⟨m,hm⟩ := Nat.not_odd_iff_even.mp hodd
  have hp : q^d=Nat.card K^m := by
    rw [hK,← pow_mul]
    congr 1
    omega
  apply hσ
  apply RingEquiv.ext
  intro a
  apply (algebraMap K E).injective
  change algebraMap K E (σ a)=algebraMap K E a
  rw [← hc,involution_eq_frobenius φ hφ hφne,
    fixedField_card_of_even_power φ hφ hφne q d hE,hp,← map_pow]
  apply congrArg (algebraMap K E)
  simpa only [Nat.card_eq_fintype_card] using FiniteField.pow_card_pow m a
theorem self_conjugate_irreducible_degree_odd {K : Type*} [Field K] [Fintype K]
    (σ : K ≃+* K) (hσ : Function.Involutive σ) (hne : σ ≠ 1)
    (q : ℕ) (hK : Nat.card K=q^2) (p : K[X]) [Fact (Irreducible p)]
    (hp : Associated (p.map σ.toRingHom) p) : Odd p.natDegree := by
  let E := AdjoinRoot p
  letI : FiniteDimensional K E := (AdjoinRoot.powerBasis (Fact.out : Irreducible p).ne_zero).finite
  letI : Finite E := Finite.of_injective (Module.finBasis K E).equivFun
    (Module.finBasis K E).equivFun.injective
  letI : Fintype E := Fintype.ofFinite E
  let φ := AdjoinRoot.mapRingEquiv σ p p hp
  have hi : Function.Involutive φ := adjoinRoot_conjugation_involutive σ hσ p hp
  have hn : φ ≠ 1 := adjoinRoot_conjugation_ne_one σ hne p hp
  have hc (a : K) : φ (algebraMap K E a)=algebraMap K E (σ a) :=
    AdjoinRoot.map_of σ.toRingHom p p hp.symm.dvd a
  have hdeg : Module.finrank K E=p.natDegree := finrank_quotient_span_eq_natDegree
  have hcard : Nat.card E=q^(2*p.natDegree) := by
    calc
      Nat.card E=Nat.card K^p.natDegree := by
        simp only [Nat.card_eq_fintype_card]
        rw [Module.card_eq_pow_finrank (K := K) (V := E),hdeg]
      _ = _ := by rw [hK,← pow_mul]
  exact compatible_involution_degree_odd σ φ hne hi hn hc q p.natDegree hK hcard
end
