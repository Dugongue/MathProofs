    exact_mod_cast Nat.ne_of_gt (Multiset.count_pos.mpr hα)
  apply power_sum_radius s.toFinset c (C*R^N) R hR ?_ α
    (Multiset.mem_toFinset.mpr hα) (mul_ne_zero hc (pow_ne_zero _ ha))
  intro n
  have he : (∑ z∈s.toFinset,c z*z^n)=(s.map (fun z => z^(N+n))).sum := by
    rw [Finset.sum_multiset_map_count]
    apply Finset.sum_congr rfl
    intro z _
    simp only [c,nsmul_eq_mul,pow_add,mul_assoc]
  rw [he]
  calc
    ‖(s.map (fun z => z^(N+n))).sum‖ ≤ C*R^(N+n) := hb _ (Nat.le_add_right _ _)
    _ = (C*R^N)*R^n := by rw [pow_add,mul_assoc]
theorem multiset_power_sum_bound (s : Multiset ℂ) (R : ℝ) (hR : 0≤R)
