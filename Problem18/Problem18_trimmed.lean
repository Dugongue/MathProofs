theorem polynomial_operator_card_identity
    (hcard : Nat.card K=Nat.card (fixedField (starRingAut : K ≃+* K))^2)
    (hstar : ∀ a : K,star a=a^Nat.card (fixedField (starRingAut : K ≃+* K)))
    (f : (fixedField (starRingAut : K ≃+* K))[X]) (hm : f.Monic) (hs : Squarefree f)
    (B : V →ₗ⋆[K] V →ₗ[K] K) (hB : B.IsSymm) (hnB : B.SeparatingLeft)
    (hd : Module.finrank K V=f.natDegree) :
    Nat.card {S : Module.End K V // S.charpoly=f.map (algebraMap (fixedField (starRingAut : K ≃+* K)) K) ∧
      ∀ x y,B (S x) y=B x (S y)} *
      Nat.card (AdjoinRoot (f.map (algebraMap (fixedField (starRingAut : K ≃+* K)) K)))ˣ =
    Nat.card (AdjoinRoot f)ˣ * Nat.card (isometrySubgroup (fun x y => B x y)) := by
  let σ : K ≃+* K := starRingAut
  let F := fixedField σ
  letI : Fintype F := Fintype.ofFinite _
  let i := algebraMap F K
  let p := f.map i
  have hpm : p.Monic := hm.map i
  have hps : Squarefree p := ((PerfectField.separable_iff_squarefree.mpr hs).map).squarefree
  have hpfix : p.map σ.toRingHom=p := mapped_fixedField_fixed σ f
  have hass : Associated (p.map σ.toRingHom) p := Associated.of_eq hpfix
  let φ := AdjoinRoot.mapRingEquiv σ p p hass
  have hφ : Function.Involutive φ := adjoinRoot_conjugation_involutive σ star_involutive p hass
  have hc (a : K) : φ (algebraMap K (AdjoinRoot p) a)=algebraMap K (AdjoinRoot p) (star a) :=
    AdjoinRoot.map_of σ.toRingHom p p hass.symm.dvd a
  have hr : φ (AdjoinRoot.root p)=AdjoinRoot.root p :=
    AdjoinRoot.map_root σ.toRingHom p p hass.symm.dvd
  let pb := AdjoinRoot.powerBasis hpm.ne_zero
  letI : FiniteDimensional K (AdjoinRoot p) := pb.finite
  have hdim : Module.finrank K (AdjoinRoot p)=Module.finrank K V := by
    calc
      Module.finrank K (AdjoinRoot p)=p.natDegree := finrank_quotient_span_eq_natDegree
      _ = f.natDegree := hm.natDegree_map i
      _ = Module.finrank K V := hd.symm
  have hchar : (LinearMap.mulLeft K (AdjoinRoot.root p)).charpoly=p := by
    rw [←LinearMap.charpoly_toMatrix _ pb.basis]
    change (Algebra.leftMulMatrix pb.basis pb.gen).charpoly=p
    rw [charpoly_leftMulMatrix,AdjoinRoot.minpoly_powerBasis_gen_of_monic hpm]
  have h := operator_card_identity (F:=F) φ hc hcard hstar hφ
    (squarefree_quotient_trace_nondegenerate p hpm hps) (AdjoinRoot.root p) hr
    (AdjoinRoot.adjoinRoot_eq_top (f:=p)) (hchar.symm ▸ hps) B hB hnB hdim
  have hu : Nat.card (FixedUnits φ)=Nat.card (AdjoinRoot f)ˣ := fixed_units_card σ f φ hc hr hm
  rw [hu] at h
  simpa only [Operators,hchar] using h
theorem polynomial_operator_card
    (hcard : Nat.card K=Nat.card (fixedField (starRingAut : K ≃+* K))^2)
    (hstar : ∀ a : K,star a=a^Nat.card (fixedField (starRingAut : K ≃+* K)))
    (hne : (starRingAut : K ≃+* K)≠1)
    (f : (fixedField (starRingAut : K ≃+* K))[X]) (hm : f.Monic) (hs : Squarefree f)
    (B : V →ₗ⋆[K] V →ₗ[K] K) (hB : B.IsSymm) (hnB : B.SeparatingLeft)
    (hd : Module.finrank K V=f.natDegree) :
    Nat.card {S : Module.End K V // S.charpoly=f.map (algebraMap (fixedField (starRingAut : K ≃+* K)) K) ∧
      ∀ x y,B (S x) y=B x (S y)} *
      ∏ j : Mathproof.Problem18BoundaryNormalizedFactors20260930.FactorIndex f,
        (if Odd j.val.natDegree then Nat.card (fixedField (starRingAut : K ≃+* K))^j.val.natDegree+1
         else Nat.card (fixedField (starRingAut : K ≃+* K))^j.val.natDegree-1) =
    Nat.card (isometrySubgroup (fun x y => B x y)) := by
  classical
  let F := fixedField (starRingAut : K ≃+* K)
  letI : Fintype F := Fintype.ofFinite _
  letI : FiniteDimensional F (AdjoinRoot f) := (AdjoinRoot.powerBasis hm.ne_zero).finite
  letI : Finite (AdjoinRoot f) := Finite.of_injective (Module.finBasis F (AdjoinRoot f)).equivFun
    (Module.finBasis F (AdjoinRoot f)).equivFun.injective
  have h := polynomial_operator_card_identity hcard hstar f hm hs B hB hnB hd
  rw [Mathproof.Problem18UnitaryQuotientWeights20261001.squarefree_base_unit_weights
    (starRingAut : K ≃+* K) star_involutive hne f hm hs] at h
  apply Nat.eq_of_mul_eq_mul_left (Nat.card_pos (α := (AdjoinRoot f)ˣ))
  calc
    _ = _ := by rw [←h]; ring
end
end Mathproof.Problem18UnitaryPolynomialCountIdentity20261001
