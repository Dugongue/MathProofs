    List (PolyExpr (OuterVar a b) K) :=
  if ranksMatch F G then
    ((List.finRange a).flatMap fun i => (List.finRange a).map fun j =>
      preservesPEntry (b:=b) (1 : Matrix (Fin a) (Fin a) K) i j) ++
    ((List.finRange b).flatMap fun i => (List.finRange b).map fun j =>
      preservesREntry (a:=a) (1 : Matrix (Fin b) (Fin b) K) i j) ++
    ((List.finRange (a*b+1)).flatMap fun i => (List.finRange (a*b+1)).map fun j =>
