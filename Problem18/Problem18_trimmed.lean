namespace Mathproof.Problem18CyclicPrimaryVectors20260930
open Polynomial
open scoped BigOperators
variable {K V ι : Type*} [Field K] [Fintype K] [Fintype ι]
  [AddCommGroup V] [Module K V]
def PolynomiallyCyclic (S : Module.End K V) (x : V) : Prop :=
  Function.Surjective (fun p : K[X] => (aeval S p) x)
theorem primary_polynomial_action (S : Module.End K V) (g : ι → K[X])
    (E : (∀ i,AdjoinRoot (g i)) ≃ₗ[K] V)
    (hE : ∀ x,E (fun i => AdjoinRoot.root (g i)*x i)=S (E x))
    (p : K[X]) (x : ∀ i,AdjoinRoot (g i)) :
    E (fun i => aeval (AdjoinRoot.root (g i)) p*x i)=(aeval S p) (E x) := by
  have hp (n : ℕ) : E (fun i => AdjoinRoot.root (g i)^n*x i)=(S^n) (E x) := by
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ',Module.End.mul_apply,← ih,← hE]
      congr 1
      funext i
      rw [pow_succ',mul_assoc]
  induction p using Polynomial.induction_on' with
  | add p q ihp ihq =>
    simp only [map_add,add_mul,LinearMap.add_apply]
    change E ((fun i => aeval (AdjoinRoot.root (g i)) p*x i)+(fun i => aeval (AdjoinRoot.root (g i)) q*x i))=_
    rw [E.map_add,ihp,ihq]
  | monomial n a =>
    simp only [aeval_monomial,← Algebra.smul_def,LinearMap.smul_apply]
    rw [← hp]
    rw [← E.map_smul]
    congr 1
    funext i
    exact smul_mul_assoc a (AdjoinRoot.root (g i)^n) (x i)
theorem polynomiallyCyclic_iff_primary_nonzero (S : Module.End K V) (g : ι → K[X])
    [∀ i,Fact (Irreducible (g i))]
    (hcop : Pairwise (fun i j => IsCoprime (g i) (g j)))
    (E : (∀ i,AdjoinRoot (g i)) ≃ₗ[K] V)
    (hE : ∀ x,E (fun i => AdjoinRoot.root (g i)*x i)=S (E x))
    (x : ∀ i,AdjoinRoot (g i)) :
    PolynomiallyCyclic S (E x) ↔ ∀ i,x i≠0 := by
  classical
  constructor
  · intro hx i hxi
    obtain ⟨p,hp⟩ := hx (E (Pi.single i 1))
    change (aeval S p) (E x)=E (Pi.single i 1) at hp
    rw [← primary_polynomial_action S g E hE] at hp
    have hi := congrFun (E.injective hp) i
    simpa [hxi] using hi
  · intro hx y
    let z := E.symm y
    have hc : Pairwise (fun i j => IsCoprime
        (Ideal.span ({g i} : Set K[X])) (Ideal.span ({g j} : Set K[X]))) := by
      intro i j hij
      exact (Ideal.isCoprime_span_singleton_iff _ _).mpr (hcop hij)
    obtain ⟨p,hp⟩ := Ideal.pi_quotient_surjective hc (fun i => z i/x i)
    refine ⟨p,?_⟩
    change (aeval S p) (E x)=y
    rw [← primary_polynomial_action S g E hE]
    have he : (fun i => aeval (AdjoinRoot.root (g i)) p*x i)=z := by
      funext i
      rw [AdjoinRoot.aeval_eq]
      change (AdjoinRoot.mk (g i) p)*x i=z i
      have hpi : AdjoinRoot.mk (g i) p=z i/x i := hp i
      rw [hpi,div_mul_cancel₀ _ (hx i)]
    rw [he,E.apply_symm_apply]
theorem cyclic_vector_card (S : Module.End K V) (g : ι → K[X])
    [∀ i,Fact (Irreducible (g i))]
    (hcop : Pairwise (fun i j => IsCoprime (g i) (g j)))
    (E : (∀ i,AdjoinRoot (g i)) ≃ₗ[K] V)
    (hE : ∀ x,E (fun i => AdjoinRoot.root (g i)*x i)=S (E x)) :
    Nat.card {x : V // PolynomiallyCyclic S x}=∏ i,(Nat.card K^(g i).natDegree-1) := by
  classical
  let e : {x : ∀ i,AdjoinRoot (g i) // ∀ i,x i≠0} ≃
      {x : V // PolynomiallyCyclic S x} :=
    E.toEquiv.subtypeEquiv (fun x => (polynomiallyCyclic_iff_primary_nonzero S g hcop E hE x).symm)
  rw [← Nat.card_congr e,Nat.card_congr (Equiv.subtypePiEquivPi (p := fun i (z : AdjoinRoot (g i)) => z≠0)),Nat.card_pi]
  apply Finset.prod_congr rfl
  intro i _
  let b := (AdjoinRoot.powerBasis (Fact.out : Irreducible (g i)).ne_zero).basis
  letI : Finite (AdjoinRoot (g i)) := Finite.of_injective b.equivFun b.equivFun.injective
  letI : Fintype (AdjoinRoot (g i)) := Fintype.ofFinite _
  have he : Nat.card {x : AdjoinRoot (g i) // x≠0}=Nat.card (AdjoinRoot (g i))-1 := by
    simp only [Nat.card_eq_fintype_card,Fintype.card_subtype_compl,Fintype.card_subtype_eq]
  rw [he,Mathproof.Problem18DistinctDegreeSquare20260930.adjoinRoot_card]
end Mathproof.Problem18CyclicPrimaryVectors20260930
end
