variable {K : Type*} [Field K] [Fintype K] {n s : ℕ}
variable (τ : K ≃+* K) (eps : K)
set_option backward.isDefEq.respectTransparency false
def diagonalSpace : AddSubgroup K where
  carrier := {z | z=eps*τ z}
  zero_mem' := by simp
  add_mem' := by intro x y hx hy; change x+y=eps*τ (x+y); rw [map_add,mul_add,← hx,← hy]
  neg_mem' := by intro x hx; change -x=eps*τ (-x); rw [map_neg,mul_neg,← hx]
noncomputable def fullMatrix (u : Upper s → K) (d : Fin s → diagonalSpace τ eps) :
    Matrix (Fin s) (Fin s) K := upperMatrix τ eps u + Matrix.diagonal (fun i => (d i).val)
noncomputable def fullForm (u : Upper s → K) (d : Fin s → diagonalSpace τ eps) :
    Form (V := Fin s → K) τ :=
  Matrix.toLinearMapₛₗ₂' K (τ : K →+* K) (RingHom.id K) (fullMatrix τ eps u d)
theorem fullMatrix_symm (hτ : Function.Involutive τ) (heps : eps*τ eps=1)
    (u : Upper s → K) (d : Fin s → diagonalSpace τ eps) (i j : Fin s) :
    fullMatrix τ eps u d j i=eps*τ (fullMatrix τ eps u d i j) := by
  unfold fullMatrix
  simp only [Matrix.add_apply,map_add,mul_add]
  rw [upperMatrix_symm τ eps hτ heps u i j]
  congr 1
  by_cases h : i=j
  · subst j
    simp only [Matrix.diagonal_apply_eq]
    exact (d i).property
  · simp [Matrix.diagonal_apply_ne _ h,Matrix.diagonal_apply_ne _ (Ne.symm h)]
theorem fullForm_symm (hτ : Function.Involutive τ) (heps : eps*τ eps=1)
    (u : Upper s → K) (d : Fin s → diagonalSpace τ eps) (x y : Fin s → K) :
    fullForm τ eps u d y x=eps*τ (fullForm τ eps u d x y) := by
  simp only [fullForm,Matrix.toLinearMapₛₗ₂'_apply,RingHom.id_apply,smul_eq_mul]
  rw [Finset.sum_comm]
  simp only [map_sum,map_mul,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  rw [fullMatrix_symm τ eps hτ heps]
  change τ (y j)*(x i*(eps*τ (fullMatrix τ eps u d i j)))=
    eps*(τ (τ (x i))*(τ (y j)*τ (fullMatrix τ eps u d i j)))
  rw [hτ]
  ring
noncomputable def mixedCoordinates (B : Form (V := Fin n → K) τ)
    (hsym : ∀ x y,B y x=eps*τ (B x y))
    (E : (Fin s → K) →ₗ[K] (Fin n → K)) (Z : Finset (Upper s)) (D : Finset (Fin s)) :
    selfAdjointSpace τ B →+ ((Z → K) × (D → diagonalSpace τ eps)) where
  toFun T := (coordinates τ B E Z T,fun i =>
    ⟨B (T.val (E (Pi.single i.val 1))) (E (Pi.single i.val 1)),
      (T.property _ _).trans (hsym _ _)⟩)
