variable [Fintype K] {V : Type*} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
theorem finite_test_index_iff (P : ℕ→Prop) (m : ℕ) :
    (∀ i : Fin m,P (i.val+1)) ↔ ∀ d,1≤d→d≤ m→P d := by
  constructor
  · intro h d hd hm
    have hh := h ⟨d-1,by omega⟩
    have he : d-1+1=d := by omega
    exact he ▸ hh
  · intro h i
    exact h (i.val+1) (by omega) (by omega)
theorem finite_computed_tests_iff (S D : Module.End K V) (f : CPolynomial K)
    (hf : f.toPoly=S.charpoly) :
    (∀ i : Fin S.charpoly.natDegree,
      LinearMap.ker (aeval S (frobeniusGcd f (Nat.card K) (i.val+1)).toPoly) ≤
        LinearMap.ker (D^((Nat.card K^(i.val+1))/2)-1)) ↔
      Mathproof.Problem18OddCyclicFormDecision20260930.KernelSquareTests S D := by
  let G : ℕ→K[X] := fun d => (frobeniusGcd f (Nat.card K) d).toPoly
  have hspec (d : ℕ) (p : K[X]) : p ∣ G d ↔ p ∣ S.charpoly ∧ p ∣ X^(Nat.card K^d)-X := by
    simpa only [G,hf] using frobeniusGcd_dvd_iff f (Nat.card K) d p
  have hi := finite_test_index_iff (fun d =>
    LinearMap.ker (aeval S (G d)) ≤ LinearMap.ker (D^(Nat.card K^d/2)-1))
    S.charpoly.natDegree
  apply hi.trans
  classical
  letI : DecidableEq K := Classical.decEq K
  unfold Mathproof.Problem18OddCyclicFormDecision20260930.KernelSquareTests
  have hk (d : ℕ) : LinearMap.ker (aeval S (G d))=
