    have hR0 : rowStart (2 * N + N) 0 ≤ rowStart (2 * N + N) jv := rs_mono (by omega)
    have hRjv : rowStart (2 * N + N) jv = 5 + (2 * N + N) + jv * (2 * N + N) := rfl
    set R := rowStart (2 * N + N) jv with hRdef
    have eRa : (raE w).evalB B τ = some R := by
      have h1 : (plus (.lit 5) (.var w.n3)).evalB B τ = some (5 + (2 * N + N)) :=
        evalB_plus (evalB_lit (by omega)) (evalB_var_eqB hn3τ (by omega)) (by omega)
      have h2 : (Expr.bin .mul (.var w.j) (.var w.n3)).evalB B τ = some (jv * (2 * N + N)) :=
        evalB_mul (evalB_var (by omega)) (evalB_var_eqB hn3τ (by omega)) (by omega)
      have h3 := evalB_plus h1 h2 (by omega)
      rw [show 5 + (2 * N + N) + jv * (2 * N + N) = R by omega] at h3
      exact h3
    set τ1 := τ.setVar w.ra R with hτ1
    have v1 : ∀ y, y ≠ w.ra → τ1.vars y = τ.vars y := fun y hy => by simp [hτ1, hy]
    have hS1 : Slots F r q.WS Sn B τ1 := Slots.setVar F r hSτ hraS hraW R
    have val1 : ∀ s, val F r q.WS τ1 s = val F r q.WS τ s := fun s => by
      rw [hτ1, val_setVar F r hraW]
    have eD : (rowDst w).evalB B τ1 = some (R + jv) := by
      have er : τ1.vars w.ra = R := by simp [hτ1]
      have ej : τ1.vars w.j = jv := v1 _ hjra
      exact evalB_plus (evalB_var_eqB er (by omega)) (evalB_var_eqB ej (by omega)) (by omega)
    have eS : (Expr.var w.qS).evalB B τ1 = some qs :=
      evalB_var_eqB (by rw [v1 _ (keepReg w.qS (by simp)).2.2.2.1, hqτ]) (by omega)
    have hN1 : τ1.vars q.N = N := by rw [v1 _ (keepReg q.N (by simp)).2.2.2.1, hqNτ]
    obtain ⟨τ2, hr2, hS2, hv2, hf2, hx2, -, ha2, hi2, ho2⟩ :=
      rcopy_run M q hq [w.ra, w.j, w.qS]
        (by intro x hx; simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
            rcases hx with rfl | rfl | rfl
            · exact ⟨hraS, hraJ⟩
            · exact ⟨hjS, hjJ⟩
            · exact ⟨hw.reg _ (by simp [TNames.list]), hw.j (by simp [TNames.list])⟩)
        (rowDst w) (.var w.qS) (by simp [rowDst, plus, VarsIn]) (by simp [VarsIn]) hS1 eD eS hN1
        (by omega) hqfit (Or.inl (by omega))
    have eOne : (oneE w).evalB B τ2 = some (R + 2 * N + jv) := by
      have er : τ2.vars w.ra = R := by rw [hx2 _ hraS hraJ]; simp [hτ1]
      have en : τ2.vars w.n2 = 2 * N := by
        obtain ⟨a1, a2, _, a4, _⟩ := keepReg w.n2 (by simp)
        rw [hx2 _ a1 a2, v1 _ a4, hn2τ]
      have ej : τ2.vars w.j = jv := by rw [hx2 _ hjS hjJ, v1 _ hjra]
      exact evalB_plus (evalB_plus (evalB_var_eqB er (by omega)) (evalB_var_eqB en (by omega))
        (by omega)) (evalB_var_eqB ej (by omega)) (by omega)
    obtain ⟨τ3, hr3, hS3, hv3, hoth3, hvars3, harr3, hinp3, hout3⟩ :=
      constE_run q w.ci hciS hciW [w.ra, w.n2, w.j]
        (by intro x hx; simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
            rcases hx with rfl | rfl | rfl
            · exact hraci
            · exact hn2ci
            · exact hjci)
        (oneE w) (by simp [oneE, plus, VarsIn]) hS2 eOne (by omega) (.lit 1) [] (by simp) trivial
        (evalB_lit (by omega)) hp1
    have ej3 : τ3.vars w.j = jv := by rw [hvars3 _ hjci, hx2 _ hjS hjJ, v1 _ hjra]
    have eJ : (plus (.var w.j) (.lit 1)).evalB B τ3 = some (jv + 1) :=
      evalB_plus (evalB_var_eqB ej3 (by omega)) (evalB_lit (by omega)) (by omega)
    set τ4 := τ3.setVar w.j (jv + 1) with hτ4
    have keep : ∀ s < Sn, s ≠ R + 2 * N + jv → (s < R + jv ∨ R + jv + N ≤ s) →
        val F r q.WS τ4 s = val F r q.WS τ s := by
      intro s hs h1 h2
      rw [hτ4, val_setVar F r hjW, hoth3 s hs h1, hf2 s hs h2, val1]
    have copied : ∀ t : Fin N, val F r q.WS τ4 (R + jv + t.val) = qv t := by
      intro t
      have ht := t.isLt
      rw [hτ4, val_setVar F r hjW, hoth3 (R + jv + t.val) (by omega) (by omega), hv2 t.val ht,
        val1, hfτ (qs + (N - 1 - t.val)) (by omega) (Or.inr (by omega))]
      exact hqv t
    have one : val F r q.WS τ4 (R + 2 * N + jv) = 1 := by
      rw [hτ4, val_setVar F r hjW, hv3]; simp
    refine ⟨τ4, ?_, ⟨Slots.setVar F r hS3 hjS hjW _, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
    · refine ((Run.assign eRa).seq (hr2.seq (hr3.seq (Run.assign eJ)))).mono (le_of_eq ?_)
      simp only [rowStepT, raE, plus, Expr.size]
      try ring
    · simp [hτ4]; omega
    · intro y y1 y2 y3 y4 y5
      rw [hτ4, vars_setVar, if_neg y3, hvars3 _ y5, hx2 _ y1 y2, v1 _ y4, hxτ y y1 y2 y3 y4 y5]
    · intro a ha i
      have hi := i.isLt
      simp only [hτ4, vars_setVar, if_true] at ha
      by_cases hai : a.val = jv
      · rw [hai]
        by_cases hin : jv ≤ i.val ∧ i.val - jv < N
        · have e : R + i.val = R + jv + (i.val - jv) := by omega
          rw [e, copied ⟨i.val - jv, hin.2⟩]
          unfold toepGen
          rw [dif_pos (by rw [hai]; exact hin)]
          congr 1; exact Fin.ext (by simp [hai])
        · have hne : R + i.val ≠ R + 2 * N + jv := by omega
          rw [keep _ (by omega) hne (by omega), hfτ _ (by omega) (Or.inr (by omega))]
          unfold toepGen
          rw [dif_neg (by rw [hai]; exact hin)]
          exact hzero (R + i.val) (by omega) (by omega)
      · have hle : rowStart (2 * N + N) a.val + (2 * N + N) ≤ R := rs_le (by omega)
        rw [keep _ (by omega) (by omega) (Or.inl (by omega))]
        exact hpτ a (by omega) i
    · intro a ha u
      have hu := u.isLt
      simp only [hτ4, vars_setVar, if_true] at ha
      by_cases hai : a.val = jv
      · by_cases hu' : u.val = jv
        · have hue : u = a := Fin.ext (hu'.trans hai.symm)
          rw [if_pos hue, hai, hu']
          exact one
        · rw [if_neg (fun e => hu' (by rw [e]; exact hai)), hai,
            keep _ (by omega) (by omega) (Or.inr (by omega)),
            hfτ _ (by omega) (Or.inr (by omega))]
          exact hzero (R + 2 * N + u.val) (by omega) (by omega)
      · have hle : rowStart (2 * N + N) a.val + (2 * N + N) ≤ R := rs_le (by omega)
        rw [keep _ (by omega) (by omega) (Or.inl (by omega))]
        exact hsτ a (by omega) u
    · intro s hs ho
      simp only [hτ4, vars_setVar, if_true, rs_succ] at ho
      rcases ho with ho | ho
      · rw [keep s hs (by omega) (Or.inl (by omega))]
        exact hfτ s hs (Or.inl ho)
      · rw [keep s hs (by omega) (Or.inr (by omega))]
        exact hfτ s hs (Or.inr (by omega))
    · intro a h1 h2
      rw [hτ4, arrs_setVar, harr3 a h1, ha2 a h1 h2, hτ1, arrs_setVar, haτ a h1 h2]
    · rw [hτ4, inp_setVar, hinp3, hi2, hτ1, inp_setVar, hinτ]
    · rw [hτ4, out_setVar, hout3, ho2, hτ1, out_setVar, houτ]
    · simp [hτ4]; omega
  obtain ⟨τ, hr, hI, hc⟩ := Run.while_count I (fun τ => N - τ.vars w.j) (rowStepT M w N)
    hdef hstep hI0
  obtain ⟨hSτ, hjτ, hxτ, hpτ, hsτ, hfτ, haτ, hinτ, houτ⟩ := hI
  have hNτ : τ.vars w.Nr = N := by
    obtain ⟨a1, a2, a3, a4, a5⟩ := keepReg w.Nr (by simp)
    rw [hxτ _ a1 a2 a3 a4 a5, hN]
  have hjN : τ.vars w.j = N := by
    rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hNτ]; omega)), hNτ] at hc
    simp at hc; omega
  refine ⟨τ, ?_, hSτ, fun a i => hpτ a (by omega) i, fun a u => hsτ a (by omega) u,
    fun s hs ho => hfτ s hs (by rw [hjN]; exact ho), hxτ, haτ, hinτ, houτ⟩
  refine ((Run.assign (x := w.j) (evalB_lit (σ := σ) (n := 0) (by omega))).seq hr).mono
    (le_of_eq ?_)
  simp only [rowsCost, Cond.size, Expr.size, hσ0, vars_setVar, if_true, Nat.sub_zero]
  try ring
set_option maxHeartbeats 1600000 in
theorem toeplitz_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (w : TNames)
    (hw : w.Valid r q) {B Sn : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ) {N ps qs : ℕ}
    (hN : σ.vars w.Nr = N) (hps : σ.vars w.pS = ps) (hqs : σ.vars w.qS = qs)
    (hpL : rowStart (2 * N + N) N ≤ ps) (hpfit : ps + N ≤ Sn)
    (hqL : rowStart (2 * N + N) N ≤ qs) (hqfit : qs + N ≤ Sn)
    (p qv : Fin N → K)
    (hp : ∀ i : Fin N, val F r q.WS σ (ps + (N - 1 - i.val)) = p i)
    (hqv : ∀ i : Fin N, val F r q.WS σ (qs + (N - 1 - i.val)) = qv i) :
    ∃ τ, Run B (toeplitzCom M q w) σ τ (toeplitzCost M w N) ∧ Slots F r q.WS Sn B τ ∧
      (∀ s < 5, val F r q.WS τ s = 0) ∧
      (∀ i : Fin (2 * N), val F r q.WS τ (5 + i.val) = toepTarget p i) ∧
      (∀ u < N, val F r q.WS τ (5 + 2 * N + u) = 0) ∧
      (∀ (a : Fin N) (i : Fin (2 * N)),
        val F r q.WS τ (rowStart (2 * N + N) a.val + i.val) = toepGen qv a i) ∧
      (∀ (a u : Fin N), val F r q.WS τ (rowStart (2 * N + N) a.val + 2 * N + u.val) =
        if u = a then 1 else 0) ∧
      (∀ s < Sn, rowStart (2 * N + N) N ≤ s → val F r q.WS τ s = val F r q.WS σ s) ∧
      τ.vars q.n = 2 * N ∧ τ.vars q.N = 2 * N + N ∧ τ.vars q.c = N ∧
      τ.vars w.Nr = N ∧ τ.vars w.pS = ps ∧ τ.vars w.qS = qs ∧
      (∀ y, y ∉ regNames r → y ≠ q.j → y ≠ q.N → y ≠ q.n → y ≠ q.c → y ∉ w.work →
        τ.vars y = σ.vars y) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hSB := hS.slots_word
  have hLvE : rowStart (2 * N + N) N = 5 + (2 * N + N) + N * (2 * N + N) := rfl
  have hR0 : rowStart (2 * N + N) 0 = 5 + (2 * N + N) := by unfold rowStart; omega
  have hLS : rowStart (2 * N + N) N ≤ Sn := by omega
  have hNB : N < B := by omega
  have memL : ∀ y ∈ w.list, y ∉ regNames r ∧ y ≠ q.WS ∧ y ≠ q.j ∧ y ≠ q.N ∧ y ≠ q.n ∧ y ≠ q.c :=
    fun y hy => ⟨hw.reg _ hy, hw.ws hy, hw.j hy, hw.N hy, hw.n hy, hw.c hy⟩
  have mNr := memL w.Nr (by simp [TNames.list])
  have mpS := memL w.pS (by simp [TNames.list])
  have mqS := memL w.qS (by simp [TNames.list])
  have mn2 := memL w.n2 (by simp [TNames.list])
  have mn3 := memL w.n3 (by simp [TNames.list])
  have mL := memL w.L (by simp [TNames.list])
  have mzr := memL w.zr (by simp [TNames.list])
  have ms := memL w.s (by simp [TNames.list])
  have mj := memL w.j (by simp [TNames.list])
  have mra := memL w.ra (by simp [TNames.list])
  have mci := memL w.ci (by simp [TNames.list])
  have hNS : q.N ∉ regNames r := hq.avoid _ q.N_mem
  have hNW : q.N ≠ q.WS := hq.ne_of (by intro h; simp [RNames.list, h])
  have hNj : q.N ≠ q.j := hq.ne_of (by intro h; simp [RNames.list, h])
  have hnS : q.n ∉ regNames r := hq.avoid _ (by simp [RNames.list])
  have hnW : q.n ≠ q.WS := hq.ne_of (by intro h; simp [RNames.list, h])
  have hcS : q.c ∉ regNames r := hq.avoid _ (by simp [RNames.list])
  have hcW : q.c ≠ q.WS := hq.ne_of (by intro h; simp [RNames.list, h])
  have n_Nr_n2 : w.Nr ≠ w.n2 := hw.ne 0 3 (by omega) (by omega) (by omega)
  have n_Nr_n3 : w.Nr ≠ w.n3 := hw.ne 0 4 (by omega) (by omega) (by omega)
  have n_Nr_L : w.Nr ≠ w.L := hw.ne 0 5 (by omega) (by omega) (by omega)
  have n_Nr_zr : w.Nr ≠ w.zr := hw.ne 0 6 (by omega) (by omega) (by omega)
  have n_Nr_s : w.Nr ≠ w.s := hw.ne 0 7 (by omega) (by omega) (by omega)
  have n_Nr_j : w.Nr ≠ w.j := hw.ne 0 8 (by omega) (by omega) (by omega)
  have n_Nr_ra : w.Nr ≠ w.ra := hw.ne 0 9 (by omega) (by omega) (by omega)
  have n_Nr_ci : w.Nr ≠ w.ci := hw.ne 0 10 (by omega) (by omega) (by omega)
  have n_pS_n2 : w.pS ≠ w.n2 := hw.ne 1 3 (by omega) (by omega) (by omega)
  have n_pS_n3 : w.pS ≠ w.n3 := hw.ne 1 4 (by omega) (by omega) (by omega)
  have n_pS_L : w.pS ≠ w.L := hw.ne 1 5 (by omega) (by omega) (by omega)
  have n_pS_zr : w.pS ≠ w.zr := hw.ne 1 6 (by omega) (by omega) (by omega)
  have n_pS_s : w.pS ≠ w.s := hw.ne 1 7 (by omega) (by omega) (by omega)
  have n_pS_j : w.pS ≠ w.j := hw.ne 1 8 (by omega) (by omega) (by omega)
  have n_pS_ra : w.pS ≠ w.ra := hw.ne 1 9 (by omega) (by omega) (by omega)
  have n_pS_ci : w.pS ≠ w.ci := hw.ne 1 10 (by omega) (by omega) (by omega)
  have n_qS_n2 : w.qS ≠ w.n2 := hw.ne 2 3 (by omega) (by omega) (by omega)
  have n_qS_n3 : w.qS ≠ w.n3 := hw.ne 2 4 (by omega) (by omega) (by omega)
  have n_qS_L : w.qS ≠ w.L := hw.ne 2 5 (by omega) (by omega) (by omega)
  have n_qS_zr : w.qS ≠ w.zr := hw.ne 2 6 (by omega) (by omega) (by omega)
  have n_qS_s : w.qS ≠ w.s := hw.ne 2 7 (by omega) (by omega) (by omega)
  have n_qS_j : w.qS ≠ w.j := hw.ne 2 8 (by omega) (by omega) (by omega)
  have n_qS_ra : w.qS ≠ w.ra := hw.ne 2 9 (by omega) (by omega) (by omega)
  have n_qS_ci : w.qS ≠ w.ci := hw.ne 2 10 (by omega) (by omega) (by omega)
  have n_n2_n3 : w.n2 ≠ w.n3 := hw.ne 3 4 (by omega) (by omega) (by omega)
  have n_n2_L : w.n2 ≠ w.L := hw.ne 3 5 (by omega) (by omega) (by omega)
  have n_n2_zr : w.n2 ≠ w.zr := hw.ne 3 6 (by omega) (by omega) (by omega)
  have n_n2_s : w.n2 ≠ w.s := hw.ne 3 7 (by omega) (by omega) (by omega)
  have n_n2_j : w.n2 ≠ w.j := hw.ne 3 8 (by omega) (by omega) (by omega)
  have n_n2_ra : w.n2 ≠ w.ra := hw.ne 3 9 (by omega) (by omega) (by omega)
  have n_n2_ci : w.n2 ≠ w.ci := hw.ne 3 10 (by omega) (by omega) (by omega)
  have n_n3_L : w.n3 ≠ w.L := hw.ne 4 5 (by omega) (by omega) (by omega)
  have n_n3_zr : w.n3 ≠ w.zr := hw.ne 4 6 (by omega) (by omega) (by omega)
  have n_n3_s : w.n3 ≠ w.s := hw.ne 4 7 (by omega) (by omega) (by omega)
  have n_n3_j : w.n3 ≠ w.j := hw.ne 4 8 (by omega) (by omega) (by omega)
  have n_n3_ra : w.n3 ≠ w.ra := hw.ne 4 9 (by omega) (by omega) (by omega)
  have n_n3_ci : w.n3 ≠ w.ci := hw.ne 4 10 (by omega) (by omega) (by omega)
  have n_L_zr : w.L ≠ w.zr := hw.ne 5 6 (by omega) (by omega) (by omega)
  have n_L_s : w.L ≠ w.s := hw.ne 5 7 (by omega) (by omega) (by omega)
  have n_L_ci : w.L ≠ w.ci := hw.ne 5 10 (by omega) (by omega) (by omega)
  have n_zr_s : w.zr ≠ w.s := hw.ne 6 7 (by omega) (by omega) (by omega)
  have n_zr_ci : w.zr ≠ w.ci := hw.ne 6 10 (by omega) (by omega) (by omega)
  have n_s_ci : w.s ≠ w.ci := hw.ne 7 10 (by omega) (by omega) (by omega)
  set σ1 := σ.setVar w.zr 0 with hσ1
  have k1 : ∀ y, y ≠ w.zr → σ1.vars y = σ.vars y := fun y hy => by
    simp only [hσ1, vars_setVar, if_neg hy]
  have e2 : (plus (.var w.Nr) (.var w.Nr)).evalB B σ1 = some (2 * N) := by
    have h : (plus (.var w.Nr) (.var w.Nr)).evalB B σ1 = some (N + N) :=
      evalB_plus (evalB_var_eqB (by rw [k1 _ n_Nr_zr, hN] : σ1.vars w.Nr = N) hNB)
        (evalB_var_eqB (by rw [k1 _ n_Nr_zr, hN] : σ1.vars w.Nr = N) hNB) (by omega)
    rw [show N + N = 2 * N by omega] at h; exact h
  set σ2 := σ1.setVar w.n2 (2 * N) with hσ2
  have k2 : ∀ y, y ≠ w.zr → y ≠ w.n2 → σ2.vars y = σ.vars y := fun y h1 h2 => by
    simp only [hσ2, vars_setVar, if_neg h2]; exact k1 y h1
  have e3 : (plus (.var w.n2) (.var w.Nr)).evalB B σ2 = some (2 * N + N) :=
    evalB_plus (evalB_var_eqB (by simp [hσ2]) (by omega))
      (evalB_var_eqB (by rw [k2 _ n_Nr_zr n_Nr_n2, hN]) hNB) (by omega)
  set σ3 := σ2.setVar w.n3 (2 * N + N) with hσ3
  have k3 : ∀ y, y ≠ w.zr → y ≠ w.n2 → y ≠ w.n3 → σ3.vars y = σ.vars y := fun y h1 h2 h3 => by
    simp only [hσ3, vars_setVar, if_neg h3]; exact k2 y h1 h2
  have e4 : (plus (plus (.lit 5) (.var w.n3)) (.bin .mul (.var w.Nr) (.var w.n3))).evalB B σ3 =
      some (rowStart (2 * N + N) N) := by
    have h1 : (plus (.lit 5) (.var w.n3)).evalB B σ3 = some (5 + (2 * N + N)) :=
      evalB_plus (evalB_lit (by omega))
        (evalB_var_eqB (by simp [hσ3] : σ3.vars w.n3 = 2 * N + N) (by omega)) (by omega)
    have h2 : (Expr.bin .mul (.var w.Nr) (.var w.n3)).evalB B σ3 = some (N * (2 * N + N)) :=
      evalB_mul (evalB_var_eqB (by rw [k3 _ n_Nr_zr n_Nr_n2 n_Nr_n3, hN]) hNB)
        (evalB_var_eqB (by simp [hσ3] : σ3.vars w.n3 = 2 * N + N) (by omega)) (by omega)
    have h3 := evalB_plus h1 h2 (by omega)
    rw [hLvE]; exact h3
  set σ4 := σ3.setVar w.L (rowStart (2 * N + N) N) with hσ4
  have k4 : ∀ y, y ≠ w.zr → y ≠ w.n2 → y ≠ w.n3 → y ≠ w.L → σ4.vars y = σ.vars y :=
    fun y h1 h2 h3 h4 => by simp only [hσ4, vars_setVar, if_neg h4]; exact k3 y h1 h2 h3
  have e5 : (Expr.var w.Nr).evalB B σ4 = some N :=
    evalB_var_eqB (by rw [k4 _ n_Nr_zr n_Nr_n2 n_Nr_n3 n_Nr_L, hN]) hNB
  set σ5 := σ4.setVar q.N N with hσ5
  have k5 : ∀ y, y ≠ w.zr → y ≠ w.n2 → y ≠ w.n3 → y ≠ w.L → y ≠ q.N → σ5.vars y = σ.vars y :=
    fun y h1 h2 h3 h4 h5 => by simp only [hσ5, vars_setVar, if_neg h5]; exact k4 y h1 h2 h3 h4
  have hS5 : Slots F r q.WS Sn B σ5 :=
    Slots.setVar F r (Slots.setVar F r (Slots.setVar F r (Slots.setVar F r (Slots.setVar F r hS
      mzr.1 mzr.2.1 0) mn2.1 mn2.2.1 _) mn3.1 mn3.2.1 _) mL.1 mL.2.1 _) hNS hNW N
  have val5 : ∀ s, val F r q.WS σ5 s = val F r q.WS σ s := fun s => by
