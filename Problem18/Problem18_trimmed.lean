    (hnot : ∀ x ∈ aw.list, x ∉ q.list) {B Sn : ℕ} {σ : Env}
    (hS : Slots F canonical q.WS Sn B σ) {dv Nv sv ov : ℕ}
    (hd : σ.vars aw.d = dv) (hN : σ.vars aw.N = Nv) (hs : σ.vars aw.src = sv)
    (ho : σ.vars aw.out = ov) (hdN : dv < Nv) (hsS : sv + dv ≤ Sn) (hoS : ov + Nv ≤ Sn)
