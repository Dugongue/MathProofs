open scoped Classical
theorem norm_units_fiber_card
    {F : Type*} [Field F] [Fintype F] [Fintype K] [Algebra F K]
    (hcard : Fintype.card K = Fintype.card F ^ 2) (y : Fˣ) :
    (Finset.univ.filter (fun x : Kˣ => Units.map (Algebra.norm F (S := K)) x = y)).card =
      Fintype.card F + 1 := by
  classical
  let f : Kˣ →* Fˣ := Units.map (Algebra.norm F (S := K))
  have hf : Function.Surjective f := FiniteField.unitsMap_norm_surjective F K
  have he (z : Fˣ) : (Finset.univ.filter (fun x => f x = z)).card =
      (Finset.univ.filter (fun x => f x = y)).card :=
    MonoidHom.card_fiber_eq_of_mem_range f (hf z) (hf y)
  have hc : Fintype.card Kˣ = Fintype.card Fˣ *
      (Finset.univ.filter (fun x => f x = y)).card := by
    calc
      Fintype.card Kˣ = ∑ z : Fˣ, (Finset.univ.filter (fun x => f x = z)).card :=
        Finset.card_eq_sum_card_fiberwise (fun _ _ => Finset.mem_univ _)
      _ = _ := by simp_rw [he]; simp
  rw [Fintype.card_units, Fintype.card_units, hcard] at hc
  have hq : 1 < Fintype.card F := Fintype.one_lt_card
  have h₁ : Fintype.card F - 1 + 1 = Fintype.card F := Nat.sub_add_cancel (by omega)
  have h₂ : Fintype.card F ^ 2 - 1 + 1 = Fintype.card F ^ 2 :=
    Nat.sub_add_cancel (by nlinarith)
  change (Finset.univ.filter (fun x => f x = y)).card = _
  nlinarith
theorem quadratic_character_polarization
    {G F : Type*} [AddCommGroup G] [Fintype G] [AddCommGroup F]
    (ψ : AddChar F ℂ) (Q : G → F) (B : G → G → F)
    (hQ : ∀ x h, Q (x + h) = Q x + Q h + B x h) :
    (∑ x, ψ (Q x)) * (∑ x, ψ (-Q x)) =
      ∑ h, ψ (Q h) * ∑ x, ψ (B x h) := by
  have he (x : G) : ∑ h, ψ (Q (x + h)) = ∑ y, ψ (Q y) :=
    Fintype.sum_equiv (Equiv.addLeft x) _ _ (fun _ => rfl)
  calc
    (∑ x, ψ (Q x)) * (∑ x, ψ (-Q x)) =
        ∑ x, (∑ h, ψ (Q (x + h))) * ψ (-Q x) := by
          simp_rw [he]; rw [Finset.mul_sum]
    _ = ∑ h, ∑ x, ψ (Q (x + h)) * ψ (-Q x) := by
      simp_rw [Finset.sum_mul]; rw [Finset.sum_comm]
    _ = ∑ h, ψ (Q h) * ∑ x, ψ (B x h) := by
      apply Finset.sum_congr rfl
      intro h _
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro x _
      rw [← AddChar.map_add_eq_mul, ← AddChar.map_add_eq_mul, hQ]
      congr 1
      abel
theorem quadratic_character_radical_count
    {G F : Type*} [AddCommGroup G] [Fintype G] [AddCommGroup F]
    (ψ : AddChar F ℂ) (Q : G → F) (B : G → G → F)
    (β : G → AddChar G ℂ)
    (hQ : ∀ x h, Q (x + h) = Q x + Q h + B x h)
    (hβ : ∀ h x, β h x = ψ (B x h))
    (hrad : ∀ h, β h = 1 → Q h = 0) :
    (∑ x, ψ (Q x)) * (∑ x, ψ (-Q x)) =
      (Fintype.card G : ℂ) * (Finset.univ.filter (fun h => β h = 1)).card := by
  rw [quadratic_character_polarization ψ Q B hQ]
  have hi (h : G) : ∑ x, ψ (B x h) =
      if β h = 1 then (Fintype.card G : ℂ) else 0 := by
    simp_rw [← hβ]
    by_cases hh : β h = 1
    · simp [hh]
    · rw [AddChar.sum_eq_zero_of_ne_one hh]
      simp [hh]
  simp_rw [hi]
  calc
    (∑ h, ψ (Q h) * (if β h = 1 then (Fintype.card G : ℂ) else 0)) =
        ∑ h, if β h = 1 then (Fintype.card G : ℂ) else 0 := by
          apply Finset.sum_congr rfl
          intro h _
          by_cases hh : β h = 1
          · simp [hh, hrad h hh, AddChar.map_zero_eq_one]
          · simp [hh]
    _ = _ := by simp [Finset.sum_ite, mul_comm]
theorem quadratic_character_norm_sq
    {G F : Type*} [AddCommGroup G] [Fintype G] [CommRing F]
    (hp : 0 < ringChar F) (ψ : AddChar F ℂ) (Q : G → F) (B : G → G → F)
    (β : G → AddChar G ℂ)
    (hQ : ∀ x h, Q (x + h) = Q x + Q h + B x h)
    (hβ : ∀ h x, β h x = ψ (B x h))
    (hrad : ∀ h, β h = 1 → Q h = 0) :
    ‖∑ x, ψ (Q x)‖ ^ 2 =
      (Fintype.card G : ℝ) * (Finset.univ.filter (fun h => β h = 1)).card := by
  have hn (a : F) : ψ (-a) = star (ψ a) := by
    simpa [AddChar.inv_apply] using (AddChar.starComp_apply hp (φ := ψ) a).symm
  have hs : ∑ x, ψ (-Q x) = star (∑ x, ψ (Q x)) := by
    simp_rw [hn]
    exact (map_sum (starRingEnd ℂ) (fun x => ψ (Q x)) Finset.univ).symm
  have he := quadratic_character_radical_count ψ Q B β hQ hβ hrad
  rw [hs] at he
  change (∑ x, ψ (Q x)) * (starRingEnd ℂ) (∑ x, ψ (Q x)) = _ at he
  rw [Complex.mul_conj] at he
  have hr := congrArg Complex.re he
  simp only [Complex.ofReal_re, Complex.mul_re, Complex.natCast_re,
    Complex.natCast_im, mul_zero, sub_zero] at hr
  simpa only [Complex.normSq_eq_norm_sq] using hr
theorem quadratic_character_mean_norm_sq
    {G F : Type*} [AddCommGroup G] [Fintype G] [CommRing F]
    (hp : 0 < ringChar F) (ψ : AddChar F ℂ) (Q : G → F) (B : G → G → F)
    (β : G → AddChar G ℂ)
    (hQ : ∀ x h, Q (x + h) = Q x + Q h + B x h)
    (hβ : ∀ h x, β h x = ψ (B x h))
    (hrad : ∀ h, β h = 1 → Q h = 0) :
    ‖(∑ x, ψ (Q x)) / (Fintype.card G : ℂ)‖ ^ 2 =
      (Finset.univ.filter (fun h => β h = 1)).card / (Fintype.card G : ℝ) := by
  rw [norm_div, div_pow, quadratic_character_norm_sq hp ψ Q B β hQ hβ hrad]
  have hc : (Fintype.card G : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  simp only [Complex.norm_natCast]
  field_simp
theorem character_detects_linear_map
    {F V : Type*} [Field F] [AddCommGroup V] [Module F V]
    (ψ : AddChar F ℂ) (hψ : ψ ≠ 1) (L : V →ₗ[F] F) :
    (∀ x, ψ (L x) = 1) ↔ L = 0 := by
  constructor
  · intro h
    ext x
    change L x = 0
    by_contra hx
    apply hψ
    ext a
    change ψ a = 1
    have he := h ((a / L x) • x)
    simpa [map_smul, smul_eq_mul, div_mul_cancel₀ _ hx] using he
  · rintro rfl
    simp [AddChar.map_zero_eq_one]
theorem trace_character_nondegenerate
    {F : Type*} [Field F] [Algebra F K] [FiniteDimensional F K]
    [Algebra.IsSeparable F K]
    (ψ : AddChar F ℂ) (hψ : ψ ≠ 1) (a : K) :
    (∀ x, ψ (Algebra.trace F K (a * x)) = 1) ↔ a = 0 := by
  constructor
  · intro h
    have hz : Algebra.traceForm F K a = 0 :=
      (character_detects_linear_map ψ hψ (Algebra.traceForm F K a)).mp h
    exact (traceForm_nondegenerate F K).1 a (by simp [hz])
  · rintro rfl
    simp [AddChar.map_zero_eq_one]
theorem trace_vector_character_nondegenerate
    {F i : Type*} [Field F] [Fintype i] [Algebra F K] [FiniteDimensional F K]
    [Algebra.IsSeparable F K]
    (ψ : AddChar F ℂ) (hψ : ψ ≠ 1) (z : i → K) :
    (∀ x : i → K, ψ (Algebra.trace F K (∑ j, x j * z j)) = 1) ↔ z = 0 := by
  constructor
  · intro h
    ext j
    apply (trace_character_nondegenerate ψ hψ (z j)).mp
    intro a
    have he := h (Pi.single j a)
    simpa [Pi.single_apply, ite_mul, mul_comm] using he
  · rintro rfl
    simp [AddChar.map_zero_eq_one]
theorem trace_matrix_character_radical
    {F i j : Type*} [Field F] [Fintype i] [Fintype j]
    [Algebra F K] [FiniteDimensional F K] [Algebra.IsSeparable F K]
    (ψ : AddChar F ℂ) (hψ : ψ ≠ 1) (A : Matrix i j K) (y : j → K) :
    (∀ x : i → K, ψ (Algebra.trace F K (∑ k, x k * (A.mulVec y) k)) = 1) ↔
      A.mulVec y = 0 :=
  trace_vector_character_nondegenerate ψ hψ (A.mulVec y)
theorem linear_kernel_fraction
    {F V W : Type*} [Field F] [Fintype F] [AddCommGroup V] [Fintype V] [Module F V]
    [AddCommGroup W] [Module F W] (L : V →ₗ[F] W) :
    (Fintype.card (LinearMap.ker L) : ℝ) / (Fintype.card V : ℝ) =
      ((Fintype.card F : ℝ) ^ Module.finrank F (LinearMap.range L))⁻¹ := by
  rw [Module.card_eq_pow_finrank (K := F) (V := LinearMap.ker L),
    Module.card_eq_pow_finrank (K := F) (V := V), ← L.finrank_range_add_finrank_ker]
  simp only [Nat.cast_pow, pow_add, Nat.cast_mul]
  have hc : (Fintype.card F : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  field_simp
theorem trace_matrix_quadratic_fourier
    {F i : Type*} [Field F] [Fintype F] [Fintype K] [Fintype i] [StarRing K]
    [Algebra F K] [FiniteDimensional F K] [Algebra.IsSeparable F K]
    (hp : 0 < ringChar F) (ψ : AddChar F ℂ) (hψ : ψ ≠ 1)
    (A : Matrix i i K) (Q : (i → K) → F)
    (hQ : ∀ x h, Q (x + h) = Q x + Q h +
      Algebra.trace F K (∑ j, star (x j) * (A.mulVec h) j))
    (hrad : ∀ h, A.mulVec h = 0 → Q h = 0) :
    ‖(∑ x, ψ (Q x)) / (Fintype.card (i → K) : ℂ)‖ ^ 2 =
      ((Fintype.card K : ℝ) ^ A.rank)⁻¹ := by
  let L (h : i → K) : (i → K) →+ F := {
    toFun := fun x => Algebra.trace F K (∑ j, star (x j) * (A.mulVec h) j)
    map_zero' := by simp
    map_add' := by intro x y; simp [add_mul, Finset.sum_add_distrib] }
  let β (h : i → K) : AddChar (i → K) ℂ := ψ.compAddMonoidHom (L h)
  have hb (h : i → K) : β h = 1 ↔ A.mulVec h = 0 := by
    constructor
    · intro he
      apply (trace_matrix_character_radical ψ hψ A h).mp
      intro x
      have hx := congrArg (fun χ : AddChar (i → K) ℂ => χ (star x)) he
      simpa [β, L] using hx
    · intro he
      ext x
      simp [β, L, he, AddChar.map_zero_eq_one]
  have he := quadratic_character_mean_norm_sq hp ψ Q
    (fun x h => Algebra.trace F K (∑ j, star (x j) * (A.mulVec h) j)) β
    hQ (fun _ _ => rfl) (fun h hh => hrad h ((hb h).mp hh))
  simp only [hb] at he
  rw [he]
  have hk : (Finset.univ.filter (fun h => A.mulVec h = 0)).card =
      Fintype.card (LinearMap.ker A.mulVecLin) := by
    symm
    exact Fintype.card_of_subtype _ (by intro x; simp)
  rw [hk]
  simpa only [Matrix.rank] using linear_kernel_fraction A.mulVecLin
theorem quadratic_trace
    {F : Type*} [Field F] [Fintype F] [Finite K] [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F) (x : K) :
    algebraMap F K (Algebra.trace F K x) = x + star x := by
  have hd : Module.finrank F K = 2 := by
    apply Nat.pow_right_injective (show 2 ≤ Nat.card F from Finite.one_lt_card)
    change Nat.card F ^ Module.finrank F K = Nat.card F ^ 2
    rw [← Module.natCard_eq_pow_finrank, hcard]
  rw [FiniteField.algebraMap_trace_eq_sum_pow, hd]
  simp [Finset.sum_range_succ, hstar]
theorem hermitian_pairing_star
    {i : Type*} [Fintype i] [StarRing K]
    (A : Matrix i i K) (hA : Aᴴ = A) (x y : i → K) :
    star (star x ⬝ᵥ (A *ᵥ y)) = star y ⬝ᵥ (A *ᵥ x) := by
  rw [← star_dotProduct_star, star_star, star_mulVec, hA, ← dotProduct_mulVec]
noncomputable def hermitianQuadratic
    {F i : Type*} [Field F] [Fintype F] [Finite K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (A : Matrix i i K) (hA : Aᴴ = A) (x : i → K) : F :=
  (fixed_scalar_descends hstar (star x ⬝ᵥ (A *ᵥ x))
    (hermitian_pairing_star A hA x x)).choose
theorem hermitian_quadratic_spec
    {F i : Type*} [Field F] [Fintype F] [Finite K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (A : Matrix i i K) (hA : Aᴴ = A) (x : i → K) :
    algebraMap F K (hermitianQuadratic hstar A hA x) = star x ⬝ᵥ (A *ᵥ x) :=
  (fixed_scalar_descends hstar (star x ⬝ᵥ (A *ᵥ x))
    (hermitian_pairing_star A hA x x)).choose_spec
theorem hermitian_quadratic_fourier
    {F i : Type*} [Field F] [Fintype F] [Fintype K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (hp : 0 < ringChar F) (ψ : AddChar F ℂ) (hψ : ψ ≠ 1)
    (A : Matrix i i K) (hA : Aᴴ = A) :
    ‖(∑ x, ψ (hermitianQuadratic hstar A hA x)) / (Fintype.card (i → K) : ℂ)‖ ^ 2 =
      ((Fintype.card K : ℝ) ^ A.rank)⁻¹ := by
  refine trace_matrix_quadratic_fourier hp ψ hψ A (hermitianQuadratic hstar A hA) ?_ ?_
  · intro x h
    apply FaithfulSMul.algebraMap_injective F K
    simp only [map_add, hermitian_quadratic_spec, quadratic_trace hcard hstar]
    change star (x + h) ⬝ᵥ (A *ᵥ (x + h)) =
      star x ⬝ᵥ (A *ᵥ x) + star h ⬝ᵥ (A *ᵥ h) +
        (star x ⬝ᵥ (A *ᵥ h) + star (star x ⬝ᵥ (A *ᵥ h)))
    simp only [star_add, mulVec_add, add_dotProduct, dotProduct_add]
    rw [hermitian_pairing_star A hA x h]
    ring
  · intro h hh
    apply FaithfulSMul.algebraMap_injective F K
    rw [hermitian_quadratic_spec, map_zero, hh, dotProduct_zero]
theorem independent_quadratic_character_sum
    {F V : Type*} [AddCommGroup F] [Fintype V]
    (ψ : AddChar F ℂ) (Q : V → F) (m : ℕ) :
    (∑ x : Fin m → V, ψ (∑ j, Q (x j))) = (∑ x : V, ψ (Q x)) ^ m := by
  have hs (s : Finset (Fin m)) (x : Fin m → V) :
      ψ (∑ j ∈ s, Q (x j)) = ∏ j ∈ s, ψ (Q (x j)) := by
    induction s using Finset.induction_on with
    | empty => simp [AddChar.map_zero_eq_one]
    | @insert j s hj ih => simp [hj, AddChar.map_add_eq_mul, ih]
  simp_rw [hs]
  rw [← Fintype.prod_sum (fun (_ : Fin m) (x : V) => ψ (Q x))]
  simp
theorem finite_fourier_pairing
    {G : Type*} [AddCommGroup G] [Fintype G] (f g : G → ℂ) :
    (∑ χ : AddChar G ℂ, (∑ x, f x * χ x) * (∑ y, g y * χ (-y))) =
      (Fintype.card G : ℂ) * ∑ x, f x * g x := by
  have he (χ : AddChar G ℂ) :
      (∑ x, f x * χ x) * (∑ y, g y * χ (-y)) =
        ∑ x, ∑ y, (f x * g y) * χ (x - y) := by
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro x _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro y _
    rw [sub_eq_add_neg, AddChar.map_add_eq_mul]
    ring
  simp_rw [he]
  calc
    (∑ χ : AddChar G ℂ, ∑ x, ∑ y, (f x * g y) * χ (x - y)) =
        ∑ x, ∑ y, ∑ χ : AddChar G ℂ, (f x * g y) * χ (x - y) := by
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro x _
      rw [Finset.sum_comm]
    _ = _ := by
      simp_rw [← Finset.mul_sum, AddChar.sum_apply_eq_ite]
      simp [sub_eq_zero, mul_ite, Finset.mul_sum, mul_comm]
theorem finite_fourier_parseval
    {G : Type*} [AddCommGroup G] [Fintype G] (f : G → ℂ) :
    (∑ χ : AddChar G ℂ, ‖∑ x, f x * χ x‖ ^ 2) =
      (Fintype.card G : ℝ) * ∑ x, ‖f x‖ ^ 2 := by
  have hc (χ : AddChar G ℂ) :
      (∑ y, (starRingEnd ℂ) (f y) * χ (-y)) =
        (starRingEnd ℂ) (∑ y, f y * χ y) := by
    simp only [map_sum, map_mul, AddChar.map_neg_eq_conj]
  have he := finite_fourier_pairing f (fun x => (starRingEnd ℂ) (f x))
  simp_rw [hc, Complex.mul_conj] at he
  have hr : (∑ χ : AddChar G ℂ, Complex.normSq (∑ x, f x * χ x)) =
      (Fintype.card G : ℝ) * ∑ x, Complex.normSq (f x) := by
    exact_mod_cast he
  simpa only [Complex.normSq_eq_norm_sq] using hr
theorem finite_fourier_l1_bound
    {G : Type*} [AddCommGroup G] [Fintype G] (f : G → ℂ) :
    (∑ x, ‖f x‖) ^ 2 ≤ ∑ χ : AddChar G ℂ, ‖∑ x, f x * χ x‖ ^ 2 := by
  rw [finite_fourier_parseval]
  simpa using (Finset.sum_mul_sq_le_sq_mul_sq Finset.univ
    (fun _ : G => (1 : ℝ)) (fun x => ‖f x‖))
noncomputable def uniformImageWeight
    {V G : Type*} [Fintype V] (P : V → G) (y : G) : ℂ :=
  (Finset.univ.filter (fun x => P x = y)).card / (Fintype.card V : ℂ)
theorem uniform_image_average
    {V G : Type*} [Fintype V] [Fintype G] (P : V → G) (g : G → ℂ) :
    (∑ y, uniformImageWeight P y * g y) = (∑ x, g (P x)) / (Fintype.card V : ℂ) := by
  unfold uniformImageWeight
  simp_rw [div_mul_eq_mul_div]
  rw [← Finset.sum_div]
  congr 1
  rw [← Finset.sum_fiberwise' Finset.univ P g]
  simp [nsmul_eq_mul]
theorem uniform_image_total
    {V G : Type*} [Fintype V] [Nonempty V] [Fintype G] (P : V → G) :
    ∑ y, uniformImageWeight P y = 1 := by
  have he := uniform_image_average P (fun _ => 1)
  simpa using he
noncomputable def columnRangeEquiv
    {V W : Type*} [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
    (L : V →ₗ[K] W) (j : Type*) :
    LinearMap.range (L.compLeft j) ≃ₗ[K] (j → LinearMap.range L) where
  toFun y k := ⟨y.val k, by
    obtain ⟨x, hx⟩ := y.property
    exact ⟨x k, congrFun hx k⟩⟩
  invFun y := ⟨fun k => (y k).val, by
    choose x hx using fun k => (y k).property
    exact ⟨x, funext hx⟩⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv _ := rfl
  right_inv _ := rfl
theorem column_operator_rank
    {V W j : Type*} [AddCommGroup V] [Module K V] [AddCommGroup W] [Module K W]
    [FiniteDimensional K V] [Fintype j] (L : V →ₗ[K] W) :
    Module.finrank K (LinearMap.range (L.compLeft j)) =
      Fintype.card j * Module.finrank K (LinearMap.range L) := by
  rw [(columnRangeEquiv L j).finrank_eq, Module.finrank_pi_fintype]
  simp
def columnCoordinates (i j : Type*) : ((i × j) → K) ≃ₗ[K] (j → i → K) where
  toFun x k a := x (a, k)
  invFun x p := x p.2 p.1
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv _ := rfl
  right_inv _ := rfl
theorem block_diagonal_mulVecLin
    {i j k : Type*} [Fintype i] [Fintype j] [Fintype k] [DecidableEq k]
    (A : Matrix i j K) :
    (Matrix.blockDiagonal (fun _ : k => A)).mulVecLin =
      (columnCoordinates (K := K) i k).symm.toLinearMap ∘ₗ
        A.mulVecLin.compLeft k ∘ₗ (columnCoordinates (K := K) j k).toLinearMap := by
  apply LinearMap.ext
  intro x
  funext p
  rcases p with ⟨a, b⟩
  simp [columnCoordinates, Matrix.mulVec, dotProduct,
    Matrix.blockDiagonal_apply, Fintype.sum_prod_type, ite_mul]
theorem block_diagonal_rank
    {i j k : Type*} [Fintype i] [Fintype j] [Fintype k] [DecidableEq k]
    (A : Matrix i j K) :
    (Matrix.blockDiagonal (fun _ : k => A)).rank = Fintype.card k * A.rank := by
  unfold Matrix.rank
  rw [block_diagonal_mulVecLin, LinearMap.range_comp, LinearMap.range_comp,
    LinearEquiv.range, Submodule.map_top, LinearEquiv.finrank_map_eq]
  exact column_operator_rank A.mulVecLin
theorem gram_trace_columns
    {i j : Type*} [Fintype i] [Fintype j] [StarRing K]
    (Z : Matrix i i K) (N : Matrix i j K) :
    Matrix.trace (Z * (N * Nᴴ)) =
      ∑ c, star (fun a => N a c) ⬝ᵥ (Z *ᵥ (fun a => N a c)) := by
  rw [Matrix.trace_mul_cycle']
  simp [Matrix.trace, Matrix.diag, Matrix.mul_apply, Matrix.mulVec, dotProduct]
theorem gram_trace_block_form
    {i j : Type*} [Fintype i] [Fintype j] [DecidableEq j] [StarRing K]
    (Z : Matrix i i K) (N : Matrix i j K) :
    Matrix.trace (Z * (N * Nᴴ)) =
      star (fun p : i × j => N p.1 p.2) ⬝ᵥ
        (Matrix.blockDiagonal (fun _ : j => Z) *ᵥ (fun p => N p.1 p.2)) := by
  rw [gram_trace_columns]
  simp [dotProduct, Matrix.mulVec, Matrix.blockDiagonal_apply,
    Fintype.sum_prod_type, ite_mul]
  rw [Finset.sum_comm]
theorem block_diagonal_hermitian
    {i j : Type*} [Fintype i] [Fintype j] [DecidableEq j] [StarRing K]
    (Z : Matrix i i K) (hZ : Zᴴ = Z) :
    (Matrix.blockDiagonal (fun _ : j => Z))ᴴ =
      Matrix.blockDiagonal (fun _ : j => Z) := by
  rw [Matrix.blockDiagonal_conjTranspose]
  simp only [hZ]
theorem gram_trace_quadratic_spec
    {F i j : Type*} [Field F] [Fintype F] [Finite K]
    [Fintype i] [Fintype j] [DecidableEq j] [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (Z : Matrix i i K) (hZ : Zᴴ = Z) (N : Matrix i j K) :
    algebraMap F K (hermitianQuadratic hstar
      (Matrix.blockDiagonal (fun _ : j => Z))
      (block_diagonal_hermitian Z hZ) (fun p => N p.1 p.2)) =
        Matrix.trace (Z * (N * Nᴴ)) := by
  rw [hermitian_quadratic_spec, gram_trace_block_form]
theorem hermitian_trace_fixed
    {i : Type*} [Fintype i] [StarRing K]
    (A B : Matrix i i K) (hA : Aᴴ = A) (hB : Bᴴ = B) :
    star (Matrix.trace (A * B)) = Matrix.trace (A * B) := by
  rw [← Matrix.trace_conjTranspose, Matrix.conjTranspose_mul, hA, hB,
    Matrix.trace_mul_comm]
noncomputable def hermitianTrace
    {F i : Type*} [Field F] [Fintype F] [Finite K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (A B : selfAdjoint (Matrix i i K)) : F :=
  (fixed_scalar_descends hstar
    (Matrix.trace ((A : Matrix i i K) * (B : Matrix i i K)))
    (hermitian_trace_fixed (A : Matrix i i K) (B : Matrix i i K)
      (show (A : Matrix i i K)ᴴ = A from A.property)
      (show (B : Matrix i i K)ᴴ = B from B.property))).choose
theorem hermitianTrace_spec
    {F i : Type*} [Field F] [Fintype F] [Finite K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (A B : selfAdjoint (Matrix i i K)) :
    algebraMap F K (hermitianTrace hstar A B) =
      Matrix.trace ((A : Matrix i i K) * (B : Matrix i i K)) :=
  (fixed_scalar_descends hstar
    (Matrix.trace ((A : Matrix i i K) * (B : Matrix i i K)))
    (hermitian_trace_fixed (A : Matrix i i K) (B : Matrix i i K)
      (show (A : Matrix i i K)ᴴ = A from A.property)
      (show (B : Matrix i i K)ᴴ = B from B.property))).choose_spec
noncomputable def hermitianTraceAddMonoidHom
    {F i : Type*} [Field F] [Fintype F] [Finite K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (A : selfAdjoint (Matrix i i K)) :
    selfAdjoint (Matrix i i K) →+ F where
  toFun := hermitianTrace hstar A
  map_zero' := by
    apply FaithfulSMul.algebraMap_injective F K
    rw [hermitianTrace_spec, map_zero]
    simp
  map_add' B C := by
    apply FaithfulSMul.algebraMap_injective F K
    rw [hermitianTrace_spec, map_add, hermitianTrace_spec, hermitianTrace_spec]
    simp [Matrix.mul_add]
noncomputable def hermitianTraceCharacter
    {F i : Type*} [Field F] [Fintype F] [Finite K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (ψ : AddChar F ℂ) (A : selfAdjoint (Matrix i i K)) :
    AddChar (selfAdjoint (Matrix i i K)) ℂ :=
  ψ.compAddMonoidHom (hermitianTraceAddMonoidHom hstar A)
def gramHermitian
    {i j : Type*} [Fintype j] [StarRing K] (N : Matrix i j K) :
    selfAdjoint (Matrix i i K) :=
  ⟨N * Nᴴ, by
    change (N * Nᴴ)ᴴ = N * Nᴴ
    rw [Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose]⟩
theorem hermitianTrace_gram_eq
    {F i j : Type*} [Field F] [Fintype F] [Finite K]
    [Fintype i] [Fintype j] [DecidableEq j] [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (Z : selfAdjoint (Matrix i i K)) (N : Matrix i j K) :
    hermitianTrace hstar Z (gramHermitian N) =
      hermitianQuadratic hstar (Matrix.blockDiagonal (fun _ : j => (Z : Matrix i i K)))
        (block_diagonal_hermitian (Z : Matrix i i K)
          (show (Z : Matrix i i K)ᴴ = Z from Z.property)) (fun p => N p.1 p.2) := by
  apply FaithfulSMul.algebraMap_injective F K
  rw [hermitianTrace_spec]
  simpa [gramHermitian] using
    (gram_trace_quadratic_spec hstar (Z : Matrix i i K)
      (show (Z : Matrix i i K)ᴴ = Z from Z.property) N).symm
theorem hermitianTraceCharacter_gram
    {F i j : Type*} [Field F] [Fintype F] [Finite K]
    [Fintype i] [Fintype j] [DecidableEq j] [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (ψ : AddChar F ℂ) (Z : selfAdjoint (Matrix i i K)) (N : Matrix i j K) :
    hermitianTraceCharacter hstar ψ Z (gramHermitian N) =
      ψ (hermitianQuadratic hstar
        (Matrix.blockDiagonal (fun _ : j => (Z : Matrix i i K)))
        (block_diagonal_hermitian (Z : Matrix i i K)
          (show (Z : Matrix i i K)ᴴ = Z from Z.property)) (fun p => N p.1 p.2)) := by
  change ψ (hermitianTrace hstar Z (gramHermitian N)) = _
  rw [hermitianTrace_gram_eq]
theorem hermitian_quadratic_polarization_explicit
    {F i : Type*} [Field F] [Fintype F] [Finite K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (A : Matrix i i K) (hA : Aᴴ = A) (x h : i → K) :
    hermitianQuadratic hstar A hA (x + h) =
      hermitianQuadratic hstar A hA x + hermitianQuadratic hstar A hA h +
        Algebra.trace F K (∑ j, star (x j) * (A.mulVec h) j) := by
  apply FaithfulSMul.algebraMap_injective F K
  simp only [map_add, hermitian_quadratic_spec, quadratic_trace hcard hstar]
  change star (x + h) ⬝ᵥ (A *ᵥ (x + h)) =
    star x ⬝ᵥ (A *ᵥ x) + star h ⬝ᵥ (A *ᵥ h) +
      (star x ⬝ᵥ (A *ᵥ h) + star (star x ⬝ᵥ (A *ᵥ h)))
  simp only [star_add, mulVec_add, add_dotProduct, dotProduct_add]
  rw [hermitian_pairing_star A hA x h]
  ring
def rankOneHermitian
    {i : Type*} [StarRing K] (x : i → K) :
    selfAdjoint (Matrix i i K) :=
  ⟨fun a b => x a * star (x b), Matrix.IsHermitian.ext (by
    intro a b
    simp [star_mul])⟩
theorem hermitianTrace_rankOne_eq
    {F i : Type*} [Field F] [Fintype F] [Finite K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (Z : selfAdjoint (Matrix i i K)) (x : i → K) :
    hermitianTrace hstar Z (rankOneHermitian x) =
      hermitianQuadratic hstar (Z : Matrix i i K)
        (show (Z : Matrix i i K)ᴴ = Z from Z.property) x := by
  apply FaithfulSMul.algebraMap_injective F K
  rw [hermitianTrace_spec, hermitian_quadratic_spec]
  simp only [rankOneHermitian, Matrix.trace, Matrix.diag, Matrix.mulVec, dotProduct]
  apply Finset.sum_congr rfl
  intro a _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro b _
  change (Z : Matrix i i K) a b * (x b * star (x a)) =
    star (x a) * ((Z : Matrix i i K) a b * x b)
  ring
theorem hermitianTraceCharacter_eq_one_iff
    {F i : Type*} [Field F] [Fintype F] [Fintype K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (ψ : AddChar F ℂ) (hψ : ψ ≠ 1)
    (Z : selfAdjoint (Matrix i i K)) :
    hermitianTraceCharacter hstar ψ Z = 1 ↔ Z = 0 := by
  constructor
  · intro hχ
    have hq (x : i → K) :
        ψ (hermitianQuadratic hstar (Z : Matrix i i K)
          (show (Z : Matrix i i K)ᴴ = Z from Z.property) x) = 1 := by
      have he := congrArg
        (fun χ : AddChar (selfAdjoint (Matrix i i K)) ℂ => χ (rankOneHermitian x)) hχ
      change ψ (hermitianTrace hstar Z (rankOneHermitian x)) = 1 at he
      rw [hermitianTrace_rankOne_eq] at he
      exact he
    have hpolar (x h : i → K) :
        ψ (Algebra.trace F K (∑ j, star (x j) * ((Z : Matrix i i K).mulVec h) j)) =
          1 := by
      have he := congrArg ψ
        (hermitian_quadratic_polarization_explicit hcard hstar
          (Z : Matrix i i K) (show (Z : Matrix i i K)ᴴ = Z from Z.property) x h)
      simp only [AddChar.map_add_eq_mul, hq, one_mul] at he
      simpa using he.symm
    have hrad (h : i → K) : (Z : Matrix i i K).mulVec h = 0 := by
      apply (trace_matrix_character_radical ψ hψ (Z : Matrix i i K) h).mp
      intro x
      simpa using hpolar (star x) h
    apply Subtype.ext
    change (Z : Matrix i i K) = 0
    apply Matrix.ext
    intro a b
    have he := congrFun (hrad (Pi.single b 1)) a
    simp only [Matrix.mulVec_single_one, Pi.zero_apply] at he
    change (Z : Matrix i i K) a b = 0 at he
    exact he
  · rintro rfl
    ext B
    change ψ (hermitianTrace hstar 0 B) = 1
    have hz : hermitianTrace hstar
        (0 : selfAdjoint (Matrix i i K)) B = 0 := by
      apply FaithfulSMul.algebraMap_injective F K
      rw [hermitianTrace_spec, map_zero]
      simp
    rw [hz]
    exact AddChar.map_zero_eq_one ψ
theorem hermitianTrace_sub_left
    {F i : Type*} [Field F] [Fintype F] [Finite K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (A B C : selfAdjoint (Matrix i i K)) :
    hermitianTrace hstar (A - B) C =
      hermitianTrace hstar A C - hermitianTrace hstar B C := by
  apply FaithfulSMul.algebraMap_injective F K
  rw [hermitianTrace_spec, map_sub, hermitianTrace_spec, hermitianTrace_spec]
  simp [sub_mul]
theorem hermitianTraceCharacter_injective
    {F i : Type*} [Field F] [Fintype F] [Fintype K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (ψ : AddChar F ℂ) (hψ : ψ ≠ 1) :
    Function.Injective
      (hermitianTraceCharacter hstar ψ :
        selfAdjoint (Matrix i i K) → AddChar (selfAdjoint (Matrix i i K)) ℂ) := by
  intro A B hAB
  have hdiff : hermitianTraceCharacter hstar ψ (A - B) = 1 := by
    ext C
    change ψ (hermitianTrace hstar (A - B) C) = 1
    rw [hermitianTrace_sub_left, sub_eq_add_neg, AddChar.map_add_eq_mul,
      AddChar.map_neg_eq_inv]
    have he := congrArg
      (fun χ : AddChar (selfAdjoint (Matrix i i K)) ℂ => χ C) hAB
    change ψ (hermitianTrace hstar A C) = ψ (hermitianTrace hstar B C) at he
    rw [he]
    apply mul_inv_cancel₀
    intro hz
    have hn := ψ.norm_apply (hermitianTrace hstar B C)
    rw [hz, norm_zero] at hn
    norm_num at hn
  exact sub_eq_zero.mp
    ((hermitianTraceCharacter_eq_one_iff hcard hstar ψ hψ (A - B)).mp hdiff)
theorem hermitianTraceCharacter_bijective
    {F i : Type*} [Field F] [Fintype F] [Fintype K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (ψ : AddChar F ℂ) (hψ : ψ ≠ 1) :
    Function.Bijective
      (hermitianTraceCharacter hstar ψ :
        selfAdjoint (Matrix i i K) → AddChar (selfAdjoint (Matrix i i K)) ℂ) := by
  apply (Fintype.bijective_iff_injective_and_card _).2
  refine ⟨hermitianTraceCharacter_injective hcard hstar ψ hψ, ?_⟩
  simp only [AddChar.card_eq]
theorem matrix_rank_pos_of_ne_zero
    {i j : Type*} [Fintype i] [Fintype j]
    (A : Matrix i j K) (hA : A ≠ 0) : 0 < A.rank := by
  unfold Matrix.rank
  apply Module.finrank_pos_iff_exists_ne_zero.mpr
  have hex : ∃ a b, A a b ≠ 0 := by
    by_contra hn
    push Not at hn
    apply hA
    ext a b
    exact hn a b
  obtain ⟨a, b, hab⟩ := hex
  let y : LinearMap.range A.mulVecLin :=
    ⟨A.mulVec (Pi.single b 1), ⟨Pi.single b 1, rfl⟩⟩
  refine ⟨y, ?_⟩
  intro hy
  have he := congrFun (congrArg Subtype.val hy) a
  simp only [y, Matrix.mulVec_single_one] at he
  exact hab he
def flatGram
    {i j : Type*} [Fintype j] [StarRing K] (x : (i × j) → K) :
    selfAdjoint (Matrix i i K) :=
  gramHermitian (fun a b => x (a, b))
theorem sum_rankOneHermitian_eq_gram
    {i j : Type*} [Fintype j] [StarRing K] (x : j → (i → K)) :
    (∑ b, rankOneHermitian (x b)) = gramHermitian (fun a b => x b a) := by
  apply Subtype.ext
  change (selfAdjoint (Matrix i i K)).subtype (∑ b, rankOneHermitian (x b)) = _
  rw [map_sum]
  ext a c
  change (∑ b, (fun a c => x b a * star (x b c) : Matrix i i K)) a c =
    ∑ b, x b a * star (x b c)
  exact Matrix.sum_apply a c Finset.univ _
theorem finite_event_variation_bound
    {G : Type*} [Fintype G] (f : G → ℂ) (hf : ∑ y, f y = 0)
    (A : Finset G) :
    ‖∑ y ∈ A, f y‖ ≤ (∑ y, ‖f y‖) / 2 := by
  have he : (∑ y ∈ Aᶜ, f y) = -(∑ y ∈ A, f y) := by
    have hs := Finset.sum_compl_add_sum A f
    rw [hf] at hs
    exact eq_neg_of_add_eq_zero_left hs
  have hA := norm_sum_le A f
  have hC := norm_sum_le Aᶜ f
  rw [he, norm_neg] at hC
  have hs := Finset.sum_compl_add_sum A (fun y => ‖f y‖)
  linarith
theorem uniform_image_event_mass
    {V G : Type*} [Fintype V] [Fintype G] (P : V → G) (A : Finset G) :
    (∑ y ∈ A, uniformImageWeight P y) =
      ((Finset.univ.filter (fun x => P x ∈ A)).card : ℂ) / Fintype.card V := by
  have h := uniform_image_average P (fun y => if y ∈ A then 1 else 0)
  simpa [mul_ite, Finset.sum_ite] using h
theorem uniform_image_event_variation_bound
    {V G : Type*} [Fintype V] [Nonempty V] [Fintype G] [Nonempty G]
    (P : V → G) (A : Finset G) :
    ‖((Finset.univ.filter (fun x => P x ∈ A)).card : ℂ) / Fintype.card V -
      (A.card : ℂ) / Fintype.card G‖ ≤
      (∑ y, ‖uniformImageWeight P y - (Fintype.card G : ℂ)⁻¹‖) / 2 := by
  have h := finite_event_variation_bound
    (fun y => uniformImageWeight P y - (Fintype.card G : ℂ)⁻¹)
    (by simp [Finset.sum_sub_distrib, uniform_image_total]) A
  simpa [Finset.sum_sub_distrib, uniform_image_event_mass,
    nsmul_eq_mul, div_eq_mul_inv] using h
theorem uniform_image_event_probability_bound
    {V G : Type*} [Fintype V] [Nonempty V] [Fintype G] [Nonempty G]
    (P : V → G) (A : Finset G) :
    ((Finset.univ.filter (fun x => P x ∈ A)).card : ℝ) / Fintype.card V ≤
      (A.card : ℝ) / Fintype.card G +
        (∑ y, ‖uniformImageWeight P y - (Fintype.card G : ℂ)⁻¹‖) / 2 := by
  have he := uniform_image_event_variation_bound P A
  have hc :
      ((((Finset.univ.filter (fun x => P x ∈ A)).card : ℝ) / Fintype.card V -
        (A.card : ℝ) / Fintype.card G : ℝ) : ℂ) =
      ((Finset.univ.filter (fun x => P x ∈ A)).card : ℂ) / Fintype.card V -
        (A.card : ℂ) / Fintype.card G := by push_cast; rfl
  rw [← hc, Complex.norm_real, Real.norm_eq_abs] at he
  have hl := le_abs_self
    (((Finset.univ.filter (fun x => P x ∈ A)).card : ℝ) / Fintype.card V -
      (A.card : ℝ) / Fintype.card G)
  linarith
theorem card_selfAdjoint_scalar
    {F : Type*} [Field F] [Fintype F] [Fintype K] [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F) :
    Fintype.card (selfAdjoint K) = Fintype.card F := by
  let f : F → selfAdjoint K := fun a =>
    ⟨algebraMap F K a, by
      change star (algebraMap F K a) = algebraMap F K a
      rw [hstar, ← map_pow, Nat.card_eq_fintype_card, FiniteField.pow_card]⟩
  have hi : Function.Injective f := by
    intro a b h
    exact FaithfulSMul.algebraMap_injective F K (congrArg Subtype.val h)
  have hs : Function.Surjective f := by
    intro x
    obtain ⟨a, ha⟩ := fixed_scalar_descends hstar (x : K) x.property
    exact ⟨a, Subtype.ext ha⟩
  exact (Fintype.card_congr (Equiv.ofBijective f ⟨hi, hs⟩)).symm
def hermitianBorder {i : Type*} [StarRing K]
    (d : selfAdjoint K) (v : i → K) (A : selfAdjoint (Matrix i i K)) :
    selfAdjoint (Matrix (Option i) (Option i) K) :=
  ⟨fun a b => match a, b with
    | none, none => d
    | none, some b => v b
    | some a, none => star (v a)
    | some a, some b => (A : Matrix i i K) a b,
    Matrix.IsHermitian.ext (by
      intro a b
      cases a with
      | none =>
        cases b with
        | none => exact d.property
        | some b => exact star_star (v b)
      | some a =>
        cases b with
        | none => rfl
        | some b => exact (show (A : Matrix i i K).IsHermitian from A.property).apply a b)⟩
def hermitianBorderEquiv {i : Type*} [StarRing K] :
    selfAdjoint (Matrix (Option i) (Option i) K) ≃
      selfAdjoint K × (i → K) × selfAdjoint (Matrix i i K) where
  toFun A :=
    (⟨(A : Matrix (Option i) (Option i) K) none none,
      (show (A : Matrix (Option i) (Option i) K).IsHermitian from A.property).apply none none⟩,
      (fun b => (A : Matrix (Option i) (Option i) K) none (some b)),
      ⟨fun a b => (A : Matrix (Option i) (Option i) K) (some a) (some b),
        Matrix.IsHermitian.ext (fun a b =>
          (show (A : Matrix (Option i) (Option i) K).IsHermitian from A.property).apply
            (some a) (some b))⟩)
  invFun p := hermitianBorder p.1 p.2.1 p.2.2
  left_inv A := by
    apply Subtype.ext
    ext a b
    cases a with
    | none => cases b <;> rfl
    | some a =>
      cases b with
      | none =>
        exact (show (A : Matrix (Option i) (Option i) K).IsHermitian from A.property).apply
          (some a) none
      | some b => rfl
  right_inv p := by
    rcases p with ⟨d, v, A⟩
    rfl
def hermitianReindexEquiv {i j : Type*} [StarRing K] (e : i ≃ j) :
    selfAdjoint (Matrix i i K) ≃ selfAdjoint (Matrix j j K) where
  toFun A := ⟨fun a b => (A : Matrix i i K) (e.symm a) (e.symm b),
    Matrix.IsHermitian.ext (fun a b =>
      (show (A : Matrix i i K).IsHermitian from A.property).apply _ _)⟩
  invFun A := ⟨fun a b => (A : Matrix j j K) (e a) (e b),
    Matrix.IsHermitian.ext (fun a b =>
      (show (A : Matrix j j K).IsHermitian from A.property).apply _ _)⟩
  left_inv A := by apply Subtype.ext; ext a b; simp
  right_inv A := by apply Subtype.ext; ext a b; simp
theorem card_hermitian_fin
    {F : Type*} [Field F] [Fintype F] [Fintype K] [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F) (n : ℕ) :
    Fintype.card (selfAdjoint (Matrix (Fin n) (Fin n) K)) =
      Fintype.card F ^ (n ^ 2) := by
  have hK : Fintype.card K = Fintype.card F ^ 2 := by
    simpa only [Nat.card_eq_fintype_card] using hcard
  induction n with
  | zero =>
    let : Unique (selfAdjoint (Matrix (Fin 0) (Fin 0) K)) :=
      { default := 0, uniq := fun _ => Subsingleton.elim _ _ }
    simp [Fintype.card_unique]
  | succ n ih =>
    rw [Fintype.card_congr (hermitianReindexEquiv (K := K) (finSuccEquiv' (0 : Fin (n + 1)))),
      Fintype.card_congr (hermitianBorderEquiv (K := K) (i := Fin n))]
    simp only [Fintype.card_prod, Fintype.card_fun, Fintype.card_fin,
      card_selfAdjoint_scalar hstar, hK, ih]
    rw [← pow_mul, ← pow_add, ← pow_succ']
    congr 1
    ring
theorem card_hermitian
    {F i : Type*} [Field F] [Fintype F] [Fintype K] [Fintype i]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F) :
    Fintype.card (selfAdjoint (Matrix i i K)) =
      Fintype.card F ^ (Fintype.card i ^ 2) := by
  exact (Fintype.card_congr (hermitianReindexEquiv (K := K)
    (Fintype.equivFin i))).trans (card_hermitian_fin hcard hstar _)
def hyperplaneGram
    {i j h : Type*} [Fintype j] [Fintype h] [StarRing K]
    (e : (i × j) ≃ (h ⊕ Unit))
    (P : Matrix (h ⊕ Unit) (h ⊕ Unit) K) (x : h → K) :
    selfAdjoint (Matrix i i K) :=
  flatGram (fun ab => (P *ᵥ Sum.elim x (fun _ => 0)) (e ab))
def matrixReshapeLinearEquiv {i j a : Type*} (e : (i × j) ≃ a) :
    (a → K) ≃ₗ[K] Matrix i j K where
  toFun x := fun b c => x (e (b, c))
  invFun N := fun b => N (e.symm b).1 (e.symm b).2
  map_add' _ _ := rfl
  map_smul' _ _ := rfl
  left_inv x := by funext b; simp
  right_inv N := by ext b c; simp
noncomputable def matrixMulVecLinearEquiv
    {a : Type*} [Fintype a] [DecidableEq a] (P : Matrix a a K) (hP : P.det ≠ 0) :
    (a → K) ≃ₗ[K] (a → K) :=
  { P.mulVecLin with
    invFun := fun x => P⁻¹ *ᵥ x
    left_inv := fun x => by
      change P⁻¹ *ᵥ (P *ᵥ x) = x
      rw [Matrix.mulVec_mulVec, Matrix.nonsing_inv_mul P (isUnit_iff_ne_zero.mpr hP),
        Matrix.one_mulVec]
    right_inv := fun x => by
      change P *ᵥ (P⁻¹ *ᵥ x) = x
      rw [Matrix.mulVec_mulVec, Matrix.mul_nonsing_inv P (isUnit_iff_ne_zero.mpr hP),
        Matrix.one_mulVec] }
noncomputable def matrixBasisLinearEquiv
    {i j h : Type*} [Fintype h] [DecidableEq h] (e : (i × j) ≃ (h ⊕ Unit))
    (P : Matrix (h ⊕ Unit) (h ⊕ Unit) K) (hP : P.det ≠ 0) :
    ((h ⊕ Unit) → K) ≃ₗ[K] Matrix i j K :=
  (matrixMulVecLinearEquiv (K := K) P hP).trans (matrixReshapeLinearEquiv (K := K) e)
noncomputable def matrixHyperplaneFunctional
    {i j h : Type*} [Fintype h] [DecidableEq h] (e : (i × j) ≃ (h ⊕ Unit))
    (P : Matrix (h ⊕ Unit) (h ⊕ Unit) K) (hP : P.det ≠ 0) :
    Matrix i j K →ₗ[K] K :=
  (LinearMap.proj (Sum.inr ()) : ((h ⊕ Unit) → K) →ₗ[K] K).comp
    (matrixBasisLinearEquiv e P hP).symm.toLinearMap
noncomputable def hyperplaneMatrixEquiv
    {i j h : Type*} [Fintype h] [DecidableEq h] (e : (i × j) ≃ (h ⊕ Unit))
    (P : Matrix (h ⊕ Unit) (h ⊕ Unit) K) (hP : P.det ≠ 0) :
    (h → K) ≃ {N : Matrix i j K // matrixHyperplaneFunctional e P hP N = 0} where
  toFun x := ⟨matrixBasisLinearEquiv e P hP (Sum.elim x (fun _ => 0)), by
    simp [matrixHyperplaneFunctional]⟩
  invFun N := fun a => (matrixBasisLinearEquiv e P hP).symm N.val (Sum.inl a)
  left_inv x := by
    funext a
    simp
  right_inv N := by
    apply Subtype.ext
    apply (matrixBasisLinearEquiv e P hP).symm.injective
    simp only [LinearEquiv.symm_apply_apply]
    funext a
    cases a with
    | inl a => rfl
    | inr a =>
      cases a
      exact N.property.symm
theorem hyperplaneMatrixEquiv_gram
    {i j h : Type*} [Fintype j] [Fintype h] [DecidableEq h] [StarRing K]
    (e : (i × j) ≃ (h ⊕ Unit))
    (P : Matrix (h ⊕ Unit) (h ⊕ Unit) K) (hP : P.det ≠ 0) (x : h → K) :
    gramHermitian (hyperplaneMatrixEquiv e P hP x).val = hyperplaneGram e P x := rfl
noncomputable def canonicalUniv (V : Type*) [Finite V] : Finset V :=
  @Finset.univ V (Fintype.ofFinite V)
theorem univ_eq_canonical {V : Type*} [Fintype V] :
    (Finset.univ : Finset V) = canonicalUniv V := by
  change (Finset.univ : Finset V) = @Finset.univ V (Fintype.ofFinite V)
  ext x
  simp only [Finset.mem_univ]
theorem hermitian_exists_anisotropic
    {K : Type u} [Field K] {V : Type v} [AddCommGroup V] [Module K V]
    [Nontrivial V] (sigma : K ≃+* K)
    (B : V →ₛₗ[(sigma : K →+* K)] V →ₗ[K] K)
    (hB : B.IsSymm) (hsep : B.SeparatingLeft)
    (htrace : ∃ a : K, a + sigma a ≠ 0) :
    ∃ x : V, B x x ≠ 0 := by
  obtain ⟨u, hu⟩ := exists_ne (0 : V)
  have hnotall : ¬ ∀ w : V, B u w = 0 := fun h => hu (hsep u h)
  push Not at hnotall
  obtain ⟨w, hw⟩ := hnotall
  let z := (B u w)⁻¹ • w
  have huz : B u z = 1 := by simp [z, hw]
  have hzu : B z u = 1 := by rw [← hB.eq, huz, map_one]
  rcases htrace with ⟨a, ha⟩
  by_contra hall
  push Not at hall
  have hu0 := hall u
  have hz0 := hall z
  have hsum := hall (u + a • z)
  simp [map_add, map_smul, map_smulₛₗ, hu0, hz0, huz, hzu] at hsum
  exact ha (by simpa [add_comm] using hsum)
theorem hermitian_isCompl_span_singleton_orthogonal
    {K : Type u} [Field K] {V : Type v} [AddCommGroup V] [Module K V]
    (sigma : K ≃+* K)
    (B : V →ₛₗ[(sigma : K →+* K)] V →ₗ[K] K)
    {x : V} (hx : B x x ≠ 0) :
    IsCompl (K ∙ x) ((K ∙ x).orthogonalBilin B) := by
  refine
    { disjoint := disjoint_iff.2 <|
        LinearMap.span_singleton_inf_orthogonal_eq_bot B x hx
      codisjoint := codisjoint_iff.2 ?_ }
  rw [eq_top_iff]
  intro y _
  have hxx : B x x ≠ 0 := hx
  have hbase : B x (y + (-B x y / B x x) • x) = 0 := by
    rw [map_add, map_smul, smul_eq_mul, div_mul_cancel₀ _ hxx, add_neg_cancel]
  have hyorth :
      y + (-B x y / B x x) • x ∈
        (K ∙ x).orthogonalBilin B := by
    intro z hz
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hz
    rw [map_smulₛₗ]
    change sigma c * B x (y + (-B x y / B x x) • x) = 0
    rw [hbase, mul_zero]
  have hxspan :
      (B x y / B x x) • x ∈ (K ∙ x) :=
    Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self x)
  have hxspanSup :
      (B x y / B x x) • x ∈
        (K ∙ x) ⊔ (K ∙ x).orthogonalBilin B :=
    (show (K ∙ x) ≤
      (K ∙ x) ⊔ (K ∙ x).orthogonalBilin B from le_sup_left) hxspan
  have hyorthSup :
      y + (-B x y / B x x) • x ∈
        (K ∙ x) ⊔ (K ∙ x).orthogonalBilin B :=
    (show (K ∙ x).orthogonalBilin B ≤
      (K ∙ x) ⊔ (K ∙ x).orthogonalBilin B from le_sup_right) hyorth
  have hadd := Submodule.add_mem _ hxspanSup hyorthSup
  simpa [neg_div, add_comm, add_left_comm, add_assoc] using hadd
theorem hermitian_orthogonal_restrict_separatingLeft
    {K : Type u} [Field K] {V : Type v} [AddCommGroup V] [Module K V]
    (sigma : K ≃+* K)
    (B : V →ₛₗ[(sigma : K →+* K)] V →ₗ[K] K)
    (hB : B.IsSymm) (hsep : B.SeparatingLeft)
    {x : V} (hx : B x x ≠ 0) :
    (B.domRestrict₁₂
      ((K ∙ x).orthogonalBilin B)
      ((K ∙ x).orthogonalBilin B)).SeparatingLeft := by
  let N := (K ∙ x).orthogonalBilin B
  intro z hz
  apply Subtype.ext
  apply hsep z.1
  intro y
  have hxx : B x x ≠ 0 := hx
  have hybase : B x (y + (-B x y / B x x) • x) = 0 := by
    rw [map_add, map_smul, smul_eq_mul, div_mul_cancel₀ _ hxx, add_neg_cancel]
  have hyN : y + (-B x y / B x x) • x ∈ N := by
    intro z hz
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hz
    rw [map_smulₛₗ]
    change sigma c * B x (y + (-B x y / B x x) • x) = 0
    rw [hybase, mul_zero]
  let y0 : N := ⟨y + (-B x y / B x x) • x, hyN⟩
  have hxz : B x z.1 = 0 :=
    z.2 x (Submodule.mem_span_singleton_self x)
  have hzx : B z.1 x = 0 := hB.isRefl.eq_zero hxz
  have hzy0 : B z.1 y0.1 = 0 := by
    simpa [N, y0, LinearMap.domRestrict₁₂_apply] using hz y0
  have hydecomp : y = (B x y / B x x) • x + y0.1 := by
    simp [y0, neg_div, add_left_comm]
  rw [hydecomp, map_add, map_smul, smul_eq_mul, hzx, hzy0, mul_zero, zero_add]
theorem hermitian_exists_orthogonal_basis
    {K : Type u} [Field K] {V : Type v} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] (sigma : K ≃+* K)
    (B : V →ₛₗ[(sigma : K →+* K)] V →ₗ[K] K)
    (hB : B.IsSymm) (hsep : B.SeparatingLeft)
    (htrace : ∃ a : K, a + sigma a ≠ 0)
    (d : ℕ) (hd : Module.finrank K V = d) :
    ∃ b : Module.Basis (Fin d) K V, B.IsOrthoᵢ b := by
  induction d generalizing V with
  | zero =>
      exact ⟨basisOfFinrankZero hd, fun _ _ _ => map_zero _⟩
  | succ d ih =>
      let : Nontrivial V := Module.nontrivial_of_finrank_eq_succ hd
      obtain ⟨x, hx⟩ := hermitian_exists_anisotropic sigma B hB hsep htrace
      let N := (K ∙ x).orthogonalBilin B
      have hcompl : IsCompl (K ∙ x) N :=
        hermitian_isCompl_span_singleton_orthogonal sigma B hx
      rw [← Submodule.finrank_add_eq_of_isCompl hcompl.symm,
        finrank_span_singleton (ne_zero_of_map hx)] at hd
      let B' := B.domRestrict₁₂ N N
      have hB' : B'.IsSymm := hB.domRestrict N
      have hsep' : B'.SeparatingLeft :=
        hermitian_orthogonal_restrict_separatingLeft sigma B hB hsep hx
      obtain ⟨b', hb'⟩ := ih B' hB' hsep' (Nat.succ.inj hd)
      let b :=
        Module.Basis.mkFinCons x b'
          (by
            rintro c y hy hc
            rw [add_eq_zero_iff_neg_eq] at hc
            rw [← hc, Submodule.neg_mem_iff] at hy
            have hdisj := hcompl.disjoint
            rw [Submodule.disjoint_def] at hdisj
            have hzero := hdisj (c • x)
              (Submodule.smul_mem _ _ <| Submodule.mem_span_singleton_self _) hy
            exact (smul_eq_zero.1 hzero).resolve_right
              (fun h => hx <| h.symm ▸ map_zero _))
          (by
            intro y
            refine ⟨-B x y / B x x, ?_⟩
            intro z hz
            obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.1 hz
            have hxx : B x x ≠ 0 := hx
            rw [map_smulₛₗ]
            change sigma c * B x (y + (-B x y / B x x) • x) = 0
            rw [map_add, map_smul, smul_eq_mul, div_mul_cancel₀ _ hxx,
              add_neg_cancel, mul_zero])
      refine ⟨b, ?_⟩
      rw [Module.Basis.coe_mkFinCons]
      intro j i
      refine Fin.cases ?_ (fun i => ?_) i <;>
        refine Fin.cases ?_ (fun j => ?_) j <;> intro hij <;>
        simp only [Function.onFun, Fin.cons_zero, Fin.cons_succ, Function.comp_apply]
      · exact (hij rfl).elim
      · rw [← hB.eq]
        have hxo : B x (b' j) = 0 :=
          (b' j).prop _ (Submodule.mem_span_singleton_self x)
        rw [hxo, map_zero]
      · exact (b' i).prop _ (Submodule.mem_span_singleton_self x)
      · exact hb' (ne_of_apply_ne _ hij)
theorem finite_field_trace_nonzero
    {F : Type*} [Field F] [Fintype F] [Finite K] [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F) :
    ∃ a : K, a + star a ≠ 0 := by
  by_contra h
  push Not at h
  apply one_ne_zero (α := K)
  apply (traceForm_nondegenerate F K).1 1
  intro y
  apply (algebraMap F K).injective
  rw [Algebra.traceForm_apply, one_mul, quadratic_trace hcard hstar, map_zero]
  exact h y
theorem hermitian_scalar_normalizer
    {F : Type*} [Field F] [Fintype F] [Finite K] [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (x : K) (hx : x ≠ 0) (hs : star x = x) :
    ∃ a : Kˣ, star (a : K) * (a : K) * x = 1 := by
  obtain ⟨d, hd⟩ := fixed_scalar_descends hstar x hs
  have hd0 : d ≠ 0 := by
    intro hz
    apply hx
    rw [← hd, hz, map_zero]
  obtain ⟨a, ha⟩ := FiniteField.norm_surjective F K d⁻¹
  have hn : star a * a * x = 1 := by
    rw [← hd, ← quadratic_norm hcard hstar, ha, ← map_mul, inv_mul_cancel₀ hd0, map_one]
  have ha0 : a ≠ 0 := by
    intro hz
    simp [hz] at hn
  exact ⟨Units.mk0 a ha0, hn⟩
theorem hermitian_exists_orthonormal_basis
    {F V : Type*} [Field F] [Fintype F] [Finite K] [Algebra F K] [StarRing K]
    [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (B : V →ₛₗ[starRingEnd K] V →ₗ[K] K)
    (hB : B.IsSymm) (hsep : B.SeparatingLeft) :
    ∃ b : Module.Basis (Fin (Module.finrank K V)) K V,
      ∀ i j, B (b i) (b j) = if i = j then 1 else 0 := by
  classical
  obtain ⟨b, hb⟩ := hermitian_exists_orthogonal_basis (starRingAut : K ≃+* K) B hB hsep
    (finite_field_trace_nonzero hcard hstar) (Module.finrank K V) rfl
  have hs (i : Fin (Module.finrank K V)) : star (B (b i) (b i)) = B (b i) (b i) :=
    hB.eq (b i) (b i)
  have hn (i : Fin (Module.finrank K V)) :
      ∃ a : Kˣ, star (a : K) * (a : K) * B (b i) (b i) = 1 :=
    hermitian_scalar_normalizer hcard hstar _ (hb.not_isOrtho_basis_self_of_separatingLeft hsep i) (hs i)
  choose a ha using hn
  refine ⟨b.unitsSMul a, ?_⟩
  intro i j
  simp only [Module.Basis.unitsSMul_apply, Units.smul_def, map_smul, map_smulₛₗ, LinearMap.smul_apply, smul_eq_mul]
  change (a j : K) * (star (a i : K) * B (b i) (b j)) = if i = j then 1 else 0
  by_cases hij : i = j
  · subst j
    simpa [mul_assoc, mul_left_comm] using ha i
  · have hz : B (b i) (b j) = 0 := hb hij
    rw [if_neg hij, hz, mul_zero, mul_zero]
theorem orthonormal_basis_coordinates
    {V ι : Type*} [StarRing K] [AddCommGroup V] [Module K V] [Fintype ι] [DecidableEq ι]
    (B : V →ₛₗ[starRingEnd K] V →ₗ[K] K) (b : Module.Basis ι K V)
    (hb : ∀ i j, B (b i) (b j) = if i = j then 1 else 0) (x y : ι → K) :
    B (b.equivFun.symm x) (b.equivFun.symm y) = ∑ i, star (x i) * y i := by
  classical
  simp only [Module.Basis.equivFun_symm_apply, map_sum, map_smul, map_smulₛₗ, LinearMap.sum_apply, LinearMap.smul_apply, smul_eq_mul]
  simp [hb, mul_comm, starRingEnd_apply]
noncomputable def hermitianCongruenceEquiv
    {ι : Type*} [Fintype ι] [DecidableEq ι] [StarRing K]
    (P : Matrix ι ι K) (hP : P.det ≠ 0) :
    selfAdjoint (Matrix ι ι K) ≃ selfAdjoint (Matrix ι ι K) where
  toFun A := ⟨Pᴴ * A.val * P, Matrix.isHermitian_conjTranspose_mul_mul P A.property⟩
  invFun A := ⟨(P⁻¹)ᴴ * A.val * P⁻¹,
    Matrix.isHermitian_conjTranspose_mul_mul P⁻¹ A.property⟩
  left_inv A := by
    apply Subtype.ext
    change (P⁻¹)ᴴ * (Pᴴ * A.val * P) * P⁻¹ = A.val
    calc
      _ = (P * P⁻¹)ᴴ * A.val * (P * P⁻¹) := by
        rw [Matrix.conjTranspose_mul]
        simp only [Matrix.mul_assoc]
      _ = A.val := by
        rw [Matrix.mul_nonsing_inv P (isUnit_iff_ne_zero.mpr hP)]
        simp
  right_inv A := by
    apply Subtype.ext
    change Pᴴ * ((P⁻¹)ᴴ * A.val * P⁻¹) * P = A.val
    calc
      _ = (P⁻¹ * P)ᴴ * A.val * (P⁻¹ * P) := by
        rw [Matrix.conjTranspose_mul]
        simp only [Matrix.mul_assoc]
      _ = A.val := by
        rw [Matrix.nonsing_inv_mul P (isUnit_iff_ne_zero.mpr hP)]
        simp
theorem det_identity_updateCol
    {ι : Type*} [Fintype ι] [DecidableEq ι] (v : ι → K) (k : ι) :
    ((1 : Matrix ι ι K).updateCol k v).det = v k := by
  simpa [smul_eq_mul, Matrix.one_apply, mul_ite] using Matrix.det_updateCol_sum (1 : Matrix ι ι K) k v
noncomputable def hermitianKernelColumnEquiv
    {ι : Type*} [Fintype ι] [DecidableEq ι] [StarRing K]
    (v : ι → K) (k : ι) (hk : v k ≠ 0) :
    {A : selfAdjoint (Matrix ι ι K) // A.val *ᵥ v = 0} ≃
      {A : selfAdjoint (Matrix ι ι K) // ∀ j, A.val j k = 0} := by
  let P := (1 : Matrix ι ι K).updateCol k v
  have hP : P.det ≠ 0 := by simpa only [P, det_identity_updateCol] using hk
  have hi : Function.Injective (Matrix.mulVec Pᴴ) :=
    Matrix.mulVec_injective_iff_isUnit.mpr ((Matrix.isUnit_iff_isUnit_det _).mpr
      (isUnit_iff_ne_zero.mpr (by simpa only [Matrix.det_conjTranspose, star_ne_zero] using hP)))
  refine (hermitianCongruenceEquiv P hP).subtypeEquiv ?_
  intro A
  have hpv : P *ᵥ Pi.single k 1 = v := by
    ext j
    simp [P, Matrix.mulVec_single]
  have he : (Pᴴ * A.val * P) *ᵥ Pi.single k 1 = Pᴴ *ᵥ (A.val *ᵥ v) := by
    rw [← Matrix.mulVec_mulVec, hpv, ← Matrix.mulVec_mulVec]
  have hz : (Pᴴ * A.val * P) *ᵥ Pi.single k 1 = 0 ↔ A.val *ᵥ v = 0 := by
    rw [he]
    constructor
    · intro h
      apply hi
      simpa only [Matrix.mulVec_zero] using h
    · intro h
      rw [h, Matrix.mulVec_zero]
  change A.val *ᵥ v = 0 ↔ ∀ j, (Pᴴ * A.val * P) j k = 0
  rw [← hz]
  simp [Matrix.mulVec_single, funext_iff]
def hermitianZeroColumnEquiv {ι : Type*} [StarRing K] :
    selfAdjoint (Matrix ι ι K) ≃
      {A : selfAdjoint (Matrix (Option ι) (Option ι) K) // ∀ j, A.val j none = 0} where
  toFun A := ⟨hermitianBorder 0 0 A, by intro j; cases j <;> simp [hermitianBorder]⟩
  invFun A := (hermitianBorderEquiv A.val).2.2
  left_inv A := rfl
  right_inv A := by
    apply Subtype.ext
    apply Subtype.ext
    ext j k
    cases j with
    | none =>
      cases k with
      | none =>
        change 0 = A.val.val none none
        exact (A.property none).symm
      | some k =>
        change 0 = A.val.val none (some k)
        have h := (show A.val.val.IsHermitian from A.val.property).apply none (some k)
        simpa only [A.property (some k), star_zero] using h
    | some j =>
      cases k with
      | none =>
        change star (0 : K) = A.val.val (some j) none
        rw [star_zero]
        exact (A.property (some j)).symm
      | some k => rfl
noncomputable def hermitianZeroColumnSwapEquiv
    {ι : Type*} [DecidableEq ι] [StarRing K] (k l : ι) :
    {A : selfAdjoint (Matrix ι ι K) // ∀ j, A.val j k = 0} ≃
      {A : selfAdjoint (Matrix ι ι K) // ∀ j, A.val j l = 0} := by
  let e := Equiv.swap k l
  refine (hermitianReindexEquiv (K := K) e).subtypeEquiv ?_
  intro A
  change (∀ j, A.val j k = 0) ↔ ∀ j, A.val (e.symm j) (e.symm l) = 0
  have hl : e.symm l = k := by simp [e]
  rw [hl]
  exact e.symm.surjective.forall
theorem card_hermitian_annihilator
    {F ι : Type*} [Field F] [Fintype F] [Fintype K] [Fintype ι]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (v : Option ι → K) (hv : v ≠ 0) :
    Nat.card {A : selfAdjoint (Matrix (Option ι) (Option ι) K) // A.val *ᵥ v = 0} =
      Nat.card F ^ (Fintype.card ι ^ 2) := by
  classical
  obtain ⟨k, hk⟩ : ∃ k, v k ≠ 0 := by
    by_contra h
    push Not at h
    exact hv (funext h)
  let e := (hermitianKernelColumnEquiv v k hk).trans
    ((hermitianZeroColumnSwapEquiv (K := K) k none).trans hermitianZeroColumnEquiv.symm)
  rw [Nat.card_congr e]
  simpa only [Nat.card_eq_fintype_card] using card_hermitian (i := ι) hcard hstar
theorem singular_nonzero_kernel_count
    {ι : Type*} [Fintype ι] [DecidableEq ι] [Fintype K]
    (A : Matrix ι ι K) (hA : A.det = 0) :
    Fintype.card K - 1 ≤
      (Finset.univ.filter (fun v : {v : ι → K // v ≠ 0} => A *ᵥ v.val = 0)).card := by
  classical
  have hi : ¬ Function.Injective (Matrix.mulVec A) := by
    intro h
    have hu := Matrix.mulVec_injective_iff_isUnit.mp h
    have hd := (Matrix.isUnit_iff_isUnit_det A).mp hu
    exact (isUnit_iff_ne_zero.mp hd) hA
  obtain ⟨v, hv, hk⟩ : ∃ v : ι → K, v ≠ 0 ∧ A *ᵥ v = 0 := by
    by_contra h
    push Not at h
    apply hi
    intro x y hxy
    apply sub_eq_zero.mp
    by_contra hne
    exact h (x-y) hne (by rw [Matrix.mulVec_sub, hxy, sub_self])
  let f : Kˣ → {w : {w : ι → K // w ≠ 0} // A *ᵥ w.val = 0} :=
    fun c => ⟨⟨(c : K) • v, smul_ne_zero c.ne_zero hv⟩,
      by rw [Matrix.mulVec_smul, hk, smul_zero]⟩
  have hf : Function.Injective f := by
    intro a b hab
    apply Units.ext
    exact smul_left_injective K hv (congrArg (fun w => w.val.val) hab)
  have hc := Fintype.card_le_of_injective f hf
  simpa only [Fintype.card_units, Fintype.card_subtype] using hc
theorem hermitian_kernel_incidence_count
    {F ι : Type*} [Field F] [Fintype F] [Fintype K] [Fintype ι]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F) :
    (∑ A : selfAdjoint (Matrix (Option ι) (Option ι) K),
      (Finset.univ.filter (fun v : {v : Option ι → K // v ≠ 0} =>
        A.val *ᵥ v.val = 0)).card) =
      Fintype.card {v : Option ι → K // v ≠ 0} *
        Fintype.card F ^ (Fintype.card ι ^ 2) := by
  classical
  calc
    _ = ∑ v : {v : Option ι → K // v ≠ 0},
        (Finset.univ.filter (fun A : selfAdjoint (Matrix (Option ι) (Option ι) K) =>
          A.val *ᵥ v.val = 0)).card := by
      simp only [Finset.card_eq_sum_ones, Finset.sum_filter]
      exact Finset.sum_comm
    _ = _ := by
      have hc (v : {v : Option ι → K // v ≠ 0}) :
          (Finset.univ.filter (fun A : selfAdjoint (Matrix (Option ι) (Option ι) K) =>
            A.val *ᵥ v.val = 0)).card = Fintype.card F ^ (Fintype.card ι ^ 2) := by
        have h := card_hermitian_annihilator hcard hstar v.val v.property
        simpa only [Nat.card_eq_fintype_card, Fintype.card_subtype] using h
      simp only [hc, Finset.sum_const, Finset.card_univ, smul_eq_mul]
theorem hermitian_singular_count_bound
    {F ι : Type*} [Field F] [Fintype F] [Fintype K] [Fintype ι]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F) :
    (Finset.univ.filter (fun A : selfAdjoint (Matrix (Option ι) (Option ι) K) =>
      A.val.det = 0)).card * (Fintype.card F ^ 2 - 1) ≤
        Fintype.card F ^ ((Fintype.card ι + 1) ^ 2) * Fintype.card F := by
  classical
  let H := selfAdjoint (Matrix (Option ι) (Option ι) K)
  let S := Finset.univ.filter (fun A : H => A.val.det = 0)
  let c := fun A : H => (Finset.univ.filter
    (fun v : {v : Option ι → K // v ≠ 0} => A.val *ᵥ v.val = 0)).card
  have hk : Fintype.card K = Fintype.card F ^ 2 := by
    simpa only [Nat.card_eq_fintype_card] using hcard
  have hl : S.card * (Fintype.card K - 1) ≤ ∑ A : H, c A := by
    calc
      _ = ∑ _A ∈ S, (Fintype.card K - 1) := by simp
      _ ≤ ∑ A ∈ S, c A := Finset.sum_le_sum (by
        intro A hA
        exact singular_nonzero_kernel_count A.val (Finset.mem_filter.mp hA).2)
      _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg
        (Finset.filter_subset _ _) (by intros; exact Nat.zero_le _)
  have hc := hermitian_kernel_incidence_count (ι := ι) hcard hstar
  have hn : Fintype.card {v : Option ι → K // v ≠ 0} ≤
      Fintype.card (Option ι → K) :=
    Fintype.card_le_of_injective Subtype.val Subtype.val_injective
  have hu := hl.trans ((le_of_eq hc).trans
    (Nat.mul_le_mul_right (Fintype.card F ^ (Fintype.card ι ^ 2)) hn))
  rw [hk] at hu
  have he : Fintype.card (Option ι → K) * Fintype.card F ^ (Fintype.card ι ^ 2) =
      Fintype.card F ^ ((Fintype.card ι + 1) ^ 2) * Fintype.card F := by
    rw [Fintype.card_fun, Fintype.card_option, hk, ← pow_mul, ← pow_add,
      ← pow_succ]
    congr 1
    ring
  exact hu.trans_eq he
theorem hermitian_nonsingular_fraction_lower_bound
    {F ι : Type*} [Field F] [Fintype F] [Fintype K] [Fintype ι]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F) :
    (1 / 3 : ℝ) ≤
      ((Finset.univ.filter (fun A : selfAdjoint (Matrix (Option ι) (Option ι) K) =>
        A.val.det ≠ 0)).card : ℝ) /
          Fintype.card (selfAdjoint (Matrix (Option ι) (Option ι) K)) := by
  classical
  let H := selfAdjoint (Matrix (Option ι) (Option ι) K)
  let S := (Finset.univ.filter (fun A : H => A.val.det = 0)).card
  let G := (Finset.univ.filter (fun A : H => A.val.det ≠ 0)).card
  let q := Fintype.card F
  let N := Fintype.card H
  have hN : N = q ^ ((Fintype.card ι + 1) ^ 2) := by
    simpa only [N, H, q, ← Nat.card_eq_fintype_card, Finite.card_option] using
      card_hermitian (i := Option ι) hcard hstar
  have hc : S * (q ^ 2 - 1) ≤ N * q := by
    rw [hN]
    exact hermitian_singular_count_bound (ι := ι) hcard hstar
  have hq : 2 ≤ q := Fintype.one_lt_card
  have hq2 : 1 ≤ q ^ 2 := by nlinarith
  have hd : q ^ 2 - 1 + 1 = q ^ 2 := Nat.sub_add_cancel hq2
  have hfactor : 3 * q ≤ 2 * (q ^ 2 - 1) := by nlinarith
  have hmul := Nat.mul_le_mul_left S hfactor
  have htwice := Nat.mul_le_mul_left 2 hc
  have hsing : 3 * S ≤ 2 * N := by
    nlinarith
  have hpartition : S + G = N := by
    exact Finset.card_filter_add_card_filter_not (fun A : H => A.val.det = 0)
  have hgood : N ≤ 3 * G := by omega
  have hpos : (0 : ℝ) < N := by exact_mod_cast Fintype.card_pos
  change (1 / 3 : ℝ) ≤ (G : ℝ) / N
  apply (le_div_iff₀ hpos).mpr
  have hr : (N : ℝ) ≤ 3 * (G : ℝ) := by exact_mod_cast hgood
  linarith
