def hyperbolicPairStrict {n : ℕ} (x : (Fin n → K) × (Fin n → K)) :
    StrictPair n → K :=
  fun p => x.1 p.1.1 * x.2 p.1.2 + x.1 p.1.2 * x.2 p.1.1
noncomputable def strictPairFunctional {n : ℕ} (z : StrictPair n → K) :
    (StrictPair n → K) →ₗ[K] K where
  toFun A := ∑ p, z p * A p
  map_add' A B := by simp [mul_add, Finset.sum_add_distrib]
  map_smul' c A := by
    change (∑ p, z p * (c * A p)) = c * ∑ p, z p * A p
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro p _
    ring
noncomputable def strictPairCharacter {n : ℕ} (ψ : AddChar K ℂ)
