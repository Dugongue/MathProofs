theorem spanInner_run [DecidableEq K] {B n d sb : Nat} (ν : Env) (MX : Matrix (Fin d) (Fin n) K)
    (hb : Base F canonical B ν)
    (hn : ν.vars nR = n) (hd : ν.vars dR = d) (he : ν.vars eR = F.e) (hsb : ν.vars sbR = sb)
    (hmod0 : ν.vars canonical.modBase = 0)
    (hlen : F.e + 1 + F.e*spanSlots n d ≤ (ν.arrs canonical.mem).length)
    (hW : SpanWords B n d F.e sb)
    (hMlen : sb + F.e*(d + n*d) ≤ (ν.arrs spanMem).length)
    (hMcan : ∀ k < F.e*(d+n*d), (ν.arrs spanMem).getD (sb+k) 0 < F.p)
    (hone : ∀ t < d, decode F (fun i => (ν.arrs spanMem).getD (sb + F.e*t + i.val) 0) = 1)
    (hxt : ∀ u (hu : u < n) (t : Fin d),
      decode F (fun i => (ν.arrs spanMem).getD (sb + F.e*(d + u*d + t.val) + i.val) 0) =
