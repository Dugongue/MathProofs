  letI : Field (S ⧸ q) := Ideal.Quotient.field q
  letI : Algebra E S := (constantsToOrder k A E L).toAlgebra
  letI : IsScalarTower k E S := IsScalarTower.of_algebraMap_eq fun c => by
    apply Subtype.ext
    exact IsScalarTower.algebraMap_apply k E L c
  letI : IsScalarTower k (A ⧸ p) (S ⧸ q) := IsScalarTower.of_algebraMap_eq fun c => by
    change Ideal.Quotient.mk q (algebraMap k S c) =
      Ideal.Quotient.mk q (algebraMap A S (algebraMap k A c))
    rw [← IsScalarTower.algebraMap_apply k A S]
  apply constants_residue_surjective k A E L (Ideal.Quotient.mk q)
