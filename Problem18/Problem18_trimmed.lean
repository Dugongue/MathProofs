variable {K : Type} [Field K] [Fintype K]
theorem restoreNativeInvariants (F : FieldPresentation K)
    {B S : Nat} {WS : String} {sigma tau : Env}
    (hv : ValidMemory F B sigma) (hs : Slots F canonical WS S B sigma)
    (hmem : tau.arrs canonical.mem=sigma.arrs canonical.mem)
    (hscratchWord : (tau.arrs canonical.scratch).length<B)
    (hscratchFit : 16*(F.e+1)≤(tau.arrs canonical.scratch).length)
    (he : tau.vars canonical.e=sigma.vars canonical.e)
    (hp : tau.vars canonical.p=sigma.vars canonical.p)
    (hmod : tau.vars canonical.modBase=sigma.vars canonical.modBase)
    (hws : tau.vars WS=sigma.vars WS)
    (hexp : tau.vars canonical.exp<B) :
    ValidMemory F B tau ∧ Slots F canonical WS S B tau := by
  have hvalid : ValidMemory F B tau := {
    degree:=he.trans hv.degree
    prime:=hp.trans hv.prime
    arithmetic_word:=hv.arithmetic_word
    inverse_word:=hv.inverse_word
    memory_word:=by rw [hmem];exact hv.memory_word
    scratch_word:=hscratchWord
    scratch_fit:=by omega
    modulus_fit:=by rw [hmod,hmem];exact hv.modulus_fit
    modulus_value:=by
      intro i
      unfold Problem18IMPFieldMultiplication20261001.sourceCoeff
      rw [hmod,hmem]
      exact hv.modulus_value i
    coefficients:=by
      intro j hj
      rw [hmem] at hj ⊢
      exact hv.coefficients j hj }
  have hbase : Base F canonical B tau := {
    names:=hs.base.names
    degree:=he.trans hs.base.degree
    prime:=hp.trans hs.base.prime
    arithmetic_word:=hs.base.arithmetic_word
    inverse_word:=hs.base.inverse_word
    memory_word:=by rw [hmem];exact hs.base.memory_word
    scratch_word:=hscratchWord
    scratch_fit:=hscratchFit
    modulus_fit:=by rw [hmod,hmem];exact hs.base.modulus_fit
    modulus_value:=by
      intro i
      rw [hmod,hmem]
      exact hs.base.modulus_value i
    exp_word:=hexp
    priv:=hs.base.priv }
  have hslots : Slots F canonical WS S B tau := {
    base:=hbase
    ws_reg:=hs.ws_reg
    fit:=by rw [hws,hmem];exact hs.fit
    modulus_apart:=by rw [hmod,hws];exact hs.modulus_apart
    canon:=by
      intro s hss
      unfold Problem18IMPFieldPresentation20261001.Canonical
      intro i
      unfold Problem18IMPFieldPresentation20261001.slice
      rw [hws,hmem]
      exact hs.canon s hss i
    slots_word:=hs.slots_word }
  exact ⟨hvalid,hslots⟩
end Mathproof.Problem18P36BoundaryRoutedController20261003
