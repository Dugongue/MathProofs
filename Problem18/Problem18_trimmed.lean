open Problem18MarkedRecovery20260929 Problem18CharTwoMarkedWitt20260929
variable {K : Type*} [Field K] [Fintype K] [CharP K 2]
attribute [local instance] starRingOfComm
theorem standardMarker_eq_one (n : ℕ) : standardMarker (K := K) n=fun _ => 1 := by
  funext i
  have ht : (2:K)=0 := CharP.cast_eq_zero K 2
  simp only [standardMarker,recoveryMarker,dif_pos ht]
  apply CharTwo.sq_injective
  have h := canonicalVector_diagonal (standardForm (K := K) n)
    (standardForm_nondegenerate n) (standardForm_symm n) (Pi.single i 1)
  simpa [standardForm,Matrix.toBilin'_apply'] using h.symm
theorem augmented_unit_column_kernel {n : ℕ}
    (v : UnitSphere (K := K) (n+1)) (hv : v.val≠fun _ => 1) :
    LinearMap.ker (augment (Matrix.toLin' (fun i (_ : Fin 1) => v.val i))
      (fun _ => (1:K)))=⊥ := by
  have hnorm : (∑ i,v.val i*v.val i)=1 := by
    exact v.property
  have hsum : (∑ i,v.val i)=1 :=
    (Problem18CharTwoSphereCard20260930.unit_iff_sum_eq_one v.val).mp
      (by simpa only [pow_two] using hnorm)
  apply LinearMap.ker_eq_bot'.mpr
  intro z hz
  have hi (i : Fin (n+1)) : v.val i*z.1 0+z.2=0 := by
    have h := congrFun hz i
    change (∑ j : Fin 1,v.val i*z.1 j)+z.2*1=0 at h
    simpa only [Fin.sum_univ_one,mul_one] using h
  have ha : z.1 0=0 := by
    by_contra ha
    have hvconst (i : Fin (n+1)) : v.val i= -z.2/z.1 0 :=
      (eq_div_iff ha).mpr (eq_neg_of_add_eq_zero_left (hi i))
    have he : (∑ i,v.val i*v.val i)=(-z.2/z.1 0)*(∑ i,v.val i) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [hvconst i]
    rw [hsum,mul_one] at he
    have hscalar : -z.2/z.1 0=1 := he.symm.trans hnorm
    apply hv
    funext i
    exact (hvconst i).trans hscalar
  have hb : z.2=0 := by simpa only [ha,mul_zero,zero_add] using hi 0
  apply Prod.ext
  · funext j
    have hj : j=0 := Subsingleton.elim _ _
    change z.1 j=0
    rw [hj]
    exact ha
  · exact hb
theorem firstVector_ne_one (n : ℕ) :
    (firstVector (K := K) (n+1)).val≠fun _ => 1 := by
  intro h
  have hh := congrFun h (Fin.succ (0 : Fin (n+1)))
  simpa [firstVector] using hh
theorem orthogonalColumn_surjective_charTwo (n : ℕ)
    (v : UnitSphere (K := K) (n+2)) (hv : v.val≠fun _ => 1) :
    ∃ U : Matrix.orthogonalGroup (Fin (n+2)) K,unitaryColumn U=v := by
  let C : Matrix (Fin (n+2)) (Fin 1) K := fun i _ => (firstVector (K := K) (n+1)).val i
  let D : Matrix (Fin (n+2)) (Fin 1) K := fun i _ => v.val i
  have hk : LinearMap.ker (augment C.toLin' (standardMarker (n+2)))=
      LinearMap.ker (augment D.toLin' (standardMarker (n+2))) := by
    rw [standardMarker_eq_one,augmented_unit_column_kernel _ (firstVector_ne_one n),
      augmented_unit_column_kernel _ hv]
  have hg : C.transpose*C=D.transpose*D := by
    ext i j
    change (firstVector (K := K) (n+1)).val ⬝ᵥ (firstVector (n+1)).val=v.val ⬝ᵥ v.val
    have hc := (firstVector (K := K) (n+1)).property
    have hd := v.property
    exact hc.trans hd.symm
  obtain ⟨U,hU,hUD⟩ := (final_orthogonal_factor_iff C D).mpr ⟨hk,hg⟩
  refine ⟨⟨U,Matrix.mem_unitaryGroup_iff'.mpr hU⟩,?_⟩
  apply Subtype.ext
  funext i
  have h := congrFun (congrFun hUD i) 0
  change (∑ k,U i k*(firstVector (K := K) (n+1)).val k)=v.val i at h
  simpa [unitaryColumn,firstVector,Fin.sum_univ_succ] using h
theorem orthogonal_fixes_one {n : ℕ} (U : Matrix.orthogonalGroup (Fin n) K) :
    U.val *ᵥ (fun _ => 1)=fun _ => 1 := by
  let Q := orthogonalEquiv U.val (Matrix.mem_unitaryGroup_iff'.mp U.property)
  refine isometry_fixes_marker (standardForm n) (standardForm_nondegenerate n)
    (fun _ => (1:K)) ?_ Q ?_
  · intro x
    have h := canonicalVector_diagonal (standardForm (K := K) n)
      (standardForm_nondegenerate n) (standardForm_symm n) x
    have ht : (2:K)=0 := CharP.cast_eq_zero K 2
    have hm := standardMarker_eq_one (K := K) n
    simp only [standardMarker,recoveryMarker,dif_pos ht] at hm
    rwa [hm] at h
  · exact orthogonalEquiv_preserves U.val (Matrix.mem_unitaryGroup_iff'.mp U.property)
theorem orthogonalColumn_ne_one (n : ℕ)
    (U : Matrix.orthogonalGroup (Fin (n+2)) K) :
    (unitaryColumn U).val≠fun _ => 1 := by
  intro h
  have he : U.val *ᵥ (firstVector (K := K) (n+1)).val=U.val *ᵥ (fun _ => 1) := by
    rw [orthogonal_fixes_one]
    have hcol : U.val *ᵥ (firstVector (K := K) (n+1)).val=(unitaryColumn U).val := by
      funext i
      simp [mulVec,dotProduct,firstVector,unitaryColumn,Fin.sum_univ_succ]
    exact hcol.trans h
  exact firstVector_ne_one n
    ((orthogonalEquiv U.val (Matrix.mem_unitaryGroup_iff'.mp U.property)).injective he)
abbrev NoncanonicalSphere (n : ℕ) :=
  {v : UnitSphere (K := K) n // v.val≠fun _ => 1}
noncomputable def noncanonicalColumn {n : ℕ}
    (U : Matrix.orthogonalGroup (Fin (n+2)) K) : NoncanonicalSphere (K := K) (n+2) :=
  ⟨unitaryColumn U,orthogonalColumn_ne_one n U⟩
noncomputable def noncanonicalColumnFiberEquiv (n : ℕ)
    (v : NoncanonicalSphere (K := K) (n+2)) :
    {U : Matrix.orthogonalGroup (Fin (n+2)) K // noncanonicalColumn U=v} ≃
      Matrix.orthogonalGroup (Fin (n+1)) K := by
  let P := Classical.choose (orthogonalColumn_surjective_charTwo n v.val v.property)
  have hP : unitaryColumn P=v.val :=
    Classical.choose_spec (orthogonalColumn_surjective_charTwo n v.val v.property)
  let e : {U : Matrix.orthogonalGroup (Fin (n+2)) K // noncanonicalColumn U=v} ≃
      {U : Matrix.orthogonalGroup (Fin (n+2)) K // unitaryColumn U=v.val} :=
    Equiv.subtypeEquivRight (fun U => ⟨fun h => congrArg Subtype.val h,fun h => Subtype.ext h⟩)
  exact e.trans (orthogonalColumnFiberEquiv v.val P hP)
theorem orthogonal_card_recurrence_charTwo (n : ℕ) :
    Nat.card (Matrix.orthogonalGroup (Fin (n+2)) K)=
      (Nat.card K^(n+1)-(if Odd (n+2) then 1 else 0))*
        Nat.card (Matrix.orthogonalGroup (Fin (n+1)) K) := by
  classical
  letI : Fintype (NoncanonicalSphere (K := K) (n+2)) := Fintype.ofFinite _
  have h := Nat.card_congr (Equiv.sigmaFiberEquiv (noncanonicalColumn (K := K) (n := n)))
  rw [Nat.card_sigma] at h
  have hc (v : NoncanonicalSphere (K := K) (n+2)) :
      Nat.card {U : Matrix.orthogonalGroup (Fin (n+2)) K // noncanonicalColumn U=v}=
        Nat.card (Matrix.orthogonalGroup (Fin (n+1)) K) :=
    Nat.card_congr (noncanonicalColumnFiberEquiv n v)
  simp_rw [hc] at h
  have he : NoncanonicalSphere (K := K) (n+2) ≃
      {v : Fin (n+2) → K // (∑ i,(v i)^2=1) ∧ v≠fun _ => 1} :=
    { toFun := fun v => ⟨v.val.val,by
        constructor
        · have h : (∑ i,v.val.val i*v.val.val i)=1 := v.val.property
          simpa only [pow_two] using h
        · exact v.property⟩
      invFun := fun v => ⟨⟨v.val,by
        change (∑ i,v.val i*v.val i)=1
        simpa only [pow_two] using v.property.1⟩,v.property.2⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  have hs := Nat.card_congr he
  rw [Problem18CharTwoSphereCard20260930.noncanonical_unit_sphere_card (n+1)] at hs
  have h' : Nat.card (Matrix.orthogonalGroup (Fin (n+2)) K)=
      Nat.card (NoncanonicalSphere (K := K) (n+2))*
        Nat.card (Matrix.orthogonalGroup (Fin (n+1)) K) := by
    simpa only [Finset.sum_const,Finset.card_univ,smul_eq_mul,Nat.card_eq_fintype_card] using h.symm
  rwa [hs] at h'
theorem orthogonal_card_one : Nat.card (Matrix.orthogonalGroup (Fin 1) K)=1 := by
  have hU (U : Matrix.orthogonalGroup (Fin 1) K) : U=1 := by
    apply Subtype.ext
    ext i j
    have hi : i=0 := Subsingleton.elim _ _
    have hj : j=0 := Subsingleton.elim _ _
    have h := congrFun (congrFun (Matrix.mem_unitaryGroup_iff'.mp U.property) 0) 0
    change (∑ k : Fin 1,U.val k 0*U.val k 0)=1 at h
    have hs : U.val 0 0 ^ 2=(1:K)^2 := by
      simpa only [Fin.sum_univ_one,pow_two,one_mul] using h
    change U.val i j=(1 : Matrix (Fin 1) (Fin 1) K) i j
    rw [hi,hj,Matrix.one_apply,if_pos rfl]
    exact CharTwo.sq_injective hs
  letI : Subsingleton (Matrix.orthogonalGroup (Fin 1) K) :=
    ⟨fun U V => (hU U).trans (hU V).symm⟩
  exact Nat.card_unique
theorem orthogonal_order_product_charTwo (n : ℕ) :
    Nat.card (Matrix.orthogonalGroup (Fin (n+1)) K)=
      ∏ k ∈ Finset.range n,(Nat.card K^(k+1)-(if Odd (k+2) then 1 else 0)) := by
  induction n with
  | zero => simp [orthogonal_card_one]
  | succ n ih =>
      rw [orthogonal_card_recurrence_charTwo,ih,Finset.prod_range_succ,mul_comm]
end Mathproof.Problem18CharTwoOrthogonalColumn20260930
