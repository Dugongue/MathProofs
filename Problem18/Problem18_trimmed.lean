theorem flat_get {α β : Type} (xs : List α) (f : α → List β) (N : Nat)
    (h : ∀x∈xs,(f x).length=N) (u j : Nat) (hu : u<xs.length) (hj : j<N) :
    (xs.flatMap f)[u*N+j]'(by
      have hl : (xs.flatMap f).length=xs.length*N := by
        simp only [List.length_flatMap]
        rw [List.map_congr_left h]
