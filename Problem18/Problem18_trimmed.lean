    refine ⟨ζ,hr,⟨R',hs',hrmod,by omega,hpot',?_,hi.trans hin,ho.trans hout,?_⟩,by omega⟩
    · intro x hx hm hxc
      exact (hv x hx hm hxc).trans (hvars x hx hm hxc)
    · intro t ht hafter;exact (hmem t ht hafter).trans (hframe t ht hafter)
  obtain ⟨τ,hr,hIτ,hfalse⟩ :=
    Run.while_count I (fun ξ => N-ξ.vars q.c) (bodyBudget F q N) hdef hstep hI
  obtain ⟨R,hs,hmod,hc,hpot,hvars,hin,hout,hframe⟩ := hIτ
