def c0 : Real := min Problem18BoundaryUniformDensity20261001.boundaryConstant (1/2)
theorem c0_pos : 0<c0 := lt_min Problem18BoundaryUniformDensity20261001.boundaryConstant_pos (by norm_num)
theorem density_eq_probability {X : Type*} [Fintype X] (P : X→Prop) : density P=probability P := by
  simp only [density,probability,Nat.card_eq_fintype_card]
theorem density_true {X : Type*} [Fintype X] [Nonempty X] : density (fun _ : X=>True)=1 := by
  rw [density_eq_probability,probability_filter]
  simp
theorem density_bounds {X : Type*} [Fintype X] [Nonempty X] (P : X→Prop) :
    0≤ density P ∧ density P≤1 := by
  rw [density_eq_probability,probability_filter]
  constructor
  · positivity
  · apply (div_le_one (by exact_mod_cast Fintype.card_pos (α:=X))).mpr
    exact_mod_cast Finset.card_filter_le (s:=Finset.univ) (p:=P)
theorem valid_q_one {K : Type} [Field K] [Fintype K] (u : Bool) (q : Nat)
    (hv : validSize K u q) : 1≤ q := by
  have hc := Fintype.card_pos (α:=K)
  cases u with
  | false => change q=Fintype.card K at hv; omega
  | true => change _ ∧ Fintype.card K=q*q at hv; nlinarith [hv.2]
def sourceDensity {K : Type} [Field K] [Fintype K] [BEq K] [LawfulBEq K] [DecidableEq K]
    (B : Nat) (u : Bool) (q a b c : Nat) : Real :=
  density (fun A : RectTensor a b c K=>sourceCheck B u q A=true)
theorem sorted_density {K : Type} [Field K] [Fintype K] [BEq K] [LawfulBEq K] [DecidableEq K]
    (B : Nat) (u : Bool) (q a b c : Nat) :
    sourceDensity (K:=K) B u q a b c=
      density (fun A : RectTensor (shape (sortOrder a b c) a b c).1
        (shape (sortOrder a b c) a b c).2.1 (shape (sortOrder a b c) a b c).2.2 K=>
          sortedCheck B u q A=true) := by
  unfold sourceDensity sourceCheck
  exact density_pullback
    (X:=RectTensor a b c K)
    (Y:=RectTensor (shape (sortOrder a b c) a b c).1
      (shape (sortOrder a b c) a b c).2.1 (shape (sortOrder a b c) a b c).2.2 K)
    (tensorEquiv (K:=K) (a:=a) (b:=b) (c:=c) (sortOrder a b c))
    (fun A=>sortedCheck B u q A=true)
theorem shape_two (o : Order) {a b c : Nat} (ha : 2≤ a) (hb : 2≤ b) (hc : 2≤ c) :
    2≤(shape o a b c).1 ∧ 2≤(shape o a b c).2.1 ∧ 2≤(shape o a b c).2.2 := by
  cases o <;> simp_all [shape]
theorem uniform_typed_density :
    ∃ B : Nat, 8≤ B ∧ 0<c0 ∧ 0<largeConstant ∧
      ∀ (K : Type) [Field K] [Fintype K] [BEq K] [LawfulBEq K] [DecidableEq K]
        (u : Bool) (q a b c : Nat), validSize K u q→0<a→0<b→0<c→
        c0/(q:Real)≤ sourceDensity (K:=K) B u q a b c ∧
        (2≤ a→2≤ b→2≤ c→1-sourceDensity (K:=K) B u q a b c≤
          min 1 (largeConstant*(1+Real.log (median a b c))/Real.sqrt (median a b c))) ∧
        (median a b c<B→∀A : RectTensor a b c K,sourceCheck B u q A=true) := by
  obtain ⟨B,hB,hC,hlarge⟩ := large_density_package
  refine ⟨B,hB,c0_pos,hC,?_⟩
  intro K _ _ _ _ _ u q a b c hv ha hb hc
  have hq : (1:Real)≤ q := by exact_mod_cast valid_q_one u q hv
  have hcle : c0/(q:Real)≤ c0 := div_le_self c0_pos.le hq
  have hchalf : c0≤(1/2:Real) := min_le_right _ _
  have hsort := sorted_shape a b c
  have hpos := shape_positive (sortOrder a b c) ha hb hc
  have hmid := sorted_middle_median a b c
  let s := shape (sortOrder a b c) a b c
  have hs : s.1≤ s.2.1 ∧ s.2.1≤ s.2.2 := hsort
  have hp : 0<s.1 ∧ 0<s.2.1 ∧ 0<s.2.2 := hpos
  have hm : s.2.1=median a b c := hmid
  have hdens := sorted_density (K:=K) B u q a b c
  change sourceDensity (K:=K) B u q a b c=
    density (fun A : RectTensor s.1 s.2.1 s.2.2 K=>sortedCheck B u q A=true) at hdens
  have hlower : c0/(q:Real)≤ sourceDensity (K:=K) B u q a b c := by
    rw [hdens]
    by_cases hsmall : s.2.1<B
    · simp only [sortedCheck,if_pos hsmall,Bool.true_eq,density_true]
      linarith
    · have hbig : B≤ s.2.1 := Nat.le_of_not_lt hsmall
      by_cases hone : s.1=1
      · have hbd := Problem18BoundaryUniformDensity20261001.first_good_density
          (K:=K) (b:=s.2.1) (c:=s.2.2) u q hv (by omega) (by omega)
        have he : (fun A : RectTensor s.1 s.2.1 s.2.2 K=>sortedCheck B u q A=true)=
            (fun A=>Problem18BoundaryUniformDensity20261001.FirstRawGood u q (hone ▸ A)) := by
          funext A
          simp only [sortedCheck,if_neg hsmall,dif_pos hone,
            Problem18BoundaryRawChecks20261001.firstCheck_correct]
        rw [he]
        have heq : density (fun A : RectTensor s.1 s.2.1 s.2.2 K=>
          Problem18BoundaryUniformDensity20261001.FirstRawGood u q (hone ▸ A))=
          density (Problem18BoundaryUniformDensity20261001.FirstRawGood (K:=K)
            (b:=s.2.1) (c:=s.2.2) u q) := by
          have transport (x y z : Nat) (h : x=1) :
              density (fun A : RectTensor x y z K=>
                Problem18BoundaryUniformDensity20261001.FirstRawGood u q (h ▸ A))=
              density (Problem18BoundaryUniformDensity20261001.FirstRawGood (K:=K)
                (b:=y) (c:=z) u q) := by subst x; rfl
          exact transport s.1 s.2.1 s.2.2 hone
        rw [heq]
        exact (div_le_div_of_nonneg_right (min_le_left _ _) (by positivity)).trans hbd
      · have hh := (hlarge K u q s.1 s.2.1 s.2.2 hv (by omega) hs.1 hs.2 hbig).2
        simp only [sortedCheck,if_neg hsmall,dif_neg hone]
        rw [density_eq_probability]
        apply (hcle.trans hchalf).trans
        simpa only [Problem18LargeRootPredicate20261001.rawCheck_correct] using hh
  refine ⟨hlower,?_,fun hsmall A=>sourceCheck_small B u q hsmall A⟩
  intro ha2 hb2 hc2
  have ht := shape_two (sortOrder a b c) ha2 hb2 hc2
  have ht' : 2≤ s.1 ∧ 2≤ s.2.1 ∧ 2≤ s.2.2 := ht
  have hlog : 0≤ Real.log (median a b c:Real) := Real.log_nonneg (by
    have hmed : 1≤ median a b c := by omega
    exact_mod_cast hmed)
  apply le_min
  · have hnonneg := (density_bounds (fun A : RectTensor a b c K=>sourceCheck B u q A=true)).1
    change 0≤ sourceDensity (K:=K) B u q a b c at hnonneg
    linarith
  · by_cases hsmall : s.2.1<B
    · rw [hdens]
      simp only [sortedCheck,if_pos hsmall,Bool.true_eq,density_true,sub_self]
      positivity
    · have hbig : B≤ s.2.1 := Nat.le_of_not_lt hsmall
      have hone : s.1≠1 := by omega
      have hbound := (hlarge K u q s.1 s.2.1 s.2.2 hv ht'.1 hs.1 hs.2 hbig).1
      rw [hdens]
      simp only [sortedCheck,if_neg hsmall,dif_neg hone]
      rw [density_eq_probability]
      simp only [Problem18LargeRootPredicate20261001.rawCheck_correct]
      have hacc := raw_check_acceptance (K:=K) u q s.1 s.2.1 s.2.2
      simp only [Problem18LargeRootPredicate20261001.rawCheck_correct] at hacc
      rw [hacc]
      simpa only [sub_sub_cancel,hm] using hbound
