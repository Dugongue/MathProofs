  map_mul' x y := by simp [Finset.prod_mul_distrib]
theorem productNormUnits_surjective [Nonempty ι] : Function.Surjective (productNormUnits (K:=K) E) := by
  classical
  let j : ι := Classical.choice inferInstance
  intro u
  obtain ⟨v,hv⟩ := FiniteField.unitsMap_norm_surjective K (E j) u
  refine ⟨Function.update (fun i => (1:(E i)ˣ)) j v,?_⟩
  change (∏ i,Units.map (Algebra.norm K) ((Function.update (fun i => (1:(E i)ˣ)) j v) i))=u
  rw [Finset.prod_eq_single j]
  · simpa using hv
  · intro i hi hij
    simp [Function.update_of_ne hij]
  · intro hj
    exact False.elim (hj (Finset.mem_univ j))
theorem product_norm_squareclass_card [Nonempty ι] (hodd : ringChar K≠2) (a : Kˣ) :
    Nat.card {z : (∀ i,(E i)ˣ) // quadraticChar K (a.val*(productNormUnits E z).val)=1}*2=
      ∏ i,(Nat.card (E i)-1) := by
  rw [squareclass_preimage_card (productNormUnits E) (productNormUnits_surjective E) hodd a,
    Nat.card_pi]
  apply Finset.prod_congr rfl
  intro i _
  exact Nat.card_units (E i)
end
