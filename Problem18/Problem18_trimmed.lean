  have sep (x:String) (hx:x∈[acc,prod,next]) := h.modulus x hx
  obtain ⟨ξ,hr,hξ,hfr,hv,hm⟩:=accumulate_run F
    (addressExpr baseA strideA) (addressExpr baseB strideB) hρ.valid heA heB hleft hright
