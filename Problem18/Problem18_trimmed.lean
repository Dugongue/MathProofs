noncomputable section
def gauss : RNames := ⟨"P18.boundary.dep.WS","P18.boundary.dep.N",
  "P18.boundary.dep.c","P18.boundary.dep.n","P18.boundary.dep.u","P18.boundary.dep.w",
  "P18.boundary.dep.j","P18.boundary.dep.i","P18.boundary.dep.pv","P18.boundary.dep.f"⟩
def indexReg := "P18.boundary.dep.index"
def flagReg := "P18.boundary.dep.flag"
def scanReg := "P18.boundary.dep.scan"
def bankReg := "P18.boundary.dep.bank"
def strideReg := "P18.boundary.dep.stride"
