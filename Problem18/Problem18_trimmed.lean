theorem valid_of_words {B : Nat} {σ τ : Env} (h : ValidMemory F B σ)
    (he : τ.vars canonical.e = σ.vars canonical.e) (hp : τ.vars canonical.p = σ.vars canonical.p)
    (hm : τ.vars canonical.modBase = σ.vars canonical.modBase)
    (hlen : (τ.arrs canonical.mem).length = (σ.arrs canonical.mem).length)
    (hscr : (τ.arrs canonical.scratch).length = (σ.arrs canonical.scratch).length)
    (hmod : ∀ i < F.e, (τ.arrs canonical.mem).getD (σ.vars canonical.modBase + i) 0 =
      (σ.arrs canonical.mem).getD (σ.vars canonical.modBase + i) 0)
    (hcoef : ∀ j < (τ.arrs canonical.mem).length, (τ.arrs canonical.mem).getD j 0 < F.p) :
    ValidMemory F B τ := by
  refine ⟨he.trans h.degree, hp.trans h.prime, h.arithmetic_word, h.inverse_word,
    by rw [hlen]; exact h.memory_word, by rw [hscr]; exact h.scratch_word,
    by rw [hscr]; exact h.scratch_fit, by rw [hm, hlen]; exact h.modulus_fit, ?_, hcoef⟩
  intro i
  have := h.modulus_value i
