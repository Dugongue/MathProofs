namespace Mathproof.Problem18BoundaryQueryAssembly20261001
open Matrix Problem18OrthogonalAssembly
open Mathproof.Problem18AllFormatRoot20260930
open Mathproof.Problem18BoundaryRawChecks20261001
open Mathproof.Problem18DimensionOneBoundary20260930
open Mathproof.Problem18DimensionOnePermutation20260930
open Mathproof.Problem18UnitaryRootField20260930
open Mathproof.Problem18InvolutionNorm20260930
open Mathproof.Problem18ArrayKrylov20261001
variable {K : Type} [Field K] [Fintype K] [BEq K] [LawfulBEq K] [DecidableEq K]
variable {a b c : ℕ}
theorem firstCheck_invariant (u : Bool) (q : ℕ) (hv : validSize K u q)
    (A B : RectTensor 1 b c K) (h : equivalent u q A B) : firstCheck u q A=firstCheck u q B := by
  apply Bool.eq_iff_iff.mpr
  rw [firstCheck_correct,firstCheck_correct]
  cases u with
  | false =>
    exact Mathproof.Problem18OrthogonalTensorBoundaryDensity20260930.first_good_invariant q A B h
  | true =>
    let d := Classical.choice (exists_unitaryFieldData q hv)
    letI : StarRing K := d.starRing
    rw [Mathproof.Problem18BoundaryUniformDensity20261001.first_unitary_iff q d.star_eq_power,
      Mathproof.Problem18BoundaryUniformDensity20261001.first_unitary_iff q d.star_eq_power]
    exact Mathproof.Problem18UnitaryTensorBoundaryDensity20260930.first_good_invariant q d.star_eq_power A B h
def MatrixEquivalent (unitary : Bool) (q : ℕ) (A B : Matrix (Fin c) (Fin b) K) : Prop :=
  ∃ R : Matrix (Fin c) (Fin c) K, ∃ Q : Matrix (Fin b) (Fin b) K,
    isometry unitary q R ∧ isometry unitary q Q ∧ R*A*Q=B
theorem orthogonal_iff (q : ℕ) (A B : Matrix (Fin c) (Fin b) K) :
    MatrixEquivalent false q A B ↔ MatrixOrthogonalEquivalent A B := Iff.rfl
theorem unitary_iff [StarRing K] (q : ℕ) (hstar : ∀ x : K,star x=x^q)
    (A B : Matrix (Fin c) (Fin b) K) :
    MatrixEquivalent true q A B ↔ MatrixUnitaryEquivalent A B := by
  simp only [MatrixEquivalent,MatrixUnitaryEquivalent,isometry_unitary hstar]
theorem isometry_transpose (u : Bool) (q : ℕ) {n : ℕ} (M : Matrix (Fin n) (Fin n) K)
    (h : isometry u q M) : isometry u q M.transpose := by
  cases u
  · exact orthogonal_transpose _ h
  · have hh := congrArg Matrix.transpose (mul_eq_one_comm.mp h)
    simpa only [isometry,Bool.true_eq,↓reduceIte,Matrix.transpose_mul,
      Matrix.transpose_transpose,Matrix.transpose_one,Matrix.transpose_map] using hh
theorem equivalent_transpose (u : Bool) (q : ℕ) (A B : Matrix (Fin c) (Fin b) K) :
    MatrixEquivalent u q A.transpose B.transpose ↔ MatrixEquivalent u q A B := by
  have H {b c : ℕ} (A B : Matrix (Fin c) (Fin b) K)
      (h : MatrixEquivalent u q A B) : MatrixEquivalent u q A.transpose B.transpose := by
    obtain ⟨R,Q,hR,hQ,he⟩ := h
    refine ⟨Q.transpose,R.transpose,isometry_transpose u q _ hQ,isometry_transpose u q _ hR,?_⟩
    rw [← he,Matrix.transpose_mul,Matrix.transpose_mul,Matrix.mul_assoc]
  exact ⟨fun h => by simpa only [Matrix.transpose_transpose] using H _ _ h,H A B⟩
def trial (unitary : Bool) (q p : ℕ) (A B : Matrix (Fin c) (Fin b) K)
    (v w : Fin b→K) : Option Bool :=
  if unitary then some (Mathproof.Problem18UnitaryRawQuery20261001.queryCheck q A B)
  else if p=2 then some (Mathproof.Problem18CharTwoBooleanQuery20261001.queryCheck A B)
  else Mathproof.Problem18OddBooleanTrial20261001.trial q A B v w
theorem trial_zero_error (unitary : Bool) (q p : ℕ) [CharP K p]
    (hv : validSize K unitary q) (A B : Matrix (Fin c) (Fin b) K)
    (hA : rawCheck unitary q A=true) (v w : Fin b→K) (answer : Bool)
    (h : trial unitary q p A B v w=some answer) :
    answer=true ↔ MatrixEquivalent unitary q A B := by
  cases unitary with
  | false =>
    change Mathproof.Problem18BoundaryBooleanChecks20260930.orthogonalSourceCheck A=true at hA
    have hq : q=Nat.card K := by simpa only [validSize,Bool.false_eq_true,↓reduceIte,
      Nat.card_eq_fintype_card] using hv
    rw [orthogonal_iff]
    by_cases hp : p=2
    · subst p
      simp only [trial,Bool.false_eq_true,↓reduceIte,Option.some.injEq] at h
      rw [← h]
      exact Mathproof.Problem18CharTwoBooleanQuery20261001.queryCheck_correct A B hA
    · simp only [trial,Bool.false_eq_true,↓reduceIte,hp] at h
      exact Mathproof.Problem18OddBooleanTrial20261001.trial_zero_error q hq
        (by simpa only [ringChar.eq K p] using hp) A B hA v w answer h
  | true =>
    let d := Classical.choice (exists_unitaryFieldData q hv)
    letI : StarRing K := d.starRing
    letI : Fintype (fixedField d.automorphism) := Fintype.ofFinite _
    simp only [trial,Bool.true_eq,↓reduceIte,Option.some.injEq] at h
    rw [← h,unitary_iff q d.star_eq_power]
    exact Mathproof.Problem18UnitaryRawQuery20261001.queryCheck_correct
      d.quadratic_card q d.fixed_card d.star_eq_power A B hA
def orientedTrial (u : Bool) (q p : ℕ) (A B : Matrix (Fin c) (Fin b) K)
    (v w : Fin b→K) (v' w' : Fin c→K) : Option Bool :=
  if b≤ c then trial u q p A B v w else trial u q p A.transpose B.transpose v' w'
theorem orientedTrial_zero_error (u : Bool) (q p : ℕ) [CharP K p]
    (hv : validSize K u q) (A B : Matrix (Fin c) (Fin b) K)
    (hA : orientedCheck u q A=true) (v w : Fin b→K) (v' w' : Fin c→K)
    (answer : Bool) (h : orientedTrial u q p A B v w v' w'=some answer) :
    answer=true ↔ MatrixEquivalent u q A B := by
  unfold orientedTrial at h
  unfold orientedCheck at hA
  split_ifs at h hA with hbc
  · exact trial_zero_error u q p hv A B hA v w answer h
  · exact (trial_zero_error u q p hv A.transpose B.transpose hA v' w' answer h).trans
      (equivalent_transpose u q A B)
def Ready (u : Bool) (p : ℕ) (A B : Matrix (Fin c) (Fin b) K)
    (v w : Fin b→K) (v' w' : Fin c→K) : Prop :=
  u=true ∨ p=2 ∨ if b≤ c then
    cyclicCheck (A.transpose*A) v=true ∧ cyclicCheck (B.transpose*B) w=true
  else cyclicCheck (A*A.transpose) v'=true ∧ cyclicCheck (B*B.transpose) w'=true
def firstTrial (u : Bool) (q p : ℕ) (A B : RectTensor 1 b c K)
    (v w : Fin b→K) (v' w' : Fin c→K) : Option Bool :=
  orientedTrial u q p (matrixOf A) (matrixOf B) v w v' w'
theorem first_root_iff (u : Bool) (q : ℕ) (hv : validSize K u q) (A B : RectTensor 1 b c K) :
    equivalent u q A B ↔ MatrixEquivalent u q (matrixOf A) (matrixOf B) := by
  cases u with
  | false => exact root_orthogonal_dimension_one_iff q A B
  | true =>
    let d := Classical.choice (exists_unitaryFieldData q hv)
    letI : StarRing K := d.starRing
    rw [unitary_iff q d.star_eq_power]
    exact root_unitary_dimension_one_iff q d.star_eq_power A B
theorem firstTrial_zero_error (u : Bool) (q p : ℕ) [CharP K p]
    (hv : validSize K u q) (A B : RectTensor 1 b c K) (hA : firstCheck u q A=true)
    (v w : Fin b→K) (v' w' : Fin c→K) (answer : Bool)
    (h : firstTrial u q p A B v w v' w'=some answer) :
    answer=true ↔ equivalent u q A B :=
  (orientedTrial_zero_error u q p hv _ _ hA v w v' w' answer h).trans (first_root_iff u q hv A B).symm
end Mathproof.Problem18BoundaryQueryAssembly20261001
