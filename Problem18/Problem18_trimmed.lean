  Problem18FinalFactor20260930 Problem18OrthogonalAssembly
variable {K ι : Type*} [Field K] [DecidableEq K] [Fintype ι] [DecidableEq ι]
variable {m c a b : Nat}
def unencode (e : Fin m≃ι) : (Fin m→K)≃ₗ[K](ι→K) where
  toFun x:=x ∘ e.symm
  invFun x:=x ∘ e
  left_inv x:=by ext j; simp
  right_inv x:=by ext j; simp
  map_add' _ _:=rfl
  map_smul' _ _:=rfl
def computedKernel (e : Fin m≃ι) (A : Matrix (Fin c) ι K) : Fin m→ι→K :=
  fun j=>unencode e (matrixKernelFamily (A.submatrix id e) j)
theorem computedKernel_span (e : Fin m≃ι) (A : Matrix (Fin c) ι K) :
    Submodule.span K (Set.range (computedKernel e A))=LinearMap.ker A.toLin' := by
  have hr:Set.range (computedKernel e A)=unencode e '' Set.range (matrixKernelFamily (A.submatrix id e)) := by
    ext x
    simp [computedKernel]
  have hs : Submodule.span K (unencode e '' Set.range (matrixKernelFamily (A.submatrix id e)))=
      (Submodule.span K (Set.range (matrixKernelFamily (A.submatrix id e)))).map (unencode e).toLinearMap :=
    (Submodule.map_span (unencode (K:=K) e).toLinearMap _).symm
  rw [hr,hs,matrixKernelFamily_span]
  ext x
  constructor
  · rintro ⟨y,hy,rfl⟩
    change (A.submatrix id e)*ᵥy=0 at hy
    change A*ᵥ(y ∘ e.symm)=0
    simpa only [Matrix.submatrix_mulVec_equiv,Function.comp_def,id_eq] using hy
  · intro hx
    change A*ᵥx=0 at hx
    refine ⟨x ∘ e,?_,?_⟩
    · change (A.submatrix id e)*ᵥ(x ∘ e)=0
      simpa only [Matrix.submatrix_mulVec_equiv,Function.comp_def,id_eq,Equiv.apply_symm_apply] using hx
    · ext j; simp [unencode,Function.comp_def]
def computedRank (e : Fin m≃ι) (A : Matrix (Fin c) ι K) : Nat :=
  matrixRank (A.submatrix id e)
theorem computedRank_correct (e : Fin m≃ι) (A : Matrix (Fin c) ι K) : computedRank e A=A.rank := by
  rw [computedRank,matrixRank_correct]
  exact Matrix.rank_submatrix A (Equiv.refl _) e
def augmentedIndex (a b : Nat) : Fin (a*b+1)≃AugmentedColumn a b :=
  finSumFinEquiv.symm.trans (Equiv.sumCongr finProdFinEquiv.symm finOneEquiv)
def marker (c : Nat) : Fin c→K := fun _=>if (2:K)=0 then 1 else 0
theorem marker_correct [Fintype K] (c : Nat) : marker (K:=K) c=standardMarker c := by
  by_cases h:(2:K)=0
  · letI : CharP K 2:=(CharP.charP_iff_prime_eq_zero (R:=K) Nat.prime_two).mpr h
    rw [Problem18CharTwoOrthogonalColumn20260930.standardMarker_eq_one]
    change (fun _ : Fin c=>if (2:K)=0 then 1 else 0)=(fun _=>1)
    simp [h]
  · simp only [standardMarker,Problem18FiniteSymmetricRecovery20260929.recoveryMarker,dif_neg h]
    change (fun _ : Fin c=>if (2:K)=0 then 1 else 0)=0
    ext i
    simp [h]
def augmentedKernel (G : RectTensor a b c K) : Fin (a*b+1)→AugmentedColumn a b→K :=
  computedKernel (augmentedIndex a b) (augmentedConstantMatrix G (marker c))
theorem augmentedKernel_span (G : RectTensor a b c K) :
    Submodule.span K (Set.range (augmentedKernel G))=
      LinearMap.ker (augmentedConstantMatrix G (marker c)).toLin' :=
  computedKernel_span _ _
def ranksMatch (F G : RectTensor a b c K) : Bool :=
  decide (computedRank (augmentedIndex a b) (augmentedConstantMatrix F (marker c))=
    computedRank (augmentedIndex a b) (augmentedConstantMatrix G (marker c)))
theorem ranksMatch_correct (F G : RectTensor a b c K) : ranksMatch F G=true ↔
    (augmentedConstantMatrix F (marker c)).rank=(augmentedConstantMatrix G (marker c)).rank := by
  simp only [ranksMatch,decide_eq_true_eq,computedRank_correct]
def orthogonalEquations (F G : RectTensor a b c K) : List (PolyExpr (OuterVar a b) K) :=
  if ranksMatch F G then
    ((List.finRange a).flatMap fun i=>(List.finRange a).map fun j=>
      bilinearEquation F G 1 1 1 (marker c) (augmentedKernel G) (.inl (.inl (i,j)))) ++
    ((List.finRange b).flatMap fun i=>(List.finRange b).map fun j=>
      bilinearEquation F G 1 1 1 (marker c) (augmentedKernel G) (.inl (.inr (i,j)))) ++
    ((List.finRange c).flatMap fun i=>(List.finRange (a*b+1)).map fun j=>
      bilinearEquation F G 1 1 1 (marker c) (augmentedKernel G) (.inr (.inl (i,j)))) ++
    ((List.finRange (a*b)).flatMap fun i=>(List.finRange (a*b)).map fun j=>
      bilinearEquation F G 1 1 1 (marker c) (augmentedKernel G)
        (.inr (.inr (finProdFinEquiv.symm i,finProdFinEquiv.symm j))))
  else [.const 1]
theorem orthogonalEquations_zero (F G : RectTensor a b c K) (x : OuterVar a b→K) :
    (∀p∈orthogonalEquations F G,p.eval x=0) ↔ ranksMatch F G=true ∧
      BilinearSystemZero F G 1 1 1 (marker c) (augmentedKernel G) x := by
  by_cases h:ranksMatch F G=true
  · simp only [orthogonalEquations,h,ite_true,List.forall_mem_append,List.forall_mem_flatMap,
      List.forall_mem_map,List.mem_finRange,forall_true_left,true_and]
    constructor
    · rintro ⟨⟨⟨hP,hQ⟩,hk⟩,hg⟩ i
      rcases i with ((ij|ij)|(ij|ij))
      · exact hP ij.1 ij.2
      · exact hQ ij.1 ij.2
      · exact hk ij.1 ij.2
      · simpa only [Equiv.symm_apply_apply] using hg (finProdFinEquiv ij.1) (finProdFinEquiv ij.2)
    · intro h
      exact ⟨⟨⟨fun i j=>h (.inl (.inl (i,j))),fun i j=>h (.inl (.inr (i,j)))⟩,
        fun i j=>h (.inr (.inl (i,j)))⟩,fun i j=>h (.inr (.inr (_,_)))⟩
  · simp [orthogonalEquations,h,PolyExpr.eval]
theorem rank_eq_of_kernel_eq (A B : Matrix (Fin c) ι K)
    (h : LinearMap.ker A.toLin'=LinearMap.ker B.toLin') : A.rank=B.rank := by
  have hA:=LinearMap.finrank_range_add_finrank_ker A.toLin'
  have hB:=LinearMap.finrank_range_add_finrank_ker B.toLin'
  rw [h] at hA
  simp only [Matrix.toLin'_apply'] at hA hB
  exact Nat.add_right_cancel (hA.trans hB.symm)
theorem fixed_ranks_of_encoded_recovery (F G : RectTensor a b c K) (x : OuterVar a b→K)
    (hP:(pMatrix x).transpose*pMatrix x=1) (hQ:(rMatrix x).transpose*rMatrix x=1)
    (hk:LinearMap.ker (Problem18MarkedRecovery20260929.augment (transformedMatrix x F).toLin' (marker c))=
      LinearMap.ker (Problem18MarkedRecovery20260929.augment G.toLin' (marker c))) :
    ranksMatch F G=true := by
  apply ranksMatch_correct F G |>.mpr
  have h:=rank_eq_of_kernel_eq _ _ ((augmentedMatrix_kernel_eq_iff_augment x F G (marker c)).mpr hk)
  rw [augmentedTransformed_rank_eq x F (marker c) hP hQ] at h
  exact h
theorem orthogonalEquations_iff [Fintype K] (F G : RectTensor a b c K) :
    (∃x:OuterVar a b→K,∀p∈orthogonalEquations F G,p.eval x=0) ↔ RectOrthogonalEquivalent F G := by
  rw [rect_orthogonal_marked_gram_criterion]
  constructor
  · rintro ⟨x,hx⟩
    obtain ⟨hr,hz⟩:=(orthogonalEquations_zero F G x).mp hx
    have hh:=(bilinearSystem_zero_iff_root_augment_of_fixed_augmented_ranks F G (marker c)
      (augmentedKernel G) (augmentedKernel_span G) ((ranksMatch_correct F G).mp hr) x).mp hz
    refine ⟨pMatrix x,rMatrix x,hh.1,hh.2.1,?_,hh.2.2.2⟩
    simpa only [marker_correct,transformedMatrix] using hh.2.2.1
  · rintro ⟨P,Q,hP,hQ,hk,hg⟩
    let x:OuterVar a b→K:=Sum.elim (fun ij=>P ij.1 ij.2) (fun ij=>Q ij.1 ij.2)
    have hxP:pMatrix x=P:=rfl
    have hxQ:rMatrix x=Q:=rfl
    have hxk:LinearMap.ker (Problem18MarkedRecovery20260929.augment (transformedMatrix x F).toLin' (marker c))=
        LinearMap.ker (Problem18MarkedRecovery20260929.augment G.toLin' (marker c)) := by
      simpa only [marker_correct,transformedMatrix,hxP,hxQ] using hk
    have hr:=fixed_ranks_of_encoded_recovery F G x hP hQ hxk
    refine ⟨x,(orthogonalEquations_zero F G x).mpr ⟨hr,?_⟩⟩
    apply (bilinearSystem_zero_iff_root_augment_of_fixed_augmented_ranks F G (marker c)
      (augmentedKernel G) (augmentedKernel_span G) ((ranksMatch_correct F G).mp hr) x).mpr
    exact ⟨hP,hQ,hxk,hg⟩
end Mathproof.Problem18BoundedComputedPreprocessing20261001
end
