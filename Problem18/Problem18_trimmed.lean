def opRegs : List String := [oA, oB, oO, oN, oBc, oBs]
def setOp (a b o n bc bs : Expr) : Com :=
  .seq (.assign oA a) <| .seq (.assign oB b) <| .seq (.assign oO o) <|
  .seq (.assign oN n) <| .seq (.assign oBc bc) <| .assign oBs bs
def setOpCost (a b o n bc bs : Expr) : Nat :=
  6 + a.size + b.size + o.size + n.size + bc.size + bs.size
def opState (σ : Env) (a b o n bc bs : Nat) : Env :=
  (((((σ.setVar oA a).setVar oB b).setVar oO o).setVar oN n).setVar oBc bc).setVar oBs bs
theorem setOp_run {W : Nat} {σ : Env} (a b o n bc bs : Expr)
    (hr : ∀ e ∈ [a, b, o, n, bc, bs], ∀ x ∈ reads e, x ∉ opRegs)
    (ha : Fine W σ a) (hb : Fine W σ b) (ho : Fine W σ o) (hn : Fine W σ n)
    (hbc : Fine W σ bc) (hbs : Fine W σ bs) :
    Run W (setOp a b o n bc bs) σ
      (opState σ (evalN σ a) (evalN σ b) (evalN σ o) (evalN σ n) (evalN σ bc) (evalN σ bs))
      (setOpCost a b o n bc bs) := by
  have keep : ∀ (e : Expr), e ∈ [a, b, o, n, bc, bs] → ∀ (ρ : Env),
      (∀ x, x ∉ opRegs → ρ.vars x = σ.vars x) → Fine W σ e → e.evalB W ρ = some (evalN σ e) := by
    intro e he ρ hρ hf
    exact evalB_transport e (fun x hx => hρ x (hr e he x hx)) hf
  have s : ∀ (ρ : Env) (y : String) (v : Nat), y ∈ opRegs →
      (∀ x, x ∉ opRegs → ρ.vars x = σ.vars x) →
      (∀ x, x ∉ opRegs → (ρ.setVar y v).vars x = σ.vars x) := by
    intro ρ y v hy hρ x hx
    have : x ≠ y := fun h => hx (h ▸ hy)
    simp [this, hρ x hx]
  have h0 : ∀ x, x ∉ opRegs → σ.vars x = σ.vars x := fun _ _ => rfl
  have h1 := s σ oA (evalN σ a) (by simp [opRegs]) h0
  have h2 := s _ oB (evalN σ b) (by simp [opRegs]) h1
  have h3 := s _ oO (evalN σ o) (by simp [opRegs]) h2
  have h4 := s _ oN (evalN σ n) (by simp [opRegs]) h3
  have h5 := s _ oBc (evalN σ bc) (by simp [opRegs]) h4
  have r := (Run.assign (x := oA) (keep a (by simp) σ h0 ha)).seq
    ((Run.assign (x := oB) (keep b (by simp) _ h1 hb)).seq
    ((Run.assign (x := oO) (keep o (by simp) _ h2 ho)).seq
    ((Run.assign (x := oN) (keep n (by simp) _ h3 hn)).seq
    ((Run.assign (x := oBc) (keep bc (by simp) _ h4 hbc)).seq
    (Run.assign (x := oBs) (keep bs (by simp) _ h5 hbs))))))
  exact r.mono (by simp only [setOpCost]; omega)
@[simp] theorem opState_arrs (σ : Env) (a b o n bc bs : Nat) :
