  have hs := Finset.sum_le_sum (s:=Finset.univ) (fun f _ => hp f)
  simp only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,← Nat.card_eq_fintype_card,
    ← Finset.sum_mul] at hs
  have hq0 : 0<q := by dsimp [q]; exact_mod_cast Nat.card_pos (α:=F)
