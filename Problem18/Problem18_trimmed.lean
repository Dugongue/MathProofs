theorem krullDimLE_zero_quotient {R : Type*} [CommRing R] (J : Ideal R)
    (hdim : ∀ Q : Ideal R, Q.IsPrime → J ≤ Q → Q.IsMaximal) : Ring.KrullDimLE 0 (R ⧸ J) := by
  refine Ring.KrullDimLE.mk₀ fun I hI => ?_
  haveI := hI
  have hc : (I.comap (Ideal.Quotient.mk J)).IsMaximal := by
    apply hdim _ inferInstance
    intro x hx
    rw [Ideal.mem_comap, Ideal.Quotient.eq_zero_iff_mem.mpr hx]
    exact I.zero_mem
  have hmap := Ideal.map_comap_of_surjective (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective I
  rcases Ideal.map_eq_top_or_isMaximal_of_surjective (Ideal.Quotient.mk J)
      Ideal.Quotient.mk_surjective hc with h | h
  · rw [hmap] at h
    exact absurd h hI.ne_top
  · rwa [hmap] at h
theorem finite_and_finrank_le {K : Type*} [Field K] {m : Nat}
    (G : Finset (MvPolynomial (Fin m) K)) (e : Nat) (hG : ∀ g ∈ G, g.totalDegree ≤ e)
    (hdim : ∀ Q : Ideal (MvPolynomial (Fin m) K), Q.IsPrime →
      Ideal.span (G : Set (MvPolynomial (Fin m) K)) ≤ Q → Q.IsMaximal) :
    Module.Finite K (MvPolynomial (Fin m) K ⧸ Ideal.span (G : Set (MvPolynomial (Fin m) K))) ∧
    Module.finrank K (MvPolynomial (Fin m) K ⧸ Ideal.span (G : Set (MvPolynomial (Fin m) K)))
      ≤ fiberBound m e := by
  classical
  have key : Module.Finite K (MvPolynomial (Fin m) K ⧸
        Mathproof.LibraryBridges.Claude.GroebnerNormalForms_20260908.generatedIdeal
          (G : Set (MvPolynomial (Fin m) K))) ∧
      Module.finrank K (MvPolynomial (Fin m) K ⧸
        Mathproof.LibraryBridges.Claude.GroebnerNormalForms_20260908.generatedIdeal
          (G : Set (MvPolynomial (Fin m) K))) ≤ fiberBound m e := by
    haveI : Ring.KrullDimLE 0 (MvPolynomial (Fin m) K ⧸
