      Fintype.card (V x)) / Fintype.card Ω ≤
    (∑x,((A x).card : ℝ)/Fintype.card G)/Fintype.card Ω+Real.sqrt (E/4) :=
  (restricted_replacement_le P A S).trans
    (add_le_add_right (averaged_image_variation_le P E hE henergy) _)
