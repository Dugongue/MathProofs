    (Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) B // IsotropicOccurrence B h S} : ℝ)*
      (Nat.card K : ℝ)^h.natDegree ≤
        8*Nat.card (SelfAdjointOperators (RingEquiv.refl K) B) := by
