theorem sum_finrank_le_of_maximal {K R : Type*} [Field K] [CommRing R] [Algebra K R]
    (J : Ideal R) [Module.Finite K (R ⧸ J)] (T : Finset (Ideal R))
    (hT : ∀ Q ∈ T, Q.IsMaximal ∧ J ≤ Q) :
    (∀ Q ∈ T, Module.Finite K (R ⧸ Q)) ∧
    ∑ Q ∈ T, Module.finrank K (R ⧸ Q) ≤ Module.finrank K (R ⧸ J) := by
  classical
  have hfinQ : ∀ Q ∈ T, Module.Finite K (R ⧸ Q) := fun Q hQ =>
    Module.Finite.of_surjective (Ideal.Quotient.factorₐ K (hT Q hQ).2).toLinearMap
      (Ideal.Quotient.factor_surjective (hT Q hQ).2)
  refine ⟨hfinQ, ?_⟩
  let I : T → Ideal R := fun Q => Q.1
  have hcop : Pairwise fun a b => IsCoprime (I a) (I b) := by
    intro a b hab
    haveI := (hT a.1 a.2).1
    haveI := (hT b.1 b.2).1
    exact Ideal.isCoprime_of_isMaximal (fun h => hab (Subtype.ext h))
  let g : (R ⧸ J) →ₗ[K] ((Q : T) → R ⧸ I Q) :=
    LinearMap.pi fun Q => (Ideal.Quotient.factorₐ K (hT Q.1 Q.2).2).toLinearMap
  have hg : Function.Surjective g := by
    intro x
    obtain ⟨r, hr⟩ := Ideal.pi_quotient_surjective hcop x
    refine ⟨Ideal.Quotient.mk J r, ?_⟩
    funext Q
    exact (Ideal.Quotient.factor_mk (hT Q.1 Q.2).2 r).trans (hr Q)
  haveI : ∀ Q : T, Module.Finite K (R ⧸ I Q) := fun Q => hfinQ Q.1 Q.2
  have h1 := LinearMap.finrank_le_finrank_of_surjective hg
  rw [Module.finrank_pi_fintype] at h1
  rw [← Finset.sum_coe_sort T]
  exact h1
theorem quotient_isIntegral_of_X {K : Type*} [Field K] {m : Nat}
    (Q : Ideal (MvPolynomial (Fin m) K))
    (hX : ∀ i, IsIntegral K (Ideal.Quotient.mk Q (X i : MvPolynomial (Fin m) K))) :
    Algebra.IsIntegral K (MvPolynomial (Fin m) K ⧸ Q) := by
  constructor
  intro y
  obtain ⟨f, rfl⟩ := Ideal.Quotient.mk_surjective y
  induction f using MvPolynomial.induction_on with
  | C a =>
    show IsIntegral K (algebraMap K (MvPolynomial (Fin m) K ⧸ Q) a)
    exact isIntegral_algebraMap
  | add p q hp hq =>
    rw [map_add]
    exact hp.add hq
  | mul_X p i hp =>
    rw [map_mul]
    exact hp.mul (hX i)
def AlgIndep (A : Type*) {S : Type*} [CommRing A] [CommRing S] [Algebra A S] {t : ℕ}
    (f : Fin t → S) : Prop :=
  ∀ c : Fin t → A, ∑ i, algebraMap A S (c i) * f i = 0 → ∀ i, c i = 0
theorem AlgIndep.map {A S T : Type*} [CommRing A] [CommRing S] [CommRing T] [Algebra A S]
    [Algebra A T] (φ : S →ₐ[A] T) (hφ : Function.Injective φ) {t : ℕ} {f : Fin t → S}
    (hf : AlgIndep A f) : AlgIndep A (fun k => φ (f k)) := by
  intro c hc
  apply hf c
  apply hφ
  rw [map_sum, map_zero]
  simpa only [map_mul, AlgHom.commutes] using hc
section Domain
variable {A : Type*} [CommRing A] [IsDomain A] {m : Nat}
theorem comap_C_comap_eq_bot (Q : Ideal (MvPolynomial (Fin m) (FractionRing A))) (hQ : Q ≠ ⊤) :
    (Q.comap (MvPolynomial.map (algebraMap A (FractionRing A)))).comap
      (C : A →+* MvPolynomial (Fin m) A) = ⊥ := by
  rw [eq_bot_iff]
  intro a ha
  rw [Ideal.mem_comap, Ideal.mem_comap, MvPolynomial.map_C] at ha
  rw [Ideal.mem_bot]
  by_contra hne
  have hu : IsUnit (C (algebraMap A (FractionRing A) a) : MvPolynomial (Fin m) (FractionRing A)) :=
    (isUnit_iff_ne_zero.mpr
      ((map_ne_zero_iff _ (IsFractionRing.injective A (FractionRing A))).mpr hne)).map C
  exact hQ (Ideal.eq_top_of_isUnit_mem (I := Q) ha hu)
theorem isAlgebraic_X_of_le (P : Ideal (MvPolynomial (Fin m) A))
    (Q : Ideal (MvPolynomial (Fin m) (FractionRing A)))
    (hPQ : P ≤ Q.comap (MvPolynomial.map (algebraMap A (FractionRing A)))) (i : Fin m)
    (hi : IsAlgebraic A (Ideal.Quotient.mk P (X i : MvPolynomial (Fin m) A))) :
    IsAlgebraic (FractionRing A)
      (Ideal.Quotient.mk Q (X i : MvPolynomial (Fin m) (FractionRing A))) := by
  obtain ⟨p, hp0, hp⟩ := hi
  refine ⟨p.map (algebraMap A (FractionRing A)),
    (Polynomial.map_ne_zero_iff (IsFractionRing.injective A (FractionRing A))).mpr hp0, ?_⟩
  have hcomp : (Ideal.quotientMap Q (MvPolynomial.map (algebraMap A (FractionRing A))) hPQ).comp
      (algebraMap A (MvPolynomial (Fin m) A ⧸ P)) =
      (algebraMap (FractionRing A) (MvPolynomial (Fin m) (FractionRing A) ⧸ Q)).comp
        (algebraMap A (FractionRing A)) := by
    ext a
    rw [RingHom.comp_apply, RingHom.comp_apply, Ideal.quotientMap_algebraMap,
      MvPolynomial.algebraMap_eq, MvPolynomial.map_C]
    rfl
  have hX : Ideal.quotientMap Q (MvPolynomial.map (algebraMap A (FractionRing A))) hPQ
      (Ideal.Quotient.mk P (X i)) = Ideal.Quotient.mk Q (X i) := by
    rw [Ideal.quotientMap_mk, MvPolynomial.map_X]
  rw [Polynomial.aeval_def, Polynomial.eval₂_map, ← hcomp, ← hX, ← Polynomial.hom_eval₂,
    ← Polynomial.aeval_def, hp, map_zero]
set_option backward.isDefEq.respectTransparency false in
theorem linearIndependent_quotientMap (P : Ideal (MvPolynomial (Fin m) A))
    (Q : Ideal (MvPolynomial (Fin m) (FractionRing A)))
    (hPQ : P ≤ Q.comap (MvPolynomial.map (algebraMap A (FractionRing A))))
    (hQP : Q.comap (MvPolynomial.map (algebraMap A (FractionRing A))) ≤ P)
    {t : ℕ} (f : Fin t → MvPolynomial (Fin m) A ⧸ P) (hf : AlgIndep A f) :
    LinearIndependent (FractionRing A)
      (fun i => Ideal.quotientMap Q (MvPolynomial.map (algebraMap A (FractionRing A))) hPQ (f i)) := by
  set ρ := Ideal.quotientMap Q (MvPolynomial.map (algebraMap A (FractionRing A))) hPQ with hρ
  have hρinj : Function.Injective ρ := Ideal.quotientMap_injective' hQP
  have hcomp : ∀ a : A, ρ (algebraMap A (MvPolynomial (Fin m) A ⧸ P) a) =
      algebraMap (FractionRing A) (MvPolynomial (Fin m) (FractionRing A) ⧸ Q)
        (algebraMap A (FractionRing A) a) := by
    intro a
    rw [hρ, Ideal.quotientMap_algebraMap, MvPolynomial.algebraMap_eq, MvPolynomial.map_C]
    rfl
  rw [Fintype.linearIndependent_iff]
  intro c hc i
  try dsimp only at hc
  obtain ⟨b, hb⟩ := IsLocalization.exist_integer_multiples_of_finite (nonZeroDivisors A) c
  have hb' : ∀ j, ∃ y : A, algebraMap A (FractionRing A) y = (b : A) • c j :=
    fun j => RingHom.mem_rangeS.mp (hb j)
  choose a ha using hb'
  have hterm : ∀ j, ρ (algebraMap A (MvPolynomial (Fin m) A ⧸ P) (a j) * f j) =
      algebraMap (FractionRing A) (MvPolynomial (Fin m) (FractionRing A) ⧸ Q)
        (algebraMap A (FractionRing A) (b : A)) * (c j • ρ (f j)) := by
    intro j
    have e2 : c j • ρ (f j) =
        algebraMap (FractionRing A) (MvPolynomial (Fin m) (FractionRing A) ⧸ Q) (c j) * ρ (f j) := by
      obtain ⟨y, hy⟩ := Ideal.Quotient.mk_surjective (ρ (f j))
      rw [← hy]
      have h1 : c j • Ideal.Quotient.mk Q y = Ideal.Quotient.mk Q (c j • y) :=
        (Submodule.Quotient.mk_smul Q (c j) y).symm
      rw [h1, MvPolynomial.smul_eq_C_mul, map_mul]
      rfl
    have e3 : (b : A) • c j = algebraMap A (FractionRing A) (b : A) * c j :=
      Algebra.smul_def _ _
    rw [e2, map_mul, hcomp, ha j, e3, map_mul, mul_assoc]
  have hsum : ρ (∑ j, algebraMap A (MvPolynomial (Fin m) A ⧸ P) (a j) * f j) = 0 := by
    rw [map_sum, Finset.sum_congr rfl (fun j _ => hterm j), ← Finset.mul_sum, hc, mul_zero]
  have hsum0 : ∑ j, algebraMap A (MvPolynomial (Fin m) A ⧸ P) (a j) * f j = 0 :=
    hρinj (by rw [hsum, map_zero])
  have hai : a i = 0 := hf a hsum0 i
  have hzero : (b : A) • c i = 0 := by rw [← ha i, hai, map_zero]
  have hzero' : algebraMap A (FractionRing A) (b : A) * c i = 0 :=
    (Algebra.smul_def (b : A) (c i)).symm.trans hzero
  exact (mul_eq_zero.mp hzero').resolve_left
    ((map_ne_zero_iff _ (IsFractionRing.injective A (FractionRing A))).mpr
      (nonZeroDivisors.ne_zero b.2))
attribute [local instance] MvPolynomial.algebraMvPolynomial
theorem rank_sum_le_fiberBound
    (G : Finset (MvPolynomial (Fin m) A)) (e : Nat) (hG : ∀ g ∈ G, g.totalDegree ≤ e)
    (halg : ∀ P ∈ (Ideal.span (G : Set (MvPolynomial (Fin m) A))).minimalPrimes,
      P.comap (C : A →+* MvPolynomial (Fin m) A) = ⊥ →
        ∀ i : Fin m, IsAlgebraic A (Ideal.Quotient.mk P (X i : MvPolynomial (Fin m) A)))
    (S : Finset (Ideal (MvPolynomial (Fin m) A)))
    (hS : ∀ P ∈ S, P ∈ (Ideal.span (G : Set (MvPolynomial (Fin m) A))).minimalPrimes ∧
      P.comap (C : A →+* MvPolynomial (Fin m) A) = ⊥)
    (t : Ideal (MvPolynomial (Fin m) A) → ℕ)
    (ht : ∀ P ∈ S, ∃ f : Fin (t P) → MvPolynomial (Fin m) A ⧸ P, AlgIndep A f) :
    ∑ P ∈ S, t P ≤ fiberBound m e := by
  classical
  set φ : MvPolynomial (Fin m) A →+* MvPolynomial (Fin m) (FractionRing A) :=
    MvPolynomial.map (algebraMap A (FractionRing A)) with hφ
  have hJ' : Ideal.span ((G.image φ : Finset _) : Set (MvPolynomial (Fin m) (FractionRing A))) =
      (Ideal.span (G : Set (MvPolynomial (Fin m) A))).map φ := by
    rw [Ideal.map_span, Finset.coe_image]
  have hdeg : ∀ g ∈ G.image φ, g.totalDegree ≤ e := by
    intro g hg
    rw [Finset.mem_image] at hg
    obtain ⟨g0, hg0, rfl⟩ := hg
    have hsame : (φ g0).totalDegree = g0.totalDegree := by
      rw [hφ]
      unfold MvPolynomial.totalDegree
      rw [MvPolynomial.support_map_of_injective _ (IsFractionRing.injective A (FractionRing A))]
    rw [hsame]
    exact hG g0 hg0
  have hdim : ∀ Q : Ideal (MvPolynomial (Fin m) (FractionRing A)), Q.IsPrime →
      Ideal.span ((G.image φ : Finset _) : Set (MvPolynomial (Fin m) (FractionRing A))) ≤ Q →
        Q.IsMaximal := by
    intro Q hQ hJQ
    haveI := hQ
    rw [hJ', Ideal.map_le_iff_le_comap] at hJQ
    obtain ⟨P, hPmin, hPle⟩ := Ideal.exists_minimalPrimes_le hJQ
    have hbot : P.comap (C : A →+* MvPolynomial (Fin m) A) = ⊥ :=
      le_bot_iff.mp ((Ideal.comap_mono hPle).trans (comap_C_comap_eq_bot Q hQ.ne_top).le)
    haveI : Algebra.IsIntegral (FractionRing A) (MvPolynomial (Fin m) (FractionRing A) ⧸ Q) :=
      quotient_isIntegral_of_X Q fun i =>
        isAlgebraic_iff_isIntegral.mp (isAlgebraic_X_of_le P Q hPle i (halg P hPmin hbot i))
    exact Ideal.Quotient.maximal_of_isField Q
      (isField_of_isIntegral_of_isField' (R := FractionRing A)
        (S := MvPolynomial (Fin m) (FractionRing A) ⧸ Q) (Field.toIsField _))
  obtain ⟨hfinJ, hbound⟩ := finite_and_finrank_le (G.image φ) e hdeg hdim
  haveI : IsLocalization (Submonoid.map (C : A →+* MvPolynomial (Fin m) A) (nonZeroDivisors A))
      (MvPolynomial (Fin m) (FractionRing A)) :=
    MvPolynomial.isLocalization (σ := Fin m) (nonZeroDivisors A) (FractionRing A)
  have hQP : ∀ P ∈ S, (P.map φ).IsPrime ∧ (P.map φ).comap φ = P := by
    intro P hP
    obtain ⟨hPmin, hbot⟩ := hS P hP
    have hPprime : P.IsPrime := hPmin.1.1
    have hdisj : Disjoint ((Submonoid.map (C : A →+* MvPolynomial (Fin m) A) (nonZeroDivisors A) :
        Submonoid (MvPolynomial (Fin m) A)) : Set (MvPolynomial (Fin m) A))
        (P : Set (MvPolynomial (Fin m) A)) := by
      rw [Set.disjoint_left]
      rintro x ⟨a, ha, rfl⟩ hx
      have ha' : a ∈ P.comap (C : A →+* MvPolynomial (Fin m) A) := hx
      rw [hbot, Ideal.mem_bot] at ha'
      exact nonZeroDivisors.ne_zero ha ha'
    exact ⟨IsLocalization.isPrime_of_isPrime_disjoint
        (Submonoid.map (C : A →+* MvPolynomial (Fin m) A) (nonZeroDivisors A))
        (MvPolynomial (Fin m) (FractionRing A)) P hPprime hdisj,
      IsLocalization.under_map_of_isPrime_disjoint
        (Submonoid.map (C : A →+* MvPolynomial (Fin m) A) (nonZeroDivisors A))
        (MvPolynomial (Fin m) (FractionRing A)) hPprime hdisj⟩
  have hle : ∀ P ∈ S, Ideal.span ((G.image φ : Finset _) :
      Set (MvPolynomial (Fin m) (FractionRing A))) ≤ P.map φ := by
    intro P hP
    rw [hJ']
    exact Ideal.map_mono (hS P hP).1.1.2
  have hmax : ∀ P ∈ S, (P.map φ).IsMaximal := fun P hP =>
    hdim _ (hQP P hP).1 (hle P hP)
  haveI := hfinJ
  obtain ⟨hfinQ, hcrt⟩ := sum_finrank_le_of_maximal (K := FractionRing A)
    (Ideal.span ((G.image φ : Finset _) : Set (MvPolynomial (Fin m) (FractionRing A))))
    (S.image fun P => P.map φ) (by
      intro Q hQ
      rw [Finset.mem_image] at hQ
      obtain ⟨P, hP, rfl⟩ := hQ
      exact ⟨hmax P hP, hle P hP⟩)
  have hinj : ∀ P ∈ S, ∀ P' ∈ S, P.map φ = P'.map φ → P = P' := by
    intro P hP P' hP' h
    rw [← (hQP P hP).2, ← (hQP P' hP').2, h]
  rw [Finset.sum_image hinj] at hcrt
  refine le_trans ?_ (hcrt.trans hbound)
  apply Finset.sum_le_sum
  intro P hP
  obtain ⟨f, hf⟩ := ht P hP
  haveI := hfinQ (P.map φ) (Finset.mem_image_of_mem _ hP)
  have hli := linearIndependent_quotientMap P (P.map φ) Ideal.le_comap_map (hQP P hP).2.le f hf
  simpa using hli.fintype_card_le_finrank
end Domain
section Rabinowitsch
variable {A : Type*} [CommRing A] [IsDomain A] {m : Nat}
noncomputable def rabEq (h : MvPolynomial (Fin m) A) : MvPolynomial (Fin (m+1)) A :=
  X 0 * rename Fin.succ h - 1
theorem rab_normal_form (h : MvPolynomial (Fin m) A) (f : MvPolynomial (Fin (m+1)) A) :
    ∃ (k : ℕ) (g : MvPolynomial (Fin m) A),
      rename Fin.succ h ^ k * f - rename Fin.succ g ∈ Ideal.span {rabEq h} := by
  induction f using MvPolynomial.induction_on with
  | C a => exact ⟨0, C a, by simp⟩
  | add p q hp hq =>
    obtain ⟨k1, g1, h1⟩ := hp
    obtain ⟨k2, g2, h2⟩ := hq
    refine ⟨k1 + k2, h ^ k2 * g1 + h ^ k1 * g2, ?_⟩
    have hid : rename Fin.succ h ^ (k1 + k2) * (p + q) -
          rename Fin.succ (h ^ k2 * g1 + h ^ k1 * g2) =
        rename Fin.succ h ^ k2 * (rename Fin.succ h ^ k1 * p - rename Fin.succ g1) +
        rename Fin.succ h ^ k1 * (rename Fin.succ h ^ k2 * q - rename Fin.succ g2) := by
      simp only [map_add, map_mul, map_pow]
      ring
    rw [hid]
    exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ h1) (Ideal.mul_mem_left _ _ h2)
  | mul_X p i hp =>
    obtain ⟨k, g, hg⟩ := hp
    cases i using Fin.cases with
    | zero =>
      refine ⟨k + 1, g, ?_⟩
      have hid : rename Fin.succ h ^ (k + 1) * (p * X 0) - rename Fin.succ g =
          rename Fin.succ h ^ k * p * rabEq h +
            (rename Fin.succ h ^ k * p - rename Fin.succ g) := by
        simp only [rabEq]
        ring
      rw [hid]
      exact Ideal.add_mem _
        (Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_singleton _))) hg
    | succ j =>
      refine ⟨k, g * X j, ?_⟩
      have hid : rename Fin.succ h ^ k * (p * X j.succ) - rename Fin.succ (g * X j) =
          (rename Fin.succ h ^ k * p - rename Fin.succ g) * X j.succ := by
        rw [map_mul, rename_X]
        ring
      rw [hid]
      exact Ideal.mul_mem_right _ _ hg
theorem rename_h_not_mem {h : MvPolynomial (Fin m) A} {Q : Ideal (MvPolynomial (Fin (m+1)) A)}
    (hQ : Q.IsPrime) (hrab : rabEq h ∈ Q) : rename Fin.succ h ∉ Q := by
  intro hmem
  apply hQ.ne_top
  rw [Ideal.eq_top_iff_one]
  have h1 : X 0 * rename Fin.succ h ∈ Q := Q.mul_mem_left _ hmem
  have h2 : (1 : MvPolynomial (Fin (m+1)) A) = X 0 * rename Fin.succ h - rabEq h := by
    simp [rabEq]
  rw [h2]
  exact Q.sub_mem h1 hrab
theorem rab_le_of_comap_le {h : MvPolynomial (Fin m) A}
    {Q Q' : Ideal (MvPolynomial (Fin (m+1)) A)}
    (hQ' : Q'.IsPrime) (hrab : rabEq h ∈ Q) (hrab' : rabEq h ∈ Q')
    (hle : Q.comap (rename Fin.succ : MvPolynomial (Fin m) A →ₐ[A] _) ≤
      Q'.comap (rename Fin.succ : MvPolynomial (Fin m) A →ₐ[A] _)) : Q ≤ Q' := by
  intro f hf
  obtain ⟨k, g, hg⟩ := rab_normal_form h f
  have hspanQ : Ideal.span {rabEq h} ≤ Q := (Ideal.span_singleton_le_iff_mem _).mpr hrab
  have hspanQ' : Ideal.span {rabEq h} ≤ Q' := (Ideal.span_singleton_le_iff_mem _).mpr hrab'
  have hgQ : rename Fin.succ g ∈ Q := by
    have hx := Q.sub_mem (Q.mul_mem_left (rename Fin.succ h ^ k) hf) (hspanQ hg)
    rwa [sub_sub_cancel] at hx
  have hgQ' : rename Fin.succ g ∈ Q' := @hle g hgQ
  have hfQ' : rename Fin.succ h ^ k * f ∈ Q' := by
    have hx := Q'.add_mem (hspanQ' hg) hgQ'
    rwa [sub_add_cancel] at hx
  rcases hQ'.mem_or_mem hfQ' with hpow | hf'
  · exact absurd (hQ'.mem_of_pow_mem k hpow) (rename_h_not_mem hQ' hrab')
  · exact hf'
theorem exists_rab_prime (h : MvPolynomial (Fin m) A) (P : Ideal (MvPolynomial (Fin m) A))
    (hP : P.IsPrime) (hh : h ∉ P) :
    ∃ Q : Ideal (MvPolynomial (Fin (m+1)) A), Q.IsPrime ∧ rabEq h ∈ Q ∧
      Q.comap (rename Fin.succ : MvPolynomial (Fin m) A →ₐ[A] _) = P := by
  haveI := hP
  set hb : FractionRing (MvPolynomial (Fin m) A ⧸ P) :=
    algebraMap (MvPolynomial (Fin m) A ⧸ P) (FractionRing (MvPolynomial (Fin m) A ⧸ P))
      (Ideal.Quotient.mk P h) with hhb
  set ψ : MvPolynomial (Fin (m+1)) A →+* FractionRing (MvPolynomial (Fin m) A ⧸ P) :=
    MvPolynomial.eval₂Hom
      (((algebraMap (MvPolynomial (Fin m) A ⧸ P) (FractionRing (MvPolynomial (Fin m) A ⧸ P))).comp
        (Ideal.Quotient.mk P)).comp C)
      (Fin.cons hb⁻¹ fun j => algebraMap (MvPolynomial (Fin m) A ⧸ P)
        (FractionRing (MvPolynomial (Fin m) A ⧸ P)) (Ideal.Quotient.mk P (X j))) with hψ
  have hcomp : ∀ f : MvPolynomial (Fin m) A, ψ (rename Fin.succ f) =
      algebraMap (MvPolynomial (Fin m) A ⧸ P) (FractionRing (MvPolynomial (Fin m) A ⧸ P))
        (Ideal.Quotient.mk P f) := by
    intro f
    have hext : ψ.comp (rename Fin.succ : MvPolynomial (Fin m) A →ₐ[A] _).toRingHom =
        (algebraMap (MvPolynomial (Fin m) A ⧸ P) (FractionRing (MvPolynomial (Fin m) A ⧸ P))).comp
          (Ideal.Quotient.mk P) := by
      apply MvPolynomial.ringHom_ext
      · intro a
        simp [hψ]
      · intro j
        simp [hψ]
    exact RingHom.congr_fun hext f
  have hb0 : hb ≠ 0 := by
    intro h0
    apply hh
    rw [← Ideal.Quotient.eq_zero_iff_mem]
    exact (map_eq_zero_iff _ (IsFractionRing.injective _ _)).mp h0
  refine ⟨RingHom.ker ψ, RingHom.ker_isPrime ψ, ?_, ?_⟩
  · rw [RingHom.mem_ker, rabEq, map_sub, map_mul, hcomp, map_one, ← hhb]
    have hX0 : ψ (X 0) = hb⁻¹ := by simp [hψ]
    rw [hX0, inv_mul_cancel₀ hb0, sub_self]
  · ext f
    rw [Ideal.mem_comap, RingHom.mem_ker, hcomp,
      map_eq_zero_iff _ (IsFractionRing.injective _ _), Ideal.Quotient.eq_zero_iff_mem]
theorem span_rab_le_iff (G : Set (MvPolynomial (Fin m) A)) (h : MvPolynomial (Fin m) A)
    (Q : Ideal (MvPolynomial (Fin (m+1)) A)) :
    Ideal.span (insert (rabEq h) ((rename Fin.succ :
        MvPolynomial (Fin m) A →ₐ[A] MvPolynomial (Fin (m+1)) A) '' G)) ≤ Q ↔
      rabEq h ∈ Q ∧ Ideal.span G ≤
        Q.comap (rename Fin.succ : MvPolynomial (Fin m) A →ₐ[A] _) := by
  rw [Ideal.span_le, Set.insert_subset_iff, Set.image_subset_iff, Ideal.span_le]
  rfl
theorem comap_C_rab (Q : Ideal (MvPolynomial (Fin (m+1)) A)) :
    Q.comap (C : A →+* MvPolynomial (Fin (m+1)) A) =
      (Q.comap (rename Fin.succ : MvPolynomial (Fin m) A →ₐ[A] _)).comap
        (C : A →+* MvPolynomial (Fin m) A) := by
  ext a
  simp only [Ideal.mem_comap, MvPolynomial.rename_C]
theorem quotient_mem_algebraicClosure (P : Ideal (MvPolynomial (Fin m) A))
    (hX : ∀ j, IsAlgebraic A (Ideal.Quotient.mk P (X j : MvPolynomial (Fin m) A)))
    (f : MvPolynomial (Fin m) A) :
    Ideal.Quotient.mk P f ∈ Subalgebra.algebraicClosure A (MvPolynomial (Fin m) A ⧸ P) := by
  induction f using MvPolynomial.induction_on with
  | C a =>
    show algebraMap A (MvPolynomial (Fin m) A ⧸ P) a ∈ _
    exact Subalgebra.algebraMap_mem _ a
  | add p q hp hq =>
    rw [map_add]
    exact add_mem hp hq
  | mul_X p j hp =>
    rw [map_mul]
    exact mul_mem hp (hX j)
theorem rank_sum_le_fiberBound_away
    (G : Finset (MvPolynomial (Fin m) A)) (h : MvPolynomial (Fin m) A) (d e : Nat)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hh : h.totalDegree ≤ e)
    (halg : ∀ P ∈ (Ideal.span (G : Set (MvPolynomial (Fin m) A))).minimalPrimes, h ∉ P →
      P.comap (C : A →+* MvPolynomial (Fin m) A) = ⊥ →
        ∀ i : Fin m, IsAlgebraic A (Ideal.Quotient.mk P (X i : MvPolynomial (Fin m) A)))
    (S : Finset (Ideal (MvPolynomial (Fin m) A)))
    (hS : ∀ P ∈ S, P ∈ (Ideal.span (G : Set (MvPolynomial (Fin m) A))).minimalPrimes ∧ h ∉ P ∧
      P.comap (C : A →+* MvPolynomial (Fin m) A) = ⊥)
    (t : Ideal (MvPolynomial (Fin m) A) → ℕ)
    (ht : ∀ P ∈ S, ∃ f : Fin (t P) → MvPolynomial (Fin m) A ⧸ P, AlgIndep A f) :
    ∑ P ∈ S, t P ≤ fiberBound (m+1) (max d (e+1)) := by
  classical
  set ι : MvPolynomial (Fin m) A →ₐ[A] MvPolynomial (Fin (m+1)) A := rename Fin.succ with hι
  set G1 : Finset (MvPolynomial (Fin (m+1)) A) := insert (rabEq h) (G.image ι) with hG1
  have hspan : ∀ Q : Ideal (MvPolynomial (Fin (m+1)) A),
      Ideal.span (G1 : Set (MvPolynomial (Fin (m+1)) A)) ≤ Q ↔
        rabEq h ∈ Q ∧ Ideal.span (G : Set (MvPolynomial (Fin m) A)) ≤ Q.comap ι := by
    intro Q
    rw [hG1, Finset.coe_insert, Finset.coe_image]
    exact span_rab_le_iff (G : Set (MvPolynomial (Fin m) A)) h Q
  have hdeg : ∀ g ∈ G1, g.totalDegree ≤ max d (e+1) := by
    intro g hg
    rw [hG1, Finset.mem_insert, Finset.mem_image] at hg
    rcases hg with rfl | ⟨g0, hg0, rfl⟩
    · show (X 0 * rename Fin.succ h - 1 : MvPolynomial (Fin (m+1)) A).totalDegree ≤ _
      refine (totalDegree_sub _ _).trans (max_le ?_ (by simp))
      refine (totalDegree_mul _ _).trans ?_
      rw [totalDegree_X]
      have hr := (totalDegree_rename_le Fin.succ h).trans hh
      exact le_trans (by omega) (le_max_right d (e+1))
    · exact ((totalDegree_rename_le Fin.succ g0).trans (hG g0 hg0)).trans (le_max_left _ _)
  have hcontract : ∀ Q ∈ (Ideal.span (G1 : Set (MvPolynomial (Fin (m+1)) A))).minimalPrimes,
      Q.comap ι ∈ (Ideal.span (G : Set (MvPolynomial (Fin m) A))).minimalPrimes ∧
        rabEq h ∈ Q ∧ h ∉ Q.comap ι := by
    intro Q hQ
    have hQprime : Q.IsPrime := hQ.1.1
    obtain ⟨hrab, hI0⟩ := (hspan Q).mp hQ.1.2
    have hnot : h ∉ Q.comap ι := rename_h_not_mem hQprime hrab
    refine ⟨⟨⟨Ideal.IsPrime.comap ι (hK := hQprime), hI0⟩, ?_⟩, hrab, hnot⟩
    intro P' hP' hle
    have hhP' : h ∉ P' := fun hm => hnot (hle hm)
    obtain ⟨Q', hQ'prime, hrab', hcomap'⟩ := exists_rab_prime h P' hP'.1 hhP'
    have hQ'le : Q' ≤ Q := rab_le_of_comap_le hQprime hrab' hrab (by rw [hcomap']; exact hle)
    have hQ'I : Ideal.span (G1 : Set (MvPolynomial (Fin (m+1)) A)) ≤ Q' :=
      (hspan Q').mpr ⟨hrab', by rw [hcomap']; exact hP'.2⟩
    have hQQ' : Q ≤ Q' := hQ.2 ⟨hQ'prime, hQ'I⟩ hQ'le
    rw [← hcomap']
    exact Ideal.comap_mono hQQ'
  have halg1 : ∀ Q ∈ (Ideal.span (G1 : Set (MvPolynomial (Fin (m+1)) A))).minimalPrimes,
      Q.comap (C : A →+* MvPolynomial (Fin (m+1)) A) = ⊥ →
        ∀ i : Fin (m+1), IsAlgebraic A (Ideal.Quotient.mk Q (X i)) := by
    intro Q hQ hbot
    haveI : Q.IsPrime := hQ.1.1
    obtain ⟨hPmin, hrab, hnot⟩ := hcontract Q hQ
    have hbot0 : (Q.comap ι).comap (C : A →+* MvPolynomial (Fin m) A) = ⊥ := by
      rw [← comap_C_rab]
      exact hbot
    have hX := halg _ hPmin hnot hbot0
    let ρ := Ideal.quotientMapₐ Q ι (le_refl (Q.comap ι))
    have hρ : ∀ f : MvPolynomial (Fin m) A,
        ρ (Ideal.Quotient.mk (Q.comap ι) f) = Ideal.Quotient.mk Q (ι f) := fun f => rfl
    intro i
    cases i using Fin.cases with
    | zero =>
      have hhalg : IsAlgebraic A (Ideal.Quotient.mk Q (ι h)) := by
        rw [← hρ]
        have hmem : IsAlgebraic A (Ideal.Quotient.mk (Q.comap ι) h) :=
          quotient_mem_algebraicClosure _ hX h
        exact hmem.algHom ρ
      have hprod : Ideal.Quotient.mk Q (ι h) * Ideal.Quotient.mk Q (X 0) = 1 := by
        have hz : Ideal.Quotient.mk Q (rabEq h) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr hrab
        rw [rabEq, map_sub, map_mul, map_one, sub_eq_zero] at hz
        rw [mul_comm]
        exact hz
      have hne : Ideal.Quotient.mk Q (ι h) ≠ 0 := by
        intro h0
        rw [h0, zero_mul] at hprod
        exact zero_ne_one hprod
      refine IsAlgebraic.of_mul (mem_nonZeroDivisors_of_ne_zero hne) hhalg ?_
      rw [hprod]
      exact isAlgebraic_one
    | succ j =>
      have hj : Ideal.Quotient.mk Q (X j.succ : MvPolynomial (Fin (m+1)) A) =
          ρ (Ideal.Quotient.mk (Q.comap ι) (X j)) := by
        rw [hρ, hι, rename_X]
      rw [hj]
      exact (hX j).algHom ρ
  have hlift : ∀ P ∈ S, ∃ Q : Ideal (MvPolynomial (Fin (m+1)) A), Q.IsPrime ∧ rabEq h ∈ Q ∧
      Q.comap ι = P := fun P hP =>
    exists_rab_prime h P (hS P hP).1.1.1 (hS P hP).2.1
  choose! Qf hQf using hlift
  have hQfmin : ∀ P ∈ S,
      Qf P ∈ (Ideal.span (G1 : Set (MvPolynomial (Fin (m+1)) A))).minimalPrimes := by
    intro P hP
    obtain ⟨hQprime, hrab, hcomap⟩ := hQf P hP
    obtain ⟨hPmin, _, _⟩ := hS P hP
    refine ⟨⟨hQprime, (hspan _).mpr ⟨hrab, by rw [hcomap]; exact hPmin.1.2⟩⟩, ?_⟩
    intro Q' hQ' hle
    obtain ⟨hrab', hI0'⟩ := (hspan Q').mp hQ'.2
    have hcle : Q'.comap ι ≤ P := by
      rw [← hcomap]
      exact Ideal.comap_mono hle
    have hPle : P ≤ Q'.comap ι :=
      hPmin.2 ⟨Ideal.IsPrime.comap ι (hK := hQ'.1), hI0'⟩ hcle
    exact rab_le_of_comap_le hQ'.1 hrab hrab' (by rw [hcomap]; exact hPle)
  have hinj : ∀ P ∈ S, ∀ P' ∈ S, Qf P = Qf P' → P = P' := by
    intro P hP P' hP' heq
    rw [← (hQf P hP).2.2, ← (hQf P' hP').2.2, heq]
  have hmain := rank_sum_le_fiberBound G1 (max d (e+1)) hdeg halg1 (S.image Qf)
    (by
      intro Q hQ
      rw [Finset.mem_image] at hQ
      obtain ⟨P, hP, rfl⟩ := hQ
      refine ⟨hQfmin P hP, ?_⟩
      rw [comap_C_rab, (hQf P hP).2.2]
      exact (hS P hP).2.2)
    (fun Q => t (Q.comap ι))
    (by
      intro Q hQ
      rw [Finset.mem_image] at hQ
      obtain ⟨P, hP, rfl⟩ := hQ
      obtain ⟨_, _, hcomap⟩ := hQf P hP
      obtain ⟨f, hf⟩ := ht P hP
      have hle : P ≤ (Qf P).comap ι := hcomap.ge
      have hρinj : Function.Injective (Ideal.quotientMapₐ (Qf P) ι hle) :=
        Ideal.quotientMap_injective' (H := hle) hcomap.le
      show ∃ f' : Fin (t ((Qf P).comap ι)) → MvPolynomial (Fin (m+1)) A ⧸ Qf P, AlgIndep A f'
      rw [hcomap]
      exact ⟨_, hf.map (Ideal.quotientMapₐ (Qf P) ι hle) hρinj⟩)
  rw [Finset.sum_image hinj] at hmain
  calc ∑ P ∈ S, t P = ∑ P ∈ S, t ((Qf P).comap ι) :=
        Finset.sum_congr rfl (fun P hP => by rw [(hQf P hP).2.2])
    _ ≤ fiberBound (m+1) (max d (e+1)) := hmain
end Rabinowitsch
section Corollaries
variable {A : Type*} [CommRing A] [IsDomain A] {m : Nat}
def AwayAlgebraic (G : Finset (MvPolynomial (Fin m) A)) (h : MvPolynomial (Fin m) A) : Prop :=
  ∀ P ∈ (Ideal.span (G : Set (MvPolynomial (Fin m) A))).minimalPrimes, h ∉ P →
    P.comap (C : A →+* MvPolynomial (Fin m) A) = ⊥ →
      ∀ i : Fin m, IsAlgebraic A (Ideal.Quotient.mk P (X i : MvPolynomial (Fin m) A))
theorem card_components_le
    (G : Finset (MvPolynomial (Fin m) A)) (h : MvPolynomial (Fin m) A) (d e : Nat)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hh : h.totalDegree ≤ e) (halg : AwayAlgebraic G h)
    (S : Finset (Ideal (MvPolynomial (Fin m) A)))
    (hS : ∀ P ∈ S, P ∈ (Ideal.span (G : Set (MvPolynomial (Fin m) A))).minimalPrimes ∧ h ∉ P ∧
      P.comap (C : A →+* MvPolynomial (Fin m) A) = ⊥) :
    S.card ≤ fiberBound (m+1) (max d (e+1)) := by
  have hmain := rank_sum_le_fiberBound_away G h d e hG hh halg S hS (fun _ => 1) (by
    intro P hP
    refine ⟨fun _ => 1, ?_⟩
    intro c hc i
    rw [Fin.sum_univ_one, mul_one] at hc
    have hc' : Ideal.Quotient.mk P (C (c 0) : MvPolynomial (Fin m) A) = 0 := hc
    rw [Ideal.Quotient.eq_zero_iff_mem] at hc'
    have hmem : c 0 ∈ P.comap (C : A →+* MvPolynomial (Fin m) A) := hc'
    rw [(hS P hP).2.2, Ideal.mem_bot] at hmem
    rw [Fin.fin_one_eq_zero i]
    exact hmem)
  simpa using hmain
theorem exists_relation_natDegree_le
    (G : Finset (MvPolynomial (Fin m) A)) (h : MvPolynomial (Fin m) A) (d e : Nat)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hh : h.totalDegree ≤ e) (halg : AwayAlgebraic G h)
    (P : Ideal (MvPolynomial (Fin m) A))
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin m) A))).minimalPrimes ∧ h ∉ P ∧
      P.comap (C : A →+* MvPolynomial (Fin m) A) = ⊥)
    (y : MvPolynomial (Fin m) A ⧸ P) (hy : IsAlgebraic A y) :
    ∃ q : Polynomial A, q ≠ 0 ∧ q.natDegree ≤ fiberBound (m+1) (max d (e+1)) ∧
      Polynomial.aeval y q = 0 := by
  classical
  have hex : ∃ k : ℕ, ∃ q : Polynomial A, q ≠ 0 ∧ q.natDegree ≤ k ∧ Polynomial.aeval y q = 0 := by
    obtain ⟨q, hq0, hq⟩ := hy
    exact ⟨q.natDegree, q, hq0, le_rfl, hq⟩
  obtain ⟨q, hq0, hqdeg, hq⟩ := Nat.find_spec hex
  have hli : AlgIndep A (fun i : Fin (Nat.find hex) => y ^ (i : ℕ)) := by
    intro c hc
    by_contra hne
    push_neg at hne
    obtain ⟨i0, hi0⟩ := hne
    set q' : Polynomial A := ∑ i : Fin (Nat.find hex), Polynomial.C (c i) * Polynomial.X ^ (i : ℕ)
      with hq'
    have hq'coeff : q'.coeff i0 = c i0 := by
      rw [hq', Polynomial.finset_sum_coeff]
      simp only [Polynomial.coeff_C_mul_X_pow]
      rw [Finset.sum_eq_single i0]
      · simp
      · intro j _ hj
        rw [if_neg]
        intro hji
        exact hj (Fin.ext hji.symm)
      · simp
    have hq'0 : q' ≠ 0 := by
      intro h0
      rw [h0, Polynomial.coeff_zero] at hq'coeff
      exact hi0 hq'coeff.symm
    have hq'deg : q'.natDegree ≤ Nat.find hex - 1 := by
      rw [hq']
      apply Polynomial.natDegree_sum_le_of_forall_le
      intro i _
      refine (Polynomial.natDegree_C_mul_X_pow_le _ _).trans ?_
      have := i.isLt
      omega
    have hq'ev : Polynomial.aeval y q' = 0 := by
      rw [hq', map_sum]
      refine (Finset.sum_congr rfl fun i _ => ?_).trans hc
      rw [map_mul, Polynomial.aeval_C, Polynomial.aeval_X_pow]
    have hpos : 0 < Nat.find hex := by
      have := i0.isLt
      omega
    exact Nat.find_min hex (by omega : Nat.find hex - 1 < Nat.find hex) ⟨q', hq'0, hq'deg, hq'ev⟩
  have hbound := rank_sum_le_fiberBound_away G h d e hG hh halg {P}
    (by intro P' hP'; rw [Finset.mem_singleton] at hP'; subst hP'; exact hP)
    (fun _ => Nat.find hex)
    (by intro P' hP'; rw [Finset.mem_singleton] at hP'; subst hP'; exact ⟨_, hli⟩)
  rw [Finset.sum_singleton] at hbound
  exact ⟨q, hq0, hqdeg.trans hbound, hq⟩
end Corollaries
