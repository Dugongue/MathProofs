def sweep {n:ℕ} (A:Matrix (Fin n) (Fin n) K) : ℕ→(Vector K n×CPolynomial K)×ℕ
  | 0=>((Vector.replicate n 0,1),0)
  | i+1=>let s:=sweep A i
         if hi:i < n then
           let r:=update A (Pi.single ⟨i,hi⟩ 1) s.1
           (r.1,s.2+r.2)
         else s
theorem sweep_value {n:ℕ} (A:Matrix (Fin n) (Fin n) K) (i:ℕ) :
    (read (sweep A i).1.1,(sweep A i).1.2.toPoly)=
      Problem18DeterministicCyclicSweep20261001.sweep A.toLin' i := by
  induction i with
  | zero=>
    simp only [sweep,Problem18DeterministicCyclicSweep20261001.sweep,CPolynomial.toPoly_one,Prod.mk.injEq,and_true]
    funext j
    change (Vector.replicate n (0:K))[j.val]=0
    simp
  | succ i ih=>
    simp only [sweep,Problem18DeterministicCyclicSweep20261001.sweep]
    split_ifs
    · rw [update_value,ih]
    · exact ih
def cyclicVector {n:ℕ} (A:Matrix (Fin n) (Fin n) K) : Vector K n×ℕ :=
  let s:=sweep A n
  (s.1.1,s.2)
theorem cyclicVector_correct {n:ℕ} (A:Matrix (Fin n) (Fin n) K) (hs:Squarefree A.charpoly) :
    Problem18CyclicPrimaryVectors20260930.PolynomiallyCyclic A.toLin' (read (cyclicVector A).1) := by
  have hv:=congrArg Prod.fst (sweep_value A n)
  change read (cyclicVector A).1=Problem18DeterministicCyclicSweep20261001.cyclicVector A.toLin' at hv
  rw [hv]
  apply Problem18DeterministicCyclicSweep20261001.cyclicVector_correct
  simpa only [Matrix.charpoly_toLin'] using hs
