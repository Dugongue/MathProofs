variable {K V W ι : Type*} [Field K] [Fintype K] [StarRing K] [Fintype ι]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  [AddCommGroup W] [Module K W] [FiniteDimensional K W]
set_option backward.isDefEq.respectTransparency false
def SelectedEvent (g : ι→(fixedField (starRingAut : K ≃+* K))[X])
    (T : Module.End K (V×W)) : Prop :=
  ∀ i, (g i).map (algebraMap (fixedField (starRingAut : K ≃+* K)) K) ∣ T.charpoly ∧
    IsCoprime ((g i).map (algebraMap (fixedField (starRingAut : K ≃+* K)) K))
      (T.charpoly/((g i).map (algebraMap (fixedField (starRingAut : K ≃+* K)) K)))
theorem selected_joint_estimate
    (hcard : Nat.card K=Nat.card (fixedField (starRingAut : K ≃+* K))^2)
    (hstar : ∀ a : K,star a=a^Nat.card (fixedField (starRingAut : K ≃+* K)))
    (B : V →ₗ⋆[K] V →ₗ[K] K) (C : W →ₗ⋆[K] W →ₗ[K] K)
    (hB : B.IsSymm) (hnB : B.Nondegenerate) (hC : C.IsSymm) (hnC : C.Nondegenerate)
    (g : ι→(fixedField (starRingAut : K ≃+* K))[X])
    (hm : ∀ i,(g i).Monic) (hi : ∀ i,Irreducible (g i)) (hinj : Function.Injective g)
    (hd : Module.finrank K V=∑ i,(g i).natDegree) (hc : 1≤Module.finrank K W)
    (D : ℕ) (hlo : ∀ i,D≤(g i).natDegree) (hhi : ∀ i,2*(g i).natDegree≤Module.finrank K W) :
    |((Nat.card {T : SelfAdjointOperators (starRingAut : K ≃+* K)
        (sumForm (starRingAut : K ≃+* K) B C) // SelectedEvent g T.val} : ℝ)/
      Nat.card (SelfAdjointOperators (starRingAut : K ≃+* K) (sumForm (starRingAut : K ≃+* K) B C)))*
      (∏ i,if Odd (g i).natDegree then
        Nat.card (fixedField (starRingAut : K ≃+* K))^(g i).natDegree+1
        else Nat.card (fixedField (starRingAut : K ≃+* K))^(g i).natDegree-1)-1| ≤
    2/((Nat.card (fixedField (starRingAut : K ≃+* K)) : ℝ)^(Module.finrank K W))+
      (22*Nat.card ι)/((Nat.card (fixedField (starRingAut : K ≃+* K)) : ℝ)^(D/2)) := by
  let F := fixedField (starRingAut : K ≃+* K)
  letI : Fintype F := Fintype.ofFinite _
  let f := ∏ i,g i
  have hcop := selected_coprime g hm hi hinj
  have hfm : f.Monic := monic_prod_of_monic _ _ (fun i _=>hm i)
  have hfs : Squarefree f := by
    apply Finset.squarefree_prod_of_pairwise_isCoprime
    · intro i _ j _ hij
      exact (hcop hij).isRelPrime
    · intro i _
      exact (hi i).squarefree
  have hfd : Module.finrank K V=f.natDegree := by
    rw [hd]
    exact (natDegree_prod_of_monic _ _ (fun i _=>hm i)).symm
  let e := selectedFactorEquiv g hm hi hinj
  have hl : ∀ j : FactorIndex f,D≤j.val.natDegree := by
    intro j
    obtain ⟨i,rfl⟩ := e.surjective j
    exact hlo i
  have hh : ∀ j : FactorIndex f,2*j.val.natDegree≤Module.finrank K W := by
    intro j
    obtain ⟨i,rfl⟩ := e.surjective j
    exact hhi i
  have hevent (T : Module.End K (V×W)) :
      (f.map (algebraMap F K) ∣ T.charpoly ∧
        IsCoprime (f.map (algebraMap F K)) (T.charpoly/(f.map (algebraMap F K)))) ↔ SelectedEvent g T := by
    have hg0 (i : ι) : (g i).map (algebraMap F K)≠0 := (hm i).map (algebraMap F K) |>.ne_zero
    have hc' : Pairwise (fun i j=>IsCoprime ((g i).map (algebraMap F K)) ((g j).map (algebraMap F K))) := by
      intro i j hij
      exact (hcop hij).map (Polynomial.mapRingHom (algebraMap F K))
    simpa only [f,Polynomial.map_prod,SelectedEvent] using
      Mathproof.Problem18SimpleProductEvent20261001.simple_product_iff
        (fun i=>(g i).map (algebraMap F K)) hg0 hc' T.charpoly
  have hcount : Nat.card (IntrinsicOperators B C (f.map (algebraMap F K)))=
      Nat.card {T : SelfAdjointOperators (starRingAut : K ≃+* K)
        (sumForm (starRingAut : K ≃+* K) B C) // SelectedEvent g T.val} :=
    Nat.card_congr (Equiv.subtypeEquiv (Equiv.refl _) (fun T=>hevent T.val))
  have hw : localWeightProduct f=∏ i,if Odd (g i).natDegree then Nat.card F^(g i).natDegree+1
      else Nat.card F^(g i).natDegree-1 :=
    selected_weight_product g hm hi hinj (fun p=>if Odd p.natDegree then Nat.card F^p.natDegree+1 else Nat.card F^p.natDegree-1)
  have hn : Nat.card (FactorIndex f)=Nat.card ι := selected_factor_card g hm hi hinj
  have hb := intrinsic_joint_estimate hcard hstar B C hB hnB hC hnC f hfm hfs hfd hc D hl hh
  rw [hcount,hw,hn] at hb
  exact hb
end
end Mathproof.Problem18HermitianSelectedJoint20261001
