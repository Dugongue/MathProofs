    apply commutantAlgHom_injective (pairAlgebra H T)
    rw [embed_commutantAdjoint, map_add, adjoint_add, map_add,
      embed_commutantAdjoint, embed_commutantAdjoint]
  map_mul' f g := by
    apply commutantAlgHom_injective (pairAlgebra H T)
    rw [embed_commutantAdjoint, map_mul, adjoint_mul, map_mul,
      ← embed_commutantAdjoint, ← embed_commutantAdjoint]
    rw [← map_mul, ← map_mul, commutant_mul_comm]
