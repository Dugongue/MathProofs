variable [StarRing K] {i : Type*} [Fintype i] [DecidableEq i]
def IsUnitary (P : Matrix i i K) : Prop := Pᴴ * P = 1
theorem unitary_mul_conjTranspose {P : Matrix i i K} (hP : IsUnitary P) :
    P * Pᴴ = 1 :=
  mul_eq_one_comm.mp hP
def IsScalar (X : Matrix i i K) : Prop :=
  ∃ c : K, X = c • (1 : Matrix i i K)
omit [StarRing K] in
theorem scalar_of_generates (s : Set (Matrix i i K)) (X : Matrix i i K)
    (hgen : Algebra.adjoin K s = ⊤)
    (hcomm : ∀ M ∈ s, X * M = M * X) : IsScalar X := by
  have hle : Algebra.adjoin K s ≤ Subalgebra.centralizer K {X} := by
    apply Algebra.adjoin_le
    intro M hM
    exact (Subalgebra.mem_centralizer_iff K).mpr (by
      intro Y hY
      obtain rfl : Y = X := Set.mem_singleton_iff.mp hY
      exact hcomm M hM)
  rw [hgen] at hle
  obtain ⟨c, hc⟩ := Matrix.mem_range_scalar_of_commute_single (M := X)
    (fun a b _ => ((Subalgebra.mem_centralizer_iff K).mp
      (hle (show Matrix.single a b (1 : K) ∈ (⊤ : Subalgebra K (Matrix i i K))
        from trivial)) X (by simp)).symm)
  refine ⟨c, ?_⟩
  rw [← hc]
  ext a b
  by_cases hab : a = b <;> simp [Matrix.scalar, Matrix.diagonal, hab]
