    unfold capFlatN; exact Nat.mul_le_mul hbS hbS
  have hG : c ≤ capGenN a b c := by
    unfold capGenN
    calc c ≤ dimSumN a b c := hcS
      _ = dimSumN a b c * 1 := by ring
      _ ≤ dimSumN a b c * dimSumN a b c := Nat.mul_le_mul_left _ hS1
  have hN2 : (b*b)*(b*b) ≤ capFlatN a b c * capFlatN a b c := Nat.mul_le_mul hN hN
  have hN3 : (b*b)*(c+1)*(b*b) ≤ capFlatN a b c * (capGenN a b c + 1) * capFlatN a b c :=
    Nat.mul_le_mul (Nat.mul_le_mul hN (by omega)) hN
