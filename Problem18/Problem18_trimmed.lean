def OneBitRun (c : Com) (P T : Polynomial Nat) (xs : List Nat) (b : Bool) : Prop :=
  ∃ (ext : String → Nat) (tau : Env) (cost : Nat),
    cost ≤ T.eval (bitSize xs) ∧
    Run (2 ^ (P.eval (bitSize xs) + bitSize xs + 1)) c
      (initEnv ext (xs.length :: xs)) tau cost ∧
    tau.out = answerWords (some b)
def RoutedBitCorrect (cutoff : Nat) (words : List Nat) (result : Bool) : Prop :=
  (words = [0] → result = false) ∧
  ∀ (K : Type) [Field K] [Fintype K] [BEq K] [LawfulBEq K]
    [DecidableEq K] (F : FieldPresentation K) (u : Bool)
    (q a b c : Nat), validSize K u q → 0 < a → 0 < b → 0 < c →
    ∀ A : RectTensor a b c K,
      words =
        [0,u.toNat,q,F.p,F.e,a,b,c] ++
          Mathproof.Problem18IMPSourceDispatch20261001.routeWords
            cutoff 0 a b c ++
          (List.finRange F.e).map (fun i => (F.modulus i).val) ++
          tensorCoordinates F A →
      result = Mathproof.Problem18TypedSourceCheck20261001.sourceCheck
        cutoff u q A
noncomputable def extractedDecision {valid : List Nat → Prop}
    (c : Com) (P T : Polynomial Nat) (spec : List Nat → Bool → Prop)
    (total : ∀ xs, valid xs → ∃ b, OneBitRun c P T xs b ∧ spec xs b) :
    List Nat → Bool := by
  classical
  exact fun xs => if h : valid xs then Classical.choose (total xs h) else false
theorem extractedDecision_run {valid : List Nat → Prop}
    (c : Com) (P T : Polynomial Nat) (spec : List Nat → Bool → Prop)
    (total : ∀ xs, valid xs → ∃ b, OneBitRun c P T xs b ∧ spec xs b)
    (xs : List Nat) (hx : valid xs) :
    OneBitRun c P T xs (extractedDecision c P T spec total xs) := by
  unfold extractedDecision
  simp only [dif_pos hx]
  exact (Classical.choose_spec (total xs hx)).1
theorem extractedDecision_spec {valid : List Nat → Prop}
    (c : Com) (P T : Polynomial Nat) (spec : List Nat → Bool → Prop)
    (total : ∀ xs, valid xs → ∃ b, OneBitRun c P T xs b ∧ spec xs b)
    (xs : List Nat) (hx : valid xs) :
    spec xs (extractedDecision c P T spec total xs) := by
  unfold extractedDecision
  simp only [dif_pos hx]
  exact (Classical.choose_spec (total xs hx)).2
theorem extractedDecision_ramPolytimeOn {valid : List Nat → Prop}
    (c : Com) (L : Layout) (P T : Polynomial Nat)
    (spec : List Nat → Bool → Prop) (hok : Com.Ok L c)
    (total : ∀ xs, valid xs → ∃ b, OneBitRun c P T xs b ∧ spec xs b) :
    RamPolytimeOn valid
      (resultWords (extractedDecision c P T spec total)) := by
  apply ramPolytimeOn_of_bounded_imp valid L c
    (resultWords (extractedDecision c P T spec total)) P T hok
  intro xs hx
  obtain ⟨ext,tau,cost,hcost,hr,hout⟩ :=
    extractedDecision_run c P T spec total xs hx
  exact ⟨ext,tau,hr.mono hcost,by simpa [resultWords] using hout⟩
end Mathproof.Problem18P36ControllerExtraction20261004
