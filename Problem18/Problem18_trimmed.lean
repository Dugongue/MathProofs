      IsDedekindDomain.HeightOneSpectrum.residueHom (K := K) v
        (finiteAdeleLocalResidueToSubring k K D v a)
    map_add' := fun a b => by
      rw [← map_add]
      congr 1
      simp [finiteAdeleLocalResidueToSubring, mul_add]
    map_smul' := fun c a => by
      let π : K := Classical.choose (v.valuation_exists_uniformizer K)
