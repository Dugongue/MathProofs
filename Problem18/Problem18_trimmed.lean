variable {K : Type*} [Field K] [Fintype K] {n : ℕ}
theorem finrank_add_orthogonal (σ : K ≃+* K)
    (B : (Fin n → K) →ₛₗ[(σ : K →+* K)] (Fin n → K) →ₗ[K] K)
    (hB : B.Nondegenerate) (W : Submodule K (Fin n → K)) :
    finrank K W+finrank K (W.orthogonalBilin B)=n := by
  classical
  let k := finrank K W
  let b := Module.finBasis K W
  let u : Fin k → (Fin n → K) := fun i => (b i).val
  have hu : LinearIndependent K u := b.linearIndependent.map' W.subtype W.ker_subtype
  have hs : Submodule.span K (Set.range u)=W := by
    apply Submodule.eq_of_le_of_finrank_eq
    · apply Submodule.span_le.mpr
      rintro x ⟨i,rfl⟩
      exact (b i).property
    · rw [finrank_span_eq_card hu,Fintype.card_fin]
  let f : (Fin n → K) →ₗ[K] (Fin k → K) :=
    { toFun := fun x i => B (u i) x
      map_add' := by intro x y; funext i; exact map_add (B (u i)) x y
      map_smul' := by intro a x; funext i; exact map_smul (B (u i)) a x }
  have hk : k≤n := by simpa [k] using Submodule.finrank_le W
  have hf : Function.Surjective f := by
    intro a
    have hc := sesquiPairingFiber_card σ hk B hB u hu a
    have hp : 0<Nat.card (SesquiPairingFiber σ B u a) := by rw [hc]; positivity
    obtain ⟨x⟩ := (Nat.card_pos_iff.mp hp).1
    exact ⟨x.val,funext x.property⟩
  have hker : LinearMap.ker f=W.orthogonalBilin B := by
    ext x
    constructor
    · intro hx w hw
      have hspan : Submodule.span K (Set.range u)≤LinearMap.ker (B.flip x) := by
        apply Submodule.span_le.mpr
        rintro v ⟨i,rfl⟩
        exact congrFun hx i
      rw [hs] at hspan
      exact hspan hw
    · intro hx
      funext i
      exact hx (u i) (by rw [← hs]; exact Submodule.subset_span (Set.mem_range_self i))
  have hdim := f.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hf,finrank_top,hker,
    Module.finrank_fintype_fun_eq_card,Fintype.card_fin,
    Module.finrank_fintype_fun_eq_card,Fintype.card_fin] at hdim
  exact hdim
theorem small_witness (σ : K ≃+* K)
    (B : (Fin n → K) →ₛₗ[(σ : K →+* K)] (Fin n → K) →ₗ[K] K)
    (hB : B.Nondegenerate) (H T : Module.End K (Fin n → K))
    (hH : ∀x y,B (H x) y=B x (H y)) (hT : ∀x y,B (T x) y=B x (T y))
    (U : Submodule K (Fin n → K)) (hU : U≠⊥) (hUp : U≠⊤)
    (hUH : Preserves U H) (hUT : Preserves U T) :
    ∃ W : Submodule K (Fin n → K), W≠⊥ ∧ 2*finrank K W≤n ∧
      Preserves W H ∧ Preserves W T ∧
      (W ⊓ W.orthogonalBilin B=⊥ ∨ W≤W.orthogonalBilin B) := by
  have hs : ∃ L : Submodule K (Fin n → K), L≠⊥ ∧ 2*finrank K L≤n ∧
      Preserves L H ∧ Preserves L T := by
    by_cases hk : 2*finrank K U≤n
    · exact ⟨U,hU,hk,hUH,hUT⟩
    · have hd := finrank_add_orthogonal σ B hB U
      refine ⟨U.orthogonalBilin B,?_,by omega,
