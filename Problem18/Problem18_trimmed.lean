    Nat.card {T : selfAdjointSpace τ B // mixedCoordinates τ eps B hsym E Z D T=u}*
      (Nat.card K^Z.card*Nat.card (diagonalSpace τ eps)^D.card)=
        Nat.card (selfAdjointSpace τ B) := by
  letI : Finite (Module.End K (Fin n → K)) := Finite.of_injective
    (fun T : Module.End K (Fin n → K) => (T : _ → _)) DFunLike.coe_injective
  have h := Mathproof.Problem18AdditiveFiberCount20260930.surjective_fiber_card_mul
    (mixedCoordinates τ eps B hsym E Z D)
    (mixedCoordinates_surjective τ eps hτ heps B hB hsym E hE Z D) u
  simpa only [Nat.card_prod,Nat.card_eq_fintype_card,Fintype.card_fun,Fintype.card_coe,Fintype.card_prod] using h
