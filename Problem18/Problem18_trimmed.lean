  letI : Fintype F₀ := Fintype.ofFinite _
  letI : Finite V := Finite.of_injective (Module.finBasis K V).equivFun (Module.finBasis K V).equivFun.injective
  letI : Finite W := Finite.of_injective (Module.finBasis K W).equivFun (Module.finBasis K W).equivFun.injective
  letI : Finite (V ≃ₗ[K] V) := Finite.of_injective (fun e : V ≃ₗ[K] V => (e : V→V)) DFunLike.coe_injective
  letI : Finite (W ≃ₗ[K] W) := Finite.of_injective (fun e : W ≃ₗ[K] W => (e : W→W)) DFunLike.coe_injective
  letI : Nonempty (Isometries (starRingAut : K ≃+* K) B) := ⟨⟨LinearEquiv.refl K V,fun _ _=>rfl⟩⟩
  letI : Nonempty (Isometries (starRingAut : K ≃+* K) C) := ⟨⟨LinearEquiv.refl K W,fun _ _=>rfl⟩⟩
  let gb : ℝ := Nat.card (Isometries (starRingAut : K ≃+* K) B)
  let gc : ℝ := Nat.card (Isometries (starRingAut : K ≃+* K) C)
  have hgb : 0<gb := by
    dsimp only [gb]
    exact_mod_cast (Nat.card_pos (α:=Isometries (starRingAut : K ≃+* K) B))
  have hgc : 0<gc := by
    dsimp only [gc]
    exact_mod_cast (Nat.card_pos (α:=Isometries (starRingAut : K ≃+* K) C))
  have hi' := Mathproof.Problem18SpectralOccurrenceCount20261001.occurrence_card_mul_le
    (starRingAut : K ≃+* K) B C hnB h
  have hs' := Mathproof.Problem18HermitianIrreducibleCount20261001.irreducible_card_mul_le
    hcard hstar h hm hi B hB hnB hd
  have hiR : (Nat.card (Mathproof.Problem18SpectralOccurrenceCount20261001.OccurrenceOperators
      (starRingAut : K ≃+* K) B C h) : ℝ)*gb*gc ≤
    (Nat.card (Mathproof.Problem18SpectralJointCount20260930.SourceOperators (starRingAut : K ≃+* K) B h) : ℝ)*
      Nat.card (Isometries (starRingAut : K ≃+* K) (sumForm (starRingAut : K ≃+* K) B C))*
        Nat.card (SelfAdjointOperators (starRingAut : K ≃+* K) C) := by
    dsimp only [gb,gc]
    exact_mod_cast hi'
  have hsR : (Nat.card (Mathproof.Problem18SpectralJointCount20260930.SourceOperators (starRingAut : K ≃+* K) B h) : ℝ)*
      (Nat.card F₀ : ℝ)^h.natDegree≤gb := by
    dsimp only [gb,F₀]
    exact_mod_cast hs'
  have hratio := order_sample_ratio_le (F:=F₀) hcard hstar (sumForm (starRingAut : K ≃+* K) B C) C
    hsA hnA.1 hC hnC.1 (by rw [Module.finrank_prod]; omega) hc
  have hmul := mul_le_mul_of_nonneg_right hiR (show (0:ℝ)≤(Nat.card F₀ : ℝ)^h.natDegree by positivity)
  have hsource := mul_le_mul_of_nonneg_right hsR
    (show (0:ℝ)≤(Nat.card (Isometries (starRingAut : K ≃+* K) (sumForm (starRingAut : K ≃+* K) B C)):ℝ)*
      Nat.card (SelfAdjointOperators (starRingAut : K ≃+* K) C) by positivity)
  have hscale := mul_le_mul_of_nonneg_left hratio (le_of_lt hgb)
  apply le_of_mul_le_mul_left (a:=gb*gc) _ (mul_pos hgb hgc)
  nlinarith [hmul,hsource,hscale]
