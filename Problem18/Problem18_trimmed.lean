def restrictionLocalHom (Q : Place k L) :
    (restrictPlace k F L Q).toValuationSubring →ₐ[k] Q.toValuationSubring where
  toFun x := ⟨algebraMap F L x.val,(mem_restrictPlace k F L Q x.val).mp x.property⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' x y := Subtype.ext (map_mul _ _ _)
  map_zero' := Subtype.ext (map_zero _)
  map_add' x y := Subtype.ext (map_add _ _ _)
  commutes' c := Subtype.ext (IsScalarTower.algebraMap_apply k F L c).symm
instance restrictionLocalHom_isLocal (Q : Place k L) : IsLocalHom (restrictionLocalHom k F L Q) where
  map_nonunit x hx := by
    by_contra hn
    have hz : IsLocalRing.residue (restrictPlace k F L Q).toValuationSubring x=0 :=
      (IsLocalRing.residue_eq_zero_iff x).mpr hn
    have hp := (residue_zero_iff (restrictPlace k F L Q) x).mp hz
    have hq : Q.valuation (algebraMap F L x.val)<1 :=
      (restrictPlace_valuation_isEquiv k F L Q).lt_one_iff_lt_one.mp hp
    have hr : IsLocalRing.residue Q.toValuationSubring (restrictionLocalHom k F L Q x)=0 :=
      (residue_zero_iff Q _).mpr hq
    have hu := hx.map (IsLocalRing.residue Q.toValuationSubring)
    rw [hr] at hu
    exact not_isUnit_zero hu
def restrictionResidueHom (Q : Place k L) :
    (restrictPlace k F L Q).residueField →ₐ[k] Q.residueField :=
  IsLocalRing.ResidueField.mapAlgHom (restrictionLocalHom k F L Q)
theorem restriction_degree_dvd [Finite k] (Q : Place k L) [Finite Q.residueField] :
    (restrictPlace k F L Q).degree ∣ Q.degree := by
  exact FiniteField.nonempty_algHom_iff_finrank_dvd.mp ⟨restrictionResidueHom k F L Q⟩
variable (E : Type*) [Field E] [Finite E] [Algebra k E] [Algebra E L] [IsScalarTower k E L]
theorem rational_restriction_degree_dvd (Q : Place E L) (hQ : Q.degree=1) :
    (restrictPlace k F L (forgetConstants k E L Q)).degree ∣ finrank k E := by
  letI : Finite k := Finite.of_injective (algebraMap k E) (algebraMap k E).injective
  letI : FiniteDimensional E Q.residueField := Module.finite_of_finrank_pos (by change 0<Q.degree; omega)
  letI : Finite Q.residueField := Module.finite_of_finite E
  letI : Algebra k Q.toValuationSubring := (forgetConstants k E L Q).algebraValuationSubring
  letI : Algebra k Q.residueField := inferInstance
  letI : IsScalarTower k E Q.residueField := IsScalarTower.of_algebraMap_eq fun c => by
    change IsLocalRing.residue Q.toValuationSubring (algebraMap k Q.toValuationSubring c)=
      algebraMap E Q.residueField (algebraMap k E c)
    rw [IsScalarTower.algebraMap_apply E Q.toValuationSubring Q.residueField]
    congr 1
    apply Subtype.ext
    exact IsScalarTower.algebraMap_apply k E L c
  letI : Finite (forgetConstants k E L Q).residueField := by
    change Finite Q.residueField
    infer_instance
  have hd := restriction_degree_dvd k F L (forgetConstants k E L Q)
  have hf : (forgetConstants k E L Q).degree=finrank k E := by
    change finrank k Q.residueField=finrank k E
    rw [← Module.finrank_mul_finrank k E Q.residueField]
    change finrank k E*Q.degree=finrank k E
    rw [hQ,mul_one]
  exact hf ▸ hd
end Mathproof.Problem18PlaceResidueRestriction20260930
