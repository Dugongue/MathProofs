    (B : V →ₗ⋆[K] V →ₗ[K] K) (C : W →ₗ⋆[K] W →ₗ[K] K)
    (hB : B.IsSymm) (hnB : B.Nondegenerate) (hC : C.IsSymm) (hnC : C.Nondegenerate)
    (hc : 1≤Module.finrank K W) :
    |((Nat.card (Isometries (starRingAut : K ≃+* K) (sumForm (starRingAut : K ≃+* K) B C)) : ℝ)*
      Nat.card (SelfAdjointOperators (starRingAut : K ≃+* K) C))/
      ((Nat.card (Isometries (starRingAut : K ≃+* K) C) : ℝ)*
        Nat.card (SelfAdjointOperators (starRingAut : K ≃+* K) (sumForm (starRingAut : K ≃+* K) B C)))-1| ≤
      2/((Nat.card (fixedField (starRingAut : K ≃+* K)) : ℝ)^(Module.finrank K W)) := by
