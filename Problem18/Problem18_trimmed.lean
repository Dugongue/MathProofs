    refine ⟨τ3, ?_, hc3.slots, ?_, hframe, ?_, hfix3, ?_, ?_, ?_⟩
    · have h := r1.seq (rc.seq (r2.seq r3))
      rw [hcom]
      refine h.mono ?_
