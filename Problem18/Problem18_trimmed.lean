    (hlarge : (2:ℝ)^80*(1+Real.log (b:ℝ))^2≤b)
    (g : ι→K[X]) (hm : ∀ i,(g i).Monic) (hi : ∀ i,Irreducible (g i)) (hinj : Function.Injective g)
    (hj : Nat.card ι≤8*(Nat.ceil (Real.log (b:ℝ))+1))
    (hlo : ∀ i,4096*(Nat.ceil (Real.log (b:ℝ))+1)≤(g i).natDegree)
    (hhi : ∀ i,(g i).natDegree≤b/(1024*(Nat.ceil (Real.log (b:ℝ))+1))) :
    |((Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) B //∀ i,PrimaryEvent (g i) S.val}:ℝ)/
      Nat.card (SelfAdjointOperators (RingEquiv.refl K) B))*(∏ i,(Nat.card K:ℝ)^(g i).natDegree)-1| ≤
      Real.exp (-3*Real.log (b:ℝ)) := by
