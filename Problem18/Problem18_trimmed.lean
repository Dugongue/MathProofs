    simp [chosenOf, Problem18ArrayElimination20260929.read, rowVec, List.getElem_reverse]
  · intro s hs hso
    exact hkeepf s hs (by rw [htf]; exact hso)
theorem chosen_run_canonical (q : RNames) (hq : q.Valid canonical) (cc t src dst : String)
    (hfr : ∀ x ∈ [cc, t, src, dst], x ∉ regNames canonical ∧ x ≠ q.WS ∧ x ∉ q.list)
    (hnd : [cc, t, src, dst].Nodup) {B Sn N c : ℕ} {σ : Env}
    (hS : Slots F canonical q.WS Sn B σ)
    (hN : σ.vars q.N = N) (hcc : σ.vars cc = c) (hcN : c ≤ N) (hfit : inStart N c ≤ Sn) :
    ∃ τ, Run B (chosenCom (Problem18ClaudeFieldMacrosInstancePow20261001.fieldMacros F) q cc t
          src dst) σ τ
        (chosenCost (Problem18ClaudeFieldMacrosInstancePow20261001.fieldMacros F) q cc t src dst
          N c) ∧
      Slots F canonical q.WS Sn B τ ∧
      (∀ u (hu : u < c), ∀ k : Fin N, val F canonical q.WS τ (inStart N u + k.val) =
        read ((chosenOf (val F canonical q.WS σ) N c)[u]'(by simp [chosenOf]; exact hu)) k) ∧
      (∀ s < Sn, (s < inStart N 0 ∨ inStart N c ≤ s) →
        val F canonical q.WS τ s = val F canonical q.WS σ s) ∧
      τ.vars q.N = N ∧ τ.vars cc = c ∧
      (∀ x, x ∉ regNames canonical → x ≠ q.j → x ≠ t → x ≠ src → x ≠ dst →
        τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ canonical.mem → a ≠ canonical.scratch → τ.arrs a = σ.arrs a) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out :=
