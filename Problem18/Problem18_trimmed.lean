    { toFun := fun S=>⟨S.val,S.property⟩
      invFun := fun S=>⟨S.val,S.property⟩
      left_inv := fun _=>rfl
      right_inv := fun _=>rfl }
  let E := (Mathproof.Problem18OrdinarySampleNormalization20261001.operatorIsometryEquiv B C e he).trans Ec
  let X := {S : SelfAdjointOperators σ B // IsotropicOccurrence B h S}
  let Y := {S : Mathproof.Problem18SelfAdjointCoordinateRestriction20260930.selfAdjointSpace σ C //
    Mathproof.Problem18GeneralIsotropicPrimaryUnion20261001.IsotropicPrimaryEvent σ C h S}
  let f : X → Y := fun S => ⟨E S.val,by
    obtain ⟨U,hU,hdu,hcu,hiu⟩ := S.property
    obtain ⟨hZ,hχ⟩ := restriction_transport e S.val.val U hU
    let Z := U.map e.toLinearMap
