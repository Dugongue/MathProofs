variable {n : Nat}
theorem aeval_self_eq_eval {E : Type} [Field E] (x : Fin n → E) (p : MvPolynomial (Fin n) E) :
    aeval x p = eval x p := rfl
theorem geometricIdeal_self {E : Type} [Field E] (S : Set (MvPolynomial (Fin n) E)) :
    geometricIdeal (K := E) (L := E) S = Ideal.span S := by
  simp only [geometricIdeal, Algebra.algebraMap_self, MvPolynomial.map_id, RingHom.coe_id,
    Set.image_id', Set.image_id]
theorem geometricIdeal_tower {K L Ω : Type} [Field K] [Field L] [Field Ω] [Algebra K L]
    [Algebra K Ω] [Algebra L Ω] [IsScalarTower K L Ω] (S : Set (MvPolynomial (Fin n) K)) :
    geometricIdeal (L := Ω) S =
      Ideal.map (MvPolynomial.map (algebraMap L Ω)) (geometricIdeal (L := L) S) := by
  unfold geometricIdeal
  rw [Ideal.map_span, ← Set.image_comp]
  have hcomp : (MvPolynomial.map (algebraMap L Ω) : MvPolynomial (Fin n) L → MvPolynomial (Fin n) Ω)
      ∘ MvPolynomial.map (algebraMap K L) = MvPolynomial.map (algebraMap K Ω) := by
    funext p
    simp only [Function.comp, MvPolynomial.map_map]
    rw [IsScalarTower.algebraMap_eq K L Ω]
  rw [hcomp]
theorem exists_trdeg_lt_of_lt {E : Type} [Field E] (P Q : Ideal (MvPolynomial (Fin n) E))
    [P.IsPrime] [Q.IsPrime] (t : Nat)
    (ht : Algebra.trdeg E (MvPolynomial (Fin n) E ⧸ P) = (t : Cardinal)) (hlt : P < Q) :
    ∃ t' : Nat, t' < t ∧ Algebra.trdeg E (MvPolynomial (Fin n) E ⧸ Q) = (t' : Cardinal) := by
  have hft : Algebra.FiniteType E (MvPolynomial (Fin n) E ⧸ P) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ E P) (Ideal.Quotient.mkₐ_surjective E P)
  have hle : P ≤ Q := hlt.le
  have hker : RingHom.ker (Ideal.Quotient.mkₐ E P) = P := Ideal.mk_ker
  haveI hQ' : (Q.map (Ideal.Quotient.mkₐ E P)).IsPrime :=
    Ideal.map_isPrime_of_surjective (Ideal.Quotient.mkₐ_surjective E P) (by rw [hker]; exact hle)
  have hne : Q.map (Ideal.Quotient.mkₐ E P) ≠ ⊥ := by
    intro h0
    rw [Ideal.map_eq_bot_iff_le_ker, hker] at h0
    exact (lt_irrefl _) (lt_of_lt_of_le hlt h0)
  have h1 := trdeg_quotient_lt (k := E) (Q.map (Ideal.Quotient.mkₐ E P)) hne
  have h2 : Algebra.trdeg E ((MvPolynomial (Fin n) E ⧸ P) ⧸ Q.map (Ideal.Quotient.mkₐ E P))
      = Algebra.trdeg E (MvPolynomial (Fin n) E ⧸ Q) :=
    (DoubleQuot.quotQuotEquivQuotOfLEₐ E hle).trdeg_eq
  have hlt' : Algebra.trdeg E (MvPolynomial (Fin n) E ⧸ Q) < (t : Cardinal) := by
    rw [← h2, ← ht]; exact h1
  obtain ⟨t', ht'⟩ := Cardinal.lt_aleph0.mp (lt_trans hlt' (Cardinal.nat_lt_aleph0 t))
  refine ⟨t', ?_, ht'⟩
  rw [ht'] at hlt'
  exact_mod_cast hlt'
end Ideals
variable {K : Type} [Field K] [DecidableEq K] [Fintype K]
def UniqueComp (E : Type) [Field E] {n : Nat} (gs : List (MvPolynomial (Fin n) E)) : Prop :=
  ∃ P : Ideal (MvPolynomial (Fin n) E),
    (geometricIdeal (K := E) (L := E) (systemSet gs)).minimalPrimes = {P}
def SectionCond (E : Type) [Field E] {n : Nat} (gs : List (MvPolynomial (Fin n) E)) (i j : Fin n)
    (a b : E) : Prop :=
  (∃ x : Fin n → E, (∀ f ∈ gs, eval x f = 0) ∧ eval x (X i + MvPolynomial.C a * X j - MvPolynomial.C b) ≠ 0) ∧
  ∃ Q : Ideal (MvPolynomial (Fin n) E),
    (geometricIdeal (K := E) (L := E) (systemSet (sectionSystem gs i j a b))).minimalPrimes = {Q}
structure SectionTemplateT (n d c₀ : Nat) where
  encode : List (MvPolynomial (Fin n) K) → Fin c₀ → K
  template : Fin n → Fin n → Formula ℤ (c₀ + 2)
  degreeBound : Nat
  template_degree : ∀ (i j : Fin n), ∀ cl ∈ clauses (qe (template i j)), ∀ l ∈ cl,
    l.1.degree ≤ degreeBound
  clauseBound : Nat
  template_clauses : ∀ (i j : Fin n), ∀ cl ∈ clauses (qe (template i j)), cl.length ≤ clauseBound
  semantics : ∀ (E : Type) [Field E] [Algebra K E] [IsAlgClosed E]
    (fs : List (MvPolynomial (Fin n) K)), Bounded d fs → ∀ (i j : Fin n) (a b : E),
    UniqueComp E (fs.map (MvPolynomial.map (algebraMap K E))) →
    ((template i j).Holds (Int.castRingHom E)
        ((Sum.elim (algebraMap K E ∘ encode fs) ![a, b]) ∘ fun v => finSumFinEquiv.symm v) ↔
      SectionCond E (fs.map (MvPolynomial.map (algebraMap K E))) i j a b)
section OverL
variable (L : Type) [Field L] [Algebra K L] [IsAlgClosed L] [Algebra.IsAlgebraic K L]
theorem uniqueComp_of_irredDimT {n : Nat} (fs : List (MvPolynomial (Fin n) K)) (t : Nat)
    (hirr : IrredDimT L fs t) : UniqueComp L (fs.map (MvPolynomial.map (algebraMap K L))) := by
  obtain ⟨P, hP, -⟩ := hirr
  exact ⟨P, by rw [← geometricIdeal_map_eq L fs]; exact hP⟩
theorem trdeg_drop_of_sectionCond {n : Nat} (fs : List (MvPolynomial (Fin n) K)) (t : Nat)
    (hirr : IrredDimT L fs t) (i j : Fin n) (a b : K)
    (hc : SectionCond L (fs.map (MvPolynomial.map (algebraMap K L))) i j
      (algebraMap K L a) (algebraMap K L b)) :
    ∃ t' : Nat, t' < t ∧ IrredDimT L (sectionSystem fs i j a b) t' := by
  obtain ⟨P, hP, ht⟩ := hirr
  obtain ⟨⟨x, hx, hℓ⟩, Q, hQ⟩ := hc
  have hJ : geometricIdeal (K := L) (L := L) (systemSet (sectionSystem
        (fs.map (MvPolynomial.map (algebraMap K L))) i j (algebraMap K L a) (algebraMap K L b)))
      = geometricIdeal (L := L) (systemSet (sectionSystem fs i j a b)) := by
    rw [geometricIdeal_map_eq L (sectionSystem fs i j a b), sectionSystem_map]
  rw [hJ] at hQ
  have hPmem : P ∈ (geometricIdeal (L := L) (systemSet fs)).minimalPrimes := by
    rw [hP]; exact Set.mem_singleton P
  have hQmem : Q ∈ (geometricIdeal (L := L) (systemSet (sectionSystem fs i j a b))).minimalPrimes := by
    rw [hQ]; exact Set.mem_singleton Q
  haveI hPp : P.IsPrime := hPmem.isPrime
  haveI hQp : Q.IsPrime := hQmem.isPrime
  have hIJ : geometricIdeal (L := L) (systemSet fs) ≤
      geometricIdeal (L := L) (systemSet (sectionSystem fs i j a b)) := by
    apply Ideal.span_mono
    apply Set.image_mono
    intro f hf
    exact List.mem_append_left _ hf
  obtain ⟨p, hp, hpQ⟩ := Ideal.exists_minimalPrimes_le (le_trans hIJ hQmem.1.2)
  rw [hP] at hp
  have hPQ : P ≤ Q := by rw [← Set.mem_singleton_iff.mp hp]; exact hpQ
  have hℓJ : MvPolynomial.map (algebraMap K L) (X i + MvPolynomial.C a * X j - MvPolynomial.C b) ∈
      geometricIdeal (L := L) (systemSet (sectionSystem fs i j a b)) :=
    Ideal.subset_span ⟨X i + MvPolynomial.C a * X j - MvPolynomial.C b,
      List.mem_append_right _ (List.mem_singleton.mpr rfl), rfl⟩
  have hℓQ : MvPolynomial.map (algebraMap K L) (X i + MvPolynomial.C a * X j - MvPolynomial.C b) ∈ Q := hQmem.1.2 hℓJ
  have hℓL : MvPolynomial.map (algebraMap K L) (X i + MvPolynomial.C a * X j - MvPolynomial.C b)
      = X i + MvPolynomial.C (algebraMap K L a) * X j - MvPolynomial.C (algebraMap K L b) := by
    simp only [map_sub, map_add, map_mul, MvPolynomial.map_X, MvPolynomial.map_C]
  have hIm : geometricIdeal (L := L) (systemSet fs) ≤ vanishingIdeal L ({x} : Set (Fin n → L)) := by
    rw [geometricIdeal, Ideal.span_le]
    rintro g ⟨f, hf, rfl⟩ y hy
    rw [Set.mem_singleton_iff.mp hy, aeval_self_eq_eval]
    exact hx _ (List.mem_map.mpr ⟨f, hf, rfl⟩)
  obtain ⟨p', hp', hp'm⟩ := Ideal.exists_minimalPrimes_le hIm
  rw [hP] at hp'
  have hPm : P ≤ vanishingIdeal L ({x} : Set (Fin n → L)) := by
    rw [← Set.mem_singleton_iff.mp hp']; exact hp'm
  have hℓP : MvPolynomial.map (algebraMap K L) (X i + MvPolynomial.C a * X j - MvPolynomial.C b) ∉ P := by
    intro hmem
    have h0 := (mem_vanishingIdeal_iff.mp (hPm hmem)) x (Set.mem_singleton x)
    rw [aeval_self_eq_eval, hℓL] at h0
    exact hℓ h0
  have hlt : P < Q := lt_of_le_of_ne hPQ (fun h => hℓP (h ▸ hℓQ))
  obtain ⟨t', ht', hQt⟩ := exists_trdeg_lt_of_lt P Q t ht hlt
  exact ⟨t', ht', Q, hQ, hQt⟩
end OverL
section OverOmega
variable (L : Type) [Field L] [Algebra K L] [IsAlgClosed L] [Algebra.IsAlgebraic K L]
variable (Ω : Type) [Field Ω] [Algebra K Ω] [Algebra L Ω] [IsScalarTower K L Ω] [IsAlgClosed Ω]
theorem bertini_output {n : Nat} (fs : List (MvPolynomial (Fin n) K))
    (P : Ideal (MvPolynomial (Fin n) L))
    (hP : (geometricIdeal (L := L) (systemSet fs)).minimalPrimes = {P})
    (i j : Fin n) (u u₀ : Ω)
    (hBC : (Ideal.map (MvPolynomial.map (algebraMap L Ω)) P).IsPrime)
    (Q : Ideal (MvPolynomial (Fin n) Ω))
    (hQ : (geometricIdeal (K := Ω) (L := Ω) (systemSet (sectionSystem
      (fs.map (MvPolynomial.map (algebraMap K Ω))) i j u u₀))).minimalPrimes = {Q})
    (hlt : Ideal.map (MvPolynomial.map (algebraMap L Ω)) P < Q) :
    UniqueComp Ω (fs.map (MvPolynomial.map (algebraMap K Ω))) ∧
      SectionCond Ω (fs.map (MvPolynomial.map (algebraMap K Ω))) i j u u₀ := by
  have hIΩ : geometricIdeal (K := Ω) (L := Ω) (systemSet (fs.map (MvPolynomial.map (algebraMap K Ω))))
      = Ideal.map (MvPolynomial.map (algebraMap L Ω)) (geometricIdeal (L := L) (systemSet fs)) := by
    rw [← geometricIdeal_map_eq Ω fs, geometricIdeal_tower (L := L)]
  have hPmem : P ∈ (geometricIdeal (L := L) (systemSet fs)).minimalPrimes := by
    rw [hP]; exact Set.mem_singleton P
  haveI := hPmem.isPrime
  have hradL : (geometricIdeal (L := L) (systemSet fs)).radical = P := by
    rw [← Ideal.sInf_minimalPrimes, hP, sInf_singleton]
  have hrad : (geometricIdeal (K := Ω) (L := Ω)
      (systemSet (fs.map (MvPolynomial.map (algebraMap K Ω))))).radical
      = Ideal.map (MvPolynomial.map (algebraMap L Ω)) P := by
    apply le_antisymm
    · rw [hBC.radical_le_iff, hIΩ]; exact Ideal.map_mono hPmem.1.2
    · rw [hIΩ, ← hradL]; exact Ideal.map_radical_le _
  have huc : (geometricIdeal (K := Ω) (L := Ω)
      (systemSet (fs.map (MvPolynomial.map (algebraMap K Ω))))).minimalPrimes
      = {Ideal.map (MvPolynomial.map (algebraMap L Ω)) P} := by
    rw [← hrad]; exact minimalPrimes_eq_radical _ (hrad ▸ hBC)
  refine ⟨⟨_, huc⟩, ?_, Q, hQ⟩
  have hℓnot : (X i + MvPolynomial.C u * X j - MvPolynomial.C u₀ : MvPolynomial (Fin n) Ω) ∉
      Ideal.map (MvPolynomial.map (algebraMap L Ω)) P := by
    intro hℓ
    have hJle : geometricIdeal (K := Ω) (L := Ω) (systemSet (sectionSystem
        (fs.map (MvPolynomial.map (algebraMap K Ω))) i j u u₀)) ≤
        Ideal.map (MvPolynomial.map (algebraMap L Ω)) P := by
      rw [geometricIdeal_self, Ideal.span_le]
      intro g hg
      rcases List.mem_append.mp hg with h | h
      · have hgI : g ∈ geometricIdeal (K := Ω) (L := Ω)
            (systemSet (fs.map (MvPolynomial.map (algebraMap K Ω)))) := by
          rw [geometricIdeal_self]; exact Ideal.subset_span h
        rw [← hrad]; exact Ideal.le_radical hgI
      · rw [List.mem_singleton.mp h]; exact hℓ
    haveI := hBC
    obtain ⟨p, hp, hpP⟩ := Ideal.exists_minimalPrimes_le hJle
    rw [hQ] at hp
    have hQle : Q ≤ Ideal.map (MvPolynomial.map (algebraMap L Ω)) P := by
      rw [← Set.mem_singleton_iff.mp hp]; exact hpP
    exact (lt_irrefl _) (lt_of_lt_of_le hlt hQle)
  have hℓrad : (X i + MvPolynomial.C u * X j - MvPolynomial.C u₀ : MvPolynomial (Fin n) Ω) ∉ (geometricIdeal (K := Ω) (L := Ω)
      (systemSet (fs.map (MvPolynomial.map (algebraMap K Ω))))).radical := by
    rw [hrad]; exact hℓnot
  rw [← vanishingIdeal_zeroLocus_eq_radical (K := Ω), mem_vanishingIdeal_iff] at hℓrad
  push_neg at hℓrad
  obtain ⟨x, hxV, hxℓ⟩ := hℓrad
  refine ⟨x, ?_, ?_⟩
  · intro f hf
    have hfI : f ∈ geometricIdeal (K := Ω) (L := Ω)
        (systemSet (fs.map (MvPolynomial.map (algebraMap K Ω)))) := by
      rw [geometricIdeal_self]; exact Ideal.subset_span hf
    have := (mem_zeroLocus_iff.mp hxV) f hfI
    rwa [aeval_self_eq_eval] at this
  · rwa [aeval_self_eq_eval] at hxℓ
end OverOmega
section Glue
variable (L : Type) [Field L] [Algebra K L] [IsAlgClosed L] [Algebra.IsAlgebraic K L]
theorem section_stepT_of_template {n d c₀ : Nat} (T : SectionTemplateT (K := K) n d c₀)
    (Ω : Type) [Field Ω] [Algebra K Ω] [IsAlgClosed Ω] (u u₀ : Ω)
    (hu : Transcendental K u) (hu₀ : Transcendental (Polynomial.aeval u : Polynomial K →ₐ[K] Ω).range u₀)
    (hgen : ∀ (fs : List (MvPolynomial (Fin n) K)) (t : Nat), Bounded d fs → 2 ≤ t →
      IrredDimT L fs t → ∃ i j : Fin n,
        UniqueComp Ω (fs.map (MvPolynomial.map (algebraMap K Ω))) ∧
        SectionCond Ω (fs.map (MvPolynomial.map (algebraMap K Ω))) i j u u₀)
    (hq : 2 * (T.clauseBound * T.degreeBound) < Fintype.card K)
    (fs : List (MvPolynomial (Fin n) K)) (t : Nat) (hb : Bounded d fs) (ht : 2 ≤ t)
    (hirr : IrredDimT L fs t) :
    ∃ (i j : Fin n) (a b : K) (t' : Nat), t' < t ∧ IrredDimT L (sectionSystem fs i j a b) t' := by
  classical
  obtain ⟨i, j, hucΩ, hscΩ⟩ := hgen fs t hb ht hirr
  have hT := (T.semantics Ω fs hb i j u u₀ hucΩ).mpr hscΩ
  obtain ⟨cl, hcl, hholds⟩ := (qe_clauses_correct (Int.castRingHom Ω) (T.template i j) _).mpr hT
  have hsum : clauseHolds (Int.castRingHom Ω)
      (Sum.elim (algebraMap K Ω ∘ T.encode fs) ![u, u₀]) (toSumClause cl) :=
    (clauseHolds_toSumClause _ cl).mpr hholds
  have hcomp : (algebraMap K Ω).comp (Int.castRingHom K) = Int.castRingHom Ω := RingHom.ext_int _ _
  have hgenHolds : GenericallyHolds (Int.castRingHom K) (T.encode fs) (toSumClause cl) := by
    rw [← clauseHolds_generic_iff (Int.castRingHom K) (T.encode fs) (toSumClause cl) u u₀ hu hu₀, hcomp]
    exact hsum
  have hdeg := toSumClause_degree cl T.degreeBound (T.template_degree i j cl hcl)
  have hlen : (toSumClause cl).length ≤ T.clauseBound := by
    rw [toSumClause_length]; exact T.template_clauses i j cl hcl
  have hq' : 2 * ((toSumClause cl).length * T.degreeBound) < Fintype.card K :=
    lt_of_le_of_lt (Nat.mul_le_mul_left 2 (Nat.mul_le_mul_right _ hlen)) hq
  obtain ⟨a, b, hab⟩ := exists_rational_instance (Int.castRingHom K) (T.encode fs) (toSumClause cl)
    hgenHolds T.degreeBound hdeg hq'
  have habL : clauseHolds (Int.castRingHom L)
      (Sum.elim (algebraMap K L ∘ T.encode fs) ![algebraMap K L a, algebraMap K L b])
      (toSumClause cl) := by
    have h := (clauseHolds_map (algebraMap K L) (Sum.elim (T.encode fs) ![a, b]) (toSumClause cl)).mp hab
    convert h using 2
    funext v
    rcases v with v | v
    · rfl
    · fin_cases v <;> rfl
  have hTL : (T.template i j).Holds (Int.castRingHom L)
      ((Sum.elim (algebraMap K L ∘ T.encode fs) ![algebraMap K L a, algebraMap K L b]) ∘
        fun v => finSumFinEquiv.symm v) :=
    (qe_clauses_correct (Int.castRingHom L) (T.template i j) _).mp
      ⟨cl, hcl, (clauseHolds_toSumClause _ cl).mp habL⟩
  have hscL := (T.semantics L fs hb i j (algebraMap K L a) (algebraMap K L b)
    (uniqueComp_of_irredDimT L fs t hirr)).mp hTL
  obtain ⟨t', ht', hsec⟩ := trdeg_drop_of_sectionCond L fs t hirr i j a b hscL
  exact ⟨i, j, a, b, t', ht', hsec⟩
end Glue
