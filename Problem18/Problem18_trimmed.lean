theorem preservation_card_mul_le (eps : K) (hτ : Function.Involutive τ)
    (heps : eps*τ eps=1) (B : Form (V := Fin n → K) τ) (hB : B.SeparatingLeft)
    (hsym : ∀x y,B y x=eps*τ (B x y)) (W : Submodule K (Fin n → K))
    (E : (Fin (t+a+c) → K) →ₗ[K] (Fin n → K)) (hE : Function.Injective E)
    (hw : ∀i : Fin (t+a+c), i.val<t+a → E (Pi.single i 1)∈W)
    (hz : ∀j : Fin (t+a+c), j.val<t ∨ t+a≤j.val →
      ∀w∈W,B w (E (Pi.single j 1))=0) :
