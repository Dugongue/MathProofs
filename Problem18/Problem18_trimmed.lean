variable {V : Type*} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
theorem commuting_aeval (S D : Module.End K V) (hD : ∀ x,D (S x)=S (D x))
    (p : K[X]) (x : V) : D ((aeval S p) x)=(aeval S p) (D x) := by
  have hp (n : ℕ) (v : V) : D ((S^n) v)=(S^n) (D v) := by
    induction n with
    | zero => simp
    | succ n ih => simp only [pow_succ',Module.End.mul_apply,hD,ih]
  induction p using Polynomial.induction_on' with
  | add p q ihp ihq => simp only [aeval_add,LinearMap.add_apply,map_add,ihp,ihq]
  | monomial n a =>
    simp only [aeval_monomial,← Algebra.smul_def,LinearMap.smul_apply,map_smul,hp]
theorem cyclic_commutant_polynomial (S D : Module.End K V) (v : V)
    (hv : PolynomiallyCyclic S v) (hD : ∀ x,D (S x)=S (D x)) :
    ∃! p : Polynomial.degreeLT K (Module.finrank K V),aeval S p.val=D := by
  have hbij := (polynomiallyCyclic_iff_cyclicEvalMap_bijective S v).mp hv
  obtain ⟨p,hp⟩ := hbij.surjective (D v)
  have he : aeval S p.val=D := by
    apply LinearMap.ext
    intro x
    obtain ⟨q,rfl⟩ := hv x
    have hc : (aeval S p.val)*(aeval S q)=(aeval S q)*(aeval S p.val) := by
      rw [← map_mul,← map_mul,mul_comm]
    change ((aeval S p.val)*(aeval S q)) v=D ((aeval S q) v)
    rw [hc]
    change (aeval S q) ((aeval S p.val) v)=D ((aeval S q) v)
    rw [show (aeval S p.val) v=D v from hp,commuting_aeval S D hD]
  refine ⟨p,he,?_⟩
  intro q hq
  apply hbij.injective
  change (aeval S q.val) v=(aeval S p.val) v
  rw [hq,he]
theorem cyclic_aeval_zero_iff (S : Module.End K V) (v : V)
    (hv : PolynomiallyCyclic S v) (p : K[X]) :
    aeval S p=0 ↔ S.charpoly ∣ p := by
  constructor
  · intro hp
    have hd : p %ₘ S.charpoly∈Polynomial.degreeLT K (Module.finrank K V) := by
      rw [Polynomial.mem_degreeLT]
      have hh := degree_modByMonic_lt p S.charpoly_monic
      simpa only [degree_eq_natDegree S.charpoly_monic.ne_zero,S.charpoly_natDegree] using hh
    let r : Polynomial.degreeLT K (Module.finrank K V) := ⟨p %ₘ S.charpoly,hd⟩
    have hr : cyclicEvalMap S v (Module.finrank K V) r=
        cyclicEvalMap S v (Module.finrank K V) 0 := by
      change (aeval S (p %ₘ S.charpoly)) v=(aeval S 0) v
      rw [aeval_modByMonic_eq_self_of_root S.aeval_self_charpoly,hp,map_zero]
    have he := ((polynomiallyCyclic_iff_cyclicEvalMap_bijective S v).mp hv).injective hr
    apply (modByMonic_eq_zero_iff_dvd S.charpoly_monic).mp
    exact congrArg Subtype.val he
  · intro hp
    exact aeval_eq_zero_of_dvd_aeval_eq_zero hp S.aeval_self_charpoly
theorem cyclic_divisor_kernel_iff (S : Module.End K V) (v : V)
    (hv : PolynomiallyCyclic S v) (hs : Squarefree S.charpoly)
    (g p : K[X]) (hg : g ∣ S.charpoly) :
    LinearMap.ker (aeval S g) ≤ LinearMap.ker (aeval S p) ↔ g ∣ p := by
  constructor
  · intro hk
    obtain ⟨q,hq⟩ := hg
    have hc : IsCoprime g q := isRelPrime_iff_isCoprime.mp
      (squarefree_mul_iff.mp (hq ▸ hs)).1
    have hpq : aeval S (p*q)=0 := by
      apply LinearMap.ext
      intro x
      change (aeval S (p*q)) x=0
      rw [aeval_mul,Module.End.mul_apply]
      apply hk
      change (aeval S g) ((aeval S q) x)=0
      rw [← Module.End.mul_apply,← aeval_mul,← hq,S.aeval_self_charpoly]
      rfl
    have hd := (cyclic_aeval_zero_iff S v hv (p*q)).mp hpq
    exact hc.dvd_of_dvd_mul_right ((show g ∣ S.charpoly from ⟨q,hq⟩).trans hd)
  · rintro ⟨q,hq⟩ x hx
    change (aeval S p) x=0
    rw [hq,mul_comm,aeval_mul,Module.End.mul_apply,LinearMap.mem_ker.mp hx,map_zero]
end Commutant
end Mathproof.Problem18OddCyclicFormDecision20260930
