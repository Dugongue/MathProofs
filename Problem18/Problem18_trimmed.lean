theorem cell_factor_bounds {a b c e : Nat} (ha : 0 < a) (hb : 0 < b) (hc : 0 < c)
    (he : 0 < e) :
    a ≤ a*b*c*e ∧ b ≤ a*b*c*e ∧ c ≤ a*b*c*e ∧ e ≤ a*b*c*e ∧
      a*b ≤ a*b*c*e ∧ a*b*c ≤ a*b*c*e := by
  have h1 : a ≤ a*b := Nat.le_mul_of_pos_right a hb
  have h2 : b ≤ a*b := Nat.le_mul_of_pos_left b ha
  have h3 : a*b ≤ a*b*c := Nat.le_mul_of_pos_right (a*b) hc
  have h4 : c ≤ a*b*c := Nat.le_mul_of_pos_left c (Nat.mul_pos ha hb)
  have h5 : a*b*c ≤ a*b*c*e := Nat.le_mul_of_pos_right (a*b*c) he
  have h6 : e ≤ a*b*c*e := Nat.le_mul_of_pos_left e (Nat.mul_pos (Nat.mul_pos ha hb) hc)
  omega
theorem sourcePayloadProgram_run {K : Type} [Field K] [Fintype K]
