def largeConstant : ℝ := firstConstant+50
theorem large_density_package :
    ∃B : ℕ, 8≤B ∧ 0<largeConstant ∧
      ∀(K : Type) [Field K] [Fintype K] (u : Bool) (q a b c : ℕ),
        validSize K u q→2≤a→a≤b→b≤ c→B≤b→
        probability (fun A : RectTensor a b c K=>¬RawGood u q A)≤
          largeConstant*(1+Real.log (b:ℝ))/Real.sqrt (b:ℝ) ∧
        1/2≤probability (fun A : RectTensor a b c K=>rawCheck u q A=true) := by
  obtain ⟨B1,hB1,hC,hfirst⟩ := first_generation_universal
  have hLC : 0<largeConstant := by unfold largeConstant; linarith
  obtain ⟨B2,hB2,hhalf⟩ := exists_half_threshold largeConstant hLC.le
  refine ⟨max B1 B2,hB1.trans (le_max_left _ _),hLC,?_⟩
  intro K _ _ u q a b c hv ha hab hbc hb
  have hb1 : B1≤b := (le_max_left _ _).trans hb
  have hb2 : B2≤b := (le_max_right _ _).trans hb
  have hbpos : 1≤b := hB2.trans hb2
  have hlog : 0≤Real.log (b:ℝ) := Real.log_nonneg (by exact_mod_cast hbpos)
  have hsecond := (raw_second_failure_le u q hv a b c ha (hab.trans hbc)).trans
    (five_slice_sqrt_bound b hbpos)
  have hsecond' : probability (fun A : RectTensor a b c K=>
      Algebra.adjoin K (Set.range (rawSecond u q A))≠⊤)≤
      50*(1+Real.log (b:ℝ))/Real.sqrt (b:ℝ) := by
    apply hsecond.trans
    apply div_le_div_of_nonneg_right _ (Real.sqrt_nonneg _)
    nlinarith
  have hbad := (raw_failure_union (K:=K) u q a b c).trans
    (add_le_add (hfirst K u q a b c hv ha hab hbc hb1) hsecond')
  have hbound : probability (fun A : RectTensor a b c K=>¬RawGood u q A)≤
      largeConstant*(1+Real.log (b:ℝ))/Real.sqrt (b:ℝ) := by
    calc
      _ ≤ _ := hbad
      _ = _ := by unfold largeConstant; ring
  refine ⟨hbound,?_⟩
  rw [raw_check_acceptance]
  have hh := hbound.trans (hhalf b hb2)
  linarith
end
end Mathproof.Problem18LargeRootDensity20261001
