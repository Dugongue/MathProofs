  ∀ f ∈ generatedIdeal G, f ≠ 0 →
    ∃ g ∈ G, g ≠ 0 ∧ ExponentDivides (m.degree g) (m.degree f)
def standardMonomials (G : Set (MvPolynomial σ K)) : Set (Finsupp σ Nat) :=
  {d | ∀ g ∈ G, g ≠ 0 → ¬ ExponentDivides (m.degree g) d}
def IsReduced (G : Set (MvPolynomial σ K)) (r : MvPolynomial σ K) : Prop :=
  ∀ d ∈ r.support, d ∈ standardMonomials m G
def NormalForm (G : Set (MvPolynomial σ K)) (f r : MvPolynomial σ K) : Prop :=
  f - r ∈ generatedIdeal G ∧ IsReduced m G r
def reductionStep (f g : MvPolynomial σ K) (d : Finsupp σ Nat) :
    MvPolynomial σ K :=
