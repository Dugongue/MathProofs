theorem loop_run_framed (q : RNames) (hq : q.Valid canonical)
    {Sn B N : Nat} {P Q : K[X]} {σ : Env} (h : Stored F q Sn B N P Q σ)
    (hc0 : σ.vars q.c = 0) :
    ∃ τ, Run B (.while (.lt (.var q.c) (.var q.n))
        (Problem18IMPPolynomialRemainder20261001.body q)) σ τ ((4+bodyBudget F q N)*N+4) ∧
      Stored F q Sn B N (P % Q) Q τ ∧ τ.vars q.c = N ∧
