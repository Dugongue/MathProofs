  refine ⟨τ, hr.mono (by simp [Expr.size]), hG, hG.valid F ?_, hzero, hv, ha, hi, ho⟩
  intro j hj
  by_cases hje : F.e ≤ j
  · rw [hzero j hje]; exact F.prime.pos
  · have := hG.modulus ⟨j, by omega⟩
    simp only at this
    rw [this]; exact (F.modulus _).isLt
theorem load_run {W Sn bankLen : Nat} {σ : Env} (hG : Glob F W Sn bankLen σ)
    (hV : ValidMemory F W σ) {s d n : Expr} {sv dv nv : Nat} {v : Nat → K}
    (hcs : Clean s) (hcd : Clean d) (hcn : Clean n)
    (hs : s.evalB W σ = some sv) (hd : d.evalB W σ = some dv)
    (hn : n.evalB W σ = some (F.e * nv))
    (hbank : Vals F bank σ sv nv v)
    (hsl : sv + F.e * nv ≤ bankLen) (hdlo : F.e ≤ dv)
    (hdl : dv + F.e * nv ≤ F.e + 1 + Sn * F.e) :
