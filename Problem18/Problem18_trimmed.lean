  simp only [Nat.mul_zero, pow_zero, inv_one, mul_one, Nat.add_zero] at hb
  have hexp : n*r/8 ≤ (n-s)*(r-s) := by
    have ha : n ≤ 2*(n-s) := by omega
    have hc : r ≤ 4*(r-s) := by omega
    have hm := Nat.mul_le_mul ha hc
    apply Nat.div_le_of_le_mul
    nlinarith
