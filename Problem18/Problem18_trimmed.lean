  have hm:=Nat.mul_le_mul_right c hc
  unfold rgCost
  nlinarith
theorem loader_bound (F : FieldPresentation K) (n d c H : Nat)
    (he : F.e≤H) (hw : macroBudget F≤H) (hH : 1≤H) :
