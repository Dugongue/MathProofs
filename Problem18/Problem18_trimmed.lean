variable {K : Type} [Field K] [Fintype K] (F : FieldPresentation K)
def rowCost (w : Nat) := copyCost (fieldMacros F) (rowDest w) (rowSource w) w+
  constCost (marker w) F.e
theorem row_run {B S w z dv sv : Nat} {σ : Env}
    (hS : Slots F canonical q.WS S B σ) (hN : σ.vars q.N=w)
    (hd : (rowDest w).evalB B σ=some dv) (hs : (rowSource w).evalB B σ=some sv)
    (hdf : dv+w+1 ≤ S) (hsf : sv+w ≤ S)
    (hsep : dv+w+1 ≤ sv ∨ sv+w ≤ dv) (hz : z < F.p) :
    ∃τ,Run B (row w z) σ τ (rowCost F w) ∧ Slots F canonical q.WS S B τ ∧
      (∀k < w,val F canonical q.WS τ (dv+k)=val F canonical q.WS σ (sv+k)) ∧
      val F canonical q.WS τ (dv+w)=(z:K) ∧
      (∀s < S,(s < dv ∨ dv+w+1 ≤ s) → val F canonical q.WS τ s=val F canonical q.WS σ s) ∧
      (∀x,x∉regNames canonical → x≠q.j → x≠ci → τ.vars x=σ.vars x) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hcontrols:∀x∈controls,x∉regNames canonical ∧ x≠q.j:=by
    intro x hx
    simp only [controls,List.mem_cons,List.not_mem_nil,or_false] at hx
    rcases hx with rfl|rfl|rfl|rfl <;> constructor <;> decide
  have hdv:VarsIn controls (rowDest w):=by simp [rowDest,plus,VarsIn,controls]
  have hsv:VarsIn controls (rowSource w):=by simp [rowSource,plus,VarsIn,controls]
  obtain ⟨η,hr0,hη,hvalues,hmem,hregs,hj,harr,hi,ho⟩:=
    copy_run (fieldMacros F) q Problem18ConcreteSolverNames20261002.names_valid.1 controls
      hcontrols (rowDest w) (rowSource w) hdv hsv hS hd hs hN (by omega) hsf
      (by rcases hsep with h|h;exact Or.inl (by omega);exact Or.inr h)
  have hdη:(rowDest w).evalB B η=some dv:=by
    rw [evalB_congr_varsIn (fun x hx=>hregs x (hcontrols x hx).1 (hcontrols x hx).2) _ hdv]
    exact hd
  have hSB:=hS.slots_word
  have hm:(marker w).evalB B η=some (dv+w):=
    evalB_bin (op:=Bop.add) hdη (evalB_lit (by omega)) (by change dv+w < B;omega)
  obtain ⟨τ,hr1,hτ,hmarker,hframe,hregτ,harrτ,hiτ,hoτ⟩:=
    const_run (F:=F) q ci (by decide) (by decide) controls (by simp [controls,src,dst,idx,count,ci])
      (marker w) (by simp [marker,rowDest,plus,VarsIn,controls]) hη hm (by omega) hz
  refine ⟨τ,hr0.seq hr1,hτ,?_,hmarker,?_,?_,hiτ.trans hi,hoτ.trans ho⟩
  · intro k hk
    rw [hframe _ (by omega) (by omega)]
    exact hvalues k hk
  · intro s hs hout
    rw [hframe s hs (by rcases hout with h|h <;> omega),hmem s hs (by rcases hout with h|h;exact Or.inl h;exact Or.inr (by omega))]
  · intro x hx hj hc
    exact (hregτ x hc).trans (hregs x hx hj)
end
