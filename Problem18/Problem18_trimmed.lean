def capSqN (a b c : Nat) : Nat := capFlatN a b c * capFlatN a b c
def prefixN (a b c : Nat) : Nat :=
  candEndN (capFlatN a b c) (capGenN a b c) + candEndN (capFlatN a b c) (capGenN a b c)
def sortedN (a b c : Nat) : Nat := prefixN a b c
def poweredN (a b c : Nat) : Nat := sortedN a b c + tensorN a b c
def transposedN (a b c : Nat) : Nat := poweredN a b c + tensorN a b c
def secondFamilyN (a b c : Nat) : Nat := transposedN a b c + tensorN a b c
def secondRightN (a b c : Nat) : Nat := secondFamilyN a b c + capGenN a b c * capFlatN a b c
def secondOutputN (a b c : Nat) : Nat := secondRightN a b c + capFlatN a b c
def secondScratchN (a b c : Nat) : Nat := secondOutputN a b c + capFlatN a b c
def firstGramN (a b c : Nat) : Nat := transposedN a b c + tensorN a b c
def firstPowerN (a b c : Nat) : Nat := firstGramN a b c + capSqN a b c
def firstPowerCapN (a b c : Nat) : Nat := (2*dimSumN a b c)*capSqN a b c
def firstProductWorkN (a b c : Nat) : Nat := firstPowerN a b c + firstPowerCapN a b c
