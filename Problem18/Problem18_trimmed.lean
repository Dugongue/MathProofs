namespace Mathproof.Problem18ZetaSeriesRoots20260930
open PowerSeries Problem18EulerLocalSeries20260930 Problem18EulerReciprocalRoots20260930
open scoped PowerSeries
def rationalZetaSeries (P : Polynomial ℂ) (q : ℂ) : ℂ⟦X⟧ :=
  (P:ℂ⟦X⟧)*localEuler 1 1*localEuler 1 q
def rationalZetaLog (P : Polynomial ℂ) (q : ℂ) : ℂ⟦X⟧ :=
  reciprocalRootLogDerivative P.reverse.roots+(localEuler 1 1-1)+(localEuler 1 q-1)
theorem eq_rationalZetaSeries_of_denominator (P : Polynomial ℂ) (q : ℂ) (Z : ℂ⟦X⟧)
    (hZ : (P:ℂ⟦X⟧)=(1-X)*(1-C q*X)*Z) : Z=rationalZetaSeries P q := by
  have h1 : localEuler 1 (1:ℂ)*(1-X)=1 := by
    simpa using localEuler_mul_one_sub (1:ℂ) (e:=1) one_ne_zero
  have hq : localEuler 1 q*(1-C q*X)=1 := by
    simpa using localEuler_mul_one_sub q (e:=1) one_ne_zero
  unfold rationalZetaSeries
  rw [hZ]
  calc
    Z=1*1*Z := by ring
    _ = (localEuler 1 (1:ℂ)*(1-X))*(localEuler 1 q*(1-C q*X))*Z := by rw [h1,hq]
    _ = _ := by ring
theorem rationalZeta_derivative (P : Polynomial ℂ) (hP : P.coeff 0=1) (q : ℂ) :
    X*PowerSeries.derivative ℂ (rationalZetaSeries P q)=
      rationalZetaSeries P q*rationalZetaLog P q := by
  have hp := polynomial_logarithmic_derivative P hP
  have h1 := X_mul_derivativeFun_localEuler (1:ℂ) (e:=1) one_ne_zero
  have hq := X_mul_derivativeFun_localEuler q (e:=1) one_ne_zero
  simp only [Nat.cast_one,map_one,one_mul] at h1 hq
  unfold rationalZetaSeries rationalZetaLog
  rw [Derivation.leibniz,Derivation.leibniz]
  simp only [smul_eq_mul]
  linear_combination (localEuler 1 (1:ℂ)*localEuler 1 q)*hp +
    ((P:ℂ⟦X⟧)*localEuler 1 q)*h1 + ((P:ℂ⟦X⟧)*localEuler 1 1)*hq
theorem coeff_rationalZetaLog (P : Polynomial ℂ) (q : ℂ) {n : Nat} (hn : n≠0) :
    coeff n (rationalZetaLog P q)=q^n+1-(P.reverse.roots.map (fun α => α^n)).sum := by
  rw [rationalZetaLog,map_add,map_add,coeff_reciprocalRootLogDerivative _ hn,
    map_sub,map_sub,coeff_localEuler (1:ℂ) one_ne_zero,
    coeff_localEuler q one_ne_zero,PowerSeries.coeff_one,if_neg hn]
  simp only [one_dvd,if_true,Nat.div_one,one_pow,sub_zero]
  ring
theorem constantCoeff_rationalZetaLog (P : Polynomial ℂ) (q : ℂ) :
    constantCoeff (rationalZetaLog P q)=0 := by
  rw [rationalZetaLog,map_add,map_add,constantCoeff_reciprocalRootLogDerivative,
    map_sub,map_sub]
  have h1 : constantCoeff (localEuler 1 (1:ℂ))=1 := by
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply,coeff_localEuler (1:ℂ) one_ne_zero]
    simp
  have hq : constantCoeff (localEuler 1 q)=1 := by
    rw [← PowerSeries.coeff_zero_eq_constantCoeff_apply,coeff_localEuler q one_ne_zero]
    simp
  rw [h1,hq,map_one]
  ring
end Mathproof.Problem18ZetaSeriesRoots20260930
