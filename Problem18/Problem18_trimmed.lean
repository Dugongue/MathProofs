theorem opState_other (σ : Env) (a b o n bc bs : Nat) (x : String) (hx : x ∉ opRegs) :
    (opState σ a b o n bc bs).vars x = σ.vars x := by
  simp only [opRegs, List.mem_cons, List.not_mem_nil, or_false, not_or] at hx
  simp [opState, hx.1, hx.2.1, hx.2.2.1, hx.2.2.2.1, hx.2.2.2.2.1, hx.2.2.2.2.2]
theorem opState_regs (σ : Env) (a b o n bc bs : Nat) :
    (opState σ a b o n bc bs).vars oA = a ∧ (opState σ a b o n bc bs).vars oB = b ∧
    (opState σ a b o n bc bs).vars oO = o ∧ (opState σ a b o n bc bs).vars oN = n ∧
    (opState σ a b o n bc bs).vars oBc = bc ∧ (opState σ a b o n bc bs).vars oBs = bs := by
  simp only [opState, vars_setVar]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> simp (config := { decide := true })
def opCall (op : Primitive) (a b o n bc bs : Expr) : Com := .seq (setOp a b o n bc bs) (opStage op)
section
variable {K : Type} [Field K] (F : FieldPresentation K)
theorem opCall_run {W Sn bankLen workLen : Nat} (op : Primitive) (a b o n bc bs : Expr)
    {av bv ov nv bcv bsv : Nat} {va vb : Nat → K} {σ : Env}
    (hS : FState F W Sn bankLen workLen σ)
    (hr : ∀ e ∈ [a, b, o, n, bc, bs], ∀ x ∈ reads e, x ∉ opRegs)
    (ha : Fine W σ a) (hb : Fine W σ b) (ho : Fine W σ o) (hn : Fine W σ n)
    (hbc : Fine W σ bc) (hbs : Fine W σ bs)
    (hav : evalN σ a = av) (hbv : evalN σ b = bv) (hov : evalN σ o = ov) (hnv : evalN σ n = nv)
    (hbcv : evalN σ bc = bcv) (hbsv : evalN σ bs = bsv)
    (hmode : (bsv = 1 ∧ bcv = nv) ∨ (bsv = 0 ∧ bcv = 1)) (hn1 : 1 ≤ nv)
    (hva : Vals F work σ av nv va) (hvb : Vals F work σ bv bcv vb)
    (hafit : av + F.e * nv ≤ workLen) (hbfit : bv + F.e * bcv ≤ workLen)
    (hofit : ov + F.e * nv ≤ workLen) (hcap : 3 * nv ≤ Sn)
    (hexp : σ.vars canonical.exp < W) :
    ∃ τ, Run W (opCall op a b o n bc bs) σ τ
        (setOpCost a b o n bc bs + opCost F Sn op (σ.vars canonical.exp) nv bcv) ∧
      FState F W Sn bankLen workLen τ ∧
      Vals F work τ ov nv (fun i => op.value (σ.vars canonical.exp) (va i) (vb (bsv * i))) ∧
      (∀ j, (j < ov ∨ ov + F.e * nv ≤ j) → (τ.arrs work).getD j 0 = (σ.arrs work).getD j 0) ∧
      (∀ arr, arr ≠ canonical.mem → arr ≠ canonical.scratch → arr ≠ work →
        τ.arrs arr = σ.arrs arr) ∧
      (∀ x, x ∉ scalarWrites (opCall op a b o n bc bs) → τ.vars x = σ.vars x) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  have r1 := setOp_run a b o n bc bs hr ha hb ho hn hbc hbs
  set σ1 := opState σ (evalN σ a) (evalN σ b) (evalN σ o) (evalN σ n) (evalN σ bc) (evalN σ bs)
  have hS1 : FState F W Sn bankLen workLen σ1 := FState.op_state F hS _ _ _ _ _ _
  have hex1 : σ1.vars canonical.exp = σ.vars canonical.exp := opState_other _ _ _ _ _ _ _ _ (by decide)
  obtain ⟨q1, q2, q3, q4, q5, q6⟩ := opState_regs σ (evalN σ a) (evalN σ b) (evalN σ o) (evalN σ n)
    (evalN σ bc) (evalN σ bs)
  obtain ⟨τ, r2, hS2, hv, hf, harr, hi, ho'⟩ := opStage_run F op (n := nv) (bc := bcv) (bs := bsv)
    (a := av) (b := bv) (o := ov) (va := va) (vb := vb) hS1
    (q1.trans hav) (q2.trans hbv) (q3.trans hov) (q4.trans hnv) (q5.trans hbcv) (q6.trans hbsv) hmode hn1 hva hvb hafit hbfit hofit hcap
    (by rw [hex1]; exact hexp)
  have hrun := r1.seq r2
  refine ⟨τ, by rw [hex1] at hrun; exact hrun, hS2, by rw [hex1] at hv; exact hv, hf, harr,
    (run_frame hrun).1, hi, ho'⟩
end
def scalStage : Com :=
  .seq (.assign canonical.exp (.lit 0)) <|
  .seq (copyBlock bank work (.var rDx) (.lit 0) (.var canonical.e)) <|
  .seq (copyBlock bank work (.var rDy) (wo (.lit 1)) (.var canonical.e)) <|
  .seq (opCall .multiply (wo (.lit 1)) (.lit 0) (wo (.lit 3)) (.lit 1) (.lit 1) (.lit 0)) <|
  .seq (.assign canonical.exp (.lit 0)) <|
  .seq (opCall .inverse (wo (.lit 3)) (wo (.lit 3)) (wo (.lit 2)) (.lit 1) (.lit 1) (.lit 0)) <|
  .seq (.assign canonical.exp (.div (.var rQ) (.lit 2))) <|
  .seq (opCall .power (.lit 0) (.lit 0) (wo (.lit 4)) (.lit 3) (.lit 1) (.lit 0)) <|
  .seq (.assign canonical.exp (.lit 0)) <|
  .seq (opCall .power (.lit 0) (.lit 0) (wo (.lit 7)) (.lit 1) (.lit 1) (.lit 0)) <|
  .seq (.assign rNf (.lit 1)) <|
  .seq (cmpW rNf (wo (.lit 4)) (wo (.lit 7))) <|
  .seq (cmpW rNf (wo (.lit 5)) (wo (.lit 7))) <|
    cmpW rNf (wo (.lit 6)) (wo (.lit 7))
section
variable {K : Type} [Field K] (F : FieldPresentation K)
def scalVals (dx dy : K) (q : Nat) : Nat → K
  | 0 => dx
  | 1 => dy
  | 2 => (dy*dx)⁻¹
  | 3 => dy*dx
  | 4 => dx^(q/2)
  | 5 => dy^(q/2)
  | 6 => (dy*dx)⁻¹^(q/2)
  | _ => 1
def scalCost (Sn q : Nat) : Nat :=
  2 + 2 * (20 * (F.e * 1) + 13 + 4) +
  (setOpCost (wo (.lit 1)) (.lit 0) (wo (.lit 3)) (.lit 1) (.lit 1) (.lit 0) +
    opCost F Sn .multiply 0 1 1) + 2 +
  (setOpCost (wo (.lit 3)) (wo (.lit 3)) (wo (.lit 2)) (.lit 1) (.lit 1) (.lit 0) +
    opCost F Sn .inverse 0 1 1) + 5 +
  (setOpCost (.lit 0) (.lit 0) (wo (.lit 4)) (.lit 3) (.lit 1) (.lit 0) +
    opCost F Sn .power (q/2) 3 1) + 2 +
  (setOpCost (.lit 0) (.lit 0) (wo (.lit 7)) (.lit 1) (.lit 1) (.lit 0) +
    opCost F Sn .power 0 1 1) + 2 +
  3 * cmpWCost (wo (.lit 4)) (wo (.lit 7)) F.e
