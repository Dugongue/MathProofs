  have h1 : i / (a * b) < a * b := (Nat.div_lt_iff_lt_mul hab).mpr hi
  have h2 : i / (a * b) * (a * b) ≤ i := Nat.div_mul_le_self _ _
  have h3 : i < i / (a * b) * (a * b) + a * b := Nat.lt_div_mul_add hab
  have h3' : i - i / (a * b) * (a * b) < a * b := by omega
  set s := i - i / (a * b) * (a * b) with hs
  set r := i / (a * b) with hr
