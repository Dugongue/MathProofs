theorem multiset_radius_of_eventual (s : Multiset ℂ) (R C : ℝ) (hR : 0<R) (N : Nat)
    (hb : ∀ n : Nat, N≤n → ‖(s.map (fun α => α^n)).sum‖≤C*R^n)
