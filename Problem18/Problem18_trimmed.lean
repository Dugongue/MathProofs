    · intro i _
      exact (Fact.out : Irreducible (g i)).squarefree
  obtain ⟨e,E,hE,hact⟩ := exists_simultaneous_primary_coordinates S g hm (fun i => Fact.out) hf hs
  let Q := quotientPrimaryEquiv g hm hcop
  refine ⟨⟨Q.toLinearEquiv.trans E,?_⟩⟩
  intro x
  change E (Q (AdjoinRoot.root (∏ i,g i)*x))=S (E (Q x))
  rw [map_mul,quotientPrimaryEquiv_root]
  exact hact (Q x)
theorem squarefree_quotient_frame (f : K[X]) (hm : f.Monic) (hs : Squarefree f)
    (S : Module.End K V) (hf : S.charpoly=f) : Nonempty (Frames (AdjoinRoot.root f) S) := by
  classical
  let g : FactorIndex f → K[X] := fun i => i.val
  letI (i : FactorIndex f) : Fact (Irreducible (g i)) := ⟨factor_irreducible f i⟩
  have hcop : Pairwise (fun i j : FactorIndex f => IsCoprime (g i) (g j)) := by
    intro i j hij
    apply (factor_irreducible f i).coprime_iff_not_dvd.mpr
    intro hd
    have ha := ((factor_irreducible f i).dvd_irreducible_iff_associated (factor_irreducible f j)).mp hd
    exact hij (Subtype.ext (Polynomial.eq_of_monic_of_associated (factor_monic f i) (factor_monic f j) ha))
  have hp : f=∏ i,g i := factor_product f hm hs
  have h := product_quotient_frame g (factor_monic f) hcop S (hf.trans hp)
  have htransport (p q : K[X]) (he : p=q) :
      Nonempty (Frames (AdjoinRoot.root p) S) → Nonempty (Frames (AdjoinRoot.root q) S) := by
    subst q
    exact id
  exact htransport _ f hp.symm h
