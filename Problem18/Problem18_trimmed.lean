        P.comap (coefficientAutomorphism (FiniteField.frobeniusAlgEquivOfAlgebraic K L)) = P := by
  rw [geometricIdeal_eq_of_span _ _ (rowData_ideal n d rows fs h),
    ← rational_param_iff_fixed n d (rowData n d rows) (rowData_degree n d rows fs h)]
  show ((patterns (boxSize n (cpE n d))).map fun pat =>
      patternRun n d pat (flatData (rowData n d rows))).any (·.1) = true ↔ _
  rw [List.any_eq_true]
  simp only [List.mem_map, exists_exists_and_eq_and]
  constructor
  · rintro ⟨pat, _, hrun⟩
    obtain ⟨U, hU⟩ := (patternRun_correct (L := L) n d pat _).mp hrun
    exact ⟨pat.1, pat.2, U, hU⟩
