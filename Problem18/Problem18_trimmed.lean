variable {K : Type} [Field K] (F : FieldPresentation K)
theorem FState.op_state {W Sn bankLen workLen : Nat} {σ : Env}
    (h : FState F W Sn bankLen workLen σ) (a b o n bc bs : Nat) :
    FState F W Sn bankLen workLen (opState σ a b o n bc bs) := by
  unfold opState
  repeat (apply FState.setVar F <;> try decide)
  exact h
theorem vals_keep {arr : String} {σ τ : Env} {off n o m : Nat} {v : Nat → K}
    (hv : Vals F arr σ off n v)
    (hf : ∀ j, (j < o ∨ o + m ≤ j) → (τ.arrs arr).getD j 0 = (σ.arrs arr).getD j 0)
    (hd : off + F.e * n ≤ o ∨ o + m ≤ off) : Vals F arr τ off n v := by
  intro i hi t
  have := index_split (e := F.e) t.isLt hi
  rw [hf _ (by omega)]
  exact hv i hi t
theorem vals_eq {arr : String} {σ τ : Env} {off n : Nat} {v : Nat → K}
    (hv : Vals F arr σ off n v) (h : τ.arrs arr = σ.arrs arr) : Vals F arr τ off n v :=
  vals_frame F hv h
theorem vals_one {arr : String} {σ : Env} {off n : Nat} {v : Nat → K}
    (hv : Vals F arr σ off n v) (i : Nat) (hi : i < n) :
    Vals F arr σ (off + F.e * i) 1 (fun _ => v i) := by
  intro j hj t
  have hj0 : j = 0 := by omega
  subst hj0
  have := hv i hi t
  simpa using this
theorem vals_of_ones {arr : String} {σ : Env} {off n : Nat} {v : Nat → K}
    (h : ∀ i < n, Vals F arr σ (off + F.e * i) 1 (fun _ => v i)) :
    Vals F arr σ off n v := by
  intro i hi t
  have := h i hi 0 (by omega) t
  simpa using this
theorem vals_congr_fun {arr : String} {σ : Env} {off n : Nat} {v w : Nat → K}
    (hv : Vals F arr σ off n v) (h : ∀ i < n, v i = w i) : Vals F arr σ off n w := by
  intro i hi t; rw [← h i hi]; exact hv i hi t
theorem words_eq_iff {arr : String} {σ : Env} {s d : Nat} {x y : K}
    (hx : Vals F arr σ s 1 (fun _ => x)) (hy : Vals F arr σ d 1 (fun _ => y)) :
    (∀ j < F.e, (σ.arrs arr).getD (s + j) 0 = (σ.arrs arr).getD (d + j) 0) ↔ x = y := by
  constructor
  · intro h
    apply F.coordinate.injective
    funext t
    apply Fin.ext
    have h1 := hx 0 (by omega) t
    have h2 := hy 0 (by omega) t
    simp only [Nat.mul_zero, Nat.add_zero] at h1 h2
    rw [← h1, ← h2]
    exact h t.val t.isLt
  · rintro rfl j hj
    have h1 := hx 0 (by omega) ⟨j, hj⟩
    have h2 := hy 0 (by omega) ⟨j, hj⟩
    simp only [Nat.mul_zero, Nat.add_zero] at h1 h2
    rw [h1, h2]
theorem vals_of_data {src dst : String} {σ τ : Env} {s d n : Nat} {v : Nat → K}
    (hv : Vals F src σ s n v)
    (hdata : ∀ j, (τ.arrs dst).getD j 0 =
        if d ≤ j ∧ j < d + F.e * n then (σ.arrs src).getD (s + (j - d)) 0
        else (σ.arrs dst).getD j 0) : Vals F dst τ d n v := by
  intro i hi t
  have := index_split (e := F.e) t.isLt hi
  rw [hdata, if_pos (by omega), show s + (d + F.e * i + t.val - d) = s + F.e * i + t.val by omega]
  exact hv i hi t
theorem bankCopy_run {W Sn bankLen workLen : Nat} {σ : Env}
    (hS : FState F W Sn bankLen workLen σ) {s d n : Expr} {sv dv nv : Nat} {v : Nat → K}
    (hcs : Clean s) (hcd : Clean d) (hcn : Clean n)
    (hs : s.evalB W σ = some sv) (hd : d.evalB W σ = some dv)
    (hn : n.evalB W σ = some (F.e * nv))
    (hv : Vals F bank σ sv nv v) (hsl : sv + F.e * nv ≤ bankLen)
    (hdl : dv + F.e * nv ≤ workLen) :
    ∃ τ, Run W (copyBlock bank work s d n) σ τ
        (20 * (F.e * nv) + 13 + s.size + d.size + n.size) ∧
      FState F W Sn bankLen workLen τ ∧ Vals F work τ dv nv v ∧
      (∀ j, (j < dv ∨ dv + F.e * nv ≤ j) → (τ.arrs work).getD j 0 = (σ.arrs work).getD j 0) ∧
      (∀ x, x ∉ wcRegs → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ work → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hG := hS.glob
  have hB2 : 1 < W := by have := hS.mem_lt; have := F.degree_pos; omega
  have hlt := vals_lt F hv
  have hpW := hS.p_lt
  obtain ⟨τ, hr, hvv, ha, hl, hdata, hi, ho⟩ := copyBlock_run (B := W) bank work
    (Ne.symm work_ne_bank) σ hcs hcd hcn hs hd hn (by rw [hG.bank_len]; exact hsl)
    (by rw [hS.wlen]; exact hdl) (by rw [hG.bank_len]; exact hG.bank_word)
    (by rw [hS.wlen]; exact hS.wword) (by intro j hj; have := hlt j hj; omega) hB2
  have hregs : ∀ x ∈ [canonical.e, canonical.p, canonical.modBase, memTail], x ∉ wcRegs := by
    decide
  have hG' : Glob F W Sn bankLen τ := Glob.transfer F hG
    (hvv _ (hregs _ (by simp))) (hvv _ (hregs _ (by simp))) (hvv _ (hregs _ (by simp)))
    (by intro i; rw [ha _ (Ne.symm work_ne_mem)])
    (by intro a; by_cases ha' : a = work
        · subst ha'; exact hl
        · rw [ha a ha'])
  refine ⟨τ, hr, FState.transfer F hS hG' (hvv _ (hregs _ (by simp))) hl,
    vals_of_data F hv hdata, ?_, hvv, ha, hi, ho⟩
  intro j hj; rw [hdata, if_neg (by omega)]
def cmpW (flag : String) (s d : Expr) : Com :=
  .seq (.assign cS s) <| .seq (.assign cD d) <| .seq (.assign cCnt (.var canonical.e)) <|
    cmpLoop work flag (rhsPair work) 0
def cmpWCost (s d : Expr) (e : Nat) : Nat := s.size + d.size + 4 + ((5 + 16) * e + 6)
theorem cmpW_run [DecidableEq K] {W Sn bankLen workLen : Nat} (flag : String) {σ : Env}
    (hS : FState F W Sn bankLen workLen σ) (s d : Expr) {sv dv : Nat} {x y : K}
    (hf : flag ∉ [cIdx, cS, cD, cCnt]) (hrs : ∀ z ∈ reads s ++ reads d, z ∉ [cS, cD, cCnt])
    (hs : Fine W σ s) (hd : Fine W σ d) (hsv : evalN σ s = sv) (hdv : evalN σ d = dv)
    (hx : Vals F work σ sv 1 (fun _ => x)) (hy : Vals F work σ dv 1 (fun _ => y))
    (hsfit : sv + F.e ≤ workLen) (hdfit : dv + F.e ≤ workLen) :
    ∃ τ, Run W (cmpW flag s d) σ τ (cmpWCost s d F.e) ∧
      τ.vars flag = (if x = y then σ.vars flag else 0) ∧
      (∀ z, z ∉ [cIdx, cS, cD, cCnt, flag] → τ.vars z = σ.vars z) ∧ τ.arrs = σ.arrs ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hf' : flag ≠ cIdx ∧ flag ≠ cS ∧ flag ≠ cD ∧ flag ≠ cCnt := by
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hf; exact hf
  have hG := hS.glob
  have hWw := hS.wword
  have he := F.degree_pos
  have hpW := hS.p_lt
  have n1 : cS ≠ cCnt := by decide
  have n2 : cS ≠ cD := by decide
  have n3 : cD ≠ cCnt := by decide
  have hlen' : (σ.arrs work).length = workLen := hS.wlen
  let σ1 := σ.setVar cS sv
  have e1 : s.evalB W σ = some sv := hsv ▸ evalB_fine s hs
  have e2 : d.evalB W σ1 = some dv := by
    rw [← hdv]; apply evalB_transport d _ hd
    intro z hz; have := hrs z (by simp [hz]); simp [σ1, show z ≠ cS by intro h; simp_all]
  let σ2 := σ1.setVar cD dv
  have e3 : (Expr.var canonical.e).evalB W σ2 = some F.e := by
    have h : σ2.vars canonical.e = F.e := by simp [σ2, σ1]; exact hG.e_reg
    rw [← h]; exact evalB_var (by rw [h]; have := hS.mem_lt; omega)
  let σ3 := σ2.setVar cCnt F.e
  have hw3 : σ3.arrs = σ.arrs := rfl
  have hlen : (σ3.arrs work).length = workLen := hS.wlen
  obtain ⟨τ, hr, hfl, hvars, harr, hi, ho⟩ := cmpLoop_run (B := W) (n := F.e) (s := sv) work flag
    (rhsPair work) 0 (σ := σ3) hf'.1 hf'.2.2.2 hf'.2.1 (by simp [σ3, σ2, σ1, n1, n2])
    (by simp [σ3]) (by rw [hlen]; exact hsfit) (by rw [hlen]; exact hWw)
    (by intro j hj; have := vals_lt F hx j (by omega); show (σ.arrs work).getD (sv+j) 0 < W; omega) (by omega)
    (fun j => (σ.arrs work).getD (dv + j) 0) (by
      intro ρ hρa hρv hρi
      have hd' : ρ.vars cD = dv := by
        rw [hρv cD (by decide) (Ne.symm hf'.2.2.1)]; simp [σ3, σ2, n3]
      have eI : (Expr.add (.var cD) (.var cIdx)).evalB W ρ = some (dv + ρ.vars cIdx) := by
        have := evalB_bin (op := Bop.add) (evalB_var (σ := ρ) (x := cD) (B := W)
          (by rw [hd']; omega)) (evalB_var (σ := ρ) (x := cIdx) (B := W) (by omega))
          (by show ρ.vars cD + ρ.vars cIdx < W; rw [hd']; omega)
        simpa [hd'] using this
      apply evalB_get eI
      · rw [hρa, hw3, List.getElem?_eq_getElem (by rw [hlen']; omega)]
        simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem
          (show dv + ρ.vars cIdx < (σ.arrs work).length by rw [hlen']; omega)]
      · have := vals_lt F hy (ρ.vars cIdx) (by omega); omega)
  refine ⟨τ, ?_, ?_, ?_, harr.trans hw3, hi, ho⟩
  · have hall := (Run.assign (x := cS) e1).seq ((Run.assign (x := cD) e2).seq
      ((Run.assign (x := cCnt) e3).seq hr))
    apply hall.mono
    simp only [cmpWCost, rhsPair, Expr.size]; omega
  · rw [hfl]
    have hflag : σ3.vars flag = σ.vars flag := by
      simp [σ3, σ2, σ1, hf'.2.1, hf'.2.2.1, hf'.2.2.2]
    rw [hflag]
    congr 1
    exact propext (words_eq_iff F (σ := σ3) hx hy)
  · intro z hz
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hz
    rw [hvars z hz.1 hz.2.2.2.2]
    simp [σ3, σ2, σ1, hz.2.1, hz.2.2.1, hz.2.2.2.1]
end
