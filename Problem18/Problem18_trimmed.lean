      evalB_var (B:=B) (σ:=σ) (x:=nR) (by rw [hn]; simp only [majorant] at hB; omega)
  | vd => simpa only [expr,value,hd] using
      evalB_var (B:=B) (σ:=σ) (x:=dR) (by rw [hd]; simp only [majorant] at hB; omega)
  | ve => simpa only [expr,value,he] using
      evalB_var (B:=B) (σ:=σ) (x:=eR) (by rw [he]; simp only [majorant] at hB; omega)
  | vsb => simpa only [expr,value,hb] using
      evalB_var (B:=B) (σ:=σ) (x:=sbR) (by rw [hb]; simp only [majorant] at hB; omega)
  | add a c ha hc =>
    have h1 : majorant a n d e b < B := by simp only [majorant] at hB; omega
