    refine ⟨?_, rfl⟩
    nlinarith
  · rintro ⟨rfl, rfl⟩
    rw [Nat.add_zero, show E*(i*n+i)=(n+1)*E*i by ring]
    exact Nat.mul_mod_right _ _
