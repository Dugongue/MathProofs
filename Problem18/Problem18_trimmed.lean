    intro i
    simp only [Problem18IMPFieldMultiplication20261001.sourceCoeff, h.mod_reg, Nat.zero_add]
    exact h.modulus i
  coefficients := hcoef
def memTail : String := "P18.pair.memTail"
def reset : Com := zeroBlock canonical.mem (.var canonical.e) (.var memTail)
theorem reset_run {W Sn bankLen : Nat} {σ : Env} (h : Glob F W Sn bankLen σ)
    (ht : σ.vars memTail = 1 + Sn * F.e) :
    ∃ τ, Run W reset σ τ (20 * (1 + Sn * F.e) + 14) ∧
      Glob F W Sn bankLen τ ∧ ValidMemory F W τ ∧
      (∀ j, F.e ≤ j → (τ.arrs canonical.mem).getD j 0 = 0) ∧
      (∀ x, x ∉ wcRegs → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ canonical.mem → τ.arrs a = σ.arrs a) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hlen := h.mem_len
  have hw := h.mem_word
  have hB2 : 1 < W := by have := F.degree_pos; omega
  obtain ⟨τ, hr, hv, ha, hl, hd, hi, ho⟩ := zeroBlock_run (B := W) canonical.mem σ
    (d := .var canonical.e) (n := .var memTail) (dv := F.e) (nv := 1 + Sn * F.e)
    (by refine ⟨?_, ?_, ?_⟩ <;> simp [Problem18ClaudeIMPSlots20261001.NoVar] <;> decide)
    (by rw [← h.e_reg]; exact evalB_var (by rw [h.e_reg]; omega))
    (by rw [← ht]; exact evalB_var (by rw [ht]; omega))
    (by omega) hw hB2
  have hregs : ∀ x ∈ [canonical.e, canonical.p, canonical.modBase], x ∉ wcRegs := by decide
  have hG : Glob F W Sn bankLen τ := Glob.transfer F h
    (hv _ (hregs _ (by simp))) (hv _ (hregs _ (by simp))) (hv _ (hregs _ (by simp)))
    (by intro i; rw [hd, if_neg (by have := i.isLt; omega)])
    (by intro arr; by_cases harr : arr = canonical.mem
        · subst harr; exact hl
        · rw [ha arr harr])
  have hzero : ∀ j, F.e ≤ j → (τ.arrs canonical.mem).getD j 0 = 0 := by
    intro j hj
    rw [hd]
    by_cases hjl : j < F.e + (1 + Sn * F.e)
    · rw [if_pos ⟨hj, hjl⟩]
    · rw [if_neg (by omega), List.getD_eq_getElem?_getD,
