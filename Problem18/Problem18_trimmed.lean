    rawCheck u q A=true ↔ RawGood u q A := by
  have he : Set.range (fun t : Fin (b*b)=>rawSecond u q A (finProdFinEquiv.symm t))=
      Set.range (rawSecond u q A) := by
    ext X
    constructor
    · rintro ⟨t,rfl⟩; exact ⟨finProdFinEquiv.symm t,rfl⟩
    · rintro ⟨kl,rfl⟩; exact ⟨finProdFinEquiv kl,by simp⟩
  simp only [rawCheck,Bool.and_eq_true,generationCheck_correct,he,RawGood]
