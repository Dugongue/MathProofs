namespace Mathproof.Problem18RootQuadraticBasis20261001
open Problem18AllFormatRoot20260930 Problem18InvolutionNorm20260930
open Problem18ExplicitFixedCoordinates20261001 Problem18UnitaryRootField20260930
open Meta.Problem18BoundedGeneratorBasis20260930 Meta.Problem18BoundedQuadraticCoordinates20260930
variable {K : Type} [Field K] [Fintype K]
theorem generator_out (F : FieldPresentation K) {q : ℕ} (d : UnitaryFieldData (K:=K) q) :
    F.generator∉Set.range (algebraMap (fixedField d.automorphism) K) := by
  rintro ⟨z,hz⟩
  apply presentation_generator_not_fixed F d.automorphism d.nontrivial
  rw [←hz]
  exact (mem_fixedField d.automorphism z.val).mp z.property
noncomputable def rootBasis (F : FieldPresentation K) {q : ℕ} (d : UnitaryFieldData (K:=K) q) :
    Module.Basis (Fin 2) (fixedField d.automorphism) K :=
  generatorBasis F.generator (generator_out F d)
    (finrank_fixedField d.automorphism d.involutive d.nontrivial)
theorem rootBasis_zero (F : FieldPresentation K) {q : ℕ} (d : UnitaryFieldData (K:=K) q) :
    rootBasis F d 0=1 := by simp only [rootBasis,generatorBasis_zero]
theorem rootBasis_one (F : FieldPresentation K) {q : ℕ} (d : UnitaryFieldData (K:=K) q) :
    rootBasis F d 1=F.generator := by simp only [rootBasis,generatorBasis_one]
theorem root_coordinates_basisEval (F : FieldPresentation K) {q : ℕ}
    (d : UnitaryFieldData (K:=K) q) (x : K) : basisEval (rootBasis F d) (rootCoordinates F d x)=x := by
  rw [basisEval_eq (rootBasis F d) F.generator (rootBasis_zero F d) (rootBasis_one F d)]
  exact coordinates_reconstruct d.automorphism d.involutive F.generator
    (presentation_generator_not_fixed F d.automorphism d.nontrivial).symm x
def rootTrace (F : FieldPresentation K) {q : ℕ} (d : UnitaryFieldData (K:=K) q) :
    fixedField d.automorphism :=
  ⟨F.generator+d.automorphism F.generator,(mem_fixedField _ _).mpr (by
    rw [map_add,d.involutive,add_comm])⟩
def rootNegNorm (F : FieldPresentation K) {q : ℕ} (d : UnitaryFieldData (K:=K) q) :
    fixedField d.automorphism :=
  ⟨-(F.generator*d.automorphism F.generator),(mem_fixedField _ _).mpr (by
    rw [map_neg,map_mul,d.involutive,mul_comm])⟩
theorem generator_quadratic (F : FieldPresentation K) {q : ℕ} (d : UnitaryFieldData (K:=K) q) :
    F.generator^2=algebraMap (fixedField d.automorphism) K (rootTrace F d)*F.generator+
      algebraMap (fixedField d.automorphism) K (rootNegNorm F d) := by
  change F.generator^2=(F.generator+d.automorphism F.generator)*F.generator+
    -(F.generator*d.automorphism F.generator)
  ring
theorem coordinates_mul (F : FieldPresentation K) {q : ℕ} (d : UnitaryFieldData (K:=K) q) (x y : K) :
    rootCoordinates F d (x*y)=coordinateMul (rootTrace F d) (rootNegNorm F d)
      (rootCoordinates F d x) (rootCoordinates F d y) := by
  apply (basisEval_bijective (rootBasis F d)).1
  rw [root_coordinates_basisEval,basisEval_coordinateMul (rootBasis F d) F.generator
    (rootBasis_zero F d) (rootBasis_one F d) (rootTrace F d) (rootNegNorm F d)
    (generator_quadratic F d),root_coordinates_basisEval,root_coordinates_basisEval]
theorem coordinates_conjugate (F : FieldPresentation K) {q : ℕ} (d : UnitaryFieldData (K:=K) q) (x : K) :
    rootCoordinates F d (d.automorphism x)=coordinateConj (rootTrace F d) (rootCoordinates F d x) := by
  apply (basisEval_bijective (rootBasis F d)).1
  have ht : fixedFieldAlgEquiv d.automorphism F.generator=
      algebraMap (fixedField d.automorphism) K (rootTrace F d)-F.generator := by
    change d.automorphism F.generator=(F.generator+d.automorphism F.generator)-F.generator
    ring
  rw [root_coordinates_basisEval,basisEval_coordinateConj (rootBasis F d) F.generator
    (rootBasis_zero F d) (rootBasis_one F d) (fixedFieldAlgEquiv d.automorphism) (rootTrace F d) ht,
    root_coordinates_basisEval]
  rfl
end Mathproof.Problem18RootQuadraticBasis20261001
end
