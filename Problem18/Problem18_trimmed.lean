variable {K i ι : Type*} [Field K] [Fintype i] [DecidableEq i] [Nonempty i]
theorem matrix_intertwiner_isUnit (S T : ι → Matrix i i K) (X : Matrix i i K)
    (hX0 : X ≠ 0) (hgen : Algebra.adjoin K (Set.range S) = ⊤)
    (hX : ∀ j, X * S j = T j * X) : IsUnit X := by
  let e : Matrix i i K ≃ₐ[K] Module.End K (i → K) := Matrix.toLinAlgEquiv'
  have hg : Algebra.adjoin K (Set.range (fun j => e (S j))) = ⊤ := by
    have hr : Set.range (fun j => e (S j)) = e '' Set.range S := by
      ext y
      simp
    rw [hr]
    calc
      Algebra.adjoin K (e '' Set.range S) = (Algebra.adjoin K (Set.range S)).map e.toAlgHom :=
        (e.toAlgHom.map_adjoin (Set.range S)).symm
      _ = (⊤ : Subalgebra K (Matrix i i K)).map e.toAlgHom :=
        congrArg (fun A : Subalgebra K (Matrix i i K) => A.map e.toAlgHom) hgen
      _ = ⊤ := (Algebra.map_top e.toAlgHom).trans
        ((AlgHom.range_eq_top e.toAlgHom).mpr e.surjective)
  have hn : e X ≠ 0 := by
    intro h
    apply hX0
    apply e.injective
    simpa using h
  have hu := intertwiner_isUnit (fun j => e (S j)) (fun j => e (T j))
    (e X) hn hg (fun j => by simpa using congrArg e (hX j))
  have hback : IsUnit (e.symm (e X)) := hu.map e.symm.toMonoidHom
  rwa [e.symm_apply_apply] at hback
theorem intertwiner_line (S T : ι → Matrix i i K) (X Y : Matrix i i K)
    (hX0 : X ≠ 0) (hgen : Algebra.adjoin K (Set.range S) = ⊤)
    (hX : ∀ j, X * S j = T j * X) (hY : ∀ j, Y * S j = T j * Y) :
    ∃ c : K, Y = c • X := by
  have hu := matrix_intertwiner_isUnit S T X hX0 hgen hX
  have hd := X.isUnit_iff_isUnit_det.mp hu
  have hi (j : ι) : X⁻¹ * T j = S j * X⁻¹ := by
    have h := congrArg (fun M : Matrix i i K => X⁻¹ * M * X⁻¹) (hX j)
    simpa only [← Matrix.mul_assoc, Matrix.nonsing_inv_mul X hd, Matrix.one_mul,
      Matrix.mul_nonsing_inv_cancel_right X (X⁻¹ * T j) hd] using h.symm
  obtain ⟨c, hc⟩ := FiniteFieldOrthogonalUnitaryTI.scalar_of_generates
    (Set.range S) (X⁻¹ * Y) hgen (by
      rintro _ ⟨j, rfl⟩
      rw [Matrix.mul_assoc, hY j, ← Matrix.mul_assoc, hi j, Matrix.mul_assoc])
  refine ⟨c, ?_⟩
  have h := congrArg (fun M : Matrix i i K => X * M) hc
  simpa only [Matrix.mul_nonsing_inv_cancel_left X Y hd, Matrix.mul_smul,
    Matrix.mul_one] using h
section Star
variable [StarRing K]
theorem ordered_scalar_gram (S T : ι → Matrix i i K) (mate : ι → ι)
    (hS : ∀ j, (S (mate j))ᴴ = S j) (hT : ∀ j, (T (mate j))ᴴ = T j)
    (hgen : Algebra.adjoin K (Set.range S) = ⊤)
    (X : Matrix i i K) (hX0 : X ≠ 0) (hX : ∀ j, X * S j = T j * X) :
    ∃ d : K, d ≠ 0 ∧ star d = d ∧ Xᴴ * X = d • (1 : Matrix i i K) := by
  obtain ⟨d, hd⟩ := matched_adjoint_scalar_gram S T mate hS hT hgen X hX
  have hu := matrix_intertwiner_isUnit S T X hX0 hgen hX
  have hdet := X.isUnit_iff_isUnit_det.mp hu
  have hd0 : d ≠ 0 := by
    intro hz
    have hg : (Xᴴ * X).det ≠ 0 := by
      rw [Matrix.det_mul, Matrix.det_conjTranspose]
      exact mul_ne_zero (star_ne_zero.mpr hdet.ne_zero) hdet.ne_zero
    simp [hd, hz] at hg
  refine ⟨d, hd0, ?_, hd⟩
  have h := congrArg Matrix.conjTranspose hd
  simp only [Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose,
    Matrix.conjTranspose_smul, Matrix.conjTranspose_one] at h
  rw [hd] at h
  obtain ⟨j⟩ := ‹Nonempty i›
  have he := congrArg (fun M : Matrix i i K => M j j) h
  simpa using he.symm
end Star
end Problem18OrderedRecovery20260930
