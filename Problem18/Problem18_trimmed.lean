theorem unitary_transpose (R : Matrix i i K) (hR : IsUnitary R) :
    IsUnitary R.transpose := by
  have h := congrArg Matrix.transpose (unitary_mul_conjTranspose hR)
  simpa [IsUnitary, Matrix.transpose_mul, Matrix.conjTranspose,
    Matrix.transpose_map] using h
theorem unitary_kronecker {j : Type*} [Fintype j] [DecidableEq j]
    (Q : Matrix i i K) (R : Matrix j j K)
    (hQ : IsUnitary Q) (hR : IsUnitary R) :
    IsUnitary (Matrix.kronecker Q R) := by
  unfold IsUnitary at *
  unfold Matrix.kronecker
  rw [Matrix.conjTranspose_kronecker, ← Matrix.mul_kronecker_mul, hQ, hR,
    Matrix.one_kronecker_one]
end UnitaryRecovery
theorem quadratic_norm {F : Type*} [Field F] [Finite F] [Finite K]
    [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F) (x : K) :
    algebraMap F K (Algebra.norm F x) = star x * x := by
  have hq : 1 < Nat.card F := Finite.one_lt_card
  have hexp : (Nat.card K - 1) / (Nat.card F - 1) = Nat.card F + 1 := by
    rw [hcard]
    have hprod : Nat.card F ^ 2 - 1 =
        (Nat.card F + 1) * (Nat.card F - 1) := by
      have hsub : Nat.card F - 1 + 1 = Nat.card F := Nat.sub_add_cancel (by omega)
      have hsq : Nat.card F ^ 2 - 1 + 1 = Nat.card F ^ 2 :=
        Nat.sub_add_cancel (by nlinarith)
      nlinarith
    rw [hprod, Nat.mul_div_cancel _ (by omega : 0 < Nat.card F - 1)]
  rw [FiniteField.algebraMap_norm_eq_pow, hexp, pow_succ, hstar]
section HermitianRecovery
theorem fixed_scalar_descends {F : Type*} [Field F] [Fintype F] [Finite K]
    [Algebra F K] [StarRing K]
    (hstar : ∀ x : K, star x = x ^ Nat.card F) (x : K) (hx : star x = x) :
    ∃ d : F, algebraMap F K d = x := by
  apply (IsGalois.mem_range_algebraMap_iff_fixed x).mpr
  intro σ
  obtain ⟨j, rfl⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow F K).2 σ
  have hf : FiniteField.frobeniusAlgEquivOfAlgebraic F K x = x := by
    change x ^ Fintype.card F = x
    rw [Fintype.card_eq_nat_card, ← hstar x]
    exact hx
  have hp : ∀ m : ℕ, (FiniteField.frobeniusAlgEquivOfAlgebraic F K ^ m) x = x := by
    intro m
    induction m with
    | zero => rfl
    | succ m ih => rw [pow_succ, AlgEquiv.mul_apply, hf, ih]
  exact hp j.val
end HermitianRecovery
section PolynomialCounting
open Polynomial
noncomputable def monicCoefficients (n : ℕ) :
    {p : K[X] // p.Monic ∧ p.natDegree = n} ≃ (Fin n → K) :=
  (Polynomial.monicEquivDegreeLT n).trans (Polynomial.degreeLTEquiv K n).toEquiv
theorem card_monic_polynomials [Finite K] (n : ℕ) :
    Nat.card {p : K[X] // p.Monic ∧ p.natDegree = n} = Nat.card K ^ n := by
  rw [Nat.card_congr (monicCoefficients (K := K) n)]
  rw [Nat.card_fun, Nat.card_fin]
