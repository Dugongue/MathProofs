    (by omega) (by omega) (by rw [arr1]; omega)
  have rv2 : ∀ x, x ∉ zArgs.map Prod.fst → x ≠ zj → ν2.vars x = ν.vars x :=
    fun x h1 h2 => (v2 x h2).trans (rest1 x h1)
  have hz12 : ∀ x ∈ [nR, dR, eR, sbR, canonical.e, canonical.p, canonical.modBase, canonical.exp],
