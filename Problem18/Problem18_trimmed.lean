theorem monomial_correction_lt {σ K ι : Type*} [Field K]
    (m : MonomialOrder σ) (b : ι → MvPolynomial σ K)
    (q : ι →₀ MvPolynomial σ K) (P : MvPolynomial σ K)
    (D E : σ →₀ ℕ) (hD : (⊥ : m.syn) < m.toSyn D)
    (hE : E ≤ D) (hP : m.toSyn (m.degree P) ≤ m.toSyn (D-E))
    (hq : ∀ k, q k ≠ 0 → m.toSyn (m.degree (b k * q k)) < m.toSyn E) :
    representationDegree m b (P • q) < m.toSyn D := by
  apply representationDegree_lt_of_forall m b _ _ hD
  intro k hk
  have hqk : q k ≠ 0 := by
    intro hz
    apply hk
    simp [Finsupp.smul_apply, hz]
  change m.toSyn (m.degree (b k * (P * q k))) < m.toSyn D
  rw [mul_left_comm]
  calc
    m.toSyn (m.degree (P * (b k * q k))) ≤
        m.toSyn (m.degree P) + m.toSyn (m.degree (b k * q k)) := by
      simpa only [map_add] using m.degree_mul_le (f := P) (g := b k * q k)
    _ < m.toSyn (D-E) + m.toSyn E := add_lt_add_of_le_of_lt hP (hq k hqk)
    _ = m.toSyn D := by rw [← map_add, tsub_add_cancel_of_le hE]
theorem general_representation_improvement
    {σ K ι : Type*} [Field K]
    (m : MonomialOrder σ)
    (b : ι → MvPolynomial σ K)
    (hb : ∀ i : ι, b i ≠ 0)
    (pairs : ι → ι → ι →₀ MvPolynomial σ K)
    (hpairs : ∀ i j, Finsupp.linearCombination (MvPolynomial σ K) b (pairs i j) =
      m.sPolynomial (b i) (b j))
    (hsmall : ∀ i j k, pairs i j k ≠ 0 →
      m.toSyn (m.degree (b k * pairs i j k)) <
        m.toSyn (m.degree (b i) ⊔ m.degree (b j)))
    (g : ι →₀ MvPolynomial σ K)
    (p : MvPolynomial σ K)
    (hrep : Finsupp.linearCombination (MvPolynomial σ K) b g = p)
    (hbad : m.toSyn (m.degree p) < representationDegree m b g)
    (hresidual :
      representationDegree m b
        (g - ∑ i ∈ g.support.filter
            (fun i => m.toSyn (m.degree (b i * g i)) =
              representationDegree m b g),
          Finsupp.single i (m.leadingTerm (g i))) <
        representationDegree m b g) :
    ∃ g' : ι →₀ MvPolynomial σ K,
      Finsupp.linearCombination (MvPolynomial σ K) b g' = p ∧
        representationDegree m b g' < representationDegree m b g := by
  classical
  let d : m.syn := representationDegree m b g
  let D : σ →₀ ℕ := m.toSyn.symm d
  let B : Finset ι := g.support.filter
    (fun i => m.toSyn (m.degree (b i * g i)) = d)
  have hd : (⊥ : m.syn) < d :=
    lt_of_le_of_lt bot_le hbad
  have hsum : (∑ i ∈ g.support, b i * g i) = p := by
    simpa [Finsupp.linearCombination_apply, Finsupp.sum,
      smul_eq_mul, mul_comm] using hrep
  have htotal :
      m.toSyn (m.degree (∑ i ∈ g.support, b i * g i)) <
        m.toSyn D := by
    rw [hsum]
    simpa [D] using hbad
  have hbound : ∀ i ∈ g.support,
      m.toSyn (m.degree (b i * g i)) ≤ m.toSyn D := by
    intro i hi
    simpa [D, d] using
      degree_mul_le_representationDegree m b g i
        (Finsupp.mem_support_iff.mp hi)
  have htopcancel :
      m.toSyn (m.degree
        (∑ i ∈ B, m.leadingTerm (g i) * b i)) < d := by
    have hfilter :
        g.support.filter (fun i => m.degree (b i * g i) = D) = B := by
      ext i
      simp only [B, Finset.mem_filter]
      change
        (i ∈ g.support ∧ m.degree (b i * g i) = D) ↔
          (i ∈ g.support ∧ m.toSyn (m.degree (b i * g i)) = d)
      constructor
      · rintro ⟨hi, hdegree⟩
        refine ⟨hi, ?_⟩
        rw [hdegree]
        simp [D]
      · rintro ⟨hi, hdegree⟩
        refine ⟨hi, ?_⟩
        apply m.toSyn.injective
        simpa [D] using hdegree
    simpa [hfilter, D] using
      top_leadingTerm_sum_degree_lt m b (fun i => g i)
        g.support D hbound htotal
  have htop : ∀ i ∈ B,
      m.toSyn (m.degree (m.leadingTerm (g i) * b i)) = d ∨
        m.leadingTerm (g i) * b i = 0 := by
    intro i hi
    left
    have hi' := (Finset.mem_filter.mp hi).2
    simpa [m.degree_leadingTerm_mul, mul_comm] using hi'
  obtain ⟨c, hc⟩ := top_leading_multiple_sPolynomial_decomposition
    m B b (fun i => g i) d htop htopcancel
  let P : ι → ι → MvPolynomial σ K := fun i j =>
    MvPolynomial.monomial
      (m.degree (g i * b i) ⊔ m.degree (g j * b j) -
        m.degree (b i) ⊔ m.degree (b j))
      (m.leadingCoeff (g i) * m.leadingCoeff (g j))
  let residual := g - ∑ i ∈ B, Finsupp.single i (m.leadingTerm (g i))
  let correction : ι → ι → ι →₀ MvPolynomial σ K := fun i j =>
    (c i j • P i j) • pairs i j
  refine ⟨residual + ∑ i ∈ B, ∑ j ∈ B, correction i j, ?_, ?_⟩
  · have hremove : Finsupp.linearCombination (MvPolynomial σ K) b
        (∑ i ∈ B, Finsupp.single i (m.leadingTerm (g i))) =
        ∑ i ∈ B, m.leadingTerm (g i) * b i := by
      simp only [map_sum, Finsupp.linearCombination_single, smul_eq_mul]
    have hrestore : Finsupp.linearCombination (MvPolynomial σ K) b
        (∑ i ∈ B, ∑ j ∈ B, correction i j) =
        ∑ i ∈ B, m.leadingTerm (g i) * b i := by
      rw [hc]
      simp only [map_sum, correction, map_smul, hpairs, smul_eq_mul, P,
        smul_mul_assoc]
    simp only [map_add, residual, map_sub, hremove, hrestore, sub_add_cancel, hrep]
  · apply representationDegree_add_sum_sum_lt m b residual B B correction d hd
    · exact hresidual
    · intro i hi j hj
      have heq : ∀ k ∈ B, m.degree (g k * b k) = D := by
        intro k hk
        apply m.toSyn.injective
        simpa [mul_comm, D] using (Finset.mem_filter.mp hk).2
      have hgi : g i ≠ 0 := Finsupp.mem_support_iff.mp (Finset.mem_filter.mp hi).1
      have hgj : g j ≠ 0 := Finsupp.mem_support_iff.mp (Finset.mem_filter.mp hj).1
      have hE : m.degree (b i) ⊔ m.degree (b j) ≤ D := by
        apply sup_le
        · rw [← heq i hi, m.degree_mul hgi (hb i)]
          exact self_le_add_left _ _
        · rw [← heq j hj, m.degree_mul hgj (hb j)]
          exact self_le_add_left _ _
      have hP : m.toSyn (m.degree (c i j • P i j)) ≤
          m.toSyn (D - (m.degree (b i) ⊔ m.degree (b j))) := by
        apply (m.degree_smul_le (r := c i j) (f := P i j)).trans
        dsimp [P]
        rw [heq i hi, heq j hj, sup_idem]
        exact m.degree_monomial_le (m.leadingCoeff (g i) * m.leadingCoeff (g j))
      simpa only [correction, D, AddEquiv.apply_symm_apply] using
        monomial_correction_lt m b (pairs i j) (c i j • P i j) D
          (m.degree (b i) ⊔ m.degree (b j)) (by simpa [D] using hd)
          hE hP (hsmall i j)
theorem leading_divisibility_of_small_pairs {σ K ι : Type*} [Field K]
    (m : MonomialOrder σ) (b : ι → MvPolynomial σ K)
    (hb : ∀ i, b i ≠ 0)
    (pairs : ι → ι → ι →₀ MvPolynomial σ K)
    (hpairs : ∀ i j, Finsupp.linearCombination (MvPolynomial σ K) b (pairs i j) =
      m.sPolynomial (b i) (b j))
    (hsmall : ∀ i j k, pairs i j k ≠ 0 →
      m.toSyn (m.degree (b k * pairs i j k)) <
        m.toSyn (m.degree (b i) ⊔ m.degree (b j)))
    (p : MvPolynomial σ K) (hp : p ≠ 0)
    (hrep : ∃ g : ι →₀ MvPolynomial σ K,
      Finsupp.linearCombination (MvPolynomial σ K) b g = p) :
    ∃ i, m.degree (b i) ≤ m.degree p := by
  classical
  apply exists_degree_le_of_representationImprovement m b hb p hp hrep
  intro g hg hbad
  apply general_representation_improvement m b hb pairs hpairs hsmall g p hg hbad
  apply representationDegree_strip_top_leading_terms_lt m b g _ _
    (lt_of_le_of_lt bot_le hbad) hb
    (degree_mul_le_representationDegree_all m b g)
  intro i
  simp only [Finset.mem_filter, Finsupp.mem_support_iff]
