      (∑ x, χ (P x)) / (Fintype.card Ω : ℂ) = (a χ : ℂ))
    (y : G) :
    ‖uniformImageWeight P y‖ ≤ ‖uniformImageWeight P 0‖ := by
  classical
  have hinv (z : G) :
