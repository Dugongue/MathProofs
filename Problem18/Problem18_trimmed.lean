noncomputable def pullback (C : Form (V := Fin s → K) τ)
    (L : (Fin n → K) →ₗ[K] (Fin s → K)) : Form (V := Fin n → K) τ where
  toFun x := (C (L x)).comp L
  map_add' x y := by ext z; simp only [map_add,LinearMap.comp_apply,LinearMap.add_apply]
  map_smul' a x := by
    ext z
    simp only [map_smul,map_smulₛₗ,LinearMap.comp_apply,LinearMap.smul_apply]
