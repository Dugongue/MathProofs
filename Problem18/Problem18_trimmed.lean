    fun i c => c * (Nat.cast (i+1) : K)
  ⟨(CPolynomial.Raw.mk arr).trim,CPolynomial.Raw.Trim.isCanonical_trim _⟩
theorem coeff_derivative (p : CPolynomial K) (n : ℕ) :
    (derivative p).coeff n=p.coeff (n+1)*(↑(n+1):K) := by
  simp only [derivative,CPolynomial.coeff,CPolynomial.Raw.Trim.coeff_eq_coeff,
    CPolynomial.Raw.coeff,CPolynomial.Raw.mk]
  by_cases hn : n+1<Array.size p.val
  · unfold Array.getD
    simp only [Array.size_mapIdx,Array.size_extract,Nat.min_self,hn,dite_true]
    split
    · simp [Array.getElem_mapIdx,Array.getElem_extract,Nat.add_comm 1 n]
    · omega
  · unfold Array.getD
    simp only [Array.size_mapIdx,Array.size_extract,Nat.min_self,hn,dite_false]
    split
    · omega
    · simp
theorem derivative_toPoly (p : CPolynomial K) :
    (derivative p).toPoly=p.toPoly.derivative := by
  ext n
  rw [← CPolynomial.coeff_toPoly,coeff_derivative,CPolynomial.coeff_toPoly,
    Polynomial.coeff_derivative]
  push_cast
  ring
def unitCheck (p : CPolynomial K) : Bool :=
  (p.natDegree==0) && !(p.coeff 0==0)
theorem unitCheck_correct (p : CPolynomial K) :
    unitCheck p=true ↔ IsUnit p.toPoly := by
  simp only [unitCheck,Bool.and_eq_true,beq_iff_eq,Bool.not_eq_true_eq_eq_false,
    beq_eq_false_iff_ne,CPolynomial.natDegree_toPoly,CPolynomial.coeff_toPoly]
  constructor
  · rintro ⟨hd,hc⟩
    rw [Polynomial.eq_C_of_natDegree_eq_zero hd]
    exact Polynomial.isUnit_C.mpr (isUnit_iff_ne_zero.mpr hc)
