      (F * (Matrix.kronecker (pMatrix x) (rMatrix x)).transpose) s ij := by
  rw [Matrix.mul_apply, Fintype.sum_prod_type]
  change (transformedEntry F s ij).eval x =
    ∑ u, ∑ v, F s (u,v) *
