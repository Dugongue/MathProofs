theorem specialize_sum {P : Type} (z : P→K) (ps : List (StarExpr (P ⊕ V) Int)) :
    specialize z (sum ps)=sxSum (ps.map (specialize z)) := by
  induction ps <;> simp_all [sum,specialize,sxSum]
