namespace Mathproof.Problem18RootParser20261001
open Problem18AllFormatRoot20260930 Problem18PresentationSize20260930
open Problem18OrthogonalAssembly (RectTensor)
structure ParsedInput where
  tag : ℕ
  unitary : ℕ
  q : ℕ
  p : ℕ
  e : ℕ
  a : ℕ
  b : ℕ
  c : ℕ
  data : List ℕ
  deriving DecidableEq
def ParsedInput.Valid (d : ParsedInput) : Prop :=
  d.tag≤1 ∧ d.unitary≤1 ∧ 2≤d.p ∧ 0<d.e ∧ 0<d.a ∧ 0<d.b ∧ 0<d.c ∧
  d.data.length=d.e+(d.tag+1)*(d.a*d.b*d.c*d.e) ∧ ∀x∈d.data,x<d.p
instance (d : ParsedInput) : Decidable d.Valid := by unfold ParsedInput.Valid; infer_instance
def parseNumbers : List ℕ → Option ParsedInput
  | tag::u::q::p::e::a::b::c::data =>
    let d : ParsedInput:=⟨tag,u,q,p,e,a,b,c,data⟩
    if d.Valid then some d else none
  | _ => none
def parseBits (bits : List Bool) : Option ParsedInput :=
  (BitstringEncoding.bitDecode bits : Option (List ℕ)).bind parseNumbers
def ParsedInput.modulus (d : ParsedInput) : List ℕ := d.data.take d.e
def ParsedInput.coordinates (d : ParsedInput) : List ℕ := d.data.drop d.e
variable {K : Type} [Field K] [Fintype K]
def represented (F : FieldPresentation K) (tag : ℕ) (u : Bool) (q a b c : ℕ)
    (payload : List ℕ) : ParsedInput :=
  ⟨tag,u.toNat,q,F.p,F.e,a,b,c,
    (List.finRange F.e).map (fun i=>(F.modulus i).val)++payload⟩
theorem represented_valid (F : FieldPresentation K) (tag : ℕ) (u : Bool) (q a b c : ℕ)
    (payload : List ℕ) (htag : tag≤1) (ha : 0<a) (hb : 0<b) (hc : 0<c)
    (hlen : payload.length=(tag+1)*(a*b*c*F.e)) (hdigits : ∀x∈payload,x<F.p) :
    (represented F tag u q a b c payload).Valid := by
  refine ⟨htag,?_,F.prime.two_le,F.degree_pos,ha,hb,hc,?_,?_⟩
  · cases u <;> simp [represented]
  · simp [represented,hlen]
  · intro x hx
    rcases List.mem_append.mp hx with hx | hx
    · obtain ⟨i,_,rfl⟩:=List.mem_map.mp hx
      exact (F.modulus i).isLt
    · exact hdigits x hx
theorem parseNumbers_represented (F : FieldPresentation K) (tag : ℕ) (u : Bool)
    (q a b c : ℕ) (payload : List ℕ) (htag : tag≤1) (ha : 0<a) (hb : 0<b) (hc : 0<c)
    (hlen : payload.length=(tag+1)*(a*b*c*F.e)) (hdigits : ∀x∈payload,x<F.p) :
    parseNumbers (tag::(header F u q a b c++payload))=
      some (represented F tag u q a b c payload) := by
  have hv:=represented_valid F tag u q a b c payload htag ha hb hc hlen hdigits
  change (if (represented F tag u q a b c payload).Valid then
    some (represented F tag u q a b c payload) else none)=_
  exact if_pos hv
theorem parse_sourceBits (F : FieldPresentation K) (u : Bool) (q : ℕ)
    {a b c : ℕ} (ha : 0<a) (hb : 0<b) (hc : 0<c) (A : RectTensor a b c K) :
    parseBits (sourceBits F u q A)=some (represented F 0 u q a b c (tensorCoordinates F A)) := by
  rw [parseBits,sourceBits,BitstringEncoding.bitDecode_bitEncode,Option.bind_some]
  exact parseNumbers_represented F 0 u q a b c _ (by decide) ha hb hc
    (by simp [tensorCoordinates_length]) (tensorCoordinates_entry_lt F A)
theorem parseNumbers_valid (xs : List ℕ) (d : ParsedInput) (h : parseNumbers xs=some d) : d.Valid := by
  unfold parseNumbers at h
  split at h
  · dsimp only at h
    split_ifs at h with hv
    · cases h
      exact hv
  · contradiction
theorem valid_allocation_bound (d : ParsedInput) (h : d.Valid) :
    d.e≤d.data.length ∧ d.a*d.b*d.c*d.e≤d.data.length := by
  have he:=h.2.2.2.2.2.2.2.1
  have hm : d.a*d.b*d.c*d.e≤(d.tag+1)*(d.a*d.b*d.c*d.e) := Nat.le_mul_of_pos_left _ (by omega)
  omega
end Mathproof.Problem18RootParser20261001
end
