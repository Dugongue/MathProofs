open Mathproof.Problem18FinalFactor20260930
open Mathproof.Problem18DimensionOneBoundary20260930
variable {K : Type} [Field K] [Fintype K] {n m : ℕ}
local instance {a b : ℕ} : Finite ((Fin a→K) →ₗ[K] (Fin b→K)) :=
  Finite.of_injective (fun S : (Fin a→K) →ₗ[K] (Fin b→K) => (S : (Fin a→K) → (Fin b→K))) DFunLike.coe_injective
@[simp] theorem operatorForm_standard_matrix (S : Module.End K (Fin n→K)) :
    (operatorForm (standardForm (K:=K) n) S).toMatrix'=S.toMatrix'.transpose := by
  dsimp only [operatorForm]
  rw [LinearMap.BilinForm.toMatrix'_comp]
  simp [standardForm]
theorem det_ne_zero_of_constant (S : Module.End K (Fin n→K)) (hS : S.charpoly.coeff 0≠0) :
    S.det≠0 := by
  rw [LinearMap.det_eq_sign_charpoly_coeff]
  exact mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)) hS
theorem operatorForm_standard_regular (S : Module.End K (Fin n→K))
    (hS : S.charpoly.coeff 0≠0) : (operatorForm (standardForm (K:=K) n) S).Nondegenerate :=
  operatorForm_nondegenerate _ (standardForm_nondegenerate n) S
    ((Module.End.isUnit_iff S).mp ((LinearMap.isUnit_iff_isUnit_det S).mpr
      (isUnit_iff_ne_zero.mpr (det_ne_zero_of_constant S hS))))
theorem selected_operator_gram_count {ι : Type*} [Fintype ι]
    (S : ι → Module.End K (Fin n→K)) (hinj : Function.Injective S)
    (hself : ∀ i,(standardForm (K:=K) n).IsSelfAdjoint (S i))
    (hs : ∀ i,Squarefree (S i).charpoly) (hz : ∀ i,(S i).charpoly.coeff 0≠0)
    (e : ∀ i,(Fin n→K) ≃ₗ[K] (Fin n→K))
    (he : ∀ i x y,standardForm n (e i x) (e i y)=operatorForm (standardForm (K:=K) n) (S i) x y) :
    Nat.card ι*Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) (n+m))) ≤
      Nat.card {F : Matrix (Fin (n+m)) (Fin n) K // OrthogonalGood F}*
        Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) m)) := by
  classical
  let P (j : (Fin n→K) →ₗ[K] (Fin (n+m)→K)) := OrthogonalGood j.toMatrix'
  have hc := standard_gram_family_count_lower (K:=K) (n:=n) (m:=m)
    (fun i => operatorForm (standardForm (K:=K) n) (S i))
    (fun i => operatorForm_standard_regular (S i) (hz i))
    (by intro i j h; exact hinj (operatorForm_injective (standardForm (K:=K) n) (standardForm_nondegenerate n) h))
    e he P
  have hh : Nat.card ι*Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) (n+m))) ≤
      Nat.card {j : (Fin n→K) →ₗ[K] (Fin (n+m)→K) // P j}*
        Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) m)) := by
    apply hc
    intro i j hj
    have hf : (standardForm (n+m)).comp j j=operatorForm (standardForm (K:=K) n) (S i) := by
      apply LinearMap.ext
      intro x
      apply LinearMap.ext
      intro y
      exact hj x y
    have hg : j.toMatrix'.transpose*j.toMatrix'=(S i).toMatrix'.transpose := by
      have h := congrArg LinearMap.BilinForm.toMatrix' hf
      rw [operatorForm_standard_matrix] at h
      simpa only [LinearMap.BilinForm.toMatrix'_comp,standardForm,LinearMap.BilinForm.toMatrix'_toBilin',
        Matrix.mul_one,operatorForm_standard_matrix] using h
    change OrthogonalGood j.toMatrix'
    constructor
    · rw [hg,Matrix.det_transpose,LinearMap.det_toMatrix']
      exact det_ne_zero_of_constant (S i) (hz i)
    · rw [hg,Matrix.charpoly_transpose,← Matrix.charpoly_toLin',Matrix.toLin'_toMatrix']
      exact hs i
  have E : {j : (Fin n→K) →ₗ[K] (Fin (n+m)→K) // P j} ≃
      {F : Matrix (Fin (n+m)) (Fin n) K // OrthogonalGood F} :=
    { toFun := fun j => ⟨j.val.toMatrix',j.property⟩
      invFun := fun F => ⟨F.val.toLin',by simpa only [P,LinearMap.toMatrix'_toLin'] using F.property⟩
      left_inv := by intro j; apply Subtype.ext; exact Matrix.toLin'_toMatrix' j.val
      right_inv := by intro F; apply Subtype.ext; exact LinearMap.toMatrix'_toLin' F.val }
  rwa [Nat.card_congr E] at hh
theorem odd_fixed_gram_count (hodd : ringChar K≠2) :
    Nat.card (FixedGoodOperators (standardForm (K:=K) n) ((-1:K)^n))*
      Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) (n+m))) ≤
      Nat.card {F : Matrix (Fin (n+m)) (Fin n) K // OrthogonalGood F}*
        Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) m)) := by
  classical
  let I := FixedGoodOperators (standardForm (K:=K) n) ((-1:K)^n)
  letI : Fintype I := Fintype.ofFinite I
  have hz (i : I) : i.val.charpoly.coeff 0≠0 := by rw [i.property.2.2]; exact pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)
  have hex (i : I) : ∃ e : (Fin n→K) ≃ₗ[K] (Fin n→K),∀ x y,
      standardForm n (e x) (e y)=operatorForm (standardForm (K:=K) n) i.val x y := by
    apply odd_standard_representation hodd _
      (operatorForm_symmetric _ (standardForm_symm n) _ i.property.1)
      (operatorForm_standard_regular i.val (hz i))
    have hd : i.val.det=1 := by
      rw [LinearMap.det_eq_sign_charpoly_coeff,i.property.2.2]
      simp only [Module.finrank_pi,Fintype.card_fin,Module.finrank_self,mul_one]
      rw [← mul_pow]
      simp
    rw [LinearMap.BilinForm.toMatrix_basisFun,operatorForm_standard_matrix,Matrix.det_transpose,
      LinearMap.det_toMatrix',hd]
    exact ⟨1,by simp⟩
  choose e he using hex
  exact selected_operator_gram_count (fun i : I => i.val) Subtype.val_injective
    (fun i => i.property.1) (fun i => i.property.2.1) hz e he
theorem charTwo_good_gram_count [CharP K 2] (hn : 0<n) :
    Nat.card (GoodOperators (standardForm (K:=K) n))*
      Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) (n+m))) ≤
      Nat.card {F : Matrix (Fin (n+m)) (Fin n) K // OrthogonalGood F}*
        Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) m)) := by
  classical
  let I := GoodOperators (standardForm (K:=K) n)
  letI : Fintype I := Fintype.ofFinite I
  have hex (i : I) : ∃ e : (Fin n→K) ≃ₗ[K] (Fin n→K),∀ x y,
      standardForm n (e x) (e y)=operatorForm (standardForm (K:=K) n) i.val x y :=
    charTwo_standard_representation hn _
      (operatorForm_symmetric _ (standardForm_symm n) _ i.property.1)
      (operatorForm_standard_regular i.val i.property.2.2) i.val
      (operatorForm_selfAdjoint _ _ i.property.1) i.property.2.1
  choose e he using hex
  exact selected_operator_gram_count (fun i : I => i.val) Subtype.val_injective
    (fun i => i.property.1) (fun i => i.property.2.1) (fun i => i.property.2.2) e he
theorem odd_gram_mass_before_orders (hodd : ringChar K≠2) (hn : 4≤n) :
    (Nat.card K:ℝ)^(n-1)*
      Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) n))*
      Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) (n+m))) ≤
    12*(Nat.card {F : Matrix (Fin (n+m)) (Fin n) K // OrthogonalGood F}:ℝ)*
      Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) m)) := by
  have hp := fixed_operator_mass_lower hodd n hn ((-1:K)^n)
    (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)) (standardForm (K:=K) n)
    (standardForm_symm n) (standardForm_nondegenerate n) (by simp)
  have hg := odd_fixed_gram_count (m:=m) hodd (n:=n)
  have hgR : (Nat.card (FixedGoodOperators (standardForm (K:=K) n) ((-1:K)^n)):ℝ)*
      Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) (n+m))) ≤
      (Nat.card {F : Matrix (Fin (n+m)) (Fin n) K // OrthogonalGood F}:ℝ)*
        Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) m)) := by exact_mod_cast hg
  have hh := mul_le_mul_of_nonneg_right hp
    (show (0:ℝ)≤Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) (n+m))) by positivity)
  change (Nat.card K:ℝ)^(n-1)*
    Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) n))/12*
    Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) (n+m))) ≤ _ at hh
  nlinarith
theorem charTwo_gram_mass_before_orders [CharP K 2] (hn : 2≤n) :
    (Nat.card K:ℝ)^n*
      Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) n))*
      Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) (n+m))) ≤
    24*(Nat.card {F : Matrix (Fin (n+m)) (Fin n) K // OrthogonalGood F}:ℝ)*
      Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) m)) := by
  have ha : ¬(standardForm (K:=K) n).IsAlt := by
    intro h
    have hh := h.self_eq_zero (Pi.single (⟨0,by omega⟩:Fin n) 1)
    simpa [standardForm,Matrix.toBilin'_apply'] using hh
  have hp := charTwo_operator_mass_lower n hn (standardForm (K:=K) n)
    (standardForm_symm n) (standardForm_nondegenerate n) ha (by simp)
  have hg := charTwo_good_gram_count (K:=K) (m:=m) (show 0<n by omega)
  have hgR : (Nat.card (GoodOperators (standardForm (K:=K) n)):ℝ)*
      Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) (n+m))) ≤
      (Nat.card {F : Matrix (Fin (n+m)) (Fin n) K // OrthogonalGood F}:ℝ)*
        Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) m)) := by exact_mod_cast hg
  have hh := mul_le_mul_of_nonneg_right hp
    (show (0:ℝ)≤Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) (n+m))) by positivity)
  change (Nat.card K:ℝ)^n*
    Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) n))/24*
    Nat.card (Isometries (RingEquiv.refl K) (standardForm (K:=K) (n+m))) ≤ _ at hh
  nlinarith
