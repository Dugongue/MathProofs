theorem annCost_le (a : AMNames) (N d : ℕ) (hdN : d < N) :
    annCost (fieldMacros F) a N d ≤ 300 * macroBudget F * (N + 1) := by
  have hb := concrete_costBound F
  have hW := hb.one
  have hcp := hb.point
  have he : F.e + 1 ≤ macroBudget F := by unfold macroBudget; omega
  unfold annCost fillCost fillStep rcopyCost rcopyStep constCostE
  simp only [dstE, oneSlotE, plus, Expr.size]
  obtain ⟨W, hWd⟩ : ∃ W, macroBudget F = W := ⟨_, rfl⟩
  obtain ⟨cp, hcpd⟩ : ∃ cp, (fieldMacros F).costPoint = cp := ⟨_, rfl⟩
  obtain ⟨e, hed⟩ : ∃ e, F.e = e := ⟨_, rfl⟩
  rw [hWd] at hW; rw [hWd, hcpd] at hcp; rw [hWd, hed] at he
  rw [hWd, hcpd, hed]
  have h1 : (4 + (19 * e + 19)) * N ≤ (23 * W) * N := Nat.mul_le_mul_right _ (by omega)
  have h2 : (4 + (33 + (1 + (1 + 1 + 1) + 1) + 2 * 1 + cp)) * d ≤ (46 * W) * N :=
    Nat.mul_le_mul (by omega) (by omega)
  have h3 : (4 + (1 + (1 + 1 + 1 + 1 + 1) + 1 + 12)) * e ≤ 23 * W := by omega
  have r1 : (23 * W) * N = 23 * (W * N) := by ring
  have r2 : (46 * W) * N = 46 * (W * N) := by ring
  have r3 : 300 * W * (N + 1) = 300 * (W * N) + 300 * W := by ring
  rw [r3]
  omega
