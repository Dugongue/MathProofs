  let H := Mathproof.Problem18ClassicalOrbitBoundary20260930.matrixHermitian (hyperbolicMetric m (1:K))
  have hsH : H.IsSymm := Mathproof.Problem18ClassicalOrbitBoundary20260930.matrixHermitian_symm hmH
  have hnH : H.Nondegenerate := by
    have hh : H.SeparatingLeft := Mathproof.Problem18ClassicalOrbitBoundary20260930.matrixHermitian_separating
