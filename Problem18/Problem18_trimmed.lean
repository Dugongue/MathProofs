def rgBody (M : FieldMacros F r) (q : RNames) (mn : MNames) (Ls : ℕ) (tbl : List (Option ℕ)) :
    Com :=
  .seq (gatherCom M q (macSrc mn Ls) (rgDst mn tbl.length) tbl 0)
    (.assign mn.t (plus (.var mn.t) (.lit 1)))
def rgLoop (M : FieldMacros F r) (q : RNames) (mn : MNames) (Ls : ℕ) (tbl : List (Option ℕ)) :
    Com :=
  .seq (.assign mn.t (.lit 0)) (.while (.lt (.var mn.t) (.var mn.R)) (rgBody M q mn Ls tbl))
def rgStep (M : FieldMacros F r) (mn : MNames) (Ls : ℕ) (tbl : List (Option ℕ)) : ℕ :=
  gatherCost M (macSrc mn Ls) (rgDst mn tbl.length) tbl.length + 4
def rgCost (M : FieldMacros F r) (mn : MNames) (Ls : ℕ) (tbl : List (Option ℕ)) (R : ℕ) : ℕ :=
