  · rw [hgi]; exact hpayIn
  · rw [hgo]; exact hpayOut
end run
section regather
variable {K : Type} [Field K] [Fintype K] [DecidableEq K]
theorem layoutEndN_congr {a b c a' b' c' : Nat} (hs : a+b+c = a'+b'+c')
    (hp : a*b*c = a'*b'*c') : layoutEndN a b c = layoutEndN a' b' c' := by
  simp only [layoutEndN,firstAlgScratchN,firstOutputN,firstRightN,firstFamilyN,
    firstScratchN,firstOneN,firstProductWorkN,firstPowerN,firstPowerCapN,firstGramN,
    transposedN,poweredN,sortedN,prefixN,tensorN,capFlatN,capGenN,capSqN,dimSumN,hs,hp]
theorem sortedN_congr {a b c a' b' c' : Nat} (hs : a+b+c = a'+b'+c') :
    sortedN a b c = sortedN a' b' c' := by
  simp only [sortedN,prefixN,capFlatN,capGenN,dimSumN,hs]
theorem PostGather.of_coords {F : FieldPresentation K} {W Sn a b c : Nat} {u : Bool} {q : Nat}
    {A A' : RectTensor a b c K} {sigma : Env}
    (h : PostGather F W Sn a b c u q A' sigma)
    (hA : tensorCoordinates F A = tensorCoordinates F A') :
    PostGather F W Sn a b c u q A sigma :=
  { h with sorted := by rw [hA]; exact h.sorted }
theorem savedSecond_not_gather :
    savedSecond ∉ Mathproof.Problem18P36LargeGather20261004.gatherWrites := by decide
theorem gather_post (F : FieldPresentation K) {W Sn a0 b0 c0 : Nat} {u : Bool} {q : Nat}
    {A0 : RectTensor a0 b0 c0 K} {sigma : Env}
    (ha : 0 < a0) (hb : 0 < b0) (hc : 0 < c0)
    (hv : ValidMemory F W sigma)
    (hlen : (sigma.arrs canonical.mem).length = F.e+1+Sn*F.e)
    (hscr : 16*(F.e+1) ≤ (sigma.arrs canonical.scratch).length)
    (hSnW : Sn < W) (hqW : q < W) (hfit : layoutEndN a0 b0 c0 ≤ Sn)
    (hu : sigma.vars "u" = u.toNat) (hq : sigma.vars "q" = q)
    (hmod : sigma.vars canonical.modBase = 0)
    (hsrc : GatherSource F W a0 b0 c0 A0 sigma) :
    ∃ tau, Run W sortedTensorProgram sigma tau
        (Mathproof.Problem18IMPAssignments20261002.cost (gatherBindings (sortOrder a0 b0 c0)) +
          12 + 210*(a0*b0*c0*F.e+1)) ∧
      PostGather F W Sn (shape (sortOrder a0 b0 c0) a0 b0 c0).1
        (shape (sortOrder a0 b0 c0) a0 b0 c0).2.1 (shape (sortOrder a0 b0 c0) a0 b0 c0).2.2
        u q (tensorEquiv (sortOrder a0 b0 c0) A0) tau ∧
      GatherSource F W a0 b0 c0 A0 tau ∧
      tau.vars savedSecond = sigma.vars savedSecond ∧
      tau.inp = sigma.inp ∧ tau.out = sigma.out := by
  have hepos := F.degree_pos
  have hpPos : 0 < F.p := by have := F.prime.two_le; omega
  have hCoordLt : ∀ {a' b' c' : Nat} (A' : RectTensor a' b' c' K),
      ∀ v ∈ tensorCoordinates F A', v < F.p := by
    intro a' b' c' A' v hv
    simp only [tensorCoordinates,List.mem_flatMap,List.mem_map,List.mem_finRange,true_and] at hv
    obtain ⟨k,i,j,t,rfl⟩ := hv
    exact (F.coordinate _ t).isLt
  have hNW : a0*b0*c0*F.e < W := lt_of_le_of_lt hsrc.fit hsrc.word
  have hmemW := hv.memory_word
  set d := physN F.e (sortedN a0 b0 c0) with hd
  have hdEnd : d + a0*b0*c0*F.e ≤ F.e+1+layoutEndN a0 b0 c0*F.e := by
    have h1 : sortedN a0 b0 c0 + a0*b0*c0 ≤ layoutEndN a0 b0 c0 := by
      simp only [layoutEndN, firstAlgScratchN, firstOutputN, firstRightN, firstScratchN,
        firstFamilyN, firstOneN, firstProductWorkN, firstPowerN, firstGramN, transposedN,
        poweredN, tensorN]
      omega
    have h2 := Nat.mul_le_mul_right F.e h1
    rw [Nat.add_mul] at h2
    rw [hd]
    unfold physN
    omega
  have hdLen : d + a0*b0*c0*F.e ≤ (sigma.arrs canonical.mem).length := by
    rw [hlen]
    have : layoutEndN a0 b0 c0*F.e ≤ Sn*F.e := Nat.mul_le_mul_right _ hfit
    omega
  have hdEval : sortedBase.evalB W sigma = some d := by
    have hpos : Mathproof.Problem18P36PosEval20261004.Pos sigma sortedBase := by
      simp [Mathproof.Problem18P36PosEval20261004.Pos,sortedBase,physicalSlot,sortedSlot,
        algebraPrefix,candidateEnd,capFlat,capGen,dimSum,hsrc.hdr_a,hsrc.hdr_b,hsrc.hdr_c,
        hsrc.e_reg]
      omega
    have hnom : Mathproof.Problem18P36PosEval20261004.nom sigma sortedBase = d := by
      simp only [Mathproof.Problem18P36PosEval20261004.nom,sortedBase,physicalSlot,sortedSlot,
        algebraPrefix,candidateEnd,capFlat,capGen,dimSum,hsrc.hdr_a,hsrc.hdr_b,hsrc.hdr_c,
        hsrc.e_reg,hd,physN,sortedN,prefixN,candEndN,capFlatN,capGenN,dimSumN,Expr.add,Expr.mul]
      try ring
    rw [← hnom]
    apply Mathproof.Problem18P36PosEval20261004.evalB_pos _ _ hpos
    rw [hnom]
    omega
  obtain ⟨hgrun,hgcells,hgmemory,hgother,hgout,hglen,hgvars,hgframe,hgi,hgo⟩ :=
    Mathproof.Problem18P36LargeGather20261004.sortedTensorProgram_run F (B:=W) sigma A0
      hsrc.hdr_a hsrc.hdr_b hsrc.hdr_c hsrc.e_reg ha hb hc hNW hsrc.total hdEval
      hdLen hmemW hsrc.fit hsrc.word hsrc.values hsrc.coords
  set tau := Mathproof.Problem18P36LargeGather20261004.gatheredState (sortOrder a0 b0 c0) a0 b0 c0
    F.e d sigma with htau
  have frame : ∀ x, x ∉ Mathproof.Problem18P36LargeGather20261004.gatherWrites →
      tau.vars x = sigma.vars x := hgframe
  obtain ⟨-,-,hdA,hdB,hdC⟩ :=
    Mathproof.Problem18P36LargeGather20261004.installedState_loaded (a:=a0) (b:=b0) (c:=c0)
      (e:=F.e) (d:=d) (sortOrder a0 b0 c0) sigma
  have xa' : tau.vars "a" = a0 := (frame _ (by decide)).trans hsrc.hdr_a
  have xb' : tau.vars "b" = b0 := (frame _ (by decide)).trans hsrc.hdr_b
  have xc' : tau.vars "c" = c0 := (frame _ (by decide)).trans hsrc.hdr_c
  have xe' : tau.vars canonical.e = F.e := (frame _ (by decide)).trans hsrc.e_reg
  have xp' : tau.vars canonical.p = F.p := (frame _ (by decide)).trans hv.prime
  have xmod : tau.vars canonical.modBase = 0 := (frame _ (by decide)).trans hmod
  have xMemLen : (tau.arrs canonical.mem).length = F.e+1+Sn*F.e := (hglen _).trans hlen
  have xScr : tau.arrs canonical.scratch = sigma.arrs canonical.scratch := hgother _ (by decide)
  have xMem : ∀ j < (tau.arrs canonical.mem).length,
      (tau.arrs canonical.mem).getD j 0 < F.p := by
    intro j hj
    by_cases hin : d ≤ j ∧ j < d + a0*b0*c0*F.e
    · obtain ⟨k,rfl⟩ : ∃ k, j = d+k := ⟨j-d,by omega⟩
      rw [hgcells k (by omega)]
      exact getD_lt_of_forall hpPos (hCoordLt _)
    · rw [hgout j (by omega)]
      exact hv.coefficients j (by rw [← hglen]; exact hj)
  have hprod := shape_prod (sortOrder a0 b0 c0) a0 b0 c0
  have hsum := shape_sum (sortOrder a0 b0 c0) a0 b0 c0
  refine ⟨tau,hgrun,?_,?_,(frame _ savedSecond_not_gather),hgi,hgo⟩
  · exact {
      valid := {
        degree := xe'
        prime := xp'
        arithmetic_word := hv.arithmetic_word
        inverse_word := hv.inverse_word
        memory_word := by rw [xMemLen,← hlen]; exact hmemW
        scratch_word := by rw [xScr]; exact hv.scratch_word
        scratch_fit := by rw [xScr]; exact hv.scratch_fit
        modulus_fit := by rw [xmod,xMemLen]; omega
        modulus_value := by
          intro i
          simp only [Problem18IMPFieldMultiplication20261001.sourceCoeff]
          rw [xmod,hgout _ (Or.inl (by rw [hd]; unfold physN; have := i.isLt; omega))]
          have := hv.modulus_value i
          simpa only [Problem18IMPFieldMultiplication20261001.sourceCoeff,hmod] using this
        coefficients := xMem }
      length := xMemLen
      a_pos := (shape_pos (sortOrder a0 b0 c0) ha hb hc).1
      b_pos := (shape_pos (sortOrder a0 b0 c0) ha hb hc).2.1
      c_pos := (shape_pos (sortOrder a0 b0 c0) ha hb hc).2.2
      fit := by rw [layoutEndN_congr hsum hprod]; exact hfit
      scratch_len := by rw [xScr]; exact hscr
      sn_word := hSnW
      q_word := hqW
      dims := ⟨(hgvars _ (by decide)).trans hdA,(hgvars _ (by decide)).trans hdB,
        (hgvars _ (by decide)).trans hdC⟩
      hdr_pos := by rw [xa',xb',xc']; exact ⟨ha,hb,hc⟩
      hdr_prod := by rw [xa',xb',xc',hprod]
      hdr_sum := by rw [xa',xb',xc',hsum]
      u_reg := (frame _ (by decide)).trans hu
      q_reg := (frame _ (by decide)).trans hq
      modBase := xmod
      sorted := by
        intro j hj
        rw [sortedN_congr hsum,← hd]
        exact hgcells j (by rw [← hprod]; exact hj) }
  · exact {
      hdr_a := xa'
      hdr_b := xb'
      hdr_c := xc'
      e_reg := xe'
      total := (frame _ (by decide)).trans hsrc.total
      fit := by rw [hgmemory]; exact hsrc.fit
      word := by rw [hgmemory]; exact hsrc.word
      values := by rw [hgmemory]; exact hsrc.values
      coords := by rw [hgmemory]; exact hsrc.coords }
