attribute [-instance] FunLike.toDecidableEq CommSemiRingCat.FilteredColimits.colimitCommSemiring SemiRingCat.instSemiringObjForgetRingHomCarrier AddMonoidAlgebra.instHopfAlgebraStruct AddMonoidAlgebra.instBialgebra Bialgebra.toAlgebra
namespace Problem18Elimination20260929
variable {K M ι : Type*} [Field K] [DecidableEq K]
  [AddCommGroup M] [Module K M]
def pivot (coords : List ι) (p : M →ₗ[K] (ι → K)) (v : M) : Option ι :=
  coords.find? (fun i => decide (p v i ≠ 0))
def eliminate (p : M →ₗ[K] (ι → K)) (i : ι) (v : M) : M →ₗ[K] M :=
  LinearMap.id - (p v i)⁻¹ • (((LinearMap.proj i).comp p).smulRight v)
@[simp] theorem eliminate_apply (p : M →ₗ[K] (ι → K)) (i : ι) (v x : M) :
    eliminate p i v x = x - (p x i / p v i) • v := by
  simp [eliminate, div_eq_mul_inv, smul_smul, mul_comm]
def reduce (coords : List ι) (p : M →ₗ[K] (ι → K)) : List M → M →ₗ[K] M
  | [] => LinearMap.id
  | v :: vs => match pivot coords p v with
    | none => reduce coords p vs
    | some i => (reduce coords p (vs.map (eliminate p i v))).comp (eliminate p i v)
termination_by vs => vs.length
def rowSpan (vs : List M) : Submodule K M := Submodule.span K {v | v ∈ vs}
lemma mem_rowSpan (vs : List M) (v : M) (h : v ∈ vs) : v ∈ rowSpan (K := K) vs :=
  Submodule.subset_span h
lemma rowSpan_cons (v : M) (vs : List M) : rowSpan (K := K) vs ≤ rowSpan (K := K) (v :: vs) :=
  Submodule.span_mono (by intro x hx; exact List.mem_cons_of_mem v hx)
lemma pivot_none (coords : List ι) (hc : ∀ i, i ∈ coords)
    (p : M →ₗ[K] (ι → K)) (v : M) (h : pivot coords p v = none) : p v = 0 := by
  funext i
  have h' := List.find?_eq_none.mp h i (hc i)
  simpa using h'
lemma pivot_some (coords : List ι) (p : M →ₗ[K] (ι → K)) (v : M) (i : ι)
    (h : pivot coords p v = some i) : p v i ≠ 0 := by
  have h' := List.find?_some h
  simpa using h'
theorem reduce_spec (coords : List ι) (hc : ∀ i, i ∈ coords)
    (p : M →ₗ[K] (ι → K)) (vs : List M) :
    (∀ x, x - reduce coords p vs x ∈ rowSpan (K := K) vs) ∧
    (∀ x, p x = 0 → p (reduce coords p vs x) = 0) ∧
    (∀ v ∈ vs, p (reduce coords p vs v) = 0) := by
  cases vs with
  | nil => simp [reduce, rowSpan]
  | cons v vs =>
    cases hp : pivot coords p v with
    | none =>
      obtain ⟨hd, hk, hr⟩ := reduce_spec coords hc p vs
      have hv := pivot_none coords hc p v hp
      simp only [reduce, hp]
      refine ⟨fun x => rowSpan_cons v vs (hd x), hk, ?_⟩
      intro w hw
      rcases List.mem_cons.mp hw with hw | hw
      · subst w
        exact hk v hv
      · exact hr w hw
    | some i =>
      let E := eliminate p i v
      obtain ⟨hd, hk, hr⟩ := reduce_spec coords hc p (vs.map E)
      have hv := pivot_some coords p v i hp
      have hsub : rowSpan (K := K) (vs.map E) ≤ rowSpan (K := K) (v :: vs) := by
        apply Submodule.span_le.mpr
        intro w hw
        obtain ⟨z, hz, rfl⟩ := List.mem_map.mp hw
        simp only [E, eliminate_apply]
        exact Submodule.sub_mem _ (mem_rowSpan _ _ (List.mem_cons_of_mem _ hz))
          (Submodule.smul_mem _ _ (mem_rowSpan _ _ (List.mem_cons_self)))
      simp only [reduce, hp, LinearMap.comp_apply]
      refine ⟨?_, ?_, ?_⟩
      · intro x
        have hfirst : x - E x ∈ rowSpan (K := K) (v :: vs) := by
          simpa [E] using (Submodule.smul_mem (rowSpan (K := K) (v :: vs)) (p x i / p v i)
            (mem_rowSpan (v :: vs) v (List.mem_cons_self)))
        have hsum := Submodule.add_mem _ hfirst (hsub (hd (E x)))
        simpa only [sub_add_sub_cancel] using hsum
      · intro x hx
        have hEx : E x = x := by simp [E, hx]
        exact hk (E x) (by rw [hEx]; exact hx)
      · intro w hw
        rcases List.mem_cons.mp hw with hw | hw
        · subst w
          have hEv : E v = 0 := by simp [E, hv]
          change p (reduce coords p (vs.map E) (E v)) = 0
          rw [hEv, map_zero, map_zero]
        · exact hr (E w) (List.mem_map.mpr ⟨w, hw, rfl⟩)
termination_by vs.length
theorem reduce_eq_zero_iff (coords : List ι) (hc : ∀ i, i ∈ coords)
    (p : M →ₗ[K] (ι → K)) (vs : List M) (x : M) :
    p (reduce coords p vs x) = 0 ↔ p x ∈ (rowSpan (K := K) vs).map p := by
  obtain ⟨hd, hk, hr⟩ := reduce_spec coords hc p vs
  let R := reduce coords p vs
  have hkill : rowSpan (K := K) vs ≤ LinearMap.ker (p.comp R) := by
    apply Submodule.span_le.mpr
    intro v hv
    exact hr v hv
  constructor
  · intro h
    refine Submodule.mem_map.mpr ⟨x - R x, hd x, ?_⟩
    simp only [map_sub, R, h, sub_zero]
  · intro h
    obtain ⟨y, hy, hxy⟩ := Submodule.mem_map.mp h
    have hRy : p (R y) = 0 := hkill hy
    have hdiff : p (x - y) = 0 := by simp [map_sub, hxy]
    have hz := hk (x - y) hdiff
    change p (R (x - y)) = 0 at hz
    simpa only [map_sub, hRy, sub_zero] using hz
end Problem18Elimination20260929
end
