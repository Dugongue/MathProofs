  have hnew : powerMatrix F n base k tau =
      powerMatrix F n base (k-1) rho * G := by
    rw [hprod',hprevXi,hcopied]
  have holdTau : ∀ j, j < k →
      powerMatrix F n base j tau = powerMatrix F n base j rho := by
    intro j hj
    have hjle : j <= k-1 := by omega
    have hmono := Nat.mul_le_mul_right (2*block) hjle
    dsimp [block] at hmono
    have hjdest : powerAt F base n j + block <= dest := by
      have hh := hregions.1
      dsimp [block] at hregions
      dsimp [dest,powerAt,gramCopyAt,block] at hh ⊢
      omega
    have hjlen : powerAt F base n j + block <=
        (xi.arrs canonical.mem).length := by
      have hf := hdestFit
      have hlen := (run_frame hcopyRun).2.2.1 canonical.mem
      rw [hlen]
      omega
    have htx : powerMatrix F n base j tau = powerMatrix F n base j xi := by
      unfold powerMatrix
      apply matrix_of_word_copy F
      intro x hx
      apply hmem
      · have := hjlen
        omega
      · have := hjdest
        have := hdestOut
        omega
    have hxr : powerMatrix F n base j xi = powerMatrix F n base j rho := by
