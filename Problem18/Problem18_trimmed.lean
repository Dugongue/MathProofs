    Module.finrank K (tableSpan vs)=Module.finrank K (rowSpan (K:=K) (vs.map read)) := by
  rw [tableSpan_map]
  exact LinearEquiv.finrank_map_eq encoding.symm _
theorem basisTable_finrank (S : Fin m→Matrix (Fin n) (Fin n) K) (k : ℕ) :
    Module.finrank K (tableSpan (basisTable S k))=(basisTable S k).length := by
  rw [tableSpan_finrank]
  cases k with
  | zero => rw [basisTable,compress_span,←compress_finrank]
  | succ k => rw [basisTable,compress_span,←compress_finrank]
def rankCheck (S : Fin m→Matrix (Fin n) (Fin n) K) : Bool :=
  decide ((basisTable S (n^2+1)).length=n*n)
theorem rankCheck_correct (S : Fin m→Matrix (Fin n) (Fin n) K) :
    rankCheck S=true ↔ Algebra.adjoin K (Set.range S)=⊤ := by
  rw [rankCheck,decide_eq_true_eq,←basisTable_finrank,basisTable_exact]
  constructor
  · intro h
    have he : (Algebra.adjoin K (Set.range S)).toSubmodule=⊤ := by
      apply Submodule.eq_top_of_finrank_eq
      simpa only [Module.finrank_matrix,Module.finrank_self,Fintype.card_fin,mul_one] using h
    exact SetLike.ext (fun x=>show x∈Algebra.adjoin K (Set.range S) ↔ x∈(⊤:Subalgebra K (Matrix (Fin n) (Fin n) K)) from
      Iff.of_eq (congrArg (fun U:Submodule K (Matrix (Fin n) (Fin n) K)=>x∈U) he))
  · intro h
    rw [h]
    change Module.finrank K (⊤ : Submodule K (Matrix (Fin n) (Fin n) K))=n*n
    simp [Module.finrank_matrix]
theorem rankCheck_eq (S : Fin m→Matrix (Fin n) (Fin n) K) :
    rankCheck S=Problem18ExecutableAlgebra20261001.generationCheck S := by
