    · rw [hp]; exact href.base.prime
    · rw [hmem]; exact href.base.memory_word
    · rw [hscratch]; exact hscratchBase.scratch_word
    · rw [hscratch]; exact hscratchBase.scratch_fit
    · rw [hm, hmem]; exact href.base.modulus_fit
    · intro i
      rw [hmem, hm]
      exact href.base.modulus_value i
    · rw [hx]; exact href.base.exp_word
  refine ⟨hbase, href.ws_reg, ?_, ?_, ?_, href.slots_word⟩
  · rw [hWS, hmem]
    exact href.fit
  · rw [hWS, hm]
    exact href.modulus_apart
  · intro s hs
    unfold Canonical slice
    rw [hmem, hWS]
    exact href.canon s hs
