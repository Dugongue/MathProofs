  classical
  intro c d h
  funext i
  apply trace_coefficient_ext (K:=K)
  intro x
  have hh := congrArg (fun B : LinearMap.BilinForm K (∀ i,AdjoinRoot (g i)) =>
    B (Pi.single i x) (Pi.single i 1)) h
