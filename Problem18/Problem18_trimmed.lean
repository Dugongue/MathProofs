    (x : String) (v : Nat) :
    renameEnv rho (sigma.setVar x v)=(renameEnv rho sigma).setVar x v := by
  rfl
@[simp] theorem renameEnv_setArr (rho : String ≃ String) (sigma : Env)
    (a : String) (i v : Nat) :
