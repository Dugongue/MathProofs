theorem pointState_read_preserved (r : FieldNames) (σ : Env) (f : Nat→Nat)
    (n j : Nat) (src : String) (hj : j<(σ.arrs src).length)
    (hsep : src≠r.mem ∨ j<σ.vars r.outBase ∨ σ.vars r.outBase+n ≤ j) :
    ((pointState σ r f n).arrs src).getD j 0=(σ.arrs src).getD j 0 := by
  by_cases hs:src=r.mem
  · subst src
    simpa [pointState] using writeValues_outside (σ.arrs r.mem) (σ.vars r.outBase) n j f hj (hsep.resolve_left (by simp))
  · simp [pointState,hs]
theorem pointState_array_length (r : FieldNames) (σ : Env) (f : Nat→Nat)
    (n : Nat) (src : String) :
    ((pointState σ r f n).arrs src).length=(σ.arrs src).length := by
  by_cases hs:src=r.mem
  · subst src
    simp [pointState,writeValues_length]
  · simp [pointState,hs]
theorem pointState_get_evalB (r : FieldNames) (σ : Env) (f : Nat→Nat)
    {B n j : Nat} (src : String) (idx : Expr)
    (hidx : idx.evalB B (pointState σ r f n)=some j)
    (hj : j<(σ.arrs src).length)
    (hsep : src≠r.mem ∨ j<σ.vars r.outBase ∨ σ.vars r.outBase+n ≤ j)
    (hvalue : (σ.arrs src).getD j 0<B) :
    (Expr.get src idx).evalB B (pointState σ r f n)=some ((σ.arrs src).getD j 0) := by
  have hh:=getElem_some_getD ((pointState σ r f n).arrs src) j
    (by rw [pointState_array_length]; exact hj)
  rw [pointState_read_preserved r σ f n j src hj hsep] at hh
  exact evalB_get hidx hh hvalue
def storeBody (r : FieldNames) (rhs : Expr) : Com :=
  .seq (.store r.mem (address r.outBase r.i) rhs)
    (.assign r.i (.add (.var r.i) (.lit 1)))
def storeLoop (r : FieldNames) (rhs : Expr) : Com :=
  .seq (.assign r.i (.lit 0))
    (.while (.lt (.var r.i) (.var r.e)) (storeBody r rhs))
theorem storeLoop_run (r : FieldNames) (rhs : Expr) {B : Nat} (σ : Env) (f : Nat→Nat)
    (hbase : r.outBase≠r.i) (hlim : r.e≠r.i)
    (he : σ.vars r.e<B) (hmem : (σ.arrs r.mem).length<B)
    (hfit : σ.vars r.outBase+σ.vars r.e ≤ (σ.arrs r.mem).length)
    (hval : ∀j<σ.vars r.e,rhs.evalB B (pointState σ r f j)=some (f j)) :
    Run B (storeLoop r rhs) σ (pointState σ r f (σ.vars r.e))
      ((rhs.size+12)*(σ.vars r.e+1)) := by
  let states:=pointState σ r f
  have hi (j : Nat) : (states j).vars r.i=j := by simp [states,pointState]
  have ho (j : Nat) : (states j).vars r.outBase=σ.vars r.outBase := by
    simp [states,pointState,hbase]
  have hn (j : Nat) : (states j).vars r.e=σ.vars r.e := by simp [states,pointState,hlim]
  have hstep : ∀j<σ.vars r.e,Run B (storeBody r rhs) (states j) (states (j+1)) (rhs.size+8) := by
    intro j hj
    have hjB:j<B:=by omega
    have hoB:σ.vars r.outBase<B:=by omega
    have haddr : (address r.outBase r.i).evalB B (states j)=some (σ.vars r.outBase+j) := by
      have hb' : (Expr.var r.outBase).evalB B (states j)=some (σ.vars r.outBase) := by
        simpa only [ho j] using evalB_var (σ:=states j) (x:=r.outBase) (by rw [ho]; exact hoB)
      have hi' : (Expr.var r.i).evalB B (states j)=some j := by
        simpa only [hi j] using evalB_var (σ:=states j) (x:=r.i) (by rw [hi]; exact hjB)
      exact evalB_bin (op:=Bop.add) hb' hi' (by change σ.vars r.outBase+j<B; omega)
    have hs:=Run.store (a:=r.mem) haddr (hval j hj)
      (by simp only [states,pointState]; simp [writeValues_length]; omega)
    let τ:=(states j).setArr r.mem (σ.vars r.outBase+j) (f j)
    have hτi:τ.vars r.i=j := by simpa [τ] using hi j
    have hinc : (Expr.add (.var r.i) (.lit 1)).evalB B τ=some (j+1) := by
      have hi' : (Expr.var r.i).evalB B τ=some j := by
        simpa only [hτi] using evalB_var (σ:=τ) (x:=r.i) (by rw [hτi]; exact hjB)
      exact evalB_bin (op:=Bop.add) hi' (evalB_lit (by omega)) (by change j+1<B; omega)
    have hr:=hs.seq (Run.assign (x:=r.i) hinc)
    apply (hr.congr (pointState_next σ r f j)).mono
    simp only [address,Expr.size]
    omega
  have hloop:=countedLoop_run r.i r.e (storeBody r rhs) states
    (fun j _=>hi j) (fun j _=>hn j) he hstep
  have hinit : Run B (.assign r.i (.lit 0)) σ (states 0) 2 := by
    simpa only [states,pointState_zero,Expr.size] using
      Run.assign (x:=r.i) (σ:=σ) (evalB_lit (by omega : 0<B))
  apply (hinit.seq hloop).mono
  nlinarith
def shiftValue (v : Nat→Nat) (j : Nat) : Nat := if j=0 then 0 else v (j-1)
def hornerStep (p e : Nat) (modulus acc rhs : Nat→Nat) (a j : Nat) : Nat :=
  (shiftValue acc j+p-(acc (e-1)*modulus j)%p+a*rhs j)%p
def hornerCoeffs (p e : Nat) (modulus lhs rhs : Nat→Nat) : Nat→Nat→Nat
  | 0 => fun _=>0
  | t+1 => hornerStep p e modulus (hornerCoeffs p e modulus lhs rhs t) rhs (lhs (e-1-t))
def workNames (r : FieldNames) : FieldNames :=
  { r with mem:=r.scratch, outBase:=r.k, i:=r.j }
def finishNames (r : FieldNames) : FieldNames := {r with i:=r.j}
def initAccumulator (r : FieldNames) : Com :=
  .seq (.assign r.k (.lit 0)) (storeLoop (workNames r) (.lit 0))
def shiftExpr (r : FieldNames) : Expr :=
  .mul (.get r.scratch (.sub (.var r.j) (.lit 1)))
    (.sub (.lit 1) (.sub (.lit 1) (.var r.j)))
theorem shiftExpr_evalB (r : FieldNames) {B p j : Nat} {σ : Env} (acc : Nat→Nat)
    (hj : (Expr.var r.j).evalB B σ=some j)
    (hread : (Expr.get r.scratch (.sub (.var r.j) (.lit 1))).evalB B σ=some (acc (j-1)))
    (hacc : acc (j-1)<p) (hpB : p<B) (hone : 1<B) :
    (shiftExpr r).evalB B σ=some (shiftValue acc j) := by
  have hone':(Expr.lit 1).evalB B σ=some 1:=evalB_lit hone
  have hsub : (Expr.sub (.lit 1) (.var r.j)).evalB B σ=some (1-j) :=
    evalB_bin (op:=Bop.sub) hone' hj (by change 1-j<B; omega)
  have hind : (Expr.sub (.lit 1) (.sub (.lit 1) (.var r.j))).evalB B σ=some (1-(1-j)) :=
    evalB_bin (op:=Bop.sub) hone' hsub (by change 1-(1-j)<B; omega)
  have hi : 1-(1-j)=if j=0 then 0 else 1 := by split_ifs <;> omega
  have hm : acc (j-1)*(1-(1-j))<B := by rw [hi]; split_ifs <;> simp only [mul_zero,mul_one] <;> omega
  have hh:=evalB_bin (op:=Bop.mul) hread hind hm
  simpa only [shiftExpr,shiftValue,hi,Bop.apply,mul_ite,mul_zero,mul_one] using hh
def hornerArithmetic (shift lead modulus a b p : Expr) : Expr :=
  modExpr (.add (.sub (.add shift p) (modExpr (.mul lead modulus) p)) (.mul a b)) p
def hornerExpr (r : FieldNames) (modArray : String) : Expr :=
  hornerArithmetic (shiftExpr r) (.var r.value) (.get modArray (address r.modBase r.j))
    (.get r.mem (.add (.var r.aBase) (.sub (.sub (.var r.e) (.lit 1)) (.var r.i))))
    (.get r.mem (address r.bBase r.j)) (.var r.p)
theorem hornerArithmetic_evalB {B p s l m a b : Nat} {σ : Env}
    {S L M A C P : Expr}
    (hS : S.evalB B σ=some s) (hL : L.evalB B σ=some l)
    (hM : M.evalB B σ=some m) (hA : A.evalB B σ=some a)
    (hC : C.evalB B σ=some b) (hP : P.evalB B σ=some p)
    (hs : s<p) (hl : l<p) (hm : m<p) (ha : a<p) (hb : b<p)
    (hword : (p+1)^2<B) :
    (hornerArithmetic S L M A C P).evalB B σ=some ((s+p-(l*m)%p+a*b)%p) := by
  have hlm : l*m ≤ p*p := Nat.mul_le_mul (by omega) (by omega)
  have hab : a*b ≤ p*p := Nat.mul_le_mul (by omega) (by omega)
  have hleft : s+p-(l*m)%p ≤ s+p := Nat.sub_le _ _
  have hprod : (Expr.mul L M).evalB B σ=some (l*m) :=
    evalB_bin (op:=Bop.mul) hL hM (by change l*m<B; nlinarith)
  have hmod:=modExpr_evalB hprod hP
  have hsum : (Expr.add S P).evalB B σ=some (s+p) :=
    evalB_bin (op:=Bop.add) hS hP (by change s+p<B; nlinarith)
  have hsub : (Expr.sub (.add S P) (modExpr (.mul L M) P)).evalB B σ=some (s+p-(l*m)%p) :=
    evalB_bin (op:=Bop.sub) hsum hmod (by change s+p-(l*m)%p<B; nlinarith)
  have hright : (Expr.mul A C).evalB B σ=some (a*b) :=
    evalB_bin (op:=Bop.mul) hA hC (by change a*b<B; nlinarith)
  exact modExpr_evalB (evalB_bin (op:=Bop.add) hsub hright (by change s+p-(l*m)%p+a*b<B; nlinarith)) hP
def sourceCoeff (σ : Env) (arr base : String) (j : Nat) : Nat :=
  (σ.arrs arr).getD (σ.vars base+j) 0
def stepValues (r : FieldNames) (modArray : String) (σ : Env) : Nat→Nat :=
  hornerStep (σ.vars r.p) (σ.vars r.e) (sourceCoeff σ modArray r.modBase)
    (fun j=>(σ.arrs r.scratch).getD j 0) (sourceCoeff σ r.mem r.bBase)
    (sourceCoeff σ r.mem r.aBase (σ.vars r.e-1-σ.vars r.i))
theorem hornerMap_run (r : FieldNames) (modArray : String) {B : Nat} (σ : Env)
    (hregs : ∀x∈[r.p,r.e,r.aBase,r.bBase,r.modBase,r.i,r.value,r.k],x≠r.j)
    (hk : σ.vars r.k=σ.vars r.e)
    (hlead : σ.vars r.value=(σ.arrs r.scratch).getD (σ.vars r.e-1) 0)
    (he0 : 0<σ.vars r.e) (hi : σ.vars r.i<σ.vars r.e)
    (hword : (σ.vars r.p+1)^2<B)
    (hmem : (σ.arrs r.mem).length<B) (hmod : (σ.arrs modArray).length<B)
    (hscr : (σ.arrs r.scratch).length<B)
    (hwork : 2*σ.vars r.e ≤ (σ.arrs r.scratch).length)
    (hfitA : σ.vars r.aBase+σ.vars r.e ≤ (σ.arrs r.mem).length)
    (hfitB : σ.vars r.bBase+σ.vars r.e ≤ (σ.arrs r.mem).length)
    (hfitM : σ.vars r.modBase+σ.vars r.e ≤ (σ.arrs modArray).length)
    (hsepA : r.mem≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars r.aBase)
    (hsepB : r.mem≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars r.bBase)
    (hsepM : modArray≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars r.modBase)
    (hcoeff : ∀j<σ.vars r.e,
      sourceCoeff σ r.mem r.aBase j<σ.vars r.p ∧
      sourceCoeff σ r.mem r.bBase j<σ.vars r.p ∧
      sourceCoeff σ modArray r.modBase j<σ.vars r.p ∧
      (σ.arrs r.scratch).getD j 0<σ.vars r.p) :
    Run B (storeLoop (workNames r) (hornerExpr r modArray)) σ
      (pointState σ (workNames r) (stepValues r modArray σ) (σ.vars r.e))
      (1000*(σ.vars r.e+1)) := by
  let f:=stepValues r modArray σ
  have he:σ.vars r.e<B:=by omega
  have hp:σ.vars r.p<B:=by nlinarith
  have hone:1<B:=by nlinarith
  have hh:=storeLoop_run (workNames r) (hornerExpr r modArray) σ f
    (hregs r.k (by simp)) (hregs r.e (by simp)) he hscr
    (by change σ.vars r.k+σ.vars r.e ≤ (σ.arrs r.scratch).length; omega) ?_
  · apply hh.mono
    norm_num [hornerExpr,hornerArithmetic,shiftExpr,address,modExpr,Expr.size,workNames]
  intro j hj
  change j<σ.vars r.e at hj
  let τ:=pointState σ (workNames r) f j
  have hv (x : String) (hx : x∈[r.p,r.e,r.aBase,r.bBase,r.modBase,r.i,r.value,r.k]) :
      τ.vars x=σ.vars x := by simp [τ,pointState,workNames,hregs x hx]
  have v (x : String) (hx : x∈[r.p,r.e,r.aBase,r.bBase,r.modBase,r.i,r.value,r.k])
      (hB : σ.vars x<B) : (Expr.var x).evalB B τ=some (σ.vars x) := by
    simpa only [hv x hx] using evalB_var (σ:=τ) (x:=x) (by rw [hv x hx]; exact hB)
  have hji:τ.vars r.j=j:=by simp [τ,pointState,workNames]
  have hjv : (Expr.var r.j).evalB B τ=some j := by
    simpa only [hji] using evalB_var (σ:=τ) (x:=r.j) (by rw [hji]; omega)
  have hload (arr base : String)
      (hx : base∈[r.p,r.e,r.aBase,r.bBase,r.modBase,r.i,r.value,r.k])
      (t : Nat) (tExpr : Expr) (ht : t<σ.vars r.e)
      (hte : tExpr.evalB B τ=some t)
      (hlen : (σ.arrs arr).length<B)
      (hfit : σ.vars base+σ.vars r.e ≤ (σ.arrs arr).length)
      (hsep : arr≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars base)
      (hval : sourceCoeff σ arr base t<σ.vars r.p) :
      (Expr.get arr (.add (.var base) tExpr)).evalB B τ=some (sourceCoeff σ arr base t) := by
    have ha : (Expr.add (.var base) tExpr).evalB B τ=some (σ.vars base+t) :=
      evalB_bin (op:=Bop.add) (v base hx (by omega)) hte (by change σ.vars base+t<B; omega)
    apply pointState_get_evalB (workNames r) σ f arr _ ha (by omega) _ (hval.trans hp)
    change arr≠r.scratch ∨ σ.vars base+t<σ.vars r.k ∨ σ.vars r.k+j ≤ σ.vars base+t
    rcases hsep with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inr (by omega))
  have hm:=hload modArray r.modBase (by simp) j (.var r.j) hj hjv hmod hfitM hsepM (hcoeff j hj).2.2.1
  have hb:=hload r.mem r.bBase (by simp) j (.var r.j) hj hjv hmem hfitB hsepB (hcoeff j hj).2.1
  have ht:σ.vars r.e-1-σ.vars r.i<σ.vars r.e:=by omega
  have htExpr : (Expr.sub (.sub (.var r.e) (.lit 1)) (.var r.i)).evalB B τ=
      some (σ.vars r.e-1-σ.vars r.i) :=
    evalB_bin (op:=Bop.sub)
      (evalB_bin (op:=Bop.sub) (v r.e (by simp) he) (evalB_lit hone)
        (by change σ.vars r.e-1<B; omega))
      (v r.i (by simp) (by omega)) (by change σ.vars r.e-1-σ.vars r.i<B; omega)
  have ha:=hload r.mem r.aBase (by simp) _ _ ht htExpr hmem hfitA hsepA (hcoeff _ ht).1
  have hpred : (Expr.sub (.var r.j) (.lit 1)).evalB B τ=some (j-1) :=
    evalB_bin (op:=Bop.sub) hjv (evalB_lit hone) (by change j-1<B; omega)
  have hacc:=pointState_get_evalB (workNames r) σ f r.scratch _ hpred
    (by omega) (Or.inr (Or.inl (by change j-1<σ.vars r.k; omega)))
    ((hcoeff (j-1) (by omega)).2.2.2.trans hp)
  have hshift:=shiftExpr_evalB r (fun t=>(σ.arrs r.scratch).getD t 0) hjv hacc
    (hcoeff (j-1) (by omega)).2.2.2 hp hone
  have hs : shiftValue (fun t=>(σ.arrs r.scratch).getD t 0) j<σ.vars r.p := by
    unfold shiftValue
    split_ifs
    · have hh:=(hcoeff 0 he0).1; omega
    · exact (hcoeff (j-1) (by omega)).2.2.2
  have hl : σ.vars r.value<σ.vars r.p := by rw [hlead]; exact (hcoeff _ (by omega)).2.2.2
  have hz:=hornerArithmetic_evalB hshift (v r.value (by simp) (hl.trans hp)) hm ha hb
    (v r.p (by simp) hp) hs hl (hcoeff j hj).2.2.1 (hcoeff _ ht).1 (hcoeff j hj).2.1 hword
