    by_contra hn
    push_neg at hn
    apply ht
    exact IsCoprime.prod_left (fun i _=>(hi i).coprime_iff_not_dvd.mpr (hn i))
  let M : {T : X//P T} → ((i : ι) × {T : X//Q i T}) := fun T=>
    ⟨Classical.choose (hcover T.val T.property),T.val,Classical.choose_spec (hcover T.val T.property)⟩
  have hM : Function.Injective M := by
    intro S T he
    exact Subtype.ext (congrArg (fun z : (i : ι) × {T : X//Q i T}=>z.2.val) he)
  have hc := Nat.card_le_card_of_injective M hM
  rw [Nat.card_sigma] at hc
  have hr : (Nat.card {T : X//P T}:ℝ)≤∑ i:ι,(Nat.card {T : X//Q i T}:ℝ) := by exact_mod_cast hc
  have hq : (1:ℝ)≤Nat.card K := by exact_mod_cast (Nat.card_pos (α:=K))
  have hb (i : ι) : (Nat.card {T : X//Q i T}:ℝ)*(Nat.card K:ℝ)^D≤20*Nat.card X := by
    have h := Mathproof.Problem18OrdinaryOccurrenceBound20261001.irreducible_occurrence_bound
      B hB hnB (g i) (hm i) (hi i) (hhi i)
    exact (mul_le_mul_of_nonneg_left (pow_le_pow_right₀ hq (hlo i)) (by positivity)).trans h
  calc
    _ ≤ (∑ i:ι,(Nat.card {T : X//Q i T}:ℝ))*(Nat.card K:ℝ)^D :=
      mul_le_mul_of_nonneg_right hr (by positivity)
    _ = ∑ i:ι,(Nat.card {T : X//Q i T}:ℝ)*(Nat.card K:ℝ)^D := Finset.sum_mul ..
    _ ≤ ∑ _i:ι,20*(Nat.card X:ℝ) := Finset.sum_le_sum (fun i _=>hb i)
    _ = _ := by simp only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,Nat.card_eq_fintype_card]; ring
theorem residual_probability_bounds (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (hnB : B.Nondegenerate) (g : ι→K[X])
    (hm : ∀ i,(g i).Monic) (hi : ∀ i,Irreducible (g i))
    (D : ℕ) (hlo : ∀ i,D≤(g i).natDegree)
    (hhi : ∀ i,2*(g i).natDegree≤Module.finrank K V) :
    let t := (Nat.card {T : SelfAdjointOperators (RingEquiv.refl K) B //
      IsCoprime (∏ i,g i) T.val.charpoly}:ℝ)/Nat.card (SelfAdjointOperators (RingEquiv.refl K) B)
    0≤t ∧ t≤1 ∧ 1-t≤20*Nat.card ι/(Nat.card K:ℝ)^D := by
  letI : Finite V := Finite.of_injective (Module.finBasis K V).equivFun (Module.finBasis K V).equivFun.injective
  letI : Finite (Module.End K V) := Finite.of_injective (fun T : Module.End K V=>(T:V→V)) DFunLike.coe_injective
  let X := SelfAdjointOperators (RingEquiv.refl K) B
  letI : Fintype X := Fintype.ofFinite _
  letI : Nonempty X := ⟨⟨0,by intro x y; simp⟩⟩
  let P (T : X) := IsCoprime (∏ i,g i) T.val.charpoly
  let r : ℝ := Nat.card {T : X//P T}
  let z : ℝ := Nat.card {T : X//¬P T}
  let s : ℝ := Nat.card X
  have hs : 0<s := by dsimp only [s]; exact_mod_cast (Nat.card_pos (α:=X))
  have htotal : r+z=s := by
    have hc := Fintype.card_subtype_compl P
    have hl := Fintype.card_subtype_le P
    have he : Fintype.card {T : X//P T}+Fintype.card {T : X//¬P T}=Fintype.card X := by omega
    simpa only [r,z,s,Nat.card_eq_fintype_card,Nat.cast_add] using congrArg (fun n:ℕ=>(n:ℝ)) he
  have hr : 0≤ r := by positivity
  have hz : 0≤z := by positivity
  change 0≤ r/s ∧ r/s≤1 ∧ 1-r/s≤_
  refine ⟨div_nonneg hr hs.le,(div_le_one hs).mpr (by linarith),?_⟩
  have hq : (0:ℝ)<Nat.card K := by exact_mod_cast (Nat.card_pos (α:=K))
  have hb := residual_union_bound B hB hnB g hm hi D hlo hhi
  change z*(Nat.card K:ℝ)^D≤20*Nat.card ι*s at hb
  apply (le_div_iff₀ (pow_pos hq D)).mpr
  apply le_of_mul_le_mul_right (a:=s) _ hs
  have he : (1-r/s)*(Nat.card K:ℝ)^D*s=z*(Nat.card K:ℝ)^D := by
    field_simp [hs.ne']
    nlinarith [htotal]
  rw [he]
  exact hb
