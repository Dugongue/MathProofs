  apply Mathproof.Problem18CharTwoNonalternating20260930.nonalternating_isometry_of_finrank_eq
    A B hsA hs hnA hn haA ha
  simpa using hdV.symm
theorem hermitian_anchor_metric_split [StarRing K]
    {F : Type*} [Field F] [Fintype F] [Algebra F K]
    (hcard : Nat.card K=Nat.card F^2) (hstar : ∀ x : K,star x=x^Nat.card F)
    (m r : ℕ) (B : V →ₗ⋆[K] V →ₗ[K] K) (hs : B.IsSymm) (hn : B.Nondegenerate)
