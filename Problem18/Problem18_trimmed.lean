      have hqA3' : σ3.arrs qA = (rest.length + 8) :: ws := by rw [hqA3, hq2]
      obtain ⟨sp, hsp, hpin⟩ := isoOf_pin' k
      obtain ⟨σ4, r4, inv4, fr4⟩ := iso_run (fresh_isoOf k) hXr σ3 [] []
        (fun x => by rw [isoOf_ren]; exact (hcleanX x).1)
        (fun x => by rw [isoOf_ren]; exact (hcleanX x).2)
        (by rw [hpin]; exact hpins sp hsp)
        ⟨[], by rw [isoOf_tin, hqA3']; simp⟩
        (by rw [isoOf_tin, hqA3']; simp [ws]; omega)
        (by rw [isoOf_tin, hqA3']; exact hval')
        (fun _ => hout3)
        (fun h => by simp [isoOf_redirect] at h)
        (fun h => by simp [isoOf_redirect] at h)
        (fun h => by simp [isoOf_redirect] at h)
        (fun h => by simp [isoOf_redirect] at h)
        (fun h => by simp [isoOf_redirect] at h)
