      (rows (Problem18EliminationKernelWitness20261001.columns A j)).map read)
    (hx:rowVec (val F canonical q.WS σ) 5 ((n+1)+m)=
      read (query (m:=m) Problem18EliminationKernelWitness20261001.target))
    (ht:Problem18EliminationKernelWitness20261001.test A j=true) :
