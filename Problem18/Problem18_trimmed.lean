      F.p.size + 1 ≤ n ∧ q.size + 1 ≤ n ∧ words.length ≤ n := by
  intro words n
  have hlen := Lax51Proofs.Encoding.length_le_bitSize words
  have hL : words.length = 8 + F.e + 2*(a*b*c*F.e) := queryWords_length F u q A T
  have he := F.degree_pos
