variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}
def gsrc (src : Expr) : Option ℕ → Expr
  | some k => plus src (.lit k)
  | none => .lit 0
theorem gsrc_size_le (src : Expr) (o : Option ℕ) : (gsrc src o).size ≤ src.size + 2 := by
  cases o <;> simp [gsrc, plus, Expr.size]
def gatherCom (M : FieldMacros F r) (q : RNames) (src dst : Expr) :
    List (Option ℕ) → ℕ → Com
  | [], _ => .skip
  | o :: os, i => .seq (mcall r q M.copy (gsrc src o) (gsrc src o) (plus dst (.lit i)))
      (gatherCom M q src dst os (i + 1))
def gatherStep (M : FieldMacros F r) (src dst : Expr) : ℕ :=
  21 + 2 * src.size + dst.size + M.costPoint
def gatherCost (M : FieldMacros F r) (src dst : Expr) (L : ℕ) : ℕ :=
  L * gatherStep M src dst + 1
def gval (g : ℕ → K) (sv : ℕ) : Option ℕ → K
  | some k => g (sv + k)
  | none => 0
theorem gather_run (M : FieldMacros F r) (q : RNames) (l : List String)
    (hl : ∀ x ∈ l, x ∉ regNames r) (src dst : Expr) (hsp : VarsIn l src) (hdp : VarsIn l dst)
    {B Sn : ℕ} {sv dv : ℕ} :
    ∀ (tbl : List (Option ℕ)) (i₀ : ℕ) (σ : Env), Slots F r q.WS Sn B σ →
      src.evalB B σ = some sv → dst.evalB B σ = some dv → val F r q.WS σ 0 = 0 →
      1 ≤ dv + i₀ → dv + i₀ + tbl.length ≤ Sn →
      (∀ k, some k ∈ tbl → sv + k < Sn ∧ (sv + k < dv + i₀ ∨ dv + i₀ + tbl.length ≤ sv + k)) →
      ∃ τ, Run B (gatherCom M q src dst tbl i₀) σ τ (gatherCost M src dst tbl.length) ∧
        Slots F r q.WS Sn B τ ∧
        (∀ t (ht : t < tbl.length),
          val F r q.WS τ (dv + i₀ + t) = gval (val F r q.WS σ) sv tbl[t]) ∧
        (∀ s < Sn, (s < dv + i₀ ∨ dv + i₀ + tbl.length ≤ s) →
          val F r q.WS τ s = val F r q.WS σ s) ∧
        (∀ x, x ∉ regNames r → τ.vars x = σ.vars x) ∧
        (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
        τ.out = σ.out := by
  have hlA : ∀ e, VarsIn l e → NoVar r.aBase e := fun e he =>
    noVar_of_varsIn (fun h => hl _ h (by simp [regNames, scalarNames])) e he
  have hlB : ∀ e, VarsIn l e → NoVar r.bBase e := fun e he =>
    noVar_of_varsIn (fun h => hl _ h (by simp [regNames, scalarNames])) e he
  intro tbl
  induction tbl with
  | nil =>
    intro i₀ σ hS _ _ _ _ _ _
    refine ⟨σ, Run.skip.mono (by simp [gatherCost]), hS, fun t ht => by simp at ht,
      fun _ _ _ => rfl, fun _ _ => rfl, fun _ _ _ => rfl, rfl, rfl⟩
  | cons o os ih =>
    intro i₀ σ hS hsv hdv hz h1 hfit hsrc
    have hSB := hS.slots_word
    simp only [List.length_cons] at hfit hsrc
    obtain ⟨sa, hsa, hsaS, hsane, hsav⟩ : ∃ sa, (gsrc src o).evalB B σ = some sa ∧ sa < Sn ∧
        sa ≠ dv + i₀ ∧ val F r q.WS σ sa = gval (val F r q.WS σ) sv o := by
      cases o with
      | none =>
        exact ⟨0, evalB_lit (by omega), by omega, by omega, by simp [gval, hz]⟩
      | some k =>
        have hk := hsrc k (by simp)
        refine ⟨sv + k, ?_, hk.1, by omega, rfl⟩
        unfold gsrc plus
        exact evalB_bin hsv (evalB_lit (by omega)) (by change sv + k < B; omega)
    have hNa : NoVar r.aBase (gsrc src o) := by
      cases o with
      | none => trivial
      | some k => exact ⟨hlA src hsp, trivial⟩
    have hdo : (plus dst (.lit i₀)).evalB B σ = some (dv + i₀) := by
      unfold plus; exact evalB_bin hdv (evalB_lit (by omega)) (by change dv + i₀ < B; omega)
    obtain ⟨τ1, hr1, hv1, hc1⟩ := slot_call F r M.copy_spec hS (gsrc src o) (gsrc src o)
      (plus dst (.lit i₀)) hsa hsa hdo hNa ⟨hlA dst hdp, trivial⟩ ⟨hlB dst hdp, trivial⟩
      hsaS hsaS (by omega) (Ne.symm hsane) (Ne.symm hsane)
    have hreg1 : ∀ x, x ∉ regNames r → τ1.vars x = σ.vars x := call_regs_all hc1
    have hsv1 : src.evalB B τ1 = some sv := by
      rw [evalB_congr_varsIn (fun x hx => hreg1 x (hl x hx)) src hsp]; exact hsv
    have hdv1 : dst.evalB B τ1 = some dv := by
      rw [evalB_congr_varsIn (fun x hx => hreg1 x (hl x hx)) dst hdp]; exact hdv
    have hz1 : val F r q.WS τ1 0 = 0 := by
      rw [call_val hc1 (by omega) (by omega)]; exact hz
    obtain ⟨τ, hr, hSτ, hvals, hfr, hregs, harr, hinp, hout⟩ := ih (i₀ + 1) τ1 hc1.slots hsv1
      hdv1 hz1 (by omega) (by omega) (fun k hk => by
        have := hsrc k (List.mem_cons_of_mem _ hk); omega)
    refine ⟨τ, ?_, hSτ, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · refine (hr1.seq hr).mono ?_
      have e1 := gsrc_size_le src o
      have e2 : (plus dst (Expr.lit i₀)).size = dst.size + 2 := rfl
      rw [e2]
      unfold gatherCost gatherStep
      simp only [List.length_cons]
      nlinarith
    · intro t ht
      cases t with
      | zero =>
        rw [hfr _ (by omega) (Or.inl (by omega)), Nat.add_zero, hv1]
        simp only [List.getElem_cons_zero]
        rw [← hsav]
      | succ t =>
        have := hvals t (by simpa using ht)
        rw [show dv + i₀ + (t + 1) = dv + (i₀ + 1) + t by omega, this]
        simp only [List.getElem_cons_succ]
        cases hot : os[t]'(by simpa using ht) with
        | none => rfl
        | some k =>
          have hk := hsrc k (List.mem_cons_of_mem _ (by rw [← hot]; exact List.getElem_mem _))
          simp only [gval]
          exact call_val hc1 hk.1 (by omega)
    · intro s hs hs'
      simp only [List.length_cons] at hs'
      rw [hfr s hs (by omega), call_val hc1 hs (by omega)]
    · intro x hx; rw [hregs x hx, hreg1 x hx]
    · intro a h1 h2; rw [harr a h1 h2, hc1.arrays a h1 h2]
    · rw [hinp, hc1.inp]
    · rw [hout, hc1.out]
end Mathproof.Problem18ClaudeIMPGather20261001
