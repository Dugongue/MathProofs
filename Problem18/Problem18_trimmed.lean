variable {K : Type*} [Field K] [DecidableEq K]
def rowFamily {c m : Nat} (A : Matrix (Fin c) (Fin m) K) : List (Vector K m) :=
  (List.finRange c).map fun i=>Vector.ofFn (A i)
def test {m k : Nat} (Z : Matrix (Fin m) (Fin k) K) (j : Fin k) : (Fin m→K)→ₗ[K]K where
  toFun v := (v ᵥ* Z) j
  map_add' v w := by simp [Matrix.vecMul,dotProduct,add_mul,Finset.sum_add_distrib]
  map_smul' s v := by simp [Matrix.vecMul,dotProduct,smul_eq_mul,mul_assoc,Finset.mul_sum]
@[simp] theorem test_apply {m k : Nat} (Z : Matrix (Fin m) (Fin k) K) (j : Fin k) (v : Fin m→K) :
    test Z j v=(v ᵥ* Z) j := rfl
theorem compressed_constraints_iff {c m k : Nat} (A : Matrix (Fin c) (Fin m) K)
    (Z : Matrix (Fin m) (Fin k) K) :
    (∀v∈(compress (rowFamily A)).1,read v ᵥ* Z=0) ↔ A*Z=0 := by
  have h (j : Fin k) := compress_linear_zeros (rowFamily A) (test Z j)
  constructor
  · intro hz
    ext i j
    have hj := (h j).mp (fun v hv=>congrFun (hz v hv) j)
    have hi := hj (Vector.ofFn (A i)) (by simp [rowFamily])
    simpa [test,Matrix.mul_apply,Matrix.vecMul,dotProduct,read_ofFn] using hi
  · intro hz v hv
    ext j
    apply (h j).mpr ?_ v hv
    intro w hw
    obtain ⟨i,hi,rfl⟩ := List.mem_map.mp hw
    have hh:=congrFun (congrFun hz i) j
    simpa [test,Matrix.mul_apply,Matrix.vecMul,dotProduct,read_ofFn] using hh
theorem compressed_length {c m : Nat} (A : Matrix (Fin c) (Fin m) K) :
    (compress (rowFamily A)).1.length≤ m := compress_length _
theorem compressed_rank {c m : Nat} (A : Matrix (Fin c) (Fin m) K) :
    (compress (rowFamily A)).1.length=A.rank := by
  simpa [matrixRank,rowFamily] using matrixRank_correct A.transpose
