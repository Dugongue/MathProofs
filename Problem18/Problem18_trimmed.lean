def pMatrix {a b : ℕ} (x : OuterVar a b → K) : Matrix (Fin a) (Fin a) K :=
  fun i j => x (.inl (i,j))
def rMatrix {a b : ℕ} (x : OuterVar a b → K) : Matrix (Fin b) (Fin b) K :=
  fun i j => x (.inr (i,j))
theorem eval_sumFin_eq_finset_sum [Semiring K] {σ : Type*}
    (x : σ → K) (n : ℕ) (f : Fin n → PolyExpr σ K) :
