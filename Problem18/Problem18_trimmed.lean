namespace Mathproof.Problem18LargeSourceCovariance20261001
open scoped BigOperators Matrix
open Matrix FiniteFieldOrthogonalUnitaryTI
open Problem18OrthogonalAssembly (RectTensor rectAction)
open Problem18LargeSourcePredicate20261001
variable {K : Type*} [Field K] [StarRing K] {a b c : ℕ}
def blockFamily (X : Matrix (Fin a×Fin b) (Fin a×Fin b) K)
    (kl : Fin b×Fin b) : Matrix (Fin a) (Fin a) K := fun i j=>X (i,kl.1) (j,kl.2)
theorem blockFamily_conjugate (X : Matrix (Fin a×Fin b) (Fin a×Fin b) K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (kl : Fin b×Fin b) :
    blockFamily (Matrix.kronecker P Q*X*(Matrix.kronecker P Q)ᴴ) kl=
      ∑ k : Fin b,∑ l : Fin b,(Q kl.1 k*star (Q kl.2 l)) • (P*blockFamily X (k,l)*Pᴴ) := by
  ext i j
  simp only [blockFamily,Matrix.mul_apply,Matrix.conjTranspose_apply,Matrix.kronecker,Matrix.kroneckerMap_apply,
    Fintype.sum_prod_type,Matrix.sum_apply,Matrix.smul_apply,smul_eq_mul,star_mul,
    Finset.mul_sum,Finset.sum_mul]
  conv_lhs =>
    arg 2; ext j'
    arg 2; ext l
    rw [Finset.sum_comm]
  conv_lhs =>
    arg 2; ext j'
    rw [Finset.sum_comm]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro k _
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro l _
  apply Finset.sum_congr rfl
  intro j' _
  apply Finset.sum_congr rfl
  intro i' _
  ring
theorem secondFamily_action (A : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (hR : IsUnitary R) (kl : Fin b×Fin b) :
    secondFamily (rectAction P Q R A) kl=
      ∑ k : Fin b,∑ l : Fin b,(Q kl.1 k*star (Q kl.2 l)) • (P*secondFamily A (k,l)*Pᴴ) := by
  have he (Y : RectTensor a b c K) : secondFamily Y=blockFamily (columnGramRecord Y) := by
    funext kl i j
    exact secondFamily_eq_block Y kl.1 kl.2 i j
  rw [he,rectangular_columnGram_action A P Q R hR,blockFamily_conjugate,he]
theorem adjoint_unitary {n : ℕ} (P : Matrix (Fin n) (Fin n) K) (hP : IsUnitary P) :
    IsUnitary Pᴴ := by
  simpa only [IsUnitary,Matrix.conjTranspose_conjTranspose] using unitary_mul_conjTranspose hP
theorem action_adjoint_inverse (A : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (hP : IsUnitary P) (hQ : IsUnitary Q)
    (hR : IsUnitary R) : rectAction Pᴴ Qᴴ Rᴴ (rectAction P Q R A)=A := by
  have hW := unitary_kronecker P Q hP hQ
  unfold rectAction
  unfold Matrix.kronecker
  rw [←Matrix.conjTranspose_kronecker]
  calc Rᴴ*(R*A*(Matrix.kronecker P Q).transpose)*((Matrix.kronecker P Q)ᴴ).transpose
      =(Rᴴ*R)*A*((Matrix.kronecker P Q)ᴴ*Matrix.kronecker P Q).transpose := by
        simp only [Matrix.transpose_mul,Matrix.mul_assoc]
       _=A := by rw [hR,hW]; simp
theorem conjugate_adjoint_cancel {n : ℕ} (P Z : Matrix (Fin n) (Fin n) K)
    (hP : IsUnitary P) : P*(Pᴴ*Z*P)*Pᴴ=Z := by
  calc P*(Pᴴ*Z*P)*Pᴴ=(P*Pᴴ)*Z*(P*Pᴴ) := by simp only [Matrix.mul_assoc]
       _=Z := by rw [unitary_mul_conjTranspose hP]; simp
theorem second_generation_action (A : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (hP : IsUnitary P) (hQ : IsUnitary Q)
    (hR : IsUnitary R) (hgen : Algebra.adjoin K (Set.range (secondFamily A))=⊤) :
    Algebra.adjoin K (Set.range (secondFamily (rectAction P Q R A)))=⊤ := by
  let J := Algebra.adjoin K (Set.range (secondFamily (rectAction P Q R A)))
  have hfull := generating_family_unitary_conjugate (secondFamily A) P hP hgen
  apply top_unique
  rw [←hfull]
  apply Algebra.adjoin_le
  rintro X ⟨kl,rfl⟩
  have he := secondFamily_action (rectAction P Q R A) Pᴴ Qᴴ Rᴴ
    (adjoint_unitary R hR) kl
  rw [action_adjoint_inverse A P Q R hP hQ hR] at he
  change P*secondFamily A kl*Pᴴ∈J
  rw [he]
  simp only [Matrix.mul_sum,Matrix.sum_mul,Matrix.mul_smul,Matrix.smul_mul,
    Matrix.conjTranspose_conjTranspose,conjugate_adjoint_cancel P _ hP]
  apply J.sum_mem
  intro k _
  apply J.sum_mem
  intro l _
  exact J.smul_mem (Algebra.subset_adjoin ⟨(k,l),rfl⟩) _
theorem good_action (A : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (hP : IsUnitary P) (hQ : IsUnitary Q)
    (hR : IsUnitary R) (hA : Good A) : Good (rectAction P Q R A) :=
  ⟨first_generation_action A P Q R hP hQ hR hA.1,
    second_generation_action A P Q R hP hQ hR hA.2⟩
theorem good_action_iff (A : RectTensor a b c K)
    (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (hP : IsUnitary P) (hQ : IsUnitary Q)
    (hR : IsUnitary R) : Good (rectAction P Q R A) ↔ Good A := by
  refine ⟨?_,good_action A P Q R hP hQ hR⟩
  intro h
  have hh := good_action _ Pᴴ Qᴴ Rᴴ (adjoint_unitary P hP)
    (adjoint_unitary Q hQ) (adjoint_unitary R hR) h
  simpa only [action_adjoint_inverse A P Q R hP hQ hR] using hh
end Mathproof.Problem18LargeSourceCovariance20261001
