section GoodClass
variable {i : Type*} [StarRing K] [Fintype i] [DecidableEq i]
def unitaryConjugation (P : Matrix i i K) (hP : IsUnitary P) :
    Matrix i i K ≃ₐ[K] Matrix i i K where
  toFun X := P * X * Pᴴ
  invFun X := Pᴴ * X * P
  left_inv X := by
    change Pᴴ * (P * X * Pᴴ) * P = X
    calc
      _ = (Pᴴ * P) * X * (Pᴴ * P) := by simp only [Matrix.mul_assoc]
      _ = X := by rw [hP]; simp
  right_inv X := by
    change P * (Pᴴ * X * P) * Pᴴ = X
    calc
      _ = (P * Pᴴ) * X * (P * Pᴴ) := by simp only [Matrix.mul_assoc]
      _ = X := by rw [unitary_mul_conjTranspose hP]; simp
  map_mul' X Y := by
    change P * (X * Y) * Pᴴ = (P * X * Pᴴ) * (P * Y * Pᴴ)
    calc
      _ = P * X * (Pᴴ * P) * Y * Pᴴ := by rw [hP]; simp only [Matrix.mul_one, Matrix.mul_assoc]
      _ = _ := by simp only [Matrix.mul_assoc]
  map_add' X Y := by simp only [Matrix.mul_add, Matrix.add_mul]
  commutes' a := by
    simp only [Algebra.algebraMap_eq_smul_one, Matrix.mul_smul, Matrix.mul_one,
      Matrix.smul_mul, unitary_mul_conjTranspose hP]
theorem generating_family_unitary_conjugate {t : Type*}
    (S : t → Matrix i i K) (P : Matrix i i K) (hP : IsUnitary P)
    (hgen : Algebra.adjoin K (Set.range S) = ⊤) :
    Algebra.adjoin K (Set.range (fun a => P * S a * Pᴴ)) = ⊤ := by
  let f := unitaryConjugation P hP
  have he : Set.range (fun a => P * S a * Pᴴ) = f '' Set.range S := by
    ext X
    constructor
    · rintro ⟨a, rfl⟩
      exact ⟨S a, ⟨a,rfl⟩,rfl⟩
    · rintro ⟨Y, ⟨a,rfl⟩, rfl⟩
      exact ⟨a,rfl⟩
  rw [he]
  change Algebra.adjoin K (f.toAlgHom '' Set.range S) = ⊤
  rw [Algebra.adjoin_image, hgen, Algebra.map_top]
  exact (AlgHom.range_eq_top _).mpr f.surjective
end GoodClass
