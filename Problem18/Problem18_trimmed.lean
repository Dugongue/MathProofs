noncomputable section
set_option backward.isDefEq.respectTransparency false
open Classical
open scoped BigOperators
open Mathproof.Problem18OddSphereCard20260930
variable {K : Type*} [Field K] [Fintype K]
noncomputable def weightedSquareEquiv (a t : K) (ha : a ≠ 0) :
    {x : K // a*x^2=t} ≃ {y : K // y^2=a*t} where
  toFun x := ⟨a*x.val,by linear_combination a*x.property⟩
  invFun y := ⟨y.val/a,by
    calc a*(y.val/a)^2=y.val^2/a := by field_simp <;> ring
         _ = t := (div_eq_iff ha).mpr (y.property.trans (mul_comm a t))⟩
  left_inv x := by apply Subtype.ext; dsimp; field_simp
  right_inv y := by apply Subtype.ext; dsimp; field_simp
theorem weighted_square_card (hodd : ringChar K ≠ 2) (a t : K) (ha : a ≠ 0) :
    (Nat.card {x : K // a*x^2=t} : ℤ)=quadraticChar K (a*t)+1 := by
  rw [Nat.card_congr (weightedSquareEquiv a t ha),square_fiber_card hodd]
noncomputable def weightedBinaryFiberEquiv (a b t : K) (hb : b ≠ 0) :
    {xy : K × K // a*xy.1^2+b*xy.2^2=t} ≃
      Σ x : K,{z : K // z^2=b*t-a*b*x^2} where
  toFun xy := ⟨xy.val.1,⟨b*xy.val.2,by
    linear_combination b*xy.property⟩⟩
  invFun xz := ⟨(xz.1,xz.2.val/b),by
    dsimp
    apply mul_left_cancel₀ hb
    calc b*(a*xz.1^2+b*(xz.2.val/b)^2)=a*b*xz.1^2+xz.2.val^2 := by field_simp <;> ring
         _ = b*t := by linear_combination xz.2.property⟩
  left_inv xy := by
    apply Subtype.ext
    apply Prod.ext
    · rfl
    · dsimp; field_simp
  right_inv xz := by
    apply Sigma.ext
    · rfl
    · apply heq_of_eq
      apply Subtype.ext
      dsimp
      field_simp
private theorem quadratic_difference_sum_all (hodd : ringChar K ≠ 2) (t : K) :
    (∑ x : K,quadraticChar K (x^2-t)) = -1+Nat.card K*(if t=0 then 1 else 0) := by
  by_cases ht : t=0
  · subst t
    have hq (x : K) : quadraticChar K (x^2-0)=if x=0 then 0 else 1 := by
      by_cases hx : x=0
      · simp [hx]
      · simp [hx,quadraticChar_sq_one' hx]
    simp_rw [hq]
    simp only [Finset.sum_ite,Finset.sum_const_zero,zero_add,Finset.sum_const,
      nsmul_eq_mul,mul_one,if_true]
    have hf : (Finset.univ.filter fun x : K => ¬x=0).card=Fintype.card K-1 := by
      have he : (Finset.univ.filter fun x : K => ¬x=0)=Finset.univ.erase 0 := by
        ext x; simp [and_comm]
      rw [he,Finset.card_erase_of_mem (Finset.mem_univ _),Finset.card_univ]
    rw [hf,Nat.cast_sub (by exact Fintype.card_pos),← Nat.card_eq_fintype_card]
    push_cast
    ring
  · rw [quadratic_difference_sum hodd t ht,if_neg ht]
    ring
theorem weighted_binary_card (hodd : ringChar K ≠ 2) (a b t : K)
    (ha : a ≠ 0) (hb : b ≠ 0) :
    (Nat.card {xy : K × K // a*xy.1^2+b*xy.2^2=t} : ℤ)=
      Nat.card K-quadraticChar K (-a*b)+
        quadraticChar K (-a*b)*Nat.card K*(if t=0 then 1 else 0) := by
  rw [Nat.card_congr (weightedBinaryFiberEquiv a b t hb),Nat.card_sigma,Nat.cast_sum]
  simp_rw [square_fiber_card hodd]
  rw [Finset.sum_add_distrib]
  have he (x : K) : quadraticChar K (b*t-a*b*x^2)=
      quadraticChar K (-a*b)*quadraticChar K (x^2-t/a) := by
    rw [← map_mul]
    congr 1
    field_simp
    ring
  simp_rw [he]
  rw [← Finset.mul_sum,quadratic_difference_sum_all hodd]
  simp only [div_eq_zero_iff,ha,or_false,Finset.sum_const,Finset.card_univ,
    nsmul_eq_mul,mul_one,← Nat.card_eq_fintype_card]
  ring
def weightedSum {n : ℕ} (a v : Fin n → K) : K := ∑ i,a i*(v i)^2
noncomputable def weightedCount {n : ℕ} (a : Fin n → K) (t : K) : ℤ :=
  Nat.card {v : Fin n → K // weightedSum a v=t}
noncomputable def weightedTwoStepEquiv {n : ℕ} (a : Fin (n+2) → K) (t : K) :
    {v : Fin (n+2) → K // weightedSum a v=t} ≃
      Σ v : Fin n → K,{xy : K × K // a 0*xy.1^2+a 1*xy.2^2=
        t-weightedSum (Fin.tail (Fin.tail a)) v} where
  toFun v := ⟨Fin.tail (Fin.tail v.val),⟨(v.val 0,v.val 1),by
    have h:=v.property
    simp only [weightedSum,Fin.sum_univ_succ] at h
    change a 0*(v.val 0)^2+a 1*(v.val 1)^2=
      t-∑ i : Fin n,a i.succ.succ*(v.val i.succ.succ)^2
    have hi : (1 : Fin (n+2))=Fin.succ (0 : Fin (n+1)) := by ext; simp
    rw [hi]
    linear_combination h⟩⟩
  invFun v := ⟨Fin.cons v.2.val.1 (Fin.cons v.2.val.2 v.1),by
    simp only [weightedSum,Fin.sum_univ_succ,Fin.cons_zero,Fin.cons_succ]
    have h:=v.2.property
    change a 0*(v.2.val.1)^2+a 1*(v.2.val.2)^2=
      t-∑ i : Fin n,a i.succ.succ*(v.1 i)^2 at h
    have hi : (1 : Fin (n+2))=Fin.succ (0 : Fin (n+1)) := by ext; simp
    simp only [hi] at h
    linear_combination h⟩
  left_inv v := by
    apply Subtype.ext
    funext i
    refine Fin.cases ?_ (fun j => Fin.cases ?_ (fun k => ?_) j) i <;> rfl
  right_inv v := by cases v; rfl
theorem weightedCount_add_two (hodd : ringChar K ≠ 2) {n : ℕ}
    (a : Fin (n+2) → K) (ha : ∀ i,a i ≠ 0) (t : K) :
    weightedCount a t=(Nat.card K-quadraticChar K (-a 0*a 1))*(Nat.card K:ℤ)^n+
      quadraticChar K (-a 0*a 1)*Nat.card K*
        weightedCount (Fin.tail (Fin.tail a)) t := by
  unfold weightedCount
  rw [Nat.card_congr (weightedTwoStepEquiv a t),Nat.card_sigma,Nat.cast_sum]
  simp_rw [weighted_binary_card hodd (a 0) (a 1) _ (ha 0) (ha 1)]
  have he (v : Fin n → K) : (t-weightedSum (Fin.tail (Fin.tail a)) v=0) ↔
      weightedSum (Fin.tail (Fin.tail a)) v=t := by rw [sub_eq_zero,eq_comm]
  simp_rw [he]
  rw [Finset.sum_add_distrib,← Finset.mul_sum]
  have hs : (∑ v : Fin n → K,if weightedSum (Fin.tail (Fin.tail a)) v=t then (1:ℤ) else 0)=
      Nat.card {v : Fin n → K // weightedSum (Fin.tail (Fin.tail a)) v=t} := by
    rw [Nat.card_eq_fintype_card,Fintype.card_subtype]
    simp only [Finset.sum_boole]
  rw [hs]
  simp only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,Fintype.card_fun,
    Fintype.card_fin,Nat.cast_pow]
  simp only [Nat.card_eq_fintype_card]
  ring
def discriminant {n : ℕ} (a : Fin n → K) : K := (-1:K)^(n/2)*∏ i,a i
theorem discriminant_add_two {n : ℕ} (a : Fin (n+2) → K) :
    discriminant a=(-a 0*a 1)*discriminant (Fin.tail (Fin.tail a)) := by
  unfold discriminant
  rw [show (n+2)/2=n/2+1 by omega,pow_succ]
  simp only [Fin.prod_univ_succ]
  have hi : (1 : Fin (n+2))=Fin.succ (0 : Fin (n+1)) := by ext; simp
  rw [hi]
  change (-1:K)^(n/2)*(-1)*(a 0*(a (Fin.succ 0)*(∏ i : Fin n,a i.succ.succ))) =
    (-a 0*a (Fin.succ 0))*((-1:K)^(n/2)*(∏ i : Fin n,a i.succ.succ))
  ring
@[simp] theorem weightedCount_zero (a : Fin 0 → K) (t : K) :
    weightedCount a t=if t=0 then 1 else 0 := by
  unfold weightedCount weightedSum
  by_cases ht : t=0
  · subst t; simp
  · simp [ht,eq_comm]
theorem weightedCount_one (hodd : ringChar K ≠ 2) (a : Fin 1 → K)
    (ha : a 0 ≠ 0) (t : K) : weightedCount a t=quadraticChar K (a 0*t)+1 := by
  have e : {v : Fin 1 → K // weightedSum a v=t} ≃ {x : K // a 0*x^2=t} :=
    Equiv.subtypeEquiv (Equiv.funUnique (Fin 1) K) (by
      intro v
      simp [weightedSum,Equiv.funUnique,Equiv.piUnique])
  unfold weightedCount
  rw [Nat.card_congr e,weighted_square_card hodd _ _ ha]
private theorem discriminant_char {n : ℕ} (a : Fin (n+2) → K) (t : K) :
    quadraticChar K (discriminant a*t)=
      quadraticChar K (-a 0*a 1)*quadraticChar K (discriminant (Fin.tail (Fin.tail a))*t) := by
  rw [discriminant_add_two,← map_mul]
  congr 1
  ring
theorem weighted_odd_count (hodd : ringChar K ≠ 2) (m : ℕ)
    (a : Fin (2*m+1) → K) (ha : ∀ i,a i ≠ 0) (t : K) :
    weightedCount a t=(Nat.card K:ℤ)^(2*m)+
      quadraticChar K (discriminant a*t)*(Nat.card K:ℤ)^m := by
  induction m with
  | zero =>
    rw [weightedCount_one hodd a (ha 0)]
    simp [discriminant,Fin.prod_univ_succ,add_comm]
  | succ m ih =>
    revert a
    rw [show 2*(m+1)+1=(2*m+1)+2 by omega]
    intro a ha
    rw [weightedCount_add_two hodd a ha,
      ih (Fin.tail (Fin.tail a)) (fun i => ha i.succ.succ),discriminant_char a t]
    rw [show 2*(m+1)=2*m+2 by omega]
    simp only [pow_add,pow_succ]
    ring
theorem weighted_even_count (hodd : ringChar K ≠ 2) (m : ℕ)
    (a : Fin (2*m+2) → K) (ha : ∀ i,a i ≠ 0) (t : K) :
    weightedCount a t=(Nat.card K:ℤ)^(2*m+1)+
      quadraticChar K (discriminant a)*(Nat.card K:ℤ)^m*
        ((Nat.card K:ℤ)*(if t=0 then 1 else 0)-1) := by
  induction m with
  | zero =>
    rw [weightedCount_add_two hodd a ha,weightedCount_zero]
    simp only [Nat.mul_zero,zero_add,pow_zero,pow_one,mul_one]
    have hd : discriminant a=-a 0*a 1 := by
      simp [discriminant,Fin.prod_univ_succ]
    rw [hd]
    ring
  | succ m ih =>
    revert a
    rw [show 2*(m+1)+2=(2*m+2)+2 by omega]
    intro a ha
    have hc : quadraticChar K (discriminant a)=quadraticChar K (-a 0*a 1)*
        quadraticChar K (discriminant (Fin.tail (Fin.tail a))) := by
      rw [discriminant_add_two a,map_mul]
    rw [weightedCount_add_two hodd a ha,
      ih (Fin.tail (Fin.tail a)) (fun i => ha i.succ.succ),hc]
    rw [show 2*(m+1)=2*m+2 by omega]
    simp only [pow_add,pow_succ]
    ring
end
end Mathproof.Problem18WeightedOddSphereCard20260930
