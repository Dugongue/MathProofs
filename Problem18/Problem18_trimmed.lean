    rcases h.firstCapacity with hz | hn
    · exact Or.inl hz
    · exact Or.inr (Or.inr (by omega))
  have hdef : ∀ ξ, I ξ → ∃ v, (Cond.lt (.var q.c) (.var q.n)).evalB B ξ = some v := by
    rintro ξ ⟨R,hs,_,hc,_,_,_,_,_⟩
    exact evalB_condLt_vars (by omega) (by rw [hs.capacity];exact hNB)
  have hstep : ∀ ξ, I ξ → (Cond.lt (.var q.c) (.var q.n)).evalB B ξ = some true →
      ∃ ζ, Run B (Problem18IMPPolynomialRemainder20261001.body q) ξ ζ (bodyBudget F q N) ∧
        I ζ ∧ N-ζ.vars q.c < N-ξ.vars q.c := by
    rintro ξ ⟨R,hs,hmod,hc,hpot,hvars,hin,hout,hframe⟩ he
