theorem product_quotient_frame {ι : Type*} [Fintype ι] (g : ι → K[X])
    [∀ i,Fact (Irreducible (g i))] (hm : ∀ i,(g i).Monic)
    (hcop : Pairwise (fun i j => IsCoprime (g i) (g j)))
    (S : Module.End K V) (hf : S.charpoly=∏ i,g i) :
    Nonempty (Frames (AdjoinRoot.root (∏ i,g i)) S) := by
