def totalStep {σ : Type*} (f : σ → Option σ) (x : σ) : σ := (f x).getD x
theorem iterate_bind_none {σ : Type*} (f : σ → Option σ) (n : ℕ) :
    (fun x : Option σ => x.bind f)^[n] none = none :=
  Function.iterate_fixed rfl n
theorem total_iterate_of_some {σ : Type*} (f : σ → Option σ)
    (n : ℕ) (a b : σ)
    (h : (fun x : Option σ => x.bind f)^[n] (some a) = some b) :
    (totalStep f)^[n] a = b := by
  induction n generalizing a with
  | zero => simpa using h
  | succ n ih =>
    rw [Function.iterate_succ_apply] at h ⊢
    cases hf : f a with
    | none =>
      simp only [Option.bind_some, hf, iterate_bind_none] at h
      contradiction
    | some c =>
      simp only [Option.bind_some, hf] at h
      simpa only [totalStep, hf, Option.getD_some] using ih c h
theorem total_iterate_of_reaches {σ : Type*} (f : σ → Option σ)
    (a b : σ) (h : StateTransition.EvalsTo f a (some b)) :
    (totalStep f)^[h.steps] a = b :=
  total_iterate_of_some f h.steps a b h.evals_in_steps
theorem total_iterate_terminal {σ : Type*} (f : σ → Option σ)
    (a b : σ) (h : StateTransition.EvalsTo f a (some b)) (hb : f b = none)
    (n : ℕ) (hn : h.steps ≤ n) : (totalStep f)^[n] a = b := by
  rw [← Nat.sub_add_cancel hn, Function.iterate_add_apply,
    total_iterate_of_reaches f a b h]
  exact Function.iterate_fixed (by simp [totalStep, hb]) _
theorem deterministic_run (A : Turing.TM2ComputableAux Bool Bool)
    (hΓ : ∀ k, Fintype (A.tm.Γ k)) (input coins : List Bool) :
    run (deterministic A hΓ) input coins =
      (totalStep A.tm.step)^[coins.length]
        (Turing.initList A.tm (input.map A.inputAlphabet.symm)) := by
  unfold run
  change coins.foldl (fun c _ => totalStep A.tm.step c) _ = _
  exact List.foldl_const _ _ _
theorem deterministic_reaches_terminal (A : Turing.TM2ComputableAux Bool Bool)
    (hΓ : ∀ k, Fintype (A.tm.Γ k)) (input : List Bool) (c : A.tm.Cfg)
    (h : StateTransition.EvalsTo A.tm.step
      (Turing.initList A.tm (input.map A.inputAlphabet.symm)) (some c))
    (hc : A.tm.step c = none) (coins : List Bool) (hn : h.steps ≤ coins.length) :
    run (deterministic A hΓ) input coins = c := by
  rw [deterministic_run]
  exact total_iterate_terminal _ _ _ h hc _ hn
theorem deterministic_outputs (A : Turing.TM2ComputableAux Bool Bool)
    (hΓ : ∀ k, Fintype (A.tm.Γ k)) (input : List Bool) (answer : Option Bool)
    (T : ℕ)
    (h : Turing.TM2OutputsInTime A.tm (input.map A.inputAlphabet.symm)
      (some ((encodeAnswer answer).map A.outputAlphabet.symm)) T) :
    ZeroError (deterministic A hΓ) input answer ∧
      ExpectedStepsLE (deterministic A hΓ) input (T : ℝ) := by
  let c := Turing.haltList A.tm ((encodeAnswer answer).map A.outputAlphabet.symm)
  have hc : A.tm.step c = none := rfl
  let he : StateTransition.EvalsTo A.tm.step
      (Turing.initList A.tm (input.map A.inputAlphabet.symm)) (some c) := h.toEvalsTo
  have hrun (coins : List Bool) (hn : T ≤ coins.length) :
      run (deterministic A hΓ) input coins = c :=
    deterministic_reaches_terminal A hΓ input c he hc coins (h.steps_le_m.trans hn)
  have hhalt (coins : List Bool) (hn : T ≤ coins.length) :
      halted (deterministic A hΓ) input coins = true := by
    unfold halted
    rw [hrun coins hn]
    rfl
  constructor
  · intro coins hh
    have hext := run_append_of_halted (deterministic A hΓ) input coins
      (List.replicate T false) hh
    have hlong := hrun (coins ++ List.replicate T false) (by simp)
    have hr : run (deterministic A hΓ) input coins = c := hext.symm.trans hlong
    unfold output
    rw [hr]
    simp [c, deterministic, Turing.haltList, List.map_map, Function.comp_def]
    change List.map (fun x : Bool => A.outputAlphabet (A.outputAlphabet.symm x))
      (encodeAnswer answer) = encodeAnswer answer
    have hout : (fun x => A.outputAlphabet (A.outputAlphabet.symm x)) = id :=
      funext A.outputAlphabet.apply_symm_apply
    rw [hout, List.map_id]
  · apply expectedStepsLE_of_halts_at
    intro coins hn
    exact hhalt coins hn.ge
end Mathproof.Problem18TM2OperationalBridge20260930
