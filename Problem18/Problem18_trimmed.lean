variable {K V : Type*} [Field K] [Fintype K]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
local instance : Finite (Module.End K V) := by
  letI : Finite V := Finite.of_injective (Module.finBasis K V).equivFun
    (Module.finBasis K V).equivFun.injective
  exact Finite.of_injective (fun S : Module.End K V => (S : V → V)) DFunLike.coe_injective
abbrev OperatorsOf (B : LinearMap.BilinForm K V) (f : K[X]) :=
  {S : Module.End K V // S.charpoly=f ∧ B.IsSelfAdjoint S}
theorem odd_polynomial_operator_card (hodd : ringChar K≠2) (f : K[X])
    (hm : f.Monic) (hs : Squarefree f) (hp : 0<f.natDegree)
    (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hnB : B.Nondegenerate)
    (hdim : Module.finrank K V=f.natDegree) :
    Nat.card (OperatorsOf B f)*2=
      Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y)) := by
  classical
  let I := FactorIndex f
  let g (i : I) := i.val
  letI (i : I) : Fact (Irreducible (g i)) := ⟨factor_irreducible f i⟩
  letI : Nonempty I := by
    by_contra h
    letI : IsEmpty I := ⟨fun i => h ⟨i⟩⟩
    have hh := congrArg Polynomial.natDegree (factor_product f hm hs)
    simp only [Finset.univ_eq_empty,Finset.prod_empty,natDegree_one] at hh
    omega
  have hc : Pairwise (fun i j : I => IsCoprime (g i) (g j)) := by
    intro i j hij
    apply (factor_irreducible f i).coprime_iff_not_dvd.mpr
    intro hd
    have he := Polynomial.eq_of_monic_of_associated (factor_monic f i) (factor_monic f j)
      (((factor_irreducible f i).dvd_irreducible_iff_associated (factor_irreducible f j)).mp hd)
    exact hij (Subtype.ext he)
  have hd : Module.finrank K V=∑ i,(g i).natDegree := by
    have hh := congrArg Polynomial.natDegree (factor_product f hm hs)
    rw [Polynomial.natDegree_prod_of_monic Finset.univ g (fun i _ => factor_monic f i)] at hh
    exact hdim.trans hh
  have he : OperatorsOf B f ≃ Mathproof.Problem18SquarefreeOperatorCount20260930.Operators g B :=
    Equiv.subtypeEquivRight (fun S => by rw [← factor_product f hm hs]; rfl)
  rw [Nat.card_congr he]
  exact odd_squarefree_operator_card g hodd (factor_monic f) hc B hB hnB hd
abbrev FixedSquarefree (n : ℕ) (c : K) :=
  {f : FixedConstant (K:=K) n c // Squarefree f.val.val}
abbrev FixedGoodOperators (B : LinearMap.BilinForm K V) (c : K) :=
  {S : Module.End K V // B.IsSelfAdjoint S ∧ Squarefree S.charpoly ∧ S.charpoly.coeff 0=c}
theorem fixed_operator_family_count (hodd : ringChar K≠2) (n : ℕ) (hn : 0<n) (c : K)
    (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hnB : B.Nondegenerate)
    (hdim : Module.finrank K V=n) :
    Nat.card (FixedSquarefree (K:=K) n c)*
      Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y)) ≤
        Nat.card (FixedGoodOperators B c)*2 := by
  classical
  let I := FixedSquarefree (K:=K) n c
  let f : (Σ p : I,OperatorsOf B p.val.val.val) → FixedGoodOperators B c :=
    fun z => ⟨z.2.val,z.2.property.2,
      z.2.property.1.symm ▸ z.1.property,
      z.2.property.1.symm ▸ z.1.val.property⟩
  have hf : Function.Injective f := by
    rintro ⟨p,S⟩ ⟨q,T⟩ h
    have hST : S.val=T.val := congrArg Subtype.val h
    have hpq : p=q := by
      apply Subtype.ext
      apply Subtype.ext
      apply Subtype.ext
      exact S.property.1.symm.trans ((congrArg (fun R : Module.End K V => R.charpoly) hST).trans T.property.1)
    subst q
    exact congrArg (Sigma.mk p) (Subtype.ext hST)
  have hc := Nat.card_le_card_of_injective f hf
  have hh := Nat.mul_le_mul_right 2 hc
  rw [Nat.card_sigma,Finset.sum_mul] at hh
  have hp (p : I) : Nat.card (OperatorsOf B p.val.val.val)*2=
      Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y)) :=
    odd_polynomial_operator_card hodd p.val.val.val p.val.val.property.1 p.property
      (by simpa only [p.val.val.property.2] using hn) B hB hnB (hdim.trans p.val.val.property.2.symm)
  simp_rw [hp] at hh
  simpa only [Finset.sum_const,Finset.card_univ,smul_eq_mul,Nat.card_eq_fintype_card] using hh
theorem fixed_operator_mass_lower (hodd : ringChar K≠2) (n : ℕ) (hn : 4≤n)
    (c : K) (hc : c≠0) (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (hnB : B.Nondegenerate) (hdim : Module.finrank K V=n) :
    (Nat.card K:ℝ)^(n-1)*
      Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y))/12 ≤
        Nat.card (FixedGoodOperators B c) := by
  have hq : (0:ℝ)<Nat.card K := by exact_mod_cast Nat.card_pos (α:=K)
  have hp := (le_div_iff₀ (pow_pos hq (n-1))).mp
    (fixed_constant_squarefree_density hodd n hn c hc)
  have hg : (0:ℝ)≤Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y)) := by positivity
  have hm := mul_le_mul_of_nonneg_right hp hg
  have hs := fixed_operator_family_count hodd n (by omega) c B hB hnB hdim
  have hsR : (Nat.card (FixedSquarefree (K:=K) n c):ℝ)*
      Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y)) ≤
        (Nat.card (FixedGoodOperators B c):ℝ)*2 := by exact_mod_cast hs
  change (1/6:ℝ)*(Nat.card K:ℝ)^(n-1)*
    Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y)) ≤ _ at hm
  nlinarith
theorem charTwo_polynomial_operator_card [CharP K 2] (f : K[X])
    (hm : f.Monic) (hs : Squarefree f) (hp : 0<f.natDegree)
    (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hnB : B.Nondegenerate) (haB : ¬B.IsAlt)
    (hdim : Module.finrank K V=f.natDegree) :
    Nat.card (OperatorsOf B f)=
      Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y)) := by
  classical
  let I := FactorIndex f
  let g (i : I) := i.val
  letI (i : I) : Fact (Irreducible (g i)) := ⟨factor_irreducible f i⟩
  letI : Nonempty I := by
    by_contra h
    letI : IsEmpty I := ⟨fun i => h ⟨i⟩⟩
    have hh := congrArg Polynomial.natDegree (factor_product f hm hs)
    simp only [Finset.univ_eq_empty,Finset.prod_empty,natDegree_one] at hh
    omega
  have hc : Pairwise (fun i j : I => IsCoprime (g i) (g j)) := by
    intro i j hij
    apply (factor_irreducible f i).coprime_iff_not_dvd.mpr
    intro hd
    have he := Polynomial.eq_of_monic_of_associated (factor_monic f i) (factor_monic f j)
      (((factor_irreducible f i).dvd_irreducible_iff_associated (factor_irreducible f j)).mp hd)
    exact hij (Subtype.ext he)
  have hd : Module.finrank K V=∑ i,(g i).natDegree := by
    have hh := congrArg Polynomial.natDegree (factor_product f hm hs)
    rw [Polynomial.natDegree_prod_of_monic Finset.univ g (fun i _ => factor_monic f i)] at hh
    exact hdim.trans hh
  have he : OperatorsOf B f ≃ Mathproof.Problem18SquarefreeOperatorCount20260930.Operators g B :=
    Equiv.subtypeEquivRight (fun S => by rw [← factor_product f hm hs]; rfl)
  rw [Nat.card_congr he]
  exact charTwo_squarefree_operator_card g (factor_monic f) hc B hB hnB haB hd
abbrev GoodPolynomials (n : ℕ) :=
  {f : Mathproof.Problem18MonicDivisibilityBoundary20260930.MonicDegree (K:=K) n //
    Squarefree f.val ∧ f.val.coeff 0≠0}
abbrev GoodOperators (B : LinearMap.BilinForm K V) :=
  {S : Module.End K V // B.IsSelfAdjoint S ∧ Squarefree S.charpoly ∧ S.charpoly.coeff 0≠0}
theorem charTwo_operator_mass_lower [CharP K 2] (n : ℕ) (hn : 2≤n)
    (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hnB : B.Nondegenerate) (haB : ¬B.IsAlt)
    (hdim : Module.finrank K V=n) :
    (Nat.card K:ℝ)^n*
      Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y))/24 ≤
        Nat.card (GoodOperators B) := by
  classical
  let I := GoodPolynomials (K:=K) n
  let f : (Σ p : I,OperatorsOf B p.val.val) → GoodOperators B :=
    fun z => ⟨z.2.val,z.2.property.2,
      z.2.property.1.symm ▸ z.1.property.1,
      z.2.property.1.symm ▸ z.1.property.2⟩
  have hf : Function.Injective f := by
    rintro ⟨p,S⟩ ⟨q,T⟩ h
    have hST : S.val=T.val := congrArg Subtype.val h
    have hpq : p=q := by
      apply Subtype.ext
      apply Subtype.ext
      exact S.property.1.symm.trans ((congrArg (fun R : Module.End K V => R.charpoly) hST).trans T.property.1)
    subst q
    exact congrArg (Sigma.mk p) (Subtype.ext hST)
  have hh := Nat.card_le_card_of_injective f hf
  rw [Nat.card_sigma] at hh
  have hp (p : I) : Nat.card (OperatorsOf B p.val.val)=
      Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y)) :=
    charTwo_polynomial_operator_card p.val.val p.val.property.1 p.property.1
      (by rw [p.val.property.2]; omega) B hB hnB haB (hdim.trans p.val.property.2.symm)
  simp_rw [hp] at hh
  have hcount : Nat.card I*
      Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y)) ≤
        Nat.card (GoodOperators B) := by
    simpa only [Finset.sum_const,Finset.card_univ,smul_eq_mul,Nat.card_eq_fintype_card] using hh
  have hq : (0:ℝ)<Nat.card K := by exact_mod_cast Nat.card_pos (α:=K)
  have hpoly := (le_div_iff₀ (pow_pos hq n)).mp
    (Mathproof.Problem18SquarefreeDensityBoundary20260930.squarefree_nonzero_constant_density_ge (K:=K) n hn)
  have hmult := mul_le_mul_of_nonneg_right hpoly
    (show (0:ℝ)≤Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y)) by positivity)
  have hcountR : (Nat.card I:ℝ)*
      Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y)) ≤
        Nat.card (GoodOperators B) := by exact_mod_cast hcount
  change (1/24:ℝ)*(Nat.card K:ℝ)^n*
    Nat.card (Mathproof.Problem18PrimaryOperatorOrbit20260930.isometrySubgroup (fun x y => B x y)) ≤ _ at hmult
  nlinarith
end Mathproof.Problem18BoundaryOperatorDensity20260930
