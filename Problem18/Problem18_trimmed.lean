theorem eval_le_monomial (P : Polynomial ℕ) (x S : ℕ)
    (hS : 1 ≤ S) (hx : x ≤ 128*S^2) :
    P.eval x ≤ (P.eval 1 * 128^P.natDegree) * S^(2*P.natDegree) := by
  have hb : 1 ≤ 128*S^2 := by nlinarith [sq_nonneg (S : ℤ)]
  have h : P.eval x ≤ P.eval 1 * (128*S^2)^P.natDegree := by
    rw [Polynomial.eval_eq_sum_range, Polynomial.eval_eq_sum_range, Finset.sum_mul]
    apply Finset.sum_le_sum
    intro i hi
    simp only [one_pow, mul_one]
    apply Nat.mul_le_mul_left
    exact (Nat.pow_le_pow_left hx i).trans
      (pow_le_pow_right₀ hb (Nat.le_of_lt_succ (Finset.mem_range.mp hi)))
  calc
    _ ≤ P.eval 1 * (128*S^2)^P.natDegree := h
    _ = _ := by rw [mul_pow, ← pow_mul]; ring
end Mathproof.Problem18RootPolynomialRuntime20260930
