  le_trans h (Nat.mul_le_mul hc (Nat.pow_le_pow_right ht hk))
theorem spow {s t : Nat} (k : Nat) (h : s ≤ 3 * t) : s ^ k ≤ 3 ^ k * t ^ k := by
  have := Nat.pow_le_pow_left h k; rwa [mul_pow] at this
theorem word_facts {t e s : Nat} (ht : 1 ≤ t) (hs : s ≤ 3 * t) (he : e + 1 ≤ t) :
    2 * 10 ^ 20 * s ^ 20 * (e + 1) + 1 ≤ 10 ^ 40 * t ^ 40 ∧
    e + 1 + 2 * 10 ^ 20 * s ^ 20 * e ≤ 10 ^ 40 * t ^ 40 ∧
    16 * (e * s ^ 4) ≤ 10 ^ 40 * t ^ 40 ∧
    e * (100 * s ^ 8) ≤ 10 ^ 40 * t ^ 40 ∧
    16 * (e + 1) ≤ 10 ^ 40 * t ^ 40 := by
  have A20 := spow 20 hs
  have A4 := spow 4 hs
  have A8 := spow 8 hs
  have t21 : t ≤ t ^ 21 := Nat.le_self_pow (by norm_num) t
  have e1 : e ≤ t := by omega
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · apply to40 ht (c := 2 * 10 ^ 20 * 3 ^ 20 + 1) (k := 21) _ (by norm_num) (by norm_num)
    calc 2 * 10 ^ 20 * s ^ 20 * (e + 1) + 1
        ≤ 2 * 10 ^ 20 * (3 ^ 20 * t ^ 20) * t + t :=
          Nat.add_le_add (Nat.mul_le_mul (Nat.mul_le_mul_left _ A20) he) ht
      _ ≤ 2 * 10 ^ 20 * (3 ^ 20 * t ^ 20) * t + t ^ 21 := Nat.add_le_add_left t21 _
      _ = (2 * 10 ^ 20 * 3 ^ 20 + 1) * t ^ 21 := by ring
  · apply to40 ht (c := 2 * 10 ^ 20 * 3 ^ 20 + 1) (k := 21) _ (by norm_num) (by norm_num)
    calc e + 1 + 2 * 10 ^ 20 * s ^ 20 * e
        ≤ t + 2 * 10 ^ 20 * (3 ^ 20 * t ^ 20) * t :=
          Nat.add_le_add he (Nat.mul_le_mul (Nat.mul_le_mul_left _ A20) e1)
      _ ≤ t ^ 21 + 2 * 10 ^ 20 * (3 ^ 20 * t ^ 20) * t := Nat.add_le_add_right t21 _
      _ = (2 * 10 ^ 20 * 3 ^ 20 + 1) * t ^ 21 := by ring
  · apply to40 ht (c := 16 * 3 ^ 4) (k := 5) _ (by norm_num) (by norm_num)
    calc 16 * (e * s ^ 4) ≤ 16 * (t * (3 ^ 4 * t ^ 4)) :=
          Nat.mul_le_mul_left _ (Nat.mul_le_mul e1 A4)
      _ = 16 * 3 ^ 4 * t ^ 5 := by ring
  · apply to40 ht (c := 100 * 3 ^ 8) (k := 9) _ (by norm_num) (by norm_num)
    calc e * (100 * s ^ 8) ≤ t * (100 * (3 ^ 8 * t ^ 8)) :=
          Nat.mul_le_mul e1 (Nat.mul_le_mul_left _ A8)
      _ = 100 * 3 ^ 8 * t ^ 9 := by ring
  · apply to40 ht (c := 16) (k := 1) _ (by norm_num) (by norm_num)
    calc 16 * (e + 1) ≤ 16 * t := Nat.mul_le_mul_left _ he
      _ = 16 * t ^ 1 := by ring
theorem cost_side {n a0 b0 c0 a b c e ps qs Sn : Nat} (ha0 : a0 ≤ n) (hb0 : b0 ≤ n) (hc0 : c0 ≤ n)
    (hsum : a + b + c = a0 + b0 + c0) (he : e ≤ n) (hp : ps + 1 ≤ n) (hq : qs + 1 ≤ n)
    (hS : Sn ≤ 1000000000000000000000000000000 * (n + 1) ^ 20) :
    let X := 10 ^ 30 * (n + 1) ^ 20
    1 ≤ X ∧ a0 ≤ X ∧ b0 ≤ X ∧ c0 ≤ X ∧ a ≤ X ∧ b ≤ X ∧ c ≤ X ∧ b * b ≤ X ∧ e ≤ X ∧
      ps ≤ X ∧ qs ≤ X ∧ Sn ≤ X := by
  intro X
  have hX : X = 1000000000000000000000000000000 * (n + 1) ^ 20 := by norm_num [X]
  have hn20 : n + 1 ≤ (n + 1) ^ 20 := Nat.le_self_pow (by norm_num) _
  have hn2 : (n + 1) ^ 2 ≤ (n + 1) ^ 20 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have hb3 : b ≤ 3 * n := by omega
  have hbb : b * b ≤ 9 * (n + 1) ^ 2 := by
    have := Nat.mul_le_mul hb3 hb3
    have h : 3 * n * (3 * n) ≤ 9 * (n + 1) ^ 2 := by nlinarith
    omega
  rw [hX]
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, hS⟩ <;> omega
theorem sn_bound {n s : Nat} (hs : s ≤ 3 * (n + 1)) :
    200000000000000000000 * s ^ 20 ≤ 1000000000000000000000000000000 * (n + 1) ^ 20 := by
  have h := spow 20 hs
  have h3 : (3 : Nat) ^ 20 = 3486784401 := by norm_num
  rw [h3] at h
  have := Nat.mul_le_mul_left 200000000000000000000 h
  omega
theorem caps {a b c e s : Nat} (ha : a ≤ s) (hb : b ≤ s) (hc : c ≤ s) (hs : 1 ≤ s) :
    Mathproof.Problem18PairLargeMidUndo20261004.undoWords a b c ≤ 100 * s ^ 8 ∧
    Mathproof.Problem18PairLargeMidUndo20261004.undoSlots a b c ≤ 100 * s ^ 8 ∧
    Mathproof.Problem18PairLargeMidKronH20261004.kronHWords a b c ≤ 100 * s ^ 8 ∧
    Mathproof.Problem18PairLargeMidKronH20261004.kronHSlots a b c ≤ 100 * s ^ 8 ∧
    Mathproof.Problem18PairLargeFinalProgram20261004.finalSlots a b c ≤ 10000 * s ^ 8 ∧
    Mathproof.Problem18PairLargeFinalProgram20261004.finalWords a b c ≤ 100 * s ^ 8 ∧
    2 * (b * b * (a * a)) + 1 ≤ 100 * s ^ 8 ∧ a * a ≤ s ^ 4 ∧ 1 ≤ s ^ 8 := by
  have p1 : s ≤ s ^ 8 := Nat.le_self_pow (by norm_num) _
  have p2 : s ^ 2 ≤ s ^ 8 := Nat.pow_le_pow_right hs (by norm_num)
  have p3 : s ^ 3 ≤ s ^ 8 := Nat.pow_le_pow_right hs (by norm_num)
  have p4 : s ^ 4 ≤ s ^ 8 := Nat.pow_le_pow_right hs (by norm_num)
  have p6 : s ^ 6 ≤ s ^ 8 := Nat.pow_le_pow_right hs (by norm_num)
  have q2 : ∀ x y, x ≤ s → y ≤ s → x * y ≤ s ^ 2 := fun x y hx hy => by
    have := Nat.mul_le_mul hx hy; rw [pow_two]; exact this
  have bb := q2 b b hb hb
  have aa := q2 a a ha ha
  have ab := q2 a b ha hb
  have cab : c * a * b ≤ s ^ 3 := by
    have := Nat.mul_le_mul (q2 c a hc ha) hb; rw [pow_succ]; exact this
  have cab' : c * (a * b) ≤ s ^ 3 := by rw [← Nat.mul_assoc]; exact cab
  have abab : a * b * (a * b) ≤ s ^ 4 := by
    have := Nat.mul_le_mul ab ab; rw [← pow_add] at this; exact this
  have bbaa : b * b * (a * a) ≤ s ^ 4 := by
    have := Nat.mul_le_mul bb aa; rw [← pow_add] at this; exact this
  have aa4 : a * a ≤ s ^ 4 := le_trans aa (Nat.pow_le_pow_right hs (by norm_num))
  have s1 : 1 ≤ s ^ 8 := Nat.one_le_pow _ _ hs
  have fs : a * b + c + 4 ≤ 6 * s ^ 2 := by
    have : s ≤ s ^ 2 := Nat.le_self_pow (by norm_num) _
    have : 1 ≤ s ^ 2 := Nat.one_le_pow _ _ hs
    omega
  have fs3 : (a * b + c + 4) ^ 3 ≤ 216 * s ^ 6 := by
    have := Nat.pow_le_pow_left fs 3
    rw [mul_pow, ← pow_mul] at this; norm_num at this; exact this
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, aa4, s1⟩
  · simp only [Mathproof.Problem18PairLargeMidUndo20261004.undoWords]; omega
  · simp only [Mathproof.Problem18PairLargeMidUndo20261004.undoSlots]; omega
  · simp only [Mathproof.Problem18PairLargeMidKronH20261004.kronHWords]; omega
  · simp only [Mathproof.Problem18PairLargeMidKronH20261004.kronHSlots]; omega
  · simp only [Mathproof.Problem18PairLargeFinalProgram20261004.finalSlots]; omega
  · simp only [Mathproof.Problem18PairLargeFinalProgram20261004.finalWords]
    have : c * (a * b + 1) = c * (a * b) + c := by ring
    omega
  · omega
theorem pair_run (B : Nat) (x : Query)
    (hbr : Problem18EncodedSourceCheck20261001.branch B x.a x.b x.c = 3)
    (hacc : accepted B x = true) :
    ∃ (ext : String → Nat) (σ : Env),
      Run (2 ^ (pairWordPoly.eval (bitSize (words x)) + bitSize (words x) + 1)) pairProgram
        (initEnv ext ((words x).length :: words x)) σ (pairTimePoly.eval (bitSize (words x))) ∧
      σ.out = Mathproof.Problem18RAMAnswerCodec20261001.answerWords (pairAnswer x) := by
  classical
  have hsem := Mathproof.Problem18PairLargeSemantic20261004.pairAnswer_eq_sorted x hbr hacc
  have hgood := Mathproof.Problem18PairLargeSemantic20261004.accepted_rawGood x hbr hacc
  obtain ⟨fd, u, q, a0, b0, c0, hv, ha0, hb0, hc0, A, T⟩ := x
  simp only at hsem hgood hbr ⊢
  set F := fd.presentation with hF
  set wds := words ⟨fd, u, q, a0, b0, c0, hv, ha0, hb0, hc0, A, T⟩ with hwds
  have hwq : wds = queryWords F u q A T := rfl
  set n := bitSize wds with hn
  obtain ⟨hen, han, hbn, hcn, habcn, hpn, hqn, -⟩ :=
    queryWords_bounds F u q A T ha0 hb0 hc0
  rw [← hwq, ← hn] at hen han hbn hcn habcn hpn hqn
  set W := 2 ^ (pairWordPoly.eval n + n + 1) with hW
  have he := F.degree_pos
  have hS1t : S1 a0 b0 c0 ≤ 3 * (n + 1) := by simp only [S1]; omega
  obtain ⟨w1, w2, w3, w4, w5⟩ := word_facts (t := n + 1) (e := F.e) (by omega) hS1t (by omega)
  have hsetW : 2 * 10 ^ 20 * S1 a0 b0 c0 ^ 20 * (F.e + 1) + 1 < W := lt_word w1
  have hmemW : F.e + 1 + snOf a0 b0 c0 * F.e < W := lt_word (by simp only [snOf]; exact w2)
  have hbankW : bankLenOf F.e a0 b0 c0 < W := lt_word (by
    simp only [bankLenOf, cwOf]; exact w3)
  have hworkW : workLenOf F.e a0 b0 c0 < W := lt_word (by simp only [workLenOf]; exact w4)
  have hscrW : 16 * (F.e + 1) < W := lt_word w5
  have hgW : 2 * (a0 * b0 * c0 * F.e) < W := lt_word (by
    have : n + 1 ≤ (n + 1) ^ 40 := Nat.le_self_pow (by norm_num) _
    have : (n + 1) ^ 40 ≤ 10 ^ 40 * (n + 1) ^ 40 := Nat.le_mul_of_pos_left _ (by positivity)
    omega)
  obtain ⟨hpe, hp2⟩ := modulus_lt_word F hpn hen
  have hqW : q + 1 < W := by
    have h := Mathproof.Problem18P36BoundarySourceRun20261004.prime_power_fits (p := q) (e := 1)
      (N := n) (by omega) (by omega)
    rw [← pairWordPoly_eval_eq] at h
    have : q + 1 ≤ (q + 1) ^ (1 + 1) := Nat.le_self_pow (by norm_num) _
    omega
  obtain ⟨σ1, hr1, hI1, hAs1, hTs1, hin1, hout1⟩ :=
    phaseA1_run F u q A T ha0 hb0 hc0 hsetW hmemW hbankW hscrW hgW hp2 hpe hqW hworkW
  have hpos := shape_positive (sortOrder a0 b0 c0) ha0 hb0 hc0
  have hsrt := sorted_shape a0 b0 c0
  have hsum := Mathproof.Problem18P36LargeSourceRun20261004.shape_sum (sortOrder a0 b0 c0) a0 b0 c0
  have hprod := Mathproof.Problem18P36LargeSourceRun20261004.shape_prod (sortOrder a0 b0 c0) a0 b0 c0
  obtain ⟨L1, L2, L3, L4, L5, L6, L7, L8, L9, L10, L11, L12, L13, L14, L15⟩ :=
    Mathproof.Problem18PairLargeLayout20261004.layout_facts (e := F.e)
      (s := S1 a0 b0 c0) hpos.1 hsrt.1 hsrt.2 (by simp only [S1]; omega) he
  have hP4 : S1 a0 b0 c0 ^ 4 ≤ S1 a0 b0 c0 ^ 20 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have hP6 : S1 a0 b0 c0 ^ 6 ≤ S1 a0 b0 c0 ^ 20 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have hP1 : 1 ≤ S1 a0 b0 c0 ^ 20 := Nat.one_le_pow _ _ (by omega)
  have hP8 : S1 a0 b0 c0 ^ 8 ≤ S1 a0 b0 c0 ^ 20 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have hsn : snOf a0 b0 c0 = 200000000000000000000 * S1 a0 b0 c0 ^ 20 := by
    simp only [snOf]; norm_num
  have hfr : freeOf a0 b0 c0 = 100000000000000000000 * S1 a0 b0 c0 ^ 20 := by
    simp only [freeOf]; norm_num
  have hcwd : cwOf F.e a0 b0 c0 = F.e * S1 a0 b0 c0 ^ 4 := rfl
  have hsbd : sbOf a0 b0 c0 = 5 + S1 a0 b0 c0 ^ 6 := rfl
  have htbd : tbOf a0 b0 c0 = 5 + S1 a0 b0 c0 ^ 6 + S1 a0 b0 c0 ^ 4 := rfl
  have hSnW : snOf a0 b0 c0 < W := by
    have : snOf a0 b0 c0 ≤ snOf a0 b0 c0 * F.e := Nat.le_mul_of_pos_right _ he
    omega
  have hqW' : q < W := by omega
  have hgl : (shape (sortOrder a0 b0 c0) a0 b0 c0).1 * (shape (sortOrder a0 b0 c0) a0 b0 c0).2.1 *
      (shape (sortOrder a0 b0 c0) a0 b0 c0).2.2 * F.e ≤ 2 * (a0 * b0 * c0 * F.e) := by
    rw [hprod]; omega
  obtain ⟨σ2, hr2, hI2, hAs2, hTs2, hV4, hV5, hS2, hws2, hdec2, hiN2, hiM2, -, hin2, hout2⟩ :=
    phaseA2_run F _ _ hI1 hAs1 hTs1 hpos.1 hsrt.1 hsrt.2 (by rw [hcwd]; exact L1)
      (by rw [hcwd]; exact L2) (le_of_eq rfl) hgl (by rw [hfr]; exact L6)
      (by rw [hfr, hsn]; omega) hSnW hqW' (by rw [hsbd]; omega) (by rw [hsbd, htbd]; omega)
      (by rw [htbd, hsn]; omega) (by rw [hsbd]; omega) (by rw [hsn]; omega)
  have hcs := cost_side (Sn := snOf a0 b0 c0) (a := (shape (sortOrder a0 b0 c0) a0 b0 c0).1)
    (b := (shape (sortOrder a0 b0 c0) a0 b0 c0).2.1) (c := (shape (sortOrder a0 b0 c0) a0 b0 c0).2.2)
    han hbn hcn hsum hen hpn hqn (by rw [hsn]; exact sn_bound hS1t)
  have hcostTot := Mathproof.Problem18PairLargeTotalCost20261004.total_le F
    (X := 10 ^ 30 * (n + 1) ^ 20)
    (Sn := snOf a0 b0 c0) (a0 := a0) (b0 := b0) (c0 := c0)
    (a := (shape (sortOrder a0 b0 c0) a0 b0 c0).1) (b := (shape (sortOrder a0 b0 c0) a0 b0 c0).2.1)
    (c := (shape (sortOrder a0 b0 c0) a0 b0 c0).2.2) (q := q) u
    hcs.1 hcs.2.1 hcs.2.2.1 hcs.2.2.2.1 hcs.2.2.2.2.1 hcs.2.2.2.2.2.1 hcs.2.2.2.2.2.2.1
    hcs.2.2.2.2.2.2.2.1 hcs.2.2.2.2.2.2.2.2.1 hcs.2.2.2.2.2.2.2.2.2.1 hcs.2.2.2.2.2.2.2.2.2.2.1
    hcs.2.2.2.2.2.2.2.2.2.2.2 hcs.2.2.2.2.2.2.2.2.2.2.2
  have htime : 10 ^ 90 * (10 ^ 30 * (n + 1) ^ 20) ^ 80 ≤ pairTimePoly.eval n := by
    rw [pairTimePoly_eval, mul_pow, ← pow_mul, ← mul_assoc, ← pow_mul, ← pow_add]
  have hTot := le_trans hcostTot htime
  have hcond : ∀ σ : Env, σ.vars kflag < W →
      (Cond.eq (.var kflag) (.lit 0)).evalB W σ = some (σ.vars kflag == 0) :=
    fun σ h => evalB_condEq (evalB_var h) (evalB_lit (by omega))
  have hW2 : 2 ≤ W := by
    have : 1 ≤ pairWordPoly.eval n + n + 1 := by omega
    calc 2 = 2 ^ 1 := rfl
      _ ≤ W := Nat.pow_le_pow_right (by norm_num) this
  obtain ⟨cU, cUs, cKw, cKs, cFs, cFw, cSw, caa, c1⟩ :=
    caps (a := (shape (sortOrder a0 b0 c0) a0 b0 c0).1) (b := (shape (sortOrder a0 b0 c0) a0 b0 c0).2.1) (c := (shape (sortOrder a0 b0 c0) a0 b0 c0).2.2) (e := F.e) (s := S1 a0 b0 c0)
      (by simp only [S1]; omega) (by simp only [S1]; omega) (by simp only [S1]; omega) (by omega)
  have hbits := phases_bit
  have hf1 : σ1.vars kflag ≤ 1 :=
    Mathproof.Problem18PairLargeFlag20261004.run_bit hr1 hbits.1 (by simp [initEnv])
  have hf2 : σ2.vars kflag ≤ 1 := Mathproof.Problem18PairLargeFlag20261004.run_bit hr2 hbits.2.1 hf1
  have hans : Mathproof.Problem18RAMAnswerCodec20261001.answerWords
      (pairAnswer ⟨fd, u, q, a0, b0, c0, hv, ha0, hb0, hc0, A, T⟩) =
      [if rawLargeCheck hpos.1 hpos.2.1 u F.p q (tensorEquiv (sortOrder a0 b0 c0) A)
        (tensorEquiv (sortOrder a0 b0 c0) T) then 1 else 0] := by
    rw [hsem, answerWords_bit]
    congr 2
  rw [hans, Mathproof.Problem18PairLargeFinalMath20261004.rawLargeCheck_eq_final]
  have hcwd' : ∀ k, F.e * k ≤ F.e * S1 a0 b0 c0 ^ 4 → F.e * k ≤ cwOf F.e a0 b0 c0 :=
    fun k h => by rw [hcwd]; exact h
  rcases h1 : intertwiner (rawFirst u q (tensorEquiv (sortOrder a0 b0 c0) A))
      (rawFirst u q (tensorEquiv (sortOrder a0 b0 c0) T)) with _ | X
  ·
    rw [h1] at hdec2
    have hfl : σ2.vars kflag ≠ 0 :=
      (decoded_none_iff F).mp (Option.map_eq_none_iff.mp hdec2)
    have hf : σ2.vars kflag = 1 := by omega
    have hc : (Cond.eq (.var kflag) (.lit 0)).evalB W σ2 = some false := by
      rw [hcond σ2 (by omega), hf]; rfl
    refine ⟨extOf F.e a0 b0 c0, { σ2 with out := σ2.out ++ [0] }, ?_, ?_⟩
    · have hw : Run W (.write (.lit 0)) σ2 { σ2 with out := σ2.out ++ [0] } 2 :=
        Run.write (evalB_lit (by omega))
      have hall := hr1.seq (hr2.seq (Run.ite_false (c := .seq phaseB (.ite (.eq (.var kflag) (.lit 0)) phaseC (.write (.lit 0)))) hc hw))
      apply hall.mono
      have := hTot
      simp only [Cond.size, Expr.size] at this ⊢
      omega
    · show σ2.out ++ [0] = _
      rw [hout2, hout1]; rfl
  ·
    rw [h1] at hdec2
    obtain ⟨hf0, -⟩ := decoded_values F hdec2
    have hc : (Cond.eq (.var kflag) (.lit 0)).evalB W σ2 = some true := by
      rw [hcond σ2 (by omega), hf0]; rfl
    obtain ⟨hgram, hd⟩ := Mathproof.Problem18PairLargeSemantic20261004.first_gram hpos.2.1 u q hv
      _ _ hgood X h1
    obtain ⟨σ3, hr3, hI3, hAs3, hTs3, hX3, hdx3, hS3, hws3, hdec3, hiN3, hiM3, hin3, hout3⟩ :=
      phaseB_run F _ _ X hI2 hAs2 hTs2 hS2 hws2 hdec2 hiN2 hiM2 hpos.1 hsrt.1 hsrt.2 hpos.2.1
        hgram hd (by rw [hcwd]; exact L1) (hcwd' _ L3) (hcwd' _ L4) (le_of_eq rfl) hgl
        (by rw [hsn]; have h := L6; rw [show (10:ℕ) ^ 20 = 100000000000000000000 by norm_num] at h; omega) hSnW hqW (by rw [hsn]; omega)
        (by simp only [workLenOf]; exact Nat.mul_le_mul_left _ cU) (by rw [hsn]; omega)
        (by simp only [workLenOf]; exact Nat.mul_le_mul_left _ cSw) (by rw [hsn]; omega)
        (by rw [hsbd]; omega) (by rw [hsbd, htbd]; omega) (by rw [htbd, hsn]; omega)
        (by rw [hsbd]; omega) (by rw [hsn]; omega)
    have hf3 : σ3.vars kflag ≤ 1 :=
      Mathproof.Problem18PairLargeFlag20261004.run_bit hr3 hbits.2.2 (by omega)
    simp only
    rcases Option.eq_none_or_eq_some (intertwiner (rawSecondIndexed u q (tensorEquiv (sortOrder a0 b0 c0) A))
        (fun t => rawGram hpos.2.1 u q X • rawSecondIndexed u q
          (Problem18TwoIntertwinerRecovery20261001.undoFirst
            (tensorEquiv (sortOrder a0 b0 c0) T) X) t)) with h2 | ⟨Y, h2⟩
    · rw [h2] at hdec3
      simp only [h2]
      have hfl : σ3.vars kflag ≠ 0 :=
        (decoded_none_iff F).mp (Option.map_eq_none_iff.mp hdec3)
      have hf : σ3.vars kflag = 1 := by omega
      have hc3 : (Cond.eq (.var kflag) (.lit 0)).evalB W σ3 = some false := by
        rw [hcond σ3 (by omega), hf]; rfl
      refine ⟨extOf F.e a0 b0 c0, { σ3 with out := σ3.out ++ [0] }, ?_, ?_⟩
      · have hw : Run W (.write (.lit 0)) σ3 { σ3 with out := σ3.out ++ [0] } 2 :=
          Run.write (evalB_lit (by omega))
        have hall := hr1.seq (hr2.seq (Run.ite_true (d := .write (.lit 0)) hc (hr3.seq (Run.ite_false (c := phaseC) hc3 hw))))
        apply hall.mono
        have := hTot
        simp only [Cond.size, Expr.size] at this ⊢
        omega
      · show σ3.out ++ [0] = _
        rw [hout3, hout2, hout1]; rfl
    · rw [h2] at hdec3
      simp only [h2]
      obtain ⟨hf30, -⟩ := decoded_values F hdec3
      have hc3 : (Cond.eq (.var kflag) (.lit 0)).evalB W σ3 = some true := by
        rw [hcond σ3 (by omega), hf30]; rfl
      obtain ⟨σ4, hr4, hout4, hin4⟩ := phaseC_run F _ _ X Y hpos.1 hpos.2.1 hI3 hAs3 hTs3 hX3 hdx3
        hS3 hws3 hdec3 hiN3 hiM3 hpos.2.2 (by rw [hcwd]; exact L1) (hcwd' _ L4)
        (hcwd' _ (Nat.mul_le_mul_left _ caa)) (le_of_eq rfl) hqW (by rw [hsn]; omega)
        (by simp only [workLenOf]; exact Nat.mul_le_mul_left _ cKw) (by rw [hsn]; omega)
        (by rw [hsn]; omega) (by simp only [workLenOf]; exact Nat.mul_le_mul_left _ cFw)
      refine ⟨extOf F.e a0 b0 c0, σ4, ?_, ?_⟩
      · have hall := hr1.seq (hr2.seq (Run.ite_true (d := .write (.lit 0)) hc (hr3.seq (Run.ite_true (d := .write (.lit 0)) hc3 hr4))))
        apply hall.mono
        have := hTot
        simp only [Cond.size, Expr.size] at this ⊢
        omega
      · rw [hout4, hout3, hout2, hout1]; rfl
def large : ∀ B : Nat, 8 ≤ B → PairProgram B 3 := fun B _ =>
  { program := pairProgram
    wordPolynomial := pairWordPoly
    timePolynomial := pairTimePoly
    run := fun x hb ha => pair_run B x hb ha }
end
