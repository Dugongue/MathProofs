  obtain ⟨F₀, hF₀⟩ : ∃ F₀ : IntermediateField k Ω,
      ∀ a : Ω, a ∈ F₀ ↔ IsAlgebraic (IntermediateField.adjoin k ({x, y} : Set Ω)) a :=
    ⟨(algebraicClosure (IntermediateField.adjoin k ({x, y} : Set Ω)) Ω).restrictScalars k,
      fun a => by rw [IntermediateField.mem_restrictScalars, mem_algebraicClosure_iff]⟩
  have hF₀cl : ∀ b : Ω, b ∈ F₀ ↔ b ∈ (AlgebraicIndependent.matroid k Ω).closure {x, y} :=
    fun b => (hF₀ b).trans (mem_matroid_closure_iff _ b).symm
  have hK₀F : IntermediateField.adjoin k ({x, y} : Set Ω) ≤ F := by
    rw [IntermediateField.adjoin_le_iff]
    intro a ha
    rcases ha with rfl | rfl
    · exact hx
    · exact hy
  have hF₀F : F₀ ≤ F := fun a ha => hF a (isAlgebraic_of_le hK₀F ((hF₀ a).mp ha))
  have hxF₀ : x ∈ F₀ := (hF₀ x).mpr (isAlgebraic_algebraMap
    (⟨x, sub (Set.mem_insert _ _)⟩ : IntermediateField.adjoin k ({x, y} : Set Ω)))
  have hyF₀ : y ∈ F₀ := (hF₀ y).mpr (isAlgebraic_algebraMap
    (⟨y, sub (Set.mem_insert_of_mem _ rfl)⟩ : IntermediateField.adjoin k ({x, y} : Set Ω)))
  have huT : Transcendental F₀ u := fun h => hu (isAlgebraic_of_le hF₀F h)
  have hvT : Transcendental F₀ v := fun h => hvF (isAlgebraic_of_le hF₀F h)
  haveI : Infinite F₀ := Infinite.of_injective (algebraMap k F₀) (algebraMap k F₀).injective
  have hE₀ : IntermediateField.adjoin k ({u, x + u * y} : Set Ω) ≤
      IntermediateField.adjoin k ((F₀ : Set Ω) ∪ {u}) := by
    rw [IntermediateField.adjoin_le_iff]
    intro a ha
    rcases ha with rfl | rfl
    · exact sub (Set.mem_union_right _ rfl)
    · exact add_mem (sub (Set.mem_union_left _ hxF₀))
        (mul_mem (sub (Set.mem_union_right _ rfl)) (sub (Set.mem_union_left _ hyF₀)))
  have hA : ∀ a ∈ F, IsAlgebraic F₀ a → a ∈ F₀ := by
    intro a _ halga
    have h1 : a ∈ (AlgebraicIndependent.matroid k Ω).closure (F₀ : Set Ω) := by
      rw [mem_matroid_closure_iff, IntermediateField.adjoin_self]
      exact halga
    exact (hF₀cl a).mpr (closure_le_of_subset (fun b hb => (hF₀cl b).mp hb) h1)
  have hz0 : z ∈ IntermediateField.adjoin k ((F₀ : Set Ω) ∪ {u}) :=
    mem_adjoin_union_of_isAlgebraic F₀ F hF₀F hA hu (mem_union_of_mem_adjoin hz)
      (isAlgebraic_of_le hE₀ halgz)
  obtain ⟨r, q, hzrq⟩ := (IntermediateField.mem_adjoin_simple_iff F₀ z).mp
    (mem_adjoin_of_mem_union hz0)
  by_cases hq0 : Polynomial.aeval u q = 0
  · rw [hzrq, hq0, div_zero]
    exact zero_mem _
  have hq : q ≠ 0 := fun h => hq0 (by rw [h, map_zero])
  obtain ⟨w, hwdef⟩ : ∃ w : Ω, w = Polynomial.aeval v r / Polynomial.aeval v q := ⟨_, rfl⟩
  have hcomp : (algebraMap F Ω).comp (IntermediateField.inclusion hF₀F : F₀ →+* F) =
      algebraMap F₀ Ω := RingHom.ext fun _ => rfl
  have hmapF : ∀ (a : Ω) (p : Polynomial F₀),
      Polynomial.aeval a (p.map (IntermediateField.inclusion hF₀F : F₀ →+* F)) =
        Polynomial.aeval a p := by
    intro a p
    rw [Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.eval₂_map, hcomp]
  obtain ⟨zU, hzUz⟩ : ∃ zU : IntermediateField.adjoin F ({u} : Set Ω), (zU : Ω) = z :=
    ⟨⟨z, hz⟩, rfl⟩
  have hcoe : ∀ p : Polynomial F,
      ((Polynomial.aeval (IntermediateField.AdjoinSimple.gen F u) p :
        IntermediateField.adjoin F ({u} : Set Ω)) : Ω) = Polynomial.aeval u p := fun p =>
    (Polynomial.aeval_algHom_apply (IntermediateField.adjoin F ({u} : Set Ω)).val
      (IntermediateField.AdjoinSimple.gen F u) p).symm
  have hzU : zU = Polynomial.aeval (IntermediateField.AdjoinSimple.gen F u)
        (r.map (IntermediateField.inclusion hF₀F : F₀ →+* F)) /
      Polynomial.aeval (IntermediateField.AdjoinSimple.gen F u)
        (q.map (IntermediateField.inclusion hF₀F : F₀ →+* F)) := by
    apply Subtype.ext
    rw [hzUz, IntermediateField.coe_div, hcoe, hcoe, hmapF, hmapF]
    exact hzrq
  have halgU : IsAlgebraic (IntermediateField.adjoin k ({u, x + u * y} : Set Ω)) (zU : Ω) := by
    rw [hzUz]
    exact halgz
  have hsepU : IsSeparable (IntermediateField.adjoin k ({u, x + u * y} : Set Ω)) (zU : Ω) := by
    rw [hzUz]
    exact hsep
  have hσz : sigma F hu hvF zU = w := by
    rw [hzU, map_div₀, sigma_aeval, sigma_aeval, hmapF, hmapF, hwdef]
  have hEU : ∀ c ∈ IntermediateField.adjoin k ({u, x + u * y} : Set Ω),
      c ∈ IntermediateField.adjoin F ({u} : Set Ω) := by
    intro c hc
    have hle : IntermediateField.adjoin k ({u, x + u * y} : Set Ω) ≤
        (IntermediateField.adjoin F ({u} : Set Ω)).restrictScalars k := by
      rw [IntermediateField.adjoin_le_iff]
      intro a ha
      have huU : u ∈ IntermediateField.adjoin F ({u} : Set Ω) :=
        IntermediateField.mem_adjoin_simple_self F u
      have hFU : ∀ b ∈ F, b ∈ IntermediateField.adjoin F ({u} : Set Ω) := fun b hb =>
        IntermediateField.algebraMap_mem (IntermediateField.adjoin F ({u} : Set Ω)) ⟨b, hb⟩
      rcases ha with rfl | rfl
      · exact huU
      · exact add_mem (hFU x hx) (mul_mem huU (hFU y hy))
    exact hle hc
  have htrans := sigma_transfer F hu hvF hx hy hEU zU
  have hwalg : IsAlgebraic (IntermediateField.adjoin k ({v, x + v * y} : Set Ω)) w :=
    by rw [← hσz]; exact htrans.1 halgU
  have hwsep : IsSeparable (IntermediateField.adjoin k ({v, x + v * y} : Set Ω)) w :=
    by rw [← hσz]; exact htrans.2 hsepU
  obtain ⟨P, hP⟩ : ∃ P : IntermediateField k Ω,
      P = IntermediateField.adjoin k ({x, y, u, v} : Set Ω) := ⟨_, rfl⟩
  have hxP : x ∈ P := by rw [hP]; exact sub (Set.mem_insert _ _)
  have hyP : y ∈ P := by rw [hP]; exact sub (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
  have huP : u ∈ P := by
    rw [hP]; exact sub (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))
  have hvP : v ∈ P := by
    rw [hP]
    exact sub (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl)))
  have hK₀P : IntermediateField.adjoin k ({x, y} : Set Ω) ≤ P := by
    rw [IntermediateField.adjoin_le_iff]
    intro a ha
    rcases ha with rfl | rfl
    · exact hxP
    · exact hyP
  have hEP : IntermediateField.adjoin k ({u, x + u * y} : Set Ω) ≤ P := by
    rw [IntermediateField.adjoin_le_iff]
    intro a ha
    rcases ha with rfl | rfl
    · exact huP
    · exact add_mem hxP (mul_mem huP hyP)
  have hE'P : IntermediateField.adjoin k ({v, x + v * y} : Set Ω) ≤ P := by
    rw [IntermediateField.adjoin_le_iff]
    intro a ha
    rcases ha with rfl | rfl
    · exact hvP
    · exact add_mem hxP (mul_mem hvP hyP)
  have hF₀L : ∀ a ∈ F₀, a ∈ algebraicClosure P Ω := fun a ha =>
    mem_algebraicClosure_iff.mpr (isAlgebraic_of_le hK₀P ((hF₀ a).mp ha))
  have hwPz : w ∈ IntermediateField.adjoin P ({z} : Set Ω) :=
    mem_adjoin_of_forall_fixes (isSeparable_of_le hEP hsep) (isSeparable_of_le hE'P hwsep)
      (fun g z' w' hz' hw' hg =>
        fixes_twin hK₀P hF₀ hF₀L huP hvP huT hvT r q hq g z' w' (hz'.trans hzrq)
          (hw'.trans hwdef) hg)
  obtain ⟨M, hMdef⟩ : ∃ M : IntermediateField k Ω, M = IntermediateField.adjoin k
      (((IntermediateField.adjoin k ({u, x + u * y} : Set Ω) : IntermediateField k Ω) :
        Set Ω) ∪ {z}) := ⟨_, rfl⟩
  have hEM : ∀ c ∈ IntermediateField.adjoin k ({u, x + u * y} : Set Ω), c ∈ M :=
    fun c hc => by rw [hMdef]; exact sub (Set.mem_union_left _ hc)
  have hzM : z ∈ M := by rw [hMdef]; exact sub (Set.mem_union_right _ rfl)
  have huM : u ∈ M := hEM u (sub (Set.mem_insert _ _))
  have htM : x + u * y ∈ M := hEM _ (sub (Set.mem_insert_of_mem _ rfl))
  have hMcl : ∀ m ∈ M, m ∈ (AlgebraicIndependent.matroid k Ω).closure {u, x + u * y} := by
    intro m hm
    rw [hMdef] at hm
    refine closure_le_of_subset ?_ (mem_closure_of_mem_adjoin hm)
    intro b hb
    rcases hb with hb | hb
    · exact mem_closure_of_mem_adjoin hb
    · rw [Set.mem_singleton_iff.mp hb]
      exact (mem_matroid_closure_iff _ z).mpr halgz
  have hvM : Transcendental M v := by
    intro halgv
    have h1 : v ∈ (AlgebraicIndependent.matroid k Ω).closure (M : Set Ω) := by
      rw [mem_matroid_closure_iff, IntermediateField.adjoin_self]
      exact halgv
    have h2 : v ∈ (AlgebraicIndependent.matroid k Ω).closure {u, x + u * y} :=
      closure_le_of_subset hMcl h1
    have hsub : ({u, x + u * y} : Set Ω) ⊆
        (AlgebraicIndependent.matroid k Ω).closure {u, x, y} := by
      intro b hb
      rcases hb with rfl | rfl
      · exact subset_matroid_closure _ (Set.mem_insert _ _)
      · refine mem_closure_of_mem_adjoin (add_mem (sub ?_) (mul_mem (sub ?_) (sub ?_)))
        · exact Set.mem_insert_of_mem _ (Set.mem_insert _ _)
        · exact Set.mem_insert _ _
        · exact Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl)
    have h3' : v ∈ (AlgebraicIndependent.matroid k Ω).closure {u, x, y} :=
      closure_le_of_subset hsub h2
    refine false_of_subset_closure (X := ({u, x, y} : Set Ω)) h4 ?_ ?_
    · rw [hcard]
      exact lt_of_le_of_lt (encard_triple_le _ _ _) (by norm_num)
    · intro a ha
      rcases ha with ha | ha
      · rw [ha]
        exact h3'
      · exact subset_matroid_closure _ ha
  have hsT := transcendental_s h4 hcard M hMcl hu0 huv
  haveI : Infinite (IntermediateField.adjoin k ({v} : Set Ω)) :=
    Infinite.of_injective (algebraMap k (IntermediateField.adjoin k ({v} : Set Ω)))
      (algebraMap k (IntermediateField.adjoin k ({v} : Set Ω))).injective
  have hle1 : IntermediateField.adjoin k ({v} : Set Ω) ≤
      IntermediateField.adjoin k ((M : Set Ω) ∪ {v}) := by
    rw [IntermediateField.adjoin_le_iff]
    intro a ha
    exact sub (Set.mem_union_right _ ha)
  have hwT : w ∈ IntermediateField.adjoin k
      (((IntermediateField.adjoin k ((M : Set Ω) ∪ {v}) : IntermediateField k Ω) : Set Ω) ∪
        {x + v * y}) := by
    have hMT : ∀ m ∈ M, m ∈ IntermediateField.adjoin k
        (((IntermediateField.adjoin k ((M : Set Ω) ∪ {v}) : IntermediateField k Ω) : Set Ω) ∪
          {x + v * y}) :=
      fun m hm => sub (Set.mem_union_left _ (sub (Set.mem_union_left _ hm)))
    have hvT' : v ∈ IntermediateField.adjoin k
        (((IntermediateField.adjoin k ((M : Set Ω) ∪ {v}) : IntermediateField k Ω) : Set Ω) ∪
          {x + v * y}) :=
      sub (Set.mem_union_left _ (sub (Set.mem_union_right _ rfl)))
    have hsT' : x + v * y ∈ IntermediateField.adjoin k
        (((IntermediateField.adjoin k ((M : Set Ω) ∪ {v}) : IntermediateField k Ω) : Set Ω) ∪
          {x + v * y}) :=
      sub (Set.mem_union_right _ rfl)
    have hyT : y ∈ IntermediateField.adjoin k
        (((IntermediateField.adjoin k ((M : Set Ω) ∪ {v}) : IntermediateField k Ω) : Set Ω) ∪
          {x + v * y}) := by
      have h := div_mem (sub_mem (hMT _ htM) hsT') (sub_mem (hMT _ huM) hvT')
      have hyeq : (x + u * y - (x + v * y)) / (u - v) = y := by
        rw [div_eq_iff (sub_ne_zero.mpr huv)]
        ring
      rwa [hyeq] at h
    have hxT : x ∈ IntermediateField.adjoin k
        (((IntermediateField.adjoin k ((M : Set Ω) ∪ {v}) : IntermediateField k Ω) : Set Ω) ∪
          {x + v * y}) := by
      have h := sub_mem hsT' (mul_mem hvT' hyT)
      rwa [add_sub_cancel_right] at h
    have hPT : ∀ c ∈ IntermediateField.adjoin k ((P : Set Ω) ∪ {z}),
        c ∈ IntermediateField.adjoin k
          (((IntermediateField.adjoin k ((M : Set Ω) ∪ {v}) : IntermediateField k Ω) :
            Set Ω) ∪ {x + v * y}) := by
      intro c hc
      have hle : IntermediateField.adjoin k ((P : Set Ω) ∪ {z}) ≤ IntermediateField.adjoin k
          (((IntermediateField.adjoin k ((M : Set Ω) ∪ {v}) : IntermediateField k Ω) :
            Set Ω) ∪ {x + v * y}) := by
        rw [IntermediateField.adjoin_le_iff]
        intro a ha
        rcases ha with ha | ha
        · have hPle : P ≤ IntermediateField.adjoin k
              (((IntermediateField.adjoin k ((M : Set Ω) ∪ {v}) : IntermediateField k Ω) :
                Set Ω) ∪ {x + v * y}) := by
            rw [hP, IntermediateField.adjoin_le_iff]
            intro b hb
            rcases hb with rfl | rfl | rfl | rfl
            · exact hxT
            · exact hyT
            · exact hMT _ huM
            · exact hvT'
          exact hPle ha
        · rw [Set.mem_singleton_iff.mp ha]
          exact hMT _ hzM
      exact hle hc
    exact hPT w (mem_union_of_mem_adjoin hwPz)
  have hE'le : IntermediateField.adjoin k ({v, x + v * y} : Set Ω) ≤
      IntermediateField.adjoin k
        (((IntermediateField.adjoin k ({v} : Set Ω) : IntermediateField k Ω) : Set Ω) ∪
          {x + v * y}) := by
    rw [IntermediateField.adjoin_le_iff]
    intro a ha
    rcases ha with rfl | rfl
    · exact sub (Set.mem_union_left _ (IntermediateField.mem_adjoin_simple_self k a))
    · exact sub (Set.mem_union_right _ rfl)
  have hA2 : ∀ a ∈ IntermediateField.adjoin k ((M : Set Ω) ∪ {v}),
      IsAlgebraic (IntermediateField.adjoin k ({v} : Set Ω)) a →
        a ∈ IntermediateField.adjoin k ({v} : Set Ω) :=
    fun a ha halga => mem_adjoin_v M hvM ha halga
  have hwE'' := mem_adjoin_union_of_isAlgebraic (IntermediateField.adjoin k ({v} : Set Ω))
    (IntermediateField.adjoin k ((M : Set Ω) ∪ {v})) hle1 hA2 hsT hwT
    (isAlgebraic_of_le hE'le hwalg)
  have hle2 : IntermediateField.adjoin k
      (((IntermediateField.adjoin k ({v} : Set Ω) : IntermediateField k Ω) : Set Ω) ∪
        {x + v * y}) ≤ IntermediateField.adjoin k ({v, x + v * y} : Set Ω) := by
    rw [IntermediateField.adjoin_le_iff]
    intro a ha
    rcases ha with ha | ha
    · have hvle : IntermediateField.adjoin k ({v} : Set Ω) ≤
          IntermediateField.adjoin k ({v, x + v * y} : Set Ω) :=
        IntermediateField.adjoin_le_iff.mpr
          (Set.singleton_subset_iff.mpr (sub (Set.mem_insert _ _)))
      exact hvle ha
    · rw [Set.mem_singleton_iff.mp ha]
      exact sub (Set.mem_insert_of_mem _ rfl)
  have hwE' : sigma F hu hvF zU ∈ IntermediateField.adjoin k ({v, x + v * y} : Set Ω) := by
    rw [hσz]
    exact hle2 hwE''
  have hfin := sigma_preimage F hu hvF hx hy zU hwE'
  rw [hzUz] at hfin
  exact hfin
theorem bertini_core [IsAlgClosed k] [IsAlgClosed Ω] (F : IntermediateField k Ω)
    (hF : ∀ a : Ω, IsAlgebraic F a → a ∈ F) {x y u v : Ω} (hx : x ∈ F) (hy : y ∈ F)
    (hxy : AlgebraicIndependent k ![x, y]) (hu : Transcendental F u)
    (hv : Transcendental (IntermediateField.adjoin F ({u} : Set Ω)) v) {z : Ω}
    (hz : z ∈ IntermediateField.adjoin F ({u} : Set Ω))
    (halg : IsAlgebraic (IntermediateField.adjoin k ({u, x + u * y} : Set Ω)) z) :
    z ∈ IntermediateField.adjoin k ({u, x + u * y} : Set Ω) := by
  classical
  have hint : IsIntegral (IntermediateField.adjoin k ({u, x + u * y} : Set Ω)) z :=
    halg.isIntegral
  obtain ⟨p, hchar⟩ := CharP.exists k
  rcases CharP.char_is_prime_or_zero k p with hp | hp
  · haveI := Fact.mk hp
    haveI : CharP (IntermediateField.adjoin k ({u, x + u * y} : Set Ω)) p :=
      charP_of_injective_algebraMap
        (algebraMap k (IntermediateField.adjoin k ({u, x + u * y} : Set Ω))).injective p
    obtain ⟨n, g, hg, hgf⟩ :=
      Polynomial.exists_separable_of_irreducible p (minpoly.irreducible hint) hp.ne_zero
    have hsepn : IsSeparable (IntermediateField.adjoin k ({u, x + u * y} : Set Ω)) (z ^ p ^ n) := by
      refine Polynomial.Separable.of_dvd hg (minpoly.dvd _ _ ?_)
      rw [← Polynomial.expand_aeval, hgf, minpoly.aeval]
    have hmain := core_sep F hF hx hy hxy hu hv (pow_mem hz _) hsepn
    obtain ⟨h4, hvx, hux, hne⟩ := indep_four hx hy hxy hu hv
    have h3 : AlgebraicIndepOn k id ({u, x, y} : Set Ω) :=
      (show (AlgebraicIndependent.matroid k Ω).Indep _ from h4).subset (Set.subset_insert _ _)
    have hut := indep_u_t h3 hux hne
    have hyE : y ∉ IntermediateField.adjoin k (Set.range ![u, x + u * y]) := by
      rw [range_pair]
      exact not_mem_adjoin_y h3 hux hne
    have key : ∀ m : ℕ, z ^ p ^ m ∈ IntermediateField.adjoin k ({u, x + u * y} : Set Ω) →
        z ∈ IntermediateField.adjoin k ({u, x + u * y} : Set Ω) := by
      intro m
      induction m with
      | zero =>
        intro h
        simpa using h
      | succ m ih =>
        intro h
        apply ih
        rw [pow_succ, pow_mul] at h
        have h' : (z ^ p ^ m) ^ p ∈ IntermediateField.adjoin k (Set.range ![u, x + u * y]) := by
          rw [range_pair]
          exact h
        have h'' := mem_of_pow_char_mem_adjoin p F hx hy hu hut hyE (pow_mem hz _) h'
        rw [range_pair] at h''
        exact h''
    exact key n hmain
  · subst hp
    haveI : CharZero k := CharP.charP_to_charZero k
    haveI : CharZero (IntermediateField.adjoin k ({u, x + u * y} : Set Ω)) :=
      charZero_of_injective_algebraMap
        (algebraMap k (IntermediateField.adjoin k ({u, x + u * y} : Set Ω))).injective
    exact core_sep F hF hx hy hxy hu hv hz (minpoly.irreducible hint).separable
end Core
section RatFuncForm
theorem aeval_mem_of {K F Ω : Type*} [Field K] [Field F] [Field Ω] [Algebra K Ω] [Algebra F Ω]
    (S : IntermediateField K Ω) (hS : ∀ c : F, algebraMap F Ω c ∈ S) {u : Ω} (hu : u ∈ S)
    (r : Polynomial F) : Polynomial.aeval u r ∈ S := by
  refine Polynomial.induction_on r ?_ ?_ ?_
  · intro a
    rw [Polynomial.aeval_C]
    exact hS a
  · intro p q hp hq
    rw [map_add]
    exact add_mem hp hq
  · intro n a h
    rw [pow_succ, ← mul_assoc, map_mul, Polynomial.aeval_X]
    exact mul_mem h hu
theorem bertini_ratFunc_of_ambient {k F Ω : Type*} [Field k] [IsAlgClosed k] [Field F]
    [Algebra k F] [Field Ω] [IsAlgClosed Ω] [Algebra k Ω] [Algebra F Ω] [IsScalarTower k F Ω]
    [Algebra (RatFunc F) Ω] [IsScalarTower F (RatFunc F) Ω] [IsScalarTower k (RatFunc F) Ω]
    {v : Ω} (hv : Transcendental (RatFunc F) v) {x y : F}
    (hxy : AlgebraicIndependent k ![x, y]) {z : RatFunc F}
    (halg : IsAlgebraic (IntermediateField.adjoin k
      ({RatFunc.X, RatFunc.C x + RatFunc.X * RatFunc.C y} : Set (RatFunc F))) z) :
    z ∈ IntermediateField.adjoin k
      ({RatFunc.X, RatFunc.C x + RatFunc.X * RatFunc.C y} : Set (RatFunc F)) := by
  classical
  let φt : RatFunc F →ₐ[F] Ω := IsScalarTower.toAlgHom F (RatFunc F) Ω
  have hu0 : Transcendental F (φt RatFunc.X) := fun h =>
    RatFunc.transcendental_X ((isAlgebraic_algHom_iff φt φt.toRingHom.injective).mp h)
  obtain ⟨u, hudef⟩ : ∃ u : Ω, u = φt RatFunc.X := ⟨_, rfl⟩
  rw [← hudef] at hu0
  let φ : RatFunc F →ₐ[F] Ω := (IntermediateField.adjoin F ({u} : Set Ω)).val.comp
    (RatFunc.algEquivOfTranscendental u hu0).toAlgHom
  have hφX : φ RatFunc.X = u := RatFunc.algEquivOfTranscendental_X u hu0
  have hφC : ∀ c : F, φ (RatFunc.C c) = algebraMap F Ω c := fun c => by
    rw [← RatFunc.algebraMap_eq_C]
    exact φ.commutes c
  let φk : RatFunc F →ₐ[k] Ω := φ.restrictScalars k
  have hφinj : Function.Injective φk := φk.toRingHom.injective
  let F' : IntermediateField k Ω := (IsScalarTower.toAlgHom k F Ω).fieldRange
  have hmemF' : ∀ c : F, algebraMap F Ω c ∈ F' := fun c => ⟨c, rfl⟩
  let ψ : F →+* F' :=
    { toFun := fun c => ⟨algebraMap F Ω c, hmemF' c⟩
      map_one' := Subtype.ext (map_one (algebraMap F Ω))
      map_mul' := fun a b => Subtype.ext (map_mul (algebraMap F Ω) a b)
      map_zero' := Subtype.ext (map_zero (algebraMap F Ω))
      map_add' := fun a b => Subtype.ext (map_add (algebraMap F Ω) a b) }
  have hψsurj : Function.Surjective ψ := by
    rintro ⟨a, c, rfl⟩
    exact ⟨c, rfl⟩
  let e : F ≃+* F' := RingEquiv.ofBijective ψ ⟨ψ.injective, hψsurj⟩
  have htr : ∀ a : Ω, IsAlgebraic F' a ↔ IsAlgebraic F a := fun a =>
    isAlgebraic_ringHom_iff_of_comp_eq e (RingHom.id Ω) Function.injective_id
      (RingHom.ext fun _ => rfl)
  obtain ⟨Fb, hFbdef⟩ : ∃ Fb : IntermediateField k Ω, ∀ a : Ω, a ∈ Fb ↔ IsAlgebraic F' a :=
    ⟨(algebraicClosure F' Ω).restrictScalars k,
      fun a => by rw [IntermediateField.mem_restrictScalars, mem_algebraicClosure_iff]⟩
  have hFbcl : ∀ b : Ω, b ∈ Fb ↔ b ∈ (AlgebraicIndependent.matroid k Ω).closure (F' : Set Ω) := by
    intro b
    rw [hFbdef, mem_matroid_closure_iff, IntermediateField.adjoin_self]
  have hF : ∀ a : Ω, IsAlgebraic Fb a → a ∈ Fb := by
    intro a ha
    have h1 : a ∈ (AlgebraicIndependent.matroid k Ω).closure (Fb : Set Ω) := by
      rw [mem_matroid_closure_iff, IntermediateField.adjoin_self]
      exact ha
    exact (hFbcl a).mpr (closure_le_of_subset (fun b hb => (hFbcl b).mp hb) h1)
  have hu : Transcendental Fb u := by
    intro h
    exact hu0 ((htr u).mp ((hFbdef u).mp (hF u h)))
  have hFb : ∀ c : F, algebraMap F Ω c ∈ Fb := fun c =>
    (hFbdef _).mpr (isAlgebraic_algebraMap (⟨algebraMap F Ω c, hmemF' c⟩ : F'))
  have hxy' : AlgebraicIndependent k ![algebraMap F Ω x, algebraMap F Ω y] := by
    have h := hxy.map' (f := IsScalarTower.toAlgHom k F Ω)
      (IsScalarTower.toAlgHom k F Ω).toRingHom.injective
    convert h using 1
    ext i
    fin_cases i <;> rfl
  have hvG : Transcendental (algebraicClosure (RatFunc F) Ω) v :=
    (Algebra.IsAlgebraic.transcendental_iff (RatFunc F) (algebraicClosure (RatFunc F) Ω)).mp hv
  have hle : (IntermediateField.adjoin Fb ({u} : Set Ω)).restrictScalars k ≤
      (algebraicClosure (RatFunc F) Ω).restrictScalars k := by
    rw [IntermediateField.restrictScalars_adjoin, IntermediateField.adjoin_le_iff]
    intro a ha
    rcases ha with ha | ha
    · have h1 : IsAlgebraic F a := (htr a).mp ((hFbdef a).mp ha)
      exact mem_algebraicClosure_iff.mpr (h1.tower_top (RatFunc F))
    · rw [Set.mem_singleton_iff.mp ha, hudef]
      exact mem_algebraicClosure_iff.mpr (isAlgebraic_algebraMap (RatFunc.X : RatFunc F))
  have hv' : Transcendental (IntermediateField.adjoin Fb ({u} : Set Ω)) v := by
    intro h
    have h1 : IsAlgebraic ((IntermediateField.adjoin Fb ({u} : Set Ω)).restrictScalars k) v := h
    exact hvG (isAlgebraic_of_le hle h1)
  have hz' : φk z ∈ IntermediateField.adjoin Fb ({u} : Set Ω) := by
    have hmem : φ z ∈ IntermediateField.adjoin F ({u} : Set Ω) :=
      ((RatFunc.algEquivOfTranscendental u hu0) z).2
    obtain ⟨r, s, hrs⟩ := (IntermediateField.mem_adjoin_simple_iff F (φ z)).mp hmem
    have hS : ∀ c : F, algebraMap F Ω c ∈ IntermediateField.adjoin Fb ({u} : Set Ω) := fun c =>
      IntermediateField.algebraMap_mem (IntermediateField.adjoin Fb ({u} : Set Ω))
        (⟨algebraMap F Ω c, hFb c⟩ : Fb)
    have huS : u ∈ IntermediateField.adjoin Fb ({u} : Set Ω) :=
      IntermediateField.mem_adjoin_simple_self Fb u
    show φ z ∈ _
    rw [hrs]
    exact div_mem (aeval_mem_of _ hS huS r) (aeval_mem_of _ hS huS s)
  have hmapE : (IntermediateField.adjoin k
      ({RatFunc.X, RatFunc.C x + RatFunc.X * RatFunc.C y} : Set (RatFunc F))).map φk =
      IntermediateField.adjoin k ({u, algebraMap F Ω x + u * algebraMap F Ω y} : Set Ω) := by
    rw [IntermediateField.adjoin_map, Set.image_pair]
    have h1 : φk RatFunc.X = u := hφX
    have h2 : φk (RatFunc.C x + RatFunc.X * RatFunc.C y) =
        algebraMap F Ω x + u * algebraMap F Ω y := by
      show φ (RatFunc.C x + RatFunc.X * RatFunc.C y) = _
      rw [map_add, map_mul, hφC, hφC, hφX]
    rw [h1, h2]
  have halg' : IsAlgebraic
      (IntermediateField.adjoin k ({u, algebraMap F Ω x + u * algebraMap F Ω y} : Set Ω))
      (φk z) := by
    rw [← hmapE]
    exact (isAlgebraic_ringHom_iff_of_comp_eq
      (IntermediateField.equivMap (IntermediateField.adjoin k
        ({RatFunc.X, RatFunc.C x + RatFunc.X * RatFunc.C y} : Set (RatFunc F))) φk).toRingEquiv
      (φk : RatFunc F →+* Ω) hφinj (RingHom.ext fun _ => rfl)).mpr halg
  have hcore := bertini_core Fb hF (hFb x) (hFb y) hxy' hu hv' hz' halg'
  rw [← hmapE] at hcore
  obtain ⟨z', hz'E, hφz⟩ := hcore
  rw [← hφinj hφz]
  exact hz'E
theorem bertini_two_variable {k F : Type*} [Field k] [IsAlgClosed k] [Field F] [Algebra k F]
    {x y : F} (hxy : AlgebraicIndependent k ![x, y]) {z : RatFunc F}
    (halg : IsAlgebraic (IntermediateField.adjoin k
      ({RatFunc.X, RatFunc.C x + RatFunc.X * RatFunc.C y} : Set (RatFunc F))) z) :
    z ∈ IntermediateField.adjoin k
      ({RatFunc.X, RatFunc.C x + RatFunc.X * RatFunc.C y} : Set (RatFunc F)) := by
  have hv : Transcendental (RatFunc F)
      (algebraMap (RatFunc (RatFunc F)) (AlgebraicClosure (RatFunc (RatFunc F)))
        (RatFunc.X : RatFunc (RatFunc F))) := by
    intro h
    let f : RatFunc (RatFunc F) →ₐ[RatFunc F] AlgebraicClosure (RatFunc (RatFunc F)) :=
      IsScalarTower.toAlgHom (RatFunc F) (RatFunc (RatFunc F))
        (AlgebraicClosure (RatFunc (RatFunc F)))
    have h' : IsAlgebraic (RatFunc F) (f (RatFunc.X : RatFunc (RatFunc F))) := h
    exact RatFunc.transcendental_X ((isAlgebraic_algHom_iff f f.toRingHom.injective).mp h')
  exact bertini_ratFunc_of_ambient hv hxy halg
end RatFuncForm
