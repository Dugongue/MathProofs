section Defs
variable {L : Type*} [Field L]
def weight (n D : ℕ) (j : Fin (boxSize n D)) : ℕ :=
  ((boundedExponents n D)[j.val]).sum fun _ => id
def collDeg (n d : ℕ) : ℕ := componentCount n (n * d) ^ 2 * (n * cpE n d)
def InColl {s : ℕ} (n d : ℕ) (F : Fin s → Fin (boxSize n d) → L) (y : Fin n → L) : Prop :=
  ∃ (k1 : ℕ) (S1 : Fin k1 → Fin (boxSize n (cpE n d)))
    (U1 : Fin k1 → Fin (boxSize n (cpE n d)) → L)
    (k2 : ℕ) (S2 : Fin k2 → Fin (boxSize n (cpE n d)))
    (U2 : Fin k2 → Fin (boxSize n (cpE n d)) → L),
    IsP n d F S1 U1 ∧ IsP n d F S2 U2 ∧ (∀ i, denseEval y (U1 i) = 0) ∧
      (∀ i, denseEval y (U2 i) = 0) ∧
      ∃ z : Fin n → L, (∀ i, denseEval z (U1 i) = 0) ∧ ¬ ∀ i, denseEval z (U2 i) = 0
def InW {s : ℕ} (n d D : ℕ) (F : Fin s → Fin (boxSize n d) → L)
    (v : Fin (boxSize n D) → L) : Prop :=
  (∀ j, D < weight n D j → v j = 0) ∧ ∀ y, InColl n d F y → denseEval y v = 0
def IsCB {s k : ℕ} (n d D : ℕ) (F : Fin s → Fin (boxSize n d) → L)
    (S : Fin k → Fin (boxSize n D)) (U : Fin k → Fin (boxSize n D) → L) : Prop :=
  (∀ i j, U i (S j) = if i = j then 1 else 0) ∧ (∀ i, InW n d D F (U i)) ∧
    ∀ v, InW n d D F v → ∀ j, v j = ∑ i, v (S i) * U i j
end Defs
section Linear
variable {L : Type*} [Field L]
theorem denseEval_comb {n D k : ℕ} (y : Fin n → L) (c : Fin k → L)
    (U : Fin k → Fin (boxSize n D) → L) :
    denseEval y (fun j => ∑ i, c i * U i j) = ∑ i, c i * denseEval y (U i) := by
  have h : (fun j => ∑ i, c i * U i j) = ∑ i, c i • U i := by
    funext j
    simp [Finset.sum_apply, smul_eq_mul]
  rw [h, map_sum]
  simp only [map_smul, smul_eq_mul]
def Wsub {s : ℕ} (n d D : ℕ) (F : Fin s → Fin (boxSize n d) → L) :
    Submodule L (Fin (boxSize n D) → L) where
  carrier := {v | InW n d D F v}
  add_mem' := by
    intro a b ha hb
    refine ⟨fun j hj => ?_, fun y hy => ?_⟩
    · simp [ha.1 j hj, hb.1 j hj]
    · rw [map_add, ha.2 y hy, hb.2 y hy, add_zero]
  zero_mem' := by
    refine ⟨fun j _ => rfl, fun y _ => map_zero _⟩
  smul_mem' := by
    intro c a ha
    refine ⟨fun j hj => ?_, fun y hy => ?_⟩
    · simp [ha.1 j hj]
    · rw [map_smul, ha.2 y hy, smul_zero]
theorem exists_isCB {s : ℕ} (n d D : ℕ) (F : Fin s → Fin (boxSize n d) → L) :
    ∃ (k : ℕ) (S : Fin k → Fin (boxSize n D)) (U : Fin k → Fin (boxSize n D) → L),
      IsCB n d D F S U := by
  obtain ⟨k, S, U, hU, hS, hspan⟩ := exists_reduced_basis _ (Wsub n d D F)
  exact ⟨k, S, U, hS, hU, fun v hv => hspan v hv⟩
theorem isCB_unique {s k : ℕ} (n d D : ℕ) (F : Fin s → Fin (boxSize n d) → L)
    (S : Fin k → Fin (boxSize n D)) (U U' : Fin k → Fin (boxSize n D) → L)
    (h1 : IsCB n d D F S U) (h2 : IsCB n d D F S U') : U = U' := by
  funext i j
  rw [h1.2.2 (U' i) (h2.2.1 i) j]
  simp only [h2.1, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
theorem coeff_boxPoly (n D : ℕ) (v : Fin (boxSize n D) → L) (j : Fin (boxSize n D)) :
    coeff ((boundedExponents n D)[j.val]) (boxPoly n D v) = v j := by
  rw [boxPoly_eq, coeff_sum]
  simp only [coeff_monomial]
  rw [Finset.sum_eq_single j]
  · simp
  · intro b _ hb
    rw [if_neg]
    intro heq
    exact hb (Fin.ext ((boundedExponents_nodup n D).getElem_inj_iff.mp heq))
  · simp
theorem totalDegree_boxPoly_low (n D : ℕ) (v : Fin (boxSize n D) → L)
    (hv : ∀ j, D < weight n D j → v j = 0) : (boxPoly n D v).totalDegree ≤ D := by
  rw [boxPoly_eq]
  refine (totalDegree_finsetSum _ _).trans (Finset.sup_le fun j _ => ?_)
  by_cases h : D < weight n D j
  · rw [hv j h, map_zero, totalDegree_zero]
    exact Nat.zero_le _
  · exact (totalDegree_monomial_le _ _).trans (not_lt.mp h)
end Linear
section Geometry
variable {L : Type*} [Field L] [IsAlgClosed L]
theorem zeroLocus_radical_iff {n : ℕ} (J : Ideal (MvPolynomial (Fin n) L)) (x : Fin n → L) :
    x ∈ zeroLocus L J.radical ↔ x ∈ zeroLocus L J := by
  constructor
  · intro h
    rw [mem_zeroLocus_eval] at h ⊢
    exact fun f hf => h f (Ideal.le_radical hf)
  · intro h
    rw [mem_zeroLocus_eval]
    intro f hf
    exact (mem_radical_iff_vanish J f).mp hf x h
theorem inColl_iff {s : ℕ} (n d : ℕ) (F : Fin s → Fin (boxSize n d) → L)
    (hF : ∀ r, (boxPoly n d (F r)).totalDegree ≤ d) (y : Fin n → L) :
    InColl n d F y ↔
      ∃ P ∈ (Ideal.span (rowSys n d F : Set (MvPolynomial (Fin n) L))).minimalPrimes,
        ∃ Q ∈ (Ideal.span (rowSys n d F : Set (MvPolynomial (Fin n) L))).minimalPrimes,
          P ≠ Q ∧ y ∈ zeroLocus L P ∧ y ∈ zeroLocus L Q := by
  constructor
  · rintro ⟨k1, S1, U1, k2, S2, U2, h1, h2, hy1, hy2, z, hz1, hz2⟩
    refine ⟨_, isParam_component n d F S1 U1 h1, _, isParam_component n d F S2 U2 h2, ?_, ?_, ?_⟩
    · intro heq
      apply hz2
      have hz : z ∈ zeroLocus L
          (Ideal.span (rowSys n (cpE n d) U2 : Set (MvPolynomial (Fin n) L))).radical := by
        rw [← heq, zeroLocus_radical_iff, mem_zeroLocus_rowSys]
        exact hz1
      rwa [zeroLocus_radical_iff, mem_zeroLocus_rowSys] at hz
    · rw [zeroLocus_radical_iff, mem_zeroLocus_rowSys]
      exact hy1
    · rw [zeroLocus_radical_iff, mem_zeroLocus_rowSys]
      exact hy2
  · rintro ⟨P, hP, Q, hQ, hPQ, hyP, hyQ⟩
    obtain ⟨k1, S1, U1, h1, -, hm1, -⟩ := component_param n d F hF P hP
    obtain ⟨k2, S2, U2, h2, hr2, hm2, -⟩ := component_param n d F hF Q hQ
    have hv1 : ∀ x ∈ zeroLocus L P, ∀ i, denseEval x (U1 i) = 0 := fun x hx i => by
      rw [← eval_boxPoly]
      exact (mem_zeroLocus_eval P x).mp hx _ (hm1 i)
    have hv2 : ∀ x ∈ zeroLocus L Q, ∀ i, denseEval x (U2 i) = 0 := fun x hx i => by
      rw [← eval_boxPoly]
      exact (mem_zeroLocus_eval Q x).mp hx _ (hm2 i)
    have hnle : ¬ Q ≤ P := by
      intro hle
      exact hPQ (le_antisymm (hP.2 hQ.1 hle) hle)
    obtain ⟨g, hgQ, hgP⟩ := SetLike.not_le_iff_exists.mp hnle
    obtain ⟨z, hzP, hgz⟩ := prime_point P hP.1.1 g hgP
    refine ⟨k1, S1, U1, k2, S2, U2, h1, h2, hv1 y hyP, hv2 y hyQ, z, hv1 z hzP, ?_⟩
    intro hall
    apply hgz
    have hzQ : z ∈ zeroLocus L Q := by
      rw [← hr2, zeroLocus_radical_iff, mem_zeroLocus_rowSys]
      exact hall
    exact (mem_zeroLocus_eval Q z).mp hzQ g hgQ
theorem zeroLocus_collision {n : ℕ} (I : Ideal (MvPolynomial (Fin n) L)) (y : Fin n → L) :
    y ∈ zeroLocus L (collisionIdeal I) ↔
      ∃ P ∈ I.minimalPrimes, ∃ Q ∈ I.minimalPrimes,
        P ≠ Q ∧ y ∈ zeroLocus L P ∧ y ∈ zeroLocus L Q := by
  classical
  constructor
  · intro hy
    by_contra hno
    push_neg at hno
    have hfin := collision_family_finite I
    have hsel : ∀ J ∈ {J | ∃ P ∈ I.minimalPrimes, ∃ Q ∈ I.minimalPrimes, P ≠ Q ∧ J = P ⊔ Q},
        ∃ f ∈ J, eval y f ≠ 0 := by
      rintro J ⟨P, hP, Q, hQ, hPQ, rfl⟩
      by_cases hyP : y ∈ zeroLocus L P
      · have hyQ := hno P hP Q hQ hPQ hyP
        rw [mem_zeroLocus_eval] at hyQ
        push_neg at hyQ
        obtain ⟨f, hf, hfy⟩ := hyQ
        exact ⟨f, Ideal.mem_sup_right hf, hfy⟩
      · rw [mem_zeroLocus_eval] at hyP
        push_neg at hyP
        obtain ⟨f, hf, hfy⟩ := hyP
        exact ⟨f, Ideal.mem_sup_left hf, hfy⟩
    choose! f hf hfy using hsel
    have hmem : ∏ J ∈ hfin.toFinset, f J ∈ collisionIdeal I := by
      unfold collisionIdeal
      rw [Submodule.mem_sInf]
      intro J hJ
      have hJT : J ∈ hfin.toFinset := hfin.mem_toFinset.mpr hJ
      rw [← Finset.mul_prod_erase _ f hJT]
      exact Ideal.mul_mem_right _ _ (hf J hJ)
    have h0 := (mem_zeroLocus_eval _ y).mp hy _ hmem
    rw [map_prod, Finset.prod_eq_zero_iff] at h0
    obtain ⟨J, hJ, hJ0⟩ := h0
    exact hfy J (hfin.mem_toFinset.mp hJ) hJ0
  · rintro ⟨P, hP, Q, hQ, hPQ, hyP, hyQ⟩
    rw [mem_zeroLocus_eval]
    intro f hf
    have hle : collisionIdeal I ≤ P ⊔ Q := sInf_le ⟨P, hP, Q, hQ, hPQ, rfl⟩
    have hker : P ⊔ Q ≤ RingHom.ker (eval y) :=
      sup_le (fun g hg => RingHom.mem_ker.mpr ((mem_zeroLocus_eval P y).mp hyP g hg))
        (fun g hg => RingHom.mem_ker.mpr ((mem_zeroLocus_eval Q y).mp hyQ g hg))
    exact RingHom.mem_ker.mp (hker (hle hf))
theorem exists_separating {s : ℕ} (n d : ℕ) (F : Fin s → Fin (boxSize n d) → L)
    (hF : ∀ r, (boxPoly n d (F r)).totalDegree ≤ d) (y : Fin n → L) (hno : ¬ InColl n d F y) :
    ∃ h : Fin (boxSize n (collDeg n d)) → L, InW n d (collDeg n d) F h ∧ denseEval y h ≠ 0 := by
  classical
  have hfin := Ideal.finite_minimalPrimes_of_isNoetherianRing _
    (Ideal.span (rowSys n d F : Set (MvPolynomial (Fin n) L)))
  have key : ∀ P ∈ (Ideal.span (rowSys n d F : Set (MvPolynomial (Fin n) L))).minimalPrimes,
      y ∉ zeroLocus L P → ∃ g : MvPolynomial (Fin n) L,
        g.totalDegree ≤ n * cpE n d ∧ g ∈ P ∧ eval y g ≠ 0 := by
    intro P hP hyP
    obtain ⟨k, S', U', -, hr, hm, -⟩ := component_param n d F hF P hP
    have hex : ¬ ∀ i, denseEval y (U' i) = 0 := by
      intro hall
      apply hyP
      rw [← hr, zeroLocus_radical_iff, mem_zeroLocus_rowSys]
      exact hall
    push_neg at hex
    obtain ⟨i, hi⟩ := hex
    exact ⟨boxPoly n (cpE n d) (U' i), totalDegree_boxPoly_le _ _ _, hm i, by rwa [eval_boxPoly]⟩
  have hsel : ∀ pq ∈ (hfin.toFinset ×ˢ hfin.toFinset).filter (fun pq => pq.1 ≠ pq.2),
      ∃ g : MvPolynomial (Fin n) L, g.totalDegree ≤ n * cpE n d ∧ (g ∈ pq.1 ∨ g ∈ pq.2) ∧
        eval y g ≠ 0 := by
    intro pq hpq
    simp only [Finset.mem_filter, Finset.mem_product, Set.Finite.mem_toFinset] at hpq
    obtain ⟨⟨hP, hQ⟩, hne⟩ := hpq
    have hnot : ¬ (y ∈ zeroLocus L pq.1 ∧ y ∈ zeroLocus L pq.2) := fun h =>
      hno ((inColl_iff n d F hF y).mpr ⟨_, hP, _, hQ, hne, h.1, h.2⟩)
    by_cases hyP : y ∈ zeroLocus L pq.1
    · obtain ⟨g, hg1, hg2, hg3⟩ := key _ hQ (fun h => hnot ⟨hyP, h⟩)
      exact ⟨g, hg1, Or.inr hg2, hg3⟩
    · obtain ⟨g, hg1, hg2, hg3⟩ := key _ hP hyP
      exact ⟨g, hg1, Or.inl hg2, hg3⟩
  choose! g hgdeg hgmem hgy using hsel
  have hcard : ((hfin.toFinset ×ˢ hfin.toFinset).filter (fun pq => pq.1 ≠ pq.2)).card ≤
      componentCount n (n * d) ^ 2 := by
    refine (Finset.card_filter_le _ _).trans ?_
    rw [Finset.card_product, sq]
    have hc := minimalPrimes_card_le n d F hfin.toFinset (fun Q hQ => hfin.mem_toFinset.mp hQ)
    exact Nat.mul_le_mul hc hc
  have hdeg : (∏ pq ∈ (hfin.toFinset ×ˢ hfin.toFinset).filter (fun pq => pq.1 ≠ pq.2),
      g pq).totalDegree ≤ collDeg n d := by
    refine (totalDegree_finsetProd _ _).trans ?_
    refine (Finset.sum_le_card_nsmul _ _ (n * cpE n d) fun pq hpq => hgdeg pq hpq).trans ?_
    rw [smul_eq_mul, collDeg]
    exact Nat.mul_le_mul_right _ hcard
  refine ⟨vecOf n (collDeg n d) (∏ pq ∈ (hfin.toFinset ×ˢ hfin.toFinset).filter
    (fun pq => pq.1 ≠ pq.2), g pq), ⟨?_, ?_⟩, ?_⟩
  · intro j hj
    unfold vecOf
    apply coeff_eq_zero_of_totalDegree_lt
    exact lt_of_le_of_lt hdeg hj
  · intro y' hy'
    rw [denseEval_vecOf n _ _ hdeg, map_prod]
    obtain ⟨P, hP, Q, hQ, hPQ, hyP, hyQ⟩ := (inColl_iff n d F hF y').mp hy'
    have hmem : (P, Q) ∈ (hfin.toFinset ×ˢ hfin.toFinset).filter (fun pq => pq.1 ≠ pq.2) := by
      simp only [Finset.mem_filter, Finset.mem_product, Set.Finite.mem_toFinset]
      exact ⟨⟨hP, hQ⟩, hPQ⟩
    apply Finset.prod_eq_zero hmem
    rcases hgmem _ hmem with h | h
    · exact (mem_zeroLocus_eval P y').mp hyP _ h
    · exact (mem_zeroLocus_eval Q y').mp hyQ _ h
  · rw [denseEval_vecOf n _ _ hdeg, map_prod]
    exact Finset.prod_ne_zero_iff.mpr fun pq hpq => hgy pq hpq
theorem zeroLocus_isCB {s k : ℕ} (n d : ℕ) (F : Fin s → Fin (boxSize n d) → L)
    (hF : ∀ r, (boxPoly n d (F r)).totalDegree ≤ d)
    (S : Fin k → Fin (boxSize n (collDeg n d))) (U : Fin k → Fin (boxSize n (collDeg n d)) → L)
    (hCB : IsCB n d (collDeg n d) F S U) (y : Fin n → L) :
    y ∈ zeroLocus L (Ideal.span (rowSys n (collDeg n d) U : Set (MvPolynomial (Fin n) L))) ↔
      InColl n d F y := by
  rw [mem_zeroLocus_rowSys]
  constructor
  · intro hy
    by_contra hno
    obtain ⟨h, hW, hhy⟩ := exists_separating n d F hF y hno
    apply hhy
    rw [show h = fun j => ∑ i, h (S i) * U i j from funext (hCB.2.2 h hW), denseEval_comb]
    simp [hy]
  · intro hy i
    exact (hCB.2.1 i).2 y hy
theorem radical_isCB {s k : ℕ} (n d : ℕ) (F : Fin s → Fin (boxSize n d) → L)
    (hF : ∀ r, (boxPoly n d (F r)).totalDegree ≤ d)
    (S : Fin k → Fin (boxSize n (collDeg n d))) (U : Fin k → Fin (boxSize n (collDeg n d)) → L)
    (hCB : IsCB n d (collDeg n d) F S U) :
    (Ideal.span (rowSys n (collDeg n d) U : Set (MvPolynomial (Fin n) L))).radical =
      (collisionIdeal (Ideal.span (rowSys n d F : Set (MvPolynomial (Fin n) L)))).radical := by
  rw [← vanishingIdeal_zeroLocus_eq_radical (K := L),
    ← vanishingIdeal_zeroLocus_eq_radical (K := L)]
  congr 1
  ext y
  rw [zeroLocus_isCB n d F hF S U hCB, zeroLocus_collision, inColl_iff n d F hF]
end Geometry
end Mathproof.Problem18CollisionLocus20261001
