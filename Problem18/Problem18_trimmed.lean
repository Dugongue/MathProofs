    degree := by rw [hve]; exact hv.degree
    prime := by rw [hvp]; exact hv.prime
    arithmetic_word := hv.arithmetic_word
    inverse_word := hv.inverse_word
    memory_word := by rw [harr]; exact hv.memory_word
    scratch_word := by rw [harr]; exact hv.scratch_word
