def unitaryPrepared (q : Nat) (F G : RectTensor a b c K) : List (StarExpr (OuterVar a b) K)×Nat :=
  let rF:=CR (F.submatrix id finProdFinEquiv.symm)
  let rG:=CR (G.submatrix id finProdFinEquiv.symm)
  let k:=CK (G.submatrix id finProdFinEquiv.symm)
  let S:=gramRect true q F
  let T:=gramRect true q G
  let ps:=if rF.1=rG.1 then
    ((List.finRange a).flatMap fun i=>(List.finRange a).map fun j=>preserveP i j) ++
    ((List.finRange b).flatMap fun i=>(List.finRange b).map fun j=>preserveQ i j) ++
    ((List.finRange c).flatMap fun i=>(List.finRange (a*b)).map fun t=>
      sxSumPair a b fun ij=>StarExpr.mul (transformedExpr F i ij) (.const (k.1 t (finProdFinEquiv ij)))) ++
    ((List.finRange (a*b)).flatMap fun i=>(List.finRange (a*b)).map fun j=>
