structure IndexedTM2ComputableInPolyTime {α : Type u} {β : Type v}
    {αΓ βΓ : Type} (ea : α→List αΓ) (eb : β→List βΓ) (f : α→β)
    extends TM2ComputableAux αΓ βΓ where
  time : Polynomial Nat
  outputsFun : ∀a,TM2OutputsInTime tm (List.map inputAlphabet.invFun (ea a))
    (some (List.map outputAlphabet.invFun (eb (f a)))) (time.eval (ea a).length)
theorem indexed_root_machine {ι : Type u} (input output : ι→List Nat)
    (p : Lax13.Ram.Program) (W T : Polynomial Nat)
    (hram : ∀i,FitsInWords (W.eval (bitSize (input i)))
      (((input i).length::input i)++output i) ∧
      ∀w,W.eval (bitSize (input i)) ≤ w →
        ∃t ≤ T.eval (bitSize (input i)),
          Lax13.Ram.RunsTo w p ((input i).length::input i) (output i) t) :
    ∃M : IndexedTM2ComputableInPolyTime (fun i=>BitstringEncoding.bitEncode (input i))
      BitstringEncoding.bitEncode output,∀k,Finite (M.tm.Γ k) := by
  let J : Type := {z : List Nat×List Nat // ∃i,input i=z.1 ∧ output i=z.2}
  have hj : ∀z:J,FitsInWords (W.eval (bitSize z.val.1))
      ((z.val.1.length::z.val.1)++z.val.2) ∧
      ∀w,W.eval (bitSize z.val.1)≤w→∃t≤T.eval (bitSize z.val.1),
        Lax13.Ram.RunsTo w p (z.val.1.length::z.val.1) z.val.2 t := by
    intro z
    obtain ⟨i,hi,ho⟩:=z.property
