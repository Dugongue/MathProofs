theorem order_sample_ratio_le
    (hcard : Nat.card K=Nat.card F^2) (hstar : ∀ a : K,star a=a^Nat.card F)
    (A : V →ₗ⋆[K] V →ₗ[K] K) (C : W →ₗ⋆[K] W →ₗ[K] K)
    (hA : A.IsSymm) (hnA : A.SeparatingLeft) (hC : C.IsSymm) (hnC : C.SeparatingLeft)
    (hd : Module.finrank K W≤Module.finrank K V) (hc : 1≤Module.finrank K W) :
    (Nat.card (Isometries (starRingAut : K ≃+* K) A) : ℝ)*
      Nat.card (SelfAdjointOperators (starRingAut : K ≃+* K) C) ≤
    3*Nat.card (Isometries (starRingAut : K ≃+* K) C)*
      Nat.card (SelfAdjointOperators (starRingAut : K ≃+* K) A) := by
  rw [isometry_card hcard hstar A hA hnA,isometry_card hcard hstar C hC hnC,
    sample_card hcard hstar A hA hnA,sample_card hcard hstar C hC hnC]
  push_cast
  let n := Module.finrank K W
  let m := Module.finrank K V-n
  have hdim : n+m=Module.finrank K V := Nat.add_sub_of_le hd
  have hq : (1:ℝ)≤Nat.card F := by exact_mod_cast (Nat.succ_le_of_lt (Nat.card_pos (α:=F)))
  have hg : (0:ℝ)<Nat.card (Matrix.unitaryGroup (Fin n) K) := by exact_mod_cast (Nat.card_pos (α:=Matrix.unitaryGroup (Fin n) K))
  have hp : (0:ℝ)<(Nat.card F : ℝ)^((n+m)^2-n^2) := pow_pos (lt_of_lt_of_le zero_lt_one hq) _
  have ht := Mathproof.Problem18ClassicalOrderRatios20260930.unitary_order_ratio_error hcard hstar n m hc
  have hi : ((Nat.card F : ℝ)^n)⁻¹≤1 := inv_le_one_of_one_le₀ (one_le_pow₀ hq)
  have hu : (Nat.card (Matrix.unitaryGroup (Fin (n+m)) K) : ℝ) ≤
      3*((Nat.card (Matrix.unitaryGroup (Fin n) K) : ℝ)*(Nat.card F : ℝ)^((n+m)^2-n^2)) := by
    apply (div_le_iff₀ (mul_pos hg hp)).mp
    have hh := (abs_le.mp ht).2
    linarith
  have he : (Nat.card F : ℝ)^((n+m)^2-n^2)*(Nat.card F : ℝ)^(n^2)=
      (Nat.card F : ℝ)^((n+m)^2) := by
    rw [←pow_add,Nat.sub_add_cancel (Nat.pow_le_pow_left (by omega) 2)]
  have hh := mul_le_mul_of_nonneg_right hu (show (0:ℝ)≤(Nat.card F : ℝ)^(n^2) by positivity)
  rw [mul_assoc (3:ℝ),mul_assoc,he,hdim] at hh
