theorem order_tail_error (q : ℝ) (hq : 2 ≤ q) (n m : ℕ) (hn : 1 ≤ n) :
    |(∏ k∈Finset.range m,orderFactor q (n+k))-1| ≤ 2*(q^n)⁻¹ := by
  classical
  let r := q⁻¹
  have hq0 : 0<q := by linarith
  have hr0 : 0 ≤ r := inv_nonneg.mpr hq0.le
  have hr : r ≤ 1/2 := by
    dsimp only [r]
    rw [inv_eq_one_div]
    exact (div_le_iff₀ hq0).mpr (by linarith)
  have hb : r^n ≤ 1/2 := (pow_le_pow_of_le_one hr0 (by linarith) hn).trans (by simpa using hr)
  let x := fun k => -(if Odd (n+k+2) then (q^(n+k+1))⁻¹ else 0)
  have hx (k : ℕ) : |x k| ≤ r^(n+k+1) := by
    dsimp only [x]
    split_ifs <;> simp only [abs_neg,abs_of_nonneg (by positivity : 0 ≤ (q^(n+k+1))⁻¹),
      r,inv_pow,le_refl,neg_zero,abs_zero] <;> positivity
  have htail : (∑ k∈Finset.range m,r^(n+k+1))≤ r^n := by
    calc
      _ = r^n*(∑ k∈Finset.range m,r^(k+1)) := by
        simp_rw [show ∀ k:ℕ,n+k+1=n+(k+1) from fun k=>by omega,pow_add]
        rw [Finset.mul_sum]
      _ ≤ r^n*1 := mul_le_mul_of_nonneg_left (geometric_error_sum r hr0 hr m) (pow_nonneg hr0 n)
      _ = r^n := mul_one _
  have hs : (∑ k∈Finset.range m,|x k|) ≤ r^n :=
    (Finset.sum_le_sum (fun k _ => hx k)).trans htail
  simpa only [x,orderFactor,sub_eq_add_neg,r,inv_pow] using
    finite_product_error (Finset.range m) x (r^n) (pow_nonneg hr0 n) hb hs
theorem orthogonal_order_normalized {K : Type*} [Field K] [Fintype K] [CharP K 2] (n : ℕ) :
    (Nat.card (Matrix.orthogonalGroup (Fin (n+1)) K):ℝ)=
      (Nat.card K:ℝ)^((n+1).choose 2)*∏ k∈Finset.range n,orderFactor (Nat.card K) k := by
  classical
  have hnat : 1 ≤ Nat.card K := Nat.card_pos
  rw [Mathproof.Problem18CharTwoOrthogonalColumn20260930.orthogonal_order_product_charTwo,Nat.cast_prod]
  have he : (∏ k∈Finset.range n,((Nat.card K^(k+1)-(if Odd (k+2) then 1 else 0):ℕ):ℝ))=
      ∏ k∈Finset.range n,((Nat.card K:ℝ)^(k+1)-(if Odd (k+2) then 1 else 0)) := by
    apply Finset.prod_congr rfl
    intro k hk
    by_cases ho : Odd (k+2)
    · rw [if_pos ho,if_pos ho,Nat.cast_sub (Nat.one_le_pow (k+1) _ hnat)]
      simp
    · simp [ho]
  rw [he,product_normalization _ (by exact_mod_cast (Nat.card_pos (α:=K)).ne')]
theorem orthogonal_order_ratio_error {K : Type*} [Field K] [Fintype K] [CharP K 2]
    (n m : ℕ) (hn : 1 ≤ n) :
    |(Nat.card (Matrix.orthogonalGroup (Fin (n+m+1)) K):ℝ)/
      ((Nat.card (Matrix.orthogonalGroup (Fin (n+1)) K):ℝ)*
        (Nat.card K:ℝ)^((n+m+1).choose 2-(n+1).choose 2))-1| ≤ 2*((Nat.card K:ℝ)^n)⁻¹ := by
  have hq : 2 ≤ (Nat.card K:ℝ) := by exact_mod_cast (Finite.one_lt_card (α:=K))
  have hq0 : (Nat.card K:ℝ)≠0 := by exact_mod_cast (Nat.card_pos (α:=K)).ne'
  have hg : (Nat.card (Matrix.orthogonalGroup (Fin (n+1)) K):ℝ)≠0 := by
    exact_mod_cast (Nat.card_pos (α:=Matrix.orthogonalGroup (Fin (n+1)) K)).ne'
  have he : (Nat.card (Matrix.orthogonalGroup (Fin (n+m+1)) K):ℝ)/
      ((Nat.card (Matrix.orthogonalGroup (Fin (n+1)) K):ℝ)*
        (Nat.card K:ℝ)^((n+m+1).choose 2-(n+1).choose 2))=
      ∏ k∈Finset.range m,orderFactor (Nat.card K) (n+k) := by
    apply (div_eq_iff (mul_ne_zero hg (pow_ne_zero _ hq0))).mpr
    rw [orthogonal_order_normalized,orthogonal_order_normalized,Finset.prod_range_add]
    have hle : (n+1).choose 2 ≤ (n+m+1).choose 2 := Nat.choose_le_choose 2 (by omega)
