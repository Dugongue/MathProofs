      Nat.card (Isometries σ B) := by
  let i₀ : IsometricEmbeddings σ B (sumForm σ B C) :=
    ⟨j₀.val,embeddingOrbit_isometric σ B C j₀⟩
  let e : {j : EmbeddingOrbit σ B C // LinearMap.range j.val=LinearMap.range j₀.val} ≃
      {j : IsometricEmbeddings σ B (sumForm σ B C) // LinearMap.range j.val=LinearMap.range i₀.val} := {
    toFun := fun j => ⟨⟨j.val.val,embeddingOrbit_isometric σ B C j.val⟩,j.property⟩
    invFun := fun j => ⟨⟨j.val.val,embeddingOrbit_of_same_range σ B C hB j₀ j.val j.property⟩,j.property⟩
