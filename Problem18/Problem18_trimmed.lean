  exact Mathproof.Problem18OrdinaryJointCount20260930.odd_joint_operator_card g hodd hm hcop B C hB hnB hdim
theorem charTwo_kernel_event_card [Fintype K] [CharP K 2]
    {ι : Type*} [Fintype ι] [Nonempty ι]
    (g : ι → K[X]) [∀ i,Fact (Irreducible (g i))]
    (hm : ∀ i,(g i).Monic) (hcop : Pairwise (fun i j => IsCoprime (g i) (g j)))
    (B : LinearMap.BilinForm K V) (C : LinearMap.BilinForm K W)
    (hB : B.IsSymm) (hnB : B.Nondegenerate) (haB : ¬B.IsAlt)
    (hdim : Module.finrank K V=∑ i,(g i).natDegree) :
    Nat.card (KernelOperators B C (∏ i,g i))*Nat.card (Isometries (RingEquiv.refl K) C)=
      Nat.card (Isometries (RingEquiv.refl K) (sumForm (RingEquiv.refl K) B C))*
        Nat.card {D : SelfAdjointOperators (RingEquiv.refl K) C // IsCoprime (∏ i,g i) D.val.charpoly} := by
  have hp : (∏ i,g i).Monic := Polynomial.monic_prod_of_monic _ _ (fun i _=>hm i)
