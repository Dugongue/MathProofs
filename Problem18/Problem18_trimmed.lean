attribute [-instance] FunLike.toDecidableEq CommSemiRingCat.FilteredColimits.colimitCommSemiring AddMonoidAlgebra.instHopfAlgebraStruct AddMonoidAlgebra.instBialgebra Bialgebra.toAlgebra
namespace Mathproof.Problem18FrobeniusCoordinateDescent20261001
open Module
universe u v
variable {ι : Type u} [Fintype ι] {L : Type v} [Field L]
def coordinate (W : Submodule L (ι → L)) (i : ι) : Module.Dual L W :=
  (LinearMap.proj i).comp W.subtype
@[simp] theorem coordinate_apply (W : Submodule L (ι → L)) (i : ι) (w : W) :
    coordinate W i w = w.val i := rfl
theorem coordinate_span (W : Submodule L (ι → L)) :
    Submodule.span L (Set.range (coordinate W)) = ⊤ := by
  classical
  let b := (Pi.basisFun L ι).dualBasis
  have heq : coordinate W = fun i => W.subtype.dualMap (b i) := by
    funext i
    ext w
    simp [coordinate, b, LinearMap.dualMap_apply, Module.Basis.dualBasis_apply]
  rw [heq]
  change Submodule.span L (Set.range (W.subtype.dualMap ∘ b)) = ⊤
  rw [Set.range_comp, ← Submodule.map_span, b.span_eq, Submodule.map_top]
  exact LinearMap.range_eq_top.mpr (LinearMap.dualMap_surjective_of_injective W.injective_subtype)
theorem exists_coordinate_equiv (W : Submodule L (ι → L)) :
    ∃ (κ : Type u) (a : κ → ι), Function.Injective a ∧
      ∃ e : W ≃ₗ[L] (κ → L), ∀ (w : W) (i : κ), e w i = w.val (a i) := by
  classical
  obtain ⟨κ, a, ha, hspan, hli⟩ := exists_linearIndependent' L (coordinate W)
  letI : Finite κ := Finite.of_injective a ha
  letI : Fintype κ := Fintype.ofFinite κ
  let b : Module.Basis κ L (Module.Dual L W) := Module.Basis.mk hli (by
    rw [hspan, coordinate_span])
  let e : W ≃ₗ[L] (κ → L) := (Module.evalEquiv L W).trans b.dualBasis.equivFun
  refine ⟨κ, a, ha, e, ?_⟩
  intro w i
  change b.dualBasis.equivFun (Module.evalEquiv L W w) i = w.val (a i)
  rw [b.dualBasis_equivFun]
  change (b i) w = w.val (a i)
  simp [b, Module.Basis.mk_apply, Function.comp_def]
theorem exists_fixed_basis (W : Submodule L (ι → L)) (σ : L →+* L)
    (hW : ∀ w : W, (fun j => σ (w.val j)) ∈ W) :
    ∃ (κ : Type u) (_ : Finite κ) (b : Module.Basis κ L W),
      ∀ i j, σ ((b i).val j) = (b i).val j := by
  classical
  obtain ⟨κ, a, ha, e, he⟩ := exists_coordinate_equiv W
  letI : Finite κ := Finite.of_injective a ha
  letI : Fintype κ := Fintype.ofFinite κ
