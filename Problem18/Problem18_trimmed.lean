attribute [-instance] FunLike.toDecidableEq CommSemiRingCat.FilteredColimits.colimitCommSemiring AddMonoidAlgebra.instHopfAlgebraStruct AddMonoidAlgebra.instBialgebra Bialgebra.toAlgebra
namespace Mathproof.Problem18PolynomialCompression20261001
open scoped BigOperators
open Problem18Elimination20260929 Problem18ArrayElimination20260929
  Problem18MacaulayAlgorithm20260930 Problem18DenseMonomialEnumeration20260930
variable {K : Type*} [Field K] [DecidableEq K] {N : Nat}
def selectRows (chosen : List (Vector K N)) : List (Vector K N)→List (Vector K N)×Nat
  | [] => (chosen,0)
  | v::vs =>
    let h:=spanCheck chosen v
    let r:=selectRows (if h.1 then chosen else v::chosen) vs
    (r.1,r.2+h.2)
theorem rowSpan_cons_eq (v : Fin N→K) (vs : List (Fin N→K)) :
    rowSpan (K:=K) (v::vs)=Submodule.span K {v} ⊔ rowSpan (K:=K) vs := by
  have he : {w | w∈v::vs}=insert v {w | w∈vs} := by ext w; simp
  rw [rowSpan,he,Submodule.span_insert]
  rfl
theorem selectedRows_span (chosen candidates : List (Vector K N)) :
    rowSpan (K:=K) (((selectRows chosen candidates).1).map read)=
      rowSpan (K:=K) (chosen.map read) ⊔ rowSpan (K:=K) (candidates.map read) := by
  induction candidates generalizing chosen with
  | nil => simp [selectRows,rowSpan]
  | cons v vs ih =>
    simp only [selectRows,List.map_cons]
    rw [ih,rowSpan_cons_eq]
    split_ifs with h
    · have hv: read v∈rowSpan (K:=K) (chosen.map read):=(spanCheck_iff chosen v).mp h
      have hs:Submodule.span K {read v}≤ rowSpan (K:=K) (chosen.map read):=
        (Submodule.span_singleton_le_iff_mem _ _).mpr hv
      exact (sup_assoc _ _ _).symm.trans (congrArg (fun W=>W⊔rowSpan (K:=K) (vs.map read))
        (sup_eq_left.mpr hs)) |>.symm
    · rw [List.map_cons,rowSpan_cons_eq]
      simp only [sup_assoc,sup_left_comm,sup_comm]
theorem selectedRows_independent (chosen candidates : List (Vector K N))
    (hc : LinearIndepOn K read {v | v∈chosen}) :
    LinearIndepOn K read {v | v∈(selectRows chosen candidates).1} := by
  induction candidates generalizing chosen with
  | nil => exact hc
  | cons v vs ih =>
    simp only [selectRows]
    apply ih
    split_ifs with h
    · exact hc
    · have hv:read v∉rowSpan (K:=K) (chosen.map read):=fun hv=>h ((spanCheck_iff chosen v).mpr hv)
      have he : {w | w∈v::chosen}=insert v {w | w∈chosen} := by ext w; simp
      rw [he]
      apply hc.insert
      have hm : read '' {w | w∈chosen}={z | z∈chosen.map read} := by ext z; simp
      rw [hm]
      exact hv
theorem selectedRows_nodup (chosen candidates : List (Vector K N)) (hc : chosen.Nodup) :
    (selectRows chosen candidates).1.Nodup := by
  induction candidates generalizing chosen with
  | nil => exact hc
  | cons v vs ih =>
    simp only [selectRows]
    apply ih
    split_ifs with h
    · exact hc
    · apply List.nodup_cons.mpr
      refine ⟨?_,hc⟩
      intro hv
      exact h ((spanCheck_iff chosen v).mpr (mem_rowSpan _ _ (List.mem_map.mpr ⟨v,hv,rfl⟩)))
theorem independent_rows_length (chosen : List (Vector K N))
    (hi : LinearIndepOn K read {v | v∈chosen}) (hn : chosen.Nodup) : chosen.length≤N := by
  classical
  letI : Fintype {v // v∈chosen}:=Fintype.ofFinset chosen.toFinset (by intro v; change v∈chosen.toFinset ↔ v∈chosen; simp)
  have hc:Fintype.card {v // v∈chosen}=chosen.length := by
    rw [Fintype.card_of_subtype chosen.toFinset (by intro v; simp)]
    exact List.toFinset_card_of_nodup hn
  have hl:LinearIndependent K (fun v : {v // v∈chosen}=>read v.val):=hi
  have h:=hl.fintype_card_le_finrank
  rw [hc] at h
  simpa using h
theorem selectedRows_mem (chosen candidates : List (Vector K N)) (v : Vector K N)
    (hv : v∈(selectRows chosen candidates).1) : v∈chosen ∨ v∈candidates := by
  induction candidates generalizing chosen with
  | nil => exact Or.inl hv
  | cons w ws ih =>
    simp only [selectRows] at hv
    rcases ih _ hv with hc | ht
    · split_ifs at hc with h
      · exact Or.inl hc
      · rcases List.mem_cons.mp hc with rfl | hc
        · exact Or.inr (by simp)
        · exact Or.inl hc
    · exact Or.inr (List.mem_cons_of_mem w ht)
def compress (vs : List (Vector K N)) : List (Vector K N)×Nat := selectRows [] vs
theorem compress_span (vs : List (Vector K N)) :
    rowSpan (K:=K) ((compress vs).1.map read)=rowSpan (K:=K) (vs.map read) := by
  simpa [compress,rowSpan] using selectedRows_span ([]:List (Vector K N)) vs
theorem compress_length (vs : List (Vector K N)) : (compress vs).1.length≤N :=
  independent_rows_length _ (selectedRows_independent [] vs (by simp))
    (selectedRows_nodup [] vs (by simp))
theorem independent_rows_finrank (chosen : List (Vector K N))
    (hi : LinearIndepOn K read {v | v∈chosen}) (hn : chosen.Nodup) :
    Module.finrank K (rowSpan (K:=K) (chosen.map read))=chosen.length := by
  classical
  letI : Fintype {v // v∈chosen}:=Fintype.ofFinset chosen.toFinset (by intro v; change v∈chosen.toFinset ↔ v∈chosen; simp)
  have hc:Fintype.card {v // v∈chosen}=chosen.length := by
    rw [Fintype.card_of_subtype chosen.toFinset (by intro v; simp)]
    exact List.toFinset_card_of_nodup hn
  have hl:LinearIndependent K (fun v : {v // v∈chosen}=>read v.val):=hi
  have he:Set.range (fun v : {v // v∈chosen}=>read v.val)={x | x∈chosen.map read} := by
    ext x
    simp
  have h:=finrank_span_eq_card (b:=fun v : {v // v∈chosen}=>read v.val) hl
  rw [he,hc] at h
  exact h
theorem compress_finrank (vs : List (Vector K N)) :
    (compress vs).1.length=Module.finrank K (rowSpan (K:=K) (vs.map read)) := by
  rw [←compress_span vs]
  exact (independent_rows_finrank _ (selectedRows_independent [] vs (by simp))
    (selectedRows_nodup [] vs (by simp))).symm
def matrixRank {r c : Nat} (A : Matrix (Fin r) (Fin c) K) : Nat :=
  (compress ((List.finRange c).map (fun j=>Vector.ofFn (fun i=>A i j)))).1.length
theorem matrixRank_correct {r c : Nat} (A : Matrix (Fin r) (Fin c) K) : matrixRank A=A.rank := by
  rw [matrixRank,compress_finrank,Matrix.rank_eq_finrank_span_cols]
  have he : {v | v∈((List.finRange c).map (fun j=>Vector.ofFn (fun i=>A i j))).map read}=
      Set.range A.col := by
    ext v
    simp [List.map_map,read_ofFn,Matrix.col,Matrix.transpose,Function.comp_def,Set.mem_range]
    rfl
  rw [rowSpan,he]
def testBudget (N : Nat) : Nat := N*N+(2*N+1)*N^2+N
theorem selectedRows_cost (chosen candidates : List (Vector K N))
    (hi : LinearIndepOn K read {v | v∈chosen}) (hn : chosen.Nodup) :
    (selectRows chosen candidates).2≤ candidates.length*testBudget N := by
  induction candidates generalizing chosen with
  | nil => simp [selectRows]
  | cons v vs ih =>
    have hsize:=independent_rows_length chosen hi hn
    have hc:(spanCheck chosen v).2≤testBudget N :=
      (spanCheck_cost_le chosen v).trans (by unfold testBudget; gcongr)
    have hnextI:LinearIndepOn K read {w | w∈if (spanCheck chosen v).1 then chosen else v::chosen} := by
      simpa [selectRows] using selectedRows_independent chosen [v] hi
    have hnextN:(if (spanCheck chosen v).1 then chosen else v::chosen).Nodup := by
      simpa [selectRows] using selectedRows_nodup chosen [v] hn
    have hh:=ih _ hnextI hnextN
    simp only [selectRows,List.length_cons]
    nlinarith
theorem compress_cost (vs : List (Vector K N)) :
    (compress vs).2≤vs.length*testBudget N := selectedRows_cost [] vs (by simp) (by simp)
theorem compress_linear_zeros (vs : List (Vector K N)) (e : (Fin N→K)→ₗ[K]K) :
    (∀v∈(compress vs).1,e (read v)=0) ↔ ∀v∈vs,e (read v)=0 := by
  have hh (ws : List (Vector K N)) :
      (∀v∈ws,e (read v)=0) ↔ rowSpan (K:=K) (ws.map read)≤LinearMap.ker e := by
    rw [rowSpan,Submodule.span_le]
    simp only [Set.subset_def,Set.mem_setOf_eq,List.mem_map,forall_exists_index,and_imp,
      forall_apply_eq_imp_iff₂]
    rfl
  rw [hh,compress_span,←hh]
theorem compress_sublist_values (vs : List (Vector K N)) (v : Vector K N)
    (hv : v∈(compress vs).1) : v∈vs := by
  simpa using selectedRows_mem [] vs v hv
def denseEval {n d : Nat} (x : Fin n→K) : (Fin (boundedExponents n d).length→K)→ₗ[K]K :=
  ∑i, (∏j:Fin n,x j^((boundedExponents n d)[i.val]) j) • LinearMap.proj i
theorem formal_polynomial_compression {n d : Nat} (vs : List (DenseInput n d K)) :
    (compress vs).1.length≤(d+1)^n ∧
    (compress vs).2≤vs.length*testBudget ((d+1)^n) ∧
    ∀x:Fin n→K,
      (∀v∈(compress vs).1,denseEval x (read v)=0) ↔ ∀v∈vs,denseEval x (read v)=0 := by
  refine ⟨?_,?_,fun x=>compress_linear_zeros vs (denseEval x)⟩
  · simpa only [boundedExponents_length] using compress_length vs
  · simpa only [boundedExponents_length] using compress_cost vs
end Mathproof.Problem18PolynomialCompression20261001
