theorem decomp3 {a b c t : Nat} (ht : t < c * (a * b)) :
    ∃ k : Fin c, ∃ i : Fin a, ∃ j : Fin b, t = k.val * (a * b) + i.val * b + j.val := by
  obtain ⟨k, s, rfl⟩ := decomp2 ht
  obtain ⟨i, j, hs⟩ := decomp2 s.isLt
  exact ⟨k, i, j, by rw [hs, Nat.add_assoc]⟩
variable {K : Type} [Field K]
def flat2 {n : Nat} (Z : Matrix (Fin n) (Fin n) K) (i : Nat) : K :=
  if h : i < n * n then
    Z ⟨i / n, (Nat.div_lt_iff_lt_mul (pos_of_lt_mul h)).mpr h⟩
      ⟨i % n, Nat.mod_lt _ (pos_of_lt_mul h)⟩
  else 0
theorem flat2_apply {n : Nat} (Z : Matrix (Fin n) (Fin n) K) (i j : Fin n) :
    flat2 Z (i.val * n + j.val) = Z i j := by
  have hlt := idx2_lt i.isLt j.isLt
