    intro c d
    refine Quotient.inductionOn₂ c d ?_
    intro B C h
    have he : B.val.IsAlt ↔ C.val.IsAlt := by
      have hh : decide B.val.IsAlt=decide C.val.IsAlt := h
      by_cases hb : B.val.IsAlt <;> by_cases hc : C.val.IsAlt <;> simp_all
    apply Quotient.sound
    by_cases hb : B.val.IsAlt
    · exact Mathproof.Problem18AlternatingClassification20260930.alternating_isometry_of_finrank_eq
        B.val C.val hb (he.mp hb) B.property.2 C.property.2 rfl
    · exact Mathproof.Problem18CharTwoNonalternating20260930.nonalternating_isometry_of_finrank_eq
        B.val C.val B.property.1 C.property.1 B.property.2 C.property.2 hb
