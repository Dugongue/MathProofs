      val_setVar F canonical (show tw.pS≠q.WS by decide),val_setVar F canonical (show tw.qS≠q.WS by decide)]
  have hinit₁ : Run B (.assign tw.Nr (.var q.n)) ξ ξ₁ 2 :=
    Run.assign (by simpa only [hnξ] using evalB_var (B:=B) (σ:=ξ) (x:=q.n) (by rw [hnξ];omega))
  have hinit₂ : Run B (.assign tw.pS (.var gReg)) ξ₁ ξ₂ 2 := by
    apply Run.assign
    have hvv : ξ₁.vars gReg=gs := by simpa only [ξ₁,vars_setVar,if_neg (by decide : gReg≠tw.Nr)] using hgsξ
    simpa only [hvv] using evalB_var (B:=B) (σ:=ξ₁) (x:=gReg) (by rw [hvv];omega)
  have hinit₃ : Run B (.assign tw.qS (.var outReg)) ξ₂ ξ₃ 2 := by
