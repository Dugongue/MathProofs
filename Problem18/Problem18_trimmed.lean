variable {K E : Type*} [Field K] [CommRing E] [Algebra K E] [FiniteDimensional K E]
noncomputable def traceCoefficient (htr : (Algebra.traceForm K E).Nondegenerate)
    (B : LinearMap.BilinForm K E) : E :=
  ((Algebra.traceForm K E).toDual htr).symm (B 1)
theorem traceCoefficient_spec (htr : (Algebra.traceForm K E).Nondegenerate)
    (B : LinearMap.BilinForm K E) (x : E) :
    Algebra.trace K E (traceCoefficient htr B*x)=B 1 x :=
  LinearMap.BilinForm.apply_toDual_symm_apply (B:=Algebra.traceForm K E) (B 1) x
theorem balanced_trace_representation (htr : (Algebra.traceForm K E).Nondegenerate)
    (B : LinearMap.BilinForm K E) (hbal : ∀ t x y,B (t*x) y=B x (t*y)) (x y : E) :
    B x y=Algebra.trace K E (traceCoefficient htr B*x*y) := by
  have h := hbal x 1 y
  rw [mul_one] at h
  rw [h,← traceCoefficient_spec htr B (x*y),mul_assoc]
theorem trace_coefficient_ext (htr : (Algebra.traceForm K E).Nondegenerate) (c d : E)
    (h : ∀ x,Algebra.trace K E (c*x)=Algebra.trace K E (d*x)) : c=d := by
  apply ((Algebra.traceForm K E).toDual htr).injective
  ext x
  exact h x
theorem balanced_trace_coefficient_units
    (htr : (Algebra.traceForm K E).Nondegenerate) (B : LinearMap.BilinForm K E)
    (hbal : ∀ t x y,B (t*x) y=B x (t*y)) (hn : B.Nondegenerate) :
    ∃! c : Eˣ,∀ x y,B x y=Algebra.trace K E ((c:E)*x*y) := by
  let c := traceCoefficient htr B
  have hi : Function.Injective (LinearMap.mulLeft K c) := by
    apply (injective_iff_map_eq_zero (LinearMap.mulLeft K c)).mpr
    intro x hx
    apply hn.1
    intro y
    rw [balanced_trace_representation htr B hbal]
    change Algebra.trace K E ((c*x)*y)=0
    change c*x=0 at hx
    rw [hx,zero_mul,map_zero]
  obtain ⟨z,hz⟩ := LinearMap.injective_iff_surjective.mp hi (1:E)
  change c*z=1 at hz
  let u : Eˣ := ⟨c,z,hz,by rw [mul_comm]; exact hz⟩
  refine ⟨u,?_,?_⟩
  · exact balanced_trace_representation htr B hbal
  · intro v hv
    apply Units.ext
    apply trace_coefficient_ext htr
    intro x
    simpa only [mul_one] using (hv x 1).symm.trans (balanced_trace_representation htr B hbal x 1)
theorem balanced_of_generator (B : LinearMap.BilinForm K E) (t : E)
    (ht : Algebra.adjoin K ({t}:Set E)=⊤) (hadj : ∀ x y,B (t*x) y=B x (t*y)) :
    ∀ z x y,B (z*x) y=B x (z*y) := by
  intro z
  have hz : z∈Algebra.adjoin K ({t}:Set E) := by rw [ht]; trivial
  induction hz using Algebra.adjoin_induction with
  | mem z hz =>
    have he : z=t := Set.mem_singleton_iff.mp hz
    subst z
    exact hadj
  | algebraMap r =>
    intro x y
    simp only [← Algebra.smul_def,map_smul,LinearMap.smul_apply]
  | add u v hu hv ihu ihv =>
    intro x y
    simp only [add_mul,map_add,LinearMap.add_apply,ihu,ihv]
  | mul u v hu hv ihu ihv =>
    intro x y
    rw [mul_assoc,ihu,ihv]
    congr 1
    ring
end
end Mathproof.Problem18EtaleTraceCoefficient20260930
