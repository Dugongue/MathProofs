theorem bitSize_facts (F : FieldPresentation K) (cutoff : Nat) (u : Bool) (q : Nat)
    {a b c : Nat} (A : RectTensor a b c K) :
    10+F.e+a*b*c*F.e ≤ Lax51.BinaryWordEncoding.bitSize (routedSourceWords F cutoff u q A) ∧
    F.p.size+1 ≤ Lax51.BinaryWordEncoding.bitSize (routedSourceWords F cutoff u q A) ∧
    q.size+1 ≤ Lax51.BinaryWordEncoding.bitSize (routedSourceWords F cutoff u q A) ∧
    F.p ∈ routedSourceWords F cutoff u q A ∧ q ∈ routedSourceWords F cutoff u q A := by
  have hlen := Lax51Proofs.Encoding.length_le_bitSize (routedSourceWords F cutoff u q A)
  rw [routedSourceWords_length] at hlen
  have hpm : F.p ∈ routedSourceWords F cutoff u q A := by simp [routedSourceWords]
  have hqm : q ∈ routedSourceWords F cutoff u q A := by simp [routedSourceWords]
  have hp := Lax51Proofs.Encoding.bits_length_add_one_le_bitSize_of_mem hpm
  have hq := Lax51Proofs.Encoding.bits_length_add_one_le_bitSize_of_mem hqm
  rw [Nat.size_eq_bits_len] at hp hq
  exact ⟨hlen,hp,hq,hpm,hqm⟩
