    PointInput F canonical B σ where
  degree := h.degree
  prime := h.prime
  names := canonical_names_ne_i
  degree_word := e_lt F h
  arithmetic_word := arith F h
  memory_word := h.memory_word
  first_fits := by rw [h.degree]; exact h.first_fit
  second_fits := by rw [h.degree]; exact h.second_fit
  output_fits := by rw [h.degree]; exact h.output_fit
  first_disjoint := by rw [h.degree]; exact h.first_disjoint
  second_disjoint := by rw [h.degree]; exact h.second_disjoint
  first_canonical := h.first_canonical
  second_canonical := h.second_canonical
