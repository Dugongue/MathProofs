theorem preservingSample_probability_le_crossZero
    (B : LinearMap.BilinForm K V) (hB : B.Nondegenerate)
    (eps : K) (heps : eps ^ 2 = 1)
    (W : Submodule K V) {k z m : ℕ}
    (E : (Fin (k + z) → K) →ₗ[K] V)
    (hE : Function.Injective E)
    (hw : ∀ i, leftTestVector E i ∈ W)
    (hv : ∀ l, RightOrthogonalTo B W (rightTestVector E l)) :
    (Nat.card {u : Fin m → V × V //
        Preserves W (∑ j,
          Mathproof.Problem18AnchorBilinear20260930.anchorPair
            B eps (u j).1 (u j).2)} : ℝ) /
        Nat.card (Fin m → V × V) ≤
      (Nat.card (CrossZeroPairs (K := K) k (m + m) z) : ℝ) /
        Nat.card
          (Matrix (Fin k) (Fin (m + m)) K ×
            Matrix (Fin z) (Fin (m + m)) K) := by
  have hnat := preservingSample_card_mul_le_crossZero (m := m)
    B hB eps heps W E hE hw hv
  have hsampNat : 0 < Nat.card (Fin m → V × V) := Nat.card_pos
  have hsamp :
      (0 : ℝ) < Nat.card (Fin m → V × V) := by exact_mod_cast hsampNat
  have hmatNat :
      0 < Nat.card
        (Matrix (Fin k) (Fin (m + m)) K ×
          Matrix (Fin z) (Fin (m + m)) K) := Nat.card_pos
  have hmat :
      (0 : ℝ) <
