variable {A : Type*} [Monoid A]
def bitsValue : List Bool → ℕ
  | [] => 0
  | b :: bs => Nat.bit b (bitsValue bs)
theorem bitsValue_bits (n : ℕ) : bitsValue n.bits = n := by
  induction n using Nat.binaryRec' with
  | zero => rfl
  | bit b n hn ih =>
    rw [Nat.bits_append_bit n b hn]
    simp only [bitsValue, ih]
def powBits (x : A) : List Bool → A × ℕ
  | [] => (1, 0)
  | b :: bs =>
    let r := powBits x bs
    if b then (r.1 * r.1 * x, r.2 + 2)
    else (r.1 * r.1, r.2 + 1)
theorem powBits_correct (x : A) (bs : List Bool) :
    (powBits x bs).1 = x ^ bitsValue bs := by
  induction bs with
  | nil => simp [powBits, bitsValue]
  | cons b bs ih =>
    cases b <;>
      simp [powBits, bitsValue, Nat.bit_val, ih, Nat.mul_comm 2, pow_add, pow_mul, pow_two]
theorem powBits_cost (x : A) (bs : List Bool) :
    (powBits x bs).2 ≤ 2 * bs.length := by
  induction bs with
  | nil => simp [powBits]
  | cons b bs ih =>
    cases b <;> simp only [powBits, Bool.false_eq_true, ↓reduceIte,
      Bool.true_eq, List.length_cons] <;> omega
def binaryPower (x : A) (n : ℕ) : A × ℕ := powBits x n.bits
@[simp] theorem binaryPower_correct (x : A) (n : ℕ) :
    (binaryPower x n).1 = x^n := by
  rw [binaryPower, powBits_correct, bitsValue_bits]
theorem binaryPower_cost (x : A) (n : ℕ) :
    (binaryPower x n).2 ≤ 2 * n.size := by
  simpa only [binaryPower, Nat.size_eq_bits_len] using powBits_cost x n.bits
end Mathproof.Problem18BinaryPower20260930
