theorem perm_lt {b c i : Nat} (hb : 0 < b) (hi : i < c * (b * b)) : perm b i < c * (b * b) := by
  unfold perm
  have hbb : 0 < b * b := Nat.mul_pos hb hb
  have h1 : i / (b * b) < c := (Nat.div_lt_iff_lt_mul hbb).mpr hi
  have h2 : i % (b * b) % b < b := Nat.mod_lt _ hb
  have h3 : i % (b * b) / b < b := (Nat.div_lt_iff_lt_mul hb).mpr (Nat.mod_lt _ hbb)
  have h4 : (i % (b * b) % b) * b + i % (b * b) / b < b * b := by nlinarith
  have h5 : i / (b * b) * (b * b) + b * b ≤ c * (b * b) := by
    have := Nat.mul_le_mul_right (b * b) (Nat.succ_le_of_lt h1)
    rw [Nat.succ_mul] at this; exact this
  omega
