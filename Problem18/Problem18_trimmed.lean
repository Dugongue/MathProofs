theorem pb_close {X a c d C D : Nat} (hX : 1 ≤ X) (h : a ≤ c*X^d) (hc : c ≤ C)
    (hd : d ≤ D) : a ≤ C*X^D :=
  h.trans (Nat.mul_le_mul hc (Nat.pow_le_pow_right hX hd))
