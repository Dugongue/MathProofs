  | cons p ps ih=>
    have hh:constantLeaves p ≤ M:=(constants_le_mass p).trans (hm p List.mem_cons_self)
    have hp:=(compileCounted_cost P d p).trans
      (Nat.add_le_add_left (Nat.mul_le_mul_right _ hh) _)
