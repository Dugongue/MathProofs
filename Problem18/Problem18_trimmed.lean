      Good F L S B σ0 τ ∧
      mat F L (σ0.vars ws) L.acc τ=mat F L (σ0.vars ws) L.acc ρ * mat F L (σ0.vars ws) L.base ρ ∧
      mat F L (σ0.vars ws) L.base τ=mat F L (σ0.vars ws) L.base ρ ∧
      τ.vars exponentReg=ρ.vars exponentReg ∧ τ.vars halfReg=ρ.vars halfReg := by
  have hsc := hok.scaled F.e
