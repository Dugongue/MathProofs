  simp [installed,s7,s6,s5,s4,s3,s2,s1,Env.setVar,
    count,baseA,baseB,strideA,strideB,acc,prod,next]
@[simp] theorem installed_baseB (sigma : Env)
    (c left right stride scratch prodAddr nextAddr : Nat) :
    (installed sigma c left right stride scratch prodAddr nextAddr).vars baseB = right := by
  simp [installed,s7,s6,s5,s4,s3,s2,s1,Env.setVar,
    count,baseA,baseB,strideA,strideB,acc,prod,next]
@[simp] theorem installed_strideA (sigma : Env)
    (c left right stride scratch prodAddr nextAddr : Nat) :
    (installed sigma c left right stride scratch prodAddr nextAddr).vars strideA = stride := by
  simp [installed,s7,s6,s5,s4,s3,s2,s1,Env.setVar,
    count,baseA,baseB,strideA,strideB,acc,prod,next]
@[simp] theorem installed_strideB (sigma : Env)
    (c left right stride scratch prodAddr nextAddr : Nat) :
    (installed sigma c left right stride scratch prodAddr nextAddr).vars strideB = 0 := by
  simp [installed,s7,s6,s5,s4,s3,s2,s1,Env.setVar,
