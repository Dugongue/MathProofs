structure Input (B : Nat) (σ : Env) : Prop where
  valid : ValidMemory F B σ
  words : ∀x∈[count,baseA,baseB,strideA,strideB],σ.vars x<B
  exponent : σ.vars canonical.exp<B
  buffers : ∀x∈[acc,prod,next],Fits F σ (σ.vars x)
  separated : Disjoint F (σ.vars acc) (σ.vars prod) ∧
    Disjoint F (σ.vars next) (σ.vars prod) ∧ Disjoint F (σ.vars next) (σ.vars acc)
  modulus : ∀x∈[acc,prod,next],Disjoint F (σ.vars x) (σ.vars canonical.modBase)
  leftFits : ∀i<σ.vars count,Fits F σ (address F σ baseA strideA i)
  rightFits : ∀i<σ.vars count,Fits F σ (address F σ baseB strideB i)
  leftSeparate : ∀i<σ.vars count,∀x∈[acc,prod,next],
    Disjoint F (σ.vars x) (address F σ baseA strideA i)
  rightSeparate : ∀i<σ.vars count,∀x∈[acc,prod,next],
    Disjoint F (σ.vars x) (address F σ baseB strideB i)
def Outside (σ : Env) (j : Nat) : Prop :=
  ∀x∈[acc,prod,next],j<σ.vars x ∨ σ.vars x+F.e≤j
def MemoryFrame (σ τ : Env) : Prop :=
  ∀j<(σ.arrs canonical.mem).length,Outside F σ j →
    (τ.arrs canonical.mem).getD j 0=(σ.arrs canonical.mem).getD j 0
def Frame (σ τ : Env) : Prop :=
  (∀x,x≠index → x∉callRegisters → τ.vars x=σ.vars x) ∧
  (∀arr,arr≠canonical.mem → arr≠canonical.scratch → τ.arrs arr=σ.arrs arr) ∧
  (∀arr,(τ.arrs arr).length=(σ.arrs arr).length) ∧ τ.inp=σ.inp ∧ τ.out=σ.out
theorem frame_refl (σ : Env) : Frame σ σ :=
  ⟨fun _ _ _=>rfl,fun _ _ _=>rfl,fun _=>rfl,rfl,rfl⟩
theorem frame_trans {σ τ ξ : Env} (h : Frame σ τ) (h' : Frame τ ξ) : Frame σ ξ := by
  exact ⟨fun x hx hs=>(h'.1 x hx hs).trans (h.1 x hx hs),
    fun a hm hs=>(h'.2.1 a hm hs).trans (h.2.1 a hm hs),
    fun a=>(h'.2.2.1 a).trans (h.2.2.1 a),
    h'.2.2.2.1.trans h.2.2.2.1,h'.2.2.2.2.trans h.2.2.2.2⟩
theorem frame_of_call {σ τ : Env} (h : CallPreserves σ τ) : Frame σ τ :=
  ⟨fun x _ hx=>h.1 x hx,h.2⟩
theorem frame_setIndex (σ : Env) (i : Nat) : Frame σ (σ.setVar index i) := by
  refine ⟨?_,fun _ _ _=>rfl,fun _=>rfl,rfl,rfl⟩
  intro x hx _
  simp [Env.setVar,hx]
theorem frame_register {σ τ : Env} (h : Frame σ τ) (x : String)
    (hx : x∈[acc,prod,next,count,baseA,baseB,strideA,strideB,canonical.modBase,canonical.exp]) :
    τ.vars x=σ.vars x := by
  simp only [List.mem_cons,List.not_mem_nil,or_false] at hx
  rcases hx with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl <;>
    exact h.1 _ (by decide) (by decide)
theorem memoryFrame_read {σ τ : Env} (hm : MemoryFrame F σ τ) (a : Nat)
    (ha : Fits F σ a) (hs : ∀x∈[acc,prod,next],Disjoint F (σ.vars x) a) :
    slice F τ canonical a=slice F σ canonical a := by
  funext i
  apply hm
  · have hi:=i.isLt; unfold Fits at ha; omega
  · intro x hx
    have hh:=hs x hx; have hi:=i.isLt
    rcases hh with hh|hh <;> omega
def term (σ : Env) (i : Nat) : K :=
  decode F (slice F σ canonical (address F σ baseA strideA i))*
    decode F (slice F σ canonical (address F σ baseB strideB i))
structure Invariant (B : Nat) (σ τ : Env) : Prop where
  valid : ValidMemory F B τ
  frame : Frame σ τ
  memory : MemoryFrame F σ τ
