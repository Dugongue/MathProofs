      (Problem18IMPBoundaryDispatchAdapter20261002.boundaryGram false 0
        (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
          (sortOrder a b c) T hA.first)) = true)
    (hsrc : Problem18BoundaryBooleanChecks20260930.orthogonalSourceCheck
      (Problem18DimensionOneBoundary20260930.matrixOf
        (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
          (sortOrder a b c) A hA.first)) = true) :
    ∃ τ, Run B charTwoMode σ τ (coreCost F (boundaryWidth a b c) (boundaryHeight a b c) a b c) ∧
      (τ.vars modeResult = 0 ∨ τ.vars modeResult = 1) ∧
      (τ.vars modeResult = 1 ↔ Problem18CharTwoBooleanQuery20261001.queryCheck
        (Problem18DimensionOneBoundary20260930.matrixOf
          (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
            (sortOrder a b c) A hA.first))
        (Problem18DimensionOneBoundary20260930.matrixOf
          (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
            (sortOrder a b c) T hA.first)) = true) ∧
      (∀ a', a' ≠ modeMem → a' ≠ spanMem → a' ≠ canonical.scratch → τ.arrs a' = σ.arrs a') ∧
      (∀ x, x ∉ scalarWrites charTwoMode → τ.vars x = σ.vars x) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
