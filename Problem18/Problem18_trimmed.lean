    (Submodule.span K ((vecOf n (secDeg d)) '' {f | f ∈ fs}))
  have hinj : Function.Injective S := by
    intro j j' hjj
    have h1 := hS j j
    have h2 := hS j j'
    rw [← hjj, h1] at h2
