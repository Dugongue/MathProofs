  apply Submodule.span_mono
  rintro z ⟨f,hf,p,hp,rfl⟩
  exact ⟨f,hf,p,hp.trans h,rfl⟩
theorem generator_mem_macaulaySpan (F : Set (MvPolynomial (Fin N) K))
