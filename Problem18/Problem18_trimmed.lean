theorem coordinate_field_degree
    (G : Finset (MvPolynomial (Fin n) L)) (d : Nat)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hdim : DimLE G 1 1)
    (P : Ideal (MvPolynomial (Fin n) L)) [P.IsPrime]
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes)
    (hfix : P.comap (MvPolynomial.map
      (FiniteField.frobeniusAlgEquivOfAlgebraic K L).toRingEquiv.toRingHom) = P)
    (i : Fin n) (ht : Transcendental K (coordinate (K := K) P i)) :
    parameterDegree (K := K) (coordinate (K := K) P i) ≤
      (coefficientBound n d) ^ n := by
  simpa only [parameterDegree, Fintype.card_fin] using
    Problem18BivariateFieldDegree20261001.degree_le_of_bivariate_relations
    (coordinate (K := K) P) _ ht (coefficientBound n d)
    (Problem18FixedCurveOriginalCoordinate20261001.coordinate_adjoin_eq_top P)
    (coordinate_bivariate_relations G d hG hdim P hP hfix i ht)
