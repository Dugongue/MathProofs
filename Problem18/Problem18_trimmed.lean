  rw [hr]
  apply m.degree_sub_le.trans
  apply sup_le le_rfl
  apply (degree_linearCombination_le_representationDegree m b q).trans
  exact Finset.sup_le (fun i _ => hq i)
theorem sPolynomial_totalDegree_le (f g : MvPolynomial (Fin N) K) :
