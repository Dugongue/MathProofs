attribute [-instance] FunLike.toDecidableEq CommSemiRingCat.FilteredColimits.colimitCommSemiring AddMonoidAlgebra.instHopfAlgebraStruct AddMonoidAlgebra.instBialgebra Bialgebra.toAlgebra
namespace Mathproof.Problem18FinalFactor20260930
open Matrix
open Problem18OrthogonalAssembly
open Problem18FiniteSymmetricRecovery20260929
open Problem18MarkedRecovery20260929
variable {K : Type*} [Field K] [Fintype K]
noncomputable def standardForm (n : ℕ) : LinearMap.BilinForm K (Fin n → K) :=
  (1 : Matrix (Fin n) (Fin n) K).toBilin'
theorem standardForm_nondegenerate (n : ℕ) :
    (standardForm (K := K) n).Nondegenerate :=
  LinearMap.BilinForm.nondegenerate_toBilin'_iff_det_ne_zero.mpr (by simp)
theorem standardForm_symm (n : ℕ) : (standardForm (K := K) n).IsSymm :=
  Matrix.isSymm_toBilin'_iff_isSymm.mpr Matrix.isSymm_one
noncomputable def standardMarker (n : ℕ) : Fin n → K :=
  recoveryMarker (standardForm n) (standardForm_nondegenerate n) (standardForm_symm n)
theorem standardForm_pullback_matrix {n : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]
    (C : Matrix (Fin n) ι K) :
    ((standardForm n).comp C.toLin' C.toLin').toMatrix' = C.transpose * C := by
  simp [standardForm, LinearMap.BilinForm.toMatrix'_comp]
noncomputable def orthogonalEquiv {n : ℕ} (R : Matrix (Fin n) (Fin n) K)
    (hR : IsOrthogonal R) : (Fin n → K) ≃ₗ[K] (Fin n → K) :=
  { R.toLin' with
    invFun := R.transpose.toLin'
    left_inv := by
      intro x
      change R.transpose *ᵥ (R *ᵥ x) = x
      rw [Matrix.mulVec_mulVec, (show R.transpose * R = 1 from hR), Matrix.one_mulVec]
    right_inv := by
      intro x
      change R *ᵥ (R.transpose *ᵥ x) = x
      rw [Matrix.mulVec_mulVec, (show R * R.transpose = 1 from mul_eq_one_comm.mp hR), Matrix.one_mulVec] }
theorem orthogonalEquiv_preserves {n : ℕ} (R : Matrix (Fin n) (Fin n) K)
    (hR : IsOrthogonal R) (x y : Fin n → K) :
    standardForm n (orthogonalEquiv R hR x) (orthogonalEquiv R hR y) =
      standardForm n x y := by
  have hp : (standardForm n).comp R.toLin' R.toLin' = standardForm n := by
    apply LinearMap.BilinForm.toMatrix'.injective
    rw [standardForm_pullback_matrix]
    simpa [standardForm, IsOrthogonal] using hR
  exact LinearMap.congr_fun (LinearMap.congr_fun hp x) y
theorem final_orthogonal_factor_iff {n : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]
    (C D : Matrix (Fin n) ι K) :
    (∃ R : Matrix (Fin n) (Fin n) K, IsOrthogonal R ∧ R*C = D) ↔
      LinearMap.ker (augment C.toLin' (standardMarker n)) =
        LinearMap.ker (augment D.toLin' (standardMarker n)) ∧
      C.transpose*C = D.transpose*D := by
  have hw := finite_symmetric_recovery_iff (standardForm n)
    (standardForm_nondegenerate n) (standardForm_symm n) C.toLin' D.toLin'
  have hg : (∀ x y, standardForm n (C.toLin' x) (C.toLin' y) =
      standardForm n (D.toLin' x) (D.toLin' y)) ↔
      C.transpose*C = D.transpose*D := by
    constructor
    · intro h
      have he : (standardForm n).comp C.toLin' C.toLin' =
          (standardForm n).comp D.toLin' D.toLin' := by
        apply LinearMap.ext
        intro x
        apply LinearMap.ext
        intro y
        exact h x y
      have he' := congrArg LinearMap.BilinForm.toMatrix' he
      simpa only [standardForm_pullback_matrix] using he'
    · intro h
      have he : (standardForm n).comp C.toLin' C.toLin' =
          (standardForm n).comp D.toLin' D.toLin' := by
        apply LinearMap.BilinForm.toMatrix'.injective
        simpa only [standardForm_pullback_matrix] using h
      intro x y
      exact LinearMap.congr_fun (LinearMap.congr_fun he x) y
  rw [hg] at hw
  dsimp only [standardMarker]
  rw [← hw]
  constructor
  · rintro ⟨R, hR, hRD⟩
    refine ⟨orthogonalEquiv R hR, ?_, orthogonalEquiv_preserves R hR⟩
    intro x
    change R *ᵥ (C *ᵥ x) = D *ᵥ x
    rw [Matrix.mulVec_mulVec, hRD]
  · rintro ⟨Q, hQ, hform⟩
    let R := Q.toLinearMap.toMatrix'
    have he : (standardForm n).comp Q.toLinearMap Q.toLinearMap = standardForm n := by
      apply LinearMap.ext
      intro x
      apply LinearMap.ext
      intro y
      exact hform x y
    have hR : IsOrthogonal R := by
      have he' := congrArg LinearMap.BilinForm.toMatrix' he
      simpa [standardForm, LinearMap.BilinForm.toMatrix'_comp, R, IsOrthogonal] using he'
    refine ⟨R, hR, ?_⟩
    apply Matrix.toLin'.injective
    rw [Matrix.toLin'_mul]
    change (Matrix.toLin' Q.toLinearMap.toMatrix').comp C.toLin' = D.toLin'
    rw [Matrix.toLin'_toMatrix']
    apply LinearMap.ext
    intro x
    exact hQ x
theorem rect_orthogonal_marked_gram_criterion {a b c : ℕ}
    (A B : RectTensor a b c K) :
    RectOrthogonalEquivalent A B ↔
    ∃ (P : Matrix (Fin a) (Fin a) K) (Q : Matrix (Fin b) (Fin b) K),
      IsOrthogonal P ∧ IsOrthogonal Q ∧
      LinearMap.ker (augment (A * (Matrix.kronecker P Q).transpose).toLin'
        (standardMarker c)) = LinearMap.ker (augment B.toLin' (standardMarker c)) ∧
      (A * (Matrix.kronecker P Q).transpose).transpose *
        (A * (Matrix.kronecker P Q).transpose) = B.transpose*B := by
  constructor
  · rintro ⟨P, Q, R, hP, hQ, hR, hact⟩
    refine ⟨P, Q, hP, hQ, ?_⟩
    apply (final_orthogonal_factor_iff _ B).mp
    refine ⟨R, hR, ?_⟩
    simpa only [rectAction, Matrix.mul_assoc] using hact
  · rintro ⟨P, Q, hP, hQ, hker, hgram⟩
    obtain ⟨R, hR, hact⟩ := (final_orthogonal_factor_iff
      (A * (Matrix.kronecker P Q).transpose) B).mpr ⟨hker, hgram⟩
    refine ⟨P, Q, R, hP, hQ, hR, ?_⟩
    simpa only [rectAction, Matrix.mul_assoc] using hact
end Mathproof.Problem18FinalFactor20260930
