  [Fintype K] [Fintype E] [FiniteDimensional K E] [Algebra.IsSeparable K E]
  {n : ℕ}
theorem weighted_commuting_probability_le
    (τ : K ≃+* K) (σ : E ≃+* E) (eps : K)
    (hcompat : (algebraMap K E).comp (τ : K →+* K) =
      (σ : E →+* E).comp (algebraMap K E))
    (hσ : Function.Involutive σ)
    (ρ₀ : E →ₐ[K] Module.End K (Fin n → K))
    (B : (Fin n → K) →ₛₗ[(τ : K →+* K)] (Fin n → K) →ₗ[K] K)
    (hB : B.Nondegenerate) (hsym : ∀ x y, B y x = eps * τ (B x y))
    {S : Type*} [Fintype S]
    (sample : S → Module.End K (Fin n → K)) (hsample : Function.Injective sample)
    (hself : ∀ s x y, B (sample s x) y = B x (sample s y))
    (hsize : (Fintype.card K : ℝ)^(n.choose 2) ≤ Fintype.card S) :
    letI := Fintype.ofFinite (CompatibleEmbedding σ (fun x y => B x y))
    (∑ ρ : CompatibleEmbedding σ (fun x y => B x y),
      (Nat.card {s : S // ∀ a x, sample s (ρ.1 a x) = ρ.1 a (sample s x)} : ℝ) /
        Fintype.card S) ≤ 16 * (Fintype.card K : ℝ)^(2*n) := by
  classical
  letI : Fintype (CompatibleEmbedding σ (fun x y => B x y)) := Fintype.ofFinite _
  letI : Finite (Module.End K (Fin n → K)) :=
    Finite.of_injective (fun T : Module.End K (Fin n → K) => (T : _ → _))
      DFunLike.coe_injective
  let Fiber := fun ρ : CompatibleEmbedding σ (fun x y => B x y) =>
    {s : S // ∀ a x, sample s (ρ.1 a x) = ρ.1 a (sample s x)}
  have hf (ρ : CompatibleEmbedding σ (fun x y => B x y)) :
      Nat.card (Fiber ρ) ≤ Nat.card (CommutingSelfAdjoint τ B ρ.1) := by
    let f : Fiber ρ → CommutingSelfAdjoint τ B ρ.1 := fun s =>
      ⟨sample s.1, hself s.1, s.2⟩
    apply Nat.card_le_card_of_injective f
    intro s t h
    apply Subtype.ext
    apply hsample
    exact congrArg Subtype.val h
  have hsum : (∑ ρ : CompatibleEmbedding σ (fun x y => B x y),
      (Nat.card (Fiber ρ) : ℝ)) ≤ Nat.card (CompatiblePair τ σ B) := by
    have hnat : (∑ ρ : CompatibleEmbedding σ (fun x y => B x y),
        Nat.card (Fiber ρ)) ≤ Nat.card (CompatiblePair τ σ B) := by
      change _ ≤ Nat.card ((ρ : CompatibleEmbedding σ (fun x y => B x y)) × _)
      rw [Nat.card_sigma]
      exact Finset.sum_le_sum (fun ρ _ => hf ρ)
    exact_mod_cast hnat
  have hq : (0 : ℝ) < Fintype.card K := by positivity
  change (∑ ρ : CompatibleEmbedding σ (fun x y => B x y),
    (Nat.card (Fiber ρ) : ℝ) / Fintype.card S) ≤ _
  rw [← Finset.sum_div]
  calc
    _ ≤ (Nat.card (CompatiblePair τ σ B) : ℝ) / Fintype.card S :=
      div_le_div_of_nonneg_right hsum (by positivity)
    _ ≤ (Nat.card (CompatiblePair τ σ B) : ℝ) /
        (Fintype.card K : ℝ)^(n.choose 2) :=
      div_le_div_of_nonneg_left (by positivity) (pow_pos hq _) hsize
    _ ≤ _ := compatiblePair_normalized_le τ σ eps hcompat hσ ρ₀ B hB hsym
theorem weighted_commuting_probability_bound
    (τ : K ≃+* K) (σ : E ≃+* E) (eps : K)
    (hcompat : (algebraMap K E).comp (τ : K →+* K) =
      (σ : E →+* E).comp (algebraMap K E))
    (hσ : Function.Involutive σ)
    (B : (Fin n → K) →ₛₗ[(τ : K →+* K)] (Fin n → K) →ₗ[K] K)
    (hB : B.Nondegenerate) (hsym : ∀ x y, B y x = eps * τ (B x y))
    {S : Type*} [Fintype S]
    (sample : S → Module.End K (Fin n → K)) (hsample : Function.Injective sample)
    (hself : ∀ s x y, B (sample s x) y = B x (sample s y))
    (hsize : (Fintype.card K : ℝ)^(n.choose 2) ≤ Fintype.card S) :
    letI := Fintype.ofFinite (CompatibleEmbedding σ (fun x y => B x y))
    (∑ ρ : CompatibleEmbedding σ (fun x y => B x y),
      (Nat.card {s : S // ∀ a x, sample s (ρ.1 a x) = ρ.1 a (sample s x)} : ℝ) /
        Fintype.card S) ≤ 16 * (Fintype.card K : ℝ)^(2*n) := by
  classical
  by_cases he : Nonempty (E →ₐ[K] Module.End K (Fin n → K))
  · exact weighted_commuting_probability_le τ σ eps hcompat hσ he.some
      B hB hsym sample hsample hself hsize
  · letI : IsEmpty (E →ₐ[K] Module.End K (Fin n → K)) := not_nonempty_iff.mp he
    simp only [Finset.univ_eq_empty, Finset.sum_empty]
    positivity
end Mathproof.Problem18WeightedCommutant20260930
end
