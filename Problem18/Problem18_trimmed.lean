  obtain ⟨τ,hfinish,hresult⟩:=finish_pair_run F μ
    ((rootCoordinates F d a).1:K) ((rootCoordinates F d a).2:K) hvalid
    (by rw [hptr,hlen]; omega)
    (by rw [hptr]; exact hx)
    (by rw [hptr]; convert hy using 1 <;> congr 2 <;> omega)
  refine ⟨τ,(append_loader hload (hr.seq hfinish)).mono (by omega),?_⟩
  simpa only [hout,List.nil_append] using hresult
theorem coordinate_program_cost_le [Fintype K] {L q : Nat}
    (he : F.e≤L) (hp : F.p.size≤L) (hq : q.size≤L) :
    260*(F.e+1)+coordinateCost F q≤20000000*(L+1)^4 := by
  have hpow:=primitive_cost_le F .power he hp hq
  have hinv:=primitive_cost_le F .inverse he hp hq
  have hmul:=primitive_cost_le F .multiply he hp hq
  have hcopy:=primitive_cost_le F (.point .copy) he hp hq
  have hL4 : L+1≤(L+1)^4 := by
    have hh : (L+1)^1≤(L+1)^4 := Nat.pow_le_pow_right (by omega) (by decide)
    simpa only [pow_one] using hh
  rw [coordinateCost_formula]
  simp only [Primitive.cost] at hpow hinv hmul hcopy
  nlinarith only [hpow,hinv,hmul,hcopy,he,hL4]
theorem coordinate_imp_uniform_run [Fintype K] {q : Nat} (d : UnitaryFieldData (K:=K) q)
    (a b : K) :
    let xs:=fieldInput F a b q
    let L:=bitSize xs
    ∃τ,Run (2^(100*(L+1)^2+L+1)) (fieldProgram .coordinates)
      (initialState F a b q) τ (20000000*(L+1)^4) ∧
      τ.out=coefficients F ((rootCoordinates F d a).1:K)++
        coefficients F ((rootCoordinates F d a).2:K) := by
  obtain ⟨hmem,hq,harith,hinv⟩:=input_word_conditions F a b q
  obtain ⟨τ,hr,hout⟩:=coordinate_program_run F d a b _ hmem hq harith hinv
  obtain ⟨he,hp,hqsize⟩:=input_parameters_le F a b q
