    (G : Matrix (Fin (a*b)) (Fin (a*b)) K) (Tm : Matrix (Fin (a*b)) (Fin c) K)
    (Sm : Matrix (Fin c) (Fin (a*b)) K) (hG : G = Tm * Sm)
    (hT : ∀ x k, Tm x k = (A k (gramIndex rfl x))^(adjointExp u q))
    (hS : ∀ k y, Sm k y = A k (gramIndex rfl y)) :
    ∀ x y : Fin (a*b), G x y =
      (Problem18LargeRootPredicate20261001.rawAdjoint u q A * A)
        (gramIndex rfl x) (gramIndex rfl y) := by
  intro x y
  rw [hG, Matrix.mul_apply, Matrix.mul_apply]
  apply Finset.sum_congr rfl
  intro k _
  rw [hT, hS]
