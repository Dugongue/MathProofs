  have ra : Run B (.assign sbR (Sz.expr sbA)) ρ ρa (1 + (Sz.expr sbA).size) := Run.assign ev1
  have hva : ValidMemory F B ρa :=
    Problem18IMPMatrixDot20261001.validMemory_setVar F hv sbR _ (by decide) (by decide) (by decide)
  have Lx : ∀ sb : Nat, sb + F.e*xN n d + F.e*(d*n) ≤ sb + F.e*sideN n d := fun sb =>
    lay _ _ _ _ _ (by simp only [sideN, k2N, tN, gN, utN, k1N, uN, wN, sN]; omega)
  have hlenS : F.e + 1 + F.e*sideN n d + F.e*sideN n d ≤ (ρ.arrs canonical.mem).length := by
    have := hlen; unfold charTwoMemLen at this; omega
  have hgA := gatherA_spec F (sb := F.e+1) A ρa (gatherInput_setSb F hA _) hWA.x
    (by show ρ.vars canonical.modBase + F.e ≤ _; rw [hmod0]; omega)
    (by simp only [← hndef, ← hddef]; have := Lx (F.e+1); show _ ≤ (ρ.arrs canonical.mem).length; omega)
  obtain ⟨gs, gr, gw, ga⟩ := gatherA_facts
  obtain ⟨τA, rA, vA, gA', tA', oA', xA', kA, regA, arrA, iA, oA⟩ :=
    side_run F gatherA ρa _ hva ((vs _ _ _ (by decide)).trans hn) ((vs _ _ _ (by decide)).trans hd)
    ((vs _ _ _ (by decide)).trans he) (by simp [ρa]) (by rw [vs _ _ _ (by decide)]; exact hexp)
    (by rw [vs _ _ _ (by decide), hmod0]; omega)
    (by show _ ≤ (ρ.arrs canonical.mem).length; omega) hn0 hd0 hWA hgA gs gr gw ga
  have sideA : SideOut F n d (F.e+1) _ τA := ⟨gA', tA', oA', xA'⟩
  have hlenA : (τA.arrs canonical.mem).length = (ρ.arrs canonical.mem).length :=
    (run_frame rA).2.2.1 _
  have ev2 := Sz.expr_eval sbB (σ := τA) ((regA _ (by decide)).trans ((vs _ _ _ (by decide)).trans hn))
    ((regA _ (by decide)).trans ((vs _ _ _ (by decide)).trans hd))
    ((regA _ (by decide)).trans ((vs _ _ _ (by decide)).trans he)) (b := τA.vars sbR) rfl
    (by rw [show Sz.majorant sbB n d F.e (τA.vars sbR) = Sz.majorant sbB n d F.e 0 from rfl]
        exact hsB)
  let ρb := τA.setVar sbR (F.e + 1 + F.e*sideN n d)
  have rb : Run B (.assign sbR (Sz.expr sbB)) τA ρb (1 + (Sz.expr sbB).size) := Run.assign ev2
  have hvb : ValidMemory F B ρb :=
    Problem18IMPMatrixDot20261001.validMemory_setVar F vA sbR _ (by decide) (by decide) (by decide)
  have hregB : ∀ x ∈ sideRegs, x ≠ sbR → ρb.vars x = ρ.vars x := by
    intro x hx hx'
    rw [vs _ _ _ hx', regA x hx, vs _ _ _ hx']
  have hTb : GatherInput F B a b c tBank T ρb := by
    refine gatherInput_setSb F (gatherInput_transport F hT (fun x hx h' => ?_) ?_) _
    · rw [regA x hx, vs _ _ _ h']
    · rw [arrA _ (by decide) (by decide)]; rfl
  have hgT := gatherT_spec F (sb := F.e + 1 + F.e*sideN n d) T ρb hTb hWB.x
    (by rw [hregB _ (by decide) (by decide), hmod0]; omega)
    (by simp only [← hndef, ← hddef]; have := Lx (F.e + 1 + F.e*sideN n d)
        show _ ≤ (τA.arrs canonical.mem).length; omega)
  obtain ⟨gs', gr', gw', ga'⟩ := gatherT_facts
  obtain ⟨τB, rB, vB, gB', tB', oB', xB', kB, regB, arrB, iB, oB⟩ :=
    side_run F gatherT ρb _ hvb ((hregB _ (by decide) (by decide)).trans hn)
    ((hregB _ (by decide) (by decide)).trans hd) ((hregB _ (by decide) (by decide)).trans he)
    (by simp [ρb]) (by rw [hregB _ (by decide) (by decide)]; exact hexp)
    (by rw [hregB _ (by decide) (by decide), hmod0]; omega)
    (by show _ ≤ (τA.arrs canonical.mem).length; omega)
    hn0 hd0 hWB hgT gs' gr' gw' ga'
  have hrun : Run B sides ρ τB (sidesCost F n d a b c) := ra.seq (rA.seq (rb.seq rB))
  refine ⟨τB, hrun, vB, sideOut_keep F sideA (keep_mono kB (by omega) (by simp only [← hndef, ← hddef]; omega)),
    ⟨gB', tB', oB', xB'⟩, ?_, ?_, ?_, (run_frame hrun).1, ?_, ?_⟩
  · intro x hx hx'
    rw [regB x hx]; exact hregB x hx hx'
  · intro a' h1 h2
    rw [arrB a' h1 h2]; show τA.arrs a' = _; rw [arrA a' h1 h2]; rfl
  · exact (run_frame hrun).2.2.1 _
  · rw [iB]; show τA.inp = _; rw [iA]; rfl
  · rw [oB]; show τA.out = _; rw [oA]; rfl
