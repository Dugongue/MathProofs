attribute [-instance] FunLike.toDecidableEq CommSemiRingCat.FilteredColimits.colimitCommSemiring AddMonoidAlgebra.instHopfAlgebraStruct AddMonoidAlgebra.instBialgebra Bialgebra.toAlgebra
namespace Mathproof.Problem18FiniteAlgebraSolver20260930
open scoped BigOperators
open Module
variable {K A : Type*} [Field K] [Fintype K] [CommRing A] [Algebra K A]
def frobeniusDefect : A →ₗ[K] A :=
  (FiniteField.frobeniusAlgHom K A).toLinearMap - LinearMap.id
@[simp] theorem frobeniusDefect_apply (x : A) :
    frobeniusDefect (K := K) x = x ^ Fintype.card K - x := rfl
theorem finite_field_fixed_descends
    {L : Type*} [Field L] [Finite L] [Algebra K L]
    (x : L) (hx : x ^ Fintype.card K = x) :
    ∃ c : K, algebraMap K L c = x := by
  apply (IsGalois.mem_range_algebraMap_iff_fixed x).mpr
  intro σ
  obtain ⟨j, rfl⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow K L).2 σ
