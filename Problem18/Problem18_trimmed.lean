theorem iterate_optionBind_none {α : Type} (f : α → Option α) (n : ℕ) :
    ((fun o : Option α => o.bind f)^[n]) none = none := by
  induction n with
  | zero => rfl
  | succ n ih =>
      rw [Function.iterate_succ_apply]
      exact ih
