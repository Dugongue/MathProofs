namespace Mathproof.Problem18IMPNaturalPower20261001
open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Problem18IMPFieldLayout20261001 Problem18IMPModularArithmetic20261001
structure Names where
  base : String
  exponent : String
  out : String
  index : String
def body (r : Names) : Com :=
  .seq (.assign r.out (.mul (.var r.out) (.var r.base)))
    (.assign r.index (.add (.var r.index) (.lit 1)))
def naturalPowerRoutine (r : Names) : Com :=
  .seq (.seq (.assign r.out (.lit 1)) (.assign r.index (.lit 0)))
    (.while (.lt (.var r.index) (.var r.exponent)) (body r))
def state (r : Names) (σ : Env) (i : Nat) : Env :=
  (σ.setVar r.out (σ.vars r.base ^ i)).setVar r.index i
theorem naturalPower_run (r : Names) {B : Nat} (σ : Env)
    (ho : r.out ≠ r.index)
    (hbase : r.base ≠ r.out ∧ r.base ≠ r.index)
    (hexp : r.exponent ≠ r.out ∧ r.exponent ≠ r.index)
    (hn : σ.vars r.exponent < B) (hp : σ.vars r.base < B)
    (hpow : ∀ i ≤ σ.vars r.exponent, σ.vars r.base ^ i < B) :
