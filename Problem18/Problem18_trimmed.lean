    (hcard : (σ.arrs capacity)[5]?=some Q) (hQ : Q < B)
    (hbank : (σ.arrs P.memoryBank).length=M) (hlayout : (σ.arrs P.layoutBank).length=7)
    (hwords : Words B canonical.mem σ) (hseven : 7 < B)
    (hapart : P.memoryBank ≠ P.layoutBank) (hcount : P.count ∉ regNames canonical) :
    ∃ τ, Run B (program P capacity) σ τ (12*M+33) ∧
      Slots F canonical names.q.WS S B (prepared P M Q σ) ∧
