  apply hb.trans
  apply mul_le_mul_of_nonneg_left _ (by norm_num)
  exact inv_anti₀ hp (pow_le_pow_right₀ hq hexp)
open Classical in
theorem low_rank_probability_le (n r : ℕ) (hrn : 2*r ≤ n) :
    ((Finset.univ.filter (fun X : Matrix (Fin n) (Fin r) K =>
      4*X.rank < 3*r)).card : ℝ) /
      Fintype.card (Matrix (Fin n) (Fin r) K) ≤
