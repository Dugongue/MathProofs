  rw [← Ideal.mem_bot, ← hjac]
  refine Ideal.mem_sInf.mpr fun m hm => ?_
  haveI : m.IsMaximal := hm.2
  obtain ⟨φ, hφ⟩ := exists_algHom_ker_eq (k := k) m
  have hprod : evalAt φ x * evalAt φ y = 0 := by rw [← map_mul, hxy, map_zero]
  rcases mul_eq_zero.mp hprod with h | h
  · exact Ideal.mul_mem_right _ _ ((hφ _).mp (coeff_eval_zero bA φ x h i))
  · exact Ideal.mul_mem_left _ _ ((hφ _).mp (coeff_eval_zero bA φ y h j))
