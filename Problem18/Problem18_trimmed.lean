theorem FState.transfer {W Sn bankLen workLen : Nat} {σ τ : Env}
    (h : FState F W Sn bankLen workLen σ) (hG : Glob F W Sn bankLen τ)
    (ht : τ.vars memTail = σ.vars memTail) (hw : (τ.arrs work).length = (σ.arrs work).length) :
    FState F W Sn bankLen workLen τ :=
