  rcases lt_trichotomy i j with hij | hij | hij
  · exact congrFun h ⟨(i, j), hij⟩
  · subst j
    have hA := A.property.self_eq_zero (Pi.single i 1)
    have hB := B.property.self_eq_zero (Pi.single i 1)
    simpa using hA.trans hB.symm
  · have hu : A.val j i = B.val j i := congrFun h ⟨(j, i), hij⟩
    have hA : -A.val i j = A.val j i := by
      simpa using A.property.neg_eq (Pi.single i 1) (Pi.single j 1)
    have hB : -B.val i j = B.val j i := by
      simpa using B.property.neg_eq (Pi.single i 1) (Pi.single j 1)
    apply neg_injective
    exact hA.trans (hu.trans hB.symm)
theorem altMat_card_le [Fintype K] (n : ℕ) :
    Nat.card (AltMat n K) ≤ Nat.card K ^ (n.choose 2) := by
  calc
    Nat.card (AltMat n K) ≤
        Nat.card ({p : Fin n × Fin n // p.1 < p.2} → K) :=
      Nat.card_le_card_of_injective altToStrict altToStrict_injective
    _ = Nat.card K ^ (n.choose 2) := by
      rw [Nat.card_fun, Nat.card_eq_fintype_card
        (α := {p : Fin n × Fin n // p.1 < p.2}),
        card_strictPairs]
theorem alternating_image_card_le [Fintype K] {n r : ℕ}
    (W : Submodule K (Fin n → K)) (hW : Module.finrank K W = r) :
    Nat.card {A : AltMat n K // LinearMap.range A.val.mulVecLin ≤ W} ≤
      Nat.card (AltMat r K) := by
  classical
  obtain ⟨X, E, hXE⟩ := subspace_matrix_retraction_narrow W hW
  let S := {A : AltMat n K // LinearMap.range A.val.mulVecLin ≤ W}
  have hleft (A : S) : X * E * A.val.val = A.val.val := by
    apply Matrix.toLin'.injective
    apply LinearMap.ext
    intro v
    change (X * E * A.val.val) *ᵥ v = A.val.val *ᵥ v
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
    exact hXE _ (A.property ⟨v, rfl⟩)
  have hrec (A : S) : X * (E * A.val.val * Eᵀ) * Xᵀ = A.val.val := by
    have ha := alt_transpose_eq_neg A.val
    have hr := congrArg Matrix.transpose (hleft A)
    simp only [Matrix.transpose_mul, ha, neg_mul] at hr
    have hr'' : -(A.val.val * Eᵀ * Xᵀ) = -A.val.val := by
      simpa only [Matrix.mul_assoc] using hr
    have hr' : A.val.val * Eᵀ * Xᵀ = A.val.val := neg_injective hr''
    calc
      _ = (X * E * A.val.val) * Eᵀ * Xᵀ := by simp only [Matrix.mul_assoc]
      _ = A.val.val * Eᵀ * Xᵀ := by rw [hleft A]
      _ = A.val.val := hr'
  let f : S → AltMat r K := fun A =>
    ⟨E * A.val.val * Eᵀ, by
      have hform : (E * A.val.val * Eᵀ).toBilin' =
          A.val.val.toBilin'.comp Eᵀ.toLin' Eᵀ.toLin' := by
        symm
        simpa using Matrix.toBilin'_comp A.val.val Eᵀ Eᵀ
      rw [hform]
      exact fun x => A.val.property.self_eq_zero (Eᵀ.toLin' x)⟩
  apply Nat.card_le_card_of_injective f
  intro A B h
  apply Subtype.ext
  apply Subtype.ext
  exact (hrec A).symm.trans ((congrArg (fun H : AltMat r K =>
    X * H.val * Xᵀ) h).trans (hrec B))
theorem alternating_rank_card_le_subspaces [Fintype K] (n r : ℕ) :
    Nat.card {A : AltMat n K // A.val.rank = r} ≤
      Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = r} *
        Nat.card (AltMat r K) := by
  classical
  let S := {A : AltMat n K // A.val.rank = r}
  let G := {W : Submodule K (Fin n → K) // Module.finrank K W = r}
  let f : S → G := fun A => ⟨LinearMap.range A.val.val.mulVecLin, A.property⟩
  have hf (W : G) : Nat.card {A : S // f A = W} ≤ Nat.card (AltMat r K) := by
    let g : {A : S // f A = W} →
        {A : AltMat n K // LinearMap.range A.val.mulVecLin ≤ W.val} := fun A =>
      ⟨A.val.val, (congrArg Subtype.val A.property).le⟩
    have hg : Function.Injective g := by
      intro A B h
      apply Subtype.ext
      apply Subtype.ext
      apply Subtype.ext
      simpa only [g] using congrArg (fun z => z.val.val) h
    exact (Nat.card_le_card_of_injective g hg).trans
      (alternating_image_card_le W.val W.property)
  let : Fintype G := Fintype.ofFinite G
  have he := Fintype.card_congr (Equiv.sigmaFiberEquiv f)
  rw [Fintype.card_sigma] at he
  simp only [Nat.card_eq_fintype_card] at hf ⊢
  rw [← he]
  calc
    _ ≤ ∑ _W : G, Fintype.card (AltMat r K) := Finset.sum_le_sum (fun W _ => hf W)
    _ = _ := by simp [G]
theorem alternating_rank_count_bound [Fintype K] (n r : ℕ) (hr : r ≤ n) :
    (Nat.card {A : AltMat n K // A.val.rank = r} : ℝ) ≤
      4 * (Fintype.card K : ℝ) ^ (r * (n - r) + r.choose 2) := by
  have hs := finite_field_subspace_count_bound_four (K := K) n r hr
  have hc := altMat_card_le (K := K) r
  have hb := alternating_rank_card_le_subspaces (K := K) n r
  have hbc := hb.trans (Nat.mul_le_mul_left _ hc)
  have hbR : (Nat.card {A : AltMat n K // A.val.rank = r} : ℝ) ≤
      (Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = r} : ℝ) *
        (Fintype.card K : ℝ) ^ (r.choose 2) := by
    have hbR' : (Nat.card {A : AltMat n K // A.val.rank = r} : ℝ) ≤
        (Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = r} : ℝ) *
          (Nat.card K : ℝ) ^ (r.choose 2) := by
      exact_mod_cast hbc
    simpa only [Nat.card_eq_fintype_card] using hbR'
  calc
    _ ≤ (Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = r} : ℝ) *
        (Fintype.card K : ℝ) ^ (r.choose 2) := hbR
    _ ≤ (4 * (Fintype.card K : ℝ) ^ (r * (n-r))) *
        (Fintype.card K : ℝ) ^ (r.choose 2) :=
      mul_le_mul_of_nonneg_right hs (by positivity)
    _ = _ := by rw [mul_assoc, ← pow_add]
end Mathproof.Problem18AlternatingCounts20260930
