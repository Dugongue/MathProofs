theorem patternRun_correct {L : Type*} [Field L] [Algebra K L] [IsAlgClosed L]
    [Algebra.IsAlgebraic K L] (n d : ℕ) (pat : Σ k : ℕ, Fin k → Fin (boxSize n (cpE n d)))
    (FK : Fin (boxSize n d) → Fin (boxSize n d) → K) :
    (patternRun n d pat (flatData FK)).1 = true ↔
      ∃ U : Fin pat.1 → Fin (boxSize n (cpE n d)) → K,
        IsP n d (fun r j => algebraMap K L (FK r j)) pat.2 (fun i j => algebraMap K L (U i j)) := by
  classical
  set aL : Fin (boxSize n d * boxSize n d) → L := fun t => algebraMap K L (flatData FK t) with haL
  have hunflat : unflat aL = fun r j => algebraMap K L (FK r j) := by
    funext r j
    simp only [haL, unflat, flatData, Equiv.symm_apply_apply]
  have hholds : ∀ u : Fin (pat.1 * boxSize n (cpE n d)) → L,
      (template n d pat).Holds (Int.castRingHom L) (Fin.append aL u) ↔
        IsP n d (fun r j => algebraMap K L (FK r j)) pat.2 (unflat u) := by
    intro u
    rw [template, holds_psi, hunflat]
  have hB : {u : Fin (pat.1 * boxSize n (cpE n d)) → L |
      (template n d pat).Holds (Int.castRingHom L) (Fin.append aL u)}.Finite := by
    simp only [hholds]
    exact (isParam_finite n d _ pat.2).preimage unflat_injective.injOn
  show ((clauses (qe (template n d pat))).map fun c => clauseRun c (flatData FK)).any (·.1) = true ↔ _
  rw [List.any_eq_true]
  simp only [List.mem_map, exists_exists_and_eq_and]
  constructor
  · rintro ⟨c, hc, hrun⟩
    rw [clauseRun_correct (L := L) c _ (clause_locus_finite _ c hc _ hB)] at hrun
    obtain ⟨u, hu⟩ := hrun
    refine ⟨unflat u, ?_⟩
    have hL : (template n d pat).Holds (Int.castRingHom L)
        (Fin.append aL (fun i => algebraMap K L (u i))) := by
      rw [← qe_clauses_correct, haL, ← append_map]
      exact ⟨c, hc, (clauseHolds_map (algebraMap K L) _ c).mpr hu⟩
    rw [hholds] at hL
    exact hL
  · rintro ⟨U, hU⟩
    have hL : (template n d pat).Holds (Int.castRingHom L)
        (Fin.append aL (fun i => algebraMap K L (flatData U i))) := by
      rw [hholds]
      have : unflat (fun i => algebraMap K L (flatData U i)) = fun i j => algebraMap K L (U i j) := by
        funext i j
        simp only [unflat, flatData, Equiv.symm_apply_apply]
      rw [this]
      exact hU
    rw [← qe_clauses_correct, haL, ← append_map] at hL
    obtain ⟨c, hc, hcl⟩ := hL
    refine ⟨c, hc, ?_⟩
    rw [clauseRun_correct (L := L) c _ (clause_locus_finite _ c hc _ hB)]
    exact ⟨flatData U, (clauseHolds_map (algebraMap K L) _ c).mp hcl⟩
end FixedTest
