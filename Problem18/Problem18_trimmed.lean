theorem trace_conjugate (σ : K ≃+* K) (φ : E ≃+* E)
    (hc : ∀ a : K,φ (algebraMap K E a)=algebraMap K E (σ a)) (x : E) :
    σ (Algebra.trace K E x)=Algebra.trace K E (φ x) := by
  have he : (algebraMap K E).comp σ.toRingHom=φ.toRingHom.comp (algebraMap K E) := by
    ext a
