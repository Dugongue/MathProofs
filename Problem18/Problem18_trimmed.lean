  have h24 := mono_pow hs (show 2 ≤ 4 by norm_num)
  have h46 := mono_pow hs (show 4 ≤ 6 by norm_num)
  have h0 := mono_pow hs (show 0 ≤ 2 by norm_num)
  have hpow : s ^ 2 * s ^ 4 = s ^ 6 := by rw [← pow_add]
  simp only [pow_zero] at h0
  have h1 : M * (N + 1 + M) ≤ s ^ 2 * (3 * s ^ 4) := Nat.mul_le_mul hM (by omega)
  have h3 : s ^ 2 * (3 * s ^ 4) = 3 * s ^ 6 := by ring
  have h6 : 1 ≤ s ^ 6 := Nat.one_le_pow _ _ hs
  omega
theorem layout_facts {a b c e s : Nat} (ha : 1 ≤ a) (hab : a ≤ b) (hbc : b ≤ c)
    (hs : a + b + c + 1 = s) (he : 1 ≤ e) :
    let cw := cwOf e a b c
    a * b * c * e ≤ e * s ^ 4 ∧ e * (c * (b * b)) ≤ e * s ^ 4 ∧
    e * (b * b * (a * a)) ≤ e * s ^ 4 ∧ e * (b * b) ≤ e * s ^ 4 ∧ e ≤ e * s ^ 4 ∧
    layoutEndN a b c ≤ 10 ^ 20 * s ^ 20 ∧
    c * (b * b) ≤ s ^ 4 ∧ b * b * (a * a) ≤ s ^ 4 ∧
    b * b * (c * (b * b)) ≤ s ^ 6 ∧ a * a * (b * b * (a * a)) ≤ s ^ 6 ∧
    (b * b + 1) * Problem18IMPIntertwinerScan20261001.blockSize (c * (b * b)) (b * b) ≤ 30 * s ^ 8 ∧
    (a * a + 1) * Problem18IMPIntertwinerScan20261001.blockSize (b * b * (a * a)) (a * a) ≤
      30 * s ^ 8 ∧
    Problem18IMPIntertwinerScan20261001.blockSize (c * (b * b)) (b * b) + b * b ≤ 30 * s ^ 8 ∧
    Problem18IMPIntertwinerScan20261001.blockSize (b * b * (a * a)) (a * a) + a * a ≤ 30 * s ^ 8 ∧
    3 ≤ s := by
  intro cw
  have hs1 : 1 ≤ s := by omega
  have has : a ≤ s := by omega
  have hbs : b ≤ s := by omega
  have hcs : c ≤ s := by omega
  have p24 := mono_pow hs1 (show 2 ≤ 4 by norm_num)
  have p34 := mono_pow hs1 (show 3 ≤ 4 by norm_num)
  have p46 := mono_pow hs1 (show 4 ≤ 6 by norm_num)
  have p56 := mono_pow hs1 (show 5 ≤ 6 by norm_num)
  have p68 := mono_pow hs1 (show 6 ≤ 8 by norm_num)
  have p48 := mono_pow hs1 (show 4 ≤ 8 by norm_num)
  have p04 := mono_pow hs1 (show 0 ≤ 4 by norm_num)
  simp only [pow_zero] at p04
  have habc : a * b * c ≤ s ^ 3 := m3 has hbs hcs
  have hcbb : c * (b * b) ≤ s ^ 3 := by
    have := m3 hcs hbs hbs; nlinarith
  have hbbaa : b * b * (a * a) ≤ s ^ 4 := m4 hbs hbs has has
