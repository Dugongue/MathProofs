    ∃ τ, Run B fill σ τ (30*N+8) ∧
      (∀ k < N, (τ.arrs canonical.mem).getD (b+k) 0 = unitDigit e k) ∧
      (∀ j, (j < b ∨ b + N ≤ j) →
        (τ.arrs canonical.mem).getD j 0 = (σ.arrs canonical.mem).getD j 0) ∧
      (τ.arrs canonical.mem).length = (σ.arrs canonical.mem).length ∧
      (∀ a, a ≠ canonical.mem → τ.arrs a = σ.arrs a) ∧
      (∀ x, x ≠ fj → τ.vars x = σ.vars x) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  let I : Env → Prop := fun ρ => ρ.vars fj ≤ N ∧ ρ.vars fcnt = N ∧ ρ.vars fbase = b ∧
    ρ.vars eR = e ∧
    (ρ.arrs canonical.mem).length = (σ.arrs canonical.mem).length ∧
    (∀ a, a ≠ canonical.mem → ρ.arrs a = σ.arrs a) ∧
    (∀ k < ρ.vars fj, (ρ.arrs canonical.mem).getD (b+k) 0 = unitDigit e k) ∧
    (∀ j, (j < b ∨ b + ρ.vars fj ≤ j) →
