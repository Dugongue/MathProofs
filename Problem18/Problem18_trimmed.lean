    Nat.card {X : Matrix (Fin n) (Fin r) K //
      LinearMap.range (X*J*X.transpose).mulVecLin = W'} := by
  apply equivariant_fiber_card_eq _ _ W W' h
  intro g
  obtain ⟨hAB, hBA⟩ := equiv_matrices g
  refine ⟨leftMulEquiv _ _ hAB hBA, ?_⟩
  intro X
  have he := gram_image_congruence _ _ hBA X J
  have hlin : (LinearMap.toMatrix' g.toLinearMap).mulVecLin = g.toLinearMap := by
    apply LinearMap.ext
    intro x
    exact LinearMap.toMatrix'_mulVec _ x
  rw [hlin] at he
  exact he
theorem hermitian_gram_image_fiber_card_eq [StarRing K] {n r : ℕ}
    (J : Matrix (Fin r) (Fin r) K)
    (W W' : Submodule K (Fin n → K))
    (h : Module.finrank K W = Module.finrank K W') :
    Nat.card {X : Matrix (Fin n) (Fin r) K //
      LinearMap.range (X*J*Xᴴ).mulVecLin = W} =
    Nat.card {X : Matrix (Fin n) (Fin r) K //
      LinearMap.range (X*J*Xᴴ).mulVecLin = W'} := by
  apply equivariant_fiber_card_eq _ _ W W' h
  intro g
  obtain ⟨hAB, hBA⟩ := equiv_matrices g
  refine ⟨leftMulEquiv _ _ hAB hBA, ?_⟩
  intro X
  have he := hermitian_gram_image_congruence _ _ hBA X J
  have hlin : (LinearMap.toMatrix' g.toLinearMap).mulVecLin = g.toLinearMap := by
    apply LinearMap.ext
    intro x
