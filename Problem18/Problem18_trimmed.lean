  obtain ⟨τ1,hr1,hv1,hs1,hp1,hf1,hx1,ha1,hl1,hi1,ho1⟩ := product_call_run F L.n L.acc L.base L.out
    L.work accR baseR outR workR ρ hRρ.acc hRρ.base hRρ.out hRρ.work hRρ.n
    (by simp [layoutRegs]) (by simp [layoutRegs]) (by simp [layoutRegs]) (by simp [layoutRegs])
    hg.valid hg.slots hmb' hok.n_pos hok.acc_base (by have := hok.base_copy; have := hok.copy_out; omega)
    hok.out_work hok.work_fit
