variable {R k τ : Type*} [CommRing R] [Field k]
def polyEval {K : Type*} [CommRing K] (f : R →+* K) (x : τ → K) : PolyExpr τ R → K
  | .const r => f r
  | .var i => x i
  | .add a b => polyEval f x a + polyEval f x b
  | .mul a b => polyEval f x a * polyEval f x b
theorem polyEval_eq_interpret {K : Type*} [Field K] (f : R →+* K) (x : τ → K)
    (p : PolyExpr τ R) : polyEval f x p = interpret f x p := by
  induction p with
  | const r => rfl
  | var i => rfl
  | add a b iha ihb => simp [polyEval, interpret, iha, ihb]
  | mul a b iha ihb => simp [polyEval, interpret, iha, ihb]
theorem polyEval_hom {K K' : Type*} [CommRing K] [CommRing K'] (φ : K →+* K')
    (f : R →+* K) (x : τ → K) (p : PolyExpr τ R) :
    polyEval (φ.comp f) (φ ∘ x) p = φ (polyEval f x p) := by
  induction p with
  | const r => simp [polyEval]
  | var i => simp [polyEval]
  | add a b iha ihb => simp [polyEval, iha, ihb]
  | mul a b iha ihb => simp [polyEval, iha, ihb]
def symbolicAssignment (c : τ → k) : τ ⊕ Fin 2 → k[X][X] :=
  Sum.elim (fun i => C (C (c i))) ![C X, X]
def symbolicConst (f : R →+* k) : R →+* k[X][X] := (C.comp C).comp f
def symbolic (f : R →+* k) (c : τ → k) (p : PolyExpr (τ ⊕ Fin 2) R) : k[X][X] :=
  polyEval (symbolicConst f) (symbolicAssignment c) p
def evalPair (a b : k) : k[X][X] →+* k :=
  (evalRingHom b).comp (mapRingHom (evalRingHom a))
theorem evalPair_apply (a b : k) (Q : k[X][X]) :
    evalPair a b Q = (specialize Q a).eval b := rfl
theorem evalPair_comp_symbolicConst (f : R →+* k) (a b : k) :
    (evalPair a b).comp (symbolicConst f) = f := by
  ext r
  simp [evalPair, symbolicConst]
theorem evalPair_comp_symbolicAssignment (c : τ → k) (a b : k) :
    (evalPair a b) ∘ symbolicAssignment c = Sum.elim c ![a, b] := by
  funext i
  rcases i with i | i
  · simp [evalPair, symbolicAssignment]
  · fin_cases i <;> simp [evalPair, symbolicAssignment]
theorem symbolic_eval (f : R →+* k) (c : τ → k) (p : PolyExpr (τ ⊕ Fin 2) R) (a b : k) :
    (specialize (symbolic f c p) a).eval b = interpret f (Sum.elim c ![a, b]) p := by
  rw [← polyEval_eq_interpret, ← evalPair_apply, symbolic, ← polyEval_hom,
    evalPair_comp_symbolicConst, evalPair_comp_symbolicAssignment]
def CoeffBound (D : Nat) (Q : k[X][X]) : Prop :=
  Q.natDegree ≤ D ∧ ∀ j, (Q.coeff j).natDegree ≤ D
theorem coeffBound_mono {D D' : Nat} (h : D ≤ D') {Q : k[X][X]} (hQ : CoeffBound D Q) :
    CoeffBound D' Q :=
  ⟨hQ.1.trans h, fun j => (hQ.2 j).trans h⟩
theorem coeffBound_C_C (v : k) : CoeffBound 0 (C (C v) : k[X][X]) := by
  refine ⟨by simp, fun j => ?_⟩
  rw [coeff_C]
  split_ifs <;> simp
theorem coeffBound_C_X : CoeffBound 1 (C X : k[X][X]) := by
  refine ⟨by simp, fun j => ?_⟩
  rw [coeff_C]
  split_ifs <;> simp
theorem coeffBound_X : CoeffBound 1 (X : k[X][X]) := by
  refine ⟨natDegree_X_le, fun j => ?_⟩
  rw [coeff_X]
  split_ifs <;> simp
theorem coeffBound_add {D₁ D₂ : Nat} {P Q : k[X][X]} (hP : CoeffBound D₁ P)
    (hQ : CoeffBound D₂ Q) : CoeffBound (max D₁ D₂) (P + Q) := by
  refine ⟨natDegree_add_le_of_degree_le (hP.1.trans (le_max_left _ _))
    (hQ.1.trans (le_max_right _ _)), fun j => ?_⟩
  rw [coeff_add]
  exact natDegree_add_le_of_degree_le ((hP.2 j).trans (le_max_left _ _))
    ((hQ.2 j).trans (le_max_right _ _))
theorem coeffBound_mul {D₁ D₂ : Nat} {P Q : k[X][X]} (hP : CoeffBound D₁ P)
    (hQ : CoeffBound D₂ Q) : CoeffBound (D₁ + D₂) (P * Q) := by
  refine ⟨natDegree_mul_le_of_le hP.1 hQ.1, fun j => ?_⟩
  rw [coeff_mul]
  apply natDegree_sum_le_of_forall_le
  intro ij _
  exact natDegree_mul_le_of_le (hP.2 ij.1) (hQ.2 ij.2)
theorem coeffBound_one : CoeffBound 0 (1 : k[X][X]) := by
  refine ⟨by simp, fun j => ?_⟩
  rw [coeff_one]
  split_ifs <;> simp
theorem coeffBound_prod (l : List (k[X][X])) (D : Nat) (h : ∀ Q ∈ l, CoeffBound D Q) :
    CoeffBound (l.length * D) l.prod := by
  induction l with
  | nil => simpa using coeffBound_one
  | cons Q l ih =>
    have hQ := h Q List.mem_cons_self
    have hl := ih (fun Q' hQ' => h Q' (List.mem_cons_of_mem Q hQ'))
    have := coeffBound_mul hQ hl
    simpa [List.length_cons, Nat.succ_mul, Nat.add_comm] using this
theorem symbolic_coeffBound (f : R →+* k) (c : τ → k) (p : PolyExpr (τ ⊕ Fin 2) R) :
    CoeffBound p.degree (symbolic f c p) := by
  induction p with
  | const r =>
    simpa [symbolic, polyEval, symbolicConst, PolyExpr.degree] using coeffBound_C_C (f r)
  | var i =>
    rcases i with i | i
    · simpa [symbolic, polyEval, symbolicAssignment, PolyExpr.degree] using
        coeffBound_mono (Nat.zero_le 1) (coeffBound_C_C (c i))
    · fin_cases i
      · simpa [symbolic, polyEval, symbolicAssignment, PolyExpr.degree] using coeffBound_C_X
      · simpa [symbolic, polyEval, symbolicAssignment, PolyExpr.degree] using coeffBound_X
  | add a b iha ihb =>
    simpa [symbolic, polyEval, PolyExpr.degree] using coeffBound_add iha ihb
  | mul a b iha ihb =>
    simpa [symbolic, polyEval, PolyExpr.degree] using coeffBound_mul iha ihb
def GenericallyHolds (f : R →+* k) (c : τ → k) (cl : Clause (τ ⊕ Fin 2) R) : Prop :=
  ∀ l ∈ cl, if l.2 then symbolic f c l.1 = 0 else symbolic f c l.1 ≠ 0
def inequationProduct (f : R →+* k) (c : τ → k) (cl : Clause (τ ⊕ Fin 2) R) : k[X][X] :=
  ((cl.filter fun l => !l.2).map fun l => symbolic f c l.1).prod
theorem inequationProduct_ne_zero (f : R →+* k) (c : τ → k) (cl : Clause (τ ⊕ Fin 2) R)
    (h : GenericallyHolds f c cl) : inequationProduct f c cl ≠ 0 := by
  apply List.prod_ne_zero
  intro h0
  obtain ⟨l, hl, hl0⟩ := List.mem_map.mp h0
  have hmem := List.mem_filter.mp hl
  have hgen := h l hmem.1
  have hfalse : l.2 = false := by simpa using hmem.2
  rw [hfalse] at hgen
  simp only [Bool.false_eq_true, if_false] at hgen
  exact hgen hl0
theorem symbolic_dvd_inequationProduct (f : R →+* k) (c : τ → k) (cl : Clause (τ ⊕ Fin 2) R)
    (l : Literal (τ ⊕ Fin 2) R) (hl : l ∈ cl) (hfalse : l.2 = false) :
    symbolic f c l.1 ∣ inequationProduct f c cl := by
  apply List.dvd_prod
  apply List.mem_map.mpr
  exact ⟨l, List.mem_filter.mpr ⟨hl, by simp [hfalse]⟩, rfl⟩
theorem inequationProduct_coeffBound (f : R →+* k) (c : τ → k) (cl : Clause (τ ⊕ Fin 2) R)
    (D : Nat) (hD : ∀ l ∈ cl, l.1.degree ≤ D) :
    CoeffBound (cl.length * D) (inequationProduct f c cl) := by
  have h := coeffBound_prod ((cl.filter fun l => !l.2).map fun l => symbolic f c l.1) D (by
    intro Q hQ
    obtain ⟨l, hl, rfl⟩ := List.mem_map.mp hQ
    exact coeffBound_mono (hD l (List.mem_filter.mp hl).1) (symbolic_coeffBound f c l.1))
  refine coeffBound_mono ?_ h
  rw [List.length_map]
  exact Nat.mul_le_mul_right _ (List.length_filter_le _ _)
theorem clauseHolds_of_generic (f : R →+* k) (c : τ → k) (cl : Clause (τ ⊕ Fin 2) R)
    (h : GenericallyHolds f c cl) (a b : k)
    (hab : (specialize (inequationProduct f c cl) a).eval b ≠ 0) :
    clauseHolds f (Sum.elim c ![a, b]) cl := by
  intro l hl
  have hgen := h l hl
  unfold literalHolds
  rw [← symbolic_eval]
  by_cases hb : l.2 = true
  · rw [hb] at hgen ⊢
    simp only [if_true] at hgen ⊢
    rw [hgen]
    simp [specialize]
  · have hfalse : l.2 = false := by simpa using hb
    rw [hfalse]
    simp only [Bool.false_eq_true, if_false]
    intro h0
    apply hab
    obtain ⟨r, hr⟩ := symbolic_dvd_inequationProduct f c cl l hl hfalse
    rw [← evalPair_apply] at h0 ⊢
    rw [hr, map_mul, h0, zero_mul]
theorem exists_rational_instance [Fintype k] [DecidableEq k] (f : R →+* k) (c : τ → k)
    (cl : Clause (τ ⊕ Fin 2) R) (h : GenericallyHolds f c cl) (D : Nat)
    (hD : ∀ l ∈ cl, l.1.degree ≤ D) (hq : 2 * (cl.length * D) < Fintype.card k) :
    ∃ a b : k, clauseHolds f (Sum.elim c ![a, b]) cl := by
  have hB := inequationProduct_coeffBound f c cl D hD
  obtain ⟨ab, hab⟩ := exists_not_zero (inequationProduct f c cl)
    (inequationProduct_ne_zero f c cl h) (cl.length * D) hB.1 (hB.2 _) hq
  exact ⟨ab.1, ab.2, clauseHolds_of_generic f c cl h ab.1 ab.2 hab⟩
section Generic
variable {Ω : Type*} [Field Ω] [Algebra k Ω]
def genericEval (u u₀ : Ω) : k[X][X] →+* Ω :=
  (evalRingHom u₀).comp (mapRingHom (aeval u : k[X] →ₐ[k] Ω).toRingHom)
theorem genericEval_apply (u u₀ : Ω) (Q : k[X][X]) :
    genericEval u u₀ Q = Q.eval₂ (aeval u : k[X] →ₐ[k] Ω).toRingHom u₀ := by
  simp [genericEval, eval₂_map, eval_map]
theorem aeval_injective_of_transcendental (u : Ω) (hu : Transcendental k u) :
    Function.Injective (aeval u : k[X] →ₐ[k] Ω) := by
  rw [injective_iff_map_eq_zero]
  intro p hp
  exact (transcendental_iff.mp hu) p hp
theorem genericEval_injective (u u₀ : Ω) (hu : Transcendental k u)
    (hu₀ : Transcendental (aeval u : k[X] →ₐ[k] Ω).range u₀) :
    Function.Injective (genericEval (k := k) u u₀) := by
  rw [injective_iff_map_eq_zero]
  intro Q hQ
  by_contra hne
  let φ : k[X] →ₐ[k] (aeval u : k[X] →ₐ[k] Ω).range := (aeval u).rangeRestrict
  have hφ : Function.Injective φ := by
    intro p q hpq
    apply aeval_injective_of_transcendental u hu
    have := congrArg (Subtype.val) hpq
    simpa [φ] using this
  have hQ' : Q.map φ.toRingHom ≠ 0 := (Polynomial.map_ne_zero_iff (f := φ.toRingHom) hφ).mpr hne
  have hcomp : (algebraMap (aeval u : k[X] →ₐ[k] Ω).range Ω).comp φ.toRingHom =
      (aeval u : k[X] →ₐ[k] Ω).toRingHom := RingHom.ext fun p => rfl
  have key : (aeval (R := (aeval u : k[X] →ₐ[k] Ω).range) u₀) (Q.map φ.toRingHom) =
      genericEval u u₀ Q := by
    rw [aeval_def, eval₂_map, hcomp, genericEval_apply]
  have h0 : (aeval (R := (aeval u : k[X] →ₐ[k] Ω).range) u₀) (Q.map φ.toRingHom) = 0 := by
    rw [key]
    exact hQ
  exact hQ' ((transcendental_iff.mp hu₀) _ h0)
theorem symbolic_genericEval (f : R →+* k) (c : τ → k) (p : PolyExpr (τ ⊕ Fin 2) R) (u u₀ : Ω) :
    genericEval u u₀ (symbolic f c p) =
      interpret ((algebraMap k Ω).comp f) (Sum.elim (algebraMap k Ω ∘ c) ![u, u₀]) p := by
  rw [← polyEval_eq_interpret, symbolic, ← polyEval_hom]
  congr 1
  · ext r; simp [genericEval, symbolicConst]
  · funext i
    rcases i with i | i
    · simp [genericEval, symbolicAssignment]
    · fin_cases i <;> simp [genericEval, symbolicAssignment]
theorem clauseHolds_generic_iff (f : R →+* k) (c : τ → k) (cl : Clause (τ ⊕ Fin 2) R)
    (u u₀ : Ω) (hu : Transcendental k u)
    (hu₀ : Transcendental (aeval u : k[X] →ₐ[k] Ω).range u₀) :
    clauseHolds ((algebraMap k Ω).comp f) (Sum.elim (algebraMap k Ω ∘ c) ![u, u₀]) cl ↔
      GenericallyHolds f c cl := by
  have hinj := genericEval_injective (k := k) u u₀ hu hu₀
  unfold clauseHolds GenericallyHolds
  apply forall₂_congr
  intro l _
  unfold literalHolds
  rw [← symbolic_genericEval]
  by_cases hb : l.2 = true
  · rw [hb]
    simp only [if_true]
    exact ⟨fun h => hinj (by simpa using h), fun h => by rw [h, map_zero]⟩
  · have hfalse : l.2 = false := by simpa using hb
    rw [hfalse]
    simp only [Bool.false_eq_true, if_false]
    exact ⟨fun h h0 => h (by rw [h0, map_zero]), fun h h0 => h (hinj (by simpa using h0))⟩
end Generic
