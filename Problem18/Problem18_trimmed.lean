namespace Mathproof.Problem18ExplicitFixedCoordinates20261001
open Problem18AllFormatRoot20260930 Problem18InvolutionNorm20260930
open scoped BigOperators
variable {K : Type} [Field K] [Fintype K]
theorem presentation_generator_not_fixed (F : FieldPresentation K) (σ : K≃+*K) (hne : σ≠1) :
    σ F.generator≠F.generator := by
  intro hg
  apply hne
  apply RingEquiv.ext
  intro x
  change σ x=x
  calc σ x=σ (∑i : Fin F.e,((F.coordinate x i).val : K)*F.generator^i.val) :=
        congrArg σ (F.coordinate_spec x)
       _=∑i : Fin F.e,((F.coordinate x i).val : K)*F.generator^i.val := by simp [hg]
       _=x := (F.coordinate_spec x).symm
def coefficientB (σ : K≃+*K) (θ x : K) : K := (x-σ x)/(θ-σ θ)
def coefficientA (σ : K≃+*K) (θ x : K) : K := x-coefficientB σ θ x*θ
theorem coefficientB_fixed (σ : K≃+*K) (hinv : Function.Involutive σ)
    (θ : K) (hθ : θ≠σ θ) (x : K) : σ (coefficientB σ θ x)=coefficientB σ θ x := by
  simp only [coefficientB,map_div₀,map_sub,hinv x,hinv θ]
  apply (div_eq_div_iff (sub_ne_zero.mpr hθ.symm) (sub_ne_zero.mpr hθ)).mpr
  ring
theorem coefficientA_fixed (σ : K≃+*K) (hinv : Function.Involutive σ)
    (θ : K) (hθ : θ≠σ θ) (x : K) : σ (coefficientA σ θ x)=coefficientA σ θ x := by
  rw [coefficientA,map_sub,map_mul,coefficientB_fixed σ hinv θ hθ]
  have h : coefficientB σ θ x*(θ-σ θ)=x-σ x:=div_mul_cancel₀ _ (sub_ne_zero.mpr hθ)
  linear_combination h
def coordinates (σ : K≃+*K) (hinv : Function.Involutive σ) (θ : K) (hθ : θ≠σ θ)
    (x : K) : fixedField σ × fixedField σ :=
  (⟨coefficientA σ θ x,(mem_fixedField σ _).mpr (coefficientA_fixed σ hinv θ hθ x)⟩,
   ⟨coefficientB σ θ x,(mem_fixedField σ _).mpr (coefficientB_fixed σ hinv θ hθ x)⟩)
def fromCoordinates (σ : K≃+*K) (θ : K) (v : fixedField σ × fixedField σ) : K :=
  v.1.val+v.2.val*θ
theorem coordinates_reconstruct (σ : K≃+*K) (hinv : Function.Involutive σ)
    (θ : K) (hθ : θ≠σ θ) (x : K) :
    fromCoordinates σ θ (coordinates σ hinv θ hθ x)=x := by
  simp only [fromCoordinates,coordinates,coefficientA]
  ring
theorem coefficientB_fromCoordinates (σ : K≃+*K) (θ : K) (hθ : θ≠σ θ)
    (v : fixedField σ × fixedField σ) : coefficientB σ θ (fromCoordinates σ θ v)=v.2.val := by
  simp only [coefficientB,fromCoordinates,map_add,map_mul,
    (mem_fixedField σ _).mp v.1.property,(mem_fixedField σ _).mp v.2.property]
  apply (div_eq_iff (sub_ne_zero.mpr hθ)).mpr
  ring
theorem coordinates_fromCoordinates (σ : K≃+*K) (hinv : Function.Involutive σ)
    (θ : K) (hθ : θ≠σ θ) (v : fixedField σ × fixedField σ) :
    coordinates σ hinv θ hθ (fromCoordinates σ θ v)=v := by
  apply Prod.ext <;> apply Subtype.ext
  · change coefficientA σ θ (fromCoordinates σ θ v)=v.1.val
    rw [coefficientA,coefficientB_fromCoordinates σ θ hθ]
    simp [fromCoordinates]
  · exact coefficientB_fromCoordinates σ θ hθ v
def coordinateEquiv (σ : K≃+*K) (hinv : Function.Involutive σ) (θ : K) (hθ : θ≠σ θ) :
    K≃(fixedField σ × fixedField σ) where
  toFun:=coordinates σ hinv θ hθ
  invFun:=fromCoordinates σ θ
  left_inv:=coordinates_reconstruct σ hinv θ hθ
  right_inv:=coordinates_fromCoordinates σ hinv θ hθ
def rootCoordinates (F : FieldPresentation K) {q : ℕ}
    (d : Problem18UnitaryRootField20260930.UnitaryFieldData (K:=K) q) :
    K≃(fixedField d.automorphism × fixedField d.automorphism) :=
  coordinateEquiv d.automorphism d.involutive F.generator
    (presentation_generator_not_fixed F d.automorphism d.nontrivial).symm
theorem root_coordinateB_formula (F : FieldPresentation K) {q : ℕ}
    (d : Problem18UnitaryRootField20260930.UnitaryFieldData (K:=K) q) (x : K) :
    ((rootCoordinates F d x).2 : K)=(x-x^q)/(F.generator-F.generator^q) := by
  simp only [rootCoordinates,coordinateEquiv,Equiv.coe_fn_mk,coordinates,coefficientB,d.frobenius]
theorem root_coordinateA_formula (F : FieldPresentation K) {q : ℕ}
    (d : Problem18UnitaryRootField20260930.UnitaryFieldData (K:=K) q) (x : K) :
    ((rootCoordinates F d x).1 : K)=x-(x-x^q)/(F.generator-F.generator^q)*F.generator := by
  simp only [rootCoordinates,coordinateEquiv,Equiv.coe_fn_mk,coordinates,coefficientA,coefficientB,d.frobenius]
end Mathproof.Problem18ExplicitFixedCoordinates20261001
end
