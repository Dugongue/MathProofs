def anyMappedCom {α : Type} (compile : α → Com) (flag acc : String) : List α → Com
  | [] => .skip
  | a :: as =>
      .seq (compile a)
        (.seq (.ite (.eq (.var flag) (.lit 1)) (.assign acc (.lit 1)) .skip)
          (anyMappedCom compile flag acc as))
def existsMappedCom {α : Type} (compile : α → Com) (flag found : String) :
    List α → Com
  | [] => .skip
  | a :: as =>
      .ite (.eq (.var found) (.lit 0))
        (.seq (compile a)
          (.seq (.ite (.eq (.var flag) (.lit 1))
              (.assign found (.lit 1)) (.assign found (.lit 0)))
            (existsMappedCom compile flag found as)))
        .skip
def existsMappedCost {α : Type} (cost : α → Nat) : List α → Nat
  | [] => 1
  | a :: as => 4 + cost a + 8 + existsMappedCost cost as
def DestructiveCandidates {α : Type} (B : Nat) (compile : α → Com)
    (flag : String) (I : Env → Prop) (P : α → Prop) [DecidablePred P]
    (cost : α → Nat) (as : List α) : Prop :=
  ∀ a ∈ as, ∀ σ : Env, I σ →
    ∃ τ : Env, Run B (compile a) σ τ (cost a) ∧ I τ ∧
      τ.vars flag = (if P a then 1 else 0)
theorem existsMappedCom_run {α : Type} {B : Nat} {compile : α → Com}
    {flag found : String} {I : Env → Prop} {P : α → Prop} [DecidablePred P]
    {cost : α → Nat} (hB : 1 < B) (hff : flag ≠ found)
    (hIset : ∀ σ, I σ → ∀ v, I (σ.setVar found v)) :
    ∀ (as : List α), DestructiveCandidates B compile flag I P cost as →
      ∀ σ : Env, I σ → σ.vars found = 0 →
      ∃ τ : Env,
        Run B (existsMappedCom compile flag found as) σ τ
          (existsMappedCost cost as) ∧
        I τ ∧ τ.vars found = (if ∃ a ∈ as, P a then 1 else 0) := by
  intro as
  induction as with
  | nil =>
      intro _ σ hI h0
      exact ⟨σ, Run.skip, hI, by simp [h0]⟩
  | cons a as ih =>
      intro hC σ hI h0
      have hc0 : (Cond.eq (.var found) (.lit 0)).evalB B σ = some true := by
        rw [evalB_condEq (evalB_var (by rw [h0]; omega))
          (evalB_lit (by omega)), h0]
        rfl
      obtain ⟨τ₁, hr₁, hI₁, hf₁⟩ := hC a List.mem_cons_self σ hI
      have hC' : DestructiveCandidates B compile flag I P cost as :=
        fun a' ha' => hC a' (List.mem_cons_of_mem _ ha')
      have hfB : τ₁.vars flag < B := by
        rw [hf₁]
        split_ifs <;> omega
      have hc : (Cond.eq (.var flag) (.lit 1)).evalB B τ₁ =
          some (τ₁.vars flag == 1) :=
        evalB_condEq (evalB_var hfB) (evalB_lit hB)
      by_cases hP : P a
      · have hf : τ₁.vars flag = 1 := by rw [hf₁, if_pos hP]
        have hct : (Cond.eq (.var flag) (.lit 1)).evalB B τ₁ = some true := by
          rw [hc, hf]
          rfl
        have hr₂ := Run.ite_true (d := .assign found (.lit 0)) hct
          (Run.assign (B := B) (σ := τ₁) (x := found) (evalB_lit (n := 1) hB))
        let τ₂ := τ₁.setVar found 1
        have hI₂ : I τ₂ := hIset τ₁ hI₁ 1
        have hfound₂ : τ₂.vars found = 1 := by simp [τ₂, vars_setVar]
        have htail : ∀ (xs : List α) (τ : Env), τ.vars found = 1 →
            ∃ υ : Env,
              Run B (existsMappedCom compile flag found xs) τ υ
                (existsMappedCost cost xs) ∧ υ = τ := by
          intro xs τ hfound
          cases xs with
          | nil => exact ⟨τ, Run.skip, rfl⟩
          | cons b bs =>
              have hcfalse : (Cond.eq (.var found) (.lit 0)).evalB B τ =
                  some false := by
                rw [evalB_condEq (evalB_var (by rw [hfound]; omega))
                  (evalB_lit (by omega)), hfound]
                rfl
              refine ⟨τ, (Run.ite_false (c := _) hcfalse
                (Run.skip (B := B) (σ := τ))).mono ?_, rfl⟩
              simp only [existsMappedCost, Cond.size, Expr.size]
              omega
        obtain ⟨τ₃, hr₃, rfl⟩ := htail as τ₂ hfound₂
        refine ⟨τ₂, ?_, hI₂, ?_⟩
        · exact (Run.ite_true (d := Com.skip) hc0
            (hr₁.seq (hr₂.seq hr₃))).mono (by
              simp only [existsMappedCost, Cond.size, Expr.size]
              omega)
        · have hex : ∃ a' ∈ a :: as, P a' :=
            ⟨a, List.mem_cons_self, hP⟩
          rw [if_pos hex]
          exact hfound₂
      · have hf : τ₁.vars flag = 0 := by rw [hf₁, if_neg hP]
        have hcf : (Cond.eq (.var flag) (.lit 1)).evalB B τ₁ = some false := by
          rw [hc, hf]
          rfl
        have hr₂ := Run.ite_false (c := .assign found (.lit 1)) hcf
          (Run.assign (B := B) (σ := τ₁) (x := found)
            (evalB_lit (n := 0) (by omega)))
        let τ₂ := τ₁.setVar found 0
        have hI₂ : I τ₂ := hIset τ₁ hI₁ 0
        have hfound₂ : τ₂.vars found = 0 := by simp [τ₂, vars_setVar]
        obtain ⟨τ₃, hr₃, hI₃, hfound₃⟩ := ih hC' τ₂ hI₂ hfound₂
        refine ⟨τ₃, ?_, hI₃, ?_⟩
        · exact (Run.ite_true (d := Com.skip) hc0
            (hr₁.seq (hr₂.seq hr₃))).mono (by
              simp only [existsMappedCost, Cond.size, Expr.size]
              omega)
        · rw [hfound₃]
          have hex : (∃ a' ∈ a :: as, P a') ↔ ∃ a' ∈ as, P a' := by
            constructor
            · rintro ⟨a', ha', hp'⟩
              rcases List.mem_cons.mp ha' with rfl | ha'
              · exact absurd hp' hP
              · exact ⟨a', ha', hp'⟩
            · rintro ⟨a', ha', hp'⟩
              exact ⟨a', List.mem_cons_of_mem _ ha', hp'⟩
          simp only [hex]
end Mathproof.Problem18IndexedSequencers20261002
