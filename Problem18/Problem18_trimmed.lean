variable {K : Type*} [Field K] [Fintype K]
variable {L : Type*} [Field L] [Algebra K L] [IsAlgClosed L] [Algebra.IsAlgebraic K L]
def descentDegree (n d : ℕ) : ℕ := n * cpE n d
theorem descent {n d : ℕ} (fs : List (MvPolynomial (Fin n) K))
    (hfs : ∀ f ∈ fs, f.totalDegree ≤ d) (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ (geometricIdeal (L := L) {f | f ∈ fs}).minimalPrimes)
    (hfix : P.comap (coefficientAutomorphism (FiniteField.frobeniusAlgEquivOfAlgebraic K L)) = P) :
    ∃ gs : List (MvPolynomial (Fin n) K),
      (∀ g ∈ gs, g.totalDegree ≤ descentDegree n d) ∧
      (geometricIdeal (L := L) {g | g ∈ gs}).minimalPrimes = {P} ∧
      ∀ x : Fin n → K, (∀ g ∈ gs, eval x g = 0) → ∀ f ∈ fs, eval x f = 0 := by
  classical
  let F : Fin fs.length → Fin (boxSize n d) → K := fun r => vecOf n d (fs.get r)
  have hFpoly : ∀ r, boxPoly n d (F r) = fs.get r := fun r =>
    boxPoly_of_totalDegree n d _ (hfs _ (List.get_mem fs r))
  have hrange : {f | f ∈ fs} = Set.range fun r => boxPoly n d (F r) := by
    ext f
    simp only [Set.mem_setOf_eq, Set.mem_range, hFpoly, List.mem_iff_get]
  have hF : ∀ r, (boxPoly n d (fun j => algebraMap K L (F r j))).totalDegree ≤ d := by
    intro r
    rw [← boxPoly_map, hFpoly]
    exact (Finset.sup_mono (support_map_subset _ _)).trans (hfs _ (List.get_mem fs r))
  rw [hrange] at hP
  have hex : ∃ (k : ℕ) (S : Fin k → Fin (boxSize n (cpE n d)))
      (U : Fin k → Fin (boxSize n (cpE n d)) → K),
      IsP n d (fun r j => algebraMap K L (F r j)) S (fun i j => algebraMap K L (U i j)) ∧
      (Ideal.span (rowSys n (cpE n d) (fun i j => algebraMap K L (U i j)) :
        Set (MvPolynomial (Fin n) L))).radical = P := by
    rw [geometricIdeal_rowSys] at hP
    obtain ⟨k, S, U, hU, hrad, hUP, hred⟩ := component_param n d _ hF P hP
    set σ := coefficientAutomorphism (N := n) (FiniteField.frobeniusAlgEquivOfAlgebraic K L)
      with hσ
    have hσP : ∀ f, σ f ∈ P ↔ f ∈ P := by
      intro f
      conv_rhs => rw [← hfix]
      rfl
    have hfixU : ∀ i j, (FiniteField.frobeniusAlgEquivOfAlgebraic K L) (U i j) = U i j := by
      intro i j
      have hmem : boxPoly n (cpE n d)
          (fun t => (FiniteField.frobeniusAlgEquivOfAlgebraic K L) (U i t)) ∈ P := by
        rw [← coefficientAutomorphism_boxPoly, ← hσ, hσP]
        exact hUP i
      rw [hred _ hmem j]
      have hS : ∀ t, (FiniteField.frobeniusAlgEquivOfAlgebraic K L) (U i (S t)) =
          if i = t then 1 else 0 := by
        intro t
        rw [hU.1 i t]
        split_ifs <;> simp
      simp only [hS, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    have hrat : ∀ i j, ∃ c : K, algebraMap K L c = U i j := by
      intro i j
      apply Mathproof.Problem18ZeroDimFixedComponent20261001.pow_card_fixed_mem_range
      have := hfixU i j
      rwa [FiniteField.coe_frobeniusAlgEquivOfAlgebraic] at this
    choose UK hUK using hrat
    have hfun : (fun i j => algebraMap K L (UK i j)) = U := by
      funext i j
      exact hUK i j
    exact ⟨k, S, UK, hfun ▸ hU, hfun ▸ hrad⟩
  obtain ⟨k, S, UK, hU, hrad⟩ := hex
  refine ⟨List.ofFn fun i => boxPoly n (cpE n d) (UK i), ?_, ?_, ?_⟩
  · intro g hg
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hg
    exact totalDegree_boxPoly_le n _ (UK i)
  · have hgeo : geometricIdeal (L := L) {g | g ∈ List.ofFn fun i => boxPoly n (cpE n d) (UK i)} =
        Ideal.span (rowSys n (cpE n d) (fun i j => algebraMap K L (UK i j)) :
          Set (MvPolynomial (Fin n) L)) := by
      rw [← geometricIdeal_rowSys]
      congr 1
      ext g
      simp only [Set.mem_setOf_eq, List.mem_ofFn, Set.mem_range]
    rw [hgeo, ← Ideal.radical_minimalPrimes, hrad]
    haveI : P.IsPrime := hrad ▸ (isParam_component n d _ S _ hU).1.1
    exact Ideal.minimalPrimes_eq_subsingleton_self
  · intro x hx f hf
    have key : ∀ p : MvPolynomial (Fin n) K,
        eval (fun i => algebraMap K L (x i)) (MvPolynomial.map (algebraMap K L) p) =
          algebraMap K L (eval x p) := by
      intro p
      show _ = algebraMap K L (eval₂Hom (RingHom.id K) x p)
      rw [map_eval₂Hom, eval_map, RingHom.comp_id, coe_eval₂Hom]
    have hxP : (fun i => algebraMap K L (x i)) ∈ zeroLocus L P := by
      rw [← hrad, mem_zeroLocus_eval]
      intro g hg
      rw [mem_radical_iff_vanish] at hg
      apply hg
      rw [mem_zeroLocus_rowSys]
      intro i
      rw [← eval_boxPoly, ← boxPoly_map, key, hx _ (List.mem_ofFn.mpr ⟨i, rfl⟩), map_zero]
    have hfmem : MvPolynomial.map (algebraMap K L) f ∈ P := by
      apply hP.1.2
      apply Ideal.subset_span
      refine ⟨f, ?_, rfl⟩
      rw [← hrange]
      exact hf
    have h0 := (mem_zeroLocus_eval P _).mp hxP _ hfmem
    rw [key] at h0
    exact (map_eq_zero_iff _ (algebraMap K L).injective).mp h0
end Mathproof.Problem18ComponentDescent20261001
