noncomputable def preimageEquiv (f : M →+ N) (hf : Function.Surjective f)
    (P : N → Prop) : {x : M // P (f x)} ≃ {y : N // P y} × f.ker := by
  classical
  choose s hs using hf
  exact {
    toFun := fun x => (⟨f x, x.property⟩, ⟨x.val - s (f x), by
      change f (x.val - s (f x)) = 0
      simp [map_sub, hs]⟩)
    invFun := fun y => ⟨s y.1.val + y.2.val, by
      have hz : f y.2.val = 0 := y.2.property
      simpa [map_add, hs, hz] using y.1.property⟩
    left_inv := fun x => by
      apply Subtype.ext
      change s (f x.val) + (x.val - s (f x.val)) = x.val
      abel
    right_inv := fun y => by
      have hz : f y.2.val = 0 := y.2.property
      apply Prod.ext
      · apply Subtype.ext
        change f (s y.1.val + y.2.val) = y.1.val
        simp [map_add, hs, hz]
      · apply Subtype.ext
        change s y.1.val + y.2.val - s (f (s y.1.val + y.2.val)) = y.2.val
        simp [map_add, hs, hz] }
theorem preimage_card_mul [Finite M] [Finite N]
    (f : M →+ N) (hf : Function.Surjective f) (P : N → Prop) :
    Nat.card {x : M // P (f x)} * Nat.card N =
      Nat.card {y : N // P y} * Nat.card M := by
  have hp := Nat.card_congr (preimageEquiv f hf P)
  rw [Nat.card_prod] at hp
  have ht := Nat.card_congr (preimageEquiv f hf (fun _ => True))
  simp only [Nat.card_prod, Nat.card_subtype_true] at ht
  rw [hp, ht]
  ring
