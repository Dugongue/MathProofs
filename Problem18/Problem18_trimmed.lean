      (fun p hp=>hf p (by simp [hp]))
theorem copied_valid {B : Nat} (xs : List (String×String)) (σ : Env)
    (hv : Problem18IMPFieldPrimitives20261001.ValidMemory F B σ)
    (hf : ∀p∈xs,canonical.e≠p.1 ∧ canonical.p≠p.1 ∧ canonical.modBase≠p.1) :
    Problem18IMPFieldPrimitives20261001.ValidMemory F B (copied xs σ) := by
  induction xs generalizing σ with
  | nil=>exact hv
  | cons p xs ih=>
    have h:=hf p (by simp)
    exact ih _ (Problem18IMPMatrixDot20261001.validMemory_setVar F hv p.1 (σ.vars p.2) h.1 h.2.1 h.2.2)
      (fun p hp=>hf p (by simp [hp]))
