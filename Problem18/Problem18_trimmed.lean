    change v (1 / RatFunc.X) ≤ 1
    rw [RatFunc.inftyValuation.X_inv]
    simpa only [← WithZero.exp_zero, WithZero.exp_le_exp] using (show (-1 : ℤ) ≤ 0 by omega)
