    Equiv.subtypeEquivRight (fun T => by rw [hQ])
  exact e.trans ((restrictionMarkedEquiv σ B C A Q).symm.trans (baseFiberEquiv σ B C hB A))
abbrev MarkedOperators (B : Form σ V) (C : Form σ W) (A : SelfAdjointOperators σ B) :=
  (j : EmbeddingOrbit σ B C) × MarkedFiber σ B C A j.val
theorem marked_card [Finite V] [Finite W] (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingLeft) (A : SelfAdjointOperators σ B) :
    Nat.card (MarkedOperators σ B C A)=
      Nat.card (EmbeddingOrbit σ B C)*Nat.card (SelfAdjointOperators σ C) := by
  letI : Finite (Module.End K (V × W)) := Finite.of_injective
    (fun T : Module.End K (V × W) => (T : V × W → V × W)) DFunLike.coe_injective
  letI : Finite (V →ₗ[K] V × W) := Finite.of_injective
    (fun j : V →ₗ[K] V × W => (j : V → V × W)) DFunLike.coe_injective
  letI : Fintype (EmbeddingOrbit σ B C) := Fintype.ofFinite _
  rw [MarkedOperators,Nat.card_sigma]
  have hc (j : EmbeddingOrbit σ B C) : Nat.card (MarkedFiber σ B C A j.val)=
      Nat.card (SelfAdjointOperators σ C) := Nat.card_congr (markedFiberEquiv σ B C hB A j)
  simp_rw [hc]
  simp only [Finset.sum_const,Finset.card_univ,smul_eq_mul,Nat.card_eq_fintype_card]
theorem marked_card_mul_complement_isometries [Finite V] [Finite W]
    (B : Form σ V) (C : Form σ W) (hB : B.Nondegenerate) (A : SelfAdjointOperators σ B) :
    Nat.card (MarkedOperators σ B C A)*Nat.card (Isometries σ C)=
      Nat.card (Isometries σ (sumForm σ B C))*Nat.card (SelfAdjointOperators σ C) := by
  rw [marked_card σ B C hB.1 A]
