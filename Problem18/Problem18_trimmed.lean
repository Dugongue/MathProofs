theorem pointSpec (op : PointOp) :
    BinarySpec F canonical (pointRoutine canonical op) (fieldValue op) (1000 * (F.e + 1)) := by
  intro B σ h
  have hin := toPointInput F h
  obtain ⟨τ, hrun, hval, hcan, hvars, harrs, hinp, hout⟩ := pointRoutine_correct F canonical op σ hin
  have hrun' := pointRoutine_run canonical op σ canonical_names_ne_i (p_pos F h) (e_lt F h) (arith F h)
    h.memory_word hin.first_fits hin.second_fits hin.output_fits hin.first_disjoint hin.second_disjoint
    (fun j hj => ⟨coeffA F h j hj, coeffB F h j hj⟩)
  have hτ : τ = pointState σ canonical (resultValues σ canonical op) (σ.vars canonical.e) :=
    Run.eq_of_runs hrun hrun'
  refine ⟨τ, hrun, hval, hcan, ?_⟩
  refine ⟨fun x hx => hvars x (fun hxi => hx (hxi ▸ clobbered_i)),
    fun a ha _ => harrs a ha, ?_, ?_, ?_, hinp, hout⟩
  · rw [hτ]; simp [pointState, writeValues_length]
  · rw [harrs _ canonical_mem_ne_scratch.symm]
  · intro j hj hside
    rw [hτ]
    simp only [pointState, if_true]
    rw [writeValues_outside _ _ _ _ _ hj (by rw [h.degree]; exact hside)]
theorem mulSpec :
    BinarySpec F canonical (mulCore canonical canonical.mem) (fun x y => x * y) (10000 * (F.e + 1) ^ 2) := by
  intro B σ h
  have hin := toMulInput F h
  obtain ⟨hrun, hval, hcan⟩ := mulCore_field_correct F canonical canonical.mem σ hin h.degree h.prime
    (modulus_source F h)
  refine ⟨completed canonical canonical.mem σ, hrun, hval, hcan, ?_⟩
  have hnd := canonical_nodup
  refine ⟨?_, ?_, completed_lengths _ _ _ _, completed_lengths _ _ _ _, ?_, ?_, ?_⟩
  · intro x hx
    simp only [clobbered, List.mem_append, List.mem_cons, List.mem_singleton, not_or,
      List.not_mem_nil] at hx
    obtain ⟨⟨hi, hj, hk, hv, -, -⟩, -⟩ := hx
    exact completed_vars canonical canonical.mem σ x hi hv hk hj
  · intro a ha hs
    apply list_eq_of_getD _ _ (completed_lengths _ _ _ _)
    intro j hj
    rw [completed_lengths] at hj
    exact completed_read_preserved hin a j hj (Or.inl hs) (Or.inl ha)
  · intro j hj hside
    exact completed_read_preserved hin canonical.mem j hj (Or.inl canonical_mem_ne_scratch)
      (Or.inr (by rw [h.degree]; exact hside))
  · exact (run_frame hrun).2.2.2.1 (by
      simp [noRead, mulCore, initAccumulator, hornerIteration, hornerExpr, hornerArithmetic, shiftExpr,
        storeLoop, storeBody, workNames, finishNames])
  · exact (run_frame hrun).2.2.2.2 (by
      simp [Com.NoWrite, mulCore, initAccumulator, hornerIteration, hornerExpr, hornerArithmetic, shiftExpr,
        storeLoop, storeBody, workNames, finishNames])
theorem eqSpec : EqSpec F canonical (eqRoutine canonical) (1000 * (F.e + 1)) := by
  intro B σ h
  have hrun := eqRoutine_run canonical σ canonical_i_ne_flag canonical_regs_ne (e_lt F h) (arith F h)
    h.memory_word (by rw [h.degree]; exact h.first_fit) (by rw [h.degree]; exact h.second_fit)
    (fun j hj => ⟨coeffA F h j hj, coeffB F h j hj⟩)
  rw [h.degree] at hrun
  refine ⟨eqState σ canonical F.e, hrun, ?_, ?_⟩
  ·
    have hiff : (∀ j < F.e, entryA σ canonical j = entryB σ canonical j) ↔
        decode F (slice F σ canonical (σ.vars canonical.aBase)) =
          decode F (slice F σ canonical (σ.vars canonical.bBase)) := by
      rw [decode_injective F h.first_canonical h.second_canonical]
      constructor
      · intro hall; funext i; exact hall i.val i.isLt
      · intro heq j hj; exact congrFun heq ⟨j, hj⟩
    have hflag := eqState_flag σ canonical F.e
    by_cases hd : decode F (slice F σ canonical (σ.vars canonical.aBase)) =
        decode F (slice F σ canonical (σ.vars canonical.bBase))
    · rw [if_pos hd]; exact hflag.mpr (hiff.mpr hd)
    · rw [if_neg hd]
      have h0 : (eqState σ canonical F.e).vars canonical.flag = 0 ∨
          (eqState σ canonical F.e).vars canonical.flag = 1 := by
        simp only [eqState, Env.setVar, if_true]
        split_ifs <;> simp
      rcases h0 with h0 | h0
      · exact h0
      · exact absurd (hiff.mp (hflag.mp h0)) hd
  · refine ⟨?_, rfl, rfl, rfl⟩
    intro x hx
    simp only [clobbered, List.mem_append, List.mem_cons, List.mem_singleton, not_or,
      List.not_mem_nil] at hx
    obtain ⟨⟨hi, -, -, -, -, hf⟩, -⟩ := hx
    simp [eqState, Env.setVar, hi, hf]
