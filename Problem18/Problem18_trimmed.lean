set_option backward.isDefEq.respectTransparency false
set_option maxHeartbeats 1500000
namespace Mathproof.Problem18IMPSlotsMemory20261001
open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Problem18AllFormatRoot20260930 Problem18IMPFieldLayout20261001
open Problem18IMPFieldPresentation20261001 Problem18IMPFieldPrimitives20261001
open Problem18IMPFieldAddition20261001 Problem18ClaudeIMPSlots20261001
variable {K : Type} [Field K] [Fintype K] (F : FieldPresentation K)
def program : Com := .store canonical.mem (.var canonical.e) (.lit 0)
def normalized (σ : Env) : Env := σ.setArr canonical.mem F.e 0
private theorem outside {σ : Env} {i : ℕ} (hi : i<(σ.arrs canonical.mem).length) (he : F.e≠i) :
    ((normalized F σ).arrs canonical.mem).getD i 0=(σ.arrs canonical.mem).getD i 0 := by
  simp only [normalized,arrs_setArr,if_true]
  exact getD_set_other _ _ _ _ hi he
private theorem workspace_slice {WS : String} {Sn B : ℕ} {σ : Env}
    (hS : Slots F canonical WS Sn B σ) (hws : σ.vars WS=F.e+1)
    (s : ℕ) (hs : s<Sn) :
    slice F (normalized F σ) canonical ((normalized F σ).vars WS+s*F.e)=
      slice F σ canonical (σ.vars WS+s*F.e) := by
  funext i
  change ((normalized F σ).arrs canonical.mem).getD (σ.vars WS+s*F.e+i.val) 0=_
  apply outside F
  · have hi:=i.isLt
    have hmul:=Nat.mul_le_mul_right F.e (show s+1≤Sn by omega)
    have hf:=hS.fit
    rw [hws] at hf ⊢
    nlinarith
  · rw [hws]
    omega
private theorem base_normalized {WS : String} {Sn B : ℕ} {σ : Env}
    (hS : Slots F canonical WS Sn B σ) (hm : σ.vars canonical.modBase=0) :
    Base F canonical B (normalized F σ) := by
  have hb:=hS.base
  refine ⟨hb.names,hb.degree,hb.prime,hb.arithmetic_word,hb.inverse_word,?_,?_,?_,?_,?_,hb.exp_word,hb.priv⟩
  · simpa [normalized] using hb.memory_word
  · simpa [normalized,canonical] using hb.scratch_word
  · simpa [normalized,canonical] using hb.scratch_fit
  · simpa [normalized] using hb.modulus_fit
  · intro i
    change ((normalized F σ).arrs canonical.mem).getD (σ.vars canonical.modBase+i.val) 0=_
    rw [outside F (by have hi:=i.isLt; have hh:=hb.modulus_fit; omega)
      (by rw [hm]; have hi:=i.isLt; omega)]
    exact hb.modulus_value i
private theorem slots_normalized {WS : String} {Sn B : ℕ} {σ : Env}
    (hS : Slots F canonical WS Sn B σ) (hm : σ.vars canonical.modBase=0)
    (hws : σ.vars WS=F.e+1) : Slots F canonical WS Sn B (normalized F σ) := by
  refine ⟨base_normalized F hS hm,hS.ws_reg,?_,hS.modulus_apart,?_,hS.slots_word⟩
  · simpa [normalized] using hS.fit
  · intro s hs
    rw [workspace_slice F hS hws s hs]
    exact hS.canon s hs
private theorem coefficients_normalized {WS : String} {Sn B : ℕ} {σ : Env}
    (hS : Slots F canonical WS Sn B σ) (hm : σ.vars canonical.modBase=0)
    (hws : σ.vars WS=F.e+1)
    (hlen : (σ.arrs canonical.mem).length=F.e+1+Sn*F.e) :
    ∀j<((normalized F σ).arrs canonical.mem).length,
      ((normalized F σ).arrs canonical.mem).getD j 0<F.p := by
  intro j hj
  have hj' : j<(σ.arrs canonical.mem).length := by simpa [normalized] using hj
  by_cases hlt : j<F.e
  · rw [outside F hj' (by omega)]
    have he:=hS.base.modulus_value ⟨j,hlt⟩
    rw [hm,Nat.zero_add] at he
    rw [he]
    exact (F.modulus ⟨j,hlt⟩).isLt
  · by_cases heq : j=F.e
    · subst j
      simp only [normalized,arrs_setArr,if_true]
      rw [getD_set_same _ _ _ hj']
      exact F.prime.pos
    · rw [outside F hj' (by omega)]
      let t := j-(F.e+1)
      have ht : t<Sn*F.e := by rw [hlen] at hj'; dsimp [t]; omega
      have hs : t/F.e<Sn := (Nat.div_lt_iff_lt_mul F.degree_pos).mpr ht
      have hi : t%F.e<F.e := Nat.mod_lt _ F.degree_pos
      have hc:=hS.canon (t/F.e) hs ⟨t%F.e,hi⟩
      change (σ.arrs canonical.mem).getD (σ.vars WS+(t/F.e)*F.e+t%F.e) 0<F.p at hc
      have hd:=Nat.mod_add_div t F.e
      have haddr : σ.vars WS+(t/F.e)*F.e+t%F.e=j := by
        rw [hws]
        calc F.e+1+(t/F.e)*F.e+t%F.e = F.e+1+(t%F.e+F.e*(t/F.e)) := by ring
             _ = F.e+1+t := by rw [Nat.mod_add_div]
             _ = j := by dsimp [t]; omega
      rwa [haddr] at hc
theorem reset_run {WS : String} {Sn B : ℕ} {σ : Env}
    (hS : Slots F canonical WS Sn B σ) (hm : σ.vars canonical.modBase=0)
    (hws : σ.vars WS=F.e+1)
    (hlen : (σ.arrs canonical.mem).length=F.e+1+Sn*F.e) :
    ∃τ, Run B program σ τ 3 ∧ ValidMemory F B τ ∧ Slots F canonical WS Sn B τ ∧
      (∀s<Sn,val F canonical WS τ s=val F canonical WS σ s) ∧
      (∀x,τ.vars x=σ.vars x) ∧ τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hb:=hS.base
  have he : F.e<B := by have hh:=hb.memory_word; rw [hlen] at hh; omega
  have hp : 0<B := by omega
  have hr : Run B program σ (normalized F σ) 3 := by
    apply Run.store
    · rw [←hb.degree]; exact evalB_var (by rw [hb.degree]; exact he)
    · exact evalB_lit hp
    · rw [hlen]; omega
  have hs:=slots_normalized F hS hm hws
  refine ⟨normalized F σ,hr,?_,hs,?_,fun _=>rfl,rfl,rfl⟩
