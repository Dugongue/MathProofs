  have hmap : nilradical (Ω ⊗[E] F) = (nilradical (Ω ⊗[Eb] (Eb ⊗[E] F))).comap e := by
    ext x
    rw [Ideal.mem_comap, mem_nilradical, mem_nilradical]
    constructor
    · rintro ⟨m, hm⟩
      exact ⟨m, by rw [← map_pow, hm, map_zero]⟩
    · rintro ⟨m, hm⟩
      exact ⟨m, e.injective (by rw [map_pow, hm, map_zero])⟩
  rw [hmap]
  exact Ideal.comap_isPrime e _
theorem nilradical_isPrime_tensor
    (hE : ∀ a : F, IsIntegral E a → a ∈ Set.range (algebraMap E F))
