    (P : {P : Place k F // P.degree=1}) :
    pullbackPlace E L θ τ hθ (rationalConstantLift k F E L hgen P)=
      rationalConstantLift k F E L hgen P := by
  apply (exists_unique_rational_lift k F E L hgen P.val P.property).choose_spec.2.2
  have hr : restrictPlace k F L (forgetConstants k E L
      (pullbackPlace E L θ τ hθ (rationalConstantLift k F E L hgen P)))=
      restrictPlace k F L (forgetConstants k E L (rationalConstantLift k F E L hgen P)) := by
    ext x
    change x∈restrictPlace k F L (forgetConstants k E L
      (pullbackPlace E L θ τ hθ (rationalConstantLift k F E L hgen P))) ↔
      x∈restrictPlace k F L (forgetConstants k E L (rationalConstantLift k F E L hgen P))
    rw [mem_restrictPlace,mem_restrictPlace]
    change algebraMap F L x∈pullbackPlace E L θ τ hθ (rationalConstantLift k F E L hgen P) ↔
