def planeBound (n d : Nat) : Nat := 2 * fiberBound (n-1+1) (max d 1)
variable {L : Type} [Field L] {n : Nat}
theorem plane_projection_relation (G : Finset (MvPolynomial (Fin n) L)) (d : Nat)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hdim : DimLE G 1 1)
    (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes)
    (ν : Fin 2 ↪ Fin n)
    (ht : Transcendental L (Ideal.Quotient.mk P (X (ν 1)))) :
    ∃ s : MvPolynomial (Fin 2) L,
      s ≠ 0 ∧ rename ν s ∈ P ∧ s.totalDegree ≤ planeBound n d := by
  haveI : P.IsPrime := hP.isPrime
  let I := P.comap (rename ν : MvPolynomial (Fin 2) L →ₐ[L] _).toRingHom
  haveI : I.IsPrime := Ideal.comap_isPrime _ P
  let φ : (MvPolynomial (Fin 2) L ⧸ I) →ₐ[L] (MvPolynomial (Fin n) L ⧸ P) :=
    Ideal.quotientMapₐ P (rename ν) le_rfl
  have ht' : Transcendental L (Ideal.Quotient.mk I (X (1 : Fin 2))) := by
    intro ha
    apply ht
    simpa [φ] using ha.algHom φ
  have hI : 1 ≤ Algebra.trdeg L (MvPolynomial (Fin 2) L ⧸ I) := by
    have hi := (algebraicIndependent_iff_transcendental.mpr ht').cardinalMk_le_trdeg
    simpa using hi
  have hrel : ∀ i : Fin 2, ∃ g : MvPolynomial (Fin 2) L,
      g ≠ 0 ∧ g ∈ I ∧ g.degreeOf i ≤ fiberBound (n-1+1) (max d 1) := by
    intro i
    obtain ⟨g, hg0, hdeg, hg⟩ := exists_index_relation G 1 d 0 hG (by simp)
      hdim ν P hP P.one_notMem i
    exact ⟨g, hg0, hg, by simpa using hdeg⟩
  obtain ⟨s, hs, hmem, hdeg⟩ := bounded_plane_generator I hI _ hrel
  exact ⟨s, hs, hmem, hdeg⟩
variable {K : Type} [Field K] [Fintype K] [Algebra K L] [Algebra.IsAlgebraic K L]
theorem fixed_plane_projection_relation (G : Finset (MvPolynomial (Fin n) L)) (d : Nat)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (hdim : DimLE G 1 1)
    (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes)
    (hfix : P.comap (MvPolynomial.map
      (FiniteField.frobeniusAlgEquivOfAlgebraic K L).toRingEquiv.toRingHom) = P)
    (ν : Fin 2 ↪ Fin n)
    (ht : Transcendental L (Ideal.Quotient.mk P (X (ν 1)))) :
    ∃ s : MvPolynomial (Fin 2) K, s ≠ 0 ∧ s.totalDegree ≤ planeBound n d ∧
      rename ν (MvPolynomial.map (algebraMap K L) s) ∈ P := by
  obtain ⟨s, hs, hmem, hdeg⟩ := plane_projection_relation G d hG hdim P hP ν ht
  let I := P.comap (rename ν : MvPolynomial (Fin 2) L →ₐ[L] _).toRingHom
  have hI : I.comap (MvPolynomial.map
      (FiniteField.frobeniusAlgEquivOfAlgebraic K L).toRingEquiv.toRingHom) = I := by
    ext g
    change rename ν (MvPolynomial.map _ g) ∈ P ↔ rename ν g ∈ P
    rw [← MvPolynomial.map_rename]
    change rename ν g ∈ P.comap (MvPolynomial.map _) ↔ rename ν g ∈ P
    rw [hfix]
  exact Problem18BoundedRelationDescent20261001.exists_nonzero_bounded_relation
    I (planeBound n d) hI s hs hmem hdeg
end Mathproof.Problem18CurveProjectionRelation20261001
