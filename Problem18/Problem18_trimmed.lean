@[simp] theorem renameExpr_evalB (rho : String ≃ String) (B : Nat) : ∀e sigma,
    (renameExpr rho e).evalB B (renameEnv rho sigma)=e.evalB B sigma := by
  intro e
  induction e with
  | lit n => intro sigma; rfl
  | var x => intro sigma; rfl
  | get a i ih =>
      intro sigma
      simp only [renameExpr,Expr.evalB,renameEnv_arrs,Equiv.symm_apply_apply]
      rw [ih sigma]
  | bin op e f ihe ihf =>
      intro sigma
      simp only [renameExpr,Expr.evalB]
      rw [ihe sigma,ihf sigma]
