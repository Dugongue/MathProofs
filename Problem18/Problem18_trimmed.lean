    4*(Problem18CollisionChild20261001.childBox n d+1)+rebuildMaximum n d
theorem step_bound (F : FieldPresentation K) (n d M : Nat) :
    Problem18RecursiveWorkspaceStep20261002.cost F n d M ≤ stepCoefficient n d*scale F M := by
  have hmax:=rebuild_maximum_bound F n d M
  have h1 : 1 ≤ scale F M := (scale_bounds F M).1
  have hc:=Nat.mul_le_mul_left (4*(Problem18CollisionChild20261001.childBox n d+1)) h1
