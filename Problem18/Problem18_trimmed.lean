    (j : Nat) (hj : j<(σ.arrs canonical.mem).length)
    (hout : j<σ.vars canonical.outBase ∨
      σ.vars canonical.outBase+F.e*(σ.vars rows*σ.vars columns)≤j)
    (hwork : j<σ.vars workBase ∨ σ.vars workBase+3*F.e≤j) :
