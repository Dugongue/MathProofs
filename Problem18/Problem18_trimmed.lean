        rw [hτmem, List.length_set, writeValues_length]
      rw [List.getD_eq_default _ _ (by omega), List.getD_eq_default _ _ (by omega)]
  · intro x hx1 hx2
    simp [τ,ζ,zeroState,pointState,resetNames,Env.setArr,σ1,hx1,hx2]
  · intro a ha
    simp [τ,ζ,zeroState,pointState,resetNames,Env.setArr,σ1,ha]
  · intro a
    by_cases ha : a = canonical.mem
    · subst ha
      rw [hτmem, List.length_set, writeValues_length]
    · simp [τ,ζ,zeroState,pointState,resetNames,Env.setArr,σ1,ha]
  · simp [τ,ζ,zeroState,pointState,Env.setArr,σ1]
  · simp [τ,ζ,zeroState,pointState,Env.setArr,σ1]
