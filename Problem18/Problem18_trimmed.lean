    (cl : Clause (Fin (a+b)) Int) : clauseCostBound F D M cl ≤ clauseCoeff cl D*scale F M := by
  have hc:=Problem18ConcreteClausePolynomial20261002.cost_bound F cl D
  have h1:1 ≤ scale F M := (scale_bounds F M).1
  have hM:M ≤ scale F M := (scale_bounds F M).2.1
  have hw:macroBudget F*((Fintype.card K).size+1) ≤ scale F M := by unfold scale; omega
  have ht:=Nat.mul_le_mul_left (Problem18ConcreteClausePolynomial20261002.coefficient cl D) hw
  unfold clauseCostBound clauseCoeff
  nlinarith
theorem pattern_bound (F : FieldPresentation K) (n d D M : Nat)
    (pat : Σ k : Nat,Fin k → Fin (boxSize n (cpE n d))) :
    patternCostBound F n d D M pat ≤ patternCoeff n d D pat*scale F M := by
  have h1:1 ≤ scale F M := (scale_bounds F M).1
  have ht:=mapped_bound (clauseCostBound F D M) (fun cl=>clauseCoeff cl D) (scale F M) h1
    (clauses (qe (template n d pat))) (fun cl _=>clause_bound F M D cl)
  unfold patternCostBound patternCoeff
  nlinarith
