namespace Mathproof.Problem18CountedBirdArithmetic20261001
open Mathproof.Problem18ArrayBirdCharpoly20260930
variable {R : Type*} [CommRing R]
def sumCount (n lo : ℕ) (f : ℕ→R×ℕ) : R×ℕ :=
  if lo<n then
    let a := f lo
    let r := sumCount n (lo+1) f
    (a.1+r.1,a.2+r.2+1)
  else (0,0)
termination_by n-lo
theorem sumCount_correct (n lo : ℕ) (f : ℕ→R×ℕ) :
    (sumCount n lo f).1=BirdDet.sumFrom n lo (fun i => (f i).1) := by
  induction lo using BirdDet.sumFrom_induct n with
  | step lo hlo ih => rw [sumCount,BirdDet.sumFrom_step _ _ _ hlo]; simp only [hlo,↓reduceIte,ih]
  | stop lo hlo => rw [sumCount,BirdDet.sumFrom_stop _ _ _ hlo]; simp only [hlo,↓reduceIte]
def step (n : ℕ) (A F : Array R) (i j : ℕ) : R×ℕ :=
  let d := sumCount n (i+1) (fun k => (BirdDet.get n F k k,0))
  let r := sumCount n (i+1) (fun k => (BirdDet.get n F i k*BirdDet.get n A k j,1))
  (-d.1*BirdDet.get n A i j+r.1,d.2+r.2+3)
theorem step_correct (n : ℕ) (A F : Array R) (i j : ℕ) :
    (step n A F i j).1=BirdDet.stepEntry n A (BirdDet.get n F) i j := by
  simp only [step,sumCount_correct,BirdDet.stepEntry]
def stageEntries (n : ℕ) (A F : Array R) : Array (R×ℕ) :=
  Array.ofFn fun ij:Fin (n*n) => step n A F ij.divNat.val ij.modNat.val
def stage (n : ℕ) (A F : Array R) : Array R×ℕ :=
  let entries := stageEntries n A F
  (entries.map Prod.fst,∑ij:Fin (n*n),(entries[ij.val]'(by simpa [entries,stageEntries] using ij.isLt)).2)
theorem stage_correct (n : ℕ) (A F : Array R) :
    (stage n A F).1=Mathproof.Problem18ArrayBirdCharpoly20260930.stage n A F := by
  simp only [stage,stageEntries,Mathproof.Problem18ArrayBirdCharpoly20260930.stage,
    arrayOf,Array.map_ofFn]
  apply congrArg Array.ofFn
  funext ij
  exact step_correct n A F ij.divNat.val ij.modNat.val
def stages (n : ℕ) (A : Array R) : ℕ→Array R×ℕ
  | 0 => (A,0)
  | t+1 =>
    let r := stages n A t
    let s := stage n A r.1
    (s.1,r.2+s.2)
theorem stages_correct (n t : ℕ) (A : Array R) :
    (stages n A t).1=Mathproof.Problem18ArrayBirdCharpoly20260930.stages n A t := by
  induction t with
  | zero => rfl
  | succ t ih => simp only [stages,stage_correct,ih,Mathproof.Problem18ArrayBirdCharpoly20260930.stages]
def sign : ℕ→R×ℕ
  | 0 => (1,0)
  | t+1 => let r := sign t; (-r.1,r.2+1)
theorem sign_correct (t : ℕ) : (sign (R:=R) t).1=(-1:R)^t := by
  induction t with
  | zero => simp [sign]
  | succ t ih => simp [sign,ih,pow_succ]
def determinant : (n : ℕ)→Array R→R×ℕ
  | 0,_ => (1,0)
  | t+1,A =>
    let r := stages (t+1) A t
    let s := sign (R:=R) t
    (s.1*BirdDet.get (t+1) r.1 0 0,r.2+s.2+1)
theorem determinant_correct (n : ℕ) (A : Array R) :
    (determinant n A).1=Mathproof.Problem18ArrayBirdCharpoly20260930.determinant n A := by
  cases n with
  | zero => rfl
  | succ t => simp only [determinant,stages_correct,sign_correct,
      Mathproof.Problem18ArrayBirdCharpoly20260930.determinant]
end Mathproof.Problem18CountedBirdArithmetic20261001
