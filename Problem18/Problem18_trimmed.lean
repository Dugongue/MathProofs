    (X : Matrix (Fin n) (Fin r) K) (J : Matrix (Fin r) (Fin r) K)
    (hJ : J.det ≠ 0) : 2*X.rank ≤ (X*J*Xᴴ).rank+r := by
  have h := rank_sylvester (X*J) Xᴴ
  rw [Matrix.rank_mul_eq_left_of_det_ne_zero J X hJ, finite_rank_conjTranspose] at h
