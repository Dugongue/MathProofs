    unfold Fits; rw [hρ.frame.2.2.1]; exact h.leftFits _ hi
  have hright : Fits F ρ (address F σ baseB strideB (ρ.vars index)) := by
    unfold Fits; rw [hρ.frame.2.2.1]; exact h.rightFits _ hi
  have hf (x:String) (hx:x∈[acc,prod,next]) : Fits F ρ (ρ.vars x) := by
