namespace Mathproof.Problem18SquarefreeModelAlgebra20260930
noncomputable section
set_option backward.isDefEq.respectTransparency false
open Polynomial
open scoped BigOperators
open Mathproof.Problem18CyclicPrimaryVectors20260930
theorem model_intertwiner_scalar {K ι : Type*} [Field K] [Fintype K] [Fintype ι]
    (g : ι → K[X]) [∀ i, Fact (Irreducible (g i))]
    (hcop : Pairwise (fun i j => IsCoprime (g i) (g j)))
    (T : Module.End K (∀ i, AdjoinRoot (g i)))
    (hT : ∀ x, T (fun i => AdjoinRoot.root (g i)*x i) =
              fun i => AdjoinRoot.root (g i)*(T x i)) :
    ∀ x i, T x i = (T 1 i)*x i := by
  let S : Module.End K (∀ i,AdjoinRoot (g i)) :=
    { toFun := fun x i => AdjoinRoot.root (g i)*x i
      map_add' := by intro x y; funext i; exact mul_add _ _ _
      map_smul' := by
        intro a x; funext i
        change AdjoinRoot.root (g i)*(a • x i)=a • (AdjoinRoot.root (g i)*x i)
        exact mul_smul_comm _ _ _ }
  have hc : PolynomiallyCyclic S 1 :=
    (polynomiallyCyclic_iff_primary_nonzero S g hcop (LinearEquiv.refl K _) (fun _ => rfl) 1).mpr
      (fun _ => one_ne_zero)
  have hpow (n : ℕ) (x : ∀ i,AdjoinRoot (g i)) : T ((S^n) x)=(S^n) (T x) := by
    induction n with
    | zero => simp
    | succ n ih =>
      rw [pow_succ',Module.End.mul_apply,Module.End.mul_apply]
      change T (S ((S^n) x))=S ((S^n) (T x))
      rw [show T (S ((S^n) x))=S (T ((S^n) x)) from hT _,ih]
  have hp (p : K[X]) (x : ∀ i,AdjoinRoot (g i)) :
      T ((aeval S p) x)=(aeval S p) (T x) := by
    induction p using Polynomial.induction_on' with
    | add p q ihp ihq => simp only [map_add,LinearMap.add_apply,ihp,ihq]
    | monomial n a =>
      simp only [aeval_monomial,← Algebra.smul_def,LinearMap.smul_apply,T.map_smul,hpow]
  intro x i
  obtain ⟨p,hpx⟩ := hc x
  have hact (y : ∀ i,AdjoinRoot (g i)) :=
    primary_polynomial_action S g (LinearEquiv.refl K _) (fun _ => rfl) p y
  have hx : aeval (AdjoinRoot.root (g i)) p=x i := by
    have hh := congrFun ((hact 1).trans hpx) i
    simpa using hh
  have hty := congrFun (hact (T 1)) i
  change aeval (AdjoinRoot.root (g i)) p*T 1 i=((aeval S p) (T 1)) i at hty
  calc T x i=((aeval S p) (T 1)) i := by rw [← hpx,hp]
       _ = T 1 i*x i := by rw [← hty,hx,mul_comm]
variable {K ι : Type*} [Field K] [Fintype K] [Fintype ι]
variable (g : ι → K[X]) [∀ i, Fact (Irreducible (g i))]
abbrev ModelCentralizer :=
  {T : (∀ i,AdjoinRoot (g i)) ≃ₗ[K] (∀ i,AdjoinRoot (g i)) //
    ∀ x,T (fun i => AdjoinRoot.root (g i)*x i)=fun i => AdjoinRoot.root (g i)*T x i}
noncomputable def modelCentralizerEquivUnits
    (hcop : Pairwise (fun i j => IsCoprime (g i) (g j))) :
    ModelCentralizer g ≃ (∀ i,(AdjoinRoot (g i))ˣ) where
  toFun T i := Units.mk0 (T.val 1 i) (by
    obtain ⟨x,hx⟩ := T.val.surjective 1
    have hs := model_intertwiner_scalar g hcop T.val.toLinearMap T.property x i
    have hi : T.val x i=1 := congrFun hx i
    intro hz
    change T.val x i=T.val 1 i*x i at hs
    rw [hz,zero_mul,hi] at hs
    exact one_ne_zero hs)
  invFun z := ⟨LinearEquiv.piCongrRight (fun i =>
    Mathproof.Problem18PrimaryIntertwinerBoundary20260930.scalarEquiv (z i).val (z i).ne_zero),by
      intro x
      funext i
      change (z i).val*(AdjoinRoot.root (g i)*x i)=AdjoinRoot.root (g i)*((z i).val*x i)
      ring⟩
  left_inv T := by
    apply Subtype.ext
    ext x i
    exact (model_intertwiner_scalar g hcop T.val.toLinearMap T.property x i).symm
  right_inv z := by
    funext i
    apply Units.ext
    exact mul_one (z i).val
theorem model_centralizer_card
    (hcop : Pairwise (fun i j => IsCoprime (g i) (g j))) :
    Nat.card (ModelCentralizer g)=∏ i,(Nat.card K^(g i).natDegree-1) := by
  classical
  letI (i : ι) : FiniteDimensional K (AdjoinRoot (g i)) :=
    (AdjoinRoot.powerBasis (Fact.out : Irreducible (g i)).ne_zero).finite
  letI (i : ι) : Finite (AdjoinRoot (g i)) :=
    Finite.of_injective (Module.finBasis K (AdjoinRoot (g i))).equivFun
      (Module.finBasis K (AdjoinRoot (g i))).equivFun.injective
  rw [Nat.card_congr (modelCentralizerEquivUnits g hcop),Nat.card_pi]
  apply Finset.prod_congr rfl
  intro i _
  rw [Nat.card_units,Mathproof.Problem18DistinctDegreeSquare20260930.adjoinRoot_card]
noncomputable def modelOperator : Module.End K (∀ i,AdjoinRoot (g i)) where
  toFun x i := AdjoinRoot.root (g i)*x i
  map_add' x y := by funext i; exact mul_add _ _ _
  map_smul' a x := by
    funext i
    change AdjoinRoot.root (g i)*(a • x i)=a • (AdjoinRoot.root (g i)*x i)
    exact mul_smul_comm _ _ _
noncomputable local instance (i : ι) : FiniteDimensional K (AdjoinRoot (g i)) :=
  (AdjoinRoot.powerBasis (Fact.out : Irreducible (g i)).ne_zero).finite
theorem modelOperator_charpoly (hm : ∀ i,(g i).Monic)
    (hcop : Pairwise (fun i j => IsCoprime (g i) (g j))) :
    (modelOperator g).charpoly=∏ i,g i := by
  classical
  letI (i : ι) : FiniteDimensional K (AdjoinRoot (g i)) :=
    (AdjoinRoot.powerBasis (Fact.out : Irreducible (g i)).ne_zero).finite
  let f := ∏ i,g i
  have hfm : f.Monic := Polynomial.monic_prod_of_monic _ _ (fun i _ => hm i)
  let pb := AdjoinRoot.powerBasis hfm.ne_zero
  letI : FiniteDimensional K (AdjoinRoot f) := pb.finite
  let S := LinearMap.mulLeft K (AdjoinRoot.root f)
  have hf : S.charpoly=f := by
    rw [← LinearMap.charpoly_toMatrix S pb.basis]
    change (Algebra.leftMulMatrix pb.basis pb.gen).charpoly=f
    rw [charpoly_leftMulMatrix,AdjoinRoot.minpoly_powerBasis_gen_of_monic hfm]
  have hsq : Squarefree S.charpoly := by
    rw [hf]
    apply Finset.squarefree_prod_of_pairwise_isCoprime
    · intro i hi j hj hij
      exact (hcop hij).isRelPrime
    · intro i _
      exact (Fact.out : Irreducible (g i)).squarefree
  obtain ⟨e,E,hE,hact⟩ :=
    Mathproof.Problem18PrimaryAssemblyBoundary20260930.exists_simultaneous_primary_coordinates
      S g hm (fun i => Fact.out) hf hsq
  have he : modelOperator g=E.symm.conj S := by
    apply LinearMap.ext
    intro x
    funext i
    have hh := congrArg E.symm (hact x)
    have hh' : E.symm (S (E x))=(fun i => AdjoinRoot.root (g i)*x i) := by
      simpa only [LinearEquiv.symm_apply_apply] using hh.symm
    exact (congrFun hh' i).symm
  rw [he,LinearEquiv.charpoly_conj]
  exact hf
end
end Mathproof.Problem18SquarefreeModelAlgebra20260930
