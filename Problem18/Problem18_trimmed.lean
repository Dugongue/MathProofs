variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}
  (M : FieldMacros F r)
theorem evalB_congr_varsIn {B : ℕ} {l : List String} {σ τ : Env}
    (h : ∀ x ∈ l, τ.vars x = σ.vars x) :
    ∀ e : Expr, VarsIn l e → e.evalB B τ = e.evalB B σ
  | .lit _, _ => rfl
  | .var y, hy => by simp only [Expr.evalB]; rw [h y hy]
  | .get _ _, hf => hf.elim
  | .bin op e f, hef => by
    simp only [Expr.evalB]
    rw [evalB_congr_varsIn h e hef.1, evalB_congr_varsIn h f hef.2]
structure RowSlots extends MonoSlots where
  S0 : ℕ
  S1 : ℕ
  P : ℕ
def RowSlots.sum (rs : RowSlots) (b : Bool) : ℕ := if b then rs.S1 else rs.S0
structure RowSlots.Valid (rs : RowSlots) (n S cv box : ℕ) : Prop where
  mono : rs.toMonoSlots.Valid n S
  s0 : rs.S0 < S
  s1 : rs.S1 < S
  p : rs.P < S
  cfit : cv + box ≤ S
  s0_s1 : rs.S0 ≠ rs.S1
  s0_zero : rs.S0 ≠ 0
  s1_zero : rs.S1 ≠ 0
  p_s0 : rs.P ≠ rs.S0
  p_s1 : rs.P ≠ rs.S1
  s0_a0 : rs.S0 ≠ rs.A0
  s0_a1 : rs.S0 ≠ rs.A1
  s0_t : rs.S0 ≠ rs.T
  s1_a0 : rs.S1 ≠ rs.A0
  s1_a1 : rs.S1 ≠ rs.A1
  s1_t : rs.S1 ≠ rs.T
  p_a0 : rs.P ≠ rs.A0
  p_a1 : rs.P ≠ rs.A1
  p_t : rs.P ≠ rs.T
  c_p : ∀ k < box, cv + k ≠ rs.P
  c_s0 : ∀ k < box, cv + k ≠ rs.S0
  c_s1 : ∀ k < box, cv + k ≠ rs.S1
  c_a0 : ∀ k < box, cv + k ≠ rs.A0
  c_a1 : ∀ k < box, cv + k ≠ rs.A1
  c_t : ∀ k < box, cv + k ≠ rs.T
  p_x : ∀ i < n, rs.P ≠ rs.X + i
  s0_x : ∀ i < n, rs.S0 ≠ rs.X + i
  s1_x : ∀ i < n, rs.S1 ≠ rs.X + i
  one_a0 : rs.ONE ≠ rs.A0
  one_a1 : rs.ONE ≠ rs.A1
  one_t : rs.ONE ≠ rs.T
  one_p : rs.ONE ≠ rs.P
  one_s0 : rs.ONE ≠ rs.S0
  one_s1 : rs.ONE ≠ rs.S1
  zero_a0 : (0 : ℕ) ≠ rs.A0
  zero_a1 : (0 : ℕ) ≠ rs.A1
  zero_t : (0 : ℕ) ≠ rs.T
  zero_p : (0 : ℕ) ≠ rs.P
def expo {n : ℕ} (d : ℕ) (k : Fin (boundedExponents n d).length) : Fin n → ℕ :=
  fun i => (boundedExponents n d)[k.val] i
def rowSteps (WS : String) (rs : RowSlots) {n : ℕ} (d : ℕ) (cb : Expr) :
    List (Fin (boundedExponents n d).length) → Bool → Com
  | [], _ => .skip
  | k :: ks, b =>
    .seq (monoCom M WS rs.toMonoSlots (expo d k))
      (.seq (call r (addr r WS (.bin .add cb (.lit k.val))) (addr r WS (.lit (rs.out n)))
          (addr r WS (.lit rs.P)) M.mul)
        (.seq (call r (addr r WS (.lit (rs.sum b))) (addr r WS (.lit rs.P))
            (addr r WS (.lit (rs.sum (!b)))) M.add)
          (rowSteps WS rs d cb ks (!b))))
def rowStepCost {n : ℕ} (d : ℕ) (cbsz : ℕ) (k : Fin (boundedExponents n d).length) : ℕ :=
  monoCost M (expo d k) + (19 + cbsz + M.costMul) + (18 + M.costPoint)
def rowStepsCost {n : ℕ} (d : ℕ) (cbsz : ℕ) : List (Fin (boundedExponents n d).length) → ℕ
  | [] => 1
  | k :: ks => rowStepCost M d cbsz k + rowStepsCost d cbsz ks
def rowCom (WS : String) (rs : RowSlots) (n d : ℕ) (cb : Expr) : Com :=
  .seq (call r (addr r WS (.lit 0)) (addr r WS (.lit 0)) (addr r WS (.lit rs.S0)) M.copy)
    (rowSteps M WS rs d cb (List.finRange (boundedExponents n d).length) false)
def rowCost (n d : ℕ) (cbsz : ℕ) : ℕ :=
  18 + M.costPoint + rowStepsCost M d cbsz (List.finRange (boundedExponents n d).length)
def RowSlots.out (rs : RowSlots) (n d : ℕ) : ℕ := rs.sum (parity false (boundedExponents n d).length)
theorem sum_lt {rs : RowSlots} {n S cv box : ℕ} (hv : rs.Valid n S cv box) (b : Bool) :
    rs.sum b < S := by
  cases b <;> simp [RowSlots.sum, hv.s0, hv.s1]
theorem sum_ne_sum {rs : RowSlots} {n S cv box : ℕ} (hv : rs.Valid n S cv box) (b : Bool) :
    rs.sum (!b) ≠ rs.sum b := by
  cases b <;> simp [RowSlots.sum, hv.s0_s1, hv.s0_s1.symm]
theorem sum_ne_p {rs : RowSlots} {n S cv box : ℕ} (hv : rs.Valid n S cv box) (b : Bool) :
    rs.sum b ≠ rs.P := by
  cases b <;> simp [RowSlots.sum, hv.p_s0.symm, hv.p_s1.symm]
theorem sum_ne_a0 {rs : RowSlots} {n S cv box : ℕ} (hv : rs.Valid n S cv box) (b : Bool) :
    rs.sum b ≠ rs.A0 := by
  cases b <;> simp [RowSlots.sum, hv.s0_a0, hv.s1_a0]
theorem sum_ne_a1 {rs : RowSlots} {n S cv box : ℕ} (hv : rs.Valid n S cv box) (b : Bool) :
    rs.sum b ≠ rs.A1 := by
  cases b <;> simp [RowSlots.sum, hv.s0_a1, hv.s1_a1]
theorem sum_ne_t {rs : RowSlots} {n S cv box : ℕ} (hv : rs.Valid n S cv box) (b : Bool) :
    rs.sum b ≠ rs.T := by
  cases b <;> simp [RowSlots.sum, hv.s0_t, hv.s1_t]
theorem ne_sum_of {rs : RowSlots} {s : ℕ} (h0 : s ≠ rs.S0) (h1 : s ≠ rs.S1) (b : Bool) :
    s ≠ rs.sum b := by
  cases b <;> simp [RowSlots.sum, h0, h1]
theorem out_ne_p {rs : RowSlots} {n S cv box : ℕ} (hv : rs.Valid n S cv box) :
    rs.toMonoSlots.out n ≠ rs.P := by
  unfold MonoSlots.out
  cases parity false n <;> simp [MonoSlots.acc, hv.p_a0.symm, hv.p_a1.symm]
theorem out_lt {rs : RowSlots} {n S cv box : ℕ} (hv : rs.Valid n S cv box) :
    rs.toMonoSlots.out n < S := acc_lt hv.mono _
theorem expo_lt {n d B : ℕ} (hdB : d < B) (k : Fin (boundedExponents n d).length) (i : Fin n) :
    expo d k i < B := by
  unfold expo
  have := (mem_boundedExponents_iff _).mp (List.getElem_mem k.isLt) i
  omega
def RowFrame (σ τ : Env) : Prop :=
  ∀ y, y ∉ clobbered r → y ≠ r.aBase → y ≠ r.bBase → y ≠ r.outBase → y ≠ r.exp →
    τ.vars y = σ.vars y
theorem frame_vars {l : List String} (hl : ∀ x ∈ l, x ∉ regNames r) {σ τ : Env}
    (h : RowFrame (r := r) σ τ) : ∀ x ∈ l, τ.vars x = σ.vars x := by
  intro x hx
  have hx' := hl x hx
  refine h x (fun hc => hx' (clobbered_reg r x hc)) ?_ ?_ ?_ ?_ <;>
    (intro he; apply hx'; rw [he]; simp [regNames, scalarNames])
noncomputable def monoVal (F : FieldPresentation K) (r : FieldNames) (WS : String) (rs : RowSlots)
    {n : ℕ} (d : ℕ) (σ : Env) (k : Fin (boundedExponents n d).length) : K :=
  ∏ i, val F r WS σ (rs.X + i.val) ^ expo d k i
theorem rowSteps_run {WS : String} {S B n d cv : ℕ} (rs : RowSlots)
    (hv : rs.Valid n S cv (boundedExponents n d).length) (hdB : d < B)
    (cb : Expr) (l0 : List String) (hl0 : ∀ x ∈ l0, x ∉ regNames r) (hcbV : VarsIn l0 cb) :
    ∀ (l : List (Fin (boundedExponents n d).length)) (b : Bool) (σ : Env),
      Slots F r WS S B σ → cb.evalB B σ = some cv → val F r WS σ rs.ONE = 1 →
    ∃ τ : Env, Run B (rowSteps M WS rs d cb l b) σ τ (rowStepsCost M d cb.size l) ∧
      Slots F r WS S B τ ∧
      val F r WS τ (rs.sum (parity b l.length)) =
        val F r WS σ (rs.sum b) +
          (l.map fun k => val F r WS σ (cv + k.val) * monoVal F r WS rs d σ k).sum ∧
      (∀ s < S, s ≠ rs.A0 → s ≠ rs.A1 → s ≠ rs.T → s ≠ rs.P → s ≠ rs.S0 → s ≠ rs.S1 →
        val F r WS τ s = val F r WS σ s) ∧
      RowFrame (r := r) σ τ ∧
      (∀ arr, arr ≠ r.mem → arr ≠ r.scratch → τ.arrs arr = σ.arrs arr) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  intro l
  induction l with
  | nil =>
    intro b σ hS _ _
    refine ⟨σ, Run.skip, hS, ?_, fun _ _ _ _ _ _ _ _ => rfl, fun _ _ _ _ _ _ => rfl,
      fun _ _ _ => rfl, rfl, rfl⟩
    simp [parity]
  | cons k ks ih =>
    intro b σ hS hcb hone
    have hSB := hS.slots_word
    have hmono := hv.mono
    have hk := k.isLt
    have hck : cv + k.val < S := by have := hv.cfit; omega
    obtain ⟨τ₁, hrun₁, hS₁, hval₁, hoth₁, hvars₁, harr₁, hinp₁, hout₁⟩ :=
      monoCom_run M rs.toMonoSlots hmono (expo d k) (expo_lt hdB k) hS hone
    have hc₁ : val F r WS τ₁ (cv + k.val) = val F r WS σ (cv + k.val) :=
      hoth₁ _ hck (hv.c_a0 _ hk) (hv.c_a1 _ hk) (hv.c_t _ hk)
    have hsum₁ : ∀ b', val F r WS τ₁ (rs.sum b') = val F r WS σ (rs.sum b') := fun b' =>
      hoth₁ _ (sum_lt hv b') (sum_ne_a0 hv b') (sum_ne_a1 hv b') (sum_ne_t hv b')
    have hcb₁ : cb.evalB B τ₁ = some cv := by
      rw [evalB_congr_varsIn (frame_vars hl0 hvars₁) cb hcbV]; exact hcb
    have hcbk : (Expr.bin .add cb (.lit k.val)).evalB B τ₁ = some (cv + k.val) :=
      evalB_bin hcb₁ (evalB_lit (by omega)) (by change cv + k.val < B; omega)
    have hnoA : NoVar r.aBase (Expr.lit (rs.toMonoSlots.out n)) := trivial
    obtain ⟨τ₂, hrun₂, hval₂, hres₂⟩ :=
      slot_call F r M.mul_spec hS₁ (.bin .add cb (.lit k.val)) (.lit (rs.toMonoSlots.out n))
        (.lit rs.P) hcbk (evalB_lit (by have := out_lt hv; omega))
        (evalB_lit (by have := hv.p; omega)) hnoA trivial trivial
        hck (out_lt hv) hv.p (hv.c_p _ hk).symm (out_ne_p hv).symm
    obtain ⟨τ₃, hrun₃, hval₃, hres₃⟩ :=
      slot_call F r M.add_spec hres₂.slots (.lit (rs.sum b)) (.lit rs.P) (.lit (rs.sum (!b)))
        (evalB_lit (by have := sum_lt hv b; omega)) (evalB_lit (by have := hv.p; omega))
        (evalB_lit (by have := sum_lt hv (!b); omega)) trivial trivial trivial
        (sum_lt hv b) hv.p (sum_lt hv (!b)) (sum_ne_sum hv b) (sum_ne_p hv (!b))
    have hframe₃ : RowFrame (r := r) σ τ₃ := by
      intro y hy h1 h2 h3 h4
      rw [hres₃.vars y hy h1 h2 h3, hres₂.vars y hy h1 h2 h3, hvars₁ y hy h1 h2 h3 h4]
    have hcb₃ : cb.evalB B τ₃ = some cv := by
      rw [evalB_congr_varsIn (frame_vars hl0 hframe₃) cb hcbV]; exact hcb
    have hone₃ : val F r WS τ₃ rs.ONE = 1 := by
      rw [val_of_slice_eq (hres₃.others _ hmono.one (ne_sum_of hv.one_s0 hv.one_s1 (!b))),
        val_of_slice_eq (hres₂.others _ hmono.one hv.one_p),
        hoth₁ _ hmono.one hv.one_a0 hv.one_a1 hv.one_t, hone]
    obtain ⟨τ₄, hrun₄, hS₄, hval₄, hoth₄, hvars₄, harr₄, hinp₄, hout₄⟩ :=
      ih (!b) τ₃ hres₃.slots hcb₃ hone₃
    have hsurv : ∀ s < S, s ≠ rs.A0 → s ≠ rs.A1 → s ≠ rs.T → s ≠ rs.P → s ≠ rs.S0 → s ≠ rs.S1 →
        val F r WS τ₃ s = val F r WS σ s := by
      intro s hs h0 h1 ht hp hs0 hs1
      rw [val_of_slice_eq (hres₃.others s hs (ne_sum_of hs0 hs1 (!b))),
        val_of_slice_eq (hres₂.others s hs hp), hoth₁ s hs h0 h1 ht]
    have hx₃ : ∀ j : Fin n, val F r WS τ₃ (rs.X + j.val) = val F r WS σ (rs.X + j.val) := by
      intro j
      have hj : rs.X + j.val < S := by have := j.isLt; have := hmono.fit; omega
      exact hsurv _ hj (hmono.a0_x _ j.isLt).symm (hmono.a1_x _ j.isLt).symm
        (hmono.t_x _ j.isLt).symm (hv.p_x _ j.isLt).symm (hv.s0_x _ j.isLt).symm
        (hv.s1_x _ j.isLt).symm
    have hmono₃ : ∀ k' : Fin (boundedExponents n d).length,
        monoVal F r WS rs d τ₃ k' = monoVal F r WS rs d σ k' := by
      intro k'
      unfold monoVal
      exact Finset.prod_congr rfl (fun i _ => by rw [hx₃ i])
    have hc₃ : ∀ k' : Fin (boundedExponents n d).length,
        val F r WS τ₃ (cv + k'.val) = val F r WS σ (cv + k'.val) := by
      intro k'
      have hk' := k'.isLt
      exact hsurv _ (by have := hv.cfit; omega) (hv.c_a0 _ hk') (hv.c_a1 _ hk') (hv.c_t _ hk')
        (hv.c_p _ hk') (hv.c_s0 _ hk') (hv.c_s1 _ hk')
    have hsum₂ : val F r WS τ₂ (rs.sum b) = val F r WS σ (rs.sum b) := by
      rw [val_of_slice_eq (hres₂.others _ (sum_lt hv b) (sum_ne_p hv b)), hsum₁]
    refine ⟨τ₄, ?_, hS₄, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · have h := hrun₁.seq (hrun₂.seq (hrun₃.seq hrun₄))
      refine h.mono ?_
      simp only [rowStepsCost, rowStepCost, Expr.size]
      omega
    · rw [List.length_cons, flip_succ, hval₄, hval₃, hval₂, hval₁, hsum₂, hc₁,
        List.map_cons, List.sum_cons]
      rw [List.map_congr_left (fun k' _ => by rw [hc₃ k', hmono₃ k'])]
      unfold monoVal
      ring
    · intro s hs h0 h1 ht hp hs0 hs1
      rw [hoth₄ s hs h0 h1 ht hp hs0 hs1, hsurv s hs h0 h1 ht hp hs0 hs1]
    · intro y hy h1 h2 h3 h4
      rw [hvars₄ y hy h1 h2 h3 h4, hframe₃ y hy h1 h2 h3 h4]
    · intro arr h1 h2
      rw [harr₄ arr h1 h2, hres₃.arrays arr h1 h2, hres₂.arrays arr h1 h2, harr₁ arr h1 h2]
    · rw [hinp₄, hres₃.inp, hres₂.inp, hinp₁]
    · rw [hout₄, hres₃.out, hres₂.out, hout₁]
theorem rowCom_run {WS : String} {S B n d cv : ℕ} (rs : RowSlots)
    (hv : rs.Valid n S cv (boundedExponents n d).length) (hdB : d < B)
    (cb : Expr) (l0 : List String) (hl0 : ∀ x ∈ l0, x ∉ regNames r) (hcbV : VarsIn l0 cb)
    {σ : Env} (hS : Slots F r WS S B σ) (hcb : cb.evalB B σ = some cv)
    (hone : val F r WS σ rs.ONE = 1) (hzero : val F r WS σ 0 = 0) :
    ∃ τ : Env, Run B (rowCom M WS rs n d cb) σ τ (rowCost M n d cb.size) ∧
      Slots F r WS S B τ ∧
      val F r WS τ (rs.out n d) =
        denseEval (fun i : Fin n => val F r WS σ (rs.X + i.val))
          (fun k : Fin (boundedExponents n d).length => val F r WS σ (cv + k.val)) ∧
      (∀ s < S, s ≠ rs.A0 → s ≠ rs.A1 → s ≠ rs.T → s ≠ rs.P → s ≠ rs.S0 → s ≠ rs.S1 →
        val F r WS τ s = val F r WS σ s) ∧
      RowFrame (r := r) σ τ ∧
      (∀ arr, arr ≠ r.mem → arr ≠ r.scratch → τ.arrs arr = σ.arrs arr) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hSB := hS.slots_word
  have hmono := hv.mono
  have hpos := hmono.pos
  obtain ⟨τ₁, hrun₁, hval₁, hres₁⟩ :=
    slot_call F r M.copy_spec hS (.lit 0) (.lit 0) (.lit rs.S0)
      (evalB_lit (by omega)) (evalB_lit (by omega)) (evalB_lit (by have := hv.s0; omega))
      trivial trivial trivial hpos hpos hv.s0 hv.s0_zero hv.s0_zero
  have hframe₁ : RowFrame (r := r) σ τ₁ := fun y hy h1 h2 h3 _ => hres₁.vars y hy h1 h2 h3
