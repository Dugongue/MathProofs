  exact optional_memory h
theorem squared_values (h : BufferInput F r B σ) :
    bufferValue F r (squaredState r σ) 2=bufferValue F r σ 2*bufferValue F r σ 2 ∧
    bufferValue F r (squaredState r σ) 3=
      if σ.vars r.exponent%2=1 then bufferValue F r σ 3*bufferValue F r σ 2
      else bufferValue F r σ 3 := by
  have ho:=optional_preserves h
  have hm:=ho.multiply_preserves (a:=2) (b:=2) (out:=4) (by simp) (by simp) (by simp)
  constructor
  · have hh:bufferValue F r (squaredState r σ) 2=
        bufferValue F r (optionalState r σ) 2*bufferValue F r (optionalState r σ) 2 :=
      (hm.copy_value (by simp) (by simp) (by decide)).1.trans
        (ho.multiply_value (by simp) (by simp) (by simp)).1
    simpa only [(optional_values h).1] using hh
  · have hh:bufferCoeffs F r (squaredState r σ) 3=bufferCoeffs F r (optionalState r σ) 3 := by
      unfold squaredState
      rw [hm.copy_other (src:=4) (out:=2) (by simp) (by decide),
        ho.multiply_other (by simp) (by simp) (by simp) (by simp) (by decide)]
    unfold bufferValue
    rw [hh]
    exact (optional_values h).2
theorem powerNext_preserves (h : BufferInput F r B σ) :
    BufferInput F r B (powerNext r σ) :=
  BufferInput.setExponent (squared_preserves h) _ ((Nat.div_le_self _ _).trans_lt h.exponent_word)
theorem powerNext_exponent (r : FieldNames) (σ : Env) :
    (powerNext r σ).vars r.exponent=σ.vars r.exponent/2 := by simp [powerNext]
theorem powerNext_memory (h : BufferInput F r B σ) :
    (powerNext r σ).arrs r.mem=σ.arrs r.mem := squared_memory h
theorem powerNext_vars (h : BufferInput F r B σ) (x : String)
    (hx : x∈scalarNames r) (he : x≠r.exponent) :
    (powerNext r σ).vars x=σ.vars x := by
  simpa [powerNext,he] using squared_vars h x hx
theorem powerBody_invariant (h : BufferInput F r B σ) :
    bufferValue F r (powerNext r σ) 3 *
        bufferValue F r (powerNext r σ) 2 ^ (powerNext r σ).vars r.exponent =
      bufferValue F r σ 3 * bufferValue F r σ 2 ^ σ.vars r.exponent := by
  have hv:=squared_values h
  change bufferValue F r (squaredState r σ) 3 *
      bufferValue F r (squaredState r σ) 2 ^ (powerNext r σ).vars r.exponent = _
  rw [powerNext_exponent,hv.1,hv.2]
  exact binary_step_invariant _ _ _
theorem powerBody_run (h : BufferInput F r B σ) :
    Run B (powerBody r) σ (powerNext r σ) (30000*(F.e+1)^2) := by
  have ho:=optional_preserves h
  have hm:=ho.multiply_preserves (a:=2) (b:=2) (out:=4) (by simp) (by simp) (by simp)
  have hfirst:=optional_run h
  have hsecond:=ho.multiply_run (a:=2) (b:=2) (out:=4) (by simp) (by simp) (by simp)
  have hthird:=hm.copy_run (src:=4) (out:=2) (by simp) (by simp) (by decide)
  have heq:(squaredState r σ).vars r.exponent=σ.vars r.exponent:=
    squared_vars h r.exponent (by simp [scalarNames])
  have h2:2<B:=by have hf:=h.scratch_fit; have hw:=h.scratch_word; have he:=F.degree_pos; omega
  have hdiv:(Expr.div (.var r.exponent) (.lit 2)).evalB B (squaredState r σ)=
      some (σ.vars r.exponent/2) := by
    have hh:=evalB_bin (op:=Bop.div)
      (evalB_var (σ:=squaredState r σ) (x:=r.exponent) (by rw [heq]; exact h.exponent_word))
      (evalB_lit h2) (by
        change (squaredState r σ).vars r.exponent/2<B
        rw [heq]
        exact (Nat.div_le_self _ _).trans_lt h.exponent_word)
    simpa only [heq,Bop.apply] using hh
  have hr:=hfirst.seq (hsecond.seq (hthird.seq (Run.assign (x:=r.exponent) hdiv)))
  apply hr.mono
  simp only [Expr.size]
  nlinarith
theorem powerLoop_run (h : BufferInput F r B σ) :
    ∃τ,Run B (.while (.lt (.lit 0) (.var r.exponent)) (powerBody r)) σ τ
        ((30000*(F.e+1)^2+4)*(σ.vars r.exponent).size+4) ∧
      BufferInput F r B τ ∧ τ.vars r.exponent=0 ∧
      bufferValue F r τ 3=bufferValue F r σ 3*bufferValue F r σ 2^σ.vars r.exponent ∧
      τ.arrs r.mem=σ.arrs r.mem ∧
      (∀x∈scalarNames r,x≠r.exponent → τ.vars x=σ.vars x) := by
  let I : Env→Prop:=fun τ=>BufferInput F r B τ ∧ τ.vars r.exponent≤σ.vars r.exponent ∧
    bufferValue F r τ 3*bufferValue F r τ 2^τ.vars r.exponent=
      bufferValue F r σ 3*bufferValue F r σ 2^σ.vars r.exponent ∧
    τ.arrs r.mem=σ.arrs r.mem ∧
    (∀x∈scalarNames r,x≠r.exponent → τ.vars x=σ.vars x)
  have h0:0<B:=by have he:=F.degree_pos; have hf:=h.scratch_fit; have hw:=h.scratch_word; omega
  have hdef:∀τ,I τ → ∃v,(Cond.lt (.lit 0) (.var r.exponent)).evalB B τ=some v := by
    intro τ hτ
    exact ⟨_,evalB_condLt (evalB_lit h0) (evalB_var hτ.1.exponent_word)⟩
  have hstep:∀τ,I τ → (Cond.lt (.lit 0) (.var r.exponent)).evalB B τ=some true →
      ∃τ',Run B (powerBody r) τ τ' (30000*(F.e+1)^2) ∧ I τ' ∧
        (τ'.vars r.exponent).size<(τ.vars r.exponent).size := by
    intro τ hτ ht
    have he:0<τ.vars r.exponent:=by
      have hv:=evalB_condLt (evalB_lit h0) (evalB_var hτ.1.exponent_word)
      rw [ht] at hv
      simpa using hv.symm
    refine ⟨powerNext r τ,powerBody_run hτ.1,?_,?_⟩
    · refine ⟨powerNext_preserves hτ.1,?_,(powerBody_invariant hτ.1).trans hτ.2.2.1,
        (powerNext_memory hτ.1).trans hτ.2.2.2.1,?_⟩
      · rw [powerNext_exponent]
        exact (Nat.div_le_self _ _).trans hτ.2.1
      · intro x hx hxe
        exact (powerNext_vars hτ.1 x hx hxe).trans (hτ.2.2.2.2 x hx hxe)
    · rw [powerNext_exponent]
      exact Problem18IMPModularPower20261001.size_half_lt he
  obtain ⟨τ,hr,hI,hfalse⟩:=Run.while_count I (fun τ=>(τ.vars r.exponent).size)
    (30000*(F.e+1)^2) hdef hstep (σ:=σ) ⟨h,le_rfl,rfl,rfl,by intros; rfl⟩
  have he:τ.vars r.exponent=0:=by
    have hv:=evalB_condLt (evalB_lit h0) (evalB_var hI.1.exponent_word)
    rw [hfalse] at hv
    have hh:¬0<τ.vars r.exponent:=by simpa using hv.symm
    omega
  refine ⟨τ,?_,hI.1,he,?_,hI.2.2.2.1,hI.2.2.2.2⟩
  · apply hr.mono
    apply le_of_eq
    simp only [Cond.size,Expr.size]
    ring
  · simpa only [he,pow_zero,mul_one] using hI.2.2.1
end Mathproof.Problem18IMPFieldPowerLoop20261001
