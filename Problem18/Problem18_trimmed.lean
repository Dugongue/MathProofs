  have htwo : 2 ≤ Module.finrank K (pairCommutant H T) := by omega
  refine ⟨Module.finrank K (pairCommutant H T), hp, ?_⟩
  letI : NeZero (Module.finrank K (pairCommutant H T)) := ⟨Nat.ne_of_gt hp⟩
  refine ⟨htwo, Nat.le_of_dvd hv hd, ?_⟩
