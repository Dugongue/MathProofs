        Nat.card (Fin m → V × V) ≤
      4 * (p + 1) *
        ((Fintype.card K : ℝ) ^ ((t * (m + m)) / 16))⁻¹ := by
  calc
    _ ≤ (Nat.card (CrossZeroPairs (K := K) p (m + m) z) : ℝ) /
          Nat.card
            (Matrix (Fin p) (Fin (m + m)) K ×
              Matrix (Fin z) (Fin (m + m)) K) :=
      preservingSample_probability_le_crossZero
