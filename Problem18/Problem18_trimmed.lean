  have hN₁ : σ₁.vars q.N=N := by simp [σ₁]
  have hn₁ : σ₁.vars q.n=N := by simpa only [σ₁,vars_setVar,if_neg (by decide : q.n≠q.N)] using hn
  have hp₁ : σ₁.vars pReg=ps := by simpa only [σ₁,vars_setVar,if_neg (by decide : pReg≠q.N)] using hp
  have hg₁ : σ₁.vars gReg=gs := by simpa only [σ₁,vars_setVar,if_neg (by decide : gReg≠q.N)] using hg
