variable {K : Type*} [Field K] [Fintype K]
def order {n : ℕ} (a : Fin n → K) : ℤ :=
  Nat.card (Isometries (RingEquiv.refl K) (diagonalForm a))
def orderProduct (q : ℤ) (m : ℕ) := ∏ k∈Finset.range m,(q^(2*(k+1))-1)
theorem order_zero (a : Fin 0 → K) : order a=1 := by
  letI : Unique (Isometries (RingEquiv.refl K) (diagonalForm a)) :=
    ⟨⟨⟨LinearEquiv.refl K _,by intros; rfl⟩⟩,fun Q => Subtype.ext (Subsingleton.elim _ _)⟩
  simp [order,Nat.card_unique]
theorem order_recurrence (hodd : ringChar K≠2) {n : ℕ}
    (a : Fin (n+1) → K) (ha : ∀ i,a i≠0) :
    order a=weightedCount a (a 0)*order (Fin.tail a) := by
  have h := diagonal_isometry_card_recurrence a ha (Ring.two_ne_zero hodd)
  unfold order weightedCount weightedSum
  exact_mod_cast h
theorem discriminant_nonzero {n : ℕ} (a : Fin n → K) (ha : ∀ i,a i≠0) :
    discriminant a≠0 := by
  unfold discriminant
  exact mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero))
    (Finset.prod_ne_zero_iff.mpr (fun i _ => ha i))
theorem odd_head_discriminant (m : ℕ) (a : Fin (2*m+1) → K) (ha : a 0≠0) :
    quadraticChar K (discriminant a*a 0)=quadraticChar K (discriminant (Fin.tail a)) := by
  have he : discriminant a*a 0=(a 0)^2*discriminant (Fin.tail a) := by
    unfold discriminant
    rw [show (2*m+1)/2=m by omega,show (2*m)/2=m by omega,Fin.prod_univ_succ]
    simp only [Fin.tail]
    ring
  rw [he,map_mul,quadraticChar_sq_one' ha,one_mul]
theorem even_order_of_odd (hodd : ringChar K≠2) (m : ℕ)
    (hO : ∀ a : Fin (2*m+1) → K,(∀ i,a i≠0) →
      order a=2*(Nat.card K:ℤ)^(m*m)*orderProduct (Nat.card K) m)
    (a : Fin (2*m+2) → K) (ha : ∀ i,a i≠0) :
    order a=2*(Nat.card K:ℤ)^(m*(m+1))*
      ((Nat.card K:ℤ)^(m+1)-quadraticChar K (discriminant a))*orderProduct (Nat.card K) m := by
  rw [order_recurrence hodd a ha,weighted_even_count hodd m a ha,if_neg (ha 0),
    hO (Fin.tail a) (fun i => ha i.succ)]
  have hp : (Nat.card K:ℤ)^(2*m+1)=
      (Nat.card K:ℤ)^m*(Nat.card K:ℤ)^(m+1) := by rw [← pow_add]; congr 1; omega
  have hpow : (Nat.card K:ℤ)^(m*(m+1))=
      (Nat.card K:ℤ)^m*(Nat.card K:ℤ)^(m*m) := by
    rw [← pow_add]; congr 1; ring
  rw [hp,hpow]
  ring
theorem odd_order_step (hodd : ringChar K≠2) (m : ℕ)
    (hE : ∀ a : Fin (2*m+2) → K,(∀ i,a i≠0) →
      order a=2*(Nat.card K:ℤ)^(m*(m+1))*
        ((Nat.card K:ℤ)^(m+1)-quadraticChar K (discriminant a))*orderProduct (Nat.card K) m)
    (a : Fin (2*(m+1)+1) → K) (ha : ∀ i,a i≠0) :
    order a=2*(Nat.card K:ℤ)^((m+1)*(m+1))*orderProduct (Nat.card K) (m+1) := by
  have hdim : 2*(m+1)=2*m+2 := by omega
  have ht : order (Fin.tail a)=2*(Nat.card K:ℤ)^(m*(m+1))*
      ((Nat.card K:ℤ)^(m+1)-quadraticChar K (discriminant (Fin.tail a)))*
      orderProduct (Nat.card K) m := by
    generalize hb : Fin.tail a=b
    have hb0 : ∀ i,b i≠0 := by rw [← hb]; exact fun i => ha i.succ
    clear hb
    revert b hb0
    rw [hdim]
    exact hE
  rw [order_recurrence hodd a ha,weighted_odd_count hodd (m+1) a ha,
    odd_head_discriminant (m+1) a (ha 0),ht]
  let q : ℤ := Nat.card K
  let e : ℤ := quadraticChar K (discriminant (Fin.tail a))
  have he : e^2=1 := quadraticChar_sq_one (discriminant_nonzero (Fin.tail a) (fun i => ha i.succ))
  have hc := Mathproof.Problem18OddOrderAlgebra20260930.discriminant_cancel q e (m+1) he
  have hp : q^(2*(m+1))=q^(m+1)*q^(m+1) := by rw [← pow_add]; congr 1; omega
  have hpow : q^((m+1)*(m+1))=q^(m+1)*q^(m*(m+1)) := by
    rw [← pow_add]; congr 1; ring
  change (q^(2*(m+1))+e*q^(m+1))*(2*q^(m*(m+1))*(q^(m+1)-e)*orderProduct q m)=
    2*q^((m+1)*(m+1))*orderProduct q (m+1)
  have hprod : orderProduct q (m+1)=orderProduct q m*(q^(2*(m+1))-1) := by
    exact Finset.prod_range_succ (fun k => q^(2*(k+1))-1) m
  rw [hprod]
  change _=2*q^((m+1)*(m+1))*(orderProduct q m*(q^(2*(m+1))-1))
  rw [hp,hpow] at *
  linear_combination 2*q^(m+1)*q^(m*(m+1))*orderProduct q m * hc
theorem odd_order (hodd : ringChar K≠2) (m : ℕ)
    (a : Fin (2*m+1) → K) (ha : ∀ i,a i≠0) :
    order a=2*(Nat.card K:ℤ)^(m*m)*orderProduct (Nat.card K) m := by
  induction m with
  | zero =>
    rw [order_recurrence hodd a ha,weightedCount_one hodd a (ha 0),order_zero]
    simp only [← pow_two,quadraticChar_sq_one' (ha 0)]
    norm_num [orderProduct]
  | succ m ih =>
    exact odd_order_step hodd m (even_order_of_odd hodd m (fun b hb => ih b hb)) a ha
theorem even_order (hodd : ringChar K≠2) (m : ℕ)
    (a : Fin (2*m+2) → K) (ha : ∀ i,a i≠0) :
    order a=2*(Nat.card K:ℤ)^(m*(m+1))*
      ((Nat.card K:ℤ)^(m+1)-quadraticChar K (discriminant a))*orderProduct (Nat.card K) m :=
  even_order_of_odd hodd m (odd_order hodd m) a ha
end Mathproof.Problem18OddFormOrderProduct20260930
end
