theorem natDegree_minpoly_le (a : E) : (minpoly F a).natDegree ≤ Module.finrank F E :=
  minpoly.natDegree_le a
theorem exists_primitive_combination (hq : Module.finrank F E * Module.finrank F E < Fintype.card K) :
    ∀ (n : Nat) (x : Fin n → E), ∃ c : Fin n → K,
      adjoin F (Set.range x) = F⟮∑ j, algebraMap K F (c j) • x j⟯ := by
  intro n
  induction n with
  | zero =>
    intro x
    refine ⟨fun i => i.elim0, ?_⟩
    rw [Set.range_eq_empty, Finset.univ_eq_empty, Finset.sum_empty, adjoin_zero, adjoin_empty]
  | succ n ih =>
    intro x
    obtain ⟨c, hc⟩ := ih (Fin.tail x)
    set y : E := ∑ j, algebraMap K F (c j) • Fin.tail x j with hy
    have hrange : Set.range x = insert (x 0) (Set.range (Fin.tail x)) := by
      conv_lhs => rw [← Fin.cons_self_tail x]
      exact Fin.range_cons _ _
    have hpair : adjoin F (Set.range x) = F⟮x 0, y⟯ := by
      rw [hrange, ← adjoin_insert_adjoin, hc, adjoin_insert_adjoin]
    have hdeg : (minpoly F (x 0)).natDegree * (minpoly F y).natDegree < Fintype.card K :=
      lt_of_le_of_lt (Nat.mul_le_mul (natDegree_minpoly_le F (x 0)) (natDegree_minpoly_le F y)) hq
    obtain ⟨d, hd⟩ := exists_pair_coefficient F (x 0) y K hdeg
    refine ⟨Fin.cons 1 (fun j => d * c j), ?_⟩
    rw [hpair, hd]
    congr 2
    rw [Fin.sum_univ_succ, Fin.cons_zero, map_one, one_smul, hy, Finset.smul_sum]
    congr 1
    apply Finset.sum_congr rfl
    intro j _
    rw [Fin.cons_succ, map_mul, mul_smul]
    rfl
end Family
