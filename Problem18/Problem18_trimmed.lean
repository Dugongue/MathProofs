    simp [V, Cond.size, Expr.size]
    omega
  refine ⟨τ, hrun, fun k hk => hin k (by omega), fun j hj' => hout j (by omega), hlen, harr, ?_, ?_, ?_⟩
  · intro x hx
    apply (run_frame hrun).1 x
    simp [zfill, zbody, scalarWrites, hx]
  · exact (run_frame hrun).2.2.2.1 (by simp [zfill, zbody, noRead])
  · exact (run_frame hrun).2.2.2.2 (by simp [zfill, zbody, Com.NoWrite])
end Mathproof.Problem18PairBoundaryModeC2Zero20261004
