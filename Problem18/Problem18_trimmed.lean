    (Finset.univ.filter (fun d : Fin n → K =>
      ‖(∑ x : S, ψ (completion Q d x)) / (Fintype.card S : ℂ)‖^2 ≠ 0)).card =
      Fintype.card K ^ (n - Module.finrank K S) := by
  have hz : (Q.comp S.subtype).polarBilin = 0 := by
    ext x y
