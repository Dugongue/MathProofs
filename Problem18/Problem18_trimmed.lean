  intro x
  have he : e.val.symm (t*x)=AdjoinRoot.root R.charpoly*e.val.symm x := by
    apply e.val.injective
    rw [e.val.apply_symm_apply,e.property,e.val.apply_symm_apply]
    rfl
  change f.val (e.val.symm (t*x))=S (f.val (e.val.symm x))
