variable {K : Type} [Field K] [Fintype K] (F : FieldPresentation K) (r : FieldNames)
def digitVec (mv i : Nat) : Fin F.e → Fin F.p :=
  fun j => ⟨mv / F.p ^ (i * F.e + j.val) % F.p, Nat.mod_lt _ F.prime.pos⟩
noncomputable def digitCoord (mv i : Nat) : K := F.coordinate.symm (digitVec F mv i)
theorem decode_digitVec (mv i : Nat) :
    decode F (fun j => (digitVec F mv i j).val) = digitCoord F mv i := by
  unfold digitCoord
  have := (F.coordinate_spec (F.coordinate.symm (digitVec F mv i))).symm
  simpa [decode] using this
def digitsSlotsCom (WS w k m : String) (s cnt : Nat) : Com :=
  digitsCom r WS w k m (.lit s) (.bin .mul (.lit cnt) (.var r.e))
def digitsSlotsCost (cnt e : Nat) : Nat := digitsCost 1 3 (cnt * e)
theorem reg_ne_of_not_mem {x y : String} (hx : x ∉ regNames r) (hy : y ∈ regNames r) : y ≠ x :=
  fun h => hx (h ▸ hy)
theorem mem_regNames_e : r.e ∈ regNames r := by simp [regNames, scalarNames]
theorem mem_regNames_p : r.p ∈ regNames r := by simp [regNames, scalarNames]
theorem mem_regNames_modBase : r.modBase ∈ regNames r := by simp [regNames, scalarNames]
theorem mem_regNames_exp : r.exp ∈ regNames r := by simp [regNames, scalarNames]
theorem digits_slots {WS w k m : String} {S B : Nat} {σ : Env} (hS : Slots F r WS S B σ)
    (hw : w ∉ regNames r) (hk : k ∉ regNames r) (hwWS : w ≠ WS) (hkWS : k ≠ WS) (hwk : w ≠ k)
    (hwm : w ≠ m) (hkm : k ≠ m) (s cnt : Nat) (hfit : s + cnt ≤ S) (hmv : σ.vars m < B) :
    ∃ τ : Env, Run B (digitsSlotsCom r WS w k m s cnt) σ τ (digitsSlotsCost cnt F.e) ∧
      Slots F r WS S B τ ∧
      (∀ i < cnt, val F r WS τ (s + i) = digitCoord F (σ.vars m) i) ∧
      (∀ t < S, (t < s ∨ s + cnt ≤ t) → val F r WS τ t = val F r WS σ t) ∧
      (∀ x, x ≠ w → x ≠ k → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out := by
  classical
  have hb := hS.base
  have heB := e_lt F r hb
  have hSB := hS.slots_word
  have hlenB := hb.memory_word
  have hfitS := hS.fit
  have hwe : w ≠ r.e := (reg_ne_of_not_mem r hw (mem_regNames_e r)).symm
  have hwp : w ≠ r.p := (reg_ne_of_not_mem r hw (mem_regNames_p r)).symm
  have hwmod : r.modBase ≠ w := reg_ne_of_not_mem r hw (mem_regNames_modBase r)
  have hwx : r.exp ≠ w := reg_ne_of_not_mem r hw (mem_regNames_exp r)
  have hke : k ≠ r.e := (reg_ne_of_not_mem r hk (mem_regNames_e r)).symm
  have hkp : k ≠ r.p := (reg_ne_of_not_mem r hk (mem_regNames_p r)).symm
  have hkmod : r.modBase ≠ k := reg_ne_of_not_mem r hk (mem_regNames_modBase r)
  have hkx : r.exp ≠ k := reg_ne_of_not_mem r hk (mem_regNames_exp r)
  have hpB : F.p < B := by
    have h1 : F.p + 1 ≤ (F.p + 1) ^ 2 := Nat.le_self_pow (by norm_num) _
    have h2 := hb.arithmetic_word
    omega
  have hsB : s < B := by omega
  have hcntB : cnt < B := by omega
  have hsse : s * F.e + cnt * F.e ≤ S * F.e := by
    rw [← Nat.add_mul]; exact Nat.mul_le_mul_right _ hfit
  have hcB : cnt * F.e < B := by omega
  have hbfit : σ.vars WS + s * F.e + cnt * F.e ≤ (σ.arrs r.mem).length := by omega
  obtain ⟨τ, hrun, hin, hout, harr, hlen, hvars, hinp, houtp⟩ :=
    digitsCom_run F r WS w k m (.lit s) (.bin .mul (.lit cnt) (.var r.e)) (sv := s)
      (L := cnt * F.e) (fun _ _ => evalB_lit hsB)
      (fun τ hτ => evalB_bin (evalB_lit hcntB)
        (evalB_var_of (by rw [hτ r.e hwe.symm hke.symm]; exact hb.degree) heB) hcB)
      hb.prime hb.degree hmv hbfit hlenB hpB heB hwk hwWS hkWS hwm hkm hwp hkp hwe hke
  have hWS : τ.vars WS = σ.vars WS := hvars WS hwWS.symm hkWS.symm
  have hmod : τ.vars r.modBase = σ.vars r.modBase := hvars _ hwmod hkmod
  have hscr : τ.arrs r.scratch = σ.arrs r.scratch := harr _ hb.names.2.symm
  have hidx_lt : ∀ t, t < S → ∀ j : Fin F.e, σ.vars WS + t * F.e + j.val < (σ.arrs r.mem).length := by
    intro t ht j
    have := Nat.mul_le_mul_right F.e (Nat.succ_le_of_lt ht)
    rw [Nat.succ_mul] at this
    have := j.isLt
    omega
  have hside : ∀ t, (t < s ∨ s + cnt ≤ t) → ∀ j : Fin F.e,
      σ.vars WS + t * F.e + j.val < σ.vars WS + s * F.e ∨
        σ.vars WS + s * F.e + cnt * F.e ≤ σ.vars WS + t * F.e + j.val := by
    intro t ht j
    rcases ht with h | h
    · left
      have := Nat.mul_le_mul_right F.e (Nat.succ_le_of_lt h)
      rw [Nat.succ_mul] at this
      have := j.isLt
      omega
    · right
      have := Nat.mul_le_mul_right F.e h
      rw [Nat.add_mul] at this
      omega
  have hcell_in : ∀ i, i < cnt → ∀ j : Fin F.e,
      (τ.arrs r.mem).getD (σ.vars WS + (s + i) * F.e + j.val) 0 = (digitVec F (σ.vars m) i j).val := by
    intro i hi j
    have hidx : σ.vars WS + (s + i) * F.e + j.val = σ.vars WS + s * F.e + (i * F.e + j.val) := by
      rw [Nat.add_mul]; omega
    have hlt : i * F.e + j.val < cnt * F.e := by
      have := Nat.mul_le_mul_right F.e (Nat.succ_le_of_lt hi)
      rw [Nat.succ_mul] at this
      have := j.isLt
      omega
    rw [hidx, hin _ hlt]
    rfl
  refine ⟨τ, hrun, ?_, ?_, ?_, hvars, harr, hinp, houtp⟩
  ·
    refine ⟨⟨hb.names, ?_, ?_, hb.arithmetic_word, hb.inverse_word, ?_, ?_, ?_, ?_, ?_, ?_,
      hb.priv⟩, hS.ws_reg, ?_, ?_, ?_, hSB⟩
    · rw [hvars _ hwe.symm hke.symm]; exact hb.degree
    · rw [hvars _ hwp.symm hkp.symm]; exact hb.prime
    · rw [hlen]; exact hb.memory_word
    · rw [hscr]; exact hb.scratch_word
    · rw [hscr]; exact hb.scratch_fit
    · rw [hmod, hlen]; exact hb.modulus_fit
    · intro i
      rw [hmod]
      have hfitm := hb.modulus_fit
      have hi := i.isLt
      rw [hout _ (by omega) ?_]
      · exact hb.modulus_value i
      · rcases hS.modulus_apart with h | h
        · left; omega
        · right; omega
    · rw [hvars _ hwx hkx]; exact hb.exp_word
    · rw [hWS, hlen]; exact hfitS
    · rw [hmod, hWS]; exact hS.modulus_apart
    · intro t ht j
      show (τ.arrs r.mem).getD (τ.vars WS + t * F.e + j.val) 0 < F.p
      rw [hWS]
      by_cases hin' : s ≤ t ∧ t < s + cnt
      · obtain ⟨h1, h2⟩ := hin'
        have ht' : t = s + (t - s) := by omega
        rw [ht', hcell_in (t - s) (by omega) j]
        exact (digitVec F (σ.vars m) (t - s) j).isLt
      · have hside' : t < s ∨ s + cnt ≤ t := by omega
        rw [hout _ (hidx_lt t ht j) (hside t hside' j)]
        have := hS.canon t ht j
        exact this
  ·
    intro i hi
    unfold val
    have hslice : slice F τ r (τ.vars WS + (s + i) * F.e) = fun j => (digitVec F (σ.vars m) i j).val := by
      funext j
      unfold slice
      rw [hWS]
      exact hcell_in i hi j
    rw [hslice]
    exact decode_digitVec F (σ.vars m) i
  ·
    intro t ht hside'
    unfold val
    congr 1
    funext j
    unfold slice
    rw [hWS]
    exact hout _ (hidx_lt t ht j) (hside t hside' j)
end Mathproof.Problem18ClaudeDigitsSlots20261001
