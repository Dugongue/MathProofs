theorem ker_le_orthogonal (B : BilinForm K V) (hB : B.IsAlt) (W : Submodule K V) :
    LinearMap.ker B ≤ B.orthogonal W := by
  rw [← LinearMap.BilinForm.orthogonal_top_eq_ker hB.isRefl]
  exact LinearMap.BilinForm.orthogonal_le le_top
theorem mem_ker_restrict_iff (B : BilinForm K V) (W : Submodule K V) (x : W) :
    x ∈ LinearMap.ker (B.restrict W) ↔ ∀ y ∈ W, B x y = 0 := by
  rw [LinearMap.mem_ker, LinearMap.ext_iff]
  constructor
  · intro h y hy
    simpa using h ⟨y, hy⟩
  · intro h y
    simpa using h y y.2
theorem map_ker_restrict_orthogonal (B : BilinForm K V) (hB : B.IsAlt) (W : Submodule K V)
    (hsup : W ⊔ B.orthogonal W = ⊤) :
    (LinearMap.ker (B.restrict (B.orthogonal W))).map (B.orthogonal W).subtype
      = LinearMap.ker B := by
  ext x
  rw [Submodule.mem_map]
  constructor
  · rintro ⟨⟨y, hyO⟩, hyK, rfl⟩
    rw [mem_ker_restrict_iff] at hyK
    simp only [Submodule.subtype_apply]
    rw [LinearMap.mem_ker, LinearMap.ext_iff]
    intro z
    have hz : z ∈ W ⊔ B.orthogonal W := by rw [hsup]; exact Submodule.mem_top
    obtain ⟨w, hw, o, ho, rfl⟩ := Submodule.mem_sup.mp hz
    have hwy : B y w = 0 := by
      rw [LinearMap.BilinForm.mem_orthogonal_iff] at hyO
      rw [← hB.neg_eq, hyO w hw, neg_zero]
    simp [map_add, hwy, hyK o ho]
  · intro hx
    have hxO : x ∈ B.orthogonal W := ker_le_orthogonal B hB W hx
    refine ⟨⟨x, hxO⟩, ?_, rfl⟩
    rw [mem_ker_restrict_iff]
    intro y _
    rw [LinearMap.mem_ker] at hx
    rw [hx]; rfl
theorem isAlt_restrict (B : BilinForm K V) (hB : B.IsAlt) (W : Submodule K V) :
    (B.restrict W).IsAlt := fun x => hB.self_eq_zero x
end Kernel
noncomputable def rank {V : Type u} [AddCommGroup V] [Module K V] (B : BilinForm K V) : ℕ :=
  finrank K V - finrank K (LinearMap.ker B)
theorem even_rank_aux (n : ℕ) :
    ∀ {V : Type u} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
      (B : BilinForm K V), B.IsAlt → finrank K V = n → Even (rank B) := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro V _ _ _ B hB hn
    by_cases hzero : ∀ a b : V, B a b = 0
    ·
      have hker : LinearMap.ker B = ⊤ := by
        rw [Submodule.eq_top_iff']
        intro x
        rw [LinearMap.mem_ker, LinearMap.ext_iff]
        intro y
        simpa using hzero x y
      unfold rank
      rw [hker, finrank_top]
      simp
    · push Not at hzero
      obtain ⟨a, b, hab⟩ := hzero
      set W := plane (K := K) a b with hWdef
      set O := B.orthogonal W with hOdef
      have hcompl : IsCompl W O := isCompl_plane_orthogonal B hB hab
      have hdim : finrank K W + finrank K O = finrank K V :=
        Submodule.finrank_add_eq_of_isCompl hcompl
      have hW2 : finrank K W = 2 := finrank_plane B hB hab
      have hsup : W ⊔ O = ⊤ := hcompl.sup_eq_top
      have hkermap := map_ker_restrict_orthogonal B hB W hsup
      have hkerdim : finrank K (LinearMap.ker (B.restrict O)) = finrank K (LinearMap.ker B) := by
        rw [← hkermap]
        exact (Submodule.finrank_map_subtype_eq O _).symm
      have hkerle : finrank K (LinearMap.ker B) ≤ finrank K O :=
        Submodule.finrank_mono (ker_le_orthogonal B hB W)
      have hOlt : finrank K O < n := by omega
      have hrec : Even (rank (B.restrict O)) :=
        ih (finrank K O) hOlt (B.restrict O) (isAlt_restrict B hB O) rfl
      have hrec' : Even (finrank K O - finrank K (LinearMap.ker B)) := by
        unfold rank at hrec
        rwa [hkerdim] at hrec
      have hsplit : finrank K V - finrank K (LinearMap.ker B)
          = (finrank K O - finrank K (LinearMap.ker B)) + 2 := by omega
      show Even (finrank K V - finrank K (LinearMap.ker B))
      rw [hsplit]
      exact Even.add hrec' even_two
theorem even_rank_of_isAlt {V : Type u} [AddCommGroup V] [Module K V] [FiniteDimensional K V]
    (B : BilinForm K V) (hB : B.IsAlt) : Even (rank B) :=
  even_rank_aux (finrank K V) B hB rfl
end Mathproof.Meta.AlternatingEvenRank20260901
