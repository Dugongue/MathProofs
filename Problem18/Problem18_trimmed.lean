theorem charTwo_anchor_metric_split [CharP K 2] (m r : ℕ)
    (B : LinearMap.BilinForm K V) (hs : B.IsSymm) (hn : B.Nondegenerate) (ha : ¬B.IsAlt)
    (b : Module.Basis (Fin ((m+m)+(r+1))) K V) :
    ∃ e : ((Fin (m+m)→K)×(Fin (r+1)→K)) ≃ₗ[K] V,
