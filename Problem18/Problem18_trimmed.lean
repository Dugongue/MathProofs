private theorem finite_conditioned_event_bound
    {Ω : Type*} [Fintype Ω] (P Q : Ω → Prop) (R : ℝ)
    (hΩ : 0 < (Nat.card Ω : ℝ)) (hR : 0 ≤ R)
    (hP : (Nat.card {x : Ω // P x} : ℝ) / Nat.card Ω ≤ R)
    (hQ : (1 / 4 : ℝ) ≤
      (Nat.card {x : Ω // Q x} : ℝ) / Nat.card Ω) :
    (Nat.card {x : Ω // P x ∧ Q x} : ℝ) /
      Nat.card {x : Ω // Q x} ≤ 4 * R := by
  have hIQ : Nat.card {x : Ω // P x ∧ Q x} ≤
      Nat.card {x : Ω // P x} := by
    apply Nat.card_le_card_of_injective
      (fun x : {x : Ω // P x ∧ Q x} => (⟨x.1, x.2.1⟩ : {x : Ω // P x}))
    intro x y h
    apply Subtype.ext
    exact congrArg (fun z : {x : Ω // P x} => z.val) h
  have hIQ' : (Nat.card {x : Ω // P x ∧ Q x} : ℝ) ≤
      Nat.card {x : Ω // P x} := by exact_mod_cast hIQ
  have hQmass : (Nat.card Ω : ℝ) ≤
      4 * (Nat.card {x : Ω // Q x} : ℝ) := by
    have hh := (le_div_iff₀ hΩ).mp hQ
    nlinarith
  have hQpos : (0 : ℝ) < Nat.card {x : Ω // Q x} := by
    nlinarith
  have hPmass : (Nat.card {x : Ω // P x} : ℝ) ≤ R * Nat.card Ω :=
    (div_le_iff₀ hΩ).mp hP
  apply (div_le_iff₀ hQpos).mpr
  calc
    (Nat.card {x : Ω // P x ∧ Q x} : ℝ) ≤
        Nat.card {x : Ω // P x} := hIQ'
    _ ≤ R * Nat.card Ω := hPmass
    _ ≤ R * (4 * (Nat.card {x : Ω // Q x} : ℝ)) :=
      mul_le_mul_of_nonneg_left hQmass hR
    _ = (4 * R) * Nat.card {x : Ω // Q x} := by ring
def ambientEquiv {K : Type*} [Field K] (d w t : ℕ) :
    (Matrix (Fin w) (Fin d) K × Matrix (Fin t) (Fin d) K) ≃
      Matrix (Fin d) (Fin (w + t)) K :=
  ((Equiv.sumArrowEquivProdArrow (Fin w) (Fin t) (Fin d → K)).symm.trans
    (Equiv.piCongrLeft (fun _ : Fin (w + t) => Fin d → K)
      (finSumFinEquiv : Fin w ⊕ Fin t ≃ Fin (w + t)))).trans
    (Matrix.transposeAddEquiv _ _ _).toEquiv
theorem conditional_annihilator_tail_ambient_full_row_rank
    {K : Type*} [Field K] [Fintype K]
    (d u w t : ℕ) (hu : u ≤ d) (hd : d ≤ w + t) :
    (Nat.card {z : Matrix (Fin w) (Fin d) K × Matrix (Fin t) (Fin d) K //
      (∃ U : {W : Submodule K (Fin d → K) // Module.finrank K W = u},
        ∀ x : Fin d → K, x ∈ U.val → ∀ j : Fin w,
          ∑ i : Fin d, x i * z.1 j i = 0) ∧
      (ambientEquiv d w t z).rank = d} : ℝ) /
      Nat.card {z : Matrix (Fin w) (Fin d) K × Matrix (Fin t) (Fin d) K //
        (ambientEquiv d w t z).rank = d} ≤
      16 * (Fintype.card K : ℝ) ^ (u * (d - u)) *
        ((Fintype.card K : ℝ) ^ (u * w))⁻¹ := by
  let A := Matrix (Fin w) (Fin d) K
  let B := Matrix (Fin t) (Fin d) K
  let Ω := A × B
  let E : A → Prop := fun N =>
    ∃ U : {W : Submodule K (Fin d → K) // Module.finrank K W = u},
      ∀ x : Fin d → K, x ∈ U.val → ∀ j : Fin w,
        ∑ i : Fin d, x i * N j i = 0
  let P : Ω → Prop := fun z => E z.1
  let Q : Ω → Prop := fun z => (ambientEquiv d w t z).rank = d
  let R : ℝ := 4 * (Fintype.card K : ℝ) ^ (u * (d - u)) *
    ((Fintype.card K : ℝ) ^ (u * w))⁻¹
  have hA : (0 : ℝ) < Nat.card A := by
    dsimp [A]
    rw [Nat.card_eq_fintype_card]
    positivity
  have hB : (0 : ℝ) < Nat.card B := by
    dsimp [B]
    rw [Nat.card_eq_fintype_card]
    positivity
  have hΩ : (0 : ℝ) < Nat.card Ω := by
    rw [show Nat.card Ω = Nat.card A * Nat.card B by simp [Ω]]
    simpa only [Nat.cast_mul] using mul_pos hA hB
  have hR : 0 ≤ R := by dsimp [R]; positivity
