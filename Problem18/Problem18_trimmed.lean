        have hh:=congrFun hcB ⟨j-F.e,hjsecond⟩
        have hn : σ.vars canonical.outBase+F.e+(j-F.e)=σ.vars canonical.outBase+j := by omega
        change (σ.arrs canonical.mem).getD (σ.vars canonical.outBase+F.e+(j-F.e)) 0 =
