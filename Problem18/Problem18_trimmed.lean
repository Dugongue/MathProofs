theorem unitary_degree_two_le (F : FieldPresentation K) {q : Nat} (d : UnitaryFieldData (K:=K) q) :
    2≤F.e := by
  by_contra hn
  have he:F.e=1:=by have hp:=F.degree_pos; omega
  have hi (i : Fin F.e):i.val=0:=by have hh:=i.isLt; omega
  apply presentation_generator_not_fixed F d.automorphism d.nontrivial
  calc
    d.automorphism F.generator =
        d.automorphism (∑ i : Fin F.e, ((F.coordinate F.generator i).val : K)*F.generator^i.val) :=
      congrArg d.automorphism (F.coordinate_spec F.generator)
    _ = ∑ i : Fin F.e, ((F.coordinate F.generator i).val : K)*F.generator^i.val := by simp [hi]
    _ = F.generator := (F.coordinate_spec F.generator).symm
theorem generatorCoefficients_decode (F : FieldPresentation K) (he : 2≤F.e) :
