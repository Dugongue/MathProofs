theorem costPoint_le : (fieldMacros F).costPoint ≤ macroBudget F := (concrete_costBound F).point
theorem e_succ_le : F.e + 1 ≤ macroBudget F := by unfold macroBudget; omega
theorem one_le_budget : 1 ≤ macroBudget F := (concrete_costBound F).one
theorem loadCost_le (n m : ℕ) :
    loadCost (fieldMacros F).costPoint F.e n m ≤ 400 * macroBudget F * (n + m + 1) ^ 2 := by
  have hcp := costPoint_le F
  have he := e_succ_le F
  have hW := one_le_budget F
  obtain ⟨W, hWd⟩ : ∃ W, macroBudget F = W := ⟨_, rfl⟩
  obtain ⟨cp, hcpd⟩ : ∃ cp, (fieldMacros F).costPoint = cp := ⟨_, rfl⟩
  obtain ⟨e, hed⟩ : ∃ e, F.e = e := ⟨_, rfl⟩
  rw [hWd, hcpd] at hcp; rw [hWd, hed] at he; rw [hWd] at hW
  rw [hcpd, hed, hWd]
  set P := n + m + 1 with hP
  have hP1 : 1 ≤ P := by omega
  have hPP : P ≤ P * P := Nat.le_mul_of_pos_right _ hP1
  have hWP : W ≤ W * P := Nat.le_mul_of_pos_right _ hP1
  have hX : W * P ≤ W * (P * P) := Nat.mul_le_mul_left _ hPP
  have hLv : rowStart (n + m) m ≤ 7 * (P * P) := by
    unfold rowStart
    have : m * (n + m) ≤ P * P := Nat.mul_le_mul (by omega) (by omega)
    omega
  have T1 : (4 + (19 * e + 19)) * rowStart (n + m) m ≤ (23 * W) * (7 * (P * P)) :=
    Nat.mul_le_mul (by omega) hLv
  have T2 : (39 + cp) * n ≤ (40 * W) * (P * P) := Nat.mul_le_mul (by omega) (by omega)
  have T3 : (37 + cp) * n ≤ (38 * W) * P := Nat.mul_le_mul (by omega) (by omega)
  have h4 : 4 + rowStep cp e n ≤ 106 * (W * P) := by
    unfold rowStep
    have : (38 * W) * P = 38 * (W * P) := by ring
    omega
  have T4 : (4 + rowStep cp e n) * m ≤ (106 * (W * P)) * P := Nat.mul_le_mul h4 (by omega)
  have r1 : (23 * W) * (7 * (P * P)) = 161 * (W * (P * P)) := by ring
  have r2 : (40 * W) * (P * P) = 40 * (W * (P * P)) := by ring
  have r3 : (106 * (W * P)) * P = 106 * (W * (P * P)) := by ring
  have r4 : 400 * W * P ^ 2 = 400 * (W * (P * P)) := by ring
  have h1 : 1 ≤ W * (P * P) := le_trans hW (le_trans hWP hX)
