variable {K ι : Type*} [Field K] [Fintype K]
def NoPrimary {n : Type*} [Fintype n] [DecidableEq n]
    (p : ι→K[X]) (S : Matrix n n K) : Prop :=
  ∀ i,¬(p i∣S.charpoly ∧ IsCoprime (p i) (S.charpoly/p i))
theorem noPrimary_opposite_iff {n m : Type*} [Fintype n] [Fintype m]
    [DecidableEq n] [DecidableEq m] (p : ι→K[X]) (hp : ∀ i,(p i).coeff 0≠0)
    (A : Matrix n m K) (B : Matrix m n K) :
    NoPrimary p (A*B) ↔ NoPrimary p (B*A) := by
  apply forall_congr'
  intro i
  exact not_congr (opposite_charpoly_primary_event_iff A B (p i) (hp i))
private theorem card_filter {X : Type*} [Fintype X] (P : X→Prop) :
    (Finset.univ.filter P).card=Nat.card {x : X//P x} := by
  rw [Nat.card_eq_fintype_card,Fintype.card_subtype]
private theorem transpose_event_card {n m : ℕ} (P : Matrix (Fin n) (Fin m) K→Prop) :
    Nat.card {x : Matrix (Fin m) (Fin n) K//P (Matrix.transpose x)}=
      Nat.card {N : Matrix (Fin n) (Fin m) K//P N} :=
  Nat.card_congr ((Matrix.transposeAddEquiv (Fin m) (Fin n) K).toEquiv.subtypeEquiv (fun _=>Iff.rfl))
private theorem transpose_space_card (n m : ℕ) :
    Nat.card (Fin m → Fin n → K)=Nat.card (Matrix (Fin n) (Fin m) K) :=
  Nat.card_congr (Matrix.transposeAddEquiv (Fin m) (Fin n) K).toEquiv
private theorem hermitian_rows_card [StarRing K] (n m : ℕ)
    (p : ι→K[X]) (hp : ∀ i,(p i).coeff 0≠0) :
    Nat.card {x : Fin m→Fin n→K // NoPrimary p (gramHermitian (fun a b=>x b a)).val}=
      Nat.card {N : Matrix (Fin n) (Fin m) K // NoPrimary p (Nᴴ*N)} := by
  have he : Nat.card {x : Fin m→Fin n→K // NoPrimary p (gramHermitian (fun a b=>x b a)).val}=
      Nat.card {x : Matrix (Fin m) (Fin n) K // NoPrimary p ((Matrix.transpose x)ᴴ*(Matrix.transpose x))} := by
    apply Nat.card_congr
    exact (Equiv.refl _).subtypeEquiv (fun x=>noPrimary_opposite_iff p hp (Matrix.transpose x) (Matrix.transpose x)ᴴ)
  exact he.trans (transpose_event_card (fun N : Matrix (Fin n) (Fin m) K=>NoPrimary p (Nᴴ*N)))
theorem odd_rectangular_primary_failure_le [StarRing K] [TrivialStar K]
    (h2 : (2:K)≠0) (n m : ℕ) (hm : n ≤ m)
    (p : ι→K[X]) (hp : ∀ i,(p i).coeff 0≠0) :
    (Nat.card {N : Matrix (Fin n) (Fin m) K // NoPrimary p (Nᴴ*N)} : ℝ)/
      Nat.card (Matrix (Fin n) (Fin m) K)  ≤
    Real.sqrt (12*((Nat.card {H : selfAdjoint (Matrix (Fin n) (Fin n) K)//NoPrimary p H.val}:ℝ)/
      Nat.card (selfAdjoint (Matrix (Fin n) (Fin n) K)))) := by
  let E := Finset.univ.filter (fun H : selfAdjoint (Matrix (Fin n) (Fin n) K)=>NoPrimary p H.val)
  have h := Mathproof.Problem18OrthogonalSecondMoment20260930.orthogonal_gram_event_probability_le
    h2 n m hm E
  simp only [E,Finset.mem_filter,Finset.mem_univ,true_and] at h
  simp only [card_filter,←Nat.card_eq_fintype_card] at h
  rw [hermitian_rows_card n m p hp,transpose_space_card n m] at h
  exact h
theorem hermitian_rectangular_primary_failure_le {F : Type*} [Field F] [Fintype F]
    [Algebra F K] [StarRing K] (hcard : Nat.card K=Nat.card F^2)
    (hstar : ∀ x : K,star x=x^Nat.card F) (n m : ℕ) (hm : n ≤ m)
    (p : ι→K[X]) (hp : ∀ i,(p i).coeff 0≠0) :
    (Nat.card {N : Matrix (Fin n) (Fin m) K // NoPrimary p (Nᴴ*N)} : ℝ)/
      Nat.card (Matrix (Fin n) (Fin m) K)  ≤
    Real.sqrt ((5/2:ℝ)*((Nat.card {H : selfAdjoint (Matrix (Fin n) (Fin n) K)//NoPrimary p H.val}:ℝ)/
      Nat.card (selfAdjoint (Matrix (Fin n) (Fin n) K)))) := by
  let E := Finset.univ.filter (fun H : selfAdjoint (Matrix (Fin n) (Fin n) K)=>NoPrimary p H.val)
  have h := Mathproof.Problem18RectangularHermitianTransfer20260930.rectangular_hermitian_gram_event_probability_le
    hcard hstar n m hm E
  simp only [E,Finset.mem_filter,Finset.mem_univ,true_and] at h
  simp only [card_filter,←Nat.card_eq_fintype_card] at h
  change (Nat.card {x : Fin m → Fin n → K // NoPrimary p
    (gramHermitian (fun a b => x b a)).val} : ℝ) / Nat.card (Fin m → Fin n → K) ≤ _ at h
  rw [hermitian_rows_card n m p hp,transpose_space_card n m] at h
  exact h
theorem charTwo_rectangular_primary_failure_le [CharP K 2]
    (n m : ℕ) (hm : n ≤ m) (p : ι→K[X]) (hp : ∀ i,(p i).coeff 0≠0) :
    (Nat.card {N : Matrix (Fin n) (Fin m) K // NoPrimary p (N.transpose*N)} : ℝ)/
      Nat.card (Matrix (Fin n) (Fin m) K)  ≤
    Real.sqrt (5*((Nat.card {H : Mathproof.Problem18CharTwoGram20260930.SymMat n K//NoPrimary p H.val}:ℝ)/
      Nat.card (Mathproof.Problem18CharTwoGram20260930.SymMat n K))) := by
  let E := Finset.univ.filter (fun H : Mathproof.Problem18CharTwoGram20260930.SymMat n K=>NoPrimary p H.val)
  have h := Mathproof.Problem18StandardGramTransfer20260930.charTwo_gram_event_probability_le n m hm E
  simp only [E,Finset.mem_filter,Finset.mem_univ,true_and] at h
  simp only [card_filter,←Nat.card_eq_fintype_card] at h
  have he : Nat.card {x : Fin m→Fin n→K // NoPrimary p (Mathproof.Problem18CharTwoGram20260930.gramSymm x).val}=
      Nat.card {N : Matrix (Fin n) (Fin m) K // NoPrimary p (N.transpose*N)} := by
    calc
      _ = Nat.card {x : Matrix (Fin m) (Fin n) K // NoPrimary p (x*(Matrix.transpose x))} := by
        apply Nat.card_congr
        apply (Equiv.refl _).subtypeEquiv
        intro x
        let X : Matrix (Fin m) (Fin n) K := x
        have hg : (Mathproof.Problem18CharTwoGram20260930.gramSymm x).val=X.transpose * X := by
          rw [Mathproof.Problem18CharTwoGram20260930.gramSymm,
            Mathproof.Problem18CharTwoGram20260930.sum_rankOneSymm_eq_gram]
          rfl
        rw [hg]
        exact noPrimary_opposite_iff p hp X.transpose X
      _ = _ := transpose_event_card (fun N : Matrix (Fin n) (Fin m) K=>NoPrimary p (N.transpose*N))
  rw [he,transpose_space_card n m] at h
  exact h
end
end Mathproof.Problem18RectangularPrimaryTransfer20261001
