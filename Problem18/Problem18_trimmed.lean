variable {F K : Type*} [Field F] [Fintype F] [Field K] [Fintype K]
  [Algebra F K] [StarRing K]
theorem restricted_hermitian_fourier_bound {n m : ℕ}
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (ψ : AddChar F ℂ) (hψ : ψ ≠ 1)
    (A : Matrix (Fin n) (Fin n) K) (hA : A.IsHermitian)
    (X : Matrix (Fin n) (Fin m) K) :
    ‖(∑ x : Fin m → K, ψ (hermitianQuadratic hstar A hA.eq (X *ᵥ x))) /
        (Fintype.card (Fin m → K) : ℂ)‖ ^ 2 ≤
      ((Fintype.card K : ℝ) ^
        (A.rank - 2 * Module.finrank K
          ↥(LinearMap.range A.mulVecLin ⊓ LinearMap.ker Xᴴ.mulVecLin)))⁻¹ := by
  have hB : (Xᴴ * A * X)ᴴ = Xᴴ * A * X := by
    simp only [Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose,
      hA.eq, Matrix.mul_assoc]
  have hquad (x : Fin m → K) :
      hermitianQuadratic hstar A hA.eq (X *ᵥ x) =
      hermitianQuadratic hstar (Xᴴ * A * X) hB x := by
    apply FaithfulSMul.algebraMap_injective F K
    simp only [hermitian_quadratic_spec, ← Matrix.mulVec_mulVec]
    rw [Matrix.dotProduct_mulVec (star x) Xᴴ, Matrix.vecMul_conjTranspose, star_star]
  simp_rw [hquad]
  have hp : 0 < ringChar F := Nat.pos_of_ne_zero (CharP.ringChar_ne_zero_of_finite F)
  have he : ‖(∑ x : Fin m → K,
      ψ (hermitianQuadratic hstar (Xᴴ * A * X) hB x)) /
      (Fintype.card (Fin m → K) : ℂ)‖^2 =
        ((Fintype.card K : ℝ)^(Xᴴ * A * X).rank)⁻¹ := by
    convert! hermitian_quadratic_fourier hcard hstar hp ψ hψ (Xᴴ * A * X) hB using 1
    all_goals (congr 5 <;> exact Subsingleton.elim _ _)
  rw [he]
  have hr := hermitian_restriction_rank_loss A hA X
  have hd : A.rank - 2 * Module.finrank K
      ↥(LinearMap.range A.mulVecLin ⊓ LinearMap.ker Xᴴ.mulVecLin) ≤
        (Xᴴ * A * X).rank := by omega
  have hq : (1 : ℝ) ≤ Fintype.card K := by
    exact_mod_cast Fintype.card_pos (α := K)
  exact inv_anti₀ (by positivity) (pow_le_pow_right₀ hq hd)
end Mathproof.Problem18RestrictedHermitianFourier20260930
end
