theorem matrix_eq_iff_words {B : Nat} {σ : Env} (hv : ValidMemory F B σ) {b1 b2 m c : Nat}
    (h1 : b1 + F.e*(m*c) ≤ (σ.arrs canonical.mem).length)
    (h2 : b2 + F.e*(m*c) ≤ (σ.arrs canonical.mem).length) :
    Problem18IMPMatrixMemory20261001.matrix F σ b1 m c =
        Problem18IMPMatrixMemory20261001.matrix F σ b2 m c ↔
      ∀ k < F.e*(m*c), (σ.arrs canonical.mem).getD (b1+k) 0 = (σ.arrs canonical.mem).getD (b2+k) 0 := by
  have hE := F.degree_pos
