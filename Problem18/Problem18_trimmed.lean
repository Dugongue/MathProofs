      (.lit 0) [] (by simp) trivial (evalB_lit (by omega)) (by have := F.prime.two_le;omega)
  refine ⟨τ,?_,⟨h₄,?_,?_,?_,?_,by omega,hPd,hQd⟩,?_,?_,hin₄.trans (hin₃.trans hin₂),hout₄.trans (hout₃.trans hout₂)⟩
