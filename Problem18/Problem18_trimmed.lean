namespace Mathproof.Problem18IMPSourceDispatchProgram20261001
open Lax13Proofs.Imp Lax13Proofs.Reasoning Lax13Proofs.Compile
open Problem18IMPSourceDispatch20261001 Problem18RootRetainedValidatorIMP20261001
open Problem18RootRetainedHeaderIMP20261001 Problem18IMPPolynomialCompiler20261001
open Lax51.BinaryWordEncoding Lax51.RamPolytime
def body (B : Nat) : Com := .seq (readFields headerNames)
  (.seq (routeCom B) (.seq (.assign "left" (.sub (.var "len") (.lit 8))) scan))
def program (B : Nat) : Com := .seq (.read "len")
  (.ite (.lt (.var "len") (.lit 8)) (.write (.lit 0)) (body B))
def routed (B : Nat) : List Nat→List Nat
  | tag::u::q::p::e::a::b::c::data=>
      [tag,u,q,p,e,a,b,c]++routeWords B tag a b c++data
  | _=>[0]
theorem short_routed (B : Nat) (xs : List Nat) (h : xs.length<8) : routed B xs=[0] := by
  unfold routed
  split
  · simp only [List.length_cons] at h; omega
  · rfl
theorem program_ok (B : Nat) : Com.Ok validatorLayout (program B) := by
  simp [validatorLayout,program,body,routeCom,sortCom,leCom,leafCom,branchCom,
    orderCode,minimumName,middleName,headerNames,readFields,scan,scanBody,echoRead,
    Com.Ok,Cond.Ok,Expr.Ok,condExpr]
theorem program_run (B W M : Nat) (xs : List Nat) (hM : 9≤M) (hW : M<W)
    (hB : B<W) (hlen : xs.length<M) (hv : ∀v∈xs,v<M) :
    ∃τ,Run W (program B) (initEnv (fun _=>0) (xs.length::xs)) τ (30*xs.length+100) ∧
      τ.out=routed B xs := by
  let σ := initEnv (fun _=>0) (xs.length::xs)
  let σ₁ : Env:={σ.setVar "len" xs.length with inp:=xs}
  have hr : Run W (.read "len") σ σ₁ 1:=Run.read rfl
  have ht : (Cond.lt (.var "len") (.lit 8)).evalB W σ₁=some (decide (xs.length<8)) := by
    simp [evalB_condLt_iff,σ₁,hlen.trans hW]; omega
  by_cases hshort : xs.length<8
  · have hw:=Run.write (σ:=σ₁) (evalB_lit (by omega : 0<W))
    have hh:=hr.seq (Run.ite_true (b:=.lt (.var "len") (.lit 8)) (d:=body B)
      (by simpa only [hshort,decide_true] using ht) hw)
    refine ⟨_,hh.mono (by simp [Expr.size,Cond.size] <;> omega),?_⟩
    simp [σ₁,σ,initEnv,short_routed B xs hshort]
  · obtain ⟨tag,u,q,p,e,a,b,c,data,rfl⟩:=header_exists xs (by omega)
    let σ₂ : Env:= {readEnv headerNames (tag::u::q::p::e::a::b::c::data) σ₁ with out:=[tag,u,q,p,e,a,b,c]}
    let σ₃ : Env:= {σ₂ with out:=σ₂.out++routeWords B tag a b c}
    let σ₄ := σ₃.setVar "left" data.length
    have hrh:=readFields_run headerNames (tag::u::q::p::e::a::b::c::data) σ₁
      (by simp [headerNames]) rfl W (fun v h=>(hv v h).trans hW)
    have hσ₁ : ∀x,σ₁.vars x<M := by
      intro x
      simp only [σ₁,Env.setVar]
      split_ifs <;> first | exact hlen | exact (by dsimp [σ,initEnv]; omega)
    have hσ₂ : ∀x,σ₂.vars x<M:=readEnv_bounded headerNames _ _ _ hv hσ₁
    have hroute : Run W (routeCom B) σ₂ σ₃ 40 := by
      have hr0 := routeCom_run B W σ₂ (by omega) hB (fun x=>(hσ₂ x).trans hW)
      have htag : σ₂.vars "tag"=tag := by simp [σ₂,readEnv,headerNames]
      have ha' : σ₂.vars "a"=a := by simp [σ₂,readEnv,headerNames]
      have hb' : σ₂.vars "b"=b := by simp [σ₂,readEnv,headerNames]
      have hc' : σ₂.vars "c"=c := by simp [σ₂,readEnv,headerNames]
      rw [htag,ha',hb',hc'] at hr0
      exact hr0
    have hdata : data.length<M:=by simp only [List.length_cons] at hlen; omega
    have hlength : data.length+8<M:=by simpa only [List.length_cons,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using hlen
    have hd : (Expr.sub (.var "len") (.lit 8)).evalB W σ₃=some data.length := by
      simp [evalB_bin_iff,σ₃,σ₂,readEnv,headerNames,σ₁,σ,initEnv,Bop.apply]
      constructor <;> omega
    have ha:=Run.assign (x:="left") hd
    have hp : σ₄.vars "p"=p := by simp [σ₄,σ₃,σ₂,readEnv,headerNames]
    have hpW : p<W := (hv p (by simp)).trans hW
    obtain ⟨τ,hscan,_,_,_,hout⟩:=scan_run W p data σ₄ (by omega) hpW rfl
      (by simp [σ₄]) hp (hdata.trans hW) (fun v h=>(hv v (by simp [h])).trans hW)
    have hbody:=hrh.seq (hroute.seq (ha.seq hscan))
    have hh:=hr.seq (Run.ite_false (b:=.lt (.var "len") (.lit 8)) (c:=.write (.lit 0))
      (by simpa only [hshort,decide_false] using ht) hbody)
    refine ⟨τ,hh.mono ?_,?_⟩
    · simp [headerNames,Expr.size,Cond.size]; omega
    · rw [hout]
      simp [σ₄,σ₃,σ₂,routed,List.append_assoc]
theorem routed_ramPolytime (B : Nat) : RamPolytime (routed B) := by
  apply ramPolytime_of_bounded_imp validatorLayout (program B) (routed B)
    (Polynomial.C (B+10)) (30*Polynomial.X+100) (program_ok B)
  intro xs
  let n:=bitSize xs
  let M:=2^(n+4)
  let W:=2^(B+10+n+1)
  have hM : 9≤M := by
    have hh : 2^4≤M:=Nat.pow_le_pow_right (by omega) (by omega)
    norm_num at hh
    omega
  have hW : M<W := Nat.pow_lt_pow_right (by omega) (by omega)
  have hBW : B<W := by
    have hh : B<2^B:=Nat.lt_two_pow_self
    exact hh.trans_le (Nat.pow_le_pow_right (by omega) (by omega))
  have hpow : 2^(n+1)≤M:=Nat.pow_le_pow_right (by omega) (by omega)
  have hlen : xs.length<M:=
    (Lax51Proofs.Encoding.length_lt_two_pow_bitSize_add_one xs).trans_le hpow
  have hv : ∀v∈xs,v<M:=fun v h=>
    (Lax51Proofs.Encoding.mem_lt_two_pow_bitSize_add_one h).trans_le hpow
  obtain ⟨τ,hr,ho⟩:=program_run B W M xs hM hW hBW hlen hv
  have hcost : 30*xs.length+100≤30*n+100:=by
    have hh:=Lax51Proofs.Encoding.length_le_bitSize xs
    dsimp [n]
    omega
  refine ⟨(fun _=>0),τ,?_,ho⟩
  convert hr.mono hcost using 1 <;> simp [W,n]
end Mathproof.Problem18IMPSourceDispatchProgram20261001
