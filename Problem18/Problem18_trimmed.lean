  have l7 : (σ7.arrs sA).length = 11 + N := by simp [σ7, Env.setArr, l6]
  have s8 := store_qw (σ := σ7) (idx := 8) (k := 8) (v := c) (by rw [q7, hq]; rfl) hvc (by omega)
    (by omega) (by omega)
  let σ8 := σ7.setArr sA 8 c
  refine ⟨σ8, ?_, ?_, ?_, ?_, ?_, ?_⟩
