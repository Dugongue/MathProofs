def primaryAt (W : Submodule K (Fin c→K)) (A : Matrix (Fin c) (Fin a×Fin b) K) : Prop :=
  ∃p : K[X],p.Monic ∧ p.coeff 0≠0 ∧ p∣(A*Aᴴ).charpoly ∧
    IsCoprime p ((A*Aᴴ).charpoly/p) ∧
    p.map (starRingAut : K ≃+* K).toRingHom=p ∧
    (A*Aᴴ).charpoly.map (starRingAut : K ≃+* K).toRingHom=(A*Aᴴ).charpoly ∧
    W=LinearMap.ker (aeval (A*Aᴴ).toLin' p)
theorem fixed_subspace_bound {F : Type*} [Field F] [Fintype F] [Algebra F K]
