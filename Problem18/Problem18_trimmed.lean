  have hqn : ν5.vars q.n = d := vals5 (q.n, Sz.vd) (by simp [qArgs])
  have hqc : ν5.vars q.c = n := vals5 (q.c, Sz.vn) (by simp [qArgs])
  have hregs5 : ∀ x ∈ [nR, dR, eR, sbR, canonical.e, canonical.p, canonical.modBase, canonical.exp],
