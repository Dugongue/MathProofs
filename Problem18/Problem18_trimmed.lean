variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
noncomputable def cost (n : Nat) := Problem18IMPBoundarySeedPhase20261002.cost F.e n+(Problem18IMPBoundaryAnnihilatorPhase20261002.cost F n+Problem18IMPBoundaryUpdateTail20261002.cost F n)
theorem step_run {B n i : Nat} {S : Matrix (Fin n) (Fin n) K} {σ : Env}
    (h : State F B S i σ) (hi : i<n) (hb : WordBounds B n F.e) :
    ∃τ,Run B program σ τ (cost F n) ∧ State F B S (i+1) τ ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  obtain ⟨_,_,_,_,_,hf,hg,hd,hv,hz,hm,ha,ht,hp,hw,ho,hsl⟩:=allocation n
  obtain ⟨ρ,hrs,hρ,hseed,hmemS,hwρ,hnρ,hiρ,hri,hro⟩:=Problem18IMPBoundarySeedPhase20261002.program_run F
    h.slots h.workspace h.dimension h.index hi hb.basis
  have coreρ : Core F B S ρ := Core.transport_run F h.toCore hrs hρ hwρ hnρ (by decide) (by
    intro j k
    have hh:=matrix_address_bounds j k
    exact hmemS _ (by omega) (Or.inr (by omega)))
  have stateρ : State F B S i ρ := by
    refine ⟨coreρ,hiρ,h.index_le,?_,?_⟩
    · intro j
      rw [hmemS _ (by have hh:=j.isLt;omega) (Or.inl (by have hh:=j.isLt;omega))]
      exact h.vector j
    · intro j hj
      rw [hmemS _ (by omega) (Or.inl (by omega))]
      exact h.polynomial j hj
