theorem squareclass_preimage_card {K G : Type*} [Field K] [Fintype K] [Group G] [Finite G]
    (f : G →* Kˣ) (hf : Function.Surjective f) (hodd : ringChar K≠2) (a : Kˣ) :
    Nat.card {z : G // quadraticChar K (a.val*(f z).val)=1}*2=Nat.card G := by
  obtain ⟨u,hu⟩ := quadraticChar_exists_neg_one' hodd
  obtain ⟨w,hw⟩ := hf u
  have hwc : quadraticChar K (f w).val = -1 := by rw [hw,hu]
  let p : G → Prop := fun z => quadraticChar K (a.val*(f z).val)=1
  have hp (z : G) : p z ↔ ¬p (z*w) := by
    change quadraticChar K (a.val*(f z).val)=1 ↔ ¬quadraticChar K (a.val*(f (z*w)).val)=1
    rw [f.map_mul,Units.val_mul,← mul_assoc,
      map_mul (quadraticChar K) (a.val*(f z).val) (f w).val,hwc]
    rcases quadraticChar_dichotomy (mul_ne_zero a.ne_zero (f z).ne_zero) with hz | hz <;>
      rw [hz] <;> norm_num
  let e : {z : G // p z} ≃ {z : G // ¬p z} := (Equiv.mulRight w).subtypeEquiv hp
  have he := Nat.card_congr e
  have hs := Nat.card_congr (Equiv.sumCompl p)
  rw [Nat.card_sum,← he] at hs
  change Nat.card {z : G // p z}*2=Nat.card G
  omega
