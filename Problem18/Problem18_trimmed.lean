    intro hk σ h
    have hkn:k<n:=by omega
    let i:Fin n:=⟨k,hkn⟩
    obtain ⟨σ1,hr1,h1,hv1,hf1,hi1,ho1⟩:=Problem18ConcretePointStep20261002.run F n d B vs i σ h
    obtain ⟨τ,hr2,h2,hv2,hf2,hi2,ho2⟩:=ih (by omega) σ1 h1
    refine ⟨τ,?_,h2,?_,?_,hi2.trans hi1,ho2.trans ho1⟩
    · simpa only [program,dif_pos hkn,i,Nat.succ_mul,Nat.add_assoc,Nat.add_comm,Nat.add_left_comm] using hr1.seq hr2
    · intro j hj
      by_cases hjk:j.val=k
      · have he:j=i:=Fin.ext hjk
        subst j
        rw [hf2 _ (by dsimp [i]; unfold size inBase; omega) (Or.inr (by dsimp [i]; omega))]
        exact hv1
      · exact hv2 j (by omega)
    · intro s hs hc
      rw [hf2 s hs (by rcases hc with hc|hc; exact Or.inl hc; exact Or.inr (by omega))]
      apply hf1 s hs
      · rcases hc with hc|hc
        · exact Or.inl hc
        · exact Or.inr (by omega)
      · dsimp [i]
        rcases hc with hc|hc
        · subst s; unfold outBase coef qry src rowStart; omega
        · omega
theorem run (n d B : Nat) (vs : List (DenseInput n d K)) (σ : Env)
    (h:Input F n d B vs σ) :
    ∃τ,Run B (program n d vs.length n) σ τ (n*cost F n d vs.length+1) ∧
      Input F n d B vs τ ∧
      (∀i:Fin n,val F canonical names.q.WS τ (outBase n d vs.length+i.val)=coordValue d vs i) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  obtain ⟨τ,hr,hτ,hv,hf,hi,ho⟩:=loop_run F n d B vs n le_rfl σ h
  exact ⟨τ,hr,hτ,fun i=>hv i i.isLt,hi,ho⟩
def coefficient (n d count : Nat) : Nat := n*(formatCoeff n d (E n d) 1 count+38)+1
theorem cost_bound (n d count : Nat) :
    n*cost F n d count+1 ≤ macroBudget F*coefficient n d count := by
  have hcert:=pipeline_cost F names.q names.mn names.an n d (E n d) 1 count
  have hpoint:=(concrete_costBound F).point
  have hone:=(concrete_costBound F).one
  have hs:cost F n d count ≤ macroBudget F*(formatCoeff n d (E n d) 1 count+38) := by
    unfold cost
    nlinarith
  calc n*cost F n d count+1
      ≤ n*(macroBudget F*(formatCoeff n d (E n d) 1 count+38))+macroBudget F :=
        Nat.add_le_add (Nat.mul_le_mul_left n hs) hone
    _ = macroBudget F*coefficient n d count := by unfold coefficient; ring
theorem run_bounded (n d B : Nat) (vs : List (DenseInput n d K)) (σ : Env)
    (h:Input F n d B vs σ) :
    ∃τ,Run B (program n d vs.length n) σ τ (macroBudget F*coefficient n d vs.length) ∧
      Input F n d B vs τ ∧
      (∀i:Fin n,val F canonical names.q.WS τ (outBase n d vs.length+i.val)=coordValue d vs i) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  obtain ⟨τ,hr,hτ,hv,hi,ho⟩:=run F n d B vs σ h
  exact ⟨τ,hr.mono (cost_bound F n d vs.length),hτ,hv,hi,ho⟩
end
