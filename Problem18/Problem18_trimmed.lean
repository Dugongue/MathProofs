theorem finite_zeros (F G : Matrix (Fin c) (Fin a × Fin b) K)
    (h : ranksMatch F G) (x : OuterVar a b→K) :
    (∀p∈finite a b,interpret (Int.castRingHom K)
      (Sum.elim (values F G) (x ∘ (Fintype.equivFin (OuterVar a b)).symm)) p=0) ↔
      ∀p∈Problem18P34Frontend20261003FiniteSystem.equations F G,p.eval x=0 := by
  simp only [finite,List.forall_mem_map,values,finite_eval]
  exact zeros F G h x
theorem equivalence [Fintype K] (F G : Matrix (Fin c) (Fin a × Fin b) K)
    (h : ranksMatch F G) :
    (∃x:Fin (Fintype.card (OuterVar a b))→K,∀p∈finite a b,
