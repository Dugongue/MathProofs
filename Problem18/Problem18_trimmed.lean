  obtain ⟨e,he⟩ := (Mathproof.Problem18DeterminantClassIsometry20261001.determinantClass_eq_iff_isometry
    hodd A B bA b hsA hs hnA hn).mp hd
  exact ⟨c,e,he⟩
private theorem modelForm_not_alt (r : ℕ) (c : SquareClass K) : ¬(modelForm r c).IsAlt := by
  intro h
