    (constants_mem_order k A E L)
theorem order_image_mem_constants {M : Type*} [CommRing M]
    (ψ : constantOrder k A E L →+* M)
    (hA : ∀ a : A, ψ (algebraMap A (constantOrder k A E L) a) ∈
      (ψ.comp (constantsToOrder k A E L)).range)
    (s : constantOrder k A E L) :
    ψ s ∈ (ψ.comp (constantsToOrder k A E L)).range := by
  obtain ⟨t,rfl⟩ := (localTensorMap k A E L).rangeRestrict_surjective s
  induction t using TensorProduct.induction_on with
  | zero =>
    rw [map_zero, map_zero]
    exact (ψ.comp (constantsToOrder k A E L)).range.zero_mem
  | tmul a e =>
    have he : ψ (constantsToOrder k A E L e) ∈
        (ψ.comp (constantsToOrder k A E L)).range := ⟨e,rfl⟩
    have ht : (localTensorMap k A E L).rangeRestrict (a ⊗ₜ[k] e) =
        algebraMap A (constantOrder k A E L) a * constantsToOrder k A E L e := by
      apply Subtype.ext
      change localTensorMap k A E L (a ⊗ₜ[k] e) = algebraMap A L a * algebraMap E L e
      simp [localTensorMap, Algebra.smul_def]
    rw [ht, map_mul]
    exact (ψ.comp (constantsToOrder k A E L)).range.mul_mem (hA a) he
  | add t u ht hu =>
    rw [map_add, map_add]
    exact (ψ.comp (constantsToOrder k A E L)).range.add_mem ht hu
theorem constants_residue_surjective {M : Type*} [CommRing M]
    (ψ : constantOrder k A E L →+* M) (hψ : Function.Surjective ψ)
    (hA : ∀ a : A, ψ (algebraMap A (constantOrder k A E L) a) ∈
      (ψ.comp (constantsToOrder k A E L)).range) :
    Function.Surjective (ψ.comp (constantsToOrder k A E L)) := by
  intro m
  obtain ⟨s,rfl⟩ := hψ m
  exact order_image_mem_constants k A E L ψ hA s
theorem quotient_constants_surjective [Finite E]
    (q : Ideal (constantOrder k A E L)) [q.IsMaximal]
