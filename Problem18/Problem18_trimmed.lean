  have hek:r.e≠r.k:=by tauto
  have hiv:r.i≠r.value:=by tauto
  have hik:r.i≠r.k:=by tauto
  have hvk:r.value≠r.k:=Ne.symm (by tauto : r.k≠r.value)
  have heq:=iterStart_vars r σ r.e hev hek
  have hiq:=iterStart_vars r σ r.i hiv hik
