  constructor
  · rintro ⟨hd,hc,⟨e,he⟩,⟨k,hk⟩⟩
    have hχ : T.val.charpoly=p*(T.val.charpoly/p) :=
      (EuclideanDomain.mul_div_cancel' hp.ne_zero hd).symm
    have hq : (T.val.charpoly/p).Monic := hp.of_mul_monic_left (hχ ▸ T.val.charpoly_monic)
    exact ⟨hc,marking_of_kernel_coordinates B C T p (T.val.charpoly/p) hp hq hc hχ e k he hk⟩
  · rintro ⟨hc,⟨M⟩⟩
    have hcoords := kernel_coordinates_of_marking B C hB T p hc M
    let N : MarkedFiber (RingEquiv.refl K) B C M.2.val M.1.val := ⟨T,M.2.property.2⟩
