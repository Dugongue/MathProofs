    let words := routedSourceWords F cutoff u q A
    let tau := sourcePayloadLoaded F ext words A
    Run W loadPayloadProgram (afterRoutedHeader ext words) tau
      (100*(F.e+a*b*c*F.e+1)) ∧
    (∀ x < a*b*c*F.e,
      (tau.arrs Problem18IMPTensorGather20261002.memory).getD x 0 =
        (tensorCoordinates F A).getD x 0) ∧
    tau.inp = [] ∧ tau.out = [] := by
  intro words tau
  let sigma := afterRoutedHeader ext words
  let modList := (List.finRange F.e).map (fun i => (F.modulus i).val)
  let coords := tensorCoordinates F A
  obtain ⟨_htag,_hu,_hq,_hpf,hef,haf,hbf,hcf,_hord,_hbr,hin,harr,hout⟩ :=
    routedSourceHeader_fields F cutoff u q A ext
  have hdims := cell_factor_bounds ha hb hc F.degree_pos
  have hmodLen : modList.length = F.e := by simp [modList]
  let sigma1 := sourceModPrepared ext words
