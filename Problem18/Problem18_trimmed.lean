namespace Mathproof.Problem18RootConditionedMetric20261001
open scoped BigOperators Matrix
open Classical
variable {K : Type*} [Field K] [StarRing K] {a b m : Nat}
def mixRows {V : Type*} [AddCommGroup V] [Module K V]
    (R : Matrix (Fin m) (Fin m) K) (N : Fin m → V) : Fin m → V :=
  fun j => ∑ r, R j r • N r
theorem mixRows_mul {V : Type*} [AddCommGroup V] [Module K V]
    (R T : Matrix (Fin m) (Fin m) K) (N : Fin m → V) :
    mixRows R (mixRows T N)=mixRows (R*T) N := by
  funext j
  simp only [mixRows,Finset.smul_sum,smul_smul,Matrix.mul_apply,Finset.sum_smul]
  rw [Finset.sum_comm]
theorem mixRows_one {V : Type*} [AddCommGroup V] [Module K V] (N : Fin m → V) :
    mixRows (1 : Matrix (Fin m) (Fin m) K) N=N := by
  funext j
  simp [mixRows,Matrix.one_apply]
def mixRowsEquiv {V : Type*} [AddCommGroup V] [Module K V]
    (R : (Matrix (Fin m) (Fin m) K)ˣ) : (Fin m → V)≃(Fin m → V) where
  toFun:=mixRows R.val
  invFun:=mixRows (R⁻¹).val
  left_inv N:=by rw [mixRows_mul,Units.inv_mul,mixRows_one]
  right_inv N:=by rw [mixRows_mul,Units.mul_inv,mixRows_one]
def rowBlock (N : Fin m → Fin a → Fin b → K) (i : Fin a) : Matrix (Fin m) (Fin b) K :=
  fun r j => N r i j
def metricGram (J : Matrix (Fin m) (Fin m) K) (N : Fin m → Fin a → Fin b → K) :
    Matrix (Fin b) (Fin b) K := ∑ i,(rowBlock N i)ᴴ*J*rowBlock N i
theorem rowBlock_mix (R : Matrix (Fin m) (Fin m) K) (N : Fin m → Fin a → Fin b → K)
    (i : Fin a) : rowBlock (mixRows R N) i=R*rowBlock N i := by
  ext r j
  simp [rowBlock,mixRows,Matrix.mul_apply,Finset.sum_apply]
theorem metricGram_mix (J R : Matrix (Fin m) (Fin m) K)
    (N : Fin m → Fin a → Fin b → K) :
    metricGram J (mixRows R N)=metricGram (Rᴴ*J*R) N := by
  simp only [metricGram,rowBlock_mix,Matrix.conjTranspose_mul,Matrix.mul_assoc]
theorem metricGram_event_card [Fintype K] (E : Submodule K (Fin a → Fin b → K))
    (J : Matrix (Fin m) (Fin m) K) (R : (Matrix (Fin m) (Fin m) K)ˣ)
    (P : Matrix (Fin b) (Fin b) K → Prop) :
    Nat.card {N : Fin m → E // P (metricGram J (fun j => (N j).val))}=
      Nat.card {N : Fin m → E // P (metricGram (R.valᴴ*J*R.val) (fun j => (N j).val))} := by
  let e : (Fin m → E)≃(Fin m → E):=mixRowsEquiv R
  have he (N : Fin m → E) :
      (fun j => (e N j).val)=mixRows R.val (fun j => (N j).val) := by
    funext j
    simp [e,mixRowsEquiv,mixRows]
  let ee : {N : Fin m → E // P (metricGram (R.valᴴ*J*R.val) (fun j => (N j).val))}≃
      {N : Fin m → E // P (metricGram J (fun j => (N j).val))} :=
    { toFun:=fun N=>⟨e N.val,by rw [he,metricGram_mix]; exact N.property⟩
      invFun:=fun N=>⟨e.symm N.val,by
        have hh:=he (e.symm N.val)
        rw [e.apply_symm_apply] at hh
        rw [←metricGram_mix,←hh]
        exact N.property⟩
      left_inv:=by intro N; apply Subtype.ext; exact e.symm_apply_apply _
      right_inv:=by intro N; apply Subtype.ext; exact e.apply_symm_apply _ }
  exact (Nat.card_congr ee).symm
end Mathproof.Problem18RootConditionedMetric20261001
