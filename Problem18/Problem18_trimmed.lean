      (Fintype.card K : ℝ)^b := by
    have hh := Fintype.card_subtype_le (fun z : Fin b → K => z ≠ 0)
    simpa only [Fintype.card_fun, Fintype.card_fin, Nat.cast_pow] using
      (show (Fintype.card {z : Fin b → K // z ≠ 0} : ℝ) ≤
        Fintype.card (Fin b → K) from by exact_mod_cast hh)
  calc
    _ = ∑ z : {z : Fin b → K // z ≠ 0},
        (∑ M : ConstraintSample K d (Fin a × Fin b),
          diagonalWeight ψ M.val (fun ij => z.val ij.2) m) /
          Nat.card (ConstraintSample K d (Fin a × Fin b)) := by
      rw [Finset.sum_comm, Finset.sum_div]
    _ ≤ ∑ _z : {z : Fin b → K // z ≠ 0}, C := Finset.sum_le_sum (fun z _ => hp z)
    _ = (Fintype.card {z : Fin b → K // z ≠ 0} : ℝ) * C := by simp
    _ ≤ (Fintype.card K : ℝ)^b * C := mul_le_mul_of_nonneg_right hc (by dsimp [C]; positivity)
    _ = _ := by dsimp [C]; rw [pow_add]; ring
