        rw [← hup']
        exact evalB_bin (evalB_var (by rw [hup']; omega)) (evalB_lit (by omega))
          (by change τp.vars q.u + 1 < B; rw [hup']; omega)
      have hcf' : (Cond.eq (.var q.f) (.lit 1)).evalB B τp = some false := by
        rw [hcond_eval]
        rcases hf01 with h | h
        · rw [h]; rfl
        · exact absurd h hf
      refine ⟨τp.setVar q.u (uv + 1), ?_, ⟨Slots.setVar F r hSp huS huW _, ?_, ?_, ?_, ?_, ?_, ?_,
        ?_, ?_⟩, ?_⟩
      · refine (hrp.seq ((Run.ite_false hcf' Run.skip).seq (Run.assign hinc))).mono ?_
        have e1 : (Cond.eq (Expr.var q.f) (Expr.lit 1)).size = 3 := rfl
        have e2 : (plus (Expr.var q.u) (Expr.lit 1)).size = 3 := rfl
        rw [e1, e2]; unfold stepCost; omega
      · simp only [vars_setVar, if_true]; omega
      · intro x hx hxm
        obtain ⟨h1, h2, h3, h4, h5, h6⟩ := hmov x hxm
        simp only [vars_setVar, if_neg h1]
        rw [hregsp x hx h4 h6 h5]; exact hregs x hx hxm
      · rw [val_setVar F r huW, hvalp]; exact hzτ
      · have hv : val F r q.WS (τp.setVar q.u (uv + 1)) = val F r q.WS τ := by
          funext s; rw [val_setVar F r huW, hvalp]
        have hu' : (τp.setVar q.u (uv + 1)).vars q.u = uv + 1 := by simp
        rw [hu', hv, ← hred, hrestτ, reduce_cons_none hnN _ _ _ hnone]
      · intro s hs hge
        rw [val_setVar F r huW, hvalp]; exact hhigh s hs hge
      · intro a h1 h2
        simp only [arrs_setVar]; rw [harrp a h1 h2]; exact harr a h1 h2
      · simp only [inp_setVar]; rw [hinpp]; exact hinp
      · simp only [out_setVar]; rw [houtp]; exact hout
      · simp only [vars_setVar, if_true]; omega
  obtain ⟨τf, hrf, hLf, hcf⟩ := Run.while_count L (fun τ => cv - τ.vars q.u)
    (stepCost M q Nv nv cv) hdef hstep hL0
  obtain ⟨hNf, hnf, hcf'⟩ := hkeep τf hLf
  obtain ⟨hSf, hulef, hregsf, hzf, hredf, hhighf, harrf, hinpf, houtf⟩ := hLf
  have hueq : τf.vars q.u = cv := by
    rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hcf']; omega))] at hcf
    simp only [Option.some.injEq, decide_eq_false_iff_not, not_lt] at hcf
    rw [hcf'] at hcf; omega
  refine ⟨τf, ?_, hSf, ?_, ?_, hregsf, harrf, hinpf, houtf⟩
  · refine ((Run.assign (x := q.u) (evalB_lit (σ := σ) (by omega : 0 < B))).seq hrf).mono ?_
    simp only [vars_setVar, eq_self_iff_true, if_true, ite_true, Nat.sub_zero]
    have e1 : (Expr.lit 0).size = 1 := rfl
    have e2 : (Cond.lt (Expr.var q.u) (Expr.var q.c)).size = 3 := rfl
    rw [e1, e2]; unfold reduceCost; ring_nf; try omega
  · rw [hueq, restRows_end] at hredf
