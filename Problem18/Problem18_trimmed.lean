def lineCoef (n d : ℕ) (i j : Fin n) (e : Fin (secBox n d)) :
    PolyExpr (Fin (secC0 n d + 2 + secBox n d)) ℤ :=
  .add (.const (if fte (fun k => if k = i then 1 else 0) = (boundedExponents n (secDeg d))[e.val] then 1 else 0))
    (.add (.mul (.var (oldIdx _ (avar n d)))
        (.const (if fte (fun k => if k = j then 1 else 0) = (boundedExponents n (secDeg d))[e.val] then 1 else 0)))
      (.mul (.var (oldIdx _ (bvar n d)))
        (.const (if fte (fun _ => 0) = (boundedExponents n (secDeg d))[e.val] then -1 else 0))))
def secFv (n d : ℕ) (r : Fin (secBox n d + 1)) (jj : Fin (secBox n d)) :
