  have hM5 : ν5.arrs spanMem = ν.arrs spanMem := by
    rw [arr5, a4 _ (by decide), hM3]
  have hP2 : ν3.arrs canonical.mem = ν2.arrs canonical.mem := by rw [arr3]
  have wlow : ∀ j < F.e + 1, (ν5.arrs canonical.mem).getD j 0 = (ν.arrs canonical.mem).getD j 0 := by
