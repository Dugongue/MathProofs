    have hd:(i.val*σ.vars columns+j.val)/σ.vars columns=i.val:=by
      rw [Nat.add_comm, Nat.add_mul_div_right _ _ hp, Nat.div_eq_of_lt j.isLt]
      simp
    have hmod:(i.val*σ.vars columns+j.val)%σ.vars columns=j.val:=
      Nat.mul_add_mod_of_lt j.isLt
