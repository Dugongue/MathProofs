  apply env_ext
  · rfl
  · funext b
    simp only [renameEnv,Env.setArr]
    by_cases h : b=rho a
    · subst b
      simp
    · have h' : rho.symm b≠a := by
        intro hh
        apply h
        simpa using congrArg rho hh
      simp [h,h']
  · rfl
  · rfl
