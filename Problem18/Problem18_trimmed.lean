section Frobenius
variable {K : Type*} [Field K] [Fintype K]
variable {L : Type*} [Field L] [Algebra K L] [IsAlgClosed L] [Algebra.IsAlgebraic K L]
theorem coefficientAutomorphism_boxPoly (g : L ≃ₐ[K] L) (n E : ℕ) (v : Fin (boxSize n E) → L) :
    coefficientAutomorphism g (boxPoly n E v) = boxPoly n E (fun j => g (v j)) := by
  rw [coefficientAutomorphism, MvPolynomial.mapEquiv_apply]
  exact boxPoly_map (g : L →+* L) n E v
theorem geometricIdeal_rowSys {s : ℕ} (n d : ℕ) (F : Fin s → Fin (boxSize n d) → K) :
    geometricIdeal (L := L) (Set.range fun r => boxPoly n d (F r)) =
      Ideal.span (rowSys n d (fun r j => algebraMap K L (F r j)) :
        Set (MvPolynomial (Fin n) L)) := by
  rw [geometricIdeal, coe_rowSys]
  congr 1
  ext f
  simp only [Set.mem_image, Set.mem_range]
  constructor
  · rintro ⟨_, ⟨r, rfl⟩, rfl⟩
    exact ⟨r, (boxPoly_map (algebraMap K L) n d (F r)).symm⟩
  · rintro ⟨r, rfl⟩
    exact ⟨_, ⟨r, rfl⟩, boxPoly_map (algebraMap K L) n d (F r)⟩
theorem rational_param_iff_fixed {s : ℕ} (n d : ℕ) (F : Fin s → Fin (boxSize n d) → K)
    (hF : ∀ r, (boxPoly n d (fun j => algebraMap K L (F r j))).totalDegree ≤ d) :
    (∃ (k : ℕ) (S : Fin k → Fin (boxSize n (cpE n d)))
        (U : Fin k → Fin (boxSize n (cpE n d)) → K),
        IsP n d (fun r j => algebraMap K L (F r j)) S (fun i j => algebraMap K L (U i j))) ↔
      ∃ P ∈ (geometricIdeal (L := L) (Set.range fun r => boxPoly n d (F r))).minimalPrimes,
        P.comap (coefficientAutomorphism (FiniteField.frobeniusAlgEquivOfAlgebraic K L)) = P := by
  set σ := coefficientAutomorphism (N := n) (FiniteField.frobeniusAlgEquivOfAlgebraic K L) with hσ
  rw [geometricIdeal_rowSys]
  constructor
  · rintro ⟨k, S, U, hU⟩
    refine ⟨_, isParam_component n d _ S _ hU, ?_⟩
    rw [Ideal.comap_radical]
    congr 1
    rw [coe_rowSys]
    apply span_comap_fixed
    rintro _ ⟨i, rfl⟩
    rw [hσ, coefficientAutomorphism_boxPoly]
    congr 1
    funext j
    exact (FiniteField.frobeniusAlgEquivOfAlgebraic K L).commutes (U i j)
  · rintro ⟨P, hP, hfix⟩
    obtain ⟨k, S, U, hU, -, hUP, hred⟩ := component_param n d _ hF P hP
    have hσP : ∀ f, σ f ∈ P ↔ f ∈ P := by
      intro f
      conv_rhs => rw [← hfix]
      rfl
    have hfixU : ∀ i j, (FiniteField.frobeniusAlgEquivOfAlgebraic K L) (U i j) = U i j := by
      intro i j
      have hmem : boxPoly n (cpE n d)
          (fun t => (FiniteField.frobeniusAlgEquivOfAlgebraic K L) (U i t)) ∈ P := by
        rw [← coefficientAutomorphism_boxPoly, ← hσ, hσP]
        exact hUP i
      rw [hred _ hmem j]
      have hS : ∀ t, (FiniteField.frobeniusAlgEquivOfAlgebraic K L) (U i (S t)) =
          if i = t then 1 else 0 := by
        intro t
        rw [hU.1 i t]
        split_ifs <;> simp
      simp only [hS, ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    have hrat : ∀ i j, ∃ c : K, algebraMap K L c = U i j := by
      intro i j
      apply Mathproof.Problem18ZeroDimFixedComponent20261001.pow_card_fixed_mem_range
      have := hfixU i j
      rwa [FiniteField.coe_frobeniusAlgEquivOfAlgebraic] at this
    choose UK hUK using hrat
    refine ⟨k, S, UK, ?_⟩
    have hfun : (fun i j => algebraMap K L (UK i j)) = U := by
      funext i j
      exact hUK i j
    rw [hfun]
    exact hU
end Frobenius
