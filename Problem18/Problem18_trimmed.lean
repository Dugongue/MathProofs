theorem five_slice_sqrt_bound (b : ℕ) (hb : 1≤b) :
    (29/32:ℝ)^(b/5) ≤ 50/Real.sqrt (b:ℝ) := by
  let k := b/5
  let p : ℝ := (29/32:ℝ)^k
  have hp : 0≤p := by positivity
  have hbern : 1+(k:ℝ)*(3/29)≤(32/29:ℝ)^k := by
    simpa only [show (32/29:ℝ)-1=3/29 by norm_num] using
      (one_add_mul_sub_le_pow (by norm_num : (-1:ℝ)≤32/29) k)
  have hinv : p*(32/29:ℝ)^k=1 := by
    dsimp [p]
    rw [←mul_pow]
    norm_num
  have hmul : (1+(k:ℝ)*(3/29))*p≤1 := by
    nlinarith [mul_le_mul_of_nonneg_right hbern hp]
  have hnat : b≤5*k+4 := by dsimp [k]; omega
  have hbnd : (b:ℝ)≤50*(1+(k:ℝ)*(3/29)) := by
    have hh : (b:ℝ)≤5*(k:ℝ)+4 := by exact_mod_cast hnat
    have hk : (0:ℝ)≤k := by positivity
    nlinarith
  have hbp : (b:ℝ)*p≤50 := by
    nlinarith [mul_le_mul_of_nonneg_right hbnd hp]
  have hb1 : (1:ℝ)≤b := by exact_mod_cast hb
  have hs : Real.sqrt (b:ℝ)≤b := Real.sqrt_le_self_iff.mpr (Or.inr hb1)
  have hpos : 0<Real.sqrt (b:ℝ) := Real.sqrt_pos.2 (by linarith)
  apply (le_div_iff₀ hpos).2
  change p*Real.sqrt (b:ℝ)≤50
  nlinarith [mul_le_mul_of_nonneg_left hs hp]
theorem exists_half_threshold (C : ℝ) (hC : 0≤C) :
    ∃ B : ℕ, 1≤B ∧ ∀b : ℕ, B≤b →
      C*(1+Real.log (b:ℝ))/Real.sqrt (b:ℝ)≤1/2 := by
  have h0 : Tendsto (fun x : ℝ=>1/x) atTop (𝓝 0) := by
    simpa using Real.tendsto_pow_log_div_mul_add_atTop 1 0 0 one_ne_zero
  have h1 : Tendsto (fun x : ℝ=>Real.log x/x) atTop (𝓝 0) := by
    simpa using Real.tendsto_pow_log_div_mul_add_atTop 1 0 1 one_ne_zero
  have h2 : Tendsto (fun x : ℝ=>(Real.log x)^2/x) atTop (𝓝 0) := by
    simpa using Real.tendsto_pow_log_div_mul_add_atTop 1 0 2 one_ne_zero
  have hh : Tendsto (fun x : ℝ=>C^2*(1+Real.log x)^2/x) atTop (𝓝 0) := by
    have hl := ((h0.add (h1.const_mul 2)).add h2).const_mul (C^2)
    convert hl using 1
    · funext x; ring
    · norm_num
  obtain ⟨R,hR⟩ := eventually_atTop.mp
    (hh.eventually (gt_mem_nhds (by norm_num : (0:ℝ)<1/4)))
  refine ⟨max 1 (Nat.ceil R),le_max_left _ _,?_⟩
  intro b hb
  have hb1 : 1≤b := (le_max_left _ _).trans hb
  have hb0 : (0:ℝ)<b := by exact_mod_cast (show 0<b by omega)
  have hRb : R≤(b:ℝ) := (Nat.le_ceil R).trans
    (by exact_mod_cast (le_max_right 1 (Nat.ceil R)).trans hb)
  have hsq := (div_lt_iff₀ hb0).mp (hR (b:ℝ) hRb)
  have hlog : 0≤1+Real.log (b:ℝ) := by
    have := Real.log_nonneg (show (1:ℝ)≤b by exact_mod_cast hb1)
    linarith
  have hs := Real.sq_sqrt hb0.le
  have hs0 := Real.sqrt_nonneg (b:ℝ)
  apply (div_le_iff₀ (Real.sqrt_pos.2 hb0)).2
  nlinarith [mul_nonneg hC hlog, sq_nonneg (2*C*(1+Real.log (b:ℝ))+Real.sqrt (b:ℝ))]
end
end Mathproof.Problem18LargeDensityAnalytic20261001
