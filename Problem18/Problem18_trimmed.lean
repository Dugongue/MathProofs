    (B C : CrossForm (E := E) (L := E) σ)
    (hb : CrossBalanced σ φ B) (hc' : CrossBalanced σ φ C)
    (hB : ∀ x y,B x y=σ (B y x)) (hC : ∀ x y,C x y=σ (C y x))
    (hndB : B.SeparatingLeft) (hndC : C.SeparatingLeft) (t : E) :
    ∃ T : E ≃ₗ[K] E,(∀ x,T (t*x)=t*T x) ∧ ∀ x y,B (T x) (T y)=C x y := by
