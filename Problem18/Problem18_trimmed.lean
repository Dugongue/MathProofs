private theorem choose_add_two (d c : ℕ) :
    (d+c).choose 2=d.choose 2+c.choose 2+d*c := by
  induction d with
  | zero => simp
  | succ d ih =>
    rw [show d+1+c=(d+c)+1 by omega,Nat.choose_succ_succ',Nat.choose_one_right,
      Nat.choose_succ_succ',Nat.choose_one_right,ih]
    ring
theorem regular_subspace_fiber_bound (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (hnB : B.Nondegenerate) (U : Submodule K V) (hU : (B.restrict U).Nondegenerate)
    (h : K[X]) (hm : h.Monic) (hi : Irreducible h) (hd : Module.finrank K U=h.natDegree) :
    (Nat.card {T : Preservers B U // (restrictedOperator B U T).val.charpoly=h}:ℝ)*
      (Nat.card K:ℝ)^(h.natDegree*(Module.finrank K V-h.natDegree)+h.natDegree) ≤
        3*Nat.card (SelfAdjointOperators (RingEquiv.refl K) B) := by
  let d := Module.finrank K U
  let c := Module.finrank K (B.orthogonal U)
  let n := Module.finrank K V
  have hsum : d+c=n := by
    have he := (splitCoordinates B hB U hU).finrank_eq
    simpa only [Module.finrank_prod] using he
  have hnC := Mathproof.Problem18RegularComplementCoordinates20261001.complement_nondegenerate B hB hnB U hU
  have hc := Mathproof.Problem18OrdinaryIrreducibleMass20261001.irreducible_source_card_le
    (B.restrict U) (hB.restrict U) hU h hm hi hd
  have he : d.choose 2+(c.choose 2+c)+(h.natDegree*(n-h.natDegree)+h.natDegree)=n.choose 2+n := by
    have hdc : h.natDegree=d := hd.symm
    rw [hdc,←hsum,choose_add_two]
    simp only [Nat.add_sub_cancel_left]
    ring
  rw [regular_subspace_charpoly_card B hB U hU h,Nat.cast_mul,
    Mathproof.Problem18OrdinarySampleNormalization20261001.sample_card
      (B.restrict (B.orthogonal U)) (hB.restrict _) hnC,
    Mathproof.Problem18OrdinarySampleNormalization20261001.sample_card B hB hnB,Nat.cast_pow,Nat.cast_pow]
  calc
    _ ≤ (3*(Nat.card K:ℝ)^(d.choose 2))*(Nat.card K:ℝ)^(c.choose 2+c)*
        (Nat.card K:ℝ)^(h.natDegree*(n-h.natDegree)+h.natDegree) := by
      apply mul_le_mul_of_nonneg_right _ (by positivity)
      exact mul_le_mul_of_nonneg_right hc (by positivity)
    _ = 3*(Nat.card K:ℝ)^(n.choose 2+n) := by
      rw [mul_assoc (3:ℝ),←pow_add,mul_assoc,←pow_add,he]
end
end Mathproof.Problem18OrdinaryRegularSubspaceBound20261001
