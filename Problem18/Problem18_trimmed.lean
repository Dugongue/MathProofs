variable {K : Type*} [Field K] [Fintype K]
theorem primarySquares_iff_square_mod (f a : K[X]) (hm : f.Monic) (hs : Squarefree f) :
    PrimarySquares f a ↔ ∃ r : K[X],f ∣ a-r^2 := by
  classical
  constructor
  · intro h
    let I := FactorIndex f
    let g (i : I) := i.val
    letI (i : I) : Fact (Irreducible (g i)) := ⟨factor_irreducible f i⟩
    have hc : Pairwise (fun i j : I => IsCoprime (g i) (g j)) := by
      intro i j hij
      apply (factor_irreducible f i).coprime_iff_not_dvd.mpr
      intro hd
      have he := Polynomial.eq_of_monic_of_associated (factor_monic f i) (factor_monic f j)
        (((factor_irreducible f i).dvd_irreducible_iff_associated (factor_irreducible f j)).mp hd)
      exact hij (Subtype.ext he)
    have hz (i : I) : ∃ z : AdjoinRoot (g i),aeval (AdjoinRoot.root (g i)) a=z*z :=
      h (g i) (factor_irreducible f i)
        (dvd_of_mem_normalizedFactors (Multiset.mem_toFinset.mp i.property))
    choose z hz using hz
    have hcI : Pairwise (fun i j : I => IsCoprime
        (Ideal.span ({g i}:Set K[X])) (Ideal.span ({g j}:Set K[X]))) := by
      intro i j hij
      exact (Ideal.isCoprime_span_singleton_iff _ _).mpr (hc hij)
    obtain ⟨r,hr⟩ := Ideal.pi_quotient_surjective hcI z
    refine ⟨r,?_⟩
    rw [factor_product f hm hs]
    apply Fintype.prod_dvd_of_coprime hc
    intro i
    apply (aeval_root_zero_iff (g i) _).mp
    have hri : aeval (AdjoinRoot.root (g i)) r=z i := by
      rw [AdjoinRoot.aeval_eq]
      exact hr i
    simp only [map_sub,map_pow,map_mul,hri,hz,pow_two,sub_self]
  · rintro ⟨r,hr⟩ p hp hpf
    have hh := (aeval_root_zero_iff p (a-r^2)).mpr (hpf.trans hr)
    refine ⟨aeval (AdjoinRoot.root p) r,?_⟩
    simpa only [map_sub,map_pow,map_mul,sub_eq_zero,pow_two] using hh
theorem frobeniusTests_iff_square_mod (f a : K[X]) (hm : f.Monic) (hs : Squarefree f)
    (hcop : IsCoprime f a) (hchar : ringChar K≠2) :
    FrobeniusSquareTests f a ↔ ∃ r : K[X],f ∣ a-r^2 :=
  (primarySquares_iff_frobeniusSquareTests f a hs hm.ne_zero hcop hchar).symm.trans
    (primarySquares_iff_square_mod f a hm hs)
theorem injective_aeval_coprime {V : Type*} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] (S : Module.End K V) (a : K[X])
    (hs : Squarefree S.charpoly) (ha : Function.Injective (aeval S a)) :
    IsCoprime S.charpoly a := by
  classical
  rw [factor_product S.charpoly S.charpoly_monic hs]
  apply IsCoprime.prod_left
  intro i _
  apply (factor_irreducible S.charpoly i).coprime_iff_not_dvd.mpr
  intro hd
  apply Mathproof.Problem18PrimaryNonzeroBoundary20260930.primary_kernel_ne_bot S i.val
    (factor_irreducible S.charpoly i)
    (dvd_of_mem_normalizedFactors (Multiset.mem_toFinset.mp i.property))
  apply LinearMap.ker_eq_bot'.mpr
  intro v hv
  apply ha
  rw [map_zero]
  obtain ⟨p,hp⟩ := hd
  rw [hp,mul_comm,aeval_mul,Module.End.mul_apply,hv,map_zero]
end Mathproof.Problem18OddCyclicFormDecision20260930
