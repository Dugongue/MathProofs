def program (q : RNames) (ci : String) (D S : Expr) : Com :=
  .seq (constLoadE canonical q ci (.lit 0) (.lit 0))
    (.seq (constLoadE canonical q ci (.lit 5) (.lit 1))
      (finish q (.lit 5) D S S))
variable {K : Type} [Field K] [Fintype K] (F : FieldPresentation K)
def cost (D S : Expr) (n : Nat) := constCostE (.lit 0) (.lit 0) F.e+
  constCostE (.lit 5) (.lit 1) F.e+finishCost F (.lit 5) D S S n
theorem program_run (q : RNames) (hq : q.Valid canonical) (ci : String)
    (hcS : ci∉regNames canonical) (hcq : ci∉q.list) (D S : Expr)
    (hD : VarsIn q.fixed D) (hS : VarsIn q.fixed S)
    {B Sn dv sv n : Nat} {σ : Env} (hslots : Slots F canonical q.WS Sn B σ)
    (hd : D.evalB B σ=some dv) (hs : S.evalB B σ=some sv) (hn : σ.vars q.N=n)
    (hdf : dv+n ≤ Sn) (hsf : sv+n ≤ Sn) (hd6 : 6 ≤ dv) (hs6 : 6 ≤ sv)
    (hds : dv+n ≤ sv ∨ sv+n ≤ dv) :
    ∃τ,Run B (program q ci D S) σ τ (cost F D S n) ∧
      Slots F canonical q.WS Sn B τ ∧
      (∀i<n,val F canonical q.WS τ (sv+i)=
        val F canonical q.WS σ (dv+i)+val F canonical q.WS σ (sv+i)) ∧
      (∀s<Sn,(s<sv ∨ sv+n ≤ s) → (s<dv ∨ dv+n ≤ s) →
        s≠0 → s≠2 → s≠3 → s≠4 → s≠5 →
        val F canonical q.WS τ s=val F canonical q.WS σ s) ∧
      (∀x,x∉regNames canonical → x≠q.j → x≠ci → τ.vars x=σ.vars x) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hcW : ci≠q.WS := fun he=>hcq (he ▸ q.WS_mem)
  have hword:=hslots.slots_word
  have hp:=F.prime.two_le
  obtain ⟨ρ₀,hr₀,h₀,hzero,hmem₀,hreg₀,harr₀,hin₀,hout₀⟩:=
    constE_run (F:=F) (r:=canonical) q ci hcS hcW [] (by simp) (.lit 0) trivial hslots
      (evalB_lit (by omega)) (by omega) (.lit 0) [] (by simp) trivial
      (evalB_lit (by omega)) (by omega)
  obtain ⟨ρ₁,hr₁,h₁,hunit,hmem₁,hreg₁,harr₁,hin₁,hout₁⟩:=
    constE_run (F:=F) (r:=canonical) q ci hcS hcW [] (by simp) (.lit 5) trivial h₀
      (evalB_lit (by omega)) (by omega) (.lit 1) [] (by simp) trivial
      (evalB_lit (by omega)) (by omega)
