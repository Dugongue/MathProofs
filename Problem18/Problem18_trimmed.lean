def totalFinish : State → List Bool
  | .one => [true]
  | _ => [false]
def totalDecoder : Transducer Symbol Bool State where
  initial := .start
  next s a := (nextState s a, [])
  finish := totalFinish
  next_bound _ _ := by simp
  finish_bound s := by cases s <;> simp [totalFinish]
@[simp] theorem totalDecoder_empty :
    Mathproof.Problem18FiniteTransducer20261001.run totalDecoder .start [] = [false] := rfl
theorem total_decode_answer (b : Bool) :
    Mathproof.Problem18FiniteTransducer20261001.run totalDecoder .start
        (Lax51.BinaryWordEncoding.encode (answerWords (some b))) =
      BitstringEncoding.bitEncode b := by
  cases b <;> decide
inductive StatusState
  | status
  | timeout
  | success (decoder : State)
  deriving DecidableEq, Fintype
def statusNext : StatusState → Symbol → StatusState
  | .status, .one => .success .start
  | .status, _ => .timeout
  | .timeout, _ => .timeout
  | .success q, a => .success (nextState q a)
def statusFinish : StatusState → List Bool
  | .success q => totalFinish q
  | _ => [false]
def statusDecoder : Transducer Symbol Bool StatusState where
  initial := .status
  next q a := (statusNext q a, [])
  finish := statusFinish
  next_bound _ _ := by simp
  finish_bound q := by
    cases q with
    | status | timeout => simp [statusFinish]
    | success q => cases q <;> simp [statusFinish, totalFinish]
theorem run_timeout (raw : List Symbol) :
    Mathproof.Problem18FiniteTransducer20261001.run statusDecoder .status (.zero :: raw) = [false] := by
  change Mathproof.Problem18FiniteTransducer20261001.run statusDecoder .timeout raw = [false]
  induction raw with
  | nil => rfl
  | cons a raw ih =>
      change Mathproof.Problem18FiniteTransducer20261001.run
        statusDecoder .timeout raw = [false]
      exact ih
theorem run_success (raw : List Symbol) :
    Mathproof.Problem18FiniteTransducer20261001.run statusDecoder .status (.one :: raw) =
      Mathproof.Problem18FiniteTransducer20261001.run totalDecoder .start raw := by
  have aux : ∀ (q : State) (xs : List Symbol),
      Mathproof.Problem18FiniteTransducer20261001.run statusDecoder (.success q) xs = Mathproof.Problem18FiniteTransducer20261001.run totalDecoder q xs := by
    intro q xs
    induction xs generalizing q with
    | nil => rfl
    | cons a xs ih =>
        simp only [Mathproof.Problem18FiniteTransducer20261001.run, statusDecoder, statusNext, totalDecoder,
          List.nil_append]
        exact ih (nextState q a)
  change Mathproof.Problem18FiniteTransducer20261001.run statusDecoder (.success .start) raw =
    Mathproof.Problem18FiniteTransducer20261001.run totalDecoder .start raw
  exact aux .start raw
noncomputable def statusDecoderMachine :
    TM2ComputableInPolyTime id id (Mathproof.Problem18FiniteTransducer20261001.run statusDecoder .status) :=
  computable statusDecoder
