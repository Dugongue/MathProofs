    (.assign zj (.bin .add (.var zj) (.lit 1)))
def zfill : Com := .seq (.assign zj (.lit 0)) (.while (.lt (.var zj) (.var zcnt)) zbody)
theorem zfill_run {B N b : Nat} (σ : Env) (hB1 : 1 < B) (hN : σ.vars zcnt = N)
    (hb : σ.vars zbase = b) (hNB : N < B) (hbB : b + N < B)
    (hfit : b + N ≤ (σ.arrs canonical.mem).length) :
    ∃ τ, Run B zfill σ τ (20*N+6) ∧
      (∀ k < N, (τ.arrs canonical.mem).getD (b+k) 0 = 0) ∧
      (∀ j, (j < b ∨ b + N ≤ j) →
        (τ.arrs canonical.mem).getD j 0 = (σ.arrs canonical.mem).getD j 0) ∧
      (τ.arrs canonical.mem).length = (σ.arrs canonical.mem).length ∧
      (∀ a, a ≠ canonical.mem → τ.arrs a = σ.arrs a) ∧
      (∀ x, x ≠ zj → τ.vars x = σ.vars x) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  let I : Env → Prop := fun ρ => ρ.vars zj ≤ N ∧ ρ.vars zcnt = N ∧ ρ.vars zbase = b ∧
    (ρ.arrs canonical.mem).length = (σ.arrs canonical.mem).length ∧
    (∀ a, a ≠ canonical.mem → ρ.arrs a = σ.arrs a) ∧
    (∀ k < ρ.vars zj, (ρ.arrs canonical.mem).getD (b+k) 0 = 0) ∧
    (∀ j, (j < b ∨ b + ρ.vars zj ≤ j) →
      (ρ.arrs canonical.mem).getD j 0 = (σ.arrs canonical.mem).getD j 0)
  let V : Env → Nat := fun ρ => N - ρ.vars zj
  have hdef : ∀ ρ, I ρ → ∃ v, (Cond.lt (.var zj) (.var zcnt)).evalB B ρ = some v := by
    intro ρ h
    exact evalB_condLt_vars (by have := h.1; omega) (by rw [h.2.1]; exact hNB)
  have hstep : ∀ ρ, I ρ → (Cond.lt (.var zj) (.var zcnt)).evalB B ρ = some true →
      ∃ τ, Run B zbody ρ τ 16 ∧ I τ ∧ V τ < V ρ := by
    intro ρ h hc
    obtain ⟨hj,hcnt,hbase,hlen,harr,hin,hout⟩ := h
    have htest := evalB_condLt (evalB_var (by omega : ρ.vars zj < B))
      (evalB_var (by rw [hcnt]; exact hNB : ρ.vars zcnt < B))
    rw [hc,hcnt] at htest
    have hi : ρ.vars zj < N := by simpa using htest.symm
    obtain ⟨j,hjeq⟩ : ∃ j, ρ.vars zj = j := ⟨_,rfl⟩
    rw [hjeq] at hi hj
    have haddr : (Expr.bin .add (.var zbase) (.var zj)).evalB B ρ = some (b + j) := by
      have := evalB_bin (op:=.add) (evalB_var (σ:=ρ) (x:=zbase) (B:=B) (by rw [hbase]; omega))
        (evalB_var (σ:=ρ) (x:=zj) (B:=B) (by rw [hjeq]; omega))
        (by simp only [Bop.apply, hbase, hjeq]; omega)
      simpa [Bop.apply, hbase, hjeq] using this
    have hidx : b + j < (ρ.arrs canonical.mem).length := by rw [hlen]; omega
    let ρ1 := ρ.setArr canonical.mem (b + j) 0
    have hr1 : Run B (.store canonical.mem (.bin .add (.var zbase) (.var zj)) (.lit 0)) ρ ρ1 10 :=
      (Run.store haddr (evalB_lit (σ:=ρ) (B:=B) (n:=0) (by omega)) hidx).mono (by simp)
    have hinc : (Expr.bin .add (.var zj) (.lit 1)).evalB B ρ1 = some (j + 1) := by
      have := evalB_bin (op:=.add) (evalB_var (σ:=ρ1) (x:=zj) (B:=B) (by simp [ρ1, hjeq]; omega))
        (evalB_lit (σ:=ρ1) (B:=B) (n:=1) hB1) (by simp [Bop.apply, ρ1, hjeq]; omega)
      simpa [Bop.apply, ρ1, hjeq] using this
    refine ⟨ρ1.setVar zj (j+1), (hr1.seq (Run.assign (x:=zj) hinc)).mono (by simp), ?_, ?_⟩
    · refine ⟨by simp; omega, (vsn (by decide)).trans hcnt, (vsn (by decide)).trans hbase,
        by simp [ρ1, hlen], ?_, ?_, ?_⟩
      · intro a ha; simp [ρ1, ha, harr a ha]
      · intro k hk
        simp only [vars_setVar, ↓reduceIte] at hk
        simp only [ρ1, arrs_setVar, arrs_setArr, ↓reduceIte]
        by_cases hkj : k = j
        · subst hkj; exact Mathproof.Problem18PairBoundaryCopy20261004.getD_set_self hidx
        · rw [Mathproof.Problem18PairBoundaryCopy20261004.getD_set_ne (by omega)]
          exact hin k (by rw [hjeq]; omega)
      · intro i hi'
        simp only [vars_setVar, ↓reduceIte] at hi'
        simp only [ρ1, arrs_setVar, arrs_setArr, ↓reduceIte]
        rw [Mathproof.Problem18PairBoundaryCopy20261004.getD_set_ne (by omega)]
        exact hout i (by rw [hjeq]; omega)
    · show N - (ρ1.setVar zj (j+1)).vars zj < N - ρ.vars zj
      simp; omega
  have hI : I (σ.setVar zj 0) := by
    refine ⟨by simp, (vsn (by decide)).trans hN, (vsn (by decide)).trans hb,
      rfl, fun _ _ => rfl, by simp, fun _ _ => rfl⟩
  obtain ⟨τ, hr, hτ, hfalse⟩ := Run.while_count I V 16 hdef hstep hI
  obtain ⟨hj, hcnt, -, hlen, harr, hin, hout⟩ := hτ
  have ht := evalB_condLt (evalB_var (by omega : τ.vars zj < B))
    (evalB_var (by rw [hcnt]; exact hNB : τ.vars zcnt < B))
  rw [hfalse, hcnt] at ht
