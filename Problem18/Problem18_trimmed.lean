    rw [Nat.add_assoc, Nat.add_comm, Nat.add_mul_div_right _ _ (by positivity),
      Nat.div_eq_of_lt hab, Nat.zero_add]
  have h2 : (j.val * (n * n) + a.val * n + b.val) % (n * n) = a.val * n + b.val := by
    rw [Nat.add_assoc, Nat.add_comm, Nat.add_mul_mod_self_right, Nat.mod_eq_of_lt hab]
  have h3 : (a.val * n + b.val) / n = a.val := by
