variable {K V : Type} [Field K] [Fintype K] [DecidableEq K] {a b c q : Nat}
abbrev Params (a b : Nat) :=Fin 4 × Fin (a*b) × Fin (a*b)
def sum : List (StarExpr V Int)→StarExpr V Int
