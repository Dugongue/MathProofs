noncomputable section
abbrev gmem : String := Problem18IMPTensorGather20261002.memory
abbrev gtotal : String := Problem18IMPTensorGather20261002.total
theorem bank_ne_gmem : bank ≠ gmem := by decide
theorem gmem_ne_mem : gmem ≠ canonical.mem := by decide
theorem gmem_ne_scratch : gmem ≠ canonical.scratch := by decide
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
structure GStore (W gLen : Nat) (σ : Env) : Prop where
  len : (σ.arrs gmem).length = gLen
  word : gLen < W
  vals : ∀ x < gLen, (σ.arrs gmem).getD x 0 < F.p
def TensorAt (arr : String) (σ : Env) (off : Nat) {a b c : Nat} (Z : RectTensor a b c K) :
    Prop :=
  ∀ j < a * b * c * F.e, (σ.arrs arr).getD (off + j) 0 = (tensorCoordinates F Z).getD j 0
theorem valid_congr {W : Nat} {σ τ : Env} (h : ValidMemory F W σ)
    (he : τ.vars canonical.e = σ.vars canonical.e)
    (hp : τ.vars canonical.p = σ.vars canonical.p)
    (hm : τ.vars canonical.modBase = σ.vars canonical.modBase)
    (ham : τ.arrs canonical.mem = σ.arrs canonical.mem)
    (has : τ.arrs canonical.scratch = σ.arrs canonical.scratch) : ValidMemory F W τ := by
  refine ⟨?_, ?_, h.arithmetic_word, h.inverse_word, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [he]; exact h.degree
  · rw [hp]; exact h.prime
  · rw [ham]; exact h.memory_word
  · rw [has]; exact h.scratch_word
  · rw [has]; exact h.scratch_fit
  · rw [ham, hm]; exact h.modulus_fit
  · intro i
    have := h.modulus_value i
    simp only [Problem18IMPFieldMultiplication20261001.sourceCoeff] at this ⊢
    rw [ham, hm]; exact this
  · rw [ham]; exact h.coefficients
theorem coords_lt {a b c : Nat} (Z : RectTensor a b c K) :
    ∀ j, (tensorCoordinates F Z).getD j 0 < F.p := by
  intro j
  have hp : 0 < F.p := F.prime.pos
  rw [List.getD_eq_getElem?_getD]
  cases h : (tensorCoordinates F Z)[j]? with
  | none => simpa using hp
  | some v =>
    have hv : v ∈ tensorCoordinates F Z := List.mem_of_getElem? h
    simp only [tensorCoordinates, List.mem_flatMap, List.mem_map, List.mem_finRange,
      true_and] at hv
    obtain ⟨k, i, j, t, rfl⟩ := hv
    simpa using (F.coordinate _ t).isLt
def tensorWords (x y z : String) : Expr :=
  .mul (.mul (.mul (.var x) (.var y)) (.var z)) (.var canonical.e)
def gatherStage (oZ x y z : String) : Com :=
  .seq reset <|
  .seq (copyBlock bank gmem (.var oZ) (.lit 0) (tensorWords x y z)) <|
  .seq (.assign "a" (.var x)) <|
  .seq (.assign "b" (.var y)) <|
  .seq (.assign "c" (.var z)) <|
  .seq (.assign gtotal (tensorWords "a" "b" "c")) <|
    sortedTensorProgram
def gatherCost (Sn a b c : Nat) : Nat :=
  20 * (1 + Sn * F.e) + 14 + (20 * (a * b * c * F.e) + 30) + 30 +
    (Mathproof.Problem18IMPAssignments20261002.cost (gatherBindings (sortOrder a b c)) + 12 +
      210 * (a * b * c * F.e + 1))
theorem sorted_keeps_bank : bank ∉ arrayWrites sortedTensorProgram := by decide
theorem sorted_keeps_gmem : gmem ∉ arrayWrites sortedTensorProgram := by decide
theorem clean_tensorWords (x y z : String) (hx : x ∉ wcRegs) (hy : y ∉ wcRegs) (hz : z ∉ wcRegs) :
    Clean (tensorWords x y z) := by
  simp only [wcRegs, List.mem_cons, List.not_mem_nil, or_false, not_or] at hx hy hz
  obtain ⟨_, x1, x2, x3⟩ := hx
  obtain ⟨_, y1, y2, y3⟩ := hy
  obtain ⟨_, z1, z2, z3⟩ := hz
  simp only [Clean, tensorWords, Problem18ClaudeIMPSlots20261001.NoVar]
  refine ⟨⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩, ⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩, ⟨⟨⟨?_, ?_⟩, ?_⟩, ?_⟩⟩ <;>
    first | decide | assumption
theorem tensorWords_eval {W : Nat} {σ : Env} {x y z : String} {a b c : Nat}
    (hx : σ.vars x = a) (hy : σ.vars y = b) (hz : σ.vars z = c) (he : σ.vars canonical.e = F.e)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hW : a * b * c * F.e < W) :
    (tensorWords x y z).evalB W σ = some (a * b * c * F.e) := by
  have h := evalB_mono (B := W) (σ := σ) (tensorWords x y z)
    (by simp only [tensorWords, Mono, evalN, Bop.apply, hx, hy, hz, he]
        have := F.degree_pos
        refine ⟨⟨⟨trivial, trivial, ha, hb⟩, trivial, Nat.mul_pos ha hb, hc⟩, trivial,
          Nat.mul_pos (Nat.mul_pos ha hb) hc, this⟩)
    (by simp only [tensorWords, evalN, Bop.apply, hx, hy, hz, he]; exact hW)
  rw [h]; simp only [tensorWords, evalN, Bop.apply, hx, hy, hz, he]
theorem gatherStage_run {W Sn bankLen gLen a0 b0 c0 oz : Nat} {u : Bool} {q : Nat} {σ : Env}
    (oZ x y z : String) (hG : Glob F W Sn bankLen σ) (htail : σ.vars memTail = 1 + Sn * F.e)
    (hGS : GStore F W gLen σ) (Z : RectTensor a0 b0 c0 K) (hT : TensorAt F bank σ oz Z)
    (hozL : oz + a0 * b0 * c0 * F.e ≤ bankLen)
    (hoz : σ.vars oZ = oz) (hx : σ.vars x = a0) (hy : σ.vars y = b0) (hz : σ.vars z = c0)
    (hgl : a0 * b0 * c0 * F.e ≤ gLen) (ha : 0 < a0) (hb : 0 < b0) (hc : 0 < c0)
    (hu : σ.vars "u" = u.toNat) (hq : σ.vars "q" = q) (hqW : q < W)
    (hfit : layoutEndN a0 b0 c0 ≤ Sn) (hSnW : Sn < W)
    (hnames : ∀ v ∈ [oZ, x, y, z], v ∉ wcRegs) (hya : y ≠ "a") (hza : z ≠ "a")
    (hzb : z ≠ "b") :
    ∃ τ, Run W (gatherStage oZ x y z) σ τ (gatherCost F Sn a0 b0 c0) ∧
      PostGather F W Sn (shape (sortOrder a0 b0 c0) a0 b0 c0).1
        (shape (sortOrder a0 b0 c0) a0 b0 c0).2.1 (shape (sortOrder a0 b0 c0) a0 b0 c0).2.2
        u q (tensorEquiv (sortOrder a0 b0 c0) Z) τ ∧
      Glob F W Sn bankLen τ ∧ GStore F W gLen τ ∧ τ.arrs bank = σ.arrs bank ∧
      (∀ v, v ∉ wcRegs → v ∉ ["a", "b", "c", gtotal] →
        v ∉ scalarWrites sortedTensorProgram → τ.vars v = σ.vars v) ∧
      τ.vars "a" = a0 ∧ τ.vars "b" = b0 ∧ τ.vars "c" = c0 ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  have he := F.degree_pos
  have hpW : F.p < W := by
    have : F.p + 1 ≤ (F.p + 1) ^ 2 := Nat.le_self_pow (by norm_num) _
    have := hG.arith; omega
  have hNW : a0 * b0 * c0 * F.e < W := by have := hGS.word; omega
  have hB2 : 1 < W := by have := hG.mem_word; have := hG.mem_len; omega
  obtain ⟨hn1, hn2, hn3, hn4⟩ : oZ ∉ wcRegs ∧ x ∉ wcRegs ∧ y ∉ wcRegs ∧ z ∉ wcRegs :=
    ⟨hnames _ (by simp), hnames _ (by simp), hnames _ (by simp), hnames _ (by simp)⟩
  obtain ⟨σ1, hr1, hG1, hV1, -, hv1, ha1, hi1, ho1⟩ := reset_run F hG htail
  have hb1 : σ1.arrs bank = σ.arrs bank := ha1 bank bank_ne_mem
  have hg1 : σ1.arrs gmem = σ.arrs gmem := ha1 gmem gmem_ne_mem
  obtain ⟨σ2, hr2, hv2, ha2, hl2, hd2, hi2, ho2⟩ := copyBlock_run (B := W) bank gmem bank_ne_gmem
    σ1 (s := .var oZ) (d := .lit 0) (n := tensorWords x y z) (sv := oz) (dv := 0)
    (nv := a0 * b0 * c0 * F.e) (clean_var oZ hn1) ⟨trivial, trivial, trivial⟩
    (clean_tensorWords x y z hn2 hn3 hn4)
    (by rw [← hoz, ← hv1 oZ hn1]; exact evalB_var (by rw [hv1 oZ hn1, hoz]; have := hG.bank_word; omega))
    (evalB_lit (by omega))
    (tensorWords_eval F ((hv1 x hn2).trans hx) ((hv1 y hn3).trans hy) ((hv1 z hn4).trans hz)
      hG1.e_reg ha hb hc hNW)
    (by rw [hb1, hG.bank_len]; exact hozL) (by rw [hg1, hGS.len]; omega)
    (by rw [hb1, hG.bank_len]; exact hG.bank_word) (by rw [hg1, hGS.len]; exact hGS.word)
    (by
      intro j hj
      rw [hb1, hT j hj]
      exact lt_trans (coords_lt F Z j) hpW) hB2
  have hm2 : σ2.arrs canonical.mem = σ1.arrs canonical.mem := ha2 _ (Ne.symm gmem_ne_mem)
  have hs2 : σ2.arrs canonical.scratch = σ1.arrs canonical.scratch := ha2 _ (Ne.symm gmem_ne_scratch)
  have hb2 : σ2.arrs bank = σ.arrs bank := (ha2 bank bank_ne_gmem).trans hb1
  let s3 := σ2.setVar "a" a0
  let s4 := s3.setVar "b" b0
  let s5 := s4.setVar "c" c0
  let σ6 := s5.setVar gtotal (a0 * b0 * c0 * F.e)
  have sv : ∀ (ρ : Env) (x y : String) (v : Nat), y ≠ x → (ρ.setVar x v).vars y = ρ.vars y :=
    fun ρ x y v h => by simp [Env.setVar, h]
  have ss : ∀ (ρ : Env) (x : String) (v : Nat), (ρ.setVar x v).vars x = v :=
    fun ρ x v => by simp [Env.setVar]
  have x2 : σ2.vars x = a0 := (hv2 x hn2).trans ((hv1 x hn2).trans hx)
  have y2 : σ2.vars y = b0 := (hv2 y hn3).trans ((hv1 y hn3).trans hy)
  have z2 : σ2.vars z = c0 := (hv2 z hn4).trans ((hv1 z hn4).trans hz)
  have haW : a0 < W := lt_of_le_of_lt (by
    have : a0 ≤ a0 * b0 := Nat.le_mul_of_pos_right _ hb
    have : a0 * b0 ≤ a0 * b0 * c0 := Nat.le_mul_of_pos_right _ hc
    have : a0 * b0 * c0 ≤ a0 * b0 * c0 * F.e := Nat.le_mul_of_pos_right _ he
    omega) hNW
  have hbW : b0 < W := lt_of_le_of_lt (by
    have : b0 ≤ a0 * b0 := Nat.le_mul_of_pos_left _ ha
    have : a0 * b0 ≤ a0 * b0 * c0 := Nat.le_mul_of_pos_right _ hc
    have : a0 * b0 * c0 ≤ a0 * b0 * c0 * F.e := Nat.le_mul_of_pos_right _ he
    omega) hNW
  have hcW : c0 < W := lt_of_le_of_lt (by
    have : c0 ≤ a0 * b0 * c0 := Nat.le_mul_of_pos_left _ (Nat.mul_pos ha hb)
    have : a0 * b0 * c0 ≤ a0 * b0 * c0 * F.e := Nat.le_mul_of_pos_right _ he
    omega) hNW
  have r3 : Run W (.assign "a" (.var x)) σ2 s3 2 := by
    have := Run.assign (x := "a") (σ := σ2) (B := W) (evalB_var (σ := σ2) (x := x) (by rw [x2]; exact haW))
    simpa [x2, Expr.size] using this
  have r4 : Run W (.assign "b" (.var y)) s3 s4 2 := by
    have hy3 : s3.vars y = b0 := by rw [sv _ _ _ _ hya, y2]
    have := Run.assign (x := "b") (σ := s3) (B := W) (evalB_var (σ := s3) (x := y) (by rw [hy3]; exact hbW))
    simpa [hy3, Expr.size] using this
  have r5 : Run W (.assign "c" (.var z)) s4 s5 2 := by
    have hz4 : s4.vars z = c0 := by rw [sv _ _ _ _ hzb, sv _ _ _ _ hza, z2]
    have := Run.assign (x := "c") (σ := s4) (B := W) (evalB_var (σ := s4) (x := z) (by rw [hz4]; exact hcW))
    simpa [hz4, Expr.size] using this
  have e5 : s5.vars canonical.e = F.e := by
    rw [sv _ _ _ _ (by decide), sv _ _ _ _ (by decide), sv _ _ _ _ (by decide),
      hv2 _ (by decide), hG1.e_reg]
  have r6 : Run W (.assign gtotal (tensorWords "a" "b" "c")) s5 σ6
      (1 + (tensorWords "a" "b" "c").size) := Run.assign
    (tensorWords_eval F (by rw [sv _ _ _ _ (by decide), sv _ _ _ _ (by decide), ss])
      (by rw [sv _ _ _ _ (by decide), ss]) (ss _ _ _) e5 ha hb hc hNW)
  have k6 : ∀ v, v ∉ ["a", "b", "c", gtotal] → σ6.vars v = σ2.vars v := by
    intro v hv
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hv
    rw [sv _ _ _ _ hv.2.2.2, sv _ _ _ _ hv.2.2.1, sv _ _ _ _ hv.2.1, sv _ _ _ _ hv.1]
  have hV6 : ValidMemory F W σ6 := valid_congr F hV1
    (by rw [k6 _ (by decide), hv2 _ (by decide)]) (by rw [k6 _ (by decide), hv2 _ (by decide)])
    (by rw [k6 _ (by decide), hv2 _ (by decide)]) hm2 hs2
  have hgm6 : σ6.arrs gmem = σ2.arrs gmem := rfl
  have hsrc : GatherSource F W a0 b0 c0 Z σ6 := {
    hdr_a := by rw [sv _ _ _ _ (by decide), sv _ _ _ _ (by decide), sv _ _ _ _ (by decide), ss]
    hdr_b := by rw [sv _ _ _ _ (by decide), sv _ _ _ _ (by decide), ss]
    hdr_c := by rw [sv _ _ _ _ (by decide), ss]
    e_reg := by rw [sv _ _ _ _ (by decide)]; exact e5
    total := ss _ _ _
    fit := by rw [hgm6, hl2, hg1, hGS.len]; exact hgl
    word := by rw [hgm6, hl2, hg1, hGS.len]; exact hGS.word
    values := by
      intro j hj
      rw [hgm6, hd2]
      split_ifs with hin
      · rw [hb1, hT _ (by omega)]; exact lt_trans (coords_lt F Z _) hpW
      · rw [hg1]
        exact lt_trans (hGS.vals j (by rw [hgm6, hl2, hg1, hGS.len] at hj; exact hj)) hpW
    coords := by
      intro j hj
      rw [hgm6, hd2, if_pos (by omega), hb1, Nat.sub_zero]
      exact hT j hj }
  obtain ⟨τ, hgrun, hPG, hsrcτ, -, hiτ, hoτ⟩ :=
    Mathproof.Problem18P36LargePrefix20261004.gather_post F ha hb hc hV6
      (by rw [show σ6.arrs canonical.mem = σ1.arrs canonical.mem from hm2]; exact hG1.mem_len)
      (by rw [show σ6.arrs canonical.scratch = σ1.arrs canonical.scratch from hs2]; exact hG1.scratch_fit)
      hSnW hqW hfit
      (by rw [k6 _ (by decide), hv2 _ (by decide), hv1 _ (by decide)]; exact hu)
      (by rw [k6 _ (by decide), hv2 _ (by decide), hv1 _ (by decide)]; exact hq)
      (by rw [k6 _ (by decide), hv2 _ (by decide)]; exact hG1.mod_reg) hsrc
  have hfr := run_frame hgrun
  have hbτ : τ.arrs bank = σ.arrs bank := by rw [hfr.2.1 _ sorted_keeps_bank]; exact hb2
  have hgτ : τ.arrs gmem = σ2.arrs gmem := hfr.2.1 _ sorted_keeps_gmem
  have hGτ : Glob F W Sn bankLen τ := by
    apply Glob.transfer F hG1
    · rw [hPG.valid.degree, hG1.e_reg]
    · rw [hPG.valid.prime, hG1.p_reg]
    · rw [hPG.modBase, hG1.mod_reg]
    · intro i
      have h1 := hPG.valid.modulus_value i
      simp only [Problem18IMPFieldMultiplication20261001.sourceCoeff, hPG.modBase,
        Nat.zero_add] at h1
      rw [h1, hG1.modulus i]
    · intro arr
      rw [hfr.2.2.1 arr]
      show (σ2.arrs arr).length = _
      by_cases h : arr = gmem
      · subst h; exact hl2
      · rw [ha2 arr h]
  refine ⟨τ, ?_, hPG, hGτ, ?_, hbτ, ?_, hsrcτ.hdr_a, hsrcτ.hdr_b, hsrcτ.hdr_c,
    hiτ.trans (hi2.trans hi1), hoτ.trans (ho2.trans ho1)⟩
  · have hall := hr1.seq (hr2.seq (r3.seq (r4.seq (r5.seq (r6.seq hgrun)))))
    apply hall.mono
    simp only [gatherCost, Expr.size, tensorWords]
    omega
  · refine ⟨by rw [hgτ, hl2, hg1, hGS.len], hGS.word, ?_⟩
    intro j hj
    rw [hgτ, hd2]
    split_ifs with hin
    · rw [hb1, hT _ (by omega)]; exact coords_lt F Z _
    · rw [hg1]; exact hGS.vals j hj
  · intro v hw hh hs
    rw [hfr.1 v hs, k6 v hh, hv2 v hw, hv1 v hw]
end
