def Words (B : Nat) (a : String) (σ : Env) : Prop := ∀ v ∈ σ.arrs a, v < B
theorem bigStep_words {B k : Nat} {c : Com} {σ τ : Env}
    (h : BigStepB B c σ τ k) (a : String) (hw : Words B a σ) : Words B a τ := by
  induction h with
  | skip => exact hw
  | assign _ => exact hw
  | @store σ dst i e k v hi he hk =>
    intro u hu
    have hv : v < B := Expr.lt_of_evalB he
    by_cases had : a=dst
    · subst dst
      simp only [Env.setArr,if_pos rfl] at hu
      rcases List.mem_or_eq_of_mem_set hu with h | h
      · exact hw u h
      · subst u; exact hv
    · apply hw u
      simpa [Env.setArr,had] using hu
  | seq _ _ ih ih' => exact ih' (ih hw)
  | ite_true _ _ ih => exact ih hw
  | ite_false _ _ ih => exact ih hw
  | while_true _ _ _ ih ih' => exact ih' (ih hw)
  | while_false _ => exact hw
  | read _ => exact hw
  | write _ => exact hw
theorem run_words {B k : Nat} {c : Com} {σ τ : Env}
    (h : Run B c σ τ k) (a : String) (hw : Words B a σ) : Words B a τ := by
  obtain ⟨t,_,ht⟩ := h
  exact bigStep_words ht a hw
end Mathproof.Problem18RecursiveMemoryWords20261002
