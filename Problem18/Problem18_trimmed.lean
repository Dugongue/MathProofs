variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}
def copyBody (M : FieldMacros F r) (q : RNames) (D S : Expr) : Com :=
  .seq (mcall r q M.copy (plus S (.var q.j)) (plus S (.var q.j)) (plus D (.var q.j)))
    (.assign q.j (plus (.var q.j) (.lit 1)))
def copyLoop (M : FieldMacros F r) (q : RNames) (D S : Expr) : Com :=
  .seq (.assign q.j (.lit 0)) (.while (.lt (.var q.j) (.var q.N)) (copyBody M q D S))
def copyStep (M : FieldMacros F r) (D S : Expr) : ℕ := 30 + D.size + 2 * S.size + M.costPoint
def copyCost (M : FieldMacros F r) (D S : Expr) (N : ℕ) : ℕ :=
