variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V]
theorem exists_subspaceBlockCoordinateMap
    (B : LinearMap.BilinForm K V) (W R : Submodule K V)
    (hRW : R ≤ W) (hRO : R ≤ B.orthogonal W)
    (p z : ℕ) (ht : finrank K R = p + z) :
    ∃ E : (Fin (p + z) → K) →ₗ[K] V,
      Function.Injective E ∧
      (∀ i, leftTestVector E i ∈ W) ∧
      (∀ l, RightOrthogonalTo B W (rightTestVector E l)) := by
  let reindex : (Fin (p + z) → K) ≃ₗ[K]
      (Fin (finrank K R) → K) :=
    LinearEquiv.piCongrLeft K (fun _ : Fin (finrank K R) => K)
      (finCongr ht.symm)
  let basis := finBasisFunEquiv R
  let E : (Fin (p + z) → K) →ₗ[K] V :=
    R.subtype.comp (basis.toLinearMap.comp reindex.toLinearMap)
  refine ⟨E, ?_, ?_, ?_⟩
  · exact R.subtype_injective.comp (basis.injective.comp reindex.injective)
  · intro i
    exact hRW (basis (reindex (Pi.single (Fin.castAdd z i) 1))).property
  · intro l
    exact hRO (basis (reindex (Pi.single (Fin.natAdd p l) 1))).property
end Mathproof.Problem18AnchorRadicalCoordinates20260930
