variable {K V W : Type*} [Field K] [AddCommGroup V] [Module K V]
  [AddCommGroup W] [Module K W] [FiniteDimensional K V] [FiniteDimensional K W]
  (σ : K ≃+* K)
set_option backward.isDefEq.respectTransparency false
abbrev SpectralMarkings (B : Form σ V) (C : Form σ W) (f : K[X])
    (T : SelfAdjointOperators σ (sumForm σ B C)) :=
  (j : EmbeddingOrbit σ B C) ×
    {A : SelfAdjointOperators σ B // A.val.charpoly=f ∧ ∀ x,T.val (j.val x)=j.val (A.val x)}
theorem marking_range (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft)
    (f : K[X]) (T : SelfAdjointOperators σ (sumForm σ B C))
    (hc : IsCoprime f (T.val.charpoly/f)) (M : SpectralMarkings σ B C f T) :
    LinearMap.range M.1.val=LinearMap.ker (Polynomial.aeval T.val f) := by
  have hcA : IsCoprime M.2.val.val.charpoly (T.val.charpoly/M.2.val.val.charpoly) := by
    simpa only [M.2.property.1] using hc
  have h := marked_primary_range σ B C hB M.2.val M.1 ⟨T,M.2.property.2⟩ hcA
  change LinearMap.ker (Polynomial.aeval T.val M.2.val.val.charpoly)=LinearMap.range M.1.val at h
  rw [M.2.property.1] at h
  exact h.symm
theorem marked_source_unique (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft)
    (T : SelfAdjointOperators σ (sumForm σ B C)) (j : EmbeddingOrbit σ B C)
    (A D : SelfAdjointOperators σ B)
    (hA : ∀ x,T.val (j.val x)=j.val (A.val x))
    (hD : ∀ x,T.val (j.val x)=j.val (D.val x)) : A=D := by
  apply Subtype.ext
  apply LinearMap.ext
  intro x
  apply embedding_injective σ B (sumForm σ B C) hB
    ⟨j.val,embeddingOrbit_isometric σ B C j⟩
  exact (hA x).symm.trans (hD x)
theorem same_range_marking_exists (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft)
    (f : K[X]) (T : SelfAdjointOperators σ (sumForm σ B C))
    (M : SpectralMarkings σ B C f T) (j : EmbeddingOrbit σ B C)
    (hr : LinearMap.range j.val=LinearMap.range M.1.val) :
    ∃ A : SelfAdjointOperators σ B,A.val.charpoly=f ∧ ∀ x,T.val (j.val x)=j.val (A.val x) := by
  let j₀ : IsometricEmbeddings σ B (sumForm σ B C) :=
    ⟨M.1.val,embeddingOrbit_isometric σ B C M.1⟩
  let j₁ : IsometricEmbeddings σ B (sumForm σ B C) :=
    ⟨j.val,embeddingOrbit_isometric σ B C j⟩
  let U := sameRangeIsometry σ B (sumForm σ B C) hB j₀ j₁ hr
  let A := conjugateOperator σ B (inverseIsometry σ B U) M.2.val
  have he (x : V) : M.1.val (U.val x)=j.val x :=
    rangeCoordinateEquiv_apply σ B (sumForm σ B C) hB j₀ j₁ hr x
  refine ⟨A,?_,?_⟩
  · change (U.val.symm.conj M.2.val.val).charpoly=f
    rw [LinearEquiv.charpoly_conj,M.2.property.1]
  · intro x
    rw [← he x,M.2.property.2,← he (A.val x)]
    change M.1.val (M.2.val.val (U.val x))=
      M.1.val (U.val (U.val.symm (M.2.val.val (U.val x))))
    rw [U.val.apply_symm_apply]
noncomputable def spectralMarkingsEquiv (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft)
    (f : K[X]) (T : SelfAdjointOperators σ (sumForm σ B C))
    (hc : IsCoprime f (T.val.charpoly/f)) (M : SpectralMarkings σ B C f T) :
    SpectralMarkings σ B C f T ≃
      {j : EmbeddingOrbit σ B C // LinearMap.range j.val=LinearMap.range M.1.val} := by
  let F : SpectralMarkings σ B C f T →
      {j : EmbeddingOrbit σ B C // LinearMap.range j.val=LinearMap.range M.1.val} :=
    fun N => ⟨N.1,(marking_range σ B C hB f T hc N).trans
      (marking_range σ B C hB f T hc M).symm⟩
  apply Equiv.ofBijective F
  constructor
  · rintro ⟨j,A⟩ ⟨k,D⟩ h
    have hj : j=k := congrArg Subtype.val h
    subst k
    have hA : A=D := Subtype.ext
      (marked_source_unique σ B C hB T j A.val D.val A.property.2 D.property.2)
    subst D
    rfl
  · intro j
    obtain ⟨A,hA⟩ := same_range_marking_exists σ B C hB f T M j.val j.property
    exact ⟨⟨j.val,⟨A,hA⟩⟩,Subtype.ext rfl⟩
theorem spectral_markings_card (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft)
    (f : K[X]) (T : SelfAdjointOperators σ (sumForm σ B C))
    (hc : IsCoprime f (T.val.charpoly/f)) (M : SpectralMarkings σ B C f T) :
    Nat.card (SpectralMarkings σ B C f T)=Nat.card (Isometries σ B) := by
  rw [Nat.card_congr (spectralMarkingsEquiv σ B C hB f T hc M)]
  exact same_range_embeddingOrbit_card σ B C hB M.1
end
