def mark (F : Matrix (Fin c) (Fin a × Fin b) K) (e : Fin c → K) : Fin (a*b+1) → K :=
  fun i=>padded (matrix F e) i ((augmentedIndex a b).symm (.inr ()))
theorem matrix_source (F : Matrix (Fin c) (Fin a × Fin b) K) (e : Fin c → K) :
    matrix (source F e) (mark F e)=padded (matrix F e) := by
  ext i j
  change augmentedScalar (source F e) (mark F e) i (augmentedIndex a b j)=_
  generalize hj:augmentedIndex a b j=z
  have hi : (augmentedIndex a b).symm z=j := by rw [←hj];simp
