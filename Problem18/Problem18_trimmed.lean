variable {I : Iso} (hI : Fresh I)
include hI
theorem agree_setVar {σ σ' : Env} (h : Agree I σ σ') (x : String) (v : Nat) :
    Agree I (σ.setVar x v) (σ'.setVar (I.ren x) v) := by
  refine ⟨fun y => ?_, fun a => h.2 a⟩
  simp only [Env.setVar]
  by_cases hy : y = x
  · subst hy; simp
  · have : I.ren y ≠ I.ren x := fun e => hy (hI.inj e)
    simp [hy, this, h.1 y]
theorem agree_setArr {σ σ' : Env} (h : Agree I σ σ') (a : String) (k v : Nat) :
    Agree I (σ.setArr a k v) (σ'.setArr (I.ren a) k v) := by
  refine ⟨fun y => h.1 y, fun b => ?_⟩
  simp only [Env.setArr]
  by_cases hb : b = a
  · subst hb; simp [h.2 b]
  · have : I.ren b ≠ I.ren a := fun e => hb (hI.inj e)
    simp [hb, this, h.2 b]
theorem agree_aux_var {σ σ' : Env} (h : Agree I σ σ') (z : String)
    (hz : ∀ y, I.ren y ≠ z) (v : Nat) : Agree I σ (σ'.setVar z v) := by
  refine ⟨fun y => ?_, fun a => h.2 a⟩
  simp [Env.setVar, hz y, h.1 y]
theorem agree_aux_arr {σ σ' : Env} (h : Agree I σ σ') (z : String)
    (hz : ∀ y, I.ren y ≠ z) (k v : Nat) : Agree I σ (σ'.setArr z k v) := by
  refine ⟨fun y => h.1 y, fun a => ?_⟩
  simp [Env.setArr, hz a, h.2 a]
theorem sim {B : Nat} {c : Com} {σ τ : Env} {k : Nat} (h : BigStepB B c σ τ k)
    (o0 : List Nat) (R : List Nat) :
    ∀ σ', Inv I B o0 R σ σ' → (I.redirect = true → o0.length + τ.out.length ≤ R.length) →
      ∃ τ' k', BigStepB B (iso I c) σ' τ' k' ∧ k' ≤ 7*k ∧
        Inv I B o0 R τ τ' ∧ Frame I σ' τ' := by
  induction h with
  | skip =>
      intro σ' hinv _
      exact ⟨σ', 1, .skip, by omega, hinv, Frame.refl I σ'⟩
  | @assign σ x e v he =>
      intro σ' hinv _
      refine ⟨σ'.setVar (I.ren x) v, 1 + e.size, ?_, by omega, ?_, ?_⟩
      · have := BigStepB.assign (B := B) (x := I.ren x)
          (show (renE I.ren e).evalB B σ' = some v by rw [evalB_renE hinv.agree]; exact he)
        simpa [iso, renE_size] using this
      · have hp : I.ren x ≠ I.pin := hI.pin x
        have hq : I.ren x ≠ I.pout := hI.pout x
        refine ⟨agree_setVar hI hinv.agree x v, ?_, hinv.tinLen, hinv.tinVal, hinv.outReal,
          ?_, ?_, hinv.outLen, hinv.LoutB, ?_⟩
        · simpa [Env.setVar, hp.symm] using hinv.tape
        · intro hr; simpa [Env.setVar, hq.symm] using hinv.outPtr hr
        · intro hr; simpa [Env.setVar, hq.symm] using hinv.outArr hr
        · intro hr; simpa [Env.setVar, hq.symm] using hinv.outRest hr
      · refine ⟨rfl, fun _ => rfl, fun z hz _ _ => ?_, fun _ _ _ => rfl⟩
        simp [Env.setVar, hz x]
  | @store σ a i e idx v hi he hk =>
      intro σ' hinv _
      refine ⟨σ'.setArr (I.ren a) idx v, 1 + i.size + e.size, ?_, by omega, ?_, ?_⟩
      · have := BigStepB.store (B := B) (a := I.ren a)
          (show (renE I.ren i).evalB B σ' = some idx by rw [evalB_renE hinv.agree]; exact hi)
          (show (renE I.ren e).evalB B σ' = some v by rw [evalB_renE hinv.agree]; exact he)
          (by rw [hinv.agree.2 a]; exact hk)
        simpa [iso, renE_size] using this
      · have ht : I.ren a ≠ I.tin := hI.tin a
        have ho : I.ren a ≠ I.tout := hI.tout a
        refine ⟨agree_setArr hI hinv.agree a idx v, ?_, ?_, ?_, hinv.outReal,
          hinv.outPtr, ?_, ?_, hinv.LoutB, ?_⟩
        · simpa [Env.setArr, ht.symm] using hinv.tape
        · simpa [Env.setArr, ht.symm] using hinv.tinLen
        · simpa [Env.setArr, ht.symm] using hinv.tinVal
        · intro hr; simpa [Env.setArr, ho.symm] using hinv.outArr hr
        · intro hr; simpa [Env.setArr, ho.symm] using hinv.outLen hr
        · intro hr; simpa [Env.setArr, ho.symm] using hinv.outRest hr
      · refine ⟨rfl, fun _ => rfl, fun _ _ _ _ => rfl, fun z hz _ => ?_⟩
        simp [Env.setArr, hz a]
  | @seq c d σ σ1 σ2 k1 k2 h1 h2 ih1 ih2 =>
      intro σ' hinv hfit
      obtain ⟨l, hl⟩ := out_prefix h2
      obtain ⟨τ1, k1', r1, hk1, hinv1, hf1⟩ := ih1 σ' hinv (fun hr => by
        have := hfit hr; rw [hl] at this; simp at this; omega)
      obtain ⟨τ2, k2', r2, hk2, hinv2, hf2⟩ := ih2 τ1 hinv1 hfit
      exact ⟨τ2, k1' + k2', .seq r1 r2, by omega, hinv2, hf1.trans hf2⟩
  | @ite_true b c d σ σ1 k1 hb h1 ih =>
      intro σ' hinv hfit
      obtain ⟨τ1, k1', r1, hk1, hinv1, hf1⟩ := ih σ' hinv hfit
      refine ⟨τ1, 1 + b.size + k1', ?_, by omega, hinv1, hf1⟩
      have := BigStepB.ite_true (d := iso I d)
        (show (renC I.ren b).evalB B σ' = some true by rw [evalB_renC hinv.agree]; exact hb) r1
      simpa [iso, renC_size] using this
  | @ite_false b c d σ σ1 k1 hb h1 ih =>
      intro σ' hinv hfit
      obtain ⟨τ1, k1', r1, hk1, hinv1, hf1⟩ := ih σ' hinv hfit
      refine ⟨τ1, 1 + b.size + k1', ?_, by omega, hinv1, hf1⟩
      have := BigStepB.ite_false (c := iso I c)
        (show (renC I.ren b).evalB B σ' = some false by rw [evalB_renC hinv.agree]; exact hb) r1
      simpa [iso, renC_size] using this
  | @while_true b c σ σ1 σ2 k1 k2 hb h1 h2 ih1 ih2 =>
      intro σ' hinv hfit
      obtain ⟨l, hl⟩ := out_prefix h2
      obtain ⟨τ1, k1', r1, hk1, hinv1, hf1⟩ := ih1 σ' hinv (fun hr => by
        have := hfit hr; rw [hl] at this; simp at this; omega)
      obtain ⟨τ2, k2', r2, hk2, hinv2, hf2⟩ := ih2 τ1 hinv1 hfit
      refine ⟨τ2, 1 + b.size + k1' + k2', ?_, by omega, hinv2, hf1.trans hf2⟩
      have := BigStepB.while_true
        (show (renC I.ren b).evalB B σ' = some true by rw [evalB_renC hinv.agree]; exact hb)
        r1 (by simpa [iso] using r2)
      simpa [iso, renC_size] using this
  | @while_false b c σ hb =>
      intro σ' hinv _
      refine ⟨σ', 1 + b.size, ?_, by omega, hinv, Frame.refl I σ'⟩
      have := BigStepB.while_false (c := iso I c)
        (show (renC I.ren b).evalB B σ' = some false by rw [evalB_renC hinv.agree]; exact hb)
      simpa [iso, renC_size] using this
  | @read σ x v rest hin =>
      intro σ' hinv _
      obtain ⟨junk, hjunk⟩ := hinv.tape
      set p := σ'.vars I.pin with hpdef
      set T := σ'.arrs I.tin with hTdef
      rw [hin] at hjunk
      have hTp : T[p]? = some v := by
        have := congrArg List.head? hjunk
        simpa [List.head?_drop] using this
      have hplen : p < T.length := by
        by_contra hc
        have : T.drop p = [] := List.drop_eq_nil_of_le (by omega)
        rw [this] at hjunk; simp at hjunk
      have hvB : v < B := hinv.tinVal v (List.mem_of_getElem? hTp)
      have hB : T.length < B := hinv.tinLen
      let σ1 := σ'.setVar (I.ren x) v
      have e1 : (Expr.get I.tin (.var I.pin)).evalB B σ' = some v := by
        simp [Expr.evalB, ← hpdef, ← hTdef, fit, hTp, hvB, show p < B by omega]
      have r1 := BigStepB.assign (x := I.ren x) e1
      have hp1 : σ1.vars I.pin = p := by
        simp [σ1, Env.setVar, (hI.pin x).symm, hpdef]
      have e2 : (Expr.bin .add (.var I.pin) (.lit 1)).evalB B σ1 = some (p+1) := by
        simp [Expr.evalB, hp1, fit, show p < B by omega, show 1 < B by omega,
          show p + 1 < B by omega]
      have r2 := BigStepB.assign (x := I.pin) e2
      refine ⟨σ1.setVar I.pin (p+1), _, .seq r1 r2, ?_, ?_, ?_⟩
      · simp [Expr.size]
      · have hag : Agree I { σ.setVar x v with inp := rest } (σ1.setVar I.pin (p+1)) :=
          agree_aux_var hI (agree_setVar hI hinv.agree x v) I.pin hI.pin (p+1)
        have hq : I.ren x ≠ I.pout := hI.pout x
        have hpq := hI.pin_pout
        have hrt : I.ren x ≠ I.tin := hI.tin x
        refine ⟨hag, ⟨junk, ?_⟩, ?_, ?_, ?_, ?_, ?_, ?_, hinv.LoutB, ?_⟩
        · have hd : T.drop (p+1) = rest ++ junk := by
            rw [← List.drop_drop, hjunk]; simp
          simpa [σ1, Env.setVar, ← hTdef] using hd
        · simpa [σ1, Env.setVar] using hinv.tinLen
        · simpa [σ1, Env.setVar] using hinv.tinVal
        · intro hr; simpa [σ1, Env.setVar] using hinv.outReal hr
        · intro hr; simpa [σ1, Env.setVar, hq.symm, hpq.symm, Env.setVar] using hinv.outPtr hr
        · intro hr; simpa [σ1, Env.setVar, hq.symm, hpq.symm] using hinv.outArr hr
        · intro hr; simpa [σ1, Env.setVar] using hinv.outLen hr
        · intro hr; simpa [σ1, Env.setVar, hq.symm, hpq.symm] using hinv.outRest hr
      · refine ⟨rfl, fun _ => rfl, fun z hz hzp _ => ?_, fun _ _ _ => rfl⟩
        simp [σ1, Env.setVar, hz x, hzp]
  | @write σ e v he =>
      intro σ' hinv hfit
      have he' : (renE I.ren e).evalB B σ' = some v := by
        rw [evalB_renE hinv.agree]; exact he
      cases hred : I.redirect with
      | false =>
          refine ⟨{ σ' with out := σ'.out ++ [v] }, 1 + e.size, ?_, by omega, ?_, ?_⟩
          · have := BigStepB.write (B := B) he'
            simpa [iso, hred, renE_size] using this
          · refine ⟨hinv.agree, hinv.tape, hinv.tinLen, hinv.tinVal, fun _ => ?_,
              fun h => by simp [hred] at h, fun h => by simp [hred] at h,
              fun h => by simp [hred] at h, fun h => by simp [hred] at h,
              fun h => by simp [hred] at h⟩
            simp [hinv.outReal hred]
          · exact ⟨rfl, fun h => by simp [hred] at h, fun _ _ _ _ => rfl, fun _ _ _ => rfl⟩
      | true =>
          set p := σ'.vars I.pout with hpdef
          have hp : p = o0.length + σ.out.length := hinv.outPtr hred
          have hfit' := hfit hred
          simp at hfit'
          have hlen := hinv.outLen hred
          have hLB := hinv.LoutB hred
          have hpl : p < (σ'.arrs I.tout).length := by omega
          have r1 := BigStepB.store (B := B) (a := I.tout)
            (show (Expr.var I.pout).evalB B σ' = some p by
              simp [Expr.evalB, fit, ← hpdef]; omega) he' hpl
          let σ1 := σ'.setArr I.tout p v
          have hp1 : σ1.vars I.pout = p := by simp [σ1, Env.setArr, hpdef]
          have hB1 : p + 1 < B := by omega
          have e2 : (Expr.bin .add (.var I.pout) (.lit 1)).evalB B σ1 = some (p+1) := by
            simp only [Expr.evalB, hp1]
            simp [fit, hB1, show p < B by omega, show 1 < B by omega]
          have r2 := BigStepB.assign (x := I.pout) e2
          have r : BigStepB B (iso I (.write e)) σ' (σ1.setVar I.pout (p+1))
              (1 + (Expr.var I.pout).size + (renE I.ren e).size +
                (1 + (Expr.bin Bop.add (Expr.var I.pout) (Expr.lit 1)).size)) := by
            simp only [iso, hred, if_true]
            exact .seq r1 r2
          refine ⟨σ1.setVar I.pout (p+1), _, r, ?_, ?_, ?_⟩
          · simp [Expr.size, renE_size]; omega
          · have hag : Agree I { σ with out := σ.out ++ [v] } (σ1.setVar I.pout (p+1)) :=
              agree_aux_var hI (agree_aux_arr hI hinv.agree I.tout hI.tout p v) I.pout hI.pout (p+1)
            have hpq := hI.pin_pout
            have htt := hI.tin_tout
            refine ⟨hag, ?_, ?_, ?_, fun h => by simp [hred] at h, ?_, ?_, ?_, fun _ => hLB, ?_⟩
            · obtain ⟨junk, hj⟩ := hinv.tape
              exact ⟨junk, by simpa [σ1, Env.setVar, Env.setArr, hpq, htt] using hj⟩
            · simpa [σ1, Env.setVar, Env.setArr, htt] using hinv.tinLen
            · simpa [σ1, Env.setVar, Env.setArr, htt] using hinv.tinVal
            · intro _; simp [σ1, Env.setVar, Env.setArr]; omega
            · intro _
              have ha := hinv.outArr hred
              simp only [σ1, Env.setVar, Env.setArr, if_true]
              rw [take_set_succ _ _ _ hpl, hpdef, ha, List.append_assoc]
            · intro _; simp [σ1, Env.setVar, Env.setArr, hlen]
            · intro _
              have hr := hinv.outRest hred
              simp only [σ1, Env.setVar, Env.setArr, if_true]
              rw [drop_set_succ, ← List.drop_drop, hpdef, hr, List.drop_drop]
          · refine ⟨rfl, fun _ => rfl, fun z _ _ hzo => ?_, fun z _ hzt => ?_⟩
            · simp [σ1, Env.setVar, Env.setArr, hzo]
            · simp [σ1, Env.setVar, Env.setArr, hzt]
end
theorem iso_run {I : Iso} (hI : Fresh I) {W : Nat} {c : Com} {ext : String → Nat}
    {input : List Nat} {τ : Env} {T : Nat} (h : Run W c (initEnv ext input) τ T)
    (σ' : Env) (o0 R : List Nat)
    (hv : ∀ x, σ'.vars (I.ren x) = 0)
    (ha : ∀ a, σ'.arrs (I.ren a) = List.replicate (ext a) 0)
    (hpin : σ'.vars I.pin = 0) (htape : ∃ junk, σ'.arrs I.tin = input ++ junk)
    (htinLen : (σ'.arrs I.tin).length < W) (htinVal : ∀ v ∈ σ'.arrs I.tin, v < W)
    (hreal : I.redirect = false → σ'.out = o0)
    (hptr : I.redirect = true → σ'.vars I.pout = o0.length)
    (harr : I.redirect = true → (σ'.arrs I.tout).take o0.length = o0)
    (hlen : I.redirect = true → (σ'.arrs I.tout).length = R.length)
    (hRB : I.redirect = true → R.length < W)
    (hrest : I.redirect = true → (σ'.arrs I.tout).drop o0.length = R.drop o0.length)
    (hfit : I.redirect = true → o0.length + τ.out.length ≤ R.length) :
    ∃ τ', Run W (iso I c) σ' τ' (7*T) ∧ Inv I W o0 R τ τ' ∧ Frame I σ' τ' := by
  obtain ⟨k, hk, hb⟩ := h
  have hinv : Inv I W o0 R (initEnv ext input) σ' := by
    refine ⟨⟨fun x => by simp [initEnv, hv x], fun a => by simp [initEnv, ha a]⟩,
      ?_, htinLen, htinVal, fun hr => by simp [initEnv, hreal hr],
      fun hr => by simp [initEnv, hptr hr], fun hr => by simp [initEnv, hptr hr, harr hr],
      hlen, hRB, fun hr => by rw [hptr hr]; exact hrest hr⟩
    obtain ⟨junk, hj⟩ := htape
    exact ⟨junk, by simp [initEnv, hpin, hj]⟩
  obtain ⟨τ', k', hb', hk', hinv', hf⟩ := sim hI hb o0 R σ' hinv hfit
  exact ⟨τ', ⟨k', by omega, hb'⟩, hinv', hf⟩
end Mathproof.Problem18P37Isolation20261004
