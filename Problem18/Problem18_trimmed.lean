    ∃ p : Polynomial K⟮t⟯, p ≠ 0 ∧ Polynomial.aeval y p = 0 ∧
      p.natDegree ≤ s.totalDegree := by
  let E := K⟮t⟯
  let t₀ : E := ⟨t, mem_adjoin_simple_self K t⟩
  have ht₀ : Transcendental K t₀ := by
    intro ha
    exact ht (ha.algHom E.val)
  let ψ : Polynomial K →+* E := (Polynomial.aeval t₀).toRingHom
  let p := Polynomial.map ψ (asPolynomial s)
  have hp : p ≠ 0 := by
    apply (Polynomial.map_ne_zero_iff (transcendental_iff_injective.mp ht₀)).mpr
    intro hzero
    apply hs
    apply (asPolynomial (K := K)).injective
    simpa only [map_zero] using hzero
  have hc : (algebraMap E F).comp ψ = (Polynomial.aeval t).toRingHom := by
    have h : E.val.comp (Polynomial.aeval t₀) = Polynomial.aeval t := by
      ext
      simp [t₀]
    exact congrArg AlgHom.toRingHom h
  refine ⟨p, hp, ?_, Polynomial.natDegree_map_le.trans (asPolynomial_degree_le s)⟩
  change p.eval₂ (algebraMap E F) y = 0
  rw [Polynomial.eval₂_map, hc]
  exact (asPolynomial_eval s t y).trans he
