variable {N : Nat} {K L : Type*} [Field K] [Field L] [Algebra K L]
  [IsAlgClosed L] [Algebra.IsAlgebraic K L]
theorem finite_geometric_quotient_uniform_finrank
    (F : Finset (MvPolynomial (Fin N) K)) (d : Nat)
    (hF : ∀ f ∈ F, f.totalDegree ≤ d)
    (hfinite : (zeroLocus L (generatedIdeal (F : Set (MvPolynomial (Fin N) K)))).Finite) :
    Module.finrank K ((MvPolynomial (Fin N) K) ⧸ generatedIdeal (F : Set (MvPolynomial (Fin N) K))) ≤
      (d*2^(controlledDepth N d))^N := by
  classical
  obtain ⟨G,hG,hdeg⟩ := exists_uniform_bounded_groebner F d hF
  letI := finiteDimensional_of_finite_geometric_locus (generatedIdeal (F : Set (MvPolynomial (Fin N) K))) hfinite
  have hpure := pure_power_leaders_of_finiteDimensional degLex
    (generatedIdeal (F : Set (MvPolynomial (Fin N) K))) (G : Set (MvPolynomial (Fin N) K)) hG
  choose g hg hg0 e he using hpure
  have heBound : ∀ i, e i ≤ d*2^(controlledDepth N d) := by
    intro i
    have heq : e i = (g i).totalDegree := by
      rw [← degree_degLexDegree, he i, Finsupp.degree_single]
    rw [heq]
    exact hdeg (g i) (hg i)
  have hmem : ∀ i, g i ∈ generatedIdeal (F : Set (MvPolynomial (Fin N) K)) := by
    intro i
    rw [← hG.2]
    exact Ideal.subset_span (hg i)
  have hu : ∀ i, IsUnit (degLex.leadingCoeff (g i)) := fun i =>
    isUnit_iff_ne_zero.mpr (degLex.leadingCoeff_ne_zero_iff.mpr (hg0 i))
  calc
    _ ≤ ∏ i, e i := quotient_finrank_le_box degLex g _ e hu he hmem
    _ ≤ ∏ i : Fin N, d*2^(controlledDepth N d) :=
      Finset.prod_le_prod' (fun i _ => heBound i)
    _ = _ := by simp
end Mathproof.Problem18BoundedGeometricDimension20260930
