variable {K M M' ι : Type*} [Field K] [DecidableEq K] [AddCommGroup M] [Module K M]
  [AddCommGroup M'] [Module K M']
theorem eliminate_natural (p' : M' →ₗ[K] (ι → K)) (π : M →ₗ[K] M') (i : ι) (v y : M) :
    π (eliminate (p'.comp π) i v y) = eliminate p' i (π v) (π y) := by
  simp only [eliminate_apply, map_sub, map_smul, LinearMap.comp_apply]
theorem pivot_natural (coords : List ι) (p' : M' →ₗ[K] (ι → K)) (π : M →ₗ[K] M') (v : M) :
    pivot coords (p'.comp π) v = pivot coords p' (π v) := rfl
theorem reduce_natural (coords : List ι) (p' : M' →ₗ[K] (ι → K)) (π : M →ₗ[K] M') :
    ∀ (vs : List M) (x : M),
      π (reduce coords (p'.comp π) vs x) = reduce coords p' (vs.map π) (π x)
  | [], x => by simp [reduce]
  | v :: vs, x => by
    cases h : pivot coords p' (π v) with
    | none =>
      have h' : pivot coords (p'.comp π) v = none := (pivot_natural coords p' π v).trans h
      simp only [reduce, h, h', List.map_cons]
      exact reduce_natural coords p' π vs x
    | some i =>
      have h' : pivot coords (p'.comp π) v = some i := (pivot_natural coords p' π v).trans h
      simp only [reduce, h, h', List.map_cons, LinearMap.comp_apply]
      have hl : (vs.map (eliminate (p'.comp π) i v)).map π = (vs.map π).map (eliminate p' i (π v)) := by
        rw [List.map_map, List.map_map]
        exact List.map_congr_left (fun w _ => eliminate_natural p' π i v w)
      rw [reduce_natural coords p' π (vs.map (eliminate (p'.comp π) i v)), hl, eliminate_natural]
termination_by vs => vs.length
end natural
variable {K : Type} [Field K] [Fintype K] [DecidableEq K]
theorem map_finRange_getElem {α β : Type*} (l : List α) (f : α → β) :
    (List.finRange l.length).map (fun j => f l[j.val]) = l.map f := by
  apply List.ext_getElem
  · simp
  · intro n h1 h2
    simp
theorem spanCheck_fst_eq {c : ℕ} (rs : List (Vector K c)) (x : Vector K c) :
    (spanCheck rs x).1 = decide (observe (Fin.castAdd rs.length)
      (read (reduceArray (List.finRange c) (Fin.castAdd rs.length) (rows (rowFamily rs))
        (query (read x))).1) = 0) := by
  have ho : (observe (K := K) (Fin.castAdd rs.length) :
      (Fin (c + rs.length) → K) →ₗ[K] (Fin c → K)) =
      (observe (K := K) (id : Fin c → Fin c)).comp (observe (Fin.castAdd rs.length)) := by
    ext; rfl
  have hid : (observe (K := K) (id : Fin c → Fin c)) = LinearMap.id := by ext; rfl
  have hrows : ((rows (rowFamily rs)).map read).map (observe (K := K) (Fin.castAdd rs.length)) =
      rs.map read := by
    simp only [rows, List.map_map, Function.comp_def, augmented_prefix]
    exact map_finRange_getElem rs read
  have key := reduce_natural (List.finRange c) (observe (K := K) (id : Fin c → Fin c))
    (observe (Fin.castAdd rs.length)) ((rows (rowFamily rs)).map read) (read (query (read x)))
  rw [← ho] at key
  simp only [spanCheck, reduceArray_read]
  congr 2
  rw [key, hrows, query_prefix]
theorem restRows_augmented {c : ℕ} (g : ℕ → K) (rs : List (Vector K c))
    (hrow : ∀ u (hu : u < rs.length) (k : Fin c),
      g (rowStart (c + rs.length) u + k.val) = read rs[u] k)
    (hid : ∀ u < rs.length, ∀ b < rs.length,
      g (rowStart (c + rs.length) u + c + b) = if u = b then (1 : K) else 0) :
    restRows g (c + rs.length) rs.length 0 = (rows (rowFamily rs)).map read := by
  rw [restRows_zero]
  apply List.ext_getElem
  · simp [rows]
  · intro t h1 h2
    simp only [List.length_map, List.length_range] at h1
    simp only [List.getElem_map, List.getElem_range, rows, List.getElem_finRange]
    funext j
    refine Fin.addCases (fun i => ?_) (fun b => ?_) j
    · simp only [rowVec, augmented, read_ofFn, Fin.addCases_left, Fin.coe_castAdd, rowFamily]
      rw [hrow t h1 i]
      rfl
    · simp only [rowVec, augmented, read_ofFn, Fin.addCases_right, Fin.coe_natAdd]
      rw [← Nat.add_assoc, hid t h1 b.val b.isLt, Pi.single_apply]
      by_cases htb : t = b.val
      · rw [if_pos htb, if_pos (Fin.ext (by simp [htb]))]
      · rw [if_neg htb, if_neg (fun h => htb (by rw [h]; rfl))]
theorem rowVec_query {c m : ℕ} (g : ℕ → K) (x : Vector K c)
    (hx : ∀ k : Fin c, g (5 + k.val) = read x k) (hz : ∀ b < m, g (5 + c + b) = 0) :
    rowVec g 5 (c + m) = read (query (m := m) (read x)) := by
  funext j
  refine Fin.addCases (fun i => ?_) (fun b => ?_) j
  · simp only [rowVec, query, read_ofFn, Fin.addCases_left, Fin.coe_castAdd]
    exact hx i
  · simp only [rowVec, query, read_ofFn, Fin.addCases_right, Fin.coe_natAdd, Pi.zero_apply]
    rw [← Nat.add_assoc]; exact hz b.val b.isLt
theorem castLE_eq_castAdd (c m : ℕ) (h : c ≤ c + m) :
    (Fin.castLE h : Fin c → Fin (c + m)) = Fin.castAdd m := by
  funext i; rfl
theorem arrayCertificate_coefficients_read {c : ℕ} (rs : List (Vector K c)) (x : Vector K c)
    (j : Fin rs.length) :
    read (arrayCertificate rs x).coefficients j =
      -(reduce (List.finRange c) (observe (Fin.castAdd rs.length)) ((rows (rowFamily rs)).map read)
        (read (query (m := rs.length) (read x)))) (j.natAdd c) := by
  simp only [arrayCertificate, read_ofFn, reduceArray_read]
theorem arrayCertificate_member_eq {c : ℕ} (rs : List (Vector K c)) (x : Vector K c) :
    (arrayCertificate rs x).member = decide (observe (Fin.castAdd rs.length)
      (reduce (List.finRange c) (observe (Fin.castAdd rs.length)) ((rows (rowFamily rs)).map read)
        (read (query (m := rs.length) (read x)))) = 0) := by
  simp only [arrayCertificate]
  rw [spanCheck_fst_eq, reduceArray_read]
