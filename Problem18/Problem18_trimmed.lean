variable {V : Type*} [AddCommGroup V] [Module K V]
theorem aeval_kernel_le_of_dvd (S : Module.End K V) {p r : K[X]} (h : p ∣ r) :
    LinearMap.ker (aeval S p) ≤ LinearMap.ker (aeval S r) := by
  rintro x hx
  obtain ⟨s,rfl⟩ := h
  change (aeval S (p*s)) x=0
  rw [mul_comm,aeval_mul,Module.End.mul_apply,LinearMap.mem_ker.mp hx,map_zero]
