    · intro i _
      exact (hi i).squarefree
  have hq : 2≤q := by dsimp only [q]; exact_mod_cast (Finite.one_lt_card (α:=K))
  have hq0 : 0<q := by linarith
  have hq1 : 1≤q := by linarith
  have herr : |((Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) B //
      p∣S.val.charpoly ∧ IsCoprime p (S.val.charpoly/p)}:ℝ)/
      Nat.card (SelfAdjointOperators (RingEquiv.refl K) B))*q^d-1|≤64/q^(c/4)+20*Nat.card ι/q^D := by
    by_cases ho : ringChar K ≠ 2
