variable {K V : Type*} [Field K] [Fintype K]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
noncomputable def factorSet (f : K[X]) : Finset K[X] := by
  classical
  exact (normalizedFactors f).toFinset
abbrev FactorIndex (f : K[X]) := {p // p ∈ factorSet f}
instance (f : K[X]) : Fintype (FactorIndex f) := by
  classical
  exact Finset.fintypeCoeSort (factorSet f)
theorem factor_monic (f : K[X]) (p : FactorIndex f) : p.val.Monic := by
  classical
  have hp : p.val ∈ normalizedFactors f := Multiset.mem_toFinset.mp p.property
  exact (Polynomial.normalize_eq_self_iff_monic
    (irreducible_of_normalized_factor p.val hp).ne_zero).mp
    (normalize_normalized_factor p.val hp)
theorem factor_irreducible (f : K[X]) (p : FactorIndex f) : Irreducible p.val := by
  classical
  exact irreducible_of_normalized_factor p.val (Multiset.mem_toFinset.mp p.property)
theorem factor_product (f : K[X]) (hm : f.Monic) (hs : Squarefree f) :
    f=∏ p : FactorIndex f,p.val := by
  classical
  change f=∏ p : (factorSet f), (p : K[X])
  rw [Finset.prod_coe_sort (f := fun p : K[X] => p)]
  have hn := (squarefree_iff_nodup_normalizedFactors hm.ne_zero).mp hs
  change f=(factorSet f).prod id
  rw [← Finset.prod_val]
  rw [factorSet,Multiset.toFinset_val,Multiset.dedup_eq_self.mpr hn,
    prod_normalizedFactors_eq hm.ne_zero,hm.normalize_eq_self]
theorem squarefree_trace_form (S : Module.End K V)
    (B : LinearMap.BilinForm K V) (hB : B.IsRefl) (hnd : B.Nondegenerate)
    (hS : Mathproof.Meta.Problem18SpectralBlocks20260930.IsSelfAdjointFor B S)
    (hs : Squarefree S.charpoly) :
    ∃ (E : (∀ p : FactorIndex S.charpoly,AdjoinRoot p.val) ≃ₗ[K] V)
      (c : ∀ p : FactorIndex S.charpoly,AdjoinRoot p.val),
      (∀ p,c p≠0) ∧
      (∀ x,E (fun p => AdjoinRoot.root p.val*x p)=S (E x)) ∧
      ∀ x y,B (E x) (E y)=∑ p,Algebra.trace K (AdjoinRoot p.val) (c p*x p*y p) := by
  classical
  exact exists_simultaneous_primary_trace_form S (fun p : FactorIndex S.charpoly => p.val)
    B hB hnd hS (factor_monic S.charpoly) (factor_irreducible S.charpoly)
    (factor_product S.charpoly S.charpoly_monic hs) hs
end Mathproof.Problem18BoundaryNormalizedFactors20260930
end
