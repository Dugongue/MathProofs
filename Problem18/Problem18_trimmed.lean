attribute [-instance] FunLike.toDecidableEq CommSemiRingCat.FilteredColimits.colimitCommSemiring AddMonoidAlgebra.instHopfAlgebraStruct AddMonoidAlgebra.instBialgebra Bialgebra.toAlgebra
namespace Mathproof.Problem18EliminationKernelWitness20261001
open scoped BigOperators
open Matrix Problem18EliminationCoordinates20260929 Problem18ArrayElimination20260929
variable {K : Type*} [Field K] [DecidableEq K] {n m : ℕ}
def columns (A : Matrix (Fin n) (Fin m) K) (j i : Fin m) : Fin (n+1)→K :=
  Fin.addCases (fun r=>A r i) (fun _ : Fin 1=>if i=j then 1 else 0)
def target : Fin (n+1)→K := Fin.addCases 0 (fun _ : Fin 1=>1)
def test (A : Matrix (Fin n) (Fin m) K) (j : Fin m) : Bool :=
  (spanCheck ((List.finRange m).map (fun i=>Vector.ofFn (columns A j i)))
    (Vector.ofFn target)).1
def candidate (A : Matrix (Fin n) (Fin m) K) (j : Fin m) : Fin m→K :=
  read (coordinates (columns A j) target)
theorem test_iff (A : Matrix (Fin n) (Fin m) K) (j : Fin m) :
    test A j=true ↔ target∈Submodule.span K (Set.range (columns A j)) := by
  rw [test,spanCheck_iff]
  simp only [read_ofFn,Problem18Elimination20260929.rowSpan,List.map_map,Function.comp_def]
  have he : {v | v∈(List.finRange m).map (columns A j)}=Set.range (columns A j) := by
    ext y
    simp
  rw [he]
theorem constraints_sum (A : Matrix (Fin n) (Fin m) K) (j : Fin m) (x : Fin m→K) :
    ∑i,x i • columns A j i=target ↔ A.mulVec x=0 ∧ x j=1 := by
  constructor
  · intro h
    constructor
    · funext r
      have he:=congrArg (fun v=>v (Fin.castAdd 1 r)) h
      simpa [columns,target,Matrix.mulVec,dotProduct,mul_comm] using he
    · have he:=congrArg (fun v=>v (Fin.natAdd n (0:Fin 1))) h
      simpa [columns,target] using he
  · rintro ⟨hA,hj⟩
    funext r
    refine Fin.addCases ?_ ?_ r
    · intro r
      have he:=congrFun hA r
      simpa [columns,target,Matrix.mulVec,dotProduct,mul_comm] using he
    · intro r
      simp [columns,target,hj]
theorem candidate_correct (A : Matrix (Fin n) (Fin m) K) (j : Fin m)
    (h : test A j=true) : A.mulVec (candidate A j)=0 ∧ candidate A j j=1 :=
  (constraints_sum A j _).mp (coordinates_solution _ _ ((test_iff A j).mp h))
theorem test_complete (A : Matrix (Fin n) (Fin m) K) (j : Fin m) (x : Fin m→K)
    (hA : A.mulVec x=0) (hj : x j=1) : test A j=true := by
  apply (test_iff A j).mpr
  rw [←(constraints_sum A j x).mpr ⟨hA,hj⟩]
  exact Submodule.sum_mem _ (fun i _=>Submodule.smul_mem _ _ (Submodule.subset_span ⟨i,rfl⟩))
def witness (A : Matrix (Fin n) (Fin m) K) : Option (Fin m→K) :=
  ((List.finRange m).find? (test A)).map (candidate A)
theorem witness_some (A : Matrix (Fin n) (Fin m) K) (x : Fin m→K)
    (h : witness A=some x) : x≠0 ∧ A.mulVec x=0 := by
  obtain ⟨j,hj,hx⟩:=Option.map_eq_some_iff.mp h
  have hc:=candidate_correct A j (List.find?_some hj)
  subst x
  refine ⟨?_,hc.1⟩
  intro hz
  have he:=congrFun hz j
  rw [hc.2] at he
  exact one_ne_zero he
theorem witness_exists (A : Matrix (Fin n) (Fin m) K) (x : Fin m→K)
    (hx : x≠0) (hA : A.mulVec x=0) : ∃y,witness A=some y := by
  have hj : ∃j,x j≠0 := by
    by_contra h
    apply hx
    funext j
    simpa using not_exists.mp h j
  obtain ⟨j,hj⟩:=hj
  have hn : A.mulVec ((x j)⁻¹ • x)=0 := by rw [Matrix.mulVec_smul,hA,smul_zero]
  have hv : ((x j)⁻¹ • x) j=1 := by simp [hj]
  have ht:=test_complete A j ((x j)⁻¹ • x) hn hv
  cases hf : (List.finRange m).find? (test A) with
  | none =>
    have hh:=List.find?_eq_none.mp hf j (List.mem_finRange j)
    simp [ht] at hh
  | some k => exact ⟨candidate A k,by simp [witness,hf]⟩
theorem witness_none_iff (A : Matrix (Fin n) (Fin m) K) :
    witness A=none ↔ ∀x,A.mulVec x=0 → x=0 := by
  constructor
  · intro hn x hx
    by_contra hz
    obtain ⟨y,hy⟩:=witness_exists A x hz hx
    rw [hn] at hy
    contradiction
  · intro h
    cases hw : witness A with
    | none => rfl
    | some x => exact False.elim ((witness_some A x hw).1 (h x (witness_some A x hw).2))
end Mathproof.Problem18EliminationKernelWitness20261001
