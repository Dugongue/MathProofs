    rw [IntermediateField.adjoin_le_iff]
    intro a ha
    rcases ha with rfl | rfl
    · exact hx
    · exact hy
  have hFu : ∀ a ∈ F, a ∈ IntermediateField.adjoin F ({u} : Set Ω) := fun a ha =>
    IntermediateField.algebraMap_mem (IntermediateField.adjoin F ({u} : Set Ω)) ⟨a, ha⟩
  have huF : ∀ a ∈ F, a ≠ u := by
    rintro a ha rfl
    exact hu (isAlgebraic_algebraMap (⟨a, ha⟩ : F))
  have hux : u ∉ ({x, y} : Set Ω) := by
    rintro (h | h)
    · exact huF x hx h.symm
    · exact huF y hy h.symm
  have h3 : AlgebraicIndepOn k id ({u, x, y} : Set Ω) := by
    refine algebraicIndepOn_insert_of_transcendental h2 ?_
    intro halg
    exact hu (isAlgebraic_of_le hle1 halg)
  have hle2 : IntermediateField.adjoin k ({u, x, y} : Set Ω) ≤
      (IntermediateField.adjoin F ({u} : Set Ω)).restrictScalars k := by
    rw [IntermediateField.adjoin_le_iff]
    intro a ha
    rcases ha with rfl | rfl | rfl
    · exact IntermediateField.mem_adjoin_simple_self F a
    · exact hFu a hx
    · exact hFu a hy
  have hvU : ∀ a ∈ IntermediateField.adjoin F ({u} : Set Ω), a ≠ v := by
    rintro a ha rfl
    exact hv (isAlgebraic_algebraMap (⟨a, ha⟩ : IntermediateField.adjoin F ({u} : Set Ω)))
  have hvx : v ∉ ({u, x, y} : Set Ω) := by
    rintro (h | h | h)
    · exact hvU u (IntermediateField.mem_adjoin_simple_self F u) h.symm
    · exact hvU x (hFu x hx) h.symm
    · exact hvU y (hFu y hy) h.symm
  have h4 : AlgebraicIndepOn k id ({v, u, x, y} : Set Ω) := by
    refine algebraicIndepOn_insert_of_transcendental h3 ?_
    intro halg
    exact hv (isAlgebraic_of_le hle2 halg)
  exact ⟨h4, hvx, hux, hne⟩
theorem encard_three {u x y : Ω} (hux : u ∉ ({x, y} : Set Ω)) (hne : x ≠ y) :
    ({u, x, y} : Set Ω).encard = 3 := by
  rw [Set.encard_insert_of_notMem hux, Set.encard_pair hne]
  rfl
theorem encard_four {v u x y : Ω} (hvx : v ∉ ({u, x, y} : Set Ω)) (hux : u ∉ ({x, y} : Set Ω))
    (hne : x ≠ y) : ({v, u, x, y} : Set Ω).encard = 4 := by
  rw [Set.encard_insert_of_notMem hvx, encard_three hux hne]
  rfl
theorem encard_pair_le (a b : Ω) : ({a, b} : Set Ω).encard ≤ 2 := by
  refine (Set.encard_insert_le _ _).trans ?_
  rw [Set.encard_singleton]
  rfl
theorem encard_triple_le (a b c : Ω) : ({a, b, c} : Set Ω).encard ≤ 3 := by
  refine (Set.encard_insert_le _ _).trans ?_
  calc ({b, c} : Set Ω).encard + 1 ≤ 2 + 1 := add_le_add (encard_pair_le b c) le_rfl
    _ = 3 := rfl
theorem not_mem_adjoin_y {x y u : Ω} (h3 : AlgebraicIndepOn k id ({u, x, y} : Set Ω))
    (hux : u ∉ ({x, y} : Set Ω)) (hne : x ≠ y) :
    y ∉ IntermediateField.adjoin k ({u, x + u * y} : Set Ω) := by
  intro hyE
  have huE : u ∈ IntermediateField.adjoin k ({u, x + u * y} : Set Ω) :=
    IntermediateField.subset_adjoin k _ (Set.mem_insert _ _)
  have htE : x + u * y ∈ IntermediateField.adjoin k ({u, x + u * y} : Set Ω) :=
    IntermediateField.subset_adjoin k _ (Set.mem_insert_of_mem _ rfl)
  have hxE : x ∈ IntermediateField.adjoin k ({u, x + u * y} : Set Ω) := by
    have h := sub_mem htE (mul_mem huE hyE)
    rwa [add_sub_cancel_right] at h
  refine false_of_subset_closure (X := ({u, x + u * y} : Set Ω)) h3 ?_ ?_
  · rw [encard_three hux hne]
    exact lt_of_le_of_lt (encard_pair_le _ _) (by norm_num)
  · intro a ha
    rcases ha with rfl | rfl | rfl
    · exact mem_closure_of_mem_adjoin huE
    · exact mem_closure_of_mem_adjoin hxE
    · exact mem_closure_of_mem_adjoin hyE
theorem indep_u_t {x y u : Ω} (h3 : AlgebraicIndepOn k id ({u, x, y} : Set Ω))
    (hux : u ∉ ({x, y} : Set Ω)) (hne : x ≠ y) :
    AlgebraicIndependent k ![u, x + u * y] := by
  have hcl : x + u * y ∉ (AlgebraicIndependent.matroid k Ω).closure {u} := by
    intro htc
    have htc' : x + u * y ∈ (AlgebraicIndependent.matroid k Ω).closure {u, y} :=
      (AlgebraicIndependent.matroid k Ω).closure_subset_closure
        (Set.singleton_subset_iff.mpr (Set.mem_insert u {y})) htc
    have hxa : x ∈ IntermediateField.adjoin k ({x + u * y, u, y} : Set Ω) := by
      have h := sub_mem
        (IntermediateField.subset_adjoin k ({x + u * y, u, y} : Set Ω) (Set.mem_insert _ _))
        (mul_mem
          (IntermediateField.subset_adjoin k ({x + u * y, u, y} : Set Ω)
            (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))
          (IntermediateField.subset_adjoin k ({x + u * y, u, y} : Set Ω)
            (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))))
      rwa [add_sub_cancel_right] at h
    have hxc : x ∈ (AlgebraicIndependent.matroid k Ω).closure {u, y} := by
      have := mem_closure_of_mem_adjoin hxa
      rwa [Matroid.closure_insert_eq_of_mem_closure htc'] at this
    refine false_of_subset_closure (X := ({u, y} : Set Ω)) h3 ?_ ?_
    · rw [encard_three hux hne]
      exact lt_of_le_of_lt (encard_pair_le _ _) (by norm_num)
    · intro a ha
      rcases ha with rfl | rfl | rfl
      · exact subset_matroid_closure _ (Set.mem_insert _ _)
      · exact hxc
      · exact subset_matroid_closure _ (Set.mem_insert_of_mem _ rfl)
  have hne' : u ≠ x + u * y := by
    intro h
    apply hcl
    rw [← h]
    exact subset_matroid_closure _ rfl
  have h1 : AlgebraicIndepOn k id ({u} : Set Ω) :=
    (show (AlgebraicIndependent.matroid k Ω).Indep _ from h3).subset
      (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))
  have h2 : AlgebraicIndepOn k id ({x + u * y, u} : Set Ω) := by
    refine algebraicIndepOn_insert_of_transcendental h1 ?_
    intro halg
    exact hcl ((mem_matroid_closure_iff _ _).mpr halg)
  let f : Fin 2 → ({x + u * y, u} : Set Ω) :=
    ![⟨u, Set.mem_insert_of_mem _ rfl⟩, ⟨x + u * y, Set.mem_insert _ _⟩]
  have hf : Function.Injective f := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [f, Subtype.ext_iff, hne', hne'.symm]
  have h5 := (show AlgebraicIndependent k (Subtype.val : ({x + u * y, u} : Set Ω) → Ω) from h2).comp f hf
  convert h5 using 1
  ext i
  fin_cases i <;> rfl
theorem transcendental_s {x y u v : Ω} (h4 : AlgebraicIndepOn k id ({v, u, x, y} : Set Ω))
    (hcard : ({v, u, x, y} : Set Ω).encard = 4) (M : IntermediateField k Ω)
    (hM : ∀ m ∈ M, m ∈ (AlgebraicIndependent.matroid k Ω).closure {u, x + u * y})
    (hu0 : u ≠ 0) (huv : u ≠ v) :
    Transcendental (IntermediateField.adjoin k ((M : Set Ω) ∪ {v})) (x + v * y) := by
  intro halg
  set X : Set Ω := {u, x + u * y, v} with hX
  set C := (AlgebraicIndependent.matroid k Ω).closure X with hC
  have hXC : X ⊆ C := subset_matroid_closure X
  have hMC : (M : Set Ω) ∪ {v} ⊆ C := by
    intro a ha
    rcases ha with ha | ha
    · refine (AlgebraicIndependent.matroid k Ω).closure_subset_closure ?_ (hM a ha)
      intro b hb
      rcases hb with rfl | rfl
      · exact Set.mem_insert _ _
      · exact Set.mem_insert_of_mem _ (Set.mem_insert _ _)
    · rw [Set.mem_singleton_iff.mp ha]
      exact hXC (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))
  have hLC : ((IntermediateField.adjoin k ((M : Set Ω) ∪ {v}) : IntermediateField k Ω) :
      Set Ω) ⊆ C := by
    intro a ha
    have := mem_closure_of_mem_adjoin ha
    exact closure_le_of_subset hMC this
  have hsC : x + v * y ∈ C := by
    have h1 : x + v * y ∈ (AlgebraicIndependent.matroid k Ω).closure
        ((IntermediateField.adjoin k ((M : Set Ω) ∪ {v}) : IntermediateField k Ω) : Set Ω) := by
      rw [mem_matroid_closure_iff, IntermediateField.adjoin_self]
      exact halg
    exact closure_le_of_subset hLC h1
  have hden : (1 : Ω) - v / u ≠ 0 := by
    intro h
    apply huv
    have : v / u = 1 := by linear_combination -h
    rw [div_eq_one_iff_eq hu0] at this
    exact this.symm
  have hxeq : x = ((x + v * y) - v * (x + u * y) / u) / (1 - v / u) := by
    rw [eq_div_iff hden]
    field_simp
    ring
  have hxa : x ∈ IntermediateField.adjoin k ({x + v * y, u, x + u * y, v} : Set Ω) := by
    have hs : x + v * y ∈ IntermediateField.adjoin k ({x + v * y, u, x + u * y, v} : Set Ω) :=
      IntermediateField.subset_adjoin k _ (Set.mem_insert _ _)
    have hu' : u ∈ IntermediateField.adjoin k ({x + v * y, u, x + u * y, v} : Set Ω) :=
      IntermediateField.subset_adjoin k _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
    have ht' : x + u * y ∈ IntermediateField.adjoin k ({x + v * y, u, x + u * y, v} : Set Ω) :=
      IntermediateField.subset_adjoin k _
        (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_insert _ _)))
    have hv' : v ∈ IntermediateField.adjoin k ({x + v * y, u, x + u * y, v} : Set Ω) :=
      IntermediateField.subset_adjoin k _
        (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl)))
    have h := div_mem (sub_mem hs (div_mem (mul_mem hv' ht') hu'))
      (sub_mem (one_mem _) (div_mem hv' hu'))
    rwa [← hxeq] at h
  have hsubC : ({x + v * y, u, x + u * y, v} : Set Ω) ⊆ C := by
    intro a ha
    rcases ha with rfl | ha
    · exact hsC
    · exact hXC ha
  have hxC : x ∈ C := closure_le_of_subset hsubC (mem_closure_of_mem_adjoin hxa)
  have hya : y ∈ IntermediateField.adjoin k ({x + u * y, x, u} : Set Ω) := by
    have hyeq : y = ((x + u * y) - x) / u := by
      field_simp
      ring
    have h := div_mem
      (sub_mem (IntermediateField.subset_adjoin k ({x + u * y, x, u} : Set Ω) (Set.mem_insert _ _))
        (IntermediateField.subset_adjoin k ({x + u * y, x, u} : Set Ω)
          (Set.mem_insert_of_mem _ (Set.mem_insert _ _))))
      (IntermediateField.subset_adjoin k ({x + u * y, x, u} : Set Ω)
        (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl)))
    rwa [← hyeq] at h
  have hsub2 : ({x + u * y, x, u} : Set Ω) ⊆ C := by
    intro a ha
    rcases ha with rfl | rfl | rfl
    · exact hXC (Set.mem_insert_of_mem _ (Set.mem_insert _ _))
    · exact hxC
    · exact hXC (Set.mem_insert _ _)
  have hyC : y ∈ C := closure_le_of_subset hsub2 (mem_closure_of_mem_adjoin hya)
  refine false_of_subset_closure (X := X) h4 ?_ ?_
  · rw [hcard]
    exact lt_of_le_of_lt (encard_triple_le _ _ _) (by norm_num)
  · intro a ha
    rcases ha with rfl | rfl | rfl | rfl
    · exact hXC (Set.mem_insert_of_mem _ (Set.mem_insert_of_mem _ rfl))
    · exact hXC (Set.mem_insert _ _)
    · exact hxC
    · exact hyC
end Independence
section Separability
variable {k Ω : Type*} [Field k] [Field Ω] [Algebra k Ω]
theorem isSeparable_of_aeval_derivative {K : Type*} [Field K] [Algebra K Ω] {w : Ω}
    (p : Polynomial K) (hp : Polynomial.aeval w p = 0)
    (hp' : Polynomial.aeval w (Polynomial.derivative p) ≠ 0) : IsSeparable K w := by
  have hp0 : p ≠ 0 := by
    rintro rfl
    simp at hp'
  have hint : IsIntegral K w := (isAlgebraic_iff_isIntegral).mp ⟨p, hp0, hp⟩
  unfold IsSeparable
  rw [Polynomial.separable_iff_derivative_ne_zero (minpoly.irreducible hint)]
  intro hd
  obtain ⟨q, hq⟩ := minpoly.dvd K w hp
  apply hp'
  rw [hq, Polynomial.derivative_mul, hd, zero_mul, zero_add, map_mul, minpoly.aeval, zero_mul]
theorem isSeparable_of_le {A B : IntermediateField k Ω} (h : A ≤ B) {a : Ω}
    (ha : IsSeparable A a) : IsSeparable B a := by
  have hcomp : (algebraMap B Ω).comp (IntermediateField.inclusion h : A →+* B) = algebraMap A Ω :=
    RingHom.ext fun _ => rfl
  have hmap : ∀ p : Polynomial A, Polynomial.aeval a (p.map (IntermediateField.inclusion h : A →+* B)) =
      Polynomial.aeval a p := by
    intro p
    rw [Polynomial.aeval_def, Polynomial.aeval_def, Polynomial.eval₂_map, hcomp]
  refine isSeparable_of_aeval_derivative
    ((minpoly A a).map (IntermediateField.inclusion h : A →+* B)) ?_ ?_
  · rw [hmap, minpoly.aeval]
  · rw [Polynomial.derivative_map, hmap]
    exact ha.aeval_derivative_ne_zero (minpoly.aeval A a)
end Separability
section Sigma
variable {k Ω : Type*} [Field k] [Field Ω] [Algebra k Ω]
variable (F : IntermediateField k Ω) {u v : Ω} (hu : Transcendental F u) (hvF : Transcendental F v)
noncomputable def sigma : IntermediateField.adjoin F ({u} : Set Ω) →ₐ[F] Ω :=
  (IntermediateField.adjoin F ({v} : Set Ω)).val.comp
    ((RatFunc.algEquivOfTranscendental v hvF).toAlgHom.comp
      (RatFunc.algEquivOfTranscendental u hu).symm.toAlgHom)
theorem sigma_gen : sigma F hu hvF (IntermediateField.AdjoinSimple.gen F u) = v := by
  simp [sigma, RatFunc.algEquivOfTranscendental_symm_gen, RatFunc.algEquivOfTranscendental_X]
theorem sigma_aeval (r : Polynomial F) :
    sigma F hu hvF (Polynomial.aeval (IntermediateField.AdjoinSimple.gen F u) r) =
      Polynomial.aeval v r := by
  rw [← Polynomial.aeval_algHom_apply, sigma_gen]
theorem sigma_injective : Function.Injective (sigma F hu hvF) :=
  (sigma F hu hvF).toRingHom.injective
theorem sigma_adjoin_map {x y : Ω} (hx : x ∈ F) (hy : y ∈ F) :
    ∃ S : Set (IntermediateField.adjoin F ({u} : Set Ω)),
      (IntermediateField.adjoin k S).map
          ((IntermediateField.adjoin F ({u} : Set Ω)).val.restrictScalars k) =
        IntermediateField.adjoin k ({u, x + u * y} : Set Ω) ∧
      (IntermediateField.adjoin k S).map ((sigma F hu hvF).restrictScalars k) =
        IntermediateField.adjoin k ({v, x + v * y} : Set Ω) := by
  let u' : IntermediateField.adjoin F ({u} : Set Ω) := IntermediateField.AdjoinSimple.gen F u
  let t' : IntermediateField.adjoin F ({u} : Set Ω) :=
    algebraMap F (IntermediateField.adjoin F ({u} : Set Ω)) ⟨x, hx⟩ +
      u' * algebraMap F (IntermediateField.adjoin F ({u} : Set Ω)) ⟨y, hy⟩
  have hσu : (sigma F hu hvF).restrictScalars k u' = v := sigma_gen F hu hvF
  have hσt : (sigma F hu hvF).restrictScalars k t' = x + v * y := by
    show sigma F hu hvF (algebraMap F (IntermediateField.adjoin F ({u} : Set Ω)) ⟨x, hx⟩ +
      u' * algebraMap F (IntermediateField.adjoin F ({u} : Set Ω)) ⟨y, hy⟩) = x + v * y
    rw [map_add, map_mul, AlgHom.commutes, AlgHom.commutes, sigma_gen]
    rfl
  have hf1 : (IntermediateField.adjoin F ({u} : Set Ω)).val.restrictScalars k u' = u := rfl
  have hf2 : (IntermediateField.adjoin F ({u} : Set Ω)).val.restrictScalars k t' = x + u * y := rfl
  refine ⟨{u', t'}, ?_, ?_⟩
  · rw [IntermediateField.adjoin_map, Set.image_pair, hf1, hf2]
  · rw [IntermediateField.adjoin_map, Set.image_pair, hσu, hσt]
theorem sigma_mem_adjoin {x y : Ω} (hx : x ∈ F) (hy : y ∈ F)
    (c : IntermediateField.adjoin F ({u} : Set Ω))
    (hc : (c : Ω) ∈ IntermediateField.adjoin k ({u, x + u * y} : Set Ω)) :
    sigma F hu hvF c ∈ IntermediateField.adjoin k ({v, x + v * y} : Set Ω) := by
  obtain ⟨S, h1, h2⟩ := sigma_adjoin_map F hu hvF hx hy
  rw [← h1] at hc
  obtain ⟨c', hc', hfc⟩ := hc
  have hcc : c' = c := Subtype.ext hfc
  rw [← h2]
  exact ⟨c', hc', by rw [hcc]; rfl⟩
theorem sigma_preimage {x y : Ω} (hx : x ∈ F) (hy : y ∈ F)
    (c : IntermediateField.adjoin F ({u} : Set Ω))
    (hc : sigma F hu hvF c ∈ IntermediateField.adjoin k ({v, x + v * y} : Set Ω)) :
    (c : Ω) ∈ IntermediateField.adjoin k ({u, x + u * y} : Set Ω) := by
  obtain ⟨S, h1, h2⟩ := sigma_adjoin_map F hu hvF hx hy
  rw [← h2] at hc
  obtain ⟨c', hc', hσc⟩ := hc
  have hcc : c' = c := sigma_injective F hu hvF hσc
  rw [← h1]
  exact ⟨c', hc', by rw [hcc]; rfl⟩
end Sigma
section Transfer
variable {k Ω : Type*} [Field k] [Field Ω] [Algebra k Ω]
theorem transfer_aux {F : IntermediateField k Ω} {U : IntermediateField F Ω}
    {E E' : IntermediateField k Ω} (s : U →+* Ω) (hEU : ∀ c ∈ E, c ∈ U)
    (hσ : ∀ c : U, (c : Ω) ∈ E → s c ∈ E') (z : U) :
    (IsAlgebraic E (z : Ω) → IsAlgebraic E' (s z)) ∧
    (IsSeparable E (z : Ω) → IsSeparable E' (s z)) := by
  let ι : E →+* U :=
    { toFun := fun c => ⟨c, hEU c c.2⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl
      map_zero' := rfl
      map_add' := fun _ _ => rfl }
  let σE : E →+* E' :=
    { toFun := fun c => ⟨s (ι c), hσ (ι c) c.2⟩
      map_one' := by
        apply Subtype.ext
        show s (ι 1) = 1
        rw [map_one, map_one]
      map_mul' := fun a b => by
        apply Subtype.ext
        show s (ι (a * b)) = s (ι a) * s (ι b)
        rw [map_mul, map_mul]
      map_zero' := by
        apply Subtype.ext
        show s (ι 0) = 0
        rw [map_zero, map_zero]
      map_add' := fun a b => by
        apply Subtype.ext
        show s (ι (a + b)) = s (ι a) + s (ι b)
        rw [map_add, map_add] }
  have hsinj : Function.Injective s := s.injective
  have hc1 : (algebraMap E' Ω).comp σE = s.comp ι := RingHom.ext fun _ => rfl
  have hc2 : (U.val : U →+* Ω).comp ι = algebraMap E Ω := RingHom.ext fun _ => rfl
  have key1 : ∀ p : Polynomial E, Polynomial.aeval (s z) (p.map σE) = s (p.eval₂ ι z) := by
    intro p
    rw [Polynomial.aeval_def, Polynomial.eval₂_map, hc1]
    exact (Polynomial.hom_eval₂ p ι s z).symm
  have key2 : ∀ p : Polynomial E, Polynomial.aeval (z : Ω) p = ((p.eval₂ ι z : U) : Ω) := by
    intro p
    have := Polynomial.hom_eval₂ p ι (U.val : U →+* Ω) z
    rw [hc2] at this
    rw [Polynomial.aeval_def]
    exact this.symm
  have hσE : Function.Injective σE := σE.injective
  constructor
  · rintro ⟨p, hp0, hpz⟩
    refine ⟨p.map σE, (Polynomial.map_ne_zero_iff hσE).mpr hp0, ?_⟩
    rw [key1]
    have h0 : p.eval₂ ι z = 0 := by
      apply Subtype.ext
      rw [← key2, hpz]
      rfl
    rw [h0, map_zero]
  · intro hsep
    have hpz : Polynomial.aeval (z : Ω) (minpoly E (z : Ω)) = 0 := minpoly.aeval _ _
    have hd : Polynomial.aeval (z : Ω) (Polynomial.derivative (minpoly E (z : Ω))) ≠ 0 :=
      Polynomial.Separable.aeval_derivative_ne_zero hsep hpz
    refine isSeparable_of_aeval_derivative ((minpoly E (z : Ω)).map σE) ?_ ?_
    · rw [key1]
      have h0 : (minpoly E (z : Ω)).eval₂ ι z = 0 := by
        apply Subtype.ext
        rw [← key2, hpz]
        rfl
      rw [h0, map_zero]
    · rw [Polynomial.derivative_map, key1]
      intro h
      apply hd
      rw [key2]
      have h1 : (Polynomial.derivative (minpoly E (z : Ω))).eval₂ ι z = 0 := by
        apply hsinj
        rw [h, map_zero]
      rw [h1]
      rfl
theorem sigma_transfer (F : IntermediateField k Ω) {u v : Ω} (hu : Transcendental F u)
    (hvF : Transcendental F v) {x y : Ω} (hx : x ∈ F) (hy : y ∈ F)
    (hEU : ∀ c ∈ IntermediateField.adjoin k ({u, x + u * y} : Set Ω),
      c ∈ IntermediateField.adjoin F ({u} : Set Ω))
    (z : IntermediateField.adjoin F ({u} : Set Ω)) :
    (IsAlgebraic (IntermediateField.adjoin k ({u, x + u * y} : Set Ω)) (z : Ω) →
      IsAlgebraic (IntermediateField.adjoin k ({v, x + v * y} : Set Ω)) (sigma F hu hvF z)) ∧
    (IsSeparable (IntermediateField.adjoin k ({u, x + u * y} : Set Ω)) (z : Ω) →
      IsSeparable (IntermediateField.adjoin k ({v, x + v * y} : Set Ω)) (sigma F hu hvF z)) :=
