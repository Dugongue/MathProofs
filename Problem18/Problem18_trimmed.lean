theorem sum_nondegenerate {W : Type*} [AddCommGroup W] [Module K W]
    (B : LinearMap.BilinForm K V) (C : LinearMap.BilinForm K W)
    (hnB : B.Nondegenerate) (hnC : C.Nondegenerate) :
    (sumForm (RingEquiv.refl K) B C).Nondegenerate := by
  constructor
  · intro x hx
    apply Prod.ext
    · apply hnB.1
      intro y
      have hh := hx (y,0)
      change B x.1 y+C x.2 0=0 at hh
      simpa using hh
    · apply hnC.1
      intro y
      have hh := hx (0,y)
      change B x.1 0+C x.2 y=0 at hh
      simpa using hh
  · intro x hx
    apply Prod.ext
    · apply hnB.2
      intro y
      have hh := hx (y,0)
      change B y x.1+C 0 x.2=0 at hh
      simpa using hh
    · apply hnC.2
      intro y
      have hh := hx (0,y)
      change B 0 x.1+C y x.2=0 at hh
      simpa using hh
