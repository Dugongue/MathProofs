  set σ2 := σ1.setVar q.N c with hσ2
  have hS2 : Slots F r q.WS Sn B σ2 := Slots.setVar F r hS1 rNS nNW _
  have st2 : Stab σ2 := setStab σ1 st1 _ (by simp [certMoving]) _
  have hv2 : ∀ s, val F r q.WS σ2 s = val F r q.WS σ s := fun s => by
    rw [hσ2, val_setVar F r nNW, hσ1, val_setVar F r nNwW]
  have hNw2 : σ2.vars an.Nw = c + m := by
    rw [hσ2, vars_setVar, if_neg (ha.ne_of (by intro h; simp [RNames.list, ANames.list, h]))]
