namespace Mathproof.Problem18EulerFiniteSeries20260930
open PowerSeries Problem18EulerLocalSeries20260930
open scoped PowerSeries
variable {R : Type*} [CommRing R]
private theorem X_mul_derivative_finset_prod {κ : Type*} (s : Finset κ) (d : κ → Nat)
    (hd : ∀ i, d i ≠ 0) (z : κ → R) :
    X * PowerSeries.derivative R (∏ i ∈ s, localEuler (d i) (z i)) =
      (∏ i ∈ s, localEuler (d i) (z i)) *
        ∑ i ∈ s, PowerSeries.C (d i : R) * (localEuler (d i) (z i) - 1) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [Derivation.map_one_eq_zero]
  | insert a s ha ih =>
    rw [Finset.prod_insert ha, Finset.sum_insert ha, Derivation.leibniz, smul_eq_mul,
      smul_eq_mul]
    have hloc := X_mul_derivativeFun_localEuler (z a) (hd a)
    linear_combination (localEuler (d a) (z a)) * ih +
      (∏ i ∈ s, localEuler (d i) (z i)) * hloc
variable {ι : Type*} [Fintype ι]
def finiteEulerProduct (d : ι → Nat) (z : ι → R) : PowerSeries R :=
  ∏ i, localEuler (d i) (z i)
def finiteEulerLogDerivative (d : ι → Nat) (z : ι → R) : PowerSeries R :=
  ∑ i, PowerSeries.C (d i:R)*(localEuler (d i) (z i)-1)
theorem finiteEuler_derivative (d : ι → Nat) (hd : ∀ i, d i≠0) (z : ι → R) :
    X*PowerSeries.derivative R (finiteEulerProduct d z)=
      finiteEulerProduct d z*finiteEulerLogDerivative d z :=
  X_mul_derivative_finset_prod Finset.univ d hd z
theorem coeff_finiteEulerLogDerivative (d : ι → Nat) (hd : ∀ i, d i≠0)
    (z : ι → R) {n : Nat} (hn : n≠0) :
    coeff n (finiteEulerLogDerivative d z)=
      ∑ i, if d i∣n then (d i:R)*z i^(n/d i) else 0 := by
  rw [finiteEulerLogDerivative, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [coeff_C_mul, map_sub, coeff_localEuler (z i) (hd i), coeff_one, if_neg hn, sub_zero]
  split_ifs <;> simp
theorem constantCoeff_finiteEulerLogDerivative (d : ι → Nat) (hd : ∀ i, d i≠0)
    (z : ι → R) : constantCoeff (finiteEulerLogDerivative d z)=0 := by
  rw [finiteEulerLogDerivative, map_sum]
  refine Finset.sum_eq_zero fun i _ => ?_
  rw [← coeff_zero_eq_constantCoeff_apply, coeff_C_mul, map_sub,
    coeff_localEuler (z i) (hd i), coeff_one, if_pos (dvd_zero _), if_pos rfl, Nat.zero_div,
    pow_zero, sub_self, mul_zero]
end Mathproof.Problem18EulerFiniteSeries20260930
end
