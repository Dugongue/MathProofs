    {wordPolynomial timePolynomial : Polynomial Nat} {words : List Nat}
    {left right : Bool}
    (hl : CanonicalOneBitRun c wordPolynomial timePolynomial words left)
    (hr : CanonicalOneBitRun c wordPolynomial timePolynomial words right) :
    left = right := by
  obtain ⟨tauL,costL,_hcostL,hrunL,houtL⟩ := hl
  obtain ⟨tauR,costR,_hcostR,hrunR,houtR⟩ := hr
  obtain ⟨_kL,_hkL,hbigL⟩ := hrunL.bigStep
  obtain ⟨_kR,_hkR,hbigR⟩ := hrunR.bigStep
  have henv : tauL = tauR := (BigStep.unique hbigL hbigR).1
  have hout : Mathproof.Problem18RAMAnswerCodec20261001.answerWords (some left) =
      Mathproof.Problem18RAMAnswerCodec20261001.answerWords (some right) := by
    rw [←houtL,←houtR,henv]
  revert hout
  cases left <;> cases right <;> simp [Mathproof.Problem18RAMAnswerCodec20261001.answerWords]
