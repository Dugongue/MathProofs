theorem fullCoordinates_injective (B : Form (V := Fin n → K) τ) (hB : B.SeparatingLeft)
    (hsym : ∀ x y,B y x=eps*τ (B x y)) :
    Function.Injective (mixedCoordinates τ eps B hsym (LinearMap.id : Module.End K (Fin n → K))
      Finset.univ Finset.univ) := by
  intro T U hTU
  have hentry (i j : Fin n) :
      B (T.val (Pi.single i 1)) (Pi.single j 1)=B (U.val (Pi.single i 1)) (Pi.single j 1) := by
    have hup (i j : Fin n) (hij : i<j) :
        B (T.val (Pi.single i 1)) (Pi.single j 1)=B (U.val (Pi.single i 1)) (Pi.single j 1) := by
      exact congrArg (fun u => u.1 ⟨⟨(i,j),hij⟩,Finset.mem_univ _⟩) hTU
    rcases lt_trichotomy i j with hij | hij | hij
    · exact hup i j hij
    · subst j
      exact congrArg (fun u => (u.2 ⟨i,Finset.mem_univ _⟩).val) hTU
    · calc
        B (T.val (Pi.single i 1)) (Pi.single j 1) =
          eps*τ (B (T.val (Pi.single j 1)) (Pi.single i 1)) :=
            (T.property _ _).trans (hsym _ _)
        _ = eps*τ (B (U.val (Pi.single j 1)) (Pi.single i 1)) :=
          congrArg (fun z => eps*τ z) (hup j i hij)
        _ = B (U.val (Pi.single i 1)) (Pi.single j 1) :=
          ((U.property _ _).trans (hsym _ _)).symm
