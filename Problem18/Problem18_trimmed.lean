    ((PerfectField.separable_iff_squarefree.mpr f.property.1.1).map).squarefree
  have hzero (f : I) : (f.val.val.map (algebraMap F K)).coeff 0≠0 := by
    rw [Polynomial.coeff_map,_root_.map_ne_zero]
    exact fun h => f.property.1.2 (Polynomial.X_dvd_iff.mpr h)
