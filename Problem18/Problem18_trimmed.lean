      (∑ M : ConstraintSample K d (Fin a × Fin b),
        diagonalWeight ψ M.val (fun ij => z.val ij.2) m) /
        Nat.card (ConstraintSample K d (Fin a × Fin b)) ≤ C := by
    have hz : (fun ij : Fin a × Fin b => z.val ij.2) ≠ 0 := by
      intro he
      apply z.property
      funext j
      exact congrFun he (i₀,j)
