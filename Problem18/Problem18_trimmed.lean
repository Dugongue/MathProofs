      Submodule.subset_span ⟨f, hf, rfl⟩
    have hrep : vecOf n (secDeg d) f = ∑ i, vecOf n (secDeg d) f (S i) • U i := by
      funext j
      rw [hspan _ hvf j]
      simp [Finset.sum_apply, smul_eq_mul]
    have hbox : f = boxPoly n (secDeg d) (vecOf n (secDeg d) f) :=
      (boxPoly_of_totalDegree n _ f ((hfs f hf).trans hdE)).symm
    rw [SetLike.mem_coe, hbox, hrep]
    simp only [boxPoly, map_sum, map_smul]
    refine Ideal.sum_mem _ fun i _ => ?_
    rw [smul_eq_C_mul]
    refine Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨⟨i.val, lt_of_lt_of_le i.isLt hk⟩, ?_⟩)
