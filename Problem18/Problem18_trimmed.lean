    (hrefCount : ρ.vars count = (ρ.arrs canonical.mem).length)
    (hmemName : memoryBank ≠ canonical.mem)
    (hmemScratch : memoryBank ≠ canonical.scratch)
    (hlayoutMem : layoutBank ≠ canonical.mem)
    (hlayoutScratch : layoutBank ≠ canonical.scratch)
    (hidxCount : idx ≠ count)
    (hidx : ∀ x ∈ protectedNames count, idx ≠ x)
    (hcountFresh : count ∉ fixedTargets)
    (hseven : 7 < B)
    (himageBound : ∀ v ∈ image count ρ, v < B)
    (hz : val F canonical names.q.WS ρ 0 = 0)
    (hQ : ρ.vars names.qr = Fintype.card K) (hQB : Fintype.card K < B)
    (hb : ∀ cl ∈ cls, ∀ p ∈ sysExprs cl,
      ∀ e ∈ rowExprs p (clauseDeg cl), polyDepth e ≤ D ∧ constBound e < B)
    (ha : ∀ i : Fin c0, val F canonical names.q.WS ρ (5 + i.val) = a i)
    (hwords : ∀ cl ∈ cls,
      (sysExprs cl).length + (m + 1) +
        lenM (m + 1) (eliminantShift (m + 1) (clauseDeg cl)) +
        lenD (m + 1) (clauseDeg cl) +
        lenM (m + 1) (geoE (m + 1)
          (frobeniusDegree (m + 1) (clauseDeg cl))) +
        rowLength (m + 1) (clauseDeg cl) < B)
