theorem crossRank_largeComplement
    (k r z s n : ℝ) (hk : 0 ≤ k) (hr : 0 ≤ r) (hz : 0 ≤ z)
    (hs : 0 ≤ s) (hsk : s ≤ k) (hsr : s ≤ r)
