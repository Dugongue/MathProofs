  · exact nomatch impossible
  · cases label <;>
      simp [program, embedCleanup, liftCoreProgram, outputAdapterProgram,
        mapLabelStmt, mapLabelStmt_comp, Function.comp_def] <;>
      try (congr 1 <;> funext x <;> rfl)
theorem emitted_cleanup_run {N : Nat} (q : Polynomial Nat)
    (state : WrapperState N)
    (tapes : (k : WrapperStack) → List (WrapperAlphabet k)) :
    ((fun o => o.bind (TM2.step (program (N := N) q)))^[
        cleanupTotalCost tapes + 1])
      (some (mapLabelCfg embedCleanup
        (outputAdapterCfg (L := Empty) (.cleanupPeek .input) state tapes))) =
    some (mapLabelCfg embedCleanup
      (⟨none, default, cleanedStacks tapes⟩ :
        TM2.Cfg WrapperAlphabet (Sum Empty OutputAdapterLabel)
          (WrapperState N))) := by
  rw [cleanup_lift, output_cleanup_run]
  rfl
def taggedInput (p : Lax51Proofs.Microcode.Program)
    (wordBound timeBound : Polynomial Nat) (x : List Nat) : List Symbol :=
  List.replicate (clockTokenCount p wordBound timeBound x) .one ++
    .separator :: encode x
noncomputable def emitterSteps (p : Lax51Proofs.Microcode.Program)
    (wordBound timeBound : Polynomial Nat) (x : List Nat) : Nat :=
  let q := clockPolynomial p wordBound timeBound
  let c := readyCfg (N := programArgumentBound p) q x
  let tapes := emitTapes c.stk [] [] (taggedInput p wordBound timeBound x)
  4 * bitSize x + (simpleMajorantEvalCostPolynomial q).eval (bitSize x) + 5 +
    1 + bitSize x + 1 + 1 + 1 +
    clockTokenCount p wordBound timeBound x + 1 +
    cleanupTotalCost tapes + 1
noncomputable def emitterTimePolynomial
    (p : Lax51Proofs.Microcode.Program)
    (wordBound timeBound : Polynomial Nat) : Polynomial Nat :=
  let q := clockPolynomial p wordBound timeBound
  10 * X + simpleMajorantEvalCostPolynomial q +
    polynomialSimpleMajorant q + C 30
 theorem emitter_cleanupCost_le
    (p : Lax51Proofs.Microcode.Program)
    (wordBound timeBound : Polynomial Nat) (x : List Nat) :
    let q := clockPolynomial p wordBound timeBound
    let c := readyCfg (N := programArgumentBound p) q x
    let tapes := emitTapes c.stk [] [] (taggedInput p wordBound timeBound x)
    cleanupTotalCost tapes ≤ 4 * bitSize x + 15 := by
  dsimp only
  have hx := Lax51Proofs.Encoding.length_le_bitSize x
  simp [cleanupTotalCost, emitTapes, readyCfg, inputWidthReadyCfg,
    inputWidthPowerFinalCfg, mapLabelCfg, liftCoreCfg, wrapperCoreStacks,
    lensReturnCfg, lensRenamedCfg, renamedStacks, unaryMulCoreRenaming,
    unaryMulStacks, unaryPowerCfg, inputWidthScannedStacks, unaryMarkers,
    inputSeparatorCount_encode, Function.update]
  omega
 theorem emitterSteps_le
    (p : Lax51Proofs.Microcode.Program)
    (wordBound timeBound : Polynomial Nat) (x : List Nat) :
    emitterSteps p wordBound timeBound x ≤
      (emitterTimePolynomial p wordBound timeBound).eval (bitSize x) := by
  have hc := emitter_cleanupCost_le p wordBound timeBound x
  simp only [emitterSteps, emitterTimePolynomial,
    Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_ofNat,
    Polynomial.eval_X, Polynomial.eval_C]
  change
    4 * bitSize x +
        (simpleMajorantEvalCostPolynomial
          (clockPolynomial p wordBound timeBound)).eval (bitSize x) + 5 +
      1 + bitSize x + 1 + 1 + 1 +
      clockTokenCount p wordBound timeBound x + 1 +
      cleanupTotalCost
        (emitTapes
          (readyCfg (N := programArgumentBound p)
            (clockPolynomial p wordBound timeBound) x).stk
          [] [] (taggedInput p wordBound timeBound x)) + 1 ≤
    10 * bitSize x +
      (simpleMajorantEvalCostPolynomial
        (clockPolynomial p wordBound timeBound)).eval (bitSize x) +
      (polynomialSimpleMajorant
        (clockPolynomial p wordBound timeBound)).eval (bitSize x) + 30
  change _ ≤ _
  unfold clockTokenCount at *
  omega
theorem map_refl_invFun (xs : List Symbol) :
    List.map (Equiv.refl Symbol).invFun xs = xs := by
  induction xs with
  | nil => rfl
  | cons a xs ih => simp only [List.map_cons]; rw [ih]; rfl
theorem initList_map_refl (N : Nat) (q : Polynomial Nat) (input : List Symbol) :
    Turing.initList (machine N q) (List.map (Equiv.refl Symbol).invFun input) =
      Turing.initList (machine N q) input :=
  congrArg _ (map_refl_invFun input)
theorem haltList_map_refl (N : Nat) (q : Polynomial Nat) (out : List Symbol) :
    Turing.haltList (machine N q) (List.map (Equiv.refl Symbol).invFun out) =
      Turing.haltList (machine N q) out :=
  congrArg _ (map_refl_invFun out)
theorem machine_initList (N : Nat) (q : Polynomial Nat) (input : List Symbol) :
    Turing.initList (machine N q) input = initialCfg (N := N) q input := by
  simp only [Turing.initList, machine, initialCfg, inputWidthCfg, mapLabelCfg,
    Option.map_some, embedWidth]
  congr 1
  funext k
  cases k with
  | input => simp [inputWidthInitialStacks] <;> rfl
  | output => simp [inputWidthInitialStacks]
  | core k => simp [inputWidthInitialStacks]
theorem machine_haltList (N : Nat) (q : Polynomial Nat)
    (base : (k : WrapperStack) → List (WrapperAlphabet k)) (out : List Symbol) :
    Turing.haltList (machine N q) out =
      mapLabelCfg embedCleanup
        (⟨none, default, cleanedStacks (emitTapes base [] [] out)⟩ :
          TM2.Cfg WrapperAlphabet (Sum Empty OutputAdapterLabel)
            (WrapperState N)) := by
  simp only [Turing.haltList, machine, mapLabelCfg, Option.map_none]
  congr 1
  funext k
  cases k with
  | input => simp [cleanedStacks] <;> rfl
  | output => simp [cleanedStacks, emitTapes]
  | core k => simp [cleanedStacks] <;> rfl
theorem emitter_run (p : Lax51Proofs.Microcode.Program)
    (wordBound timeBound : Polynomial Nat) (x : List Nat) :
    ((fun o => o.bind (TM2.step
      (program (N := programArgumentBound p)
        (clockPolynomial p wordBound timeBound))))^[
          emitterSteps p wordBound timeBound x])
      (some (initialCfg (N := programArgumentBound p)
        (clockPolynomial p wordBound timeBound) (encode x))) =
    some (Turing.haltList
      (machine (programArgumentBound p)
        (clockPolynomial p wordBound timeBound))
      (taggedInput p wordBound timeBound x)) := by
  let q := clockPolynomial p wordBound timeBound
  let c := readyCfg (N := programArgumentBound p) q x
  let count := clockTokenCount p wordBound timeBound x
  let tagged := taggedInput p wordBound timeBound x
  let finalTapes := emitTapes c.stk [] [] tagged
  have hwidth := width_complete (N := programArgumentBound p) q x
  have hbridge :
      ((fun o => o.bind (TM2.step
        (program (N := programArgumentBound p) q)))^[1])
        (some c) =
      some (emitCfg (q := q) .raw c.var c.stk
        (c.stk (.core .work0)) (c.stk (.core .work3)) (c.stk .output)) := by
    simpa [c] using width_ready_step (N := programArgumentBound p) q x
  have hraw₀ := raw_run (q := q) c.var c.stk
    (c.stk (.core .work0)) (c.stk (.core .work3)) (c.stk .output)
  have hwork0 : c.stk (.core .work0) =
      (encode x).reverse.map sparseOfInputSymbol := by
    simpa only [c, readyCfg, mapLabelCfg] using
      (inputWidthReadyCfg_work0 q x
        (default : WrapperState (programArgumentBound p)))
  have hwork3base : c.stk (.core .work3) =
      unaryMarkers (count + 1) := by
    simpa only [c, readyCfg, mapLabelCfg, q, count, clockPolynomial,
      clockTokenCount, simulationWordWidth] using
      (inputWidthReadyCfg_work3 q x
        (default : WrapperState (programArgumentBound p)))
  have hwork3 : c.stk (.core .work3) =
      .wordEnd :: unaryMarkers count := by
    rw [hwork3base]
    simp [unaryMarkers, List.replicate_succ]
  have hout : c.stk .output = [] := by
    simp [c, readyCfg, inputWidthReadyCfg, inputWidthPowerFinalCfg,
      mapLabelCfg, liftCoreCfg, wrapperCoreStacks, inputWidthScannedStacks]
  have hraw :
      ((fun o => o.bind (TM2.step
        (program (N := programArgumentBound p) q)))^[bitSize x])
        (some (emitCfg (q := q) .raw c.var c.stk
          (c.stk (.core .work0)) (c.stk (.core .work3)) (c.stk .output))) =
      some (emitCfg (q := q) .raw c.var c.stk []
        (.wordEnd :: unaryMarkers count) (encode x)) := by
    rw [hwork0, hwork3, hout] at hraw₀
    simpa [hwork0, hwork3, hout, bitSize, List.map_map,
      List.map_reverse, Function.comp_def] using hraw₀
  have hrawEnd :
      ((fun o => o.bind (TM2.step
        (program (N := programArgumentBound p) q)))^[1])
        (some (emitCfg (q := q) .raw c.var c.stk []
          (.wordEnd :: unaryMarkers count) (encode x))) =
      some (emitCfg (q := q) .separator c.var c.stk []
        (.wordEnd :: unaryMarkers count) (encode x)) := by
    simpa using raw_nil_step (q := q) c.var c.stk
      (.wordEnd :: unaryMarkers count) (encode x)
  have hsep :
      ((fun o => o.bind (TM2.step
        (program (N := programArgumentBound p) q)))^[1])
        (some (emitCfg (q := q) .separator c.var c.stk []
          (.wordEnd :: unaryMarkers count) (encode x))) =
      some (emitCfg (q := q) .drop c.var c.stk []
        (.wordEnd :: unaryMarkers count) (.separator :: encode x)) := by
    simpa using separator_step (q := q) c.var c.stk
      (.wordEnd :: unaryMarkers count) (encode x)
  have hdrop :
      ((fun o => o.bind (TM2.step
        (program (N := programArgumentBound p) q)))^[1])
        (some (emitCfg (q := q) .drop c.var c.stk []
          (.wordEnd :: unaryMarkers count) (.separator :: encode x))) =
      some (emitCfg (q := q) .clock c.var c.stk []
        (unaryMarkers count) (.separator :: encode x)) := by
    simpa using drop_step (q := q) c.var c.stk .wordEnd
      (unaryMarkers count) (.separator :: encode x)
  have hclock₀ := clock_run (q := q) c.var c.stk
    (unaryMarkers count) (.separator :: encode x)
  have hclock :
      ((fun o => o.bind (TM2.step
        (program (N := programArgumentBound p) q)))^[count])
        (some (emitCfg (q := q) .clock c.var c.stk []
          (unaryMarkers count) (.separator :: encode x))) =
      some (emitCfg (q := q) .clock c.var c.stk [] [] tagged) := by
    simpa [tagged, taggedInput, unaryMarkers] using hclock₀
  have hclockEnd :
      ((fun o => o.bind (TM2.step
        (program (N := programArgumentBound p) q)))^[1])
        (some (emitCfg (q := q) .clock c.var c.stk [] [] tagged)) =
      some (mapLabelCfg embedCleanup
        (outputAdapterCfg (L := Empty) (.cleanupPeek .input)
          (clearHeld c.var) finalTapes)) := by
    simpa [finalTapes] using clock_nil_step (q := q) c.var c.stk tagged
  have hcleanup := emitted_cleanup_run (N := programArgumentBound p) q
    (clearHeld c.var) finalTapes
  have h := chain_iterations _ hwidth hbridge
  have h := chain_iterations _ h hraw
  have h := chain_iterations _ h hrawEnd
  have h := chain_iterations _ h hsep
  have h := chain_iterations _ h hdrop
  have h := chain_iterations _ h hclock
  have h := chain_iterations _ h hclockEnd
  have h := chain_iterations _ h hcleanup
  rw [machine_haltList (base := c.stk)]
  exact h
noncomputable def emitterMachine
    (p : Lax51Proofs.Microcode.Program)
    (wordBound timeBound : Polynomial Nat) :
    TM2ComputableInPolyTime encode
      (taggedInput p wordBound timeBound) id where
  tm := machine (programArgumentBound p)
    (clockPolynomial p wordBound timeBound)
  inputAlphabet := Equiv.refl Symbol
  outputAlphabet := Equiv.refl Symbol
  time := emitterTimePolynomial p wordBound timeBound
  outputsFun := by
    intro x
    refine ⟨⟨emitterSteps p wordBound timeBound x, ?_⟩,
      emitterSteps_le p wordBound timeBound x⟩
    have hrun := emitter_run p wordBound timeBound x
    rw [← machine_initList, ← initList_map_refl, ← haltList_map_refl] at hrun
    exact hrun
end
end Mathproof.Problem18P36ClockTagEmitter20261004
