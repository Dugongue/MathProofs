namespace Mathproof.Problem18GuardedTransducer20261001
open Turing StateTransition Problem18FiniteTransducer20261001
variable {A B Q : Type} [Fintype A] [Fintype B] [Fintype Q] [Inhabited A] [Inhabited B]
def finalState (T : Transducer A B Q) : Q→List A→Q
  | q,[]=>q
  | q,a::xs=>finalState T (T.next q a).1 xs
def guardedRun (T : Transducer A B Q) (accept : Q→Bool) (xs : List A) : List B :=
  if accept (finalState T T.initial xs) then run T T.initial xs else []
def scanStatement (T : Transducer A B Q) : Statement A B Q :=
  .pop .input (fun v x=>(v.1,x,none))
    (.branch (fun v=>v.2.1.isSome)
      (emit (fun v=>(T.next v.1 (v.2.1.getD default)).2)
        (.load (fun v=>((T.next v.1 (v.2.1.getD default)).1,none,none)) (.goto (fun _=>true))))
      (emit (fun v=>T.finish v.1)
        (.load (fun v=>(v.1,none,none)) (.goto (fun _=>false)))))
def reverseStatement (T : Transducer A B Q) (accept : Q→Bool) : Statement A B Q :=
  .pop .buffer (fun v x=>(v.1,none,x))
    (.branch (fun v=>v.2.2.isSome)
      (.branch (fun v=>accept v.1)
        (.push .output (fun v=>v.2.2.getD default)
          (.load (fun v=>(v.1,none,none)) (.goto (fun _=>false))))
        (.load (fun v=>(v.1,none,none)) (.goto (fun _=>false))))
      (.load (fun _=>(T.initial,none,none)) .halt))
def machine (T : Transducer A B Q) (accept : Q→Bool) : FinTM2 where
  K:=Stack
  k₀:=.input
  k₁:=.output
  Γ:=Alphabet A B
  Λ:=Bool
  main:=true
  σ:=State A B Q
  initialState:=(T.initial,none,none)
  m p:=if p then scanStatement T else reverseStatement T accept
def scanCfg (T : Transducer A B Q) (accept : Q→Bool) (q : Q)
    (xs : List A) (ys out : List B) : (machine T accept).Cfg where
  l:=some true
  var:=(q,none,none)
  stk k:=match k with | .input=>xs | .buffer=>ys | .output=>out
def reverseCfg (T : Transducer A B Q) (accept : Q→Bool) (q : Q)
    (ys out : List B) : (machine T accept).Cfg where
  l:=some false
  var:=(q,none,none)
  stk k:=match k with | .input=>[] | .buffer=>ys | .output=>out
theorem initial_eq (T : Transducer A B Q) (accept : Q→Bool) (xs : List A) :
    initList (machine T accept) xs=scanCfg T accept T.initial xs [] [] := by
  simp [initList,machine,scanCfg]
  congr 1
  funext k
  cases k <;> rfl
theorem scan_step (T : Transducer A B Q) (accept : Q→Bool) (q : Q)
    (a : A) (xs : List A) (ys out : List B) :
    (machine T accept).step (scanCfg T accept q (a::xs) ys out)=
      some (scanCfg T accept (T.next q a).1 xs ((T.next q a).2.reverse++ys) out) := by
  simp only [machine,FinTM2.step,TM2.step,scanCfg,scanStatement,ite_true,TM2.stepAux,
    List.head?_cons,List.tail_cons,Option.isSome_some,Bool.cond_true,Option.getD_some]
  rw [stepAux_emit _ _ _ _ (T.next_bound q a)]
  simp only [TM2.stepAux]
  congr 2
  funext k
  cases k <;> simp [Function.update]
theorem scan_finish (T : Transducer A B Q) (accept : Q→Bool) (q : Q) (ys out : List B) :
    (machine T accept).step (scanCfg T accept q [] ys out)=
      some (reverseCfg T accept q ((T.finish q).reverse++ys) out) := by
  simp only [machine,FinTM2.step,TM2.step,scanCfg,reverseCfg,scanStatement,ite_true,TM2.stepAux,
    List.head?_nil,List.tail_nil,Option.isSome_none,Bool.cond_false]
  rw [stepAux_emit _ _ _ _ (T.finish_bound q)]
  simp only [TM2.stepAux]
  congr 2
  funext k
  cases k <;> simp [Function.update]
theorem reverse_step (T : Transducer A B Q) (accept : Q→Bool) (q : Q)
    (b : B) (ys out : List B) :
    (machine T accept).step (reverseCfg T accept q (b::ys) out)=
      some (reverseCfg T accept q ys (if accept q then b::out else out)) := by
  cases h : accept q <;>
    simp [machine,FinTM2.step,TM2.step,reverseCfg,reverseStatement,TM2.stepAux,h] <;>
    congr 2 <;> funext k <;> cases k <;> simp [Function.update]
theorem reverse_finish (T : Transducer A B Q) (accept : Q→Bool) (q : Q) (out : List B) :
    (machine T accept).step (reverseCfg T accept q [] out)=
      some (haltList (machine T accept) out) := by
  simp [machine,FinTM2.step,TM2.step,reverseCfg,reverseStatement,TM2.stepAux,haltList]
  congr 2
  funext k
  cases k <;> simp [Function.update]
def scanTrace (T : Transducer A B Q) (accept : Q→Bool) (q : Q)
    (xs : List A) (ys out : List B) :
    EvalsToInTime (machine T accept).step (scanCfg T accept q xs ys out)
      (some (reverseCfg T accept (finalState T q xs) ((run T q xs).reverse++ys) out))
      (xs.length+1) := by
  induction xs generalizing q ys with
  | nil=>exact oneStep _ _ _ (scan_finish T accept q ys out)
  | cons a xs ih=>
    have h1:=oneStep _ _ _ (scan_step T accept q a xs ys out)
    have h2:=ih (T.next q a).1 ((T.next q a).2.reverse++ys)
    have h:=EvalsToInTime.trans (machine T accept).step _ _ _ _ _ h1 h2
    simpa [run,finalState,List.reverse_append,List.append_assoc,Nat.add_assoc] using h
def reverseTrace (T : Transducer A B Q) (accept : Q→Bool) (q : Q) (ys out : List B) :
    EvalsToInTime (machine T accept).step (reverseCfg T accept q ys out)
      (some (haltList (machine T accept) ((if accept q then ys.reverse else [])++out)))
      (ys.length+1) := by
  induction ys generalizing out with
  | nil=>simpa using oneStep _ _ _ (reverse_finish T accept q out)
  | cons b ys ih=>
    have h1:=oneStep _ _ _ (reverse_step T accept q b ys out)
    have h2:=ih (if accept q then b::out else out)
    have h:=EvalsToInTime.trans (machine T accept).step _ _ _ _ _ h1 h2
    cases ha : accept q <;>
      simpa [ha,List.reverse_cons,List.append_assoc,Nat.add_assoc] using h
noncomputable def computable (T : Transducer A B Q) (accept : Q→Bool) :
    TM2ComputableInPolyTime id id (guardedRun T accept) where
  tm:=machine T accept
  inputAlphabet:=Equiv.refl A
  outputAlphabet:=Equiv.refl B
  time:=Polynomial.C 3*Polynomial.X+Polynomial.C 4
  outputsFun xs:=by
    have h1:=scanTrace T accept T.initial xs [] []
    have h2:=reverseTrace T accept (finalState T T.initial xs) (run T T.initial xs).reverse []
    simp only [List.append_nil] at h1
    have h:=EvalsToInTime.trans (machine T accept).step _ _ _ _ _ h1 h2
    have hh : EvalsToInTime (machine T accept).step (initList (machine T accept) xs)
        (some (haltList (machine T accept) (guardedRun T accept xs)))
        (xs.length+1+((run T T.initial xs).length+1)) := by
      simpa only [initial_eq,guardedRun,List.reverse_reverse,List.append_nil,List.length_reverse,Nat.add_comm] using h
    have hb:=run_length T T.initial xs
    have hbound:=hh.steps_le_m.trans (show xs.length+1+((run T T.initial xs).length+1) ≤ 3*xs.length+4 by omega)
    simpa [TM2OutputsInTime,Equiv.refl,Equiv.symm] using
      (show EvalsToInTime (machine T accept).step (initList (machine T accept) xs)
        (some (haltList (machine T accept) (guardedRun T accept xs))) (3*xs.length+4)
        from {hh with steps_le_m:=hbound})
end Mathproof.Problem18GuardedTransducer20261001
