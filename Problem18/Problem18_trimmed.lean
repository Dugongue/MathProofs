theorem tflat_apply {a b c : Nat} (Z : RectTensor a b c K) (k : Fin c) (i : Fin a) (j : Fin b) :
    tflat Z (k.val * (a * b) + i.val * b + j.val) = Z k (i, j) := by
  have hs : i.val * b + j.val < a * b := idx2_lt i.isLt j.isLt
  have hlt : k.val * (a * b) + i.val * b + j.val < c * (a * b) := by
    rw [Nat.add_assoc]; exact idx2_lt k.isLt hs
  unfold tflat
  rw [dif_pos hlt]
  have h1 : (k.val * (a * b) + i.val * b + j.val) / (a * b) = k.val := by
    rw [Nat.add_assoc]; exact idx2_div hs
  have h2 : (k.val * (a * b) + i.val * b + j.val) % (a * b) = i.val * b + j.val := by
    rw [Nat.add_assoc]; exact idx2_mod hs
  have h3 : (k.val * (a * b) + i.val * b + j.val) % b = j.val := by
    rw [show k.val * (a * b) + i.val * b + j.val = (k.val * a + i.val) * b + j.val by ring]
    exact idx2_mod j.isLt
  congr 1
  · exact Fin.ext h1
  · refine Prod.ext (Fin.ext ?_) (Fin.ext h3)
    show (k.val * (a * b) + i.val * b + j.val) % (a * b) / b = i.val
    rw [h2]; exact idx2_div j.isLt
section Tensor
variable (F : FieldPresentation K)
theorem tensorAt_iff_vals (arr : String) (σ : Lax13Proofs.Imp.Env) (off : Nat) {a b c : Nat}
    (Z : RectTensor a b c K) :
    TensorAt F arr σ off Z ↔ Vals F arr σ off (c * (a * b)) (tflat Z) := by
  have hoff : ∀ (k : Fin c) (i : Fin a) (j : Fin b) (t : Fin F.e),
      Problem18EncodedTensorSort20261001.offset a b F.e k.val i.val j.val t.val =
        F.e * (k.val * (a * b) + i.val * b + j.val) + t.val := by
    intro k i j t; simp only [Problem18EncodedTensorSort20261001.offset]; ring
  constructor
  · intro h s hs t
    obtain ⟨k, i, j, rfl⟩ := decomp3 hs
    have hlt := Problem18EncodedTensorSort20261001.offset_lt k i j t
    have := h (Problem18EncodedTensorSort20261001.offset a b F.e k.val i.val j.val t.val) (by
      have : c * (a * (b * F.e)) = a * b * c * F.e := by ring
      omega)
    rw [hoff] at this
    rw [Nat.add_assoc, this, ← hoff, Problem18EncodedTensorSort20261001.tensorCoordinates_getD,
      tflat_apply]
  · intro h s hs
    have he := F.degree_pos
    have hsi : s / F.e < c * (a * b) := by
      rw [Nat.div_lt_iff_lt_mul he]
      have : a * b * c * F.e = c * (a * b) * F.e := by ring
      omega
    obtain ⟨k, i, j, hkij⟩ := decomp3 hsi
    have hts : s % F.e < F.e := Nat.mod_lt _ he
    have hsplit : s = F.e * (s / F.e) + s % F.e := (Nat.div_add_mod s F.e).symm
    have := h (s / F.e) hsi ⟨s % F.e, hts⟩
    simp only at this
    rw [show off + s = off + F.e * (s / F.e) + s % F.e by rw [Nat.add_assoc, ← hsplit], this, hkij, tflat_apply]
    have ho : Problem18EncodedTensorSort20261001.offset a b F.e k.val i.val j.val
        (⟨s % F.e, hts⟩ : Fin F.e).val = s := by rw [hoff, ← hkij]; exact hsplit.symm
    conv_rhs => rw [← ho]
    rw [Problem18EncodedTensorSort20261001.tensorCoordinates_getD]
end Tensor
def prodVal (fL fR : Nat → K) (n p t : Nat) : K :=
  ∑ k : Fin n, fL (t / p * n + k.val) * fR (k.val * p + t % p)
def ex (u : Bool) (q : Nat) : Nat := if u then q else 1
theorem raw_pow (u : Bool) (q : Nat) (x : K) : (if u then x ^ q else x) = x ^ ex u q := by
  cases u <;> simp [ex]
variable [DecidableEq K]
theorem gram_eq {n : Nat} (hn : 0 < n) (u : Bool) (q : Nat) (Z : Matrix (Fin n) (Fin n) K) :
    rawGram hn u q Z = prodVal (fun _ => 1) (fun i => flat2 Z i ^ ex u q * flat2 Z i) n n 0 := by
  unfold rawGram prodVal
  rw [Matrix.mul_apply]
  apply Finset.sum_congr rfl
  intro k _
  have hz := flat2_apply Z k ⟨0, hn⟩
  simp only [Nat.add_zero] at hz
  simp only [Nat.zero_mod, Nat.add_zero, one_mul, hz]
  simp only [rawAdjoint]
  cases u <;> simp [ex, Matrix.transpose_apply]
theorem undo_eq [Fintype K] {a b c : Nat} (hb : 0 < b) (u : Bool) (q : Nat) (T : RectTensor a b c K)
    (X : Matrix (Fin b) (Fin b) K)
    (hgram : rawAdjoint u q X * X = rawGram hb u q X • 1) (hd : rawGram hb u q X ≠ 0) :
    ∀ t < c * (a * b), tflat (Problem18TwoIntertwinerRecovery20261001.undoFirst T X) t =
      prodVal (tflat T) (fun i => flat2 X i ^ ex u q * (rawGram hb u q X)⁻¹) b b t := by
  intro t ht
  obtain ⟨k, i, j, rfl⟩ := decomp3 ht
  let _ : StarRing K := identityStar
  rw [tflat_apply, Mathproof.Problem18PairLargeSemantic20261004.undoFirst_entry u q T X _ hgram hd]
  unfold prodVal
  apply Finset.sum_congr rfl
  intro j' _
  have e1 : (k.val * (a * b) + i.val * b + j.val) / b * b + j'.val =
      k.val * (a * b) + i.val * b + j'.val := by
    rw [show k.val * (a * b) + i.val * b + j.val = (k.val * a + i.val) * b + j.val by ring,
      idx2_div j.isLt]; ring
  have e2 : j'.val * b + (k.val * (a * b) + i.val * b + j.val) % b = j'.val * b + j.val := by
    rw [show k.val * (a * b) + i.val * b + j.val = (k.val * a + i.val) * b + j.val by ring,
      idx2_mod j.isLt]
  rw [e1, e2, tflat_apply]
  dsimp only
  rw [flat2_apply, raw_pow]
  ring
theorem scale_eq {m n : Nat} (G : Fin m → Matrix (Fin n) (Fin n) K) (d : K) (i : Nat) :
    flat3 (fun t => d • G t) i = flat3 G i * d := by
  unfold flat3
  split_ifs
  · simp [smul_eq_mul, mul_comm]
  · simp
def rI (a b idx : Nat) : Nat := idx / (a * b)
def sI (a b idx : Nat) : Nat := idx - rI a b idx * (a * b)
def yI (a b idx : Nat) : Nat := sI a b idx / b * a + rI a b idx / b
def xI (a b idx : Nat) : Nat :=
  (sI a b idx - sI a b idx / b * b) * b + (rI a b idx - rI a b idx / b * b)
def kflat (a b : Nat) (Y : Matrix (Fin a) (Fin a) K) (X : Matrix (Fin b) (Fin b) K)
    (idx : Nat) : K :=
  flat2 Y (yI a b idx) * flat2 X (xI a b idx)
theorem kflat_apply {a b : Nat} (Y : Matrix (Fin a) (Fin a) K) (X : Matrix (Fin b) (Fin b) K)
    (i' i : Fin a) (j' j : Fin b) :
    kflat a b Y X ((i'.val * b + j'.val) * (a * b) + (i.val * b + j.val)) = Y i i' * X j j' := by
  have hr : i'.val * b + j'.val < a * b := idx2_lt i'.isLt j'.isLt
  have hs : i.val * b + j.val < a * b := idx2_lt i.isLt j.isLt
  have h1 : rI a b ((i'.val * b + j'.val) * (a * b) + (i.val * b + j.val)) = i'.val * b + j'.val :=
    idx2_div hs
  have h2 : sI a b ((i'.val * b + j'.val) * (a * b) + (i.val * b + j.val)) = i.val * b + j.val := by
    unfold sI; rw [h1]; omega
  unfold kflat yI xI
  rw [h1, h2, idx2_div j.isLt, idx2_div j'.isLt,
    show i.val * b + j.val - i.val * b = j.val by omega,
    show i'.val * b + j'.val - i'.val * b = j'.val by omega, flat2_apply, flat2_apply]
theorem outer_eq {a b c : Nat} (A : RectTensor a b c K) (Y : Matrix (Fin a) (Fin a) K)
    (X : Matrix (Fin b) (Fin b) K) :
    ∀ t < c * (a * b), tflat (Problem18LargeRecoveryCriterion20261001.outerImage A Y X) t =
      prodVal (tflat A) (kflat a b Y X) (a * b) (a * b) t := by
  intro t ht
  obtain ⟨k, i, j, rfl⟩ := decomp3 ht
  rw [tflat_apply]
  have hs : i.val * b + j.val < a * b := idx2_lt i.isLt j.isLt
  have e1 : (k.val * (a * b) + i.val * b + j.val) / (a * b) = k.val := by
    rw [Nat.add_assoc]; exact idx2_div hs
  have e2 : (k.val * (a * b) + i.val * b + j.val) % (a * b) = i.val * b + j.val := by
    rw [Nat.add_assoc]; exact idx2_mod hs
  unfold prodVal
  rw [e1, e2]
  simp only [Problem18LargeRecoveryCriterion20261001.outerImage, Matrix.mul_apply,
    Matrix.transpose_apply, Matrix.kronecker_apply]
  rw [← (finProdFinEquiv (m := a) (n := b)).sum_comp]
  apply Finset.sum_congr rfl
  intro x _
  have hv : (finProdFinEquiv x).val = x.1.val * b + x.2.val := by
    simp [finProdFinEquiv]; ring
  rw [hv, show k.val * (a * b) + (x.1.val * b + x.2.val) =
    k.val * (a * b) + x.1.val * b + x.2.val by ring, tflat_apply, kflat_apply]
  simp [Matrix.kronecker, Matrix.kroneckerMap_apply]
