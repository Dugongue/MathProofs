    _ ≤ _ := Finset.card_union_le _ _
    _ ≤ D * Fintype.card K + Fintype.card K * D := Nat.add_le_add h1 h2
    _ = 2 * D * Fintype.card K := by ring
theorem exists_not_zero (P : K[X][X]) (hP : P ≠ 0) (D : Nat)
    (hdeg : P.natDegree ≤ D) (hlead : P.leadingCoeff.natDegree ≤ D)
    (hq : 2 * D < Fintype.card K) :
    ∃ ab : K × K, (specialize P ab.1).eval ab.2 ≠ 0 := by
  by_contra h
  push_neg at h
  have hall : zeroSet P = Finset.univ := by
    ext ab
    refine ⟨fun _ => Finset.mem_univ _, fun _ => ?_⟩
    change ab ∈ Finset.univ.filter (fun ab : K × K => (specialize P ab.1).eval ab.2 = 0)
    rw [Finset.mem_filter]
