variable [DecidableEq K]
theorem toeplitz_bank (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (w : TNames)
    (hw : w.Valid r q) {B Sn : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ) {N ps qs : ℕ}
    (hN : σ.vars w.Nr = N) (hps : σ.vars w.pS = ps) (hqs : σ.vars w.qS = qs)
    (hpL : rowStart (2 * N + N) N ≤ ps) (hpfit : ps + N ≤ Sn)
    (hqL : rowStart (2 * N + N) N ≤ qs) (hqfit : qs + N ≤ Sn)
    (p qv : Fin N → K)
    (hp : ∀ i : Fin N, val F r q.WS σ (ps + (N - 1 - i.val)) = p i)
    (hqv : ∀ i : Fin N, val F r q.WS σ (qs + (N - 1 - i.val)) = qv i) :
    ∃ τ, Run B (toeplitzCom M q w) σ τ (toeplitzCost M w N) ∧ Slots F r q.WS Sn B τ ∧
      val F r q.WS τ 0 = 0 ∧
      restRows (val F r q.WS τ) (2 * N + N) N 0 =
        (rows (toepGen qv)).map Problem18ArrayElimination20260929.read ∧
      rowVec (val F r q.WS τ) 5 (2 * N + N) =
        Problem18ArrayElimination20260929.read (query (m := N) (toepTarget p)) ∧
      τ.vars q.n = 2 * N ∧ τ.vars q.N = 2 * N + N ∧ τ.vars q.c = N ∧
      τ.vars w.Nr = N ∧ τ.vars w.pS = ps ∧ τ.vars w.qS = qs ∧
      (∀ s < Sn, rowStart (2 * N + N) N ≤ s → val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ y, y ∉ regNames r → y ≠ q.j → y ≠ q.N → y ≠ q.n → y ≠ q.c → y ∉ w.work →
        τ.vars y = σ.vars y) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  obtain ⟨τ, hr, hSτ, hz, hx, hzs, hrow, hid, hout, hn, hNN, hc, hNr, hpS, hqS, hvars, harr, hi,
    ho⟩ := toeplitz_run M q hq w hw hS hN hps hqs hpL hpfit hqL hqfit p qv hp hqv
  refine ⟨τ, hr, hSτ, hz 0 (by omega), ?_, ?_, hn, hNN, hc, hNr, hpS, hqS, hout, hvars, harr, hi,
    ho⟩
  · exact bank_rows (val F r q.WS τ) (toepGen qv) hrow hid
  · exact bank_query (val F r q.WS τ) (toepTarget p) hx hzs
end Consumer
