    intro f hf
    simp only [Finset.coe_insert, Finset.mem_coe, List.mem_toFinset, List.mem_append,
      List.mem_singleton] at hf
    rcases hf with hf | rfl
    · exact Ideal.mem_sup_left (Ideal.subset_span (by simpa using hf))
    · exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
  have hmem := coordCertificate_member (frobeniusDegree M d) (frobeniusSystem Q d vs)
    (frobeniusPolys Q d vs fs) hv' t (y0 t) hJ
  have hsound := coordValue_sound (frobeniusDegree M d) (frobeniusSystem Q d vs)
    (frobeniusPolys Q d vs fs) hv' t hmem
  have h0 := aeval_generatedIdeal (L := k) y0 _ (fun f hf => by
    rw [aeval_self]; exact hroot f hf) _ hsound
  rw [aeval_self, map_sub, eval_X, eval_C, sub_eq_zero] at h0
  exact h0.symm
end Point
section Cost
def coordRowBound (M d s : ℕ) : ℕ :=
  (s + M) * (certificateDegree M (frobeniusDegree M d) 1 + 1) ^ M + 1
def coordColumns (M d : ℕ) : ℕ :=
  (frobeniusDegree M d + certificateDegree M (frobeniusDegree M d) 1 + 1) ^ M
def coordBound (M d s : ℕ) : ℕ :=
  2 * coordRowBound M d s * coordColumns M d +
    (4 * coordColumns M d + 2 * coordRowBound M d s + 2) * coordRowBound M d s ^ 2 +
    coordColumns M d + coordRowBound M d s
def extractConst (M d s : ℕ) : ℕ :=
  M * coordinateFixedCost M d s + M * coordinateSlopeCost M d + M * coordBound M d s
theorem coordCertificate_cost (d : ℕ) (vs : List (DenseInput M d k)) (Q s : ℕ)
    (hs : vs.length ≤ s) (t : Fin M) :
    (coordCertificate (frobeniusDegree M d) (frobeniusSystem Q d vs) t).fieldOps ≤
      coordBound M d s := by
  have h := arrayCertificate_cost (coordRows (frobeniusDegree M d) (frobeniusSystem Q d vs))
    (powerRow (frobeniusDegree M d + certificateDegree M (frobeniusDegree M d) 1) t 1)
  have hlen : (frobeniusSystem Q d vs).length = vs.length + M := by
    simp [frobeniusSystem, coordinateSteps]
  have hr : (coordRows (frobeniusDegree M d) (frobeniusSystem Q d vs)).length ≤
      coordRowBound M d s := by
    rw [coordRows_length, macaulayRows_length, hlen, coordRowBound]
    exact Nat.add_le_add_right (Nat.mul_le_mul (Nat.add_le_add_right hs _)
      (multiplierExponents_length_le _)) _
  have hc : (boundedExponents M (frobeniusDegree M d +
      certificateDegree M (frobeniusDegree M d) 1)).length = coordColumns M d := by
    rw [boundedExponents_length, coordColumns]
  refine h.trans ?_
  generalize (coordRows (frobeniusDegree M d) (frobeniusSystem Q d vs)).length = R at hr ⊢
  rw [hc]
  unfold coordBound
  gcongr
theorem extractPoint_cost (Q d : ℕ) (vs : List (DenseInput M d k)) (s : ℕ)
    (hs : vs.length ≤ s) :
    (extractPoint Q d vs).2 ≤ extractConst M d s * (Nat.size Q + 1) := by
  have hops : ((coordinateSteps Q d vs).map fun t => t.2.2).sum ≤
      M * coordinateFixedCost M d s + M * coordinateSlopeCost M d * Nat.size Q := by
    have h := List.sum_le_card_nsmul ((coordinateSteps Q d vs).map fun t => t.2.2)
      (coordinateFixedCost M d s + coordinateSlopeCost M d * Nat.size Q) (by
        intro x hx
        simp only [coordinateSteps, List.map_map, List.mem_map, List.mem_finRange, true_and,
          Function.comp_apply] at hx
        obtain ⟨i, rfl⟩ := hx
        exact coordinateStep_cost Q d vs s hs i)
    simp only [coordinateSteps, List.map_map, List.length_map, List.length_finRange,
      smul_eq_mul] at h
    simp only [coordinateSteps, List.map_map]
    nlinarith [h]
  have hcert : ((List.finRange M).map fun t =>
      (coordCertificate (frobeniusDegree M d) (frobeniusSystem Q d vs) t).fieldOps).sum ≤
      M * coordBound M d s := by
    have h := List.sum_le_card_nsmul ((List.finRange M).map fun t =>
      (coordCertificate (frobeniusDegree M d) (frobeniusSystem Q d vs) t).fieldOps)
      (coordBound M d s) (by
        intro x hx
        simp only [List.mem_map, List.mem_finRange, true_and] at hx
        obtain ⟨t, rfl⟩ := hx
        exact coordCertificate_cost d vs Q s hs t)
    simpa only [List.length_map, List.length_finRange, smul_eq_mul] using h
  show ((coordinateSteps Q d vs).map fun s => s.2.2).sum +
      ((List.finRange M).map fun t =>
        (coordCertificate (frobeniusDegree M d) (frobeniusSystem Q d vs) t).fieldOps).sum ≤ _
  unfold extractConst
  nlinarith [hops, hcert, Nat.zero_le (Nat.size Q), Nat.zero_le (M * coordinateFixedCost M d s),
    Nat.zero_le (M * coordBound M d s)]
end Cost
