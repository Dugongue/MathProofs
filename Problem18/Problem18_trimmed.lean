variable {K : Type} [Field K] [Fintype K] {b c : ℕ}
theorem symmetric_standard_selfAdjoint (M : Matrix (Fin b) (Fin b) K) (hM : M.IsSymm) :
    (standardForm b).IsSelfAdjoint M.toLin' := by
  intro x y
  simp only [standardForm,Matrix.toBilin'_apply',Matrix.one_mulVec]
  change (M*ᵥx) ⬝ᵥ y=x ⬝ᵥ (M*ᵥy)
  have hh := Matrix.dotProduct_transpose_mulVec M y x
  rw [hM] at hh
  exact (dotProduct_comm _ _).trans hh
theorem gram_det_ne_zero_ker (A : Matrix (Fin c) (Fin b) K)
    (hA : (A.transpose*A).det≠0) : LinearMap.ker A.toLin'=⊥ := by
  apply LinearMap.ker_eq_bot.mpr
  intro x y hxy
  have hi : Function.Injective (fun v => (A.transpose*A)*ᵥv) :=
    Matrix.mulVec_injective_iff_isUnit.mpr
      ((Matrix.isUnit_iff_isUnit_det _).mpr (isUnit_iff_ne_zero.mpr hA))
  apply hi
  change (A.transpose*A)*ᵥx=(A.transpose*A)*ᵥy
  rw [← Matrix.mulVec_mulVec,← Matrix.mulVec_mulVec]
  exact congrArg (fun z => A.transpose*ᵥz) hxy
theorem regular_orthogonal_iff_operator_isometry (hodd : (2:K)≠0)
    (F G : Matrix (Fin c) (Fin b) K) (hG : OrthogonalGood G) :
    MatrixOrthogonalEquivalent F G ↔
      ∃ T : (Fin b→K) ≃ₗ[K] (Fin b→K),
        (∀ x,T ((G.transpose*G).toLin' x)=(F.transpose*F).toLin' (T x)) ∧
        ∀ x y,standardForm b (T x) (T y)=standardForm b x y := by
  constructor
  · intro h
    obtain ⟨Q,hQ,_,hgram⟩ := (orthogonal_boundary_recovery F G).mp h
    refine ⟨orthogonalEquiv Q hQ,?_,orthogonalEquiv_preserves Q hQ⟩
    have hc : Q*(G.transpose*G)=(F.transpose*F)*Q := by
      rw [← hgram,← Matrix.mul_assoc,← Matrix.mul_assoc,
        show Q*Q.transpose=1 from mul_eq_one_comm.mp hQ,Matrix.one_mul]
    intro x
    change Q*ᵥ((G.transpose*G)*ᵥx)=(F.transpose*F)*ᵥ(Q*ᵥx)
    rw [Matrix.mulVec_mulVec,Matrix.mulVec_mulVec,hc]
  · rintro ⟨T,hT,hform⟩
    let Q : Matrix (Fin b) (Fin b) K := T.toLinearMap.toMatrix'
    have hQx (x : Fin b→K) : Q*ᵥx=T x := by
      change (Matrix.toLin' T.toLinearMap.toMatrix') x=T x
      rw [Matrix.toLin'_toMatrix']; rfl
    have hp : (standardForm b).comp Q.toLin' Q.toLin'=standardForm b := by
      apply LinearMap.ext
      intro x
      apply LinearMap.ext
      intro y
      exact (show standardForm b (Q*ᵥx) (Q*ᵥy)=standardForm b x y by rw [hQx,hQx]; exact hform x y)
    have hQ : IsOrthogonal Q := by
      have hh := congrArg LinearMap.BilinForm.toMatrix' hp
      rw [standardForm_pullback_matrix] at hh
      simpa [standardForm,IsOrthogonal] using hh
    have hc : Q*(G.transpose*G)=(F.transpose*F)*Q := by
      apply Matrix.toLin'.injective
      apply LinearMap.ext
      intro x
      change (Q*(G.transpose*G))*ᵥx=((F.transpose*F)*Q)*ᵥx
      calc
        _=Q*ᵥ((G.transpose*G)*ᵥx) := (Matrix.mulVec_mulVec _ _ _).symm
        _=T ((G.transpose*G)*ᵥx) := hQx _
        _=(F.transpose*F)*ᵥ(T x) := hT x
        _=((F.transpose*F)*Q)*ᵥx := by rw [← hQx,Matrix.mulVec_mulVec]
    have hg : Q.transpose*(F.transpose*F)*Q=G.transpose*G := by
      rw [Matrix.mul_assoc,← hc,← Matrix.mul_assoc,show Q.transpose*Q=1 from hQ,Matrix.one_mul]
    have hfg : (F*Q).transpose*(F*Q)=G.transpose*G := by
      simpa only [Matrix.transpose_mul,Matrix.mul_assoc] using hg
    apply (orthogonal_boundary_recovery F G).mpr
    refine ⟨Q,hQ,?_,hg⟩
    simp only [standardMarker,Problem18FiniteSymmetricRecovery20260929.recoveryMarker,dif_neg hodd,
      Problem18FiniteSymmetricRecovery20260929.augment_zero_ker_iff]
    rw [gram_det_ne_zero_ker (F*Q) (by rw [hfg]; exact hG.1),gram_det_ne_zero_ker G hG.1]
def boundaryCandidate (F G : Matrix (Fin c) (Fin b) K) (v w : Fin b→K) :
    Matrix (Fin b) (Fin b) K :=
  krylovMatrix (F.transpose*F).toLin' w*(krylovMatrix (G.transpose*G).toLin' v)⁻¹
theorem odd_boundary_iff_kernel_checks (hodd : ringChar K≠2)
    (F G : Matrix (Fin c) (Fin b) K) (hG : OrthogonalGood G)
    (hχ : (G.transpose*G).charpoly=(F.transpose*F).charpoly)
    (v w : Fin b→K) (hv : PolynomiallyCyclic (G.transpose*G).toLin' v)
    (hw : PolynomiallyCyclic (F.transpose*F).toLin' w) :
    MatrixOrthogonalEquivalent F G ↔ KernelSquareTests (G.transpose*G).toLin'
      ((boundaryCandidate F G v w).transpose*boundaryCandidate F G v w).toLin' := by
  have htwo : (2:K)≠0 := by
    intro h
    letI : CharP K 2 := (CharP.charP_iff_prime_eq_zero (R:=K) Nat.prime_two).mpr h
    exact hodd (ringChar.eq K 2)
  obtain ⟨H,hH,_,hm⟩ := krylov_candidate_intertwines
    (G.transpose*G).toLin' (F.transpose*F).toLin' v w hv hw
    (by simpa only [Matrix.charpoly_toLin'] using hχ)
  let M := boundaryCandidate F G v w
  have hMx (x : Fin b→K) : M*ᵥx=H x := by
    rw [show M=H.toLinearMap.toMatrix' from hm.symm]
    change (Matrix.toLin' H.toLinearMap.toMatrix') x=H x
    rw [Matrix.toLin'_toMatrix']; rfl
  have hc : M*(G.transpose*G)=(F.transpose*F)*M := by
    apply Matrix.toLin'.injective
    apply LinearMap.ext
    intro x
    change (M*(G.transpose*G))*ᵥx=((F.transpose*F)*M)*ᵥx
    calc
      _=M*ᵥ((G.transpose*G)*ᵥx) := (Matrix.mulVec_mulVec _ _ _).symm
      _=H ((G.transpose*G)*ᵥx) := hMx _
      _=(F.transpose*F)*ᵥ(H x) := hH x
      _=((F.transpose*F)*M)*ᵥx := by rw [← hMx,Matrix.mulVec_mulVec]
  have hct : (G.transpose*G)*M.transpose=M.transpose*(F.transpose*F) := by
    simpa only [Matrix.transpose_mul,Matrix.transpose_transpose] using congrArg Matrix.transpose hc
  have hD : ∀ x,(M.transpose*M).toLin' ((G.transpose*G).toLin' x)=
      (G.transpose*G).toLin' ((M.transpose*M).toLin' x) := by
    intro x
    change (M.transpose*M)*ᵥ((G.transpose*G)*ᵥx)=(G.transpose*G)*ᵥ((M.transpose*M)*ᵥx)
    rw [Matrix.mulVec_mulVec,Matrix.mulVec_mulVec]
    congr 1
    rw [Matrix.mul_assoc,hc,← Matrix.mul_assoc,← hct,Matrix.mul_assoc]
  have hp (x y : Fin b→K) : standardForm b (H x) (H y)=standardForm b ((M.transpose*M).toLin' x) y := by
    rw [← hMx,← hMx]
    simp only [standardForm,Matrix.toBilin'_apply',Matrix.one_mulVec]
    change (M*ᵥx) ⬝ᵥ (M*ᵥy)=((M.transpose*M)*ᵥx) ⬝ᵥ y
    rw [← Matrix.mulVec_mulVec]
    exact (Matrix.dotProduct_transpose_mulVec M y (M*ᵥx)).symm.trans (dotProduct_comm _ _)
  rw [regular_orthogonal_iff_operator_isometry htwo F G hG]
  exact intertwining_isometry_iff_kernel_tests (standardForm b) (standardForm b)
    (standardForm_nondegenerate b) (standardForm_nondegenerate b)
    (G.transpose*G).toLin' (M.transpose*M).toLin' (F.transpose*F).toLin'
    (symmetric_standard_selfAdjoint _ (by simp [Matrix.IsSymm,Matrix.transpose_mul])) v hv
    (by simpa only [Matrix.charpoly_toLin'] using hG.2) hodd H hH hD hp
end Mathproof.Problem18OddBoundaryDecision20260930
