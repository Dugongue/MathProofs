theorem smallLoop_run (q : RNames) (cn : CNames) (zn : ZNames) (sn : SNames) (rs : RowSlots)
    {n d : ℕ} (rows : List (DenseInput n d K)) {S B Qv : ℕ} {σ σ₀ : Env}
    (hq : q.Valid r) (hcn : cn.Valid r q) (hz : zn.Valid r q cn) (hsn : sn.Valid r q cn zn)
    (hd : RowDistinct rs n) (hb : RowBelow rs n (inStart (boxSize n d) 0)) (hcb : CoordBlock rs n)
    (hdB : d < B) (hfitS : inStart (boxSize n d) rows.length ≤ S) (hRB : rows.length < B)
    (hQB : Qv < B) (hI0 : LoopInv F r q cn zn sn rs rows S B Qv σ 0 σ₀) :
    ∃ τ : Env, Run B (smallLoop M q cn zn sn rs n d) σ₀ τ
        (smallLoopCost M n d rows.length F.e Qv) ∧
      LoopInv F r q cn zn sn rs rows S B Qv σ Qv τ := by
  let I : Env → Prop := fun τ => ∃ i, i ≤ Qv ∧ LoopInv F r q cn zn sn rs rows S B Qv σ i τ
  let V : Env → ℕ := fun τ => Qv - τ.vars sn.c
  have hdef : ∀ τ, I τ → ∃ v, (Cond.lt (.var sn.c) (.var sn.Q)).evalB B τ = some v := by
    rintro τ ⟨i, hi, hI⟩
    exact ⟨_, evalB_condLt (evalB_var_at hI.c (by omega)) (evalB_var_at hI.Q hQB)⟩
  have hstep : ∀ τ, I τ → (Cond.lt (.var sn.c) (.var sn.Q)).evalB B τ = some true →
      ∃ τ', Run B (smallBody M q cn zn sn rs n d) τ τ' (smallBodyCost M n d rows.length F.e) ∧
        I τ' ∧ V τ' < V τ := by
    rintro τ ⟨i, hi, hI⟩ hc
    have hilt : i < Qv := by
      rw [evalB_condLt (evalB_var_at hI.c (by omega)) (evalB_var_at hI.Q hQB)] at hc
      simpa using hc
    obtain ⟨τ', hrun, hI'⟩ :=
      smallBody_step M q cn zn sn rs rows hq hcn hz hsn hd hb hcb hdB hfitS hRB hQB hI hilt
    refine ⟨τ', hrun, ⟨i + 1, hilt, hI'⟩, ?_⟩
    show Qv - τ'.vars sn.c < Qv - τ.vars sn.c
    rw [hI'.c, hI.c]; omega
  obtain ⟨τ, hrunW, ⟨i, hi, hI⟩, hfalse⟩ :=
    Run.while_count (B := B) (b := Cond.lt (.var sn.c) (.var sn.Q))
      (c := smallBody M q cn zn sn rs n d) I V (smallBodyCost M n d rows.length F.e) hdef hstep
      ⟨0, Nat.zero_le _, hI0⟩
  have hie : i = Qv := by
    rw [evalB_condLt (evalB_var_at hI.c (by omega)) (evalB_var_at hI.Q hQB)] at hfalse
    have : ¬ i < Qv := by simpa using hfalse
    omega
  have hV : V σ₀ = Qv := by
    show Qv - σ₀.vars sn.c = Qv
    rw [hI0.c, Nat.sub_zero]
  have hbsz : (Cond.lt (.var sn.c) (.var sn.Q)).size = 3 := rfl
  have hco : 1 + 3 + smallBodyCost M n d rows.length F.e = smallBodyCost M n d rows.length F.e + 4 := by
    omega
  rw [hV, hbsz, hco] at hrunW
  refine ⟨τ, ?_, hie ▸ hI⟩
  refine hrunW.mono ?_
  simp only [smallLoopCost]
  omega
