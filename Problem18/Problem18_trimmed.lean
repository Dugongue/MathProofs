  rw [dotProduct_single, mul_one]
  simp [Matrix.mulVec, dotProduct, Pi.single_apply]
theorem isAlt_of_quadForm_eq_zero {U : Matrix (Fin n) (Fin n) K}
    (h : ∀ y : Fin n → K, (U *ᵥ y) ⬝ᵥ y = 0) : IsAlt U := by
  have hpolar : ∀ x y : Fin n → K, (U *ᵥ y) ⬝ᵥ x + (U *ᵥ x) ⬝ᵥ y = 0 := by
    intro x y
    have h3 := h (x + y)
    rw [Matrix.mulVec_add, add_dotProduct, dotProduct_add, dotProduct_add] at h3
    linear_combination h3 - h x - h y
