  obtain ⟨σ₃,hr₃,h₃,hv₃,hm₃,hreg₃,_,_,hin₃,hout₃⟩ :=
    copy_run (fieldMacros F) q names_valid stable hl secondExpr (.var gReg) (by simp [VarsIn,stable,secondExpr,firstExpr,plus]) (by simp [VarsIn,stable])
      h₂ he₂ (by simpa only [hg₂] using evalB_var (B:=B) (σ:=σ₂) (x:=gReg) (by rw [hg₂];omega))
