theorem symmetric_matrix_form_rank {n : ℕ} (A : SymMat n K) :
    Module.finrank K (LinearMap.range A.val.toBilin')=A.val.rank := by
  let B := A.val.toBilin'
  have hs : B.IsSymm := Matrix.isSymm_toBilin'_iff_isSymm.mpr A.property
  have hk : LinearMap.ker B=LinearMap.ker A.val.mulVecLin := by
    ext x
    simp only [LinearMap.mem_ker]
    constructor
    · intro hx
      funext i
      have hxi : B x (Pi.single i 1)=0 := by
        simpa using LinearMap.congr_fun hx (Pi.single i 1)
      have hix : B (Pi.single i 1) x=0 := (hs.eq _ _).trans hxi
      change A.val.mulVec x i=0
      simpa only [B,Matrix.toBilin'_apply',single_one_dotProduct] using hix
    · intro hx
      apply LinearMap.ext
      intro y
      rw [hs.eq x y]
      simp only [B,Matrix.toBilin'_apply']
      change A.val.mulVec x=0 at hx
      rw [hx]
      exact dotProduct_zero y
  have h1 := B.finrank_range_add_finrank_ker
  have h2 := A.val.mulVecLin.finrank_range_add_finrank_ker
  rw [hk] at h1
  change Module.finrank K (LinearMap.range B)=Module.finrank K (LinearMap.range A.val.mulVecLin)
  omega
theorem quadratic_polar_rank {n : ℕ} (h2 : (2 : K)≠0) (A : SymMat n K) :
    Module.finrank K (LinearMap.range (quadratic A).polarBilin)=A.val.rank := by
  let B := A.val.toBilin'
  have hs : B.IsSymm := Matrix.isSymm_toBilin'_iff_isSymm.mpr A.property
  have hf : B.flip=B := by ext x y; exact hs.eq _ _
  have hp : (quadratic A).polarBilin=(2 : K) • B := by
    rw [quadratic,LinearMap.BilinMap.polarBilin_toQuadraticMap]
    change B+B.flip=(2 : K) • B
    rw [hf,two_smul]
  have hk : LinearMap.ker (quadratic A).polarBilin=LinearMap.ker B := by
    ext x
    simp only [LinearMap.mem_ker,hp,LinearMap.smul_apply,smul_eq_zero,h2,false_or]
  have h1 := (quadratic A).polarBilin.finrank_range_add_finrank_ker
  have h2' := B.finrank_range_add_finrank_ker
  have h3 := symmetric_matrix_form_rank A
  rw [hk] at h1
  dsimp only [B] at h1 h2'
  omega
theorem repeated_quadratic_average_le (h2 : (2 : K)≠0)
    (a b d : ℕ) (hd : d≤a*b) (A : SymMat b K)
    (ψ : AddChar K ℂ) (hψ : ψ≠1) :
    (∑g : InjectiveSample K (Module.Dual K (Fin a → Fin b → K)) d,
      (‖(∑x : constraintKernel g.val,ψ (∑i,quadratic A (x.val i))) /
        (Fintype.card (constraintKernel g.val) : ℂ)‖^2)^(b-d)) /
      Nat.card (InjectiveSample K (Module.Dual K (Fin a → Fin b → K)) d) ≤
      rankWeight (Fintype.card K : ℝ) a b d A.val.rank := by
  have hh := averaged_quadratic_moment_le (QuadraticMap.pi (fun _ : Fin a => quadratic A))
    d (by simpa [Module.finrank_pi_fintype] using hd) ψ hψ (b-d)
  rw [pi_polar_rank,quadratic_polar_rank h2] at hh
  simpa only [QuadraticMap.pi_apply,Module.finrank_pi_fintype,
    Module.finrank_fintype_fun_eq_card,Fintype.card_fin,Finset.sum_const,
    Finset.card_univ,smul_eq_mul,Module.finrank_self,mul_one,rankWeight] using hh
theorem positive_symmetric_energy_average_le (h2 : (2 : K)≠0)
    (a b d : ℕ) (ha : 2≤a) (hb : 8≤b) (hdb : 64*d≤b)
    (ψ : AddChar K ℂ) (hψ : ψ≠1) :
    (∑g : InjectiveSample K (Module.Dual K (Fin a → Fin b → K)) d,
      ∑A : {A : SymMat b K // A.val.rank≠0},
      (‖(∑x : constraintKernel g.val,ψ (∑i,quadratic A.val (x.val i))) /
        (Fintype.card (constraintKernel g.val) : ℂ)‖^2)^(b-d)) /
      Nat.card (InjectiveSample K (Module.Dual K (Fin a → Fin b → K)) d) ≤
      64*(b : ℝ)*(d+1 : ℕ)*((Fintype.card K : ℝ)^(b/4))⁻¹ := by
  apply le_trans ?_ (symmetric_weighted_average_bound (K := K) a b d ha hb hdb)
  rw [Finset.sum_comm,Finset.sum_div]
  apply Finset.sum_le_sum
  intro A hA
  exact repeated_quadratic_average_le h2 a b d (by nlinarith) A.val ψ hψ
end Mathproof.Problem18OddConditionedQuadratic20260930
