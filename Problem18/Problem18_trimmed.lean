variable {K : Type} [Field K] [Fintype K]
def modulusSetupState (F : FieldPresentation K) (sigma : Env) : Env :=
  ((sigma.setVar copyCount F.e).setVar externalBase 0).setVar nativeBase 0
theorem modulusCopySetup_run {B : Nat} (F : FieldPresentation K) (sigma : Env)
    (he : sigma.vars canonical.e=F.e) (heB : F.e<B) :
    Run B modulusCopySetup sigma (modulusSetupState F sigma) 7 := by
  have ee : (Expr.var canonical.e).evalB B sigma=some F.e := by
    rw [evalB_var_iff,he]
    exact ⟨rfl,heB⟩
  have ez1 : (Expr.lit 0).evalB B (sigma.setVar copyCount F.e)=some 0 :=
    evalB_lit (by omega)
  have ez2 : (Expr.lit 0).evalB B
      ((sigma.setVar copyCount F.e).setVar externalBase 0)=some 0 :=
    evalB_lit (by omega)
  exact ((Run.assign ee).seq ((Run.assign ez1).seq
    ((Run.assign ez2).seq Run.skip))).mono (by
      simp [modulusCopySetup,assignAll,modulusSetupState,Expr.size])
structure ModulusCopyInput {K : Type} [Field K] [Fintype K]
    (F : FieldPresentation K) (B : Nat) (sigma : Env) : Prop where
  nativeValid : ValidMemory F B sigma
  modBase_zero : sigma.vars canonical.modBase=0
  work_word : (sigma.arrs workBank).length<B
  work_fit : F.e≤(sigma.arrs workBank).length
  work_coefficients : ∀j<(sigma.arrs workBank).length,
    (sigma.arrs workBank).getD j 0<F.p
theorem modulusCopy_run {K : Type} [Field K] [Fintype K]
    (F : FieldPresentation K) {B : Nat} (sigma : Env)
    (h : ModulusCopyInput F B sigma) :
    ∃tau, Run B modulusCopy sigma tau (20*F.e+13) ∧
      ValidMemory F B (externalState tau) ∧
      ((externalState tau).arrs canonical.mem).length=(sigma.arrs workBank).length ∧
      tau.arrs canonical.mem=sigma.arrs canonical.mem ∧
      (∀a,a≠workBank→tau.arrs a=sigma.arrs a) ∧
      (∀x,x≠copyIndex→x≠copyCount→x≠externalBase→x≠nativeBase→
        tau.vars x=sigma.vars x) ∧
      tau.inp=sigma.inp ∧ tau.out=sigma.out := by
  let rho:=modulusSetupState F sigma
  have heB : F.e<B:=h.nativeValid.degree_word
  have hsetup : Run B modulusCopySetup sigma rho 7 :=
    modulusCopySetup_run F sigma h.nativeValid.degree heB
  have hrhoe : rho.vars canonical.e=F.e := by
    simpa [rho,modulusSetupState,canonical,copyCount,externalBase,nativeBase] using
      h.nativeValid.degree
  have hcount : (externalState rho).vars copyCount=F.e := by
    simp [externalState,rho,modulusSetupState,copyCount,externalBase,nativeBase]
  have hsource : (externalState rho).vars externalBase=0 := by
    simp [externalState,rho,modulusSetupState,copyCount,externalBase,nativeBase]
  have htarget : (externalState rho).vars nativeBase=0 := by
    simp [externalState,rho,modulusSetupState,copyCount,externalBase,nativeBase]
  have hpB : F.p<B := by
    have hh:=h.nativeValid.arithmetic_word
    nlinarith
  have hsourceWord : ∀k<F.e,
      ((externalState rho).arrs workBank).getD (0+k) 0<B := by
    intro k hk
    have hkB : (sigma.arrs canonical.mem).getD k 0<B := (h.nativeValid.coefficients k (by
      have hf:=h.nativeValid.modulus_fit
      rw [h.modBase_zero] at hf
      omega)).trans hpB
    simpa [externalState,rho,modulusSetupState,bankSwap,workBank] using hkB
  obtain ⟨eta,hcopy,hcells,houtside,harrays,hvars,hi,ho⟩:=
    copyGram_run (B:=B) (n:=F.e) (sourceBase:=0) (targetBase:=0)
      (externalState rho) heB hcount hsource htarget
      (by omega)
      (by omega)
      (by simpa [externalState,rho,modulusSetupState,bankSwap,workBank,h.modBase_zero] using
        h.nativeValid.modulus_fit)
      (by simpa [externalState,rho,modulusSetupState,bankSwap,workBank] using h.work_fit)
      hsourceWord
  let tau:=renameEnv bankSwap eta
  have hrho : renameEnv bankSwap (externalState rho)=rho := by
    simpa [externalState,bankSwap] using renameEnv_symm bankSwap rho
  have htau : externalState tau=eta := by
    simpa [externalState,tau,bankSwap] using renameEnv_symm bankSwap eta
  have hrunCopy : Run B (renameCom bankSwap copyGram) rho tau (20*F.e+6) := by
    simpa [hrho,tau] using rename_run bankSwap hcopy
  have hetaLen : (eta.arrs canonical.mem).length=(sigma.arrs workBank).length := by
    calc
      (eta.arrs canonical.mem).length=
          ((externalState rho).arrs canonical.mem).length :=
        (run_frame hcopy).2.2.1 _
      _=(sigma.arrs workBank).length := by
        simp [externalState,rho,modulusSetupState,bankSwap,workBank]
  have hetaScratch : eta.arrs canonical.scratch=sigma.arrs canonical.scratch := by
    calc
      eta.arrs canonical.scratch=(externalState rho).arrs canonical.scratch :=
        harrays _ (by decide)
      _=sigma.arrs canonical.scratch := by
        change sigma.arrs (bankSwap.symm canonical.scratch)=sigma.arrs canonical.scratch
        congr 1
  have hetaMod : eta.vars canonical.modBase=0 := by
    rw [hvars _ (by decide)]
    simpa [externalState,rho,modulusSetupState,canonical,copyCount,externalBase,nativeBase]
      using h.modBase_zero
  have hetaE : eta.vars canonical.e=F.e := by
    rw [hvars _ (by decide)]
    exact hrhoe
  have hetaP : eta.vars canonical.p=F.p := by
    rw [hvars _ (by decide)]
    simpa [externalState,rho,modulusSetupState,canonical,copyCount,externalBase,nativeBase]
      using h.nativeValid.prime
  have hetaValid : ValidMemory F B eta := by
    refine {
      degree:=hetaE
      prime:=hetaP
      arithmetic_word:=h.nativeValid.arithmetic_word
      inverse_word:=h.nativeValid.inverse_word
      memory_word:=by rw [hetaLen];exact h.work_word
      scratch_word:=by rw [hetaScratch];exact h.nativeValid.scratch_word
      scratch_fit:=by rw [hetaScratch];exact h.nativeValid.scratch_fit
      modulus_fit:=by rw [hetaMod,hetaLen];simpa only [Nat.zero_add] using h.work_fit
      modulus_value:=?_
      coefficients:=?_ }
    · intro i
      unfold Problem18IMPFieldMultiplication20261001.sourceCoeff
      rw [hetaMod]
      rw [hcells i.val i.isLt]
      calc
        ((externalState rho).arrs workBank).getD (0+i.val) 0 =
            (sigma.arrs canonical.mem).getD i.val 0 := by
          simp [externalState,rho,modulusSetupState,bankSwap,workBank]
        _ = (F.modulus i).val := by
          simpa only [Problem18IMPFieldMultiplication20261001.sourceCoeff,
            h.modBase_zero,Nat.zero_add] using h.nativeValid.modulus_value i
    · intro j hj
      by_cases hlo:j<F.e
      · rw [show (eta.arrs canonical.mem).getD j 0=
          ((externalState rho).arrs workBank).getD j 0 by
            simpa only [Nat.zero_add] using hcells j hlo]
        simpa [externalState,rho,modulusSetupState,bankSwap,workBank] using
          h.nativeValid.coefficients j (by
          have hf:=h.nativeValid.modulus_fit
          rw [h.modBase_zero] at hf
          omega)
      · rw [houtside j (Or.inr (by omega))]
        apply h.work_coefficients j
        simpa [hetaLen] using hj
  refine ⟨tau,(hsetup.seq hrunCopy).mono (by omega),?_,?_,?_,?_,?_,?_,?_⟩
  · simpa only [htau] using hetaValid
  · simpa only [htau] using hetaLen
  · change eta.arrs (bankSwap canonical.mem)=sigma.arrs canonical.mem
    change eta.arrs workBank=sigma.arrs canonical.mem
    calc
      eta.arrs workBank=(externalState rho).arrs workBank := harrays _ (by decide)
      _=sigma.arrs canonical.mem := by
        simp [externalState,rho,modulusSetupState,bankSwap,workBank]
  · intro a ha
    change eta.arrs (bankSwap a)=sigma.arrs a
    by_cases hcan:a=canonical.mem
    · subst a
      simp [bankSwap,workBank]
      exact harrays workBank (by decide)
    · have hswap : bankSwap a≠canonical.mem := by
        intro hh
        have hback:=congrArg bankSwap hh
        simp [bankSwap,workBank] at hback
        exact ha hback
      rw [harrays _ hswap]
      simp [externalState,rho,modulusSetupState,bankSwap]
  · intro x hxi hxc hxe hxn
    change eta.vars x=sigma.vars x
    rw [hvars x hxi]
    simp [externalState,rho,modulusSetupState,hxc,hxe,hxn]
  · simpa [tau,renameEnv,externalState,rho,modulusSetupState] using hi
  · simpa [tau,renameEnv,externalState,rho,modulusSetupState] using ho
end Mathproof.Problem18P36BoundaryRoutedController20261003
