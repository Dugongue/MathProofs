def IrredDimT {n : Nat} (fs : List (MvPolynomial (Fin n) K)) (t : Nat) : Prop :=
  ∃ P : Ideal (MvPolynomial (Fin n) L),
    (geometricIdeal (L := L) (systemSet fs)).minimalPrimes = {P} ∧
    Algebra.trdeg L (MvPolynomial (Fin n) L ⧸ P) = (t : Cardinal)
theorem rational_of_irredDimT_zero {n : Nat} (fs : List (MvPolynomial (Fin n) K))
    (h : IrredDimT L fs 0) : ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0 := by
  obtain ⟨P, hP, hdim⟩ := h
  have hmem : P ∈ (geometricIdeal (L := L) (systemSet fs)).minimalPrimes := by
    rw [hP]; exact Set.mem_singleton P
  haveI : P.IsPrime := hmem.isPrime
  have hmax : P.IsMaximal := isMaximal_of_trdeg_eq_zero (k := L) P (by simpa using hdim)
  exact fixed_zero_dim_component_rational_point (systemSet fs) P hmem hmax
    (unique_component_fixed L fs P hP)
structure PointBridgeT (n d : Nat) where
  Qcurve : Nat
  Qpencil : Nat
  dDesc : Nat
  one_le_dDesc : 1 ≤ dDesc
  curve_point : ∀ fs : List (MvPolynomial (Fin n) K), Bounded dDesc fs → IrredDimT L fs 1 →
    Qcurve < Fintype.card K → ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0
  section_step : ∀ (fs : List (MvPolynomial (Fin n) K)) (t : Nat), Bounded dDesc fs → 2 ≤ t →
    IrredDimT L fs t → Qpencil < Fintype.card K →
    ∃ (i j : Fin n) (a b : K) (t' : Nat), t' < t ∧ IrredDimT L (sectionSystem fs i j a b) t'
  descent : ∀ (fs : List (MvPolynomial (Fin n) K)), Bounded d fs → HasFixedComponent L fs →
    ∃ (gs : List (MvPolynomial (Fin n) K)) (t : Nat), Bounded dDesc gs ∧ IrredDimT L gs t ∧
      ∀ x : Fin n → K, (∀ g ∈ gs, eval x g = 0) → ∀ f ∈ fs, eval x f = 0
theorem rational_of_irredDimT {n d : Nat} (B : PointBridgeT (K := K) L n d)
    (hqc : B.Qcurve < Fintype.card K) (hqp : B.Qpencil < Fintype.card K) :
    ∀ (t : Nat) (fs : List (MvPolynomial (Fin n) K)), Bounded B.dDesc fs → IrredDimT L fs t →
      ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0 := by
  intro t
  induction t using Nat.strong_induction_on with
  | _ t ih =>
    intro fs hb hirr
    match t with
    | 0 => exact rational_of_irredDimT_zero L fs hirr
    | 1 => exact B.curve_point fs hb hirr hqc
    | t + 2 =>
      obtain ⟨i, j, a, b, t', ht', hsec⟩ := B.section_step fs (t + 2) hb (by omega) hirr hqp
      obtain ⟨x, hx⟩ := ih t' ht' _ (bounded_append_linear B.one_le_dDesc fs hb i j a b) hsec
      exact ⟨x, fun f hf => hx f (List.mem_append_left _ hf)⟩
theorem pointExistence_of_bridgeT {n d : Nat} (B : PointBridgeT (K := K) L n d)
    (fs : List (MvPolynomial (Fin n) K)) (hb : Bounded d fs)
    (hq : max B.Qcurve B.Qpencil < Fintype.card K) (hfix : HasFixedComponent L fs) :
    ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0 := by
  obtain ⟨gs, t, hgb, hirr, hsub⟩ := B.descent fs hb hfix
  obtain ⟨x, hx⟩ := rational_of_irredDimT L B (lt_of_le_of_lt (le_max_left _ _) hq)
    (lt_of_le_of_lt (le_max_right _ _) hq) t gs hgb hirr
  exact ⟨x, hsub x hx⟩
end Mathproof.Problem18ClaudePointBridgeT20261001
