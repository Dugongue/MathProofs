variable {K : Type} [Field K] [Fintype K] [DecidableEq K] {F : FieldPresentation K}
  {r : FieldNames}
theorem boxSize_eq_lenD (n d : ℕ) : boxSize n d = lenD n d := rfl
def feasCost (M : FieldMacros F r) (q : RNames) (gn : GNames) (n d e R : ℕ) : ℕ :=
  8 + (4 + (copyCost M (.var gn.inB) (.lit (inStart (boxSize n d) 0)) (R * boxSize n d) +
    (2 + (geoCost M q gn n d e R + (4 +
      (copyCost M (.lit (inStart (boxSize n d) 0)) (.var gn.inB) (R * boxSize n d) + (2 + 2)))))))
theorem copyCost_mono (M : FieldMacros F r) (D S : Expr) {a b : ℕ} (h : a ≤ b) :
    copyCost M D S a ≤ copyCost M D S b := by
  unfold copyCost
  have := Nat.mul_le_mul_left (4 + copyStep M D S) h
  omega
theorem geoCost_mono (M : FieldMacros F r) (q : RNames) (gn : GNames) (n d e : ℕ) {a b : ℕ}
    (h : a ≤ b) : geoCost M q gn n d e a ≤ geoCost M q gn n d e b := by
  unfold geoCost macCost
  have h1 := Nat.mul_le_mul_left (4 + macStep M gn.mn n d (geoE n d)) h
  have h2 := reduceCost_mono M q (lenL n d (geoE n d)) (lenL n d (geoE n d))
    (Nat.mul_le_mul_right (lenM n (geoE n d)) h)
  omega
theorem feasCost_mono (M : FieldMacros F r) (q : RNames) (gn : GNames) (n d e : ℕ) {a b : ℕ}
    (h : a ≤ b) : feasCost M q gn n d e a ≤ feasCost M q gn n d e b := by
  unfold feasCost
  have hN := Nat.mul_le_mul_right (boxSize n d) h
  have h1 := copyCost_mono M (.var gn.inB) (.lit (inStart (boxSize n d) 0)) hN
  have h2 := copyCost_mono M (.lit (inStart (boxSize n d) 0)) (.var gn.inB) hN
  have h3 := geoCost_mono M q gn n d e h
  omega
