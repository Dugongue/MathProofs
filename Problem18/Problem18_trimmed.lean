def PB (N x K d : Nat) : Prop := 1 ≤ N ∧ x ≤ K * N ^ d
theorem PB.lit {N : Nat} (n : Nat) (hN : 1 ≤ N) : PB N n n 0 :=
  ⟨hN, by simp⟩
theorem PB.var {N x : Nat} (hN : 1 ≤ N) (h : x ≤ N) : PB N x 1 1 :=
  ⟨hN, by simpa using h⟩
theorem PB.raise {N x K d d' : Nat} (h : PB N x K d) (hd : d ≤ d') : PB N x K d' := by
  refine ⟨h.1, h.2.trans ?_⟩
  exact Nat.mul_le_mul_left K (Nat.pow_le_pow_right h.1 hd)
theorem PB.add {N x y K1 K2 d1 d2 : Nat} (hx : PB N x K1 d1) (hy : PB N y K2 d2) :
    PB N (x + y) (K1 + K2) (max d1 d2) := by
  have hx' := hx.raise (le_max_left d1 d2)
  have hy' := hy.raise (le_max_right d1 d2)
  refine ⟨hx.1, ?_⟩
  have := Nat.add_le_add hx'.2 hy'.2
  simpa [Nat.add_mul] using this
theorem PB.mul {N x y K1 K2 d1 d2 : Nat} (hx : PB N x K1 d1) (hy : PB N y K2 d2) :
    PB N (x * y) (K1 * K2) (d1 + d2) := by
  refine ⟨hx.1, ?_⟩
  calc x * y ≤ (K1 * N ^ d1) * (K2 * N ^ d2) := Nat.mul_le_mul hx.2 hy.2
    _ = K1 * K2 * N ^ (d1 + d2) := by rw [pow_add]; ring
theorem PB.pow {N x K d : Nat} (k : Nat) (hx : PB N x K d) :
    PB N (x ^ k) (K ^ k) (d * k) := by
  refine ⟨hx.1, ?_⟩
  calc x ^ k ≤ (K * N ^ d) ^ k := Nat.pow_le_pow_left hx.2 k
    _ = K ^ k * N ^ (d * k) := by rw [mul_pow, ← pow_mul]
theorem PB.sub {N x K d : Nat} (y : Nat) (hx : PB N x K d) : PB N (x - y) K d :=
  ⟨hx.1, (Nat.sub_le x y).trans hx.2⟩
theorem PB.div {N x K d : Nat} (y : Nat) (hx : PB N x K d) : PB N (x / y) K d :=
  ⟨hx.1, (Nat.div_le_self x y).trans hx.2⟩
theorem PB.bound {N x K d C D : Nat} (hx : PB N x K d) (hK : K ≤ C) (hd : d ≤ D) :
    x ≤ C * N ^ D :=
  hx.2.trans (Nat.mul_le_mul hK (Nat.pow_le_pow_right hx.1 hd))
syntax "pb_solve " term : tactic
macro_rules
  | `(tactic| pb_solve $hN) =>
    `(tactic| repeat (first
        | with_reducible assumption
        | with_reducible apply PB.add
        | with_reducible apply PB.mul
        | with_reducible apply PB.pow
        | with_reducible apply PB.sub
        | with_reducible apply PB.div
        | (with_reducible apply PB.var $hN; with_reducible assumption)
        | with_reducible exact PB.lit _ $hN))
end Mathproof.Problem18P36LargePolyBound20261004
end
