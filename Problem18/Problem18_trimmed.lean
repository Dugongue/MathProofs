      rw [evalB_congr_varsIn (toL τ hfix) D hDp]; exact hDv
    have hSτv : S.evalB B τ = some sv := by
      rw [evalB_congr_varsIn (toL τ hfix) S hSp]; exact hSv
    obtain ⟨τ1, hr1, hv1, hc1⟩ := slot_call F r M.copy_spec hSτ (plus S (.var q.j))
      (plus S (.var q.j)) (plus D (.var q.j)) (evalB_plus_var hSτv rfl (by omega))
      (evalB_plus_var hSτv rfl (by omega)) (evalB_plus_var hDτ rfl (by omega))
      ⟨hlA S hSp, hjA⟩ ⟨hlA D hDp, hjA⟩ ⟨hlB D hDp, hjB⟩ (by omega) (by omega) (by omega)
      (by omega) (by omega)
    have hj1 : τ1.vars q.j = τ.vars q.j := call_regs_all hc1 q.j hjS
    have hinc : (plus (.var q.j) (.lit 1)).evalB B τ1 = some (τ.vars q.j + 1) := by
      unfold plus
      exact evalB_bin (by rw [← hj1]; exact evalB_var (by rw [hj1]; omega)) (evalB_lit (by omega))
        (by change τ.vars q.j + 1 < B; omega)
    refine ⟨τ1.setVar q.j (τ.vars q.j + 1), ?_, ⟨Slots.setVar F r hc1.slots hjS hjW _, ?_, ?_,
      ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
    · refine (hr1.seq (Run.assign hinc)).mono ?_
      have e1 : (plus S (Expr.var q.j)).size = S.size + 2 := rfl
      have e2 : (plus D (Expr.var q.j)).size = D.size + 2 := rfl
      have e3 : (plus (Expr.var q.j) (Expr.lit 1)).size = 3 := rfl
      rw [e1, e2, e3]; unfold copyStep; omega
    · simp only [vars_setVar, if_true]; omega
    · intro x hx hxj
      simp only [vars_setVar, if_neg hxj]
      rw [call_regs_all hc1 x hx]; exact hfix x hx hxj
    · intro m hm
      rw [val_setVar F r hjW]
      simp only [vars_setVar, if_true]
      by_cases hmk : m = τ.vars q.j
      · rw [hmk, if_pos (Nat.lt_succ_self _), hv1, hfr _ (by omega) (by omega)]
      · rw [call_val hc1 (by omega) (by omega : dv + m ≠ dv + τ.vars q.j), hdst m hm]
        by_cases hlt : m < τ.vars q.j
        · rw [if_pos hlt, if_pos (by omega)]
        · rw [if_neg hlt, if_neg (by omega)]
    · intro s hs hout'
      rw [val_setVar F r hjW, call_val hc1 hs (by omega)]
      exact hfr s hs hout'
    · intro a h1 h2
      simp only [arrs_setVar]; rw [hc1.arrays a h1 h2]; exact harr a h1 h2
    · simp only [inp_setVar]; rw [hc1.inp]; exact hinp
    · simp only [out_setVar]; rw [hc1.out]; exact hout
    · simp only [vars_setVar, if_true]; omega
  obtain ⟨τf, hrf, hIf, hcf⟩ := Run.while_count I (fun τ => Nv - τ.vars q.j) (copyStep M D S)
    hdef hstep hI0
  have hNf := hNτ τf hIf
  obtain ⟨hSf, hjf, hfixf, hdstf, hfrf, harrf, hinpf, houtf⟩ := hIf
  have hjeq : τf.vars q.j = Nv := by
    rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hNf]; omega))] at hcf
    simp only [Option.some.injEq, decide_eq_false_iff_not, not_lt] at hcf
    rw [hNf] at hcf; omega
  refine ⟨τf, ?_, hSf, ?_, hfrf, hfixf, hjeq, harrf, hinpf, houtf⟩
  · refine ((Run.assign (x := q.j) (evalB_lit (σ := σ) (by omega : 0 < B))).seq hrf).mono ?_
    simp only [vars_setVar, eq_self_iff_true, if_true, ite_true, Nat.sub_zero]
    have e1 : (Expr.lit 0).size = 1 := rfl
    have e2 : (Cond.lt (Expr.var q.j) (Expr.var q.N)).size = 3 := rfl
    rw [e1, e2]; unfold copyCost; ring_nf; try omega
  · intro k hk; rw [hdstf k hk, if_pos (by omega)]
