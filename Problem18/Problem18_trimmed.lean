namespace Mathproof.Problem18PairLargeTape20261004
open Lax13Proofs.Imp Lax13Proofs.Reasoning Problem18IMPFieldLayout20261001
def readFree : Com → Bool
  | .read _ => false
  | .seq c d => readFree c && readFree d
  | .ite _ c d => readFree c && readFree d
  | .while _ c => readFree c
  | _ => true
def writeFree : Com → Bool
  | .write _ => false
  | .seq c d => writeFree c && writeFree d
  | .ite _ c d => writeFree c && writeFree d
  | .while _ c => writeFree c
  | _ => true
theorem noRead_of : ∀ c : Com, readFree c = true → noRead c
  | .skip, _ => trivial
  | .assign _ _, _ => trivial
  | .store _ _ _, _ => trivial
  | .read _, h => absurd h (by simp [readFree])
  | .write _, _ => trivial
  | .seq c d, h => by
    simp only [readFree, Bool.and_eq_true] at h
    exact ⟨noRead_of c h.1, noRead_of d h.2⟩
  | .ite _ c d, h => by
    simp only [readFree, Bool.and_eq_true] at h
    exact ⟨noRead_of c h.1, noRead_of d h.2⟩
  | .while _ c, h => noRead_of c h
theorem noWrite_of : ∀ c : Com, writeFree c = true → c.NoWrite
  | .skip, _ => trivial
  | .assign _ _, _ => trivial
  | .store _ _ _, _ => trivial
  | .read _, _ => trivial
  | .write _, h => absurd h (by simp [writeFree])
  | .seq c d, h => by
    simp only [writeFree, Bool.and_eq_true] at h
    exact ⟨noWrite_of c h.1, noWrite_of d h.2⟩
  | .ite _ c d, h => by
    simp only [writeFree, Bool.and_eq_true] at h
    exact ⟨noWrite_of c h.1, noWrite_of d h.2⟩
  | .while _ c, h => noWrite_of c h
theorem tape_frame {B K : Nat} {c : Com} {σ τ : Env} (h : Run B c σ τ K)
    (hr : readFree c = true) (hw : writeFree c = true) : τ.inp = σ.inp ∧ τ.out = σ.out :=
