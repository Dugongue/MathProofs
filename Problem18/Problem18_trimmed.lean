theorem loop_run {B S : Nat} (L : Layout) (σ0 : Env) (hok : L.Ok S)
    (hmb : σ0.vars canonical.modBase+F.e ≤ σ0.vars ws)
    (D : Matrix (Fin L.n) (Fin L.n) K) (total : Nat) (ρ : Env)
    (hg : Good F L S B σ0 ρ) (hvB : ρ.vars exponentReg<B)
    (hinv : mat F L (σ0.vars ws) L.acc ρ * (mat F L (σ0.vars ws) L.base ρ)^(ρ.vars exponentReg)=
      D^total) :
    ∃τ K, Run B (loop L) ρ τ K ∧ K ≤ (4+bodyCost F.e L.n)*Nat.size (ρ.vars exponentReg)+4 ∧
      Good F L S B σ0 τ ∧ τ.vars exponentReg=0 ∧ mat F L (σ0.vars ws) L.acc τ=D^total := by
  let I : Env → Prop := fun ρ => Good F L S B σ0 ρ ∧ ρ.vars exponentReg<B ∧
    mat F L (σ0.vars ws) L.acc ρ * (mat F L (σ0.vars ws) L.base ρ)^(ρ.vars exponentReg)=D^total
  let Φ : Env → Nat := fun ρ => (4+bodyCost F.e L.n)*Nat.size (ρ.vars exponentReg)
  have hdef : ∀ρ, I ρ → ∃v, (Cond.lt (.lit 0) (.var exponentReg)).evalB B ρ=some v := by
    intro ρ h
    exact ⟨_, evalB_condLt (evalB_lit (show 0<B by have := h.2.1; omega)) (evalB_var h.2.1)⟩
  have hstep : ∀ρ, I ρ → (Cond.lt (.lit 0) (.var exponentReg)).evalB B ρ=some true →
      ∃τ K, Run B (body L) ρ τ K ∧ I τ ∧
        1+(Cond.lt (.lit 0) (.var exponentReg)).size+K+Φ τ ≤ Φ ρ := by
    intro ρ h ht
    obtain ⟨hgρ,hvρ,hiρ⟩ := h
    have htest := evalB_condLt (evalB_lit (σ:=ρ) (show 0<B by omega)) (evalB_var hvρ)
    rw [ht] at htest
    have hpos : 0<ρ.vars exponentReg := by simpa using htest.symm
    obtain ⟨τ,hr,hgτ,hx,hacc,hbase⟩ := body_run F L σ0 ρ hok hmb hgρ hvρ
    refine ⟨τ,_,hr,⟨hgτ,by rw [hx]; omega,?_⟩,?_⟩
    · rw [hx, hacc]
      rw [← hiρ]
      exact invariant_step _ _ _ _ hbase
    · simp only [Φ, Cond.size, Expr.size]
      rw [hx, ← size_half hpos, Nat.mul_add, Nat.mul_one]
      omega
  obtain ⟨τ,K,hr,⟨hgτ,hvτ,hiτ⟩,hfalse,hK⟩ := Run.while_potential I Φ hdef hstep ⟨hg,hvB,hinv⟩
  have htest := evalB_condLt (evalB_lit (σ:=τ) (show 0<B by omega)) (evalB_var hvτ)
  rw [hfalse] at htest
  have hzero : τ.vars exponentReg=0 := by
    have hh : ¬0<τ.vars exponentReg := by simpa using htest.symm
    omega
  refine ⟨τ,K,hr,?_,hgτ,hzero,?_⟩
  · simp only [Φ, Cond.size, Expr.size] at hK
    omega
  · rw [hzero, pow_zero, mul_one] at hiτ
    exact hiτ
def controlNames : List String := [exponentReg,halfReg,indexReg]++setupNames
theorem program_writes (L : Layout) (x : String)
