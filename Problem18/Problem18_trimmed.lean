open scoped BigOperators
open Classical
open Mathproof.Problem18FourierCore20260930
open Mathproof.Problem18FourierVariation20260930
open Mathproof.Problem18ProbabilityAssembly20260930
theorem averaged_uniform_sum_variation_le
    {Ω G : Type*} [Fintype Ω] [Nonempty Ω] [DecidableEq Ω]
    [AddCommGroup G] [Fintype G]
    {V : Ω → Type*} [∀ ω, Fintype (V ω)] [∀ ω, Nonempty (V ω)]
    (P : ∀ ω, V ω → G) (m : ℕ) (E : ℝ) (hE : 0 ≤ E)
    (henergy :
      (∑ ω, ∑ χ : AddChar G ℂ, if χ = 1 then 0 else
        (‖(∑ x : V ω, χ (P ω x)) / (Fintype.card (V ω) : ℂ)‖^2)^m) /
        (Fintype.card Ω : ℝ) ≤ E) :
    (∑ ω,
      (∑ y, ‖uniformImageWeight (fun x : Fin m → V ω => ∑ j, P ω (x j)) y -
        (Fintype.card G : ℂ)⁻¹‖) / 2) / (Fintype.card Ω : ℝ) ≤
      Real.sqrt (E / 4) := by
  let tv : Ω → ℝ := fun ω =>
    (∑ y, ‖uniformImageWeight (fun x : Fin m → V ω => ∑ j, P ω (x j)) y -
      (Fintype.card G : ℂ)⁻¹‖) / 2
  let en : Ω → ℝ := fun ω => ∑ χ : AddChar G ℂ, if χ = 1 then 0 else
    (‖(∑ x : V ω, χ (P ω x)) / (Fintype.card (V ω) : ℂ)‖^2)^m
  have hN : 0 < (Fintype.card Ω : ℝ) := by positivity
  have he : (∑ ω, en ω) ≤ E * (Fintype.card Ω : ℝ) :=
    (div_le_iff₀ hN).mp henergy
  have hp (ω : Ω) : tv ω ^ 2 ≤ en ω / 4 :=
    uniform_sum_fourier_energy_bound (P ω) m
  have hs : (∑ ω, tv ω ^ 2) ≤ (E / 4) * (Fintype.card Ω : ℝ) := by
    calc
      _ ≤ ∑ ω, en ω / 4 := Finset.sum_le_sum (fun ω _ => hp ω)
      _ = (∑ ω, en ω) / 4 := (Finset.sum_div _ _ _).symm
      _ ≤ (E / 4) * (Fintype.card Ω : ℝ) := by linarith
  have ht := weighted_event_probability_le_sqrt tv Finset.univ (E / 4)
    (fun ω => by dsimp [tv]; positivity) (by positivity) hs
  simpa only [Finset.card_univ, div_self (ne_of_gt hN), mul_one]
    using ht
end Mathproof.Problem18AveragedVariation20260930
end
