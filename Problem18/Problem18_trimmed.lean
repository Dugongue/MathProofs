namespace Mathproof.Problem18SquarefreeDensityBoundary20260930
open Polynomial
open scoped BigOperators
open Mathproof.Problem18MonicDivisibilityBoundary20260930
open Mathproof.Problem18SquarefreeSieveBoundary20260930
variable {K : Type*} [Field K] [Finite K]
noncomputable def contribution (n d : ℕ) : ℝ :=
  (Nat.card (NonzeroIrreducibleDegree (K := K) d) * repeatCount (K := K) n d : ℕ) /
    (Nat.card K : ℝ)^n
theorem field_card_real_two : (2 : ℝ) ≤ Nat.card K := by
  exact_mod_cast (show 2 ≤ Nat.card K from Finite.one_lt_card)
theorem contribution_le_quotient (n d : ℕ) :
    contribution (K := K) n d ≤
      (Nat.card (NonzeroIrreducibleDegree (K := K) d) : ℝ) /
        ((Nat.card K : ℝ)^d * (Nat.card K : ℝ)^d) := by
  have hq : (0 : ℝ) < Nat.card K := lt_of_lt_of_le (by norm_num) (field_card_real_two (K := K))
  unfold contribution repeatCount
  split_ifs with hd
  · push_cast
    have hp : (Nat.card K : ℝ)^(n-2*d)*
        ((Nat.card K : ℝ)^d*(Nat.card K : ℝ)^d)=(Nat.card K : ℝ)^n := by
      rw [← pow_add,← pow_add]
      congr 1
      omega
    rw [← hp]
    apply le_of_eq
    field_simp [(ne_of_gt hq)]
  · simp only [mul_zero,Nat.cast_zero,zero_div]
    positivity
theorem contribution_le_irreducible (n d : ℕ) (hd : 0 < d) :
    contribution (K := K) n d ≤ ((Nat.card K : ℝ)⁻¹)^d / d := by
  have hq : (0 : ℝ) < Nat.card K := lt_of_lt_of_le (by norm_num) (field_card_real_two (K := K))
  have hdR : (0 : ℝ) < d := by exact_mod_cast hd
  have hc : (Nat.card (NonzeroIrreducibleDegree (K := K) d) : ℝ)*d ≤
      (Nat.card K : ℝ)^d := by
    exact_mod_cast nonzero_irreducible_card_mul_degree_le (K := K) d hd
  refine (contribution_le_quotient n d).trans ?_
  rw [inv_pow,inv_eq_one_div,div_div]
  apply (div_le_div_iff₀ (mul_pos (pow_pos hq _) (pow_pos hq _))
    (mul_pos (pow_pos hq _) hdR)).mpr
  have hh := mul_le_mul_of_nonneg_left hc (le_of_lt (pow_pos hq d))
  nlinarith
theorem contribution_zero (n : ℕ) : contribution (K := K) n 0=0 := by
  unfold contribution
  rw [nonzero_irreducible_card_zero,zero_mul,Nat.cast_zero,zero_div]
theorem contribution_one_le (n : ℕ) : contribution (K := K) n 1 ≤ 1/4 := by
  have hq2 := field_card_real_two (K := K)
  have hq : (0 : ℝ) < Nat.card K := by linarith
  refine (contribution_le_quotient n 1).trans ?_
  rw [nonzero_irreducible_card_one,Nat.cast_sub (by have := Finite.one_lt_card (α := K); omega),
    Nat.cast_one,pow_one]
  apply (div_le_iff₀ (mul_pos hq hq)).mpr
  nlinarith [sq_nonneg ((Nat.card K : ℝ)-2)]
theorem contribution_two_le (n : ℕ) : contribution (K := K) n 2 ≤ 1/8 := by
  have hq2 := field_card_real_two (K := K)
  have hqi : (Nat.card K : ℝ)⁻¹ ≤ 1/2 := by
    rw [inv_eq_one_div]
    apply (div_le_iff₀ (by linarith : (0 : ℝ) < Nat.card K)).mpr
    linarith
  have hn : (0 : ℝ) ≤ (Nat.card K : ℝ)⁻¹ := by positivity
  have hp := pow_le_pow_left₀ hn hqi 2
  have hh := contribution_le_irreducible (K := K) n 2 (by decide)
  norm_num at hp hh ⊢
  nlinarith
theorem contribution_tail_le (n d : ℕ) (hd : 3 ≤ d) :
    contribution (K := K) n d ≤ (1/2 : ℝ)^d / 3 := by
  have hq2 := field_card_real_two (K := K)
  have hqi : (Nat.card K : ℝ)⁻¹ ≤ 1/2 := by
    rw [inv_eq_one_div]
    apply (div_le_iff₀ (by linarith : (0 : ℝ) < Nat.card K)).mpr
    linarith
  have hdR : (3 : ℝ) ≤ d := by exact_mod_cast hd
  refine (contribution_le_irreducible n d (by omega)).trans ?_
  calc
    ((Nat.card K : ℝ)⁻¹)^d / d ≤ ((Nat.card K : ℝ)⁻¹)^d / 3 :=
      div_le_div_of_nonneg_left (by positivity) (by norm_num) hdR
    _ ≤ (1/2 : ℝ)^d/3 := by gcongr
theorem geometric_tail_le (m : ℕ) :
    (∑ i ∈ Finset.range m, (1/2 : ℝ)^(3+i)/3) ≤ 1/12 := by
  have hg := geom_sum_mul_neg (1/2 : ℝ) m
  have hp := pow_nonneg (by norm_num : (0 : ℝ) ≤ 1/2) m
  have hsum : (∑ i ∈ Finset.range m, (1/2 : ℝ)^(3+i)/3) =
      (1/24 : ℝ)*∑ i ∈ Finset.range m, (1/2 : ℝ)^i := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i hi
    rw [pow_add]
    ring
  rw [hsum]
  linarith
theorem total_contribution_le (n : ℕ) (hn : 2 ≤ n) :
    (∑ d : Fin (n+1), contribution (K := K) n d) ≤ 11/24 := by
  rw [Fin.sum_univ_eq_sum_range]
  rw [show n+1=3+(n-2) by omega,Finset.sum_range_add]
  have hprefix : (∑ d ∈ Finset.range 3, contribution (K := K) n d) ≤ 3/8 := by
    norm_num [Finset.sum_range_succ,contribution_zero]
    linarith [contribution_one_le (K := K) n,contribution_two_le (K := K) n]
  have htail : (∑ d ∈ Finset.range (n-2), contribution (K := K) n (3+d)) ≤ 1/12 := by
    apply le_trans _ (geometric_tail_le (n-2))
    apply Finset.sum_le_sum
    intro d hd
    exact contribution_tail_le n (3+d) (by omega)
  linarith
theorem squarefree_nonzero_density_ge (n : ℕ) (hn : 2 ≤ n) :
    (1/24 : ℝ) ≤ (Nat.card {f : MonicDegree (K := K) n // Good f} : ℝ) /
      (Nat.card K : ℝ)^n := by
  have hq2 := field_card_real_two (K := K)
  have hq : (0 : ℝ) < Nat.card K := by linarith
  have hqpow : (0 : ℝ) < (Nat.card K : ℝ)^n := pow_pos hq _
  have hs := squarefree_nonzero_card_sieve (K := K) n (by omega)
  have hsR : (Nat.card K : ℝ)^n ≤
      (Nat.card {f : MonicDegree (K := K) n // Good f} : ℝ) +
      (Nat.card K : ℝ)^(n-1) + ∑ d : Fin (n+1),
        (Nat.card (NonzeroIrreducibleDegree (K := K) d)*repeatCount (K := K) n d : ℕ) := by
    exact_mod_cast hs
  have hdiv := div_le_div_of_nonneg_right hsR (le_of_lt hqpow)
  rw [div_self (ne_of_gt hqpow),add_div,add_div,Nat.cast_sum,Finset.sum_div] at hdiv
  have hx : (Nat.card K : ℝ)^(n-1)/(Nat.card K : ℝ)^n ≤ 1/2 := by
    have he : (Nat.card K : ℝ)^(n-1)*(Nat.card K : ℝ)=(Nat.card K : ℝ)^n := by
      rw [← pow_succ]
      congr 1
      omega
    apply (div_le_iff₀ hqpow).mpr
    rw [← he]
    have hh := mul_le_mul_of_nonneg_left hq2 (le_of_lt (pow_pos hq (n-1)))
    nlinarith
  have ht := total_contribution_le (K := K) n hn
  unfold contribution at ht
  linarith
theorem squarefree_nonzero_constant_density_ge (n : ℕ) (hn : 2 ≤ n) :
    (1/24 : ℝ) ≤
      (Nat.card {f : MonicDegree (K := K) n // Squarefree f.1 ∧ f.1.coeff 0 ≠ 0} : ℝ) /
        (Nat.card K : ℝ)^n := by
  simpa only [Good,Polynomial.X_dvd_iff] using squarefree_nonzero_density_ge (K := K) n hn
end Mathproof.Problem18SquarefreeDensityBoundary20260930
end
