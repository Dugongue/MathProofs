    (y : ι → F) (t : F) (ht : Transcendental K t) (B : Nat)
    (hgen : IntermediateField.adjoin K (Set.range y) = ⊤)
    (hrel : ∀ i, ∃ s : MvPolynomial (Fin 2) K, s ≠ 0 ∧
      s.totalDegree ≤ B ∧ aeval ![y i,t] s = 0) :
    Module.finrank K⟮t⟯ F ≤ B ^ Fintype.card ι := by
  apply Problem18FiniteGeneratorDegree20261001.field_degree_le y B
    (IntermediateField.adjoin_eq_top_of_adjoin_eq_top K hgen)
  intro i
  obtain ⟨s, hs, hd, he⟩ := hrel i
  obtain ⟨p, hp, he', hd'⟩ := relation_over_parameter t (y i) ht s hs he
  exact ⟨p, hp, he', hd'.trans hd⟩
