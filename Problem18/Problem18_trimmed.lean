   (asgCost (cmpArgs oT (Sz.ve *ₛ (Cₛ 1 *ₛ n1))) + (20*(F.e*(1*(n+1)))+8)) +
  (spansCost F n d + 40)))
theorem combine_run {B : Nat} (σ : Env) (hB : 1 < B)
    (hr : σ.vars rTReg = 0 ∨ σ.vars rTReg = 1) (hg : σ.vars gF = 0 ∨ σ.vars gF = 1)
    (ht : σ.vars tF = 0 ∨ σ.vars tF = 1) (ha : σ.vars zA ≤ 1) (hz : σ.vars zR ≤ 1) :
    ∃ τ, Run B combine σ τ 40 ∧ (τ.vars result = 0 ∨ τ.vars result = 1) ∧
      (τ.vars result = 1 ↔ (σ.vars rTReg = 1 ∧ σ.vars gF = 1 ∧ (σ.vars zA = 0 ↔ σ.vars zR = 0) ∧
        (σ.vars zA = 0 → σ.vars tF = 1))) ∧
      (∀ x, x ≠ result → τ.vars x = σ.vars x) ∧ τ.arrs = σ.arrs ∧ τ.inp = σ.inp ∧ τ.out = σ.out := by
  have ev : ∀ (ρ : Env) (x : String), ρ.vars x ≤ 1 → (Expr.var x).evalB B ρ = some (ρ.vars x) :=
    fun ρ x h => evalB_var (by omega)
  have l0 : ∀ ρ : Env, (Expr.lit 0).evalB B ρ = some 0 := fun ρ => evalB_lit (by omega)
  have l1 : ∀ ρ : Env, (Expr.lit 1).evalB B ρ = some 1 := fun ρ => evalB_lit hB
  let σ0 := σ.setVar result 0
  have r0 : Run B (.assign result (.lit 0)) σ σ0 2 := Run.assign (l0 σ)
  have v0 : ∀ x, x ≠ result → σ0.vars x = σ.vars x := fun x h => by simp [σ0, h]
  have bnd : ∀ x, x ≠ result → σ.vars x ≤ 1 → σ0.vars x ≤ 1 := fun x h h' => by rw [v0 x h]; exact h'
  have hr' : σ0.vars rTReg ≤ 1 := bnd _ (by decide) (by omega)
  have hg' : σ0.vars gF ≤ 1 := bnd _ (by decide) (by omega)
  have ht' : σ0.vars tF ≤ 1 := bnd _ (by decide) (by omega)
  have ha' : σ0.vars zA ≤ 1 := bnd _ (by decide) ha
  have hz' : σ0.vars zR ≤ 1 := bnd _ (by decide) hz
  have c1 := evalB_condEq (ev σ0 rTReg hr') (l1 σ0)
  have c2 := evalB_condEq (ev σ0 gF hg') (l1 σ0)
  have c3 := evalB_condEq (ev σ0 zA ha') (ev σ0 zR hz')
  have c4 := evalB_condEq (ev σ0 zA ha') (l0 σ0)
  rw [v0 _ (by decide)] at c1 c2 c3 c4
  rw [v0 _ (by decide)] at c3
  by_cases h1 : σ.vars rTReg = 1
  · by_cases h2 : σ.vars gF = 1
    · by_cases h3 : σ.vars zA = σ.vars zR
      · by_cases h4 : σ.vars zA = 0
        · let τ := σ0.setVar result (σ0.vars tF)
          have rr : Run B combine σ τ 40 := by
            refine (r0.seq (Run.ite_true (c1.trans (by simp [h1])) (Run.ite_true (c2.trans (by simp [h2]))
              (Run.ite_true (c3.trans (by simp [h3])) (Run.ite_true (c4.trans (by simp [h4]))
                (Run.assign (ev σ0 tF ht')))))) ).mono ?_
            simp [Cond.size, Expr.size]
          refine ⟨τ, rr, ?_, ?_, ?_, rfl, rfl, rfl⟩
          · simp only [τ, vars_setVar, ↓reduceIte]; rw [v0 _ (by decide)]; exact ht
          · simp only [τ, vars_setVar, ↓reduceIte]; rw [v0 _ (by decide)]
            constructor
            · intro h; exact ⟨h1, h2, by rw [h3], fun _ => h⟩
            · rintro ⟨-, -, -, h⟩; exact h h4
          · intro x hx; simp only [τ, vars_setVar, if_neg hx]; exact v0 x hx
        · let τ := σ0.setVar result 1
          have rr : Run B combine σ τ 40 := by
            refine (r0.seq (Run.ite_true (c1.trans (by simp [h1])) (Run.ite_true (c2.trans (by simp [h2]))
              (Run.ite_true (c3.trans (by simp [h3])) (Run.ite_false (c4.trans (by simp [h4]))
                (Run.assign (l1 σ0))))))).mono ?_
            simp [Cond.size, Expr.size]
          refine ⟨τ, rr, by simp [τ], ?_, ?_, rfl, rfl, rfl⟩
          · simp only [τ, vars_setVar, ↓reduceIte, true_iff]
            exact ⟨h1, h2, by rw [h3], fun h => absurd h h4⟩
          · intro x hx; simp only [τ, vars_setVar, if_neg hx]; exact v0 x hx
      · have rr : Run B combine σ σ0 40 := by
          refine (r0.seq (Run.ite_true (c1.trans (by simp [h1])) (Run.ite_true (c2.trans (by simp [h2]))
            (Run.ite_false (c3.trans (by simp [h3])) Run.skip)))).mono ?_
          simp [Cond.size, Expr.size]
        refine ⟨σ0, rr, by simp [σ0], ?_, v0, rfl, rfl, rfl⟩
        simp only [σ0, vars_setVar, ↓reduceIte, zero_ne_one, false_iff]
        rintro ⟨-, -, h, -⟩
        apply h3; omega
    · have rr : Run B combine σ σ0 40 := by
        refine (r0.seq (Run.ite_true (c1.trans (by simp [h1]))
          (Run.ite_false (c2.trans (by simp [h2])) Run.skip))).mono ?_
        simp [Cond.size, Expr.size]
      refine ⟨σ0, rr, by simp [σ0], ?_, v0, rfl, rfl, rfl⟩
      simp only [σ0, vars_setVar, ↓reduceIte, zero_ne_one, false_iff]
      rintro ⟨-, h, -⟩; exact h2 h
  · have rr : Run B combine σ σ0 40 := by
      refine (r0.seq (Run.ite_false (c1.trans (by simp [h1])) Run.skip)).mono ?_
      simp [Cond.size, Expr.size]
    refine ⟨σ0, rr, by simp [σ0], ?_, v0, rfl, rfl, rfl⟩
    simp only [σ0, vars_setVar, ↓reduceIte, zero_ne_one, false_iff]
    rintro ⟨h, -⟩; exact h1 h
