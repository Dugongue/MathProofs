def avar (n d : ℕ) : Fin (secC0 n d + 2) := Fin.natAdd (secC0 n d) 0
def bvar (n d : ℕ) : Fin (secC0 n d + 2) := Fin.natAdd (secC0 n d) 1
def lineExpr (n d : ℕ) (i j : Fin n) : PolyExpr (Fin (secC0 n d + 2 + n)) ℤ :=
