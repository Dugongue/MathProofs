variable {i j : Type*} [StarRing K] [Fintype i] [Fintype j]
def columnGramRecord (A : Matrix i j K) : Matrix j j K := (Aᴴ * A).transpose
theorem columnGramRecord_right (A : Matrix i j K) (W : Matrix j j K) :
    columnGramRecord (A * W.transpose) = W * columnGramRecord A * Wᴴ := by
  simp only [columnGramRecord, Matrix.conjTranspose_mul, Matrix.transpose_mul,
    Matrix.transpose_transpose, Matrix.conjTranspose_transpose_eq_transpose_conjTranspose,
    Matrix.mul_assoc]
end ColumnRecords
structure HermitianBasisRecordMatch
    {K i t u : Type*} [Field K] [StarRing K] [Fintype i] [DecidableEq i]
    (b c : Module.Basis t K (Matrix i i K)) (S T : u → Matrix i i K) : Prop where
  identity : b.repr 1 = c.repr 1
  multiplication : ∀ v w, b.repr (b v * b w) = c.repr (c v * c w)
  sourceHermitian : ∀ a, (S a)ᴴ = S a
  targetHermitian : ∀ a, (T a)ᴴ = T a
  generates : Algebra.adjoin K (Set.range S) = ⊤
  marked : ∀ a, b.repr (S a) = c.repr (T a)
section PartialTraces
variable {i j : Type*} [Fintype i] [Fintype j]
def partialTraceRight : Matrix (i × j) (i × j) K →ₗ[K] Matrix j j K where
  toFun X a b := ∑ c, X (c,a) (c,b)
  map_add' X Y := by
    ext a b
    change (∑ c, (X (c,a) (c,b) + Y (c,a) (c,b))) =
      (∑ c, X (c,a) (c,b)) + ∑ c, Y (c,a) (c,b)
    rw [Finset.sum_add_distrib]
  map_smul' k X := by
    ext a b
    change (∑ c, k * X (c,a) (c,b)) = k * ∑ c, X (c,a) (c,b)
    rw [Finset.mul_sum]
omit [Fintype j] in
theorem partialTraceRight_kronecker (M : Matrix i i K) (N : Matrix j j K) :
    partialTraceRight (Matrix.kronecker M N) = Matrix.trace M • N := by
  ext a b
  change (∑ c, M c c * N a b) = (∑ c, M c c) * N a b
  rw [Finset.sum_mul]
variable [StarRing K]
omit [Fintype j] in
theorem partialTraceRight_conjTranspose (X : Matrix (i × j) (i × j) K) :
    partialTraceRight Xᴴ = (partialTraceRight X)ᴴ := by
  ext a b
  change (∑ c, star (X (c,b) (c,a))) = star (∑ c, X (c,b) (c,a))
  rw [star_sum]
variable [DecidableEq i] [DecidableEq j]
theorem trace_unitary_conjugate (N Q : Matrix j j K) (hQ : IsUnitary Q) :
    Matrix.trace (Q * N * Qᴴ) = Matrix.trace N := by
  rw [Matrix.trace_mul_cycle, hQ, Matrix.one_mul]
theorem partialTraceRight_covariant (X : Matrix (i × j) (i × j) K)
    (P : Matrix i i K) (Q : Matrix j j K) (hP : IsUnitary P) :
    partialTraceRight (Matrix.kronecker P Q * X * (Matrix.kronecker P Q)ᴴ) =
      Q * partialTraceRight X * Qᴴ := by
  obtain ⟨Z, rfl⟩ := (kroneckerLinearEquiv i i j j K).surjective X
  induction Z using TensorProduct.induction_on with
  | zero => simp
  | tmul M N =>
    simp only [kroneckerLinearEquiv_tmul]
    unfold Matrix.kronecker
    rw [Matrix.conjTranspose_kronecker, ← Matrix.mul_kronecker_mul,
      ← Matrix.mul_kronecker_mul]
    change partialTraceRight (Matrix.kronecker (P * M * Pᴴ) (Q * N * Qᴴ)) =
      Q * partialTraceRight (Matrix.kronecker M N) * Qᴴ
    rw [partialTraceRight_kronecker, partialTraceRight_kronecker, trace_unitary_conjugate M P hP]
    simp only [Matrix.smul_mul, Matrix.mul_smul]
  | add x y hx hy =>
    simpa only [map_add, Matrix.mul_add, Matrix.add_mul] using congrArg₂ (· + ·) hx hy
end PartialTraces
