      calc
        _ = 64*(q^(r*(b-r)+(r+1).choose 2)*q^(u.val*(d-u.val)))*
          ((q^(u.val*(a*b-a*r)))⁻¹*(q^((a*r-2*u.val)*(b - d)))⁻¹) := by ring
        _ = _ := by rw [hn,hd]
open Classical in
theorem hermitian_weighted_average_bound
    (a b d : ℕ) (ha : 2  ≤  a) (hb : 8  ≤  b) (hdb : 64*d  ≤  b) :
    (∑ A : {A : selfAdjoint (Matrix (Fin b) (Fin b) K) // A.val.rank  ≠  0},
      rankWeight (Fintype.card K : ℝ) a b d A.val.val.rank)  ≤
      64 * (b : ℝ) * (d+1 : ℕ) *
        (((Fintype.card K : ℝ)^(b/4))⁻¹) := by
  let q : ℝ := Fintype.card K
  have hq : 2  ≤  q := by
    dsimp [q]
    exact_mod_cast (show 2  ≤  Fintype.card K from Fintype.one_lt_card)
  let S := {A : selfAdjoint (Matrix (Fin b) (Fin b) K) // A.val.rank  ≠  0}
  have hr1 (A : S) : 1  ≤  A.val.val.rank := by
    have h1 := A.property
    omega
  let f : S → Fin b := fun A =>
    ⟨A.val.val.rank - 1, by
      have hr : A.val.val.rank  ≤  b := by
        simpa only [Fintype.card_fin] using A.val.val.rank_le_card_width
      have h2 := hr1 A
      omega⟩
  have hfval (A : S) : (f A).val + 1 = A.val.val.rank := by
    dsimp [f]
    have h2 := hr1 A
    omega
  have hc (r : Fin b) :
      Nat.card {A : S // f A = r}  ≤
        Nat.card {A : selfAdjoint (Matrix (Fin b) (Fin b) K) // A.val.rank = r.val+1} := by
    let g : {A : S // f A = r} →
        {A : selfAdjoint (Matrix (Fin b) (Fin b) K) // A.val.rank = r.val+1} := fun A =>
      ⟨A.val.val, by
        rw [← hfval A.val]
        have hv := congrArg Fin.val A.property
        omega⟩
    exact Nat.card_le_card_of_injective g (by
      intro A B h
      apply Subtype.ext
      apply Subtype.ext
      simpa [g] using congrArg Subtype.val h)
  have he := Fintype.sum_fiberwise' f
    (fun r => rankWeight q a b d (r.val+1))
  simp only [Finset.sum_const, Finset.card_univ, nsmul_eq_mul,
    ← Nat.card_eq_fintype_card] at he
  change (∑ A : S, rankWeight q a b d A.val.val.rank)  ≤  _
  have he' :
      (∑ A : S, rankWeight q a b d A.val.val.rank) =
        ∑ r : Fin b,
          (Nat.card {A : S // f A = r} : ℝ) *
            rankWeight q a b d (r.val+1) := by
    calc
      _ = ∑ A : S, rankWeight q a b d ((f A).val+1) := by
        apply Finset.sum_congr rfl
        intro A _
        rw [hfval]
      _ = _ := he.symm
  rw [he']
  calc
    _  ≤  ∑ r : Fin b, ∑ u : Fin (d+1),
        64 * q^(u.val*(d-u.val) + (r.val+1)*(b-(r.val+1)) +
            (r.val+2).choose 2) *
          (q^(u.val*(a*b-a*(r.val+1)) +
            (b - d)*(a*(r.val+1)-2*u.val)))⁻¹ := by
      apply Finset.sum_le_sum
      intro r _
      calc
        (Nat.card {A : S // f A = r} : ℝ) *
            rankWeight q a b d (r.val+1)  ≤
          (Nat.card {A : selfAdjoint (Matrix (Fin b) (Fin b) K) // A.val.rank = r.val+1} : ℝ) *
            rankWeight q a b d (r.val+1) :=
          mul_le_mul_of_nonneg_right (by exact_mod_cast hc r) (by
            unfold rankWeight
            positivity)
        _  ≤  _ := rank_count_weight_bound hcard hstar q (by linarith) (by rfl) a b d
          (r.val+1) (by omega)
    _  ≤  64 * (b : ℝ) * (d+1 : ℕ) * (q^(b/4))⁻¹ :=
      conditioned_symmetric_energy_sum_bound q hq a b d ha hb hdb
end Mathproof.Problem18HermitianConditionedWeights20260930
