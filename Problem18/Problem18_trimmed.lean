  | .var x => [x]
  | .get _ i => reads i
  | .bin _ e f => reads e ++ reads f
def NoGet : Expr → Prop
  | .lit _ => True
  | .var _ => True
  | .get _ _ => False
  | .bin _ e f => NoGet e ∧ NoGet f
theorem evalB_congr {B : Nat} {σ τ : Env} : ∀ (e : Expr), NoGet e →
    (∀ x ∈ reads e, τ.vars x = σ.vars x) → e.evalB B τ = e.evalB B σ
  | .lit _, _, _ => rfl
  | .var x, _, h => by simp only [Expr.evalB]; rw [h x (by simp [reads])]
  | .get _ _, hg, _ => absurd hg id
  | .bin op e f, hg, h => by
    simp only [Expr.evalB]
    rw [evalB_congr e hg.1 (fun x hx => h x (by simp [reads, hx])),
      evalB_congr f hg.2 (fun x hx => h x (by simp [reads, hx]))]
def evalN (σ : Env) : Expr → Nat
  | .lit n => n
  | .var x => σ.vars x
  | .get _ _ => 0
  | .bin op e f => op.apply (evalN σ e) (evalN σ f)
def Mono (σ : Env) : Expr → Prop
  | .lit _ => True
  | .var _ => True
  | .get _ _ => False
  | .bin .add e f => Mono σ e ∧ Mono σ f
  | .bin .mul e f => Mono σ e ∧ Mono σ f ∧ 1 ≤ evalN σ e ∧ 1 ≤ evalN σ f
  | .bin _ _ _ => False
theorem evalB_mono {B : Nat} {σ : Env} : ∀ (e : Expr), Mono σ e → evalN σ e < B →
    e.evalB B σ = some (evalN σ e)
  | .lit n, _, h => evalB_lit h
  | .var x, _, h => evalB_var h
  | .get _ _, hm, _ => absurd hm id
  | .bin op e f, hm, h => by
    cases op with
    | add =>
      have he : evalN σ e < B := by simp only [evalN, Bop.apply] at h; omega
      have hf : evalN σ f < B := by simp only [evalN, Bop.apply] at h; omega
      exact evalB_bin (evalB_mono e hm.1 he) (evalB_mono f hm.2 hf) h
    | mul =>
      obtain ⟨hme, hmf, h1, h2⟩ := hm
      have hv : evalN σ (.bin .mul e f) = evalN σ e * evalN σ f := rfl
      have he : evalN σ e < B := by
        rw [hv] at h
        exact lt_of_le_of_lt (Nat.le_mul_of_pos_right _ h2) h
      have hf : evalN σ f < B := by
        rw [hv] at h
        exact lt_of_le_of_lt (Nat.le_mul_of_pos_left _ h1) h
      exact evalB_bin (evalB_mono e hme he) (evalB_mono f hmf hf) h
    | sub => exact absurd hm id
    | div => exact absurd hm id
    | and => exact absurd hm id
    | or => exact absurd hm id
    | xor => exact absurd hm id
    | shiftl => exact absurd hm id
    | shiftr => exact absurd hm id
end Mathproof.Problem18PairLargeExpr20261004
