variable {K : Type} [Field K] [Fintype K] (F : FieldPresentation K)
theorem configured_slots (xs : List Entry) (n e : Nat) {W : String} {Sn B : Nat} {σ : Env}
    (hs : Slots F canonical W Sn B σ)
    (hf : ∀p∈xs,p.1∉regNames canonical ∧ p.1≠W) :
    Slots F canonical W Sn B (configured xs n e σ) := by
  induction xs generalizing σ with
  | nil=>exact hs
  | cons p ps ih=>
    change Slots F canonical W Sn B (configured ps n e (σ.setVar p.1 (value p.2 n e)))
    apply ih (Slots.setVar F canonical hs (hf p (by simp)).1 (hf p (by simp)).2 _)
    intro a ha
    exact hf a (by simp [ha])
theorem configured_val (xs : List Entry) (n e : Nat) {W : String} (σ : Env) (s : Nat)
    (hf : ∀p∈xs,p.1≠W) :
    val F canonical W (configured xs n e σ) s=val F canonical W σ s := by
  induction xs generalizing σ with
  | nil=>rfl
  | cons p ps ih=>
    change val F canonical W (configured ps n e (σ.setVar p.1 (value p.2 n e))) s=_
    rw [ih _ (fun a ha=>hf a (by simp [ha]))]
    exact val_setVar F canonical (hf p (by simp)) σ _ s
theorem configured_vars (xs : List Entry) (n e : Nat) (σ : Env) (x : String)
    (hx : ∀p∈xs,p.1≠x) : (configured xs n e σ).vars x=σ.vars x := by
  induction xs generalizing σ with
  | nil=>rfl
  | cons p ps ih=>
    change (configured ps n e (σ.setVar p.1 (value p.2 n e))).vars x=_
    rw [ih _ (fun a ha=>hx a (by simp [ha]))]
    simp only [vars_setVar,if_neg (hx p (by simp)).symm]
theorem phase_protected (p : Phase) :
    ∀a∈entries p,a.1∉regNames canonical ∧ a.1≠workspaceName := by
  cases p <;> decide
theorem setup_state (p : Phase) {B n : Nat} {σ : Env}
    (hs : Slots F canonical workspaceName (Problem18IMPBoundaryCyclicLayout20261002.slots n) B σ)
    (hn : σ.vars dimName=n)
    (hb : majorant (boundExpression p) n F.e < B) :
    Run B (program p) σ (installed p n F.e σ)
      (Problem18IMPAssignments20261002.cost (commands dimName canonical.e (entries p))) ∧
    Slots F canonical workspaceName (Problem18IMPBoundaryCyclicLayout20261002.slots n) B
      (installed p n F.e σ) ∧
    (∀s,val F canonical workspaceName (installed p n F.e σ) s=val F canonical workspaceName σ s) ∧
    (installed p n F.e σ).inp=σ.inp ∧ (installed p n F.e σ).out=σ.out := by
  obtain ⟨hr,_,hi,ho⟩:=setup_run p hn hs.base.degree hb
  exact ⟨hr,configured_slots F _ _ _ hs (phase_protected p),
    fun s=>configured_val F _ _ _ σ s (fun a ha=>(phase_protected p a ha).2),hi,ho⟩
end Mathproof.Problem18IMPBoundaryPhaseState20261002
