theorem diagonal_order_profile (hodd : ringChar K≠2) {n : ℕ} (hn : 0<n)
    (a : Fin n → K) (ha : ∀ i,a i≠0) :
    ∃ ε : ℝ,|ε| ≤ ((Nat.card K:ℝ)^(n/2))⁻¹ ∧
      (order a:ℝ)=2*(1+ε)*(Nat.card K:ℝ)^(n.choose 2)*evenPowerProduct (Nat.card K) ((n-1)/2) := by
  classical
