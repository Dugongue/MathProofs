    AlgebraicIndependent K ![u, u₀] := by
  classical
  rw [AlgebraicIndependent.iff_transcendental_adjoin_image (1 : Fin 2)]
  have hU : ∀ j : {j : Fin 2 // j ≠ 1}, j = ⟨0, by decide⟩ := by
    rintro ⟨j, hj⟩
    fin_cases j
    · rfl
    · exact absurd rfl hj
  letI : Unique {j : Fin 2 // j ≠ 1} := ⟨⟨⟨0, by decide⟩⟩, hU⟩
  refine ⟨?_, ?_⟩
  · rw [algebraicIndependent_unique_type_iff]
    exact hu
  · have himg : (![u, u₀] '' ({1}ᶜ : Set (Fin 2))) = {u} := by
      ext z
      simp only [Set.mem_image, Set.mem_compl_iff, Set.mem_singleton_iff]
      constructor
      · rintro ⟨m, hm, rfl⟩
        fin_cases m
        · rfl
