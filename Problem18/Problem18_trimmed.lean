variable {F K : Type*} [Field F] [Field K] (i : F →+* K) (f : F[X])
noncomputable def quotientBaseMap : AdjoinRoot f →+* AdjoinRoot (f.map i) :=
  AdjoinRoot.map i f (f.map i) dvd_rfl
@[simp] theorem quotientBaseMap_mk (p : F[X]) :
    quotientBaseMap i f (AdjoinRoot.mk f p)=AdjoinRoot.mk (f.map i) (p.map i) := by
  unfold quotientBaseMap AdjoinRoot.map
  rw [AdjoinRoot.lift_mk,← AdjoinRoot.aeval_eq]
  simp only [Polynomial.aeval_def,Polynomial.eval₂_map]
  rfl
theorem quotientBaseMap_injective : Function.Injective (quotientBaseMap i f) := by
  apply (injective_iff_map_eq_zero (quotientBaseMap i f)).mpr
  intro x hx
  obtain ⟨p,rfl⟩ := AdjoinRoot.mk_surjective x
  rw [quotientBaseMap_mk,AdjoinRoot.mk_eq_zero] at hx
  rw [AdjoinRoot.mk_eq_zero]
  exact (Polynomial.map_dvd_map' i).mp hx
theorem quotientBaseMap_fixed (σ : K ≃+* K)
    (hσ : ∀ a : F,σ (i a)=i a)
    (φ : AdjoinRoot (f.map i) ≃+* AdjoinRoot (f.map i))
    (hc : ∀ a : K,φ (AdjoinRoot.of (f.map i) a)=AdjoinRoot.of (f.map i) (σ a))
    (hr : φ (AdjoinRoot.root (f.map i))=AdjoinRoot.root (f.map i))
    (x : AdjoinRoot f) : φ (quotientBaseMap i f x)=quotientBaseMap i f x := by
  have he : φ.toRingHom.comp (quotientBaseMap i f)=quotientBaseMap i f := by
    apply AdjoinRoot.ringHom_ext
    · ext a
      change φ (quotientBaseMap i f (AdjoinRoot.of f a))=quotientBaseMap i f (AdjoinRoot.of f a)
      simp only [quotientBaseMap,AdjoinRoot.map_of,hc,hσ]
    · change φ (quotientBaseMap i f (AdjoinRoot.root f))=quotientBaseMap i f (AdjoinRoot.root f)
      simp only [quotientBaseMap,AdjoinRoot.map_root,hr]
  exact congrArg (fun g : AdjoinRoot f →+* AdjoinRoot (f.map i) => g x) he
noncomputable def baseUnitsFixedEmbedding (σ : K ≃+* K)
    (hσ : ∀ a : F,σ (i a)=i a)
    (φ : AdjoinRoot (f.map i) ≃+* AdjoinRoot (f.map i))
    (hc : ∀ a : K,φ (AdjoinRoot.of (f.map i) a)=AdjoinRoot.of (f.map i) (σ a))
    (hr : φ (AdjoinRoot.root (f.map i))=AdjoinRoot.root (f.map i)) :
    (AdjoinRoot f)ˣ ↪ {u : (AdjoinRoot (f.map i))ˣ // φ u.val=u.val} where
  toFun u := ⟨Units.map (quotientBaseMap i f).toMonoidHom u,
    quotientBaseMap_fixed i f σ hσ φ hc hr u.val⟩
  inj' u v h := Units.map_injective (quotientBaseMap_injective i f) (congrArg Subtype.val h)
end BaseChange
