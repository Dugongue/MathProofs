    coreρ.slots coreρ.workspace coreρ.dimension coreρ.modulus coreρ.length hb.annihilator hb.seed
  have coreξ : Core F B S ξ := Core.transport_run F coreρ hra hξ hwξ hnξ (by decide) (by
    intro j k
    have hh:=matrix_address_bounds j k
    exact hmemA _ (by omega) (by omega) (Or.inr (by omega)))
  have stateξ : State F B S i ξ := by
    refine ⟨coreξ,hiξ.trans hiρ,h.index_le,?_,?_⟩
    · intro j
      rw [hmemA _ (by have hh:=j.isLt;omega) (by omega) (Or.inr (by omega))]
      exact stateρ.vector j
    · intro j hj
      rw [hmemA _ (by omega) (by omega) (Or.inl (by omega))]
      exact stateρ.polynomial j hj
  have hmatrix : Problem18IMPBoundaryAnnihilatorPhase20261002.matrixValue F n ρ=S := by
    ext j k
    exact coreρ.matrix j k
  have hseedEq : Problem18IMPBoundaryAnnihilatorPhase20261002.seedValue F n ρ=Pi.single (⟨i,hi⟩:Fin n) 1 := by
    funext j
