theorem galois_place_transitive (Q R : Place k L)
    (hQR : restrictPlace k F L Q=restrictPlace k F L R) :
    ∃ σ : L ≃ₐ[F] L, ∀ x : L, σ x∈Q.toValuationSubring ↔ x∈R.toValuationSubring := by
