theorem exists_model_coordinates (B : LinearMap.BilinForm K V) (hs : B.IsSymm) (hn : B.Nondegenerate) :
    ∃ c : FormClass K (Module.finrank K V),∃ e : (Fin (Module.finrank K V) → K) ≃ₗ[K] V,
      ∀ x y,B (e x) (e y)=(representative K c).val x y := by
  let e := (Module.finBasis K V).equivFun.symm
  let C := B.comp e.toLinearMap e.toLinearMap
  have hCs : C.IsSymm := by constructor; intro x y; exact hs.eq (e x) (e y)
  have hCn : C.Nondegenerate := by
    constructor
    · intro x hx
      apply e.injective
      rw [map_zero]
      apply hn.1
      intro y
      obtain ⟨y,rfl⟩ := e.surjective y
      exact hx y
    · intro y hy
      apply e.injective
      rw [map_zero]
      apply hn.2
      intro x
      obtain ⟨x,rfl⟩ := e.surjective x
      exact hy x
  let D : RegularForm K (Module.finrank K V) := ⟨C,hCs,hCn⟩
  let c : FormClass K (Module.finrank K V) := Quotient.mk _ D
  obtain ⟨T,hT⟩ := representative_covers K D
  refine ⟨c,T.symm.trans e,?_⟩
  intro x y
  change C (T.symm x) (T.symm y)=(representative K c).val x y
  simpa only [T.apply_symm_apply] using (hT (T.symm x) (T.symm y)).symm
end
