namespace Mathproof.Problem18EulerReciprocalRoots20260930
open Polynomial PowerSeries Problem18EulerLocalSeries20260930
open scoped BigOperators PowerSeries
noncomputable def reciprocalRootLogTerm (a : ℂ) : PowerSeries ℂ :=
  PowerSeries.C (-a) * PowerSeries.X * localEuler 1 a
noncomputable def reciprocalRootLogDerivative
    (s : Multiset ℂ) : PowerSeries ℂ :=
  (s.map reciprocalRootLogTerm).sum
private theorem coeff_logTerm (a : ℂ) {n : Nat} (hn : n ≠ 0) :
    PowerSeries.coeff n (reciprocalRootLogTerm a) = -a ^ n := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  rw [reciprocalRootLogTerm, mul_assoc, PowerSeries.coeff_C_mul, PowerSeries.coeff_succ_X_mul,
    coeff_localEuler a one_ne_zero, if_pos (one_dvd _), Nat.div_one]
  ring
private theorem constantCoeff_logTerm (a : ℂ) :
    PowerSeries.constantCoeff (reciprocalRootLogTerm a) = 0 := by
  simp [reciprocalRootLogTerm]
theorem coeff_reciprocalRootLogDerivative
    (s : Multiset ℂ) {n : Nat} (hn : n ≠ 0) :
    PowerSeries.coeff n (reciprocalRootLogDerivative s) =
      -(s.map (fun a ↦ a ^ n)).sum := by
  induction s using Multiset.induction_on with
  | empty => simp [reciprocalRootLogDerivative]
  | cons a s ih =>
    rw [reciprocalRootLogDerivative] at ih ⊢
    rw [Multiset.map_cons, Multiset.sum_cons, map_add, ih, coeff_logTerm a hn,
      Multiset.map_cons, Multiset.sum_cons]
    ring
theorem constantCoeff_reciprocalRootLogDerivative
    (s : Multiset ℂ) :
    PowerSeries.constantCoeff (reciprocalRootLogDerivative s) = 0 := by
  induction s using Multiset.induction_on with
  | empty => simp [reciprocalRootLogDerivative]
  | cons a s ih =>
    rw [reciprocalRootLogDerivative] at ih ⊢
    rw [Multiset.map_cons, Multiset.sum_cons, map_add, ih, constantCoeff_logTerm, add_zero]
private noncomputable def factorProd (s : Multiset ℂ) : PowerSeries ℂ :=
  (s.map fun a => (1 - PowerSeries.C a * PowerSeries.X : PowerSeries ℂ)).prod
private theorem X_mul_derivative_factorProd (s : Multiset ℂ) :
    PowerSeries.X * PowerSeries.derivative ℂ (factorProd s) =
      factorProd s * reciprocalRootLogDerivative s := by
  induction s using Multiset.induction_on with
  | empty =>
    simp [factorProd, reciprocalRootLogDerivative, Derivation.map_one_eq_zero]
  | cons a s ih =>
    rw [factorProd] at ih ⊢
    rw [reciprocalRootLogDerivative] at ih ⊢
    rw [Multiset.map_cons, Multiset.prod_cons, Multiset.map_cons, Multiset.sum_cons,
      Derivation.leibniz, smul_eq_mul, smul_eq_mul]
    have hda : PowerSeries.derivative ℂ (1 - PowerSeries.C a * PowerSeries.X : PowerSeries ℂ) =
        -PowerSeries.C a := by
      simp [Derivation.map_one_eq_zero, Derivation.leibniz]
    have hinv := localEuler_mul_one_sub a (e := 1) one_ne_zero
    rw [pow_one] at hinv
    have hneg : PowerSeries.C (-a) = -PowerSeries.C a := map_neg _ _
    rw [hda, reciprocalRootLogTerm]
    linear_combination (1 - PowerSeries.C a * PowerSeries.X) * ih +
      (-(PowerSeries.C (-a) * PowerSeries.X) *
        (s.map fun a => (1 - PowerSeries.C a * PowerSeries.X : PowerSeries ℂ)).prod) * hinv +
      (-(PowerSeries.X *
        (s.map fun a => (1 - PowerSeries.C a * PowerSeries.X : PowerSeries ℂ)).prod)) * hneg
private theorem reflect_prod_X_sub_C (s : Multiset ℂ) :
    (s.map fun a => (Polynomial.X - Polynomial.C a : ℂ[X])).prod.natDegree ≤ s.card ∧
    reflect s.card (s.map fun a => (Polynomial.X - Polynomial.C a : ℂ[X])).prod =
      (s.map fun a => (1 - Polynomial.C a * Polynomial.X : ℂ[X])).prod := by
  induction s using Multiset.induction_on with
  | empty => simp
  | cons a s ih =>
    obtain ⟨hdeg, hrefl⟩ := ih
    have h1 : (Polynomial.X - Polynomial.C a : ℂ[X]).natDegree ≤ 1 :=
      (natDegree_X_sub_C a).le
    simp only [Multiset.map_cons, Multiset.prod_cons, Multiset.card_cons]
    constructor
    · calc _ ≤ (Polynomial.X - Polynomial.C a : ℂ[X]).natDegree
            + (s.map fun a => (Polynomial.X - Polynomial.C a : ℂ[X])).prod.natDegree :=
            natDegree_mul_le
        _ ≤ s.card + 1 := by omega
    · rw [add_comm, reflect_mul _ _ h1 hdeg, hrefl, reflect_sub, reflect_C]
      have hX : reflect 1 (Polynomial.X : ℂ[X]) = 1 := by
        simp
      rw [hX, pow_one]
private theorem polynomial_eq_factor_prod (P : ℂ[X]) (hP : P.coeff 0 = 1) :
    P = (P.reverse.roots.map fun a => (1 - Polynomial.C a * Polynomial.X : ℂ[X])).prod := by
  have hP0 : P.coeff 0 ≠ 0 := by rw [hP]; exact one_ne_zero
  have htr : P.natTrailingDegree = 0 := natTrailingDegree_eq_zero.mpr (Or.inr hP0)
  have hmonic : P.reverse.Monic := by
    rw [Monic, reverse_leadingCoeff, trailingCoeff, htr, hP]
  have hdeg : P.reverse.natDegree = P.natDegree := by
    rw [reverse_natDegree, htr, Nat.sub_zero]
  have hcard : P.reverse.roots.card = P.natDegree := by
    rw [IsAlgClosed.card_roots_eq_natDegree, hdeg]
  have hsplit := prod_multiset_X_sub_C_of_monic_of_roots_card_eq hmonic
    (by rw [hcard, hdeg])
  have hrev : P = reflect P.natDegree P.reverse := by
    rw [reverse, reflect_reflect]
  rw [← (reflect_prod_X_sub_C P.reverse.roots).2, hsplit, hcard]
  exact hrev
private theorem coe_factor_prod (s : Multiset ℂ) :
    (((s.map fun a => (1 - Polynomial.C a * Polynomial.X : ℂ[X])).prod : ℂ[X]) :
        PowerSeries ℂ) = factorProd s := by
  induction s using Multiset.induction_on with
  | empty => simp [factorProd]
  | cons a s ih =>
    rw [factorProd] at ih ⊢
    simp only [Multiset.map_cons, Multiset.prod_cons, Polynomial.coe_mul, ih,
      Polynomial.coe_sub, Polynomial.coe_one, Polynomial.coe_C, Polynomial.coe_X]
theorem polynomial_logarithmic_derivative (P : ℂ[X]) (hP : P.coeff 0=1) :
    PowerSeries.X*PowerSeries.derivative ℂ (P:PowerSeries ℂ)=
      (P:PowerSeries ℂ)*reciprocalRootLogDerivative P.reverse.roots := by
  have h : (P : PowerSeries ℂ) = factorProd P.reverse.roots := by
    conv_lhs => rw [polynomial_eq_factor_prod P hP]
    exact coe_factor_prod _
  rw [h]
  exact X_mul_derivative_factorProd _
theorem reciprocal_roots_card_le (P : ℂ[X]) : P.reverse.roots.card≤P.natDegree :=
  (card_roots' _).trans (reverse_natDegree_le P)
end Mathproof.Problem18EulerReciprocalRoots20260930
