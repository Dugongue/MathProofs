theorem preservingSample_probability_largeComplement
    (B : LinearMap.BilinForm K V) (hB : B.Nondegenerate)
    (eps : K) (heps : eps ^ 2 = 1)
    (W : Submodule K V) {k z m n : ℕ}
    (E : (Fin (k + z) → K) →ₗ[K] V)
    (hE : Function.Injective E)
    (hw : ∀ i, leftTestVector E i ∈ W)
    (hv : ∀ l, RightOrthogonalTo B W (rightTestVector E l))
    (hkn : 2 * k ≤ n) (hrn : 2 * (m + m) ≤ n)
    (hzn : n ≤ 4 * z) :
    (Nat.card {u : Fin m → V × V //
        Preserves W (∑ j,
          Mathproof.Problem18AnchorBilinear20260930.anchorPair
            B eps (u j).1 (u j).2)} : ℝ) /
        Nat.card (Fin m → V × V) ≤
      4 * (k + 1) *
        ((Fintype.card K : ℝ) ^ ((k * (m + m)) / 8))⁻¹ := by
  calc
    _ ≤ (Nat.card (CrossZeroPairs (K := K) k (m + m) z) : ℝ) /
          Nat.card
            (Matrix (Fin k) (Fin (m + m)) K ×
              Matrix (Fin z) (Fin (m + m)) K) :=
      preservingSample_probability_le_crossZero
