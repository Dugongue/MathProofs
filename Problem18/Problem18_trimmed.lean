    Function.comp_def,Sum.elim_inl,Sum.elim_inr,map_zero,ZeroMemClass.coe_zero,add_zero]
theorem primary_orthogonal_eq (S : Module.End K (Fin c→K)) (p q : Polynomial K)
    (hW : W=LinearMap.ker (Polynomial.aeval S p))
    (hnW : ((standardHermitian c).domRestrict₁₂ W W).Nondegenerate)
    (hS : ∀x y,standardHermitian c (S x) y=standardHermitian c x (S y))
    (hp : p.map (starRingAut : K ≃+* K).toRingHom=p)
    (hq : q.map (starRingAut : K ≃+* K).toRingHom=q)
    (hpq : IsCoprime p q) (hχ : S.charpoly=p*q) :
    W.orthogonalBilin (standardHermitian c)=LinearMap.ker (Polynomial.aeval S q) := by
