theorem log_one_sub_lower (x : ℝ) (hx : 0 ≤ x) (hh : x ≤ 1/2) :
    -2*x ≤ Real.log (1-x) := by
  have hy : 0 < 1-x := by linarith
  have h := Real.log_le_sub_one_of_pos (inv_pos.mpr hy)
  rw [Real.log_inv] at h
  have hr : (1-x)⁻¹-1 ≤ 2*x := by
    apply sub_le_iff_le_add.mpr
    rw [inv_eq_one_div]
    apply (div_le_iff₀ hy).mpr
    nlinarith
  linarith
theorem finite_product_lower {ι : Type*} (s : Finset ι) (x : ι → ℝ)
    (hx : ∀ i∈s,0 ≤ x i) (hh : ∀ i∈s,x i ≤ 1/2) :
    Real.exp (-2*∑ i∈s,x i) ≤ ∏ i∈s,(1-x i) := by
  calc
    _ = ∏ i∈s,Real.exp (-2*x i) := by
      rw [← Real.exp_sum,Finset.mul_sum]
    _ ≤ _ := Finset.prod_le_prod (fun i hi => (Real.exp_pos _).le) (fun i hi => by
      calc Real.exp (-2*x i) ≤ Real.exp (Real.log (1-x i)) :=
             Real.exp_le_exp.mpr (log_one_sub_lower (x i) (hx i hi) (hh i hi))
           _ = 1-x i := Real.exp_log (by have h := hh i hi; linarith))
theorem finite_product_lower_of_sum {ι : Type*} (s : Finset ι) (x : ι → ℝ)
    (hx : ∀ i∈s,0 ≤ x i) (hh : ∀ i∈s,x i ≤ 1/2) (M : ℝ)
    (hM : ∑ i∈s,x i ≤ M) : Real.exp (-2*M) ≤ ∏ i∈s,(1-x i) := by
  exact (Real.exp_le_exp.mpr (by linarith)).trans (finite_product_lower s x hx hh)
theorem finite_product_lower_sum36 {ι : Type*} (s : Finset ι) (x : ι → ℝ)
    (hx : ∀ i∈s,0 ≤ x i) (hh : ∀ i∈s,x i ≤ 1/2)
    (hM : ∑ i∈s,x i ≤ 36) : Real.exp (-72) ≤ ∏ i∈s,(1-x i) := by
  convert finite_product_lower_of_sum s x hx hh 36 hM using 1 <;> norm_num
end Mathproof.Problem18EulerProductBounds20260930
