variable [StarRing K] (u : Bool) (q : ℕ)
  (hs : ∀x : K,(if u then x^q else x)=star x)
include hs
theorem rawAdjoint_eq {i j : Type*} (A : Matrix i j K) : rawAdjoint u q A=Aᴴ := by
  ext i j
  cases u <;> simpa [rawAdjoint,Matrix.conjTranspose_apply] using hs (A j i)
theorem rawFirst_eq (A : RectTensor a b c K) : rawFirst u q A=firstFamily A := by
  funext t
