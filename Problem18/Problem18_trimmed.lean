theorem repeated_diagonal_support_le {a : ℕ} (i₀ : Fin a)
    (Q : QuadraticForm K (Fin n → K))
    (E : Submodule K (Fin a → Fin n → K))
    (ψ : AddChar K ℂ) (hψ : ψ ≠ 1) :
    (Finset.univ.filter (fun d : Fin n → K =>
      (∑ x : E, ψ (∑ i, completion Q d (x.val i))) ≠ 0)).card ≤
      Fintype.card K ^ (Module.finrank K (LinearMap.range Q.polarBilin) +
        (a*n - Module.finrank K E)) := by
