noncomputable def coprimeEvaluation {K ι : Type*} [Field K] [Fintype ι]
    (g : ι → K[X]) : AdjoinRoot (∏ i,g i) →ₐ[K] (∀ i,AdjoinRoot (g i)) :=
  AlgHom.pi fun i => AdjoinRoot.liftAlgHom (∏ i,g i)
    (Algebra.ofId K (AdjoinRoot (g i))) (AdjoinRoot.root (g i)) (by
      change Polynomial.aeval (AdjoinRoot.root (g i)) (∏ j,g j)=0
      rw [map_prod]
      apply Finset.prod_eq_zero (Finset.mem_univ i)
      rw [AdjoinRoot.aeval_eq]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton (g i))))
theorem coprimeEvaluation_mk {K ι : Type*} [Field K] [Fintype ι]
    (g : ι → K[X]) (p : K[X]) (i : ι) :
    coprimeEvaluation g (AdjoinRoot.mk (∏ j,g j) p) i=AdjoinRoot.mk (g i) p := by
  change Polynomial.aeval (AdjoinRoot.root (g i)) p=AdjoinRoot.mk (g i) p
  rw [AdjoinRoot.aeval_eq]
theorem coprimeEvaluation_surjective {K ι : Type*} [Field K] [Fintype ι]
    (g : ι → K[X]) (hcop : Pairwise (fun i j => IsCoprime (g i) (g j))) :
    Function.Surjective (coprimeEvaluation g) := by
  intro x
  have hc : Pairwise (fun i j => IsCoprime
      (Ideal.span ({g i}:Set K[X])) (Ideal.span ({g j}:Set K[X]))) := by
    intro i j hij
    exact (Ideal.isCoprime_span_singleton_iff _ _).mpr (hcop hij)
  obtain ⟨p,hp⟩ := Ideal.pi_quotient_surjective hc x
  refine ⟨AdjoinRoot.mk (∏ j,g j) p,?_⟩
  funext i
  rw [coprimeEvaluation_mk]
  exact hp i
noncomputable def coprimeQuotientEquiv {K ι : Type*} [Field K] [Fintype K] [Fintype ι]
    (g : ι → K[X]) (hm : ∀ i,(g i).Monic)
    (hcop : Pairwise (fun i j => IsCoprime (g i) (g j))) :
    AdjoinRoot (∏ i,g i) ≃ₐ[K] (∀ i,AdjoinRoot (g i)) := by
  letI (i : ι) : FiniteDimensional K (AdjoinRoot (g i)) := (AdjoinRoot.powerBasis (hm i).ne_zero).finite
  have hfm : (∏ i,g i).Monic := Polynomial.monic_prod_of_monic _ _ (fun i _ => hm i)
  letI : FiniteDimensional K (AdjoinRoot (∏ i,g i)) := (AdjoinRoot.powerBasis hfm.ne_zero).finite
  have hd : Module.finrank K (AdjoinRoot (∏ i,g i))=Module.finrank K (∀ i,AdjoinRoot (g i)) := by
    have hprod : Module.finrank K (AdjoinRoot (∏ i,g i))=(∏ i,g i).natDegree := finrank_quotient_span_eq_natDegree
    have hi (i) : Module.finrank K (AdjoinRoot (g i))=(g i).natDegree := finrank_quotient_span_eq_natDegree
    rw [hprod,Module.finrank_pi_fintype]
    simp_rw [hi]
    exact Polynomial.natDegree_prod_of_monic _ _ (fun i _ => hm i)
  exact AlgEquiv.ofBijective (coprimeEvaluation g)
    ⟨(LinearMap.injective_iff_surjective_of_finrank_eq_finrank (f:=(coprimeEvaluation g).toLinearMap) hd).mpr
      (coprimeEvaluation_surjective g hcop),coprimeEvaluation_surjective g hcop⟩
theorem coprime_product_units_card {K ι : Type*} [Field K] [Fintype K] [Fintype ι]
    (g : ι → K[X]) (hm : ∀ i,(g i).Monic)
    (hcop : Pairwise (fun i j => IsCoprime (g i) (g j))) :
    Nat.card (AdjoinRoot (∏ i,g i))ˣ=∏ i,Nat.card (AdjoinRoot (g i))ˣ := by
  let e := (Units.mapEquiv (coprimeQuotientEquiv g hm hcop).toRingEquiv.toMulEquiv).trans
    (MulEquiv.piUnits : (∀ i,AdjoinRoot (g i))ˣ ≃* ∀ i,(AdjoinRoot (g i))ˣ)
  rw [Nat.card_congr e.toEquiv,Nat.card_pi]
theorem irreducible_quotient_units_card {K : Type*} [Field K] [Fintype K]
    (g : K[X]) (hg : Irreducible g) : Nat.card (AdjoinRoot g)ˣ=Nat.card K^g.natDegree-1 := by
  letI : Fact (Irreducible g) := ⟨hg⟩
  letI : FiniteDimensional K (AdjoinRoot g) := (AdjoinRoot.powerBasis hg.ne_zero).finite
  letI : Finite (AdjoinRoot g) := Finite.of_injective (Module.finBasis K (AdjoinRoot g)).equivFun
    (Module.finBasis K (AdjoinRoot g)).equivFun.injective
  rw [Nat.card_units,Mathproof.Problem18DistinctDegreeSquare20260930.adjoinRoot_card]
theorem paired_quotient_units_card {K : Type*} [Field K] [Fintype K]
    (g h : K[X]) (hgm : g.Monic) (hhm : h.Monic) (hgi : Irreducible g) (hhi : Irreducible h)
    (hc : IsCoprime g h) :
    Nat.card (AdjoinRoot (g*h))ˣ=(Nat.card K^g.natDegree-1)*(Nat.card K^h.natDegree-1) := by
  classical
  let v : Fin 2 → K[X] := ![g,h]
  have hm : ∀ i,(v i).Monic := by intro i; fin_cases i <;> assumption
  have hcop : Pairwise (fun i j => IsCoprime (v i) (v j)) := by
    intro i j hij
    fin_cases i <;> fin_cases j
    · exact (hij rfl).elim
    · exact hc
    · exact hc.symm
    · exact (hij rfl).elim
  have hp := coprime_product_units_card v hm hcop
  have hv : (∏ i,v i)=g*h := by simp [v,Fin.prod_univ_two]
