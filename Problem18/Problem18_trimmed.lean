  unfold run
  erw [List.foldl_append]
  change tail.foldl (fun c bit => (Turing.TM2.step (M.program bit) c).getD c)
    (run M input coins) = run M input coins
  exact foldl_fixed_of_halted M _ hl tail
theorem halted_append (M : CoinMachine) (input coins tail : List Bool)
    (h : halted M input coins = true) : halted M input (coins ++ tail) = true := by
  unfold halted
  rw [run_append_of_halted M input coins tail h]
  exact h
theorem halted_of_length_ge (M : CoinMachine) (input : List Bool) (T : ℕ)
    (hT : ∀ coins : List Bool, coins.length = T → halted M input coins = true)
    (coins : List Bool) (hc : T ≤ coins.length) : halted M input coins = true := by
  have ht : (coins.take T).length = T := by simp [List.length_take, Nat.min_eq_left hc]
  have h := halted_append M input (coins.take T) (coins.drop T) (hT _ ht)
  simpa only [List.take_append_drop] using h
theorem survival_le_one (M : CoinMachine) (input : List Bool) (n : ℕ) :
    survival M input n ≤ 1 := by
  unfold survival
  apply (div_le_one (by positivity : (0 : ℝ) < 2 ^ n)).mpr
  have hc := Finset.card_filter_le (s := (Finset.univ : Finset (Fin n → Bool)))
    (p := fun coins => halted M input (List.ofFn coins) = false)
  have hn : (Finset.univ : Finset (Fin n → Bool)).card = 2 ^ n := by simp
  rw [hn] at hc
  exact_mod_cast hc
theorem survival_eq_zero_of_halts_at (M : CoinMachine) (input : List Bool) (T n : ℕ)
    (hT : ∀ coins : List Bool, coins.length = T → halted M input coins = true)
    (hn : T ≤ n) : survival M input n = 0 := by
  have h : ∀ coins : Fin n → Bool, halted M input (List.ofFn coins) = true := by
    intro coins
    apply halted_of_length_ge M input T hT
    simpa using hn
  simp [survival, h]
theorem expectedStepsLE_of_halts_at (M : CoinMachine) (input : List Bool) (T : ℕ)
    (hT : ∀ coins : List Bool, coins.length = T → halted M input coins = true) :
    ExpectedStepsLE M input (T : ℝ) := by
  intro N
  calc
    (∑ n ∈ Finset.range N, survival M input n) ≤
        ∑ n ∈ Finset.range N, if n < T then (1 : ℝ) else 0 := by
      apply Finset.sum_le_sum
      intro n _
      split_ifs with hn
      · exact survival_le_one M input n
      · rw [survival_eq_zero_of_halts_at M input T n hT (Nat.le_of_not_gt hn)]
    _ = (((Finset.range N).filter (fun n => n < T)).card : ℝ) := by simp
    _ ≤ (T : ℝ) := by
      have hsub : (Finset.range N).filter (fun n => n < T) ⊆ Finset.range T := by
        intro n hn
        exact Finset.mem_range.mpr (Finset.mem_filter.mp hn).2
      exact_mod_cast (Finset.card_le_card hsub).trans_eq (Finset.card_range T)
end Mathproof.Problem18DeterministicRuntime20260930
