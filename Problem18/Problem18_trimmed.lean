variable {F L : Type*} [Field F] [Field L] [Algebra F L]
theorem valuation_comap_nontrivial [Algebra.IsAlgebraic F L]
    (v : Valuation L ℤᵐ⁰) [v.IsNontrivial] :
    (v.comap (algebraMap F L)).IsNontrivial := by
  by_contra hn
  letI : v.IsTrivialOn F := ⟨fun c hc => by
    by_contra h
    apply hn
    exact ⟨c, by simpa using (algebraMap F L).injective.ne (by simpa using hc), h⟩⟩
  obtain ⟨x,hx,hv⟩ := Valuation.IsNontrivial.exists_lt_one (v := v)
  exact (Valuation.transcendental_of_ne_one F x hx hv.ne) (Algebra.IsAlgebraic.isAlgebraic x)
variable (k F : Type*) [Field k] [Field F] [Algebra k F]
def placeOfValuation (v : Valuation F ℤᵐ⁰) [v.IsNontrivial]
    (hc : ∀ c : k, v (algebraMap k F c) ≤ 1) : FunctionField.Place k F where
  toValuationSubring := v.valuationSubring
  ne_top h := ((Valuation.valuationSubring_eq_top_iff v).mp h) inferInstance
  triv_on_k := hc
  isDiscrete := ⟨(v.isEquiv_valuation_valuationSubring.symm.orderMonoidIso).trans
    (Valuation.IsRankOneDiscrete.valueGroup₀_equiv_withZeroMulInt v)⟩
variable (L : Type*) [Field L] [Algebra k L] [Algebra F L] [IsScalarTower k F L]
  [Algebra.IsAlgebraic F L]
def restrictPlace (v : FunctionField.Place k L) : FunctionField.Place k F :=
  letI := valuation_comap_nontrivial (F := F) v.valuation
  placeOfValuation k F (v.valuation.comap (algebraMap F L)) fun c => by
    rw [Valuation.comap_apply, ← IsScalarTower.algebraMap_apply k F L]
    by_cases hc : c = 0
    · simp [hc]
    · exact (Valuation.IsTrivialOn.eq_one c hc).le
@[simp] theorem mem_restrictPlace (v : FunctionField.Place k L) (x : F) :
    x ∈ restrictPlace k F L v ↔ algebraMap F L x ∈ v := by
  change v.valuation (algebraMap F L x) ≤ 1 ↔ _
  rw [← Valuation.mem_valuationSubring_iff, v.valuationSubring_valuation]
  rfl
theorem restrictPlace_valuation_isEquiv (v : FunctionField.Place k L) :
    (restrictPlace k F L v).valuation.IsEquiv (v.valuation.comap (algebraMap F L)) := by
  apply (Valuation.isEquiv_iff_valuationSubring _ _).mpr
  rw [FunctionField.Place.valuationSubring_valuation]
  rfl
end Mathproof.Problem18PlaceRestriction20260930
