def loopState (r : FieldNames) (modArray : String) (σ : Env) : Nat→Env
  | 0=>σ
  | t+1=>iterEnd r modArray (loopState r modArray σ t)
theorem loopState_layout {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulLayout r modArray B σ) (t : Nat) : MulLayout r modArray B (loopState r modArray σ t) := by
  induction t with
  | zero=>exact h
  | succ t ih=>exact iterEnd_layout ih
theorem loopState_vars (r : FieldNames) (modArray : String) (σ : Env) (x : String)
    (hxi : x≠r.i) (hxv : x≠r.value) (hxk : x≠r.k) (hxj : x≠r.j) (t : Nat) :
    (loopState r modArray σ t).vars x=σ.vars x := by
  induction t with
  | zero=>rfl
  | succ t ih=>exact (iterEnd_vars r modArray _ x hxi hxv hxk hxj).trans ih
theorem loopState_counter (r : FieldNames) (modArray : String) (σ : Env) (t : Nat) :
    (loopState r modArray σ t).vars r.i=σ.vars r.i+t := by
  induction t with
  | zero=>simp [loopState]
  | succ t ih=>rw [loopState,iterEnd_counter,ih]; omega
theorem loopState_lengths (r : FieldNames) (modArray : String) (σ : Env) (arr : String) (t : Nat) :
    ((loopState r modArray σ t).arrs arr).length=(σ.arrs arr).length := by
  induction t with
  | zero=>rfl
  | succ t ih=>exact (iterEnd_lengths r modArray _ arr).trans ih
theorem hornerLoop_run {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulLayout r modArray B σ) (hzero : σ.vars r.i=0) :
    Run B (.while (.lt (.var r.i) (.var r.e)) (hornerIteration r modArray)) σ
      (loopState r modArray σ (σ.vars r.e))
      ((3000*(σ.vars r.e+1)+4)*σ.vars r.e+4) := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hei:r.e≠r.i:=by tauto
  have hev:r.e≠r.value:=by tauto
  have hek:r.e≠r.k:=by tauto
  have hej:r.e≠r.j:=by tauto
  have heq (t : Nat): (loopState r modArray σ t).vars r.e=σ.vars r.e :=
    loopState_vars r modArray σ r.e hei hev hek hej t
  have hiq (t : Nat): (loopState r modArray σ t).vars r.i=t := by
    simpa only [hzero,Nat.zero_add] using loopState_counter r modArray σ t
  have he:σ.vars r.e<B:=by have hs:=h.scratch_fit; have hw:=h.scratch_word; omega
  exact countedLoop_run r.i r.e (hornerIteration r modArray) (loopState r modArray σ)
    (fun t _=>hiq t) (fun t _=>heq t) he (by
      intro t ht
      have hr:=hornerIteration_run (loopState_layout h t) (by rw [hiq,heq]; exact ht)
      simpa only [loopState,heq] using hr)
theorem loopState_read_preserved {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulLayout r modArray B σ) (arr : String) (j : Nat)
    (hj : j<(σ.arrs arr).length) (hsep : arr≠r.scratch ∨ 2*σ.vars r.e ≤ j) (t : Nat) :
    ((loopState r modArray σ t).arrs arr).getD j 0=(σ.arrs arr).getD j 0 := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hei:r.e≠r.i:=by tauto
  have hev:r.e≠r.value:=by tauto
  have hek:r.e≠r.k:=by tauto
  have hej:r.e≠r.j:=by tauto
  have heq (t : Nat): (loopState r modArray σ t).vars r.e=σ.vars r.e :=
    loopState_vars r modArray σ r.e hei hev hek hej t
  induction t with
  | zero=>rfl
  | succ t ih=>
    have hr:=iterEnd_read_preserved r modArray (loopState r modArray σ t) arr j
      (by rw [loopState_lengths]; exact hj) (by rw [heq]; exact hsep)
    exact hr.trans ih
theorem loopState_sourceCoeff {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulLayout r modArray B σ) (arr base : String)
    (hx : base∈[r.p,r.e,r.aBase,r.bBase,r.modBase])
    (hfit : σ.vars base+σ.vars r.e ≤ (σ.arrs arr).length)
    (hsep : arr≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars base)
    (t j : Nat) (hj : j<σ.vars r.e) :
    sourceCoeff (loopState r modArray σ t) arr base j=sourceCoeff σ arr base j := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hv : (loopState r modArray σ t).vars base=σ.vars base := by
    apply loopState_vars
    all_goals simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hx
    all_goals rcases hx with rfl|rfl|rfl|rfl|rfl <;> tauto
  unfold sourceCoeff
  rw [hv]
  apply loopState_read_preserved h
  · omega
  · rcases hsep with h | h
    · exact Or.inl h
    · exact Or.inr (by omega)
theorem loopState_first {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulLayout r modArray B σ) (hi0 : σ.vars r.i=0)
    (hz : ∀j<σ.vars r.e,(σ.arrs r.scratch).getD j 0=0)
    (t j : Nat) (hj : j<σ.vars r.e) :
    ((loopState r modArray σ t).arrs r.scratch).getD j 0=
      hornerCoeffs (σ.vars r.p) (σ.vars r.e) (sourceCoeff σ modArray r.modBase)
        (sourceCoeff σ r.mem r.aBase) (sourceCoeff σ r.mem r.bBase) t j := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hv (x : String) (hx : x∈[r.p,r.e]) (t : Nat) :
      (loopState r modArray σ t).vars x=σ.vars x := by
    apply loopState_vars
    all_goals simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hx
    all_goals rcases hx with rfl|rfl <;> tauto
  have heq:=hv r.e (by simp)
  have hpq:=hv r.p (by simp)
  have hiq (t : Nat) : (loopState r modArray σ t).vars r.i=t := by
    simpa only [hi0,Nat.zero_add] using loopState_counter r modArray σ t
  induction t generalizing j with
  | zero=>exact hz j hj
  | succ t ih=>
    rw [loopState,iterEnd_first (loopState_layout h t) (by rw [heq]; exact hj),
      stepValues_iterStart (loopState_layout h t)]
    dsimp only [stepValues,hornerCoeffs,hornerStep]
    rw [hpq,heq,hiq]
    rw [loopState_sourceCoeff h modArray r.modBase (by simp) h.modulus_fit h.modulus_separate t j hj,
      loopState_sourceCoeff h r.mem r.bBase (by simp) h.second_fit h.second_separate t j hj,
      loopState_sourceCoeff h r.mem r.aBase (by simp) h.first_fit h.first_separate t _
        (by have he0:=h.degree_pos; omega),
      ih (σ.vars r.e-1) (by have he0:=h.degree_pos; omega)]
    unfold shiftValue
    split_ifs
    · rfl
    · try dsimp only []
      rw [ih (j-1) (by omega)]
structure MulInput (r : FieldNames) (modArray : String) (B : Nat) (σ : Env) : Prop where
  scalar_names : (scalarNames r).Nodup
  degree_pos : 0<σ.vars r.e
  arithmetic_word : (σ.vars r.p+1)^2<B
  memory_word : (σ.arrs r.mem).length<B
  modulus_word : (σ.arrs modArray).length<B
  scratch_word : (σ.arrs r.scratch).length<B
  scratch_fit : 2*σ.vars r.e ≤ (σ.arrs r.scratch).length
  first_fit : σ.vars r.aBase+σ.vars r.e ≤ (σ.arrs r.mem).length
  second_fit : σ.vars r.bBase+σ.vars r.e ≤ (σ.arrs r.mem).length
  modulus_fit : σ.vars r.modBase+σ.vars r.e ≤ (σ.arrs modArray).length
  output_fit : σ.vars r.outBase+σ.vars r.e ≤ (σ.arrs r.mem).length
  first_separate : r.mem≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars r.aBase
  second_separate : r.mem≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars r.bBase
  modulus_separate : modArray≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars r.modBase
  output_separate : r.mem≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars r.outBase
  coefficients : ∀j<σ.vars r.e,
    sourceCoeff σ r.mem r.aBase j<σ.vars r.p ∧
    sourceCoeff σ r.mem r.bBase j<σ.vars r.p ∧
    sourceCoeff σ modArray r.modBase j<σ.vars r.p
def initialized (r : FieldNames) (σ : Env) : Env :=
  (pointState (σ.setVar r.k 0) (workNames r) (fun _=>0) (σ.vars r.e)).setVar r.i 0
theorem initialized_vars (r : FieldNames) (σ : Env) (x : String)
    (hxi : x≠r.i) (hxk : x≠r.k) (hxj : x≠r.j) :
    (initialized r σ).vars x=σ.vars x := by
  simp [initialized,pointState,workNames,hxi,hxk,hxj]
theorem initialized_counter (r : FieldNames) (σ : Env) : (initialized r σ).vars r.i=0 := by
  simp [initialized]
theorem initialized_lengths (r : FieldNames) (σ : Env) (arr : String) :
    ((initialized r σ).arrs arr).length=(σ.arrs arr).length := by
  simp [initialized,pointState_array_length]
theorem initialized_read_preserved (r : FieldNames) (σ : Env) (arr : String) (j : Nat)
    (hj : j<(σ.arrs arr).length) (hsep : arr≠r.scratch ∨ σ.vars r.e ≤ j) :
    ((initialized r σ).arrs arr).getD j 0=(σ.arrs arr).getD j 0 := by
  apply pointState_read_preserved (workNames r) (σ.setVar r.k 0)
  · exact hj
  · change arr≠r.scratch ∨ j<(σ.setVar r.k 0).vars r.k ∨
      (σ.setVar r.k 0).vars r.k+σ.vars r.e ≤ j
    rcases hsep with h | h
    · exact Or.inl h
    · right; right; simpa using h
theorem initialized_zero (r : FieldNames) (σ : Env)
    (hfit : σ.vars r.e ≤ (σ.arrs r.scratch).length) {j : Nat} (hj : j<σ.vars r.e) :
    ((initialized r σ).arrs r.scratch).getD j 0=0 := by
  have hh:=writeValues_inside (σ.arrs r.scratch) 0 (σ.vars r.e) j (fun _=>0) (by omega) hj
  simpa [initialized,pointState,workNames] using hh
theorem initialize_run {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulInput r modArray B σ) :
    Run B (.seq (initAccumulator r) (.assign r.i (.lit 0))) σ (initialized r σ)
      (102*(σ.vars r.e+1)) := by
  have he:σ.vars r.e<B:=by have hs:=h.scratch_fit; have hw:=h.scratch_word; omega
  have hr:=initAccumulator_run r σ h.scalar_names he h.scratch_word
    (by have hs:=h.scratch_fit; omega)
  have hz:=Run.assign (σ:=pointState (σ.setVar r.k 0) (workNames r) (fun _=>0) (σ.vars r.e))
    (x:=r.i) (evalB_lit (by omega : 0<B))
  exact (hr.seq hz).mono (by simp only [Expr.size]; omega)
theorem initialized_layout {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulInput r modArray B σ) : MulLayout r modArray B (initialized r σ) := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hv (x : String) (hx : x∈[r.p,r.e,r.aBase,r.bBase,r.modBase]) :
      (initialized r σ).vars x=σ.vars x := by
    apply initialized_vars
    all_goals simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hx
    all_goals rcases hx with rfl|rfl|rfl|rfl|rfl <;> tauto
  have hpq:=hv r.p (by simp)
  have heq:=hv r.e (by simp)
  have haq:=hv r.aBase (by simp)
  have hbq:=hv r.bBase (by simp)
  have hmq:=hv r.modBase (by simp)
  have hget (arr base : String) (hx : base∈[r.p,r.e,r.aBase,r.bBase,r.modBase])
      (hfit : σ.vars base+σ.vars r.e ≤ (σ.arrs arr).length)
      (hsep : arr≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars base) (j : Nat) (hj : j<σ.vars r.e) :
      sourceCoeff (initialized r σ) arr base j=sourceCoeff σ arr base j := by
    unfold sourceCoeff
    rw [hv base hx]
    apply initialized_read_preserved
    · omega
    · rcases hsep with h | h
      · exact Or.inl h
      · exact Or.inr (by omega)
  constructor
  · exact h.scalar_names
  · rw [heq]; exact h.degree_pos
  · rw [hpq]; exact h.arithmetic_word
  · rw [initialized_lengths]; exact h.memory_word
  · rw [initialized_lengths]; exact h.modulus_word
  · rw [initialized_lengths]; exact h.scratch_word
  · rw [heq,initialized_lengths]; exact h.scratch_fit
  · rw [haq,heq,initialized_lengths]; exact h.first_fit
  · rw [hbq,heq,initialized_lengths]; exact h.second_fit
  · rw [hmq,heq,initialized_lengths]; exact h.modulus_fit
  · rw [haq,heq]; exact h.first_separate
  · rw [hbq,heq]; exact h.second_separate
  · rw [hmq,heq]; exact h.modulus_separate
  · intro j hj
    rw [heq] at hj
    rw [hpq,hget r.mem r.aBase (by simp) h.first_fit h.first_separate j hj,
      hget r.mem r.bBase (by simp) h.second_fit h.second_separate j hj,
      hget modArray r.modBase (by simp) h.modulus_fit h.modulus_separate j hj,
      initialized_zero r σ (by have hs:=h.scratch_fit; omega) hj]
    refine ⟨(h.coefficients j hj).1,(h.coefficients j hj).2.1,(h.coefficients j hj).2.2,?_⟩
    have h0:=(h.coefficients 0 h.degree_pos).1
    omega
def processed (r : FieldNames) (modArray : String) (σ : Env) : Env :=
  loopState r modArray (initialized r σ) (σ.vars r.e)
def completed (r : FieldNames) (modArray : String) (σ : Env) : Env :=
  pointState (processed r modArray σ) (finishNames r)
    (fun j=>((processed r modArray σ).arrs r.scratch).getD j 0) (σ.vars r.e)
theorem processed_vars (r : FieldNames) (modArray : String) (σ : Env) (x : String)
    (hxi : x≠r.i) (hxv : x≠r.value) (hxk : x≠r.k) (hxj : x≠r.j) :
    (processed r modArray σ).vars x=σ.vars x :=
  (loopState_vars r modArray (initialized r σ) x hxi hxv hxk hxj _).trans
    (initialized_vars r σ x hxi hxk hxj)
theorem processed_lengths (r : FieldNames) (modArray : String) (σ : Env) (arr : String) :
    ((processed r modArray σ).arrs arr).length=(σ.arrs arr).length :=
  (loopState_lengths r modArray (initialized r σ) arr _).trans (initialized_lengths r σ arr)
theorem processed_layout {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulInput r modArray B σ) : MulLayout r modArray B (processed r modArray σ) :=
  loopState_layout (initialized_layout h) _
theorem mulCore_run {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulInput r modArray B σ) :
    Run B (mulCore r modArray) σ (completed r modArray σ) (10000*(σ.vars r.e+1)^2) := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hei:r.e≠r.i:=by tauto
  have hev:r.e≠r.value:=by tauto
  have hek:r.e≠r.k:=by tauto
  have hej:r.e≠r.j:=by tauto
  have hoi:r.outBase≠r.i:=by tauto
  have hov:r.outBase≠r.value:=by tauto
  have hok:r.outBase≠r.k:=by tauto
  have hoj:r.outBase≠r.j:=by tauto
  have hpi:r.p≠r.i:=by tauto
  have hpv:r.p≠r.value:=by tauto
  have hpk:r.p≠r.k:=by tauto
  have hpj:r.p≠r.j:=by tauto
  have hie:=initialized_vars r σ r.e hei hek hej
  have heq:=processed_vars r modArray σ r.e hei hev hek hej
  have hoq:=processed_vars r modArray σ r.outBase hoi hov hok hoj
  have hpq:=processed_vars r modArray σ r.p hpi hpv hpk hpj
  have hl:=processed_layout h
  have hp:σ.vars r.p<B:=by have hw:=h.arithmetic_word; nlinarith
  have hi:=initialize_run h
  have hlo : Run B (.while (.lt (.var r.i) (.var r.e)) (hornerIteration r modArray))
      (initialized r σ) (processed r modArray σ)
      ((3000*(σ.vars r.e+1)+4)*σ.vars r.e+4) := by
    simpa only [processed,hie] using hornerLoop_run (initialized_layout h) (initialized_counter r σ)
  have hf : Run B (storeLoop (finishNames r) (.get r.scratch (.var r.j)))
      (processed r modArray σ) (completed r modArray σ) (100*(σ.vars r.e+1)) := by
    have hrun:=finishAccumulator_run r (processed r modArray σ) hoj hej
      (by rw [heq]; have hs:=h.scratch_fit; have hw:=h.scratch_word; omega)
      (by rw [processed_lengths]; exact h.memory_word)
      (by rw [hoq,heq,processed_lengths]; exact h.output_fit)
      (by rw [heq,processed_lengths]; have hs:=h.scratch_fit; omega)
      (by rw [heq,hoq]; rcases h.output_separate with hh|hh
          · exact Or.inl hh
          · exact Or.inr (by omega)) hp
      (by intro j hj; simpa only [hpq] using (hl.coefficients j hj).2.2.2)
    simpa only [completed,heq] using hrun
  obtain ⟨a,ha,hia⟩:=hi
  obtain ⟨b,hb,hib⟩:=hlo
  obtain ⟨c,hc,hic⟩:=hf
  cases hia with
  | seq hinit hzero=>
    refine ⟨_,?_,BigStepB.seq hinit (BigStepB.seq hzero (BigStepB.seq hib hic))⟩
    nlinarith
theorem hornerCoeffs_congr {p e : Nat} (he : 0<e)
    {m a b m' a' b' : Nat→Nat}
    (hm : ∀j<e,m j=m' j) (ha : ∀j<e,a j=a' j) (hb : ∀j<e,b j=b' j)
    (t j : Nat) (hj : j<e) :
    hornerCoeffs p e m a b t j=hornerCoeffs p e m' a' b' t j := by
  induction t generalizing j with
  | zero=>rfl
  | succ t ih=>
    simp only [hornerCoeffs,hornerStep]
    rw [hm j hj,hb j hj,ha (e-1-t) (by omega),ih (e-1) (by omega)]
    unfold shiftValue
    split_ifs
    · rfl
    · try dsimp only []
      rw [ih (j-1) (by omega)]
def productCoeffs (r : FieldNames) (modArray : String) (σ : Env) : Nat→Nat :=
  hornerCoeffs (σ.vars r.p) (σ.vars r.e) (sourceCoeff σ modArray r.modBase)
    (sourceCoeff σ r.mem r.aBase) (sourceCoeff σ r.mem r.bBase) (σ.vars r.e)
theorem processed_first {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulInput r modArray B σ) {j : Nat} (hj : j<σ.vars r.e) :
    ((processed r modArray σ).arrs r.scratch).getD j 0=productCoeffs r modArray σ j := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hv (x : String) (hx : x∈[r.p,r.e,r.aBase,r.bBase,r.modBase]) :
      (initialized r σ).vars x=σ.vars x := by
    apply initialized_vars
    all_goals simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hx
    all_goals rcases hx with rfl|rfl|rfl|rfl|rfl <;> tauto
  have hpq:=hv r.p (by simp)
  have heq:=hv r.e (by simp)
  have hget (arr base : String) (hx : base∈[r.p,r.e,r.aBase,r.bBase,r.modBase])
      (hfit : σ.vars base+σ.vars r.e ≤ (σ.arrs arr).length)
      (hsep : arr≠r.scratch ∨ 2*σ.vars r.e ≤ σ.vars base) (i : Nat) (hi : i<σ.vars r.e) :
      sourceCoeff (initialized r σ) arr base i=sourceCoeff σ arr base i := by
    unfold sourceCoeff
    rw [hv base hx]
    apply initialized_read_preserved
    · omega
    · rcases hsep with h | h
      · exact Or.inl h
      · exact Or.inr (by omega)
  have hvalue:=loopState_first (initialized_layout h) (initialized_counter r σ)
    (by intro i hi; apply initialized_zero; have hs:=h.scratch_fit; omega
        simpa only [heq] using hi)
    (σ.vars r.e) j (by simpa only [heq] using hj)
  rw [hpq,heq] at hvalue
  refine hvalue.trans (hornerCoeffs_congr h.degree_pos ?_ ?_ ?_ _ _ hj)
  · exact hget modArray r.modBase (by simp) h.modulus_fit h.modulus_separate
  · exact hget r.mem r.aBase (by simp) h.first_fit h.first_separate
  · exact hget r.mem r.bBase (by simp) h.second_fit h.second_separate
theorem completed_output {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulInput r modArray B σ) {j : Nat} (hj : j<σ.vars r.e) :
    ((completed r modArray σ).arrs r.mem).getD (σ.vars r.outBase+j) 0=productCoeffs r modArray σ j := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hoi:r.outBase≠r.i:=by tauto
  have hov:r.outBase≠r.value:=by tauto
  have hok:r.outBase≠r.k:=by tauto
  have hoj:r.outBase≠r.j:=by tauto
  have hoq:=processed_vars r modArray σ r.outBase hoi hov hok hoj
  have hl:=processed_lengths r modArray σ r.mem
  have hread:=writeValues_inside ((processed r modArray σ).arrs r.mem)
    (σ.vars r.outBase) (σ.vars r.e) j (fun i=>((processed r modArray σ).arrs r.scratch).getD i 0)
    (by rw [hl]; exact h.output_fit) hj
  have hout : ((completed r modArray σ).arrs r.mem).getD (σ.vars r.outBase+j) 0=
      ((processed r modArray σ).arrs r.scratch).getD j 0 := by
    simpa [completed,pointState,finishNames,hoq] using hread
  exact hout.trans (processed_first h hj)
theorem mulCore_correct {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulInput r modArray B σ) :
    Run B (mulCore r modArray) σ (completed r modArray σ) (10000*(σ.vars r.e+1)^2) ∧
      ∀j<σ.vars r.e,((completed r modArray σ).arrs r.mem).getD (σ.vars r.outBase+j) 0=
        productCoeffs r modArray σ j ∧ productCoeffs r modArray σ j<σ.vars r.p := by
  refine ⟨mulCore_run h,fun j hj=>⟨completed_output h hj,?_⟩⟩
  have hp:0<σ.vars r.p:=by have h0:=(h.coefficients 0 h.degree_pos).1; omega
  exact hornerCoeffs_canonical _ _ _ hp _ _
theorem processed_read_preserved {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulInput r modArray B σ) (arr : String) (j : Nat)
    (hj : j<(σ.arrs arr).length) (hsep : arr≠r.scratch ∨ 2*σ.vars r.e ≤ j) :
    ((processed r modArray σ).arrs arr).getD j 0=(σ.arrs arr).getD j 0 := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hei:r.e≠r.i:=by tauto
  have hek:r.e≠r.k:=by tauto
  have hej:r.e≠r.j:=by tauto
  have heq:=initialized_vars r σ r.e hei hek hej
  have hr:=loopState_read_preserved (initialized_layout h) arr j
    (by rw [initialized_lengths]; exact hj) (by rw [heq]; exact hsep) (σ.vars r.e)
  apply hr.trans
  apply initialized_read_preserved r σ arr j hj
  rcases hsep with hs|hs
  · exact Or.inl hs
  · exact Or.inr (by omega)
theorem completed_vars (r : FieldNames) (modArray : String) (σ : Env) (x : String)
    (hxi : x≠r.i) (hxv : x≠r.value) (hxk : x≠r.k) (hxj : x≠r.j) :
    (completed r modArray σ).vars x=σ.vars x := by
  simpa [completed,pointState,finishNames,hxj] using processed_vars r modArray σ x hxi hxv hxk hxj
theorem completed_lengths (r : FieldNames) (modArray : String) (σ : Env) (arr : String) :
    ((completed r modArray σ).arrs arr).length=(σ.arrs arr).length := by
  simp [completed,pointState_array_length,processed_lengths]
theorem completed_read_preserved {r : FieldNames} {modArray : String} {B : Nat} {σ : Env}
    (h : MulInput r modArray B σ) (arr : String) (j : Nat) (hj : j<(σ.arrs arr).length)
    (hwork : arr≠r.scratch ∨ 2*σ.vars r.e ≤ j)
    (hout : arr≠r.mem ∨ j<σ.vars r.outBase ∨ σ.vars r.outBase+σ.vars r.e ≤ j) :
    ((completed r modArray σ).arrs arr).getD j 0=(σ.arrs arr).getD j 0 := by
  have hh:=h.scalar_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hoi:r.outBase≠r.i:=by tauto
  have hov:r.outBase≠r.value:=by tauto
  have hok:r.outBase≠r.k:=by tauto
  have hoj:r.outBase≠r.j:=by tauto
  have hoq:=processed_vars r modArray σ r.outBase hoi hov hok hoj
  have hr : ((completed r modArray σ).arrs arr).getD j 0=
      ((processed r modArray σ).arrs arr).getD j 0 := by
    apply pointState_read_preserved (finishNames r) (processed r modArray σ)
    · rw [processed_lengths]; exact hj
    · change arr≠r.mem ∨ j<(processed r modArray σ).vars r.outBase ∨
        (processed r modArray σ).vars r.outBase+σ.vars r.e ≤ j
      rw [hoq]
      exact hout
  exact hr.trans (processed_read_preserved h arr j hj hwork)
end Mathproof.Problem18IMPFieldMultiplicationLoop20261001
