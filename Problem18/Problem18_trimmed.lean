    (ht : ∀ x, f (x+h) = f x*c) : c = 1 := by
  have he : (∑ x, f x)*c = ∑ x, f x := by
    calc
      _ = ∑ x, f (x+h) := by simp_rw [ht]; rw [Finset.sum_mul]
      _ = _ := Fintype.sum_equiv (Equiv.addRight h) _ _ (fun _ => rfl)
  exact mul_left_cancel₀ hs (he.trans (mul_one _).symm)
