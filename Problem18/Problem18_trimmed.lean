def sizeAssign : List (String × SizeExpr) → Com
  | [] => .skip
  | (x,s)::xs => .seq (.assign x (expression colsR canonical.e s)) (sizeAssign xs)
def sizeAssignCost : List (String × SizeExpr) → Nat
  | [] => 1
  | (_,s)::xs => 1+(expression colsR canonical.e s).size+sizeAssignCost xs
def installed (n e : Nat) : List (String × SizeExpr) → Env → Env
  | [],σ => σ
  | (x,s)::xs,σ => installed n e xs (σ.setVar x (value s n e))
theorem installed_arrs (n e : Nat) (xs : List (String × SizeExpr)) (σ : Env) :
    (installed n e xs σ).arrs=σ.arrs := by
  induction xs generalizing σ with
  | nil => rfl
  | cons p xs ih => rcases p with ⟨x,s⟩;simp only [installed];rw [ih];rfl
theorem installed_inp (n e : Nat) (xs : List (String × SizeExpr)) (σ : Env) :
    (installed n e xs σ).inp=σ.inp := by
  induction xs generalizing σ with
  | nil => rfl
  | cons p xs ih => rcases p with ⟨x,s⟩;simp only [installed];rw [ih];rfl
theorem installed_out (n e : Nat) (xs : List (String × SizeExpr)) (σ : Env) :
    (installed n e xs σ).out=σ.out := by
  induction xs generalizing σ with
  | nil => rfl
  | cons p xs ih => rcases p with ⟨x,s⟩;simp only [installed];rw [ih];rfl
theorem installed_other (n e : Nat) (xs : List (String × SizeExpr)) (σ : Env) (y : String)
    (hy : y∉xs.map Prod.fst) : (installed n e xs σ).vars y=σ.vars y := by
  induction xs generalizing σ with
  | nil => rfl
  | cons p xs ih =>
    rcases p with ⟨x,s⟩
    simp only [List.map_cons,List.mem_cons,not_or] at hy
    simp only [installed];rw [ih _ hy.2,vars_setVar,if_neg hy.1]
theorem installed_mem (n e : Nat) (xs : List (String × SizeExpr)) (σ : Env)
    (hnd : (xs.map Prod.fst).Nodup) (x : String) (s : SizeExpr) (hx : (x,s)∈xs) :
    (installed n e xs σ).vars x=value s n e := by
  induction xs generalizing σ with
  | nil => simp at hx
  | cons p xs ih =>
    rcases p with ⟨y,t⟩
    simp only [List.map_cons,List.nodup_cons] at hnd
    simp only [installed]
    rcases List.mem_cons.mp hx with h|h
    · cases h
      rw [installed_other _ _ _ _ _ hnd.1,vars_setVar,if_pos rfl]
    · exact ih _ hnd.2 h
theorem sizeAssign_run {B n e : Nat} (xs : List (String × SizeExpr)) (σ : Env)
    (hc : σ.vars colsR=n) (he : σ.vars canonical.e=e)
    (hfresh : ∀p∈xs,p.1≠colsR ∧ p.1≠canonical.e)
    (hb : ∀p∈xs,majorant p.2 n e<B) :
    Run B (sizeAssign xs) σ (installed n e xs σ) (sizeAssignCost xs) := by
  induction xs generalizing σ with
  | nil => exact Run.skip
  | cons p xs ih =>
    rcases p with ⟨x,s⟩
    have h0 := hfresh (x,s) (by simp)
    have r1 : Run B (.assign x (expression colsR canonical.e s)) σ (σ.setVar x (value s n e))
        (1+(expression colsR canonical.e s).size) :=
      Run.assign (expression_eval s _ _ hc he (hb (x,s) (by simp)))
    have r2 := ih (σ.setVar x (value s n e))
      (by rw [vars_setVar,if_neg (Ne.symm h0.1)];exact hc)
      (by rw [vars_setVar,if_neg (Ne.symm h0.2)];exact he)
      (fun p hp=>hfresh p (by simp [hp])) (fun p hp=>hb p (by simp [hp]))
    exact r1.seq r2
end Mathproof.Problem18PairBoundaryOddAssign20261004
