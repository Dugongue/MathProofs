    have h := congrArg (PowerSeries.map (Int.castRingHom ℂ)) hP
    simpa [Q,Polynomial.polynomial_map_coe,complexDivisorZeta] using h
  have hz0 : constantCoeff (complexDivisorZeta k K)=1 := by
    simpa only [coeff_zero_eq_constantCoeff_apply] using complex_divisor_coeff_zero k K
  refine ⟨Q,Polynomial.natDegree_map_le.trans hdeg,?_,?_⟩
  · have h := congrArg (constantCoeff) hQ
    simpa only [map_mul,map_sub,map_one,constantCoeff_X,map_zero,constantCoeff_C,sub_zero,mul_zero,one_mul,Polynomial.constantCoeff_coe,hz0] using h
