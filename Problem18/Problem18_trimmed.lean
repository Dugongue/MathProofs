theorem bigStep_var_lt {B k : Nat} {c : Com} {σ τ : Env} (h : BigStepB B c σ τ k)
    (x : String) : σ.InpBounded B → σ.vars x < B → τ.vars x < B := by
  induction h with
  | skip => exact fun _ hx => hx
  | @assign σ y e v he =>
    intro _ hx
    have hv := Expr.lt_of_evalB he
    by_cases hxy : x = y
    · simpa [hxy] using hv
    · simpa [hxy] using hx
  | store _ _ _ => exact fun _ hx => hx
  | seq h1 _ ih1 ih2 =>
    intro hi hx
    exact ih2 (h1.inpBounded hi) (ih1 hi hx)
  | ite_true _ _ ih => exact ih
  | ite_false _ _ ih => exact ih
  | while_true _ h1 _ ih1 ih2 =>
    intro hi hx
    exact ih2 (h1.inpBounded hi) (ih1 hi hx)
  | while_false _ => exact fun _ hx => hx
  | @read σ y v rest hh =>
    intro hi hx
    have hv : v < B := hi v (by rw [hh]; simp)
    by_cases hxy : x = y
    · simpa [hxy] using hv
    · simpa [hxy] using hx
  | write _ => exact fun _ hx => hx
theorem run_var_lt {B k : Nat} {c : Com} {σ τ : Env} (h : Run B c σ τ k)
    (x : String) (hi : σ.InpBounded B) (hx : σ.vars x < B) : τ.vars x < B := by
  obtain ⟨_,_,hr⟩ := h
  exact bigStep_var_lt hr x hi hx
def accumulate (flag result : String) : Com :=
  .ite (.eq (.var result) (.lit 0)) .skip (.assign flag (.lit 1))
theorem accumulate_run (flag result : String) {B : Nat} {σ : Env}
    (hB : 1 < B) (hr : σ.vars result < B) :
    ∃ τ, Run B (accumulate flag result) σ τ 6 ∧
      (τ.vars flag = 0 ↔ σ.vars flag = 0 ∧ σ.vars result = 0) ∧
      (∀ x, x ≠ flag → τ.vars x = σ.vars x) ∧
      τ.arrs = σ.arrs ∧ τ.inp = σ.inp ∧ τ.out = σ.out := by
  have he := evalB_condEq (evalB_var hr) (evalB_lit (σ:=σ) (show 0 < B by omega))
  by_cases hz : σ.vars result = 0
  · have hc : (Cond.eq (.var result) (.lit 0)).evalB B σ = some true := by
      simpa [hz] using he
    refine ⟨σ,?_,by simp [hz],fun _ _ => rfl,rfl,rfl,rfl⟩
    exact (Run.ite_true (d:=.assign flag (.lit 1)) hc Run.skip).mono (by simp [Cond.size,Expr.size])
  · have hc : (Cond.eq (.var result) (.lit 0)).evalB B σ = some false := by
      simpa [hz] using he
    refine ⟨σ.setVar flag 1,?_,by simp [hz],?_,rfl,rfl,rfl⟩
    · exact Run.ite_false (c:=.skip) hc (Run.assign (evalB_lit hB))
    · intro x hx
      simp [hx]
end Mathproof.Problem18ConcreteSolverControl20261002
