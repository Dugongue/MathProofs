  have hv₁ : ∀ y, y ≠ sn.w → y ≠ sn.k → τ₁.vars y = τ.vars y := hvars₁
  have hout_block : ∀ s, (s < rs.X ∨ rs.X + n ≤ s) → s < S → val F r q.WS τ₁ s = val F r q.WS τ s :=
