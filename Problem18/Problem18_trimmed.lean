noncomputable def factorConjugate (σ : K ≃+* K) (f : K[X]) (hf : f≠0)
    (hfix : f.map σ.toRingHom=f) (p : FactorIndex f) : FactorIndex f := by
  classical
  refine ⟨p.val.map σ.toRingHom,Multiset.mem_toFinset.mpr ?_⟩
  apply (mem_normalizedFactors_iff' hf).mpr
  have hm := (factor_monic f p).map σ.toRingHom
  have hi : Irreducible (p.val.map σ.toRingHom) :=
    (MulEquiv.irreducible_iff (Polynomial.mapEquiv σ).toMulEquiv).mpr (factor_irreducible f p)
  refine ⟨hi,hm.normalize_eq_self,?_⟩
  have hd := Polynomial.map_dvd σ.toRingHom
    (dvd_of_mem_normalizedFactors (Multiset.mem_toFinset.mp p.property))
  rwa [hfix] at hd
@[simp] theorem factorConjugate_val (σ : K ≃+* K) (f : K[X]) (hf : f≠0)
    (hfix : f.map σ.toRingHom=f) (p : FactorIndex f) :
    (factorConjugate σ f hf hfix p).val=p.val.map σ.toRingHom := rfl
theorem factorConjugate_involutive (σ : K ≃+* K) (hσ : Function.Involutive σ)
    (f : K[X]) (hf : f≠0) (hfix : f.map σ.toRingHom=f) :
    Function.Involutive (factorConjugate σ f hf hfix) := by
  intro p
  apply Subtype.ext
  ext n
  simp only [factorConjugate_val,coeff_map,RingEquiv.toRingHom_eq_coe,RingHom.coe_coe]
  exact hσ _
theorem conjugate_coprime_of_ne (σ : K ≃+* K) (f : K[X]) (hf : f≠0)
    (hfix : f.map σ.toRingHom=f) (p r : FactorIndex f)
    (hne : r≠factorConjugate σ f hf hfix p) :
    IsCoprime (p.val.map σ.toRingHom) r.val := by
  classical
  let q := factorConjugate σ f hf hfix p
  have hi := factor_irreducible f q
  apply hi.coprime_iff_not_dvd.mpr
  intro hd
  have hass := (hi.dvd_irreducible_iff_associated (factor_irreducible f r)).mp hd
  have he : q.val=r.val := Polynomial.eq_of_monic_of_associated (factor_monic f q) (factor_monic f r) hass
  exact hne (Subtype.ext he.symm)
theorem hermitian_charpoly_fixed [StarRing K] {ι : Type*} [Fintype ι] [DecidableEq ι]
    (M : Matrix ι ι K) (hM : M.IsHermitian) :
    M.charpoly.map (starRingAut : K ≃+* K).toRingHom=M.charpoly := by
  rw [← Matrix.charpoly_map]
  have he : M.map (starRingAut : K ≃+* K).toRingHom=M.transpose := by
    ext i j
    exact congrArg (fun A : Matrix ι ι K => A j i) hM
  rw [he,Matrix.charpoly_transpose]
