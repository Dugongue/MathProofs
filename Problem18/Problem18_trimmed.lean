  | 1=>kernelFamily G z.2.1 (finProdFinEquiv.symm z.2.2)
  | 2=>gram d F (finProdFinEquiv.symm z.2.1) (finProdFinEquiv.symm z.2.2)
  | _=>gram d G (finProdFinEquiv.symm z.2.1) (finProdFinEquiv.symm z.2.2)
def tensor {P : Type} (ij uv : Fin a×Fin b) : StarExpr (P ⊕ OuterVar a b) Int :=
  .mul (.var (.inr (.inl (ij.1,uv.1)))) (.var (.inr (.inr (ij.2,uv.2))))
def isoP (i j : Fin a) : StarExpr (Params a b ⊕ OuterVar a b) Int :=
  sub (sumFin a fun u=>.mul (.conj (.var (.inr (.inl (u,i))))) (.var (.inr (.inl (u,j)))))
    (.const (if i=j then 1 else 0))
def isoR (i j : Fin b) : StarExpr (Params a b ⊕ OuterVar a b) Int :=
  sub (sumFin b fun u=>.mul (.conj (.var (.inr (.inr (u,i))))) (.var (.inr (.inr (u,j)))))
    (.const (if i=j then 1 else 0))
def row (s t : Fin (a*b)) : StarExpr (Params a b ⊕ OuterVar a b) Int :=
  sumPair a b fun ij=>.mul (sumPair a b fun uv=>
    .mul (.var (.inl (0,s,finProdFinEquiv uv))) (tensor ij uv))
    (.var (.inl (1,t,finProdFinEquiv ij)))
def gramT (ij kl : Fin a×Fin b) : StarExpr (Params a b ⊕ OuterVar a b) Int :=
  sub (sumPair a b fun u=>sumPair a b fun v=>
    .mul (.mul (.conj (tensor ij u)) (.var (.inl (2,finProdFinEquiv u,finProdFinEquiv v)))) (tensor kl v))
    (.var (.inl (3,finProdFinEquiv ij,finProdFinEquiv kl)))
theorem isoP_spec (d : UnitaryFieldData (K:=K) q) (F G : Matrix (Fin c) (Fin a×Fin b) K) (i j : Fin a) :
    specialize (data d F G) (isoP i j)=preserveP (b:=b) i j := by
  simp [isoP,sub,specialize,specialize_sumFin,preserveP,sxSub,sxNeg]
theorem isoR_spec (d : UnitaryFieldData (K:=K) q) (F G : Matrix (Fin c) (Fin a×Fin b) K) (i j : Fin b) :
    specialize (data d F G) (isoR i j)=preserveQ (a:=a) i j := by
  simp [isoR,sub,specialize,specialize_sumFin,preserveQ,sxSub,sxNeg]
theorem row_spec (d : UnitaryFieldData (K:=K) q) (F G : Matrix (Fin c) (Fin a×Fin b) K) (s t : Fin (a*b)) :
    specialize (data d F G) (row s t)=
      Problem18P34Frontend20261003UnitarySystem.testExpr
        (Problem18P34Frontend20261003UnitarySystem.source F) (kernelFamily G) s t := by
  simp [row,specialize_sumPair,specialize,data,tensor,tensorExpr,transformedExpr,
    Problem18P34Frontend20261003UnitarySystem.testExpr,Problem18P34Frontend20261003UnitarySystem.source]
theorem gram_spec (d : UnitaryFieldData (K:=K) q) (F G : Matrix (Fin c) (Fin a×Fin b) K) (ij kl : Fin a×Fin b) :
    specialize (data d F G) (gramT ij kl)=gramExpr (gram d F) (gram d G) ij kl := by
  simp [gramT,sub,specialize_sumPair,specialize,data,tensor,gramExpr,sxSub,sxNeg,tensorExpr]
def templates (a b : Nat) : List (StarExpr (Params a b ⊕ OuterVar a b) Int) :=
    ((List.finRange a).flatMap fun i=>(List.finRange a).map fun j=>isoP i j) ++
    ((List.finRange b).flatMap fun i=>(List.finRange b).map fun j=>isoR i j) ++
    ((List.finRange (a*b)).flatMap fun i=>(List.finRange (a*b)).map fun j=>row i j) ++
    ((List.finRange (a*b)).flatMap fun i=>(List.finRange (a*b)).map fun j=>
      gramT (finProdFinEquiv.symm i) (finProdFinEquiv.symm j))
theorem zeros (d : UnitaryFieldData (K:=K) q) (F G : Matrix (Fin c) (Fin a×Fin b) K)
    (h : ranksMatch F G) (x : OuterVar a b→K) :
    (∀p∈templates a b,(specialize (data d F G) p).eval d x=0) ↔
      ∀p∈Problem18P34Frontend20261003UnitarySystem.equations d F G,p.eval d x=0 := by
  simp only [templates,Problem18P34Frontend20261003UnitarySystem.equations,h,ite_true,
    List.forall_mem_append,List.forall_mem_flatMap,List.forall_mem_map,List.mem_finRange,
    forall_true_left,isoP_spec,isoR_spec,row_spec,gram_spec]
end
