  .add (PolyExpr.sumFin a fun i => PolyExpr.sumFin b fun j =>
    PolyExpr.sumFin a fun u => PolyExpr.sumFin b fun v =>
      .mul (.mul (.var (.inl (.inl (u,v)))) (tensorT (i,j) (u,v)))
        (.var (.inl (.inr (.inl (i,j)))))) (.var (.inl (.inr (.inr ()))))
def rowData (f k : Pair a b → K) (t : K) : RowParam a b → K :=
  Sum.elim f (Sum.elim k (fun _=>t))
theorem row_eval (F : Matrix (Fin c) (Pair a b) K) (e : Fin c → K)
    {r : Nat} (ker : Fin r → AugmentedColumn a b → K)
    (s : Fin c) (t : Fin r) (x : OuterVar a b → K) :
    interpret (Int.castRingHom K)
      (Sum.elim (rowData (F s) (fun ij=>ker t (.inl ij)) (e s*ker t (.inr ()))) x) rowT=
        (augmentedKernelEntry F e ker s t).eval x := by
