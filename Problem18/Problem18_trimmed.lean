  have h2 : (Expr.var an.a).evalB B σ = some av := by rw [← ha]; exact evalB_var (by omega)
  have h3 : (Expr.var an.c).evalB B σ = some cv := by rw [← hc]; exact evalB_var (by omega)
  have h4 : (Expr.bin .mul (.var an.a) (.var an.c)).evalB B σ = some (av * cv) :=
    evalB_bin h2 h3 (by change av * cv < B; omega)
