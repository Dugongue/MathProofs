variable {K R σ τ : Type*} [Field K] [CommRing R] {n d : Nat}
theorem boundedFunctions_nodup (n d : Nat) : (boundedFunctions n d).Nodup := by
  induction n with
  | zero=>simp [boundedFunctions]
  | succ n ih=>
    apply List.nodup_flatMap.mpr
    constructor
    · intro a ha
      apply ih.map
      intro f g h
      funext j
      exact congrFun h j.succ
    · apply (List.nodup_finRange (d+1)).imp
      intro a b hab x hx hy
      obtain ⟨f,_,rfl⟩:=List.mem_map.mp hx
      obtain ⟨g,_,hg⟩:=List.mem_map.mp hy
      apply hab
      apply Fin.ext
      exact (congrFun hg 0).symm
theorem boundedExponents_nodup (n d : Nat) : (boundedExponents n d).Nodup :=
  (boundedFunctions_nodup n d).map (fun f g h=>by
    funext i
    exact congrArg (fun e:FinExponent n=>e i) h)
theorem denseEval_valid (x : Fin n→K) (v : DenseInput n d K) (p : MvPolynomial (Fin n) K)
    (hv : ValidDenseInput d v p) : denseEval x (read v)=eval x p := by
  have hs:p.support⊆(boundedExponents n d).toFinset := by
    intro a ha
    exact List.mem_toFinset.mpr (bounded_support_mem p hv.1 ha)
  have he : (∑a∈(boundedExponents n d).toFinset,monomial a (coeff a p))=p := by
    calc
      _=∑a∈p.support,monomial a (coeff a p) := (Finset.sum_subset hs (by
        intro a ha hn
        have hz:coeff a p=0:=by simpa only [mem_support_iff,not_not] using hn
        simp only [hz,monomial_zero])).symm
      _=p:=support_sum_monomial_coeff p
  have hev:=congrArg (eval x) he
  simp only [map_sum,eval_monomial] at hev
  rw [←hev]
  simp only [denseEval,LinearMap.sum_apply,LinearMap.smul_apply,LinearMap.proj_apply,smul_eq_mul]
  simp_rw [show ∀i:Fin (boundedExponents n d).length,read v i=coeff ((boundedExponents n d)[i.val]) p
    from fun i=>hv.2 i]
  rw [Fin.sum_univ_fun_getElem (boundedExponents n d)
    (fun a=>(∏j:Fin n,x j^a j)*coeff a p),←List.sum_toFinset _ (boundedExponents_nodup n d)]
  apply Finset.sum_congr rfl
  intro a ha
  rw [Finsupp.prod_fintype _ _ (fun i=>pow_zero (x i))]
  exact mul_comm _ _
def interpretCounted (f : R→+*K) (x : σ→K) : PolyExpr σ R→K×Nat
  | .const c=>(f c,0)
  | .var i=>(x i,0)
  | .add a b=>let u:=interpretCounted f x a; let v:=interpretCounted f x b
      (u.1+v.1,u.2+v.2+1)
  | .mul a b=>let u:=interpretCounted f x a; let v:=interpretCounted f x b
      (u.1*v.1,u.2+v.2+1)
def operationNodes : PolyExpr σ R→Nat
  | .const _=>0
  | .var _=>0
  | .add a b=>operationNodes a+operationNodes b+1
  | .mul a b=>operationNodes a+operationNodes b+1
theorem interpretCounted_correct (f : R→+*K) (x : σ→K) (p : PolyExpr σ R) :
    (interpretCounted f x p).1=interpret f x p ∧ (interpretCounted f x p).2=operationNodes p := by
  induction p <;> simp_all [interpretCounted,interpret,operationNodes]
def evaluateVector {m : Nat} (f : R→+*K) (x : σ→K) (v : Vector (PolyExpr σ R) m) : Vector K m×Nat :=
  let a:=v.map (interpretCounted f x)
  (a.map Prod.fst,(a.toList.map Prod.snd).sum)
theorem evaluateVector_value {m : Nat} (f : R→+*K) (x : σ→K) (v : Vector (PolyExpr σ R) m) :
    (evaluateVector f x v).1=interpretVector f x v := by
  ext i hi
  simp [evaluateVector,interpretVector,(interpretCounted_correct f x _).1]
theorem evaluateVector_cost {m : Nat} (f : R→+*K) (x : σ→K) (v : Vector (PolyExpr σ R) m) :
    (evaluateVector f x v).2=(v.toList.map operationNodes).sum := by
  simp only [evaluateVector,Vector.toList_map,List.map_map,Function.comp_def]
  congr 1
  apply List.map_congr_left
  intro p hp
  exact (interpretCounted_correct f x p).2
def expansionMass : PolyExpr σ R→Nat
  | .const _=>1
  | .var _=>1
  | .add a b=>expansionMass a+expansionMass b
  | .mul a b=>2*expansionMass a*expansionMass b
def sparseWork (s : Sparse n σ R) : Nat := s.length+(s.map (fun a=>operationNodes a.2)).sum
@[simp] theorem sparseWork_nil : sparseWork ([]:Sparse n σ R)=0 := rfl
@[simp] theorem sparseWork_cons (a : FinExponent n×PolyExpr σ R) (s : Sparse n σ R) :
    sparseWork (a::s)=(operationNodes a.2+1)+sparseWork s := by
  simp only [sparseWork,List.length_cons,List.map_cons,List.sum_cons]
  omega
@[simp] theorem sparseWork_append (s t : Sparse n σ R) : sparseWork (s++t)=sparseWork s+sparseWork t := by
  simp only [sparseWork,List.length_append,List.map_append,List.sum_append]
  omega
theorem sparseWork_mul (s t : Sparse n σ R) : sparseWork (sparseMul s t)≤2*sparseWork s*sparseWork t := by
  have hm (a : FinExponent n×PolyExpr σ R) :
      sparseWork (t.map fun b=>(addExponent a.1 b.1,PolyExpr.mul a.2 b.2))≤
        2*(operationNodes a.2+1)*sparseWork t := by
    induction t with
    | nil=>simp
    | cons b t ih=>
      simp only [List.map_cons,sparseWork_cons,operationNodes] at *
      nlinarith
  induction s with
  | nil=>simp [sparseMul]
  | cons a s ih=>
    change sparseWork ((t.map fun b=>(addExponent a.1 b.1,PolyExpr.mul a.2 b.2))++sparseMul s t)≤_
    rw [sparseWork_append,sparseWork_cons]
    have hh:=hm a
    nlinarith
theorem expand_work (split : τ→σ⊕Fin n) (p : PolyExpr τ R) :
    sparseWork (expand split p)≤expansionMass p := by
  induction p with
  | const c=>simp [Problem18QuantifierElimination20261001.expand,sparseWork,operationNodes,expansionMass]
  | var i=>cases hi:split i <;> simp [Problem18QuantifierElimination20261001.expand,hi,sparseWork,operationNodes,expansionMass]
  | add a b iha ihb=>simpa only [Problem18QuantifierElimination20261001.expand,sparseWork_append,expansionMass] using Nat.add_le_add iha ihb
  | mul a b iha ihb=>exact (sparseWork_mul _ _).trans (by
      change 2*_*_≤2*expansionMass a*expansionMass b
      gcongr)
theorem sparseCoefficient_work (a : FinExponent n) (s : Sparse n σ R) :
    operationNodes (sparseCoefficient a s)≤ sparseWork s := by
  induction s with
  | nil=>simp [sparseCoefficient,PolyExpr.sum,PolyExpr.zero,operationNodes,sparseWork]
  | cons b s ih=>
    simp only [sparseCoefficient,List.map_cons,PolyExpr.sum,operationNodes,sparseWork_cons] at *
    split_ifs <;> (try simp only [operationNodes]) <;> omega
def templateRows (p : PolyExpr (σ⊕Fin n) R) (d : Nat) : Vector (PolyExpr σ R) (boundedExponents n d).length :=
  denseExpressions d (expand id p)
def templateCost (p : PolyExpr (σ⊕Fin n) R) (d : Nat) : Nat :=
  ((templateRows p d).toList.map operationNodes).sum
def evaluateTemplate (f : R→+*K) (x : σ→K) (p : PolyExpr (σ⊕Fin n) R) (d : Nat) :
    DenseInput n d K×Nat := evaluateVector f x (templateRows p d)
theorem evaluateTemplate_cost (f : R→+*K) (x : σ→K) (p : PolyExpr (σ⊕Fin n) R) (d : Nat) :
    (evaluateTemplate f x p d).2=templateCost p d := evaluateVector_cost f x _
theorem templateCost_bound (p : PolyExpr (σ⊕Fin n) R) (d : Nat) :
    templateCost p d≤(d+1)^n*expansionMass p := by
  have h (v : List (PolyExpr σ R)) (hv : ∀r∈v,operationNodes r≤expansionMass p) :
      (v.map operationNodes).sum≤v.length*expansionMass p := by
    induction v with
    | nil=>simp
    | cons r v ih=>
      have hr:=hv r List.mem_cons_self
      have ht:=ih (fun t ht=>hv t (List.mem_cons_of_mem r ht))
      simp only [List.map_cons,List.sum_cons,List.length_cons]
      nlinarith
  have hh:=h (templateRows p d).toList (by
    intro r hr
    obtain ⟨i,hi,he⟩:=List.getElem_of_mem hr
    subst r
    simp only [templateRows,denseExpressions,Vector.getElem_toList,Vector.getElem_ofFn]
    exact (sparseCoefficient_work _ _).trans (expand_work id p))
  simpa only [templateCost,Vector.length_toList,boundedExponents_length] using hh
theorem evaluateTemplate_valid (f : R→+*K) (x : σ→K) (p : PolyExpr (σ⊕Fin n) R) (d : Nat)
    (h : SparseBound (expand id p) d) :
    ValidDenseInput d (evaluateTemplate f x p d).1 (sparsePolynomial f x (expand id p)) := by
  rw [evaluateTemplate,evaluateVector_value]
  exact denseExpressions_valid f x d _ h
theorem evaluateTemplate_eval (f : R→+*K) (x : σ→K) (p : PolyExpr (σ⊕Fin n) R) (d : Nat)
    (h : SparseBound (expand id p) d) (y : Fin n→K) :
    denseEval y (read (evaluateTemplate f x p d).1)=interpret f (Sum.elim x y) p := by
  rw [denseEval_valid y _ _ (evaluateTemplate_valid f x p d h),expand_eval]
  rfl
variable [DecidableEq K]
def compressTemplates (f : R→+*K) (x : σ→K) (ps : List (PolyExpr (σ⊕Fin n) R)) (d : Nat) :
    List (DenseInput n d K)×Nat :=
  let rows:=ps.map (fun p=>evaluateTemplate f x p d)
  let reduced:=compress (rows.map Prod.fst)
  (reduced.1,(rows.map Prod.snd).sum+reduced.2)
theorem compressTemplates_correct (f : R→+*K) (x : σ→K)
    (ps : List (PolyExpr (σ⊕Fin n) R)) (d : Nat)
    (hd : ∀p∈ps,p.degree≤d) :
    (compressTemplates f x ps d).1.length≤(d+1)^n ∧
    (compressTemplates f x ps d).2≤
      (ps.map (fun p=>templateCost p d)).sum+ps.length*testBudget ((d+1)^n) ∧
    ∀y:Fin n→K,
      (∀v∈(compressTemplates f x ps d).1,denseEval y (read v)=0) ↔
      ∀p∈ps,interpret f (Sum.elim x y) p=0 := by
  have hbound (p) (hp:p∈ps) : SparseBound (expand id p) d :=
    fun a ha=>(expand_bound id p a ha).trans (hd p hp)
  have hh:=formal_polynomial_compression
    ((ps.map (fun p=>evaluateTemplate f x p d)).map Prod.fst)
  refine ⟨hh.1,?_,?_⟩
  · have hc : ((ps.map (fun p=>evaluateTemplate f x p d)).map Prod.snd).sum=
        (ps.map (fun p=>templateCost p d)).sum := by
      simp only [List.map_map,Function.comp_def,evaluateTemplate_cost]
    change _+_≤_
    rw [hc]
    simpa only [List.length_map] using Nat.add_le_add_left hh.2.1 _
  · intro y
    change (∀v∈(compress _).1,denseEval y (read v)=0) ↔ _
    rw [hh.2.2 y]
    simp only [List.forall_mem_map]
    exact forall₂_congr fun p hp=>by rw [evaluateTemplate_eval f x p d (hbound p hp) y]
end Mathproof.Problem18ExpressionCoefficientBackend20261001
