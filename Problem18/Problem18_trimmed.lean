    · refine ⟨by dsimp [tau];simp;omega,?_,?_,?_,?_,?_,?_,?_⟩
      · simpa [tau,rho1,copyIndex,copyCount] using h.2.1
      · simpa [tau,rho1,copyIndex,externalBase] using h.2.2.1
