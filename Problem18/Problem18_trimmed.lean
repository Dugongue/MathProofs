  change (∀ x y, standardHermitian n (C.toLin' x) (C.toLin' y) =
    standardHermitian n (D.toLin' x) (D.toLin' y)) ↔ _ at hg
  rw [hg] at hw
  rw [← hw]
  constructor
  · rintro ⟨R, hR, hRD⟩
    refine ⟨unitaryEquiv R hR, ?_, unitaryEquiv_preserves R hR⟩
    intro x
