    rw [hP5, f4 j (Or.inl (by omega)), hP2, f2 j (Or.inl (by omega)), arr1]
  have wzero : ∀ k < F.e*5, (ν5.arrs canonical.mem).getD (F.e+1+k) 0 = 0 := by
