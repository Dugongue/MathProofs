theorem range_mul_right_inverse {n m : ℕ}
    (M : Matrix (Fin n) (Fin m) K) (R S : Matrix (Fin m) (Fin m) K)
    (hRS : R*S=1) : LinearMap.range (M*R).mulVecLin = LinearMap.range M.mulVecLin := by
  have htop : LinearMap.range R.mulVecLin = ⊤ := by
    apply LinearMap.range_eq_top.mpr
    intro x
    refine ⟨S *ᵥ x, ?_⟩
    change R *ᵥ (S *ᵥ x) = x
    rw [Matrix.mulVec_mulVec, hRS, Matrix.one_mulVec]
  rw [Matrix.mulVecLin_mul, LinearMap.range_comp_of_range_eq_top _ htop]
