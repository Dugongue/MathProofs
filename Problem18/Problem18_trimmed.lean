abbrev OccurrenceOperators (B : Form σ V) (C : Form σ W) (f : K[X]) :=
  {T : SelfAdjointOperators σ (sumForm σ B C) // Nonempty (SpectralMarkings σ B C f T)}
abbrev AllIncidences (B : Form σ V) (C : Form σ W) (f : K[X]) :=
  (A : SourceOperators σ B f) × MarkedOperators σ B C A.val
noncomputable def allIncidenceEquiv (B : Form σ V) (C : Form σ W) (f : K[X]) :
