  have hprod := shape_prod (sortOrder a b c) a b c
  have hsum := shape_sum (sortOrder a b c) a b c
  refine ⟨tau,?_,?_,?_,?_,?_⟩
  · simpa [largePrefixCost] using hpay.seq hgrun
  · exact {
