    rw [Mathproof.Problem18IMPAssignments20261002.applyValues_cons]
    simp only [List.map_cons, List.nodup_cons] at hnd
    rcases List.mem_cons.mp hx with h | h
    · subst h
      rw [Mathproof.Problem18IMPAssignments20261002.applyValues_vars _ _ _ _ hnd.1]
      simp [Env.setVar]
    · exact ih _ hnd.2 h
