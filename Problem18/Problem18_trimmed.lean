macro "ksimp" : tactic => `(tactic| simp [state,bindings,copied,q,canonical,ws,
  Problem18ConcreteSolverNames20261002.names,height,width,banksBase,outputBase,matrixBase,
  savedBanks,savedOutput,savedTranspose])
variable {K : Type} [Field K] [Fintype K] (F : FieldPresentation K)
theorem run {B S c m : Nat} (σ : Env) (hS : Slots F canonical ws S B σ)
    (hc : σ.vars height=c) (hm : σ.vars width=m) (hcm : c+m < B)
    (hb : σ.vars savedBanks < B) (ho : σ.vars savedOutput < B) (hv : σ.vars savedTranspose < B) :
    Run B program σ (state c m σ) 17 ∧ Slots F canonical ws S B (state c m σ) ∧
      (state c m σ).vars q.N=c+m ∧ (state c m σ).vars q.n=c ∧
      (state c m σ).vars q.c=m ∧ (state c m σ).vars q.WS=σ.vars ws ∧
      (state c m σ).vars banksBase=σ.vars savedBanks ∧
      (state c m σ).vars outputBase=σ.vars savedOutput ∧
      (state c m σ).vars matrixBase=σ.vars savedTranspose := by
  have hwsB:σ.vars ws < B:=by have hf:=hS.fit;have hh:=hS.base.memory_word;omega
  have hbounds:∀p∈bindings,σ.vars p.2 < B:=by
    intro p hp
    simp only [bindings,List.mem_cons,List.not_mem_nil,or_false] at hp
    rcases hp with rfl|rfl|rfl|rfl|rfl|rfl
    · exact hwsB
    · rw [hc];omega
    · rw [hm];omega
    · exact hb
    · exact ho
    · exact hv
  have hd:∀p∈bindings,∀r∈bindings,p.1≠r.2:=by
    simp [bindings,q,canonical,ws,Problem18ConcreteSolverNames20261002.names,height,width,
      banksBase,outputBase,matrixBase,savedBanks,savedOutput,savedTranspose]
  have hr:=copies_run bindings σ hbounds hd
  let η:=copied bindings σ
  have hη:Slots F canonical ws S B η:=copied_slots F bindings σ hS (by
    simp [bindings,q,canonical,ws,Problem18ConcreteSolverNames20261002.names,
      banksBase,outputBase,matrixBase])
  have he:η.vars height=c:=by simpa [η,bindings,copied,q,canonical,ws,
    Problem18ConcreteSolverNames20261002.names,height,width,banksBase,outputBase,matrixBase,
    savedBanks,savedOutput,savedTranspose] using hc
  have hm':η.vars width=m:=by simpa [η,bindings,copied,q,canonical,ws,
    Problem18ConcreteSolverNames20261002.names,height,width,banksBase,outputBase,matrixBase,
    savedBanks,savedOutput,savedTranspose] using hm
  have ec:(Expr.var height).evalB B η=some c:=by rw [evalB_var_iff,he];exact ⟨rfl,by omega⟩
  have em:(Expr.var width).evalB B η=some m:=by rw [evalB_var_iff,hm'];exact ⟨rfl,by omega⟩
  refine ⟨(hr.seq (Run.assign (x:=q.N) (evalB_bin (op:=Bop.add) ec em hcm))).mono (by simp [bindings,Expr.size]),
    slots_set F hη q.N _ (by decide) (by decide) (by decide) (by decide) (by decide),?_,?_,?_,?_,?_,?_,?_⟩
  · ksimp
  · simpa [state,bindings,copied,q,canonical,ws,Problem18ConcreteSolverNames20261002.names,
      height,width,banksBase,outputBase,matrixBase,savedBanks,savedOutput,savedTranspose] using hc
  · simpa [state,bindings,copied,q,canonical,ws,Problem18ConcreteSolverNames20261002.names,
      height,width,banksBase,outputBase,matrixBase,savedBanks,savedOutput,savedTranspose] using hm
  all_goals ksimp
