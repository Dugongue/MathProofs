  · apply (hcopyRun.seq (hinstall.seq (hprodRun.seq hinc))).mono
    simp [powerBody,copyCurrentGram,powerStepCost,powerCopyCost]
    omega
  · change (tau.arrs canonical.mem).length = _
    rw [hlenTau, hlenXi]
theorem powerProgram_run_frame {B a b c n gram base work : Nat} {sigma : Env}
    {G : Matrix (Fin n) (Fin n) K}
    (h : RuntimeLayout F B a b c n gram base work sigma)
    (hG : Problem18IMPMatrixMemory20261001.matrix F sigma gram n n = G) :
    ∃ tau,
      Run B powerProgram sigma tau (powerProgramCost F n c) ∧
      RuntimeLayout F B a b c n gram base work tau ∧
      PowerInvariant F B n base gram c G tau ∧
      NativeFrame F n c base work sigma tau := by
  obtain ⟨rho,hinit,hR,hI,hF0,hL0⟩ := power_initial_run_frame F h hG
  let Inv : Env → Prop := fun z =>
    ∃ k, 1 <= k ∧ k <= c ∧ z.vars powerCursor = k ∧
      RuntimeLayout F B a b c n gram base work z ∧
      PowerInvariant F B n base gram k G z ∧
      NativeFrame F n c base work sigma z ∧
      (z.arrs canonical.mem).length = (sigma.arrs canonical.mem).length
  let V : Env → Nat := fun z => c-z.vars powerCursor
  have hdef : ∀ z, Inv z →
      ∃ v, (Cond.lt (.var powerCursor) exC).evalB B z = some v := by
    intro z hz
    obtain ⟨k,hk,hkc,hcur,hzR,hzI,-,-⟩ := hz
    have ec : (Expr.var powerCursor).evalB B z = some k := by
      have hh := evalB_var (B:=B) (x:=powerCursor) (σ:=z)
        (by rw [hcur]; exact lt_of_le_of_lt hkc hzR.c_word)
      simpa [hcur] using hh
    have eC : exC.evalB B z = some c := by
      simpa [exC,evalB_var_iff,hzR.dimC_eq] using hzR.c_word
    exact ⟨decide (k<c),evalB_condLt ec eC⟩
  have hstep : ∀ z, Inv z →
      (Cond.lt (.var powerCursor) exC).evalB B z = some true →
      ∃ w, Run B powerBody z w (powerStepCost F n) ∧ Inv w ∧ V w < V z := by
    intro z hz hcond
    obtain ⟨k,hk,hkc,hcur,hzR,hzI,hzF,hzL⟩ := hz
    have ec : (Expr.var powerCursor).evalB B z = some k := by
      have hh := evalB_var (B:=B) (x:=powerCursor) (σ:=z)
        (by rw [hcur]; exact lt_of_le_of_lt hkc hzR.c_word)
      simpa [hcur] using hh
    have eC : exC.evalB B z = some c := by
      simpa [exC,evalB_var_iff,hzR.dimC_eq] using hzR.c_word
    have ht := evalB_condLt ec eC
    rw [hcond] at ht
    have hlt : k<c := by simpa using ht.symm
    obtain ⟨w,hrw,hwR,hwI,hwF,hwL⟩ := power_iteration_run_frame F hzR hzI hk hlt
    refine ⟨w,hrw,?_,?_⟩
    · exact ⟨k+1,by omega,by omega,hwI.cursor_eq,hwR,hwI,
        nativeFrame_trans F hzF hwF hzL, hwL.trans hzL⟩
    · dsimp [V]
      rw [hwI.cursor_eq,hcur]
      omega
  have hInvRho : Inv rho := ⟨1,by omega,h.c_pos,hI.cursor_eq,hR,hI,hF0,hL0⟩
  obtain ⟨tau,hloop,hTau,hfalse⟩ :=
    Run.while_count Inv V (powerStepCost F n) hdef hstep hInvRho
  obtain ⟨k,hk,hkc,hcur,hTR,hTI,hTF,-⟩ := hTau
  have ec : (Expr.var powerCursor).evalB B tau = some k := by
    have hh := evalB_var (B:=B) (x:=powerCursor) (σ:=tau)
      (by rw [hcur]; exact lt_of_le_of_lt hkc hTR.c_word)
    simpa [hcur] using hh
  have eC : exC.evalB B tau = some c := by
    simpa [exC,evalB_var_iff,hTR.dimC_eq] using hTR.c_word
  have ht := evalB_condLt ec eC
  rw [hfalse] at ht
  have hkcEq : k=c := by
    have hnlt : ¬k<c := by simpa using ht.symm
    omega
  have hTIc : PowerInvariant F B n base gram c G tau := by
    rw [←hkcEq]
    exact hTI
  have hV : V rho = c-1 := by
    dsimp [V]
    rw [hI.cursor_eq]
  refine ⟨tau,?_,hTR,hTIc,hTF⟩
  have hall := Problem18IMPMatrixProductStep20261001.run_seq_assoc (hinit.seq hloop)
  rw [hV] at hall
  simpa [powerProgram,powerProgramCost] using hall
end Mathproof.Problem18P36LargeFirstExecution20261004
