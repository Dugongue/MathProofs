theorem markedFiber_inverse_charpoly (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingLeft) (A : SelfAdjointOperators σ B)
    (j : EmbeddingOrbit σ B C) (D : SelfAdjointOperators σ C) :
    ((markedFiberEquiv σ B C hB A j).symm D).val.val.charpoly=
      A.val.charpoly*D.val.charpoly := by
  let Q : Isometries σ (sumForm σ B C) := Classical.choose j.property
  change (Q.val.conj (A.val.prodMap D.val)).charpoly=_
  rw [LinearEquiv.charpoly_conj,LinearMap.charpoly_prodMap]
theorem markedFiber_charpoly (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingLeft) (A : SelfAdjointOperators σ B)
    (j : EmbeddingOrbit σ B C) (T : MarkedFiber σ B C A j.val) :
    T.val.val.charpoly=A.val.charpoly*(markedFiberEquiv σ B C hB A j T).val.charpoly := by
  have h := markedFiber_inverse_charpoly σ B C hB A j (markedFiberEquiv σ B C hB A j T)
  simpa only [Equiv.symm_apply_apply] using h
noncomputable def conditionedMarkedFiberEquiv (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingLeft) (A : SelfAdjointOperators σ B)
    (j : EmbeddingOrbit σ B C) (P : K[X] → Prop) :
    {T : MarkedFiber σ B C A j.val // P (T.val.val.charpoly/A.val.charpoly)} ≃
      {D : SelfAdjointOperators σ C // P D.val.charpoly} :=
  (markedFiberEquiv σ B C hB A j).subtypeEquiv (fun T => by
    rw [markedFiber_charpoly σ B C hB A j T,mul_div_cancel_left₀ _ A.val.charpoly_monic.ne_zero])
theorem conditioned_marked_fiber_card (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingLeft) (A : SelfAdjointOperators σ B)
    (j : EmbeddingOrbit σ B C) (P : K[X] → Prop) :
    Nat.card {T : MarkedFiber σ B C A j.val // P (T.val.val.charpoly/A.val.charpoly)}=
      Nat.card {D : SelfAdjointOperators σ C // P D.val.charpoly} :=
  Nat.card_congr (conditionedMarkedFiberEquiv σ B C hB A j P)
abbrev ConditionedMarked (B : Form σ V) (C : Form σ W)
    (A : SelfAdjointOperators σ B) (P : K[X] → Prop) :=
  (j : EmbeddingOrbit σ B C) ×
    {T : MarkedFiber σ B C A j.val // P (T.val.val.charpoly/A.val.charpoly)}
theorem conditioned_marked_card [Finite V] [Finite W]
    (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft)
    (A : SelfAdjointOperators σ B) (P : K[X] → Prop) :
    Nat.card (ConditionedMarked σ B C A P)=Nat.card (EmbeddingOrbit σ B C)*
      Nat.card {D : SelfAdjointOperators σ C // P D.val.charpoly} := by
  letI : Finite (Module.End K (V × W)) := Finite.of_injective
    (fun T : Module.End K (V × W) => (T : V × W → V × W)) DFunLike.coe_injective
