variable {K : Type} [Field K] [DecidableEq K] {a b c : ℕ}
def finalClause (u : Bool) (p q : ℕ) (H B : RectTensor a b c K) (dx dy : K) : Bool :=
  let card:=if u then q*q else q
  if u then check finProdFinEquiv.symm H B &&
    decide ((dy*dx)⁻¹ • (rawAdjoint u q H*H)=rawAdjoint u q B*B)
  else if p=2 then charTwoFinal card H B (dy*dx)
  else oddNormalizer card dy && oddNormalizer card dx && oddFinal card H B (dy*dx)
theorem rawLargeCheck_eq_final (ha : 0 < a) (hb : 0 < b) (u : Bool) (p q : ℕ)
    (A B : RectTensor a b c K) :
    rawLargeCheck ha hb u p q A B =
      match intertwiner (rawFirst u q A) (rawFirst u q B) with
      | none => false
      | some X =>
        match intertwiner (rawSecondIndexed u q A)
          (fun t => rawGram hb u q X • rawSecondIndexed u q (undoFirst B X) t) with
        | none => false
        | some Y => finalClause u p q (outerImage A Y X) B (rawGram hb u q X) (rawGram ha u q Y) :=
  rfl
def flat (H : RectTensor a b c K) : Matrix (Fin c) (Fin (a*b)) K :=
  H.submatrix id finProdFinEquiv.symm
def augM {r N : ℕ} (w : ℕ) (M : Matrix (Fin r) (Fin N) K) : Matrix (Fin r) (Fin (N+w)) K :=
  fun k t => if h : t.val < N then M k ⟨t.val, h⟩ else 1
def adjF {r N : ℕ} (ex : ℕ) (M : Matrix (Fin r) (Fin N) K) : Matrix (Fin N) (Fin r) K :=
  (M.map (fun x => x^ex)).transpose
def twoMode (u : Bool) (p : ℕ) : Bool := !u && p == 2
def oddMode (u : Bool) (p : ℕ) : Bool := !u && p != 2
def scaleOf (u : Bool) (p q : ℕ) (d : K) : K := if twoMode u p then d⁻¹^(q/2) else 1
def widthOf (u : Bool) (p : ℕ) : ℕ := if twoMode u p then 1 else 0
def expOf (u : Bool) (q : ℕ) : ℕ := if u then q else 1
def normOK (u : Bool) (p q : ℕ) (dx dy : K) : Bool :=
  if oddMode u p then
    decide (dy^(q/2)=1) && decide (dx^(q/2)=1) && decide ((dy*dx)⁻¹^(q/2)=1)
  else true
def gramOK {r N : ℕ} (ex : ℕ) (d : K) (H B : Matrix (Fin r) (Fin N) K) : Bool :=
  decide (d⁻¹ • (adjF ex H*H)=adjF ex B*B)
def kerOK {r N : ℕ} (w : ℕ) (s : K) (H B : Matrix (Fin r) (Fin N) K) : Bool :=
  kernelEqCheck (augM w (s • H)) (augM w B)
def machineClause {r N : ℕ} (u : Bool) (p q : ℕ) (H B : Matrix (Fin r) (Fin N) K)
    (dx dy : K) : Bool :=
  normOK u p q dx dy && kerOK (widthOf u p) (scaleOf u p q (dy*dx)) H B &&
    gramOK (expOf u q) (dy*dx) H B
theorem augM_zero {r N : ℕ} (M : Matrix (Fin r) (Fin N) K) : augM 0 M = M := by
  funext k t
  simp [augM, t.isLt]
theorem check_eq_kerOK (H B : RectTensor a b c K) :
    check finProdFinEquiv.symm H B = kerOK 0 1 (flat H) (flat B) := by
  unfold kerOK
  rw [one_smul, augM_zero, augM_zero]
  rfl
theorem marked_eq_aug (A : RectTensor a b c K) :
    (marked A (fun _ => (1 : K))).submatrix id
      (finSumFinEquiv.symm.trans (Equiv.sumCongr finProdFinEquiv.symm (Equiv.refl (Fin 1)))) =
      augM 1 (flat A) := by
  funext k t
  refine Fin.addCases (fun t => ?_) (fun t => ?_) t
  · simp [augM, flat, marked, t.isLt]
  · have ht : t = 0 := Subsingleton.elim _ _
    subst ht
    simp [augM, marked]
theorem markedCheck_eq_kerOK (s : K) (H B : RectTensor a b c K) :
    markedCheck finProdFinEquiv.symm (s • H) B (fun _ => 1) = kerOK 1 s (flat H) (flat B) := by
  unfold markedCheck check kerOK
  rw [marked_eq_aug, marked_eq_aug]
  rfl
theorem gram_eq (u : Bool) (q : ℕ) (d : K) (H B : RectTensor a b c K) :
    decide (d⁻¹ • (rawAdjoint u q H*H)=rawAdjoint u q B*B) =
      gramOK (expOf u q) d (flat H) (flat B) := by
  unfold gramOK
  generalize d⁻¹ = x
  congr 1
  apply propext
  have hsub : ∀ (M : RectTensor a b c K), (x • (rawAdjoint u q M*M)).submatrix
      finProdFinEquiv.symm finProdFinEquiv.symm = x • (adjF (expOf u q) (flat M)*flat M) := by
    intro M
    funext s t
    cases u <;> simp [rawAdjoint, adjF, flat, expOf, Matrix.mul_apply]
  have hsub' : ∀ (M : RectTensor a b c K), (rawAdjoint u q M*M).submatrix
      finProdFinEquiv.symm finProdFinEquiv.symm = adjF (expOf u q) (flat M)*flat M := by
    intro M
    funext s t
    cases u <;> simp [rawAdjoint, adjF, flat, expOf, Matrix.mul_apply]
  constructor
  · intro h
    rw [← hsub, ← hsub', h]
  · intro h
    rw [← hsub, ← hsub'] at h
    funext s t
    have := congrFun (congrFun h (finProdFinEquiv s)) (finProdFinEquiv t)
    simpa using this
theorem finalClause_eq (u : Bool) (p q : ℕ) (H B : RectTensor a b c K) (dx dy : K) :
    finalClause u p q H B dx dy = machineClause u p q (flat H) (flat B) dx dy := by
  cases u with
  | true =>
    simp only [finalClause, machineClause, normOK, oddMode, scaleOf, twoMode, widthOf,
      if_true, Bool.not_true, Bool.false_and, Bool.true_and, gramOK]
    rw [check_eq_kerOK, gram_eq true q]
    simp only [Bool.false_eq_true, if_false, Bool.true_and, gramOK]
  | false =>
    by_cases hp : p = 2
    · subst hp
      simp only [finalClause, machineClause, normOK, oddMode, scaleOf, twoMode, widthOf,
        charTwoFinal, gramOK]
      rw [markedCheck_eq_kerOK]
      have hg := gram_eq false q (dy*dx) H B
      simp only [rawAdjoint, Bool.false_eq_true, if_false, gramOK] at hg
      simp only [Bool.false_eq_true, if_false, Bool.not_false, Bool.true_and, bne_self_eq_false,
        Bool.false_and, beq_self_eq_true, if_true, Bool.and_true]
      rw [hg]
    · have hb : (p == 2) = false := by simpa using hp
      have hb' : (p != 2) = true := by simpa using hp
      simp only [finalClause, machineClause, normOK, oddMode, scaleOf, twoMode, widthOf,
        oddFinal, oddNormalizer, gramOK, hb, hb', hp, Bool.not_false, Bool.true_and,
        Bool.and_false, if_false, if_true, Bool.false_eq_true]
      rw [check_eq_kerOK]
      have hg := gram_eq false q (dy*dx) H B
      simp only [rawAdjoint, Bool.false_eq_true, if_false, gramOK] at hg
      rw [hg]
      simp only [Bool.and_assoc]
