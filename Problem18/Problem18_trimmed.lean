      64 * (b-1 : ℕ) * (d+1 : ℕ) * ((Fintype.card K : ℝ)^(2*b/5))⁻¹ := by
  let S := {A : AltMat b K // A.val.rank ≠ 0}
  have hd : d ≤ a*b := by nlinarith
  have hm : 1 ≤ b-d := by omega
  let i₀ : Fin a := ⟨0, by omega⟩
