  maxList ((List.range (Problem18CollisionChild20261001.childBox n d+1)).flatMap fun R =>
    (List.range (Problem18CollisionChild20261001.childBox n d+1)).map fun c =>
      rebuildCoefficient n (collDeg n d) R c)
theorem maximum_bound (xs : List Nat) (C : Nat) (h : ∀ x∈xs,x≤C) : maxList xs≤C := by
  induction xs with
  | nil => simp [maxList]
  | cons x xs ih =>
    exact max_le (h x List.mem_cons_self) (ih (fun y hy=>h y (List.mem_cons_of_mem x hy)))
theorem rebuild_maximum_bound (F : FieldPresentation K) (n d M : Nat) :
    Problem18RecursiveWorkspaceStep20261002.rebuildCost F n d M ≤ rebuildMaximum n d*scale F M := by
  apply maximum_bound
  intro x hx
  obtain ⟨R,hR,hx⟩:=List.mem_flatMap.mp hx
  obtain ⟨c,hc,rfl⟩:=List.mem_map.mp hx
  apply (rebuild_bound F n (collDeg n d) R M c).trans
  apply Nat.mul_le_mul_right
  exact le_maxList_of_mem (List.mem_flatMap.mpr ⟨R,hR,List.mem_map.mpr ⟨c,hc,rfl⟩⟩)
def stepCoefficient (n d : Nat) : Nat :=
