variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] [Finite V] (τ : K ≃+* K)
abbrev Form := V →ₛₗ[(τ : K →+* K)] Module.Dual K V
noncomputable def formEquiv (B : Form (V := V) τ) (hB : B.SeparatingLeft) :
    V ≃ Module.Dual K V := by
  classical
  have hi : Function.Injective B := LinearMap.ker_eq_bot.mp
    ((LinearMap.separatingLeft_iff_ker_eq_bot (B := B)).mp hB)
  exact Equiv.ofBijective B ⟨hi,
    (Finite.injective_iff_surjective_of_equiv
      (Module.Basis.ofVectorSpace K V).toDualEquiv.toEquiv).mp hi⟩
noncomputable def formOperator (B : Form (V := V) τ) (hB : B.SeparatingLeft)
    (C : Form (V := V) τ) : Module.End K V where
  toFun x := (formEquiv τ B hB).symm (C x)
  map_add' x y := by
    apply (formEquiv τ B hB).injective
    change (formEquiv τ B hB) ((formEquiv τ B hB).symm (C (x+y))) =
      B ((formEquiv τ B hB).symm (C x) + (formEquiv τ B hB).symm (C y))
    rw [Equiv.apply_symm_apply, B.map_add]
    change C (x+y) = (formEquiv τ B hB) ((formEquiv τ B hB).symm (C x)) +
      (formEquiv τ B hB) ((formEquiv τ B hB).symm (C y))
    simp only [Equiv.apply_symm_apply,map_add]
  map_smul' a x := by
    apply (formEquiv τ B hB).injective
    change (formEquiv τ B hB) ((formEquiv τ B hB).symm (C (a • x))) =
      B (a • (formEquiv τ B hB).symm (C x))
    rw [Equiv.apply_symm_apply, B.map_smulₛₗ]
    change C (a • x) = τ a • (formEquiv τ B hB) ((formEquiv τ B hB).symm (C x))
    simp only [Equiv.apply_symm_apply,map_smulₛₗ]
    rfl
theorem formOperator_spec (B : Form (V := V) τ) (hB : B.SeparatingLeft)
    (C : Form (V := V) τ) (x y : V) : B (formOperator τ B hB C x) y = C x y :=
  congrArg (fun g : Module.Dual K V => g y) ((formEquiv τ B hB).apply_symm_apply (C x))
theorem formOperator_injective (B : Form (V := V) τ) (hB : B.SeparatingLeft) :
    Function.Injective (formOperator τ B hB) := by
  intro C D h
  ext x y
  rw [← formOperator_spec τ B hB C,← formOperator_spec τ B hB D,h]
theorem formOperator_selfAdjoint (B : Form (V := V) τ) (hB : B.SeparatingLeft)
    (eps : K) (heps : eps ≠ 0) (hsym : ∀ x y, B y x = eps*τ (B x y))
    (C : Form (V := V) τ) (hC : ∀ x y, C y x = eps*τ (C x y)) :
    ∀ x y, B (formOperator τ B hB C x) y = B x (formOperator τ B hB C y) := by
  intro x y
  rw [formOperator_spec]
  apply τ.injective
  apply mul_left_cancel₀ heps
  rw [← hC,← hsym,formOperator_spec]
theorem formOperator_alternating (B : Form (V := V) τ) (hB : B.SeparatingLeft)
    (eps : K) (heps : eps ≠ 0) (hsym : ∀ x y, B y x = eps*τ (B x y))
    (C : Form (V := V) τ) (hC : ∀ x y, C y x = eps*τ (C x y))
    (halt : ∀ x, C x x = 0) : ∀ x, B x (formOperator τ B hB C x) = 0 := by
  intro x
  rw [← formOperator_selfAdjoint τ B hB eps heps hsym C hC,formOperator_spec,halt]
end Mathproof.Problem18SesquiOperatorForm20260930
