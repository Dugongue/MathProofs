    ext s
    change (⟨algebraMap S L s,hS s⟩:(p.valuation L).comap σ.toRingHom |>.valuationSubring)∈
      IsLocalRing.maximalIdeal _ ↔ s∈q.asIdeal
    rw [Valuation.mem_maximalIdeal_iff,Valuation.comap_apply]
    change p.valuation L (σ (algebraMap S L s))<1 ↔ s∈q.asIdeal
    rw [hστ,HeightOneSpectrum.valuation_lt_one_iff_mem]
    rw [← hpq]
    rfl
  have hne : Place.centerIdeal V hS≠⊥ := hc ▸ q.ne_bot
  have hq : Place.center V hS hne=q := by
    apply HeightOneSpectrum.ext
    exact hc
  rw [← HeightOneSpectrum.valuationSubringAtPrime_eq_valuationSubring,← hq]
  exact Place.valuationSubringAtPrime_center V hV hS hne
variable (k F L : Type*) [Field k] [Field F] [Field L]
