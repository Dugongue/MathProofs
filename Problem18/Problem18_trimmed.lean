    (renameCond rho b).evalB B (renameEnv rho sigma)=b.evalB B sigma := by
  intro b sigma
  cases b <;> simp [renameCond,Cond.evalB]
theorem rename_bigStepB (rho : String ≃ String) {B : Nat} {c : Com}
    {sigma tau : Env} {k : Nat} (h : BigStepB B c sigma tau k) :
    BigStepB B (renameCom rho c) (renameEnv rho sigma) (renameEnv rho tau) k := by
  induction h with
  | skip => exact .skip
  | assign h =>
      simpa [renameCom] using
        (BigStepB.assign ((renameExpr_evalB rho B _ _).trans h))
  | store hi he hk =>
      simpa [renameCom] using
        (BigStepB.store ((renameExpr_evalB rho B _ _).trans hi)
          ((renameExpr_evalB rho B _ _).trans he) (by simpa [renameEnv] using hk))
  | seq _ _ ih ih' => exact .seq ih ih'
  | ite_true hb _ ih =>
      simpa [renameCom] using
        (BigStepB.ite_true ((renameCond_evalB rho B _ _).trans hb) ih)
  | ite_false hb _ ih =>
      simpa [renameCom] using
        (BigStepB.ite_false ((renameCond_evalB rho B _ _).trans hb) ih)
  | while_true hb _ _ ih ih' =>
      simpa [renameCom] using
        (BigStepB.while_true ((renameCond_evalB rho B _ _).trans hb) ih ih')
  | while_false hb =>
      simpa [renameCom] using
        (BigStepB.while_false ((renameCond_evalB rho B _ _).trans hb))
  | read h =>
      simpa [renameCom,renameEnv,Env.setVar] using
        (BigStepB.read (σ:=renameEnv rho _) h)
  | write h =>
      simpa [renameCom,renameEnv] using
        (BigStepB.write ((renameExpr_evalB rho B _ _).trans h))
