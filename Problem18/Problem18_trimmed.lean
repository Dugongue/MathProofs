  | bin op e f ihe ihf => simp [renE, Expr.size, ihe, ihf]
theorem renC_size (r : String → String) (b : Cond) : (renC r b).size = b.size := by
  cases b <;> simp [renC, Cond.size, renE_size]
structure Fresh (I : Iso) : Prop where
  inj : Function.Injective I.ren
  tin : ∀ y, I.ren y ≠ I.tin
  pin : ∀ y, I.ren y ≠ I.pin
  tout : ∀ y, I.ren y ≠ I.tout
  pout : ∀ y, I.ren y ≠ I.pout
  pin_pout : I.pin ≠ I.pout
  tin_tout : I.tin ≠ I.tout
def Agree (I : Iso) (σ σ' : Env) : Prop :=
  (∀ x, σ'.vars (I.ren x) = σ.vars x) ∧ (∀ a, σ'.arrs (I.ren a) = σ.arrs a)
theorem evalB_renE {I : Iso} {σ σ' : Env} (h : Agree I σ σ') (B : Nat) (e : Expr) :
    (renE I.ren e).evalB B σ' = e.evalB B σ := by
  induction e with
  | lit n => rfl
  | var x => simp [renE, Expr.evalB, h.1 x]
  | get a i ih => simp [renE, Expr.evalB, ih, h.2 a]
  | bin op e f ihe ihf => simp [renE, Expr.evalB, ihe, ihf]
theorem evalB_renC {I : Iso} {σ σ' : Env} (h : Agree I σ σ') (B : Nat) (b : Cond) :
    (renC I.ren b).evalB B σ' = b.evalB B σ := by
  cases b <;> simp [renC, Cond.evalB, evalB_renE h]
structure Inv (I : Iso) (B : Nat) (o0 : List Nat) (R : List Nat) (σ σ' : Env) : Prop where
  agree : Agree I σ σ'
  tape : ∃ junk, (σ'.arrs I.tin).drop (σ'.vars I.pin) = σ.inp ++ junk
  tinLen : (σ'.arrs I.tin).length < B
  tinVal : ∀ v ∈ σ'.arrs I.tin, v < B
  outReal : I.redirect = false → σ'.out = o0 ++ σ.out
  outPtr : I.redirect = true → σ'.vars I.pout = o0.length + σ.out.length
  outArr : I.redirect = true → (σ'.arrs I.tout).take (σ'.vars I.pout) = o0 ++ σ.out
  outLen : I.redirect = true → (σ'.arrs I.tout).length = R.length
  LoutB : I.redirect = true → R.length < B
  outRest : I.redirect = true →
    (σ'.arrs I.tout).drop (σ'.vars I.pout) = R.drop (σ'.vars I.pout)
structure Frame (I : Iso) (σ' τ' : Env) : Prop where
  inp : τ'.inp = σ'.inp
  out : I.redirect = true → τ'.out = σ'.out
  vars : ∀ x, (∀ y, x ≠ I.ren y) → x ≠ I.pin → x ≠ I.pout → τ'.vars x = σ'.vars x
  arrs : ∀ a, (∀ y, a ≠ I.ren y) → a ≠ I.tout → τ'.arrs a = σ'.arrs a
theorem Frame.refl (I : Iso) (σ : Env) : Frame I σ σ :=
  ⟨rfl, fun _ => rfl, fun _ _ _ _ => rfl, fun _ _ _ => rfl⟩
theorem Frame.trans {I : Iso} {σ τ ρ : Env} (h : Frame I σ τ) (h' : Frame I τ ρ) :
    Frame I σ ρ :=
  ⟨h'.inp.trans h.inp, fun hr => (h'.out hr).trans (h.out hr),
    fun x hx hp ho => (h'.vars x hx hp ho).trans (h.vars x hx hp ho),
    fun a ha ho => (h'.arrs a ha ho).trans (h.arrs a ha ho)⟩
theorem out_prefix {B : Nat} {c : Com} {σ τ : Env} {k : Nat} (h : BigStepB B c σ τ k) :
    ∃ l, τ.out = σ.out ++ l := by
  induction h with
  | skip => exact ⟨[], by simp⟩
  | assign _ => exact ⟨[], by simp [Env.setVar]⟩
  | store _ _ _ => exact ⟨[], by simp [Env.setArr]⟩
  | seq _ _ ih ih' =>
      obtain ⟨l, hl⟩ := ih; obtain ⟨l', hl'⟩ := ih'
      exact ⟨l ++ l', by rw [hl', hl, List.append_assoc]⟩
  | ite_true _ _ ih => exact ih
  | ite_false _ _ ih => exact ih
  | while_true _ _ _ ih ih' =>
      obtain ⟨l, hl⟩ := ih; obtain ⟨l', hl'⟩ := ih'
      exact ⟨l ++ l', by rw [hl', hl, List.append_assoc]⟩
  | while_false _ => exact ⟨[], by simp⟩
  | read _ => exact ⟨[], by simp [Env.setVar]⟩
  | write _ => exact ⟨_, rfl⟩
theorem take_set_succ (l : List Nat) (p v : Nat) (hp : p < l.length) :
    (l.set p v).take (p+1) = l.take p ++ [v] := by
  induction l generalizing p with
  | nil => simp at hp
  | cons w ws ih =>
      cases p with
      | zero => simp
      | succ p =>
          simp only [List.set_cons_succ, List.take_succ_cons, List.cons_append]
          rw [ih p (by simpa using hp)]
theorem drop_set_succ (l : List Nat) (p v : Nat) :
    (l.set p v).drop (p+1) = l.drop (p+1) := by
  induction l generalizing p with
  | nil => simp
  | cons w ws ih =>
      cases p with
      | zero => simp
      | succ p => simp only [List.set_cons_succ, List.drop_succ_cons]; exact ih p
