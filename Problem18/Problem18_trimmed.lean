variable {K : Type*} [Field K] [Fintype K] {n t a c : ℕ}
theorem preservation_card_mul_le (B : LinearMap.BilinForm K (Fin n → K)) (hB : B.SeparatingLeft)
    (hsym : ∀x y,B y x= -B x y) (W : Submodule K (Fin n → K))
    (E : (Fin (t+a+c) → K) →ₗ[K] (Fin n → K)) (hE : Function.Injective E)
    (hw : ∀i : Fin (t+a+c), i.val<t+a → E (Pi.single i 1)∈W)
    (hz : ∀j : Fin (t+a+c), j.val<t ∨ t+a≤j.val →
      ∀w∈W,B w (E (Pi.single j 1))=0) :
    Nat.card {T : alternatingSpace B // Preserves W T.val} *
      Fintype.card K^(t.choose 2+t*a+(t+a)*c) ≤ Nat.card (alternatingSpace B) := by
  classical
  let Z := alternatingForcedSet t a c
  have hc := zero_coordinates_card_mul B hB hsym E hE Z
  have hforced (T : alternatingSpace B) (hT : Preserves W T.val)
      (p : Upper (t+a+c)) (hp : p∈Z) :
      B (T.val (E (Pi.single p.val.1 1))) (E (Pi.single p.val.2 1))=0 := by
    obtain ⟨u,hu,rfl⟩ := Finset.mem_map.mp hp
    change B (T.val (E (Pi.single (alternatingForcedPair t a c u).val.1 1)))
      (E (Pi.single (alternatingForcedPair t a c u).val.2 1))=0
    rcases u with u | u
    · apply hz _ (Or.inl (by simp only [alternatingForcedPair]; exact u.val.2.isLt))
      exact hT _ (hw _ (by simp only [alternatingForcedPair]; have := u.val.1.isLt; omega))
    · rcases u with u | u
      · rw [T.property.1,hsym]
        have hh := hz (alternatingForcedPair t a c (Sum.inr (Sum.inl u))).val.1
          (Or.inl (by simp only [alternatingForcedPair]; exact u.1.isLt))
          (T.val (E (Pi.single (alternatingForcedPair t a c (Sum.inr (Sum.inl u))).val.2 1)))
          (hT _ (hw _ (by simp only [alternatingForcedPair]; have := u.2.isLt; omega)))
        rw [hh,neg_zero]
      · apply hz _ (Or.inr (by simp only [alternatingForcedPair]; omega))
        exact hT _ (hw _ (by simp only [alternatingForcedPair]; exact u.1.isLt))
  have hcard : Nat.card {T : alternatingSpace B // Preserves W T.val} ≤
      Nat.card {T : alternatingSpace B // ∀p∈Z,
        B (T.val (E (Pi.single p.val.1 1))) (E (Pi.single p.val.2 1))=0} :=
    Nat.card_le_card_of_injective (fun T => ⟨T.val,hforced T.val T.property⟩)
      (by intro x y h; exact Subtype.ext (congrArg
        (fun z : {T : alternatingSpace B // ∀p∈Z,
          B (T.val (E (Pi.single p.val.1 1))) (E (Pi.single p.val.2 1))=0} => z.val) h))
  have hh := Nat.mul_le_mul_right (Fintype.card K^Z.card) hcard
  rw [hc] at hh
  simpa only [Z,alternatingForcedSet_card] using hh
end Mathproof.Problem18AlternatingPreservationCount20260930
end
