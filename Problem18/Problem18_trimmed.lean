def stepCost (M : FieldMacros F r) (q : RNames) (Nv nv cv : ℕ) : ℕ :=
  pivotCost M nv + 10 + elimCost M q Nv cv
def reduceCost (M : FieldMacros F r) (q : RNames) (Nv nv cv : ℕ) : ℕ :=
  2 + (4 + stepCost M q Nv nv cv) * cv + 4
noncomputable def restRows (g : ℕ → K) (Nv cv u : ℕ) : List (Fin Nv → K) :=
