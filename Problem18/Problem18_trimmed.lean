private theorem linear_prefactor (t : ℕ) (ht : 1≤t) : (2:ℝ)+176*t≤2^(16*t) := by
  obtain ⟨n,rfl⟩ := Nat.exists_eq_add_of_le ht
  induction n with
  | zero => norm_num
