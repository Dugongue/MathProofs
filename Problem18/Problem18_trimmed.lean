open MulAction
variable (G X : Type*) [Group G] [MulAction G X] [IsPretransitive G X]
def twistedFiberEquiv (τ : X ≃ X) (x : X) :
    {g : G // τ (g • x)=x} ≃ stabilizer G x := by
  let g₀ := (exists_smul_eq G x (τ.symm x)).choose
  have hg₀ : g₀ • x=τ.symm x := (exists_smul_eq G x (τ.symm x)).choose_spec
  refine
    { toFun := fun g => ⟨g₀⁻¹*g.val,?_⟩
      invFun := fun h => ⟨g₀*h.val,?_⟩
      left_inv := ?_
      right_inv := ?_ }
  · change (g₀⁻¹*g.val) • x=x
    have he : g.val • x=g₀ • x := τ.injective (g.property.trans (by rw [hg₀]; simp))
    rw [mul_smul,he,inv_smul_smul]
  · rw [mul_smul,h.property,hg₀,τ.apply_symm_apply]
  · intro g
    apply Subtype.ext
    simp
  · intro h
    apply Subtype.ext
    simp
theorem twisted_fixed_point_sum [Fintype G] [Fintype X] [Nonempty X] (τ : X ≃ X) :
    ∑ g : G, Nat.card {x : X // τ (g • x)=x}=Nat.card G := by
  classical
  have hf (x : X) : Nat.card {g : G // τ (g • x)=x}*Nat.card X=Nat.card G := by
    rw [Nat.card_congr (twistedFiberEquiv G X τ x)]
    have he := Nat.card_congr (orbitProdStabilizerEquivGroup G x)
    rw [Nat.card_prod,orbit_eq_univ,Nat.card_univ] at he
    exact (Nat.mul_comm _ _).trans he
  let e : (Σ g : G, {x : X // τ (g • x)=x}) ≃
      (Σ x : X, {g : G // τ (g • x)=x}) :=
    { toFun := fun ⟨g,x,h⟩ => ⟨x,g,h⟩
      invFun := fun ⟨x,g,h⟩ => ⟨g,x,h⟩
      left_inv := by rintro ⟨g,x,h⟩; rfl
      right_inv := by rintro ⟨x,g,h⟩; rfl }
  have he := Nat.card_congr e
  rw [Nat.card_sigma,Nat.card_sigma] at he
  rw [he]
  apply Nat.eq_of_mul_eq_mul_right (Nat.card_pos (α:=X))
  rw [Finset.sum_mul]
  simp_rw [hf]
  simp only [Finset.sum_const,Finset.card_univ,smul_eq_mul,Nat.card_eq_fintype_card]
  exact Nat.mul_comm _ _
end Mathproof.Problem18TwistedOrbitAverage20260930
