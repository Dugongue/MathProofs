  have hR := hcontains R hQR.symm
  let p := Place.center Q.toValuationSubring hQ (center_ne_bot S L _ Q.ne_top hQ)
  let q := Place.center R.toValuationSubring hR (center_ne_bot S L _ R.ne_top hR)
  have hp : (p.valuation L).valuationSubring=Q.toValuationSubring := by
    rw [← HeightOneSpectrum.valuationSubringAtPrime_eq_valuationSubring]
    exact Place.valuationSubringAtPrime_center _ Q.ne_top hQ _
