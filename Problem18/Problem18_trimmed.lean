namespace Mathproof.Problem18CountedBoundaryMatrices20261001
open Matrix Polynomial CompPoly
open Mathproof.Problem18ArrayBirdCharpoly20260930
open Mathproof.Problem18ArrayPolynomialEval20260930
open Mathproof.Problem18BinaryPower20260930
variable {K : Type*} [Field K] [BEq K] [LawfulBEq K] [DecidableEq K]
def store (n : ℕ) (f : Fin n → Fin n → K×ℕ) : Array K×ℕ :=
  let es := Array.ofFn fun ij:Fin (n*n) => f ij.divNat ij.modNat
  (es.map Prod.fst,∑ij:Fin (n*n),(es[ij.val]'(by simpa [es] using ij.isLt)).2)
theorem store_value (n : ℕ) (f : Fin n → Fin n → K×ℕ) :
    (store n f).1=arrayOf (fun i j => (f i j).1) := by
  simp only [store,Array.map_ofFn,arrayOf]
  rfl
def multiply (n : ℕ) (A B : Array K) : Array K×ℕ :=
  let r := Mathproof.Problem18CountedMatrixProducts20261001.mul (matrix n A) (matrix n B)
  (arrayOf r.1,r.2)
theorem multiply_value (n : ℕ) (A B : Array K) :
    (multiply n A B).1=arrayOf (matrix n A*matrix n B) := by
  exact congrArg arrayOf (Mathproof.Problem18CountedMatrixProducts20261001.mulValue_correct _ _)
def powerBits (n : ℕ) (A : Array K) : List Bool → Array K×ℕ
  | [] => (arrayOf (1 : Matrix (Fin n) (Fin n) K),0)
  | b::bs =>
    let r := powerBits n A bs
    let s := multiply n r.1 r.1
    if b then
      let t := multiply n s.1 A
      (t.1,r.2+s.2+t.2)
    else (s.1,r.2+s.2)
theorem powerBits_value (n : ℕ) (A : Array K) (bs : List Bool) :
    (powerBits n A bs).1=(Mathproof.Problem18ArrayMatrixPower20260930.powerBits n A bs).1 := by
  induction bs with
  | nil => rfl
  | cons b bs ih =>
    cases b <;> simp only [powerBits,Mathproof.Problem18ArrayMatrixPower20260930.powerBits,
      Bool.false_eq_true,Bool.true_eq,↓reduceIte,multiply_value,ih]
def power (n : ℕ) (A : Array K) (e : ℕ) : Array K×ℕ := powerBits n A e.bits
theorem power_value (n : ℕ) (A : Array K) (e : ℕ) :
    (power n A e).1=(Mathproof.Problem18ArrayMatrixPower20260930.power n A e).1 :=
  powerBits_value n A e.bits
def addScalar (n : ℕ) (A : Array K) (a : K) : Array K×ℕ :=
  store n fun i j => (matrix n A i j+(algebraMap K (Matrix (Fin n) (Fin n) K) a) i j,1)
theorem addScalar_value (n : ℕ) (A : Array K) (a : K) :
    (addScalar n A a).1=arrayOf (matrix n A+algebraMap K (Matrix (Fin n) (Fin n) K) a) :=
  store_value _ _
def horner (n : ℕ) (A : Array K) : List K → Array K×ℕ
  | [] => (arrayOf (0 : Matrix (Fin n) (Fin n) K),0)
  | a::as =>
    let r := horner n A as
    let m := multiply n r.1 A
    let s := addScalar n m.1 a
    (s.1,r.2+m.2+s.2)
theorem horner_value (n : ℕ) (A : Array K) (xs : List K) :
    (horner n A xs).1=evalList n A xs := by
  induction xs with
  | nil => rfl
  | cons a as ih =>
    simp only [horner,evalList,addScalar_value,multiply_value,matrix_arrayOf,ih]
def evaluate (n : ℕ) (A : Array K) (p : CPolynomial K) : Array K×ℕ :=
  horner n A p.val.toList
theorem evaluate_value (n : ℕ) (A : Array K) (p : CPolynomial K) :
    (evaluate n A p).1=Mathproof.Problem18ArrayPolynomialEval20260930.evaluate n A p :=
  horner_value _ _ _
def inverse (n : ℕ) (A : Array K) : Array K×ℕ :=
  let d := Mathproof.Problem18CountedBirdArithmetic20261001.determinant n A
  let di := d.1⁻¹
  let es := store n fun i j =>
    let m := Mathproof.Problem18CountedBirdArithmetic20261001.determinant n (arrayOf ((matrix n A).updateRow j (Pi.single i 1)))
