        if i = Nv - 1 - dv then (1 : K)
        else if Nv - 1 - i < dv then val F canonical q.WS σ (sv + (Nv - 1 - i)) else 0) ∧
      (∀ s < Sn, (s < ov ∨ ov + Nv ≤ s) →
        val F canonical q.WS τ s = val F canonical q.WS σ s) ∧
      (∀ x, x ∉ regNames canonical → x ≠ q.j → x ≠ q.N → x ≠ aw.k → x ≠ aw.ci →
        τ.vars x = σ.vars x) ∧
      τ.vars q.N = dv ∧ τ.vars q.j = dv ∧
      τ.vars aw.d = dv ∧ τ.vars aw.N = Nv ∧ τ.vars aw.src = sv ∧ τ.vars aw.out = ov ∧
      (∀ arr, arr ≠ canonical.mem → arr ≠ canonical.scratch → τ.arrs arr = σ.arrs arr) ∧
