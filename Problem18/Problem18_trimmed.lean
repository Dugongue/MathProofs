theorem caller_array_preserved {B cost : Nat} {c : Com} {σ τ : Env}
    (hc : Scoped r c) (hr : Run B c σ τ cost) (a : String)
    (hm : a ≠ r.mem) (hs : a ≠ r.scratch) : τ.arrs a=σ.arrs a := by
  apply (run_frame hr).2.1 a
  intro ha
  have := hc ha
  simpa [hm,hs] using this
theorem clause_caller_array_preserved {c m B cost D : Nat} (cl : Clause (Fin (c+m)) Int)
    {σ τ : Env} (hr : Run B (Problem18ConcreteClauseDecision20261002.program cl D) σ τ cost)
    (a : String) (hm : a ≠ canonical.mem) (hs : a ≠ canonical.scratch) :
    τ.arrs a=σ.arrs a :=
  caller_array_preserved (scope_clause cl D) hr a hm hs
