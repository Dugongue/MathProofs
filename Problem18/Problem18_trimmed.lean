theorem le_of_weighted_powers_le (a b C R : ℝ) (ha : 0<a) (hR : 0<R)
    (h : ∀ n : Nat, a*b^n≤C*R^n) : b≤R := by
  by_contra hb
  have hratio : 1<b/R := (one_lt_div hR).mpr (lt_of_not_ge hb)
  obtain ⟨n,hn⟩ := pow_unbounded_of_one_lt (C/a) hratio
  have hle : (b/R)^n≤C/a := by
    rw [div_pow]
    apply (div_le_div_iff₀ (pow_pos hR n) ha).mpr
    nlinarith [h n]
  exact (not_lt_of_ge hle) hn
theorem power_sum_radius (s : Finset ℂ) (c : ℂ → ℂ) (C R : ℝ) (hR : 0<R)
    (hbound : ∀ n : Nat, ‖∑ z∈s, c z*z^n‖≤C*R^n)
    (α : ℂ) (hα : α∈s) (hc : c α≠0) : ‖α‖≤R := by
  classical
  induction s using Finset.strongInductionOn generalizing c C with
  | _ s ih =>
    by_cases hs : s={α}
    · apply le_of_weighted_powers_le ‖c α‖ ‖α‖ C R (norm_pos_iff.mpr hc) hR
      intro n
      simpa only [hs,Finset.sum_singleton,norm_mul,norm_pow] using hbound n
    · obtain ⟨β,hβ,hβα⟩ : ∃ β∈s, β≠α := by
        by_contra hn
        apply hs
        apply Finset.eq_singleton_iff_unique_mem.mpr
        refine ⟨hα,?_⟩
        intro z hz
        by_contra hzα
        exact hn ⟨z,hz,hzα⟩
      let d : ℂ → ℂ := fun z => c z*(z-β)
      have hdiff (n : Nat) : (∑ z∈s.erase β, d z*z^n)=
          (∑ z∈s,c z*z^(n+1))-β*(∑ z∈s,c z*z^n) := by
        have he := Finset.sum_erase_add s (fun z => d z*z^n) hβ
        have hdβ : d β=0 := by simp [d]
        rw [hdβ,zero_mul,add_zero] at he
        rw [he,Finset.mul_sum,← Finset.sum_sub_distrib]
        apply Finset.sum_congr rfl
        intro z hz
        dsimp [d]
        rw [pow_succ]
        ring
      have hbound' (n : Nat) : ‖∑ z∈s.erase β,d z*z^n‖≤(C*(R+‖β‖))*R^n := by
        rw [hdiff]
        calc
          ‖(∑ z∈s,c z*z^(n+1))-β*(∑ z∈s,c z*z^n)‖ ≤
              ‖∑ z∈s,c z*z^(n+1)‖+‖β*(∑ z∈s,c z*z^n)‖ := norm_sub_le _ _
          _ ≤ C*R^(n+1)+‖β‖*(C*R^n) := by
            rw [norm_mul]
            exact add_le_add (hbound (n+1)) (mul_le_mul_of_nonneg_left (hbound n) (norm_nonneg β))
          _ = (C*(R+‖β‖))*R^n := by rw [pow_succ]; ring
      exact ih (s.erase β) (Finset.erase_ssubset hβ) d (C*(R+‖β‖)) hbound'
