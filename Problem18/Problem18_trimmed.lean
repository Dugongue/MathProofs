      · rw [if_neg hap, sub_zero, call_val hc3 (by omega) (by omega),
          call_val hc2 (by omega) (by omega), hkc _ (by omega) (by omega), hgv a ha]
    · rw [hframe 0 (by omega) (Or.inl (by omega)) (by omega) (by omega)]; exact hz
    · intro a h1 h2
      rw [hc3.arrays a h1 h2, hc2.arrays a h1 h2, harrc a h1, harr1 a h1 h2]
    · rw [hc3.inp, hc2.inp, hinpc, hinp1]
    · rw [hc3.out, hc2.out, houtc, hout1]
