variable {K : Type} [Field K] [DecidableEq K] {a b c : Nat}
abbrev Params (a b : Nat) := Fin 4 × Fin (a*b+1) × Fin (a*b+1)
def col (ij : Fin a × Fin b) : Fin (a*b+1) := (augmentedIndex a b).symm (.inl ij)
