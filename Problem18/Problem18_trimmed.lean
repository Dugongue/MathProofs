theorem charTwo_event_source_not_alternating [Fintype K] [CharP K 2] [Nontrivial V]
    (B : LinearMap.BilinForm K V) (C : LinearMap.BilinForm K W)
    (hB : B.IsSymm) (hnB : B.Nondegenerate) (p : K[X]) (hp : p.Monic) (hs : Squarefree p)
