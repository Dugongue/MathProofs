  simp only [templates,Problem18P34Frontend20261003FiniteSystem.equations,h,ite_true,
    List.forall_mem_append,List.forall_mem_flatMap,List.forall_mem_map,
    List.mem_finRange,forall_true_left,isoP_eval,isoR_eval,row_eval,gram_eval]
def finite (a b : Nat) :
    List (PolyExpr (Fin (Fintype.card (Params a b)) ⊕ Fin (Fintype.card (OuterVar a b))) Int) :=
  (templates a b).map finiteTemplate
def values (F G : Matrix (Fin c) (Fin a × Fin b) K) : Fin (Fintype.card (Params a b))→K :=
