theorem finish_pair_run {B : Nat} (σ : Env) (x y : K)
    (h : ValidMemory F B σ)
    (ho : σ.vars canonical.outBase+2*F.e≤(σ.arrs canonical.mem).length)
    (hx : decode F (slice F σ canonical (σ.vars canonical.outBase))=x)
    (hy : decode F (slice F σ canonical (σ.vars canonical.outBase+F.e))=y) :
    ∃τ,Run B (finish .coordinates) σ τ (60*(F.e+1)) ∧
      τ.out=σ.out++(coefficients F x++coefficients F y) := by
  let ξ:=σ.setVar canonical.flag (2*F.e)
  have hpB : F.p<B := by have hh:=h.arithmetic_word; nlinarith only [hh]
  have heB:=h.degree_word
  have htwo : 2*F.e<B := by have hh:=h.memory_word; omega
  have hv : (Expr.var canonical.e).evalB B σ=some F.e := by
    simpa only [h.degree] using evalB_var (σ:=σ) (x:=canonical.e) (by rw [h.degree]; exact heB)
  have heval : (Expr.mul (.lit 2) (.var canonical.e)).evalB B σ=some (2*F.e) := by
    simpa [Bop.apply] using evalB_bin (op:=Bop.mul) (evalB_lit (by have he:=F.degree_pos; omega : 2<B)) hv
      (by change 2*F.e<B; exact htwo)
  have hcA : slice F σ canonical (σ.vars canonical.outBase)=fun i=>(F.coordinate x i).val :=
    (decode_injective F (h.slice_canonical _ (by unfold Fits; omega)) (fun i=>(F.coordinate x i).isLt)).mp
      (hx.trans (decode_coordinates F x).symm)
  have hcB : slice F σ canonical (σ.vars canonical.outBase+F.e)=fun i=>(F.coordinate y i).val :=
    (decode_injective F (h.slice_canonical _ (by unfold Fits; omega)) (fun i=>(F.coordinate y i).isLt)).mp
      (hy.trans (decode_coordinates F y).symm)
  have hwrite:=writeBlock_run outputNames (by unfold Names.Valid outputNames canonical; decide) ξ (coefficients F x++coefficients F y)
    (by simpa [coefficients,two_mul] using htwo)
    (by simp [ξ,outputNames,canonical,coefficients,two_mul])
    (by simpa [ξ,outputNames,canonical,coefficients,two_mul] using ho)
    (by simpa [ξ,outputNames] using h.memory_word)
    (by intro v hv; rcases List.mem_append.mp hv with hv|hv
        · exact (coefficients_bound F x v hv).trans hpB
        · exact (coefficients_bound F y v hv).trans hpB) (by
