def arguments (r : FieldNames) (σ : Env) (a b o : Nat) : Env :=
  ((σ.setVar r.aBase a).setVar r.bBase b).setVar r.outBase o
def call (r : FieldNames) (a b o : Expr) (body : Com) : Com :=
  .seq (.assign r.aBase a) (.seq (.assign r.bBase b) (.seq (.assign r.outBase o) body))
theorem call_run (r : FieldNames) (a b o : Expr) (body : Com)
    {B av bv ov cost : Nat} {σ τ : Env}
    (ha : a.evalB B σ=some av)
    (hb : b.evalB B (σ.setVar r.aBase av)=some bv)
    (ho : o.evalB B ((σ.setVar r.aBase av).setVar r.bBase bv)=some ov)
    (hbody : Run B body (arguments r σ av bv ov) τ cost) :
    Run B (call r a b o body) σ τ (3+a.size+b.size+o.size+cost) := by
  have hh := (Run.assign (x:=r.aBase) ha).seq
    ((Run.assign (x:=r.bBase) hb).seq ((Run.assign (x:=r.outBase) ho).seq hbody))
  exact hh.mono (by omega)
theorem arguments_vars (r : FieldNames) (σ : Env) (a b o : Nat) (x : String)
    (ha : x≠r.aBase) (hb : x≠r.bBase) (ho : x≠r.outBase) :
    (arguments r σ a b o).vars x=σ.vars x := by
  simp [arguments,ha,hb,ho]
theorem arguments_arrays (r : FieldNames) (σ : Env) (a b o : Nat) :
    (arguments r σ a b o).arrs=σ.arrs := rfl
theorem install_run (r : FieldNames) (a b o : Expr)
    {B av bv ov : Nat} {σ : Env}
    (ha : a.evalB B σ=some av)
    (hb : b.evalB B (σ.setVar r.aBase av)=some bv)
    (ho : o.evalB B ((σ.setVar r.aBase av).setVar r.bBase bv)=some ov) :
    Run B (call r a b o .skip) σ (arguments r σ av bv ov)
      (4+a.size+b.size+o.size) := by
  have h := call_run r a b o .skip ha hb ho (Run.skip (B:=B))
  convert h using 1 <;> omega
variable {K : Type} [Field K] [Fintype K]
variable (F : Mathproof.Problem18AllFormatRoot20260930.FieldPresentation K)
theorem arguments_slice (r : FieldNames) (σ : Env) (a b o base : Nat) :
    slice F (arguments r σ a b o) r base=slice F σ r base := rfl
