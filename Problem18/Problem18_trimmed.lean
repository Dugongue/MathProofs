    Run.assign (evalB_lit heB)
  have hassignN : Run B (.assign gauss.N (.lit n)) ξ ζ 2 :=
    Run.assign (evalB_lit hnB)
  have hξ : Slots F canonical workspaceName (slots n) B ξ :=
    Slots.setVar F canonical h.slots (by decide) (by decide) (F.e+1)
  have hξalias : ξ.vars gauss.WS=ξ.vars workspaceName := by simp [ξ,h.workspace]
  have hξg : Slots F canonical gauss.WS (slots n) B ξ :=
    slots_alias F hξ (by decide) hξalias
  have hcopySlots : Slots F canonical gauss.WS (slots n) B ζ :=
    Slots.setVar F canonical hξg (by decide) (by decide) n
  obtain ⟨ρ,hcopy,hρ,hcopied,hmem,hvars,_,_,hri,hro⟩:=copy_run
    (fieldMacros F) gauss gauss_valid [] (by simp) (.lit (seed n)) (.lit (candidate n))
    (by simp [Problem18ClaudeIMPAxpy20261001.VarsIn])
    (by simp [Problem18ClaudeIMPAxpy20261001.VarsIn]) hcopySlots
    (dv:=seed n) (sv:=candidate n) (Nv:=n)
    (by exact evalB_lit (by omega)) (by exact evalB_lit (by omega))
    (by simp [ζ]) (by omega) (by omega) (Or.inr (by omega))
  have hcopyRun : Run B (copyProgram F n) σ ρ (copyCost F n) := by
    exact (hassignW.seq (hassignN.seq hcopy)).mono (by unfold copyCost;omega)
  have hρw : ρ.vars workspaceName=F.e+1 := by
    rw [hvars workspaceName (by decide) (by decide)]
    simpa [ζ,ξ,show workspaceName≠gauss.N by decide,
      show workspaceName≠gauss.WS by decide] using h.workspace
  have hρg : ρ.vars gauss.WS=F.e+1 := by
    rw [hvars gauss.WS (by decide) (by decide)]
    simp [ζ,ξ,show gauss.WS≠gauss.N by decide]
  have hρalias : ρ.vars workspaceName=ρ.vars gauss.WS := hρw.trans hρg.symm
  have hρcommon : Slots F canonical workspaceName (slots n) B ρ :=
    slots_alias F hρ (by decide) hρalias
  have hρn : ρ.vars dimName=n := by
    rw [hvars dimName (by decide) (by decide)]
    simpa [ζ,ξ,show dimName≠gauss.N by decide,
      show dimName≠gauss.WS by decide] using h.dimension
  have hρmod : ρ.vars canonical.modBase=0 := by
    rw [(run_frame hcopy).1 canonical.modBase (by
      simp [Problem18ClaudeIMPCopy20261001.copyLoop,
        Problem18ClaudeIMPCopy20261001.copyBody,
        Problem18ClaudeIMPAxpy20261001.mcall,
        Problem18ClaudeFieldMacros20261001.call,
        Problem18ClaudeFieldMacrosInstancePow20261001.fieldMacros,
        Problem18IMPFieldAddition20261001.pointRoutine,
        Problem18IMPFieldAddition20261001.pointBody,scalarWrites] <;> decide)]
    simpa [ζ,ξ,show canonical.modBase≠gauss.N by decide,
      show canonical.modBase≠gauss.WS by decide] using h.modulus
  have hρlen : (ρ.arrs canonical.mem).length=F.e+1+slots n*F.e := by
    rw [(run_frame hcopy).2.2.1 canonical.mem]
    exact h.length
  have hζalias : ζ.vars gauss.WS=ζ.vars workspaceName := by
    simp [ζ,ξ,h.workspace,show gauss.WS≠gauss.N by decide,
      show workspaceName≠gauss.N by decide,show workspaceName≠gauss.WS by decide]
  have hmatrixρ : Problem18IMPBoundaryAnnihilatorPhase20261002.matrixValue F n ρ=S := by
    ext i j
