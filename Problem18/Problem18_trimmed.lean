theorem unflat_injective {L : Type*} {s c : ℕ} : Function.Injective (unflat : (Fin (s * c) → L) → _) := by
  intro u v h
  funext t
  have := congrFun (congrFun h (finProdFinEquiv.symm t).1) (finProdFinEquiv.symm t).2
