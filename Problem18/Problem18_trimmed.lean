local infixl:65 " +ₛ " => Sz.add
local infixl:70 " *ₛ " => Sz.mul
local notation "Cₛ" => Sz.lit
def mcIdx : String := "P18.pairBoundary.mode.mc.idx"
def mcCnt : String := "P18.pairBoundary.mode.mc.cnt"
