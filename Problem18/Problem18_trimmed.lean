theorem twisted_balanced_of_generator (C : E →ₗ⋆[K] E →ₗ[K] K)
    (t : E) (hgen : Algebra.adjoin K ({t}:Set E)=⊤)
    (hadj : ∀ x y,C (t*x) y=C x (φ t*y)) :
    ∀ z x y,C (z*x) y=C x (φ z*y) := by
  intro z
  have hz : z∈Algebra.adjoin K ({t}:Set E) := by rw [hgen]; trivial
  induction hz using Algebra.adjoin_induction with
  | mem z hz => simpa only [Set.mem_singleton_iff.mp hz] using hadj
  | algebraMap a =>
    intro x y
    rw [hc]
    simp only [← Algebra.smul_def,map_smulₛₗ,map_smul,LinearMap.smul_apply,
      RingHom.id_apply,starRingEnd_apply]
  | add u v hu hv ihu ihv =>
    intro x y
