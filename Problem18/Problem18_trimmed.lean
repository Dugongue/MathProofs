  rw [hc, List.range_succ_eq_map, List.map_cons, List.map_map]
  rw [Nat.add_zero, List.cons.injEq]
  refine ⟨rfl, List.map_congr_left fun t _ => ?_⟩
  simp only [Function.comp_apply, Nat.succ_eq_add_one]
  rw [show u + (t + 1) = u + 1 + t by omega]
theorem restRows_end (g : ℕ → K) (Nv cv : ℕ) : restRows g Nv cv cv = [] := by
  simp [restRows]
theorem restRows_zero (g : ℕ → K) (Nv cv : ℕ) :
