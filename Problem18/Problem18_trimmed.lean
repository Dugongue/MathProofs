variable {K : Type*} [Field K] [Fintype K]
abbrev DegreeDivisorIndex {n : ℕ} (f : MonicDegree (K:=K) n) :=
  Σ d : Fin (n+1),{g : IrreducibleDegree (K:=K) d // g.val.val ∣ f.val}
noncomputable def factorDegreeIndex {n : ℕ} (f : MonicDegree (K:=K) n)
    (p : FactorIndex f.val) : DegreeDivisorIndex f := by
  classical
  have hd : p.val ∣ f.val := dvd_of_mem_normalizedFactors (Multiset.mem_toFinset.mp p.property)
  have hn : p.val.natDegree<n+1 := by
    have hh := natDegree_le_of_dvd hd f.property.1.ne_zero
    rw [f.property.2] at hh
    omega
  exact ⟨⟨p.val.natDegree,hn⟩,⟨⟨⟨p.val,factor_monic f.val p,rfl⟩,
    factor_irreducible f.val p⟩,hd⟩⟩
noncomputable def factorDegreeEquiv {n : ℕ} (f : MonicDegree (K:=K) n) :
    FactorIndex f.val ≃ DegreeDivisorIndex f where
  toFun := factorDegreeIndex f
  invFun z := ⟨z.2.val.val.val,by
    classical
    apply Multiset.mem_toFinset.mpr
    exact (mem_normalizedFactors_iff' f.property.1.ne_zero).mpr
      ⟨z.2.val.property,z.2.val.val.property.1.normalize_eq_self,z.2.property⟩⟩
  left_inv p := by apply Subtype.ext; rfl
  right_inv z := by
    rcases z with ⟨⟨d,hd⟩,⟨⟨⟨p,hm,hdeg⟩,hi⟩,hdiv⟩⟩
    cases hdeg
    rfl
theorem weight_eq_primary_sum {n : ℕ} (f : MonicDegree (K:=K) n) :
    weight f=∑ p : FactorIndex f.val,((Nat.card K:ℝ)^p.val.natDegree)⁻¹ := by
  classical
  calc
    weight f = ∑ d : Fin (n+1),∑ g : {g : IrreducibleDegree (K:=K) d // g.val.val ∣ f.val},
        ((Nat.card K:ℝ)⁻¹)^d.val := by
      unfold weight
      apply Finset.sum_congr rfl
      intro d _
      rw [← Finset.sum_filter]
      exact Finset.sum_subtype _ (by simp) (fun _ => ((Nat.card K:ℝ)⁻¹)^d.val)
    _ = ∑ z : DegreeDivisorIndex f,((Nat.card K:ℝ)⁻¹)^z.1.val :=
      (Fintype.sum_sigma (fun z : DegreeDivisorIndex f => ((Nat.card K:ℝ)⁻¹)^z.1.val)).symm
    _ = ∑ p : FactorIndex f.val,((Nat.card K:ℝ)^p.val.natDegree)⁻¹ := by
      symm
      apply Fintype.sum_equiv (factorDegreeEquiv f)
      intro p
      change ((Nat.card K:ℝ)^p.val.natDegree)⁻¹=((Nat.card K:ℝ)⁻¹)^p.val.natDegree
      exact (inv_pow (Nat.card K:ℝ) p.val.natDegree).symm
