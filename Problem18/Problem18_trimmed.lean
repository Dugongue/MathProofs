open scoped BigOperators
variable {σ τ R K : Type*} [CommRing R] [Field K]
def reindex (u : σ→τ) : PolyExpr σ R→PolyExpr τ R
  | .const c => .const c
  | .var i => .var (u i)
  | .add a b => .add (reindex u a) (reindex u b)
  | .mul a b => .mul (reindex u a) (reindex u b)
theorem interpret_reindex (f : R→+*K) (x : τ→K) (u : σ→τ) (p : PolyExpr σ R) :
    interpret f x (reindex u p)=interpret f (x ∘ u) p := by
  induction p <;> simp_all [reindex,interpret]
def exprProduct : List (PolyExpr σ R)→PolyExpr σ R
  | [] => .const 1
  | p::ps => .mul p (exprProduct ps)
theorem interpret_product_ne_zero (f : R→+*K) (x : σ→K) (ps : List (PolyExpr σ R)) :
    interpret f x (exprProduct ps)≠0 ↔ ∀ p∈ps, interpret f x p≠0 := by
  induction ps with
  | nil => simp [exprProduct,interpret]
  | cons p ps ih => simp [exprProduct,interpret,mul_ne_zero_iff,ih]
def zeroExpressions (c : Clause σ R) : List (PolyExpr σ R) :=
  c.filterMap fun l => if l.2 then some l.1 else none
def nonzeroExpressions (c : Clause σ R) : List (PolyExpr σ R) :=
  c.filterMap fun l => if l.2 then none else some l.1
theorem clauseHolds_split (f : R→+*K) (x : σ→K) (c : Clause σ R) :
    clauseHolds f x c ↔
      (∀ p∈zeroExpressions c, interpret f x p=0) ∧
      (∀ p∈nonzeroExpressions c, interpret f x p≠0) := by
  induction c with
  | nil => simp [clauseHolds,zeroExpressions,nonzeroExpressions]
  | cons l c ih =>
    rcases l with ⟨p,b⟩
    cases b <;> simp_all [clauseHolds,literalHolds,zeroExpressions,nonzeroExpressions]
    <;> tauto
theorem clauseHolds_product (f : R→+*K) (x : σ→K) (c : Clause σ R) :
    clauseHolds f x c ↔
      (∀ p∈zeroExpressions c, interpret f x p=0) ∧
      interpret f x (exprProduct (nonzeroExpressions c))≠0 := by
  rw [interpret_product_ne_zero,clauseHolds_split]
def equationExpressions (c : Clause σ R) : List (PolyExpr (σ⊕Unit) R) :=
  (zeroExpressions c).map (reindex Sum.inl) ++
    [PolyExpr.sub (.mul (.var (.inr ()))
      (reindex Sum.inl (exprProduct (nonzeroExpressions c)))) (.const 1)]
theorem equationExpressions_correct (f : R→+*K) (x : σ→K) (b : K) (c : Clause σ R) :
    (∀ p∈equationExpressions c, interpret f (Sum.elim x (fun _=>b)) p=0) ↔
      (∀ p∈zeroExpressions c, interpret f x p=0) ∧
      b*interpret f x (exprProduct (nonzeroExpressions c))=1 := by
  simp only [equationExpressions,List.forall_mem_append,List.forall_mem_map,List.forall_mem_singleton]
  simp [interpret_sub,interpret,interpret_reindex,Function.comp_def,sub_eq_zero]
def maxDegree : List (PolyExpr σ R)→Nat
  | [] => 0
  | p::ps => max p.degree (maxDegree ps)
theorem degree_le_maxDegree (ps : List (PolyExpr σ R)) (p : PolyExpr σ R) (hp : p∈ps) :
    p.degree≤ maxDegree ps := by
  induction ps with
  | nil => simp at hp
  | cons q qs ih =>
    rcases List.mem_cons.mp hp with rfl | hp
    · exact Nat.le_max_left _ _
    · exact (ih hp).trans (Nat.le_max_right _ _)
def splitExtended (n : Nat) : (Fin (n+1)⊕Unit)→Fin n⊕Fin 2
  | .inl i => Fin.cases (.inr 0) (fun j=>.inl j) i
  | .inr _ => .inr 1
theorem splitExtended_environment {n : Nat} (x : Fin n→K) (y : Fin 2→K) :
    (fun i => Sum.elim x y (splitExtended n i))=
      Sum.elim (Fin.cons (y 0) x) (fun _ : Unit=>y 1) := by
  funext i
  cases i with
  | inl i => exact Fin.cases rfl (fun _=>rfl) i
  | inr i => rfl
def clauseSystem {n : Nat} (c : Clause (Fin (n+1)) R) : List (Sparse 2 (Fin n) R) :=
  (equationExpressions c).map (expand (splitExtended n))
def clauseDegree {n : Nat} (c : Clause (Fin (n+1)) R) : Nat := maxDegree (equationExpressions c)
theorem clauseSystem_bound {n : Nat} (c : Clause (Fin (n+1)) R) :
    ∀ s∈clauseSystem c, SparseBound s (clauseDegree c) := by
  intro s hs
  obtain ⟨p,hp,rfl⟩:=List.mem_map.mp hs
  intro a ha
  exact (expand_bound (splitExtended n) p a ha).trans (degree_le_maxDegree _ p hp)
def eliminateClause {n : Nat} (c : Clause (Fin (n+1)) R) : TestTree (Fin n) R :=
  parametricFeasible (clauseDegree c) (clauseSystem c)
variable [DecidableEq K] [IsAlgClosed K]
theorem eliminateClause_correct {n : Nat} (f : R→+*K) (x : Fin n→K)
    (c : Clause (Fin (n+1)) R) :
    (eliminateClause c).Holds f x ↔ ∃ a : K, clauseHolds f (Fin.cons a x) c := by
  rw [eliminateClause,parametricFeasible_correct f x _ _ (clauseSystem_bound c)]
  simp only [clauseSystem,List.mem_map,forall_exists_index,and_imp,forall_apply_eq_imp_iff₂]
  simp_rw [expand_eval,splitExtended_environment,equationExpressions_correct]
  constructor
  · rintro ⟨y,hz,hi⟩
    refine ⟨y 0,(clauseHolds_product f _ c).mpr ⟨hz,?_⟩⟩
    intro hg
    rw [hg,mul_zero] at hi
    exact zero_ne_one hi
  · rintro ⟨a,ha⟩
    obtain ⟨hz,hg⟩:=(clauseHolds_product f _ c).mp ha
    let g:=interpret f (Fin.cons a x) (exprProduct (nonzeroExpressions c))
    let y : Fin 2→K:=Fin.cases a (fun _=>g⁻¹)
    refine ⟨y,?_,?_⟩
    · exact hz
    · exact inv_mul_cancel₀ hg
def anyTree : List (TestTree σ R)→TestTree σ R
  | [] => .reject
  | t::ts => disj t (anyTree ts)
theorem anyTree_correct (f : R→+*K) (x : σ→K) (ts : List (TestTree σ R)) :
    (anyTree ts).Holds f x ↔ ∃ t∈ts, t.Holds f x := by
  induction ts with
  | nil => simp [anyTree,TestTree.Holds]
  | cons t ts ih => simp [anyTree,disj_correct,ih]
def eliminateOne {n : Nat} (T : TestTree (Fin (n+1)) R) : TestTree (Fin n) R :=
  anyTree ((clauses T).map eliminateClause)
theorem eliminateOne_correct {n : Nat} (f : R→+*K) (x : Fin n→K)
    (T : TestTree (Fin (n+1)) R) :
    (eliminateOne T).Holds f x ↔ ∃ a : K, T.Holds f (Fin.cons a x) := by
  rw [eliminateOne,anyTree_correct]
  simp only [List.mem_map,exists_exists_and_eq_and]
  simp_rw [eliminateClause_correct]
  constructor
  · rintro ⟨c,hc,a,ha⟩
    exact ⟨a,(clauses_correct f _ T).mp ⟨c,hc,ha⟩⟩
  · rintro ⟨a,ha⟩
    obtain ⟨c,hc,ha⟩:=(clauses_correct f _ T).mpr ha
    exact ⟨c,hc,a,ha⟩
inductive Formula (R : Type*) : Nat→Type _ where
  | zero {n : Nat} (p : PolyExpr (Fin n) R) : Formula R n
  | falsum {n : Nat} : Formula R n
  | neg {n : Nat} (p : Formula R n) : Formula R n
  | disj {n : Nat} (p q : Formula R n) : Formula R n
  | ex {n : Nat} (p : Formula R (n+1)) : Formula R n
def Formula.Holds (f : R→+*K) : {n : Nat}→Formula R n→(Fin n→K)→Prop
  | _,.zero p,x => interpret f x p=0
  | _,.falsum,_ => False
  | _,.neg p,x => ¬p.Holds f x
  | _,.disj p q,x => p.Holds f x ∨ q.Holds f x
  | _,.ex p,x => ∃ a : K, p.Holds f (Fin.cons a x)
def qe : {n : Nat}→Formula R n→TestTree (Fin n) R
  | _,.zero p => .test p .accept .reject
  | _,.falsum => .reject
  | _,.neg p => negate (qe p)
  | _,.disj p q => disj (qe p) (qe q)
  | _,.ex p => eliminateOne (qe p)
theorem qe_correct {n : Nat} (f : R→+*K) (φ : Formula R n) (x : Fin n→K) :
    (qe φ).Holds f x ↔ φ.Holds f x := by
  induction φ with
  | zero p => simp [qe,TestTree.Holds,Formula.Holds]
  | falsum => rfl
  | neg p ih => simp only [qe,negate_correct,Formula.Holds,ih]
  | disj p q ihp ihq => simp only [qe,disj_correct,Formula.Holds,ihp,ihq]
  | ex p ih =>
    rw [qe,eliminateOne_correct]
    exact exists_congr (fun a=>ih (Fin.cons a x))
theorem qe_clauses_correct {n : Nat} (f : R→+*K) (φ : Formula R n) (x : Fin n→K) :
    (∃ c∈clauses (qe φ), clauseHolds f x c) ↔ φ.Holds f x :=
  (clauses_correct f x (qe φ)).trans (qe_correct f φ x)
end Mathproof.Problem18QuantifiedFormulaElimination20261001
end
