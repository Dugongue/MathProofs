def renE (r : String → String) : Expr → Expr
  | .lit n => .lit n
  | .var x => .var (r x)
  | .get a i => .get (r a) (renE r i)
  | .bin op e f => .bin op (renE r e) (renE r f)
def renC (r : String → String) : Cond → Cond
