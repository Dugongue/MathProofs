structure MNames where
  t : String
  R : String
  inB : String
  oB : String
def MNames.list (mn : MNames) : List String := [mn.t, mn.R, mn.inB, mn.oB]
structure MNames.Valid (r : FieldNames) (q : RNames) (mn : MNames) : Prop where
  nodup : (q.list ++ mn.list).Nodup
  avoid : ∀ x ∈ mn.list, x ∉ regNames r
theorem MNames.Valid.ne_of {r : FieldNames} {q : RNames} {mn : MNames} (h : mn.Valid r q)
    {x y : String} (hxy : x = y → ¬ (q.list ++ mn.list).Nodup) : x ≠ y := fun e => hxy e h.1
def lenD (n d : ℕ) : ℕ := (boundedExponents n d).length
def lenL (n d E : ℕ) : ℕ := (boundedExponents n (d + E)).length
def lenM (n E : ℕ) : ℕ := (multiplierExponents n E).length
theorem shiftTbl_length_L (n d E : ℕ) (a : FinExponent n) :
    (shiftTbl n d E a).length = lenL n d E := shiftTbl_length n d E a
def rowAt (ov L u : ℕ) : ℕ := ov + u * L
theorem rowAt_lt {ov L u w : ℕ} (h : u < w) : rowAt ov L u + L ≤ rowAt ov L w := by
  unfold rowAt
  have := Nat.mul_le_mul_right L (Nat.succ_le_of_lt h)
  rw [Nat.succ_mul] at this; omega
theorem rowAt_mono {ov L u w : ℕ} (h : u ≤ w) : rowAt ov L u ≤ rowAt ov L w := by
  unfold rowAt
  have := Nat.mul_le_mul_right L h; omega
theorem rowAt_zero (ov L : ℕ) : rowAt ov L 0 = ov := by simp [rowAt]
def macSrc (mn : MNames) (Ld : ℕ) : Expr := plus (.var mn.inB) (.bin .mul (.var mn.t) (.lit Ld))
def macDst (mn : MNames) (L mc j : ℕ) : Expr :=
  plus (.var mn.oB) (.bin .mul (plus (.bin .mul (.var mn.t) (.lit mc)) (.lit j)) (.lit L))
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] {F : FieldPresentation K} {r : FieldNames}
def macGathers (M : FieldMacros F r) (q : RNames) (mn : MNames) (n d E : ℕ) :
    List (FinExponent n) → ℕ → Com
  | [], _ => .skip
  | a :: as, j => .seq (gatherCom M q (macSrc mn (lenD n d)) (macDst mn (lenL n d E) (lenM n E) j)
      (shiftTbl n d E a) 0) (macGathers M q mn n d E as (j + 1))
def macBody (M : FieldMacros F r) (q : RNames) (mn : MNames) (n d E : ℕ) : Com :=
  .seq (macGathers M q mn n d E (multiplierExponents n E) 0)
    (.assign mn.t (plus (.var mn.t) (.lit 1)))
def macLoop (M : FieldMacros F r) (q : RNames) (mn : MNames) (n d E : ℕ) : Com :=
  .seq (.assign mn.t (.lit 0)) (.while (.lt (.var mn.t) (.var mn.R)) (macBody M q mn n d E))
def macGStep (M : FieldMacros F r) (mn : MNames) (n d E : ℕ) : ℕ :=
  gatherCost M (macSrc mn (lenD n d)) (macDst mn (lenL n d E) (lenM n E) 0) (lenL n d E)
def macStep (M : FieldMacros F r) (mn : MNames) (n d E : ℕ) : ℕ :=
  (lenM n E * macGStep M mn n d E + 1) + 4
def macCost (M : FieldMacros F r) (mn : MNames) (n d E R : ℕ) : ℕ :=
  2 + (4 + macStep M mn n d E) * R + 4
theorem gatherCost_macDst (M : FieldMacros F r) (mn : MNames) (n d E j : ℕ) :
    gatherCost M (macSrc mn (lenD n d)) (macDst mn (lenL n d E) (lenM n E) j) (lenL n d E) =
      macGStep M mn n d E := rfl
theorem evalB_macSrc {B : ℕ} {σ : Env} (mn : MNames) {Ld iv tv : ℕ} (hi : σ.vars mn.inB = iv)
    (ht : σ.vars mn.t = tv) (hlt : iv + tv * Ld < B) (htB : tv < B) (hLB : Ld < B) :
    (macSrc mn Ld).evalB B σ = some (iv + tv * Ld) := by
  unfold macSrc plus
  have h1 : (Expr.var mn.inB).evalB B σ = some iv := by rw [← hi]; exact evalB_var (by omega)
  have h2 : (Expr.var mn.t).evalB B σ = some tv := by rw [← ht]; exact evalB_var (by omega)
  have h3 : (Expr.bin .mul (.var mn.t) (.lit Ld)).evalB B σ = some (tv * Ld) :=
    evalB_bin h2 (evalB_lit hLB) (by change tv * Ld < B; omega)
  exact evalB_bin h1 h3 (by change iv + tv * Ld < B; exact hlt)
theorem evalB_macDst {B : ℕ} {σ : Env} (mn : MNames) {ov L mc j tv : ℕ} (ht : σ.vars mn.t = tv)
    (ho : σ.vars mn.oB = ov)
    (hlt : rowAt ov L (tv * mc + j) < B) (htB : tv < B) (hmB : mc < B) (hjB : j < B)
    (hLB : L < B) (hL1 : 1 ≤ L) :
    (macDst mn L mc j).evalB B σ = some (rowAt ov L (tv * mc + j)) := by
  unfold macDst plus rowAt at *
  have h2 : (Expr.var mn.t).evalB B σ = some tv := by rw [← ht]; exact evalB_var (by omega)
  have h3 : (Expr.bin .mul (.var mn.t) (.lit mc)).evalB B σ = some (tv * mc) :=
    evalB_bin h2 (evalB_lit hmB) (by change tv * mc < B; have := Nat.le_mul_of_pos_right (tv * mc + j) hL1; omega)
  have h4 : (Expr.bin .add (Expr.bin .mul (.var mn.t) (.lit mc)) (.lit j)).evalB B σ =
      some (tv * mc + j) :=
    evalB_bin h3 (evalB_lit hjB) (by change tv * mc + j < B; have := Nat.le_mul_of_pos_right (tv * mc + j) hL1; omega)
  have h5 : (Expr.bin .mul (Expr.bin .add (Expr.bin .mul (.var mn.t) (.lit mc)) (.lit j))
      (.lit L)).evalB B σ = some ((tv * mc + j) * L) :=
    evalB_bin h4 (evalB_lit (by omega)) (by change (tv * mc + j) * L < B; omega)
  have h1 : (Expr.var mn.oB).evalB B σ = some ov := by rw [← ho]; exact evalB_var (by omega)
  exact evalB_bin h1 h5 (by change ov + (tv * mc + j) * L < B; omega)
theorem drop_cons_eq {α : Type*} {l : List α} {j : ℕ} {a : α} {as : List α}
    (h : a :: as = l.drop j) : ∃ hj : j < l.length, a = l[j] ∧ as = l.drop (j + 1) := by
  have hj : j < l.length := by
    by_contra hj
    rw [List.drop_eq_nil_of_le (by omega)] at h
    exact List.cons_ne_nil _ _ h
  rw [List.drop_eq_getElem_cons hj] at h
  obtain ⟨h1, h2⟩ := List.cons.inj h
  exact ⟨hj, h1, h2⟩
theorem macGathers_run (M : FieldMacros F r) (q : RNames) (mn : MNames) (hmn : mn.Valid r q)
    (n d E : ℕ) (v : DenseInput n d K) {B Sn tv iv ov : ℕ} (hov : 1 ≤ ov)
    (hSB' : lenL n d E < B) (hmB : lenM n E < B) (hLdB : lenD n d < B) (htB : tv < B)
    (hsrcB : rowAt ov (lenL n d E) (tv * lenM n E + lenM n E) ≤ iv + tv * lenD n d)
    (hinS : iv + tv * lenD n d + lenD n d ≤ Sn) :
    ∀ (as : List (FinExponent n)) (j : ℕ) (σ : Env), as = (multiplierExponents n E).drop j →
      j ≤ lenM n E → Slots F r q.WS Sn B σ → σ.vars mn.t = tv → σ.vars mn.inB = iv →
      σ.vars mn.oB = ov → val F r q.WS σ 0 = 0 →
      (∀ k (hk : k < lenD n d), val F r q.WS σ (iv + tv * lenD n d + k) = read v ⟨k, hk⟩) →
      ∃ τ, Run B (macGathers M q mn n d E as j) σ τ (as.length * macGStep M mn n d E + 1) ∧
        Slots F r q.WS Sn B τ ∧
        (∀ j' (hj' : j' < lenM n E), j ≤ j' → ∀ i : Fin (lenL n d E),
          val F r q.WS τ (rowAt ov (lenL n d E) (tv * lenM n E + j') + i.val) =
            read (shiftedRow d (d + E) v ((multiplierExponents n E)[j']'hj')) i) ∧
        (∀ s < Sn, (s < rowAt ov (lenL n d E) (tv * lenM n E + j) ∨
          rowAt ov (lenL n d E) (tv * lenM n E + lenM n E) ≤ s) →
            val F r q.WS τ s = val F r q.WS σ s) ∧
        (∀ x, x ∉ regNames r → τ.vars x = σ.vars x) ∧
        (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
        τ.out = σ.out := by
  set L := lenL n d E with hL
  set mc := lenM n E with hmc
  set Ld := lenD n d with hLd
  have hLdef : (boundedExponents n (d + E)).length = L := rfl
  have hmcdef : (multiplierExponents n E).length = mc := rfl
  have hLddef : (boundedExponents n d).length = Ld := rfl
  have hL1 : 1 ≤ L := by rw [← hLdef, boundedExponents_length]; exact Nat.one_le_pow _ _ (by omega)
  have htS : mn.t ∉ regNames r := hmn.avoid _ (by simp [MNames.list])
  have hiS : mn.inB ∉ regNames r := hmn.avoid _ (by simp [MNames.list])
  have hoS : mn.oB ∉ regNames r := hmn.avoid _ (by simp [MNames.list])
  have hl : ∀ x ∈ [mn.t, mn.inB, mn.oB], x ∉ regNames r := by
    intro x hx
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl
    · exact htS
    · exact hiS
    · exact hoS
  have hsp : VarsIn [mn.t, mn.inB, mn.oB] (macSrc mn Ld) := by simp [VarsIn, macSrc, plus]
  intro as
  induction as with
  | nil =>
    intro j σ hdrop hj hS _ _ _ _ _
    have hjm : mc ≤ j := by
      by_contra h
      have hl' : (multiplierExponents n E).length = mc := rfl
      have : (multiplierExponents n E).drop j ≠ [] := by
        rw [Ne, List.drop_eq_nil_iff]; omega
      exact this hdrop.symm
    refine ⟨σ, Run.skip.mono (by simp), hS, fun j' hj' hjj' => by omega,
      fun _ _ _ => rfl, fun _ _ => rfl, fun _ _ _ => rfl, rfl, rfl⟩
  | cons a as ih =>
    intro j σ hdrop hj hS ht hi ho hz hin
    try simp only [← hL, ← hmc, ← hLd]
    obtain ⟨hjl, ha, has⟩ := drop_cons_eq hdrop
    have hjm : j < mc := hjl
    have hSB := hS.slots_word
    have hr1 : rowAt ov L (tv * mc + j) + L ≤ rowAt ov L (tv * mc + mc) := rowAt_lt (by omega)
    have hdp : VarsIn [mn.t, mn.inB, mn.oB] (macDst mn L mc j) := by simp [VarsIn, macDst, plus]
    have hsv := evalB_macSrc (B := B) (Ld := Ld) mn hi ht (by omega) htB hLdB
