theorem gram_eval (F G : Matrix (Fin c) (Fin a × Fin b) K)
    (x : OuterVar a b→K) (ij kl : Fin a × Fin b) :
    interpret (Int.castRingHom K) (Sum.elim (data F G) x) (gram ij kl)=
      (Problem18P34Frontend20261003Gram.gramExpr (F.transpose*F) (G.transpose*G) ij kl).eval x := by
  rw [gram,interpret_reindex,←Problem18P34Frontend20261003Templates.gram_eval]
