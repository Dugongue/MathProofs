def PointExistence (L : Type) [Field L] [Algebra K L] [Algebra.IsAlgebraic K L]
    (n : Nat) (T : Nat → Nat) : Prop :=
  ∀ (d : Nat) (rows : List (DenseInput n d K)) (fs : List (MvPolynomial (Fin n) K)),
    Represents rows fs → T d < Fintype.card K → HasFixedComponent L fs →
      ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0
noncomputable def services (n : Nat) (T : Nat → Nat)
    (hpt : PointExistence (K := K) L n T) : Services (K := K) (L := L) n (profile n T) where
  fixedTest := Problem18FixedComponentTest20261001.fixedTest n
