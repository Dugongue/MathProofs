theorem dispatch_source_words {K : Type} [Field K] [Fintype K]
    (F : FieldPresentation K) (B : Nat) (u : Bool) (q : Nat)
    {a b c : Nat} (ha : 0<a) (hb : 0<b) (hc : 0<c) (A : RectTensor a b c K) :
    dispatchedWords B (sourceBits F u q A)=
      [0,u.toNat,q,F.p,F.e,a,b,c]++routeWords B 0 a b c++
        (List.finRange F.e).map (fun i=>(F.modulus i).val)++tensorCoordinates F A := by
  rw [dispatchedWords,parsed_source F u q ha hb hc A]
