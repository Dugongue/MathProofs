    ∃ τ, Run B (rgLoop M q mn Ls tbl) σ τ (rgCost M mn Ls tbl R) ∧ Slots F r q.WS Sn B τ ∧
      (∀ u < R, ∀ j (hj : j < tbl.length),
        val F r q.WS τ (ov + u * tbl.length + j) = gval (val F r q.WS σ) (iv + u * Ls) tbl[j]) ∧
      (∀ s < Sn, (s < ov ∨ ov + R * tbl.length ≤ s) → val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ≠ mn.t → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hSB := hS.slots_word
  have htS : mn.t ∉ regNames r := hmn.avoid _ (by simp [MNames.list])
  have htW : mn.t ≠ q.WS := hmn.ne_of (by intro h; simp [RNames.list, MNames.list, h])
  have hRt : mn.R ≠ mn.t := hmn.ne_of (by intro h; simp [RNames.list, MNames.list, h])
  have hRS : mn.R ∉ regNames r := hmn.avoid _ (by simp [MNames.list])
  have hit : mn.inB ≠ mn.t := hmn.ne_of (by intro h; simp [RNames.list, MNames.list, h])
  have hiS : mn.inB ∉ regNames r := hmn.avoid _ (by simp [MNames.list])
  have hoS : mn.oB ∉ regNames r := hmn.avoid _ (by simp [MNames.list])
