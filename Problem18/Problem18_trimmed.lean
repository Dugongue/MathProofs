theorem transcendental_of_mem_prime {B : Type*} [CommRing B] [IsDomain B] [Algebra k B]
    {ι : Type*} (t : ι → B) (Q : Ideal B) [Q.IsPrime]
    (hind : AlgebraicIndependent k ((Ideal.Quotient.mkₐ k Q) ∘ t))
    (f : B) (hf : f ∈ Q) (hf0 : f ≠ 0) :
    Transcendental (Algebra.adjoin k (Set.range t)) f := by
  intro halg
  obtain ⟨p, hp0, hpf⟩ := halg
  obtain ⟨q, hpq, hndvd⟩ := p.exists_eq_pow_rootMultiplicity_mul_and_not_dvd hp0 0
  have hq : aeval f q = 0 := by
    rw [hpq, map_mul, map_pow, map_sub, aeval_X, aeval_C, map_zero, sub_zero] at hpf
    exact (mul_eq_zero.mp hpf).resolve_left (pow_ne_zero _ hf0)
  have hq0 : q.coeff 0 ≠ 0 := by
    intro h
    apply hndvd
    rw [map_zero, sub_zero]
    exact X_dvd_iff.mpr h
  have hconst : algebraMap (Algebra.adjoin k (Set.range t)) B (q.coeff 0) ∈ Q := by
    have h := divX_mul_X_add q
    have h2 : aeval f (divX q * X + C (q.coeff 0)) = 0 := by rw [h]; exact hq
    rw [map_add, map_mul, aeval_X, aeval_C] at h2
    have h3 : algebraMap (Algebra.adjoin k (Set.range t)) B (q.coeff 0) =
        -(aeval f (divX q) * f) := eq_neg_of_add_eq_zero_right h2
    rw [h3]
    exact Q.neg_mem (Q.mul_mem_left _ hf)
  have hmem : ((q.coeff 0 : Algebra.adjoin k (Set.range t)) : B) ∈ Q := hconst
  obtain ⟨P, hP⟩ : ∃ P : MvPolynomial ι k,
      MvPolynomial.aeval t P = ((q.coeff 0 : Algebra.adjoin k (Set.range t)) : B) := by
    have hc : ((q.coeff 0 : Algebra.adjoin k (Set.range t)) : B) ∈
        (MvPolynomial.aeval t : MvPolynomial ι k →ₐ[k] B).range := by
      rw [← Algebra.adjoin_range_eq_range_aeval]
      exact (q.coeff 0).2
    obtain ⟨P, hP⟩ := hc
    exact ⟨P, hP⟩
  have h0 : (MvPolynomial.aeval ((Ideal.Quotient.mkₐ k Q) ∘ t)) P = 0 := by
    have hcomp := AlgHom.congr_fun
      (MvPolynomial.comp_aeval (R := k) (f := t) (Ideal.Quotient.mkₐ k Q)) P
    rw [AlgHom.comp_apply, hP] at hcomp
    change (MvPolynomial.aeval fun i => (Ideal.Quotient.mkₐ k Q) (t i)) P = 0
    rw [← hcomp]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hmem
  have hP0 : P = 0 := hind (by rw [h0, map_zero])
  apply hq0
  apply Subtype.ext
  change ((q.coeff 0 : Algebra.adjoin k (Set.range t)) : B) = 0
  rw [← hP, hP0, map_zero]
theorem trdeg_quotient_lt {B : Type*} [CommRing B] [IsDomain B] [Algebra k B]
    [Algebra.FiniteType k B] (Q : Ideal B) [Q.IsPrime] (hQ : Q ≠ ⊥) :
    Algebra.trdeg k (B ⧸ Q) < Algebra.trdeg k B := by
  classical
  haveI : IsDomain (B ⧸ Q) := Ideal.Quotient.isDomain Q
  haveI : Algebra.FiniteType k (B ⧸ Q) :=
    Algebra.FiniteType.of_surjective (Ideal.Quotient.mkₐ k Q) (Ideal.Quotient.mkₐ_surjective k Q)
  obtain ⟨ι, t, ht⟩ := exists_isTranscendenceBasis' k (B ⧸ Q)
  have hsurj := Ideal.Quotient.mkₐ_surjective k Q
  let t' : ι → B := fun i => Function.surjInv hsurj (t i)
  have ht' : (Ideal.Quotient.mkₐ k Q) ∘ t' = t := by
    funext i
    exact Function.surjInv_eq hsurj (t i)
  have hind : AlgebraicIndependent k ((Ideal.Quotient.mkₐ k Q) ∘ t') := by
    rw [ht']; exact ht.1
  have hind' : AlgebraicIndependent k t' := hind.of_comp _
  obtain ⟨f, hf, hf0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hQ
  have htrans := transcendental_of_mem_prime t' Q hind f hf hf0
  have hopt : AlgebraicIndependent k (fun o : Option ι => o.elim f t') :=
    AlgebraicIndependent.option_iff.mpr ⟨hind', htrans⟩
  have h1 : Cardinal.mk (Option ι) ≤ Algebra.trdeg k B := hopt.cardinalMk_le_trdeg
  have h2 : Algebra.trdeg k (B ⧸ Q) = Cardinal.mk ι := ht.cardinalMk_eq_trdeg.symm
  have hfin : Algebra.trdeg k B < ℵ₀ := trdeg_lt_aleph0_of_finiteType
  rw [Cardinal.mk_option] at h1
  have hι : Cardinal.mk ι < ℵ₀ := lt_of_le_of_lt (le_trans (le_add_right le_rfl) h1) hfin
  obtain ⟨m, hm⟩ := Cardinal.lt_aleph0.mp hι
  rw [h2, hm]
  rw [hm] at h1
  calc (m : Cardinal) < (m : Cardinal) + 1 := by
        rw [← Nat.cast_succ]; exact_mod_cast Nat.lt_succ_self m
    _ ≤ Algebra.trdeg k B := h1
theorem exists_independent_pair {A : Type*} [CommRing A] [IsDomain A] [Algebra k A]
    {n : Nat} (x : Fin n → A) (hgen : Algebra.adjoin k (Set.range x) = ⊤)
    (h2 : 2 ≤ Algebra.trdeg k A) :
    ∃ i j : Fin n, i ≠ j ∧ AlgebraicIndependent k ![x i, x j] := by
  classical
  haveI : Algebra.IsAlgebraic (Algebra.adjoin k (Set.range x)) A := by
    rw [hgen]
    refine ⟨fun a => ?_⟩
    exact isAlgebraic_algebraMap (⟨a, Algebra.mem_top⟩ : (⊤ : Subalgebra k A))
  obtain ⟨t, hts, ht⟩ := exists_isTranscendenceBasis_subset (R := k) (Set.range x)
  have hcard : 2 ≤ Cardinal.mk t := by
    rw [ht.cardinalMk_eq_trdeg]; exact h2
  obtain ⟨⟨a, ha⟩, ⟨b, hb⟩, hab⟩ := Cardinal.two_le_iff.mp hcard
  obtain ⟨i, rfl⟩ := hts ha
  obtain ⟨j, rfl⟩ := hts hb
  have hij : i ≠ j := by
    intro h; apply hab; subst h; rfl
  refine ⟨i, j, hij, ?_⟩
  have hinj : Function.Injective (fun m : Fin 2 => (![(⟨x i, ha⟩ : t), ⟨x j, hb⟩] m)) := by
    intro m m' hmm
    fin_cases m <;> fin_cases m' <;> simp_all
  have := ht.1.comp _ hinj
  convert this using 1
  funext m
  fin_cases m <;> rfl
theorem isAlgebraic_of_trdeg_eq_zero {A : Type*} [CommRing A] [IsDomain A] [Algebra k A]
    (h : Algebra.trdeg k A = 0) : Algebra.IsAlgebraic k A := by
  classical
  obtain ⟨ι, t, ht⟩ := exists_isTranscendenceBasis' k A
  have hι : Cardinal.mk ι = 0 := by rw [ht.cardinalMk_eq_trdeg, h]
  haveI : IsEmpty ι := Cardinal.mk_eq_zero_iff.mp hι
  have halg := ht.isAlgebraic
  have hrange : Set.range t = ∅ := Set.range_eq_empty t
  rw [hrange, Algebra.adjoin_empty] at halg
  haveI := halg
  exact Algebra.IsAlgebraic.of_ringHom_of_comp_eq (algebraMap k (⊥ : Subalgebra k A))
    (RingHom.id A) (by rintro ⟨_, r, rfl⟩; exact ⟨r, rfl⟩) Function.injective_id (by ext; rfl)
theorem algebraMap_surjective_of_isAlgebraic {A : Type*} [CommRing A] [IsDomain A] [Algebra k A]
    [IsAlgClosed k] [Algebra.IsAlgebraic k A] : Function.Surjective (algebraMap k A) := by
  intro a
  have hint : IsIntegral k a := (Algebra.IsAlgebraic.isAlgebraic (R := k) a).isIntegral
  have hirr : Irreducible (minpoly k a) := minpoly.irreducible hint
  have hdeg : (minpoly k a).degree = 1 := IsAlgClosed.degree_eq_one_of_irreducible k hirr
  have hmonic : (minpoly k a).leadingCoeff = 1 := (minpoly.monic hint).leadingCoeff
  have heq := Polynomial.eq_X_add_C_of_degree_eq_one hdeg
  rw [hmonic, map_one, one_mul] at heq
  have h0 := minpoly.aeval k a
  rw [heq, map_add, aeval_X, aeval_C] at h0
  exact ⟨-(minpoly k a).coeff 0, by rw [map_neg]; exact neg_eq_of_add_eq_zero_left h0⟩
theorem isMaximal_of_trdeg_eq_zero {R : Type*} [CommRing R] [Algebra k R] [IsAlgClosed k]
    (P : Ideal R) [P.IsPrime] (h : Algebra.trdeg k (R ⧸ P) = 0) : P.IsMaximal := by
  haveI : IsDomain (R ⧸ P) := Ideal.Quotient.isDomain P
  haveI : Algebra.IsAlgebraic k (R ⧸ P) := isAlgebraic_of_trdeg_eq_zero h
  have hsurj : Function.Surjective (algebraMap k (R ⧸ P)) := algebraMap_surjective_of_isAlgebraic
  apply Ideal.Quotient.maximal_of_isField
  refine ⟨?_, mul_comm, ?_⟩
  · exact ⟨0, 1, zero_ne_one⟩
  · intro a ha
    obtain ⟨c, rfl⟩ := hsurj a
    have hc : c ≠ 0 := by rintro rfl; simp at ha
    exact ⟨algebraMap k (R ⧸ P) c⁻¹, by rw [← map_mul, mul_inv_cancel₀ hc, map_one]⟩
