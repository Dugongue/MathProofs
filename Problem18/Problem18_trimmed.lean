        (a - 2) * r * ((a + 2) * (2 * b - r) - 2 * d) := by
      have h2br : 0 ≤ 2 * b - r := by linarith
      have hpositive : 0 ≤ (a + 2) * (2 * b - r) - 2 * d := by
        have h3 : 0 ≤ (a - 2) * (2 * b - r) := mul_nonneg ha0 h2br
        nlinarith
      exact mul_nonneg (mul_nonneg ha0 hr0) hpositive
    have hrr : r * r ≤ b * r := mul_le_mul_of_nonneg_right hrb hr0
    have hdr : 64 * (d * r) ≤ b * r := by nlinarith [mul_nonneg (by linarith : 0 ≤ b - 64 * d) hr0]
    have hbrr : 8 * r ≤ b * r := by nlinarith [mul_nonneg (by linarith : 0 ≤ b - 8) hr0]
    unfold restrictionExponent
    rw [hmax]
