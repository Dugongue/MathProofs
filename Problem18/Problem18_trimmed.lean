variable {K ι : Type*} [Field K] [Fintype ι]
theorem simple_product_iff (g : ι → K[X]) (hg : ∀ i,g i≠0)
    (hcop : Pairwise (fun i j => IsCoprime (g i) (g j))) (p : K[X]) :
    ((∏ i,g i) ∣ p ∧ IsCoprime (∏ i,g i) (p/(∏ i,g i))) ↔
      ∀ i,g i ∣ p ∧ IsCoprime (g i) (p/g i) := by
  classical
  let P := ∏ i,g i
  let r (i : ι) := ∏ j ∈ Finset.univ.erase i,g j
  have hP : P≠0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hg i)
  have hsplit (i : ι) : P=g i*r i := (Finset.mul_prod_erase Finset.univ g (Finset.mem_univ i)).symm
  have hdP (i : ι) : g i ∣ P := ⟨r i,hsplit i⟩
  have hquot (hp : P ∣ p) (i : ι) : p/g i=r i*(p/P) := by
    have hfactor : p=P*(p/P) := (EuclideanDomain.mul_div_cancel' hP hp).symm
    calc
      p/g i=(P*(p/P))/g i := congrArg (fun v => v/g i) hfactor
      _=(g i*r i*(p/P))/g i := congrArg (fun v => (v*(p/P))/g i) (hsplit i)
      _=r i*(p/P) := by rw [mul_assoc,mul_div_cancel_left₀ _ (hg i)]
  have hcr (i : ι) : IsCoprime (g i) (r i) := by
    apply IsCoprime.prod_right
    intro j hj
    exact hcop (Finset.ne_of_mem_erase hj).symm
  constructor
  · rintro ⟨hp,hc⟩ i
    change P ∣ p at hp
    change IsCoprime P (p/P) at hc
    refine ⟨(hdP i).trans hp,?_⟩
    rw [hquot hp i]
    exact (hcr i).mul_right (hc.of_isCoprime_of_dvd_left (hdP i))
  · intro h
    have hp : P ∣ p := Fintype.prod_dvd_of_coprime hcop (fun i => (h i).1)
    refine ⟨hp,?_⟩
    apply IsCoprime.prod_left
    intro i _
    have hc := (h i).2
    rw [hquot hp i] at hc
    exact IsCoprime.mul_right_iff.mp hc |>.2
end
end Mathproof.Problem18SimpleProductEvent20261001
end
