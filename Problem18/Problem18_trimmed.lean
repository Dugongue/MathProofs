namespace Mathproof.Problem18DivisorZetaRationality20260930
open FunctionField FunctionField.Chart Module Problem18DivisorClassFiniteness20260930
  Problem18EffectiveDivisorDegreeCount20260930
open scoped Polynomial RatFunc WithZero PowerSeries
variable (k K : Type*) [Field k] [Field K] [Finite k]
  [Algebra k K] [Algebra k[X] K] [Algebra k⟮X⟯ K] [IsScalarTower k k[X] K]
  [IsScalarTower k[X] k⟮X⟯ K] [_root_.FunctionField k K]
  [Algebra.IsSeparable k⟮X⟯ K] [FunctionField.IsFullConstantField k K]
def effectiveCount (n : Nat) : Nat :=
  Nat.card {D : DivisorA k K // IsEffective k K D ∧ deg k K D=(n:ℤ)}
theorem effective_count_formula (B : DivisorA k K) (hB : deg k K B=1)
    (n : Nat) (hn : 2*(genus k K:ℤ)-2<(n:ℤ)) :
    (effectiveCount k K n:ℤ)*((Nat.card k:ℤ)-1)+(Nat.card (classDegree k K).ker:ℤ)=
      (Nat.card (classDegree k K).ker:ℤ)*(Nat.card k:ℤ)^(((n:ℤ)+1-genus k K).toNat) := by
  have hd : deg k K (n • B)=(n:ℤ) := by rw [deg_nsmul,hB,mul_one]
  have h := effective_degree_card k K (n • B) (by rw [hd]; exact hn)
  have hc : Nat.card (EffectiveDegree k K (n • B))=effectiveCount k K n := by
    unfold EffectiveDegree effectiveCount
    rw [hd]
  rw [hc,hd] at h
  have hq : 1≤Nat.card k := (Finite.one_lt_card (α:=k)).le
  exact_mod_cast h
theorem effective_count_recurrence (B : DivisorA k K) (hB : deg k K B=1)
    (n : Nat) (hn : 2*genus k K<n+2) :
    (effectiveCount k K (n+2):ℤ)-((Nat.card k:ℤ)+1)*(effectiveCount k K (n+1):ℤ)+
      (Nat.card k:ℤ)*(effectiveCount k K n:ℤ)=0 := by
  have h0 := effective_count_formula k K B hB n (by omega)
  have h1 := effective_count_formula k K B hB (n+1) (by push_cast; omega)
  have h2 := effective_count_formula k K B hB (n+2) (by push_cast; omega)
  have he1 : (((n+1:Nat):ℤ)+1-genus k K).toNat = ((n:ℤ)+1-genus k K).toNat+1 := by omega
  have he2 : (((n+2:Nat):ℤ)+1-genus k K).toNat = ((n:ℤ)+1-genus k K).toNat+2 := by omega
  rw [he1,pow_succ] at h1
  rw [he2,pow_add,pow_two] at h2
  have he : ((Nat.card k:ℤ)-1)*
      ((effectiveCount k K (n+2):ℤ)-((Nat.card k:ℤ)+1)*(effectiveCount k K (n+1):ℤ)+
        (Nat.card k:ℤ)*(effectiveCount k K n:ℤ))=0 := by
    linear_combination h2-((Nat.card k:ℤ)+1)*h1+(Nat.card k:ℤ)*h0
  have hq : (Nat.card k:ℤ)-1≠0 := by
    have h := Finite.one_lt_card (α:=k)
    omega
  exact (mul_eq_zero.mp he).resolve_left hq
def divisorZeta : PowerSeries ℤ := PowerSeries.mk fun n => (effectiveCount k K n:ℤ)
def zetaNumeratorSeries : PowerSeries ℤ :=
  (1-PowerSeries.X)*(1-PowerSeries.C (Nat.card k:ℤ)*PowerSeries.X)*divisorZeta k K
theorem zeta_numerator_coeff_zero (B : DivisorA k K) (hB : deg k K B=1)
    (n : Nat) (hn : 2*genus k K<n) :
    PowerSeries.coeff n (zetaNumeratorSeries k K)=0 := by
  have he : zetaNumeratorSeries k K = divisorZeta k K-
      PowerSeries.C ((Nat.card k:ℤ)+1)*(PowerSeries.X*divisorZeta k K)+
      PowerSeries.C (Nat.card k:ℤ)*(PowerSeries.X*(PowerSeries.X*divisorZeta k K)) := by
    unfold zetaNumeratorSeries
    rw [map_add,map_one]
    ring
  by_cases hn2 : 2≤n
  · obtain ⟨m,rfl⟩ : ∃ m, n=m+2 := ⟨n-2,by omega⟩
    rw [he]
    simpa only [map_add,map_sub,add_mul,one_mul,PowerSeries.coeff_C_mul,PowerSeries.coeff_succ_X_mul,
      divisorZeta,PowerSeries.coeff_mk] using effective_count_recurrence k K B hB m hn
  · have hn1 : n=1 := by omega
    have hg : genus k K=0 := by omega
    subst n
    have h0 := effective_count_formula k K B hB 0 (by rw [hg]; norm_num)
    have h1 := effective_count_formula k K B hB 1 (by rw [hg]; norm_num)
    norm_num only [hg] at h0 h1
    rw [show (1:ℤ).toNat=1 from rfl,pow_one] at h0
    change (effectiveCount k K 0:ℤ)*((Nat.card k:ℤ)-1)+(Nat.card (classDegree k K).ker:ℤ)=
      (Nat.card (classDegree k K).ker:ℤ)*(Nat.card k:ℤ) at h0
    change (effectiveCount k K 1:ℤ)*((Nat.card k:ℤ)-1)+(Nat.card (classDegree k K).ker:ℤ)=
      (Nat.card (classDegree k K).ker:ℤ)*(Nat.card k:ℤ)^2 at h1
    have hq : (Nat.card k:ℤ)-1≠0 := by have h := Finite.one_lt_card (α:=k); omega
    have hh : (Nat.card (classDegree k K).ker:ℤ)=(effectiveCount k K 0:ℤ) := by
      apply sub_eq_zero.mp
      apply (mul_eq_zero.mp (show ((Nat.card k:ℤ)-1)*
        ((Nat.card (classDegree k K).ker:ℤ)-(effectiveCount k K 0:ℤ))=0 by
          linear_combination -h0)).resolve_left hq
    rw [hh] at h1
    have hz : (effectiveCount k K 1:ℤ)-((Nat.card k:ℤ)+1)*(effectiveCount k K 0:ℤ)=0 := by
      apply (mul_eq_zero.mp (show ((Nat.card k:ℤ)-1)*
        ((effectiveCount k K 1:ℤ)-((Nat.card k:ℤ)+1)*(effectiveCount k K 0:ℤ))=0 by
          linear_combination h1)).resolve_left hq
    rw [he]
    simpa only [map_add,map_sub,add_mul,one_mul,PowerSeries.coeff_C_mul,
      PowerSeries.coeff_succ_X_mul,PowerSeries.coeff_zero_X_mul,divisorZeta,
      PowerSeries.coeff_mk,mul_zero,add_zero] using hz
theorem divisor_zeta_rational (B : DivisorA k K) (hB : deg k K B=1) :
    ∃ P : ℤ[X], P.natDegree≤2*genus k K ∧
      (P : PowerSeries ℤ)=(1-PowerSeries.X)*
        (1-PowerSeries.C (Nat.card k:ℤ)*PowerSeries.X)*divisorZeta k K := by
  refine ⟨PowerSeries.trunc (2*genus k K+1) (zetaNumeratorSeries k K),?_,?_⟩
  · exact Nat.le_of_lt_succ (PowerSeries.natDegree_trunc_lt _ _)
  · change (_ : PowerSeries ℤ)=zetaNumeratorSeries k K
    ext n
    rw [Polynomial.coeff_coe,PowerSeries.coeff_trunc]
    split_ifs with hn
    · rfl
    · exact (zeta_numerator_coeff_zero k K B hB n (by omega)).symm
end Mathproof.Problem18DivisorZetaRationality20260930
