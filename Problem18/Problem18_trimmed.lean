theorem write_bit {W : Nat} {x : String} {σ : Env} {b : Bool} (hW : 1 < W)
    (h01 : σ.vars x = 0 ∨ σ.vars x = 1) (hiff : σ.vars x = 1 ↔ b = true) :
    Run W (.write (.var x)) σ { σ with out := σ.out ++ [if b then 1 else 0] } 2 := by
  have hv : σ.vars x = (if b then 1 else 0) := by
    cases b with
    | true => simp only [if_true]; exact hiff.mpr rfl
    | false =>
      simp only [Bool.false_eq_true, if_false]
      rcases h01 with h | h
      · exact h
      · exact absurd (hiff.mp h) (by simp)
  have hr := Run.write (B:=W) (σ:=σ) (evalB_var (x:=x) (by rcases h01 with h | h <;> omega))
  rw [hv] at hr
