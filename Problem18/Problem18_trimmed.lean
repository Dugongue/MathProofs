theorem exists_range_equiv_of_ker_eq
    (C D : M →ₗ[K] V) (hker : LinearMap.ker C = LinearMap.ker D) :
    ∃ e : LinearMap.range C ≃ₗ[K] LinearMap.range D,
      ∀ x : M, e ⟨C x, LinearMap.mem_range_self C x⟩ =
        ⟨D x, LinearMap.mem_range_self D x⟩ := by
