section Compositum
variable (F E L : Type*) [Field F] [Field E] [Field L] [Algebra F L] [Algebra E L]
def compositumConstants : E →+* constantCompositum F E L :=
  (algebraMap E L).codRestrict (constantCompositum F E L).toSubring
    (algebraMap_mem_constantCompositum F E L)
instance compositumAlgebra : Algebra E (constantCompositum F E L) :=
  (compositumConstants F E L).toAlgebra
instance compositumTower : IsScalarTower E (constantCompositum F E L) L :=
  IsScalarTower.of_algebraMap_eq fun _ => rfl
theorem compositum_generated :
    constantCompositum F E (constantCompositum F E L) = ⊤ := by
  let C := constantCompositum F E L
  have htop : (⊤ : IntermediateField F C).map C.val = C := by
    ext x
    constructor
    · rintro ⟨y,hy,rfl⟩; exact y.property
    · intro hx; exact ⟨⟨x,hx⟩,trivial,rfl⟩
  apply IntermediateField.map_injective C.val
  rw [htop,constantCompositum_def,IntermediateField.adjoin_map]
  have hrange : C.val '' Set.range (algebraMap E C) = Set.range (algebraMap E L) := by
    ext x
    constructor
    · rintro ⟨y,⟨c,rfl⟩,rfl⟩; exact ⟨c,rfl⟩
    · rintro ⟨c,rfl⟩; exact ⟨algebraMap E C c,⟨c,rfl⟩,rfl⟩
  rw [hrange]
  exact (constantCompositum_def F E L).symm
end Compositum
