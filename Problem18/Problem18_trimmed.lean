    (EuclideanDomain.mul_div_cancel' hm.ne_zero hdvd').symm
  have hqfix : (S.charpoly/p).map (starRingAut : K ≃+* K).toRingHom=S.charpoly/p := by
    rw [Polynomial.map_div,hfix]
    congr 1
    simpa only [S,Matrix.charpoly_toLin'] using hχfix
