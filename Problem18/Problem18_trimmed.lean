variable {K F ι : Type*} [Field K] [Field F] [Algebra K F]
theorem finrank_adjoin_singleton_le (x : F) (p : Polynomial K) (hp : p ≠ 0)
    (hx : Polynomial.aeval x p = 0) :
    finrank K (Algebra.adjoin K {x}) ≤ p.natDegree := by
  have hi : IsIntegral K x := (show IsAlgebraic K x from ⟨p, hp, hx⟩).isIntegral
  rw [(Algebra.adjoin.powerBasis hi).finrank]
  exact Polynomial.natDegree_le_of_dvd (minpoly.dvd K x hx) hp
theorem finrank_adjoin_image_le (y : ι → F) (s : Finset ι) (B : Nat)
    (hb : ∀ i ∈ s, finrank K (Algebra.adjoin K {y i}) ≤ B) :
    finrank K (Algebra.adjoin K (y '' (s : Set ι))) ≤ B ^ s.card := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    rw [Finset.coe_empty, Set.image_empty, Algebra.adjoin_empty, Subalgebra.finrank_bot]
    simp
  | @insert a s ha ih =>
    rw [Finset.coe_insert, Set.image_insert_eq, Set.insert_eq, Algebra.adjoin_union]
    apply (Subalgebra.finrank_sup_le_of_free _ _).trans
    calc
      _ ≤ B * B ^ s.card := Nat.mul_le_mul (hb a (by simp))
        (ih fun i hi => hb i (by simp [hi]))
      _ = _ := by rw [Finset.card_insert_of_notMem ha, pow_succ, Nat.mul_comm]
theorem field_degree_le [Fintype ι] (y : ι → F) (B : Nat)
    (hgen : IntermediateField.adjoin K (Set.range y) = ⊤)
    (hrel : ∀ i, ∃ p : Polynomial K, p ≠ 0 ∧
      Polynomial.aeval (y i) p = 0 ∧ p.natDegree ≤ B) :
    finrank K F ≤ B ^ Fintype.card ι := by
  classical
  have halg : ∀ x ∈ Set.range y, IsAlgebraic K x := by
    rintro x ⟨i, rfl⟩
    obtain ⟨p, hp, he, -⟩ := hrel i
    exact ⟨p, hp, he⟩
  have htop : Algebra.adjoin K (Set.range y) = ⊤ := by
    rw [← IntermediateField.adjoin_toSubalgebra_of_isAlgebraic halg, hgen]
    rfl
  have hb : ∀ i ∈ (Finset.univ : Finset ι),
      finrank K (Algebra.adjoin K {y i}) ≤ B := by
    intro i _
    obtain ⟨p, hp, he, hd⟩ := hrel i
    exact (finrank_adjoin_singleton_le (y i) p hp he).trans hd
  have h := finrank_adjoin_image_le y Finset.univ B hb
  rw [Finset.coe_univ, Set.image_univ, htop] at h
  rw [(Subalgebra.topEquiv : (⊤ : Subalgebra K F) ≃ₐ[K] F).toLinearEquiv.finrank_eq] at h
  simpa using h
