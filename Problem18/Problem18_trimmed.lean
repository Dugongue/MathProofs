attribute [-instance] FunLike.toDecidableEq CommSemiRingCat.FilteredColimits.colimitCommSemiring AddMonoidAlgebra.instHopfAlgebraStruct AddMonoidAlgebra.instBialgebra Bialgebra.toAlgebra
namespace Mathproof.Problem18CharTwoScaledRecovery20260930
open Matrix Problem18OrthogonalAssembly Problem18MarkedRecovery20260929
open Mathproof.Problem18FinalFactor20260930
open Mathproof.Problem18ScaledFinalFactor20260930
variable {K : Type*} [Field K] [Fintype K] [CharP K 2]
def squareRoot (s : K) : K := s ^ (Fintype.card K / 2)
theorem squareRoot_sq (s : K) : squareRoot s * squareRoot s = s := by
  have he : Fintype.card K % 2 = 0 :=
    FiniteField.even_card_of_char_two (ringChar.eq K 2)
  have hc : Fintype.card K / 2 * 2 = Fintype.card K := Nat.div_mul_cancel (Nat.dvd_of_mod_eq_zero he)
  rw [squareRoot, ← pow_two, ← pow_mul, hc, FiniteField.pow_card]
theorem squareRoot_unique (s u : K) (hu : u * u = s) : u = squareRoot s := by
  apply CharTwo.sq_injective
  simpa only [pow_two, hu] using (squareRoot_sq s).symm
theorem explicit_scaled_factor_iff {n : ℕ} {ι : Type*} [Fintype ι] [DecidableEq ι]
    (H D : Matrix (Fin n) ι K) (s : K) :
    (∃ u : K, u * u = s ∧ ∃ R : Matrix (Fin n) (Fin n) K,
      IsOrthogonal R ∧ R * (u • H) = D) ↔
      LinearMap.ker (augment (squareRoot s • H).toLin' (standardMarker n)) =
        LinearMap.ker (augment D.toLin' (standardMarker n)) ∧
      s • (H.transpose * H) = D.transpose * D := by
  constructor
  · rintro ⟨u, hu, hR⟩
    have he := squareRoot_unique s u hu
