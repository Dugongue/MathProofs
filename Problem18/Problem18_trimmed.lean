        rcases hp with rfl|rfl|rfl <;> (dsimp only; decide))
    (by simp only [cArgs, List.map_cons, List.map_nil]; decide)
    (by intro x hx; simp only [cArgs, List.mem_cons, List.not_mem_nil, or_false] at hx
        rcases hx with rfl|rfl|rfl; exact hW.data; exact hW.one; exact hW.dst)
  have hcc : ν3.vars cpCnt = F.e*(d+n*d) := vals3 (cpCnt, dataSz) (by simp [cArgs])
  have hcs : ν3.vars cpSb = sb + F.e*0 := vals3 (cpSb, atW oOne) (by simp [cArgs])
  have hcd : ν3.vars cpDb = F.e+1+F.e*5 := vals3 (cpDb, dstSz) (by simp [cArgs])
