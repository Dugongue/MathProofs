    { toFun := fun U => ⟨U.val,Matrix.mem_unitaryGroup_iff'.mpr U.property⟩
      invFun := fun U => ⟨U.val,Matrix.mem_unitaryGroup_iff'.mp U.property⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
