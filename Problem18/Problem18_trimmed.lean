variable {K : Type} [Field K] [Fintype K] [BEq K] [LawfulBEq K] [DecidableEq K]
noncomputable def stageGram (u : Bool) (q : Nat) {a b c : Nat} (A : RectTensor a b c K)
    (h : (shape (sortOrder a b c) a b c).1=1) :
    Matrix (Fin (boundaryWidth a b c)) (Fin (boundaryWidth a b c)) K :=
  Problem18IMPBoundaryDispatchAdapter20261002.boundaryGram u q
    (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
      (sortOrder a b c) A h)
theorem sweepTail_run (F : FieldPresentation K) {B n sourceBase : Nat}
    {S : Matrix (Fin n) (Fin n) K} (sigma : Env)
    (hS : Slots F canonical Problem18IMPBoundaryPhaseState20261002.workspaceName
      (Problem18IMPBoundaryCyclicLayout20261002.slots n) B sigma)
    (hv : ValidMemory F B sigma)
    (hn : n<B)
    (hcountB : n*n*F.e<B)
    (hworkspace : sigma.vars Problem18IMPBoundaryPhaseState20261002.workspaceName=F.e+1)
    (hcols : sigma.vars Problem18IMPTensorGather20261002.cols=n)
    (hcount : sigma.vars copyCount=n*n*F.e)
    (hsource : sigma.vars externalBase=sourceBase)
    (htarget : sigma.vars nativeBase=F.e+1+Problem18IMPBoundaryCyclicLayout20261002.matrix n*F.e)
    (hsourceB : sourceBase+n*n*F.e<B)
    (htargetB : F.e+1+Problem18IMPBoundaryCyclicLayout20261002.matrix n*F.e+n*n*F.e<B)
    (hfitSource : sourceBase+n*n*F.e≤(sigma.arrs workBank).length)
    (hmod : sigma.vars canonical.modBase=0)
    (hlen : (sigma.arrs canonical.mem).length=F.e+1+Problem18IMPBoundaryCyclicLayout20261002.slots n*F.e)
    (hword : ∀k<n*n*F.e,(sigma.arrs workBank).getD (sourceBase+k) 0<B)
    (hprime : ∀k<n*n*F.e,(sigma.arrs workBank).getD (sourceBase+k) 0<F.p)
    (hmat : Problem18IMPMatrixMemory20261001.matrix F (externalState sigma)
      sourceBase n n=S)
    (hb : Problem18IMPBoundarySweepStep20261002.WordBounds B n F.e) :
    ∃tau,Run B sweepTail sigma tau
        (20*(n*n*F.e)+12+Problem18P36BoundarySweep20261002.cost F n) ∧
      Problem18IMPBoundarySweepState20261002.State F B S n tau ∧
      tau.inp=sigma.inp ∧ tau.out=sigma.out := by
  obtain ⟨rho,hr,hcore,hi,ho⟩:=copyGram_to_core F sigma hS hv hn hcountB hworkspace hcols
    hcount hsource htarget hsourceB htargetB hfitSource hmod hlen hword hprime hmat
  obtain ⟨tau,ht,hstate,hti,hto⟩:=
    Problem18P36BoundarySweep20261002.program_run F hcore hb
  exact ⟨tau,by simpa [sweepTail] using hr.seq ht,hstate,hti.trans hi,hto.trans ho⟩
theorem stage_reassociate {B k l : Nat} {sigma theta tau : Env}
    (h : Run B
      (.seq (.seq modulusCopy (.seq boundaryGather gramLayoutSetup)) gramProgram)
      sigma theta k)
    (h' : Run B (.seq nativeCopySetup sweepTail) theta tau l) :
    Run B stageController sigma tau (k+l) := by
  obtain ⟨kh,hkh,hbig⟩:=h
  obtain ⟨kl,hkl,hbig'⟩:=h'
  cases hbig with
  | seq hleft hgram =>
    cases hleft with
    | seq hmod hrest =>
      cases hrest with
      | seq hgather hlayout =>
        cases hbig' with
        | seq hnative htail =>
          refine ⟨_,Nat.add_le_add hkh hkl,?_⟩
          have hb:=BigStepB.seq hmod (BigStepB.seq hgather
            (BigStepB.seq hlayout (BigStepB.seq hgram
              (BigStepB.seq hnative htail))))
          convert hb using 1 <;> (try simp only [stageController]) <;> omega
noncomputable def stageCost (F : FieldPresentation K) (q a b c : Nat) : Nat :=
  boundaryGramCost F q a b c+
    (10000+(20*(boundaryWidth a b c*boundaryWidth a b c*F.e)+12+
      Problem18P36BoundarySweep20261002.cost F (boundaryWidth a b c)))
theorem stageController_run (F : FieldPresentation K)
    {B a b c : Nat} {u : Bool} {q : Nat} {A : RectTensor a b c K}
    (sigma : Env) (h : BoundaryInput F B a b c u q A sigma) :
    ∃tau t, t ≤ stageCost F q a b c ∧
      Run B stageController sigma tau t ∧
      Problem18IMPBoundarySweepState20261002.State F B
        (stageGram u q A h.first) (boundaryWidth a b c) tau ∧
      (∀j<(tau.arrs workBank).length,(tau.arrs workBank).getD j 0<F.p) ∧
      tau.inp=sigma.inp ∧ tau.out=sigma.out := by
  let n:=boundaryWidth a b c
  let d:=boundaryHeight a b c
  obtain ⟨theta,htheta⟩:=boundary_gram_run F sigma h
  obtain ⟨gramCost,hgramle,hgramrun⟩:=htheta.run
  have preserve (x : String) (hx : x∉scalarWrites
      (.seq (.seq modulusCopy (.seq boundaryGather gramLayoutSetup)) gramProgram)) :
      theta.vars x=sigma.vars x := (run_frame hgramrun).1 x hx
  have he : theta.vars canonical.e=F.e := by
    exact (preserve canonical.e (by
      simp [modulusCopy,modulusCopySetup,boundaryGather,gramLayoutSetup,
        gramProgram,unitarySetup,assignAll,renameCom,copyGram,copyBody,scalarWrites]
      decide)).trans h.nativeValid.degree
  have hn : theta.vars Problem18IMPTensorGather20261002.cols=n := by
    exact (preserve _ (by
      simp [modulusCopy,modulusCopySetup,boundaryGather,gramLayoutSetup,
        gramProgram,unitarySetup,assignAll,renameCom,copyGram,copyBody,scalarWrites]
      decide)).trans h.cols_eq
  have hd : theta.vars Problem18P36LargeCovariantController20261003.dimC=d := by
    exact (preserve _ (by
      simp [modulusCopy,modulusCopySetup,boundaryGather,gramLayoutSetup,
        gramProgram,unitarySetup,assignAll,renameCom,copyGram,copyBody,scalarWrites]
      decide)).trans h.dimC_eq
  have ep:=plainAdjointExpr_eval he h.degree_word h.plain_word
  have er:=rectangularCellsExpr_eval he hd hn h.degree_word h.height_word
    h.width_word h.height_width_word h.rectangular_word
  have epow:=poweredAdjointExpr_eval ep er h.powered_word
  have esource:=sourceExpr_eval epow er h.gathered_word
  have edst:=destinationExpr_eval esource er h.gram_word
  have hnativeSetup:=nativeCopySetup_run F theta he hn h.degree_word
    h.width_word h.square_word
    (by simpa [n,Nat.mul_assoc,Nat.mul_comm,Nat.mul_left_comm] using h.square_cells_word)
    edst h.native_base_majorant
  let zeta:=nativeSetupState F d n theta
  have hzvalid : ValidMemory F B zeta := by
    have v1:=Problem18IMPMatrixDot20261001.validMemory_setVar F htheta.nativeValid
      copyCount (n*n*F.e) (by decide) (by decide) (by decide)
    have v2:=Problem18IMPMatrixDot20261001.validMemory_setVar F v1
      externalBase (gramBase F.e d n) (by decide) (by decide) (by decide)
    have v3:=Problem18IMPMatrixDot20261001.validMemory_setVar F v2
      nativeBase (F.e+1+Problem18IMPBoundaryCyclicLayout20261002.matrix n*F.e)
      (by decide) (by decide) (by decide)
    simpa [zeta,nativeSetupState] using v3
  have hzslots : Slots F canonical
      Problem18IMPBoundaryPhaseState20261002.workspaceName
      (Problem18IMPBoundaryCyclicLayout20261002.slots n) B zeta := by
    have s1:=Slots.setVar F canonical htheta.nativeSlots (x:=copyCount) (by decide) (by decide)
      (n*n*F.e)
    have s2:=Slots.setVar F canonical s1 (x:=externalBase) (by decide) (by decide)
      (gramBase F.e d n)
    have s3:=Slots.setVar F canonical s2 (x:=nativeBase) (by decide) (by decide)
      (F.e+1+Problem18IMPBoundaryCyclicLayout20261002.matrix n*F.e)
    simpa [zeta,nativeSetupState] using s3
  have hworkspace : zeta.vars Problem18IMPBoundaryPhaseState20261002.workspaceName=
      F.e+1 := by
    simpa [zeta,nativeSetupState,copyCount,externalBase,nativeBase,canonical,
      Problem18IMPBoundaryPhaseState20261002.workspaceName] using
      (preserve _ (by
        simp [modulusCopy,modulusCopySetup,boundaryGather,gramLayoutSetup,
          gramProgram,unitarySetup,assignAll,renameCom,copyGram,copyBody,scalarWrites]
        decide)).trans h.workspace_eq
  have hcols : zeta.vars Problem18IMPTensorGather20261002.cols=n := by
    simpa [zeta,nativeSetupState,copyCount,externalBase,nativeBase,
      Problem18IMPTensorGather20261002.cols] using hn
  have hmod : zeta.vars canonical.modBase=0 := by
