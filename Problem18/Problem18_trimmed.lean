variable {K : Type} [Field K] (F : FieldPresentation K)
theorem finish_primitive_run (op : Primitive) {B : Nat} (σ : Env) (x : K)
    (h : ValidMemory F B σ) (ho : Fits F σ (σ.vars canonical.outBase))
    (hx : decode F (slice F σ canonical (σ.vars canonical.outBase))=x) :
    ∃τ,Run B (finish (.primitive op)) σ τ (30*(F.e+1)) ∧ τ.out=σ.out++coefficients F x := by
  let ξ:=σ.setVar canonical.flag F.e
  have hpB : F.p<B := by have hh:=h.arithmetic_word; nlinarith only [hh]
  have heB:=h.degree_word
  have hv : (Expr.var canonical.e).evalB B σ=some F.e := by
    simpa only [h.degree] using evalB_var (σ:=σ) (x:=canonical.e) (by rw [h.degree]; exact heB)
  have heval : (Expr.mul (.lit 1) (.var canonical.e)).evalB B σ=some F.e := by
    simpa [Bop.apply] using evalB_bin (op:=Bop.mul) (evalB_lit (by have he:=F.degree_pos; omega : 1<B)) hv
      (by change 1*F.e<B; simpa using heB)
  have hc : slice F σ canonical (σ.vars canonical.outBase)=fun i=>(F.coordinate x i).val :=
    (decode_injective F (h.slice_canonical _ ho) (fun i=>(F.coordinate x i).isLt)).mp
      (hx.trans (decode_coordinates F x).symm)
  have hwrite:=writeBlock_run outputNames (by unfold Names.Valid outputNames canonical; decide) ξ (coefficients F x)
    (by simpa [coefficients] using heB)
    (by simp [ξ,outputNames,canonical,coefficients])
    (by simpa [ξ,outputNames,canonical,coefficients] using ho)
    (by simpa [ξ,outputNames] using h.memory_word)
    (fun v hv=>(coefficients_bound F x v hv).trans hpB) (by
      intro j hj
      have hj' : j<F.e := by simpa [coefficients] using hj
      have hh:=congrFun hc ⟨j,hj'⟩
      rw [coefficients_get F x ⟨j,hj'⟩]
      simpa [slice,ξ,outputNames,canonical] using hh)
  refine ⟨_,((Run.assign (x:=canonical.flag) heval).seq hwrite.1).mono ?_,?_⟩
  · simp [Expr.size,Expr.mul,coefficients]; omega
  · simpa [ξ] using hwrite.2
theorem append_loader {B t u : Nat} {σ μ τ : Env} {c : Com}
    (h : Run B (.seq readHeader (.seq initializePointers loadCoefficients)) σ μ t)
    (hc : Run B c μ τ u) :
    Run B (.seq readHeader (.seq initializePointers (.seq loadCoefficients c))) σ τ (t+u) := by
  obtain ⟨k,hk,hbs⟩:=h
  obtain ⟨l,hl,hcs⟩:=hc
  cases hbs with
  | seq hhead htail=>
    cases htail with
    | seq hpointers hload=>
      exact ⟨_,by omega,.seq hhead (.seq hpointers (.seq hload hcs))⟩
theorem primitive_program_run (op : Primitive) (a b : K) (q B : Nat)
    (hmem : 16*(F.e+1)<B) (hq : q<B)
    (harith : (F.p+1)^2<B) (hinverse : (F.p+1)^(F.e+1)<B) :
    ∃τ,Run B (fieldProgram (.primitive op)) (initialState F a b q) τ
        (230*(F.e+1)+op.cost F q) ∧ τ.out=coefficients F (op.value q a b) := by
  have hp : F.p<B := by nlinarith only [harith]
  have hload:=load_run F a b q B hmem hp
  have hvalid:=fieldState_valid F a b q B hmem harith hinverse
  have hv:=fieldState_vars F a b q
  have hl:=fieldState_lengths F a b q
  have ha : Fits F (fieldState F a b q) ((fieldState F a b q).vars canonical.aBase) := by
    change _+F.e≤_
    rw [hv.2.2.2.2.1,hl.1]; omega
  have hb : Fits F (fieldState F a b q) ((fieldState F a b q).vars canonical.bBase) := by
    change _+F.e≤_
    rw [hv.2.2.2.2.2.1,hl.1]; omega
  have ho : Fits F (fieldState F a b q) ((fieldState F a b q).vars canonical.outBase) := by
    change _+F.e≤_
    rw [hv.2.2.2.2.2.2.1,hl.1]; omega
  have hoa : Disjoint F ((fieldState F a b q).vars canonical.outBase)
      ((fieldState F a b q).vars canonical.aBase) := by
    right; rw [hv.2.2.2.2.1,hv.2.2.2.2.2.2.1]; omega
  have hob : Disjoint F ((fieldState F a b q).vars canonical.outBase)
      ((fieldState F a b q).vars canonical.bBase) := by
    right; rw [hv.2.2.2.2.2.1,hv.2.2.2.2.2.2.1]; omega
  have hom : Disjoint F ((fieldState F a b q).vars canonical.outBase)
      ((fieldState F a b q).vars canonical.modBase) := by
