    BilinearSystemZero F G JA JB JM e ker x ↔
      (pMatrix x).transpose * (JA * pMatrix x) = JA ∧
      (rMatrix x).transpose * (JB * rMatrix x) = JB ∧
      LinearMap.ker (augmentedTransformedMatrix x F e).toLin' =
        LinearMap.ker (augmentedConstantMatrix G e).toLin' ∧
      (transformedMatrix x F).transpose * (JM * transformedMatrix x F) =
        G.transpose * (JM * G) := by
  constructor
  · intro h
    refine ⟨(preservesP_zero_iff x JA).mp (fun i j => h (.inl (.inl (i, j)))),
      (preservesR_zero_iff x JB).mp (fun i j => h (.inl (.inr (i, j)))), ?_, ?_⟩
    · exact (augmentedKernel_equations_iff_kernel_eq x F G e ker hspan hrank).mp
        (fun s t => h (.inr (.inl (s, t))))
    · exact (pulledBack_equations_iff x F G JM).mp
        (fun i j => h (.inr (.inr (i, j))))
  · rintro ⟨hP, hR, hker, hgram⟩ i
    rcases i with (i | i)
    · rcases i with (ij | ij)
      · exact (preservesP_zero_iff x JA).mpr hP ij.1 ij.2
      · exact (preservesR_zero_iff x JB).mpr hR ij.1 ij.2
    · rcases i with (st | ij)
      · exact (augmentedKernel_equations_iff_kernel_eq x F G e ker hspan hrank).mpr hker st.1 st.2
      · exact (pulledBack_equations_iff x F G JM).mpr hgram ij.1 ij.2
theorem bilinearSystem_zero_iff_root_augment [Field K] {a b c k : ℕ}
    (F G : Matrix (Fin c) (Fin a × Fin b) K)
    (JA : Matrix (Fin a) (Fin a) K) (JB : Matrix (Fin b) (Fin b) K)
    (JM : Matrix (Fin c) (Fin c) K) (e : Fin c → K)
    (ker : Fin k → (AugmentedColumn a b → K))
    (hspan : Submodule.span K (Set.range ker) =
      LinearMap.ker (augmentedConstantMatrix G e).toLin')
    (x : OuterVar a b → K)
    (hrank : Module.finrank K
        (LinearMap.range (augmentedTransformedMatrix x F e).toLin') =
      Module.finrank K (LinearMap.range (augmentedConstantMatrix G e).toLin')) :
    BilinearSystemZero F G JA JB JM e ker x ↔
      (pMatrix x).transpose * (JA * pMatrix x) = JA ∧
      (rMatrix x).transpose * (JB * rMatrix x) = JB ∧
      LinearMap.ker (Problem18MarkedRecovery20260929.augment
        (transformedMatrix x F).toLin' e) =
        LinearMap.ker (Problem18MarkedRecovery20260929.augment G.toLin' e) ∧
      (transformedMatrix x F).transpose * (JM * transformedMatrix x F) =
        G.transpose * (JM * G) := by
  rw [bilinearSystem_zero_iff F G JA JB JM e ker hspan x hrank]
  constructor
  · rintro ⟨hP, hR, hker, hgram⟩
    exact ⟨hP, hR, (augmentedMatrix_kernel_eq_iff_augment x F G e).mp hker, hgram⟩
  · rintro ⟨hP, hR, hker, hgram⟩
    exact ⟨hP, hR, (augmentedMatrix_kernel_eq_iff_augment x F G e).mpr hker, hgram⟩
end Mathproof.Problem18BoundedSolverBridge20260930
