theorem balanced_cross_exponent
    (p z r s t : ℝ) (hp : 0 ≤ p) (hz : 0 ≤ z)
    (hr : 0 ≤ r) (hs : 0 ≤ s) (hsp : s ≤ p) (hsr : s ≤ r)
    (ht : t = p + z) (hbalance : 0 ≤ z - p) (hclose : z - p ≤ 1)
    (ht4 : 4 ≤ t) (hrt : r ≤ 2 * t) :
    t * r ≤ 16 * ((p - s) * (r - s) + s * z) := by
  by_cases htr : t ≤ r
  · have ha : 0 ≤ (p - s) * (r - z - s) :=
      mul_nonneg (sub_nonneg.mpr hsp) (by linarith)
    have hb : (z - p) ^ 2 ≤ 1 := by nlinarith
    have hc : t * r ≤ 2 * t ^ 2 := by
      nlinarith [mul_nonneg (show 0 ≤ t by linarith) (sub_nonneg.mpr hrt)]
    nlinarith [sq_nonneg t]
  · have hrt' : r ≤ t := le_of_lt (lt_of_not_ge htr)
    have ha := sq_nonneg (2 * s - r)
    have hb := mul_nonneg hbalance hs
    have hc := mul_nonneg hr (show 0 ≤ t - r by linarith)
    have hd := mul_nonneg hr (show 0 ≤ 2 * p - t + 1 by linarith)
    have he := mul_nonneg hr (show 0 ≤ t - 4 by linarith)
    nlinarith
end Mathproof.Problem18BalancedCrossExponent20260930
end
