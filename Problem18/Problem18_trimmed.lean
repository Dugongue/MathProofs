variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
noncomputable def entry (σ : Env) (N ps i : Nat) : K :=
  if i=0 then 0 else ((N-i:Nat):K)*val F canonical WS σ (ps+(i-1))
def loopCost (N : Nat) := (coreCost F+9)*N+4
theorem loop_run {B Sn N ps ds : Nat} {σ : Env}
    (hS : Slots F canonical WS Sn B σ)
    (hN : σ.vars sizeReg=N) (hj : σ.vars q.j=1) (hN1 : 1 ≤ N)
    (hp : σ.vars tw.pS=ps) (hd : σ.vars output=ds)
    (hp5 : 5 ≤ ps) (hd5 : 5 ≤ ds) (hpf : ps+N ≤ Sn) (hdf : ds+N ≤ Sn)
    (hsep : ps+N ≤ ds ∨ ds+N ≤ ps) (hz : val F canonical WS σ ds=0) :
    ∃τ,Run B loop σ τ (loopCost F N) ∧ Slots F canonical WS Sn B τ ∧
      (∀i<N,val F canonical WS τ (ds+i)=entry F σ N ps i) ∧
      (∀s<Sn,s≠2 → (s<ds ∨ ds+N ≤ s) → val F canonical WS τ s=val F canonical WS σ s) ∧
      (∀x,x∉regNames canonical → x≠ci → x≠q.j → τ.vars x=σ.vars x) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hSB:=hS.slots_word
  let I : Env → Prop := fun τ => Slots F canonical WS Sn B τ ∧
    1 ≤ τ.vars q.j ∧ τ.vars q.j ≤ N ∧
    (∀x,x∉regNames canonical → x≠ci → x≠q.j → τ.vars x=σ.vars x) ∧
    (∀i<N,val F canonical WS τ (ds+i)=if i<τ.vars q.j then entry F σ N ps i else val F canonical WS σ (ds+i)) ∧
    (∀s<Sn,s≠2 → (s<ds ∨ ds+N ≤ s) → val F canonical WS τ s=val F canonical WS σ s) ∧
    τ.inp=σ.inp ∧ τ.out=σ.out
  have hI : I σ := by
    refine ⟨hS,by omega,by omega,fun _ _ _ _=>rfl,?_,fun _ _ _ _=>rfl,rfl,rfl⟩
    intro i hi
    rw [hj]
    by_cases he : i=0
    · subst i;simp only [Nat.add_zero,show (0:Nat)<1 by omega,if_pos,entry];exact hz
    · rw [if_neg (by omega)]
  have hNτ : ∀τ,I τ → τ.vars sizeReg=N := by
    intro τ h;rw [h.2.2.2.1 sizeReg (by decide) (by decide) (by decide)];exact hN
  have hdef : ∀τ,I τ → ∃b,(Cond.lt (.var q.j) (.var sizeReg)).evalB B τ=some b := by
    intro τ h
    exact evalB_condLt_vars (by have:=h.2.2.1;omega) (by rw [hNτ τ h];omega)
  have hstep : ∀τ,I τ → (Cond.lt (.var q.j) (.var sizeReg)).evalB B τ=some true →
      ∃τ',Run B body τ τ' (coreCost F+4) ∧ I τ' ∧ N-τ'.vars q.j<N-τ.vars q.j := by
    intro τ h hc
    have hn:=hNτ τ h
    obtain ⟨hs,hj1,hjN,hvars,hdst,hframe,hin,hout⟩:=h
    have hjlt : τ.vars q.j<N := by
      rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hn];omega))] at hc
      simpa only [hn,Option.some.injEq,decide_eq_true_eq] using hc
    have hp' : τ.vars tw.pS=ps := (hvars _ (by decide) (by decide) (by decide)).trans hp
    have hd' : τ.vars output=ds := (hvars _ (by decide) (by decide) (by decide)).trans hd
    obtain ⟨ξ,hr,hξ,hvalue,hmem,hreg,hi,ho⟩:=core_run F hs hn rfl hp' hd' (by omega) hjlt hp5 hd5 hpf hdf hsep
    have hjξ : ξ.vars q.j=τ.vars q.j := hreg _ (by decide) (by decide)
    have he : (plus (.var q.j) (.lit 1)).evalB B ξ=some (τ.vars q.j+1) :=
      evalB_bin (op:=Bop.add) (by simpa only [hjξ] using evalB_var (σ:=ξ) (B:=B) (x:=q.j) (by rw [hjξ];omega))
        (evalB_lit (by omega : 1<B)) (by change τ.vars q.j+1<B;omega)
    refine ⟨ξ.setVar q.j (τ.vars q.j+1),hr.seq (Run.assign he),?_,?_⟩
    · refine ⟨Slots.setVar F canonical hξ (by decide) (by decide) _,?_,?_,?_,?_,?_,?_,?_⟩
      · simp only [vars_setVar,if_true];omega
      · simp only [vars_setVar,if_true];omega
      · intro x hx hci hqj
        rw [vars_setVar,if_neg hqj,hreg x hx hci];exact hvars x hx hci hqj
      · intro i hiN
        rw [val_setVar F canonical (by decide : q.j≠WS)]
        simp only [vars_setVar,if_true]
        by_cases hij : i=τ.vars q.j
        · subst i
          rw [if_pos (Nat.lt_succ_self _),hvalue]
          unfold entry
          rw [if_neg (by omega)]
          congr 1
          apply hframe _ (by omega) (by omega)
          rcases hsep with h|h <;> omega
        · rw [hmem _ (by omega) (by omega) (by omega),hdst i hiN]
          by_cases hit : i<τ.vars q.j
          · rw [if_pos hit,if_pos (by omega)]
          · rw [if_neg hit,if_neg (by omega)]
      · intro s hsx hs2 hso
        rw [val_setVar F canonical (by decide : q.j≠WS),hmem s hsx hs2 (by rcases hso with h|h <;> omega)]
        exact hframe s hsx hs2 hso
      · exact hi.trans hin
      · exact ho.trans hout
    · simp only [vars_setVar,if_true];omega
  obtain ⟨τ,hr,hτ,hfalse⟩:=Run.while_count I (fun τ=>N-τ.vars q.j) (coreCost F+4) hdef hstep hI
  have hn:=hNτ τ hτ
  obtain ⟨hs,hj1,hjN,hvars,hdst,hframe,hin,hout⟩:=hτ
  have hjeq : τ.vars q.j=N := by
    rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hn];omega))] at hfalse
    simp only [hn,Option.some.injEq,decide_eq_false_iff_not] at hfalse
    omega
  refine ⟨τ,hr.mono ?_,hs,?_,hframe,hvars,hin,hout⟩
  · simp only [loopCost,Cond.size,Expr.size]
    have hh:=Nat.mul_le_mul_left (coreCost F+9) (Nat.sub_le N (σ.vars q.j))
    nlinarith
  · intro i hi;rw [hdst i hi,if_pos (by omega)]
end Mathproof.Problem18IMPPolynomialDerivativeController20261002
