  intro A B h
  apply Subtype.ext
  apply Subtype.ext
  exact (hrec A).symm.trans ((congrArg (fun H : SymMat r K =>
    X * H.val * Xᵀ) h).trans (hrec B))
theorem symmetric_rank_card_le_subspaces [Fintype K] (n r : ℕ) :
