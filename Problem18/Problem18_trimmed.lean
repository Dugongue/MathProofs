    (hL : L.Valid r q) {B Sn : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ) {bb vb n m : ℕ}
    (hb : σ.vars L.bank = bb) (hvb : σ.vars L.vs = vb) (hn : σ.vars L.nr = n)
    (hm : σ.vars L.mr = m) (hNr : σ.vars L.Nr = n + m) (hN : σ.vars q.N = n)
    (hfit : bb + rowStart (n + m) m ≤ Sn) (hvfit : vb + m * n ≤ Sn)
    (hdisj : vb + m * n ≤ bb ∨ bb + rowStart (n + m) m ≤ vb)
    (hzero : ∀ s, rowStart (n + m) 0 ≤ s → s < rowStart (n + m) m →
      val F r q.WS σ (bb + s) = 0)
    (v : Fin m → Fin n → K)
    (hv : ∀ (a : Fin m) (t : Fin n), val F r q.WS σ (vb + a.val * n + t.val) = v a t) :
    ∃ τ, Run B (rowLoop M q L) σ τ (rowCost M.costPoint F.e n m) ∧ Slots F r q.WS Sn B τ ∧
      (∀ (a : Fin m) (t : Fin n),
        val F r q.WS τ (bb + rowStart (n + m) a.val + t.val) = v a t) ∧
      (∀ (a u : Fin m), val F r q.WS τ (bb + rowStart (n + m) a.val + n + u.val) =
        if u = a then 1 else 0) ∧
      (∀ s < Sn, (s < bb + rowStart (n + m) 0 ∨ bb + rowStart (n + m) m ≤ s) →
        val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ y, y ∉ regNames r → y ≠ q.j → y ≠ L.i → y ≠ L.ra → y ≠ L.sa → y ≠ L.ci →
        τ.vars y = σ.vars y) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hSB := hS.slots_word
  have hp1 : (1 : ℕ) < F.p := F.prime.one_lt
  set N := n + m with hNdef
  have mem : ∀ {y : String}, y ∈ L.list → y ∉ regNames r ∧ y ≠ q.WS ∧ y ≠ q.j ∧ y ≠ q.N :=
    fun hy => ⟨hL.reg _ hy, hL.ws _ hy, hL.j _ hy, hL.N _ hy⟩
  have hiS : L.i ∉ regNames r := (mem (by simp [LNames.list])).1
  have hraS : L.ra ∉ regNames r := (mem (by simp [LNames.list])).1
  have hsaS : L.sa ∉ regNames r := (mem (by simp [LNames.list])).1
  have hciS : L.ci ∉ regNames r := (mem (by simp [LNames.list])).1
  have hiW : L.i ≠ q.WS := (mem (by simp [LNames.list])).2.1
  have hraW : L.ra ≠ q.WS := (mem (by simp [LNames.list])).2.1
  have hsaW : L.sa ≠ q.WS := (mem (by simp [LNames.list])).2.1
  have hciW : L.ci ≠ q.WS := (mem (by simp [LNames.list])).2.1
  have hiJ : L.i ≠ q.j := (mem (by simp [LNames.list])).2.2.1
  have hraJ : L.ra ≠ q.j := (mem (by simp [LNames.list])).2.2.1
  have hsaJ : L.sa ≠ q.j := (mem (by simp [LNames.list])).2.2.1
  have hNS : q.N ∉ regNames r := hq.avoid _ q.N_mem
  have hNj : q.N ≠ q.j := hq.ne_of (by intro h; simp [RNames.list, h])
  have keepReg : ∀ y, y ∈ [L.bank, L.vs, L.nr, L.mr, L.Nr, q.N] →
      y ∉ regNames r ∧ y ≠ q.j ∧ y ≠ L.i ∧ y ≠ L.ra ∧ y ≠ L.sa ∧ y ≠ L.ci := by
    intro y hy
    simp only [List.mem_cons, List.not_mem_nil, or_false] at hy
    rcases hy with rfl | rfl | rfl | rfl | rfl | rfl
    · exact ⟨(mem (by simp [LNames.list])).1, (mem (by simp [LNames.list])).2.2.1, hL.ne 0 8 (by omega) (by omega)
        (by omega), hL.ne 0 9 (by omega) (by omega) (by omega), hL.ne 0 10 (by omega) (by omega)
        (by omega), hL.ne 0 11 (by omega) (by omega) (by omega)⟩
    · exact ⟨(mem (by simp [LNames.list])).1, (mem (by simp [LNames.list])).2.2.1, hL.ne 2 8 (by omega) (by omega)
        (by omega), hL.ne 2 9 (by omega) (by omega) (by omega), hL.ne 2 10 (by omega) (by omega)
        (by omega), hL.ne 2 11 (by omega) (by omega) (by omega)⟩
    · exact ⟨(mem (by simp [LNames.list])).1, (mem (by simp [LNames.list])).2.2.1, hL.ne 3 8 (by omega) (by omega)
        (by omega), hL.ne 3 9 (by omega) (by omega) (by omega), hL.ne 3 10 (by omega) (by omega)
        (by omega), hL.ne 3 11 (by omega) (by omega) (by omega)⟩
    · exact ⟨(mem (by simp [LNames.list])).1, (mem (by simp [LNames.list])).2.2.1, hL.ne 4 8 (by omega) (by omega)
        (by omega), hL.ne 4 9 (by omega) (by omega) (by omega), hL.ne 4 10 (by omega) (by omega)
        (by omega), hL.ne 4 11 (by omega) (by omega) (by omega)⟩
    · exact ⟨(mem (by simp [LNames.list])).1, (mem (by simp [LNames.list])).2.2.1, hL.ne 5 8 (by omega) (by omega)
        (by omega), hL.ne 5 9 (by omega) (by omega) (by omega), hL.ne 5 10 (by omega) (by omega)
        (by omega), hL.ne 5 11 (by omega) (by omega) (by omega)⟩
    · exact ⟨hNS, hNj, fun e => (mem (y := L.i) (by simp [LNames.list])).2.2.2 e.symm,
        fun e => (mem (y := L.ra) (by simp [LNames.list])).2.2.2 e.symm,
        fun e => (mem (y := L.sa) (by simp [LNames.list])).2.2.2 e.symm,
        fun e => (mem (y := L.ci) (by simp [LNames.list])).2.2.2 e.symm⟩
  have hira : L.i ≠ L.ra := hL.ne 8 9 (by omega) (by omega) (by omega)
  have hisa : L.i ≠ L.sa := hL.ne 8 10 (by omega) (by omega) (by omega)
  have hici : L.i ≠ L.ci := hL.ne 8 11 (by omega) (by omega) (by omega)
  have hrasa : L.ra ≠ L.sa := hL.ne 9 10 (by omega) (by omega) (by omega)
  have hraci : L.ra ≠ L.ci := hL.ne 9 11 (by omega) (by omega) (by omega)
  have hsaci : L.sa ≠ L.ci := hL.ne 10 11 (by omega) (by omega) (by omega)
  have hnrci : L.nr ≠ L.ci := (keepReg L.nr (by simp)).2.2.2.2.2
  let I : Env → Prop := fun τ =>
    Slots F r q.WS Sn B τ ∧ τ.vars L.i ≤ m ∧
    (∀ y, y ∉ regNames r → y ≠ q.j → y ≠ L.i → y ≠ L.ra → y ≠ L.sa → y ≠ L.ci →
      τ.vars y = σ.vars y) ∧
    (∀ (a : Fin m), a.val < τ.vars L.i → ∀ t : Fin n,
      val F r q.WS τ (bb + rowStart N a.val + t.val) = v a t) ∧
    (∀ (a : Fin m), a.val < τ.vars L.i → ∀ u : Fin m,
      val F r q.WS τ (bb + rowStart N a.val + n + u.val) = if u = a then 1 else 0) ∧
    (∀ s < Sn, (s < bb + rowStart N 0 ∨ bb + rowStart N (τ.vars L.i) ≤ s) →
      val F r q.WS τ s = val F r q.WS σ s) ∧
    (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out
  set σ0 := σ.setVar L.i 0 with hσ0
  have hI0 : I σ0 := by
    refine ⟨Slots.setVar F r hS hiS hiW 0, by simp [hσ0], ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · intro y _ _ hy _ _ _; simp [hσ0, hy]
    · intro a ha; simp [hσ0] at ha
    · intro a ha; simp [hσ0] at ha
    · intro s _ _; exact val_setVar F r hiW σ 0 s
    · intro a _ _; simp [hσ0]
    · simp [hσ0]
    · simp [hσ0]
  have hdef : ∀ τ, I τ → ∃ w, (Cond.lt (.var L.i) (.var L.mr)).evalB B τ = some w := by
    intro τ hτ
    have hmτ : τ.vars L.mr = m := by
      obtain ⟨a1, a2, a3, a4, a5, a6⟩ := keepReg L.mr (by simp)
      rw [hτ.2.2.1 _ a1 a2 a3 a4 a5 a6, hm]
    have : m ≤ rowStart N m := by unfold rowStart; omega
    exact ⟨_, evalB_condLt (evalB_var (by have := hτ.2.1; omega))
      (evalB_var (by rw [hmτ]; omega))⟩
  have hstep : ∀ τ, I τ → (Cond.lt (.var L.i) (.var L.mr)).evalB B τ = some true →
      ∃ τ', Run B (rowBody M q L) τ τ' (rowStep M.costPoint F.e n) ∧ I τ' ∧
        m - τ'.vars L.i < m - τ.vars L.i := by
    intro τ hτ hc
    obtain ⟨hSτ, hiτ, hxτ, hpτ, hsτ, hfτ, haτ, hinτ, houτ⟩ := hτ
    have kr : ∀ y, y ∈ [L.bank, L.vs, L.nr, L.mr, L.Nr, q.N] → τ.vars y = σ.vars y := by
      intro y hy
      obtain ⟨a1, a2, a3, a4, a5, a6⟩ := keepReg y hy
      exact hxτ y a1 a2 a3 a4 a5 a6
    have hbτ : τ.vars L.bank = bb := by rw [kr _ (by simp), hb]
    have hvτ : τ.vars L.vs = vb := by rw [kr _ (by simp), hvb]
    have hnτ : τ.vars L.nr = n := by rw [kr _ (by simp), hn]
    have hmτ : τ.vars L.mr = m := by rw [kr _ (by simp), hm]
    have hNrτ : τ.vars L.Nr = N := by rw [kr _ (by simp), hNr]
    have hNτ : τ.vars q.N = n := by rw [kr _ (by simp), hN]
    set iv := τ.vars L.i with hivdef
    have hlt : iv < m := by
      have hmB : m < B := by
        have : m ≤ rowStart N m := by unfold rowStart; omega
        omega
      rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hmτ]; omega)), hmτ] at hc
      simpa using hc
    have hRle : rowStart N iv + N ≤ rowStart N m := rs_le (by omega)
    have hR0 : rowStart N 0 ≤ rowStart N iv := rs_mono (by omega)
    have hRiv : rowStart N iv = 5 + N + iv * N := rfl
    have hRm : rowStart N m = 5 + N + m * N := rfl
    set R := bb + rowStart N iv with hRdef
    have eRa : (raE L).evalB B τ = some R := by
      have h1 : (plus (plus (.var L.bank) (.lit 5)) (.var L.Nr)).evalB B τ = some (bb + 5 + N) :=
        evalB_plus (evalB_plus (evalB_var_eqB hbτ (by omega)) (evalB_lit (by omega)) (by omega))
          (evalB_var_eqB hNrτ (by omega)) (by omega)
      have h2 : (Expr.bin .mul (.var L.i) (.var L.Nr)).evalB B τ = some (iv * N) :=
        evalB_mul (evalB_var (by omega)) (evalB_var_eqB hNrτ (by omega)) (by omega)
      have h3 := evalB_plus h1 h2 (by omega)
      rw [show bb + 5 + N + iv * N = R by omega] at h3
      exact h3
    set τ1 := τ.setVar L.ra R with hτ1
    have v1 : ∀ y, y ≠ L.ra → τ1.vars y = τ.vars y := fun y hy => by simp [hτ1, hy]
    have hmn : iv * n + n ≤ m * n := mul_add_leB (by omega)
    have eSa : (saE L).evalB B τ1 = some (vb + iv * n) := by
      have hi1 : τ1.vars L.i = iv := v1 _ hira
      have hn1 : τ1.vars L.nr = n := by rw [v1 _ (keepReg L.nr (by simp)).2.2.2.1, hnτ]
      have hv1' : τ1.vars L.vs = vb := by rw [v1 _ (keepReg L.vs (by simp)).2.2.2.1, hvτ]
      have h2 : (Expr.bin .mul (.var L.i) (.var L.nr)).evalB B τ1 = some (iv * n) :=
        evalB_mul (evalB_var_eqB hi1 (by omega)) (evalB_var_eqB hn1 (by omega)) (by omega)
      exact evalB_plus (evalB_var_eqB hv1' (by omega)) h2 (by omega)
    set τ2 := τ1.setVar L.sa (vb + iv * n) with hτ2
    have v2 : ∀ y, y ≠ L.ra → y ≠ L.sa → τ2.vars y = τ.vars y := fun y h1 h2 => by
      simp [hτ2, h2, v1 y h1]
    have hS2 : Slots F r q.WS Sn B τ2 :=
      Slots.setVar F r (Slots.setVar F r hSτ hraS hraW R) hsaS hsaW _
    have val2 : ∀ s, val F r q.WS τ2 s = val F r q.WS τ s := fun s => by
      rw [hτ2, val_setVar F r hsaW, hτ1, val_setVar F r hraW]
    have eR2 : (Expr.var L.ra).evalB B τ2 = some R :=
      evalB_var_eqB (v := R) (by simp [hτ2, hτ1, hrasa]) (by omega)
    have eS2 : (Expr.var L.sa).evalB B τ2 = some (vb + iv * n) :=
      evalB_var_eqB (v := vb + iv * n) (by simp [hτ2]) (by omega)
    have hN2 : τ2.vars q.N = n := by
      rw [v2 _ (keepReg q.N (by simp)).2.2.2.1 (keepReg q.N (by simp)).2.2.2.2.1, hNτ]
    obtain ⟨τ3, hr3, hS3, hv3, hf3, hx3, -, ha3, hi3, ho3⟩ :=
      copy_run M q hq [L.ra, L.sa]
        (by intro x hx; simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
            rcases hx with rfl | rfl
            · exact ⟨hraS, hraJ⟩
            · exact ⟨hsaS, hsaJ⟩)
        (.var L.ra) (.var L.sa) (by simp [VarsIn]) (by simp [VarsIn]) hS2 eR2 eS2 hN2
        (by omega) (by omega) (by rcases hdisj with h | h <;> [right; left] <;> omega)
    have v3 : ∀ y, y ∉ regNames r → y ≠ q.j → τ3.vars y = τ2.vars y := hx3
    have eOne : (oneE L).evalB B τ3 = some (R + n + iv) := by
      have er : τ3.vars L.ra = R := by rw [v3 _ hraS hraJ]; simp [hτ2, hτ1, hrasa]
      have en : τ3.vars L.nr = n := by
        obtain ⟨a1, a2, _, a4, a5, _⟩ := keepReg L.nr (by simp)
        rw [v3 _ a1 a2, v2 _ a4 a5, hnτ]
      have ei : τ3.vars L.i = iv := by
        rw [v3 _ hiS hiJ, v2 _ hira hisa]
      exact evalB_plus (evalB_plus (evalB_var_eqB er (by omega)) (evalB_var_eqB en (by omega))
        (by omega)) (evalB_var_eqB ei (by omega)) (by omega)
    obtain ⟨τ4, hr4, hS4, hv4, hoth4, hvars4, harr4, hinp4, hout4⟩ :=
      constE_run q L.ci hciS hciW [L.ra, L.nr, L.i]
        (by intro x hx; simp only [List.mem_cons, List.not_mem_nil, or_false] at hx
            rcases hx with rfl | rfl | rfl
            · exact hraci
            · exact hnrci
            · exact hici)
        (oneE L) (by simp [oneE, plus, VarsIn]) hS3 eOne (by omega) (.lit 1) [] (by simp) trivial
        (evalB_lit (by omega)) hp1
    have ei4 : τ4.vars L.i = iv := by
      rw [hvars4 _ hici, v3 _ hiS hiJ, v2 _ hira hisa]
    have eI : (plus (.var L.i) (.lit 1)).evalB B τ4 = some (iv + 1) :=
      evalB_plus (evalB_var_eqB ei4 (by omega)) (evalB_lit (by omega)) (by omega)
    set τ5 := τ4.setVar L.i (iv + 1) with hτ5
    have keep : ∀ s < Sn, s ≠ R + n + iv → (s < R ∨ R + n ≤ s) →
        val F r q.WS τ5 s = val F r q.WS τ s := by
      intro s hs h1 h2
      rw [hτ5, val_setVar F r hiW, hoth4 s hs h1, hf3 s hs h2, val2]
    have copied : ∀ t : Fin n, val F r q.WS τ5 (R + t.val) = v ⟨iv, hlt⟩ t := by
      intro t
      have ht := t.isLt
      rw [hτ5, val_setVar F r hiW, hoth4 (R + t.val) (by omega) (by omega), hv3 t.val ht,
        val2]
      rw [hfτ (vb + iv * n + t.val) (by omega) (by
        rcases hdisj with h | h
        · left; omega
        · right; omega)]
      exact hv ⟨iv, hlt⟩ t
    have one : val F r q.WS τ5 (R + n + iv) = 1 := by
      rw [hτ5, val_setVar F r hiW, hv4]; simp
    refine ⟨τ5, ?_, ⟨Slots.setVar F r hS4 hiS hiW _, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
    · refine ((Run.assign eRa).seq ((Run.assign eSa).seq (hr3.seq (hr4.seq
        (Run.assign eI))))).mono (le_of_eq ?_)
      simp only [rowStep, raE, saE, oneE, plus, Expr.size, copyCost, copyStep, constCostE]
      try ring
    · simp [hτ5]; omega
    · intro y y1 y2 y3 y4 y5 y6
      rw [hτ5, vars_setVar, if_neg y3, hvars4 _ y6, v3 _ y1 y2, v2 _ y4 y5, hxτ y y1 y2 y3 y4 y5 y6]
    · intro a ha t
      have ht := t.isLt
      simp only [hτ5, vars_setVar, if_true] at ha
      by_cases hai : a.val = iv
      · have hae : a = ⟨iv, hlt⟩ := Fin.ext hai
        subst hae
        exact copied t
      · have hle : rowStart N a.val + N ≤ rowStart N iv := rs_le (by omega)
        rw [keep _ (by omega) (by omega) (Or.inl (by omega))]
        exact hpτ a (by omega) t
    · intro a ha u
      have hu := u.isLt
      simp only [hτ5, vars_setVar, if_true] at ha
      by_cases hai : a.val = iv
      · by_cases hu' : u.val = iv
        · have hue : u = a := Fin.ext (hu'.trans hai.symm)
          rw [if_pos hue, hai, hu']
          exact one
        · rw [if_neg (fun e => hu' (by rw [e]; exact hai)), hai,
            keep _ (by omega) (by omega) (Or.inr (by omega)),
            hfτ _ (by omega) (Or.inr (by omega))]
          have hz := hzero (rowStart N iv + n + u.val) (by omega) (by omega)
          rw [show bb + (rowStart N iv + n + u.val) = R + n + u.val by omega] at hz
          exact hz
      · have hle : rowStart N a.val + N ≤ rowStart N iv := rs_le (by omega)
        rw [keep _ (by omega) (by omega) (Or.inl (by omega))]
        exact hsτ a (by omega) u
    · intro s hs ho
      simp only [hτ5, vars_setVar, if_true, rs_succ] at ho
      rcases ho with ho | ho
      · rw [keep s hs (by omega) (Or.inl (by omega))]
        exact hfτ s hs (Or.inl ho)
      · rw [keep s hs (by omega) (Or.inr (by omega))]
        exact hfτ s hs (Or.inr (by omega))
    · intro a h1 h2
      rw [hτ5, arrs_setVar, harr4 a h1, ha3 a h1 h2, hτ2, arrs_setVar, hτ1, arrs_setVar,
        haτ a h1 h2]
    · rw [hτ5, inp_setVar, hinp4, hi3, hτ2, inp_setVar, hτ1, inp_setVar, hinτ]
    · rw [hτ5, out_setVar, hout4, ho3, hτ2, out_setVar, hτ1, out_setVar, houτ]
    · simp [hτ5]; omega
  obtain ⟨τ, hr, hI, hc⟩ := Run.while_count I (fun τ => m - τ.vars L.i)
    (rowStep M.costPoint F.e n) hdef hstep hI0
  obtain ⟨hSτ, hiτ, hxτ, hpτ, hsτ, hfτ, haτ, hinτ, houτ⟩ := hI
  have hmτ : τ.vars L.mr = m := by
    obtain ⟨a1, a2, a3, a4, a5, a6⟩ := keepReg L.mr (by simp)
    rw [hxτ _ a1 a2 a3 a4 a5 a6, hm]
  have him : τ.vars L.i = m := by
    have : m ≤ rowStart N m := by unfold rowStart; omega
    rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hmτ]; omega)), hmτ] at hc
    simp at hc; omega
  refine ⟨τ, ?_, hSτ, fun a t => hpτ a (by omega) t, fun a u => hsτ a (by omega) u,
    fun s hs ho => hfτ s hs (by rw [him]; exact ho), hxτ, haτ, hinτ, houτ⟩
  refine ((Run.assign (x := L.i) (evalB_lit (σ := σ) (n := 0) (by omega))).seq hr).mono
    (le_of_eq ?_)
  simp only [rowCost, Cond.size, Expr.size, hσ0, vars_setVar, if_true, Nat.sub_zero]
  try ring
def loadCom (M : FieldMacros F r) (q : RNames) (L : LNames) : Com :=
  .seq (.assign L.Nr (plus (.var L.nr) (.var L.mr)))
  (.seq (.assign L.Lr (plus (plus (.lit 5) (.var L.Nr)) (.bin .mul (.var L.mr) (.var L.Nr))))
  (.seq (fillCom r q L)
  (.seq (.assign q.N (.var L.nr))
  (.seq (copyLoop M q (plus (.var L.bank) (.lit 5)) (.var L.xs))
  (.seq (rowLoop M q L)
    (.assign q.N (.var L.Nr)))))))
def loadCost (cp e n m : ℕ) : ℕ :=
  4 + (8 + (fillCost e (rowStart (n + m) m) + (2 + ((2 + (39 + cp) * n + 4) +
    (rowCost cp e n m + 2)))))
set_option maxHeartbeats 1600000 in
theorem load_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (L : LNames)
    (hL : L.Valid r q) {B Sn : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ) {bb xb vb n m : ℕ}
    (hb : σ.vars L.bank = bb) (hxb : σ.vars L.xs = xb) (hvb : σ.vars L.vs = vb)
    (hn : σ.vars L.nr = n) (hm : σ.vars L.mr = m)
    (hfit : bb + rowStart (n + m) m ≤ Sn) (hxfit : xb + n ≤ Sn) (hvfit : vb + m * n ≤ Sn)
    (hxdisj : xb + n ≤ bb ∨ bb + rowStart (n + m) m ≤ xb)
    (hvdisj : vb + m * n ≤ bb ∨ bb + rowStart (n + m) m ≤ vb)
    (x : Fin n → K) (v : Fin m → Fin n → K)
    (hx : ∀ t : Fin n, val F r q.WS σ (xb + t.val) = x t)
    (hv : ∀ (a : Fin m) (t : Fin n), val F r q.WS σ (vb + a.val * n + t.val) = v a t) :
    ∃ τ, Run B (loadCom M q L) σ τ (loadCost M.costPoint F.e n m) ∧ Slots F r q.WS Sn B τ ∧
      (∀ s < 5, val F r q.WS τ (bb + s) = 0) ∧
