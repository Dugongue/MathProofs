  have nNn : q.N ≠ q.n := hq.ne_of (by intro h; simp [RNames.list, h])
  have nnc : q.n ≠ q.c := hq.ne_of (by intro h; simp [RNames.list, h])
  have hN7 : σ7.vars q.N = c + m := by
    rw [hσ7, vars_setVar, if_neg nNc, hσ7b, vars_setVar, if_neg nNn, hσ7a, vars_setVar, if_pos rfl]
  have hn7 : σ7.vars q.n = c := by
    rw [hσ7, vars_setVar, if_neg nnc, hσ7b, vars_setVar, if_pos rfl]
