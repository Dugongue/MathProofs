  have l0 : (σ0.arrs sA).length = 11 + N := by simp [σ0, Env.setArr, hlen0]
  have s2 := store_qw (σ := σ0) (idx := 2) (k := 2) (v := u) (by rw [q0, hq]; rfl) hvu (by omega)
    (by omega) (by omega)
  let σ2 := σ0.setArr sA 2 u
  have q2 : σ2.arrs qA = σ.arrs qA := by simp [σ2, σ0, Env.setArr]
  have l2 : (σ2.arrs sA).length = 11 + N := by simp [σ2, Env.setArr, l0]
  have s3 := store_qw (σ := σ2) (idx := 3) (k := 3) (v := q) (by rw [q2, hq]; rfl) hvq (by omega)
    (by omega) (by omega)
  let σ3 := σ2.setArr sA 3 q
  have q3 : σ3.arrs qA = σ.arrs qA := by simp [σ3, σ2, σ0, Env.setArr]
  have l3 : (σ3.arrs sA).length = 11 + N := by simp [σ3, Env.setArr, l2]
  have s4 := store_qw (σ := σ3) (idx := 4) (k := 4) (v := p) (by rw [q3, hq]; rfl) hvp (by omega)
    (by omega) (by omega)
  let σ4 := σ3.setArr sA 4 p
  have q4 : σ4.arrs qA = σ.arrs qA := by simp [σ4, σ3, σ2, σ0, Env.setArr]
  have l4 : (σ4.arrs sA).length = 11 + N := by simp [σ4, Env.setArr, l3]
  have s5 := store_qw (σ := σ4) (idx := 5) (k := 5) (v := e) (by rw [q4, hq]; rfl) hve (by omega)
    (by omega) (by omega)
  let σ5 := σ4.setArr sA 5 e
  have q5 : σ5.arrs qA = σ.arrs qA := by simp [σ5, σ4, σ3, σ2, σ0, Env.setArr]
  have l5 : (σ5.arrs sA).length = 11 + N := by simp [σ5, Env.setArr, l4]
  have s6 := store_qw (σ := σ5) (idx := 6) (k := 6) (v := a) (by rw [q5, hq]; rfl) hva (by omega)
    (by omega) (by omega)
  let σ6 := σ5.setArr sA 6 a
  have q6 : σ6.arrs qA = σ.arrs qA := by simp [σ6, σ5, σ4, σ3, σ2, σ0, Env.setArr]
  have l6 : (σ6.arrs sA).length = 11 + N := by simp [σ6, Env.setArr, l5]
  have s7 := store_qw (σ := σ6) (idx := 7) (k := 7) (v := b) (by rw [q6, hq]; rfl) hvb (by omega)
    (by omega) (by omega)
  let σ7 := σ6.setArr sA 7 b
