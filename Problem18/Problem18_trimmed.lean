  exact Submodule.subset_span ⟨f,hf,1,by simp,by simp⟩
theorem macaulaySpan_le_ideal (F : Set (MvPolynomial (Fin N) K)) (E : Nat) :
    macaulaySpan F E ≤ (generatedIdeal F).restrictScalars K := by
  apply Submodule.span_le.mpr
  rintro z ⟨f,hf,p,hp,rfl⟩
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span hf)
theorem mul_mem_macaulaySpan (F : Set (MvPolynomial (Fin N) K))
    (E D : Nat) (p z : MvPolynomial (Fin N) K)
    (hp : p.totalDegree ≤ D) (hz : z ∈ macaulaySpan F E) :
    p*z ∈ macaulaySpan F (E+D) := by
  induction hz using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨f,hf,q,hq,rfl⟩ := hx
      apply Submodule.subset_span
      refine ⟨f,hf,p*q,?_,by ring⟩
      exact (totalDegree_mul p q).trans (by omega)
  | zero => simp
  | add x y hx hy ihx ihy =>
      rw [mul_add]
      exact Submodule.add_mem _ ihx ihy
  | smul a x hx ih =>
      rw [mul_smul_comm]
      exact Submodule.smul_mem _ _ ih
theorem totalDegree_mul_eq_of_ne_zero (p q : MvPolynomial (Fin N) K)
    (hp : p ≠ 0) (hq : q ≠ 0) :
    (p*q).totalDegree = p.totalDegree + q.totalDegree := by
  rw [← degree_degLexDegree, degLex.degree_mul hp hq, map_add,
    degree_degLexDegree, degree_degLexDegree]
theorem multiplier_totalDegree_le (p q : MvPolynomial (Fin N) K)
    (hp : p ≠ 0) : q.totalDegree ≤ (p*q).totalDegree := by
  by_cases hq : q = 0
  · simp [hq]
  · rw [totalDegree_mul_eq_of_ne_zero p q hp hq]
    omega
theorem macaulaySpan_eq_monomial_span (F : Set (MvPolynomial (Fin N) K)) (E : Nat) :
    macaulaySpan F E = Submodule.span K {z | ∃ f ∈ F, ∃ a : Fin N →₀ Nat,
      a.degree ≤ E ∧ z = monomial a (1 : K)*f} := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro z ⟨f,hf,p,hp,rfl⟩
    rw [MvPolynomial.as_sum p, Finset.sum_mul]
    apply Submodule.sum_mem
    intro a ha
    have hdeg : a.degree ≤ E := (le_totalDegree ha).trans hp
    have hm : monomial a (coeff a p) * f = coeff a p • (monomial a (1 : K)*f) := by
      rw [← smul_mul_assoc, MvPolynomial.smul_monomial]
      simp
    rw [hm]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨f,hf,a,hdeg,rfl⟩)
  · apply Submodule.span_le.mpr
    rintro z ⟨f,hf,a,ha,rfl⟩
    apply Submodule.subset_span
    exact ⟨f,hf,monomial a (1 : K),(totalDegree_monomial_le a (1 : K)).trans ha,rfl⟩
end Mathproof.Problem18BoundedMacaulay20260930
end
