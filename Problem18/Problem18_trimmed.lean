attribute [-instance] FunLike.toDecidableEq CommSemiRingCat.FilteredColimits.colimitCommSemiring AddMonoidAlgebra.instHopfAlgebraStruct AddMonoidAlgebra.instBialgebra Bialgebra.toAlgebra
namespace Problem18FiniteSymmetricRecovery20260929
open Problem18CharTwoMarkedWitt20260929 Problem18MarkedRecovery20260929
variable {K M V : Type*} [Field K] [Fintype K]
  [AddCommGroup M] [Module K M] [AddCommGroup V] [Module K V] [Finite V]
noncomputable def recoveryMarker (B : LinearMap.BilinForm K V)
    (hB : B.Nondegenerate) (hsym : B.IsSymm) : V := by
  classical
  exact if h : (2 : K) = 0 then
    letI : CharP K 2 := (CharP.charP_iff_prime_eq_zero (R := K) Nat.prime_two).mpr h
    canonicalVector B hB hsym
  else 0
theorem augmented_gram_of_gram [CharP K 2]
    (B : LinearMap.BilinForm K V) (hB : B.Nondegenerate) (hsym : B.IsSymm)
    (C D : M →ₗ[K] V)
    (hgram : ∀ x y, B (C x) (C y) = B (D x) (D y)) :
    ∀ x y : M × K,
      B (augment C (canonicalVector B hB hsym) x)
        (augment C (canonicalVector B hB hsym) y) =
      B (augment D (canonicalVector B hB hsym) x)
        (augment D (canonicalVector B hB hsym) y) := by
  let e := canonicalVector B hB hsym
  have hmarker (x : M) : B (C x) e = B (D x) e := by
    apply frobenius_inj K 2
    change B (C x) e ^ 2 = B (D x) e ^ 2
    rw [← canonicalVector_diagonal B hB hsym, ← canonicalVector_diagonal B hB hsym]
    exact hgram x x
  have hmarker' (x : M) : B e (C x) = B e (D x) := by
    rw [hsym.eq e (C x), hmarker, hsym.eq (D x) e]
  intro x y
  change B (C x.1 + x.2 • e) (C y.1 + y.2 • e) =
    B (D x.1 + x.2 • e) (D y.1 + y.2 • e)
  simp only [map_add, map_smul, LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul]
  rw [hgram, hmarker, hmarker']
theorem augment_zero_ker_iff (C D : M →ₗ[K] V) :
    LinearMap.ker (augment C 0) = LinearMap.ker (augment D 0) ↔
      LinearMap.ker C = LinearMap.ker D := by
  constructor
  · intro h
    ext x
    have hx := SetLike.ext_iff.mp h (x, 0)
    simpa using hx
  · intro h
    ext x
    have hx := SetLike.ext_iff.mp h x.1
    simpa using hx
theorem finite_symmetric_recovery_iff
    (B : LinearMap.BilinForm K V) (hB : B.Nondegenerate) (hsym : B.IsSymm)
    (C D : M →ₗ[K] V) :
    (∃ Q : V ≃ₗ[K] V, (∀ x, Q (C x) = D x) ∧
      (∀ v w, B (Q v) (Q w) = B v w)) ↔
    LinearMap.ker (augment C (recoveryMarker B hB hsym)) =
      LinearMap.ker (augment D (recoveryMarker B hB hsym)) ∧
    ∀ x y, B (C x) (C y) = B (D x) (D y) := by
  classical
  by_cases htwo : (2 : K) = 0
  · letI : CharP K 2 := (CharP.charP_iff_prime_eq_zero (R := K) Nat.prime_two).mpr htwo
    simp only [recoveryMarker, dif_pos htwo]
    rw [characteristic_two_recovery_iff B hB hsym C D]
    dsimp only
    constructor
    · rintro ⟨hker, hgram⟩
      exact ⟨hker, fun x y => by simpa using hgram (x, 0) (y, 0)⟩
    · rintro ⟨hker, hgram⟩
      exact ⟨hker, augmented_gram_of_gram B hB hsym C D hgram⟩
  · letI : NeZero (2 : K) := ⟨htwo⟩
    simp only [recoveryMarker, dif_neg htwo, augment_zero_ker_iff]
    exact Problem18FullOddWittRecovery20260929.exists_ambient_isometry_iff_kernel_and_gram
      B hsym.eq hB C D
end Problem18FiniteSymmetricRecovery20260929
