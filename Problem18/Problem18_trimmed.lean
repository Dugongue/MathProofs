      (MulEquiv.irreducible_iff (Polynomial.mapEquiv σ).toMulEquiv).mpr hgi
    have hc : IsCoprime g (g.map σ.toRingHom) := by
      apply hgi.coprime_iff_not_dvd.mpr
      intro hd
      exact hgne (Polynomial.eq_of_monic_of_associated hgm (hgm.map _)
        (hgi.associated_of_dvd hgc hd)).symm
    rw [if_neg (Nat.not_odd_iff_even.mpr he),hfg,paired_quotient_units_card g _ hgm (hgm.map _) hgi hgc hc,
      hgm.natDegree_map,hK,←pow_mul,hdeg]
theorem squarefree_base_unit_weights {K : Type*} [Field K] [Fintype K]
    (σ : K ≃+* K) (hσ : Function.Involutive σ) (hne : σ≠1)
    (f : (fixedField σ)[X]) (hm : f.Monic) (hs : Squarefree f) :
    Nat.card (AdjoinRoot (f.map (algebraMap (fixedField σ) K)))ˣ = Nat.card (AdjoinRoot f)ˣ *
      ∏ j : Mathproof.Problem18BoundaryNormalizedFactors20260930.FactorIndex f,
        (if Odd j.val.natDegree then Nat.card (fixedField σ)^j.val.natDegree+1
         else Nat.card (fixedField σ)^j.val.natDegree-1) := by
  classical
  letI : Fintype (fixedField σ) := Fintype.ofFinite _
  let i := algebraMap (fixedField σ) K
  let g : Mathproof.Problem18BoundaryNormalizedFactors20260930.FactorIndex f → (fixedField σ)[X] := fun j => j.val
  have hgm (j) : (g j).Monic := Mathproof.Problem18BoundaryNormalizedFactors20260930.factor_monic f j
  have hgi (j) : Irreducible (g j) := Mathproof.Problem18BoundaryNormalizedFactors20260930.factor_irreducible f j
  have hcop : Pairwise (fun j k => IsCoprime (g j) (g k)) := by
    intro j k hjk
    apply (hgi j).coprime_iff_not_dvd.mpr
    intro hd
    have ha := ((hgi j).dvd_irreducible_iff_associated (hgi k)).mp hd
    exact hjk (Subtype.ext (Polynomial.eq_of_monic_of_associated (hgm j) (hgm k) ha))
  have hmapcop : Pairwise (fun j k => IsCoprime ((g j).map i) ((g k).map i)) := by
    intro j k hjk
    exact (hcop hjk).map (Polynomial.mapRingHom i)
  have hprod : f.map i=∏ j,(g j).map i := by
    calc
      f.map i=(∏ j,g j).map i := congrArg (fun p => p.map i)
        (Mathproof.Problem18BoundaryNormalizedFactors20260930.factor_product f hm hs)
      _ = _ := map_prod (Polynomial.mapRingHom i) _ _
  have hu := coprime_product_units_card (fun j => (g j).map i) (fun j => (hgm j).map i) hmapcop
  rw [←hprod] at hu
  have hlocal (j) : Nat.card (AdjoinRoot ((g j).map i))ˣ=
      (Nat.card (fixedField σ)^(g j).natDegree-1)*
        (if Odd (g j).natDegree then Nat.card (fixedField σ)^(g j).natDegree+1
         else Nat.card (fixedField σ)^(g j).natDegree-1) :=
    irreducible_base_unit_weight σ hσ hne (g j) (hgm j) (hgi j)
  simp_rw [hlocal] at hu
  rw [Finset.prod_mul_distrib] at hu
  rw [squarefree_quotient_units_card f hm hs]
  exact hu
end
