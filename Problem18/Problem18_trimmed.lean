    (f : (fixedField (starRingAut : K ≃+* K))[X]) (hm : f.Monic) (hs : Squarefree f)
    (D : ℕ) (hlo : ∀ j : FactorIndex f,D≤j.val.natDegree)
    (hhi : ∀ j : FactorIndex f,2*j.val.natDegree≤Module.finrank K V) :
    (Nat.card {T : SelfAdjointOperators (starRingAut : K ≃+* K) B //
      ¬IsCoprime (f.map (algebraMap (fixedField (starRingAut : K ≃+* K)) K)) T.val.charpoly} : ℝ)*
      (Nat.card (fixedField (starRingAut : K ≃+* K)) : ℝ)^(D/2) ≤
