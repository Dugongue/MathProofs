    · exact ih v hv'
theorem span_boxPoly_span {n d : ℕ} (X : Set (Fin (boxSize n d) → K)) :
    Ideal.span (boxPoly n d '' (Submodule.span K X : Set _)) = Ideal.span (boxPoly n d '' X) := by
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨w, hw, rfl⟩
    have h1 : boxLin n d w ∈ Submodule.span K (boxLin n d '' X) := by
      rw [← Submodule.map_span]
      exact Submodule.mem_map_of_mem hw
    have h2 : Submodule.span K (boxLin n d '' X) ≤
        (Ideal.span (boxPoly n d '' X)).restrictScalars K := by
      rw [Submodule.span_le]
      rintro _ ⟨x, hx, rfl⟩
      exact Ideal.subset_span ⟨x, hx, rfl⟩
    exact h2 h1
  · exact Ideal.span_mono (Set.image_mono Submodule.subset_span)
theorem compress_mem {N : ℕ} (rows : List (Vector K N)) (v : Vector K N)
