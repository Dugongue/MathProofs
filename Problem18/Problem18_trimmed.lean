  have h₂ : Slots F canonical q.WS Sn B ξ₂ := Slots.setVar F canonical h₁ (by decide) (by decide) gs
  have h₃ : Slots F canonical q.WS Sn B ξ₃ := Slots.setVar F canonical h₂ (by decide) (by decide) ds
