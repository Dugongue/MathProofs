end Unitary
def OrthogonalGood (F : Matrix (Fin c) (Fin b) K) : Prop :=
  (F.transpose*F).det ≠ 0 ∧ Squarefree (F.transpose*F).charpoly
theorem orthogonal_gram_covariance
    (F : Matrix (Fin c) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (Q : Matrix (Fin b) (Fin b) K)
    (hR : IsOrthogonal R) :
    (R*F*Q).transpose*(R*F*Q) = Q.transpose*(F.transpose*F)*Q := by
  calc
    _ = Q.transpose * (F.transpose * (R.transpose*R) * F) * Q := by
      simp only [Matrix.transpose_mul, Matrix.mul_assoc]
    _ = _ := by rw [show R.transpose*R=1 from hR]; simp
theorem orthogonal_gram_charpoly
    (F : Matrix (Fin c) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (Q : Matrix (Fin b) (Fin b) K)
    (hR : IsOrthogonal R) (hQ : IsOrthogonal Q) :
    ((R*F*Q).transpose*(R*F*Q)).charpoly = (F.transpose*F).charpoly := by
  rw [orthogonal_gram_covariance F R Q hR, Matrix.charpoly_mul_comm,
    ← Matrix.mul_assoc, show Q*Q.transpose=1 from mul_eq_one_comm.mp hQ,
    Matrix.one_mul]
theorem orthogonal_gram_det
    (F : Matrix (Fin c) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (Q : Matrix (Fin b) (Fin b) K)
    (hR : IsOrthogonal R) (hQ : IsOrthogonal Q) :
    ((R*F*Q).transpose*(R*F*Q)).det = (F.transpose*F).det := by
  rw [orthogonal_gram_covariance F R Q hR]
  calc
    _ = (Q.transpose*Q).det * (F.transpose*F).det := by
      simp only [Matrix.det_mul]; ring
    _ = _ := by rw [show Q.transpose*Q=1 from hQ, Matrix.det_one, one_mul]
theorem orthogonal_good_invariant (F G : Matrix (Fin c) (Fin b) K)
    (h : MatrixOrthogonalEquivalent F G) : OrthogonalGood F ↔ OrthogonalGood G := by
  obtain ⟨R,Q,hR,hQ,rfl⟩ := h
  simp only [OrthogonalGood, orthogonal_gram_charpoly F R Q hR hQ,
    orthogonal_gram_det F R Q hR hQ]
theorem orthogonal_boundary_recovery [Fintype K]
    (F G : Matrix (Fin c) (Fin b) K) :
    MatrixOrthogonalEquivalent F G ↔
      ∃ Q : Matrix (Fin b) (Fin b) K, IsOrthogonal Q ∧
        LinearMap.ker (Problem18MarkedRecovery20260929.augment (F*Q).toLin'
          (Mathproof.Problem18FinalFactor20260930.standardMarker c)) =
        LinearMap.ker (Problem18MarkedRecovery20260929.augment G.toLin'
          (Mathproof.Problem18FinalFactor20260930.standardMarker c)) ∧
        Q.transpose*(F.transpose*F)*Q = G.transpose*G := by
  constructor
  · rintro ⟨R,Q,hR,hQ,he⟩
    have hr := (Mathproof.Problem18FinalFactor20260930.final_orthogonal_factor_iff
      (F*Q) G).mp ⟨R,hR,by simpa only [Matrix.mul_assoc] using he⟩
    exact ⟨Q,hQ,hr.1,by simpa only [Matrix.transpose_mul, Matrix.mul_assoc] using hr.2⟩
  · rintro ⟨Q,hQ,hker,hgram⟩
    obtain ⟨R,hR,he⟩ :=
      (Mathproof.Problem18FinalFactor20260930.final_orthogonal_factor_iff (F*Q) G).mpr
        ⟨hker,by simpa only [Matrix.transpose_mul, Matrix.mul_assoc] using hgram⟩
    exact ⟨R,Q,hR,hQ,by simpa only [Matrix.mul_assoc] using he⟩
section UnitaryInvariant
variable [StarRing K]
def UnitaryGood (F : Matrix (Fin c) (Fin b) K) : Prop :=
  (Fᴴ*F).det ≠ 0 ∧ Squarefree (Fᴴ*F).charpoly
theorem unitary_gram_covariance
    (F : Matrix (Fin c) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (Q : Matrix (Fin b) (Fin b) K)
    (hR : Problem18Assembly.IsUnitary R) :
    (R*F*Q)ᴴ*(R*F*Q) = Qᴴ*(Fᴴ*F)*Q := by
  calc
    _ = Qᴴ * (Fᴴ * (Rᴴ*R) * F) * Q := by
      simp only [Matrix.conjTranspose_mul, Matrix.mul_assoc]
    _ = _ := by rw [show Rᴴ*R=1 from hR]; simp
theorem unitary_gram_charpoly
    (F : Matrix (Fin c) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (Q : Matrix (Fin b) (Fin b) K)
    (hR : Problem18Assembly.IsUnitary R) (hQ : Problem18Assembly.IsUnitary Q) :
    ((R*F*Q)ᴴ*(R*F*Q)).charpoly = (Fᴴ*F).charpoly := by
  rw [unitary_gram_covariance F R Q hR, Matrix.charpoly_mul_comm,
    ← Matrix.mul_assoc, show Q*Qᴴ=1 from mul_eq_one_comm.mp hQ, Matrix.one_mul]
theorem unitary_gram_det
    (F : Matrix (Fin c) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K) (Q : Matrix (Fin b) (Fin b) K)
    (hR : Problem18Assembly.IsUnitary R) (hQ : Problem18Assembly.IsUnitary Q) :
    ((R*F*Q)ᴴ*(R*F*Q)).det = (Fᴴ*F).det := by
  rw [unitary_gram_covariance F R Q hR]
  calc
    _ = (Qᴴ*Q).det * (Fᴴ*F).det := by simp only [Matrix.det_mul]; ring
    _ = _ := by rw [show Qᴴ*Q=1 from hQ, Matrix.det_one, one_mul]
theorem unitary_good_invariant (F G : Matrix (Fin c) (Fin b) K)
    (h : MatrixUnitaryEquivalent F G) : UnitaryGood F ↔ UnitaryGood G := by
  obtain ⟨R,Q,hR,hQ,rfl⟩ := h
  simp only [UnitaryGood, unitary_gram_charpoly F R Q hR hQ,
    unitary_gram_det F R Q hR hQ]
theorem unitary_boundary_recovery [Fintype K]
    {k : Type*} [Field k] [Fintype k] [Algebra k K]
    (hcard : Nat.card K = Nat.card k ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card k)
    (F G : Matrix (Fin c) (Fin b) K) :
    MatrixUnitaryEquivalent F G ↔
      ∃ Q : Matrix (Fin b) (Fin b) K, Problem18Assembly.IsUnitary Q ∧
        LinearMap.ker (F*Q).toLin' = LinearMap.ker G.toLin' ∧
        Qᴴ*(Fᴴ*F)*Q = Gᴴ*G := by
  constructor
  · rintro ⟨R,Q,hR,hQ,he⟩
    have hr := (Mathproof.Problem18UnitaryFinalFactor20260930.final_unitary_factor_iff
      hcard hstar (F*Q) G).mp ⟨R,hR,by simpa only [Matrix.mul_assoc] using he⟩
    exact ⟨Q,hQ,hr.1,by simpa only [Matrix.conjTranspose_mul, Matrix.mul_assoc] using hr.2⟩
  · rintro ⟨Q,hQ,hker,hgram⟩
    obtain ⟨R,hR,he⟩ :=
      (Mathproof.Problem18UnitaryFinalFactor20260930.final_unitary_factor_iff
        hcard hstar (F*Q) G).mpr
        ⟨hker,by simpa only [Matrix.conjTranspose_mul, Matrix.mul_assoc] using hgram⟩
    exact ⟨R,Q,hR,hQ,by simpa only [Matrix.mul_assoc] using he⟩
end UnitaryInvariant
