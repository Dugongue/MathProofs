variable {K : Type*} [Field K] [Fintype K]
noncomputable def grassmannEquiv {V W : Type*} [AddCommGroup V] [Module K V]
    [AddCommGroup W] [Module K W] (e : V ≃ₗ[K] W) (s : ℕ) :
    {U : Submodule K V // Module.finrank K U = s} ≃
      {U : Submodule K W // Module.finrank K U = s} :=
  Equiv.subtypeEquiv (Submodule.orderIsoMapComap e).toEquiv
    (fun U => by change _ ↔ Module.finrank K (U.map e.toLinearMap) = s
                 rw [e.finrank_map_eq])
theorem subspace_card_lower (n s : ℕ) (hs : s ≤ n) :
    (1/4 : ℝ)*(Fintype.card K : ℝ)^(s*(n-s)) ≤
      Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = s} := by
  classical
  let S := {W : Submodule K (Fin n → K) // Module.finrank K W = s}
  let B := {M : Matrix (Fin s) (Fin s) K // M.rank = s}
  let R := {M : Matrix (Fin s) (Fin n) K // M.rank = s}
  have he : Nat.card S * Nat.card B = Nat.card R := by
    dsimp only [S, B, R]
    rw [fullRowRank_card (Nat.le_refl s), fullRowRank_card hs]
    exact subspace_card_mul_bases hs
  have htotal (a b : ℕ) : Nat.card (Matrix (Fin a) (Fin b) K) =
      Fintype.card K^(a*b) := by
    simp [Matrix, Nat.card_eq_fintype_card, ← pow_mul, Nat.mul_comm]
  have hb : Nat.card B ≤ Fintype.card K^(s*s) := by
    rw [← htotal s s]
    exact Nat.card_le_card_of_injective Subtype.val Subtype.val_injective
  have hr : (1/4 : ℝ)*(Fintype.card K : ℝ)^(s*n) ≤ Nat.card R := by
    have h := fullRowRank_density_ge_quarter (K := K) (d := s) (n := n) hs
    rw [htotal s n, Nat.cast_pow] at h
    exact (le_div_iff₀ (by positivity)).mp h
  have her : (Nat.card S : ℝ)*Nat.card B = (Nat.card R : ℝ) := by exact_mod_cast he
  have hbr : (Nat.card B : ℝ) ≤ (Fintype.card K : ℝ)^(s*s) := by exact_mod_cast hb
  have hh : (1/4 : ℝ)*(Fintype.card K : ℝ)^(s*n) ≤
      (Nat.card S : ℝ)*(Fintype.card K : ℝ)^(s*s) :=
    hr.trans (her.symm.le.trans (mul_le_mul_of_nonneg_left hbr (by positivity)))
  have heq : s*n=s*(n-s)+s*s := by rw [← Nat.mul_add, Nat.sub_add_cancel hs]
  rw [heq, pow_add, ← mul_assoc] at hh
  exact (mul_le_mul_iff_left₀ (by positivity : (0 : ℝ)<(Fintype.card K : ℝ)^(s*s))).mp hh
theorem subspace_card_bounds {V : Type*} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] (s : ℕ) (hs : s ≤ Module.finrank K V) :
    (1/4 : ℝ)*(Fintype.card K : ℝ)^(s*(Module.finrank K V-s)) ≤
      Nat.card {W : Submodule K V // Module.finrank K W = s} ∧
    (Nat.card {W : Submodule K V // Module.finrank K W = s} : ℝ) ≤
      4*(Fintype.card K : ℝ)^(s*(Module.finrank K V-s)) := by
  have he := Nat.card_congr (grassmannEquiv (Module.finBasis K V).equivFun s)
  rw [he]
  exact ⟨subspace_card_lower _ s hs, subspace_card_bound _ s hs⟩
variable {E V : Type*} [Field E] [Algebra K E] [Fintype E]
  [FiniteDimensional K E] [AddCommGroup V] [Module K V] [Module E V]
  [IsScalarTower K E V] [FiniteDimensional E V] [FiniteDimensional K V]
def ExtensionStable (W : Submodule K V) : Prop := ∀ a : E, ∀ x ∈ W, a • x ∈ W
noncomputable def extendStable (W : Submodule K V) (h : ExtensionStable (E := E) W) :
    Submodule E V where
  carrier := W
  zero_mem' := W.zero_mem
  add_mem' := W.add_mem
  smul_mem' := h
theorem stable_finrank (W : Submodule K V) (h : ExtensionStable (E := E) W) :
    Module.finrank K W = Module.finrank K E * Module.finrank E (extendStable W h) := by
  have ht := Module.finrank_mul_finrank K E (extendStable W h)
  exact ht.symm
noncomputable def stableGrassmannEquiv (t : ℕ) :
    {W : Submodule K V // ExtensionStable (E := E) W ∧
      Module.finrank K W = Module.finrank K E*t} ≃
    {U : Submodule E V // Module.finrank E U = t} where
  toFun W := ⟨extendStable W.val W.property.1, by
    have h := stable_finrank W.val W.property.1
    exact Nat.eq_of_mul_eq_mul_left (Module.finrank_pos (R := K) (M := E))
      (h.symm.trans W.property.2)⟩
  invFun U := ⟨U.val.restrictScalars K, ⟨fun a x hx => U.val.smul_mem a hx, by
    have ht := Module.finrank_mul_finrank K E U.val
    rw [U.property] at ht
    exact ht.symm⟩⟩
  left_inv W := by apply Subtype.ext; ext x; rfl
  right_inv U := by apply Subtype.ext; ext x; rfl
theorem stable_subspace_fraction_le (t : ℕ) (ht : t ≤ Module.finrank E V) :
    (Nat.card {W : Submodule K V // ExtensionStable (E := E) W ∧
      Module.finrank K W = Module.finrank K E*t} : ℝ) /
      Nat.card {W : Submodule K V // Module.finrank K W = Module.finrank K E*t} ≤
    16 * ((Fintype.card K : ℝ)^
      (Module.finrank K E*(Module.finrank K E-1)*t*(Module.finrank E V-t)))⁻¹ := by
  let e := Module.finrank K E
  let d := Module.finrank E V
  let q : ℝ := Fintype.card K
  have he : 1 ≤ e := Module.finrank_pos (R := K) (M := E)
  have hn : Module.finrank K V = e*d := (Module.finrank_mul_finrank K E V).symm
  have hs : e*t ≤ Module.finrank K V := by rw [hn]; exact Nat.mul_le_mul_left e ht
  have hlow := (subspace_card_bounds (K := K) (V := V) (e*t) hs).1
  have hup := (subspace_card_bounds (K := E) (V := V) t ht).2
  rw [← Nat.card_congr (stableGrassmannEquiv (K := K) (E := E) (V := V) t)] at hup
  have hQ : (Fintype.card E : ℝ)=q^e := by
    dsimp [q, e]
    exact_mod_cast Module.card_eq_pow_finrank (K := K) (V := E)
  rw [hQ, ← pow_mul] at hup
  rw [hn, ← Nat.mul_sub_left_distrib] at hlow
  have hq : 0 < q := by dsimp [q]; positivity
  have hden : (0 : ℝ) < Nat.card {W : Submodule K V // Module.finrank K W = e*t} :=
    lt_of_lt_of_le (by positivity) hlow
  calc
    _ ≤ (4*q^(e*(t*(d-t)))) / ((1/4 : ℝ)*q^((e*t)*(e*(d-t)))) :=
      div_le_div₀ (by positivity) hup (by positivity) hlow
    _ = _ := by
      have hexp : (e*t)*(e*(d-t)) = e*(t*(d-t)) + e*(e-1)*t*(d-t) := by
        have hsub : e-1+1=e := Nat.sub_add_cancel he
        calc
          _ = e*e*t*(d-t) := by ring
          _ = e*((e-1)+1)*t*(d-t) := by rw [hsub]
          _ = _ := by ring
      rw [hexp, pow_add]
      field_simp
      ring
end Mathproof.Problem18ExtensionSubspaceFraction20260930
