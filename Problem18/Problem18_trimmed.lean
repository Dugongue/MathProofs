variable {K : Type*} [Field K] [Fintype K]
theorem codim_comap_le {V W : Type*} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] [AddCommGroup W] [Module K W]
    [FiniteDimensional K W] (f : V →ₗ[K] W) (E : Submodule K W) :
    Module.finrank K V - Module.finrank K (E.comap f) ≤
      Module.finrank K W - Module.finrank K E := by
  have hr := (E.mkQ.comp f).finrank_range_add_finrank_ker
  have hb := (LinearMap.range (E.mkQ.comp f)).finrank_le
  have he := E.finrank_quotient_add_finrank
  have hk : LinearMap.ker (E.mkQ.comp f) = E.comap f := by
    ext x
    simp
  rw [hk] at hr
  omega
theorem radical_intersection_codim_le {V W : Type*} [AddCommGroup V] [Module K V]
    [FiniteDimensional K V] [AddCommGroup W] [Module K W]
