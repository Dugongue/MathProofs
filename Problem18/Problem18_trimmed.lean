variable {K V : Type*} [Field K] [Fintype K]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
def ModelFits {n : ℕ} (B : LinearMap.BilinForm K V) (c : FormClass K n) : Prop :=
  ∃ e : (Fin n → K) ≃ₗ[K] V,∀ x y,B (e x) (e y)=(representative K c).val x y
theorem modelFits_unique {n : ℕ} (B : LinearMap.BilinForm K V)
    {c d : FormClass K n} (hc : ModelFits B c) (hd : ModelFits B d) : c=d := by
  obtain ⟨e,he⟩ := hc
  obtain ⟨f,hf⟩ := hd
  apply (representative_isometric_iff K c d).mp
  refine ⟨e.trans f.symm,?_⟩
  intro x y
  rw [←hf]
  change B (f (f.symm (e x))) (f (f.symm (e y)))=(representative K c).val x y
  rw [f.apply_symm_apply,f.apply_symm_apply,he]
def ClassifiedEvent (B : LinearMap.BilinForm K V) (p : K[X])
    (cd : FormClass K p.natDegree × FormClass K (Module.finrank K V-p.natDegree))
    (S : SelfAdjointOperators (RingEquiv.refl K) B) : Prop :=
  p∣S.val.charpoly ∧ IsCoprime p (S.val.charpoly/p) ∧
    ModelFits (B.restrict (LinearMap.ker (aeval S.val p))) cd.1 ∧
    ModelFits (B.restrict (LinearMap.ker (aeval S.val (S.val.charpoly/p)))) cd.2
theorem event_classes_unique (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (hnB : B.Nondegenerate) (p : K[X]) (hm : p.Monic)
    (S : SelfAdjointOperators (RingEquiv.refl K) B)
    (hdvd : p∣S.val.charpoly) (hc : IsCoprime p (S.val.charpoly/p)) :
    ∃! cd : FormClass K p.natDegree × FormClass K (Module.finrank K V-p.natDegree),
      ClassifiedEvent B p cd S := by
  let q := S.val.charpoly/p
  have hχ : S.val.charpoly=p*q := (EuclideanDomain.mul_div_cancel' hm.ne_zero hdvd).symm
  have hq : q.Monic := hm.of_mul_monic_left (hχ ▸ S.val.charpoly_monic)
  let U := LinearMap.ker (aeval S.val p)
  let Z := LinearMap.ker (aeval S.val q)
  obtain ⟨e,_,_,hχU,hχZ,hnU,hnZ⟩ :=
    Mathproof.Problem18IntrinsicPrimarySplit20261001.exists_intrinsic_primary_coordinates
      B hB hnB S.val S.property p q hm hq hc hχ
  have hdu : Module.finrank K U=p.natDegree := by
    simpa only [LinearMap.charpoly_natDegree] using congrArg Polynomial.natDegree hχU
  have hdz : Module.finrank K Z=Module.finrank K V-p.natDegree := by
    have hh : Module.finrank K U+Module.finrank K Z=Module.finrank K V := by
      simpa only [Module.finrank_prod] using e.finrank_eq
    rw [hdu] at hh
    omega
  have hu : ∃ c : FormClass K p.natDegree,ModelFits (B.restrict U) c := by
    have hu0 : ∃ c : FormClass K (Module.finrank K U),ModelFits (B.restrict U) c :=
      exists_model_coordinates (B.restrict U) (hB.restrict U) hnU
    rw [hdu] at hu0
    exact hu0
  have hz : ∃ c : FormClass K (Module.finrank K V-p.natDegree),ModelFits (B.restrict Z) c := by
    have hz0 : ∃ c : FormClass K (Module.finrank K Z),ModelFits (B.restrict Z) c :=
      exists_model_coordinates (B.restrict Z) (hB.restrict Z) hnZ
    rw [hdz] at hz0
    exact hz0
  obtain ⟨c,hcU⟩ := hu
  obtain ⟨d,hdZ⟩ := hz
  refine ⟨(c,d),⟨hdvd,hc,hcU,hdZ⟩,?_⟩
  intro cd hcd
  exact Prod.ext (modelFits_unique (B.restrict U) hcd.2.2.1 hcU)
    (modelFits_unique (B.restrict Z) hcd.2.2.2 hdZ)
local instance (n : ℕ) : Fintype (FormClass K n) := Fintype.ofFinite _
theorem intrinsic_event_card_sum (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (hnB : B.Nondegenerate) (p : K[X]) (hm : p.Monic) :
    Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) B //
      p∣S.val.charpoly ∧ IsCoprime p (S.val.charpoly/p)}=
      ∑ cd : FormClass K p.natDegree × FormClass K (Module.finrank K V-p.natDegree),
        Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) B // ClassifiedEvent B p cd S} := by
  letI : Finite V := Finite.of_injective (Module.finBasis K V).equivFun (Module.finBasis K V).equivFun.injective
  letI : Finite (Module.End K V) := Finite.of_injective (fun T : Module.End K V=>(T:V→V)) DFunLike.coe_injective
  let X := (cd : FormClass K p.natDegree × FormClass K (Module.finrank K V-p.natDegree)) ×
    {S : SelfAdjointOperators (RingEquiv.refl K) B // ClassifiedEvent B p cd S}
  let Y := {S : SelfAdjointOperators (RingEquiv.refl K) B //
    p∣S.val.charpoly ∧ IsCoprime p (S.val.charpoly/p)}
  let f : X→Y := fun z=>⟨z.2.val,z.2.property.1,z.2.property.2.1⟩
  have hf : Function.Bijective f := by
    constructor
    · rintro ⟨cd,S⟩ ⟨ce,T⟩ he
      have hST : S.val=T.val := congrArg Subtype.val he
      have hcd : cd=ce := by
        have hu := event_classes_unique B hB hnB p hm S.val S.property.1 S.property.2.1
        exact hu.unique S.property (hST.symm ▸ T.property)
      subst ce
      exact congrArg (Sigma.mk cd) (Subtype.ext hST)
    · intro S
      obtain ⟨cd,hcd,_⟩ := event_classes_unique B hB hnB p hm S.val S.property.1 S.property.2
      exact ⟨⟨cd,⟨S.val,hcd⟩⟩,rfl⟩
  have he := Nat.card_congr (Equiv.ofBijective f hf)
  rw [show Nat.card X=∑ cd : FormClass K p.natDegree × FormClass K (Module.finrank K V-p.natDegree),
    Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) B // ClassifiedEvent B p cd S} by
      exact Nat.card_sigma] at he
  exact he.symm
end
end Mathproof.Problem18OrdinaryIntrinsicPartition20261001
