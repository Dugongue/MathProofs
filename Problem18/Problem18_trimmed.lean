    (hsym : ∀ x y,B y x=eps*τ (B x y)) (W : Submodule K (Fin n → K))
    (E : (Fin (k+z) → K) →ₗ[K] (Fin n → K)) (hE : Function.Injective E)
    (hw : ∀ i : Fin (k+z),i.val<k → E (Pi.single i 1)∈W)
    (hz : ∀ j : Fin (k+z),∀ w∈W,B w (E (Pi.single j 1))=0) :
