theorem augment_kernel_coordinates (C : M→ₗ[K] V) (L : V→ₗ[K] M)
    (hL : ∀ x,L (C x)=x) (e : V) (x : M×K) :
    x∈LinearMap.ker (augment C e) ↔
      x.1=-(x.2 • L e) ∧ x.2 • (e-C (L e))=0 := by
  constructor
  · intro hx
    have hh := congrArg L (LinearMap.mem_ker.mp hx)
    change L (C x.1+x.2 • e)=L 0 at hh
    simp only [map_add,map_smul,map_zero,hL] at hh
    have hc : x.1=-(x.2 • L e) := eq_neg_of_add_eq_zero_left hh
    refine ⟨hc,?_⟩
    have hh := LinearMap.mem_ker.mp hx
    change C x.1+x.2 • e=0 at hh
    simpa only [hc,map_neg,map_smul,smul_sub,sub_eq_add_neg,smul_add,smul_neg,add_comm] using hh
  · rintro ⟨hc,hr⟩
    change C x.1+x.2 • e=0
    simpa only [hc,map_neg,map_smul,smul_sub,sub_eq_add_neg,smul_add,smul_neg,add_comm] using hr
theorem augment_kernel_trivial (C : M→ₗ[K] V) (L : V→ₗ[K] M)
    (hL : ∀ x,L (C x)=x) (e : V) (hr : e-C (L e)≠0) (x : M×K) :
    x∈LinearMap.ker (augment C e) ↔ x=0 := by
  rw [augment_kernel_coordinates C L hL]
  constructor
  · rintro ⟨hc,hh⟩
    have ht : x.2=0 := (smul_eq_zero.mp hh).resolve_right hr
    apply Prod.ext
    · change x.1=0
      simpa only [ht,zero_smul,neg_zero] using hc
    · exact ht
  · rintro rfl
    simp
theorem augment_kernel_eq_iff (C D : M→ₗ[K] V) (L R : V→ₗ[K] M)
    (hL : ∀ x,L (C x)=x) (hR : ∀ x,R (D x)=x) (e : V) :
    LinearMap.ker (augment C e)=LinearMap.ker (augment D e) ↔
      ((e-C (L e)=0) ↔ (e-D (R e)=0)) ∧
      (e-C (L e)=0 → L e=R e) := by
  have hC : (-L e,1)∈LinearMap.ker (augment C e) ↔ e-C (L e)=0 := by
    rw [augment_kernel_coordinates C L hL]
    simp
  have hD : (-R e,1)∈LinearMap.ker (augment D e) ↔ e-D (R e)=0 := by
    rw [augment_kernel_coordinates D R hR]
    simp
  constructor
  · intro hk
    have hf (hc : e-C (L e)=0) : e-D (R e)=0 ∧ L e=R e := by
      have hm := hC.mpr hc
      rw [hk,augment_kernel_coordinates D R hR] at hm
      simpa only [one_smul,neg_inj] using And.intro hm.2 hm.1
    refine ⟨⟨fun h => (hf h).1,?_⟩,fun h => (hf h).2⟩
    intro hd
    have hm := hD.mpr hd
    rw [← hk,augment_kernel_coordinates C L hL] at hm
    simpa only [one_smul] using hm.2
  · rintro ⟨hr,hu⟩
    ext x
    by_cases hc : e-C (L e)=0
    · rw [augment_kernel_coordinates C L hL,augment_kernel_coordinates D R hR,
        hc,hr.mp hc,hu hc]
    · rw [augment_kernel_trivial C L hL e hc,
        augment_kernel_trivial D R hR e (mt hr.mpr hc)]
section Matrix
variable {b c : ℕ}
def gramLeftInverse (C : Matrix (Fin c) (Fin b) K) :
    (Fin c→K)→ₗ[K](Fin b→K) := ((C.transpose*C)⁻¹*C.transpose).toLin'
theorem gramLeftInverse_apply (C : Matrix (Fin c) (Fin b) K)
    (hC : (C.transpose*C).det≠0) (x : Fin b→K) :
    gramLeftInverse C (C.toLin' x)=x := by
  change ((C.transpose*C)⁻¹*C.transpose)*ᵥ(C*ᵥx)=x
  rw [Matrix.mulVec_mulVec,Matrix.mul_assoc,
    Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hC),Matrix.one_mulVec]
theorem matrix_augment_kernel_eq_iff (C D : Matrix (Fin c) (Fin b) K)
    (hC : (C.transpose*C).det≠0) (hD : (D.transpose*D).det≠0) (e : Fin c→K) :
    LinearMap.ker (augment C.toLin' e)=LinearMap.ker (augment D.toLin' e) ↔
      ((e-C*ᵥgramLeftInverse C e=0) ↔ (e-D*ᵥgramLeftInverse D e=0)) ∧
      (e-C*ᵥgramLeftInverse C e=0 → gramLeftInverse C e=gramLeftInverse D e) :=
  augment_kernel_eq_iff C.toLin' D.toLin' (gramLeftInverse C) (gramLeftInverse D)
    (gramLeftInverse_apply C hC) (gramLeftInverse_apply D hD) e
end Matrix
