          Mathproof.Problem18IMPSourceDispatch20261001.routeWords cutoff 0 a' b' c' ++
          (List.finRange F'.e).map (fun i => (F'.modulus i).val) ++
          tensorCoordinates F' A' := heq
      rw [hw]
