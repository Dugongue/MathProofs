open Problem18HermitianRankOne20260929
variable {F K V : Type*} [Field F] [Fintype F] [Field K] [Fintype K]
  [Algebra F K] [StarRing K]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
theorem hermitian_witt_extension
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (B : V →ₛₗ[starRingEnd K] V →ₗ[K] K)
    (hB : B.IsSymm) (hsep : B.SeparatingLeft)
    (U : Submodule K V) (f : U →ₗ[K] V) (hf : Function.Injective f)
    (hiso : ∀ u v : U, B (f u) (f v) = B u.val v.val) :
    ∃ Q : V ≃ₗ[K] V, (∀ x y, B (Q x) (Q y) = B x y) ∧
      ∀ u : U, Q u.val = f u := by
  classical
  suffices h : ∀ n (U : Submodule K V) (f : U →ₗ[K] V),
      Function.Injective f →
      (∀ u v : U, B (f u) (f v) = B u.val v.val) →
      Module.finrank K U = n →
      ∃ Q : V ≃ₗ[K] V, (∀ x y, B (Q x) (Q y) = B x y) ∧
        ∀ u : U, Q u.val = f u from h _ U f hf hiso rfl
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
    intro U f hf hiso hn
    by_cases hU : U = ⊥
    · refine ⟨LinearEquiv.refl K V, ?_, ?_⟩
      · intro x y
        rfl
      · intro u
        have huval : u.val = 0 := by
          have huBot : u.val ∈ (⊥ : Submodule K V) := hU ▸ u.property
          simpa only [Submodule.mem_bot] using huBot
        have hu0 : u = 0 := Subtype.ext huval
        simpa [hu0]
    · obtain ⟨uv, huv, huv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hU
      let u : U := ⟨uv, huv⟩
      have hu0 : u ≠ 0 := by
        intro hu
        apply huv0
        exact congrArg Subtype.val hu
      have hu_bot : u ∉ (⊥ : Submodule K U) := by
        simpa only [Submodule.mem_bot] using hu0
      obtain ⟨l, -, hlu⟩ :=
        (0 : (⊥ : Submodule K U) →ₗ[K] K).exists_extend_of_notMem hu_bot 1
      let H₀ : Submodule K U := LinearMap.ker l
      let H : Submodule K V := H₀.map U.subtype
      have hHU : H ≤ U := by
        intro x hx
        obtain ⟨w, -, rfl⟩ := hx
        exact w.property
      have huH : u.val ∉ H := by
        intro humem
        obtain ⟨w, hwH₀, hwu⟩ := humem
        have hwu' : w = u := by
          apply Subtype.ext
          exact hwu
        have hw0 : l w = 0 := hwH₀
        rw [hwu', hlu] at hw0
        exact one_ne_zero hw0
      have hHltU : H < U := by
        have hne : H ≠ U := by
          intro hEq
          apply huH
          rw [hEq]
          exact u.property
        exact lt_of_le_of_ne hHU hne
      have hdim : Module.finrank K H < n := by
        rw [← hn]
        exact Submodule.finrank_lt_finrank_of_lt hHltU
      let fH : H →ₗ[K] V := f.comp (Submodule.inclusion hHU)
      have hfH : Function.Injective fH :=
        hf.comp (Submodule.inclusion_injective hHU)
      have hisoH : ∀ x y : H, B (fH x) (fH y) = B x.val y.val := by
        intro x y
        exact hiso (Submodule.inclusion hHU x) (Submodule.inclusion hHU y)
      obtain ⟨Q₀, hQ₀, hQ₀H⟩ := ih _ hdim H fH hfH hisoH rfl
      let S : Submodule K V := LinearMap.range fH
      let a : V := Q₀ u.val
      let b : V := f u
      have hnorm : B a a = B b b := by
        rw [show B a a = B u.val u.val by exact hQ₀ u.val u.val]
        exact (hiso u u).symm
      have hpair : ∀ s : S, B a s.val = B b s.val := by
        intro s
        obtain ⟨x, hx⟩ := s.property
        have hsQ : s.val = Q₀ x.val := by
          rw [← hx]
          exact (hQ₀H x).symm
        have hsf : s.val = f (Submodule.inclusion hHU x) := by
          rw [← hx]
          rfl
        calc
          B a s.val = B (Q₀ u.val) (Q₀ x.val) := by rw [hsQ]
          _ = B u.val x.val := hQ₀ u.val x.val
          _ = B (f u) (f (Submodule.inclusion hHU x)) :=
            (hiso u (Submodule.inclusion hHU x)).symm
          _ = B b s.val := by rw [hsf]
      have haS : a ∉ S := by
        intro ha
        obtain ⟨x, hx⟩ := ha
        have hqx : Q₀ u.val = Q₀ x.val := by
          change a = Q₀ x.val
          exact hx.symm.trans (hQ₀H x).symm
        have hux : u.val = x.val := Q₀.injective hqx
        exact huH (hux ▸ x.property)
      have hbS : b ∉ S := by
        intro hb
        obtain ⟨x, hx⟩ := hb
        have hfx : f u = f (Submodule.inclusion hHU x) := by
          change b = f (Submodule.inclusion hHU x)
          exact hx.symm.trans rfl
        have hux : u = Submodule.inclusion hHU x := hf hfx
        exact huH (congrArg Subtype.val hux ▸ x.property)
      obtain ⟨Q₁, hQ₁, hQ₁a, hQ₁S⟩ :=
        exists_isometry_sending_fixing_subspace
          hcard hstar B hB hsep S hnorm hpair haS hbS
      let Q : V ≃ₗ[K] V := Q₀.trans Q₁
      refine ⟨Q, ?_, ?_⟩
      · intro x y
        exact (hQ₁ (Q₀ x) (Q₀ y)).trans (hQ₀ x y)
      · intro w
        let w₀ : U := w - (l w) • u
        have hw₀ker : w₀ ∈ H₀ := by
          change l w₀ = 0
          simp [w₀, hlu]
        have hw₀H : w₀.val ∈ H := by
          exact ⟨w₀, hw₀ker, rfl⟩
        let x : H := ⟨w₀.val, hw₀H⟩
        have hwdecomp : w.val = x.val + (l w) • u.val := by
          simp [x, w₀]
        have hwU : w = (Submodule.inclusion hHU x) + (l w) • u := by
          apply Subtype.ext
          exact hwdecomp
        have hfx : f w = fH x + (l w) • f u := by
          calc
            f w = f ((Submodule.inclusion hHU x) + (l w) • u) :=
              congrArg f hwU
            _ = fH x + (l w) • f u := by
              rw [map_add, map_smul]
              rfl
        change Q₁ (Q₀ w.val) = f w
        rw [hwdecomp, map_add, map_smul, hQ₀H x]
        rw [map_add, map_smul]
        rw [show Q₀ u.val = a by rfl, hQ₁a]
        have hmem : fH x ∈ S := LinearMap.mem_range_self fH x
        rw [hQ₁S ⟨fH x, hmem⟩]
        simpa only [b] using hfx.symm
theorem hermitian_recovery_iff
    {X : Type*} [AddCommGroup X] [Module K X]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (B : V →ₛₗ[starRingEnd K] V →ₗ[K] K)
    (hB : B.IsSymm) (hsep : B.SeparatingLeft)
    (C D : X →ₗ[K] V) :
    (∃ Q : V ≃ₗ[K] V,
      (∀ x, Q (C x) = D x) ∧ (∀ v w, B (Q v) (Q w) = B v w)) ↔
      LinearMap.ker C = LinearMap.ker D ∧
        ∀ x y, B (C x) (C y) = B (D x) (D y) := by
  constructor
  · rintro ⟨Q, hQ, hpres⟩
    constructor
    · ext x
      simp only [LinearMap.mem_ker]
      rw [← hQ x]
      exact Q.map_eq_zero_iff.symm
    · intro x y
      rw [← hQ x, ← hQ y, hpres]
  · rintro ⟨hker, hgram⟩
    obtain ⟨e, he, hiso⟩ :=
      Problem18GeneralPairingRecovery20260929.exists_range_equiv_preserving_pairing
        C D (fun v w => B v w) hker hgram
    let f := D.range.subtype.comp e.toLinearMap
    have hf : Function.Injective f := Subtype.val_injective.comp e.injective
    obtain ⟨Q, hQ, hext⟩ :=
      hermitian_witt_extension hcard hstar B hB hsep C.range f hf
        (fun u v => (hiso u v).symm)
    refine ⟨Q, ?_, hQ⟩
    intro x
    have hx := hext ⟨C x, LinearMap.mem_range_self C x⟩
    simpa only [f, LinearMap.comp_apply, LinearEquiv.coe_coe, he x,
      Submodule.subtype_apply] using hx
end Problem18HermitianFullWitt20260930
