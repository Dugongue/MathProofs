theorem zeroSlots (F : FieldPresentation K) {B : Nat} {WS : String}
    (sigma : Env) (hv : ValidMemory F B sigma)
    (hmodfit : sigma.vars canonical.modBase+F.e+1≤
      (sigma.arrs canonical.mem).length)
    (hws : WS∉regNames canonical)
    (hwsB : sigma.vars WS≤(sigma.arrs canonical.mem).length)
    (hapart : sigma.vars canonical.modBase+F.e+1≤ sigma.vars WS)
    (hscratch : 16*(F.e+1)≤(sigma.arrs canonical.scratch).length)
    (hexp : sigma.vars canonical.exp<B) :
    Slots F canonical WS 0 B sigma := by
  have hbase : Base F canonical B sigma := {
    names:=canonical_valid
    degree:=hv.degree
    prime:=hv.prime
    arithmetic_word:=hv.arithmetic_word
    inverse_word:=hv.inverse_word
    memory_word:=hv.memory_word
    scratch_word:=hv.scratch_word
    scratch_fit:=hscratch
    modulus_fit:=hmodfit
    modulus_value:=by
      intro i
      simpa only [Problem18IMPFieldMultiplication20261001.sourceCoeff] using
        hv.modulus_value i
    exp_word:=hexp
    priv:=by decide }
  refine ⟨hbase,hws,?_,Or.inl hapart,?_,?_⟩
  · simpa using hwsB
  · intro s hs
    omega
  · have he:=hv.degree_word
    omega
