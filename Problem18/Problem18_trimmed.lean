variable {K : Type} [Field K] [DecidableEq K] [Fintype K]
def value (n : Nat) : (l d : Nat) → List (DenseInput n d K) → Bool
  | 0,_,_ => false
  | l+1,d,rows => if (fixedTest n d rows).1 then true else value n l (collDeg n d) (child n d rows).1
theorem correct_of_point (L : Type) [Field L] [Algebra K L] [IsAlgClosed L] [Algebra.IsAlgebraic K L]
    (n : Nat) (T : Nat → Nat) (hpt : PointExistence (K := K) L n T) :
    ∀ (l d : Nat) (rows : List (DenseInput n d K)) fs, Represents rows fs →
      levelThresholdT n T l d < Fintype.card K → geomDim L fs+1 ≤ (l : WithBot ℕ∞) →
      (value n l d rows=true ↔ ∃ x : Fin n → K,∀ f∈fs,eval x f=0) := by
  intro l
  induction l with
  | zero =>
    intro d rows fs hrep hq hdim
    simp only [value,Bool.false_eq_true,false_iff,not_exists]
    exact fun x=>no_rational_of_dim_bot L fs (by simpa using hdim) x
  | succ l ih =>
    intro d rows fs hrep hq hdim
    have hqd : T d<Fintype.card K := (Nat.le_max_left _ _).trans_lt hq
    have hqc : levelThresholdT n T l (collDeg n d)<Fintype.card K := (Nat.le_max_right _ _).trans_lt hq
    let G:=backend L n T hpt
    cases hf : (fixedTest n d rows).1 with
    | true =>
      simp only [value,hf,if_true,true_iff]
      exact G.pointExistence d rows fs hrep hqd ((G.fixedTest_correct d rows fs hrep).mp hf)
    | false =>
      simp only [value,hf,Bool.false_eq_true,if_false]
      have hno : ¬HasFixedComponent L fs := fun h => by
        have hh: (fixedTest n d rows).1=true:=(G.fixedTest_correct d rows fs hrep).mpr h
        rw [hf] at hh; contradiction
      obtain ⟨gs,hgs,hiff,hdim'⟩:=G.child_spec d rows fs hrep hno
      have hd : geomDim L gs+1≤(l:WithBot ℕ∞):=hdim'.trans (le_of_add_one_le_succ hdim)
      rw [ih (collDeg n d) (child n d rows).1 gs hgs hqc hd]
      exact exists_congr fun x=>(hiff x).symm
end
