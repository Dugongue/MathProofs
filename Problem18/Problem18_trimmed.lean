theorem exists_isometry_sending_fixing_subspace
    {F : Type*} [Field F] [Fintype F] [Fintype K] [Algebra F K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F)
    (B : V →ₛₗ[starRingEnd K] V →ₗ[K] K)
    (hB : B.IsSymm) (hsep : B.SeparatingLeft)
    (H : Submodule K V) {a b : V}
    (hnorm : B a a = B b b)
    (hpair : ∀ h : H, B a h.val = B b h.val)
