    (hv : validSize K u q) (A B : RectTensor a b c K) (h : equivalent u q A B) :
    rawCheck u q A=rawCheck u q B := by
  apply Bool.eq_iff_iff.mpr
  rw [rawCheck_correct,rawCheck_correct]
  exact rawGood_invariant u q hv A B h
