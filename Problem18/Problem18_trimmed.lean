namespace Mathproof.Problem18IMPBoundaryInstall20261002
open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Problem18IMPBoundarySizeExpressions20261002 Problem18IMPAssignments20261002
abbrev Entry := String×SizeExpr
def commands (dn en : String) (xs : List Entry) : List (String×Expr) :=
  xs.map (fun p=>(p.1,expression dn en p.2))
def program (dn en : String) (xs : List Entry) : Com :=
  Problem18IMPAssignments20261002.program (commands dn en xs)
def configured (xs : List Entry) (n e : Nat) (σ : Env) : Env :=
  xs.foldl (fun τ p=>τ.setVar p.1 (value p.2 n e)) σ
theorem install_run (dn en : String) (xs : List Entry) {B n e : Nat} {σ : Env}
    (hn : σ.vars dn=n) (he : σ.vars en=e)
    (hfresh : ∀p∈xs,p.1≠dn ∧ p.1≠en)
    (hword : ∀p∈xs,majorant p.2 n e<B) :
    Run B (program dn en xs) σ (configured xs n e σ) (cost (commands dn en xs)) ∧
      (∀x,x∉xs.map Prod.fst → (configured xs n e σ).vars x=σ.vars x) ∧
      (configured xs n e σ).arrs=σ.arrs ∧ (configured xs n e σ).inp=σ.inp ∧
      (configured xs n e σ).out=σ.out := by
  let v : Expr→Nat := fun z=>(z.eval σ).getD 0
  have hv : ∀p∈xs,v (expression dn en p.2)=value p.2 n e := by
    intro p hp
    have hh:=Expr.eval_of_evalB (expression_eval p.2 dn en hn he (hword p hp))
    simp only [v,hh,Option.getD_some]
  have hev : ∀p∈commands dn en xs,p.2.evalB B σ=some (v p.2) := by
    intro p hp
    obtain ⟨a,ha,rfl⟩:=List.mem_map.mp hp
    rw [hv a ha]
    exact expression_eval a.2 dn en hn he (hword a ha)
  have hfree : Independent (commands dn en xs) := by
    intro p hp z hz
    obtain ⟨a,ha,rfl⟩:=List.mem_map.mp hp
    obtain ⟨b,hb,rfl⟩:=List.mem_map.mp hz
    exact expression_noVar b.2 dn en a.1 (hfresh a ha).1.symm (hfresh a ha).2.symm
  have hstate : ∀ys : List Entry,(∀p∈ys,v (expression dn en p.2)=value p.2 n e) →
      ∀τ,applyValues (commands dn en ys) v τ=configured ys n e τ := by
    intro ys
    induction ys with
    | nil=>intro _ τ;rfl
    | cons p ps ih=>
      intro hy τ
      simp only [commands,List.map_cons,applyValues_cons,configured,List.foldl_cons]
      rw [hy p (by simp)]
      exact ih (fun z hz=>hy z (by simp [hz])) _
  have hs:=hstate xs hv σ
  refine ⟨?_,?_,?_,?_,?_⟩
  · rw [←hs]
    exact run_assignments (commands dn en xs) v σ hev hfree
  · intro x hx
    rw [←hs]
    exact applyValues_vars _ v σ x (by simpa [commands,List.map_map,Function.comp_def] using hx)
  · rw [←hs,applyValues_arrs]
  · rw [←hs,applyValues_inp]
  · rw [←hs,applyValues_out]
end Mathproof.Problem18IMPBoundaryInstall20261002
end
