  haveI : Nontrivial (Eb ⊗[E] F) :=
    Algebra.TensorProduct.nontrivial_of_algebraMap_injective_of_flat_right E Eb F
      (algebraMap E Eb).injective
  have hR : ∀ z : Eb ⊗[E] F, IsNilpotent z ∨ IsUnit z := isNilpotent_or_isUnit hE
  haveI hmax : (nilradical (Eb ⊗[E] F)).IsMaximal := nilradical_isMaximal_of_forall hR
  letI : Field ((Eb ⊗[E] F) ⧸ nilradical (Eb ⊗[E] F)) := Ideal.Quotient.field _
  have hker : RingHom.ker (Algebra.TensorProduct.map (AlgHom.id Eb Ω)
      (Ideal.Quotient.mkₐ Eb (nilradical (Eb ⊗[E] F)))) = (nilradical (Eb ⊗[E] F)).map
      (Algebra.TensorProduct.includeRight : Eb ⊗[E] F →ₐ[Eb] Ω ⊗[Eb] (Eb ⊗[E] F)) := by
    rw [Algebra.TensorProduct.lTensor_ker _ (Ideal.Quotient.mkₐ_surjective Eb _)]
    congr 1
    ext x
    rw [RingHom.mem_ker, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem]
  haveI : IsDomain (Ω ⊗[Eb] ((Eb ⊗[E] F) ⧸ nilradical (Eb ⊗[E] F))) := isDomain_tensor (k := Eb)
  have hprime : (RingHom.ker (Algebra.TensorProduct.map (AlgHom.id Eb Ω)
      (Ideal.Quotient.mkₐ Eb (nilradical (Eb ⊗[E] F))))).IsPrime := RingHom.ker_isPrime _
  have hnil : RingHom.ker (Algebra.TensorProduct.map (AlgHom.id Eb Ω)
      (Ideal.Quotient.mkₐ Eb (nilradical (Eb ⊗[E] F)))) =
      nilradical (Ω ⊗[Eb] (Eb ⊗[E] F)) := by
    refine le_antisymm ?_ (nilradical_le_prime _)
