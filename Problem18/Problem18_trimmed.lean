noncomputable def fiberEquivKer (f : G →+ H) (x : G) :
    {g : G // f g=f x} ≃ f.ker where
  toFun g := ⟨g.val-x,by simp [map_sub,g.property]⟩
  invFun g := ⟨g.val+x,by have hg : f g.val=0 := g.property; simp [map_add,hg]⟩
  left_inv g := by apply Subtype.ext; simp
  right_inv g := by apply Subtype.ext; simp
theorem surjective_fiber_card_mul (f : G →+ H) (hf : Function.Surjective f) (y : H) :
    Nat.card {g : G // f g=y} * Nat.card H=Nat.card G := by
  classical
  letI : Fintype H := Fintype.ofFinite H
  have hc (z : H) : Nat.card {g : G // f g=z}=Nat.card f.ker := by
    obtain ⟨x,rfl⟩ := hf z
    exact Nat.card_congr (fiberEquivKer f x)
  have hs := Nat.card_congr (Equiv.sigmaFiberEquiv f)
  rw [Nat.card_sigma] at hs
  simp_rw [hc] at hs
  rw [hc]
  simpa only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,Nat.cast_id,
    Nat.card_eq_fintype_card,mul_comm] using hs
theorem surjective_preimage_card_mul (f : G →+ H) (hf : Function.Surjective f)
    (p : H → Prop) :
    Nat.card {g : G // p (f g)} * Nat.card H=Nat.card {y : H // p y}*Nat.card G := by
  classical
  letI : Fintype H := Fintype.ofFinite H
  let e : (Σ y : {y : H // p y}, {g : G // f g=y.val}) ≃ {g : G // p (f g)} :=
    Equiv.sigmaSubtypeFiberEquivSubtype f (fun _ => Iff.rfl)
  have he := Nat.card_congr e
  rw [Nat.card_sigma] at he
  rw [← he,Finset.sum_mul]
  simp_rw [surjective_fiber_card_mul f hf]
  simp
