def IsUnitary {n : Type*} [Fintype n] [DecidableEq n]
    (P : Matrix n n K) : Prop := Pᴴ * P = 1
private theorem unitary_mul_conjTranspose_m0014 {n : Type*} [Fintype n] [DecidableEq n]
    {P : Matrix n n K} (hP : IsUnitary P) : P * Pᴴ = 1 :=
  mul_eq_one_comm.mp hP
private theorem unitary_transpose_m0014 {n : Type*} [Fintype n] [DecidableEq n]
    (P : Matrix n n K) (hP : IsUnitary P) :
    IsUnitary P.transpose := by
  have h := congrArg Matrix.transpose (unitary_mul_conjTranspose_m0014 hP)
  simpa [IsUnitary, Matrix.transpose_mul, Matrix.conjTranspose,
    Matrix.transpose_map] using h
private theorem unitary_kronecker_m0014 {m n : Type*}
    [Fintype m] [Fintype n] [DecidableEq m] [DecidableEq n]
    (P : Matrix m m K) (Q : Matrix n n K)
    (hP : IsUnitary P) (hQ : IsUnitary Q) :
    IsUnitary (Matrix.kronecker P Q) := by
  unfold IsUnitary at *
  unfold Matrix.kronecker
  rw [Matrix.conjTranspose_kronecker, ← Matrix.mul_kronecker_mul,
    hP, hQ, Matrix.one_kronecker_one]
private theorem matrix_rightInverse_exists_m0014
    {i j : Type*} [Fintype i] [Fintype j] [DecidableEq i] [DecidableEq j]
    (X : Matrix i j K) (hX : X.rank = Fintype.card i) :
    ∃ E : Matrix j i K, X * E = 1 := by
  have hr : (Matrix.toLin' X).range = ⊤ := by
    apply Submodule.eq_top_of_finrank_eq
    rw [Matrix.toLin'_apply']
    change X.rank = Module.finrank K (i → K)
    simpa only [Module.finrank_pi] using hX
  obtain ⟨g, hg⟩ := LinearMap.exists_rightInverse_of_surjective (Matrix.toLin' X) hr
  refine ⟨LinearMap.toMatrix' g, ?_⟩
  apply Matrix.toLin'.injective
  rw [Matrix.toLin'_mul, Matrix.toLin'_toMatrix', Matrix.toLin'_one]
  exact hg
private theorem gram_recovery_from_source_m0014
    {i j : Type*} [Fintype i] [Fintype j] [DecidableEq i]
    (X Y : Matrix i j K) (E : Matrix j i K)
    (hE : X * E = 1) (hg : Xᴴ * X = Yᴴ * Y) :
    IsUnitary (Y * E) ∧ (Y * E) * X = Y := by
  have hQ : (Y * E)ᴴ * (Y * E) = 1 := by
    calc
      (Y * E)ᴴ * (Y * E) = Eᴴ * (Yᴴ * Y) * E := by
        simp only [Matrix.conjTranspose_mul, Matrix.mul_assoc]
      _ = Eᴴ * (Xᴴ * X) * E := by rw [hg]
      _ = (X * E)ᴴ * (X * E) := by
        simp only [Matrix.conjTranspose_mul, Matrix.mul_assoc]
      _ = 1 := by rw [hE]; simp
  have hF : Y * (E * (Y * E)ᴴ) = 1 := by
    rw [← Matrix.mul_assoc]
    exact mul_eq_one_comm.mp hQ
  have hFy : (E * (Y * E)ᴴ)ᴴ * Yᴴ = 1 := by
    rw [← Matrix.conjTranspose_mul, hF, Matrix.conjTranspose_one]
  have hy : Y = (E * (Y * E)ᴴ)ᴴ * (Xᴴ * X) := by
    rw [hg, ← Matrix.mul_assoc, hFy, Matrix.one_mul]
  refine ⟨hQ, ?_⟩
  calc
    (Y * E) * X = (((E * (Y * E)ᴴ)ᴴ * (Xᴴ * X)) * E) * X := by rw [← hy]
    _ = (E * (Y * E)ᴴ)ᴴ * Xᴴ * (X * E) * X := by
      simp only [Matrix.mul_assoc]
    _ = (E * (Y * E)ᴴ)ᴴ * (Xᴴ * X) := by
      rw [hE, Matrix.mul_one, Matrix.mul_assoc]
    _ = Y := hy.symm
abbrev RectTensor (a b c : ℕ) (K : Type*) :=
  Matrix (Fin c) (Fin a × Fin b) K
def rectAction (P : Matrix (Fin a) (Fin a) K)
    (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K)
    (A : RectTensor a b c K) : RectTensor a b c K :=
  R * A * (Matrix.kronecker P Q).transpose
def RectUnitaryEquivalent (A B : RectTensor a b c K) : Prop :=
  ∃ (P : Matrix (Fin a) (Fin a) K)
    (Q : Matrix (Fin b) (Fin b) K)
    (R : Matrix (Fin c) (Fin c) K),
    IsUnitary P ∧ IsUnitary Q ∧ IsUnitary R ∧ rectAction P Q R A = B
