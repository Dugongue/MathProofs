      hbankg hgf hbankd hdf hsep Q (gcd P Q) (gcd_ne_zero_of_right hQ0)
      (gcd_dvd_right P Q) hdegreeQ hdegreeD
      (by intro i;rw [hvals₃,hm _ (by omega) (by omega) (by rcases hsep with h|h <;> omega),hQ _ (by omega)];congr 1;omega)
      (by intro i;rw [hvals₃,hgcd _ (by omega)];congr 1;omega)
  have hNζ : ζ.vars tw.Nr=N := by
    rw [hquotvars tw.Nr (by decide) (by decide) (by decide)]
