variable {K ι : Type*} [Field K] [Fintype K]
def density {X : Type*} (P : X→Prop) : ℝ := (Nat.card {x : X//P x}:ℝ)/Nat.card X
private theorem density_equiv {X Y : Type*} (e : X≃Y) (P : X→Prop) (Q : Y→Prop)
    (he : ∀ x,P x ↔ Q (e x)) : density P=density Q := by
  unfold density
  rw [Nat.card_congr (e.subtypeEquiv he),Nat.card_congr e]
def flattenEquiv (a b c : ℕ) :
    Matrix (Fin c) (Fin a×Fin b) K ≃ Matrix (Fin c) (Fin (a*b)) K :=
  Matrix.reindex (Equiv.refl _) finProdFinEquiv
theorem flatten_gram [StarRing K] (a b c : ℕ) (A : Matrix (Fin c) (Fin a×Fin b) K) :
    (flattenEquiv a b c A)*(flattenEquiv a b c A)ᴴ=A*Aᴴ := by
  ext i j
  change (∑ k : Fin (a*b),A i (finProdFinEquiv.symm k)*star (A j (finProdFinEquiv.symm k)))=
    ∑ k : Fin a×Fin b,A i k*star (A j k)
  exact finProdFinEquiv.symm.sum_comp (fun k=>A i k*star (A j k))
theorem median_le_tested_dimension (a b c : ℕ) (ha : 1 ≤ a) (hbc : b ≤ c) :
    b ≤ min c (a*b) := by
  apply le_min hbc
  simpa using Nat.mul_le_mul_right b ha
private theorem small_large_density [StarRing K] (n m : ℕ)
    (p : ι→K[X]) (hp : ∀ i,(p i).coeff 0≠0) :
    density (fun N : Matrix (Fin n) (Fin m) K=>NoPrimary p (N*Nᴴ))=
      density (fun N : Matrix (Fin n) (Fin m) K=>NoPrimary p (Nᴴ*N)) := by
  apply density_equiv (Equiv.refl _)
  intro N
  exact noPrimary_opposite_iff p hp N Nᴴ
private theorem transpose_density [StarRing K] (n m : ℕ) (p : ι→K[X]) :
    density (fun N : Matrix (Fin n) (Fin m) K=>NoPrimary p (N*Nᴴ))=
      density (fun N : Matrix (Fin m) (Fin n) K=>NoPrimary p (Nᴴ*N)) := by
  apply density_equiv (Matrix.conjTransposeAddEquiv (Fin n) (Fin m) K).toEquiv
  intro N
  change NoPrimary p (N*Nᴴ) ↔ NoPrimary p ((Nᴴ)ᴴ*Nᴴ)
  rw [Matrix.conjTranspose_conjTranspose]
theorem odd_tensor_primary_failure_le [StarRing K] [TrivialStar K]
    (h2 : (2:K)≠0) (a b c : ℕ) (p : ι→K[X]) (hp : ∀ i,(p i).coeff 0≠0) :
    density (fun A : Matrix (Fin c) (Fin a×Fin b) K=>NoPrimary p (A*Aᴴ))  ≤
      Real.sqrt (12*density (fun H : selfAdjoint (Matrix (Fin (min c (a*b))) (Fin (min c (a*b))) K)=>
        NoPrimary p H.val)) := by
  have hf : density (fun A : Matrix (Fin c) (Fin a×Fin b) K=>NoPrimary p (A*Aᴴ))=
      density (fun N : Matrix (Fin c) (Fin (a*b)) K=>NoPrimary p (N*Nᴴ)) := by
    apply density_equiv (flattenEquiv a b c)
    intro A
    rw [flatten_gram]
  rw [hf]
  rcases le_total c (a*b) with h | h
  · rw [min_eq_left h,small_large_density c (a*b) p hp]
    exact odd_rectangular_primary_failure_le h2 c (a*b) h p hp
  · rw [min_eq_right h,transpose_density c (a*b) p]
    exact odd_rectangular_primary_failure_le h2 (a*b) c h p hp
theorem hermitian_tensor_primary_failure_le {F : Type*} [Field F] [Fintype F]
    [Algebra F K] [StarRing K] (hcard : Nat.card K=Nat.card F^2)
    (hstar : ∀ x : K,star x=x^Nat.card F) (a b c : ℕ)
    (p : ι→K[X]) (hp : ∀ i,(p i).coeff 0≠0) :
    density (fun A : Matrix (Fin c) (Fin a×Fin b) K=>NoPrimary p (A*Aᴴ))  ≤
      Real.sqrt ((5/2:ℝ)*density (fun H : selfAdjoint (Matrix (Fin (min c (a*b))) (Fin (min c (a*b))) K)=>
        NoPrimary p H.val)) := by
  have hf : density (fun A : Matrix (Fin c) (Fin a×Fin b) K=>NoPrimary p (A*Aᴴ))=
      density (fun N : Matrix (Fin c) (Fin (a*b)) K=>NoPrimary p (N*Nᴴ)) := by
    apply density_equiv (flattenEquiv a b c)
    intro A
    rw [flatten_gram]
  rw [hf]
  rcases le_total c (a*b) with h | h
  · rw [min_eq_left h,small_large_density c (a*b) p hp]
    exact hermitian_rectangular_primary_failure_le hcard hstar c (a*b) h p hp
  · rw [min_eq_right h,transpose_density c (a*b) p]
    exact hermitian_rectangular_primary_failure_le hcard hstar (a*b) c h p hp
theorem charTwo_tensor_primary_failure_le [CharP K 2]
    (a b c : ℕ) (p : ι→K[X]) (hp : ∀ i,(p i).coeff 0≠0) :
    density (fun A : Matrix (Fin c) (Fin a×Fin b) K=>NoPrimary p (A*A.transpose))  ≤
      Real.sqrt (5*density (fun H : Mathproof.Problem18CharTwoGram20260930.SymMat (min c (a*b)) K=>
        NoPrimary p H.val)) := by
  have hf : density (fun A : Matrix (Fin c) (Fin a×Fin b) K=>NoPrimary p (A*A.transpose))=
      density (fun N : Matrix (Fin c) (Fin (a*b)) K=>NoPrimary p (N*N.transpose)) := by
    apply density_equiv (flattenEquiv a b c)
    intro A
    have hg : (flattenEquiv a b c A)*(flattenEquiv a b c A).transpose=A*A.transpose := by
      ext i j
      change (∑ k : Fin (a*b),A i (finProdFinEquiv.symm k)*A j (finProdFinEquiv.symm k))=
        ∑ k : Fin a×Fin b,A i k*A j k
      exact finProdFinEquiv.symm.sum_comp (fun k=>A i k*A j k)
    rw [hg]
  rw [hf]
  rcases le_total c (a*b) with h | h
  · rw [min_eq_left h]
    have he : density (fun N : Matrix (Fin c) (Fin (a*b)) K=>NoPrimary p (N*N.transpose))=
        density (fun N : Matrix (Fin c) (Fin (a*b)) K=>NoPrimary p (N.transpose*N)) := by
      apply density_equiv (Equiv.refl _)
      intro N
      exact noPrimary_opposite_iff p hp N N.transpose
    rw [he]
    exact charTwo_rectangular_primary_failure_le c (a*b) h p hp
  · rw [min_eq_right h]
    have he : density (fun N : Matrix (Fin c) (Fin (a*b)) K=>NoPrimary p (N*N.transpose))=
        density (fun N : Matrix (Fin (a*b)) (Fin c) K=>NoPrimary p (N.transpose*N)) := by
      apply density_equiv (Matrix.transposeAddEquiv (Fin c) (Fin (a*b)) K).toEquiv
      intro N
      rfl
    rw [he]
    exact charTwo_rectangular_primary_failure_le (a*b) c h p hp
end
end Mathproof.Problem18TensorSpectralTransfer20261001
