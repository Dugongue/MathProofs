private theorem runtime_of_product
    {B a b c n gram base work k : Nat} {sigma tau : Env}
    (h : RuntimeLayout F B a b c n gram base work sigma)
    (hr : Run B Problem18IMPMatrixProductLoop20261001.routine
      (productInstalled sigma (powerAt F base n (k-1))
        (gramCopyAt F base n k) (powerAt F base n k) n work)
      tau (Problem18IMPMatrixProductLoop20261001.cost F.e n n n))
    (hv : ValidMemory F B tau)
    (hregs : ∀ x, x ∉ scalarWrites Problem18IMPMatrixProductLoop20261001.routine →
      tau.vars x =
        (productInstalled sigma (powerAt F base n (k-1))
          (gramCopyAt F base n k) (powerAt F base n k) n work).vars x) :
    RuntimeLayout F B a b c n gram base work tau := by
  have hlen : (tau.arrs canonical.mem).length =
      (sigma.arrs canonical.mem).length := by
    simpa [productInstalled,productS6,productS5,productS4,productS3,
      productS2,productS1] using (run_frame hr).2.2.1 canonical.mem
  have reg (x : String)
      (hx : x ∉ scalarWrites Problem18IMPMatrixProductLoop20261001.routine)
      (ha : x ≠ canonical.aBase) (hb : x ≠ canonical.bBase)
      (ho : x ≠ canonical.outBase) (hrw : x ≠ rows)
      (hcol : x ≠ columns) (hcnt : x ≠ count) (hwork : x ≠ workBase) :
      tau.vars x = sigma.vars x := by
    rw [hregs x hx]
    simp [productInstalled,productS6,productS5,productS4,productS3,
      productS2,productS1,Env.setVar,ha,hb,ho,hrw,hcol,hcnt,hwork]
  have re (x : String) (hx : x ∉ scalarWrites Problem18IMPMatrixProductLoop20261001.routine)
      (ha : x ≠ canonical.aBase) (hb : x ≠ canonical.bBase)
      (ho : x ≠ canonical.outBase) (hrw : x ≠ rows)
      (hcol : x ≠ columns) (hcnt : x ≠ count) (hwork : x ≠ workBase) :=
    reg x hx ha hb ho hrw hcol hcnt hwork
  refine {
    packed := {
      valid := hv
      n_pos := h.packed.n_pos
      n_word := h.packed.n_word
      square_word := h.packed.square_word
      c_word := h.packed.c_word
      exponent := by rw [re canonical.exp (by decide) (by decide) (by decide)
        (by decide) (by decide) (by decide) (by decide) (by decide)]; exact h.packed.exponent
      modulus_before := by rw [re canonical.modBase (by decide) (by decide) (by decide)
        (by decide) (by decide) (by decide) (by decide) (by decide)]; exact h.packed.modulus_before
      powers_before_work := h.packed.powers_before_work
      work_fit := by rw [hlen]; exact h.packed.work_fit }
    n_eq := h.n_eq
    a_word := h.a_word
    b_word := h.b_word
    c_pos := h.c_pos
    c_word := h.c_word
    gram_word := h.gram_word
    base_word := h.base_word
    work_word := h.work_word
    block_word := h.block_word
    stride_word := h.stride_word
    powers_word := h.powers_word
    gram_fit := by rw [hlen]; exact h.gram_fit
    gram_before := h.gram_before
    dimA_eq := by rw [re dimA (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide)]; exact h.dimA_eq
    dimB_eq := by rw [re dimB (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide)]; exact h.dimB_eq
    dimC_eq := by rw [re dimC (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide)]; exact h.dimC_eq
    gram_eq := by rw [re gramBase (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide)]; exact h.gram_eq
    base_eq := by rw [re poweredGramBase (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide)]; exact h.base_eq
    work_eq := by rw [re productWork (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide) (by decide)]; exact h.work_eq }
private theorem runtime_of_prepared_copy (u v z : Expr)
    {B a b c n gram base work : Nat} {sigma tau : Env}
    (h : RuntimeLayout F B a b c n gram base work sigma)
    (hv : ValidMemory F B tau)
    (hr : Run B (Problem18RecursivePreparedCopy20261002.program
      canonical.mem canonical.mem u v z)
      sigma tau (u.size+v.size+z.size+16*blockWords F n+9))
    (hvars : ∀ x, x ∉ Problem18RecursivePreparedCopy20261002.work →
      tau.vars x = sigma.vars x) :
    RuntimeLayout F B a b c n gram base work tau := by
  have hlen : (tau.arrs canonical.mem).length =
      (sigma.arrs canonical.mem).length := (run_frame hr).2.2.1 _
  have reg (x : String)
      (hx : x ∉ Problem18RecursivePreparedCopy20261002.work) :
      tau.vars x = sigma.vars x := hvars x hx
  refine {
    packed := {
      valid := hv
      n_pos := h.packed.n_pos
      n_word := h.packed.n_word
      square_word := h.packed.square_word
      c_word := h.packed.c_word
      exponent := by rw [reg canonical.exp (by decide)]; exact h.packed.exponent
      modulus_before := by rw [reg canonical.modBase (by decide)]; exact h.packed.modulus_before
      powers_before_work := h.packed.powers_before_work
      work_fit := by rw [hlen]; exact h.packed.work_fit }
    n_eq := h.n_eq
    a_word := h.a_word
    b_word := h.b_word
    c_pos := h.c_pos
    c_word := h.c_word
    gram_word := h.gram_word
    base_word := h.base_word
    work_word := h.work_word
    block_word := h.block_word
    stride_word := h.stride_word
    powers_word := h.powers_word
    gram_fit := by rw [hlen]; exact h.gram_fit
    gram_before := h.gram_before
    dimA_eq := by rw [reg dimA (by decide)]; exact h.dimA_eq
    dimB_eq := by rw [reg dimB (by decide)]; exact h.dimB_eq
    dimC_eq := by rw [reg dimC (by decide)]; exact h.dimC_eq
    gram_eq := by rw [reg gramBase (by decide)]; exact h.gram_eq
    base_eq := by rw [reg poweredGramBase (by decide)]; exact h.base_eq
    work_eq := by rw [reg productWork (by decide)]; exact h.work_eq }
