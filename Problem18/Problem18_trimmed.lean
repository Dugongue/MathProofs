variable {K V ι : Type*} [Field K] [Fintype K] [CharP K 2] [Fintype ι] [Nonempty ι]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
private theorem isometries_pos_m0596 {W : Type*} [AddCommGroup W] [Module K W] [FiniteDimensional K W]
    (C : LinearMap.BilinForm K W) : 0<(Nat.card (Isometries (RingEquiv.refl K) C):ℝ) := by
  letI : Finite W := Finite.of_injective (Module.finBasis K W).equivFun (Module.finBasis K W).equivFun.injective
  letI : Finite (W ≃ₗ[K] W) := Finite.of_injective
    (fun e : W ≃ₗ[K] W=>(e:W→W)) DFunLike.coe_injective
  letI : Nonempty (Isometries (RingEquiv.refl K) C) := ⟨⟨LinearEquiv.refl K W,fun _ _=>rfl⟩⟩
  exact_mod_cast (Nat.card_pos (α:=Isometries (RingEquiv.refl K) C))
theorem normalized_class_identity (g : ι→K[X]) [∀ i,Fact (Irreducible (g i))]
    (hm : ∀ i,(g i).Monic) (hcop : Pairwise (fun i j=>IsCoprime (g i) (g j)))
    (H : LinearMap.BilinForm K V) (hH : H.IsSymm) (hnH : H.Nondegenerate)
    (hdn : (∏ i,g i).natDegree≤Module.finrank K V)
    (cd : FormClass K (∏ i,g i).natDegree × FormClass K (Module.finrank K V-(∏ i,g i).natDegree))
    (haB : ¬(representative K cd.1).val.IsAlt)
    (e : ((Fin (∏ i,g i).natDegree→K) × (Fin (Module.finrank K V-(∏ i,g i).natDegree)→K)) ≃ₗ[K] V)
    (he : ∀ x y,H (e x) (e y)=(representative K cd.1).val x.1 y.1+(representative K cd.2).val x.2 y.2) :
    let c := Module.finrank K V-(∏ i,g i).natDegree
    let C := (representative K cd.2).val
    ((Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) H // ClassifiedEvent H (∏ i,g i) cd S}:ℝ)/
      Nat.card (SelfAdjointOperators (RingEquiv.refl K) H))*(Nat.card K:ℝ)^(∏ i,g i).natDegree=
    ((Nat.card (Isometries (RingEquiv.refl K) H):ℝ)/
      (Nat.card (Isometries (RingEquiv.refl K) C)*(Nat.card K:ℝ)^((Module.finrank K V).choose 2-c.choose 2)))*
    ((Nat.card {T : SelfAdjointOperators (RingEquiv.refl K) C // IsCoprime (∏ i,g i) T.val.charpoly}:ℝ)/
      Nat.card (SelfAdjointOperators (RingEquiv.refl K) C)) := by
  dsimp only
  let n := Module.finrank K V
  let d := (∏ i,g i).natDegree
  let c := n-d
  let C := (representative K cd.2).val
  have hC : C.IsSymm := (representative K cd.2).property.1
  have hnC : C.Nondegenerate := (representative K cd.2).property.2
  have hcDim : Module.finrank K (Fin c→K)=c := by simp
  let q : ℝ := Nat.card K
  let ga : ℝ := Nat.card (Isometries (RingEquiv.refl K) H)
  let gc : ℝ := Nat.card (Isometries (RingEquiv.refl K) C)
  let sa : ℝ := Nat.card (SelfAdjointOperators (RingEquiv.refl K) H)
  let sc : ℝ := Nat.card (SelfAdjointOperators (RingEquiv.refl K) C)
  let r : ℝ := Nat.card {T : SelfAdjointOperators (RingEquiv.refl K) C // IsCoprime (∏ i,g i) T.val.charpoly}
  let x : ℝ := Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) H // ClassifiedEvent H (∏ i,g i) cd S}
  have hq : 0<q := by dsimp only [q]; exact_mod_cast (Nat.card_pos (α:=K))
  have hsa : sa=q^(n.choose 2+n) := by
    dsimp only [sa,q,n]
    rw [sample_card H hH hnH,Nat.cast_pow]
  have hsc : sc=q^(c.choose 2+c) := by
    dsimp only [sc,q,C]
    rw [sample_card _ hC hnC,hcDim,Nat.cast_pow]
  have hsc0 : 0<sc := by rw [hsc]; positivity
  have hgc0 : 0<gc := isometries_pos_m0596 C
  have hcn : c≤n := Nat.sub_le _ _
  have hdn' : d+c=n := Nat.add_sub_of_le hdn
  have hchoose : c.choose 2≤n.choose 2 := Nat.choose_le_choose 2 hcn
  have hexp : (c.choose 2+c)+d+(n.choose 2-c.choose 2)=n.choose 2+n := by omega
  have hp : sa=sc*q^d*q^(n.choose 2-c.choose 2) := by
    rw [hsa,hsc,←pow_add,←pow_add,hexp]
  have hcard := Mathproof.Problem18OrdinaryClassTransport20261001.charTwo_classified_event_card
    g hm hcop H cd haB e he
  have hcardR : x*gc=ga*r := by dsimp only [x,gc,ga,r]; exact_mod_cast hcard
  change x/sa*q^d=(ga/(gc*q^(n.choose 2-c.choose 2)))*(r/sc)
  rw [hp]
  field_simp [hsc0.ne',hgc0.ne',hq.ne']
  nlinarith [hcardR]
private theorem product_error_m0596 (R t δ ε : ℝ) (ht0 : 0≤t) (ht1 : t≤1)
    (hR : |R-1|≤δ) (ht : 1-t≤ε) : |R*t-1|≤δ+ε := by
  have hd : 0≤δ := (abs_nonneg _).trans hR
  calc
    |R*t-1|=|(R-1)*t+(t-1)| := by congr 1; ring
    _ ≤ |(R-1)*t|+|t-1| := abs_add_le _ _
    _ = |R - 1| * t+(1-t) := by
      rw [abs_mul,abs_of_nonneg ht0,abs_of_nonpos (by linarith : t-1≤0)]
      ring
    _ ≤ δ*t+ε := add_le_add (mul_le_mul_of_nonneg_right hR ht0) ht
    _ ≤ δ+ε := by nlinarith
theorem main_class_estimate (g : ι→K[X]) [∀ i,Fact (Irreducible (g i))]
    (hm : ∀ i,(g i).Monic) (hcop : Pairwise (fun i j=>IsCoprime (g i) (g j)))
    (H : LinearMap.BilinForm K V) (hH : H.IsSymm) (hnH : H.Nondegenerate) (haH : ¬H.IsAlt)
    (hc : (∏ i,g i).natDegree+2≤Module.finrank K V)
    (cd : FormClass K (∏ i,g i).natDegree × FormClass K (Module.finrank K V-(∏ i,g i).natDegree))
    (haB : ¬(representative K cd.1).val.IsAlt) (haC : ¬(representative K cd.2).val.IsAlt)
    (e : ((Fin (∏ i,g i).natDegree→K) × (Fin (Module.finrank K V-(∏ i,g i).natDegree)→K)) ≃ₗ[K] V)
    (he : ∀ x y,H (e x) (e y)=(representative K cd.1).val x.1 y.1+(representative K cd.2).val x.2 y.2)
    (D : ℕ) (hlo : ∀ i,D≤(g i).natDegree)
    (hhi : ∀ i,2*(g i).natDegree≤Module.finrank K V-(∏ i,g i).natDegree) :
    |((Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) H // ClassifiedEvent H (∏ i,g i) cd S}:ℝ)/
      Nat.card (SelfAdjointOperators (RingEquiv.refl K) H))*(Nat.card K:ℝ)^(∏ i,g i).natDegree-1| ≤
      2*((Nat.card K:ℝ)^(Module.finrank K V-(∏ i,g i).natDegree-1))⁻¹+20*Nat.card ι/(Nat.card K:ℝ)^D := by
  rw [normalized_class_identity g hm hcop H hH hnH (by omega) cd haB e he]
  let C := (representative K cd.2).val
  have hcDim : Module.finrank K (Fin (Module.finrank K V-(∏ i,g i).natDegree)→K)=
      Module.finrank K V-(∏ i,g i).natDegree := by simp
  have ht := Mathproof.Problem18OrdinaryResidualUnion20261001.residual_probability_bounds C
    (representative K cd.2).property.1 (representative K cd.2).property.2 g hm (fun i=>Fact.out)
    D hlo (by simpa using hhi)
  have hR := nonalternating_order_ratio_error H C hH (representative K cd.2).property.1
    hnH (representative K cd.2).property.2 haH haC (by rw [hcDim]; omega)
    (by rw [hcDim]; exact Nat.sub_le _ _)
  exact product_error_m0596 _ _ _ _ ht.1 ht.2.1 (by simpa only [hcDim] using hR) ht.2.2
theorem alternating_class_bound (g : ι→K[X]) [∀ i,Fact (Irreducible (g i))]
    (hm : ∀ i,(g i).Monic) (hcop : Pairwise (fun i j=>IsCoprime (g i) (g j)))
    (H : LinearMap.BilinForm K V) (hH : H.IsSymm) (hnH : H.Nondegenerate) (haH : ¬H.IsAlt)
    (hc : (∏ i,g i).natDegree+2≤Module.finrank K V)
    (cd : FormClass K (∏ i,g i).natDegree × FormClass K (Module.finrank K V-(∏ i,g i).natDegree))
    (haB : ¬(representative K cd.1).val.IsAlt) (haC : (representative K cd.2).val.IsAlt)
    (e : ((Fin (∏ i,g i).natDegree→K) × (Fin (Module.finrank K V-(∏ i,g i).natDegree)→K)) ≃ₗ[K] V)
    (he : ∀ x y,H (e x) (e y)=(representative K cd.1).val x.1 y.1+(representative K cd.2).val x.2 y.2)
    (D : ℕ) (hlo : ∀ i,D≤(g i).natDegree)
    (hhi : ∀ i,2*(g i).natDegree≤Module.finrank K V-(∏ i,g i).natDegree) :
    ((Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) H // ClassifiedEvent H (∏ i,g i) cd S}:ℝ)/
      Nat.card (SelfAdjointOperators (RingEquiv.refl K) H))*(Nat.card K:ℝ)^(∏ i,g i).natDegree ≤
      Real.exp 2*((Nat.card K:ℝ)^(Module.finrank K V-(∏ i,g i).natDegree))⁻¹ := by
  rw [normalized_class_identity g hm hcop H hH hnH (by omega) cd haB e he]
  let n := Module.finrank K V
  let c := n-(∏ i,g i).natDegree
  let C := (representative K cd.2).val
  let q : ℝ := Nat.card K
  let ga : ℝ := Nat.card (Isometries (RingEquiv.refl K) H)
  let gc : ℝ := Nat.card (Isometries (RingEquiv.refl K) C)
  have hcDim : Module.finrank K (Fin c→K)=c := by simp
  have hn : 0<n := by dsimp [n]; omega
  have hq : 0<q := by dsimp only [q]; exact_mod_cast (Nat.card_pos (α:=K))
  have hgc : 0<gc := isometries_pos_m0596 C
  have hga : ga≤q^(n.choose 2) := by
    dsimp only [ga,q]
    rw [nonalternating_isometry_card H hH hnH haH hn]
    have heN : n-1+1=n := by omega
    let O (j : ℕ) : ℝ := Nat.card (Matrix.orthogonalGroup (Fin j) K)
    have hb := (Mathproof.Problem18CharTwoOrderBounds20260930.orthogonal_order_bounds (K:=K) (n-1)).2
    change O (n-1+1)≤(Nat.card K:ℝ)^((n-1+1).choose 2) at hb
    rw [heN] at hb
    exact hb
  have hlow : Real.exp (-2)*q^(c.choose 2+c)≤gc := by
    simpa [gc,q,c,n] using alternating_isometry_lower C haC (representative K cd.2).property.2
  have hchoose : c.choose 2≤n.choose 2 := Nat.choose_le_choose 2 (Nat.sub_le _ _)
  have hpow : q^(c.choose 2+c)*q^(n.choose 2-c.choose 2)=q^c*q^(n.choose 2) := by
    rw [←pow_add,←pow_add]
    congr 1
    omega
  have hR : ga/(gc*q^(n.choose 2-c.choose 2))≤Real.exp 2*(q^c)⁻¹ := by
    apply (div_le_iff₀ (mul_pos hgc (pow_pos hq _))).mpr
    calc
      ga≤q^(n.choose 2) := hga
      _ = (Real.exp 2*(q^c)⁻¹*q^(n.choose 2-c.choose 2))*(Real.exp (-2)*q^(c.choose 2+c)) := by
        rw [Real.exp_neg]
        field_simp [hq.ne',(Real.exp_pos 2).ne']
        nlinarith [hpow]
      _ ≤ (Real.exp 2*(q^c)⁻¹*q^(n.choose 2-c.choose 2))*gc :=
        mul_le_mul_of_nonneg_left hlow (by positivity)
      _ = (Real.exp 2*(q^c)⁻¹)*(gc*q^(n.choose 2-c.choose 2)) := by ring
  have ht := Mathproof.Problem18OrdinaryResidualUnion20261001.residual_probability_bounds C
    (representative K cd.2).property.1 (representative K cd.2).property.2 g hm (fun i=>Fact.out)
    D hlo (by simpa using hhi)
  have hR0 : 0≤ga/(gc*q^(n.choose 2-c.choose 2)) := by positivity
  exact (mul_le_of_le_one_right hR0 ht.2.1).trans hR
theorem ambient_joint_estimate (g : ι→K[X]) [∀ i,Fact (Irreducible (g i))]
    (hm : ∀ i,(g i).Monic) (hcop : Pairwise (fun i j=>IsCoprime (g i) (g j)))
    (hs : Squarefree (∏ i,g i))
    (H : LinearMap.BilinForm K V) (hH : H.IsSymm) (hnH : H.Nondegenerate) (haH : ¬H.IsAlt)
    (hd : 0<(∏ i,g i).natDegree) (hc : (∏ i,g i).natDegree+2≤Module.finrank K V)
    (D : ℕ) (hlo : ∀ i,D≤(g i).natDegree)
    (hhi : ∀ i,2*(g i).natDegree≤Module.finrank K V-(∏ i,g i).natDegree) :
    |((Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) H //
        (∏ i,g i)∣S.val.charpoly ∧ IsCoprime (∏ i,g i) (S.val.charpoly/(∏ i,g i))}:ℝ)/
      Nat.card (SelfAdjointOperators (RingEquiv.refl K) H))*(Nat.card K:ℝ)^(∏ i,g i).natDegree-1| ≤
      2*((Nat.card K:ℝ)^(Module.finrank K V-(∏ i,g i).natDegree-1))⁻¹+
        20*Nat.card ι/(Nat.card K:ℝ)^D+
        4*Real.exp 2*((Nat.card K:ℝ)^(Module.finrank K V-(∏ i,g i).natDegree))⁻¹ := by
  let p := ∏ i,g i
  have hp : p.Monic := Polynomial.monic_prod_of_monic _ _ (fun i _=>hm i)
  let d := p.natDegree
  let c := Module.finrank K V-d
  let I := FormClass K d × FormClass K c
  letI : Fintype (FormClass K d) := Fintype.ofFinite _
  letI : Fintype (FormClass K c) := Fintype.ofFinite _
  let q : ℝ := Nat.card K
  let sa : ℝ := Nat.card (SelfAdjointOperators (RingEquiv.refl K) H)
  let x (cd : I) : ℝ := Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) H // ClassifiedEvent H p cd S}
  let Main (cd : I) := ¬(representative K cd.1).val.IsAlt ∧ ¬(representative K cd.2).val.IsAlt
  let E : ℝ := 2*(q^(c-1))⁻¹+20*Nat.card ι/q^D
  let η : ℝ := Real.exp 2*(q^c)⁻¹
  have hη : 0≤η := by positivity
  have hdc : d+c=Module.finrank K V := by dsimp [c,d,p]; omega
  let b := (Module.finBasis K V).reindex (finCongr hdc.symm)
  have hcard : Nat.card {cd : I//Main cd}=1 :=
    Mathproof.Problem18CharTwoMainClasses20261001.main_pair_card_eq_one hd (by dsimp [c,d,p]; omega)
  have hcount : (∑ cd:I,if Main cd then (1:ℝ) else 0)=1 := by
    rw [Finset.sum_boole, ←Fintype.card_subtype Main, ←Nat.card_eq_fintype_card, hcard]
    norm_num
  have hfour : (Nat.card I:ℝ)≤4 := by
    exact_mod_cast Mathproof.Problem18CharTwoMainClasses20261001.all_pair_card_le_four (K:=K) d c
  have hxs : (Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) H //
      p∣S.val.charpoly ∧ IsCoprime p (S.val.charpoly/p)}:ℝ)=∑ cd:I,x cd := by
    dsimp only [x]
    exact_mod_cast intrinsic_event_card_sum H hH hnH p hp
  have hterm (cd : I) : |(x cd/sa)*q^d-(if Main cd then 1 else 0)|≤
      (if Main cd then E else 0)+η := by
    by_cases hB : ¬(representative K cd.1).val.IsAlt
    · obtain ⟨e,he⟩ := Mathproof.Problem18OrdinaryCompatibleClasses20261001.charTwo_compatible
        H hH hnH haH b cd hB
      by_cases hC : ¬(representative K cd.2).val.IsAlt
      · have hM : Main cd := ⟨hB,hC⟩
        rw [if_pos hM,if_pos hM]
        exact (main_class_estimate g hm hcop H hH hnH haH hc cd hB hC e he D hlo hhi).trans
          (le_add_of_nonneg_right hη)
      · have hM : ¬Main cd := fun h=>hC h.2
        rw [if_neg hM,if_neg hM,sub_zero,zero_add,abs_of_nonneg (by positivity)]
        exact alternating_class_bound g hm hcop H hH hnH haH hc cd hB (not_not.mp hC) e he D hlo hhi
    · have hM : ¬Main cd := fun h=>hB h.1
      have hz : x cd=0 := by
        letI : IsEmpty {S : SelfAdjointOperators (RingEquiv.refl K) H // ClassifiedEvent H p cd S} :=
          ⟨fun S=>hB (Mathproof.Problem18CharTwoMainClasses20261001.classified_source_not_alternating
            H p hp hs hd cd S.val S.property)⟩
        simp only [x,Nat.card_of_isEmpty,Nat.cast_zero]
      rw [if_neg hM,if_neg hM,hz]
      simpa using hη
  have hh := (Finset.abs_sum_le_sum_abs (fun cd:I=>(x cd/sa)*q^d-(if Main cd then 1 else 0))
    Finset.univ).trans (Finset.sum_le_sum (fun cd _=>hterm cd))
  have hz : (∑ cd:I,((x cd/sa)*q^d-(if Main cd then 1 else 0)))=
      (∑ cd:I,x cd)/sa*q^d-1 := by
    rw [Finset.sum_sub_distrib,hcount,←Finset.sum_mul,←Finset.sum_div]
  have he : (∑ cd:I,((if Main cd then E else 0)+η))=E+(Nat.card I:ℝ)*η := by
    rw [Finset.sum_add_distrib]
    have he1 : (∑ cd:I,if Main cd then E else 0)=E := by
      calc
        _ = ∑ cd:I,(if Main cd then (1:ℝ) else 0)*E := by
          apply Finset.sum_congr rfl
          intro cd _
          split_ifs <;> simp
        _ = (∑ cd:I,if Main cd then (1:ℝ) else 0)*E := (Finset.sum_mul ..).symm
        _ = E := by rw [hcount,one_mul]
    rw [he1]
    simp only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,Nat.card_eq_fintype_card]
  rw [hz,he] at hh
  have hh' := hh.trans (add_le_add (le_refl E) (mul_le_mul_of_nonneg_right hfour hη))
  change |((Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) H //
      p∣S.val.charpoly ∧ IsCoprime p (S.val.charpoly/p)}:ℝ)/sa)*q^d-1|≤E+4*Real.exp 2*(q^c)⁻¹
  rw [hxs]
  simpa only [η,mul_assoc] using hh'
end
end Mathproof.Problem18OrdinaryCharTwoJointEstimate20261001
