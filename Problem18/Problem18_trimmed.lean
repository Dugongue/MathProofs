    Slots.setVar F r (Slots.setVar F r (Slots.setVar F r hS6 rNS nNW _) rnS nnW _) rcS ncW _
  have hv7 : ∀ s, val F r q.WS σ7 s = val F r q.WS τ6 s := fun s => by
