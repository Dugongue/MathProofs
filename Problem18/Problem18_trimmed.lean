    degree:=?_,prime:=?_,separate:=h.separate,outer_names:=h.outer_names,
    inner_names:=h.inner_names,private_names:=h.private_names,arithmetic_word:=h.arithmetic_word,
    memory_word:=h.memory_word,scratch_word:=h.scratch_word,scratch_fit:=h.scratch_fit,
    modulus_fit:=?_,modulus_value:=?_,buffer_canonical:=h.buffer_canonical,exponent_word:=?_ }
