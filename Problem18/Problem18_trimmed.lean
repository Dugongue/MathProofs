    programCost F a b c
def PowerOutside (n c base work j : Nat) : Prop :=
  (j < base ∨ base + c*(2*blockWords F n) ≤ j) ∧
  (j < work ∨ work + 3*F.e ≤ j)
structure FullProgramInputF (B a b c n gram base work : Nat)
    (u : Bool) (q : Nat) (A : RectTensor a b c K)
    (G : Matrix (Fin n) (Fin n) K) (sigma : Env) : Prop where
  runtime : RuntimeLayout F B a b c n gram base work sigma
  gram_value : Problem18IMPMatrixMemory20261001.matrix F sigma gram n n = G
  trace : ∀ (rho : Env),
    RuntimeLayout F B a b c n gram base work rho →
    PowerInvariant F B n base gram c G rho →
    (∀ x, x ∉ scalarWrites Problem18P36LargeFirstController20261003.powerProgram →
      rho.vars x = sigma.vars x) →
    (∀ arr, arr ∉ arrayWrites Problem18P36LargeFirstController20261003.powerProgram →
      rho.arrs arr = sigma.arrs arr) →
    (∀ arr, (rho.arrs arr).length = (sigma.arrs arr).length) →
    (∀ j < (sigma.arrs canonical.mem).length, PowerOutside F n c base work j →
      (rho.arrs canonical.mem).getD j 0 = (sigma.arrs canonical.mem).getD j 0) →
    ProgramInput F B a b c u q A rho
theorem fullProgram_run_costF {B a b c n gram base work : Nat}
    {u : Bool} {q : Nat} {A : RectTensor a b c K}
    {G : Matrix (Fin n) (Fin n) K} {sigma : Env}
    (h : FullProgramInputF F B a b c n gram base work u q A G sigma) :
    ∃ tau,
      Run B Problem18P36LargeFirstController20261003.fullProgram sigma tau
        (fullProgramCost F a b c n) ∧
      ValidMemory F B tau ∧
      (∀ (t : Fin c) (r s : Fin b),
        decode F (slice F tau canonical
          (tau.vars familyBase + F.e*flatIndex t r s)) = rawFirst u q A t r s) := by
  obtain ⟨rho,hpower,hR,hI,hNF⟩ :=
    Problem18P36LargeFirstExecution20261004.powerProgram_run_frame F h.runtime h.gram_value
  have hfr := run_frame hpower
  have htr := h.trace rho hR hI hfr.1 hfr.2.1 hfr.2.2.1
    (fun j hj hp => hNF j hj hp.1 hp.2)
  obtain ⟨tau,htrace,hvalid,hfamily,hframe,hmemory⟩ := program_run F htr
  refine ⟨tau,?_,hvalid,?_⟩
  · simpa [Problem18P36LargeFirstController20261003.fullProgram,fullProgramCost] using
      hpower.seq htrace
  · intro t r s
    have hreg := hframe.1 familyBase (by simp [protectedRegs])
    rw [hreg]
    exact hfamily t r s
def layout : Lax13Proofs.Compile.Layout :=
  Mathproof.Problem18P34Machine20261002Layout.layout
    Problem18P36LargeFirstController20261003.fullProgram
end Mathproof.Problem18P36LargeFirstFullExecution20261004
