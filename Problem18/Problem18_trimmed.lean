        Finset.sum_le_sum (fun W _ => hf W)
      _ = _ := by simp only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,Nat.card_eq_fintype_card]
  have hg : (Nat.card (IsoSpace τ B d) : ℝ) ≤ 4*(Nat.card K : ℝ)^N := by
    simpa only [Nat.card_eq_fintype_card] using
      Mathproof.Problem18IsotropicCountBound20260930.isotropic_card_bound τ B hB d hd
  have ht := hsum.trans (mul_le_mul_of_nonneg_right hg (by positivity))
  have hq : 0<(Nat.card K : ℝ) := by exact_mod_cast (Nat.card_pos (α := K))
  have hp : 0<(Nat.card K : ℝ)^N := pow_pos hq _
  apply le_of_mul_le_mul_right (a := (Nat.card K : ℝ)^N) _ hp
