def candBody (M : FieldMacros F r) (q : RNames) (cn : CNames) : Com :=
  .seq (loadChosen M q cn.cc)
    (.seq (copyLoop M q (.lit 5) (inBase q (.var cn.t)))
      (.seq (.assign q.c (.var cn.cc))
        (.seq (.assign q.n (.var q.N))
          (.seq (reduceLoop M q)
            (.seq (zeroTest M q cn.z cn.k)
              (.seq (.ite (.eq (.var cn.z) (.lit 1))
                  (.seq (copyLoop M q (stBase q (.var cn.cc)) (inBase q (.var cn.t)))
                    (.assign cn.cc (plus (.var cn.cc) (.lit 1))))
                  .skip)
                (.assign cn.t (plus (.var cn.t) (.lit 1)))))))))
def compressCom (M : FieldMacros F r) (q : RNames) (cn : CNames) : Com :=
  .seq (.assign cn.cc (.lit 0))
    (.seq (.assign cn.t (.lit 0)) (.while (.lt (.var cn.t) (.var cn.R)) (candBody M q cn)))
def candCost (M : FieldMacros F r) (q : RNames) (cn : CNames) (Nv : ℕ) : ℕ :=
  loadCost M q cn.cc Nv Nv + copyCost M (.lit 5) (inBase q (.var cn.t)) Nv + 4 +
    reduceCost M q Nv Nv Nv + zeroCost M Nv + 12 +
    copyCost M (stBase q (.var cn.cc)) (inBase q (.var cn.t)) Nv + 8
def compressCost (M : FieldMacros F r) (q : RNames) (cn : CNames) (Nv Rv : ℕ) : ℕ :=
  4 + (4 + candCost M q cn Nv) * Rv + 4
theorem map_reverse_range {α : Type*} (n : ℕ) (f : ℕ → α) :
    (List.range n).reverse.map f = (List.range n).map (fun u => f (n - 1 - u)) := by
  apply List.ext_getElem
  · simp
  · intro i h1 h2
    simp only [List.getElem_map, List.getElem_reverse, List.getElem_range, List.length_range]
noncomputable def chosenOf (g : ℕ → K) (Nv ccv : ℕ) : List (Vector K Nv) :=
