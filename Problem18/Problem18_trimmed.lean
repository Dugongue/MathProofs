theorem product_quotient_units_card {K ι : Type*} [Field K] [Fintype K] [Fintype ι]
    (g : ι → K[X]) [∀ i,Fact (Irreducible (g i))]
    (hm : ∀ i,(g i).Monic) (hcop : Pairwise (fun i j => IsCoprime (g i) (g j))) :
    Nat.card (AdjoinRoot (∏ i,g i))ˣ=∏ i,(Nat.card K^(g i).natDegree-1) := by
  classical
  letI (i : ι) : FiniteDimensional K (AdjoinRoot (g i)) :=
    (AdjoinRoot.powerBasis (Fact.out : Irreducible (g i)).ne_zero).finite
  letI (i : ι) : Finite (AdjoinRoot (g i)) :=
    Finite.of_injective (Module.finBasis K (AdjoinRoot (g i))).equivFun
      (Module.finBasis K (AdjoinRoot (g i))).equivFun.injective
  let e := (Units.mapEquiv (quotientPrimaryEquiv g hm hcop).toRingEquiv.toMulEquiv).trans
    (MulEquiv.piUnits : (∀ i,AdjoinRoot (g i))ˣ ≃* ∀ i,(AdjoinRoot (g i))ˣ)
  rw [Nat.card_congr e.toEquiv,Nat.card_pi]
  apply Finset.prod_congr rfl
  intro i _
  rw [Nat.card_units,Mathproof.Problem18DistinctDegreeSquare20260930.adjoinRoot_card]
theorem squarefree_quotient_units_card {K : Type*} [Field K] [Fintype K]
    (f : K[X]) (hm : f.Monic) (hs : Squarefree f) :
    Nat.card (AdjoinRoot f)ˣ=∏ i : FactorIndex f,(Nat.card K^i.val.natDegree-1) := by
  let g : FactorIndex f → K[X] := fun i => i.val
  letI (i : FactorIndex f) : Fact (Irreducible (g i)) := ⟨factor_irreducible f i⟩
  have hcop : Pairwise (fun i j : FactorIndex f => IsCoprime (g i) (g j)) := by
    intro i j hij
    apply (factor_irreducible f i).coprime_iff_not_dvd.mpr
    intro hd
    have ha := ((factor_irreducible f i).dvd_irreducible_iff_associated (factor_irreducible f j)).mp hd
    exact hij (Subtype.ext (Polynomial.eq_of_monic_of_associated (factor_monic f i) (factor_monic f j) ha))
  have h := product_quotient_units_card g (factor_monic f) hcop
  have hf : f=∏ i,g i := factor_product f hm hs
  rwa [← hf] at h
theorem squarefree_quotient_units_fraction {K : Type*} [Field K] [Fintype K]
    (f : K[X]) (hm : f.Monic) (hs : Squarefree f) :
    (Nat.card (AdjoinRoot f)ˣ:ℝ)/(Nat.card K:ℝ)^f.natDegree=
      ∏ i : FactorIndex f,(1-((Nat.card K:ℝ)^i.val.natDegree)⁻¹) := by
  classical
  have hdeg : f.natDegree=∑ i : FactorIndex f,i.val.natDegree := by
    conv_lhs => rw [factor_product f hm hs]
    exact Polynomial.natDegree_prod_of_monic _ _ (fun i _ => factor_monic f i)
  have hp : (Nat.card K:ℝ)^f.natDegree=∏ i : FactorIndex f,(Nat.card K:ℝ)^i.val.natDegree := by
    rw [Finset.prod_pow_eq_pow_sum,hdeg]
  rw [squarefree_quotient_units_card f hm hs,hp,Nat.cast_prod,← Finset.prod_div_distrib]
  apply Finset.prod_congr rfl
  intro i _
  have hq : 1≤Nat.card K := Nat.one_le_iff_ne_zero.mpr Nat.card_pos.ne'
  have hpow : 1≤Nat.card K^i.val.natDegree := one_le_pow₀ hq
  rw [Nat.cast_sub hpow,Nat.cast_one,Nat.cast_pow]
  have hz : (Nat.card K:ℝ)^i.val.natDegree≠0 := by positivity
  field_simp
theorem squarefree_quotient_units_lower {K : Type*} [Field K] [Fintype K]
    {n : ℕ} (f : Mathproof.Problem18MonicDivisibilityBoundary20260930.MonicDegree (K:=K) n)
    (hs : Squarefree f.val)
    (hY : Mathproof.Problem18PolynomialWeightBoundary20260930.weight f≤36) :
    Real.exp (-72)≤(Nat.card (AdjoinRoot f.val)ˣ:ℝ)/(Nat.card K:ℝ)^n := by
  classical
  have he := squarefree_quotient_units_fraction f.val f.property.1 hs
  rw [f.property.2] at he
  rw [he]
