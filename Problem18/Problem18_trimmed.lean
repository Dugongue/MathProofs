      ∃ τ, Run B fillBody ρ τ 26 ∧ I τ ∧ V τ < V ρ := by
    intro ρ h hc
    obtain ⟨hj,hcnt,hbase,hee,hlen,harr,hin,hout⟩ := h
    have htest := evalB_condLt (evalB_var (by omega : ρ.vars fj < B))
      (evalB_var (by rw [hcnt]; exact hNB : ρ.vars fcnt < B))
    rw [hc,hcnt] at htest
    have hi : ρ.vars fj < N := by simpa using htest.symm
    obtain ⟨j,hjeq⟩ : ∃ j, ρ.vars fj = j := ⟨_,rfl⟩
    rw [hjeq] at hi hj
    have hjB : j < B := by omega
    have hdiv : (Expr.bin .div (.var fj) (.var eR)).evalB B ρ = some (j / e) := by
      have := evalB_bin (op:=.div) (evalB_var (σ:=ρ) (x:=fj) (B:=B) (by rw [hjeq]; exact hjB))
        (evalB_var (σ:=ρ) (x:=eR) (B:=B) (by rw [hee]; exact heB))
        (by simp only [Bop.apply, hee]; rw [hjeq]; exact lt_of_le_of_lt (Nat.div_le_self _ _) hjB)
      simpa [Bop.apply, hee, hjeq] using this
    have hmul : (Expr.bin .mul (.bin .div (.var fj) (.var eR)) (.var eR)).evalB B ρ =
        some (j / e * e) := by
      have := evalB_bin (op:=.mul) hdiv (evalB_var (σ:=ρ) (x:=eR) (B:=B) (by rw [hee]; exact heB))
        (by simp only [Bop.apply, hee]; exact lt_of_le_of_lt (Nat.div_mul_le_self _ _) hjB)
      simpa [Bop.apply, hee, hjeq] using this
    have hsub : (Expr.bin .sub (.var fj) (.bin .mul (.bin .div (.var fj) (.var eR)) (.var eR))).evalB
        B ρ = some (j % e) := by
      have := evalB_bin (op:=.sub) (evalB_var (σ:=ρ) (x:=fj) (B:=B) (by rw [hjeq]; exact hjB)) hmul
        (by simp only [Bop.apply]; omega)
      have hm : j - j / e * e = j % e := by
        have := Nat.div_add_mod j e
        rw [Nat.mul_comm] at this
