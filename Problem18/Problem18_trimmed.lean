namespace Mathproof.Problem18CountedQuadraticCompiler20261001
open Problem18QuadraticExpressionCompiler20261001 Problem18BinaryPower20260930
  Problem18ExplicitFixedCoordinates20261001 Problem18RootQuadraticBasis20261001
  Problem18AllFormatRoot20260930 Problem18UnitaryRootField20260930
  Problem18InvolutionNorm20260930 Problem18BoundedEncoding20260930
variable {K : Type} [Field K] [Fintype K] {q : Nat} {σ : Type*}
def rawCoordinates (θ x : K) (q : Nat) : (K×K)×Nat :=
  let t:=binaryPower θ q
  let u:=binaryPower x q
  let b:=(x-u.1)/(θ-t.1)
  ((x-b*θ,b),t.2+u.2+5)
theorem rawCoordinates_correct (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) (x : K) :
    (rawCoordinates F.generator x q).1=
      (((rootCoordinates F d x).1:K),((rootCoordinates F d x).2:K)) := by
  simp only [rawCoordinates,binaryPower_correct,root_coordinateA_formula,root_coordinateB_formula]
theorem rawCoordinates_cost (θ x : K) (q : Nat) :
    (rawCoordinates θ x q).2≤4*q.size+5 := by
  have ht:=binaryPower_cost θ q
  have hx:=binaryPower_cost x q
  simp only [rawCoordinates]
  omega
def countedCoordinates (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) (x : K) :
    (fixedField d.automorphism×fixedField d.automorphism)×Nat :=
  let z:=rawCoordinates F.generator x q
  ((⟨z.1.1,by rw [show z.1.1=((rootCoordinates F d x).1:K) from
      congrArg (fun p:K×K=>p.1) (rawCoordinates_correct F d x)]; exact (rootCoordinates F d x).1.property⟩,
    ⟨z.1.2,by rw [show z.1.2=((rootCoordinates F d x).2:K) from
      congrArg (fun p:K×K=>p.2) (rawCoordinates_correct F d x)]; exact (rootCoordinates F d x).2.property⟩),z.2)
theorem countedCoordinates_correct (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) (x : K) :
    (countedCoordinates F d x).1=rootCoordinates F d x := by
  apply Prod.ext <;> apply Subtype.ext
  · exact congrArg (fun p:K×K=>p.1) (rawCoordinates_correct F d x)
  · exact congrArg (fun p:K×K=>p.2) (rawCoordinates_correct F d x)
theorem countedCoordinates_cost (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) (x : K) :
    (countedCoordinates F d x).2≤4*q.size+5 := rawCoordinates_cost _ _ _
def countedParameters (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) :
    (fixedField d.automorphism×fixedField d.automorphism)×Nat :=
  let t:=binaryPower F.generator q
  ((⟨F.generator+t.1,by
      change F.generator+(binaryPower F.generator q).1∈fixedField d.automorphism
      simpa only [rootTrace,binaryPower_correct,d.frobenius] using (rootTrace F d).property⟩,
    ⟨-(F.generator*t.1),by
      change -(F.generator*(binaryPower F.generator q).1)∈fixedField d.automorphism
      simpa only [rootNegNorm,binaryPower_correct,d.frobenius] using (rootNegNorm F d).property⟩),t.2+3)
theorem countedParameters_correct (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) :
    (countedParameters F d).1=(rootTrace F d,rootNegNorm F d) := by
  apply Prod.ext <;> apply Subtype.ext
  all_goals simp only [countedParameters,rootTrace,rootNegNorm,binaryPower_correct,d.frobenius]
theorem countedParameters_cost (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) :
    (countedParameters F d).2≤2*q.size+3 := Nat.add_le_add_right (binaryPower_cost _ _) _
def constantLeaves : StarExpr σ K→Nat
  | .const _=>1
  | .var _=>0
  | .add a b=>constantLeaves a+constantLeaves b
  | .mul a b=>constantLeaves a+constantLeaves b
  | .conj a=>constantLeaves a
def compileCore (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q)
    (s t : fixedField d.automorphism) : StarExpr σ K→PairExpr d σ×Nat
  | .const c=>let z:=countedCoordinates F d c; ((.const z.1.1,.const z.1.2),z.2)
  | .var i=>((.var (0,i),.var (1,i)),0)
  | .add a b=>let u:=compileCore F d s t a; let v:=compileCore F d s t b
      ((.add u.1.1 v.1.1,.add u.1.2 v.1.2),u.2+v.2)
  | .mul a b=>let u:=compileCore F d s t a; let v:=compileCore F d s t b
      ((.add (.mul u.1.1 v.1.1) (.mul (.mul (.const t) u.1.2) v.1.2),
        .add (.add (.mul u.1.1 v.1.2) (.mul u.1.2 v.1.1))
          (.mul (.mul (.const s) u.1.2) v.1.2)),u.2+v.2)
  | .conj a=>let u:=compileCore F d s t a
      ((.add u.1.1 (.mul (.const s) u.1.2),PolyExpr.neg u.1.2),u.2)
theorem compileCore_correct (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q)
    (p : StarExpr σ K) :
    (compileCore F d (rootTrace F d) (rootNegNorm F d) p).1=compile F d p := by
  induction p <;> simp_all only [compileCore,compile,countedCoordinates_correct]
theorem compileCore_cost (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q)
    (s t : fixedField d.automorphism) (p : StarExpr σ K) :
    (compileCore F d s t p).2≤ constantLeaves p*(4*q.size+5) := by
  induction p with
  | const c=>simpa only [compileCore,constantLeaves,one_mul] using countedCoordinates_cost F d c
  | var i=>simp [compileCore,constantLeaves]
  | add a b iha ihb=>simpa only [compileCore,constantLeaves,add_mul] using Nat.add_le_add iha ihb
  | mul a b iha ihb=>simpa only [compileCore,constantLeaves,add_mul] using Nat.add_le_add iha ihb
  | conj a ih=>exact ih
def compileCounted (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q)
    (p : StarExpr σ K) : PairExpr d σ×Nat :=
  let z:=countedParameters F d
  let u:=compileCore F d z.1.1 z.1.2 p
  (u.1,z.2+u.2)
theorem compileCounted_correct (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q)
    (p : StarExpr σ K) : (compileCounted F d p).1=compile F d p := by
  simp only [compileCounted,countedParameters_correct,compileCore_correct]
theorem compileCounted_cost (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q)
    (p : StarExpr σ K) :
    (compileCounted F d p).2≤2*q.size+3+constantLeaves p*(4*q.size+5) :=
  Nat.add_le_add (countedParameters_cost F d) (compileCore_cost F d _ _ p)
end Mathproof.Problem18CountedQuadraticCompiler20261001
end
