theorem power_initial_run {B a b c n gram base work : Nat} {sigma : Env}
    {G : Matrix (Fin n) (Fin n) K}
    (h : RuntimeLayout F B a b c n gram base work sigma)
    (hG : Problem18IMPMatrixMemory20261001.matrix F sigma gram n n = G) :
    ∃ rho cost,
      Run B (.seq copyGram (.assign powerCursor (.lit 1))) sigma rho cost ∧
      RuntimeLayout F B a b c n gram base work rho ∧
      PowerInvariant F B n base gram 1 G rho := by
  have he := initial_copy_evals F h
  have hgramB : gram + blockWords F n < B := by
    have hf := h.gram_fit
    have hm := h.packed.valid.memory_word
    omega
  have hbaseFit : base + blockWords F n <=
      (sigma.arrs canonical.mem).length := by
    have hb : blockWords F n <= 2*blockWords F n := by omega
    have hc : 2*blockWords F n <= c*(2*blockWords F n) := by
      have := Nat.mul_le_mul_right (2*blockWords F n) h.c_pos
      simpa using this
    have hp := h.packed.powers_before_work
    have hw := h.packed.work_fit
    omega
  obtain ⟨tau,hcopyRun,hv,hcopy,houtside,hvars⟩ :=
    prepared_copy_valid F (.var gramBase) (.var poweredGramBase) blockSize
      h.packed.valid
      copyGram_independent
      he.1 he.2.1 he.2.2 h.block_word hgramB
      (by have hm := h.packed.valid.memory_word; have hb := hbaseFit; omega) h.gram_before
      h.packed.modulus_before h.gram_fit hbaseFit
  have htau := runtime_of_prepared_copy F (.var gramBase)
    (.var poweredGramBase) blockSize h hv hcopyRun hvars
  have hpow : powerMatrix F n base 0 tau = G := by
    unfold powerMatrix powerAt
    simp only [Nat.zero_mul,Nat.add_zero]
    rw [matrix_of_word_copy F hcopy]
    exact hG
  let rho := tau.setVar powerCursor 1
  have hB1 : 1 < B := by
    have hh := h.packed.valid.arithmetic_word
    have hp := F.prime.two_le
    nlinarith
  have hassign : Run B (.assign powerCursor (.lit 1)) tau rho 2 :=
    Run.assign (evalB_lit hB1)
  have hrho : RuntimeLayout F B a b c n gram base work rho := by
    exact runtime_set_cursor F htau
  have hvalid : ValidMemory F B rho := hrho.packed.valid
  have hgramtau : Problem18IMPMatrixMemory20261001.matrix F tau gram n n = G := by
    rw [matrix_of_word_copy F (src:=gram) (dst:=gram)
      (fun x hx => houtside (gram+x) (Or.inl (by
        have hs := h.gram_before
        omega)))]
    exact hG
  have hgramrho : Problem18IMPMatrixMemory20261001.matrix F rho gram n n = G := by
    change Problem18IMPMatrixMemory20261001.matrix F tau gram n n = G
    exact hgramtau
  have hpowrho : powerMatrix F n base 0 rho = G := by
    change powerMatrix F n base 0 tau = G
    exact hpow
  refine ⟨rho,_,hcopyRun.seq hassign,hrho,?_⟩
  exact invariant_one F hvalid (by simp [rho]) hgramrho hpowrho
def powerCopyCost (F : FieldPresentation K) (n : Nat) : Nat :=
  (Expr.var gramBase).size + (gramCopyAddress (.var powerCursor)).size +
    blockSize.size + 16*blockWords F n + 9
def powerStepCost (F : FieldPresentation K) (n : Nat) : Nat :=
  powerCopyCost F n + installCost +
    Problem18IMPMatrixProductLoop20261001.cost F.e n n n + 4
theorem power_iteration_run {B a b c n gram base work k : Nat}
    {rho : Env} {G : Matrix (Fin n) (Fin n) K}
    (h : RuntimeLayout F B a b c n gram base work rho)
    (hI : PowerInvariant F B n base gram k G rho)
    (hk : 1 <= k) (hkc : k < c) :
    ∃ ups,
      Run B powerBody rho ups (powerStepCost F n) ∧
      RuntimeLayout F B a b c n gram base work ups ∧
      PowerInvariant F B n base gram (k+1) G ups := by
  let block := blockWords F n
  let dest := gramCopyAt F base n k
  let out := powerAt F base n k
  have he := current_copy_evals F h hk hkc hI.cursor_eq
  have hregions := power_regions_order base block k hk
  have houtB : out < B := by
    have hm := Nat.mul_le_mul_right (2*block) (Nat.le_of_lt hkc)
    have hp := h.powers_word
    dsimp [block] at hm hp
    dsimp [out,powerAt,block]
    omega
  have hdestOut : dest + block <= out := by
    have hh := hregions.2
    dsimp [dest,out,powerAt,gramCopyAt,block]
    dsimp [block] at hh
    convert hh using 1 <;> ring
  have hdestB : dest + block < B := hdestOut.trans_lt houtB
  have hgramB : gram + block < B := by
    have hf := h.gram_fit
    have hm := h.packed.valid.memory_word
    omega
  have houtFit : out <= (rho.arrs canonical.mem).length := by
    have hmono := Nat.mul_le_mul_right (2*blockWords F n) (Nat.le_of_lt hkc)
    have hp := h.packed.powers_before_work
    have hw := h.packed.work_fit
    dsimp [out,powerAt,block]
    omega
  have hdestFit : dest + block <= (rho.arrs canonical.mem).length :=
    hdestOut.trans houtFit
  have hbaseDest : base <= dest := by
    dsimp [dest,gramCopyAt,block]
    exact Nat.le_add_right _ _
  have hsep : gram + block <= dest := by
    dsimp [block]
    exact h.gram_before.trans hbaseDest
  have hmodsep : rho.vars canonical.modBase + F.e <= dest :=
    h.packed.modulus_before.trans hbaseDest
  obtain ⟨xi,hcopyRun,hvxi,hcopy,houtside,hcopyVars⟩ :=
    prepared_copy_valid F (.var gramBase)
      (gramCopyAddress (.var powerCursor)) blockSize h.packed.valid
      copyCurrent_independent he.1 he.2.1 he.2.2 h.block_word
      hgramB hdestB hsep hmodsep h.gram_fit hdestFit
  have hxi : RuntimeLayout F B a b c n gram base work xi :=
    runtime_of_prepared_copy F (.var gramBase)
      (gramCopyAddress (.var powerCursor)) blockSize h hvxi hcopyRun hcopyVars
  have hcursorXi : xi.vars powerCursor = k := by
    rw [hcopyVars powerCursor (by decide)]
    exact hI.cursor_eq
  have hinstall := install_product_at_run F hxi hk hkc hcursorXi
  obtain ⟨tau,hprodRun,hvtau,hprod,hmem,hprodVars⟩ :=
    packed_product_run F hxi.packed hk hkc
  have htau : RuntimeLayout F B a b c n gram base work tau :=
    runtime_of_product F hxi hprodRun hvtau hprodVars
  have hprevXi : powerMatrix F n base (k-1) xi =
      powerMatrix F n base (k-1) rho := by
    unfold powerMatrix
    apply matrix_of_word_copy F
    intro x hx
    apply houtside
    left
    have hh := hregions.1
    dsimp [dest,block,powerAt,gramCopyAt] at hh ⊢
    omega
  have hcopied : Problem18IMPMatrixMemory20261001.matrix F xi dest n n = G := by
    rw [matrix_of_word_copy F hcopy]
    exact hI.gram_eq
  have hprod' : powerMatrix F n base k tau =
      powerMatrix F n base (k-1) xi *
        Problem18IMPMatrixMemory20261001.matrix F xi dest n n := by
    unfold powerMatrix
    dsimp [dest,out]
    change Problem18IMPMatrixMemory20261001.matrix F tau (powerAt F base n k) n n =
      Problem18IMPMatrixMemory20261001.matrix F xi (powerAt F base n (k-1)) n n *
        Problem18IMPMatrixMemory20261001.matrix F xi (gramCopyAt F base n k) n n
    change _ = _ at hprod
    exact hprod
  have hnew : powerMatrix F n base k tau =
      powerMatrix F n base (k-1) rho * G := by
    rw [hprod',hprevXi,hcopied]
  have holdTau : ∀ j, j < k →
      powerMatrix F n base j tau = powerMatrix F n base j rho := by
    intro j hj
    have hjle : j <= k-1 := by omega
    have hmono := Nat.mul_le_mul_right (2*block) hjle
    dsimp [block] at hmono
    have hjdest : powerAt F base n j + block <= dest := by
      have hh := hregions.1
      dsimp [block] at hregions
      dsimp [dest,powerAt,gramCopyAt,block] at hh ⊢
      omega
    have hjlen : powerAt F base n j + block <=
        (xi.arrs canonical.mem).length := by
      have hf := hdestFit
      have hlen := (run_frame hcopyRun).2.2.1 canonical.mem
      rw [hlen]
      omega
    have htx : powerMatrix F n base j tau = powerMatrix F n base j xi := by
      unfold powerMatrix
      apply matrix_of_word_copy F
      intro x hx
      apply hmem
      · have := hjlen
        omega
      · have := hjdest
        have := hdestOut
        omega
    have hxr : powerMatrix F n base j xi = powerMatrix F n base j rho := by
      unfold powerMatrix
      apply matrix_of_word_copy F
      intro x hx
      apply houtside
      left
      have := hjdest
      omega
    exact htx.trans hxr
  have hgramTau : Problem18IMPMatrixMemory20261001.matrix F tau gram n n = G := by
    have hgxi : Problem18IMPMatrixMemory20261001.matrix F xi gram n n = G := by
      rw [matrix_of_word_copy F (src:=gram) (dst:=gram)
        (fun x hx => houtside (gram+x) (Or.inl (by
          have hs := hsep
          omega)))]
      exact hI.gram_eq
    rw [matrix_of_word_copy F (src:=gram) (dst:=gram)
      (fun x hx => hmem (gram+x) (by
        have hf := h.gram_fit
        have hlen := (run_frame hcopyRun).2.2.1 canonical.mem
        rw [hlen]
        omega) (by
          have hs := h.gram_before
          dsimp [out,powerAt]
          omega))]
    exact hgxi
  have hcursorTau : tau.vars powerCursor = k := by
    rw [hprodVars powerCursor (by decide)]
    change xi.vars powerCursor = k
    exact hcursorXi
  let ups := tau.setVar powerCursor (k+1)
  have hk1B : k+1 < B := lt_of_le_of_lt (Nat.succ_le_of_lt hkc) h.c_word
  have hinc : Run B (.assign powerCursor
      (.add (.var powerCursor) (.lit 1))) tau ups 4 := by
    apply Run.assign
    have hc0 := evalB_var (B:=B) (x:=powerCursor) (σ:=tau)
      (by rw [hcursorTau]; exact lt_trans hkc h.c_word)
    have hc : (Expr.var powerCursor).evalB B tau = some k := by
      simpa [hcursorTau] using hc0
    exact evalB_bin hc (evalB_lit (by omega)) hk1B
  have hups := runtime_set_cursor F (v:=k+1) htau
  have hgramUps : Problem18IMPMatrixMemory20261001.matrix F ups gram n n = G := by
    change Problem18IMPMatrixMemory20261001.matrix F tau gram n n = G
    exact hgramTau
  have holdUps : ∀j, j<k →
      powerMatrix F n base j ups = powerMatrix F n base j rho := by
    intro j hj
    change powerMatrix F n base j tau = powerMatrix F n base j rho
    exact holdTau j hj
  have hnewUps : powerMatrix F n base k ups =
      powerMatrix F n base (k-1) rho * G := by
    change powerMatrix F n base k tau = _
    exact hnew
  have hIups : PowerInvariant F B n base gram (k+1) G ups :=
    invariant_succ F hk hI hups.packed.valid (by simp [ups]) hgramUps
      holdUps hnewUps
  refine ⟨ups,?_,hups,hIups⟩
  apply (hcopyRun.seq (hinstall.seq (hprodRun.seq hinc))).mono
  simp [powerBody,copyCurrentGram,powerStepCost,powerCopyCost]
  omega
theorem powerProgram_run {B a b c n gram base work : Nat} {sigma : Env}
    {G : Matrix (Fin n) (Fin n) K}
    (h : RuntimeLayout F B a b c n gram base work sigma)
    (hG : Problem18IMPMatrixMemory20261001.matrix F sigma gram n n = G) :
    ∃ tau cost,
      Run B powerProgram sigma tau cost ∧
      RuntimeLayout F B a b c n gram base work tau ∧
      PowerInvariant F B n base gram c G tau := by
  obtain ⟨rho,c0,hinit,hR,hI⟩ := power_initial_run F h hG
  let Inv : Env → Prop := fun z =>
    ∃ k, 1 <= k ∧ k <= c ∧ z.vars powerCursor = k ∧
      RuntimeLayout F B a b c n gram base work z ∧
      PowerInvariant F B n base gram k G z
  let V : Env → Nat := fun z => c-z.vars powerCursor
  have hdef : ∀ z, Inv z →
      ∃ v, (Cond.lt (.var powerCursor) exC).evalB B z = some v := by
    intro z hz
    obtain ⟨k,hk,hkc,hcur,hzR,hzI⟩ := hz
    have ec : (Expr.var powerCursor).evalB B z = some k := by
      have hh := evalB_var (B:=B) (x:=powerCursor) (σ:=z)
        (by rw [hcur]; exact lt_of_le_of_lt hkc hzR.c_word)
      simpa [hcur] using hh
    have eC : exC.evalB B z = some c := by
      simpa [exC,evalB_var_iff,hzR.dimC_eq] using hzR.c_word
    exact ⟨decide (k<c),evalB_condLt ec eC⟩
  have hstep : ∀ z, Inv z →
      (Cond.lt (.var powerCursor) exC).evalB B z = some true →
      ∃ w, Run B powerBody z w (powerStepCost F n) ∧ Inv w ∧ V w < V z := by
    intro z hz hcond
    obtain ⟨k,hk,hkc,hcur,hzR,hzI⟩ := hz
    have ec : (Expr.var powerCursor).evalB B z = some k := by
      have hh := evalB_var (B:=B) (x:=powerCursor) (σ:=z)
        (by rw [hcur]; exact lt_of_le_of_lt hkc hzR.c_word)
      simpa [hcur] using hh
    have eC : exC.evalB B z = some c := by
      simpa [exC,evalB_var_iff,hzR.dimC_eq] using hzR.c_word
    have ht := evalB_condLt ec eC
    rw [hcond] at ht
    have hlt : k<c := by simpa using ht.symm
    obtain ⟨w,hrw,hwR,hwI⟩ := power_iteration_run F hzR hzI hk hlt
    refine ⟨w,hrw,?_,?_⟩
    · exact ⟨k+1,by omega,by omega,hwI.cursor_eq,hwR,hwI⟩
    · dsimp [V]
      rw [hwI.cursor_eq,hcur]
      omega
  have hInvRho : Inv rho := ⟨1,by omega,h.c_pos,hI.cursor_eq,hR,hI⟩
  obtain ⟨tau,hloop,hTau,hfalse⟩ :=
    Run.while_count Inv V (powerStepCost F n) hdef hstep hInvRho
  obtain ⟨k,hk,hkc,hcur,hTR,hTI⟩ := hTau
  have ec : (Expr.var powerCursor).evalB B tau = some k := by
    have hh := evalB_var (B:=B) (x:=powerCursor) (σ:=tau)
      (by rw [hcur]; exact lt_of_le_of_lt hkc hTR.c_word)
    simpa [hcur] using hh
  have eC : exC.evalB B tau = some c := by
    simpa [exC,evalB_var_iff,hTR.dimC_eq] using hTR.c_word
  have ht := evalB_condLt ec eC
  rw [hfalse] at ht
  have hkcEq : k=c := by
    have hnlt : ¬k<c := by simpa using ht.symm
    omega
  have hTIc : PowerInvariant F B n base gram c G tau := by
    rw [←hkcEq]
    exact hTI
  let loopCost :=
    (1 + (Cond.lt (.var powerCursor) exC).size + powerStepCost F n) * V rho +
      1 + (Cond.lt (.var powerCursor) exC).size
  refine ⟨tau,c0+loopCost,?_,hTR,hTIc⟩
  dsimp [loopCost]
  simpa [powerProgram] using
    Problem18IMPMatrixProductStep20261001.run_seq_assoc (hinit.seq hloop)
def powerInitialCost (n : Nat) : Nat :=
  ((Expr.var gramBase).size + (Expr.var poweredGramBase).size + blockSize.size +
    16*blockWords F n + 9) + 2
def powerProgramCost (n c : Nat) : Nat :=
  powerInitialCost F n +
    ((1 + (Cond.lt (.var powerCursor) exC).size + powerStepCost F n) * (c-1) +
      1 + (Cond.lt (.var powerCursor) exC).size)
def NativeFrame (n c base work : Nat) (sigma tau : Env) : Prop :=
  ∀ j < (sigma.arrs canonical.mem).length,
    (j < base ∨ base + c*(2*blockWords F n) ≤ j) →
    (j < work ∨ work + 3*F.e ≤ j) →
    (tau.arrs canonical.mem).getD j 0 = (sigma.arrs canonical.mem).getD j 0
theorem nativeFrame_trans {n c base work : Nat} {sigma tau ups : Env}
    (h1 : NativeFrame F n c base work sigma tau)
    (h2 : NativeFrame F n c base work tau ups)
    (hlen : (tau.arrs canonical.mem).length = (sigma.arrs canonical.mem).length) :
    NativeFrame F n c base work sigma ups := by
  intro j hj hp hw
  rw [h2 j (by rw [hlen]; exact hj) hp hw]
  exact h1 j hj hp hw
theorem packed_product_frame {B n c base work k t : Nat} {sigma tau : Env}
    (h : PowerLayout F B n c base work sigma) (hk : 1 <= k) (hkc : k < c)
    (hr : Run B Problem18IMPMatrixProductLoop20261001.routine
      (productInstalled sigma (powerAt F base n (k-1)) (gramCopyAt F base n k)
        (powerAt F base n k) n work) tau t)
    (j : Nat) (hj : j < (sigma.arrs canonical.mem).length)
    (hout : j < powerAt F base n k ∨ powerAt F base n k + F.e*(n*n) ≤ j)
    (hwork : j < work ∨ work + 3*F.e ≤ j) :
    (tau.arrs canonical.mem).getD j 0 = (sigma.arrs canonical.mem).getD j 0 := by
  have P := packed_at F h hk hkc
  have he := F.degree_pos
  have hm := P.valid.memory_word
  have ha := P.matrix_before
  have hb := P.vector_before
  have ho := P.output_before
  have hw := P.work_fit
  have hA : (productInstalled sigma (powerAt F base n (k-1)) (gramCopyAt F base n k)
      (powerAt F base n k) n work).vars canonical.aBase < B := by nlinarith
  have hB : (productInstalled sigma (powerAt F base n (k-1)) (gramCopyAt F base n k)
      (powerAt F base n k) n work).vars canonical.bBase < B := by nlinarith
  have hO : (productInstalled sigma (powerAt F base n (k-1)) (gramCopyAt F base n k)
      (powerAt F base n k) n work).vars canonical.outBase < B := by nlinarith
  have hW : (productInstalled sigma (powerAt F base n (k-1)) (gramCopyAt F base n k)
      (powerAt F base n k) n work).vars Problem18IMPMatrixProductLoop20261001.workBase
      + 2*F.e < B := by nlinarith
  have hrows : (productInstalled sigma (powerAt F base n (k-1)) (gramCopyAt F base n k)
      (powerAt F base n k) n work).vars Problem18IMPMatrixProductLoop20261001.rows < B := by
    rw [P.rows_eq]; exact P.n_word
  have hcols : (productInstalled sigma (powerAt F base n (k-1)) (gramCopyAt F base n k)
      (powerAt F base n k) n work).vars Problem18IMPMatrixProductLoop20261001.columns < B := by
    rw [P.cols_eq]; exact P.n_word
  have htotal : (productInstalled sigma (powerAt F base n (k-1)) (gramCopyAt F base n k)
      (powerAt F base n k) n work).vars Problem18IMPMatrixProductLoop20261001.rows *
      (productInstalled sigma (powerAt F base n (k-1)) (gramCopyAt F base n k)
      (powerAt F base n k) n work).vars Problem18IMPMatrixProductLoop20261001.columns < B := by
    rw [P.rows_eq, P.cols_eq]; exact P.square_word
  have hmem0 : (productInstalled sigma (powerAt F base n (k-1)) (gramCopyAt F base n k)
      (powerAt F base n k) n work).arrs canonical.mem = sigma.arrs canonical.mem := by
    simp [productInstalled,productS6,productS5,productS4,productS3,productS2,productS1,
      Env.setVar]
  have hout0 : (productInstalled sigma (powerAt F base n (k-1)) (gramCopyAt F base n k)
      (powerAt F base n k) n work).vars canonical.outBase = powerAt F base n k := by
    simp [productInstalled,productS6,productS5,productS4,productS3,productS2,productS1,
      canonical,Problem18IMPMatrixProductLoop20261001.rows,
      Problem18IMPMatrixProductLoop20261001.columns,count,
      Problem18IMPMatrixProductLoop20261001.workBase]
  have hwork0 : (productInstalled sigma (powerAt F base n (k-1)) (gramCopyAt F base n k)
      (powerAt F base n k) n work).vars Problem18IMPMatrixProductLoop20261001.workBase
      = work := by
    simp [productInstalled,productS6,productS5,productS4,productS3,productS2,productS1,
      canonical,Problem18IMPMatrixProductLoop20261001.rows,
      Problem18IMPMatrixProductLoop20261001.columns,count,
      Problem18IMPMatrixProductLoop20261001.workBase]
  have hfr := Problem18IMPMatrixProductFrame20261001.routine_memory_frame F P.valid.degree
    hA hB hO hW hrows hcols htotal
    (Problem18IMPAlgebraProductLayout20261001.packed_loopInput F P) hr j
    (by rw [hmem0]; exact hj)
    (by rw [hout0, P.rows_eq, P.cols_eq]; exact hout)
    (by rw [hwork0]; exact hwork)
  rw [hfr, hmem0]
theorem power_initial_run_frame {B a b c n gram base work : Nat} {sigma : Env}
    {G : Matrix (Fin n) (Fin n) K}
    (h : RuntimeLayout F B a b c n gram base work sigma)
    (hG : Problem18IMPMatrixMemory20261001.matrix F sigma gram n n = G) :
    ∃ rho,
      Run B (.seq copyGram (.assign powerCursor (.lit 1))) sigma rho
        (powerInitialCost F n) ∧
      RuntimeLayout F B a b c n gram base work rho ∧
      PowerInvariant F B n base gram 1 G rho ∧
      NativeFrame F n c base work sigma rho ∧
      (rho.arrs canonical.mem).length = (sigma.arrs canonical.mem).length := by
  have he := initial_copy_evals F h
  have hgramB : gram + blockWords F n < B := by
    have hf := h.gram_fit
    have hm := h.packed.valid.memory_word
    omega
  have hbaseFit : base + blockWords F n <=
      (sigma.arrs canonical.mem).length := by
    have hb : blockWords F n <= 2*blockWords F n := by omega
    have hc : 2*blockWords F n <= c*(2*blockWords F n) := by
      have := Nat.mul_le_mul_right (2*blockWords F n) h.c_pos
      simpa using this
    have hp := h.packed.powers_before_work
    have hw := h.packed.work_fit
    omega
  obtain ⟨tau,hcopyRun,hv,hcopy,houtside,hvars⟩ :=
    prepared_copy_valid F (.var gramBase) (.var poweredGramBase) blockSize
      h.packed.valid
      copyGram_independent
      he.1 he.2.1 he.2.2 h.block_word hgramB
      (by have hm := h.packed.valid.memory_word; have hb := hbaseFit; omega) h.gram_before
      h.packed.modulus_before h.gram_fit hbaseFit
  have htau := runtime_of_prepared_copy F (.var gramBase)
    (.var poweredGramBase) blockSize h hv hcopyRun hvars
  have hpow : powerMatrix F n base 0 tau = G := by
    unfold powerMatrix powerAt
    simp only [Nat.zero_mul,Nat.add_zero]
    rw [matrix_of_word_copy F hcopy]
    exact hG
  let rho := tau.setVar powerCursor 1
  have hB1 : 1 < B := by
    have hh := h.packed.valid.arithmetic_word
    have hp := F.prime.two_le
    nlinarith
  have hassign : Run B (.assign powerCursor (.lit 1)) tau rho 2 :=
    Run.assign (evalB_lit hB1)
  have hrho : RuntimeLayout F B a b c n gram base work rho := by
    exact runtime_set_cursor F htau
  have hvalid : ValidMemory F B rho := hrho.packed.valid
  have hgramtau : Problem18IMPMatrixMemory20261001.matrix F tau gram n n = G := by
    rw [matrix_of_word_copy F (src:=gram) (dst:=gram)
      (fun x hx => houtside (gram+x) (Or.inl (by
        have hs := h.gram_before
        omega)))]
    exact hG
  have hgramrho : Problem18IMPMatrixMemory20261001.matrix F rho gram n n = G := by
    change Problem18IMPMatrixMemory20261001.matrix F tau gram n n = G
    exact hgramtau
  have hpowrho : powerMatrix F n base 0 rho = G := by
    change powerMatrix F n base 0 tau = G
    exact hpow
  refine ⟨rho,?_,hrho,?_,?_,?_⟩
  · exact (hcopyRun.seq hassign).mono (by unfold powerInitialCost; omega)
  · exact invariant_one F hvalid (by simp [rho]) hgramrho hpowrho
  · intro j _ hp _
    change (tau.arrs canonical.mem).getD j 0 = _
    apply houtside
    rcases hp with hp | hp
    · exact Or.inl hp
    · right
      have hc1 : 1*(2*blockWords F n) ≤ c*(2*blockWords F n) :=
        Nat.mul_le_mul_right _ h.c_pos
      omega
  · exact (run_frame hcopyRun).2.2.1 canonical.mem
theorem power_iteration_run_frame {B a b c n gram base work k : Nat}
    {rho : Env} {G : Matrix (Fin n) (Fin n) K}
    (h : RuntimeLayout F B a b c n gram base work rho)
    (hI : PowerInvariant F B n base gram k G rho)
    (hk : 1 <= k) (hkc : k < c) :
    ∃ ups,
      Run B powerBody rho ups (powerStepCost F n) ∧
      RuntimeLayout F B a b c n gram base work ups ∧
      PowerInvariant F B n base gram (k+1) G ups ∧
      NativeFrame F n c base work rho ups ∧
      (ups.arrs canonical.mem).length = (rho.arrs canonical.mem).length := by
  let block := blockWords F n
  let dest := gramCopyAt F base n k
  let out := powerAt F base n k
  have he := current_copy_evals F h hk hkc hI.cursor_eq
  have hregions := power_regions_order base block k hk
  have houtB : out < B := by
    have hm := Nat.mul_le_mul_right (2*block) (Nat.le_of_lt hkc)
    have hp := h.powers_word
    dsimp [block] at hm hp
    dsimp [out,powerAt,block]
    omega
  have hdestOut : dest + block <= out := by
    have hh := hregions.2
    dsimp [dest,out,powerAt,gramCopyAt,block]
    dsimp [block] at hh
    convert hh using 1 <;> ring
  have hdestB : dest + block < B := hdestOut.trans_lt houtB
  have hgramB : gram + block < B := by
    have hf := h.gram_fit
    have hm := h.packed.valid.memory_word
    omega
  have houtFit : out <= (rho.arrs canonical.mem).length := by
    have hmono := Nat.mul_le_mul_right (2*blockWords F n) (Nat.le_of_lt hkc)
    have hp := h.packed.powers_before_work
    have hw := h.packed.work_fit
    dsimp [out,powerAt,block]
    omega
  have hdestFit : dest + block <= (rho.arrs canonical.mem).length :=
    hdestOut.trans houtFit
  have hbaseDest : base <= dest := by
    dsimp [dest,gramCopyAt,block]
    exact Nat.le_add_right _ _
  have hsep : gram + block <= dest := by
    dsimp [block]
    exact h.gram_before.trans hbaseDest
  have hmodsep : rho.vars canonical.modBase + F.e <= dest :=
    h.packed.modulus_before.trans hbaseDest
  obtain ⟨xi,hcopyRun,hvxi,hcopy,houtside,hcopyVars⟩ :=
    prepared_copy_valid F (.var gramBase)
      (gramCopyAddress (.var powerCursor)) blockSize h.packed.valid
      copyCurrent_independent he.1 he.2.1 he.2.2 h.block_word
      hgramB hdestB hsep hmodsep h.gram_fit hdestFit
  have hxi : RuntimeLayout F B a b c n gram base work xi :=
    runtime_of_prepared_copy F (.var gramBase)
      (gramCopyAddress (.var powerCursor)) blockSize h hvxi hcopyRun hcopyVars
  have hcursorXi : xi.vars powerCursor = k := by
    rw [hcopyVars powerCursor (by decide)]
    exact hI.cursor_eq
  have hinstall := install_product_at_run F hxi hk hkc hcursorXi
  obtain ⟨tau,hprodRun,hvtau,hprod,hmem,hprodVars⟩ :=
    packed_product_run F hxi.packed hk hkc
  have htau : RuntimeLayout F B a b c n gram base work tau :=
    runtime_of_product F hxi hprodRun hvtau hprodVars
  have hprevXi : powerMatrix F n base (k-1) xi =
      powerMatrix F n base (k-1) rho := by
    unfold powerMatrix
    apply matrix_of_word_copy F
    intro x hx
    apply houtside
    left
    have hh := hregions.1
    dsimp [dest,block,powerAt,gramCopyAt] at hh ⊢
    omega
  have hcopied : Problem18IMPMatrixMemory20261001.matrix F xi dest n n = G := by
    rw [matrix_of_word_copy F hcopy]
    exact hI.gram_eq
  have hprod' : powerMatrix F n base k tau =
      powerMatrix F n base (k-1) xi *
        Problem18IMPMatrixMemory20261001.matrix F xi dest n n := by
    unfold powerMatrix
    dsimp [dest,out]
    change Problem18IMPMatrixMemory20261001.matrix F tau (powerAt F base n k) n n =
      Problem18IMPMatrixMemory20261001.matrix F xi (powerAt F base n (k-1)) n n *
        Problem18IMPMatrixMemory20261001.matrix F xi (gramCopyAt F base n k) n n
