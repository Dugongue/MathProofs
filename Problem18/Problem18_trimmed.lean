theorem degree_one_of_split_residue
    (E S L : Type*) [Field E] [CommRing S] [IsDomain S] [IsDedekindDomain S] [Field L]
    [Algebra E S] [Algebra E L] [Algebra S L] [IsScalarTower E S L] [IsFractionRing S L]
    (q : HeightOneSpectrum S) (Q : Place E L)
    (hQ : Q.toValuationSubring = (q.valuation L).valuationSubring)
    (hs : Function.Surjective ((Ideal.Quotient.mk q.asIdeal).comp (algebraMap E S))) :
    Q.degree = 1 := by
  let V := HeightOneSpectrum.valuationSubringAtPrime L q
  let j : S →+* Q.toValuationSubring := (algebraMap S L).codRestrict _ fun s => by
    rw [hQ]
    exact q.valuation_le_one s
  letI : Algebra S Q.toValuationSubring := j.toAlgebra
  letI : IsScalarTower E S Q.toValuationSubring := IsScalarTower.of_algebraMap_eq fun c => by
    apply Subtype.ext
    exact IsScalarTower.algebraMap_apply E S L c
  let e : V ≃ₐ[S] Q.toValuationSubring :=
    { __ := RingEquiv.subringCongr (congrArg ValuationSubring.toSubring
        ((HeightOneSpectrum.valuationSubringAtPrime_eq_valuationSubring q).trans hQ.symm))
      commutes' := fun _ => rfl }
  letI : IsLocalization.AtPrime Q.toValuationSubring q.asIdeal :=
    IsLocalization.isLocalization_of_algEquiv q.asIdeal.primeCompl e
  let f := IsLocalization.AtPrime.equivQuotMaximalIdeal q.asIdeal Q.toValuationSubring
  apply (degree_one_iff_surjective Q).mpr
  intro y
  obtain ⟨z,rfl⟩ := f.surjective y
  obtain ⟨c,rfl⟩ := hs z
  refine ⟨c,?_⟩
  change algebraMap E Q.residueField c =
    Ideal.Quotient.mk _ (algebraMap S Q.toValuationSubring (algebraMap E S c))
  rw [← IsScalarTower.algebraMap_apply E S Q.toValuationSubring]
  rfl
