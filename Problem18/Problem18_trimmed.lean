open Problem18IMPModularArithmetic20261001 Problem18AllFormatRoot20260930
def storedBuffer (r : FieldNames) (σ : Env) (n : Nat) (f : Nat→Nat) : Env :=
  pointState (σ.setVar r.k (n*σ.vars r.e)) (workNames r) f (σ.vars r.e)
theorem storedBuffer_vars (r : FieldNames) (σ : Env) (n : Nat) (f : Nat→Nat)
    (x : String) (hk : x≠r.k) (hj : x≠r.j) :
    (storedBuffer r σ n f).vars x=σ.vars x := by simp [storedBuffer,pointState,workNames,hk,hj]
theorem storedBuffer_lengths (r : FieldNames) (σ : Env) (n : Nat) (f : Nat→Nat) (arr : String) :
    ((storedBuffer r σ n f).arrs arr).length=(σ.arrs arr).length :=
  pointState_array_length _ _ _ _ _
theorem storedBuffer_memory (r : FieldNames) (σ : Env) (n : Nat) (f : Nat→Nat)
    (hsep : r.mem≠r.scratch) : (storedBuffer r σ n f).arrs r.mem=σ.arrs r.mem := by
  simp [storedBuffer,pointState,workNames,hsep]
theorem storedBuffer_output (r : FieldNames) (σ : Env) (n : Nat) (f : Nat→Nat)
    (hfit : n*σ.vars r.e+σ.vars r.e ≤ (σ.arrs r.scratch).length) {j : Nat}
    (hj : j<σ.vars r.e) :
    ((storedBuffer r σ n f).arrs r.scratch).getD (n*σ.vars r.e+j) 0=f j := by
  simpa [storedBuffer,pointState,workNames] using
    writeValues_inside (σ.arrs r.scratch) (n*σ.vars r.e) (σ.vars r.e) j f hfit hj
theorem storedBuffer_read (r : FieldNames) (σ : Env) (n : Nat) (f : Nat→Nat)
    (arr : String) (j : Nat) (hj : j<(σ.arrs arr).length)
    (hsep : arr≠r.scratch ∨ j<n*σ.vars r.e ∨ n*σ.vars r.e+σ.vars r.e ≤ j) :
    ((storedBuffer r σ n f).arrs arr).getD j 0=(σ.arrs arr).getD j 0 := by
  apply pointState_read_preserved (workNames r) (σ.setVar r.k (n*σ.vars r.e)) f _ j arr hj
  simpa [workNames] using hsep
theorem bufferStore_run (r : FieldNames) {B : Nat} (σ : Env) (n : Nat) (rhs : Expr) (f : Nat→Nat)
    (he : r.e≠r.k) (hej : r.e≠r.j) (hkj : r.k≠r.j)
    (hew : σ.vars r.e<B) (hn : n<B) (hprod : n*σ.vars r.e<B)
    (hsw : (σ.arrs r.scratch).length<B)
    (hfit : n*σ.vars r.e+σ.vars r.e ≤ (σ.arrs r.scratch).length)
    (hval : ∀j<σ.vars r.e,rhs.evalB B
      (pointState (σ.setVar r.k (n*σ.vars r.e)) (workNames r) f j)=some (f j)) :
    Run B (bufferStore r n rhs) σ (storedBuffer r σ n f)
      ((rhs.size+20)*(σ.vars r.e+1)) := by
  have ha:=Run.assign (x:=r.k) (σ:=σ)
    (evalB_bin (op:=Bop.mul) (evalB_lit hn) (evalB_var hew) hprod)
  have heq:(σ.setVar r.k (n*σ.vars r.e)).vars (workNames r).e=σ.vars r.e:=by
    simp [workNames,he]
  have hr:=storeLoop_run (workNames r) rhs (B:=B) (σ.setVar r.k (n*σ.vars r.e)) f
    hkj hej (by simpa only [heq] using hew) hsw
    (by simpa [workNames,he] using hfit)
    (by simpa only [heq] using hval)
  rw [heq] at hr
  apply (ha.seq hr).mono
  simp only [Expr.size]
  nlinarith
structure PowerInput {K : Type} [Field K] (F : FieldPresentation K)
    (r : FieldNames) (B : Nat) (σ : Env) : Prop where
  degree : σ.vars r.e=F.e
  prime : σ.vars r.p=F.p
  separate : r.mem≠r.scratch
  outer_names : (scalarNames r).Nodup
  inner_names : (scalarNames (innerNames r)).Nodup
  private_names : PrivateNames r
  arithmetic_word : (F.p+1)^2<B
  memory_word : (σ.arrs r.mem).length<B
  scratch_word : (σ.arrs r.scratch).length<B
  scratch_fit : 5*F.e ≤ (σ.arrs r.scratch).length
  modulus_fit : σ.vars r.modBase+F.e ≤ (σ.arrs r.mem).length
  modulus_value : ∀i:Fin F.e,sourceCoeff σ r.mem r.modBase i.val=(F.modulus i).val
  first_fit : σ.vars r.aBase+F.e ≤ (σ.arrs r.mem).length
  first_canonical : ∀i:Fin F.e,sourceCoeff σ r.mem r.aBase i.val<F.p
  output_fit : σ.vars r.outBase+F.e ≤ (σ.arrs r.mem).length
variable {K : Type} [Field K] {F : FieldPresentation K}
variable {r : FieldNames} {B : Nat} {σ : Env}
theorem PowerInput.buffer_preserves (h : PowerInput F r B σ) (n : Nat) (f : Nat→Nat) :
    PowerInput F r B (storedBuffer r σ n f) := by
  have hh:=h.outer_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hv (x : String) (hx : x∈[r.p,r.e,r.modBase,r.aBase,r.outBase]):
      (storedBuffer r σ n f).vars x=σ.vars x := by
    apply storedBuffer_vars
    all_goals simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hx
    all_goals rcases hx with rfl|rfl|rfl|rfl|rfl <;> tauto
  have hm:=storedBuffer_memory r σ n f h.separate
  refine {
    degree:=(hv r.e (by simp)).trans h.degree,
    prime:=(hv r.p (by simp)).trans h.prime,separate:=h.separate,
    outer_names:=h.outer_names,inner_names:=h.inner_names,private_names:=h.private_names,
    arithmetic_word:=h.arithmetic_word,memory_word:=?_,scratch_word:=?_,scratch_fit:=?_,
    modulus_fit:=?_,modulus_value:=?_,first_fit:=?_,first_canonical:=?_,output_fit:=?_ }
  · rw [storedBuffer_lengths]; exact h.memory_word
  · rw [storedBuffer_lengths]; exact h.scratch_word
  · rw [storedBuffer_lengths]; exact h.scratch_fit
  · rw [hv r.modBase (by simp),hm]; exact h.modulus_fit
  · intro i; unfold sourceCoeff; rw [hv r.modBase (by simp),hm]; exact h.modulus_value i
  · rw [hv r.aBase (by simp),hm]; exact h.first_fit
  · intro i; unfold sourceCoeff; rw [hv r.aBase (by simp),hm]; exact h.first_canonical i
  · rw [hv r.outBase (by simp),hm]; exact h.output_fit
theorem PowerInput.setExponent (h : PowerInput F r B σ) (n : Nat) :
    PowerInput F r B (σ.setVar r.exponent n) := by
  have hh:=h.outer_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have he:r.e≠r.exponent:=by tauto
  have hp:r.p≠r.exponent:=by tauto
  have hm:r.modBase≠r.exponent:=by tauto
  have ha:r.aBase≠r.exponent:=by tauto
  have ho:r.outBase≠r.exponent:=by tauto
  refine {
    degree:=?_,prime:=?_,separate:=h.separate,outer_names:=h.outer_names,
    inner_names:=h.inner_names,private_names:=h.private_names,arithmetic_word:=h.arithmetic_word,
    memory_word:=h.memory_word,scratch_word:=h.scratch_word,scratch_fit:=h.scratch_fit,
    modulus_fit:=?_,modulus_value:=?_,first_fit:=?_,first_canonical:=?_,output_fit:=?_ }
  · simpa [he] using h.degree
  · simpa [hp] using h.prime
  · simpa [hm] using h.modulus_fit
  · intro i; simpa [sourceCoeff,hm] using h.modulus_value i
  · simpa [ha] using h.first_fit
  · intro i; simpa [sourceCoeff,ha] using h.first_canonical i
  · simpa [ho] using h.output_fit
theorem PowerInput.inputBuffer_run (h : PowerInput F r B σ) :
    Run B (bufferStore r 2 (.get r.mem (address r.aBase r.j))) σ
      (storedBuffer r σ 2 (sourceCoeff σ r.mem r.aBase)) (100*(F.e+1)) := by
  have hh:=h.outer_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hek:r.e≠r.k:=by tauto
  have hej:r.e≠r.j:=by tauto
  have hkj:r.k≠r.j:=by tauto
  have hak:r.aBase≠r.k:=by tauto
  have haj:r.aBase≠r.j:=by tauto
  have hf:=h.scratch_fit
  have hw:=h.scratch_word
  have he:=F.degree_pos
  have hp:F.p<B:=by have hh:=h.arithmetic_word; nlinarith
  have hr:=bufferStore_run r (B:=B) σ 2 (.get r.mem (address r.aBase r.j))
    (sourceCoeff σ r.mem r.aBase) hek hej hkj
    (by rw [h.degree]; omega) (by omega) (by rw [h.degree]; omega) h.scratch_word
    (by rw [h.degree]; omega) (by
      intro j hj
      let ξ:=σ.setVar r.k (2*σ.vars r.e)
      let f:=sourceCoeff σ r.mem r.aBase
      let τ:=pointState ξ (workNames r) f j
      have hav:τ.vars r.aBase=σ.vars r.aBase:=by simp [τ,ξ,pointState,workNames,hak,haj]
      have hjv:τ.vars r.j=j:=by simp [τ,pointState,workNames]
      have hidx:σ.vars r.aBase+j<(σ.arrs r.mem).length:=by
        have hfit:=h.first_fit; rw [h.degree] at hj; omega
      have hidxB:σ.vars r.aBase+j<B:=hidx.trans h.memory_word
      have hi:(address r.aBase r.j).evalB B τ=some (σ.vars r.aBase+j):=by
        have hleft:(Expr.var r.aBase).evalB B τ=some (σ.vars r.aBase):=by
          simpa only [hav] using evalB_var (σ:=τ) (x:=r.aBase) (by rw [hav]; omega)
        have hright:(Expr.var r.j).evalB B τ=some j:=by
          simpa only [hjv] using evalB_var (σ:=τ) (x:=r.j) (by rw [hjv]; omega)
        exact evalB_bin (op:=Bop.add) hleft hright hidxB
      have hv:(σ.arrs r.mem).getD (σ.vars r.aBase+j) 0<B:=
        (h.first_canonical ⟨j,by simpa only [h.degree] using hj⟩).trans hp
      have ht:=pointState_get_evalB (workNames r) ξ f r.mem (address r.aBase r.j) hi hidx
        (Or.inl h.separate) hv
      simpa only [sourceCoeff, ξ, f, arrs_setVar] using ht)
  apply hr.mono
  simp only [address,Expr.size,h.degree]
  omega
def fillExpr (r : FieldNames) (identity : Bool) : Expr :=
  if identity then .sub (.lit 1) (.var r.j) else .lit 0
def fillValue (identity : Bool) (j : Nat) : Nat := if identity then 1-j else 0
theorem PowerInput.fillBuffer_run (h : PowerInput F r B σ) {n : Nat}
    (hn : n∈[3,4]) (identity : Bool) :
    Run B (bufferStore r n (fillExpr r identity)) σ
      (storedBuffer r σ n (fillValue identity)) (100*(F.e+1)) := by
  have hh:=h.outer_names
  simp only [scalarNames,List.nodup_cons,List.mem_cons,not_or] at hh
  have hek:r.e≠r.k:=by tauto
  have hej:r.e≠r.j:=by tauto
  have hkj:r.k≠r.j:=by tauto
  have hnb:3≤n ∧ n≤4:=by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hn; omega
  have hf:=h.scratch_fit
  have hw:=h.scratch_word
  have he:=F.degree_pos
  have h1:1<B:=by omega
  have hr:=bufferStore_run r (B:=B) σ n (fillExpr r identity) (fillValue identity) hek hej hkj
    (by rw [h.degree]; omega) (by omega) (by rw [h.degree]; nlinarith) h.scratch_word
    (by rw [h.degree]; nlinarith) (by
      intro j hj
      let τ:=pointState (σ.setVar r.k (n*σ.vars r.e)) (workNames r) (fillValue identity) j
      have hjv:τ.vars r.j=j:=by simp [τ,pointState,workNames]
      have hjB:j<B:=by rw [h.degree] at hj; omega
      cases identity
      · exact evalB_lit (by omega)
      · have hright:(Expr.var r.j).evalB B τ=some j:=by
          simpa only [hjv] using evalB_var (σ:=τ) (x:=r.j) (by rw [hjv]; exact hjB)
        exact evalB_bin (op:=Bop.sub) (evalB_lit h1) hright (by change 1-j<B; omega))
  apply hr.mono
  cases identity <;> simp [fillExpr,Expr.size,h.degree] <;> omega
theorem PowerInput.stored_same (h : PowerInput F r B σ) {n : Nat}
    (hn : n∈[2,3,4]) (f : Nat→Nat) :
    bufferCoeffs F r (storedBuffer r σ n f) n=fun i=>f i.val := by
  have hnb:2≤n ∧ n≤4:=by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hn; omega
  funext i
  have hh:=storedBuffer_output r σ n f
    (by rw [h.degree]; have hf:=h.scratch_fit; nlinarith)
    (j:=i.val) (by simpa only [h.degree] using i.isLt)
  simpa only [bufferCoeffs,h.degree] using hh
theorem PowerInput.stored_other (h : PowerInput F r B σ) {n k : Nat}
    (hn : n∈[2,3,4]) (hk : k≠n) (f : Nat→Nat) :
    bufferCoeffs F r (storedBuffer r σ k f) n=bufferCoeffs F r σ n := by
  have hnb:2≤n ∧ n≤4:=by simp only [List.mem_cons,List.mem_singleton,List.not_mem_nil,or_false] at hn; omega
  funext i
  apply storedBuffer_read r σ k f r.scratch (n*F.e+i.val)
  · have hf:=h.scratch_fit; have hi:=i.isLt; nlinarith
  · right
    rw [h.degree]
    have hi:=i.isLt
    rcases lt_or_gt_of_ne hk with hl|hl
    · right; nlinarith
    · left; nlinarith
def expState (r : FieldNames) (σ : Env) (n : Nat) : Env := σ.setVar r.exponent n
def baseState (r : FieldNames) (σ : Env) (n : Nat) : Env :=
  storedBuffer r (expState r σ n) 2 (sourceCoeff (expState r σ n) r.mem r.aBase)
def oneState (r : FieldNames) (σ : Env) (n : Nat) : Env :=
  storedBuffer r (baseState r σ n) 3 (fillValue true)
def initialState (r : FieldNames) (σ : Env) (n : Nat) : Env :=
  storedBuffer r (oneState r σ n) 4 (fillValue false)
theorem PowerInput.expState (h : PowerInput F r B σ) (n : Nat) :
    PowerInput F r B (expState r σ n) := h.setExponent n
theorem PowerInput.baseState (h : PowerInput F r B σ) (n : Nat) :
    PowerInput F r B (baseState r σ n) := (h.expState n).buffer_preserves _ _
theorem PowerInput.oneState (h : PowerInput F r B σ) (n : Nat) :
    PowerInput F r B (oneState r σ n) := (h.baseState n).buffer_preserves _ _
theorem PowerInput.initialState (h : PowerInput F r B σ) (n : Nat) :
    PowerInput F r B (initialState r σ n) := (h.oneState n).buffer_preserves _ _
theorem initialState_vars (r : FieldNames) (σ : Env) (n : Nat) (x : String)
    (hk : x≠r.k) (hj : x≠r.j) (he : x≠r.exponent) :
    (initialState r σ n).vars x=σ.vars x := by
  simp only [initialState,oneState,baseState,storedBuffer_vars r _ _ _ x hk hj]
  simp [expState,he]
theorem initialState_exponent (h : PowerInput F r B σ) (n : Nat) :
    (initialState r σ n).vars r.exponent=n := by
