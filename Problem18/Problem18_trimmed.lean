theorem commit_program (r : FieldNames) :
    storeLoop (workNames r) (.get r.scratch (.add (.var r.e) (.var r.j)))=
      pointRoutine (commitNames r) .copy := rfl
def iterLead (r : FieldNames) (σ : Env) : Env :=
  σ.setVar r.value ((σ.arrs r.scratch).getD (σ.vars r.e-1) 0)
def iterStart (r : FieldNames) (σ : Env) : Env :=
  (iterLead r σ).setVar r.k (σ.vars r.e)
def iterNext (r : FieldNames) (modArray : String) (σ : Env) : Env :=
  pointState (iterStart r σ) (workNames r)
