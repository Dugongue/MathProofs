def sourceWords {K : Type} [Field K] [Fintype K]
    (F : FieldPresentation K) (B : Nat) (u : Bool) (q : Nat)
    {a b c : Nat} (A : RectTensor a b c K) : List Nat :=
  [0, u.toNat, q, F.p, F.e, a, b, c] ++
    Mathproof.Problem18IMPSourceDispatch20261001.routeWords B 0 a b c ++
    (List.finRange F.e).map (fun i => (F.modulus i).val) ++
    tensorCoordinates F A
theorem clocked_refines_of_partial
    (B : Nat) (valid : List Nat → Prop) (f : List Nat → Bool)
    (p : Lax51Proofs.Microcode.Program)
    (wordBound timeBound : Polynomial Nat)
    (hsource : ∀ (K : Type) [Field K] [Fintype K] [BEq K] [LawfulBEq K]
      [DecidableEq K] (F : FieldPresentation K) (u : Bool) (q a b c : Nat),
      validSize K u q → 0 < a → 0 < b → 0 < c →
      ∀ A : RectTensor a b c K, valid (sourceWords F B u q A))
    (href : RoutedSourceRefines B f)
    (hagrees : ∀ xs, valid xs →
      clockedDecision p wordBound timeBound xs = f xs) :
    RoutedSourceRefines B (clockedDecision p wordBound timeBound) := by
  intro K _ _ _ _ _ F u q a b c hv ha hb hc A
  change clockedDecision p wordBound timeBound (sourceWords F B u q A) = _
  rw [hagrees _ (hsource K F u q a b c hv ha hb hc A)]
  exact href K F u q a b c hv ha hb hc A
def Certified (B : Nat) (c : Com) (P T : Polynomial Nat)
    (xs : List Nat) : Prop :=
  ∃ b, OneBitRun c P T xs b ∧ RoutedBitCorrect B xs b
theorem close_one_from_certified_source_runs
    (B : Nat) (c : Com) (L : Layout) (P T : Polynomial Nat)
    (hok : Com.Ok L c)
    (hsource : ∀ (K : Type) [Field K] [Fintype K] [BEq K] [LawfulBEq K]
      [DecidableEq K] (F : FieldPresentation K) (u : Bool) (q a b d : Nat),
      validSize K u q → 0 < a → 0 < b → 0 < d →
      ∀ A : RectTensor a b d K,
        ∃ result,
          OneBitRun c P T (sourceWords F B u q A) result ∧
          RoutedBitCorrect B (sourceWords F B u q A) result)
    (operational : ∀ (p : Lax51Proofs.Microcode.Program)
      (wordBound timeBound : Polynomial Nat),
      Nonempty (TM2ComputableInPolyTime
        Lax51.BinaryWordEncoding.encode BitstringEncoding.bitEncode
        (clockedDecision p wordBound timeBound))) :
    ∃ recognize : List Bool → Bool,
      ComplexityTheory.IsPolyTime recognize ∧
      Mathproof.Problem18EncodedDensityClosure20261001.EncodedRefines
        B recognize := by
  let valid : List Nat → Prop := Certified B c P T
  let total : ∀ xs, valid xs → ∃ result,
      OneBitRun c P T xs result ∧ RoutedBitCorrect B xs result :=
    fun _ hx => hx
  let f : List Nat → Bool :=
    extractedDecision c P T (RoutedBitCorrect B) total
  have hram : Mathproof.Problem18IMPPartialCompiler20261001.RamPolytimeOn valid
      (Mathproof.Problem18P36DispatchRangeRuntime20261004.resultWords f) :=
    extractedDecision_ramPolytimeOn c L P T (RoutedBitCorrect B) hok total
  obtain ⟨p,wordBound,timeBound,hagrees⟩ :=
    Mathproof.Problem18P36ClockedPartialTotalization20261004.clocked_extension_of_ramPolytimeOn
      hram
  have hvalidSource : ∀ (K : Type) [Field K] [Fintype K] [BEq K]
      [LawfulBEq K] [DecidableEq K] (F : FieldPresentation K) (u : Bool)
      (q a b d : Nat), validSize K u q → 0 < a → 0 < b → 0 < d →
      ∀ A : RectTensor a b d K, valid (sourceWords F B u q A) := by
    intro K _ _ _ _ _ F u q a b d hv ha hb hd A
    exact hsource K F u q a b d hv ha hb hd A
  have href : RoutedSourceRefines B f := by
    intro K _ _ _ _ _ F u q a b d hv ha hb hd A
    let xs := sourceWords F B u q A
    have hx : valid xs := hvalidSource K F u q a b d hv ha hb hd A
    have hs := extractedDecision_spec c P T (RoutedBitCorrect B) total xs hx
    exact hs.2 K F u q a b d hv ha hb hd A (by rfl)
  have hclocked : RoutedSourceRefines B
      (clockedDecision p wordBound timeBound) :=
    clocked_refines_of_partial B valid f p wordBound timeBound
      hvalidSource href hagrees
  exact ⟨Mathproof.Problem18P36TotalInputClose20261003.recognize B
      (clockedDecision p wordBound timeBound),
    Mathproof.Problem18P36TotalInputClose20261003.recognize_isPolyTime B
      (clockedDecision p wordBound timeBound)
      (Classical.choice (operational p wordBound timeBound)),
    Mathproof.Problem18P36TotalInputClose20261003.encodedRefines_of_routed
      hclocked⟩
theorem close_one_from_source_assembly
    (B : Nat)
    (hassembly :
      Mathproof.Problem18P36RoutedAssembly20261003.SourceAssemblyClosed B)
    (operational : ∀ (p : Lax51Proofs.Microcode.Program)
      (wordBound timeBound : Polynomial Nat),
      Nonempty (TM2ComputableInPolyTime
        Lax51.BinaryWordEncoding.encode BitstringEncoding.bitEncode
        (clockedDecision p wordBound timeBound))) :
    ∃ recognize : List Bool → Bool,
      ComplexityTheory.IsPolyTime recognize ∧
      Mathproof.Problem18EncodedDensityClosure20261001.EncodedRefines
        B recognize := by
  obtain ⟨P,T,hsource⟩ := hassembly
  apply close_one_from_certified_source_runs B
    Mathproof.Problem18P36RoutedAssembly20261003.program
    Mathproof.Problem18P36RoutedAssembly20261003.layout P T
    Mathproof.Problem18P36RoutedAssembly20261003.program_ok
  · intro K _ _ _ _ _ F u q a b d hv ha hb hd A
    simpa [sourceWords] using
      (Mathproof.Problem18P36RoutedAssembly20261003.source_routed_witness
        hsource K F u q a b d hv ha hb hd A)
  · exact operational
end Mathproof.Problem18P36ClockedRefinementAssembly20261004
