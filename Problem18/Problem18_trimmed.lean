variable {K E : Type*} [Field K] [Field E] [Algebra K E]
  [Fintype K] [Fintype E] [FiniteDimensional K E] [Algebra.IsSeparable K E]
  {n : ℕ}
abbrev CommutingSelfAdjoint (τ : K ≃+* K)
    (B : (Fin n → K) →ₛₗ[(τ : K →+* K)] (Fin n → K) →ₗ[K] K)
    (ρ : E →ₐ[K] Module.End K (Fin n → K)) :=
  {T : Module.End K (Fin n → K) //
    (∀ x y, B (T x) y = B x (T y)) ∧
    ∀ a x, T (ρ a x) = ρ a (T x)}
noncomputable def commutingToForm (τ : K ≃+* K) (σ : E ≃+* E) (eps : K)
    (B : (Fin n → K) →ₛₗ[(τ : K →+* K)] (Fin n → K) →ₗ[K] K)
    (hsym : ∀ x y, B y x = eps * τ (B x y))
    (ρ : CompatibleEmbedding σ (fun x y => B x y))
    (T : CommutingSelfAdjoint τ B ρ.1) :
    CompatibleForms (U := ActionSpace ρ.1) τ σ eps := by
  refine ⟨B.compl₂ T.1, ?_, ?_⟩
  · intro a x y
    change Fin n → K at x y
    change B (ρ.1 a x) (T.1 y) = B x (T.1 (ρ.1 (σ a) y))
    calc
      _ = B x (ρ.1 (σ a) (T.1 y)) := ρ.2 a x (T.1 y)
      _ = _ := congrArg (fun v => B x v) (T.2.2 (σ a) y).symm
  · intro x y
    change Fin n → K at x y
    change B y (T.1 x) = eps * τ (B x (T.1 y))
    rw [hsym, T.2.1]
theorem commutingToForm_injective (τ : K ≃+* K) (σ : E ≃+* E) (eps : K)
    (B : (Fin n → K) →ₛₗ[(τ : K →+* K)] (Fin n → K) →ₗ[K] K)
    (hB : B.Nondegenerate) (hsym : ∀ x y, B y x = eps * τ (B x y))
    (ρ : CompatibleEmbedding σ (fun x y => B x y)) :
    Function.Injective (commutingToForm τ σ eps B hsym ρ) := by
  intro T U h
  apply Subtype.ext
  apply LinearMap.ext
  intro y
  apply sub_eq_zero.mp
  apply hB.2
  intro x
  rw [map_sub]
  apply sub_eq_zero.mpr
  exact congrArg (fun C : CompatibleForms (U := ActionSpace ρ.1) τ σ eps => C.1 x y) h
theorem commutingSelfAdjoint_card_le (τ : K ≃+* K) (σ : E ≃+* E) (eps : K)
    (hcompat : (algebraMap K E).comp (τ : K →+* K) =
      (σ : E →+* E).comp (algebraMap K E))
    (hσ : Function.Involutive σ)
    (B : (Fin n → K) →ₛₗ[(τ : K →+* K)] (Fin n → K) →ₗ[K] K)
    (hB : B.Nondegenerate) (hsym : ∀ x y, B y x = eps * τ (B x y))
    (ρ : CompatibleEmbedding σ (fun x y => B x y)) :
    Nat.card (CommutingSelfAdjoint τ B ρ.1) ≤
      Nat.card E ^ ((Module.finrank E (ActionSpace ρ.1) + 1).choose 2) := by
  letI : Fintype (ActionSpace ρ.1) :=
    Fintype.ofEquiv (Fin n → K) (forgetAction ρ.1).symm.toEquiv
  letI : Finite (CompatibleForms (U := ActionSpace ρ.1) τ σ eps) :=
    Finite.of_injective (fun C : CompatibleForms (U := ActionSpace ρ.1) τ σ eps =>
      fun x y => C.1 x y) (by
        intro C D h
        apply Subtype.ext
        ext x y
        exact congrFun (congrFun h x) y)
  exact (Nat.card_le_card_of_injective _
    (commutingToForm_injective τ σ eps B hB hsym ρ)).trans
    (compatible_forms_card_le (Module.finBasis E (ActionSpace ρ.1))
      τ σ hcompat hσ eps)
theorem compatible_embedding_scaled_bound
    (τ : K ≃+* K) (σ : E ≃+* E) (eps : K)
    (hcompat : (algebraMap K E).comp (τ : K →+* K) =
      (σ : E →+* E).comp (algebraMap K E))
    (hσ : Function.Involutive σ)
    (ρ₀ : E →ₐ[K] Module.End K (Fin n → K))
    (B : (Fin n → K) →ₛₗ[(τ : K →+* K)] (Fin n → K) →ₗ[K] K)
    (hB : B.Nondegenerate) (hsym : ∀ x y, B y x = eps * τ (B x y)) :
    (Nat.card (CompatibleEmbedding σ (fun x y => B x y)) : ℝ) *
      (Fintype.card K : ℝ)^(n.choose 2) *
      (Fintype.card E : ℝ)^(Module.finrank E (ActionSpace ρ₀) *
        Module.finrank E (ActionSpace ρ₀)) ≤
    16 * (Fintype.card K : ℝ)^(n*n) *
      (Fintype.card E : ℝ)^((Module.finrank E (ActionSpace ρ₀)+1).choose 2) := by
  let N : ℝ := Nat.card (CompatibleEmbedding σ (fun x y => B x y))
  let I : ℝ := Nat.card (E →ₐ[K] Module.End K (Fin n → K))
  let O : ℝ := Nat.card (FormOrbit τ B)
  let q : ℝ := Fintype.card K
  let Q : ℝ := Fintype.card E
  let d := Module.finrank E (ActionSpace ρ₀)
  have hi : N * O ≤ I * Q^((d+1).choose 2) := by
    dsimp [N, O, I, Q, d]
    simp only [← Nat.card_eq_fintype_card]
    exact_mod_cast compatible_embedding_card_mul_orbit_le_power
      τ σ eps hcompat hσ ρ₀ B hsym
  have ho : (1/4 : ℝ)*q^(n.choose 2) ≤ O := formOrbit_card_ge_quarter τ B hB
  have he : I * Q^(d*d) ≤ 4*q^(n*n) := embedding_card_scaled_bound ρ₀
  have hn : 0 ≤ N := by dsimp [N]; positivity
  change N * q^(n.choose 2) * Q^(d*d) ≤ 16*q^(n*n)*Q^((d+1).choose 2)
  calc
    _ = 4*(N*((1/4 : ℝ)*q^(n.choose 2)))*Q^(d*d) := by ring
    _ ≤ 4*(N*O)*Q^(d*d) := by gcongr
    _ ≤ 4*(I*Q^((d+1).choose 2))*Q^(d*d) := by gcongr
    _ = 4*(I*Q^(d*d))*Q^((d+1).choose 2) := by ring
    _ ≤ 4*(4*q^(n*n))*Q^((d+1).choose 2) := by gcongr
    _ = _ := by ring
abbrev CompatiblePair (τ : K ≃+* K) (σ : E ≃+* E)
    (B : (Fin n → K) →ₛₗ[(τ : K →+* K)] (Fin n → K) →ₗ[K] K) :=
  (ρ : CompatibleEmbedding σ (fun x y => B x y)) × CommutingSelfAdjoint τ B ρ.1
theorem compatiblePair_card_le
    (τ : K ≃+* K) (σ : E ≃+* E) (eps : K)
    (hcompat : (algebraMap K E).comp (τ : K →+* K) =
      (σ : E →+* E).comp (algebraMap K E))
    (hσ : Function.Involutive σ)
    (ρ₀ : E →ₐ[K] Module.End K (Fin n → K))
    (B : (Fin n → K) →ₛₗ[(τ : K →+* K)] (Fin n → K) →ₗ[K] K)
    (hB : B.Nondegenerate) (hsym : ∀ x y, B y x = eps * τ (B x y)) :
    (Nat.card (CompatiblePair τ σ B) : ℝ) ≤
      16 * (Fintype.card K : ℝ)^((n+1).choose 2+n) := by
  classical
  let d := Module.finrank E (ActionSpace ρ₀)
  let q : ℝ := Fintype.card K
  let Q : ℝ := Fintype.card E
  let N : ℝ := Nat.card (CompatibleEmbedding σ (fun x y => B x y))
  let P : ℝ := Nat.card (CompatiblePair τ σ B)
  have hq : 0 < q := by dsimp [q]; positivity
  have hQ : 0 < Q := by dsimp [Q]; positivity
  letI : Finite (Module.End K (Fin n → K)) :=
    Finite.of_injective (fun T : Module.End K (Fin n → K) => (T : _ → _))
      DFunLike.coe_injective
  letI : Fintype (CompatibleEmbedding σ (fun x y => B x y)) := Fintype.ofFinite _
  have hpNat : Nat.card (CompatiblePair τ σ B) ≤
      Nat.card (CompatibleEmbedding σ (fun x y => B x y)) *
        Nat.card E ^ ((d+1).choose 2) := by
    change Nat.card ((ρ : CompatibleEmbedding σ (fun x y => B x y)) × _) ≤ _
    rw [Nat.card_sigma]
    calc
      _ ≤ ∑ _ρ : CompatibleEmbedding σ (fun x y => B x y),
          Nat.card E ^ ((d+1).choose 2) := by
        apply Finset.sum_le_sum
        intro ρ _
        have h := commutingSelfAdjoint_card_le τ σ eps hcompat hσ B hB hsym ρ
        simpa only [action_finrank_eq ρ.1 ρ₀] using h
      _ = _ := by simp [Nat.card_eq_fintype_card]
  have hp : P ≤ N * Q^((d+1).choose 2) := by
    dsimp [P, N, Q]
    simp only [← Nat.card_eq_fintype_card]
    exact_mod_cast hpNat
  have hscaled := compatible_embedding_scaled_bound τ σ eps hcompat hσ ρ₀ B hB hsym
  change N*q^(n.choose 2)*Q^(d*d) ≤ 16*q^(n*n)*Q^((d+1).choose 2) at hscaled
  have hdim : Module.finrank K E * d = n := by
    have h := Module.finrank_mul_finrank K E (ActionSpace ρ₀)
    rw [(forgetAction ρ₀).finrank_eq] at h
    simpa [d] using h
  have hcard : Q^d = q^n := by
    have hc := Module.card_eq_pow_finrank (K := K) (V := E)
    have hn : Fintype.card E ^ d = Fintype.card K ^ n := by
      rw [hc, ← pow_mul, hdim]
    dsimp [Q, q]
    exact_mod_cast hn
  have htri : 2*((d+1).choose 2) = d*d+d := by
    have h1 := choose_pair_sum d
    have h2 : (d+1).choose 2 = d.choose 2+d := by
      rw [Nat.choose_succ_succ, Nat.choose_one_right, Nat.add_comm]
    omega
  have hs : P*q^(n.choose 2)*Q^(d*d) ≤
      (16*q^(n*n)*q^n)*Q^(d*d) := by
    calc
      _ ≤ (N*Q^((d+1).choose 2))*q^(n.choose 2)*Q^(d*d) := by gcongr
      _ = (N*q^(n.choose 2)*Q^(d*d))*Q^((d+1).choose 2) := by ring
      _ ≤ (16*q^(n*n)*Q^((d+1).choose 2))*Q^((d+1).choose 2) := by gcongr
      _ = (16*q^(n*n)*q^n)*Q^(d*d) := by
        rw [mul_assoc (16*q^(n*n)), ← pow_add]
        rw [← two_mul, htri, pow_add, hcard]
        ring
  have hs' : P*q^(n.choose 2) ≤ 16*q^(n*n)*q^n :=
    (mul_le_mul_iff_left₀ (pow_pos hQ _)).mp hs
  apply (mul_le_mul_iff_left₀ (pow_pos hq (n.choose 2))).mp
  change P*q^(n.choose 2) ≤ (16*q^((n+1).choose 2+n))*q^(n.choose 2)
  calc
    _ ≤ 16*q^(n*n)*q^n := hs'
    _ = _ := by
      rw [mul_assoc, ← pow_add, mul_assoc, ← pow_add]
      congr 2
      rw [choose_pair_sum]
      omega
theorem compatiblePair_normalized_le
    (τ : K ≃+* K) (σ : E ≃+* E) (eps : K)
    (hcompat : (algebraMap K E).comp (τ : K →+* K) =
      (σ : E →+* E).comp (algebraMap K E))
    (hσ : Function.Involutive σ)
    (ρ₀ : E →ₐ[K] Module.End K (Fin n → K))
    (B : (Fin n → K) →ₛₗ[(τ : K →+* K)] (Fin n → K) →ₗ[K] K)
    (hB : B.Nondegenerate) (hsym : ∀ x y, B y x = eps * τ (B x y)) :
    (Nat.card (CompatiblePair τ σ B) : ℝ) /
      (Fintype.card K : ℝ)^(n.choose 2) ≤
      16 * (Fintype.card K : ℝ)^(2*n) := by
  have hq : (0 : ℝ) < Fintype.card K := by positivity
  apply (div_le_iff₀ (pow_pos hq _)).mpr
  calc
    _ ≤ 16 * (Fintype.card K : ℝ)^((n+1).choose 2+n) :=
      compatiblePair_card_le τ σ eps hcompat hσ ρ₀ B hB hsym
    _ = _ := by
      rw [mul_assoc, ← pow_add]
      congr 2
      have h : (n+1).choose 2 = n.choose 2+n := by
        rw [Nat.choose_succ_succ, Nat.choose_one_right, Nat.add_comm]
      omega
end Mathproof.Problem18CompatibleCommutingCount20260930
