  have hrun:Run B (segCopy a a idx cnt sb db) sigma tau (20*n+6) := by
    have hh:=(Run.assign (σ:=sigma) (x:=idx)
      (evalB_lit (by omega : 0<B))).seq hr
    apply hh.mono
