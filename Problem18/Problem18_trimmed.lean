  2+existsMappedCost (patternCoeff n d (requiredDepth n d)) (patterns (boxSize n (cpE n d)))
theorem mapped_bound {α : Type} (f g : α → Nat) (H : Nat) (hH : 1 ≤ H)
    (xs : List α) (h : ∀x∈xs,f x ≤ g x*H) : existsMappedCost f xs ≤ existsMappedCost g xs*H := by
  induction xs with
  | nil => simpa [existsMappedCost] using hH
