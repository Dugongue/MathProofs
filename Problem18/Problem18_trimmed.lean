  have hsub : Finset.univ.filter (fun x : Ω => ExtensionStable (E := E) (f x)) ⊆
      Finset.univ.filter (fun x : Ω => 2*Module.finrank K (f x)< r) ∪
        Finset.univ.filter (fun x : Ω => r ≤ 2*Module.finrank K (f x) ∧ ExtensionStable (E := E) (f x)) := by
    intro x hx
    have hs := (Finset.mem_filter.mp hx).2
    by_cases hl : 2*Module.finrank K (f x)< r <;> simp_all
  have hc := (Finset.card_le_card hsub).trans (Finset.card_union_le _ _)
