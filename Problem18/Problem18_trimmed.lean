    ⟨z.2.val.toMatrix',standard_selfAdjoint_matrix _ z.2.property.2,
      by
        rw [Matrix.det_eq_sign_charpoly_coeff,matrix_charpoly,z.2.property.1]
        exact mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)) (hzero z.1),
      by rw [matrix_charpoly,z.2.property.1]; exact hmap z.1⟩
  have hi : Function.Injective J := by
    rintro ⟨f,S⟩ ⟨g,T⟩ h
    have hST : S.val=T.val := LinearMap.toMatrix'.injective (congrArg Subtype.val h)
    have hfg : f=g := by
      apply Subtype.ext
      apply Subtype.ext
      apply Polynomial.map_injective (algebraMap F K) (algebraMap F K).injective
      exact S.property.1.symm.trans ((congrArg (fun U : Module.End K (Fin n→K) => U.charpoly) hST).trans T.property.1)
    subst g
    exact congrArg (Sigma.mk f) (Subtype.ext hST)
