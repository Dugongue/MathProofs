theorem inv_refl (ρ0 : Env) : Inv ρ0 ρ0 := ⟨fun _ _ => rfl, fun _ _ _ => rfl, rfl, rfl, rfl⟩
theorem inv_step {B K' : Nat} {c : Com} {ρ0 ρ τ : Env} (h : Inv ρ0 ρ) (hr : Run B c ρ τ K')
    (hs : ∀ x ∈ sideRegs, x ∉ scalarWrites c)
    (ha : arrayWrites c ⊆ {canonical.mem, canonical.scratch})
    (hnr : noRead c) (hnw : c.NoWrite) : Inv ρ0 τ := by
  have hf := run_frame hr
  refine ⟨fun x hx => (hf.1 x (hs x hx)).trans (h.regs x hx), fun a h1 h2 => ?_,
    (hf.2.2.1 _).trans h.len, (hf.2.2.2.1 hnr).trans h.inp, (hf.2.2.2.2 hnw).trans h.out⟩
  have : a ∉ arrayWrites c := by
    intro hm; have := ha hm; simp at this; tauto
  exact (hf.2.1 a this).trans (h.arrs a h1 h2)
