attribute [local instance] Classical.propDecidable
def variableCount (u : Bool) (a b : Nat) : Nat := if u then 2*(a*a+b*b) else a*a+b*b
def maxVariables (cutoff : Nat) : Nat := 4*cutoff^2
def maximum (f : Nat → Nat) (N : Nat) : Nat := (Finset.range (N+1)).sup f
theorem le_maximum (f : Nat → Nat) {n N : Nat} (hn : n ≤ N) : f n  ≤  maximum f N :=
  Finset.le_sup (Finset.mem_range.mpr (by omega))
def guard (d n : Nat) : Nat := n+d+12+envelope wordNeed n (n+1) d+
  threshold n d+(boxSize n d+1)+(threshold n d)^n
def reserve (cutoff d : Nat) : Nat := maximum (fun n=>envelope slotNeed n (n+1) d) (maxVariables cutoff)
def words (cutoff d : Nat) : Nat := maximum (guard d) (maxVariables cutoff)
def coefficient (cutoff d : Nat) : Nat :=
  maximum (fun n=>Problem18P34Control20261002Output.coefficient n d) (maxVariables cutoff)
theorem profile_bounds {n cutoff : Nat} (d : Nat) (hn : n ≤ maxVariables cutoff) :
    envelope slotNeed n (n+1) d  ≤  reserve cutoff d ∧
    envelope wordNeed n (n+1) d  ≤  words cutoff d ∧ n ≤ words cutoff d ∧ d ≤ words cutoff d ∧ 8 ≤ words cutoff d ∧
    threshold n d ≤ words cutoff d ∧ boxSize n d+1 ≤ words cutoff d ∧
    (threshold n d)^n ≤ words cutoff d ∧
    Problem18P34Control20261002Output.coefficient n d ≤ coefficient cutoff d := by
  have hg:=le_maximum (guard d) hn
  change guard d n ≤ words cutoff d at hg
  have hc:=le_maximum (fun n=>Problem18P34Control20261002Output.coefficient n d) hn
  have hs:=le_maximum (fun n=>envelope slotNeed n (n+1) d) hn
  unfold guard at hg
  exact ⟨hs,by omega,by omega,by omega,by omega,by omega,by omega,by omega,hc⟩
variable {K : Type} [Field K] [Fintype K]
def bound (F : FieldPresentation K) (cutoff d S : Nat) : Nat :=
  2^exponent (32*(S+1)) (words cutoff d+S+17) (bits (K:=K))
theorem resources (F : FieldPresentation K) (cutoff d S : Nat) {n : Nat}
    (hn : n ≤ maxVariables cutoff) (hS : reserve cutoff d ≤ S) :
    memory F S < bound F cutoff d S ∧ 16*(F.e+1)<bound F cutoff d S ∧
    S+1 < bound F cutoff d S ∧ Fintype.card K < bound F cutoff d S ∧
    (F.p+1)^2 < bound F cutoff d S ∧ (F.p+1)^(F.e+1)<bound F cutoff d S ∧
    envelope slotNeed n (n+1) d ≤ S ∧ envelope wordNeed n (n+1) d < bound F cutoff d S ∧
    7 < bound F cutoff d S ∧ d < bound F cutoff d S ∧ n < bound F cutoff d S ∧
    threshold n d < bound F cutoff d S ∧ boxSize n d+1 < bound F cutoff d S ∧
    (threshold n d)^n < bound F cutoff d S := by
  obtain ⟨hm,hw,hq,ha,hi⟩:=word_bounds F (32*(S+1)) (words cutoff d+S+17)
  obtain ⟨hs,hww,hnw,hdw,h8,hth,hbox,hpow,hcoef⟩:=profile_bounds d hn
  have he:=F.degree_pos
  have hmm:memory F S ≤ memory F (32*(S+1)):=by unfold memory;nlinarith
  have hsc:16*(F.e+1) ≤ memory F (32*(S+1)):=by unfold memory;nlinarith
  change memory F (32*(S+1))<bound F cutoff d S at hm
  change words cutoff d+S+17 < bound F cutoff d S at hw
  exact ⟨hmm.trans_lt hm,hsc.trans_lt hm,by omega,hq,ha,hi,hs.trans hS,
    by omega,by omega,by omega,by omega,by omega,by omega,by omega⟩
theorem solve [DecidableEq K]
    (L : Type) [Field L] [Algebra K L] [IsAlgClosed L] [Algebra.IsAlgebraic K L]
    (F : FieldPresentation K) (cutoff d S n : Nat)
    (rows : List (Problem18MacaulayAlgorithm20260930.DenseInput n d K)) (σ : Env)
    (hn : n ≤ maxVariables cutoff) (hs : reserve cutoff d ≤ S)
    (hraw : Problem18P34Input20261002Banks.RawInput F n (n+1) d S (bound F cutoff d S) (memory F S) rows σ)
    (hrows : rows.length ≤ boxSize n d)
    (hv : ∀v∈rows,∃p:MvPolynomial (Fin n) K,Problem18MacaulayAlgorithm20260930.ValidDenseInput d v p)
    (hdpos : 1 ≤ d) (hout : σ.out=[]) :
    ∃τ,Run (bound F cutoff d S) (Problem18P34Control20261002Output.program F n d) σ τ
      (coefficient cutoff d*(S+2012004)*(bits (K:=K))^5) ∧
      τ.out=Problem18RAMAnswerCodec20261001.answerWords
        (some (decide (Problem18P34Control20261002Output.feasible n d rows))) := by
  classical
  obtain ⟨hm,hsc,hS,hq,ha,hi,hrs,hrw,h7,h4,hnB,hth,hbox,hpow⟩:=resources F cutoff d S hn hs
  obtain ⟨τ,hr,ho⟩:=Problem18P34Control20261002Output.run L F n d S (bound F cutoff d S)
    (memory F S) rows σ hraw hrows hv (Problem18P34Control20261002Output.space n d hdpos)
    h4 hnB hth hbox hpow hout
  have hc:Problem18P34Control20261002Output.coefficient n d ≤ coefficient cutoff d:=
    (profile_bounds d hn).2.2.2.2.2.2.2.2
  have ht:=Nat.mul_le_mul hc (scale_bound F S)
  exact ⟨τ,hr.mono (by nlinarith [ht]),ho⟩
end Mathproof.Problem18P34Assembly20261003Profiles
