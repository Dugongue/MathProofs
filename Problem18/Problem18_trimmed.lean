      ((Fintype.card K : ℝ)^r)⁻¹ =
      (Fintype.card K : ℝ)^(Module.finrank K V - Module.finrank K E) := by
    calc
      _ = ∑ χ, a χ := by
        symm
        calc
          _ = ∑ χ : AddChar V ℂ, if a χ ≠ 0 then ((Fintype.card K : ℝ)^r)⁻¹ else 0 :=
            Finset.sum_congr rfl (fun χ _ => hd χ)
          _ = _ := by simp [Finset.sum_ite]
      _ = _ := hp
  have hq : (Fintype.card K : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hc := (div_eq_iff (pow_ne_zero r hq)).mp
    (show ((Finset.univ.filter (fun χ : AddChar V ℂ => a χ ≠ 0)).card : ℝ) /
      (Fintype.card K : ℝ)^r =
      (Fintype.card K : ℝ)^(Module.finrank K V - Module.finrank K E) by
        simpa only [div_eq_mul_inv] using he)
  rw [← pow_add] at hc
  exact_mod_cast hc
