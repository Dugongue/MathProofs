set_option autoImplicit false
namespace Mathproof.Problem18ClaudeIMPZero20261001
open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Mathproof.Problem18IMPFieldLayout20261001
open Mathproof.Problem18IMPFieldPresentation20261001
open Mathproof.Problem18AllFormatRoot20260930
open Mathproof.Problem18ClaudeFieldMacros20261001
open Mathproof.Problem18ClaudeIMPSlots20261001
open Mathproof.Problem18ClaudeIMPAxpy20261001
variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}
def zeroBody (M : FieldMacros F r) (q : RNames) (z k : String) : Com :=
  .seq (mcall r q M.eq (plus (.lit 5) (.var k)) (.lit 0) (.lit 1))
    (.seq (.ite (.eq (.var r.flag) (.lit 1)) .skip (.assign z (.lit 1)))
      (.assign k (plus (.var k) (.lit 1))))
def zeroTest (M : FieldMacros F r) (q : RNames) (z k : String) : Com :=
  .seq (.assign z (.lit 0)) (.seq (.assign k (.lit 0))
    (.while (.lt (.var k) (.var q.N)) (zeroBody M q z k)))
def zeroCost (M : FieldMacros F r) (N : ℕ) : ℕ := 8 + (40 + M.costEq) * N
theorem zero_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (z k : String)
    (hzS : z ∉ regNames r) (hkS : k ∉ regNames r) (hzk : z ≠ k) (hzW : z ≠ q.WS)
    (hkW : k ≠ q.WS) (hzN : z ≠ q.N) (hkN : k ≠ q.N)
    {B Sn : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ) {Nv : ℕ} (hN : σ.vars q.N = Nv)
    (hfit : 5 + Nv ≤ Sn) (hz : val F r q.WS σ 0 = 0) :
    ∃ τ, Run B (zeroTest M q z k) σ τ (zeroCost M Nv) ∧ Slots F r q.WS Sn B τ ∧
      (∀ s, val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ≠ z → x ≠ k → τ.vars x = σ.vars x) ∧
      (τ.vars z = 1 ↔ ∃ m < Nv, val F r q.WS σ (5 + m) ≠ 0) ∧ τ.vars z ≤ 1 ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hSB := hS.slots_word
  have hNB : Nv < B := by omega
  have hkA : k ≠ r.aBase := fun h => hkS (h ▸ by simp [regNames, scalarNames])
  have hNS : q.N ∉ regNames r := hq.2 _ q.N_mem
  let I : Env → Prop := fun τ =>
    Slots F r q.WS Sn B τ ∧ (∀ s, val F r q.WS τ s = val F r q.WS σ s) ∧
    (∀ x, x ∉ regNames r → x ≠ z → x ≠ k → τ.vars x = σ.vars x) ∧ τ.vars k ≤ Nv ∧
    (τ.vars z = 1 ↔ ∃ m < τ.vars k, val F r q.WS σ (5 + m) ≠ 0) ∧ τ.vars z ≤ 1 ∧
    (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out
  have hI0 : I ((σ.setVar z 0).setVar k 0) := by
    refine ⟨Slots.setVar F r (Slots.setVar F r hS hzS hzW 0) hkS hkW 0, ?_, ?_, ?_, ?_, ?_,
      fun _ _ _ => rfl, rfl, rfl⟩
    · intro s; rw [val_setVar F r hkW, val_setVar F r hzW]
    · intro x _ h1 h2; simp only [vars_setVar, if_neg h1, if_neg h2]
    · simp
    · simp only [vars_setVar, if_neg hzk, if_true]
      constructor
      · intro h; exact absurd h (by decide)
      · rintro ⟨m, hm, _⟩; exact absurd hm (Nat.not_lt_zero m)
    · simp only [vars_setVar, if_neg hzk, if_true]; omega
  have hNfix : ∀ τ, I τ → τ.vars q.N = Nv := fun τ hτ => by
    rw [hτ.2.2.1 q.N hNS (Ne.symm hzN) (Ne.symm hkN), hN]
  have hdef : ∀ τ, I τ → ∃ v, (Cond.lt (.var k) (.var q.N)).evalB B τ = some v := by
    intro τ hτ
    exact evalB_condLt_vars (by have := hτ.2.2.2.1; omega) (by rw [hNfix τ hτ]; omega)
  have hstep : ∀ τ, I τ → (Cond.lt (.var k) (.var q.N)).evalB B τ = some true →
      ∃ τ', Run B (zeroBody M q z k) τ τ' (36 + M.costEq) ∧ I τ' ∧
        Nv - τ'.vars k < Nv - τ.vars k := by
    intro τ hτ hc
    have hNτ := hNfix τ hτ
    obtain ⟨hSτ, hval, hregs, hkle, hzz, hz1, harr, hinp, hout⟩ := hτ
    have hkN' : τ.vars k < Nv := by
      rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hNτ]; omega))] at hc
      simp only [Option.some.injEq, decide_eq_true_eq] at hc
      rw [hNτ] at hc; exact hc
    obtain ⟨τ1, hr1, hflag, he1⟩ := slot_eq F r M.eq_spec hSτ (plus (.lit 5) (.var k)) (.lit 0)
      (.lit 1) (evalB_plus_var (evalB_lit (by omega)) rfl (by omega)) (evalB_lit (by omega))
      (evalB_lit (by omega)) trivial trivial trivial (by omega) (by omega) (by omega) (by omega)
      (by omega)
    have hk1 : τ1.vars k = τ.vars k := eq_regs_all he1 k hkS
    have hz1' : τ1.vars z = τ.vars z := eq_regs_all he1 z hzS
    have hinc : (plus (.var k) (.lit 1)).evalB B τ1 = some (τ.vars k + 1) := by
      unfold plus
      exact evalB_bin (by rw [← hk1]; exact evalB_var (by rw [hk1]; omega)) (evalB_lit (by omega))
        (by change τ.vars k + 1 < B; omega)
    have hz0 : val F r q.WS τ 0 = 0 := by rw [hval]; exact hz
    by_cases hzero : val F r q.WS σ (5 + τ.vars k) = 0
    · have hfl : τ1.vars r.flag = 1 := by
        rw [hflag, if_pos (by rw [hval, hz0]; exact hzero)]
      have hct : (Cond.eq (.var r.flag) (.lit 1)).evalB B τ1 = some true := by
        rw [evalB_condEq (evalB_var (by rw [hfl]; omega)) (evalB_lit (by omega)), hfl]; rfl
      have hinc' : (plus (.var k) (.lit 1)).evalB B τ1 = some (τ.vars k + 1) := hinc
      refine ⟨τ1.setVar k (τ.vars k + 1), ?_, ⟨Slots.setVar F r he1.slots hkS hkW _, ?_, ?_, ?_,
        ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
      · refine (hr1.seq ((Run.ite_true hct Run.skip).seq (Run.assign hinc'))).mono ?_
        have e1 : (plus (Expr.lit 5) (Expr.var k)).size = 3 := rfl
        have e2 : (Cond.eq (Expr.var r.flag) (Expr.lit 1)).size = 3 := rfl
        have e3 : (plus (Expr.var k) (Expr.lit 1)).size = 3 := rfl
        rw [e1, e2, e3]; simp only [Expr.size]; omega
      · intro s; rw [val_setVar F r hkW, he1.vals, hval]
      · intro x hx h1 h2
        simp only [vars_setVar, if_neg h2]
        rw [eq_regs_all he1 x hx]; exact hregs x hx h1 h2
      · simp only [vars_setVar, if_true]; omega
      · simp only [vars_setVar, if_true, if_neg hzk, hz1']
        rw [hzz]
        constructor
        · rintro ⟨m, hm, hne⟩; exact ⟨m, by omega, hne⟩
        · rintro ⟨m, hm, hne⟩
          refine ⟨m, ?_, hne⟩
          rcases Nat.lt_succ_iff_lt_or_eq.mp hm with h | h
          · exact h
          · exact absurd (h ▸ hzero) hne
      · simp only [vars_setVar, if_neg hzk, hz1']; exact hz1
      · intro a h1 h2; simp only [arrs_setVar]; rw [he1.arrays]; exact harr a h1 h2
      · simp only [inp_setVar]; rw [he1.inp]; exact hinp
      · simp only [out_setVar]; rw [he1.out]; exact hout
      · simp only [vars_setVar, if_true]; omega
    · have hfl : τ1.vars r.flag = 0 := by
        rw [hflag, if_neg (by rw [hval, hz0]; exact hzero)]
      have hcf : (Cond.eq (.var r.flag) (.lit 1)).evalB B τ1 = some false := by
        rw [evalB_condEq (evalB_var (by rw [hfl]; omega)) (evalB_lit (by omega)), hfl]; rfl
      set τ2 := τ1.setVar z 1
      have hk2 : τ2.vars k = τ.vars k := by simp only [τ2, vars_setVar, if_neg (Ne.symm hzk)]; exact hk1
      have hinc2 : (plus (.var k) (.lit 1)).evalB B τ2 = some (τ.vars k + 1) := by
        unfold plus
        exact evalB_bin (by rw [← hk2]; exact evalB_var (by rw [hk2]; omega)) (evalB_lit (by omega))
          (by change τ.vars k + 1 < B; omega)
      refine ⟨τ2.setVar k (τ.vars k + 1), ?_, ⟨Slots.setVar F r (Slots.setVar F r he1.slots hzS hzW _)
        hkS hkW _, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩, ?_⟩
      · refine (hr1.seq ((Run.ite_false hcf (Run.assign (evalB_lit (by omega)))).seq
          (Run.assign hinc2))).mono ?_
        have e1 : (plus (Expr.lit 5) (Expr.var k)).size = 3 := rfl
        have e2 : (Cond.eq (Expr.var r.flag) (Expr.lit 1)).size = 3 := rfl
        have e3 : (plus (Expr.var k) (Expr.lit 1)).size = 3 := rfl
        rw [e1, e2, e3]; simp only [Expr.size]; omega
      · intro s; rw [val_setVar F r hkW, val_setVar F r hzW, he1.vals, hval]
      · intro x hx h1 h2
        simp only [τ2, vars_setVar, if_neg h1, if_neg h2]
        rw [eq_regs_all he1 x hx]; exact hregs x hx h1 h2
      · simp only [vars_setVar, if_true]; omega
      · simp only [τ2, vars_setVar, if_neg hzk, if_true]
        first
        | exact ⟨fun _ => ⟨τ.vars k, by omega, hzero⟩, fun _ => rfl⟩
        | exact ⟨τ.vars k, by omega, hzero⟩
        | exact iff_of_true trivial ⟨τ.vars k, by omega, hzero⟩
      · simp only [τ2, vars_setVar, if_neg hzk, if_true]; exact le_refl _
      · intro a h1 h2; simp only [τ2, arrs_setVar]; rw [he1.arrays]; exact harr a h1 h2
      · simp only [τ2, inp_setVar]; rw [he1.inp]; exact hinp
      · simp only [τ2, out_setVar]; rw [he1.out]; exact hout
      · simp only [vars_setVar, if_true]; omega
  obtain ⟨τf, hrf, hIf, hcf⟩ := Run.while_count I (fun τ => Nv - τ.vars k) (36 + M.costEq)
    hdef hstep hI0
  have hNf := hNfix τf hIf
  obtain ⟨hSf, hvalf, hregsf, hkf, hzzf, hz1f, harrf, hinpf, houtf⟩ := hIf
  have hkeq : τf.vars k = Nv := by
    rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hNf]; omega))] at hcf
    simp only [Option.some.injEq, decide_eq_false_iff_not, not_lt] at hcf
    rw [hNf] at hcf; omega
  refine ⟨τf, ?_, hSf, hvalf, hregsf, by rw [hzzf, hkeq], hz1f, harrf, hinpf, houtf⟩
  refine ((Run.assign (x := z) (evalB_lit (σ := σ) (by omega : 0 < B))).seq
    ((Run.assign (x := k) (evalB_lit (σ := σ.setVar z 0) (by omega : 0 < B))).seq hrf)).mono ?_
  simp only [vars_setVar, eq_self_iff_true, if_true, ite_true, Nat.sub_zero]
  have e1 : (Expr.lit 0).size = 1 := rfl
  have e2 : (Cond.lt (Expr.var k) (Expr.var q.N)).size = 3 := rfl
  rw [e1, e2]; unfold zeroCost; ring_nf; try omega
end Mathproof.Problem18ClaudeIMPZero20261001
