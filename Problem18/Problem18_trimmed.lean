namespace Mathproof.Problem18ClaudeSolverAssembly20261001
open MvPolynomial
open Mathproof.Problem18AllFormatRoot20260930
open Mathproof.Problem18MacaulayAlgorithm20260930
open Mathproof.Problem18PolynomialCompression20261001
open Mathproof.Problem18ExpressionCoefficientBackend20261001
open Mathproof.Problem18GeometricEmptinessAlgorithm20260930
open Mathproof.Problem18FrobeniusComponentCollision20260930
open Mathproof.Problem18ComponentCollisionDepth20260930
open Mathproof.Problem18ComponentCollisionRecursion20260930
open Mathproof.Problem18SmallFieldEnumeration20261001
open Mathproof.Problem18BinaryPower20260930
open Problem18ArrayElimination20260929
variable {K : Type} [Field K] [DecidableEq K] [Fintype K]
variable (L : Type) [Field L] [Algebra K L] [IsAlgClosed L] [Algebra.IsAlgebraic K L]
def Represents {n d : Nat} (rows : List (DenseInput n d K)) (fs : List (MvPolynomial (Fin n) K)) :
    Prop :=
  List.Forall₂ (ValidDenseInput d) rows fs
theorem represents_eval_iff {n d : Nat} {rows : List (DenseInput n d K)}
    {fs : List (MvPolynomial (Fin n) K)} (h : Represents rows fs) (x : Fin n → K) :
    (∀ v ∈ rows, denseEval x (read v) = 0) ↔ ∀ f ∈ fs, eval x f = 0 := by
  induction h with
  | nil => simp
  | cons hv _ ih =>
    simp only [List.mem_cons, forall_eq_or_imp, ih, denseEval_valid x _ _ hv]
def systemSet {n : Nat} (fs : List (MvPolynomial (Fin n) K)) : Set (MvPolynomial (Fin n) K) :=
  {f | f ∈ fs}
def HasFixedComponent {n : Nat} (fs : List (MvPolynomial (Fin n) K)) : Prop :=
  ∃ P ∈ (geometricIdeal (L := L) (systemSet fs)).minimalPrimes,
    P.comap (coefficientAutomorphism (FiniteField.frobeniusAlgEquivOfAlgebraic K L)) = P
noncomputable def geomDim {n : Nat} (fs : List (MvPolynomial (Fin n) K)) : WithBot ℕ∞ :=
  ringKrullDim (MvPolynomial (Fin n) L ⧸ geometricIdeal (L := L) (systemSet fs))
theorem geometric_of_rational {n : Nat} (fs : List (MvPolynomial (Fin n) K)) (x : Fin n → K)
    (hx : ∀ f ∈ fs, eval x f = 0) :
    ∃ y : Fin n → L, ∀ f ∈ fs, aeval y f = 0 := by
  refine ⟨fun i => algebraMap K L (x i), fun f hf => ?_⟩
  have h := map_eval (algebraMap K L) x f
  simp only [Function.comp_def] at h
  rw [aeval_def, ← eval_map, ← h, hx f hf, map_zero]
include L in
theorem no_rational_of_infeasible {n d : Nat} (rows : List (DenseInput n d K))
    (fs : List (MvPolynomial (Fin n) K)) (h : Represents rows fs)
    (hfeas : (geometricFeasible d rows).1 = false) (x : Fin n → K) :
    ¬ ∀ f ∈ fs, eval x f = 0 := by
  intro hx
  have hc := (geometricFeasible_correct (L := L) d rows fs h).mpr (geometric_of_rational L fs x hx)
  rw [hfeas] at hc
  exact Bool.false_ne_true hc
theorem no_rational_of_dim_bot {n : Nat} (fs : List (MvPolynomial (Fin n) K))
    (hdim : geomDim L fs + 1 ≤ 0) (x : Fin n → K) : ¬ ∀ f ∈ fs, eval x f = 0 := by
  intro hx
  have hle : geometricIdeal (L := L) (systemSet fs) ≤ rationalPointKernel x :=
    (geometricIdeal_le_rationalPointKernel_iff (L := L) (systemSet fs) x).mpr hx
  have hne : geometricIdeal (L := L) (systemSet fs) ≠ ⊤ := by
    intro htop
    rw [htop] at hle
    have h1 : (1 : MvPolynomial (Fin n) L) ∈ rationalPointKernel (L := L) x :=
      hle Submodule.mem_top
    change eval (fun i => algebraMap K L (x i)) (1 : MvPolynomial (Fin n) L) = 0 at h1
    simp at h1
  letI : Nontrivial (MvPolynomial (Fin n) L ⧸ geometricIdeal (L := L) (systemSet fs)) :=
    Ideal.Quotient.nontrivial_iff.mpr hne
  have h0 : (0 : WithBot ℕ∞) ≤ geomDim L fs := ringKrullDim_nonneg_of_nontrivial
  have h1 : (0 : WithBot ℕ∞) + 1 ≤ geomDim L fs + 1 := add_le_add h0 le_rfl
  rw [zero_add] at h1
  have : (1 : WithBot ℕ∞) ≤ 0 := h1.trans hdim
  exact absurd this (by simp)
theorem geomDim_le {n : Nat} (fs : List (MvPolynomial (Fin n) K)) :
    geomDim L fs + 1 ≤ ((n + 1 : Nat) : WithBot ℕ∞) := by
  have h := polynomial_quotient_dimension_bound (geometricIdeal (L := L) (systemSet fs))
  rw [Nat.cast_add, Nat.cast_one]
  exact add_le_add h le_rfl
structure GeometryBackend (n : Nat) where
  fixedTest : (d : Nat) → List (DenseInput n d K) → Bool × Nat
  childDeg : Nat → Nat
  child : (d : Nat) → List (DenseInput n d K) → List (DenseInput n (childDeg d) K) × Nat
  threshold : Nat → Nat
  fixedBudget : Nat → Nat → Nat
  childBudget : Nat → Nat → Nat
  childRows : Nat → Nat → Nat
  fixedTest_correct : ∀ (d : Nat) (rows : List (DenseInput n d K)) fs, Represents rows fs →
    ((fixedTest d rows).1 = true ↔ HasFixedComponent L fs)
  child_spec : ∀ (d : Nat) (rows : List (DenseInput n d K)) fs, Represents rows fs →
    ¬ HasFixedComponent L fs →
    ∃ gs, Represents (child d rows).1 gs ∧
      (∀ x : Fin n → K, (∀ f ∈ fs, eval x f = 0) ↔ ∀ g ∈ gs, eval x g = 0) ∧
      geomDim L gs + 1 ≤ geomDim L fs
  pointExistence : ∀ (d : Nat) (rows : List (DenseInput n d K)) fs, Represents rows fs →
    threshold d < Fintype.card K → HasFixedComponent L fs → ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0
  fixedTest_cost : ∀ (d : Nat) (rows : List (DenseInput n d K)),
    (fixedTest d rows).2 ≤ fixedBudget d rows.length * (Nat.size (Fintype.card K) + 1)
  child_cost : ∀ (d : Nat) (rows : List (DenseInput n d K)),
    (child d rows).2 ≤ childBudget d rows.length * (Nat.size (Fintype.card K) + 1)
  child_length : ∀ (d : Nat) (rows : List (DenseInput n d K)),
    (child d rows).1.length ≤ childRows d rows.length
  fixedBudget_mono : ∀ d r r', r ≤ r' → fixedBudget d r ≤ fixedBudget d r'
  childBudget_mono : ∀ d r r', r ≤ r' → childBudget d r ≤ childBudget d r'
  childRows_mono : ∀ d r r', r ≤ r' → childRows d r ≤ childRows d r'
def feasM (n d : Nat) : Nat :=
  (multiplierExponents n
    (2 * d * 2 ^ (Mathproof.Meta.Problem18BoundedControlledDicksonEnumeration20260930.controlledDepth n d))).length
def feasC (n d : Nat) : Nat :=
  (d + 2 * d * 2 ^ (Mathproof.Meta.Problem18BoundedControlledDicksonEnumeration20260930.controlledDepth n d) + 1) ^ n
def feasBudget (n d r : Nat) : Nat :=
  r * feasM n d * feasC n d + (2 * feasC n d + 1) * (r * feasM n d) ^ 2 + feasC n d + 1
variable {L}
def solveLevel {n : Nat} (B : GeometryBackend (K := K) L n) :
    Nat → (d : Nat) → List (DenseInput n d K) → Bool × Nat
  | 0, _, _ => (false, 0)
  | ℓ + 1, d, rows =>
    let g := geometricFeasible d rows
    if g.1 = false then (false, g.2)
    else
      let h := B.fixedTest d rows
      if h.1 = true then (true, g.2 + h.2)
      else
        let c := B.child d rows
        let r := solveLevel B ℓ (B.childDeg d) c.1
        (r.1, g.2 + h.2 + c.2 + r.2)
def levelThreshold {n : Nat} (B : GeometryBackend (K := K) L n) : Nat → Nat → Nat
  | 0, _ => 0
  | ℓ + 1, d => max (B.threshold d) (levelThreshold B ℓ (B.childDeg d))
def decide {n : Nat} (B : GeometryBackend (K := K) L n) (F : FieldPresentation K) (d : Nat)
    (rows : List (DenseInput n d K)) : Bool × Nat :=
  let q := binaryPower F.p F.e
  if q.1 ≤ levelThreshold B (n + 1) d then
    let s := smallFieldDecide F rows
    (s.1, q.2 + s.2)
  else
    let s := solveLevel B (n + 1) d rows
    (s.1, q.2 + s.2)
theorem le_of_add_one_le_succ {a : WithBot ℕ∞} {ℓ : Nat}
    (h : a + 1 ≤ ((ℓ + 1 : Nat) : WithBot ℕ∞)) : a ≤ (ℓ : WithBot ℕ∞) := by
  induction a using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe m =>
    have h' : ((m + 1 : ℕ∞) : WithBot ℕ∞) ≤ (((ℓ : ℕ∞) + 1 : ℕ∞) : WithBot ℕ∞) := by
      simpa [WithBot.coe_add, WithBot.coe_one, Nat.cast_add, Nat.cast_one] using h
    rw [WithBot.coe_le_coe] at h'
    have := (ENat.add_le_add_iff_right (by simp : (1 : ℕ∞) ≠ ⊤)).mp h'
    exact_mod_cast this
theorem solveLevel_correct {n : Nat} (B : GeometryBackend (K := K) L n) :
    ∀ (ℓ d : Nat) (rows : List (DenseInput n d K)) fs, Represents rows fs →
      levelThreshold B ℓ d < Fintype.card K →
      geomDim L fs + 1 ≤ (ℓ : WithBot ℕ∞) →
      ((solveLevel B ℓ d rows).1 = true ↔ ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0) := by
  intro ℓ
  induction ℓ with
  | zero =>
    intro d rows fs hrep _ hdim
    simp only [solveLevel, Bool.false_eq_true, false_iff, not_exists]
    exact fun x => no_rational_of_dim_bot L fs (by simpa using hdim) x
  | succ ℓ ih =>
    intro d rows fs hrep hq hdim
    have hq' : max (B.threshold d) (levelThreshold B ℓ (B.childDeg d)) < Fintype.card K := hq
    have hqd : B.threshold d < Fintype.card K := lt_of_le_of_lt (le_max_left _ _) hq'
    have hqc : levelThreshold B ℓ (B.childDeg d) < Fintype.card K :=
      lt_of_le_of_lt (le_max_right _ _) hq'
    cases hg : (geometricFeasible d rows).1 with
    | false =>
      simp only [solveLevel, hg, if_true, Bool.false_eq_true, false_iff, not_exists]
      exact fun x => no_rational_of_infeasible L rows fs hrep hg x
    | true =>
      cases hf : (B.fixedTest d rows).1 with
      | true =>
        simp only [solveLevel, hg, hf, Bool.true_eq_false, if_false, if_true, true_iff]
        exact B.pointExistence d rows fs hrep hqd ((B.fixedTest_correct d rows fs hrep).mp hf)
      | false =>
        simp only [solveLevel, hg, hf, Bool.true_eq_false, Bool.false_eq_true, if_false]
        have hno : ¬ HasFixedComponent L fs := fun h => by
          have := (B.fixedTest_correct d rows fs hrep).mpr h
          rw [hf] at this
          exact Bool.false_ne_true this
        obtain ⟨gs, hgs, hiff, hdim'⟩ := B.child_spec d rows fs hrep hno
        have hdim'' : geomDim L gs + 1 ≤ (ℓ : WithBot ℕ∞) :=
          hdim'.trans (le_of_add_one_le_succ hdim)
        rw [ih (B.childDeg d) (B.child d rows).1 gs hgs hqc hdim'']
        exact exists_congr fun x => (hiff x).symm
theorem decide_correct {n : Nat} (B : GeometryBackend (K := K) L n) (F : FieldPresentation K)
    (d : Nat) (rows : List (DenseInput n d K)) fs (hrep : Represents rows fs)
    (hcard : Fintype.card K = F.p ^ F.e) :
    (decide B F d rows).1 = true ↔ ∃ x : Fin n → K, ∀ v ∈ rows, denseEval x (read v) = 0 := by
  simp only [decide, binaryPower_correct]
  by_cases hsmall : F.p ^ F.e ≤ levelThreshold B (n + 1) d
  · simp only [hsmall, if_true]
    exact smallFieldDecide_correct F rows
  · simp only [hsmall, if_false]
    have hq : levelThreshold B (n + 1) d < Fintype.card K := by
      rw [hcard]; exact Nat.lt_of_not_le hsmall
    rw [solveLevel_correct B (n + 1) d rows fs hrep hq (geomDim_le L fs)]
    exact exists_congr fun x => (represents_eval_iff hrep x).symm
end Mathproof.Problem18ClaudeSolverAssembly20261001
end
section
namespace Mathproof.Problem18ClaudeCollisionAdapter20261001
open MvPolynomial
open Mathproof.Problem18FrobeniusComponentCollision20260930
open Mathproof.Problem18ComponentCollisionDepth20260930
open Mathproof.Problem18ComponentCollisionRecursion20260930
open Mathproof.Problem18ClaudeSolverAssembly20261001
theorem ringKrullDim_quotient_eq_of_radical_eq {R : Type*} [CommRing R] {I J : Ideal R}
    (h : I.radical = J.radical) : ringKrullDim (R ⧸ I) = ringKrullDim (R ⧸ J) := by
  rw [ringKrullDim_quotient, ringKrullDim_quotient, ← PrimeSpectrum.zeroLocus_radical I,
    ← PrimeSpectrum.zeroLocus_radical J, h]
variable {K : Type} [Field K] [DecidableEq K] [Fintype K]
variable (L : Type) [Field L] [Algebra K L] [IsAlgClosed L] [Algebra.IsAlgebraic K L]
theorem rational_iff_of_radical_eq {n : Nat} (fs gs : List (MvPolynomial (Fin n) K))
    (hno : ¬ HasFixedComponent L fs)
    (hrad : (geometricIdeal (L := L) (systemSet gs)).radical =
      (collisionIdeal (geometricIdeal (L := L) (systemSet fs))).radical) (x : Fin n → K) :
    (∀ f ∈ fs, eval x f = 0) ↔ ∀ g ∈ gs, eval x g = 0 := by
  have hno' : ∀ P ∈ (geometricIdeal (L := L) (systemSet fs)).minimalPrimes,
      P.comap (coefficientAutomorphism (FiniteField.frobeniusAlgEquivOfAlgebraic K L)) ≠ P :=
    fun P hP hfix => hno ⟨P, hP, hfix⟩
  have e1 := rational_collision_equivalence (FiniteField.frobeniusAlgEquivOfAlgebraic K L)
    (systemSet fs) hno' x
  have e2 := geometricIdeal_le_rationalPointKernel_iff (L := L) (systemSet gs) x
  have hP : (rationalPointKernel (L := L) x).IsPrime := rationalPointKernel_isPrime x
  have e3 : collisionIdeal (geometricIdeal (L := L) (systemSet fs)) ≤ rationalPointKernel x ↔
      geometricIdeal (L := L) (systemSet gs) ≤ rationalPointKernel x := by
    rw [← Ideal.IsPrime.radical_le_iff hP, ← hrad, Ideal.IsPrime.radical_le_iff hP]
  exact (e1.symm.trans e3).trans e2
theorem geomDim_succ_le_of_radical_eq {n : Nat} (fs gs : List (MvPolynomial (Fin n) K))
    (hrad : (geometricIdeal (L := L) (systemSet gs)).radical =
      (collisionIdeal (geometricIdeal (L := L) (systemSet fs))).radical) :
    geomDim L gs + 1 ≤ geomDim L fs := by
  have h1 := collision_dimension_succ_le (geometricIdeal (L := L) (systemSet fs))
  have h2 : geomDim L gs =
      ringKrullDim (MvPolynomial (Fin n) L ⧸ collisionIdeal (geometricIdeal (L := L) (systemSet fs))) :=
    ringKrullDim_quotient_eq_of_radical_eq hrad
  show geomDim L gs + 1 ≤ ringKrullDim (MvPolynomial (Fin n) L ⧸ geometricIdeal (L := L) (systemSet fs))
  rw [h2]
  exact h1
theorem child_spec_of_radical_eq {n : Nat} (fs gs : List (MvPolynomial (Fin n) K))
    (hno : ¬ HasFixedComponent L fs)
    (hrad : (geometricIdeal (L := L) (systemSet gs)).radical =
      (collisionIdeal (geometricIdeal (L := L) (systemSet fs))).radical) :
    (∀ x : Fin n → K, (∀ f ∈ fs, eval x f = 0) ↔ ∀ g ∈ gs, eval x g = 0) ∧
      geomDim L gs + 1 ≤ geomDim L fs :=
  ⟨rational_iff_of_radical_eq L fs gs hno hrad, geomDim_succ_le_of_radical_eq L fs gs hrad⟩
