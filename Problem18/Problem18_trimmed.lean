theorem mem_plane_iff (a b x : V) : x ∈ plane (K := K) a b ↔ ∃ s t : K, s • a + t • b = x := by
  unfold plane
  rw [Submodule.mem_span_range_iff_exists_fun]
  constructor
  · rintro ⟨c, hc⟩
    refine ⟨c 0, c 1, ?_⟩
    simpa [Fin.sum_univ_two] using hc
  · rintro ⟨s, t, h⟩
    refine ⟨![s, t], ?_⟩
    simpa [Fin.sum_univ_two] using h
theorem a_mem_plane (a b : V) : a ∈ plane (K := K) a b :=
  Submodule.subset_span ⟨0, rfl⟩
theorem b_mem_plane (a b : V) : b ∈ plane (K := K) a b :=
  Submodule.subset_span ⟨1, rfl⟩
theorem linearIndependent_of_hyperbolic (B : BilinForm K V) (hB : B.IsAlt) {a b : V}
    (hab : B a b ≠ 0) : LinearIndependent K ![a, b] := by
  rw [LinearIndependent.pair_iff]
  intro s t h
  have h1 : B a (s • a + t • b) = 0 := by rw [h]; simp
  have h2 : B b (s • a + t • b) = 0 := by rw [h]; simp
  simp only [map_add, map_smul, smul_eq_mul, hB.self_eq_zero, mul_zero, zero_add, add_zero] at h1 h2
  have ht : t = 0 := by
    rcases mul_eq_zero.mp h1 with h | h
    · exact h
    · exact absurd h hab
  have hba : B b a ≠ 0 := by
    intro h; apply hab; rw [← hB.neg_eq]; simp [h]
  have hs : s = 0 := by
    rcases mul_eq_zero.mp h2 with h | h
    · exact h
    · exact absurd h hba
  exact ⟨hs, ht⟩
theorem finrank_plane (B : BilinForm K V) (hB : B.IsAlt) {a b : V} (hab : B a b ≠ 0) :
    finrank K (plane (K := K) a b) = 2 := by
  unfold plane
  rw [finrank_span_eq_card (linearIndependent_of_hyperbolic B hB hab)]
  simp
theorem disjoint_plane_orthogonal (B : BilinForm K V) (hB : B.IsAlt) {a b : V}
    (hab : B a b ≠ 0) : Disjoint (plane (K := K) a b) (B.orthogonal (plane (K := K) a b)) := by
  rw [Submodule.disjoint_def]
  intro x hxW hxO
  rw [LinearMap.BilinForm.mem_orthogonal_iff] at hxO
  obtain ⟨s, t, rfl⟩ := (mem_plane_iff a b x).mp hxW
  have h1 := hxO a (a_mem_plane a b)
  have h2 := hxO b (b_mem_plane a b)
  simp only [map_add, map_smul, smul_eq_mul, hB.self_eq_zero, mul_zero, zero_add, add_zero] at h1 h2
  have ht : t = 0 := by
    rcases mul_eq_zero.mp h1 with h | h
    · exact h
    · exact absurd h hab
  have hba : B b a ≠ 0 := by
    intro h; apply hab; rw [← hB.neg_eq]; simp [h]
  have hs : s = 0 := by
    rcases mul_eq_zero.mp h2 with h | h
    · exact h
    · exact absurd h hba
  simp [hs, ht]
theorem isCompl_plane_orthogonal [FiniteDimensional K V] (B : BilinForm K V) (hB : B.IsAlt)
    {a b : V} (hab : B a b ≠ 0) :
    IsCompl (plane (K := K) a b) (B.orthogonal (plane (K := K) a b)) :=
  (LinearMap.BilinForm.isCompl_orthogonal_iff_disjoint hB.isRefl).mpr
    (disjoint_plane_orthogonal B hB hab)
