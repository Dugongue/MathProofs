def coefficient {c0 m : Nat} (cl : Clause (Fin (c0+m)) Int) (D : Nat) : Nat :=
  clauseCoefficient (.lit 5) (.lit (5+c0)) (.lit (inputBase cl D))
    (lenD (m+1) (clauseDeg cl)) (clauseDeg cl) (sysExprs cl) 0+
  19+decisionCoeff (m+1) (clauseDeg cl) (sysExprs cl).length
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
theorem cost_bound {c0 m : Nat} (cl : Clause (Fin (c0+m)) Int) (D : Nat) :
    cost F cl D ≤ macroBudget F*coefficient cl D*((Fintype.card K).size+1) := by
  have hl:=clause_cost F (.lit 5) (.lit (5+c0)) (.lit (inputBase cl D))
    (lenD (m+1) (clauseDeg cl)) (clauseDeg cl) (sysExprs cl) 0
  have hd:=decision_cost F names geoNames (m+1) (clauseDeg cl) (sysExprs cl).length
    (Problem18ConcreteClauseDecision20261002.reserve cl D) (Fintype.card K)
  have h1: 1 ≤ macroBudget F := (concrete_costBound F).one
  have hs:=Nat.le_mul_of_pos_right
    (macroBudget F*clauseCoefficient (.lit 5) (.lit (5+c0)) (.lit (inputBase cl D))
      (lenD (m+1) (clauseDeg cl)) (clauseDeg cl) (sysExprs cl) 0)
    (show 0<(Fintype.card K).size+1 by omega)
  unfold cost coefficient
  nlinarith
theorem run_bounded {c0 m : Nat} (cl : Clause (Fin (c0+m)) Int) (D B : Nat) (a : Fin c0→K) (σ : Env)
    (hS : Slots F canonical names.q.WS (size cl D) B σ)
    (hz : val F canonical names.q.WS σ 0=0)
    (hQ : σ.vars names.qr=Fintype.card K) (hQB : Fintype.card K<B)
    (hb : ∀ p∈sysExprs cl,∀ e∈rowExprs p (clauseDeg cl),polyDepth e ≤ D ∧ constBound e<B)
    (ha : ∀i:Fin c0,val F canonical names.q.WS σ (5+i.val)=a i)
    (hwords : (sysExprs cl).length+(m+1)+lenM (m+1) (eliminantShift (m+1) (clauseDeg cl))+
      lenD (m+1) (clauseDeg cl)+lenM (m+1) (geoE (m+1) (frobeniusDegree (m+1) (clauseDeg cl)))+
      rowLength (m+1) (clauseDeg cl)<B)
    (htape : σ.InpBounded B) :
    ∃ τ, Run B (program cl D) σ τ (macroBudget F*coefficient cl D*((Fintype.card K).size+1)) ∧
      (τ.vars geoNames.z=1 ↔ (clauseRun cl a).1=true) ∧ τ.vars geoNames.z ≤ 1 ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  obtain ⟨τ,hr,ha,hz,hi,ho⟩:=Problem18ConcreteClauseDecision20261002.run F cl D B a σ hS hz hQ hQB hb ha hwords htape
  exact ⟨τ,hr.mono (cost_bound F cl D),ha,hz,hi,ho⟩
end
