theorem entry_majorant_le (xs : List Entry) (n e : Nat) (p : Entry) (hp : p∈xs) :
    majorant p.2 n e ≤ majorant (xs.foldr (fun p s=>SizeExpr.add p.2 s) (.lit 0)) n e := by
  induction xs with
  | nil=>simp at hp
  | cons a xs ih=>
    simp only [List.mem_cons] at hp
    simp only [List.foldr_cons,majorant]
    rcases hp with rfl|hp
    · omega
    · exact (ih hp).trans (Nat.le_add_left _ _)
