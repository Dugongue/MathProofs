@[simp] theorem installed_acc (sigma : Env)
    (c left right stride scratch prodAddr nextAddr : Nat) :
    (installed sigma c left right stride scratch prodAddr nextAddr).vars acc = scratch := by
  simp [installed,s7,s6,s5,s4,s3,s2,s1,Env.setVar,
    count,baseA,baseB,strideA,strideB,acc,prod,next]
@[simp] theorem installed_prod (sigma : Env)
    (c left right stride scratch prodAddr nextAddr : Nat) :
    (installed sigma c left right stride scratch prodAddr nextAddr).vars prod = prodAddr := by
  simp [installed,s7,s6,s5,s4,s3,s2,s1,Env.setVar,
    count,baseA,baseB,strideA,strideB,acc,prod,next]
@[simp] theorem installed_next (sigma : Env)
    (c left right stride scratch prodAddr nextAddr : Nat) :
    (installed sigma c left right stride scratch prodAddr nextAddr).vars next = nextAddr := by
  simp [installed,s7,s6,s5,s4,s3,s2,s1,Env.setVar,
    count,baseA,baseB,strideA,strideB,acc,prod,next]
structure Installable (B : Nat) (sigma : Env)
    (c left right stride scratch prodAddr nextAddr output : Nat) : Prop where
  count_eval : exA.evalB B sigma = some c
  left_eval : traceBase.evalB B (s1 sigma c) = some left
  right_eval : (Expr.var oneBase).evalB B
    (s2 sigma c left) = some right
  strideA_eval : traceStride.evalB B (s3 sigma c left right) = some stride
  strideB_eval : (Expr.lit 0).evalB B (s4 sigma c left right stride) = some 0
  acc_eval : (Expr.var scratchBase).evalB B
    (s5 sigma c left right stride) = some scratch
  prod_eval : (Expr.add (.var scratchBase) (.var canonical.e)).evalB B
    (s6 sigma c left right stride scratch) = some prodAddr
  next_eval : (Expr.add (.var scratchBase)
      (.mul (.lit 2) (.var canonical.e))).evalB B
    (s7 sigma c left right stride scratch prodAddr) = some nextAddr
  output_eval : outputEntry.evalB B
    (installed sigma c left right stride scratch prodAddr nextAddr) = some output
def installCost : Nat :=
  (1 + exA.size) +
  ((1 + traceBase.size) +
  ((1 + (Expr.var oneBase).size) +
  ((1 + traceStride.size) +
  (2 +
  ((1 + (Expr.var scratchBase).size) +
  ((1 + (Expr.add (.var scratchBase) (.var canonical.e)).size) +
   (1 + (Expr.add (.var scratchBase)
      (.mul (.lit 2) (.var canonical.e))).size)))))))
theorem installDot_run {B c left right stride scratch prodAddr nextAddr output : Nat}
    {sigma : Env}
    (h : Installable B sigma c left right stride scratch prodAddr nextAddr output) :
    Run B installDot sigma
      (installed sigma c left right stride scratch prodAddr nextAddr) installCost := by
  have h1 : Run B (.assign count exA) sigma (s1 sigma c) (1+exA.size) :=
    Run.assign h.count_eval
  have h2 : Run B (.assign baseA traceBase)
      (s1 sigma c) (s2 sigma c left)
      (1+traceBase.size) :=
    Run.assign h.left_eval
  have h3 : Run B (.assign baseB (Expr.var oneBase))
      (s2 sigma c left) (s3 sigma c left right)
      (1+(Expr.var oneBase).size) :=
    Run.assign h.right_eval
  have h4 : Run B (.assign strideA traceStride)
      (s3 sigma c left right) (s4 sigma c left right stride)
      (1+traceStride.size) := Run.assign h.strideA_eval
  have h5 : Run B (.assign strideB (.lit 0))
      (s4 sigma c left right stride) (s5 sigma c left right stride)
      2 := Run.assign h.strideB_eval
  have h6 : Run B (.assign acc (.var scratchBase))
      (s5 sigma c left right stride) (s6 sigma c left right stride scratch)
      (1+(Expr.var scratchBase).size) := Run.assign h.acc_eval
  have h7 : Run B (.assign prod (.add (.var scratchBase) (.var canonical.e)))
      (s6 sigma c left right stride scratch)
      (s7 sigma c left right stride scratch prodAddr)
      (1+(Expr.add (.var scratchBase) (.var canonical.e)).size) :=
    Run.assign h.prod_eval
  have h8 : Run B (.assign next (.add (.var scratchBase)
      (.mul (.lit 2) (.var canonical.e))))
      (s7 sigma c left right stride scratch prodAddr)
      (installed sigma c left right stride scratch prodAddr nextAddr)
      (1+(Expr.add (.var scratchBase)
        (.mul (.lit 2) (.var canonical.e))).size) :=
    Run.assign h.next_eval
  exact (h1.seq (h2.seq (h3.seq (h4.seq (h5.seq (h6.seq (h7.seq h8))))))).mono
    (by rfl)
structure EntryInput (B : Nat) (sigma : Env)
    (c left right stride scratch prodAddr nextAddr output : Nat) : Prop where
  installable : Installable B sigma c left right stride scratch prodAddr nextAddr output
  dot : Problem18IMPMatrixDot20261001.Input F B
    (installed sigma c left right stride scratch prodAddr nextAddr)
  output_fit : Fits F (installed sigma c left right stride scratch prodAddr nextAddr) output
  output_work : ∀ x ∈ [acc,prod,next],
    Disjoint F output
      ((installed sigma c left right stride scratch prodAddr nextAddr).vars x)
  output_modulus : Disjoint F output
    ((installed sigma c left right stride scratch prodAddr nextAddr).vars canonical.modBase)
def entryCost (c : Nat) : Nat :=
  installCost +
    ((38+10000*(F.e+1)^2+2000*(F.e+1))*c+1000*(F.e+1)+12) +
    (3 + (Expr.var acc).size + (Expr.var acc).size + outputEntry.size +
      (Primitive.point .copy).cost F 0)
theorem entryProgram_run {B c left right stride scratch prodAddr nextAddr output : Nat}
    {sigma : Env}
    (h : EntryInput F B sigma c left right stride scratch prodAddr nextAddr output) :
    ∃ tau, Run B entryProgram sigma tau (entryCost F c) ∧
      ValidMemory F B tau ∧
      decode F (slice F tau canonical output) =
        ∑ i ∈ Finset.range c,
          Problem18IMPMatrixDot20261001.term F
            (installed sigma c left right stride scratch prodAddr nextAddr) i ∧
      (∀ j < (sigma.arrs canonical.mem).length,
        (j < output ∨ output + F.e ≤ j) →
        (∀ x ∈ [acc,prod,next],
          j < (installed sigma c left right stride scratch prodAddr nextAddr).vars x ∨
          (installed sigma c left right stride scratch prodAddr nextAddr).vars x + F.e ≤ j) →
        (tau.arrs canonical.mem).getD j 0 =
          (sigma.arrs canonical.mem).getD j 0) := by
  let pi := installed sigma c left right stride scratch prodAddr nextAddr
  obtain ⟨xi, hdot, hxi, hframe, hmemory, hvalue⟩ :=
    Problem18IMPMatrixDot20261001.routine_run F h.dot
  have hacc : xi.vars acc = pi.vars acc :=
    hframe.1 acc (by decide) (by decide)
  have houtReg : xi.vars familyBase = pi.vars familyBase :=
    hframe.1 familyBase (by decide) (by decide)
  have hcursor : xi.vars cursor = pi.vars cursor :=
    hframe.1 cursor (by decide) (by decide)
  have hdegree : xi.vars canonical.e = pi.vars canonical.e :=
    hframe.1 canonical.e (by decide) (by decide)
  have hmod : xi.vars canonical.modBase = pi.vars canonical.modBase :=
    hframe.1 canonical.modBase (by decide) (by decide)
  have hexp : xi.vars canonical.exp = pi.vars canonical.exp :=
    hframe.1 canonical.exp (by decide) (by decide)
  have houtput0 : outputEntry.evalB B xi = some output := by
    simpa [outputEntry,exT,Expr.evalB,houtReg,hcursor,hdegree] using
      h.installable.output_eval
  have haccB : xi.vars acc < B := by
    have hf := h.dot.buffers acc (by simp)
    have hw := h.dot.valid.memory_word
    rw [hacc]
    exact lt_of_le_of_lt (Nat.le_add_right _ _) (hf.trans_lt hw)
  have hea : (Expr.var acc).evalB B xi = some (pi.vars acc) := by
    simpa only [hacc] using
      (evalB_var haccB : (Expr.var acc).evalB B xi = some (xi.vars acc))
  have heb : (Expr.var acc).evalB B
      (xi.setVar canonical.aBase (pi.vars acc)) = some (pi.vars acc) := by
    simpa [Expr.evalB,acc,canonical] using hea
  have heo : outputEntry.evalB B
      ((xi.setVar canonical.aBase (pi.vars acc)).setVar canonical.bBase (pi.vars acc)) =
        some output := by
    simpa [outputEntry,exT,Expr.evalB,familyBase,cursor,canonical] using houtput0
  have haccFits : Fits F xi (pi.vars acc) := by
    unfold Fits
    rw [hframe.2.2.1]
    simpa only using h.dot.buffers acc (by simp)
  have houtFits : Fits F xi output := by
    unfold Fits
    rw [hframe.2.2.1]
    exact h.output_fit
  have hpow : xi.vars canonical.exp < B := by
    rw [hexp]
    exact h.dot.exponent
  obtain ⟨tau,hcopy,htau,hcopyValue,hcopyMem,-⟩ :=
    dynamic_call_run F (.point .copy) (.var acc) (.var acc) outputEntry hxi
      hea heb heo haccFits haccFits houtFits
      (h.output_work acc (by simp))
      (h.output_work acc (by simp))
      (by rw [hmod]; exact h.output_modulus) hpow
  refine ⟨tau,?_,htau,?_,?_⟩
  · have hall := (installDot_run h.installable).seq (hdot.seq hcopy)
