theorem exists_uniform_window_threshold :
    ∃ b₀ : ℕ,1≤b₀ ∧ ∀ b : ℕ,b₀≤b → (2:ℝ)^80*(1+Real.log (b:ℝ))^2≤b := by
  have h0 : Tendsto (fun x : ℝ=>1/x) atTop (𝓝 0) := by
    simpa using Real.tendsto_pow_log_div_mul_add_atTop 1 0 0 one_ne_zero
  have h1 : Tendsto (fun x : ℝ=>Real.log x/x) atTop (𝓝 0) := by
    simpa using Real.tendsto_pow_log_div_mul_add_atTop 1 0 1 one_ne_zero
  have h2 : Tendsto (fun x : ℝ=>(Real.log x)^2/x) atTop (𝓝 0) := by
    simpa using Real.tendsto_pow_log_div_mul_add_atTop 1 0 2 one_ne_zero
  have hh : Tendsto (fun x : ℝ=>(2:ℝ)^80*(1+Real.log x)^2/x) atTop (𝓝 0) := by
    have hl := ((h0.add (h1.const_mul 2)).add h2).const_mul ((2:ℝ)^80)
    convert hl using 1
    · funext x
      ring
    · norm_num
  have he : ∀ᶠ x : ℝ in atTop,(2:ℝ)^80*(1+Real.log x)^2/x<1 :=
    hh.eventually (gt_mem_nhds (by norm_num : (0:ℝ)<1))
  obtain ⟨R,hR⟩ := eventually_atTop.mp he
  refine ⟨max 1 (Nat.ceil R),le_max_left _ _,?_⟩
  intro b hb
  have hb1 : 1≤b := (le_max_left _ _).trans hb
  have hb0 : (0:ℝ)<b := by exact_mod_cast (show 0<b by omega)
  have hRb : R≤(b:ℝ) := (Nat.le_ceil R).trans (by exact_mod_cast (le_max_right 1 (Nat.ceil R)).trans hb)
  have h := (div_lt_iff₀ hb0).mp (hR (b:ℝ) hRb)
  simpa only [one_mul] using h.le
end
end Mathproof.Problem18SpectralUniversalThreshold20261001
