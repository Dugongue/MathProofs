theorem dynamic_call_run (op : Primitive) (a b o : Expr)
    {B av bv ov : Nat} {σ : Env} (h : ValidMemory F B σ)
    (hea : a.evalB B σ=some av)
    (heb : b.evalB B (σ.setVar canonical.aBase av)=some bv)
    (heo : o.evalB B ((σ.setVar canonical.aBase av).setVar canonical.bBase bv)=some ov)
    (ha : Fits F σ av) (hb : Fits F σ bv) (ho : Fits F σ ov)
    (hoa : Disjoint F ov av) (hob : Disjoint F ov bv)
    (hom : Disjoint F ov (σ.vars canonical.modBase))
    (hex : σ.vars canonical.exp<B) :
    ∃τ, Run B (call canonical a b o op.code) σ τ
      (3+a.size+b.size+o.size+op.cost F (σ.vars canonical.exp)) ∧
      ValidMemory F B τ ∧
      decode F (slice F τ canonical ov)=op.value (σ.vars canonical.exp)
        (decode F (slice F σ canonical av)) (decode F (slice F σ canonical bv)) ∧
      (∀j<(σ.arrs canonical.mem).length,j<ov ∨ ov+F.e≤j →
        (τ.arrs canonical.mem).getD j 0=(σ.arrs canonical.mem).getD j 0) ∧
      CallPreserves σ τ := by
