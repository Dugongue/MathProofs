  have hrightξ:ξ.vars rightReg=σ.vars rightReg:=hfixξ rightReg (by simp [controls])
  have hend:endSlot ξ=inStart (n*n) (vs.length*(m+1)):=by
    simp only [endSlot,row,total,hNξ,hcξ,hmξ]; congr 1; ring
  have hbegin:beginSlot ξ=inStart (n*n) vs.length:=by simp [beginSlot,row,hNξ,hcξ]
  have hdata : ∀i (hi:i < vs.length) (k:Fin (n*n)),
      val F canonical q.WS τ (inStart (n*n) i+k.val)=read (vs[i]'hi) k := by
    intro i hi k
