    have := Nat.mul_le_mul hbb hcbb
    have : s ^ 2 * s ^ 3 = s ^ 5 := by rw [← pow_add]
    nlinarith
  have h6b : a * a * (b * b * (a * a)) ≤ s ^ 6 := by
    have := Nat.mul_le_mul haa hbbaa
    have : s ^ 2 * s ^ 4 = s ^ 6 := by rw [← pow_add]
    nlinarith
  have hB1 := blockSize_le (N := c * (b * b)) (M := b * b) (by omega) hbb hs1
  have hB2 := blockSize_le (N := b * b * (a * a)) (M := a * a) hbbaa haa hs1
