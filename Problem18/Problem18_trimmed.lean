    rw [deg_add,hD,zero_add]; exact hB)
  have hdeg' : deg k K A = deg k K B := by simpa only [deg_add,hD,zero_add] using hdeg
  refine ⟨⟨A,hA,hdeg'⟩,Subtype.ext ?_⟩
