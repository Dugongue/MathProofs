  trow : Problem18IMPMatrixMemory20261001.matrix F τ (sb + F.e*tN n d) 1 (n+1) =
    Matrix.of (fun _ k => tvec X k)
  ones : Problem18IMPMatrixMemory20261001.matrix F τ (sb + F.e*0) 1 d = (fun _ _ => 1)
