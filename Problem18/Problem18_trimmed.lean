namespace Mathproof.Problem18BoundedPlaceFiniteness20260930
open FunctionField FunctionField.Chart Module
open scoped Polynomial RatFunc WithZero
variable (k K : Type*) [Field k] [Field K]
  [Algebra k K] [Algebra k[X] K] [Algebra k⟮X⟯ K] [IsScalarTower k k[X] K]
  [IsScalarTower k[X] k⟮X⟯ K] [_root_.FunctionField k K]
  [Algebra.IsSeparable k⟮X⟯ K] [FunctionField.IsFullConstantField k K]
theorem canonical_degree {W : DivisorA k K} (hW : IsCanonical k K W) :
    deg k K W = 2*(genus k K : ℤ)-2 := by
  have h0 := riemann_roch k K hW 0
  have h1 := riemann_roch k K hW W
  rw [ell_zero, deg_zero, sub_zero] at h0
  rw [sub_self, ell_zero] at h1
  omega
theorem ell_eq_of_large_degree (D : DivisorA k K)
    (hD : 2*(genus k K : ℤ)-2 < deg k K D) :
    (ell k K D : ℤ) = deg k K D+1-genus k K := by
  obtain ⟨W,hW⟩ := exists_isCanonical k K
  have hneg : deg k K (W-D) < 0 := by rw [deg_sub, canonical_degree k K hW]; omega
  have h := riemann_roch k K hW D
  rw [RRspace_neg_deg_ell k K hneg] at h
  simpa using h
theorem RRspace_inf (D E : DivisorA k K) :
    RRspace k K (D ⊓ E) = RRspace k K D ⊓ RRspace k K E := by
  ext f
  constructor
  · intro hf
    exact ⟨RRspace_mono k K inf_le_left hf, RRspace_mono k K inf_le_right hf⟩
  · rintro ⟨hD,hE⟩ v
    change placeValuation k K v f ≤ WithZero.exp (min (D v) (E v))
    rcases le_total (D v) (E v) with h | h
    · rw [min_eq_left h]; exact hD v
    · rw [min_eq_right h]; exact hE v
theorem bounded_place_subspaces_injective (r : Nat) (D : DivisorA k K)
    (hD : 2*(genus k K : ℤ)-2+2*r < deg k K D) :
    Function.Injective (fun P : {P : PlaceA k K // placeDegree k K P ≤ r} =>
      RRspace k K (D-Finsupp.single P.val 1)) := by
  classical
  intro P Q heq
  change RRspace k K (D-Finsupp.single P.val 1) =
    RRspace k K (D-Finsupp.single Q.val 1) at heq
  apply Subtype.ext
  by_contra hPQ
  have hdiv : (D-Finsupp.single P.val 1) ⊓ (D-Finsupp.single Q.val 1) =
      D-Finsupp.single P.val 1-Finsupp.single Q.val 1 := by
    ext v
    by_cases hp : v=P.val
    · subst v; simp [Finsupp.single_apply,hPQ] <;> omega
    · by_cases hq : v=Q.val
      · subst v; simp [Finsupp.single_apply,hPQ,Ne.symm hPQ] <;> omega
      · simp [Finsupp.single_apply,hp,hq]
  have hinter : RRspace k K (D-Finsupp.single P.val 1-Finsupp.single Q.val 1) =
      RRspace k K (D-Finsupp.single P.val 1) := by
    rw [← hdiv, RRspace_inf, ← heq, inf_idem]
  have hp : (placeDegree k K P.val : ℤ) ≤ r := by exact_mod_cast P.property
  have hq : (placeDegree k K Q.val : ℤ) ≤ r := by exact_mod_cast Q.property
  have hp0 : (0 : ℤ) < placeDegree k K Q.val := by exact_mod_cast placeDegree_pos k K Q.val
  have ha := ell_eq_of_large_degree k K (D-Finsupp.single P.val 1) (by
    rw [deg_sub, deg_single]; omega)
  have hb := ell_eq_of_large_degree k K (D-Finsupp.single P.val 1-Finsupp.single Q.val 1) (by
    rw [deg_sub, deg_sub, deg_single, deg_single]; omega)
  have he := congrArg (fun U : Submodule k K => finrank k U) hinter
  change ell k K (D-Finsupp.single P.val 1-Finsupp.single Q.val 1) =
    ell k K (D-Finsupp.single P.val 1) at he
  rw [deg_sub, deg_single] at ha
  rw [deg_sub, deg_sub, deg_single, deg_single, he] at hb
  omega
theorem finite_chart_places_degree_le [Finite k] (r : Nat) :
    {P : PlaceA k K | placeDegree k K P ≤ r}.Finite := by
  classical
  let D : DivisorA k K := (2*genus k K+2*r+1) • polarDivisor k K (XK k K)
  have hn : (1 : ℤ) ≤ finrank k⟮X⟯ K := by exact_mod_cast finrank_pos (R:=k⟮X⟯) (M:=K)
  have hD : 2*(genus k K : ℤ)-2+2*r < deg k K D := by
    dsimp [D]
    rw [deg_nsmul,deg_polarX_eq_finrank]
    push_cast
    nlinarith
  let W := RRspace k K D
  letI : Finite W := Finite.of_equiv _ (Module.finBasis k W).equivFun.toEquiv.symm
  let ψ : {P : PlaceA k K // placeDegree k K P ≤ r} → Set W :=
    fun P => {f | (f : K) ∈ RRspace k K (D-Finsupp.single P.val 1)}
  have hinj : Function.Injective ψ := by
    intro P Q h
    apply bounded_place_subspaces_injective k K r D hD
    ext f
    have hle (v : PlaceA k K) : RRspace k K (D-Finsupp.single v 1) ≤ W := by
      apply RRspace_mono k K
      intro w
      have hs : (0 : ℤ) ≤ Finsupp.single v 1 w := by simp only [Finsupp.single_apply]; split_ifs <;> norm_num
      simp only [Finsupp.sub_apply]
      omega
    by_cases hf : f ∈ W
    · exact Iff.of_eq (congrArg (fun s : Set W => (⟨f,hf⟩ : W) ∈ s) h)
    · have hp : f ∉ RRspace k K (D-Finsupp.single P.val 1) := fun hp => hf (hle P hp)
      have hq : f ∉ RRspace k K (D-Finsupp.single Q.val 1) := fun hq => hf (hle Q hq)
      simp only [hp,hq]
  letI : Finite ↥{P : PlaceA k K | placeDegree k K P ≤ r} := Finite.of_injective ψ hinj
  exact Set.toFinite _
end Mathproof.Problem18BoundedPlaceFiniteness20260930
end
