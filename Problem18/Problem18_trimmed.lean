structure Location where
  base : String
  offset : Nat
def Location.expr (l : Location) : Expr :=
  .add (.var l.base) (.mul (.lit l.offset) (.var canonical.e))
def Location.address (l : Location) (σ : Env) : Nat :=
  σ.vars l.base+l.offset*σ.vars canonical.e
def callRegisters : List String :=
  scratchRegisters++[canonical.aBase,canonical.bBase,canonical.outBase]
def Location.Safe (l : Location) : Prop := l.base∉callRegisters
def CallPreserves (σ τ : Env) : Prop :=
  (∀x,x∉callRegisters → τ.vars x=σ.vars x) ∧
  (∀arr,arr≠canonical.mem → arr≠canonical.scratch → τ.arrs arr=σ.arrs arr) ∧
  (∀arr,(τ.arrs arr).length=(σ.arrs arr).length) ∧ τ.inp=σ.inp ∧ τ.out=σ.out
theorem preserves_toCall {σ τ : Env} (h : Preserves σ τ) : CallPreserves σ τ := by
  refine ⟨?_,h.2⟩
  intro x hx
  apply h.1 x
  intro hh
  exact hx (List.mem_append_left _ hh)
variable {K : Type} [Field K] {F : FieldPresentation K} {B : Nat} {σ τ : Env}
theorem Location.eval (l : Location) (h : ValidMemory F B σ)
    (hfit : Fits F σ (l.address σ)) : l.expr.evalB B σ=some (l.address σ) := by
  have ha : l.address σ<B:=lt_of_le_of_lt (Nat.le_add_right _ _) (hfit.trans_lt h.memory_word)
  have hb : σ.vars l.base<B:=by unfold Location.address at ha; omega
  have he : σ.vars canonical.e<B:=by rw [h.degree]; exact h.degree_word
  have hp : l.offset*σ.vars canonical.e<B:=by unfold Location.address at ha; omega
  have hn : l.offset<B := by
    have hm:=Nat.le_mul_of_pos_right l.offset (by rw [h.degree]; exact F.degree_pos : 0 < σ.vars canonical.e)
    exact hm.trans_lt hp
  have hm:=evalB_bin (op:=Bop.mul) (evalB_lit hn) (evalB_var he) hp
  exact evalB_bin (op:=Bop.add) (evalB_var hb) hm ha
theorem Location.address_preserved (l : Location) (hs : l.Safe) (hf : CallPreserves σ τ) :
    l.address τ=l.address σ := by
  unfold Location.address
  rw [hf.1 l.base hs,hf.1 canonical.e (by decide)]
theorem validMemory_arguments (h : ValidMemory F B σ) (a b o : Nat) :
    ValidMemory F B (arguments canonical σ a b o) := by
  refine {
    degree:=?_,prime:=?_,arithmetic_word:=h.arithmetic_word,inverse_word:=h.inverse_word,
    memory_word:=h.memory_word,scratch_word:=h.scratch_word,scratch_fit:=h.scratch_fit,
    modulus_fit:=?_,modulus_value:=?_,coefficients:=h.coefficients }
  · simpa [arguments,canonical] using h.degree
  · simpa [arguments,canonical] using h.prime
  · simpa [arguments,canonical] using h.modulus_fit
  · intro i
    simpa [Problem18IMPFieldMultiplication20261001.sourceCoeff,arguments,canonical] using h.modulus_value i
structure Instruction (ι : Type) where
  op : Primitive
  first : ι
  second : ι
  output : ι
def Instruction.code {ι : Type} (loc : ι→Location) (i : Instruction ι) : Com :=
  call canonical (loc i.first).expr (loc i.second).expr (loc i.output).expr i.op.code
def Instruction.cost {ι : Type} (loc : ι→Location) (i : Instruction ι)
    (F : FieldPresentation K) (q : Nat) : Nat :=
  3+(loc i.first).expr.size+(loc i.second).expr.size+(loc i.output).expr.size+i.op.cost F q
def Represents {ι : Type} (F : FieldPresentation K) (loc : ι→Location) (σ : Env) (v : ι→K) : Prop :=
  ∀i,decode F (slice F σ canonical ((loc i).address σ))=v i
def OutsideFrame {ι : Type} (F : FieldPresentation K) (loc : ι→Location) (σ τ : Env) : Prop :=
  ∀j<(σ.arrs canonical.mem).length,
    (∀i,j<(loc i).address σ ∨ (loc i).address σ+F.e ≤ j) →
    (τ.arrs canonical.mem).getD j 0=(σ.arrs canonical.mem).getD j 0
structure Layout {ι : Type} (F : FieldPresentation K) (loc : ι→Location) (σ : Env) : Prop where
  safe : ∀i,(loc i).Safe
  fits : ∀i,Fits F σ ((loc i).address σ)
  disjoint : ∀i j,i≠j → Disjoint F ((loc i).address σ) ((loc j).address σ)
  modulus : ∀i,Disjoint F ((loc i).address σ) (σ.vars canonical.modBase)
def Instruction.Valid {ι : Type} (i : Instruction ι) : Prop :=
  i.output≠i.first ∧ i.output≠i.second
variable {ι : Type} [DecidableEq ι] {loc : ι→Location} {v : ι→K}
def Instruction.value (i : Instruction ι) (q : Nat) (v : ι→K) : ι→K :=
  Function.update v i.output (i.op.value q (v i.first) (v i.second))
theorem CallPreserves.trans {ξ : Env} (h : CallPreserves σ τ) (h' : CallPreserves τ ξ) :
    CallPreserves σ ξ := by
  exact ⟨fun x hx=>(h'.1 x hx).trans (h.1 x hx),
    fun a hm hs=>(h'.2.1 a hm hs).trans (h.2.1 a hm hs),
    fun a=>(h'.2.2.1 a).trans (h.2.2.1 a),h'.2.2.2.1.trans h.2.2.2.1,h'.2.2.2.2.trans h.2.2.2.2⟩
theorem Layout.preserved (hl : Layout F loc σ) (hf : CallPreserves σ τ) : Layout F loc τ := by
  refine ⟨hl.safe,?_,?_,?_⟩
  · intro i
    unfold Fits
    rw [(loc i).address_preserved (hl.safe i) hf,hf.2.2.1]
    exact hl.fits i
  · intro i j hij
    rw [(loc i).address_preserved (hl.safe i) hf,(loc j).address_preserved (hl.safe j) hf]
    exact hl.disjoint i j hij
  · intro i
    rw [(loc i).address_preserved (hl.safe i) hf,hf.1 canonical.modBase (by decide)]
    exact hl.modulus i
theorem Location.eval_setVar (l : Location) (x : String) (n : Nat)
    (hx : l.base≠x) (he : canonical.e≠x) :
    l.expr.evalB B (σ.setVar x n)=l.expr.evalB B σ := by
  simp [Location.expr,Expr.evalB,hx,he]
theorem Location.safe_args (l : Location) (hs : l.Safe) :
    l.base≠canonical.aBase ∧ l.base≠canonical.bBase ∧ l.base≠canonical.outBase := by
  simp only [Location.Safe,callRegisters,List.mem_append,List.mem_cons,List.not_mem_nil,or_false,not_or] at hs
  exact hs.2
theorem instruction_run (i : Instruction ι) (hi : i.Valid)
    (h : ValidMemory F B σ) (hl : Layout F loc σ) (hv : Represents F loc σ v)
    (hex : σ.vars canonical.exp<B) :
    ∃τ,Run B (i.code loc) σ τ (i.cost loc F (σ.vars canonical.exp)) ∧
      ValidMemory F B τ ∧ Layout F loc τ ∧
      Represents F loc τ (i.value (σ.vars canonical.exp) v) ∧ CallPreserves σ τ ∧ OutsideFrame F loc σ τ := by
  let av:=(loc i.first).address σ
  let bv:=(loc i.second).address σ
  let ov:=(loc i.output).address σ
  let ξ:=arguments canonical σ av bv ov
  have hξ : ValidMemory F B ξ:=validMemory_arguments h av bv ov
  have ha : ξ.vars canonical.aBase=av:=by simp [ξ,arguments,canonical]
  have hb : ξ.vars canonical.bBase=bv:=by simp [ξ,arguments,canonical]
  have ho : ξ.vars canonical.outBase=ov:=by simp [ξ,arguments,canonical]
  have hq : ξ.vars canonical.exp=σ.vars canonical.exp:=by simp [ξ,arguments,canonical]
  have hm : ξ.vars canonical.modBase=σ.vars canonical.modBase:=by simp [ξ,arguments,canonical]
  obtain ⟨τ,hr,hτ,hval,hmem,hframe⟩:=primitive_run_preserving i.op hξ
    (by change ξ.vars canonical.aBase+F.e ≤ (σ.arrs canonical.mem).length; rw [ha]; exact hl.fits i.first)
    (by change ξ.vars canonical.bBase+F.e ≤ (σ.arrs canonical.mem).length; rw [hb]; exact hl.fits i.second)
    (by change ξ.vars canonical.outBase+F.e ≤ (σ.arrs canonical.mem).length; rw [ho]; exact hl.fits i.output)
    (by rw [ho,ha]; exact hl.disjoint i.output i.first hi.1)
    (by rw [ho,hb]; exact hl.disjoint i.output i.second hi.2)
    (by rw [ho,hm]; exact hl.modulus i.output)
    (by rw [hq]; exact hex)
  have hrun : Run B (i.code loc) σ τ (i.cost loc F (σ.vars canonical.exp)) := by
    have hea:=(loc i.first).eval h (hl.fits i.first)
    have heb : (loc i.second).expr.evalB B (σ.setVar canonical.aBase av)=some bv := by
      rw [Location.eval_setVar _ _ _ ((loc i.second).safe_args (hl.safe i.second)).1 (by decide)]
      exact (loc i.second).eval h (hl.fits i.second)
    have heo : (loc i.output).expr.evalB B ((σ.setVar canonical.aBase av).setVar canonical.bBase bv)=some ov := by
      rw [Location.eval_setVar _ _ _ ((loc i.output).safe_args (hl.safe i.output)).2.1 (by decide)]
      rw [Location.eval_setVar _ _ _ ((loc i.output).safe_args (hl.safe i.output)).1 (by decide)]
      exact (loc i.output).eval h (hl.fits i.output)
    have hh:=call_run canonical _ _ _ i.op.code hea heb heo hr
    simpa only [Instruction.code,Instruction.cost,hq] using hh
  have hf : CallPreserves σ τ := by
    refine ⟨?_,hframe.2⟩
    intro x hx
    simp only [callRegisters,List.mem_append,List.mem_cons,List.not_mem_nil,or_false,not_or] at hx
    exact (hframe.1 x hx.1).trans (arguments_vars canonical σ av bv ov x hx.2.1 hx.2.2.1 hx.2.2.2)
  have hvalue : decode F (slice F τ canonical ov)=i.op.value (σ.vars canonical.exp)
      (v i.first) (v i.second) := by
    rw [ha,hb,ho,hq] at hval
    change decode F (slice F τ canonical ov)=i.op.value (σ.vars canonical.exp)
      (decode F (slice F σ canonical av)) (decode F (slice F σ canonical bv)) at hval
    change decode F (slice F τ canonical ov)=i.op.value (σ.vars canonical.exp)
      (decode F (slice F σ canonical ((loc i.first).address σ)))
      (decode F (slice F σ canonical ((loc i.second).address σ))) at hval
    rw [hv i.first,hv i.second] at hval
    exact hval
  have houtside : OutsideFrame F loc σ τ := by
    intro j hj hd
    apply hmem j hj
    simpa only [ho] using hd i.output
  refine ⟨τ,hrun,hτ,hl.preserved hf,?_,hf,houtside⟩
  intro j
  rw [(loc j).address_preserved (hl.safe j) hf]
  by_cases hjo : j=i.output
  · subst j
    simpa only [Instruction.value,Function.update_self,ov] using hvalue
  · rw [Instruction.value,Function.update_of_ne hjo]
    have hslice : slice F τ canonical ((loc j).address σ)=slice F σ canonical ((loc j).address σ) := by
      funext k
      apply hmem
      · change (loc j).address σ+k.val<(σ.arrs canonical.mem).length
        have hh:=hl.fits j; have hk:=k.isLt; omega
      · rw [ho]
        have hd:=hl.disjoint i.output j (Ne.symm hjo)
        have hk:=k.isLt
        change (loc j).address σ+k.val<ov ∨ ov+F.e ≤ (loc j).address σ+k.val
        rcases hd with hd|hd <;> dsimp [ov] <;> omega
    rw [hslice]
    exact hv j
def programCode (loc : ι→Location) : List (Instruction ι) → Com
  | []=>.skip
  | i::is=>.seq (i.code loc) (programCode loc is)
def programCost (loc : ι→Location) (F : FieldPresentation K) (q : Nat) : List (Instruction ι)→Nat
  | []=>1
  | i::is=>i.cost loc F q+programCost loc F q is
def programValue (q : Nat) : List (Instruction ι)→(ι→K)→(ι→K)
  | [],v=>v
  | i::is,v=>programValue q is (i.value q v)
theorem program_run (is : List (Instruction ι)) (hi : ∀i∈is,i.Valid)
    (h : ValidMemory F B σ) (hl : Layout F loc σ) (hv : Represents F loc σ v)
    (hex : σ.vars canonical.exp<B) :
    ∃τ,Run B (programCode loc is) σ τ (programCost loc F (σ.vars canonical.exp) is) ∧
      ValidMemory F B τ ∧ Layout F loc τ ∧
      Represents F loc τ (programValue (σ.vars canonical.exp) is v) ∧ CallPreserves σ τ ∧ OutsideFrame F loc σ τ := by
  induction is generalizing σ v with
  | nil =>
    exact ⟨σ,Run.skip,h,hl,hv,⟨fun _ _=>rfl,fun _ _ _=>rfl,fun _=>rfl,rfl,rfl⟩,fun _ _ _=>rfl⟩
  | cons i is ih =>
    obtain ⟨ξ,hr,hξ,hlξ,hvξ,hf,hm⟩:=instruction_run i (hi i (by simp)) h hl hv hex
    have hq : ξ.vars canonical.exp=σ.vars canonical.exp:=hf.1 _ (by decide)
    obtain ⟨τ,hr',hτ,hlτ,hvτ,hf',hm'⟩:=ih (fun j hj=>hi j (by simp [hj])) hξ hlξ hvξ (by rw [hq]; exact hex)
    rw [hq] at hr' hvτ
    refine ⟨τ,hr.seq hr',hτ,hlτ,hvτ,hf.trans hf',?_⟩
    intro j hj hd
    apply (hm' j (by rw [hf.2.2.1]; exact hj) ?_).trans (hm j hj hd)
    intro i
    rw [(loc i).address_preserved (hl.safe i) hf]
    exact hd i
end Mathproof.Problem18IMPFieldCircuit20261001
end
