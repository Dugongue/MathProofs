variable {σ τ R K : Type*} [CommRing R] [Field K]
abbrev Literal (σ R : Type*) := PolyExpr σ R × Bool
abbrev Clause (σ R : Type*) := List (Literal σ R)
def literalHolds (f : R→+*K) (x : σ→K) (l : Literal σ R) : Prop :=
  if l.2 then interpret f x l.1=0 else interpret f x l.1≠0
def clauseHolds (f : R→+*K) (x : σ→K) (c : Clause σ R) : Prop :=
  ∀ l∈c, literalHolds f x l
def clauses : TestTree σ R → List (Clause σ R)
  | .accept => [[]]
  | .reject => []
  | .test p z n => (clauses z).map (List.cons (p,true)) ++
      (clauses n).map (List.cons (p,false))
theorem clauses_correct (f : R→+*K) (x : σ→K) (T : TestTree σ R) :
    (∃ c∈clauses T, clauseHolds f x c) ↔ T.Holds f x := by
  induction T with
  | accept => simp [clauses,clauseHolds,TestTree.Holds]
  | reject => simp [clauses,TestTree.Holds]
  | test p z n ihz ihn =>
    constructor
    · rintro ⟨c,hc,h⟩
      rcases List.mem_append.mp hc with hc | hc
      · obtain ⟨a,ha,rfl⟩:=List.mem_map.mp hc
        have hp:=h (p,true) List.mem_cons_self
        change interpret f x p=0 at hp
        exact Or.inl ⟨hp,ihz.mp ⟨a,ha,fun l hl=>h l (List.mem_cons_of_mem _ hl)⟩⟩
      · obtain ⟨a,ha,rfl⟩:=List.mem_map.mp hc
        have hp:=h (p,false) List.mem_cons_self
        change interpret f x p≠0 at hp
        exact Or.inr ⟨hp,ihn.mp ⟨a,ha,fun l hl=>h l (List.mem_cons_of_mem _ hl)⟩⟩
    · rintro (⟨hp,hz⟩|⟨hp,hn⟩)
      · obtain ⟨a,ha,h⟩:=ihz.mpr hz
        refine ⟨(p,true)::a,List.mem_append_left _ (List.mem_map.mpr ⟨a,ha,rfl⟩),?_⟩
        intro l hl
        rcases List.mem_cons.mp hl with rfl | hl
        · exact hp
        · exact h l hl
      · obtain ⟨a,ha,h⟩:=ihn.mpr hn
        refine ⟨(p,false)::a,List.mem_append_right _ (List.mem_map.mpr ⟨a,ha,rfl⟩),?_⟩
        intro l hl
        rcases List.mem_cons.mp hl with rfl | hl
        · exact hp
        · exact h l hl
def negate : TestTree σ R → TestTree σ R
  | .accept => .reject
  | .reject => .accept
  | .test p z n => .test p (negate z) (negate n)
theorem negate_correct (f : R→+*K) (x : σ→K) (T : TestTree σ R) :
    (negate T).Holds f x ↔ ¬T.Holds f x := by
  induction T with
  | accept => simp [negate,TestTree.Holds]
  | reject => simp [negate,TestTree.Holds]
  | test p z n ihz ihn =>
    classical
    by_cases hp : interpret f x p=0 <;>
      simp [negate,TestTree.Holds,hp,ihz,ihn]
def disj (S : TestTree σ R) : TestTree σ R → TestTree σ R
  | .accept => .accept
  | .reject => S
  | .test p z n => .test p (disj S z) (disj S n)
theorem disj_correct (f : R→+*K) (x : σ→K) (S T : TestTree σ R) :
    (disj S T).Holds f x ↔ S.Holds f x ∨ T.Holds f x := by
  induction T with
  | accept => simp [disj,TestTree.Holds]
  | reject => simp [disj,TestTree.Holds]
  | test p z n ihz ihn =>
    classical
    by_cases hp : interpret f x p=0 <;> simp [disj,TestTree.Holds,hp,ihz,ihn]
abbrev Sparse (N : Nat) (σ R : Type*) := List (FinExponent N × PolyExpr σ R)
def addExponent {N : Nat} (a b : FinExponent N) : FinExponent N :=
  functionToExponent (fun i => a i+b i)
def unitExponent {N : Nat} (i : Fin N) : FinExponent N :=
  functionToExponent (fun j => if j=i then 1 else 0)
@[simp] theorem addExponent_eq {N : Nat} (a b : FinExponent N) : addExponent a b=a+b := by
  ext i; rfl
@[simp] theorem unitExponent_eq {N : Nat} (i : Fin N) : unitExponent i=Finsupp.single i 1 := by
  ext j; simp [unitExponent,functionToExponent,Finsupp.single_apply,eq_comm]
def sparseMul {N : Nat} (s t : Sparse N σ R) : Sparse N σ R :=
  s.flatMap fun a => t.map fun b => (addExponent a.1 b.1,PolyExpr.mul a.2 b.2)
def expand {N : Nat} (split : τ→σ⊕Fin N) : PolyExpr τ R → Sparse N σ R
  | .const c => [(0,.const c)]
  | .var i => match split i with
      | .inl j => [(0,.var j)]
      | .inr j => [(unitExponent j,.const 1)]
  | .add a b => expand split a ++ expand split b
  | .mul a b => sparseMul (expand split a) (expand split b)
noncomputable def sparsePolynomial {N : Nat} (f : R→+*K) (x : σ→K) (s : Sparse N σ R) :
    MvPolynomial (Fin N) K := (s.map (fun a => monomial a.1 (interpret f x a.2))).sum
@[simp] theorem sparsePolynomial_append {N : Nat} (f : R→+*K) (x : σ→K)
    (s t : Sparse N σ R) : sparsePolynomial f x (s++t)=sparsePolynomial f x s+sparsePolynomial f x t := by
  simp [sparsePolynomial]
theorem sparsePolynomial_mul {N : Nat} (f : R→+*K) (x : σ→K) (s t : Sparse N σ R) :
    sparsePolynomial f x (sparseMul s t)=sparsePolynomial f x s*sparsePolynomial f x t := by
  induction s with
  | nil => simp [sparseMul,sparsePolynomial]
  | cons a s ih =>
    have ht : sparsePolynomial f x (t.map fun b => (addExponent a.1 b.1,PolyExpr.mul a.2 b.2))=
        monomial a.1 (interpret f x a.2)*sparsePolynomial f x t := by
      clear ih s
      induction t with
      | nil => simp [sparsePolynomial]
      | cons b t iht =>
        simpa only [sparsePolynomial,List.map_cons,List.sum_cons,List.map_map,interpret,
          addExponent_eq,monomial_mul,mul_add] using congrArg
            (fun z => monomial a.1 (interpret f x a.2)*monomial b.1 (interpret f x b.2)+z) iht
    change sparsePolynomial f x
      ((t.map fun b => (addExponent a.1 b.1,PolyExpr.mul a.2 b.2))++sparseMul s t)=_
    rw [sparsePolynomial_append,ht,ih]
    simp only [sparsePolynomial,List.map_cons,List.sum_cons,add_mul]
theorem expand_eval {N : Nat} (split : τ→σ⊕Fin N) (f : R→+*K) (x : σ→K) (y : Fin N→K)
    (p : PolyExpr τ R) :
    eval y (sparsePolynomial f x (expand split p))=
      interpret f (fun i => Sum.elim x y (split i)) p := by
  induction p with
  | const c => simp [expand,sparsePolynomial,interpret]
  | var i =>
    cases hi : split i with
    | inl j => simp [expand,hi,sparsePolynomial,interpret]
    | inr j => simp [expand,hi,sparsePolynomial,interpret,MvPolynomial.eval_monomial]
  | add a b iha ihb => simp [expand,interpret,iha,ihb]
  | mul a b iha ihb => rw [expand,sparsePolynomial_mul,map_mul,iha,ihb]; rfl
def SparseBound {N : Nat} (s : Sparse N σ R) (d : Nat) : Prop :=
  ∀ a∈s, a.1.degree≤d
theorem expand_bound {N : Nat} (split : τ→σ⊕Fin N) (p : PolyExpr τ R) :
    SparseBound (expand split p) p.degree := by
  induction p with
  | const c => simp [SparseBound,expand,PolyExpr.degree]
  | var i =>
    cases hi : split i <;> simp [SparseBound,expand,hi,PolyExpr.degree,Finsupp.degree_single]
  | add a b iha ihb =>
    intro t ht
    rcases List.mem_append.mp ht with ht | ht
    · exact (iha t ht).trans (Nat.le_max_left _ _)
    · exact (ihb t ht).trans (Nat.le_max_right _ _)
  | mul a b iha ihb =>
    intro t ht
    obtain ⟨u,hu,ht⟩ := List.mem_flatMap.mp ht
    obtain ⟨v,hv,rfl⟩ := List.mem_map.mp ht
    simpa only [PolyExpr.degree,addExponent_eq,map_add] using Nat.add_le_add (iha u hu) (ihb v hv)
theorem sparsePolynomial_degree {N : Nat} (f : R→+*K) (x : σ→K)
    (s : Sparse N σ R) (d : Nat) (hs : SparseBound s d) :
    (sparsePolynomial f x s).totalDegree≤d := by
  induction s with
  | nil => simp [sparsePolynomial]
  | cons a s ih =>
    have ha := hs a List.mem_cons_self
    have ht := ih (fun b hb => hs b (List.mem_cons_of_mem a hb))
    exact (totalDegree_add _ _).trans (max_le
      ((totalDegree_monomial_le _ _).trans ha) ht)
def sparseCoefficient {N : Nat} (a : FinExponent N) (s : Sparse N σ R) : PolyExpr σ R :=
  PolyExpr.sum (s.map fun t => if t.1=a then t.2 else .const 0)
theorem interpret_sum (f : R→+*K) (x : σ→K) (ps : List (PolyExpr σ R)) :
    interpret f x (PolyExpr.sum ps)=(ps.map (interpret f x)).sum := by
  induction ps with
  | nil => simp [PolyExpr.sum,PolyExpr.zero,interpret]
  | cons p ps ih => simp [PolyExpr.sum,interpret,ih]
theorem sparseCoefficient_correct {N : Nat} (f : R→+*K) (x : σ→K)
    (a : FinExponent N) (s : Sparse N σ R) :
    interpret f x (sparseCoefficient a s)=coeff a (sparsePolynomial f x s) := by
  induction s with
  | nil => simp [sparseCoefficient,PolyExpr.sum,PolyExpr.zero,sparsePolynomial,interpret]
  | cons t s ih =>
    simp only [sparseCoefficient,sparsePolynomial,List.map_cons,PolyExpr.sum,List.sum_cons,
      interpret,coeff_add]
    change interpret f x (PolyExpr.sum (s.map fun t => if t.1=a then t.2 else .const 0))=
      coeff a (s.map (fun t => monomial t.1 (interpret f x t.2))).sum at ih
    rw [ih]
    by_cases ht : t.1=a <;> simp [ht,coeff_monomial,eq_comm,interpret]
def denseExpressions {N : Nat} (d : Nat) (s : Sparse N σ R) :
    Vector (PolyExpr σ R) (boundedExponents N d).length :=
  Vector.ofFn fun i => sparseCoefficient ((boundedExponents N d)[i.val]) s
def interpretVector {n : Nat} (f : R→+*K) (x : σ→K) (v : Vector (PolyExpr σ R) n) : Vector K n :=
  Vector.ofFn fun i => interpret f x v[i.val]
theorem denseExpressions_valid {N : Nat} (f : R→+*K) (x : σ→K) (d : Nat)
    (s : Sparse N σ R) (hs : SparseBound s d) :
    ValidDenseInput d (interpretVector f x (denseExpressions d s)) (sparsePolynomial f x s) := by
  refine ⟨sparsePolynomial_degree f x s d hs,?_⟩
  intro i
  simpa only [interpretVector,denseExpressions,Vector.getElem_ofFn] using
    sparseCoefficient_correct f x ((boundedExponents N d)[i.val]) s
def expressionCoefficient {N : Nat} (d : Nat)
    (v : Vector (PolyExpr σ R) (boundedExponents N d).length) (a : FinExponent N) : PolyExpr σ R :=
  let i := (boundedExponents N d).idxOf a
  if h : i<(boundedExponents N d).length then v[i] else .const 0
variable [DecidableEq K]
theorem expressionCoefficient_correct {N : Nat} (f : R→+*K) (x : σ→K) (d : Nat)
    (v : Vector (PolyExpr σ R) (boundedExponents N d).length) (a : FinExponent N) :
    interpret f x (expressionCoefficient d v a)=inputCoefficient d (interpretVector f x v) a := by
  simp only [expressionCoefficient,inputCoefficient]
  split_ifs <;> simp [interpretVector,interpret]
def symbolicShiftedRow {N : Nat} (d B : Nat)
    (v : Vector (PolyExpr σ R) (boundedExponents N d).length) (a : FinExponent N) :
    Fin (boundedExponents N B).length→PolyExpr σ R :=
  fun i => let b := (boundedExponents N B)[i.val]
    if a≤b then expressionCoefficient d v (subtractExponent b a) else .const 0
theorem symbolicShiftedRow_correct {N : Nat} (f : R→+*K) (x : σ→K) (d B : Nat)
    (v : Vector (PolyExpr σ R) (boundedExponents N d).length) (a : FinExponent N) :
    interpretRow f x (symbolicShiftedRow d B v a)=
      read (shiftedRow d B (interpretVector f x v) a) := by
  ext i
  simp only [interpretRow,symbolicShiftedRow,shiftedRow,read_ofFn]
  split_ifs
  · exact expressionCoefficient_correct f x d v _
  · exact map_zero f
def symbolicRows {N : Nat} (d E : Nat)
    (vs : List (Vector (PolyExpr σ R) (boundedExponents N d).length)) :
    List (Fin (boundedExponents N (d+E)).length→PolyExpr σ R) :=
  vs.flatMap fun v => (multiplierExponents N E).map (symbolicShiftedRow d (d+E) v)
theorem symbolicRows_correct {N : Nat} (f : R→+*K) (x : σ→K) (d E : Nat)
    (vs : List (Vector (PolyExpr σ R) (boundedExponents N d).length)) :
    (symbolicRows d E vs).map (interpretRow f x)=
      (macaulayRows d E (vs.map (interpretVector f x))).map read := by
  induction vs with
  | nil => simp [symbolicRows,macaulayRows]
  | cons v vs ih =>
    simp only [symbolicRows,macaulayRows,List.flatMap_cons,List.map_cons,List.map_append,
      List.map_map] at *
    rw [ih]
    congr 1
    apply List.map_congr_left
    intro a ha
    exact symbolicShiftedRow_correct f x d (d+E) v a
def symbolicTargetRow {N : Nat} (t B : Nat)
    (v : Vector (PolyExpr σ R) (boundedExponents N t).length) :
    Fin (boundedExponents N B).length→PolyExpr σ R :=
  fun i => expressionCoefficient t v ((boundedExponents N B)[i.val])
theorem symbolicTargetRow_correct {N : Nat} (f : R→+*K) (x : σ→K) (t B : Nat)
    (v : Vector (PolyExpr σ R) (boundedExponents N t).length) :
    interpretRow f x (symbolicTargetRow t B v)=read (targetRow t B (interpretVector f x v)) := by
  ext i
  simpa only [interpretRow,symbolicTargetRow,targetRow,read_ofFn] using
    expressionCoefficient_correct f x t v ((boundedExponents N B)[i.val])
def symbolicMembership {N : Nat} (d t : Nat)
    (vs : List (Vector (PolyExpr σ R) (boundedExponents N d).length))
    (p : Vector (PolyExpr σ R) (boundedExponents N t).length) : TestTree σ R :=
  let E:=certificateDegree N d t
  let rs:=symbolicRows d E vs
  spanTree rs.length rs (symbolicTargetRow t (d+E) p)
theorem symbolicMembership_correct {N : Nat} (f : R→+*K) (x : σ→K) (d t : Nat)
    (vs : List (Vector (PolyExpr σ R) (boundedExponents N d).length))
    (p : Vector (PolyExpr σ R) (boundedExponents N t).length) :
    (symbolicMembership d t vs p).Holds f x ↔
      (membershipCertificate d t (vs.map (interpretVector f x)) (interpretVector f x p)).member=true := by
  unfold symbolicMembership
  rw [spanTree_correct f x _ _ _ (le_refl _),symbolicRows_correct,symbolicTargetRow_correct]
  exact (arrayCertificate_member _ _).symm
def symbolicUnit (N : Nat) : Vector (PolyExpr σ R) (boundedExponents N 0).length :=
  Vector.ofFn fun i => .const (if (boundedExponents N 0)[i.val]=0 then 1 else 0)
theorem symbolicUnit_correct (N : Nat) (f : R→+*K) (x : σ→K) :
    interpretVector f x (symbolicUnit N)=unitTarget N := by
  apply Vector.ext
  intro i hi
  simp only [interpretVector,symbolicUnit,unitTarget,constantRow,Vector.getElem_ofFn,interpret]
  split_ifs <;> simp
def parametricFeasible {N : Nat} (d : Nat) (ss : List (Sparse N σ R)) : TestTree σ R :=
  negate (symbolicMembership d 0 (ss.map (denseExpressions d)) (symbolicUnit N))
theorem parametricFeasible_correct {N : Nat} [IsAlgClosed K]
    (f : R→+*K) (x : σ→K) (d : Nat) (ss : List (Sparse N σ R))
    (hs : ∀ s∈ss, SparseBound s d) :
    (parametricFeasible d ss).Holds f x ↔
      ∃ y : Fin N→K, ∀ s∈ss, eval y (sparsePolynomial f x s)=0 := by
  let vs:=(ss.map (denseExpressions d)).map (interpretVector f x)
  let fs:=ss.map (sparsePolynomial f x)
  have hv : List.Forall₂ (ValidDenseInput d) vs fs := by
    dsimp [vs,fs]
    induction ss with
    | nil => exact .nil
    | cons s ss ih =>
      exact .cons (denseExpressions_valid f x d s (hs s List.mem_cons_self))
        (ih (fun t ht => hs t (List.mem_cons_of_mem s ht)))
  rw [parametricFeasible,negate_correct,symbolicMembership_correct,symbolicUnit_correct]
  change ¬(nullstellensatzCertificate d vs).member=true ↔ _
  rw [nullstellensatzCertificate_correct d vs fs hv (L:=K),not_not]
  simp only [fs,List.mem_map,forall_exists_index,and_imp,forall_apply_eq_imp_iff₂,aeval_eq_eval]
end Mathproof.Problem18QuantifierElimination20261001
