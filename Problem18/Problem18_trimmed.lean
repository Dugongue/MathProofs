      (Algebra.adjoin K ({H,T} : Set (Module.End K V)) : Set (Module.End K V)) := by
  obtain ⟨hfH,hfT⟩ := (centralizer_adjoin_pair H T f).mp hf
  exact (centralizer_adjoin_pair H T _).mpr
    ⟨adjoint_commutes B hB H f hH hfH, adjoint_commutes B hB T f hT hfT⟩
