  let eta:=rho.setVar Problem18IMPBoundaryPhaseState20261002.workspaceName (F.e+1)
  let tau:=eta.setVar Problem18IMPBoundaryPhaseMetadata20261002.dimName n
  have heB : F.e+1<B := by
