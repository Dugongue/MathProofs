section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
namespace Mathproof.Problem18PairBoundaryModeCharTwoMath20261004
open Matrix
open Mathproof.Problem18BoundaryBooleanChecks20260930
open Mathproof.Problem18DimensionOneBoundary20260930
open Mathproof.Problem18KrylovCandidate20260930
open Mathproof.Problem18CharTwoBooleanQuery20261001
variable {K : Type} [Field K] [Fintype K] [BEq K] [LawfulBEq K] [DecidableEq K]
variable {b c : ℕ}
def krRows (S : Matrix (Fin b) (Fin b) K) : Matrix (Fin (b+1)) (Fin b) K :=
  Matrix.of fun k => (S^(k:ℕ)) *ᵥ (fun _ => (1:K))
def gramOf (X : Matrix (Fin c) (Fin b) K) : Matrix (Fin (b+1)) (Fin (b+1)) K :=
  krRows (X.transpose*X) * (krRows (X.transpose*X)).transpose
def tvec (X : Matrix (Fin c) (Fin b) K) : Fin (b+1) → K :=
  krRows (X.transpose*X) *ᵥ (X.transpose *ᵥ (fun _ => (1:K)))
def Mem (X : Matrix (Fin c) (Fin b) K) : Prop := ∃ z, X *ᵥ z = fun _ => (1:K)
noncomputable def kr (S : Matrix (Fin b) (Fin b) K) : Matrix (Fin b) (Fin b) K :=
  krylovMatrix S.toLin' (fun _ => 1)
theorem toLin'_pow_apply (S : Matrix (Fin b) (Fin b) K) (j : ℕ) (v : Fin b → K) :
    ((S.toLin')^j) v = (S^j) *ᵥ v := by
  induction j generalizing v with
  | zero => simp
  | succ j ih =>
    rw [pow_succ,Module.End.mul_apply,ih,Matrix.toLin'_apply,Matrix.mulVec_mulVec,pow_succ]
theorem kr_apply (S : Matrix (Fin b) (Fin b) K) (i j : Fin b) :
    kr S i j = ((S^(j:ℕ)) *ᵥ (fun _ => (1:K))) i := by
  rw [kr,krylovMatrix_apply,toLin'_pow_apply]
theorem kr_entry (S : Matrix (Fin b) (Fin b) K) (i j : Fin b) :
    kr S i j = krRows S (Fin.castSucc j) i := by
  rw [kr_apply];rfl
theorem kr_transpose_mulVec (S : Matrix (Fin b) (Fin b) K) (w : Fin b → K) (j : Fin b) :
    ((kr S).transpose *ᵥ w) j = krRows S (Fin.castSucc j) ⬝ᵥ w := by
  simp only [mulVec,dotProduct,transpose_apply,kr_entry]
theorem gram_apply (S : Matrix (Fin b) (Fin b) K) (k l : Fin (b+1)) :
    (krRows S * (krRows S).transpose) k l = krRows S k ⬝ᵥ krRows S l := by
  simp only [mul_apply,transpose_apply,dotProduct]
theorem krRows_succ (S : Matrix (Fin b) (Fin b) K) (j : Fin b) :
    krRows S (Fin.succ j) = S *ᵥ krRows S (Fin.castSucc j) := by
  change (S^((Fin.succ j : Fin (b+1)):ℕ)) *ᵥ (fun _ => (1:K)) =
    S *ᵥ ((S^((Fin.castSucc j : Fin (b+1)):ℕ)) *ᵥ (fun _ => (1:K)))
  rw [Fin.val_succ,Fin.coe_castSucc,pow_succ',← mulVec_mulVec]
theorem ktk (S : Matrix (Fin b) (Fin b) K) (i j : Fin b) :
    ((kr S).transpose * kr S) i j = (krRows S * (krRows S).transpose) (Fin.castSucc i) (Fin.castSucc j) := by
  rw [gram_apply]
  simp only [mul_apply,transpose_apply,kr_entry,dotProduct]
theorem ktsk (S : Matrix (Fin b) (Fin b) K) (i j : Fin b) :
    ((kr S).transpose * S * kr S) i j = (krRows S * (krRows S).transpose) (Fin.castSucc i) (Fin.succ j) := by
  rw [gram_apply,krRows_succ,Matrix.mul_assoc]
  simp only [mul_apply,transpose_apply,kr_entry,dotProduct,mulVec]
theorem kr_det_ne_zero [CharP K 2] (X : Matrix (Fin c) (Fin b) K) (h : OrthogonalGood X) :
    (kr (X.transpose*X)).det ≠ 0 := by
  have hc := Problem18CharTwoBoundaryDecision20260930.symmetric_ones_cyclic (X.transpose*X)
    (by simp [Matrix.IsSymm,Matrix.transpose_mul]) h.2
  exact (isUnit_iff_ne_zero.mp (krylovMatrix_isUnit_det _ _ hc))
theorem candidate_eq (A B : Matrix (Fin c) (Fin b) K) :
    explicitCandidate A B = kr (A.transpose*A) * (kr (B.transpose*B))⁻¹ := by
  rw [explicitCandidate_correct];rfl
theorem leftInverse_eq (C : Matrix (Fin c) (Fin b) K) :
    leftInverseMatrix C = (C.transpose*C)⁻¹ * C.transpose := by
  rw [leftInverseMatrix,Problem18ArrayKrylov20261001.matrix_inverse _ _
    (Problem18ArrayBirdCharpoly20260930.arrayOf_size _),
    Problem18ArrayPolynomialEval20260930.matrix_arrayOf]
theorem residual_iff (C : Matrix (Fin c) (Fin b) K) (hC : (C.transpose*C).det ≠ 0)
    (e : Fin c → K) :
    (e - C *ᵥ (((C.transpose*C)⁻¹ * C.transpose) *ᵥ e) = 0) ↔ ∃ z, C *ᵥ z = e := by
  constructor
  · intro h
    exact ⟨_,(sub_eq_zero.mp h).symm⟩
  · rintro ⟨z,rfl⟩
    have hu : IsUnit (C.transpose*C).det := isUnit_iff_ne_zero.mpr hC
    have hx : ((C.transpose*C)⁻¹ * C.transpose) *ᵥ (C *ᵥ z) = z := by
      rw [mulVec_mulVec,Matrix.mul_assoc,Matrix.nonsing_inv_mul _ hu,one_mulVec]
    rw [hx,sub_self]
theorem dot_mulVec (Q : Matrix (Fin b) (Fin b) K) (x y : Fin b → K) :
    (Q *ᵥ x) ⬝ᵥ y = x ⬝ᵥ (Q.transpose *ᵥ y) := by
  rw [dotProduct_comm,dotProduct_mulVec,mulVec_transpose,dotProduct_comm]
theorem mulVec_cancel {M : Matrix (Fin b) (Fin b) K} (hM : M.det ≠ 0) {x y : Fin b → K}
    (h : M *ᵥ x = M *ᵥ y) : x = y := by
  have hu : IsUnit M.det := isUnit_iff_ne_zero.mpr hM
  have := congrArg (fun v => M⁻¹ *ᵥ v) h
  simpa only [mulVec_mulVec,Matrix.nonsing_inv_mul _ hu,one_mulVec] using this
theorem queryCheck_iff [CharP K 2] (A B : Matrix (Fin c) (Fin b) K)
    (hA : orthogonalSourceCheck A = true) :
    queryCheck A B = true ↔
      (orthogonalSourceCheck B = true ∧ gramOf A = gramOf B ∧ (Mem A ↔ Mem B) ∧
        (Mem A → tvec A = tvec B)) := by
  have hAg := (orthogonalSourceCheck_correct A).mp hA
  let SA := A.transpose*A
  let SB := B.transpose*B
  let e : Fin c → K := fun _ => 1
  have hKA := kr_det_ne_zero A hAg
  have huA : IsUnit (kr SA).det := isUnit_iff_ne_zero.mpr hKA
  by_cases hB : orthogonalSourceCheck B = true
  swap
  · constructor
    · intro h
      simp only [queryCheck,Bool.and_eq_true] at h
      exact absurd h.1.1.1 hB
    · rintro ⟨h,-⟩;exact absurd h hB
  have hBg := (orthogonalSourceCheck_correct B).mp hB
  have hKB := kr_det_ne_zero B hBg
  have huB : IsUnit (kr SB).det := isUnit_iff_ne_zero.mpr hKB
  have huSB : IsUnit SB.det := isUnit_iff_ne_zero.mpr hBg.1
  let Q := explicitCandidate A B
  have hQ : Q = kr SA * (kr SB)⁻¹ := candidate_eq A B
  have hQKB : Q * kr SB = kr SA := by
    rw [hQ,Matrix.mul_assoc,Matrix.nonsing_inv_mul _ huB,Matrix.mul_one]
  have hCgram : (A*Q).transpose*(A*Q) = Q.transpose*SA*Q := by
    simp only [SA,Matrix.transpose_mul,Matrix.mul_assoc]
  have hmark : ∀ (hG : Q.transpose*SA*Q = SB),
      (markerCheck (A*Q) B e = true ↔
        ((Mem A ↔ Mem B) ∧ (Mem A → Q.transpose *ᵥ (A.transpose *ᵥ e) = B.transpose *ᵥ e))) := by
    intro hG
    have hC : ((A*Q).transpose*(A*Q)).det ≠ 0 := by rw [hCgram,hG];exact hBg.1
    have hQu : IsUnit Q.det := by
      have hdet : (Q.transpose*SA*Q).det = SB.det := by rw [hG]
      rw [det_mul,det_mul,det_transpose] at hdet
      apply isUnit_iff_ne_zero.mpr
      intro h0;rw [h0] at hdet
      exact hBg.1 (by rw [← hdet];ring)
    have hmemAQ : (∃ z, (A*Q) *ᵥ z = e) ↔ Mem A := by
      constructor
      · rintro ⟨z,hz⟩;exact ⟨Q *ᵥ z,by rw [mulVec_mulVec];exact hz⟩
      · rintro ⟨z,hz⟩
        refine ⟨Q⁻¹ *ᵥ z,?_⟩
        rw [mulVec_mulVec,Matrix.mul_assoc,Matrix.mul_nonsing_inv _ hQu,Matrix.mul_one];exact hz
    rw [markerCheck,decide_eq_true_eq,leftInverse_eq,leftInverse_eq,
      residual_iff _ hC,residual_iff _ hBg.1,hmemAQ]
    change ((Mem A ↔ Mem B) ∧ (Mem A → _ = _)) ↔ _
    rw [hCgram,hG]
    refine and_congr Iff.rfl (imp_congr Iff.rfl ?_)
    change ((B.transpose*B)⁻¹ * (A*Q).transpose) *ᵥ e = ((B.transpose*B)⁻¹ * B.transpose) *ᵥ e ↔ _
    rw [← mulVec_mulVec,← mulVec_mulVec,Matrix.transpose_mul,← mulVec_mulVec]
    have huSB' : IsUnit (B.transpose*B).det := huSB
    constructor
    · intro h
      have := congrArg (fun v => (B.transpose*B) *ᵥ v) h
      simpa only [mulVec_mulVec,← Matrix.mul_assoc,Matrix.mul_nonsing_inv _ huSB',Matrix.one_mul] using this
    · intro h;rw [h]
  constructor
  · intro h
    simp only [queryCheck,Bool.and_eq_true,decide_eq_true_eq] at h
    obtain ⟨⟨⟨-,hQQ⟩,hM⟩,hG⟩ := h
    change Q.transpose*Q = 1 at hQQ
    change markerCheck (A*Q) B e = true at hM
    change Q.transpose*SA*Q = SB at hG
    have hQQ' : Q*Q.transpose = 1 := mul_eq_one_comm.mp hQQ
    have hcomm : SA*Q = Q*SB := by
      rw [← hG,← Matrix.mul_assoc,← Matrix.mul_assoc,hQQ',Matrix.one_mul]
    have hpow : ∀ k : ℕ, SA^k*Q = Q*SB^k := by
      intro k
      induction k with
      | zero => simp
      | succ k ih => rw [pow_succ,Matrix.mul_assoc,hcomm,← Matrix.mul_assoc,ih,
          Matrix.mul_assoc,← pow_succ]
    have hone : Q *ᵥ (fun _ => (1:K)) = fun _ => 1 := by
      funext i
      have := congrFun (congrFun hQKB i) ⟨0,i.pos⟩
      simp only [mul_apply,kr_apply] at this
      simp only [pow_zero,one_mulVec,mul_one] at this
      simpa [mulVec,dotProduct] using this
    have hu : ∀ k : Fin (b+1), krRows SA k = Q *ᵥ krRows SB k := by
      intro k
      change SA^(k:ℕ) *ᵥ (fun _ => (1:K)) = Q *ᵥ (SB^(k:ℕ) *ᵥ fun _ => (1:K))
      calc SA^(k:ℕ) *ᵥ (fun _ => (1:K)) = SA^(k:ℕ) *ᵥ (Q *ᵥ fun _ => (1:K)) := by rw [hone]
        _ = Q *ᵥ (SB^(k:ℕ) *ᵥ fun _ => (1:K)) := by rw [mulVec_mulVec,hpow,← mulVec_mulVec]
    have hmk := (hmark hG).mp hM
    refine ⟨hB,?_,hmk.1,?_⟩
    · ext k l
      change (krRows SA * (krRows SA).transpose) k l = (krRows SB * (krRows SB).transpose) k l
      rw [gram_apply,gram_apply,hu,hu,dot_mulVec,mulVec_mulVec,hQQ,one_mulVec]
    · intro hmA
      have hx := hmk.2 hmA
      funext k
      change (krRows SA *ᵥ (A.transpose *ᵥ e)) k = (krRows SB *ᵥ (B.transpose *ᵥ e)) k
      simp only [mulVec]
      change krRows SA k ⬝ᵥ _ = krRows SB k ⬝ᵥ _
      rw [hu,dot_mulVec,hx]
  · rintro ⟨-,hGr,hMem,ht⟩
    have hgA : ∀ k l, (krRows SA * (krRows SA).transpose) k l =
        (krRows SB * (krRows SB).transpose) k l := fun k l => congrFun (congrFun hGr k) l
    have hH : (kr SA).transpose * kr SA = (kr SB).transpose * kr SB := by
      ext i j;rw [ktk,ktk];exact hgA _ _
    have hH' : (kr SA).transpose * SA * kr SA = (kr SB).transpose * SB * kr SB := by
      ext i j;rw [ktsk,ktsk];exact hgA _ _
    have hinvT : ((kr SB)⁻¹).transpose * (kr SB).transpose = 1 := by
      rw [← Matrix.transpose_mul,Matrix.mul_nonsing_inv _ huB,Matrix.transpose_one]
    have hQQ : Q.transpose*Q = 1 := by
      rw [hQ,Matrix.transpose_mul,Matrix.mul_assoc,← Matrix.mul_assoc (kr SA).transpose,hH,
        ← Matrix.mul_assoc,← Matrix.mul_assoc,hinvT,Matrix.one_mul,
        Matrix.mul_nonsing_inv _ huB]
    have hG : Q.transpose*SA*Q = SB := by
      rw [hQ,Matrix.transpose_mul]
      calc ((kr SB)⁻¹).transpose * (kr SA).transpose * SA * (kr SA * (kr SB)⁻¹)
          = ((kr SB)⁻¹).transpose * ((kr SA).transpose * SA * kr SA) * (kr SB)⁻¹ := by
            simp only [Matrix.mul_assoc]
        _ = ((kr SB)⁻¹).transpose * ((kr SB).transpose * SB * kr SB) * (kr SB)⁻¹ := by rw [hH']
        _ = (((kr SB)⁻¹).transpose * (kr SB).transpose) * SB * (kr SB * (kr SB)⁻¹) := by
            simp only [Matrix.mul_assoc]
        _ = SB := by rw [hinvT,Matrix.mul_nonsing_inv _ huB,Matrix.one_mul,Matrix.mul_one]
    have hQtKA : Q.transpose * kr SA = kr SB := by
      rw [hQ,Matrix.transpose_mul,Matrix.mul_assoc,hH,← Matrix.mul_assoc,hinvT,Matrix.one_mul]
    simp only [queryCheck,Bool.and_eq_true,decide_eq_true_eq]
    refine ⟨⟨⟨hB,hQQ⟩,(hmark hG).mpr ⟨hMem,fun hmA => ?_⟩⟩,hG⟩
    have htt := ht hmA
    have hk : (kr SA).transpose *ᵥ (A.transpose *ᵥ e) =
        (kr SB).transpose *ᵥ (B.transpose *ᵥ e) := by
      funext j
      rw [kr_transpose_mulVec,kr_transpose_mulVec]
      have := congrFun htt (Fin.castSucc j)
      simpa only [tvec,mulVec] using this
    have hKBt : (kr SB).transpose = (kr SA).transpose * Q := by
      rw [← hQtKA,Matrix.transpose_mul,Matrix.transpose_transpose]
    rw [hKBt,← mulVec_mulVec] at hk
    have hKAt : ((kr SA).transpose).det ≠ 0 := by rw [det_transpose];exact hKA
    have ha := mulVec_cancel hKAt hk
    rw [ha,mulVec_mulVec,hQQ,one_mulVec]
end Mathproof.Problem18PairBoundaryModeCharTwoMath20261004
