theorem exists_nonalternating_class (n : ℕ) (hn : 0<n) :
    ∃ c : FormClass K n,¬(representative K c).val.IsAlt := by
  let B : RegularForm K n := ⟨Mathproof.Problem18FinalFactor20260930.standardForm n,
    Mathproof.Problem18FinalFactor20260930.standardForm_symm n,
    Mathproof.Problem18FinalFactor20260930.standardForm_nondegenerate n⟩
  have haB : ¬B.val.IsAlt := by
    intro ha
    have hz := ha.self_eq_zero (Pi.single (⟨0,hn⟩ : Fin n) (1:K))
    simpa [B,Mathproof.Problem18FinalFactor20260930.standardForm,Matrix.toBilin'_apply'] using hz
  refine ⟨Quotient.mk _ B,?_⟩
  intro ha
  exact haB ((isometric_isAlt_iff K (representative_covers K B)).mpr ha)
theorem main_pair_card_eq_one {n s : ℕ} (hn : 0<n) (hs : 0<s) :
    Nat.card {cd : FormClass K n × FormClass K s //
      ¬(representative K cd.1).val.IsAlt ∧ ¬(representative K cd.2).val.IsAlt}=1 := by
  apply Nat.card_eq_one_iff_unique.mpr
  constructor
  · constructor
    intro cd ce
    apply Subtype.ext
    exact Prod.ext
      (charTwo_nonalternating_class_unique cd.val.1 ce.val.1 cd.property.1 ce.property.1)
      (charTwo_nonalternating_class_unique cd.val.2 ce.val.2 cd.property.2 ce.property.2)
  · obtain ⟨c,hc⟩ := exists_nonalternating_class (K:=K) n hn
    obtain ⟨d,hd⟩ := exists_nonalternating_class (K:=K) s hs
    exact ⟨⟨(c,d),hc,hd⟩⟩
theorem classified_source_not_alternating (H : LinearMap.BilinForm K V)
    (p : K[X]) (hm : p.Monic) (hs : Squarefree p) (hd : 0<p.natDegree)
    (cd : FormClass K p.natDegree × FormClass K (Module.finrank K V-p.natDegree))
    (S : SelfAdjointOperators (RingEquiv.refl K) H) (hS : ClassifiedEvent H p cd S) :
    ¬(representative K cd.1).val.IsAlt := by
  obtain ⟨e,he⟩ := Mathproof.Problem18OrdinaryClassTransport20261001.classified_event_has_model H p hm cd S hS
  let E := Mathproof.Problem18OrdinaryClassTransport20261001.classifiedOperatorsEquiv H p cd e he
  let T := E.symm ⟨S,hS⟩
  letI : Nonempty (Fin p.natDegree) := ⟨⟨0,hd⟩⟩
  exact Mathproof.Problem18OrdinaryClassJointCount20261001.charTwo_event_source_not_alternating
    (representative K cd.1).val (representative K cd.2).val (representative K cd.1).property.1
    (representative K cd.1).property.2 p hm hs T.val T.property
theorem all_pair_card_le_four (n s : ℕ) : Nat.card (FormClass K n × FormClass K s)≤4 := by
  rw [Nat.card_prod]
  have h := Nat.mul_le_mul (class_card_le_two K n) (class_card_le_two K s)
  norm_num at h ⊢
  exact h
end
end Mathproof.Problem18CharTwoMainClasses20261001
