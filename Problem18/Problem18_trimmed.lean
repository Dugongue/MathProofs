    have hwork:ξ.vars coordinateNames.workBase=σ.vars coordinateNames.workBase:=hframe.1 _ (by unfold Protected;decide)
    have hmod:ξ.vars canonical.modBase=σ.vars canonical.modBase:=hframe.1 _ (by unfold Protected;decide)
