theorem window_parameters (b : ℕ) (hb : 1 ≤ b)
    (hlarge : (2:ℝ)^80*(1+Real.log (b:ℝ))^2 ≤ b) :
    let t := Nat.ceil (Real.log (b:ℝ))+1
    let D := 4096*t
    let k := 8*t
    let L := b/(1024*t)
    2 ≤ D ∧ D ≤ L ∧ Even k ∧ 8*Real.log (b:ℝ) ≤ (k:ℝ) ∧
    k*L ≤ b/128 ∧
    Real.log (b:ℝ)-2*Real.log (1+Real.log (b:ℝ))-64 ≤
      Real.log (L+1:ℝ)-Real.log (D:ℝ)-13 ∧
    9+Real.log (L:ℝ) ≤ (5/4:ℝ)*Real.log (b:ℝ) := by
  let t := Nat.ceil (Real.log (b:ℝ))+1
