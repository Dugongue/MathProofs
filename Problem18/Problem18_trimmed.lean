      (∀i<N,val F canonical q.WS τ (gs+i)=
        (Problem18DeterministicCyclicSweep20261001.newFactor P Q).coeff (N-1-i)) ∧
      (∀s<Sn,5+N+N+N+N ≤ s → rowStart (2*N+N) N ≤ s →
        (s<gs ∨ gs+N ≤ s) → (s<ds ∨ ds+N ≤ s) →
        val F canonical q.WS τ s=val F canonical q.WS σ s) ∧
      (∀x,x∉regNames canonical → x∉q.list → x≠ci → x≠counter → x∉tw.list →
        τ.vars x=σ.vars x) ∧ τ.vars q.n=N ∧ τ.inp=σ.inp ∧ τ.out=σ.out := by
