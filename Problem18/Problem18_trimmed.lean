open scoped Polynomial RatFunc PowerSeries
variable (k K : Type*) [Field k] [Field K] [Finite k]
  [Algebra k K] [Algebra k[X] K] [Algebra k⟮X⟯ K] [IsScalarTower k k[X] K]
  [IsScalarTower k[X] k⟮X⟯ K] [_root_.FunctionField k K]
  [Algebra.IsSeparable k⟮X⟯ K] [FunctionField.IsFullConstantField k K]
def complexDivisorZeta : ℂ⟦X⟧ := PowerSeries.map (Int.castRingHom ℂ) (divisorZeta k K)
theorem map_geometricWeight (d : Nat) (hd : d≠0) :
    PowerSeries.map (Int.castRingHom ℂ) (geometricWeight d)=localEuler d (1:ℂ) := by
  ext n
  simp [geometricWeight,coeff_localEuler _ hd]
theorem complex_finite_euler_coeff (N n : Nat) (hn : n≤N) :
    coeff n (finiteEulerProduct (fun P : BoundedPlaces k K N => placeDegree k K P.val)
      (fun _ => (1:ℂ)))=coeff n (complexDivisorZeta k K) := by
  have he : finiteEulerProduct (fun P : BoundedPlaces k K N => placeDegree k K P.val)
      (fun _ => (1:ℂ))=PowerSeries.map (Int.castRingHom ℂ)
        (∏ P : BoundedPlaces k K N, geometricWeight (placeDegree k K P.val)) := by
    rw [map_prod]
    apply Finset.prod_congr rfl
    intro P _
    exact (map_geometricWeight _ (Nat.ne_of_gt (placeDegree_pos k K P.val))).symm
  rw [he,PowerSeries.coeff_map,finite_place_euler_coefficient k K N n hn]
  simp [complexDivisorZeta,divisorZeta]
theorem complex_divisor_coeff_zero : coeff 0 (complexDivisorZeta k K)=1 := by
  rw [← complex_finite_euler_coeff k K 0 0 le_rfl,coeff_zero_eq_constantCoeff_apply,
    finiteEulerProduct,map_prod]
  apply Finset.prod_eq_one
  intro P _
  rw [← coeff_zero_eq_constantCoeff_apply,coeff_localEuler (1:ℂ)
    (Nat.ne_of_gt (placeDegree_pos k K P.val))]
  simp
def closedPointSum (n : Nat) : Nat :=
  ∑ P : BoundedPlaces k K n, if placeDegree k K P.val∣n then placeDegree k K P.val else 0
theorem closed_point_power_sum (P : ℂ[X])
    (hP : (P:ℂ⟦X⟧)=(1-X)*(1-C (Nat.card k:ℂ)*X)*complexDivisorZeta k K)
    (n : Nat) (hn : n≠0) :
    (closedPointSum k K n:ℂ)=(Nat.card k:ℂ)^n+1-
      (P.reverse.roots.map (fun α => α^n)).sum := by
  have hz0 : constantCoeff (complexDivisorZeta k K)=1 := by
    simpa only [coeff_zero_eq_constantCoeff_apply] using complex_divisor_coeff_zero k K
  have hp0 : P.coeff 0=1 := by
    have h := congrArg (constantCoeff) hP
    simpa only [map_mul,map_sub,map_one,constantCoeff_X,map_zero,constantCoeff_C,sub_zero,mul_zero,one_mul,Polynomial.constantCoeff_coe,hz0] using h
  have hZ := eq_rationalZetaSeries_of_denominator P (Nat.card k:ℂ) _ hP
  let d : BoundedPlaces k K n → Nat := fun Q => placeDegree k K Q.val
  have hd : ∀ Q, d Q≠0 := fun Q => Nat.ne_of_gt (placeDegree_pos k K Q.val)
  have he := coeff_logDerivative_eq_of_coeff_eq_up_to
    (finiteEuler_derivative d hd (fun _ => (1:ℂ))) (rationalZeta_derivative P hp0 _)
    (constantCoeff_finiteEulerLogDerivative d hd (fun _ => (1:ℂ)))
    (constantCoeff_rationalZetaLog P _) (by
      rw [complex_finite_euler_coeff k K n 0 (Nat.zero_le n),complex_divisor_coeff_zero])
    (N:=n) (fun j hj => by
      rw [complex_finite_euler_coeff k K n j hj,hZ]) (n:=n) le_rfl
  rw [coeff_finiteEulerLogDerivative d hd _ hn,coeff_rationalZetaLog P _ hn] at he
  simpa [closedPointSum,d,Nat.cast_sum,Nat.cast_ite] using he
theorem exists_closed_point_numerator (B : DivisorA k K) (hB : deg k K B=1) :
    ∃ P : ℂ[X], P.natDegree≤2*genus k K ∧ P.coeff 0=1 ∧
