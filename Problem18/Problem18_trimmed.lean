variable {K : Type} [Field K]
theorem span_cols_iff {d n : Nat} (X : Matrix (Fin d) (Fin n) K) (L : List (Fin d → K))
    (hL : ∀ v, v ∈ L ↔ ∃ u : Fin n, v = fun i => X i u) :
    (fun _ => (1:K)) ∈ rowSpan (K := K) L ↔ ∃ z, X *ᵥ z = fun _ => (1:K) := by
  have hset : {v | v ∈ L} = Set.range (fun (u : Fin n) (i : Fin d) => X i u) := by
    ext v
    simp only [Set.mem_setOf_eq, Set.mem_range, hL]
    constructor
    · rintro ⟨u, rfl⟩; exact ⟨u, rfl⟩
    · rintro ⟨u, rfl⟩; exact ⟨u, rfl⟩
  unfold rowSpan
  rw [hset, Submodule.mem_span_range_iff_exists_fun]
  have hsum : ∀ c : Fin n → K, (∑ u, c u • fun i => X i u) = X *ᵥ c := by
    intro c
    funext i
    simp [Finset.sum_apply, mulVec, dotProduct, mul_comm]
  simp only [hsum]
theorem restRows_mem {d n : Nat} (g : Nat → K) (X : Matrix (Fin d) (Fin n) K)
    (hg : ∀ t (ht : t < n) (i : Fin d), g (rowStart d t + i.val) = X i ⟨t, ht⟩)
    (v : Fin d → K) :
    v ∈ restRows g d n 0 ↔ ∃ u : Fin n, v = fun i => X i u := by
  unfold restRows
  simp only [List.mem_map, List.mem_range, Nat.sub_zero, Nat.zero_add]
  constructor
  · rintro ⟨t, ht, rfl⟩
    refine ⟨⟨t, ht⟩, ?_⟩
    funext i
    unfold rowVec
    exact hg t ht i
  · rintro ⟨u, rfl⟩
    refine ⟨u.val, u.isLt, ?_⟩
    funext i
    unfold rowVec
    exact hg u.val u.isLt i
end Mathproof.Problem18PairBoundaryModeC2SpanMath20261004
