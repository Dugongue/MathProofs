variable {K : Type} [Field K] (F : FieldPresentation K)
theorem loadA_run {W Sn bankLen L : Nat} (arr : String) (harr : arr ≠ canonical.mem)
    {σ : Env} (hG : Glob F W Sn bankLen σ)
    (hV : ValidMemory F W σ) {s d n : Expr} {sv dv nv : Nat} {v : Nat → K}
    (hcs : Clean s) (hcd : Clean d) (hcn : Clean n)
    (hs : s.evalB W σ = some sv) (hd : d.evalB W σ = some dv)
    (hn : n.evalB W σ = some (F.e * nv))
    (hlenA : (σ.arrs arr).length = L) (hLW : L < W)
    (hbank : Vals F arr σ sv nv v)
    (hsl : sv + F.e * nv ≤ L) (hdlo : F.e ≤ dv)
    (hdl : dv + F.e * nv ≤ F.e + 1 + Sn * F.e) :
    ∃ τ, Run W (copyBlock arr canonical.mem s d n) σ τ
        (20 * (F.e * nv) + 13 + s.size + d.size + n.size) ∧
      Glob F W Sn bankLen τ ∧ ValidMemory F W τ ∧
      MemVals F τ dv nv v ∧
      (∀ j, (j < dv ∨ dv + F.e * nv ≤ j) →
        (τ.arrs canonical.mem).getD j 0 = (σ.arrs canonical.mem).getD j 0) ∧
      (∀ x, x ∉ wcRegs → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ canonical.mem → τ.arrs a = σ.arrs a) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hB2 : 1 < W := by have := hG.mem_word; have := hG.mem_len; have := F.degree_pos; omega
  have hlt := vals_lt F hbank
  have hpW : F.p < W := by
    have : F.p + 1 ≤ (F.p + 1) ^ 2 := Nat.le_self_pow (by norm_num) _
    have := hG.arith; omega
  obtain ⟨τ, hr, hv, ha, hl, hdata, hi, ho⟩ := copyBlock_run (B := W) arr canonical.mem
    harr σ hcs hcd hcn hs hd hn (by rw [hlenA]; exact hsl)
    (by rw [hG.mem_len]; exact hdl) (by rw [hlenA]; exact hLW) hG.mem_word
    (by intro j hj; have h1 := hlt j hj; omega) hB2
  have hregs : ∀ x ∈ [canonical.e, canonical.p, canonical.modBase], x ∉ wcRegs := by decide
  have hG' : Glob F W Sn bankLen τ := Glob.transfer F hG
    (hv _ (hregs _ (by simp))) (hv _ (hregs _ (by simp))) (hv _ (hregs _ (by simp)))
    (by intro i; rw [hdata, if_neg (by have := i.isLt; omega)])
    (by intro a; by_cases ha' : a = canonical.mem
        · subst ha'; exact hl
        · rw [ha a ha'])
  have hframe : ∀ j, (j < dv ∨ dv + F.e * nv ≤ j) →
      (τ.arrs canonical.mem).getD j 0 = (σ.arrs canonical.mem).getD j 0 := by
    intro j hj; rw [hdata, if_neg (by omega)]
  refine ⟨τ, hr, hG', hG'.valid F ?_, ?_, hframe, hv, ha, hi, ho⟩
  · intro j hj
    rw [hdata]
    split_ifs with hin
    · exact hlt (j - dv) (by omega)
    · exact hV.coefficients j (by rw [← hl]; exact hj)
  · intro i hi'
    exact decode_of_copy F hbank hdata i hi'
theorem storeA_run {W Sn bankLen L : Nat} (arr : String) (harr : arr ≠ canonical.mem)
    (hab : arr ≠ bank) {σ : Env} (hG : Glob F W Sn bankLen σ)
    {s d n : Expr} {sv dv nv : Nat} {v : Nat → K}
    (hcs : Clean s) (hcd : Clean d) (hcn : Clean n)
    (hs : s.evalB W σ = some sv) (hd : d.evalB W σ = some dv)
    (hn : n.evalB W σ = some (F.e * nv))
    (hmem : MemVals F σ sv nv v)
    (hcan : ∀ j < F.e * nv, (σ.arrs canonical.mem).getD (sv + j) 0 < F.p)
    (hsl : sv + F.e * nv ≤ F.e + 1 + Sn * F.e)
    (hlenA : (σ.arrs arr).length = L) (hLW : L < W)
    (hdl : dv + F.e * nv ≤ L) :
    ∃ τ, Run W (copyBlock canonical.mem arr s d n) σ τ
        (20 * (F.e * nv) + 13 + s.size + d.size + n.size) ∧
      Glob F W Sn bankLen τ ∧
      Vals F arr τ dv nv v ∧
      (∀ j, (j < dv ∨ dv + F.e * nv ≤ j) →
        (τ.arrs arr).getD j 0 = (σ.arrs arr).getD j 0) ∧
      (τ.arrs arr).length = L ∧
      (∀ x, x ∉ wcRegs → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ arr → τ.arrs a = σ.arrs a) ∧
      τ.inp = σ.inp ∧ τ.out = σ.out := by
  have hB2 : 1 < W := by have := hG.mem_word; have := hG.mem_len; have := F.degree_pos; omega
  have hpW : F.p < W := by
    have : F.p + 1 ≤ (F.p + 1) ^ 2 := Nat.le_self_pow (by norm_num) _
    have := hG.arith; omega
  obtain ⟨τ, hr, hv, ha, hl, hdata, hi, ho⟩ := copyBlock_run (B := W) canonical.mem arr
    (Ne.symm harr) σ hcs hcd hcn hs hd hn (by rw [hG.mem_len]; exact hsl)
    (by rw [hlenA]; exact hdl) hG.mem_word (by rw [hlenA]; exact hLW)
    (by intro j hj; have := hcan j hj; omega) hB2
  have hregs : ∀ x ∈ [canonical.e, canonical.p, canonical.modBase], x ∉ wcRegs := by decide
  have hG' : Glob F W Sn bankLen τ := Glob.transfer F hG
    (hv _ (hregs _ (by simp))) (hv _ (hregs _ (by simp))) (hv _ (hregs _ (by simp)))
    (by intro i; rw [ha _ (Ne.symm harr)])
    (by intro a; by_cases ha' : a = arr
        · subst ha'; exact hl
        · rw [ha a ha'])
  refine ⟨τ, hr, hG', ?_, ?_, hl.trans hlenA, hv, ha, hi, ho⟩
  · exact vals_of_copy F hcan (fun i hi' => hmem i hi') hdata
  · intro j hj; rw [hdata, if_neg (by omega)]
