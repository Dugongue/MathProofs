  else 0
theorem upperMatrix_symm (hτ : Function.Involutive τ) (heps : eps*τ eps=1)
    (u : Upper n → K) (i j : Fin n) :
    upperMatrix τ eps u j i = eps*τ (upperMatrix τ eps u i j) := by
  rcases lt_trichotomy i j with h | h | h
  · simp [upperMatrix,h,not_lt_of_gt h]
  · subst j
    simp [upperMatrix]
  · simp only [upperMatrix,dif_pos h,dif_neg (not_lt_of_gt h),map_mul]
