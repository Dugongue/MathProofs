theorem squarefree_balanced_not_alternating [CharP K 2] [Nontrivial V] [FiniteDimensional K V]
    (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hnB : B.Nondegenerate)
    (S : Module.End K V) (hS : Mathproof.Meta.Problem18SpectralBlocks20260930.IsSelfAdjointFor B S)
    (hs : Squarefree S.charpoly) : ¬B.IsAlt := by
