section ConstraintSampler
variable {i j h d : Type*} [Fintype h] [Fintype d] [DecidableEq h] [DecidableEq d]
noncomputable def matrixCodimensionBasisEquiv (e : (i × j) ≃ (h ⊕ d))
    (P : Matrix (h ⊕ d) (h ⊕ d) K) (hP : P.det ≠ 0) :
    ((h ⊕ d) → K) ≃ₗ[K] Matrix i j K :=
  (matrixMulVecLinearEquiv (K := K) P hP).trans (matrixReshapeLinearEquiv (K := K) e)
noncomputable def matrixCodimensionConstraint (e : (i × j) ≃ (h ⊕ d))
    (P : Matrix (h ⊕ d) (h ⊕ d) K) (hP : P.det ≠ 0) :
    Matrix i j K →ₗ[K] (d → K) :=
  (LinearMap.pi (fun a : d => LinearMap.proj (Sum.inr a))).comp
    (matrixCodimensionBasisEquiv e P hP).symm.toLinearMap
noncomputable def codimensionMatrixEquiv (e : (i × j) ≃ (h ⊕ d))
    (P : Matrix (h ⊕ d) (h ⊕ d) K) (hP : P.det ≠ 0) :
    (h → K) ≃ {N : Matrix i j K // matrixCodimensionConstraint e P hP N = 0} where
  toFun x := ⟨matrixCodimensionBasisEquiv e P hP (Sum.elim x (fun _ => 0)), by
    ext a
    simp [matrixCodimensionConstraint]⟩
  invFun N := fun a => (matrixCodimensionBasisEquiv e P hP).symm N.val (Sum.inl a)
  left_inv x := by
    funext a
    simp
  right_inv N := by
    apply Subtype.ext
    apply (matrixCodimensionBasisEquiv e P hP).symm.injective
    simp only [LinearEquiv.symm_apply_apply]
    funext a
    cases a with
    | inl a => rfl
    | inr a => exact (congrFun N.property a).symm
theorem codimensionMatrixEquiv_gram [Fintype j] [StarRing K]
    (e : (i × j) ≃ (h ⊕ d))
    (P : Matrix (h ⊕ d) (h ⊕ d) K) (hP : P.det ≠ 0) (x : h → K) :
    gramHermitian (codimensionMatrixEquiv e P hP x).val = codimensionGram e P x := rfl
end ConstraintSampler
set_option backward.isDefEq.respectTransparency false in
theorem full_row_rank_iff_independent {d n : ℕ} (M : Matrix (Fin d) (Fin n) K) :
    M.rank = d ↔ LinearIndependent K M := by
  rw [linearIndependent_iff_card_eq_finrank_span]
  simp only [Fintype.card_fin, Set.finrank]
  change M.rank = d ↔ d = Module.finrank K (Submodule.span K (Set.range M.row))
  rw [← Matrix.rank_eq_finrank_span_row]
  exact eq_comm
theorem full_row_rank_card [Fintype K] {d n : ℕ} (hd : d ≤ n) :
    Nat.card {M : Matrix (Fin d) (Fin n) K // M.rank = d} =
      ∏ a : Fin d, (Fintype.card K ^ n - Fintype.card K ^ a.val) := by
  let e : {M : Matrix (Fin d) (Fin n) K // M.rank = d} ≃
      {M : Fin d → Fin n → K // LinearIndependent K M} :=
    Equiv.subtypeEquivRight (fun M => full_row_rank_iff_independent M)
  rw [Nat.card_congr e]
  simpa only [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] using
    (card_linearIndependent (K := K) (V := Fin n → K)
      (by simpa only [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] using hd))
omit [Field K] in
theorem rectangular_matrix_card [Fintype K] (d n : ℕ) :
    Nat.card (Matrix (Fin d) (Fin n) K) = Fintype.card K ^ (d * n) := by
  simp [Matrix, Nat.card_eq_fintype_card, ← pow_mul, Nat.mul_comm]
theorem full_row_rank_probability [Fintype K] {d n : ℕ} (hd : d ≤ n) :
    (Nat.card {M : Matrix (Fin d) (Fin n) K // M.rank = d} : ℝ) /
      Nat.card (Matrix (Fin d) (Fin n) K) =
      ∏ a : Fin d, (1 - (Fintype.card K : ℝ)^a.val / (Fintype.card K : ℝ)^n) := by
  rw [full_row_rank_card hd, rectangular_matrix_card]
  have hq : (Fintype.card K : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  have hn (a : Fin d) : Fintype.card K ^ a.val ≤ Fintype.card K ^ n := by
    exact Nat.pow_le_pow_right Fintype.card_pos (Nat.le_of_lt a.isLt |>.trans hd)
  rw [Nat.cast_prod, Nat.cast_pow]
  have he : (Fintype.card K : ℝ)^(d*n) = ∏ _a : Fin d, (Fintype.card K : ℝ)^n := by
    simp [← pow_mul, Nat.mul_comm]
  rw [he, ← Finset.prod_div_distrib]
  apply Finset.prod_congr rfl
  intro a _
  rw [Nat.cast_sub (hn a), Nat.cast_pow, Nat.cast_pow]
  field_simp
theorem finite_success_product_lower {I : Type*} (s : Finset I) (f : I → ℝ)
    (hf0 : ∀ a ∈ s, 0 ≤ f a) (hf1 : ∀ a ∈ s, f a ≤ 1) :
    1 - ∑ a ∈ s, f a ≤ ∏ a ∈ s, (1 - f a) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
    have h0 : 0 ≤ f a := hf0 a (Finset.mem_insert_self _ _)
    have h1 : f a ≤ 1 := hf1 a (Finset.mem_insert_self _ _)
    have hs0 : ∀ b ∈ s, 0 ≤ f b := fun b hb => hf0 b (Finset.mem_insert_of_mem hb)
    have hs1 : ∀ b ∈ s, f b ≤ 1 := fun b hb => hf1 b (Finset.mem_insert_of_mem hb)
    have hs : 0 ≤ ∑ b ∈ s, f b := Finset.sum_nonneg hs0
    have hh := mul_le_mul_of_nonneg_left (ih hs0 hs1) (sub_nonneg.mpr h1)
    rw [Finset.sum_insert ha, Finset.prod_insert ha]
    nlinarith [mul_nonneg h0 hs]
theorem full_row_rank_probability_lower [Fintype K] {d n : ℕ} (hd : d ≤ n) :
    1 - ∑ a : Fin d, (Fintype.card K : ℝ)^a.val / (Fintype.card K : ℝ)^n ≤
      (Nat.card {M : Matrix (Fin d) (Fin n) K // M.rank = d} : ℝ) /
        Nat.card (Matrix (Fin d) (Fin n) K) := by
  rw [full_row_rank_probability hd]
  apply finite_success_product_lower
  · intro a _; positivity
  · intro a _
    apply (div_le_one (by positivity)).2
    apply pow_le_pow_right₀
    · exact_mod_cast (Fintype.one_lt_card (α := K)).le
    · exact (Nat.le_of_lt a.isLt).trans hd
theorem full_row_rank_probability_geometric [Fintype K] {d n : ℕ} (hd : d ≤ n) :
    1 - ((Fintype.card K : ℝ)^d - 1) /
      (((Fintype.card K : ℝ) - 1) * (Fintype.card K : ℝ)^n) ≤
      (Nat.card {M : Matrix (Fin d) (Fin n) K // M.rank = d} : ℝ) /
        Nat.card (Matrix (Fin d) (Fin n) K) := by
  have hq : (1 : ℝ) < Fintype.card K := by exact_mod_cast Fintype.one_lt_card
  have he : (∑ a : Fin d, (Fintype.card K : ℝ)^a.val / (Fintype.card K : ℝ)^n) =
      ((Fintype.card K : ℝ)^d - 1) /
        (((Fintype.card K : ℝ) - 1) * (Fintype.card K : ℝ)^n) := by
    rw [← Finset.sum_div, Fin.sum_univ_eq_sum_range, geom_sum_eq (ne_of_gt hq), div_div]
  simpa only [he] using (full_row_rank_probability_lower (K := K) hd)
theorem full_rank_card_le_hermitian_mul_unitary [Fintype K] [StarRing K] (n : ℕ) :
    Nat.card {M : Matrix (Fin n) (Fin n) K // M.rank = n} ≤
      Nat.card (selfAdjoint (Matrix (Fin n) (Fin n) K)) *
        Nat.card {P : Matrix (Fin n) (Fin n) K // IsUnitary P} := by
  classical
  let R := {M : Matrix (Fin n) (Fin n) K // M.rank = n}
  let U := {P : Matrix (Fin n) (Fin n) K // IsUnitary P}
  let f : R → selfAdjoint (Matrix (Fin n) (Fin n) K) := fun M => gramHermitian M.valᴴ
  have hf (H : selfAdjoint (Matrix (Fin n) (Fin n) K)) :
      Nat.card {M : R // f M = H} ≤ Nat.card U := by
    by_cases hn : Nonempty {M : R // f M = H}
    · let x := Classical.choice hn
      have hx : x.val.val.rank = Fintype.card (Fin n) := by
        simpa only [Fintype.card_fin] using x.val.property
      have hc (y : {M : R // f M = H}) : ∃ Q : U, Q.val * x.val.val = y.val.val := by
        have he := congrArg Subtype.val (x.property.trans y.property.symm)
        dsimp only [f, gramHermitian] at he
        simp only [Matrix.conjTranspose_conjTranspose] at he
        obtain ⟨Q, hQ, hxy⟩ := (full_rank_gram_eq_iff_unitary_left x.val.val y.val.val hx).mp he
        exact ⟨⟨Q, hQ⟩, hxy⟩
      choose g hg using hc
      apply Nat.card_le_card_of_injective g
      intro y z h
      apply Subtype.ext
      apply Subtype.ext
      exact (hg y).symm.trans ((congrArg (fun Q : U => Q.val * x.val.val) h).trans (hg z))
    · have : IsEmpty {M : R // f M = H} := not_nonempty_iff.mp hn
      simp
  have he := Fintype.card_congr (Equiv.sigmaFiberEquiv f)
  rw [Fintype.card_sigma] at he
  simp only [Nat.card_eq_fintype_card] at hf ⊢
  rw [← he]
  calc
    _ ≤ ∑ _H : selfAdjoint (Matrix (Fin n) (Fin n) K), Fintype.card U :=
      Finset.sum_le_sum (fun H _ => hf H)
    _ = _ := by simp [U]
theorem unitary_card_lower_bound
    {F : Type*} [Field F] [Fintype F] [Fintype K] [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F) (n : ℕ) :
    (2 / 3 : ℝ) * (Fintype.card F : ℝ)^(n^2) ≤
      Nat.card {P : Matrix (Fin n) (Fin n) K // IsUnitary P} := by
  have hq : (2 : ℝ) ≤ Fintype.card F := by exact_mod_cast Fintype.one_lt_card (α := F)
  have hK : (Fintype.card K : ℝ) = (Fintype.card F : ℝ)^2 := by
    exact_mod_cast (show Fintype.card K = Fintype.card F ^ 2 by
      simpa only [Nat.card_eq_fintype_card] using hcard)
  have h4 : (4 : ℝ) ≤ Fintype.card K := by rw [hK]; nlinarith
  have hp : (0 : ℝ) < (Fintype.card K : ℝ)^n := by positivity
  have hd : (0 : ℝ) < ((Fintype.card K : ℝ)-1) * (Fintype.card K : ℝ)^n :=
    mul_pos (by linarith) hp
  have he : ((Fintype.card K : ℝ)^n - 1) /
      (((Fintype.card K : ℝ)-1) * (Fintype.card K : ℝ)^n) ≤ 1/3 := by
    apply (div_le_iff₀ hd).2
    nlinarith [mul_nonneg (show (0 : ℝ) ≤ (Fintype.card K : ℝ)-4 by linarith) hp.le]
  have hP : (2/3 : ℝ) ≤
      (Nat.card {M : Matrix (Fin n) (Fin n) K // M.rank = n} : ℝ) /
        Nat.card (Matrix (Fin n) (Fin n) K) := by
    linarith [full_row_rank_probability_geometric (K := K) (Nat.le_refl n)]
  have hpos : (0 : ℝ) < Nat.card (Matrix (Fin n) (Fin n) K) := by
    rw [rectangular_matrix_card]
    positivity
  have hN := (le_div_iff₀ hpos).mp hP
  have hF : (Nat.card {M : Matrix (Fin n) (Fin n) K // M.rank = n} : ℝ) ≤
      (Nat.card (selfAdjoint (Matrix (Fin n) (Fin n) K)) : ℝ) *
        Nat.card {P : Matrix (Fin n) (Fin n) K // IsUnitary P} := by
    exact_mod_cast full_rank_card_le_hermitian_mul_unitary (K := K) n
  have hH : (Nat.card (selfAdjoint (Matrix (Fin n) (Fin n) K)) : ℝ) =
      (Fintype.card F : ℝ)^(n^2) := by
    have hc : Nat.card (selfAdjoint (Matrix (Fin n) (Fin n) K)) =
        Fintype.card F ^ (n^2) := by
      simpa only [← Nat.card_eq_fintype_card, Nat.card_fin] using
        (card_hermitian (i := Fin n) hcard hstar)
    exact_mod_cast hc
  have hT : (Nat.card (Matrix (Fin n) (Fin n) K) : ℝ) =
      ((Fintype.card F : ℝ)^(n^2))^2 := by
    rw [rectangular_matrix_card, Nat.cast_pow, hK]
    simp only [← pow_mul]
    congr 1
    ring
  rw [hH] at hF
  rw [hT] at hN
  have hpower : (0 : ℝ) < (Fintype.card F : ℝ)^(n^2) := by positivity
  nlinarith
def independentSpan {V : Type*} [AddCommGroup V] [Module K V] (k : ℕ) :
    {v : Fin k → V // LinearIndependent K v} →
      {W : Submodule K V // Module.finrank K W = k} :=
  fun v => ⟨Submodule.span K (Set.range v.val), by
    rw [finrank_span_eq_card v.property, Fintype.card_fin]⟩
noncomputable def independentSpanFiberEquiv {V : Type*} [AddCommGroup V]
    [Module K V] [Module.Finite K V] (k : ℕ)
    (W : {W : Submodule K V // Module.finrank K W = k}) :
    {v : {v : Fin k → V // LinearIndependent K v} // independentSpan k v = W} ≃
      {v : Fin k → W.val // LinearIndependent K v} := by
  let e : {v : Fin k → W.val // LinearIndependent K (Subtype.val ∘ v)} ≃
      {v : Fin k → W.val // LinearIndependent K v} :=
    Equiv.subtypeEquivRight fun v => ⟨fun h => LinearIndependent.of_comp W.val.subtype h,
      fun h => h.map' W.val.subtype (Submodule.ker_subtype W.val)⟩
  refine (Equiv.ofBijective ?_ ⟨?_, ?_⟩).trans e
  · rintro ⟨⟨v, hv⟩, hvW⟩
    have heq : Submodule.span K (Set.range v) = W.val := congrArg Subtype.val hvW
    refine ⟨fun i => ⟨v i, ?_⟩, hv⟩
    rw [← heq]
    exact Submodule.subset_span (Set.mem_range_self i)
  · rintro ⟨⟨v, hv⟩, hvW⟩ ⟨⟨w, hw⟩, hwW⟩ heq
    simp only [Subtype.mk.injEq] at heq ⊢
    funext i
    exact congrArg Subtype.val (congrFun heq i)
  · rintro ⟨w, hw⟩
    let v : Fin k → V := Subtype.val ∘ w
    have hv : LinearIndependent K v := hw
    have hs : Submodule.span K (Set.range v) = W.val := by
      have hl : Submodule.span K (Set.range v) ≤ W.val := by
        apply Submodule.span_le.mpr
        rintro x ⟨i, rfl⟩
        exact (w i).property
      apply Submodule.eq_of_le_of_finrank_eq hl
      rw [finrank_span_eq_card hv, Fintype.card_fin, W.property]
    refine ⟨⟨⟨v, hv⟩, Subtype.ext hs⟩, ?_⟩
    apply Subtype.ext
    funext i
    rfl
theorem independentSpan_fiber_card {V : Type*} [AddCommGroup V]
    [Module K V] [Module.Finite K V] [Fintype K] (k : ℕ)
    (W : {W : Submodule K V // Module.finrank K W = k}) :
    Nat.card {v : {v : Fin k → V // LinearIndependent K v} // independentSpan k v = W} =
      ∏ a : Fin k, (Fintype.card K ^ k - Fintype.card K ^ a.val) := by
  have : Finite V := Module.finite_of_finite (R := K) (M := V)
  rw [Nat.card_congr (independentSpanFiberEquiv k W)]
  simpa only [W.property] using
    (card_linearIndependent (K := K) (V := W.val) (by rw [W.property]))
theorem subspace_card_mul_bases [Fintype K] {n k : ℕ} (hk : k ≤ n) :
    Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = k} *
      (∏ a : Fin k, (Fintype.card K ^ k - Fintype.card K ^ a.val)) =
      ∏ a : Fin k, (Fintype.card K ^ n - Fintype.card K ^ a.val) := by
  classical
  let f := independentSpan (K := K) (V := Fin n → K) k
  have he := Nat.card_congr (Equiv.sigmaFiberEquiv f)
  have hf (W : {W : Submodule K (Fin n → K) // Module.finrank K W = k}) :=
    independentSpan_fiber_card k W
  simp only [Nat.card_eq_fintype_card, Fintype.card_sigma] at he hf
  dsimp only [f] at he
  simp_rw [hf] at he
  have hc := card_linearIndependent (K := K) (V := Fin n → K)
    (show k ≤ Module.finrank K (Fin n → K) by simpa using hk)
  simp only [Module.finrank_fintype_fun_eq_card, Fintype.card_fin,
    Nat.card_eq_fintype_card] at hc
  simpa [f, Finset.sum_const] using he.trans hc
theorem full_rank_square_card_lower [Fintype K] (k : ℕ) (hQ : 4 ≤ Fintype.card K) :
    (2/3 : ℝ) * (Fintype.card K : ℝ)^(k*k) ≤
      Nat.card {M : Matrix (Fin k) (Fin k) K // M.rank = k} := by
  have h4 : (4 : ℝ) ≤ Fintype.card K := by exact_mod_cast hQ
  have hp : (0 : ℝ) < (Fintype.card K : ℝ)^k := by positivity
  have hd : (0 : ℝ) < ((Fintype.card K : ℝ)-1) * (Fintype.card K : ℝ)^k :=
    mul_pos (by linarith) hp
  have he : ((Fintype.card K : ℝ)^k - 1) /
      (((Fintype.card K : ℝ)-1) * (Fintype.card K : ℝ)^k) ≤ 1/3 := by
    apply (div_le_iff₀ hd).2
    nlinarith [mul_nonneg (show (0 : ℝ) ≤ (Fintype.card K : ℝ)-4 by linarith) hp.le]
  have hP : (2/3 : ℝ) ≤
      (Nat.card {M : Matrix (Fin k) (Fin k) K // M.rank = k} : ℝ) /
        Nat.card (Matrix (Fin k) (Fin k) K) := by
    linarith [full_row_rank_probability_geometric (K := K) (Nat.le_refl k)]
  rw [rectangular_matrix_card, Nat.cast_pow] at hP
  exact (le_div_iff₀ (by positivity)).mp hP
theorem finite_field_subspace_count_bound [Fintype K] (n k : ℕ)
    (hk : k ≤ n) (hQ : 4 ≤ Fintype.card K) :
    (Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = k} : ℝ) ≤
      (3/2 : ℝ) * (Fintype.card K : ℝ)^(k*(n-k)) := by
  classical
  let S := {W : Submodule K (Fin n → K) // Module.finrank K W = k}
  let B := {M : Matrix (Fin k) (Fin k) K // M.rank = k}
  let R := {M : Matrix (Fin k) (Fin n) K // M.rank = k}
  have he : Nat.card S * Nat.card B = Nat.card R := by
    dsimp only [S, B, R]
    rw [full_row_rank_card (Nat.le_refl k), full_row_rank_card hk]
    exact subspace_card_mul_bases hk
  have hr : Nat.card R ≤ Fintype.card K^(k*n) := by
    rw [← rectangular_matrix_card]
    exact Nat.card_le_card_of_injective Subtype.val Subtype.val_injective
  have hb := full_rank_square_card_lower (K := K) k hQ
  have her : (Nat.card S : ℝ) * Nat.card B = (Nat.card R : ℝ) := by exact_mod_cast he
  have hrr : (Nat.card R : ℝ) ≤ (Fintype.card K : ℝ)^(k*n) := by exact_mod_cast hr
  have hh : (Nat.card S : ℝ) * ((2/3 : ℝ) * (Fintype.card K : ℝ)^(k*k)) ≤
      (Fintype.card K : ℝ)^(k*n) := by
    calc
      _ ≤ (Nat.card S : ℝ) * Nat.card B := mul_le_mul_of_nonneg_left hb (by positivity)
      _ = _ := her
      _ ≤ _ := hrr
  have hepow : (Fintype.card K : ℝ)^(k*n) =
      (Fintype.card K : ℝ)^(k*(n-k)) * (Fintype.card K : ℝ)^(k*k) := by
    rw [← pow_add]
    congr 1
    rw [← Nat.mul_add, Nat.sub_add_cancel hk]
  calc
    _ ≤ (Fintype.card K : ℝ)^(k*n) /
        ((2/3 : ℝ) * (Fintype.card K : ℝ)^(k*k)) :=
      (le_div_iff₀ (by positivity)).2 hh
    _ = _ := by
      have hq : (Fintype.card K : ℝ) ≠ 0 := by positivity
      rw [hepow]
      field_simp
theorem subspace_matrix_retraction {n r : ℕ}
    (W : Submodule K (Fin n → K)) (hW : Module.finrank K W = r) :
    ∃ (X : Matrix (Fin n) (Fin r) K) (E : Matrix (Fin r) (Fin n) K),
      ∀ v ∈ W, X *ᵥ (E *ᵥ v) = v := by
  classical
  let b := Module.finBasisOfFinrankEq K W hW
  obtain ⟨p, hp⟩ := W.subtype.exists_leftInverse_of_injective W.ker_subtype
  let x := W.subtype.comp b.equivFun.symm.toLinearMap
  let e := b.equivFun.toLinearMap.comp p
  refine ⟨x.toMatrix', e.toMatrix', ?_⟩
  intro v hv
  simp only [LinearMap.toMatrix'_mulVec]
  change ((b.equivFun.symm (b.equivFun (p v)) : W) : Fin n → K) = v
  rw [b.equivFun.symm_apply_apply]
  have hh := LinearMap.congr_fun hp (⟨v, hv⟩ : W)
  exact congrArg Subtype.val hh
theorem hermitian_image_card_le [Fintype K] [StarRing K] {n r : ℕ}
    (W : Submodule K (Fin n → K)) (hW : Module.finrank K W = r) :
    Nat.card {A : selfAdjoint (Matrix (Fin n) (Fin n) K) //
      LinearMap.range A.val.mulVecLin ≤ W} ≤
    Nat.card (selfAdjoint (Matrix (Fin r) (Fin r) K)) := by
  classical
  obtain ⟨X, E, hXE⟩ := subspace_matrix_retraction W hW
  let S := {A : selfAdjoint (Matrix (Fin n) (Fin n) K) //
    LinearMap.range A.val.mulVecLin ≤ W}
  have hleft (A : S) : X * E * A.val.val = A.val.val := by
    apply Matrix.toLin'.injective
    apply LinearMap.ext
    intro v
    change (X * E * A.val.val) *ᵥ v = A.val.val *ᵥ v
    rw [← Matrix.mulVec_mulVec, ← Matrix.mulVec_mulVec]
    exact hXE _ (A.property ⟨v, rfl⟩)
  have hrec (A : S) : X * (E * A.val.val * Eᴴ) * Xᴴ = A.val.val := by
    have ha : A.val.valᴴ = A.val.val := A.val.property
    have hr := congrArg Matrix.conjTranspose (hleft A)
    simp only [Matrix.conjTranspose_mul, ha] at hr
    calc
      _ = (X * E * A.val.val) * Eᴴ * Xᴴ := by simp only [Matrix.mul_assoc]
      _ = A.val.val * Eᴴ * Xᴴ := by rw [hleft A]
      _ = A.val.val := by simpa only [Matrix.mul_assoc] using hr
  let f : S → selfAdjoint (Matrix (Fin r) (Fin r) K) := fun A =>
    ⟨E * A.val.val * Eᴴ, by
      change (E * A.val.val * Eᴴ)ᴴ = E * A.val.val * Eᴴ
      have ha : A.val.valᴴ = A.val.val := A.val.property
      simp only [Matrix.conjTranspose_mul, Matrix.conjTranspose_conjTranspose,
        ha, Matrix.mul_assoc]⟩
  apply Nat.card_le_card_of_injective f
  intro A B h
  apply Subtype.ext
  apply Subtype.ext
  exact (hrec A).symm.trans ((congrArg (fun H : selfAdjoint (Matrix (Fin r) (Fin r) K) =>
    X * H.val * Xᴴ) h).trans (hrec B))
theorem hermitian_rank_card_le_subspaces [Fintype K] [StarRing K] (n r : ℕ) :
    Nat.card {A : selfAdjoint (Matrix (Fin n) (Fin n) K) // A.val.rank = r} ≤
      Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = r} *
        Nat.card (selfAdjoint (Matrix (Fin r) (Fin r) K)) := by
  classical
  let S := {A : selfAdjoint (Matrix (Fin n) (Fin n) K) // A.val.rank = r}
  let G := {W : Submodule K (Fin n → K) // Module.finrank K W = r}
  let f : S → G := fun A => ⟨LinearMap.range A.val.val.mulVecLin, A.property⟩
  have hf (W : G) : Nat.card {A : S // f A = W} ≤
      Nat.card (selfAdjoint (Matrix (Fin r) (Fin r) K)) := by
    let g : {A : S // f A = W} →
        {A : selfAdjoint (Matrix (Fin n) (Fin n) K) //
          LinearMap.range A.val.mulVecLin ≤ W.val} := fun A =>
      ⟨A.val.val, (congrArg Subtype.val A.property).le⟩
    have hg : Function.Injective g := by
      intro A B h
      apply Subtype.ext
      apply Subtype.ext
      have hh := congrArg Subtype.val h
      exact hh
    exact (Nat.card_le_card_of_injective g hg).trans (hermitian_image_card_le W.val W.property)
  let : Fintype G := Fintype.ofFinite G
  have he := Fintype.card_congr (Equiv.sigmaFiberEquiv f)
  rw [Fintype.card_sigma] at he
  simp only [Nat.card_eq_fintype_card] at hf ⊢
  rw [← he]
  calc
    _ ≤ ∑ _W : G, Fintype.card (selfAdjoint (Matrix (Fin r) (Fin r) K)) :=
      Finset.sum_le_sum (fun W _ => hf W)
    _ = _ := by simp [G]
theorem hermitian_rank_count_bound
    {F : Type*} [Field F] [Fintype K] [Fintype F] [Algebra F K] [StarRing K]
    (hcard : Nat.card K = Nat.card F ^ 2)
    (hstar : ∀ x : K, star x = x ^ Nat.card F) (n r : ℕ) (hr : r ≤ n) :
    (Nat.card {A : selfAdjoint (Matrix (Fin n) (Fin n) K) // A.val.rank = r} : ℝ) ≤
      (3 / 2 : ℝ) * (Fintype.card F : ℝ)^(2*n*r-r^2) := by
  have hq : 2 ≤ Fintype.card F := Fintype.one_lt_card
  have hK : Fintype.card K = Fintype.card F ^ 2 := by
    simpa only [Nat.card_eq_fintype_card] using hcard
  have h4 : 4 ≤ Fintype.card K := by rw [hK]; nlinarith
  have hs := finite_field_subspace_count_bound (K := K) n r hr h4
  have hc := card_hermitian (i := Fin r) hcard hstar
  simp only [← Nat.card_eq_fintype_card, Nat.card_fin] at hc
  have hb : (Nat.card {A : selfAdjoint (Matrix (Fin n) (Fin n) K) // A.val.rank = r} : ℝ) ≤
      (Nat.card {W : Submodule K (Fin n → K) // Module.finrank K W = r} : ℝ) *
        (Fintype.card F : ℝ)^(r^2) := by
    have hh := hermitian_rank_card_le_subspaces (K := K) n r
    rw [hc] at hh
    simp only [Nat.card_eq_fintype_card] at hh ⊢
    exact_mod_cast hh
  have he : 2 * (r * (n-r)) + r^2 = 2*n*r-r^2 := by
    have hh : n-r+r=n := Nat.sub_add_cancel hr
    have : 2 * (r * (n-r)) + r^2 + r^2 = 2*n*r := by nlinarith
    omega
  calc
    _ ≤ ((3/2 : ℝ) * (Fintype.card K : ℝ)^(r*(n-r))) *
        (Fintype.card F : ℝ)^(r^2) :=
