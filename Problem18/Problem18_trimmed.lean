theorem asg_run {B n d e b : Nat} (xs : List (String × Sz)) (σ : Env)
    (hn : σ.vars nR = n) (hd : σ.vars dR = d) (he : σ.vars eR = e) (hb : σ.vars sbR = b)
    (hfresh : ∀ p ∈ xs, p.1 ∉ Sz.reads) (hnodup : (xs.map Prod.fst).Nodup)
    (hB : ∀ p ∈ xs, Sz.majorant p.2 n d e b < B) :
    ∃ τ, Run B (asg xs) σ τ (asgCost xs) ∧
      (∀ p ∈ xs, τ.vars p.1 = Sz.value p.2 n d e b) ∧
      (∀ x, x ∉ xs.map Prod.fst → τ.vars x = σ.vars x) ∧
      τ.arrs = σ.arrs ∧ τ.inp = σ.inp ∧ τ.out = σ.out := by
  induction xs generalizing σ with
  | nil => exact ⟨σ, Run.skip, by simp, fun _ _ => rfl, rfl, rfl, rfl⟩
  | cons p xs ih =>
    have hp := Sz.expr_eval p.2 hn hd he hb (hB p (by simp))
    let σ1 := σ.setVar p.1 (Sz.value p.2 n d e b)
    have hp1 : p.1 ∉ Sz.reads := hfresh p (by simp)
    have hne : ∀ y ∈ Sz.reads, y ≠ p.1 := fun y hy h => hp1 (h ▸ hy)
    have hv : ∀ y ∈ Sz.reads, σ1.vars y = σ.vars y := by
      intro y hy; simp [σ1, hne y hy]
    obtain ⟨τ, hr, hvals, hrest, harr, hi, ho⟩ := ih σ1
      (by rw [hv _ (by simp [Sz.reads])]; exact hn)
      (by rw [hv _ (by simp [Sz.reads])]; exact hd)
      (by rw [hv _ (by simp [Sz.reads])]; exact he)
      (by rw [hv _ (by simp [Sz.reads])]; exact hb)
      (fun q hq => hfresh q (by simp [hq]))
      (by simp only [List.map_cons, List.nodup_cons] at hnodup; exact hnodup.2)
      (fun q hq => hB q (by simp [hq]))
    have hnot : p.1 ∉ xs.map Prod.fst := by
      simp only [List.map_cons, List.nodup_cons] at hnodup; exact hnodup.1
    refine ⟨τ, ?_, ?_, ?_, harr, hi, ho⟩
    · have h1 := Run.assign (x:=p.1) hp
      have := h1.seq hr
      simpa [asg, asgCost, Problem18IMPAssignments20261002.program,
        Problem18IMPAssignments20261002.cost, Nat.add_assoc] using this
    · intro q hq
      simp only [List.mem_cons] at hq
      rcases hq with rfl | hq
      · rw [hrest _ hnot]; simp [σ1]
      · exact hvals q hq
    · intro x hx
      simp only [List.map_cons, List.mem_cons, not_or] at hx
      rw [hrest x hx.2]
      simp [σ1, hx.1]
