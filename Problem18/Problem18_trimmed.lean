  have h := Mathproof.Meta.Problem18HermitianSpectral20260930.coprime_primarySpaces_nondegenerate
    (sigma := (starRingAut : K ≃+* K)) (B:=B) (S:=S) hB hnB hS hfix hqfix hc 1 1
    (by simpa only [pow_one,primarySpace,polyEval] using hcomp.sup_eq_top)
  change (B.domRestrict₁₂ (LinearMap.ker (aeval S (p^1)))
      (LinearMap.ker (aeval S (p^1)))).Nondegenerate ∧
    (B.domRestrict₁₂ (LinearMap.ker (aeval S ((S.charpoly/p)^1)))
      (LinearMap.ker (aeval S ((S.charpoly/p)^1)))).Nondegenerate at h
