theorem existsMappedCost_mono {α : Type} (f g : α → Nat) :
    ∀ xs : List α, (∀ x ∈ xs, f x ≤ g x) →
      existsMappedCost f xs ≤ existsMappedCost g xs := by
  intro xs
  induction xs with
  | nil => intro _; rfl
  | cons x xs ih =>
      intro h
      have hx := h x List.mem_cons_self
      have ht := ih (fun y hy => h y (List.mem_cons_of_mem x hy))
      simp only [existsMappedCost]
      omega
def clauseCostBound (F : FieldPresentation K) (D M : Nat)
    {c0 m : Nat} (cl : Clause (Fin (c0 + m)) Int) : Nat :=
  22 + (12 * M + 6 + Problem18ConcreteClauseDecision20261002.cost F cl D)
def patternCostBound (F : FieldPresentation K) (n d D M : Nat)
    (pat : Σ k : Nat, Fin k → Fin (boxSize n (cpE n d))) : Nat :=
  2 + existsMappedCost (clauseCostBound F D M)
    (clauses (qe (template n d pat)))
def fixedCostBound (F : FieldPresentation K) (n d D M : Nat) : Nat :=
  2 + existsMappedCost (patternCostBound F n d D M)
    (patterns (boxSize n (cpE n d)))
theorem clauseCostBound_mono (F : FieldPresentation K) (D : Nat) {M M' : Nat}
    (hM : M ≤ M') {c0 m : Nat} (cl : Clause (Fin (c0 + m)) Int) :
    clauseCostBound F D M cl ≤ clauseCostBound F D M' cl := by
  unfold clauseCostBound
  omega
theorem patternCostBound_mono (F : FieldPresentation K) (n d D : Nat)
    {M M' : Nat} (hM : M ≤ M')
    (pat : Σ k : Nat, Fin k → Fin (boxSize n (cpE n d))) :
    patternCostBound F n d D M pat ≤ patternCostBound F n d D M' pat := by
  unfold patternCostBound
  have h := existsMappedCost_mono
    (clauseCostBound F D M) (clauseCostBound F D M')
    (clauses (qe (template n d pat)))
    (fun cl _ => clauseCostBound_mono F D hM cl)
  omega
theorem fixedCostBound_mono (F : FieldPresentation K) (n d D : Nat)
    {M M' : Nat} (hM : M ≤ M') :
    fixedCostBound F n d D M ≤ fixedCostBound F n d D M' := by
  unfold fixedCostBound
  have h := existsMappedCost_mono
    (patternCostBound F n d D M) (patternCostBound F n d D M')
    (patterns (boxSize n (cpE n d)))
    (fun pat _ => patternCostBound_mono F n d D hM pat)
  omega
def Config.fixedCost (P : Config) (F : FieldPresentation K)
    (n d R : Nat) : Nat :=
  fixedCostBound F n d (P.depth d) (P.memoryCap d R)
theorem Config.fixedCost_mono (P : Config) (F : FieldPresentation K)
    (n d R R' : Nat) (hR : R ≤ R') :
    P.fixedCost F n d R ≤ P.fixedCost F n d R' :=
  fixedCostBound_mono F n d (P.depth d) (P.memoryCap_mono d R R' hR)
structure Reference (P : Config) (F : FieldPresentation K)
    (n d B : Nat) (rows : List (DenseInput n d K)) (ρ : Env) : Prop where
  slots : ∀ pat ∈ patterns (boxSize n (cpE n d)),
    ∀ cl ∈ clauses (qe (template n d pat)),
      Slots F canonical names.q.WS (size cl (P.depth d)) B ρ
  memory_words : ∀ k (hk : k < (ρ.arrs canonical.mem).length),
    (ρ.arrs canonical.mem)[k] < B
  memory_length : (ρ.arrs canonical.mem).length ≤ P.memoryCap d rows.length
  count_value : ρ.vars P.count = (ρ.arrs canonical.mem).length
  seven : 7 < B
  image_bound : ∀ v ∈ image P.count ρ, v < B
  zero : val F canonical names.q.WS ρ 0 = 0
  cardinal : ρ.vars names.qr = Fintype.card K
  cardinal_word : Fintype.card K < B
  expressions : ∀ pat ∈ patterns (boxSize n (cpE n d)),
    ∀ cl ∈ clauses (qe (template n d pat)), ∀ p ∈ sysExprs cl,
      ∀ e ∈ rowExprs p (clauseDeg cl),
        polyDepth e ≤ P.depth d ∧ constBound e < B
  data : ∀ i : Fin (boxSize n d * boxSize n d),
    val F canonical names.q.WS ρ (5 + i.val) =
      flatData (rowData n d rows) i
  words : ∀ pat ∈ patterns (boxSize n (cpE n d)),
    ∀ cl ∈ clauses (qe (template n d pat)),
      (sysExprs cl).length + (pat.1 * boxSize n (cpE n d) + 1) +
        lenM (pat.1 * boxSize n (cpE n d) + 1)
          (eliminantShift (pat.1 * boxSize n (cpE n d) + 1) (clauseDeg cl)) +
        lenD (pat.1 * boxSize n (cpE n d) + 1) (clauseDeg cl) +
        lenM (pat.1 * boxSize n (cpE n d) + 1)
          (geoE (pat.1 * boxSize n (cpE n d) + 1)
            (frobeniusDegree (pat.1 * boxSize n (cpE n d) + 1) (clauseDeg cl))) +
        rowLength (pat.1 * boxSize n (cpE n d) + 1) (clauseDeg cl) < B
