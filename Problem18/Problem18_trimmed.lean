def data (F G : Matrix (Fin c) (Fin a × Fin b) K) : Params a b → K := fun z=>
  match z.1.val with
  | 0=>Problem18P34Frontend20261003Padding.padded
      (Problem18P34Frontend20261003FiniteSystem.matrix F (marker c)) z.2.1 z.2.2
  | 1=>augmentedKernel G z.2.1 (augmentedIndex a b z.2.2)
  | 2=>let A:=augmentedConstantMatrix F (marker c)
       (A.transpose*A) (augmentedIndex a b z.2.1) (augmentedIndex a b z.2.2)
  | _=>let A:=augmentedConstantMatrix G (marker c)
       (A.transpose*A) (augmentedIndex a b z.2.1) (augmentedIndex a b z.2.2)
def gram (ij kl : Fin a × Fin b) : PolyExpr (Params a b ⊕ OuterVar a b) Int :=
  reindex (Sum.map (Sum.elim
    (fun uv=>(2,col uv.1,col uv.2)) (fun uv=>(3,col uv.1,col uv.2))) id) (gramT ij kl)
def row (s t : Fin (a*b+1)) : PolyExpr (Params a b ⊕ OuterVar a b) Int :=
  .add (PolyExpr.sumFin a fun i=>PolyExpr.sumFin b fun j=>
    PolyExpr.sumFin a fun u=>PolyExpr.sumFin b fun v=>
      .mul (.mul (.var (.inl (0,s,col (u,v)))) (tensorT (i,j) (u,v)))
        (.var (.inl (1,t,col (i,j)))))
    (.mul (.var (.inl (0,s,last a b))) (.var (.inl (1,t,last a b))))
def isoP (i j : Fin a) : PolyExpr (Params a b ⊕ OuterVar a b) Int :=
  reindex Sum.inr (preservesPEntry (b:=b) (1 : Matrix (Fin a) (Fin a) Int) i j)
def isoR (i j : Fin b) : PolyExpr (Params a b ⊕ OuterVar a b) Int :=
