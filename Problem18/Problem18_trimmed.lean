open scoped BigOperators
namespace Mathproof.Problem18BoundedMacaulayCompletion20260930
open MvPolynomial MonomialOrder
open Mathproof.LibraryBridges.Claude.GroebnerNormalForms_20260908
open Mathproof.Problem18BoundedCompletionDegree20260930
open Mathproof.Problem18BoundedMacaulay20260930
open Mathproof.Problem18GeneralBuchberger20260930
variable {N : Nat} {K : Type*} [Field K]
theorem difference_monomial_totalDegree_le
    (f g : MvPolynomial (Fin N) K) (c : K) :
    (monomial (degLex.degree f-degLex.degree g) c).totalDegree ≤ f.totalDegree := by
  calc
    _ ≤ (degLex.degree f-degLex.degree g).degree := totalDegree_monomial_le _ _
    _ ≤ (degLex.degree f).degree := Finsupp.degree_mono tsub_le_self
    _ = _ := degree_degLexDegree
theorem sPolynomial_mem_macaulaySpan
    (F : Set (MvPolynomial (Fin N) K)) (E D : Nat)
    (f g : MvPolynomial (Fin N) K)
    (hf : f ∈ macaulaySpan F E) (hg : g ∈ macaulaySpan F E)
    (hfd : f.totalDegree ≤ D) (hgd : g.totalDegree ≤ D) :
    degLex.sPolynomial f g ∈ macaulaySpan F (E+2*D) := by
  rw [MonomialOrder.sPolynomial]
  apply Submodule.sub_mem
  · exact mul_mem_macaulaySpan F E (2*D) _ f
      ((difference_monomial_totalDegree_le g f _).trans (by omega)) hf
  · exact mul_mem_macaulaySpan F E (2*D) _ g
      ((difference_monomial_totalDegree_le f g _).trans (by omega)) hg
theorem non_groebner_macaulay_obstruction
    (F G : Set (MvPolynomial (Fin N) K)) (E D : Nat)
    (hGmem : ∀ g ∈ G, g ∈ macaulaySpan F E)
    (hdegree : ∀ g ∈ G, g.totalDegree ≤ D)
    (hnot : ¬ IsGroebner degLex G) :
    ∃ r : MvPolynomial (Fin N) K, r ≠ 0 ∧ r ∈ generatedIdeal G ∧
      IsReduced degLex G r ∧ r.totalDegree ≤ 2*D ∧
      r ∈ macaulaySpan F (E+2*D) := by
  classical
  by_contra hnone
  push Not at hnone
  let b : Reducer G → MvPolynomial (Fin N) K := fun g => g.val
  have hb : ∀ i, b i ≠ 0 := fun i => i.property.2
  have hu : ∀ i, IsUnit (degLex.leadingCoeff (b i)) := fun i =>
    isUnit_iff_ne_zero.mpr (degLex.leadingCoeff_ne_zero_iff.mpr (hb i))
  have hcert : ∀ i j : Reducer G, ∃ q : Reducer G →₀ MvPolynomial (Fin N) K,
      Finsupp.linearCombination _ b q = degLex.sPolynomial (b i) (b j) ∧
      ∀ k, q k ≠ 0 → degLex.toSyn (degLex.degree (b k*q k)) <
        degLex.toSyn (degLex.degree (b i) ⊔ degLex.degree (b j)) := by
    intro i j
    by_cases hz : degLex.sPolynomial (b i) (b j) = 0
    · exact ⟨0, by simp [hz], by simp⟩
    obtain ⟨q,r,heq,hq,hr⟩ := degLex.div hu (degLex.sPolynomial (b i) (b j))
    have hrepI : Finsupp.linearCombination _ b q ∈ generatedIdeal G := by
      rw [Finsupp.linearCombination_apply]
      exact Ideal.sum_mem _ (fun k _ => Ideal.mul_mem_left _ _ (Ideal.subset_span k.property.1))
    have hrI : r ∈ generatedIdeal G := by
      have hs := sPolynomial_mem_span degLex G i.property.1 j.property.1
      rw [heq] at hs
      simpa using (generatedIdeal G).sub_mem hs hrepI
    have hred : IsReduced degLex G r := by
      intro d hd g hg hg0
      exact hr d hd ⟨g,hg,hg0⟩
    have hrd : r.totalDegree ≤ 2*D := by
      apply (degLex_totalDegree_monotone
        (division_remainder_degree_bound degLex b q _ r heq hq)).trans
      exact (sPolynomial_totalDegree_le _ _).trans
        (by have hi := hdegree (b i) i.property.1; have hj := hdegree (b j) j.property.1; omega)
    have hsbound : (degLex.sPolynomial (b i) (b j)).totalDegree ≤ 2*D :=
      (sPolynomial_totalDegree_le _ _).trans
        (by have hi := hdegree (b i) i.property.1; have hj := hdegree (b j) j.property.1; omega)
    have hmac : r ∈ macaulaySpan F (E+2*D) := by
      have hsmac := sPolynomial_mem_macaulaySpan F E D (b i) (b j)
        (hGmem _ i.property.1) (hGmem _ j.property.1)
        (hdegree _ i.property.1) (hdegree _ j.property.1)
      have hqmac : Finsupp.linearCombination _ b q ∈ macaulaySpan F (E+2*D) := by
        rw [Finsupp.linearCombination_apply]
        apply Submodule.sum_mem
        intro k hk
        have hqdeg : (q k).totalDegree ≤ 2*D :=
          (multiplier_totalDegree_le (b k) (q k) (hb k)).trans
            ((degLex_totalDegree_monotone (hq k)).trans hsbound)
        exact mul_mem_macaulaySpan F E (2*D) (q k) (b k) hqdeg (hGmem _ k.property.1)
      rw [heq] at hsmac
      simpa using (macaulaySpan F (E+2*D)).sub_mem hsmac hqmac
    have hr0 : r = 0 := by
      by_contra hr0
      exact hnone r hr0 hrI hred hrd hmac
    refine ⟨q, by simpa [hr0] using heq.symm, ?_⟩
    intro k hk
    exact (hq k).trans_lt (degLex.degree_sPolynomial_lt_sup_degree hz)
  choose pairs hpairs hsmall using hcert
  apply hnot
  intro f hf hf0
  have hspan : generatedIdeal G = Ideal.span (Set.range b) := by
    apply le_antisymm
    · apply Ideal.span_le.mpr
      intro f hf
      by_cases hf0 : f = 0
      · simp [hf0]
      · exact Ideal.subset_span ⟨⟨f,hf,hf0⟩,rfl⟩
    · apply Ideal.span_le.mpr
      rintro f ⟨i,rfl⟩
      exact Ideal.subset_span i.property.1
  rw [hspan] at hf
  obtain ⟨q,hq⟩ := Finsupp.mem_ideal_span_range_iff_exists_finsupp.mp hf
  have hrep : ∃ q, Finsupp.linearCombination (MvPolynomial (Fin N) K) b q = f := by
    refine ⟨q,?_⟩
    simpa only [Finsupp.linearCombination_apply, Finsupp.sum, smul_eq_mul] using hq
  obtain ⟨i,hi⟩ := leading_divisibility_of_small_pairs degLex b hb pairs hpairs hsmall f hf0 hrep
  exact ⟨b i,i.property.1,hb i,hi⟩
end Mathproof.Problem18BoundedMacaulayCompletion20260930
end
