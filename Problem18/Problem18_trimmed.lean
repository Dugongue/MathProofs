variable {K : Type*} [Field K] [DecidableEq K] {n m : ℕ}
theorem encoding_single (u v : Fin n) :
    encoding.symm (Pi.single (finProdFinEquiv (u,v)) (1:K))=Matrix.single u v 1 := by
  ext a b
  change (Pi.single (finProdFinEquiv (u,v)) (1:K) : Fin (n*n) → K) (finProdFinEquiv (a,b))=Matrix.single u v 1 a b
  simp [Pi.single_apply,Matrix.single,finProdFinEquiv.injective.eq_iff,eq_comm]
theorem equationMatrix_entry (S T : Fin m → Matrix (Fin n) (Fin n) K)
    (j : Fin m) (a b u v : Fin n) :
    equationMatrix S T (finProdFinEquiv (j,finProdFinEquiv (a,b))) (finProdFinEquiv (u,v)) =
      (if a=u then S j v b else 0)-(if b=v then T j a u else 0) := by
  rw [equationMatrix,LinearMap.toMatrix'_apply,LinearMap.comp_apply]
  change equationMap S T (encoding.symm (Pi.single (finProdFinEquiv (u,v)) (1:K)))
    (finProdFinEquiv (j,finProdFinEquiv (a,b)))=_
  rw [encoding_single]
  simp only [equationMap,LinearMap.coe_mk,AddHom.coe_mk,Equiv.symm_apply_apply,Matrix.sub_apply]
  by_cases ha : a=u <;> by_cases hb : b=v
  · subst a; subst b; simp
  · subst a; simp [hb]
  · subst b; simp [ha]
  · simp [ha,hb]
