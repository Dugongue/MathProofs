private theorem phi_two_linear_branch
    (b d r u : ℝ) (hb : 8 ≤ b) (hr : 1 ≤ r) (hrb : r ≤ b)
    (hd : 0 ≤ d) (hdb : 64 * d ≤ b) (hu : 0 ≤ u) :
    b * r / 4 ≤
      u * (2 * b - 2 * r - d + u) + (b - d) * (2 * r - 2 * u)
        - b * r + r * (r - 1) / 2 := by
  have hr0 : 0 ≤ r := by linarith
  have hrr : r * r ≤ b * r := mul_le_mul_of_nonneg_right hrb hr0
  have hdr : 64 * (d * r) ≤ b * r := by nlinarith [mul_nonneg (by linarith : 0 ≤ b - 64 * d) hr0]
  have hbrr : 8 * r ≤ b * r := by nlinarith [mul_nonneg (by linarith : 0 ≤ b - 8) hr0]
  have hsq : 0 ≤ (u - r) ^ 2 := sq_nonneg (u - r)
  have hud : 0 ≤ u * d := mul_nonneg hu hd
  nlinarith
noncomputable def restrictionExponent (a b d r u : ℝ) : ℝ :=
  u * (a * b - a * r - d + u) + (b - d) * max (a * r - 2 * u) 0
    - b * r + r * (r - 1) / 2
theorem restrictionExponent_lower_bound
    (a b d r u : ℝ) (ha : 2 ≤ a) (hb : 8 ≤ b)
