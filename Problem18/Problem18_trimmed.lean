    letI : Algebra A W.toValuationSubring := j.toAlgebra
    letI : IsScalarTower A W.toValuationSubring L := IsScalarTower.of_algebraMap_eq fun _ => rfl
    intro s
    have hi : IsIntegral W.toValuationSubring (algebraMap S L s) :=
      (IsIntegralClosure.isIntegral A L s).algebraMap.tower_top
    obtain ⟨w,hw⟩ := (isIntegrallyClosed_iff L).mp
      (inferInstance : IsIntegrallyClosed W.toValuationSubring) hi
    exact hw ▸ w.property
