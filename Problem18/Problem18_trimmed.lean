variable {K : Type} [Field K] {a b : Nat}
abbrev Cell (a : Nat) := Fin a ⊕ Fin 2
def acc : Cell a := .inr 0
def temp : Cell a := .inr 1
def seed : Instruction (Cell a) := ⟨.point .sub,temp,temp,acc⟩
def add (i : Fin a) : Instruction (Cell a) := ⟨.point .add,acc,.inl i,temp⟩
def copy : Instruction (Cell a) := ⟨.point .copy,temp,temp,acc⟩
def steps : List (Fin a) → List (Instruction (Cell a))
  | [] => []
  | i::is => add i :: copy :: steps is
def instructions (a : Nat) : List (Instruction (Cell a)) := seed :: steps (List.finRange a)
def inputReg : String := "P18.large.trace.input"
def workReg : String := "P18.large.trace.work"
def locations (r s : Fin b) : Cell a→Location
  | .inl i => ⟨inputReg,(i.val*b+r.val)*(a*b)+(i.val*b+s.val)⟩
  | .inr j => ⟨workReg,j.val⟩
def program (a : Nat) {b : Nat} (r s : Fin b) : Com :=
  programCode (locations (a:=a) r s) (instructions a)
end Mathproof.Problem18P35PartialTrace20261003
