theorem decision_result_bit {B t : Nat} {sigma tau : Env}
    (h : Run B decisionProgram sigma tau t) :
    tau.vars resultReg=0 ∨ tau.vars resultReg=1 := by
  obtain ⟨k,hk,hstep⟩:=h
  unfold decisionProgram Problem18P36BoundaryDecision20261002.program at hstep
  cases hstep with
  | seq _ h1 =>
    cases h1 with
    | seq _ h2 =>
      cases h2 with
      | seq _ hfinish =>
        exact Problem18P36BoundaryRoutedController20261003.finishProgram_result_bit
          ⟨_,le_rfl,hfinish⟩
theorem decision_protected : ∀x∈stageProtected,x∉scalarWrites decisionProgram := by decide
theorem stage_keep : ∀a∈[keepBank],a∉arrayWrites stageController := by decide
variable {K : Type} [Field K] [Fintype K] [DecidableEq K]
noncomputable def prefixCost (F : FieldPresentation K) (q a b c : Nat) : Nat :=
  2*stageCost F q a b c+6+
    2*(20*memLen (boundaryWidth a b c) F.e+9+2*memLenExpr.size+2)+
    2*(20*(a*b*c*F.e)+9+3)+
    Problem18P36BoundaryDecision20261002.cost F (boundaryWidth a b c)
structure PrefixOut (F : FieldPresentation K) (B a b c : Nat) (u : Bool) (q : Nat)
    (A T : RectTensor a b c K) (sigma tau : Env)
    (hfirst : (shape (sortOrder a b c) a b c).1=1) : Prop where
  snapA : Snap F tau 0 (stageGram u q A hfirst)
  snapB : Snap F tau (memLen (boundaryWidth a b c) F.e) (stageGram u q T hfirst)
  bit : tau.vars resultReg=0 ∨ tau.vars resultReg=1
  result : tau.vars resultReg=1 ↔
    Problem18CyclicBoundaryRecognizer20261002.guardedRegularCheck (stageGram u q T hfirst)=true
  slots : Slots F canonical Problem18IMPPolynomialProductCall20261002.WS
    (slots (boundaryWidth a b c)) B tau
  keep : ∀k<a*b*c*F.e,(tau.arrs keepBank).getD k 0=(tensorCoordinates F A).getD k 0
  target : tau.arrs targetBank=sigma.arrs targetBank
  pair_len : (tau.arrs pairBank).length=(sigma.arrs pairBank).length
  keep_len : (tau.arrs keepBank).length=(sigma.arrs keepBank).length
  regs : ∀x∈stageProtected,tau.vars x=sigma.vars x
  inp : tau.inp=sigma.inp
  out : tau.out=sigma.out
  mem_len : (tau.arrs canonical.mem).length=memLen (boundaryWidth a b c) F.e
  tensor_canon : ∀x<(tau.arrs tensorBank).length,(tau.arrs tensorBank).getD x 0<F.p
  tensor_word : (tau.arrs tensorBank).length<B
  keep_canon : ∀x<(tau.arrs keepBank).length,(tau.arrs keepBank).getD x 0<F.p
  keep_word : (tau.arrs keepBank).length<B
  tensor_value : ∀x<a*b*c*F.e,(tau.arrs tensorBank).getD x 0=(tensorCoordinates F T).getD x 0
  tensor_len : (tau.arrs tensorBank).length=(sigma.arrs tensorBank).length
theorem prefix_run (F : FieldPresentation K) {B a b c : Nat} {u : Bool} {q : Nat}
    {A T : RectTensor a b c K} {sigma : Env} (h : PairInput F B a b c u q A T sigma) :
    ∃tau t, Run B prefixProgram sigma tau t ∧ t ≤ prefixCost F q a b c ∧
      PrefixOut F B a b c u q A T sigma tau h.src.first := by
  obtain ⟨rho,t0,hr0,ht0,ho⟩:=firstHalf_run F h
  have hLB : memLen (boundaryWidth a b c) F.e<B := by have:=h.len_word;omega
  have hpB : F.p<B := by
    have hh:=h.src.nativeValid.arithmetic_word
    nlinarith
  obtain ⟨s6,t6,ht6,hr6,hst6,-,hi6,ho6⟩:=stageController_run F rho ho.input
  have hreg6 : ∀x∈stageProtected,s6.vars x=rho.vars x :=
    fun x hx=>(run_frame hr6).1 x (stage_protected x hx)
  have harr6 : ∀a∈[tensorBank,targetBank,pairBank],s6.arrs a=rho.arrs a :=
    fun a ha=>(run_frame hr6).2.1 a (stage_arrays a ha)
  have hkeep6 : s6.arrs keepBank=rho.arrs keepBank :=
    (run_frame hr6).2.1 _ (stage_keep _ (by simp))
  obtain ⟨s7,hr7,hst7,hv7,hvars7,harr7,hi7,ho7⟩:=zeroGap_run F hst6
  have hcols7 : s7.vars Problem18IMPTensorGather20261002.cols=boundaryWidth a b c := by
    rw [hvars7,hreg6 _ (by simp [stageProtected]),ho.regs _ (by simp [stageProtected])]
    exact h.src.cols_eq
  have he7 : s7.vars canonical.e=F.e := hv7.degree
  have hpair7 : s7.arrs pairBank=rho.arrs pairBank := by
    rw [harr7 _ (by decide),harr6 _ (by simp)]
  have hL : memLenExpr.evalB B s7=some (memLen (boundaryWidth a b c) F.e) :=
    memLenExpr_eval hcols7 he7 (by have:=h.len_word;omega)
  obtain ⟨s8,hr8,hcopy8,hout8,harr8,hlen8,hvars8,hi8,ho8⟩:=
    copyBlock_run (src:=canonical.mem) (dst:=pairBank) (by decide)
      (cntE:=memLenExpr) (sbE:=.lit 0) (dbE:=memLenExpr) (B:=B)
      (n:=memLen (boundaryWidth a b c) F.e) (sourceBase:=0)
      (targetBase:=memLen (boundaryWidth a b c) F.e) s7 hL
      (evalB_lit (by omega))
      (by
        have h1 : ((s7.setVar cntReg (memLen (boundaryWidth a b c) F.e)).setVar sbReg 0).vars
            Problem18IMPTensorGather20261002.cols=boundaryWidth a b c := by
          rw [vars_setVar,vars_setVar,if_neg (by decide),if_neg (by decide)];exact hcols7
        have h2 : ((s7.setVar cntReg (memLen (boundaryWidth a b c) F.e)).setVar sbReg 0).vars
            canonical.e=F.e := by
          rw [vars_setVar,vars_setVar,if_neg (by decide),if_neg (by decide)];exact he7
        exact memLenExpr_eval h1 h2 (by have:=h.len_word;omega))
      hLB (by omega) (by have:=h.len_word;omega)
      (by rw [hst7.length];simp [memLen])
      (by rw [hpair7,ho.pair_len];have:=h.pair_fit;omega)
      (by
        intro k hk
        have := hv7.coefficients (0+k) (by rw [hst7.length];simpa [memLen] using hk)
        omega)
  have hsnapB : Snap F s8 (memLen (boundaryWidth a b c) F.e) (stageGram u q T h.src.first) :=
    snap_of_state F hst7 hv7 (by intro k hk;simpa using hcopy8 k hk)
  have hsnapA : Snap F s8 0 (stageGram u q A h.src.first) := by
    have hs:=ho.snap
    refine ⟨?_,?_,?_,?_⟩
    · intro i j
      rw [← hs.matrix i j]
      unfold pairSlot
      congr 1;funext t
      rw [hout8 _ (Or.inl ?_),hpair7]
      have := slot_lt (n:=boundaryWidth a b c) (e:=F.e)
        (s:=matrix (boundaryWidth a b c)+i.val*(boundaryWidth a b c)+j.val) (i:=t.val)
        (by
          obtain ⟨_,_,_,_,_,_,_,_,_,_,hm,ha,_,_,_,_,_⟩:=allocation (boundaryWidth a b c)
          have h1:=Nat.mul_le_mul_right (boundaryWidth a b c) (Nat.succ_le_of_lt i.isLt)
          have h2:=j.isLt
          simp only [Nat.succ_mul] at h1
          unfold slots orbitWork orbit productWork product temp action at *
          omega) t.isLt
      omega
    · intro j
      rw [← hs.vector j]
      unfold pairSlot
      congr 1;funext t
      rw [hout8 _ (Or.inl ?_),hpair7]
      have := slot_lt (n:=boundaryWidth a b c) (e:=F.e)
        (s:=candidate (boundaryWidth a b c)+j.val) (i:=t.val)
        (by
          obtain ⟨_,_,_,_,_,_,_,_,hc,hsd,hm,ha,_,_,_,_,_⟩:=allocation (boundaryWidth a b c)
          have h2:=j.isLt
          unfold slots orbitWork orbit productWork product temp action at *
          omega) t.isLt
      omega
    · intro j hj
      rw [← hs.polynomial j hj]
      unfold pairSlot
      congr 1;funext t
      rw [hout8 _ (Or.inl ?_),hpair7]
      have := slot_lt (n:=boundaryWidth a b c) (e:=F.e)
        (s:=first (boundaryWidth a b c)+j) (i:=t.val)
        (by
          obtain ⟨_,_,_,_,_,hf,hg,hd,hc,hsd,hm,ha,_,_,_,_,_⟩:=allocation (boundaryWidth a b c)
          unfold slots orbitWork orbit productWork product temp action at *
          omega) t.isLt
      omega
    · intro k hk
      rw [hout8 _ (Or.inl (by simpa using hk)),hpair7]
      exact hs.canonical k hk
  have hst8 : Problem18IMPBoundarySweepState20261002.State F B
      (stageGram u q T h.src.first) (boundaryWidth a b c) s8 := by
    apply state_transfer F hst7
      (memAgree_of_eq F hst7 (harr8 _ (by decide)) (harr8 _ (by decide))
        (fun x hx=>hvars8 x (by
          simp only [List.mem_cons,List.not_mem_nil,or_false] at hx
          rcases hx with rfl|rfl|rfl|rfl|rfl <;> decide)))
    · exact hvars8 _ (by decide)
    · exact hvars8 _ (by decide)
  obtain ⟨s9,hr9,hslots9,hres9,hi9,ho9⟩:=
    Problem18P36BoundaryDecision20261002.program_run F hst8 h.src.boundary_words h.src.terminal_word
  have hbit:=decision_result_bit (t:=Problem18P36BoundaryDecision20261002.cost F (boundaryWidth a b c)) hr9
  have hpair9 : s9.arrs pairBank=s8.arrs pairBank := (run_frame hr9).2.1 _ (by decide)
  have hkeep9 : s9.arrs keepBank=s8.arrs keepBank := (run_frame hr9).2.1 _ (by decide)
  have htarget9 : s9.arrs targetBank=s8.arrs targetBank := (run_frame hr9).2.1 _ (by decide)
  refine ⟨s9,_,hr0.seq (hr6.seq (hr7.seq (hr8.seq hr9))),?_,?_⟩
  · unfold prefixCost
    simp only [Expr.size] at *
    omega
  refine ⟨snap_of_pair F hsnapA hpair9,snap_of_pair F hsnapB hpair9,hbit,hres9,hslots9,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_⟩
  · intro k hk
    rw [hkeep9,harr8 _ (by decide),harr7 _ (by decide),hkeep6]
    exact ho.keep k hk
  · rw [htarget9,harr8 _ (by decide),harr7 _ (by decide),harr6 _ (by simp),ho.target]
  · rw [hpair9,hlen8,hpair7,ho.pair_len]
  · rw [hkeep9,harr8 _ (by decide),harr7 _ (by decide),hkeep6,ho.keep_len]
  · intro x hx
    rw [(run_frame hr9).1 x (decision_protected x hx),hvars8 x (copyRegs_fresh x hx),hvars7,
      hreg6 x hx,ho.regs x hx]
  · rw [hi9,hi8,hi7,hi6,ho.inp]
  · rw [ho9,ho8,ho7,ho6,ho.out]
  · rw [(run_frame hr9).2.2.1 canonical.mem,harr8 _ (by decide),hst7.length];rfl
  · have ht : s9.arrs tensorBank=rho.arrs tensorBank := by
      rw [(run_frame hr9).2.1 _ (by decide),harr8 _ (by decide),harr7 _ (by decide),
        harr6 _ (by simp)]
    rw [ht];exact ho.input.tensor_coefficients
  · have ht : s9.arrs tensorBank=rho.arrs tensorBank := by
      rw [(run_frame hr9).2.1 _ (by decide),harr8 _ (by decide),harr7 _ (by decide),
        harr6 _ (by simp)]
    rw [ht];exact ho.input.tensor_word
  · have hk : s9.arrs keepBank=rho.arrs keepBank := by
      rw [hkeep9,harr8 _ (by decide),harr7 _ (by decide),hkeep6]
    rw [hk,ho.keep_len,h.keep_len]
    intro x hx
    rw [ho.keep x hx,← h.src.tensor_value x hx]
    exact h.src.tensor_coefficients x (lt_of_lt_of_le hx h.src.tensor_fit)
  · have hk : s9.arrs keepBank=rho.arrs keepBank := by
      rw [hkeep9,harr8 _ (by decide),harr7 _ (by decide),hkeep6]
    rw [hk,ho.keep_len,h.keep_len]
    exact lt_of_le_of_lt h.src.tensor_fit h.src.tensor_word
  · have ht : s9.arrs tensorBank=rho.arrs tensorBank := by
      rw [(run_frame hr9).2.1 _ (by decide),harr8 _ (by decide),harr7 _ (by decide),
        harr6 _ (by simp)]
    rw [ht];exact ho.input.tensor_value
  · have ht : s9.arrs tensorBank=rho.arrs tensorBank := by
      rw [(run_frame hr9).2.1 _ (by decide),harr8 _ (by decide),harr7 _ (by decide),
