variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}
def rcopyBody (M : FieldMacros F r) (q : RNames) (D S : Expr) : Com :=
  .seq (mcall r q M.copy (plus S (.bin .sub (.bin .sub (.var q.N) (.lit 1)) (.var q.j)))
          (plus S (.bin .sub (.bin .sub (.var q.N) (.lit 1)) (.var q.j))) (plus D (.var q.j)))
    (.assign q.j (plus (.var q.j) (.lit 1)))
def rcopyLoop (M : FieldMacros F r) (q : RNames) (D S : Expr) : Com :=
  .seq (.assign q.j (.lit 0)) (.while (.lt (.var q.j) (.var q.N)) (rcopyBody M q D S))
def rcopyStep (M : FieldMacros F r) (D S : Expr) : ℕ := 33 + D.size + 2 * S.size + M.costPoint
def rcopyCost (M : FieldMacros F r) (D S : Expr) (N : ℕ) : ℕ :=
