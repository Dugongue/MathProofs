def simulationStart (p : Program) (wordBound : Polynomial Nat)
    (x : List Nat) : (ramSimulationTM p wordBound).Cfg :=
  Turing.initList (ramSimulationTM p wordBound) (encode x)
def simulationAfterFuel (p : Program) (wordBound timeBound : Polynomial Nat)
    (x : List Nat) : (ramSimulationTM p wordBound).Cfg :=
  (totalStep (ramSimulationTM p wordBound).step)^[
    clockTokenCount p wordBound timeBound x]
      (simulationStart p wordBound x)
def simulationSucceeded (p : Program)
    (wordBound timeBound : Polynomial Nat) (x : List Nat) : Bool :=
  (simulationAfterFuel p wordBound timeBound x).l.isNone
def simulationRawOutput (p : Program)
    (wordBound timeBound : Polynomial Nat) (x : List Nat) :
    List Lax51.BinaryWordEncoding.Symbol :=
  (simulationAfterFuel p wordBound timeBound x).stk .output
def clockedDecision (p : Program)
    (wordBound timeBound : Polynomial Nat) (x : List Nat) : Bool :=
  if simulationSucceeded p wordBound timeBound x then
    (run totalDecoder .start
      (simulationRawOutput p wordBound timeBound x)).headD false
  else false
theorem simulationAfterFuel_eq_of_runsTo
    (p : Program) (wordBound timeBound : Polynomial Nat)
    (x output : List Nat) (t : Nat)
    (hfits : FitsInWords (wordBound.eval (bitSize x))
      ((x.length :: x) ++ output))
    (ht : t ≤ timeBound.eval (bitSize x))
    (hram : RunsTo (simulationWordWidth wordBound x) p
      (x.length :: x) output t) :
    simulationAfterFuel p wordBound timeBound x =
      Turing.haltList (ramSimulationTM p wordBound) (encode output) := by
  obtain ⟨steps,hsteps,hrun⟩ :=
    combined_runsTo_bounded p wordBound timeBound x output t hfits ht hram
  have hrun' :
      ((fun o => o.bind (ramSimulationTM p wordBound).step)^[steps])
        (some (simulationStart p wordBound x)) =
      some (Turing.haltList (ramSimulationTM p wordBound) (encode output)) := by
    rw [simulationStart, ramSimulation_initList, ramSimulation_haltList]
    change
      ((fun o => o.bind (TM2.step
        (combinedProgram p (programArgumentBound p) le_rfl wordBound)))^[steps])
        (some (mapLabelCfg embedInputCombined
          (fullInputCfg (.inl (.inl .scan)) default
            (inputWidthInitialStacks (encode x))))) =
      some ⟨none, default,
        wrapperCoreStacks (fun _ => []) [] (encode output)⟩
    exact hrun
  have hprefix := total_iterate_of_some
    (ramSimulationTM p wordBound).step steps
    (simulationStart p wordBound x)
    (Turing.haltList (ramSimulationTM p wordBound) (encode output)) hrun'
  have hclock : steps ≤ clockTokenCount p wordBound timeBound x :=
    hsteps.trans (timeBound_le_clockTokenCount p wordBound timeBound x)
  unfold simulationAfterFuel
  rw [← Nat.sub_add_cancel hclock, Function.iterate_add_apply, hprefix]
  exact Function.iterate_fixed (by
    simp [totalStep, Turing.haltList]) _
theorem clockedDecision_eq_of_runsTo
    (p : Program) (wordBound timeBound : Polynomial Nat)
    (x : List Nat) (b : Bool) (t : Nat)
    (hfits : FitsInWords (wordBound.eval (bitSize x))
      ((x.length :: x) ++ answerWords (some b)))
    (ht : t ≤ timeBound.eval (bitSize x))
    (hram : RunsTo (simulationWordWidth wordBound x) p
      (x.length :: x) (answerWords (some b)) t) :
    clockedDecision p wordBound timeBound x = b := by
  have hfinal := simulationAfterFuel_eq_of_runsTo p wordBound timeBound x
    (answerWords (some b)) t hfits ht hram
  have hs : simulationSucceeded p wordBound timeBound x = true := by
    simp [simulationSucceeded, hfinal, Turing.haltList]
  have ho : simulationRawOutput p wordBound timeBound x =
      encode (answerWords (some b)) := by
    simp [simulationRawOutput, hfinal, Turing.haltList, ramSimulationTM]
  rw [clockedDecision, hs, ho, total_decode_answer]
  cases b <;> rfl
theorem totalDecoder_eq_singleton_headD
    (q : Mathproof.Problem18RAMAnswerCodec20261001.State)
    (raw : List Lax51.BinaryWordEncoding.Symbol) :
