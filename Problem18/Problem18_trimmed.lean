  intro x y
  simp only [modelTraceForm_apply]
  apply Finset.sum_congr rfl
  intro i _
  congr 1
  ring
theorem modelTraceForm_nondegenerate (c : ∀ i,AdjoinRoot (g i)) (hc : ∀ i,c i≠0) :
    (modelTraceForm g c).Nondegenerate := by
