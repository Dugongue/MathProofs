variable {K : Type} [Field K] [Fintype K] [DecidableEq K]
def Loaded (F : FieldPresentation K) (r : FieldNames) (q : RNames) (cn : CNames) {n : ℕ}
    (d : ℕ) (rows : List (DenseInput n d K)) (σ : Env) : Prop :=
  σ.vars q.N = boxSize n d ∧ σ.vars cn.R = rows.length ∧
    ∀ t (ht : t < rows.length) (k : Fin (boxSize n d)),
      val F r q.WS σ (inStart (boxSize n d) t + k.val) =
        Problem18ArrayElimination20260929.read (rows[t]'ht) k
def Pre (F : FieldPresentation K) (r : FieldNames) (q : RNames) (cn : CNames) (B S : ℕ)
    (σ : Env) : Prop :=
  Slots F r q.WS S B σ ∧ val F r q.WS σ 0 = 0 ∧ q.Valid r ∧ cn.Valid r q ∧
    σ.vars cn.R < B ∧ inStart (σ.vars q.N) (σ.vars cn.R) ≤ S
theorem compress_of_loaded {F : FieldPresentation K} {r : FieldNames} (M : FieldMacros F r)
    (q : RNames) (cn : CNames) {n : ℕ} (d : ℕ) (rows : List (DenseInput n d K)) {B S : ℕ}
    {σ : Env} (hL : Loaded F r q cn d rows σ) (hP : Pre F r q cn B S σ) :
    ∃ τ, Run B (compressCom M q cn) σ τ (compressCost M q cn (boxSize n d) rows.length) ∧
      Slots F r q.WS S B τ ∧ τ.vars cn.cc = (compress rows).1.length ∧
      (compress rows).1 = chosenOf (val F r q.WS τ) (boxSize n d) (τ.vars cn.cc) ∧
      (∀ s < S, (s = 0 ∨ inStart (boxSize n d) 0 ≤ s) → val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ∉ movingC q cn → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  obtain ⟨hN, hR, hin⟩ := hL
  obtain ⟨hS, hz, hq, hc, hRB, hfit⟩ := hP
  rw [hN, hR] at hfit
  rw [hR] at hRB
  exact compress_run M q hq cn hc hS rows hN hR hfit hz hRB hin
end Mathproof.Problem18ClaudeIMPLoaded20261001
