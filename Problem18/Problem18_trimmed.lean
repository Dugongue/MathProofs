    (htr : (Algebra.traceForm K E).Nondegenerate)
    (t : E) (ht : φ t=t) (hgen : Algebra.adjoin K ({t}:Set E)=⊤)
    (B : V →ₗ⋆[K] V →ₗ[K] K) (hB : B.IsSymm) (hnB : B.SeparatingLeft) :
    Function.Surjective (incidenceMap φ hc t ht B) := by
  intro se
  let e := se.2.val
  let C : E →ₗ⋆[K] E →ₗ[K] K := (B.comp e.toLinearMap).compl₂ e.toLinearMap
  have hCs : C.IsSymm := by
    constructor
    intro x y
    exact hB.eq (e x) (e y)
  have hCn : C.SeparatingLeft := by
    intro x hx
    apply e.injective
    rw [map_zero]
    apply hnB
    intro y
    obtain ⟨y,rfl⟩ := e.surjective y
    exact hx y
  have hCb : ∀ z x y,C (z*x) y=C x (φ z*y) := by
    apply twisted_balanced_of_generator φ hc C t hgen
    intro x y
    change B (e (t*x)) (e y)=B (e x) (e (φ t*y))
    rw [ht,se.2.property,se.2.property]
    exact se.1.property.2 _ _
