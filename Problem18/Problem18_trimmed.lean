theorem ordinary_error_small (q b : ℝ) (hq : 2≤q) (hb : 1≤b)
    (t c D j : ℕ) (ht : 1≤t) (hlog : Real.log b≤t)
    (hc : 512*t≤ c) (hD : 64*t≤D) (hj : j≤8*t) :
    64/q^(c/4)+(20*(j:ℝ))/q^D≤Real.exp (-3*Real.log b) := by
  have hq0 : 0<q := by linarith
  have hq1 : 1≤q := by linarith
