namespace Mathproof.Problem18DeterministicCyclicSweep20261001
open Polynomial
open Problem18VectorAnnihilator20261001
open Problem18CyclicPrimaryVectors20260930 Problem18KrylovBoundary20260930
open Problem18PfaffianSimplePrimary20260930
variable {K : Type*} [Field K] [DecidableEq K] {n : ℕ}
theorem product_reassociate (d h u k : K[X]) : (h*u)*(d*k)=(d*h)*(u*k) := by
  ac_rfl
noncomputable def monicGcd (f g : K[X]) : K[X] := normalize (EuclideanDomain.gcd f g)
theorem monicGcd_eq (f g : K[X]) : monicGcd f g=GCDMonoid.gcd f g := by
  symm
  exact gcd_eq_normalize
    (EuclideanDomain.dvd_gcd (gcd_dvd_left _ _) (gcd_dvd_right _ _))
    (dvd_gcd (EuclideanDomain.gcd_dvd_left _ _) (EuclideanDomain.gcd_dvd_right _ _))
noncomputable def newFactor (f g : K[X]) : K[X] := g/monicGcd f g
theorem newFactor_monic {f g : K[X]} (hg:g.Monic) : (newFactor f g).Monic := by
  have hd : (monicGcd f g).Monic := by
    rw [monicGcd_eq]
    simpa only [normalize_gcd] using monic_normalize (gcd_ne_zero_of_right hg.ne_zero)
  apply hd.of_mul_monic_left
  unfold newFactor
  rw [EuclideanDomain.mul_div_cancel' hd.ne_zero (by rw [monicGcd_eq]; exact gcd_dvd_right _ _)]
  exact hg
theorem newFactor_dvd_iff {f g p : K[X]} (hg:g≠0) : newFactor f g∣p ↔ g∣p*f := by
  rw [newFactor,monicGcd_eq]
  let d:=GCDMonoid.gcd f g
  have hd:d≠0:=gcd_ne_zero_of_right hg
  have hdf:d*(f/d)=f:=EuclideanDomain.mul_div_cancel' hd (gcd_dvd_left _ _)
  have hdg:d*(g/d)=g:=EuclideanDomain.mul_div_cancel' hd (gcd_dvd_right _ _)
  have hc:IsCoprime (g/d) (f/d):=(isCoprime_div_gcd_div_gcd hg).symm
  change g/d∣p ↔ g∣p*f
  constructor
  · intro hp
    rw [←hdg,←hdf]
    obtain ⟨u,hu⟩:=hp
    refine ⟨u*(f/d),?_⟩
    rw [hu]
    exact product_reassociate d (g/d) u (f/d)
  · intro hp
    apply hc.dvd_of_dvd_mul_right
    apply (mul_dvd_mul_iff_left hd).mp
    rw [hdg]
    have he : d*(p*(f/d))=p*f := by
      calc
        _=p*(d*(f/d)):=by ring
        _=p*f:=by rw [hdf]
    simpa only [he] using hp
theorem newFactor_coprime {f g χ : K[X]} (hs:Squarefree χ) (hf:f∣χ) (hg:g∣χ)
    (hg0:g≠0) : IsCoprime f (newFactor f g) := by
  rw [newFactor,monicGcd_eq]
  let d:=GCDMonoid.gcd f g
  have hd:d≠0:=gcd_ne_zero_of_right hg0
  have hdf:d*(f/d)=f:=EuclideanDomain.mul_div_cancel' hd (gcd_dvd_left _ _)
  have hdg:d*(g/d)=g:=EuclideanDomain.mul_div_cancel' hd (gcd_dvd_right _ _)
  have hsq:Squarefree (d*(g/d)):=by
    rw [hdg]
    exact hs.squarefree_of_dvd hg
  have hdh:IsCoprime d (g/d):=isRelPrime_iff_isCoprime.mp (squarefree_mul_iff.mp hsq).1
  have hch:IsCoprime (f/d) (g/d):=isCoprime_div_gcd_div_gcd hg0
  have hc : IsCoprime (d*(f/d)) (g/d):=hdh.mul_left hch
  rwa [hdf] at hc
theorem annihilator_action (S : Module.End K (Fin n→K)) (z : Fin n→K) {g:K[X]}
    (hg:IsVectorAnnihilator S z g) (f:K[X]) :
    IsVectorAnnihilator S ((aeval S f) z) (newFactor f g) := by
  refine ⟨newFactor_monic hg.1,?_⟩
  intro p
  rw [←Module.End.mul_apply,←map_mul,hg.2,newFactor_dvd_iff hg.1.ne_zero]
theorem eval_comm_apply (S : Module.End K (Fin n→K)) (p q:K[X]) (z:Fin n→K) :
    (aeval S p) ((aeval S q) z)=(aeval S q) ((aeval S p) z) := by
  rw [←Module.End.mul_apply,←map_mul,mul_comm,map_mul,Module.End.mul_apply]
theorem annihilator_coprime_add (S : Module.End K (Fin n→K)) (v w:Fin n→K)
    {f h:K[X]} (hf:IsVectorAnnihilator S v f) (hh:IsVectorAnnihilator S w h)
    (hc:IsCoprime f h) : IsVectorAnnihilator S (v+w) (f*h) := by
  have hfv:(aeval S f) v=0:=(hf.2 f).mpr (dvd_refl _)
  have hhw:(aeval S h) w=0:=(hh.2 h).mpr (dvd_refl _)
  obtain ⟨a,b,hab⟩:=hc
  have hv:(aeval S (b*h)) (v+w)=v := by
    have he:=congrArg (fun p:K[X]=>(aeval S p) v) hab
    simp only [map_add,map_mul,map_one,LinearMap.add_apply,Module.End.mul_apply,
      Module.End.one_apply,hfv,map_zero,zero_add] at he
    simp only [map_add,map_mul,LinearMap.add_apply,Module.End.mul_apply,hhw,map_zero,add_zero]
    exact he
  have hw:(aeval S (a*f)) (v+w)=w := by
    have he:=congrArg (fun p:K[X]=>(aeval S p) w) hab
    simp only [map_add,map_mul,map_one,LinearMap.add_apply,Module.End.mul_apply,
      Module.End.one_apply,hhw,map_zero,add_zero] at he
    simp only [map_add,map_mul,LinearMap.add_apply,Module.End.mul_apply,hfv,map_zero,zero_add]
    exact he
  refine ⟨hf.1.mul hh.1,fun p=>⟨?_,?_⟩⟩
  · intro hp
    apply (show IsCoprime f h from ⟨a,b,hab⟩).mul_dvd
    · apply (hf.2 p).mp
      rw [←hv,eval_comm_apply,hp,map_zero]
    · apply (hh.2 p).mp
      rw [←hw,eval_comm_apply,hp,map_zero]
  · intro hp
    have hpv:=(hf.2 p).mpr ((dvd_mul_right f h).trans hp)
    have hpw:=(hh.2 p).mpr ((dvd_mul_left h f).trans hp)
    simp only [map_add,hpv,hpw,add_zero]
noncomputable def update (S : Module.End K (Fin n→K)) (z:Fin n→K)
    (state:(Fin n→K)×K[X]) : (Fin n→K)×K[X] :=
  let g:=vectorAnnihilator S z
  (state.1+(aeval S state.2) z,state.2*newFactor state.2 g)
theorem update_correct (S : Module.End K (Fin n→K)) (hs:Squarefree S.charpoly)
    (z v:Fin n→K) (f:K[X]) (hf:IsVectorAnnihilator S v f) :
    IsVectorAnnihilator S (update S z (v,f)).1 (update S z (v,f)).2 ∧
      f∣(update S z (v,f)).2 ∧ vectorAnnihilator S z∣(update S z (v,f)).2 := by
  have hg:=vectorAnnihilator_correct S z
  have hfc:f∣S.charpoly:=(hf.2 _).mp (by rw [S.aeval_self_charpoly]; rfl)
  have hgc:vectorAnnihilator S z∣S.charpoly:=(hg.2 _).mp (by rw [S.aeval_self_charpoly]; rfl)
  have hc:=newFactor_coprime hs hfc hgc hg.1.ne_zero
  refine ⟨annihilator_coprime_add S v _ hf (annihilator_action S z hg f) hc,dvd_mul_right _ _,?_⟩
  change vectorAnnihilator S z∣f*newFactor f (vectorAnnihilator S z)
  rw [mul_comm]
  exact (newFactor_dvd_iff hg.1.ne_zero).mp (dvd_refl _)
noncomputable def sweep (S : Module.End K (Fin n→K)) : ℕ→((Fin n→K)×K[X])
  | 0=>(0,1)
  | i+1=>if hi:i < n then update S (Pi.single ⟨i,hi⟩ 1) (sweep S i) else sweep S i
noncomputable def cyclicVector (S : Module.End K (Fin n→K)) : Fin n→K := (sweep S n).1
theorem sweep_invariant (S : Module.End K (Fin n→K)) (hs:Squarefree S.charpoly) (i:ℕ) :
    IsVectorAnnihilator S (sweep S i).1 (sweep S i).2 ∧
      ∀j:Fin n,j.val < i → vectorAnnihilator S (Pi.single j 1)∣(sweep S i).2 := by
  induction i with
  | zero=>
    refine ⟨⟨monic_one,?_⟩,?_⟩
    · intro p
      change (aeval S p) 0=0 ↔ (1:K[X])∣p
      simp only [map_zero,one_dvd,iff_true]
    · intro j hj; omega
  | succ i ih=>
    by_cases hi:i < n
    · rw [sweep,dif_pos hi]
      have hu:=update_correct S hs (Pi.single ⟨i,hi⟩ 1) (sweep S i).1 (sweep S i).2 ih.1
      refine ⟨hu.1,?_⟩
      intro j hj
      by_cases hji:j.val < i
      · exact (ih.2 j hji).trans hu.2.1
      · have he:j=⟨i,hi⟩:=Fin.ext (by change j.val=i; omega)
        simpa only [he] using hu.2.2
    · rw [sweep,dif_neg hi]
      exact ⟨ih.1,fun j _=>ih.2 j (by omega)⟩
theorem final_annihilates_operator (S : Module.End K (Fin n→K)) (hs:Squarefree S.charpoly) :
    aeval S (sweep S n).2=0 := by
  apply (Pi.basisFun K (Fin n)).ext
  intro j
  have hj:=(vectorAnnihilator_correct S (Pi.single j 1)).2 (sweep S n).2
  have he:=hj.mpr ((sweep_invariant S hs n).2 j j.isLt)
  simpa only [Pi.basisFun_apply,LinearMap.zero_apply] using he
theorem newFactor_dvd_right {f g:K[X]} (hg:g≠0) : newFactor f g∣g := by
  have hd:monicGcd f g≠0:=by rw [monicGcd_eq]; exact gcd_ne_zero_of_right hg
  refine ⟨monicGcd f g,?_⟩
  rw [mul_comm]
  exact (EuclideanDomain.mul_div_cancel' hd (by rw [monicGcd_eq]; exact gcd_dvd_right _ _)).symm
theorem update_degree_le (S : Module.End K (Fin n→K)) (z:Fin n→K)
    (s:(Fin n→K)×K[X]) : (update S z s).2.natDegree ≤ s.2.natDegree+n := by
  have hg:=vectorAnnihilator_correct S z
  have hd: (newFactor s.2 (vectorAnnihilator S z)).natDegree ≤ n :=
    (natDegree_le_of_dvd (newFactor_dvd_right hg.1.ne_zero) hg.1.ne_zero).trans
      (vectorAnnihilator_degree_le S z)
  exact natDegree_mul_le.trans (Nat.add_le_add_left hd _)
theorem sweep_degree_le (S : Module.End K (Fin n→K)) (i:ℕ) :
    (sweep S i).2.natDegree ≤ i*n := by
  induction i with
  | zero=>simp [sweep]
  | succ i ih=>
    rw [sweep]
    split_ifs with hi
    · exact (update_degree_le S _ _).trans (by nlinarith)
    · exact ih.trans (by nlinarith)
section FiniteField
variable [Fintype K]
theorem exists_cyclic_of_squarefree (S : Module.End K (Fin n→K)) (hs:Squarefree S.charpoly) :
    ∃z,PolynomiallyCyclic S z := by
  classical
  have h:=Problem18UniversalCyclicDensity20260930.squarefree_cyclic_fraction_polynomial S hs
  have hp:0<(Nat.card {z:Fin n→K // PolynomiallyCyclic S z}:ℝ)/(Nat.card (Fin n→K):ℝ):=
    lt_of_lt_of_le (by positivity) h
  have hn:0<Nat.card {z:Fin n→K // PolynomiallyCyclic S z}:=by
    by_contra hn
    have hz:Nat.card {z:Fin n→K // PolynomiallyCyclic S z}=0:=by omega
    simp only [hz,Nat.cast_zero,zero_div,lt_self_iff_false] at hp
  obtain ⟨z,hz⟩ := Classical.choice (Nat.card_pos_iff.mp hn).1
  exact ⟨z,hz⟩
theorem final_polynomial_eq_charpoly (S : Module.End K (Fin n→K)) (hs:Squarefree S.charpoly) :
    (sweep S n).2=S.charpoly := by
  have hf:=(sweep_invariant S hs n).1
  have hfc:(sweep S n).2∣S.charpoly:=(hf.2 _).mp (by rw [S.aeval_self_charpoly]; rfl)
  obtain ⟨z,hz⟩:=exists_cyclic_of_squarefree S hs
  have hcf:S.charpoly∣(sweep S n).2:=by
    let p:K[X]:=(sweep S n).2
    have hd:p %ₘ S.charpoly∈Polynomial.degreeLT K (Module.finrank K (Fin n→K)):=by
      rw [Polynomial.mem_degreeLT]
      simpa only [degree_eq_natDegree S.charpoly_monic.ne_zero,S.charpoly_natDegree] using
        degree_modByMonic_lt p S.charpoly_monic
    let r:Polynomial.degreeLT K (Module.finrank K (Fin n→K)):=⟨p %ₘ S.charpoly,hd⟩
    have hr:cyclicEvalMap S z (Module.finrank K (Fin n→K)) r=
        cyclicEvalMap S z (Module.finrank K (Fin n→K)) 0:=by
      change (aeval S (p %ₘ S.charpoly)) z=(aeval S 0) z
      rw [aeval_modByMonic_eq_self_of_root S.aeval_self_charpoly,
        show aeval S p=0 from final_annihilates_operator S hs,map_zero]
    have he:=((polynomiallyCyclic_iff_cyclicEvalMap_bijective S z).mp hz).injective hr
    apply (modByMonic_eq_zero_iff_dvd S.charpoly_monic).mp
    exact congrArg Subtype.val he
  exact dvd_antisymm_of_normalize_eq hf.1.normalize_eq_self S.charpoly_monic.normalize_eq_self hfc hcf
theorem cyclicVector_correct (S : Module.End K (Fin n→K)) (hs:Squarefree S.charpoly) :
    PolynomiallyCyclic S (cyclicVector S) := by
  have hf:=(sweep_invariant S hs n).1
  rw [final_polynomial_eq_charpoly S hs] at hf
  rw [polynomiallyCyclic_iff_cyclicEvalMap_surjective]
  have hdim : Module.finrank K (Polynomial.degreeLT K (Module.finrank K (Fin n→K)))=
      Module.finrank K (Fin n→K) := by
    rw [Module.finrank_eq_card_basis (Polynomial.degreeLT.basis K _),Fintype.card_fin]
  apply (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).mp
  intro p q he
  apply Subtype.ext
  apply sub_eq_zero.mp
  have hz:(aeval S (p.val-q.val)) (cyclicVector S)=0 := by
    simp only [map_sub,LinearMap.sub_apply]
    exact sub_eq_zero.mpr he
  apply eq_zero_of_dvd_of_degree_lt ((hf.2 _).mp hz)
  have hd: (p.val-q.val).degree<Module.finrank K (Fin n→K):=
    Polynomial.mem_degreeLT.mp (p-q).property
  simpa only [degree_eq_natDegree S.charpoly_monic.ne_zero,S.charpoly_natDegree] using hd
end FiniteField
end Mathproof.Problem18DeterministicCyclicSweep20261001
end
