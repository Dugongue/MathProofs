    Mathproof.Problem18CharTwoCanonicalCyclic20260930.canonical_polynomiallyCyclic
      S B hB.isRefl hnB hS hs (0:V) (by intro x; simp [ha.self_eq_zero])
  obtain ⟨x,hx⟩ := exists_ne (0:V)
  obtain ⟨p,hp⟩ := hz x
  exact hx (by simpa only [map_zero] using hp.symm)
