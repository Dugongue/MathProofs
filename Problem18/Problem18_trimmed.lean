  conv_rhs => rw [← decode_coordinates F (A k (gramIndex rfl y))]
  apply congrArg (decode F)
  funext z
  unfold slice Problem18IMPMatrixMemory20261001.address
  have hy := gramIndex_val (rfl : a*b = a*b) y
  set i := (gramIndex (rfl : a*b = a*b) y).1
  set s := (gramIndex (rfl : a*b = a*b) y).2
