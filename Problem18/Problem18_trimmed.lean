namespace Mathproof.Problem18RootParserBounds20261001
open BitstringEncoding Problem18RootParser20261001
theorem decoded_blocks_le_fuel (fuel : ℕ) (input : List Bool) (blocks : List (List Bool))
    (h : undelimitBlocksAux fuel input=some blocks) : blocks.length≤fuel := by
  induction fuel generalizing input blocks with
  | zero =>
    cases input with
    | nil => simp only [undelimitBlocksAux,Option.some.injEq] at h; subst blocks; simp
    | cons b bs => simp only [undelimitBlocksAux] at h; contradiction
  | succ fuel ih =>
    cases input with
    | nil => simp only [undelimitBlocksAux,Option.some.injEq] at h; subst blocks; simp
    | cons b bs =>
      change ((undelimit (b::bs)).bind fun p=>(undelimitBlocksAux fuel p.2).map (p.1::·))=some blocks at h
      obtain ⟨⟨p,r⟩,_,hr⟩:=Option.bind_eq_some_iff.mp h
      obtain ⟨rest,hrest,he⟩:=Option.map_eq_some_iff.mp hr
      subst blocks
      have hh:=ih r rest hrest
      simpa only [List.length_cons] using Nat.succ_le_succ hh
theorem natural_blocks_decode (blocks : List (List Bool)) :
    blocks.mapM (bitDecode : List Bool→Option ℕ)=some (blocks.map Computability.decodeNat) := by
  induction blocks with
  | nil => rfl
  | cons b bs ih =>
    simp only [List.mapM_cons,ih,List.map_cons]
    rfl
theorem decoded_numbers_length (input : List Bool) (xs : List ℕ)
    (h : bitDecode input=some xs) : xs.length ≤ input.length := by
  change ((undelimitBlocks input).bind fun blocks=>blocks.mapM (bitDecode : List Bool→Option ℕ))=some xs at h
  obtain ⟨blocks,hb,hx⟩:=Option.bind_eq_some_iff.mp h
  rw [natural_blocks_decode,Option.some.injEq] at hx
  subst xs
  simpa only [List.length_map] using decoded_blocks_le_fuel input.length input blocks hb
theorem parsed_payload_length (xs : List ℕ) (d : ParsedInput) (h : parseNumbers xs=some d) :
    d.data.length≤xs.length := by
  unfold parseNumbers at h
  split at h
  · dsimp only at h
    split_ifs at h with hv
    · cases h
      simp only [List.length_cons]
      omega
  · contradiction
theorem parsed_allocation_bound (input : List Bool) (d : ParsedInput) (h : parseBits input=some d) :
    d.e ≤ input.length ∧ d.a*d.b*d.c*d.e ≤ input.length := by
  obtain ⟨xs,hx,hd⟩:=Option.bind_eq_some_iff.mp h
  have hb:=(parsed_payload_length xs d hd).trans (decoded_numbers_length input xs hx)
  have hv:=valid_allocation_bound d (parseNumbers_valid xs d hd)
  exact ⟨hv.1.trans hb,hv.2.trans hb⟩
end Mathproof.Problem18RootParserBounds20261001
end
