namespace Mathproof.Problem18SolverDegreeProfile20261001
open MvPolynomial
open Mathproof.Problem18AllFormatRoot20260930
open Mathproof.Problem18MacaulayAlgorithm20260930
open Mathproof.Problem18PolynomialCompression20261001
open Mathproof.Problem18GeometricEmptinessAlgorithm20260930
open Mathproof.Problem18SmallFieldEnumeration20261001
open Mathproof.Problem18BinaryPower20260930
open Mathproof.Problem18PresentationSize20260930
open Mathproof.Problem18ClaudeSolverAssembly20261001
open Problem18ArrayElimination20260929
structure FormatProfile where
  childDegree : Nat → Nat
  pointThreshold : Nat → Nat
  fixedBudget : Nat → Nat → Nat
  childBudget : Nat → Nat → Nat
  childRows : Nat → Nat → Nat
  fixedBudget_mono : ∀ d r r', r ≤ r' → fixedBudget d r ≤ fixedBudget d r'
  childBudget_mono : ∀ d r r', r ≤ r' → childBudget d r ≤ childBudget d r'
  childRows_mono : ∀ d r r', r ≤ r' → childRows d r ≤ childRows d r'
def threshold (P : FormatProfile) : Nat → Nat → Nat
  | 0, _ => 0
  | l + 1, d => max (P.pointThreshold d) (threshold P l (P.childDegree d))
theorem pointThreshold_le (P : FormatProfile) (l d : Nat) :
    P.pointThreshold d ≤ threshold P (l + 1) d := le_max_left _ _
theorem childThreshold_le (P : FormatProfile) (l d : Nat) :
    threshold P l (P.childDegree d) ≤ threshold P (l + 1) d := le_max_right _ _
variable {K : Type} [Field K] [DecidableEq K] [Fintype K]
variable {L : Type} [Field L] [Algebra K L] [IsAlgClosed L] [Algebra.IsAlgebraic K L]
structure Services (n : Nat) (P : FormatProfile) where
  fixedTest : (d : Nat) → List (DenseInput n d K) → Bool × Nat
  child : (d : Nat) → List (DenseInput n d K) →
    List (DenseInput n (P.childDegree d) K) × Nat
  fixedTest_correct : ∀ d rows fs, Represents rows fs →
    ((fixedTest d rows).1 = true ↔ HasFixedComponent L fs)
  child_spec : ∀ d rows fs, Represents rows fs → ¬ HasFixedComponent L fs →
    ∃ gs, Represents (child d rows).1 gs ∧
      (∀ x : Fin n → K, (∀ f ∈ fs, eval x f = 0) ↔ ∀ g ∈ gs, eval x g = 0) ∧
      geomDim L gs + 1 ≤ geomDim L fs
  pointExistence : ∀ (d : Nat) (rows : List (DenseInput n d K)) fs, Represents rows fs →
    P.pointThreshold d < Fintype.card K → HasFixedComponent L fs →
      ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0
  fixedTest_cost : ∀ d rows,
    (fixedTest d rows).2 ≤ P.fixedBudget d rows.length * (Nat.size (Fintype.card K) + 1)
  child_cost : ∀ d rows, (child d rows).2 ≤
    P.childBudget d rows.length * (Nat.size (Fintype.card K) + 1)
  child_length : ∀ d rows, (child d rows).1.length ≤ P.childRows d rows.length
def solve {n : Nat} {P : FormatProfile} (B : Services (K := K) (L := L) n P) :
    Nat → (d : Nat) → List (DenseInput n d K) → Bool × Nat
  | 0, _, _ => (false, 0)
  | l + 1, d, rows =>
    let g := geometricFeasible d rows
    if g.1 = false then (false, g.2)
    else
      let h := B.fixedTest d rows
      if h.1 = true then (true, g.2 + h.2)
      else
        let c := B.child d rows
        let r := solve B l (P.childDegree d) c.1
        (r.1, g.2 + h.2 + c.2 + r.2)
theorem solve_correct {n : Nat} {P : FormatProfile} (B : Services (K := K) (L := L) n P) :
    ∀ l d rows fs, Represents rows fs →
      threshold P l d < Fintype.card K → geomDim L fs + 1 ≤ (l : WithBot ℕ∞) →
      ((solve B l d rows).1 = true ↔ ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0) := by
  intro l
  induction l with
  | zero =>
    intro d rows fs hrep hq hdim
    simp only [solve, Bool.false_eq_true, false_iff, not_exists]
    exact fun x => no_rational_of_dim_bot L fs (by simpa using hdim) x
  | succ l ih =>
    intro d rows fs hrep hq hdim
    cases hg : (geometricFeasible d rows).1 with
    | false =>
      simp only [solve, hg, if_true, Bool.false_eq_true, false_iff, not_exists]
      exact fun x => no_rational_of_infeasible L rows fs hrep hg x
    | true =>
      cases hf : (B.fixedTest d rows).1 with
      | true =>
        simp only [solve, hg, hf, Bool.true_eq_false, if_false, if_true, true_iff]
        exact B.pointExistence d rows fs hrep
          (lt_of_le_of_lt (pointThreshold_le P l d) hq)
          ((B.fixedTest_correct d rows fs hrep).mp hf)
      | false =>
        simp only [solve, hg, hf, Bool.true_eq_false, Bool.false_eq_true, if_false]
        have hno : ¬ HasFixedComponent L fs := fun h => by
          have := (B.fixedTest_correct d rows fs hrep).mpr h
          rw [hf] at this
          exact Bool.false_ne_true this
        obtain ⟨gs, hgs, hiff, hdim'⟩ := B.child_spec d rows fs hrep hno
        have hdim'' : geomDim L gs + 1 ≤ (l : WithBot ℕ∞) :=
          hdim'.trans (le_of_add_one_le_succ hdim)
        rw [ih (P.childDegree d) (B.child d rows).1 gs hgs
          (lt_of_le_of_lt (childThreshold_le P l d) hq) hdim'']
        exact exists_congr fun x => (hiff x).symm
def decideSystem {n : Nat} {P : FormatProfile} (B : Services (K := K) (L := L) n P)
    (F : FieldPresentation K) (d : Nat) (rows : List (DenseInput n d K)) : Bool × Nat :=
  let q := binaryPower F.p F.e
  if q.1 ≤ threshold P (n + 1) d then
    let s := smallFieldDecide F rows
    (s.1, q.2 + s.2)
  else
    let s := solve B (n + 1) d rows
    (s.1, q.2 + s.2)
theorem decideSystem_correct {n : Nat} {P : FormatProfile}
    (B : Services (K := K) (L := L) n P) (F : FieldPresentation K)
    (d : Nat) (rows : List (DenseInput n d K)) fs (hrep : Represents rows fs) :
    (decideSystem B F d rows).1 = true ↔
      ∃ x : Fin n → K, ∀ v ∈ rows, denseEval x (read v) = 0 := by
  simp only [decideSystem, binaryPower_correct]
  split_ifs with hsmall
  · exact smallFieldDecide_correct F rows
  · have hq : threshold P (n + 1) d < Fintype.card K := by
      rw [presentation_card F]
      exact Nat.lt_of_not_le hsmall
    rw [solve_correct B (n + 1) d rows fs hrep hq (geomDim_le L fs)]
    exact exists_congr fun x => (represents_eval_iff hrep x).symm
def workBound (P : FormatProfile) (n s : Nat) : Nat → Nat → Nat → Nat
  | 0, _, _ => 0
  | l + 1, d, r =>
    feasBudget n d r + P.fixedBudget d r * s + P.childBudget d r * s +
      workBound P n s l (P.childDegree d) (P.childRows d r)
end Mathproof.Problem18SolverDegreeProfile20261001
end
