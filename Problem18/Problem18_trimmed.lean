theorem ann_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (a : AMNames)
    (ha : a.Valid r q) {B Sn : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ) {dv Nv sv ov : ℕ}
