      exact ⟨σ,by simpa only [iterations,Nat.zero_mul,Nat.zero_add] using
        (Run.skip (B:=B) (σ:=σ)),by simpa using h,rfl,rfl⟩
  | succ k ih =>
      obtain ⟨ρ,hr,hρ,hri,hro⟩:=ih h (by omega)
      have hi : i+k<n := by omega
      obtain ⟨τ,hs,hτ,hsi,hso⟩:=
        Problem18IMPBoundarySweepStep20261002.step_run F hρ hi hb
      refine ⟨τ,?_,?_,hsi.trans hri,hso.trans hro⟩
      · simpa only [iterations,Nat.succ_mul,Nat.add_assoc,Nat.add_comm,
          Nat.add_left_comm] using hr.seq hs
      · simpa only [Nat.add_assoc] using hτ
