    (by decide) (.var Problem18IMPBoundaryBanks20261002.table) (.var seedReg)
    (by simp [Problem18ClaudeIMPAxpy20261001.VarsIn]) (by simp [Problem18ClaudeIMPAxpy20261001.VarsIn]) hz
    (by apply evalVar;exact (hvζ _ (by decide)).trans htable;pomega)
    (by apply evalVar;simp [ζ];pomega)
    ((hvζ _ (by decide)).trans hgN) hdfit (by pomega) (Or.inr hsep)
  change Run B copyProgram ζ ρ _ at hcopy
  have hvρ (x : String) (hx:x∉regNames canonical) (hxseed:x≠seedReg) (hxj:x≠gauss.j) :
      ρ.vars x=ξ.vars x := (hvars x hx hxj).trans (hvζ x hxseed)
  have hmodρ : ρ.vars canonical.modBase=0 := by
    rw [(run_frame hcopy).1 _ (by decide),hvζ _ (by decide)]
    exact hmd.trans hmod
  have hwsρ : ρ.vars gauss.WS=F.e+1 := (hvρ _ (by decide) (by decide) (by decide)).trans hws
  have hlenρ : (ρ.arrs canonical.mem).length=F.e+1+slots n*F.e := by
