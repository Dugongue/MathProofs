def capacity (n : Nat) := n*n+n+1
def scratchEnd (n : Nat) := 20+(n+2)*maxLength n+(5+4*capacity n)+rowStart (3*capacity n) (capacity n)
def first (n : Nat) := scratchEnd n
def factor (n : Nat) := first n+capacity n
def divisor (n : Nat) := factor n+capacity n
def candidate (n : Nat) := divisor n+capacity n
def seed (n : Nat) := candidate n+n
def matrix (n : Nat) := seed n+n
def action (n : Nat) := matrix n+n*n
def temp (n : Nat) := action n+n
def product (n : Nat) := temp n+n
def productWork (n : Nat) := product n+3*capacity n
def orbit (n : Nat) := productWork n+3
def orbitWork (n : Nat) := orbit n+(n+1)*n
def slots (n : Nat) := orbitWork n+3
theorem allocation (n : Nat) :
    n<capacity n ∧ 6 ≤ first n ∧
    5+4*capacity n ≤ first n ∧ rowStart (3*capacity n) (capacity n) ≤ first n ∧
    (n+2)*maxLength n ≤ first n ∧
    first n+capacity n=factor n ∧ factor n+capacity n=divisor n ∧
    divisor n+capacity n=candidate n ∧ candidate n+n=seed n ∧ seed n+n=matrix n ∧
    matrix n+n*n=action n ∧ action n+n=temp n ∧ temp n+n=product n ∧
    product n+3*capacity n=productWork n ∧ productWork n+3=orbit n ∧
    orbit n+(n+1)*n=orbitWork n ∧ orbitWork n+3=slots n := by
  simp only [capacity,first,factor,divisor,candidate,seed,matrix,action,temp,product,productWork,orbit,orbitWork,slots,scratchEnd]
  repeat' apply And.intro
  all_goals first | rfl | trivial | omega
theorem capacity_pos (n : Nat) : 0<capacity n := by unfold capacity;omega
theorem update_degree_fits {K : Type} [Field K] [DecidableEq K] {n i : Nat}
    (S : Module.End K (Fin n→K)) (hi : i<n) (z : Fin n→K) :
    (Problem18DeterministicCyclicSweep20261001.update S z
      (Problem18DeterministicCyclicSweep20261001.sweep S i)).2.natDegree<capacity n := by
  have hs:=Problem18DeterministicCyclicSweep20261001.sweep_degree_le S i
  have hu:=Problem18DeterministicCyclicSweep20261001.update_degree_le S z
    (Problem18DeterministicCyclicSweep20261001.sweep S i)
  have hm:=Nat.mul_le_mul_right n (Nat.add_one_le_iff.mpr hi)
  unfold capacity
  nlinarith
