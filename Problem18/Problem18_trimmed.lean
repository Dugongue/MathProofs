open Problem18IMPFieldMultiplication20261001 Problem18IMPModularArithmetic20261001
open Problem18AllFormatRoot20260930
def rowCount : String := "P18.rows"
def colCount : String := "P18.cols"
def index : String := "P18.matrix.transposeIndex"
def total : String := "P18.matrix.transposeCells"
def names : FieldNames := {canonical with i:=index,e:=total}
def modExpr' (x y : Expr) : Expr := .sub x (.mul (.div x y) y)
def entryExpr : Expr := .div (.var index) (.var canonical.e)
def sourceExpr : Expr := .get canonical.mem
  (.add (.var canonical.aBase)
    (.add (.mul (.var canonical.e)
      (.add (.mul (modExpr' entryExpr (.var rowCount)) (.var colCount))
        (.div entryExpr (.var rowCount))))
      (modExpr' (.var index) (.var canonical.e))))
def body : Com := .seq (.store canonical.mem (address canonical.outBase index) sourceExpr)
  (.assign index (.add (.var index) (.lit 1)))
def routine : Com := .seq (.assign index (.lit 0))
  (.while (.lt (.var index) (.var total)) body)
def sourceIndex (base e m n j : Nat) : Nat := base+e*((j/e%m)*n+j/e/m)+j%e
def value (σ : Env) (e m n j : Nat) : Nat :=
  (σ.arrs canonical.mem).getD (sourceIndex (σ.vars canonical.aBase) e m n j) 0
def state (σ : Env) (e m n j : Nat) : Env := pointState σ names (value σ e m n) j
theorem sourceIndex_lt {base e m n j : Nat} (he:0<e) (hj:j<e*(m*n)) :
    sourceIndex base e m n j<base+e*(m*n) := by
  have hm : 0 < m := by
    by_contra h
    have hh : m = 0 := by omega
    simp [hh] at hj
  have hd:j/e< m*n:=by apply (Nat.div_lt_iff_lt_mul he).mpr; simpa [Nat.mul_comm] using hj
  have hr:j/e%m< m:=Nat.mod_lt _ hm
  have hc:j/e/m<n:=by apply (Nat.div_lt_iff_lt_mul hm).mpr;simpa [Nat.mul_comm] using hd
  have hi:=Problem18IMPMatrixMemory20261001.index_lt (⟨j/e%m,hr⟩:Fin m) (⟨j/e/m,hc⟩:Fin n)
  have hmul:=Nat.mul_le_mul_left e (Nat.succ_le_of_lt hi)
  have hk:=Nat.mod_lt j he
  unfold sourceIndex
  simp only [Nat.mul_succ] at hmul
  omega
theorem sourceExpr_eval {B e m n j : Nat} {σ : Env}
    (he:σ.vars canonical.e=e) (hm:σ.vars rowCount=m) (hn:σ.vars colCount=n)
    (hj:σ.vars index=j) (hepos:0<e)
    (heB:e<B) (hmB:m<B) (hnB:n<B) (hjB:j<B)
    (haddr:sourceIndex (σ.vars canonical.aBase) e m n j<B)
    {v : Nat} (hread:(σ.arrs canonical.mem)[sourceIndex (σ.vars canonical.aBase) e m n j]?=some v)
    (hv:v<B) : sourceExpr.evalB B σ=some v := by
  have hb:σ.vars canonical.aBase<B:=by unfold sourceIndex at haddr;omega
  have hx:j/e<B:=(Nat.div_le_self j e).trans_lt hjB
  have hy:j/e/m<B:=(Nat.div_le_self (j/e) m).trans_lt hx
  have hf:e*((j/e%m)*n+j/e/m)<B:=by unfold sourceIndex at haddr;omega
  have hs:(j/e%m)*n+j/e/m<B:=by nlinarith only [hf,hepos]
  have hp:(j/e%m)*n<B:= (Nat.le_add_right ((j/e%m)*n) (j/e/m)).trans_lt hs
  have hd:e*((j/e%m)*n+j/e/m)+j%e<B:=by unfold sourceIndex at haddr;omega
  have ee:(Expr.var canonical.e).evalB B σ=some e:=by simpa only [he] using (evalB_var (σ:=σ) (x:=canonical.e) (by rw [he];exact heB))
  have em:(Expr.var rowCount).evalB B σ=some m:=by simpa only [hm] using (evalB_var (σ:=σ) (x:=rowCount) (by rw [hm];exact hmB))
  have en:(Expr.var colCount).evalB B σ=some n:=by simpa only [hn] using (evalB_var (σ:=σ) (x:=colCount) (by rw [hn];exact hnB))
  have ej:(Expr.var index).evalB B σ=some j:=by simpa only [hj] using (evalB_var (σ:=σ) (x:=index) (by rw [hj];exact hjB))
  have ex:entryExpr.evalB B σ=some (j/e):=evalB_bin (op:=.div) ej ee hx
  have er:(modExpr' entryExpr (.var rowCount)).evalB B σ=some (j/e%m):=modExpr_evalB ex em
  have ec:(Expr.div entryExpr (.var rowCount)).evalB B σ=some (j/e/m):=evalB_bin (op:=.div) ex em hy
  have ep:=evalB_bin (op:=Bop.mul) er en (by change (j/e%m)*n<B;exact hp)
  have es:=evalB_bin (op:=Bop.add) ep ec (by change (j/e%m)*n+j/e/m<B;exact hs)
  have ef:=evalB_bin (op:=Bop.mul) ee es (by change e*((j/e%m)*n+j/e/m)<B;exact hf)
  have ek:(modExpr' (.var index) (.var canonical.e)).evalB B σ=some (j%e):=modExpr_evalB ej ee
  have ed:=evalB_bin (op:=Bop.add) ef ek (by change e*((j/e%m)*n+j/e/m)+j%e<B;exact hd)
  have ea:=evalB_bin (op:=Bop.add) (evalB_var (σ:=σ) (x:=canonical.aBase) hb) ed
    (by change σ.vars canonical.aBase+(e*((j/e%m)*n+j/e/m)+j%e)<B
        simpa only [sourceIndex,Nat.add_assoc] using haddr)
  apply evalB_get ea
  · simpa only [sourceIndex,Nat.add_assoc,Bop.apply] using hread
  · exact hv
theorem body_run {B e m n j : Nat} (σ : Env)
    (he:σ.vars canonical.e=e) (hm:σ.vars rowCount=m) (hn:σ.vars colCount=n)
    (hepos:0<e) (heB:e<B) (hmB:m<B) (hnB:n<B) (hNB:e*(m*n)<B)
    (hin:σ.vars canonical.aBase+e*(m*n)≤(σ.arrs canonical.mem).length)
    (hout:σ.vars canonical.outBase+e*(m*n)≤(σ.arrs canonical.mem).length)
    (hword:(σ.arrs canonical.mem).length<B)
    (hvalues:∀k<(σ.arrs canonical.mem).length,(σ.arrs canonical.mem).getD k 0<B)
    (hsep:σ.vars canonical.aBase+e*(m*n)≤σ.vars canonical.outBase ∨
      σ.vars canonical.outBase+e*(m*n)≤σ.vars canonical.aBase)
    (hj:j<e*(m*n)) :
    Run B body (state σ e m n j) (state σ e m n (j+1)) 1000 := by
  let ξ:=state σ e m n j
  have reg (x:String) (hx:x≠index) : ξ.vars x=σ.vars x:=by
    simp [ξ,state,pointState,names,hx]
  have hi:ξ.vars index=j:=by simp [ξ,state,pointState,names]
  have hl:(ξ.arrs canonical.mem).length=(σ.arrs canonical.mem).length:=by
    simp [ξ,state,pointState,names,writeValues_length]
  have hb:ξ.vars canonical.aBase=σ.vars canonical.aBase:=reg _ (by decide)
  have ho:ξ.vars canonical.outBase=σ.vars canonical.outBase:=reg _ (by decide)
  have ha:=sourceIndex_lt (base:=σ.vars canonical.aBase) hepos hj
  have hsrc:sourceIndex (σ.vars canonical.aBase) e m n j<(σ.arrs canonical.mem).length:=ha.trans_le hin
  have hsource:(ξ.arrs canonical.mem).getD (sourceIndex (σ.vars canonical.aBase) e m n j) 0=value σ e m n j:=by
    change (writeValues (σ.arrs canonical.mem) (σ.vars canonical.outBase)
      (value σ e m n) j).getD (sourceIndex (σ.vars canonical.aBase) e m n j) 0=_
    apply writeValues_outside _ _ _ _ _ hsrc
    have hbase:σ.vars canonical.aBase ≤ sourceIndex (σ.vars canonical.aBase) e m n j:=by
      unfold sourceIndex;omega
    rcases hsep with hs|hs <;> omega
  have hread:(ξ.arrs canonical.mem)[sourceIndex (ξ.vars canonical.aBase) e m n j]?=
      some (value σ e m n j):=by
    rw [hb,List.getElem?_eq_getElem (by rw [hl];exact hsrc)]
    rw [List.getD_eq_getElem _ _ (by rw [hl];exact hsrc)] at hsource
    exact congrArg some hsource
  have hvB:value σ e m n j<B:=hvalues _ hsrc
  have es:=sourceExpr_eval
    ((reg _ (by decide)).trans he) ((reg _ (by decide)).trans hm)
    ((reg _ (by decide)).trans hn) hi hepos heB hmB hnB (hj.trans hNB)
    (by rw [hb];exact hsrc.trans hword) hread hvB
  have hdest:σ.vars canonical.outBase+j<(σ.arrs canonical.mem).length:=by omega
  have hdestB:σ.vars canonical.outBase+j<B:=hdest.trans hword
  have ed:(address canonical.outBase index).evalB B ξ=some (σ.vars canonical.outBase+j):=by
    exact evalB_bin (op:=Bop.add)
      (by simpa only [ho] using (evalB_var (σ:=ξ) (x:=canonical.outBase) (by rw [ho];omega)))
      (by simpa only [hi] using (evalB_var (σ:=ξ) (x:=index) (by rw [hi];omega))) hdestB
  have hs:=Run.store (a:=canonical.mem) ed es (by rw [hl];exact hdest)
  have einc:(Expr.add (.var index) (.lit 1)).evalB B
      (ξ.setArr canonical.mem (σ.vars canonical.outBase+j) (value σ e m n j))=some (j+1):=by
    apply evalB_bin (op:=Bop.add)
    · simpa only [vars_setArr,hi] using
        (evalB_var (σ:=ξ.setArr canonical.mem (σ.vars canonical.outBase+j) (value σ e m n j))
          (x:=index) (by change ξ.vars index<B;rw [hi];omega))
    · exact evalB_lit (by omega)
    · change j+1<B;omega
  have hr:=hs.seq (Run.assign (x:=index) einc)
  have hnext:((ξ.setArr canonical.mem (σ.vars canonical.outBase+j) (value σ e m n j)).setVar index (j+1))=
      state σ e m n (j+1):=pointState_next σ names (value σ e m n) j
  rw [hnext] at hr
  exact hr.mono (by simp [Expr.size,sourceExpr,entryExpr,modExpr',address])
theorem routine_run {B e m n : Nat} (σ : Env)
    (he:σ.vars canonical.e=e) (hm:σ.vars rowCount=m) (hn:σ.vars colCount=n)
    (hN:σ.vars total=e*(m*n)) (hepos:0<e)
    (heB:e<B) (hmB:m<B) (hnB:n<B) (hNB:e*(m*n)<B)
    (hin:σ.vars canonical.aBase+e*(m*n)≤(σ.arrs canonical.mem).length)
    (hout:σ.vars canonical.outBase+e*(m*n)≤(σ.arrs canonical.mem).length)
    (hword:(σ.arrs canonical.mem).length<B)
    (hvalues:∀k<(σ.arrs canonical.mem).length,(σ.arrs canonical.mem).getD k 0<B)
    (hsep:σ.vars canonical.aBase+e*(m*n)≤σ.vars canonical.outBase ∨
      σ.vars canonical.outBase+e*(m*n)≤σ.vars canonical.aBase) :
    Run B routine σ (state σ e m n (e*(m*n))) (1010*(e*(m*n)+1)) := by
  have hr:=countedLoop_run (B:=B) (n:=e*(m*n)) (cost:=1000) index total body
    (state σ e m n)
    (by intro j _;simp [state,pointState,names])
    (by intro j _;simpa [state,pointState,names,total,index] using hN) hNB
    (fun j hj=>body_run σ he hm hn hepos heB hmB hnB hNB hin hout hword hvalues hsep hj)
  have hz:state σ e m n 0=σ.setVar index 0:=pointState_zero σ names (value σ e m n)
  rw [hz] at hr
  exact ((Run.assign (x:=index) (evalB_lit (by omega))).seq hr).mono
    (by simp only [Expr.size];omega)
theorem sourceIndex_entry {e m n : Nat} (he:0<e) (i:Fin n) (j:Fin m) (k:Fin e) (base:Nat) :
    sourceIndex base e m n (e*(i.val*m+j.val)+k.val)=
      base+e*(j.val*n+i.val)+k.val := by
  have hm:0 < m := Nat.zero_lt_of_lt j.isLt
  have hd:(e*(i.val*m+j.val)+k.val)/e=i.val*m+j.val:=by
    rw [Nat.mul_comm e _,Nat.add_comm,Nat.add_mul_div_right _ _ he,Nat.div_eq_of_lt k.isLt]
    simp
  have hk:(e*(i.val*m+j.val)+k.val)%e=k.val:=by
    rw [Nat.mul_comm e _]
    exact Nat.mul_add_mod_of_lt k.isLt
  have hi:(i.val*m+j.val)/m=i.val:=by
    rw [Nat.add_comm,Nat.add_mul_div_right _ _ hm,Nat.div_eq_of_lt j.isLt]
    simp
  have hj:(i.val*m+j.val)%m=j.val:=Nat.mul_add_mod_of_lt j.isLt
  simp only [sourceIndex,hd,hk,hi,hj]
theorem state_matrix {K : Type} [Field K] (F : FieldPresentation K) (σ : Env) (m n : Nat)
    (hout:σ.vars canonical.outBase+F.e*(m*n)≤(σ.arrs canonical.mem).length) :
    Problem18IMPMatrixMemory20261001.matrix F (state σ F.e m n (F.e*(m*n)))
      (σ.vars canonical.outBase) n m=
      (Problem18IMPMatrixMemory20261001.matrix F σ (σ.vars canonical.aBase) m n).transpose := by
  ext i j
  apply congrArg (Problem18IMPFieldPresentation20261001.decode F)
  funext k
  change (writeValues (σ.arrs canonical.mem) (σ.vars canonical.outBase)
    (value σ F.e m n) (F.e*(m*n))).getD
      (σ.vars canonical.outBase+F.e*(i.val*m+j.val)+k.val) 0=
    (σ.arrs canonical.mem).getD (σ.vars canonical.aBase+F.e*(j.val*n+i.val)+k.val) 0
  have ht:=Problem18IMPMatrixMemory20261001.index_lt i j
  have hh:=Nat.mul_le_mul_left F.e (Nat.succ_le_of_lt ht)
  have hk:=k.isLt
  have hindex:F.e*(i.val*m+j.val)+k.val<F.e*(m*n):=by
    simp only [Nat.mul_succ] at hh
    rw [Nat.mul_comm n m] at hh
    omega
  rw [Nat.add_assoc,writeValues_inside _ _ _ _ _ hout hindex]
  unfold value
  rw [sourceIndex_entry F.degree_pos i j k]
theorem transpose_run {K : Type} [Field K] (F : FieldPresentation K)
    {B m n : Nat} (σ : Env)
    (he:σ.vars canonical.e=F.e) (hm:σ.vars rowCount=m) (hn:σ.vars colCount=n)
    (hN:σ.vars total=F.e*(m*n)) (heB:F.e<B) (hmB:m<B) (hnB:n<B) (hNB:F.e*(m*n)<B)
    (hin:σ.vars canonical.aBase+F.e*(m*n)≤(σ.arrs canonical.mem).length)
    (hout:σ.vars canonical.outBase+F.e*(m*n)≤(σ.arrs canonical.mem).length)
    (hword:(σ.arrs canonical.mem).length<B)
    (hvalues:∀k<(σ.arrs canonical.mem).length,(σ.arrs canonical.mem).getD k 0<B)
    (hsep:σ.vars canonical.aBase+F.e*(m*n)≤σ.vars canonical.outBase ∨
      σ.vars canonical.outBase+F.e*(m*n)≤σ.vars canonical.aBase) :
    ∃τ,Run B routine σ τ (1010*(F.e*(m*n)+1)) ∧
      Problem18IMPMatrixMemory20261001.matrix F τ (σ.vars canonical.outBase) n m=
        (Problem18IMPMatrixMemory20261001.matrix F σ (σ.vars canonical.aBase) m n).transpose ∧
      (∀a,(τ.arrs a).length=(σ.arrs a).length) ∧ τ.inp=σ.inp ∧ τ.out=σ.out := by
  refine ⟨state σ F.e m n (F.e*(m*n)),
    routine_run σ he hm hn hN F.degree_pos heB hmB hnB hNB hin hout hword hvalues hsep,
    state_matrix F σ m n hout,?_,rfl,rfl⟩
  intro a
  by_cases ha : a = canonical.mem <;> simp [state,pointState,names,ha,writeValues_length]
end Mathproof.Problem18IMPMatrixTranspose20261001
