    _ ≤ (degLex.degree f ⊔ degLex.degree g).degree :=
      Finsupp.DegLex.monotone_degree (degLex.degree_sPolynomial_le f g)
    _ ≤ (degLex.degree f + degLex.degree g).degree :=
      Finsupp.degree_mono (sup_le (self_le_add_right _ _) (self_le_add_left _ _))
    _ = _ := by rw [map_add, degree_degLexDegree, degree_degLexDegree]
