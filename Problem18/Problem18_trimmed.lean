  have he : (univ.filter fun i => x i = true).powersetCard j =
      (univ.powersetCard j).filter fun s => ∀ i ∈ s, x i = true := by
    ext s
    simp only [mem_powersetCard, mem_filter, subset_univ, true_and, subset_iff,
      mem_filter, mem_univ, true_and]
    tauto
