  · intro x hx
    apply (run_frame hrun).1 x
    simp [copyGram,copyBody,scalarWrites,hx]
  · exact (run_frame hrun).2.2.2.1 (by simp [copyGram,copyBody,noRead])
  · exact (run_frame hrun).2.2.2.2 (by simp [copyGram,copyBody,Com.NoWrite])
theorem copyGram_valid {B n sourceBase targetBase : Nat} (sigma : Env)
    (hv : ValidMemory F B sigma)
    (hn : n<B) (hcount : sigma.vars copyCount=n)
    (hsource : sigma.vars externalBase=sourceBase)
    (htarget : sigma.vars nativeBase=targetBase)
    (hsourceB : sourceBase+n<B) (htargetB : targetBase+n<B)
    (hfitSource : sourceBase+n≤(sigma.arrs workBank).length)
    (hfitTarget : targetBase+n≤(sigma.arrs canonical.mem).length)
    (hmodsep : sigma.vars canonical.modBase+F.e≤targetBase)
    (hword : ∀k<n,(sigma.arrs workBank).getD (sourceBase+k) 0<B)
    (hprime : ∀k<n,(sigma.arrs workBank).getD (sourceBase+k) 0<F.p) :
    ∃tau,Run B copyGram sigma tau (20*n+6) ∧ ValidMemory F B tau ∧
      (∀k<n,(tau.arrs canonical.mem).getD (targetBase+k) 0=
        (sigma.arrs workBank).getD (sourceBase+k) 0) ∧
      (∀k,(k<targetBase ∨ targetBase+n≤k) →
        (tau.arrs canonical.mem).getD k 0=(sigma.arrs canonical.mem).getD k 0) ∧
      (∀x,x≠copyIndex→tau.vars x=sigma.vars x) ∧
      tau.inp=sigma.inp ∧ tau.out=sigma.out := by
  obtain ⟨tau,hr,hcopy,houtside,harr,hvars,hi,ho⟩:=
    copyGram_run sigma hn hcount hsource htarget hsourceB htargetB
      hfitSource hfitTarget hword
  have hlen : (tau.arrs canonical.mem).length=
      (sigma.arrs canonical.mem).length := (run_frame hr).2.2.1 _
  have hscratch : tau.arrs canonical.scratch=sigma.arrs canonical.scratch :=
    harr _ (by decide)
  have hmod : tau.vars canonical.modBase=sigma.vars canonical.modBase :=
    hvars _ (by decide)
  have he : tau.vars canonical.e=sigma.vars canonical.e := hvars _ (by decide)
  have hp : tau.vars canonical.p=sigma.vars canonical.p := hvars _ (by decide)
  have valid : ValidMemory F B tau := by
    refine {
      degree:=he.trans hv.degree
      prime:=hp.trans hv.prime
      arithmetic_word:=hv.arithmetic_word
      inverse_word:=hv.inverse_word
      memory_word:=by rw [hlen];exact hv.memory_word
      scratch_word:=by rw [hscratch];exact hv.scratch_word
      scratch_fit:=by rw [hscratch];exact hv.scratch_fit
      modulus_fit:=by rw [hmod,hlen];exact hv.modulus_fit
      modulus_value:=?_
      coefficients:=?_ }
    · intro i
      unfold Problem18IMPFieldMultiplication20261001.sourceCoeff
      rw [hmod,houtside]
      · exact hv.modulus_value i
      · left
        have hi:=i.isLt
        omega
    · intro j hj
      by_cases hlo:j<targetBase
      · rw [houtside j (Or.inl hlo)]
        exact hv.coefficients j (by rw [←hlen];exact hj)
      by_cases hhi:targetBase+n≤j
      · rw [houtside j (Or.inr hhi)]
        exact hv.coefficients j (by rw [←hlen];exact hj)
      · let k:=j-targetBase
        have hk:k<n:=by dsimp [k];omega
        have hjk:targetBase+k=j:=by dsimp [k];omega
        rw [←hjk,hcopy k hk]
        exact hprime k hk
  exact ⟨tau,hr,valid,hcopy,houtside,hvars,hi,ho⟩
