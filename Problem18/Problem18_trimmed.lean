    change ψ (strictPairFunctional z A) = ψ (strictPairFunctional w A) at heq
    simp only [LinearMap.sub_apply, AddChar.map_sub_eq_div, heq]
    apply div_self
    intro hz
    have hn := ψ.norm_apply (strictPairFunctional w A)
    rw [hz, norm_zero] at hn
    norm_num at hn
  funext p
  have heq := LinearMap.congr_fun hL (Pi.single p 1)
  simpa [strictPairFunctional, Pi.single_apply] using heq
theorem strictPairCharacter_bijective {n : ℕ} (ψ : AddChar K ℂ) (hψ : ψ ≠ 1) :
    Function.Bijective (strictPairCharacter (n := n) ψ) := by
  apply (Fintype.bijective_iff_injective_and_card _).2
  refine ⟨strictPairCharacter_injective ψ hψ, ?_⟩
  rw [AddChar.card_eq]
