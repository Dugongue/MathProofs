    (σ : K ≃+* K) (τ : ι → ι) (hτ : Function.Involutive τ)
    (S : Module.End K V) (R : Module.End K W) (a : ∀ i,Module.End K (L i))
    (B : V →ₛₗ[σ.toRingHom] V →ₗ[K] K) (C : W →ₛₗ[σ.toRingHom] W →ₗ[K] K)
    (E : (∀ i,L i) ≃ₗ[K] V) (F : (∀ i,L i) ≃ₗ[K] W)
