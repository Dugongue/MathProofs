attribute [-instance] FunLike.toDecidableEq CommSemiRingCat.FilteredColimits.colimitCommSemiring SemiRingCat.instSemiringObjForgetRingHomCarrier AddMonoidAlgebra.instHopfAlgebraStruct AddMonoidAlgebra.instBialgebra Bialgebra.toAlgebra
namespace Problem18ArrayElimination20260929
open Problem18Elimination20260929
variable {K : Type*} [Field K] [DecidableEq K] {n N : ℕ}
def read (v : Vector K N) : Fin N → K := fun i => v[i.val]
@[simp] theorem read_ofFn (f : Fin N → K) : read (Vector.ofFn f) = f := by
  funext i
  simp [read]
def observe (e : Fin n → Fin N) : (Fin N → K) →ₗ[K] (Fin n → K) :=
  LinearMap.pi (fun i => LinearMap.proj (e i))
@[simp] theorem observe_apply (e : Fin n → Fin N) (x : Fin N → K) (i : Fin n) :
    observe e x i = x (e i) := rfl
def findPivot (e : Fin n → Fin N) (v : Vector K N) :
    List (Fin n) → Option (Fin n) × ℕ
  | [] => (none, 0)
  | i :: is => if read v (e i) = 0 then
      let r := findPivot e v is
      (r.1, r.2 + 1)
    else (some i, 1)
theorem findPivot_fst (e : Fin n → Fin N) (v : Vector K N) (cs : List (Fin n)) :
    (findPivot e v cs).1 = pivot cs (observe e) (read v) := by
  induction cs with
  | nil => rfl
  | cons i cs ih =>
    simp only [findPivot, pivot, List.find?_cons, observe_apply]
    by_cases h : read v (e i) = 0 <;> simp [h, ih, pivot]
theorem findPivot_cost_le (e : Fin n → Fin N) (v : Vector K N) (cs : List (Fin n)) :
    (findPivot e v cs).2 ≤ cs.length := by
  induction cs with
  | nil => simp [findPivot]
  | cons i cs ih =>
    simp only [findPivot, List.length_cons]
    split <;> simp_all <;> omega
def eliminateArray (e : Fin n → Fin N) (i : Fin n) (v x : Vector K N) : Vector K N :=
  let a := read x (e i) / read v (e i)
  Vector.ofFn (fun j => read x j - a * read v j)
@[simp] theorem eliminateArray_read (e : Fin n → Fin N) (i : Fin n) (v x : Vector K N) :
    read (eliminateArray e i v x) = eliminate (observe e) i (read v) (read x) := by
  ext j
  simp [eliminateArray, eliminate_apply, Pi.sub_apply, Pi.smul_apply, smul_eq_mul]
def reduceArray (cs : List (Fin n)) (e : Fin n → Fin N) :
    List (Vector K N) → Vector K N → Vector K N × ℕ
  | [], x => (x, 0)
  | v :: vs, x =>
    let fp := findPivot e v cs
    match fp.1 with
    | none => let r := reduceArray cs e vs x
              (r.1, r.2 + fp.2)
    | some i => let E := eliminateArray e i v
                let r := reduceArray cs e (vs.map E) (E x)
                (r.1, r.2 + fp.2 + (vs.length + 1) * (2 * N + 1))
termination_by vs => vs.length
theorem reduceArray_read (cs : List (Fin n)) (e : Fin n → Fin N)
    (vs : List (Vector K N)) (x : Vector K N) :
    read (reduceArray cs e vs x).1 =
      reduce cs (observe e) (vs.map read) (read x) := by
  cases vs with
  | nil => simp [reduceArray, reduce]
  | cons v vs =>
    have hp := findPivot_fst e v cs
    cases h : (findPivot e v cs).1 with
    | none =>
      have h' : pivot cs (observe e) (read v) = none := hp.symm.trans h
      simp only [reduceArray, h, List.map_cons, reduce, h']
      exact reduceArray_read cs e vs x
    | some i =>
      have h' : pivot cs (observe e) (read v) = some i := hp.symm.trans h
      simp only [reduceArray, h, List.map_cons, reduce, h', LinearMap.comp_apply]
      rw [reduceArray_read]
      simp only [List.map_map, Function.comp_def, eliminateArray_read]
termination_by vs.length
theorem reduceArray_cost_le (cs : List (Fin n)) (e : Fin n → Fin N)
    (vs : List (Vector K N)) (x : Vector K N) :
    (reduceArray cs e vs x).2 ≤
      vs.length * cs.length + (2 * N + 1) * vs.length ^ 2 := by
  cases vs with
  | nil => simp [reduceArray]
  | cons v vs =>
    have hp := findPivot_cost_le e v cs
    cases h : (findPivot e v cs).1 with
    | none =>
      have ih := reduceArray_cost_le cs e vs x
      simp only [reduceArray, h, List.length_cons]
      nlinarith
    | some i =>
      have ih := reduceArray_cost_le cs e
        (vs.map (eliminateArray e i v)) (eliminateArray e i v x)
      simp only [List.length_map] at ih
      simp only [reduceArray, h, List.length_cons]
      nlinarith [sq_nonneg (vs.length : ℤ)]
termination_by vs.length
def spanCheck (vs : List (Vector K N)) (x : Vector K N) : Bool × ℕ :=
  let r := reduceArray (List.finRange N) id vs x
  (decide (read r.1 = 0), r.2 + N)
theorem spanCheck_iff (vs : List (Vector K N)) (x : Vector K N) :
    (spanCheck vs x).1 = true ↔ read x ∈ rowSpan (K := K) (vs.map read) := by
  have ho : (observe (K := K) (id : Fin N → Fin N)) = LinearMap.id := by ext; rfl
  have h := reduce_eq_zero_iff (List.finRange N) (by simp) (observe id)
    (vs.map read) (read x)
  simpa only [spanCheck, decide_eq_true_eq, reduceArray_read, ho,
    LinearMap.id_apply, Submodule.map_id] using h
theorem spanCheck_cost_le (vs : List (Vector K N)) (x : Vector K N) :
    (spanCheck vs x).2 ≤ vs.length * N + (2 * N + 1) * vs.length ^ 2 + N := by
  have h := reduceArray_cost_le (List.finRange N) id vs x
  simp only [List.length_finRange] at h
  exact Nat.add_le_add_right h N
end Problem18ArrayElimination20260929
end
