    (∑ x, if x = 0 then f x else g x) = f 0 + ∑ x : {x : X // x ≠ 0}, g x := by
  rw [Finset.sum_ite]
  have hf : (Finset.univ.filter fun x : X => x = 0) = {0} := by ext x; simp
  rw [hf, Finset.sum_singleton]
  congr 1
  exact Finset.sum_subtype (p := fun x : X => x ≠ 0) _ (by intro x; simp only [Finset.mem_filter, Finset.mem_univ, true_and]) g
