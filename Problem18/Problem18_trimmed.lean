    rw [adapted_apply]
    simp only [Function.comp_def,Sum.elim_inl,Sum.elim_inr,map_zero,ZeroMemClass.coe_zero,add_zero]
  have hi (x : Fin d→K) : e.symm (S (f x).val)=Sum.elim (f.symm (S.restrict hS (f x))) 0 := by
    apply e.injective
