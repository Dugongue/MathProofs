namespace Mathproof.Problem18FrobeniusComponentCollision20260930
open MvPolynomial
section Ring
variable {R : Type*} [CommRing R]
def collisionIdeal (I : Ideal R) : Ideal R :=
  sInf {J | ∃ P ∈ I.minimalPrimes, ∃ Q ∈ I.minimalPrimes, P ≠ Q ∧ J = P ⊔ Q}
theorem comap_minimalPrime (e : R ≃+* R) {I P : Ideal R}
    (hI : I.comap e = I) (hP : P ∈ I.minimalPrimes) :
    P.comap e ∈ I.minimalPrimes := by
  letI : P.IsPrime := hP.isPrime
  have hImap : I.map e = I := by
    have h := congrArg (fun J : Ideal R => J.map e) hI
    simpa only [Ideal.map_comap_eq_self_of_equiv] using h.symm
  refine ⟨⟨inferInstance, ?_⟩, ?_⟩
  · simpa only [hI] using Ideal.comap_mono (f := e) hP.le
  · intro Q hQ hQP
    letI : Q.IsPrime := hQ.1
    have hIQ : I ≤ Q.map e := hImap ▸ Ideal.map_mono hQ.2
    have hPQ : P ≤ Q.map e :=
      hP.2 ⟨inferInstance,hIQ⟩ (Ideal.map_le_iff_le_comap.mpr hQP)
    simpa only [Ideal.comap_map_of_bijective _ e.bijective] using
      Ideal.comap_mono (f := e) hPQ
theorem le_collisionIdeal (I : Ideal R) : I ≤ collisionIdeal I := by
  apply le_sInf
  rintro J ⟨P,hP,Q,hQ,hne,rfl⟩
  exact hP.le.trans le_sup_left
theorem exists_component_collision (e : R ≃+* R) {I M : Ideal R}
    [M.IsPrime] (hI : I.comap e = I) (hM : M.comap e = M)
    (hno : ∀ P ∈ I.minimalPrimes, P.comap e ≠ P) (hIM : I ≤ M) :
    ∃ P ∈ I.minimalPrimes, ∃ Q ∈ I.minimalPrimes, P ≠ Q ∧ P ⊔ Q ≤ M := by
  obtain ⟨P,hP,hPM⟩ := Ideal.exists_minimalPrimes_le hIM
  refine ⟨P,hP,P.comap e,comap_minimalPrime e hI hP,(hno P hP).symm,?_⟩
  exact sup_le hPM (by simpa only [hM] using Ideal.comap_mono (f := e) hPM)
theorem collision_preserves_fixed_prime (e : R ≃+* R) {I M : Ideal R}
    [M.IsPrime] (hI : I.comap e = I) (hM : M.comap e = M)
    (hno : ∀ P ∈ I.minimalPrimes, P.comap e ≠ P) :
    collisionIdeal I ≤ M ↔ I ≤ M := by
  constructor
  · exact (le_collisionIdeal I).trans
  · intro hIM
    obtain ⟨P,hP,Q,hQ,hne,hPQ⟩ := exists_component_collision e hI hM hno hIM
    exact (show collisionIdeal I ≤ P ⊔ Q from sInf_le ⟨P,hP,Q,hQ,hne,rfl⟩).trans hPQ
theorem component_collision_strict {I P Q : Ideal R}
    (hP : P ∈ I.minimalPrimes) (hQ : Q ∈ I.minimalPrimes) (hne : P ≠ Q) :
    P < P ⊔ Q ∧ Q < P ⊔ Q := by
  constructor
  · refine lt_of_le_of_ne le_sup_left ?_
    intro heq
    have hQP : Q ≤ P := heq ▸ le_sup_right
    exact hne (le_antisymm (hP.2 hQ.1 hQP) hQP)
  · refine lt_of_le_of_ne le_sup_right ?_
    intro heq
    have hPQ : P ≤ Q := heq ▸ le_sup_left
    exact hne (le_antisymm hPQ (hQ.2 hP.1 hPQ))
theorem collision_family_finite [IsNoetherianRing R] (I : Ideal R) :
    {J | ∃ P ∈ I.minimalPrimes, ∃ Q ∈ I.minimalPrimes, P ≠ Q ∧ J = P ⊔ Q}.Finite := by
  have hfin := Ideal.finite_minimalPrimes_of_isNoetherianRing R I
  apply ((hfin.prod hfin).image (fun pq => pq.1 ⊔ pq.2)).subset
  rintro J ⟨P,hP,Q,hQ,hne,rfl⟩
  exact ⟨(P,Q),⟨hP,hQ⟩,rfl⟩
theorem span_comap_fixed (e : R ≃+* R) (S : Set R) (hS : ∀ f ∈ S, e f = f) :
    (Ideal.span S).comap e = Ideal.span S := by
  have hmap : (Ideal.span S).map e = Ideal.span S := by
    rw [Ideal.map_span]
    congr 1
    ext f
    constructor
    · rintro ⟨g,hg,rfl⟩
      simpa only [hS g hg] using hg
    · intro hf
      exact ⟨f,hf,hS f hf⟩
  have h := congrArg (fun J : Ideal R => J.comap e) hmap
  simpa only [Ideal.comap_map_of_bijective _ e.bijective] using h.symm
end Ring
section Geometric
variable {N : Nat} {K L : Type*} [Field K] [Field L] [Algebra K L]
noncomputable def coefficientAutomorphism (g : L ≃ₐ[K] L) :
    MvPolynomial (Fin N) L ≃+* MvPolynomial (Fin N) L :=
  MvPolynomial.mapEquiv (Fin N) g.toRingEquiv
noncomputable def geometricIdeal (F : Set (MvPolynomial (Fin N) K)) : Ideal (MvPolynomial (Fin N) L) :=
  Ideal.span (MvPolynomial.map (algebraMap K L) '' F)
theorem geometricIdeal_fixed (g : L ≃ₐ[K] L) (F : Set (MvPolynomial (Fin N) K)) :
    (geometricIdeal (L := L) F).comap (coefficientAutomorphism g) = geometricIdeal F := by
  apply span_comap_fixed
  rintro f ⟨p,hp,rfl⟩
  ext a
  simp [coefficientAutomorphism,coeff_map,AlgEquiv.commutes]
noncomputable def rationalPointKernel (x : Fin N → K) : Ideal (MvPolynomial (Fin N) L) :=
  RingHom.ker (MvPolynomial.eval (fun i => algebraMap K L (x i)))
instance rationalPointKernel_isPrime (x : Fin N → K) :
    (rationalPointKernel (L := L) x).IsPrime := RingHom.ker_isPrime _
theorem rationalPointKernel_fixed (g : L ≃ₐ[K] L) (x : Fin N → K) :
    (rationalPointKernel (L := L) x).comap (coefficientAutomorphism g) =
      rationalPointKernel x := by
  ext p
  change eval (fun i => algebraMap K L (x i)) (map g.toRingHom p) = 0 ↔
    eval (fun i => algebraMap K L (x i)) p = 0
  have hx : g.toRingHom ∘ (fun i => algebraMap K L (x i)) =
      (fun i => algebraMap K L (x i)) := by
    funext i
    exact g.commutes (x i)
  have he := map_eval g.toRingHom (fun i => algebraMap K L (x i)) p
  rw [hx] at he
  rw [← he]
  exact map_eq_zero g
theorem rational_collision_equivalence (g : L ≃ₐ[K] L)
    (F : Set (MvPolynomial (Fin N) K))
    (hno : ∀ P ∈ (geometricIdeal (L := L) F).minimalPrimes,
      P.comap (coefficientAutomorphism g) ≠ P) (x : Fin N → K) :
    collisionIdeal (geometricIdeal (L := L) F) ≤ rationalPointKernel x ↔
      ∀ f ∈ F, eval x f = 0 := by
  rw [collision_preserves_fixed_prime (coefficientAutomorphism g)
    (geometricIdeal_fixed g F) (rationalPointKernel_fixed g x) hno]
  rw [geometricIdeal,Ideal.span_le]
  constructor
  · intro h f hf
    have hz := h (Set.mem_image_of_mem (map (algebraMap K L)) hf)
    change eval (fun i => algebraMap K L (x i)) (map (algebraMap K L) f) = 0 at hz
    have he := map_eval (algebraMap K L) x f
    simp only [Function.comp_def] at he
    rw [← he] at hz
    exact (algebraMap K L).injective (by simpa using hz)
  · intro h f hf
    obtain ⟨p,hp,rfl⟩ := hf
    change eval (fun i => algebraMap K L (x i)) (map (algebraMap K L) p) = 0
    have he := map_eval (algebraMap K L) x p
    simp only [Function.comp_def] at he
    rw [← he]
    simp [h p hp]
end Geometric
