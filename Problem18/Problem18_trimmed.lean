      (∀x,x≠idx→ tau.vars x=sigma.vars x) ∧
      tau.inp=sigma.inp ∧ tau.out=sigma.out := by
  let I : Env→ Prop:=fun rho=>rho.vars idx≤n ∧ rho.vars cnt=n ∧ rho.vars db=targetBase ∧
