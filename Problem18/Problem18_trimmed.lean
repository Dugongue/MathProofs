abbrev TwoVar : Type u := FractionRing (MvPolynomial (Fin 2) L)
abbrev Ambient : Type u := AlgebraicClosure (TwoVar L)
noncomputable def coords : Fin 2 → Ambient L :=
  (IsScalarTower.toAlgHom L (MvPolynomial (Fin 2) L) (Ambient L)) ∘ MvPolynomial.X
theorem coords_injective_map :
    Function.Injective (IsScalarTower.toAlgHom L (MvPolynomial (Fin 2) L) (Ambient L)) := by
  change Function.Injective (algebraMap (MvPolynomial (Fin 2) L) (Ambient L))
  rw [IsScalarTower.algebraMap_eq (MvPolynomial (Fin 2) L) (TwoVar L) (Ambient L)]
