def join {ι : Type u} (input : ι→List Nat) (result : ι→Option Bool)
    (profile : ι→Profile) (test : Profile→Prop) [DecidablePred test]
    (yes : ProfiledBranchProgram {x : ι // test (profile x)}
      (fun x=>input x.val) (fun x=>result x.val) (fun x=>profile x.val))
    (no : ProfiledBranchProgram {x : ι // ¬test (profile x)}
      (fun x=>input x.val) (fun x=>result x.val) (fun x=>profile x.val)) :
    ProfiledBranchProgram ι input result profile where
  layout := fun p=>if test p then yes.layout p else no.layout p
  program := fun p=>if test p then yes.program p else no.program p
  wordPolynomial := yes.wordPolynomial+no.wordPolynomial
  timePolynomial := yes.timePolynomial+no.timePolynomial
  ok := by
    intro p
    by_cases hp : test p
    · simpa only [if_pos hp] using yes.ok p
    · simpa only [if_neg hp] using no.ok p
  run := by
    intro x
    by_cases hx : test (profile x)
    · obtain ⟨ext,σ,hr,ho⟩:=yes.run ⟨x,hx⟩
      refine ⟨ext,σ,?_,ho⟩
      simp only [if_pos hx]
      have hB : 2^(yes.wordPolynomial.eval (bitSize (input x))+bitSize (input x)+1) ≤
          2^((yes.wordPolynomial+no.wordPolynomial).eval (bitSize (input x))+bitSize (input x)+1) := by
        apply Nat.pow_le_pow_right (by omega)
        simp only [Polynomial.eval_add]
        omega
      exact (Problem18P34Assembly20261003BoundMono.run hB hr).mono
        (by simp only [Polynomial.eval_add];omega)
    · obtain ⟨ext,σ,hr,ho⟩:=no.run ⟨x,hx⟩
      refine ⟨ext,σ,?_,ho⟩
      simp only [if_neg hx]
      have hB : 2^(no.wordPolynomial.eval (bitSize (input x))+bitSize (input x)+1) ≤
          2^((yes.wordPolynomial+no.wordPolynomial).eval (bitSize (input x))+bitSize (input x)+1) := by
        apply Nat.pow_le_pow_right (by omega)
        simp only [Polynomial.eval_add]
        omega
      exact (Problem18P34Assembly20261003BoundMono.run hB hr).mono
        (by simp only [Polynomial.eval_add];omega)
def UnboundedBoundary (cutoff : Nat) :=
  {x : BoundaryQuery cutoff // ¬ median x.a x.b x.c<cutoff}
def boundary (cutoff : Nat)
    (remaining : ProfiledBranchProgram (UnboundedBoundary cutoff)
      (fun x=>boundaryWords x.val) (fun x=>boundaryAnswer x.val)
      (fun x=>boundaryProfile x.val)) :
    ProfiledBranchProgram (BoundaryQuery cutoff) (@boundaryWords cutoff)
      (@boundaryAnswer cutoff) (@boundaryProfile cutoff) :=
  join (@boundaryWords cutoff) (@boundaryAnswer cutoff) (@boundaryProfile cutoff)
    (fun p=>median p.a p.b p.c<cutoff)
    (Problem18P35BoundedBoundary20261003.branch cutoff) remaining
end
end Mathproof.Problem18P35BranchAssembly20261003
