      restriction_block_isUnit _ hc f g S hpres hb
  · simpa only [S,LinearMap.toMatrix'_toLin'] using invariant_block_zero _ hc f g S hpres
  · obtain ⟨t,_,ht⟩ := primary_projector_matrix _ hc f g S p (S.charpoly/p) rfl hnW
