variable {L : Type*} [Field L] [IsAlgClosed L] {n : ℕ}
theorem minimalPrime_separator' (G : Finset (MvPolynomial (Fin n) L)) (d : ℕ)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes)
    (p : Fin n → L) (hp : p ∉ MvPolynomial.zeroLocus L P) :
    ∃ s ∈ P, s.totalDegree ≤ componentSep n d ∧ eval p s ≠ 0 := by
  rw [MvPolynomial.mem_zeroLocus_iff] at hp
  push Not at hp
  obtain ⟨f, hfP, hfp⟩ := hp
  exact minimalPrime_separator G d hG P hP p f hfP (by simpa using hfp)
theorem union_separator (G : Finset (MvPolynomial (Fin n) L)) (d : ℕ)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (S : Finset (Ideal (MvPolynomial (Fin n) L)))
    (hS : ∀ P ∈ S, P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes)
    (p : Fin n → L) (hp : ∀ P ∈ S, p ∉ MvPolynomial.zeroLocus L P) :
    ∃ s ∈ (⨅ P ∈ S, P), s.totalDegree ≤ S.card * componentSep n d ∧ eval p s ≠ 0 := by
  classical
  have hsep : ∀ P ∈ S, ∃ s ∈ P, s.totalDegree ≤ componentSep n d ∧ eval p s ≠ 0 :=
    fun P hP => minimalPrime_separator' G d hG P (hS P hP) p (hp P hP)
  choose! s hsP hsdeg hsp using hsep
  refine ⟨∏ P ∈ S, s P, ?_, ?_, ?_⟩
  · simp only [Submodule.mem_iInf]
    intro P hP
    rw [← Finset.mul_prod_erase S s hP]
    exact Ideal.mul_mem_right _ _ (hsP P hP)
  · refine (totalDegree_finsetProd _ _).trans ?_
    calc ∑ P ∈ S, (s P).totalDegree ≤ ∑ _P ∈ S, componentSep n d :=
          Finset.sum_le_sum fun P hP => hsdeg P hP
      _ = S.card * componentSep n d := by simp
  · rw [map_prod]
    exact Finset.prod_ne_zero_iff.mpr fun P hP => hsp P hP
