variable {K : Type} [Field K] [DecidableEq K] {a b c : ℕ}
def rawGram {n : ℕ} (hn : 0 < n) (u : Bool) (q : ℕ) (X : Matrix (Fin n) (Fin n) K) : K :=
  (rawAdjoint u q X*X) ⟨0,hn⟩ ⟨0,hn⟩
def rawSecondIndexed (u : Bool) (q : ℕ) (A : RectTensor a b c K) (t : Fin (b*b)) :
    Matrix (Fin a) (Fin a) K := rawSecond u q A (finProdFinEquiv.symm t)
def rawLargeCheck (ha : 0 < a) (hb : 0 < b) (u : Bool) (p q : ℕ)
    (A B : RectTensor a b c K) : Bool :=
  let card:=if u then q*q else q
  match intertwiner (rawFirst u q A) (rawFirst u q B) with
  | none=>false
  | some X=>
    let dx:=rawGram hb u q X
    match intertwiner (rawSecondIndexed u q A)
      (fun t=>dx • rawSecondIndexed u q (undoFirst B X) t) with
    | none=>false
    | some Y=>
      let dy:=rawGram ha u q Y
      let H:=outerImage A Y X
      if u then check finProdFinEquiv.symm H B &&
        decide ((dy*dx)⁻¹ • (rawAdjoint u q H*H)=rawAdjoint u q B*B)
      else if p=2 then charTwoFinal card H B (dy*dx)
      else oddNormalizer card dy && oddNormalizer card dx && oddFinal card H B (dy*dx)
section Compatible
variable [StarRing K] (u : Bool) (q : ℕ) (hs : ∀x : K,(if u then x^q else x)=star x)
include hs
theorem rawGram_eq {n : ℕ} (hn : 0 < n) (X : Matrix (Fin n) (Fin n) K) :
    rawGram hn u q X=gramScalar hn X := by
  rw [rawGram,rawAdjoint_eq u q hs]
  rfl
theorem rawSecondIndexed_eq (A : RectTensor a b c K) : rawSecondIndexed u q A=secondIndexed A := by
  funext t
  rw [rawSecondIndexed,rawSecond_eq u q hs]
  rfl
theorem rawLargeCheck_eq (ha : 0 < a) (hb : 0 < b) (p : ℕ) (A B : RectTensor a b c K) :
    rawLargeCheck ha hb u p q A B=largeCheck ha hb u p (if u then q*q else q) A B := by
  simp only [rawLargeCheck,largeCheck,firstSolution,secondSolution,secondTarget,
    rawFirst_eq u q hs,rawSecondIndexed_eq u q hs,rawGram_eq u q hs,
    rawAdjoint_eq u q hs,unitaryFinal]
  rfl
theorem root_equivalent_iff (A B : RectTensor a b c K) :
    equivalent u q A B ↔ Equivalent A B := by
  simp only [equivalent,Equivalent,root_isometry_iff u q hs]
end Compatible
theorem rawLargeCheck_correct [Fintype K] (F : FieldPresentation K)
    (ha : 0 < a) (hb : 0 < b) (u : Bool) (q : ℕ) (hv : validSize K u q)
    (A B : RectTensor a b c K) (hA : RawGood u q A) :
    rawLargeCheck ha hb u F.p q A B=true ↔ equivalent u q A B := by
  have hp : F.p=ringChar K := by
    letI : CharP K F.p:=F.characteristic
    exact (ringChar.eq K F.p).symm
  cases u with
  | false =>
    letI : StarRing K:=identityStar
    letI : TrivialStar K:=⟨fun _=>rfl⟩
    have hs : ∀x : K,(if false then x^q else x)=star x:=fun _=>rfl
    rw [rawLargeCheck_eq false q hs,root_equivalent_iff false q hs,hp]
    have hG:=(rawGood_iff false q hs A).mp hA
    have hcard : q=Fintype.card K:=hv
    simp only [Bool.false_eq_true,ite_false,hcard]
    by_cases ht : ringChar K=2
    · letI : CharP K 2:=ht ▸ inferInstanceAs (CharP K (ringChar K))
      rw [ht]
      exact largeCheck_charTwo ha hb A B hG
    · letI : NeZero (2 : K):=⟨by
        intro hz
        letI : CharP K 2:=(CharP.charP_iff_prime_eq_zero (R:=K) Nat.prime_two).mpr hz
        exact ht (ringChar.eq K 2)⟩
      exact largeCheck_odd ht ha hb A B hG
  | true =>
    let d:=Classical.choice (Problem18UnitaryRootField20260930.exists_unitaryFieldData q hv)
    letI : StarRing K:=d.starRing
    let L:=Problem18InvolutionNorm20260930.fixedField d.automorphism
    letI : Fintype L:=Fintype.ofFinite L
    have hs : ∀x : K,(if true then x^q else x)=star x:=fun x=>(d.star_eq_power x).symm
    rw [rawLargeCheck_eq true q hs,root_equivalent_iff true q hs]
    exact largeCheck_unitary (F:=L) d.quadratic_card d.star_eq_fixed_card ha hb F.p _ A B
      ((rawGood_iff true q hs A).mp hA)
end Mathproof.Problem18LargeRootDecision20261001
