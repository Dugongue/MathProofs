    (hpo : PrefixOut F W a b c true q A T σ τ hfirst)
    (hcols : τ.vars colsReg = boundaryWidth a b c) (he : τ.vars canonical.e = F.e)
    (hlen : 2*memLen (boundaryWidth a b c) F.e ≤ (τ.arrs pairBank).length)
    (hpB : F.p < W) (hB1 : 1 < W)
    (hwc : majorant cntSize (boundaryWidth a b c) F.e < W)
    (hwo : majorant o2Size (boundaryWidth a b c) F.e < W)
    (hwl : 2*memLen (boundaryWidth a b c) F.e < W)
    (hfc : Problem18BoundaryRawChecks20261001.firstCheck true q (sorted A hfirst) = true) :
    ∃ ρ, Run W uLeg τ ρ (unitaryCost (boundaryWidth a b c) F.e + 2) ∧
      ρ.out = τ.out ++ [if modeAnswer true F.p q (sorted A hfirst) (sorted T hfirst) then 1 else 0] ∧
      ρ.inp = τ.inp := by
  have hnd := (sorted_shape a b c).2
  obtain ⟨τ1, hr, hb, hiff, -, -, hin, hout⟩ :=
    unitaryMode_query F (B:=W) (d:=boundaryHeight a b c) F.p q hpo.snapA hpo.snapB hcols he
      hpo.bit hpo.result hlen hpB hB1 hwc hwo hwl hnd hfc
