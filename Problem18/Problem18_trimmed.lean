variable {K : Type*} [Field K] [Fintype K] {n : ℕ}
theorem linearEquiv_card_eq_fullRank :
    Nat.card ((Fin n → K) ≃ₗ[K] (Fin n → K)) =
      Nat.card {M : Matrix (Fin n) (Fin n) K // M.rank = n} := by
  classical
  let e : Matrix.GeneralLinearGroup (Fin n) K ≃* ((Fin n → K) ≃ₗ[K] (Fin n → K)) :=
    Matrix.GeneralLinearGroup.toLin.trans (LinearMap.GeneralLinearGroup.generalLinearEquiv K (Fin n → K))
  calc
    Nat.card ((Fin n → K) ≃ₗ[K] (Fin n → K)) =
        Nat.card (Matrix.GeneralLinearGroup (Fin n) K) := Nat.card_congr e.toEquiv.symm
    _ = Nat.card {M : Matrix (Fin n) (Fin n) K // M.rank = n} := by
      rw [Matrix.card_GL_field, fullRowRank_card le_rfl]
theorem linearEquiv_card_ge_quarter :
    (1 / 4 : ℝ) * (Fintype.card K : ℝ) ^ (n * n) ≤
      Nat.card ((Fin n → K) ≃ₗ[K] (Fin n → K)) := by
  have h := fullRowRank_density_ge_quarter (K := K) (d := n) (n := n) le_rfl
  have hc : Nat.card (Matrix (Fin n) (Fin n) K) = Fintype.card K ^ (n * n) := by
    simp [Matrix, Nat.card_eq_fintype_card, ← pow_mul]
  rw [hc, Nat.cast_pow] at h
  have hp : (0 : ℝ) < (Fintype.card K : ℝ) ^ (n * n) := by positivity
  have h' := (le_div_iff₀ hp).mp h
  rw [linearEquiv_card_eq_fullRank]
  exact h'
theorem choose_pair_sum (n : ℕ) : n * n = (n + 1).choose 2 + n.choose 2 := by
  induction n with
  | zero => decide
  | succ n ih =>
      have h1 : (n + 1).choose 2 = n.choose 2 + n := by
        rw [Nat.choose_succ_succ, Nat.choose_one_right]
        exact Nat.add_comm _ _
      have h2 : (n + 1 + 1).choose 2 = (n + 1).choose 2 + (n + 1) := by
        rw [Nat.choose_succ_succ, Nat.choose_one_right]
        exact Nat.add_comm _ _
      change (n + 1) * (n + 1) = (n + 1 + 1).choose 2 + (n + 1).choose 2
      nlinarith
theorem formOrbit_card_ge_quarter (σ : K ≃+* K)
    (B : (Fin n → K) →ₛₗ[(σ : K →+* K)] (Fin n → K) →ₗ[K] K)
    (hB : B.Nondegenerate) :
    (1 / 4 : ℝ) * (Fintype.card K : ℝ) ^ (n.choose 2) ≤ Nat.card (FormOrbit σ B) := by
  have hq : (0 : ℝ) < Fintype.card K := by positivity
  apply (mul_le_mul_iff_left₀ (pow_pos hq ((n + 1).choose 2))).mp
  calc
    (1 / 4 * (Fintype.card K : ℝ) ^ (n.choose 2)) *
        (Fintype.card K : ℝ) ^ ((n + 1).choose 2) =
        1 / 4 * (Fintype.card K : ℝ) ^ (n * n) := by
      rw [mul_assoc, ← pow_add, choose_pair_sum, Nat.add_comm (n.choose 2)]
    _ ≤ Nat.card ((Fin n → K) ≃ₗ[K] (Fin n → K)) := linearEquiv_card_ge_quarter
    _ ≤ (Nat.card (FormOrbit σ B) : ℝ) * (Fintype.card K : ℝ) ^ ((n + 1).choose 2) := by
      exact_mod_cast linearEquiv_card_le_orbit_mul σ B hB
end Mathproof.Problem18FormOrbitDensity20260930
