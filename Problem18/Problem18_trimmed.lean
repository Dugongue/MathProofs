theorem irreducible_occurrence_bound (B : LinearMap.BilinForm K V) (hB : B.IsSymm)
    (hnB : B.Nondegenerate) (h : K[X]) (hm : h.Monic) (hi : Irreducible h)
    (hd : 2*h.natDegree ≤ Module.finrank K V) :
    (Nat.card {T : SelfAdjointOperators (RingEquiv.refl K) B // h∣T.val.charpoly}:ℝ)*
      (Nat.card K:ℝ)^h.natDegree ≤ 20*Nat.card (SelfAdjointOperators (RingEquiv.refl K) B) := by
  letI : Finite V := Finite.of_injective (Module.finBasis K V).equivFun (Module.finBasis K V).equivFun.injective
  letI : Finite (Module.End K V) := Finite.of_injective (fun T : Module.End K V=>(T:V→V)) DFunLike.coe_injective
  have hcover (T : SelfAdjointOperators (RingEquiv.refl K) B) (ht : h∣T.val.charpoly) :
      RegularOccurrence B h T ∨ IsotropicOccurrence B h T := by
    obtain ⟨U,hU,hdu,hχ,hreg|hiso⟩ :=
      Mathproof.Problem18SimpleSesquilinearWitness20261001.simple_primary_charpoly_witness
        (RingEquiv.refl K) T.val h hm hi ht B T.property
    · left
      have hnU : (B.restrict U).Nondegenerate := by
        have hl : (B.restrict U).SeparatingLeft := by
          intro x hx
          apply Subtype.ext
          have hz : x.val∈U⊓U.orthogonalBilin B :=
            ⟨x.property,fun y hy=>hB.isRefl.eq_zero (hx ⟨y,hy⟩)⟩
          exact hreg.le hz
        exact ⟨hl,fun x hx=>hl x (fun y=>(hB.restrict U).isRefl.eq_zero (hx y))⟩
      exact ⟨⟨U,hdu,hnU⟩,hU,hχ⟩
    · exact Or.inr ⟨U,hU,hdu,hχ,hiso⟩
  have hu := union_card (fun T : SelfAdjointOperators (RingEquiv.refl K) B=>h∣T.val.charpoly)
    (RegularOccurrence B h) (IsotropicOccurrence B h) hcover
  have hr := regular_occurrence_bound B hB hnB h hm hi (by omega)
  have hs := isotropic_occurrence_bound B hB hnB h hm hi hd
  have huR : (Nat.card {T : SelfAdjointOperators (RingEquiv.refl K) B // h∣T.val.charpoly}:ℝ) ≤
      (Nat.card {T : SelfAdjointOperators (RingEquiv.refl K) B // RegularOccurrence B h T}:ℝ)+
        Nat.card {T : SelfAdjointOperators (RingEquiv.refl K) B // IsotropicOccurrence B h T} := by exact_mod_cast hu
  have hmul := mul_le_mul_of_nonneg_right huR (show (0:ℝ) ≤ (Nat.card K:ℝ)^h.natDegree by positivity)
  nlinarith
end
