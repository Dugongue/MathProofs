def OneStep (G : Set (MvPolynomial σ K)) (f r : MvPolynomial σ K) : Prop :=
  ∃ g ∈ G, g ≠ 0 ∧ ∃ d ∈ f.support,
    ExponentDivides (m.degree g) d ∧ r = reductionStep m f g d
def Reduces (G : Set (MvPolynomial σ K)) (f r : MvPolynomial σ K) : Prop :=
  Relation.ReflTransGen (OneStep m G) f r
def ReducesToZero (G : Set (MvPolynomial σ K)) (f : MvPolynomial σ K) : Prop :=
  Reduces m G f 0
def BuchbergerCriterion (G : Set (MvPolynomial σ K)) : Prop :=
  ∀ f ∈ G, ∀ g ∈ G, f ≠ 0 → g ≠ 0 →
    ReducesToZero m G (m.sPolynomial f g)
