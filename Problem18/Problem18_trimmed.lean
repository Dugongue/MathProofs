variable {K : Type*} [Field K] [Fintype K] [StarRing K] {n k z m : ℕ}
noncomputable def sampleTwist : (Fin m → (Fin n → K)×(Fin n → K)) ≃+
    (Fin m → (Fin n → K)×(Fin n → K)) where
  toFun u j := (twist (starRingAut : K ≃+* K) (u j).1,
    twist (starRingAut : K ≃+* K) (u j).2)
  invFun u j := (twist (starRingAut : K ≃+* K) (u j).1,
    twist (starRingAut : K ≃+* K) (u j).2)
  left_inv u := by ext j i <;> simp [twist]
  right_inv u := by ext j i <;> simp [twist]
  map_add' u v := by ext j i <;> simp [twist,map_add]
noncomputable def conjugateLeft :
    (Matrix (Fin k) (Fin (m+m)) K × Matrix (Fin z) (Fin (m+m)) K) ≃+
      (Matrix (Fin k) (Fin (m+m)) K × Matrix (Fin z) (Fin (m+m)) K) where
  toFun P := ((fun i j => star (P.1 i j)),P.2)
  invFun P := ((fun i j => star (P.1 i j)),P.2)
  left_inv P := by ext i j <;> simp
  right_inv P := by ext i j <;> simp
  map_add' P Q := by
    apply Prod.ext
    · funext i j; exact star_add (P.1 i j) (Q.1 i j)
    · rfl
noncomputable def matrixMap (B : HermitianForm (K := K) (V := Fin n → K))
    (E : (Fin (k+z) → K) →ₗ[K] (Fin n → K)) :
    (Fin m → (Fin n → K)×(Fin n → K)) →+
      (Matrix (Fin k) (Fin (m+m)) K × Matrix (Fin z) (Fin (m+m)) K) :=
  conjugateLeft.toAddMonoidHom.comp
    ((anchorMatrixLinearMap (untwistForm (starRingAut : K ≃+* K) B) 1 E).toAddMonoidHom.comp
      sampleTwist.toAddMonoidHom)
theorem matrixMap_surjective (B : HermitianForm (K := K) (V := Fin n → K))
    (hB : B.Nondegenerate) (E : (Fin (k+z) → K) →ₗ[K] (Fin n → K))
    (hE : Function.Injective E) : Function.Surjective (matrixMap (m := m) B E) := by
  exact conjugateLeft.surjective.comp
    ((anchorMatrixMap_surjective (untwistForm (starRingAut : K ≃+* K) B)
      (untwistForm_nondegenerate (starRingAut : K ≃+* K) B hB) 1 (by simp) E hE).comp sampleTwist.surjective)
theorem matrixMap_cross (B : HermitianForm (K := K) (V := Fin n → K))
    (E : (Fin (k+z) → K) →ₗ[K] (Fin n → K))
    (u : Fin m → (Fin n → K)×(Fin n → K)) (i : Fin k) (l : Fin z) :
    (matrixMap B E u).1.mulVec ((matrixMap B E u).2 l) i=
      B ((∑ j,hermitianAnchorPair B (u j).1 (u j).2) (leftTestVector E i))
        (rightTestVector E l) := by
  change (∑ c : Fin (m+m),
    star (anchorLeftMatrix (untwistForm (starRingAut : K ≃+* K) B) 1
      (leftTestVector E) (sampleTwist u) i c) *
    anchorRightMatrix (untwistForm (starRingAut : K ≃+* K) B)
      (rightTestVector E) (sampleTwist u) l c)=_
  rw [← Equiv.sum_comp finSumFinEquiv,Fintype.sum_sum_type,← Finset.sum_add_distrib]
  simp only [anchorLeftMatrix,anchorRightMatrix,Equiv.symm_apply_apply,one_mul]
  change (∑ j, (star (untwistForm (starRingAut : K ≃+* K) B
      (twist (starRingAut : K ≃+* K) (u j).2) (leftTestVector E i)) *
    untwistForm (starRingAut : K ≃+* K) B
      (twist (starRingAut : K ≃+* K) (u j).1) (rightTestVector E l) +
    star (untwistForm (starRingAut : K ≃+* K) B
      (twist (starRingAut : K ≃+* K) (u j).1) (leftTestVector E i)) *
    untwistForm (starRingAut : K ≃+* K) B
      (twist (starRingAut : K ≃+* K) (u j).2) (rightTestVector E l)))=_
  simp only [untwistForm_apply_twist]
  simp only [LinearMap.coe_sum,Finset.sum_apply,map_sum,hermitianAnchorPair,
    LinearMap.add_apply,LinearMap.smulRight_apply,map_add,map_smulₛₗ,
    LinearMap.add_apply,LinearMap.smul_apply,starRingEnd_apply,smul_eq_mul]
theorem preserving_card_mul_le (B : HermitianForm (K := K) (V := Fin n → K))
    (hB : B.Nondegenerate) (W : Submodule K (Fin n → K))
    (E : (Fin (k+z) → K) →ₗ[K] (Fin n → K)) (hE : Function.Injective E)
    (hw : ∀i,leftTestVector E i∈W)
    (hv : ∀l,∀w∈W,B w (rightTestVector E l)=0) :
    Nat.card {u : Fin m → (Fin n → K)×(Fin n → K) //
      Preserves W (∑j,hermitianAnchorPair B (u j).1 (u j).2)}*
      Nat.card (Matrix (Fin k) (Fin (m+m)) K × Matrix (Fin z) (Fin (m+m)) K) ≤
      Nat.card (CrossZeroPairs (K := K) k (m+m) z)*
        Nat.card (Fin m → (Fin n → K)×(Fin n → K)) := by
  classical
  have he := Mathproof.Problem18AdditiveFiberCount20260930.surjective_preimage_card_mul
    (matrixMap (m := m) B E) (matrixMap_surjective B hB E hE)
    (fun P => ∀l,P.1.mulVec (P.2 l)=0)
  have hc : Nat.card {u : Fin m → (Fin n → K)×(Fin n → K) //
      Preserves W (∑j,hermitianAnchorPair B (u j).1 (u j).2)}≤
    Nat.card {u : Fin m → (Fin n → K)×(Fin n → K) //
      ∀l,(matrixMap B E u).1.mulVec ((matrixMap B E u).2 l)=0} := by
    let f : {u : Fin m → (Fin n → K)×(Fin n → K) //
        Preserves W (∑j,hermitianAnchorPair B (u j).1 (u j).2)} →
      {u : Fin m → (Fin n → K)×(Fin n → K) //
        ∀l,(matrixMap B E u).1.mulVec ((matrixMap B E u).2 l)=0} := fun u =>
      ⟨u.val,by
        intro l
        funext i
        rw [matrixMap_cross]
        exact hv l _ (u.property _ (hw i))⟩
    exact Nat.card_le_card_of_injective f
      (by
        intro x y h
        apply Subtype.ext
        exact congrArg (fun v : {u : Fin m → (Fin n → K)×(Fin n → K) //
          ∀l,(matrixMap B E u).1.mulVec ((matrixMap B E u).2 l)=0} => v.val) h)
  exact (Nat.mul_le_mul_right _ hc).trans_eq he
end Mathproof.Problem18HermitianCrossEvent20260930
