    (hgs : 5+N+N+N+N ≤ gs) (hds : 5+N+N+N+N ≤ ds)
    (hbankg : rowStart (2*N+N) N ≤ gs) (hbankd : rowStart (2*N+N) N ≤ ds)
    (hpf : ps+N ≤ Sn) (hgf : gs+N ≤ Sn) (hdf : ds+N ≤ Sn)
    (hsep : gs+N ≤ ds ∨ ds+N ≤ gs)
