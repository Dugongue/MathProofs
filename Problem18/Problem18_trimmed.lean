  calc
    _ ≤ (∑i:I,(Nat.card {x : X//Q i x}:ℝ))*w := mul_le_mul_of_nonneg_right hr hw
    _ = ∑i:I,(Nat.card {x : X//Q i x}:ℝ)*w := Finset.sum_mul ..
    _ ≤ ∑_i:I,s := Finset.sum_le_sum (fun i _=>hb i)
    _ = (Nat.card I:ℝ)*s := by simp only [Finset.sum_const,Finset.card_univ,nsmul_eq_mul,Nat.card_eq_fintype_card]
