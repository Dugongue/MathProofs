variable {K V : Type*} [Field K] [Fintype K] [CharP K 2]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
theorem canonical_polynomiallyCyclic (S : Module.End K V)
    (B : LinearMap.BilinForm K V) (hB : B.IsRefl) (hn : B.Nondegenerate)
    (hS : Mathproof.Meta.Problem18SpectralBlocks20260930.IsSelfAdjointFor B S)
    (hs : Squarefree S.charpoly) (w : V) (hw : ∀ x,B w x^2=B x x) :
    PolynomiallyCyclic S w := by
  classical
  obtain ⟨E,c,hc,hE,hform⟩ := squarefree_trace_form S B hB hn hS hs
  let g : FactorIndex S.charpoly → K[X] := fun p => p.val
  letI : ∀ p : FactorIndex S.charpoly,Fact (Irreducible (g p)) :=
    fun p => ⟨factor_irreducible S.charpoly p⟩
  have hcop : Pairwise (fun i j => IsCoprime (g i) (g j)) := by
    intro i j hij
    exact (Mathproof.Problem18PrimaryAssemblyBoundary20260930.factor_coprime_complement
      S g (factor_product S.charpoly S.charpoly_monic hs) hs i).of_prod_right
      j (Finset.mem_erase.mpr ⟨hij.symm,Finset.mem_univ _⟩)
  have hall : ∀ p,(E.symm w) p≠0 := by
    intro p hp
    letI : Field (AdjoinRoot p.val) := inferInstance
    letI : FiniteDimensional K (AdjoinRoot p.val) :=
      (AdjoinRoot.powerBasis (factor_irreducible S.charpoly p).ne_zero).finite
    letI : Algebra.IsSeparable K (AdjoinRoot p.val) := inferInstance
    letI : CharP (AdjoinRoot p.val) 2 := charP_of_injective_algebraMap
      (algebraMap K (AdjoinRoot p.val)).injective 2
    let b := Module.finBasis K (AdjoinRoot p.val)
    letI : Finite (AdjoinRoot p.val) := Finite.of_injective b.equivFun b.equivFun.injective
    have hpair (u : ∀ p : FactorIndex S.charpoly,AdjoinRoot p.val) (z : AdjoinRoot p.val) :
        B (E u) (E (Pi.single p z))=Algebra.trace K (AdjoinRoot p.val) (c p*u p*z) := by
      rw [hform,Finset.sum_eq_single p]
      · rw [Pi.single_eq_same]
      · intro j _ hj
        rw [Pi.single_eq_of_ne hj]
        simp only [mul_zero,map_zero]
      · intro hh
        exact (hh (Finset.mem_univ p)).elim
    have hzero (z : AdjoinRoot p.val) : Algebra.trace K (AdjoinRoot p.val) (c p*z*z)=0 := by
      have hh := hw (E (Pi.single p z))
      have hleft : B w (E (Pi.single p z))=0 := by
        rw [← E.apply_symm_apply w,hpair,hp,mul_zero,zero_mul,map_zero]
      rw [hleft,zero_pow (by decide : 2≠0),hpair,Pi.single_eq_same] at hh
      exact hh.symm
    apply hc p
    apply (traceForm_nondegenerate K (AdjoinRoot p.val)).1
    intro z
    obtain ⟨t,ht⟩ := (Finite.surjective_of_injective
      (f:=fun z : AdjoinRoot p.val => z^2) CharTwo.sq_injective) z
    change t^2=z at ht
    change Algebra.trace K (AdjoinRoot p.val) (c p*z)=0
    rw [← ht,pow_two,← mul_assoc]
    exact hzero t
  have hcyc := (polynomiallyCyclic_iff_primary_nonzero S g hcop E hE (E.symm w)).mpr hall
  rw [LinearEquiv.apply_symm_apply] at hcyc
  exact hcyc
theorem canonicalMarker_polynomiallyCyclic [Finite V] (S : Module.End K V)
    (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hn : B.Nondegenerate)
    (hS : Mathproof.Meta.Problem18SpectralBlocks20260930.IsSelfAdjointFor B S)
    (hs : Squarefree S.charpoly) :
    PolynomiallyCyclic S (Problem18CharTwoMarkedWitt20260929.canonicalVector B hn hB) := by
  apply canonical_polynomiallyCyclic S B hB.isRefl hn hS hs
  intro x
  rw [hB.eq]
  exact (Problem18CharTwoMarkedWitt20260929.canonicalVector_diagonal B hn hB x).symm
end Mathproof.Problem18CharTwoCanonicalCyclic20260930
end
