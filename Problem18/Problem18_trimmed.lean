variable {K : Type*} [Field K] [Fintype K]
theorem exists_equiv_map_eq {n : ℕ} (W W' : Submodule K (Fin n → K))
    (h : Module.finrank K W = Module.finrank K W') :
    ∃ g : (Fin n → K) ≃ₗ[K] (Fin n → K), W.map g.toLinearMap = W' := by
  classical
  let f : W ≃ₗ[K] W' := (FiniteDimensional.nonempty_linearEquiv_of_finrank_eq h).some
  obtain ⟨g, hg⟩ := Submodule.exists_linearEquiv_restrict_eq f
  refine ⟨g, ?_⟩
  ext y
  constructor
  · rintro ⟨x, hx, rfl⟩
    change g x ∈ W'
    rw [← hg ⟨x, hx⟩]
    exact (f ⟨x, hx⟩).property
  · intro hy
    obtain ⟨x, hx⟩ := f.surjective ⟨y, hy⟩
    refine ⟨x, x.property, ?_⟩
    change g x = y
    rw [← hg x]
