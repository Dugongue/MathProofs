        (Problem18DimensionOneBoundary20260930.matrixOf
          (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
            (sortOrder a b c) A hA.first)) τ ∧
      SideOut F (boundaryWidth a b c) (boundaryHeight a b c)
        (F.e+1+F.e*sideN (boundaryWidth a b c) (boundaryHeight a b c))
        (Problem18DimensionOneBoundary20260930.matrixOf
          (Problem18IMPBoundaryOrientationAdapter20261002.sortedBoundaryTensor
            (sortOrder a b c) T hA.first)) τ ∧
      (∀ x ∈ sideRegs, x ≠ sbR → τ.vars x = ρ.vars x) ∧
      (∀ a', a' ≠ canonical.mem → a' ≠ canonical.scratch → τ.arrs a' = ρ.arrs a') ∧
      (τ.arrs canonical.mem).length = (ρ.arrs canonical.mem).length ∧
      (∀ x, x ∉ scalarWrites sides → τ.vars x = ρ.vars x) ∧
      τ.inp = ρ.inp ∧ τ.out = ρ.out := by
