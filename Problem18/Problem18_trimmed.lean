theorem commit_run (r : FieldNames) {B : Nat} (σ : Env)
    (hregs : ∀x∈[r.p,r.e,r.k],x≠r.j)
    (hk : σ.vars r.k=0) (hp : 0<σ.vars r.p)
    (he : σ.vars r.e<B) (hword : (σ.vars r.p+1)^2<B)
    (hmem : (σ.arrs r.scratch).length<B)
    (hfit : 2*σ.vars r.e ≤ (σ.arrs r.scratch).length)
    (hcoeff : ∀j<σ.vars r.e,(σ.arrs r.scratch).getD (σ.vars r.e+j) 0<σ.vars r.p) :
    Run B (storeLoop (workNames r) (.get r.scratch (.add (.var r.e) (.var r.j)))) σ
