variable {K : Type} [Field K] [DecidableEq K] [Fintype K]
abbrev sectionSystem {n : Nat} {E : Type} [Field E] (fs : List (MvPolynomial (Fin n) E))
    (i j : Fin n) (a b : E) : List (MvPolynomial (Fin n) E) :=
  fs ++ [MvPolynomial.X i + MvPolynomial.C a * MvPolynomial.X j - MvPolynomial.C b]
theorem sectionSystem_map {n : Nat} {E F : Type} [Field E] [Field F] (φ : E →+* F)
    (fs : List (MvPolynomial (Fin n) E)) (i j : Fin n) (a b : E) :
    (sectionSystem fs i j a b).map (MvPolynomial.map φ) =
      sectionSystem (fs.map (MvPolynomial.map φ)) i j (φ a) (φ b) := by
  simp only [List.map_append, List.map_cons, List.map_nil, map_sub, map_add, map_mul,
    MvPolynomial.map_X, MvPolynomial.map_C]
theorem geometricIdeal_map_eq {n : Nat} (L : Type) [Field L] [Algebra K L]
    (gs : List (MvPolynomial (Fin n) K)) :
    geometricIdeal (L := L) (systemSet gs) =
      geometricIdeal (K := L) (L := L) (systemSet (gs.map (MvPolynomial.map (algebraMap K L)))) := by
  unfold geometricIdeal
  congr 1
  ext g
  simp only [Set.mem_image, systemSet, Set.mem_setOf_eq, List.mem_map, Algebra.algebraMap_self,
    MvPolynomial.map_id]
  constructor
  · rintro ⟨f, hf, rfl⟩
    exact ⟨_, ⟨f, hf, rfl⟩, rfl⟩
  · rintro ⟨g', ⟨f, hf, rfl⟩, rfl⟩
    exact ⟨f, hf, rfl⟩
theorem degree_reindex {σ τ : Type*} (u : σ → τ) (p : PolyExpr σ ℤ) :
    (reindex u p).degree = p.degree := by
  induction p <;> simp_all [reindex, PolyExpr.degree]
abbrev toSumClause {c₀ : Nat} (cl : Clause (Fin (c₀ + 2)) ℤ) : Clause (Fin c₀ ⊕ Fin 2) ℤ :=
  cl.map fun l => (reindex (fun v => finSumFinEquiv.symm v) l.1, l.2)
theorem toSumClause_length {c₀ : Nat} (cl : Clause (Fin (c₀ + 2)) ℤ) :
    (toSumClause cl).length = cl.length := by simp
theorem clauseHolds_toSumClause {c₀ : Nat} {E : Type} [Field E] (x : Fin c₀ ⊕ Fin 2 → E)
    (cl : Clause (Fin (c₀ + 2)) ℤ) :
    clauseHolds (Int.castRingHom E) x (toSumClause cl) ↔
      clauseHolds (Int.castRingHom E) (x ∘ fun v => finSumFinEquiv.symm v) cl := by
  unfold clauseHolds
  simp only [toSumClause, List.mem_map, forall_exists_index, and_imp, forall_apply_eq_imp_iff₂,
    literalHolds, interpret_reindex]
theorem toSumClause_degree {c₀ : Nat} (cl : Clause (Fin (c₀ + 2)) ℤ) (D : Nat)
    (h : ∀ l ∈ cl, l.1.degree ≤ D) : ∀ l ∈ toSumClause cl, l.1.degree ≤ D := by
  intro l hl
  obtain ⟨l', hl', rfl⟩ := List.mem_map.mp hl
  simp only [degree_reindex]
  exact h l' hl'
theorem clauseHolds_map {σ : Type*} {E F : Type} [Field E] [Field F] (φ : E →+* F)
    (x : σ → E) (cl : Clause σ ℤ) :
    clauseHolds (Int.castRingHom E) x cl ↔ clauseHolds (Int.castRingHom F) (φ ∘ x) cl := by
  unfold clauseHolds
  apply forall₂_congr
  intro l _
  unfold literalHolds
  have h : interpret (Int.castRingHom F) (φ ∘ x) l.1 = φ (interpret (Int.castRingHom E) x l.1) := by
    rw [← polyEval_eq_interpret, ← polyEval_eq_interpret, ← polyEval_hom]
    congr 1
    exact RingHom.ext_int _ _
  rw [h]
  by_cases hb : l.2 = true
  · rw [hb]
    simp only [if_true]
    exact ⟨fun h0 => by rw [h0, map_zero], fun h0 => φ.injective (by simpa using h0)⟩
  · have hfalse : l.2 = false := by simpa using hb
    rw [hfalse]
    simp only [Bool.false_eq_true, if_false]
    exact ⟨fun h0 h1 => h0 (φ.injective (by simpa using h1)), fun h0 h1 => h0 (by rw [h1, map_zero])⟩
structure SectionTemplate (L : Type) [Field L] [Algebra K L] (n d r c₀ : Nat) where
  encode : List (MvPolynomial (Fin n) K) → Fin c₀ → K
  template : Fin n → Fin n → Formula ℤ (c₀ + 2)
  degreeBound : Nat
  template_degree : ∀ (i j : Fin n), ∀ cl ∈ clauses (qe (template i j)), ∀ l ∈ cl,
    l.1.degree ≤ degreeBound
  clauseBound : Nat
  template_clauses : ∀ (i j : Fin n), ∀ cl ∈ clauses (qe (template i j)), cl.length ≤ clauseBound
  semantics : ∀ (E : Type) [Field E] [Algebra K E] [IsAlgClosed E]
    (fs : List (MvPolynomial (Fin n) K)), Bounded d fs → ∀ (i j : Fin n) (a b : E),
    (template i j).Holds (Int.castRingHom E)
        ((Sum.elim (algebraMap K E ∘ encode fs) ![a, b]) ∘ fun v => finSumFinEquiv.symm v) ↔
      IrredDim (K := E) E (sectionSystem (fs.map (MvPolynomial.map (algebraMap K E))) i j a b) (r - 1)
end Mathproof.Problem18ClaudeSectionStep20261001
