  · rw [if_neg hz, truncation_positive (Nat.pos_of_ne_zero hz), hk.neg_one_pow]
    simp only [one_mul, zero_add]
    constructor
    · positivity
    · have hc : (z-1).choose k ≤ z.choose (k+1) := by
        have h := Nat.choose_succ_succ (z-1) k
        simp only [Nat.succ_eq_add_one] at h
        rw [Nat.sub_add_cancel (Nat.pos_of_ne_zero hz)] at h
