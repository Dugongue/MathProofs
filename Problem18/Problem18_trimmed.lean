  ext i j
  simp only [decodeMatrix,mget,matrixMul,Vector.getElem_ofFn,Fin.eta,Equiv.symm_apply_apply]
  rw [sum_decode F _ (by intro v hv; obtain ⟨k,rfl⟩:=List.mem_ofFn.mp hv; exact mul_canonical F _ _)]
