  · exact Nat.mul_le_mul_left _ hbbaa
  · exact Nat.mul_le_mul_left _ (by omega)
  · nlinarith
  · have : 1 ≤ s ^ 6 := Nat.one_le_pow _ _ hs1
    have : b * b ≤ s ^ 8 := by omega
    nlinarith
  · have : b * b * (a * a) ≤ s ^ 8 := by omega
    have : a * a ≤ s ^ 8 := by omega
    nlinarith
