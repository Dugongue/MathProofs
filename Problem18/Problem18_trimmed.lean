variable {K V W Z : Type*} [Field K]
  [AddCommGroup V] [Module K V] [FiniteDimensional K V]
  [AddCommGroup W] [Module K W] [FiniteDimensional K W]
  [AddCommGroup Z] [Module K Z] [FiniteDimensional K Z]
theorem conjugate_kernel_coordinates
    (B : LinearMap.BilinForm K V) (C : LinearMap.BilinForm K W)
    (H : LinearMap.BilinForm K Z) (e : (V×W) ≃ₗ[K] Z)
    (he : ∀ x y,H (e x) (e y)=B x.1 y.1+C x.2 y.2)
    (R : Module.End K V) (D : Module.End K W) (hc : IsCoprime R.charpoly D.charpoly) :
    ∃ j : V ≃ₗ[K] LinearMap.ker (aeval (e.conj (R.prodMap D)) R.charpoly),
      ∀ x y,H (j x).val (j y).val=B x y := by
  let f := e.toLinearMap.comp (LinearMap.inl K V W)
  have hf : Function.Injective f := by
    intro x y h
    have hh := e.injective h
    exact congrArg Prod.fst hh
  have hr : LinearMap.range f=LinearMap.ker (aeval (e.conj (R.prodMap D)) R.charpoly) :=
    (conjugate_primary_kernel R D e hc).symm
  let j := (LinearEquiv.ofInjective f hf).trans (LinearEquiv.ofEq _ _ hr)
  refine ⟨j,?_⟩
  intro x y
  change H (e (x,0)) (e (y,0))=B x y
  simpa only [map_zero,add_zero] using he (x,0) (y,0)
theorem marking_of_kernel_coordinates
    (B : LinearMap.BilinForm K V) (C : LinearMap.BilinForm K W)
    (T : SelfAdjointOperators (RingEquiv.refl K) (sumForm (RingEquiv.refl K) B C))
    (p q : K[X]) (hp : p.Monic) (hq : q.Monic) (hc : IsCoprime p q)
    (hχ : T.val.charpoly=p*q)
    (e : V ≃ₗ[K] LinearMap.ker (aeval T.val p))
    (k : W ≃ₗ[K] LinearMap.ker (aeval T.val q))
    (he : ∀ x y,(sumForm (RingEquiv.refl K) B C) (e x).val (e y).val=B x y)
    (hk : ∀ x y,(sumForm (RingEquiv.refl K) B C) (k x).val (k y).val=C x y) :
    Nonempty (SpectralMarkings (RingEquiv.refl K) B C p T) := by
  let H := sumForm (RingEquiv.refl K) B C
  let U := LinearMap.ker (aeval T.val p)
  let Z := LinearMap.ker (aeval T.val q)
  let E := Submodule.prodEquivOfIsCompl U Z (isCompl_primarySpaces_of_charpoly_eq_mul hc hχ)
  have hE (x y : U×Z) : H (E x) (E y)=H x.1.val y.1.val+H x.2.val y.2.val := by
    change H (x.1.val+x.2.val) (y.1.val+y.2.val)=_
    have hfg : H x.1.val y.2.val=0 := coprime_kernels_pairing_eq_zero T.property hc x.1.property y.2.property
    have hgf : H x.2.val y.1.val=0 := coprime_kernels_pairing_eq_zero T.property hc.symm x.2.property y.1.property
    simp only [map_add,LinearMap.add_apply,hfg,hgf,add_zero,zero_add]
  let Q : Isometries (RingEquiv.refl K) H := ⟨(e.prodCongr k).trans E,by
    intro x y
    rw [LinearEquiv.trans_apply,LinearEquiv.trans_apply,hE]
    exact congrArg₂ (·+·) (he x.1 y.1) (hk x.2 y.2)⟩
  let R := T.val.restrict (primary_kernel_invariant T.val p)
  let S : SelfAdjointOperators (RingEquiv.refl K) B := ⟨e.symm.conj R,by
    intro x y
    rw [←he,←he]
    change H (e (e.symm (R (e x)))).val (e y).val=H (e x).val (e (e.symm (R (e y)))).val
    rw [e.apply_symm_apply,e.apply_symm_apply]
    exact T.property (e x).val (e y).val⟩
  let j := restrictionToOrbit (RingEquiv.refl K) B C Q
  refine ⟨⟨j,⟨S,?_,?_⟩⟩⟩
  · change (e.symm.conj R).charpoly=p
    rw [LinearEquiv.charpoly_conj]
    exact coprime_primary_charpoly T.val p q hp hq hc hχ
  · intro x
    have hj (z : V) : j.val z=(e z).val := by
      change E (e z,k 0)=(e z).val
      rw [map_zero]
      change (e z).val+0=(e z).val
      exact add_zero _
    rw [hj,hj]
    change T.val (e x).val=(e (e.symm (R (e x)))).val
    rw [e.apply_symm_apply]
    rfl
theorem kernel_coordinates_of_marking
    (B : LinearMap.BilinForm K V) (C : LinearMap.BilinForm K W) (hB : B.SeparatingLeft)
    (T : SelfAdjointOperators (RingEquiv.refl K) (sumForm (RingEquiv.refl K) B C))
    (p : K[X]) (hc : IsCoprime p (T.val.charpoly/p))
    (M : SpectralMarkings (RingEquiv.refl K) B C p T) :
    (∃ e : V ≃ₗ[K] LinearMap.ker (aeval T.val p),
      ∀ x y,(sumForm (RingEquiv.refl K) B C) (e x).val (e y).val=B x y) ∧
    (∃ k : W ≃ₗ[K] LinearMap.ker (aeval T.val (T.val.charpoly/p)),
      ∀ x y,(sumForm (RingEquiv.refl K) B C) (k x).val (k y).val=C x y) := by
  let σ := RingEquiv.refl K
  let Q : Isometries σ (sumForm σ B C) := Classical.choose M.1.property
  let N : MarkedFiber σ B C M.2.val M.1.val := ⟨T,M.2.property.2⟩
  let D := markedFiberEquiv σ B C hB M.2.val M.1 N
  have hT : T.val=Q.val.conj (M.2.val.val.prodMap D.val) := by
    have hh := congrArg (fun U : MarkedFiber σ B C M.2.val M.1.val=>U.val.val)
      ((markedFiberEquiv σ B C hB M.2.val M.1).symm_apply_apply N)
    exact hh.symm
  have hD : T.val.charpoly/p=D.val.charpoly := by
    rw [markedFiber_charpoly σ B C hB M.2.val M.1 N,M.2.property.1,
      mul_div_cancel_left₀ _ (M.2.property.1 ▸ M.2.val.val.charpoly_monic.ne_zero)]
  have hcop : IsCoprime M.2.val.val.charpoly D.val.charpoly := by
    rw [M.2.property.1,←hD]
    exact hc
  constructor
  · obtain ⟨j,hj⟩ := conjugate_kernel_coordinates B C (sumForm σ B C) Q.val Q.property
      M.2.val.val D.val hcop
    have hk : LinearMap.ker (aeval (Q.val.conj (M.2.val.val.prodMap D.val)) M.2.val.val.charpoly)=
        LinearMap.ker (aeval T.val p) :=
      congrArg LinearMap.ker (congrArg₂ (fun (R : Module.End K (V×W)) (f : K[X])=>aeval R f)
        hT.symm M.2.property.1)
    refine ⟨j.trans (LinearEquiv.ofEq _ _ hk),fun x y=>?_⟩
    simpa only [LinearEquiv.trans_apply,LinearEquiv.coe_ofEq_apply] using hj x y
  · let Q' := (LinearEquiv.prodComm K W V).trans Q.val
    have hQ' (x y : W×V) : (sumForm σ B C) (Q' x) (Q' y)=C x.1 y.1+B x.2 y.2 := by
      change (sumForm σ B C) (Q.val (x.2,x.1)) (Q.val (y.2,y.1))=_
      rw [Q.property,sumForm_apply,add_comm]
    have hT' : Q'.conj (D.val.prodMap M.2.val.val)=T.val := by
      calc
        _=Q.val.conj (M.2.val.val.prodMap D.val) := by apply LinearMap.ext; intro x; rfl
        _=T.val := hT.symm
    obtain ⟨j,hj⟩ := conjugate_kernel_coordinates C B (sumForm σ B C) Q' hQ' D.val M.2.val.val hcop.symm
    have hk : LinearMap.ker (aeval (Q'.conj (D.val.prodMap M.2.val.val)) D.val.charpoly)=
        LinearMap.ker (aeval T.val (T.val.charpoly/p)) :=
      congrArg LinearMap.ker (congrArg₂ (fun (R : Module.End K (V×W)) (f : K[X])=>aeval R f)
        hT' hD.symm)
    refine ⟨j.trans (LinearEquiv.ofEq _ _ hk),fun x y=>?_⟩
    simpa only [LinearEquiv.trans_apply,LinearEquiv.coe_ofEq_apply] using hj x y
end
