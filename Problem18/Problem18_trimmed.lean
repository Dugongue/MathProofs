variable {K : Type*} [Field K] [Fintype K]
theorem finite_rank_map_ringEquiv {n m : ℕ}
    (A : Matrix (Fin n) (Fin m) K) (e : K ≃+* K) :
    (A.map e).rank = A.rank := by
  classical
  have hm (f : K ≃+* K) (B : Matrix (Fin n) (Fin m) K) (x : Fin m → K) :
      (B.map f) *ᵥ (f ∘ x) = f ∘ (B *ᵥ x) := by
    ext i
    simp [Matrix.mulVec, dotProduct, Matrix.map_apply, Function.comp_def]
  let E : LinearMap.ker A.mulVecLin ≃ LinearMap.ker (A.map e).mulVecLin :=
    { toFun := fun x => ⟨e ∘ x.val, by
        change (A.map e) *ᵥ (e ∘ x.val) = 0
        rw [hm]
        have hx : A *ᵥ x.val = 0 := x.property
        rw [hx]
        ext i
        simp⟩
      invFun := fun y => ⟨e.symm ∘ y.val, by
        have hy : (A.map e) *ᵥ y.val = 0 := y.property
        have hh := hm e.symm (A.map e) y.val
        rw [hy] at hh
        simpa [Matrix.map_map, Function.comp_def, Pi.zero_def] using hh⟩
      left_inv := by intro x; ext i; simp
      right_inv := by intro x; ext i; simp }
  have hk : finrank K (LinearMap.ker A.mulVecLin) =
      finrank K (LinearMap.ker (A.map e).mulVecLin) := by
    apply Nat.pow_right_injective (show 2 ≤ Nat.card K from Finite.one_lt_card)
    change Nat.card K ^ finrank K (LinearMap.ker A.mulVecLin) =
      Nat.card K ^ finrank K (LinearMap.ker (A.map e).mulVecLin)
    rw [← Module.natCard_eq_pow_finrank, ← Module.natCard_eq_pow_finrank]
    exact Nat.card_congr E
  have h₁ := LinearMap.finrank_range_add_finrank_ker A.mulVecLin
  have h₂ := LinearMap.finrank_range_add_finrank_ker (A.map e).mulVecLin
  change A.rank + _ = _ at h₁
  change (A.map e).rank + _ = _ at h₂
  omega
theorem finite_rank_conjTranspose [StarRing K] {n m : ℕ}
    (A : Matrix (Fin n) (Fin m) K) : Aᴴ.rank = A.rank := by
  calc
    Aᴴ.rank = Aᵀ.rank := finite_rank_map_ringEquiv Aᵀ (starRingAut : K ≃+* K)
    _ = A.rank := Matrix.rank_transpose A
theorem hermitian_restriction_rank_loss [StarRing K] {n m : ℕ}
    (A : Matrix (Fin n) (Fin n) K) (hA : A.IsHermitian)
    (X : Matrix (Fin n) (Fin m) K) :
    A.rank ≤ (Xᴴ * A * X).rank +
      2 * finrank K ↥(LinearMap.range A.mulVecLin ⊓ LinearMap.ker Xᴴ.mulVecLin) := by
  have h₁ := finrank_comp_add_intersection Xᴴ.mulVecLin A.mulVecLin
  have h₂ := finrank_comp_add_intersection Xᴴ.mulVecLin (A * X).mulVecLin
  have hle : LinearMap.range (A * X).mulVecLin ≤ LinearMap.range A.mulVecLin := by
    rw [Matrix.mulVecLin_mul]
    exact LinearMap.range_comp_le_range _ _
  have hi := Submodule.finrank_mono (inf_le_inf_right (LinearMap.ker Xᴴ.mulVecLin) hle)
  have ht : (A * X).rank = (Xᴴ * A).rank := by
    rw [← finite_rank_conjTranspose (A * X), Matrix.conjTranspose_mul, hA.eq]
  rw [← Matrix.mulVecLin_mul] at h₁ h₂
  change (Xᴴ * A).rank + _ = A.rank at h₁
  change (Xᴴ * (A * X)).rank + _ = (A * X).rank at h₂
  rw [← Matrix.mul_assoc, ht] at h₂
  omega
theorem kernel_parameterization_unitary_annihilator [StarRing K] {n m d : ℕ}
    (M : Matrix (Fin d) (Fin n) K) (X : Matrix (Fin n) (Fin m) K)
    (hX : LinearMap.range X.mulVecLin = LinearMap.ker M.mulVecLin) :
    LinearMap.ker Xᴴ.mulVecLin = LinearMap.range Mᴴ.mulVecLin := by
  have hMX : M * X = 0 := by
    apply Matrix.toLin'.injective
    apply LinearMap.ext
    intro v
    simp only [Matrix.toLin'_apply', Matrix.mulVecLin_apply, Matrix.zero_mulVec]
    change (M * X) *ᵥ v = 0
    rw [← Matrix.mulVec_mulVec]
    exact hX.le ⟨v, rfl⟩
  have ht : Xᴴ * Mᴴ = 0 := by
    simpa only [Matrix.conjTranspose_mul, Matrix.conjTranspose_zero] using
      congrArg Matrix.conjTranspose hMX
  have hle : LinearMap.range Mᴴ.mulVecLin ≤ LinearMap.ker Xᴴ.mulVecLin := by
    rintro v ⟨w, rfl⟩
    change Xᴴ *ᵥ (Mᴴ *ᵥ w) = 0
    rw [Matrix.mulVec_mulVec, ht, Matrix.zero_mulVec]
  symm
  apply Submodule.eq_of_le_of_finrank_eq hle
  have h₁ := LinearMap.finrank_range_add_finrank_ker Xᴴ.mulVecLin
  have h₂ := LinearMap.finrank_range_add_finrank_ker M.mulVecLin
  change Xᴴ.rank + _ = _ at h₁
  change M.rank + _ = _ at h₂
  rw [finite_rank_conjTranspose] at h₁
  have hx : X.rank = finrank K (LinearMap.ker M.mulVecLin) := by
    unfold Matrix.rank
    rw [hX]
  change Mᴴ.rank = _
  rw [finite_rank_conjTranspose]
  omega
end Mathproof.Problem18UnitaryRestrictionRank20260930
