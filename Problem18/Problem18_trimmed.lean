  value : decode F (slice F τ canonical (σ.vars acc))=
    decode F (slice F σ canonical (σ.vars acc))+∑i∈Finset.range (τ.vars index),term F σ i
theorem body_run {B : Nat} {σ ρ : Env} (h : Input F B σ) (hρ : Invariant F B σ ρ)
    (hi : ρ.vars index<σ.vars count) :
    ∃τ, Run B body ρ τ (34+10000*(F.e+1)^2+2000*(F.e+1)) ∧
