theorem parameters_bounded {B base a b c e : Nat} (o : Order)
    (ha : 0<a) (hb : 0<b) (hc : 0<c) (he : 0<e)
    (hB : base+a*b*c*e<B) : (parameters base o a b c e).bounded B := by
  have hN : a*b*c*e<B := by omega
  have hbB : base<B := by omega
  have hbe : b*e≤a*b*c*e := by
    simpa [Nat.mul_comm,Nat.mul_assoc,Nat.mul_left_comm] using
      Nat.le_mul_of_pos_left (b*e) (Nat.mul_pos ha hc)
  have habe : a*b*e≤a*b*c*e := by
    simpa [Nat.mul_comm,Nat.mul_assoc,Nat.mul_left_comm] using
      Nat.le_mul_of_pos_left (a*b*e) hc
  have heN : e≤a*b*c*e := Nat.le_mul_of_pos_left e (Nat.mul_pos (Nat.mul_pos ha hb) hc)
  have haN : a≤a*b*c*e := by
    simpa [Nat.mul_assoc] using Nat.le_mul_of_pos_right a (Nat.mul_pos (Nat.mul_pos hb hc) he)
  have hbN : b≤a*b*c*e := by
    simpa [Nat.mul_comm,Nat.mul_assoc,Nat.mul_left_comm] using
      Nat.le_mul_of_pos_left b (Nat.mul_pos (Nat.mul_pos ha hc) he)
  have hcN : c≤a*b*c*e := by
    simpa [Nat.mul_comm,Nat.mul_assoc,Nat.mul_left_comm] using
      Nat.le_mul_of_pos_left c (Nat.mul_pos (Nat.mul_pos ha hb) he)
  cases o <;> simp only [Parameters.bounded,parameters,strides,shape] <;>
    exact ⟨hbB,heN.trans_lt hN,by omega,by omega,by omega,by omega,by omega⟩
theorem offset_div {a b e : Nat} (he : 0<e) (k i j : Nat) (t : Fin e) :
    offset a b e k i j t.val/e=(k*a+i)*b+j := by
  unfold offset
  rw [Nat.add_comm, Nat.add_mul_div_right _ _ he, Nat.div_eq_of_lt t.isLt]
  simp
theorem parameters_at_entry (base : Nat) (o : Order) (a b c e : Nat)
    (k : Fin (shape o a b c).2.2) (i : Fin (shape o a b c).1)
    (j : Fin (shape o a b c).2.1) (t : Fin e) :
    (parameters base o a b c e).at
      (offset (shape o a b c).1 (shape o a b c).2.1 e k.val i.val j.val t.val) =
    base+offset a b e (originalIndex o k i j).1.val
      (originalIndex o k i j).2.1.val (originalIndex o k i j).2.2.val t.val := by
  have he : 0<e := Nat.zero_lt_of_lt t.isLt
  have ha : 0<(shape o a b c).1 := Nat.zero_lt_of_lt i.isLt
  have hb : 0<(shape o a b c).2.1 := Nat.zero_lt_of_lt j.isLt
  have hd := offset_div (a:=(shape o a b c).1) (b:=(shape o a b c).2.1) he k.val i.val j.val t
  have hd' : ((k.val*(shape o a b c).1+i.val)*(shape o a b c).2.1+j.val)/
      (shape o a b c).2.1=k.val*(shape o a b c).1+i.val := by
    rw [Nat.add_comm,Nat.add_mul_div_right _ _ hb,Nat.div_eq_of_lt j.isLt]; simp
  have hd'' : (k.val*(shape o a b c).1+i.val)/(shape o a b c).1=k.val := by
    rw [Nat.add_comm,Nat.add_mul_div_right _ _ ha,Nat.div_eq_of_lt i.isLt]; simp
  have ht : offset (shape o a b c).1 (shape o a b c).2.1 e k.val i.val j.val t.val%e=t.val :=
    Nat.mul_add_mod_of_lt t.isLt
  have hj : ((k.val*(shape o a b c).1+i.val)*(shape o a b c).2.1+j.val)%
      (shape o a b c).2.1=j.val := Nat.mul_add_mod_of_lt j.isLt
  have hi : (k.val*(shape o a b c).1+i.val)%(shape o a b c).1=i.val :=
    Nat.mul_add_mod_of_lt i.isLt
  simp only [Parameters.at,parameters,sourceIndex,hd,hd',hd'',ht,hj,hi]
  cases o <;> simp [strides,originalIndex,offset] <;> ring
theorem offset_surjective {a b c e x : Nat}
    (ha : 0<a) (hb : 0<b) (he : 0<e) (hx : x<a*b*c*e) :
    ∃ (k : Fin c) (i : Fin a) (j : Fin b) (t : Fin e),
      offset a b e k.val i.val j.val t.val=x := by
  have hx' : x/e<c*a*b := by
    apply (Nat.div_lt_iff_lt_mul he).mpr
    simpa [Nat.mul_comm,Nat.mul_assoc,Nat.mul_left_comm] using hx
  have hx'' : x/e/b<c*a := (Nat.div_lt_iff_lt_mul hb).mpr hx'
  have hx''' : x/e/b/a<c := (Nat.div_lt_iff_lt_mul ha).mpr hx''
  refine ⟨⟨_,hx'''⟩,⟨_,Nat.mod_lt (x/e/b) ha⟩,⟨_,Nat.mod_lt (x/e) hb⟩,
    ⟨_,Nat.mod_lt x he⟩,?_⟩
  simp only [offset,Nat.div_add_mod']
theorem parameters_at_lt (base : Nat) (o : Order) {a b c e : Nat}
    (ha : 0<a) (hb : 0<b) (hc : 0<c) (he : 0<e) {x : Nat} (hx : x<a*b*c*e) :
    (parameters base o a b c e).at x<base+a*b*c*e := by
  obtain ⟨ha',hb',_⟩ := shape_positive o ha hb hc
  have hx' : x<(shape o a b c).1*(shape o a b c).2.1*(shape o a b c).2.2*e := by
    rwa [shape_product]
  obtain ⟨k,i,j,t,rfl⟩ := offset_surjective ha' hb' he hx'
  rw [parameters_at_entry]
  have h := offset_lt (originalIndex o k i j).1 (originalIndex o k i j).2.1
    (originalIndex o k i j).2.2 t
  have h' : offset a b e (originalIndex o k i j).1.val
      (originalIndex o k i j).2.1.val (originalIndex o k i j).2.2.val t.val<a*b*c*e := by
    simpa [Nat.mul_comm,Nat.mul_assoc,Nat.mul_left_comm] using h
  omega
theorem tensorCoordinates_length {K : Type} [Field K] (F : FieldPresentation K)
    {a b c : Nat} (A : RectTensor a b c K) :
    (tensorCoordinates F A).length=a*b*c*F.e := by
  simp [tensorCoordinates,List.length_flatMap,Nat.mul_comm,Nat.mul_assoc,Nat.mul_left_comm]
theorem cells_tensorCoordinates {K : Type} [Field K] (F : FieldPresentation K)
    (σ : Env) (base : Nat) (o : Order) {a b c : Nat}
    (ha : 0<a) (hb : 0<b) (hc : 0<c) (A : RectTensor a b c K)
    (hmem : ∀x<a*b*c*F.e,(σ.arrs memory).getD (base+x) 0=(tensorCoordinates F A).getD x 0) :
    cells (parameters base o a b c F.e) σ (a*b*c*F.e)=tensorCoordinates F (tensorEquiv o A) := by
  apply List.ext_getElem
  · simp [cells,tensorCoordinates_length,shape_product]
  · intro x hx hy
    have hx' : x<a*b*c*F.e := by simpa [cells] using hx
    have hx'' : x<(shape o a b c).1*(shape o a b c).2.1*(shape o a b c).2.2*F.e := by
      rwa [shape_product]
    obtain ⟨ha',hb',_⟩ := shape_positive o ha hb hc
    obtain ⟨k,i,j,t,heq⟩ := offset_surjective ha' hb' F.degree_pos hx''
    rw [←List.getD_eq_getElem _ 0 hx,←List.getD_eq_getElem _ 0 hy]
    rw [cells_getD _ _ _ _ hx',←heq,parameters_at_entry]
    have h := offset_lt (originalIndex o k i j).1 (originalIndex o k i j).2.1
      (originalIndex o k i j).2.2 t
    rw [hmem _ (by simpa [Nat.mul_comm,Nat.mul_assoc,Nat.mul_left_comm] using h)]
    rw [tensorCoordinates_getD,tensorCoordinates_getD,tensorEquiv_apply]
