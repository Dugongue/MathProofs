      Finset.univ.filter (fun d : Fin n → K =>
        ‖(∑ x : S, ψ (completion Q d x)) / (Fintype.card S : ℂ)‖^2 ≠ 0) := by
    intro d hd
    have hn := (Finset.mem_filter.mp hd).2
    have hone (h : S) : ψ (completion Q d h) = 1 := by
