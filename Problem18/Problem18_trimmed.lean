  have hf (W : G) : Nat.card {A : S // f A = W} ≤ Nat.card (SymMat r K) := by
    let g : {A : S // f A = W} →
        {A : SymMat n K // LinearMap.range A.val.mulVecLin ≤ W.val} := fun A =>
      ⟨A.val.val, (congrArg Subtype.val A.property).le⟩
    have hg : Function.Injective g := by
      intro A B h
      apply Subtype.ext
      apply Subtype.ext
      apply Subtype.ext
      simpa only [g] using congrArg (fun z => z.val.val) h
    exact (Nat.card_le_card_of_injective g hg).trans
      (symmetric_image_card_le W.val W.property)
