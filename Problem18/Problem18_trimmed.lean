def sdeg : SizeExpr → Nat
  | .lit _ => 0
  | .dim => 1
  | .degree => 1
  | .add a b => max (sdeg a) (sdeg b)
  | .mul a b => sdeg a+sdeg b
theorem majorant_le (s : SizeExpr) {n e X : Nat} (hX : 1 ≤ X) (hn : n+1 ≤ X)
    (he : e+1 ≤ X) : majorant s n e ≤ majorant s 0 0*X^(sdeg s) := by
  induction s with
  | lit c => simp [majorant,sdeg]
  | dim => simpa [majorant,sdeg] using hn
  | degree => simpa [majorant,sdeg] using he
  | add a b iha ihb => exact pb_add hX iha ihb
  | mul a b iha ihb => exact pb_mul iha ihb
theorem succ_le_two_pow (N : Nat) : N+1 ≤ 2^N := Nat.lt_two_pow_self
theorem lt_word {Q c d N : Nat} (h : Q ≤ c*(N+1)^d) (hc : c ≤ 2^400) (hd : d ≤ 100) :
    Q < 2^(1000000000*(N+1)^10+N+1) := by
  have hX : (N+1)^d ≤ 2^(N*d) := by
    rw [Nat.pow_mul]
    exact Nat.pow_le_pow_left (succ_le_two_pow N) d
  have h1 : Q ≤ 2^(400+N*d) := by
    rw [Nat.pow_add]
    exact h.trans (Nat.mul_le_mul hc hX)
  have h10 : N+1 ≤ (N+1)^10 := by
    calc N+1 = (N+1)^1 := (Nat.pow_one _).symm
      _ ≤ (N+1)^10 := Nat.pow_le_pow_right (by omega) (by norm_num)
  have hexp : 400+N*d < 1000000000*(N+1)^10+N+1 := by
    have : N*d ≤ N*100 := Nat.mul_le_mul_left _ hd
    nlinarith
  exact h1.trans_lt (Nat.pow_lt_pow_right (by norm_num) hexp)
