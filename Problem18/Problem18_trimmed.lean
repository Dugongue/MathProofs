    (by
      intro B C h
      exact (determinantClass_eq_iff_isometry hodd B.val C.val (Pi.basisFun K _) (Pi.basisFun K _)
        B.property.1 C.property.1 B.property.2 C.property.2).mpr h)
theorem odd_class_card_le_two (hodd : ringChar K≠2) (n : ℕ) : Nat.card (FormClass K n)≤2 := by
  have hi : Function.Injective (determinantClassMap K hodd (n:=n)) := by
    intro c d
    refine Quotient.inductionOn₂ c d ?_
    intro B C h
    apply Quotient.sound
    exact (determinantClass_eq_iff_isometry hodd B.val C.val (Pi.basisFun K _) (Pi.basisFun K _)
      B.property.1 C.property.1 B.property.2 C.property.2).mp h
