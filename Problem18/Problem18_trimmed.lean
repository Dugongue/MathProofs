variable {K : Type} [Field K] [Fintype K] [StarRing K] {b c : ℕ}
theorem gram_det_ne_zero_ker (A : Matrix (Fin c) (Fin b) K) (hA : (Aᴴ*A).det≠0) :
    LinearMap.ker A.toLin'=⊥ := by
  apply LinearMap.ker_eq_bot.mpr
  intro x y hxy
  have hi : Function.Injective (fun v => (Aᴴ*A)*ᵥv) :=
    Matrix.mulVec_injective_iff_isUnit.mpr
      ((Matrix.isUnit_iff_isUnit_det _).mpr (isUnit_iff_ne_zero.mpr hA))
  apply hi
  change (Aᴴ*A)*ᵥx=(Aᴴ*A)*ᵥy
  rw [← Matrix.mulVec_mulVec,← Matrix.mulVec_mulVec]
  exact congrArg (fun z => Aᴴ*ᵥz) hxy
theorem hermitian_standard_selfAdjoint (M : Matrix (Fin b) (Fin b) K) (hM : M.IsHermitian) :
    Mathproof.Meta.Problem18HermitianSpectral20260930.IsSelfAdjointFor
      (starRingAut : K ≃+* K) (standardHermitian b) M.toLin' := by
  intro x y
  have hh : star (M*ᵥx) ⬝ᵥ y=star x ⬝ᵥ (M*ᵥy) := by
    rw [Matrix.star_mulVec,← Matrix.dotProduct_mulVec,hM.eq]
  exact (standardHermitian_apply _ _).trans (hh.trans (standardHermitian_apply _ _).symm)
variable {k : Type*} [Field k] [Fintype k] [Algebra k K]
theorem regular_unitary_equivalence_iff_charpoly
    (hcard : Nat.card K=Nat.card k^2) (hstar : ∀ x : K,star x=x^Nat.card k)
    (F G : Matrix (Fin c) (Fin b) K) (hF : UnitaryGood F) (hG : UnitaryGood G) :
    MatrixUnitaryEquivalent F G ↔ (Fᴴ*F).charpoly=(Gᴴ*G).charpoly := by
  constructor
  · rintro ⟨R,Q,hR,hQ,rfl⟩
    exact (unitary_gram_charpoly F R Q hR hQ).symm
  · intro hχ
    let H := standardHermitian (K:=K) b
    have hH : ∀ x y,H x y=(starRingAut : K ≃+* K) (H y x) := by
      intro x y
      exact ((standardHermitian_symm (K:=K) b).eq y x).symm
    have hσ : Function.Involutive (starRingAut : K ≃+* K) := fun x => star_star x
    have hne := quadratic_star_ne_one hcard hstar
    have hS := hermitian_standard_selfAdjoint (Gᴴ*G) (Matrix.isHermitian_conjTranspose_mul_self G)
    have hR := hermitian_standard_selfAdjoint (Fᴴ*F) (Matrix.isHermitian_conjTranspose_mul_self F)
    have hs : Squarefree (Gᴴ*G).toLin'.charpoly := by simpa only [Matrix.charpoly_toLin'] using hG.2
    have hc : (Gᴴ*G).toLin'.charpoly=(Fᴴ*F).toLin'.charpoly := by
      simpa only [Matrix.charpoly_toLin'] using hχ.symm
    have hfix : (Gᴴ*G).toLin'.charpoly.map (starRingAut : K ≃+* K).toRingHom=(Gᴴ*G).toLin'.charpoly := by
      rw [Matrix.charpoly_toLin']
      exact hermitian_charpoly_fixed (Gᴴ*G) (Matrix.isHermitian_conjTranspose_mul_self G)
    obtain ⟨T,hT,hform⟩ := squarefree_hermitian_operator_isometry
      (starRingAut : K ≃+* K) hσ hne H H hH hH
      (standardHermitian_separating b) (standardHermitian_separating b)
      (Gᴴ*G).toLin' (Fᴴ*F).toLin' hS hR hs hc hfix
    let Q : Matrix (Fin b) (Fin b) K := T.toLinearMap.toMatrix'
    have hQx (x : Fin b→K) : Q*ᵥx=T x := by
      change (Matrix.toLin' T.toLinearMap.toMatrix') x=T x
      rw [Matrix.toLin'_toMatrix']
      rfl
    have hQ : Problem18Assembly.IsUnitary Q := by
      have hh := (gram_eq_iff_pairing_eq Q (1:Matrix (Fin b) (Fin b) K)).mp (by
        intro x y
        simpa only [hQx,Matrix.one_mulVec] using hform x y)
      simpa [Problem18Assembly.IsUnitary] using hh
    have hcomm : Q*(Gᴴ*G)=(Fᴴ*F)*Q := by
      apply Matrix.toLin'.injective
      apply LinearMap.ext
      intro x
      change (Q*(Gᴴ*G))*ᵥx=((Fᴴ*F)*Q)*ᵥx
      calc
        (Q*(Gᴴ*G))*ᵥx=Q*ᵥ((Gᴴ*G)*ᵥx) := (Matrix.mulVec_mulVec _ _ _).symm
        _=T ((Gᴴ*G)*ᵥx) := hQx _
        _=(Fᴴ*F)*ᵥ(T x) := hT x
        _=((Fᴴ*F)*Q)*ᵥx := by rw [← hQx,Matrix.mulVec_mulVec]
    have hgram : Qᴴ*(Fᴴ*F)*Q=Gᴴ*G := by
      rw [Matrix.mul_assoc,← hcomm,← Matrix.mul_assoc,
        show Qᴴ*Q=1 from hQ,Matrix.one_mul]
    have hFQ : (F*Q)ᴴ*(F*Q)=Gᴴ*G := by
      simpa only [Matrix.conjTranspose_mul,Matrix.mul_assoc] using hgram
    have hker : LinearMap.ker (F*Q).toLin'=LinearMap.ker G.toLin' := by
      rw [gram_det_ne_zero_ker (F*Q) (by rw [hFQ]; exact hG.1),gram_det_ne_zero_ker G hG.1]
    exact (unitary_boundary_recovery hcard hstar F G).mpr ⟨Q,hQ,hker,hgram⟩
theorem unitary_boundary_iff_checks
    (hcard : Nat.card K=Nat.card k^2) (hstar : ∀ x : K,star x=x^Nat.card k)
    (F G : Matrix (Fin c) (Fin b) K) (hF : UnitaryGood F) :
    MatrixUnitaryEquivalent F G ↔ UnitaryGood G ∧ (Fᴴ*F).charpoly=(Gᴴ*G).charpoly := by
  constructor
  · intro h
    have hG := (unitary_good_invariant F G h).mp hF
    exact ⟨hG,(regular_unitary_equivalence_iff_charpoly hcard hstar F G hF hG).mp h⟩
  · rintro ⟨hG,hχ⟩
    exact (regular_unitary_equivalence_iff_charpoly hcard hstar F G hF hG).mpr hχ
end Mathproof.Problem18UnitaryBoundaryDecision20260930
