  have hI0 : I (digitState r σ WS w k base mv p 0) := ⟨0, Nat.zero_le _, rfl⟩
  obtain ⟨τ, hrunW, ⟨i, hi, rfl⟩, hfalse⟩ :=
    Run.while_count (B := B) (b := Cond.lt (.var k) len) (c := digitBody r WS w k s) I V
      (s.size + 22) hdef hstep hI0
  have hie : i = L := by
    rw [evalB_condLt (evalB_var_of (hkv i) (by omega)) (hlenv i)] at hfalse
    have : ¬ i < L := by simpa using hfalse
    omega
  have hbsz : (Cond.lt (.var k) len).size = len.size + 2 := by
    simp only [Cond.size, Expr.size]; omega
