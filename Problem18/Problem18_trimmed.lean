abbrev AlternatingForcedIndex (t a c : ℕ) :=
  {p : Fin t × Fin t // p.1 < p.2} ⊕
    ((Fin t × Fin a) ⊕ (Fin (t + a) × Fin c))
def alternatingForcedPair (t a c : ℕ) :
    AlternatingForcedIndex t a c →
      {p : Fin (t + a + c) × Fin (t + a + c) // p.1 < p.2}
  | Sum.inl p =>
      ⟨(⟨p.1.1.val, by omega⟩, ⟨p.1.2.val, by omega⟩), by
        exact_mod_cast p.2⟩
  | Sum.inr (Sum.inl p) =>
      ⟨(⟨p.1.val, by omega⟩, ⟨t + p.2.val, by omega⟩), by
        simp only [Fin.mk_lt_mk]
        omega⟩
  | Sum.inr (Sum.inr p) =>
      ⟨(⟨p.1.val, by omega⟩, ⟨t + a + p.2.val, by omega⟩), by
        simp only [Fin.mk_lt_mk]
        omega⟩
theorem alternatingForcedPair_injective (t a c : ℕ) :
    Function.Injective (alternatingForcedPair t a c) := by
  intro x y h
  rcases x with x | x
  · rcases y with y | y
    · have h1 : x.1.1 = y.1.1 := Fin.ext (congrArg (fun p => p.1.1.val) h)
      have h2 : x.1.2 = y.1.2 := Fin.ext (congrArg (fun p => p.1.2.val) h)
      have hxy : x = y := Subtype.ext (Prod.ext h1 h2)
      subst y
      rfl
    · rcases y with y | y
      · have hv := congrArg (fun p => p.1.2.val) h
        simp only [alternatingForcedPair] at hv
        omega
      · have hv := congrArg (fun p => p.1.2.val) h
        simp only [alternatingForcedPair] at hv
        omega
  · rcases x with x | x
    · rcases y with y | y
      · have hv := congrArg (fun p => p.1.2.val) h
        simp only [alternatingForcedPair] at hv
        omega
      · rcases y with y | y
        · have h1 : x.1 = y.1 := Fin.ext (congrArg (fun p => p.1.1.val) h)
          have hv := congrArg (fun p => p.1.2.val) h
          simp only [alternatingForcedPair] at hv
          have h2 : x.2 = y.2 := Fin.ext (by omega)
          have hxy : x = y := Prod.ext h1 h2
          subst y
          rfl
        · have hv := congrArg (fun p => p.1.2.val) h
          simp only [alternatingForcedPair] at hv
          omega
    · rcases y with y | y
      · have hv := congrArg (fun p => p.1.2.val) h
        simp only [alternatingForcedPair] at hv
        omega
      · rcases y with y | y
        · have hv := congrArg (fun p => p.1.2.val) h
          simp only [alternatingForcedPair] at hv
          omega
        · have h1 : x.1 = y.1 := Fin.ext (congrArg (fun p => p.1.1.val) h)
          have hv := congrArg (fun p => p.1.2.val) h
          simp only [alternatingForcedPair] at hv
          have h2 : x.2 = y.2 := Fin.ext (by omega)
          have hxy : x = y := Prod.ext h1 h2
          subst y
          rfl
