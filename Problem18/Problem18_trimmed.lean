abbrev BoundedPlaces (N : Nat) := {P : PlaceA k K // placeDegree k K P≤N}
instance boundedPlacesFintype (N : Nat) : Fintype (BoundedPlaces k K N) :=
  (finite_chart_places_degree_le k K N).fintype
def boundedDivisor (N : Nat) (f : BoundedPlaces k K N → Nat) : DivisorA k K :=
  ∑ P, Finsupp.single P.val (f P:ℤ)
@[simp] theorem boundedDivisor_apply (N : Nat) (f : BoundedPlaces k K N → Nat)
    (P : PlaceA k K) : boundedDivisor k K N f P=
      if h : placeDegree k K P≤N then (f ⟨P,h⟩:ℤ) else 0 := by
  classical
  rw [boundedDivisor,Finsupp.finsetSum_apply]
  by_cases hP : placeDegree k K P≤N
  · rw [dif_pos hP,Finset.sum_eq_single ⟨P,hP⟩]
    · simp
    · intro Q _ hQ
      have hne : P≠Q.val := by intro h; apply hQ; exact Subtype.ext h.symm
      simp [Finsupp.single_apply,hne]
    · simp
  · rw [dif_neg hP]
    apply Finset.sum_eq_zero
    intro Q _
    have hne : P≠Q.val := by intro h; apply hP; simpa [h] using Q.property
