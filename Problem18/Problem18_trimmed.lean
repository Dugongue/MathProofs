variable (k F E L : Type*) [Field k] [Field F] [Field E] [Field L]
  [Algebra k F] [Algebra k E] [Algebra k L] [Algebra F L] [Algebra E L]
  [IsScalarTower k F L] [IsScalarTower k E L] [Finite k] [Finite E] [FiniteDimensional F L]
  [FunctionField.IsFullConstantField k F]
  [Algebra k[X] F] [Algebra k⟮X⟯ F] [IsScalarTower k k[X] F]
  [IsScalarTower k[X] k⟮X⟯ F] [_root_.FunctionField k F] [Algebra.IsSeparable k⟮X⟯ F]
theorem rational_iff_restriction_degree_dvd (hgen : constantCompositum F E L=⊤)
    (Q : Place E L) : Q.degree=1 ↔
      (restrictPlace k F L (forgetConstants k E L Q)).degree ∣ finrank k E := by
  constructor
  · exact rational_restriction_degree_dvd k F L E Q
  · intro hd
    exact (constant_place_fiber_card_and_rational k F E L hgen _ hd).2 Q rfl
theorem constant_rational_place_count (hgen : constantCompositum F E L=⊤) :
    Nat.card {Q : Place E L // Q.degree=1}=closedPointSum k F (finrank k E) := by
  classical
  let m := finrank k E
  have hm : 0< m := finrank_pos (R:=k) (M:=E)
  let f : Place E L → PlaceA k F := fun Q =>
    (chartToPlace k F).symm (restrictPlace k F L (forgetConstants k E L Q))
  let S := {P : PlaceA k F // placeDegree k F P ∣ m}
  have hd (Q : Place E L) : placeDegree k F (f Q)=
      (restrictPlace k F L (forgetConstants k E L Q)).degree := by
    rw [placeDegree_eq]; simp [f]
  let e := Equiv.sigmaSubtypeFiberEquivSubtype f (p:=fun Q => Q.degree=1)
    (q:=fun P => placeDegree k F P∣m) (fun Q => by
      rw [hd]; exact rational_iff_restriction_degree_dvd k F E L hgen Q)
  let T := {P : BoundedPlaces k F m // placeDegree k F P.val∣m}
  let eST : S ≃ T :=
    { toFun := fun P => ⟨⟨P.val,Nat.le_of_dvd hm P.property⟩,P.property⟩
      invFun := fun P => ⟨P.val.val,P.property⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  letI : Fintype S := Fintype.ofEquiv T eST.symm
  have hcard (P : S) : Nat.card {Q : Place E L // f Q=P.val}=placeDegree k F P.val := by
    have heq : ∀ Q : Place E L, f Q=P.val ↔
        restrictPlace k F L (forgetConstants k E L Q)=chartToPlace k F P.val := by
      intro Q
      exact (Equiv.symm_apply_eq (chartToPlace k F)).trans Iff.rfl
    rw [Nat.card_congr (Equiv.subtypeEquivRight heq),placeDegree_eq]
    exact (constant_place_fiber_card_and_rational k F E L hgen _
      (by simpa only [← placeDegree_eq] using P.property)).1
  letI (P : S) : Finite {Q : Place E L // f Q=P.val} :=
    Nat.finite_of_card_ne_zero (by rw [hcard P]; exact Nat.ne_of_gt (placeDegree_pos k F P.val))
  rw [← Nat.card_congr e,Nat.card_sigma]
  simp_rw [hcard]
  change (∑ P : S, placeDegree k F P.val)=_
  rw [Fintype.sum_equiv eST (fun P : S => placeDegree k F P.val)
    (fun P : T => placeDegree k F P.val.val) (fun _ => rfl)]
  unfold closedPointSum
  rw [← Finset.sum_filter]
  exact (Finset.sum_subtype _ (by simp [m]) (fun P : BoundedPlaces k F m => placeDegree k F P.val)).symm
end Mathproof.Problem18ConstantRationalPointCount20260930
