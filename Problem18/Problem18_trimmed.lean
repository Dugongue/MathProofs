    restrictPlace k F L (forgetConstants k E L (rationalConstantLift k F E L hgen P))=P.val :=
  (exists_unique_rational_lift k F E L hgen P.val P.property).choose_spec.2.1
theorem rationalConstantLift_injective : Function.Injective (rationalConstantLift k F E L hgen) := by
  intro P Q h
