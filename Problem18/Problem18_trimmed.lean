  have hindex (r j : Fin (boxSize n d)) : r.val*boxSize n d+j.val < boxSize n d*boxSize n d := by
    have h1:=Nat.add_lt_add_left j.isLt (r.val*boxSize n d)
    have h2:=Nat.mul_le_mul_right (boxSize n d) (Nat.succ_le_of_lt r.isLt)
    rw [Nat.succ_mul] at h2
    omega
  have hq:=names_valid.q
  have hf:=fillNames_valid
  have hg:=gatherNames_valid
  have hbankS : fillNames.bank∉regNames canonical:=hf.reg _ (by simp [fillNames,LNames.list])
  have hbankW : fillNames.bank≠names.q.WS:=hf.ws _ (by simp [fillNames,LNames.list])
  have hLrS : fillNames.Lr∉regNames canonical:=hf.reg _ (by simp [fillNames,LNames.list])
  have hLrW : fillNames.Lr≠names.q.WS:=hf.ws _ (by simp [fillNames,LNames.list])
  let σ0:=(σ.setVar fillNames.bank 5).setVar fillNames.Lr (N*N)
  have hr0 : Run B (setupFill N) σ σ0 4 := by
    have h1:=Run.assign (B:=B) (σ:=σ) (x:=fillNames.bank) (evalB_lit h5B)
    have h2:=Run.assign (B:=B) (σ:=σ.setVar fillNames.bank 5)
      (x:=fillNames.Lr) (evalB_lit hsqB)
    simpa [setupFill,σ0] using h1.seq h2
  have hS0 : Slots F canonical names.q.WS Sn B σ0:=
    (hS.setVar F canonical hbankS hbankW 5).setVar F canonical hLrS hLrW (N*N)
  have hv0 (s:Nat) : val F canonical names.q.WS σ0 s=val F canonical names.q.WS σ s:=by
    dsimp [σ0];rw [val_setVar F canonical hLrW,val_setVar F canonical hbankW]
  have hb0 : σ0.vars fillNames.bank=5:=by
    simp [σ0,fillNames]
  have hL0 : σ0.vars fillNames.Lr=N*N:=by simp [σ0]
  obtain ⟨σ1,hr1,hS1,hzero,hframe1,hvars1,harr1,hi1,ho1⟩:=
    fill_run names.q fillNames
      (hf.reg _ (by simp [fillNames,LNames.list]))
      (hf.ws _ (by simp [fillNames,LNames.list]))
      (hf.reg _ (by simp [fillNames,LNames.list]))
      (hf.ws _ (by simp [fillNames,LNames.list]))
      (by decide) (by decide) (by decide) (by decide) (by decide)
      hS0 hb0 hL0 (by omega)
  have hN1 : σ1.vars names.q.N = N := by
    rw [hvars1 names.q.N (show names.q.N ≠ fillNames.k by decide)
      (show names.q.N ≠ fillNames.ci by decide)]
    have hk : names.q.N ≠ fillNames.Lr := by decide
    have hb : names.q.N ≠ fillNames.bank := by decide
    simp only [σ0, vars_setVar, if_neg hk, if_neg hb]
    exact hN.trans hNdef.symm
  have hcc1 : σ1.vars cn.cc = c := by
    rw [hvars1 cn.cc (show cn.cc ≠ fillNames.k by decide)
      (show cn.cc ≠ fillNames.ci by decide)]
    have hk : cn.cc ≠ fillNames.Lr := by decide
    have hb : cn.cc ≠ fillNames.bank := by decide
    simp only [σ0, vars_setVar, if_neg hk, if_neg hb]
    exact hcdef.symm
  have hcN0 : c ≤ N := by simpa only [c, N] using hcount
  have hchosen1 : (compress rows).1 = chosenOf (val F canonical names.q.WS σ1) N c := by
    rw [hcomp]
    apply chosenOf_congr
    intro s hs k hk
    have hs' : s < c := by simpa only [c] using hs
    have hk' : k < N := by simpa only [N] using hk
    have hsc : stStart N s + k < inStart N c := by
      calc
