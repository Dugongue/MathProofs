theorem ansFlag_succ_of_hit (F : FieldPresentation K) {n d : ℕ} (rows : List (DenseInput n d K))
    (i : ℕ) (h : zFlag (coords F n i) rows = 1) : ansFlag F rows (i + 1) = 1 := by
  unfold ansFlag
  rw [if_pos ⟨i, Nat.lt_succ_self i, h⟩]
theorem ansFlag_succ_of_miss (F : FieldPresentation K) {n d : ℕ} (rows : List (DenseInput n d K))
    (i : ℕ) (h : zFlag (coords F n i) rows ≠ 1) : ansFlag F rows (i + 1) = ansFlag F rows i := by
  unfold ansFlag
  have : (∃ t < i + 1, zFlag (coords F n t) rows = 1) ↔ ∃ t < i, zFlag (coords F n t) rows = 1 := by
    constructor
    · rintro ⟨t, ht, hz⟩
      rcases Nat.lt_succ_iff_lt_or_eq.mp ht with ht | rfl
      · exact ⟨t, ht, hz⟩
      · exact absurd hz h
    · rintro ⟨t, ht, hz⟩
      exact ⟨t, Nat.lt_succ_of_lt ht, hz⟩
  simp only [this]
theorem ansFlag_eq_smallFieldDecide (F : FieldPresentation K) {n d : ℕ}
    (rows : List (DenseInput n d K)) :
    ansFlag F rows ((F.p ^ F.e) ^ n) = if (smallFieldDecide F rows).1 then 1 else 0 := by
  unfold ansFlag
  have hiff : (∃ t < (F.p ^ F.e) ^ n, zFlag (coords F n t) rows = 1) ↔
      (smallFieldDecide F rows).1 = true := by
    rw [smallFieldDecide_iff_counter]
    constructor
    · rintro ⟨t, ht, hz⟩
      exact ⟨t, ht, (zFlag_eq_one_iff _ _).mp hz⟩
    · rintro ⟨t, ht, hz⟩
      exact ⟨t, ht, (zFlag_eq_one_iff _ _).mpr hz⟩
  by_cases hb : (smallFieldDecide F rows).1 = true
  · rw [if_pos (hiff.mpr hb), if_pos hb]
  · rw [if_neg (fun h => hb (hiff.mp h)), if_neg hb]
structure LoopInv (F : FieldPresentation K) (r : FieldNames) (q : RNames) (cn : CNames) (zn : ZNames)
    (sn : SNames) (rs : RowSlots) {n d : ℕ} (rows : List (DenseInput n d K)) (S B Qv : ℕ) (σ : Env)
    (i : ℕ) (τ : Env) : Prop where
  c : τ.vars sn.c = i
