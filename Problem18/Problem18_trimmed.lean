theorem assigns_run {W : Nat} (xs : List (String × Expr)) (σ : Env)
    (hr : ∀ p ∈ xs, ∀ x ∈ reads p.2, x ∉ xs.map Prod.fst)
    (hf : ∀ p ∈ xs, Fine W σ p.2) :
