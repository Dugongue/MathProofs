section Linear
variable {L : Type*} [Field L]
theorem exists_reduced_basis : ∀ (c : ℕ) (W : Submodule L (Fin c → L)),
    ∃ (k : ℕ) (S : Fin k → Fin c) (U : Fin k → Fin c → L),
      (∀ i, U i ∈ W) ∧ (∀ i j, U i (S j) = if i = j then 1 else 0) ∧
      ∀ v ∈ W, ∀ j, v j = ∑ i, v (S i) * U i j := by
  intro c
  induction c with
  | zero =>
    intro W
    exact ⟨0, Fin.elim0, Fin.elim0, fun i => i.elim0, fun i => i.elim0, fun _ _ j => j.elim0⟩
  | succ c ih =>
    intro W
    let tl : (Fin (c+1) → L) →ₗ[L] (Fin c → L) := LinearMap.funLeft L L Fin.succ
    let W' : Submodule L (Fin c → L) := (W ⊓ LinearMap.ker (LinearMap.proj 0)).map tl
    obtain ⟨k, S, U, hUW, hpiv, hred⟩ := ih W'
    have hlift : ∀ i, (Fin.cons 0 (U i) : Fin (c+1) → L) ∈ W := by
      intro i
      obtain ⟨w, ⟨hwW, hw0⟩, hwU⟩ := hUW i
      have hw : w = Fin.cons 0 (U i) := by
        funext t
        induction t using Fin.cases with
        | zero => simpa using hw0
        | succ t => rw [Fin.cons_succ, ← hwU]; rfl
      rw [← hw]
      exact hwW
    have htail : ∀ v ∈ W, v 0 = 0 → ∀ j : Fin c,
        v j.succ = ∑ i, v (S i).succ * U i j := by
      intro v hv hv0 j
      have hmem : tl v ∈ W' := ⟨v, ⟨hv, by simpa using hv0⟩, rfl⟩
      have := hred (tl v) hmem j
      simpa [tl, LinearMap.funLeft_apply] using this
    by_cases h0 : ∀ v ∈ W, v 0 = 0
    · refine ⟨k, fun i => (S i).succ, fun i => Fin.cons 0 (U i), hlift, ?_, ?_⟩
      · intro i j
        simp only [Fin.cons_succ]
        exact hpiv i j
      · intro v hv j
        induction j using Fin.cases with
        | zero => simp [h0 v hv]
        | succ j =>
          simp only [Fin.cons_succ]
          exact htail v hv (h0 v hv) j
    · push Not at h0
      obtain ⟨w0, hw0W, hw00⟩ := h0
      let w1 : Fin (c+1) → L := (w0 0)⁻¹ • w0
      have hw1W : w1 ∈ W := W.smul_mem _ hw0W
      have hw10 : w1 0 = 1 := by simp [w1, inv_mul_cancel₀ hw00]
      let w : Fin (c+1) → L := w1 - ∑ i, w1 (S i).succ • (Fin.cons 0 (U i) : Fin (c+1) → L)
      have hwW : w ∈ W :=
        W.sub_mem hw1W (W.sum_mem fun i _ => W.smul_mem _ (hlift i))
      have hw0 : w 0 = 1 := by simp [w, hw10]
      have hwS : ∀ j, w (S j).succ = 0 := by
        intro j
        simp only [w, Pi.sub_apply, Finset.sum_apply, Pi.smul_apply, Fin.cons_succ, smul_eq_mul,
          hpiv, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true, sub_self]
      refine ⟨k+1, Fin.cons 0 (fun i => (S i).succ), Fin.cons w (fun i => Fin.cons 0 (U i)),
        ?_, ?_, ?_⟩
      · intro i
        induction i using Fin.cases with
        | zero => simpa using hwW
        | succ i => simpa using hlift i
      · intro i j
        induction i using Fin.cases with
        | zero =>
          induction j using Fin.cases with
          | zero => simpa using hw0
          | succ j =>
            simp only [Fin.cons_zero, Fin.cons_succ, if_neg (Fin.succ_ne_zero j).symm]
            exact hwS j
        | succ i =>
          induction j using Fin.cases with
          | zero => simp
          | succ j =>
            simp only [Fin.cons_succ, hpiv i j, Fin.succ_inj]
      · intro v hv j
        let v' : Fin (c+1) → L := v - v 0 • w
        have hv'W : v' ∈ W := W.sub_mem hv (W.smul_mem _ hwW)
        have hv'0 : v' 0 = 0 := by simp [v', hw0]
        have hv'S : ∀ i, v' (S i).succ = v (S i).succ := by
          intro i
          simp [v', hwS i]
        rw [Fin.sum_univ_succ]
        simp only [Fin.cons_zero, Fin.cons_succ]
        induction j using Fin.cases with
        | zero => simp [hw0]
        | succ j =>
          simp only [Fin.cons_succ]
          have h1 := htail v' hv'W hv'0 j
          simp only [hv'S] at h1
          have h2 : v' j.succ = v j.succ - v 0 * w j.succ := by simp [v']
          rw [h2] at h1
          linear_combination h1
end Linear
section Box
variable {L : Type*} [Field L]
noncomputable def boxLin (n E : ℕ) : (Fin (boxSize n E) → L) →ₗ[L] MvPolynomial (Fin n) L :=
  ∑ j, (monomial ((boundedExponents n E)[j.val])).comp (LinearMap.proj j)
noncomputable def boxPoly (n E : ℕ) (v : Fin (boxSize n E) → L) : MvPolynomial (Fin n) L :=
  boxLin n E v
theorem boxPoly_eq (n E : ℕ) (v : Fin (boxSize n E) → L) :
    boxPoly n E v = ∑ j, monomial ((boundedExponents n E)[j.val]) (v j) := by
  simp [boxPoly, boxLin, LinearMap.sum_apply]
theorem eval_boxPoly (n E : ℕ) (x : Fin n → L) (v : Fin (boxSize n E) → L) :
    eval x (boxPoly n E v) = denseEval x v := by
  rw [boxPoly_eq, map_sum, denseEval_apply]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [eval_monomial, Finsupp.prod_fintype _ _ (fun i => pow_zero (x i)), mul_comm]
theorem boxPoly_coeffs (n E : ℕ) (p : MvPolynomial (Fin n) L)
    (hp : ∀ a ∈ p.support, a ∈ boundedExponents n E) :
    boxPoly n E (fun j => coeff ((boundedExponents n E)[j.val]) p) = p := by
  classical
  have hs : p.support ⊆ (boundedExponents n E).toFinset := fun a ha =>
    List.mem_toFinset.mpr (hp a ha)
  have he : (∑ a ∈ (boundedExponents n E).toFinset, monomial a (coeff a p)) = p := by
    calc
      _ = ∑ a ∈ p.support, monomial a (coeff a p) := (Finset.sum_subset hs (by
        intro a _ hn
        have hz : coeff a p = 0 := by simpa only [mem_support_iff, not_not] using hn
        simp only [hz, monomial_zero])).symm
      _ = p := support_sum_monomial_coeff p
  rw [boxPoly_eq]
  conv_rhs => rw [← he]
  rw [List.sum_toFinset _ (boundedExponents_nodup n E)]
  exact Fin.sum_univ_fun_getElem (boundedExponents n E) (fun a => monomial a (coeff a p))
theorem boxPoly_of_totalDegree (n E : ℕ) (p : MvPolynomial (Fin n) L) (hp : p.totalDegree ≤ E) :
    boxPoly n E (fun j => coeff ((boundedExponents n E)[j.val]) p) = p :=
  boxPoly_coeffs n E p fun _ ha => bounded_support_mem p hp ha
theorem boxPoly_map {K : Type*} [Field K] (g : K →+* L) (n E : ℕ) (v : Fin (boxSize n E) → K) :
    MvPolynomial.map g (boxPoly n E v) = boxPoly n E (fun j => g (v j)) := by
  simp only [boxPoly_eq, map_sum, map_monomial]
theorem totalDegree_boxPoly_le (n E : ℕ) (v : Fin (boxSize n E) → L) :
    (boxPoly n E v).totalDegree ≤ n * E := by
  rw [boxPoly_eq]
  refine (totalDegree_finsetSum _ _).trans (Finset.sup_le fun j _ => ?_)
  refine (totalDegree_monomial_le _ _).trans ?_
  have hmem := (mem_boundedExponents_iff _).mp (List.getElem_mem (l := boundedExponents n E) j.isLt)
  rw [Finsupp.sum_fintype _ _ (fun _ => rfl)]
  calc ∑ i, id (((boundedExponents n E)[j.val]) i) ≤ ∑ _i : Fin n, E :=
        Finset.sum_le_sum fun i _ => hmem i
    _ = n * E := by simp
end Box
section ZeroSets
variable {L : Type*} [Field L] [IsAlgClosed L] {n : ℕ}
theorem mem_zeroLocus_eval (I : Ideal (MvPolynomial (Fin n) L)) (x : Fin n → L) :
    x ∈ zeroLocus L I ↔ ∀ f ∈ I, eval x f = 0 := by
  rw [mem_zeroLocus_iff]
  rfl
theorem mem_zeroLocus_span (G : Set (MvPolynomial (Fin n) L)) (x : Fin n → L) :
    x ∈ zeroLocus L (Ideal.span G) ↔ ∀ g ∈ G, eval x g = 0 := by
  rw [mem_zeroLocus_eval]
  constructor
  · exact fun h g hg => h g (Ideal.subset_span hg)
  · intro h f hf
    induction hf using Submodule.span_induction with
    | mem g hg => exact h g hg
    | zero => simp
    | add a b _ _ ha hb => simp [ha, hb]
    | smul c a _ ha => simp [ha]
theorem mem_radical_iff_vanish (I : Ideal (MvPolynomial (Fin n) L)) (f : MvPolynomial (Fin n) L) :
    f ∈ I.radical ↔ ∀ x ∈ zeroLocus L I, eval x f = 0 := by
  rw [← vanishingIdeal_zeroLocus_eq_radical (K := L) I, mem_vanishingIdeal_iff]
  rfl
theorem prime_eq_vanish (P : Ideal (MvPolynomial (Fin n) L)) (hP : P.IsPrime)
    (f : MvPolynomial (Fin n) L) : f ∈ P ↔ ∀ x ∈ zeroLocus L P, eval x f = 0 := by
  rw [← mem_radical_iff_vanish, hP.radical]
theorem prime_point (P : Ideal (MvPolynomial (Fin n) L)) (hP : P.IsPrime)
    (g : MvPolynomial (Fin n) L) (hg : g ∉ P) : ∃ q ∈ zeroLocus L P, eval q g ≠ 0 := by
  by_contra hall
  push Not at hall
  exact hg ((prime_eq_vanish P hP g).mpr hall)
theorem point_in_component (I : Ideal (MvPolynomial (Fin n) L)) (x : Fin n → L)
    (hx : x ∈ zeroLocus L I) : ∃ Q ∈ I.minimalPrimes, x ∈ zeroLocus L Q := by
  have hmax : (vanishingIdeal L ({x} : Set (Fin n → L))).IsMaximal :=
    isMaximal_iff_eq_vanishingIdeal_singleton.mpr ⟨x, rfl⟩
  haveI := hmax.isPrime
  have hle : I ≤ vanishingIdeal L ({x} : Set (Fin n → L)) := by
    intro f hf
    rw [mem_vanishingIdeal_singleton_iff]
    exact (mem_zeroLocus_iff.mp hx) f hf
  obtain ⟨Q, hQ, hQle⟩ := Ideal.exists_minimalPrimes_le hle
  refine ⟨Q, hQ, ?_⟩
  rw [mem_zeroLocus_iff]
  intro f hf
  exact (mem_vanishingIdeal_singleton_iff x f).mp (hQle hf)
theorem avoid_point (I : Ideal (MvPolynomial (Fin n) L)) (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ I.minimalPrimes) (O : Finset (Ideal (MvPolynomial (Fin n) L))) (hPO : P ∉ O)
    (hO : ∀ Q ∈ O, Q ∈ I.minimalPrimes) :
    ∃ q ∈ zeroLocus L P, ∀ Q ∈ O, q ∉ zeroLocus L Q := by
  classical
  have hPp : P.IsPrime := hP.1.1
  have hnotle : ¬ (∏ Q ∈ O, Q) ≤ P := by
    intro hle
    obtain ⟨Q, hQ, hQP⟩ := (Ideal.IsPrime.prod_le hPp).mp hle
    have hPQ : P ≤ Q := hP.2 (hO Q hQ).1 hQP
    exact hPO (le_antisymm hPQ hQP ▸ hQ)
  obtain ⟨g0, hg0, hg0P⟩ := Set.not_subset.mp hnotle
  obtain ⟨q, hqP, hqg⟩ := prime_point P hPp g0 hg0P
  refine ⟨q, hqP, fun Q hQ hqQ => hqg ?_⟩
  have hg0Q : g0 ∈ Q := Ideal.prod_le_inf.trans (Finset.inf_le hQ) hg0
  exact (mem_zeroLocus_eval Q q).mp hqQ g0 hg0Q
end ZeroSets
section Geometry
variable {L : Type*} [Field L] [IsAlgClosed L]
def cpE (n d : ℕ) : ℕ := componentSep n d
def cpT (n d : ℕ) : ℕ := componentCount n (n * cpE n d) * componentSep n (n * cpE n d)
def cpD (n d : ℕ) : ℕ := componentCount n d * componentSep n d
abbrev IsP {s k : ℕ} (n d : ℕ) (F : Fin s → Fin (boxSize n d) → L)
    (S : Fin k → Fin (boxSize n (cpE n d))) (U : Fin k → Fin (boxSize n (cpE n d)) → L) : Prop :=
  IsParam n d (cpE n d) (cpT n d) (cpD n d) F S U
noncomputable def vecOf (n T : ℕ) (p : MvPolynomial (Fin n) L) : Fin (boxSize n T) → L :=
  fun j => coeff ((boundedExponents n T)[j.val]) p
theorem denseEval_vecOf (n T : ℕ) (p : MvPolynomial (Fin n) L) (hp : p.totalDegree ≤ T)
    (x : Fin n → L) : denseEval x (vecOf n T p) = eval x p := by
  rw [← eval_boxPoly]
  unfold vecOf
  rw [boxPoly_of_totalDegree n T p hp]
noncomputable def rowSys {k : ℕ} (n E : ℕ) (U : Fin k → Fin (boxSize n E) → L) :
    Finset (MvPolynomial (Fin n) L) := by
  classical
  exact Finset.univ.image fun i => boxPoly n E (U i)
theorem coe_rowSys {k : ℕ} (n E : ℕ) (U : Fin k → Fin (boxSize n E) → L) :
    (rowSys n E U : Set (MvPolynomial (Fin n) L)) = Set.range fun i => boxPoly n E (U i) := by
  classical
  simp [rowSys]
theorem rowSys_degree {k : ℕ} (n E : ℕ) (U : Fin k → Fin (boxSize n E) → L) :
    ∀ g ∈ rowSys n E U, g.totalDegree ≤ n * E := by
  classical
  intro g hg
  simp only [rowSys, Finset.mem_image, Finset.mem_univ, true_and] at hg
  obtain ⟨i, rfl⟩ := hg
  exact totalDegree_boxPoly_le n E (U i)
theorem mem_zeroLocus_rowSys {k : ℕ} (n E : ℕ) (U : Fin k → Fin (boxSize n E) → L)
    (x : Fin n → L) :
    x ∈ zeroLocus L (Ideal.span (rowSys n E U : Set (MvPolynomial (Fin n) L))) ↔
      ∀ i, denseEval x (U i) = 0 := by
  rw [mem_zeroLocus_span, coe_rowSys]
  simp only [Set.mem_range, forall_exists_index, forall_apply_eq_imp_iff, eval_boxPoly]
theorem minimalPrimes_card_le {k : ℕ} (n E : ℕ) (U : Fin k → Fin (boxSize n E) → L)
    (O : Finset (Ideal (MvPolynomial (Fin n) L)))
    (hO : ∀ Q ∈ O, Q ∈ (Ideal.span (rowSys n E U : Set (MvPolynomial (Fin n) L))).minimalPrimes) :
    O.card ≤ componentCount n (n * E) := by
  classical
  have hfin := Ideal.finite_minimalPrimes_of_isNoetherianRing _
    (Ideal.span (rowSys n E U : Set (MvPolynomial (Fin n) L)))
  have h1 := minimalPrimes_ncard_le (rowSys n E U) (n * E) (rowSys_degree n E U)
  rw [Set.ncard_eq_toFinset_card _ hfin] at h1
  refine le_trans (Finset.card_le_card fun Q hQ => ?_) h1
  rw [Set.Finite.mem_toFinset]
  exact hO Q hQ
theorem isParam_component {s k : ℕ} (n d : ℕ) (F : Fin s → Fin (boxSize n d) → L)
    (S : Fin k → Fin (boxSize n (cpE n d))) (U : Fin k → Fin (boxSize n (cpE n d)) → L)
    (h : IsP n d F S U) :
    (Ideal.span (rowSys n (cpE n d) U : Set (MvPolynomial (Fin n) L))).radical ∈
      (Ideal.span (rowSys n d F : Set (MvPolynomial (Fin n) L))).minimalPrimes := by
  classical
  obtain ⟨_, _, hcont, hirr, hv, hrest, y, hyU, hyH⟩ := h
  set I0 := Ideal.span (rowSys n (cpE n d) U : Set (MvPolynomial (Fin n) L)) with hI0
  set J := I0.radical with hJ
  have hJmem : ∀ f, f ∈ J ↔ ∀ x, (∀ i, denseEval x (U i) = 0) → eval x f = 0 := by
    intro f
    rw [hJ, mem_radical_iff_vanish]
    exact forall_congr' fun x => by rw [mem_zeroLocus_rowSys]
  have hyI0 : y ∈ zeroLocus L I0 := (mem_zeroLocus_rowSys n (cpE n d) U y).mpr hyU
  have hJne : J ≠ ⊤ := by
    intro htop
    have h1 := (hJmem 1).mp (htop ▸ Submodule.mem_top) y hyU
    simp at h1
  have hI0ne : I0 ≠ ⊤ := fun h0 => hJne (by rw [hJ, h0, Ideal.radical_top])
  have hprime : J.IsPrime := by
    by_contra hnp
    have hfin := Ideal.finite_minimalPrimes_of_isNoetherianRing _ I0
    obtain ⟨⟨Q1, hQ1⟩⟩ := Ideal.nonempty_minimalPrimes hI0ne
    have hex : ∃ Q2 ∈ I0.minimalPrimes, Q2 ≠ Q1 := by
      by_contra hall
      push Not at hall
      apply hnp
      have hJQ : J = Q1 := by
        rw [hJ, ← Ideal.sInf_minimalPrimes]
        refine le_antisymm (sInf_le hQ1) (le_sInf fun Q hQ => ?_)
        rw [hall Q hQ]
      rw [hJQ]
      exact hQ1.1.1
    obtain ⟨Q2, hQ2, hne⟩ := hex
    set O := hfin.toFinset.erase Q1 with hO
    have hOmin : ∀ Q ∈ O, Q ∈ I0.minimalPrimes := by
      intro Q hQ
      rw [hO, Finset.mem_erase, Set.Finite.mem_toFinset] at hQ
      exact hQ.2
    obtain ⟨q1, hq1P, hq1O⟩ := avoid_point I0 Q1 hQ1 O (by simp [hO]) hOmin
    obtain ⟨p, hpO, hpdeg, hpq1⟩ := union_separator (rowSys n (cpE n d) U) (n * cpE n d) (rowSys_degree n (cpE n d) U)
      O hOmin q1 hq1O
    have hQ12 : ¬ Q1 ≤ Q2 := fun hle => hne (le_antisymm (hQ2.2 hQ1.1 hle) hle)
    obtain ⟨g, hgQ1, hgQ2⟩ := Set.not_subset.mp hQ12
    obtain ⟨q2, hq2Q2, hq2g⟩ := prime_point Q2 hQ2.1.1 g hgQ2
    have hq2Q1 : q2 ∉ zeroLocus L Q1 := fun hm => hq2g ((mem_zeroLocus_eval Q1 q2).mp hm g hgQ1)
    obtain ⟨p', hp'Q1, hp'deg, hp'q2⟩ := minimalPrime_separator' (rowSys n (cpE n d) U) (n * cpE n d)
      (rowSys_degree n (cpE n d) U) Q1 hQ1 q2 hq2Q1
    have hcnt2 : 2 ≤ componentCount n (n * cpE n d) := by
      have := minimalPrimes_card_le n (cpE n d) U {Q1, Q2} (by
        intro Q hQ
        simp only [Finset.mem_insert, Finset.mem_singleton] at hQ
        rcases hQ with rfl | rfl
        · exact hQ1
        · exact hQ2)
      rwa [Finset.card_pair hne.symm] at this
    have hpT : p.totalDegree ≤ cpT n d :=
      hpdeg.trans (Nat.mul_le_mul_right _ (minimalPrimes_card_le n (cpE n d) U O hOmin))
    have hp'T : p'.totalDegree ≤ cpT n d := by
      refine hp'deg.trans ?_
      calc componentSep n (n * cpE n d) = 1 * componentSep n (n * cpE n d) := (one_mul _).symm
        _ ≤ componentCount n (n * cpE n d) * componentSep n (n * cpE n d) :=
          Nat.mul_le_mul_right _ (by omega)
    have hzI0 : ∀ Q ∈ I0.minimalPrimes, I0 ≤ Q := fun Q hQ => hQ.1.2
    have hprod : ∀ x : Fin n → L, (∀ i, denseEval x (U i) = 0) →
        denseEval x (vecOf n (cpT n d) p) * denseEval x (vecOf n (cpT n d) p') = 0 := by
      intro x hx
      rw [denseEval_vecOf n _ p hpT, denseEval_vecOf n _ p' hp'T]
      obtain ⟨Q, hQ, hxQ⟩ := point_in_component I0 x ((mem_zeroLocus_rowSys n (cpE n d) U x).mpr hx)
      by_cases hQ1' : Q = Q1
      · subst hQ1'
        rw [(mem_zeroLocus_eval Q x).mp hxQ p' hp'Q1, mul_zero]
      · have hQO : Q ∈ O := by
          rw [hO, Finset.mem_erase, Set.Finite.mem_toFinset]
          exact ⟨hQ1', hQ⟩
        have hpQ : p ∈ Q := by
          have h1 := (Submodule.mem_iInf _).mp hpO Q
          exact (Submodule.mem_iInf _).mp h1 hQO
        rw [(mem_zeroLocus_eval Q x).mp hxQ p hpQ, zero_mul]
    have hq1U : ∀ i, denseEval q1 (U i) = 0 := by
      rw [← mem_zeroLocus_rowSys]
      exact zeroLocus_anti_mono (hzI0 Q1 hQ1) hq1P
    have hq2U : ∀ i, denseEval q2 (U i) = 0 := by
      rw [← mem_zeroLocus_rowSys]
      exact zeroLocus_anti_mono (hzI0 Q2 hQ2) hq2Q2
    rcases hirr _ _ hprod with h1 | h1
    · have := h1 q1 hq1U
      rw [denseEval_vecOf n _ p hpT] at this
      exact hpq1 this
    · have := h1 q2 hq2U
      rw [denseEval_vecOf n _ p' hp'T] at this
      exact hp'q2 this
  have hle : Ideal.span (rowSys n d F : Set (MvPolynomial (Fin n) L)) ≤ J := by
    rw [Ideal.span_le, coe_rowSys]
    rintro _ ⟨r, rfl⟩
    rw [SetLike.mem_coe, hJmem]
    intro x hx
    rw [eval_boxPoly]
    exact hcont x hx r
  refine ⟨⟨hprime, hle⟩, fun P hP hPJ => ?_⟩
  intro g hg
  have hHg : boxPoly n (cpD n d) hv * g ∈ P := by
    have hmem : boxPoly n (cpD n d) hv * g ∈
        (Ideal.span (rowSys n d F : Set (MvPolynomial (Fin n) L))).radical := by
      rw [mem_radical_iff_vanish]
      intro x hx
      rw [mem_zeroLocus_rowSys] at hx
      rw [map_mul]
      rcases hrest x hx with hxU | hxH
      · rw [(hJmem g).mp hg x hxU, mul_zero]
      · rw [eval_boxPoly, hxH, zero_mul]
    exact (hP.1.radical_le_iff.mpr hP.2) hmem
  rcases hP.1.mem_or_mem hHg with hH | hgP
  · exfalso
    have := (hJmem _).mp (hPJ hH) y hyU
    rw [eval_boxPoly] at this
    exact hyH this
  · exact hgP
theorem isParam_unique {s k : ℕ} (n d : ℕ) (F : Fin s → Fin (boxSize n d) → L)
    (S : Fin k → Fin (boxSize n (cpE n d))) (U U' : Fin k → Fin (boxSize n (cpE n d)) → L)
    (h1 : IsP n d F S U) (h2 : IsP n d F S U')
    (heq : (Ideal.span (rowSys n (cpE n d) U : Set (MvPolynomial (Fin n) L))).radical =
      (Ideal.span (rowSys n (cpE n d) U' : Set (MvPolynomial (Fin n) L))).radical) : U = U' := by
  have hY : ∀ x : Fin n → L, (∀ i, denseEval x (U i) = 0) → ∀ i, denseEval x (U' i) = 0 := by
    intro x hx i
    have hmem : boxPoly n (cpE n d) (U' i) ∈
        (Ideal.span (rowSys n (cpE n d) U' : Set (MvPolynomial (Fin n) L))).radical :=
      Ideal.le_radical (Ideal.subset_span (by rw [coe_rowSys]; exact ⟨i, rfl⟩))
    rw [← heq, mem_radical_iff_vanish] at hmem
    rw [← eval_boxPoly]
    exact hmem x ((mem_zeroLocus_rowSys _ _ U x).mpr hx)
  obtain ⟨_, hclosed, _⟩ := h1
  obtain ⟨hpiv', _⟩ := h2
  funext i j
  have := hclosed (U' i) (fun x hx => hY x hx i) j
  rw [this]
  simp only [hpiv', ite_mul, one_mul, zero_mul, Finset.sum_ite_eq, Finset.mem_univ, if_true]
theorem component_param {s : ℕ} (n d : ℕ) (F : Fin s → Fin (boxSize n d) → L)
    (hF : ∀ r, (boxPoly n d (F r)).totalDegree ≤ d) (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ (Ideal.span (rowSys n d F : Set (MvPolynomial (Fin n) L))).minimalPrimes) :
    ∃ (k : ℕ) (S : Fin k → Fin (boxSize n (cpE n d)))
      (U : Fin k → Fin (boxSize n (cpE n d)) → L),
      IsP n d F S U ∧
      (Ideal.span (rowSys n (cpE n d) U : Set (MvPolynomial (Fin n) L))).radical = P ∧
      (∀ i, boxPoly n (cpE n d) (U i) ∈ P) ∧
      ∀ v, boxPoly n (cpE n d) v ∈ P → ∀ j, v j = ∑ i, v (S i) * U i j := by
  classical
  have hPp : P.IsPrime := hP.1.1
  have hdegIn : ∀ g ∈ rowSys n d F, g.totalDegree ≤ d := by
    intro g hg
    simp only [rowSys, Finset.mem_image, Finset.mem_univ, true_and] at hg
    obtain ⟨r, rfl⟩ := hg
    exact hF r
  let W : Submodule L (Fin (boxSize n (cpE n d)) → L) := (P.restrictScalars L).comap (boxLin n (cpE n d))
  obtain ⟨k, S, U, hUW, hpiv, hred⟩ := exists_reduced_basis _ W
  have hUP : ∀ i, boxPoly n (cpE n d) (U i) ∈ P := hUW
  have hredP : ∀ v, boxPoly n (cpE n d) v ∈ P → ∀ j, v j = ∑ i, v (S i) * U i j := fun v hv => hred v hv
  have hY : ∀ x : Fin n → L, (∀ i, denseEval x (U i) = 0) ↔ x ∈ zeroLocus L P := by
    intro x
    constructor
    · intro hx
      by_contra hxP
      obtain ⟨sp, hsP, hsdeg, hsx⟩ := minimalPrime_separator' (rowSys n d F) d hdegIn P hP x hxP
      have hvP : boxPoly n (cpE n d) (vecOf n (cpE n d) sp) ∈ P := by
        unfold vecOf
        rw [boxPoly_of_totalDegree n (cpE n d) sp hsdeg]
        exact hsP
      have hvec : vecOf n (cpE n d) sp = ∑ i, (vecOf n (cpE n d) sp (S i)) • U i := by
        funext j
        rw [hredP _ hvP j]
        simp [Finset.sum_apply]
      apply hsx
      rw [← denseEval_vecOf n (cpE n d) sp hsdeg, hvec, map_sum]
      simp [hx]
    · intro hx i
      rw [← eval_boxPoly]
      exact (mem_zeroLocus_eval P x).mp hx _ (hUP i)
  have hfin := Ideal.finite_minimalPrimes_of_isNoetherianRing _
    (Ideal.span (rowSys n d F : Set (MvPolynomial (Fin n) L)))
  set O := hfin.toFinset.erase P with hO
  have hOmin : ∀ Q ∈ O, Q ∈ (Ideal.span (rowSys n d F : Set (MvPolynomial (Fin n) L))).minimalPrimes := by
    intro Q hQ
    rw [hO, Finset.mem_erase, Set.Finite.mem_toFinset] at hQ
    exact hQ.2
  obtain ⟨q, hqP, hqO⟩ := avoid_point _ P hP O (by simp [hO]) hOmin
  obtain ⟨hp, hpO, hpdeg, hpq⟩ := union_separator (rowSys n d F) d hdegIn O hOmin q hqO
  have hcardO : O.card ≤ componentCount n d := by
    have h1 := minimalPrimes_ncard_le (rowSys n d F) d hdegIn
    rw [Set.ncard_eq_toFinset_card _ hfin] at h1
    exact (Finset.card_erase_le).trans h1
  have hpD : hp.totalDegree ≤ cpD n d :=
    hpdeg.trans (Nat.mul_le_mul_right _ hcardO)
  refine ⟨k, S, U, ⟨hpiv, ?_, ?_, ?_, vecOf n (cpD n d) hp, ?_, q, (hY q).mpr hqP, ?_⟩, ?_, hUP, hredP⟩
  · intro v hv
    apply hredP
    rw [prime_eq_vanish P hPp]
    intro x hx
    rw [eval_boxPoly]
    exact hv x ((hY x).mpr hx)
  · intro x hx r
    have hxP := (hY x).mp hx
    have hFP : boxPoly n d (F r) ∈ P :=
      hP.1.2 (Ideal.subset_span (by rw [coe_rowSys]; exact ⟨r, rfl⟩))
    rw [← eval_boxPoly]
    exact (mem_zeroLocus_eval P x).mp hxP _ hFP
  · intro p1 p2 hprod
    have hmem : boxPoly n (cpT n d) p1 * boxPoly n (cpT n d) p2 ∈ P := by
      rw [prime_eq_vanish P hPp]
      intro x hx
      rw [map_mul, eval_boxPoly, eval_boxPoly]
      exact hprod x ((hY x).mpr hx)
    rcases hPp.mem_or_mem hmem with h1 | h1
    · left
      intro x hx
      rw [← eval_boxPoly]
      exact (mem_zeroLocus_eval P x).mp ((hY x).mp hx) _ h1
    · right
      intro x hx
      rw [← eval_boxPoly]
      exact (mem_zeroLocus_eval P x).mp ((hY x).mp hx) _ h1
  · intro x hx
    obtain ⟨Q, hQ, hxQ⟩ := point_in_component _ x ((mem_zeroLocus_rowSys n d F x).mpr hx)
    by_cases hQP : Q = P
    · subst hQP
      exact Or.inl ((hY x).mpr hxQ)
    · right
      have hQO : Q ∈ O := by
        rw [hO, Finset.mem_erase, Set.Finite.mem_toFinset]
        exact ⟨hQP, hQ⟩
      have hpQ : hp ∈ Q := by
        have h1 := (Submodule.mem_iInf _).mp hpO Q
        exact (Submodule.mem_iInf _).mp h1 hQO
      rw [denseEval_vecOf n _ hp hpD]
      exact (mem_zeroLocus_eval Q x).mp hxQ hp hpQ
  · rw [denseEval_vecOf n _ hp hpD]
    exact hpq
  · apply le_antisymm
    · intro f hf
      rw [mem_radical_iff_vanish] at hf
      rw [prime_eq_vanish P hPp]
      intro x hx
      exact hf x ((mem_zeroLocus_rowSys n (cpE n d) U x).mpr ((hY x).mpr hx))
    · intro f hf
      rw [mem_radical_iff_vanish]
      intro x hx
      rw [mem_zeroLocus_rowSys] at hx
      exact (mem_zeroLocus_eval P x).mp ((hY x).mp hx) f hf
theorem isParam_finite {s k : ℕ} (n d : ℕ) (F : Fin s → Fin (boxSize n d) → L)
    (S : Fin k → Fin (boxSize n (cpE n d))) :
    {U : Fin k → Fin (boxSize n (cpE n d)) → L | IsP n d F S U}.Finite := by
  refine Set.Finite.of_finite_image (f := fun U =>
      (Ideal.span (rowSys n (cpE n d) U : Set (MvPolynomial (Fin n) L))).radical)
    ((Ideal.finite_minimalPrimes_of_isNoetherianRing _
      (Ideal.span (rowSys n d F : Set (MvPolynomial (Fin n) L)))).subset ?_) ?_
  · rintro _ ⟨U, hU, rfl⟩
    exact isParam_component n d F S U hU
  · intro U hU U' hU' heq
    exact isParam_unique n d F S U U' hU hU' heq
end Geometry
