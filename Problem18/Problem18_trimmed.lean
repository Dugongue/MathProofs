    (hχfix : (A*Aᴴ).charpoly.map (starRingAut : K ≃+* K).toRingHom=(A*Aᴴ).charpoly)
    (hW : W=LinearMap.ker (aeval (A*Aᴴ).toLin' p)) :
    primaryCoordinates (E W hc f g) (U W hc f g) A := by
