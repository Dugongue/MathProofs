    rw [matrix_of_word_copy F (src:=gram) (dst:=gram)
      (fun x hx => hmem (gram+x) (by
        have hf := h.gram_fit
        have hlen := (run_frame hcopyRun).2.2.1 canonical.mem
        rw [hlen]
        omega) (by
          have hs := h.gram_before
          dsimp [out,powerAt]
          omega))]
    exact hgxi
  have hcursorTau : tau.vars powerCursor = k := by
    rw [hprodVars powerCursor (by decide)]
    change xi.vars powerCursor = k
    exact hcursorXi
  let ups := tau.setVar powerCursor (k+1)
  have hk1B : k+1 < B := lt_of_le_of_lt (Nat.succ_le_of_lt hkc) h.c_word
  have hinc : Run B (.assign powerCursor
      (.add (.var powerCursor) (.lit 1))) tau ups 4 := by
    apply Run.assign
    have hc0 := evalB_var (B:=B) (x:=powerCursor) (σ:=tau)
      (by rw [hcursorTau]; exact lt_trans hkc h.c_word)
    have hc : (Expr.var powerCursor).evalB B tau = some k := by
      simpa [hcursorTau] using hc0
    exact evalB_bin hc (evalB_lit (by omega)) hk1B
  have hups := runtime_set_cursor F (v:=k+1) htau
  have hgramUps : Problem18IMPMatrixMemory20261001.matrix F ups gram n n = G := by
    change Problem18IMPMatrixMemory20261001.matrix F tau gram n n = G
