theorem exists_unique_rational_lift (P : Place k F) (hP : P.degree=1) :
    ∃ Q : Place E L, Q.degree=1 ∧
      restrictPlace k F L (forgetConstants k E L Q)=P ∧
      ∀ R : Place E L, restrictPlace k F L (forgetConstants k E L R)=P → R=Q := by
  have h := constant_place_fiber_card_and_rational k F E L hgen P (by rw [hP]; exact one_dvd _)
