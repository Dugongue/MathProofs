def finish (q : RNames) : Com :=
  .ite (.eq (.var q.f) (.lit 1))
    (.ite (.eq (.var q.pv) (.bin .sub (.var q.n) (.lit 1)))
      (.assign q.w (.lit 1)) (.assign q.w (.lit 0)))
    (.assign q.w (.lit 0))
def program (q : RNames) : Com := .seq (leadingProgram q) (finish q)
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
theorem scan_unit_iff (P : K[X]) {n fv pv : Nat}
    (h : (fv=0 ∧ P=0) ∨ (fv=1 ∧ pv<n ∧ P≠0 ∧ P.natDegree=n-1-pv)) :
    (fv=1 ∧ pv=n-1) ↔ IsUnit P := by
  rcases h with ⟨hf,hp⟩|⟨hf,hpn,hp,hd⟩
  · simp [hf,hp]
  · rw [hf,eq_self_iff_true,true_and,isUnit_iff_degree_eq_zero,degree_eq_natDegree hp]
    have hn : P.natDegree=0 ↔ pv=n-1 := by rw [hd];omega
    simpa only [Nat.cast_eq_zero] using hn.symm
theorem finish_run (q : RNames) {B n fv pv : Nat} {σ : Env}
    (hn : σ.vars q.n=n) (hf : σ.vars q.f=fv) (hp : σ.vars q.pv=pv)
    (hnB : n<B) (h1B : 1<B) (hfv : fv=0 ∨ fv=1)
    (hpB : fv=1 → pv<B) :
    ∃τ,Run B (finish q) σ τ 12 ∧
      τ=σ.setVar q.w (if fv=1 ∧ pv=n-1 then 1 else 0) := by
  have ef : (Expr.var q.f).evalB B σ=some fv := by
    simpa only [hf] using evalB_var (σ:=σ) (B:=B) (x:=q.f) (by rw [hf];rcases hfv with h|h <;> omega)
  have e1 := evalB_lit (σ:=σ) h1B
  have e0 := evalB_lit (σ:=σ) (show 0<B by omega)
  by_cases hf1 : fv=1
  · have ec : (Cond.eq (.var q.f) (.lit 1)).evalB B σ=some true := by
      simpa [hf1] using evalB_condEq ef e1
    have ep : (Expr.var q.pv).evalB B σ=some pv := by
      simpa only [hp] using evalB_var (σ:=σ) (B:=B) (x:=q.pv) (by rw [hp];exact hpB hf1)
    have en : (Expr.var q.n).evalB B σ=some n := by
      simpa only [hn] using evalB_var (σ:=σ) (B:=B) (x:=q.n) (by rw [hn];exact hnB)
    have es : (Expr.bin .sub (.var q.n) (.lit 1)).evalB B σ=some (n-1) :=
      evalB_bin (op:=.sub) en e1 (by change n-1<B;omega)
    by_cases he : pv=n-1
    · have eh : (Cond.eq (.var q.pv) (.bin .sub (.var q.n) (.lit 1))).evalB B σ=some true := by
        simpa [he] using evalB_condEq ep es
      refine ⟨σ.setVar q.w 1,?_,by rw [if_pos ⟨hf1,he⟩]⟩
      exact (Run.ite_true ec (Run.ite_true eh (Run.assign e1))).mono (by simp [Cond.size,Expr.size])
    · have eh : (Cond.eq (.var q.pv) (.bin .sub (.var q.n) (.lit 1))).evalB B σ=some false := by
        simpa [he] using evalB_condEq ep es
      refine ⟨σ.setVar q.w 0,?_,by rw [if_neg (by simp [he])]⟩
      exact (Run.ite_true ec (Run.ite_false eh (Run.assign e0))).mono (by simp [Cond.size,Expr.size])
  · have ec : (Cond.eq (.var q.f) (.lit 1)).evalB B σ=some false := by
      simpa [hf1] using evalB_condEq ef e1
    refine ⟨σ.setVar q.w 0,?_,by rw [if_neg (by simp [hf1])]⟩
    exact (Run.ite_false ec (Run.assign e0)).mono (by simp [Cond.size,Expr.size])
theorem program_run (q : RNames) (hq : q.Valid canonical)
    {B Sn n u : Nat} {σ : Env} (hS : Slots F canonical q.WS Sn B σ)
    (hN : σ.vars q.N=n) (hn : σ.vars q.n=n) (hu : σ.vars q.u=u)
    (hfit : Problem18ClaudeIMPPivot20261001.rowStart n u+n ≤ Sn)
    (hz : val F canonical q.WS σ 0=0) (huB : u<B) (h1B : 1<B)
    (P : K[X]) (htail : ∀i,n ≤ i → P.coeff i=0)
    (hcoef : ∀i<n,val F canonical q.WS σ
      (Problem18ClaudeIMPPivot20261001.rowStart n u+i)=P.coeff (n-1-i)) :
    ∃τ,Run B (program q) σ τ ((52+1000*(F.e+1))*(n+1)+12) ∧
      Slots F canonical q.WS Sn B τ ∧ (τ.vars q.w=1 ↔ IsUnit P) ∧
      (τ.vars q.w=0 ∨ τ.vars q.w=1) ∧
      (∀s,val F canonical q.WS τ s=val F canonical q.WS σ s) ∧
      (∀x,x∉regNames canonical → x≠q.i → x≠q.f → x≠q.pv → x≠q.w → τ.vars x=σ.vars x) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  classical
  obtain ⟨ξ,hr,hs,hm,hscan,hv,hin,hout⟩:=leading_run F q hq hS hN hn hu hfit hz huB P htail hcoef
  have hnξ : ξ.vars q.n=n := (hv _ (hq.2 _ (by simp [RNames.list]))
    (hq.ne_of (by intro h;simp [RNames.list,h]))
    (hq.ne_of (by intro h;simp [RNames.list,h]))
    (hq.ne_of (by intro h;simp [RNames.list,h]))).trans hn
  have hscan' : (ξ.vars q.f=0 ∧ P=0) ∨
      (ξ.vars q.f=1 ∧ ξ.vars q.pv<n ∧ P≠0 ∧ P.natDegree=n-1-ξ.vars q.pv) := by
    rcases hscan with h|⟨a,b,c,d,_⟩
    · exact Or.inl h
    · exact Or.inr ⟨a,b,c,d⟩
  have hnb : n<B := by
    have := hs.slots_word
    unfold Problem18ClaudeIMPPivot20261001.rowStart at hfit
    omega
  have hf : ξ.vars q.f=0 ∨ ξ.vars q.f=1 := by
    rcases hscan' with h|h
    · exact Or.inl h.1
    · exact Or.inr h.1
  have hp : ξ.vars q.f=1 → ξ.vars q.pv<B := by
    intro h
    rcases hscan' with hh|hh
    · omega
    · omega
  obtain ⟨τ,ht,he⟩:=finish_run q hnξ rfl rfl hnb h1B hf hp
  subst τ
  have hqw : q.w≠q.WS := hq.ne_of (by intro h;simp [RNames.list,h])
  refine ⟨_,hr.seq ht,Slots.setVar F canonical hs (hq.2 _ (by simp [RNames.list])) hqw _,?_,?_,?_,?_,hin,hout⟩
  · simp only [vars_setVar,if_true]
    rw [ite_eq_left_iff]
    simpa only [zero_ne_one,imp_false,not_not] using scan_unit_iff P hscan'
  · simp only [vars_setVar,if_true]
    split <;> simp
  · intro s
    rw [val_setVar F canonical hqw,hm]
  · intro x hx hxi hxf hxp hxw
    rw [vars_setVar,if_neg hxw,hv x hx hxi hxf hxp]
end Mathproof.Problem18IMPPolynomialUnitCheck20261002
