  intro u
  obtain ⟨L,hL⟩ := E.exists_leftInverse_of_injective (LinearMap.ker_eq_bot.mpr hE)
  let c : Upper s → K := fun p => if h : p∈Z then u.1 ⟨p,h⟩ else 0
  let d : Fin s → diagonalSpace τ eps := fun i => if h : i∈D then u.2 ⟨i,h⟩ else 0
  let C := fullForm τ eps c d
  let H := pullback τ C L
  have hH : ∀ x y,H y x=eps*τ (H x y) := fun x y =>
    fullForm_symm τ eps hτ heps c d (L x) (L y)
  have he : eps ≠ 0 := by intro hz; simp [hz] at heps
  let T : selfAdjointSpace τ B := ⟨formOperator τ B hB H,
    formOperator_selfAdjoint τ B hB eps he hsym H hH⟩
  have hLE (x : Fin s → K) : L (E x)=x := LinearMap.congr_fun hL x
  refine ⟨T,?_⟩
  apply Prod.ext
  · funext p
    change B (formOperator τ B hB H (E (Pi.single p.val.val.1 1)))
      (E (Pi.single p.val.val.2 1))=u.1 p
    rw [formOperator_spec]
    change C (L (E (Pi.single p.val.val.1 1))) (L (E (Pi.single p.val.val.2 1)))=u.1 p
    simp only [hLE]
    simp only [C,fullForm,Matrix.toLinearMapₛₗ₂'_single,fullMatrix,Matrix.add_apply,
      upperMatrix,dif_pos p.val.property,Matrix.diagonal_apply_ne _ (ne_of_lt p.val.property),add_zero]
    simp [c,p.property]
  · funext i
    apply Subtype.ext
    change B (formOperator τ B hB H (E (Pi.single i.val 1))) (E (Pi.single i.val 1))=(u.2 i).val
    rw [formOperator_spec]
    change C (L (E (Pi.single i.val 1))) (L (E (Pi.single i.val 1)))=(u.2 i).val
    simp only [hLE]
    simp [C,fullForm,Matrix.toLinearMapₛₗ₂'_single,fullMatrix,upperMatrix,d,i.property]
theorem mixed_fiber_card_mul (hτ : Function.Involutive τ) (heps : eps*τ eps=1)
    (B : Form (V := Fin n → K) τ) (hB : B.SeparatingLeft)
    (hsym : ∀ x y,B y x=eps*τ (B x y))
    (E : (Fin s → K) →ₗ[K] (Fin n → K)) (hE : Function.Injective E)
    (Z : Finset (Upper s)) (D : Finset (Fin s))
