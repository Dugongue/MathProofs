abbrev IsometricEmbeddings (B : Form σ V) (C : Form σ W) :=
  {j : V →ₗ[K] W // ∀ x y,C (j x) (j y)=B x y}
theorem embedding_injective (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft)
    (j : IsometricEmbeddings σ B C) : Function.Injective j.val := by
  apply (injective_iff_map_eq_zero j.val).mpr
  intro x hx
  apply hB
  intro y
  rw [← j.property,hx,map_zero,LinearMap.zero_apply]
noncomputable def rangeCoordinateEquiv (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft)
    (j₀ j : IsometricEmbeddings σ B C) (hr : LinearMap.range j.val=LinearMap.range j₀.val) :
    V ≃ₗ[K] V :=
  (LinearEquiv.ofInjective j.val (embedding_injective σ B C hB j)).trans
    ((LinearEquiv.ofEq _ _ hr).trans
      (LinearEquiv.ofInjective j₀.val (embedding_injective σ B C hB j₀)).symm)
theorem rangeCoordinateEquiv_apply (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft)
    (j₀ j : IsometricEmbeddings σ B C) (hr : LinearMap.range j.val=LinearMap.range j₀.val)
    (x : V) : j₀.val (rangeCoordinateEquiv σ B C hB j₀ j hr x)=j.val x := by
  let e₀ := LinearEquiv.ofInjective j₀.val (embedding_injective σ B C hB j₀)
  change (((e₀ (e₀.symm
    ((LinearEquiv.ofEq _ _ hr) ((LinearEquiv.ofInjective j.val
      (embedding_injective σ B C hB j)) x)))) : LinearMap.range j₀.val) : W)=j.val x
  rw [e₀.apply_symm_apply]
  rfl
noncomputable def sameRangeIsometry (B : Form σ V) (C : Form σ W) (hB : B.SeparatingLeft)
    (j₀ j : IsometricEmbeddings σ B C) (hr : LinearMap.range j.val=LinearMap.range j₀.val) :
    Isometries σ B :=
  ⟨rangeCoordinateEquiv σ B C hB j₀ j hr,by
    intro x y
    rw [← j₀.property,rangeCoordinateEquiv_apply,rangeCoordinateEquiv_apply,j.property]⟩
noncomputable def sameRangeEmbeddingEquiv (B : Form σ V) (C : Form σ W)
    (hB : B.SeparatingLeft) (j₀ : IsometricEmbeddings σ B C) :
    {j : IsometricEmbeddings σ B C // LinearMap.range j.val=LinearMap.range j₀.val} ≃
      Isometries σ B where
  toFun j := sameRangeIsometry σ B C hB j₀ j.val j.property
  invFun U := ⟨⟨j₀.val.comp U.val.toLinearMap,by
    intro x y
    change C (j₀.val (U.val x)) (j₀.val (U.val y))=B x y
    rw [j₀.property,U.property]⟩,by
      ext w
      constructor
      · rintro ⟨x,rfl⟩
        exact ⟨U.val x,rfl⟩
      · rintro ⟨x,rfl⟩
        refine ⟨U.val.symm x,?_⟩
        change j₀.val (U.val (U.val.symm x))=j₀.val x
        rw [U.val.apply_symm_apply]⟩
  left_inv j := by
    apply Subtype.ext
    apply Subtype.ext
    apply LinearMap.ext
    intro x
    exact rangeCoordinateEquiv_apply σ B C hB j₀ j.val j.property x
  right_inv U := by
    apply Subtype.ext
    apply LinearEquiv.ext
    intro x
