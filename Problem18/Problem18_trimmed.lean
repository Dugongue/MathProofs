namespace Mathproof.Problem18IMPBoundarySizeExpressions20261002
open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Problem18ClaudeIMPSlots20261001 Problem18BoundedEncoding20260930
inductive SizeExpr where
  | lit : Nat→SizeExpr
  | dim : SizeExpr
  | degree : SizeExpr
  | add : SizeExpr→SizeExpr→SizeExpr
  | mul : SizeExpr→SizeExpr→SizeExpr
def value : SizeExpr→Nat→Nat→Nat
  | .lit c,_,_=>c
  | .dim,n,_=>n
  | .degree,_,e=>e
  | .add a b,n,e=>value a n e+value b n e
  | .mul a b,n,e=>value a n e*value b n e
def majorant : SizeExpr→Nat→Nat→Nat
  | .lit c,_,_=>c+1
  | .dim,n,_=>n+1
  | .degree,_,e=>e+1
  | .add a b,n,e=>majorant a n e+majorant b n e
  | .mul a b,n,e=>majorant a n e*majorant b n e
def expression (dimName degreeName : String) : SizeExpr→Expr
  | .lit c=>.lit c
  | .dim=>.var dimName
  | .degree=>.var degreeName
  | .add a b=>.bin .add (expression dimName degreeName a) (expression dimName degreeName b)
  | .mul a b=>.bin .mul (expression dimName degreeName a) (expression dimName degreeName b)
theorem majorant_pos (s : SizeExpr) (n e : Nat) : 0< majorant s n e := by
  induction s with
  | lit c=>simp [majorant]
  | dim=>simp [majorant]
  | degree=>simp [majorant]
  | add a b ha hb=>simpa only [majorant] using Nat.add_pos_left ha _
  | mul a b ha hb=>exact Nat.mul_pos ha hb
theorem value_lt_majorant (s : SizeExpr) (n e : Nat) : value s n e< majorant s n e := by
  induction s with
  | lit c=>simp [value,majorant]
  | dim=>simp [value,majorant]
  | degree=>simp [value,majorant]
  | add a b ha hb=>simp only [value,majorant];omega
  | mul a b ha hb=>
    simp only [value,majorant]
    exact (Nat.mul_le_mul_left _ (Nat.le_of_lt hb)).trans_lt
      (Nat.mul_lt_mul_of_pos_right ha (majorant_pos b n e))
theorem expression_eval (s : SizeExpr) (dimName degreeName : String)
    {B n e : Nat} {σ : Env} (hn : σ.vars dimName=n) (he : σ.vars degreeName=e)
    (hb : majorant s n e<B) :
    (expression dimName degreeName s).evalB B σ=some (value s n e) := by
  induction s with
  | lit c=>exact evalB_lit (by simpa only [majorant] using (Nat.lt_trans (Nat.lt_succ_self c) hb))
  | dim=>simpa only [expression,value,hn] using evalB_var (B:=B) (σ:=σ) (x:=dimName) (by rw [hn];simpa only [majorant,value] using (value_lt_majorant SizeExpr.dim n e).trans hb)
  | degree=>simpa only [expression,value,he] using evalB_var (B:=B) (σ:=σ) (x:=degreeName) (by rw [he];simpa only [majorant,value] using (value_lt_majorant SizeExpr.degree n e).trans hb)
  | add a b ha hc=>
    have hab : majorant a n e<B := by simp only [majorant] at hb;omega
    have hcb : majorant b n e<B := by simp only [majorant] at hb;omega
    exact evalB_bin (ha hab) (hc hcb) ((value_lt_majorant (.add a b) n e).trans hb)
  | mul a b ha hc=>
    have hpa:=majorant_pos a n e
    have hpc:=majorant_pos b n e
    have hab : majorant a n e<B := (Nat.le_mul_of_pos_right _ hpc).trans_lt hb
    have hcb : majorant b n e<B := (Nat.le_mul_of_pos_left _ hpa).trans_lt hb
    exact evalB_bin (ha hab) (hc hcb) ((value_lt_majorant (.mul a b) n e).trans hb)
theorem expression_noVar (s : SizeExpr) (dn en x : String) (hd : dn≠x) (he : en≠x) :
    NoVar x (expression dn en s) := by
  induction s with
  | lit c=>trivial
  | dim=>exact hd
  | degree=>exact he
  | add a b ha hb=>exact ⟨ha,hb⟩
  | mul a b ha hb=>exact ⟨ha,hb⟩
def boundPolynomial : SizeExpr→PolyExpr Bool Nat
  | .lit c=>.const (c+1)
  | .dim=>.add (.var false) (.const 1)
  | .degree=>.add (.var true) (.const 1)
  | .add a b=>.add (boundPolynomial a) (boundPolynomial b)
  | .mul a b=>.mul (boundPolynomial a) (boundPolynomial b)
theorem majorant_polynomial (s : SizeExpr) (n e : Nat) :
    majorant s n e=(boundPolynomial s).eval (fun b=>if b then e else n) := by
  induction s <;> simp_all [majorant,boundPolynomial,PolyExpr.eval]
theorem word_polynomial_bound (s : SizeExpr) (n e : Nat) :
    majorant s n e ≤ (boundPolynomial s).eval (fun _=>1)*(n+e+1)^(boundPolynomial s).degree := by
  rw [majorant_polynomial]
  apply Problem18BoundedMedianReduction20261001.nat_expression_bound
  · omega
  · intro b
    cases b <;> simp <;> omega
end Mathproof.Problem18IMPBoundarySizeExpressions20261002
end
