  · dsimp [A]
    rw [deg_add,deg_principalDivisorA_eq_zero,add_zero]
  · dsimp [A]
    rw [map_add,divisorClass_principal,add_zero]
theorem finite_degree_zero_classes [Finite k] : Finite (classDegree k K).ker := by
  classical
