variable {K : Type} [Field K] [Fintype K] [DecidableEq K]
def program (F : FieldPresentation K) (n M : Nat) (answer : String) : Nat → Nat → Com
  | 0,_ => .assign answer (.lit 0)
  | l+1,d => .seq ((config n M).program n d)
      (.ite (.eq (.var (config n M).fixedFlag) (.lit 1)) (.assign answer (.lit 1))
        (.seq (Problem18RecursiveWorkspaceStep20261002.program F n d M)
          (program F n M answer l (collDeg n d))))
def cost (F : FieldPresentation K) (n M : Nat) : Nat → Nat → Nat
  | 0,_ => 2
  | l+1,d => (config n M).fixedCost F n d 0+6+
      Problem18RecursiveWorkspaceStep20261002.cost F n d M+cost F n M l (collDeg n d)
def coefficient (n : Nat) : Nat → Nat → Nat
  | 0,_ => 2
  | l+1,d => fixedCoeff n d+6+stepCoefficient n d+coefficient n l (collDeg n d)
theorem cost_bound (F : FieldPresentation K) (n M l d : Nat) :
    cost F n M l d ≤ coefficient n l d*scale F M := by
  induction l generalizing d with
  | zero => simpa [cost,coefficient] using Nat.mul_le_mul_left 2 (scale_bounds F M).1
  | succ l ih =>
    have hf:=fixed_bound F n d M 0
    have hs:=step_bound F n d M
    have ht:=ih (collDeg n d)
    have h1:1 ≤ scale F M := (scale_bounds F M).1
    simp only [cost,coefficient]
    nlinarith
theorem run (F : FieldPresentation K) (n l d S B M : Nat) (answer : String)
    (rows : List (DenseInput n d K)) (σ : Env) (h : Loaded F n l d S B M rows σ) :
    ∃τ,Run B (program F n M answer l d) σ τ (cost F n M l d) ∧
      τ.vars answer=(if value n l d rows then 1 else 0) ∧
      (∀ a,(τ.arrs a).length=(σ.arrs a).length) ∧ τ.inp=σ.inp ∧ τ.out=σ.out := by
  induction l generalizing d rows σ with
  | zero =>
    refine ⟨σ.setVar answer 0,Run.assign (evalB_lit (by have hh:=h.seven; omega)),?_,?_,rfl,rfl⟩
