variable {K : Type} [Field K] [Fintype K] [BEq K] [LawfulBEq K] [DecidableEq K]
structure PairInput (F : FieldPresentation K) (B a b c : Nat) (u : Bool) (q : Nat)
    (A T : RectTensor a b c K) (sigma : Env) : Prop where
  src : BoundaryInput F B a b c u q A sigma
  target_fit : a*b*c*F.e ≤ (sigma.arrs targetBank).length
  target_value : ∀x<a*b*c*F.e,(sigma.arrs targetBank).getD x 0=
    (tensorCoordinates F T).getD x 0
  target_canonical : ∀x<a*b*c*F.e,(sigma.arrs targetBank).getD x 0<F.p
  keep_fit : a*b*c*F.e ≤ (sigma.arrs keepBank).length
  keep_len : (sigma.arrs keepBank).length=a*b*c*F.e
  pair_fit : 2*memLen (boundaryWidth a b c) F.e ≤ (sigma.arrs pairBank).length
  len_word : majorant memLenSize (boundaryWidth a b c) F.e+
    2*memLen (boundaryWidth a b c) F.e<B
theorem snap_of_pair {σ τ : Env} {off n : Nat} {S : Matrix (Fin n) (Fin n) K}
    (F : FieldPresentation K) (h : Snap F σ off S)
    (hp : τ.arrs pairBank=σ.arrs pairBank) : Snap F τ off S := by
  have hs : ∀s,pairSlot F τ off s=pairSlot F σ off s := by
    intro s;unfold pairSlot;rw [hp]
  exact ⟨fun i j=>by rw [hs];exact h.matrix i j,fun j=>by rw [hs];exact h.vector j,
    fun j hj=>by rw [hs];exact h.polynomial j hj,fun k hk=>by rw [hp];exact h.canonical k hk⟩
theorem ext_tensor (σ : Env) : (externalState σ).arrs tensorBank=σ.arrs tensorBank := rfl
theorem ext_vars (σ : Env) : (externalState σ).vars=σ.vars := rfl
theorem loaded_transfer {P : Problem18IMPTensorGather20261002.Parameters} {σ τ : Env}
    (h : P.loaded σ) (hv : ∀x∈stageProtected,τ.vars x=σ.vars x) : P.loaded τ := by
  rcases h with ⟨h0,h1,h2,h3,h4,h5,h6⟩
  exact ⟨(hv _ (by simp [stageProtected])).trans h0,(hv _ (by simp [stageProtected])).trans h1,
    (hv _ (by simp [stageProtected])).trans h2,(hv _ (by simp [stageProtected])).trans h3,
    (hv _ (by simp [stageProtected])).trans h4,(hv _ (by simp [stageProtected])).trans h5,
    (hv _ (by simp [stageProtected])).trans h6⟩
structure FirstOut (F : FieldPresentation K) (B a b c : Nat) (u : Bool) (q : Nat)
    (A T : RectTensor a b c K) (sigma rho : Env) (hfirst : (shape (sortOrder a b c) a b c).1=1) :
    Prop where
  input : BoundaryInput F B a b c u q T rho
  snap : Snap F rho 0 (stageGram u q A hfirst)
  keep : ∀k<a*b*c*F.e,(rho.arrs keepBank).getD k 0=(tensorCoordinates F A).getD k 0
  keep_len : (rho.arrs keepBank).length=(sigma.arrs keepBank).length
  target : rho.arrs targetBank=sigma.arrs targetBank
  pair_len : (rho.arrs pairBank).length=(sigma.arrs pairBank).length
  regs : ∀x∈stageProtected,rho.vars x=sigma.vars x
  inp : rho.inp=sigma.inp
  out : rho.out=sigma.out
theorem firstHalf_run (F : FieldPresentation K) {B a b c : Nat} {u : Bool} {q : Nat}
    {A T : RectTensor a b c K} {sigma : Env} (h : PairInput F B a b c u q A T sigma) :
    ∃rho t, Run B firstHalf sigma rho t ∧
      t ≤ stageCost F q a b c+3+
        (20*memLen (boundaryWidth a b c) F.e+9+memLenExpr.size+2)+
        2*(20*(a*b*c*F.e)+9+3) ∧
      FirstOut F B a b c u q A T sigma rho h.src.first := by
  have hNB : a*b*c*F.e<B := lt_of_le_of_lt h.src.tensor_fit h.src.tensor_word
  have hLB : memLen (boundaryWidth a b c) F.e<B := by have:=h.len_word;omega
  have hpB : F.p<B := by
    have hh:=h.src.nativeValid.arithmetic_word
    nlinarith
  obtain ⟨s1,t1,ht1,hr1,hst1,hwork1,hi1,ho1⟩:=stageController_run F sigma h.src
  have hreg1 : ∀x∈stageProtected,s1.vars x=sigma.vars x :=
    fun x hx=>(run_frame hr1).1 x (stage_protected x hx)
  have harr1 : ∀a∈[tensorBank,targetBank,pairBank],s1.arrs a=sigma.arrs a :=
    fun a ha=>(run_frame hr1).2.1 a (stage_arrays a ha)
  have hkeep1 : s1.arrs keepBank=sigma.arrs keepBank := (run_frame hr1).2.1 _ keep_not_written
  obtain ⟨s2,hr2,hst2,hv2,hvars2,harr2,hi2,ho2⟩:=zeroGap_run F hst1
  have hcols2 : s2.vars Problem18IMPTensorGather20261002.cols=boundaryWidth a b c := by
    rw [hvars2,hreg1 _ (by simp [stageProtected])];exact h.src.cols_eq
  have he2 : s2.vars canonical.e=F.e := hv2.degree
  have hmemLen2 : (s2.arrs canonical.mem).length=memLen (boundaryWidth a b c) F.e := hst2.length
  have hpair2 : s2.arrs pairBank=sigma.arrs pairBank := by
    rw [harr2 _ (by decide),harr1 _ (by simp)]
  obtain ⟨s3,hr3,hcopy3,-,harr3,hlen3,hvars3,hi3,ho3⟩:=
    copyBlock_run (src:=canonical.mem) (dst:=pairBank) (by decide)
      (cntE:=memLenExpr) (sbE:=.lit 0) (dbE:=.lit 0) (B:=B) (n:=memLen (boundaryWidth a b c) F.e) (sourceBase:=0)
      (targetBase:=0) s2
      (memLenExpr_eval hcols2 he2 (by have:=h.len_word;omega))
      (evalB_lit (by omega)) (evalB_lit (by omega)) hLB (by omega) (by omega)
      (by omega)
      (by rw [hpair2];have:=h.pair_fit;omega)
      (by
        intro k hk
        have := hv2.coefficients (0+k) (by omega)
        omega)
  have hsnap3 : Snap F s3 0 (stageGram u q A h.src.first) :=
    snap_of_state F hst2 hv2 (by intro k hk;simpa using hcopy3 k hk)
  have hreg3 : ∀x∈stageProtected,s3.vars x=sigma.vars x := by
    intro x hx;rw [hvars3 x (copyRegs_fresh x hx),hvars2,hreg1 x hx]
  have htotal3 : s3.vars Problem18IMPTensorGather20261002.total=a*b*c*F.e := by
    rw [hreg3 _ (by simp [stageProtected])]
    simpa [externalState] using h.src.total_eq
  have htensor3 : s3.arrs tensorBank=sigma.arrs tensorBank := by
    rw [harr3 _ (by decide),harr2 _ (by decide),harr1 _ (by simp)]
  have hext : ∀k,(sigma.arrs tensorBank).getD k 0=
      ((externalState sigma).arrs tensorBank).getD k 0 := fun k=>by rw [ext_tensor]
  have hextLen : (sigma.arrs tensorBank).length=((externalState sigma).arrs tensorBank).length := by
    rw [ext_tensor]
  obtain ⟨s4,hr4,hcopy4,-,harr4,hlen4,hvars4,hi4,ho4⟩:=
    copyBlock_run (src:=tensorBank) (dst:=keepBank) (by decide)
      (cntE:=.var Problem18IMPTensorGather20261002.total) (sbE:=.lit 0) (dbE:=.lit 0)
      (B:=B) (n:=a*b*c*F.e) (sourceBase:=0) (targetBase:=0) s3
      (by rw [evalB_var (by rw [htotal3];exact hNB),htotal3])
      (evalB_lit (by omega)) (evalB_lit (by omega)) hNB (by omega) (by omega)
      (by rw [htensor3,hextLen];have:=h.src.tensor_fit;omega)
      (by rw [harr3 _ (by decide),harr2 _ (by decide),hkeep1];have:=h.keep_fit;omega)
      (by
        intro k hk
        rw [htensor3,hext]
        have := h.src.tensor_coefficients (0+k) (by rw [← hextLen];have:=h.src.tensor_fit;rw [hextLen] at *;omega)
        omega)
  have hreg4 : ∀x∈stageProtected,s4.vars x=sigma.vars x := by
    intro x hx;rw [hvars4 x (copyRegs_fresh x hx),hreg3 x hx]
  have htotal4 : s4.vars Problem18IMPTensorGather20261002.total=a*b*c*F.e := by
    rw [hvars4 _ (by decide),htotal3]
  have htarget4 : s4.arrs targetBank=sigma.arrs targetBank := by
    rw [harr4 _ (by decide),harr3 _ (by decide),harr2 _ (by decide),harr1 _ (by simp)]
  have htensor4 : s4.arrs tensorBank=sigma.arrs tensorBank := by
    rw [harr4 _ (by decide),htensor3]
  obtain ⟨s5,hr5,hcopy5,hout5,harr5,hlen5,hvars5,hi5,ho5⟩:=
    copyBlock_run (src:=targetBank) (dst:=tensorBank) (by decide)
      (cntE:=.var Problem18IMPTensorGather20261002.total) (sbE:=.lit 0) (dbE:=.lit 0)
      (B:=B) (n:=a*b*c*F.e) (sourceBase:=0) (targetBase:=0) s4
      (by rw [evalB_var (by rw [htotal4];exact hNB),htotal4])
      (evalB_lit (by omega)) (evalB_lit (by omega)) hNB (by omega) (by omega)
      (by rw [htarget4];simpa using h.target_fit)
      (by rw [htensor4,hextLen];have:=h.src.tensor_fit;omega)
      (by
        intro k hk
        rw [htarget4]
        have := h.target_canonical (0+k) (by omega)
        omega)
  have hreg5 : ∀x∈stageProtected,s5.vars x=sigma.vars x := by
    intro x hx;rw [hvars5 x (copyRegs_fresh x hx),hreg4 x hx]
  have hmem5 : s5.arrs canonical.mem=s2.arrs canonical.mem := by
    rw [harr5 _ (by decide),harr4 _ (by decide),harr3 _ (by decide)]
  have hscr5 : s5.arrs canonical.scratch=s2.arrs canonical.scratch := by
    rw [harr5 _ (by decide),harr4 _ (by decide),harr3 _ (by decide)]
  have hnat5 : ∀x∈[canonical.e,canonical.p,canonical.modBase,canonical.exp,WS,
      dimName,indexName],s5.vars x=s2.vars x := by
    intro x hx
    rw [hvars5 x (copyRegs_native x hx),hvars4 x (copyRegs_native x hx),
      hvars3 x (copyRegs_native x hx)]
  obtain ⟨hv5,hs5⟩:=restoreNativeInvariants F hv2 hst2.slots hmem5
    (by rw [hscr5];exact hst2.slots.base.scratch_word)
    (by rw [hscr5];exact hst2.slots.base.scratch_fit)
    (hnat5 _ (by simp)) (hnat5 _ (by simp)) (hnat5 _ (by simp)) (hnat5 _ (by simp))
    (by rw [hnat5 _ (by simp)];exact hst2.slots.base.exp_word)
  have htensorLen5 : (s5.arrs tensorBank).length=((externalState sigma).arrs tensorBank).length := by
    rw [hlen5,htensor4,hextLen]
