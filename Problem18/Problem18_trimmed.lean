    (asPolynomial f).eval₂ (Polynomial.aeval t).toRingHom y =
      aeval ![y,t] f := by
  let φ : MvPolynomial (Fin 2) K →ₐ[K] F :=
    (Polynomial.aevalTower (Polynomial.aeval t) y).comp (asPolynomial.toAlgHom)
  have he : φ = aeval ![y,t] := by
    apply MvPolynomial.algHom_ext
    intro i
    rw [aeval_X]
    fin_cases i
    · change (Polynomial.map (uniqueAlgEquiv K (Fin 1)).toRingHom
        (finSuccEquiv K 1 (X 0))).eval₂ (Polynomial.aeval t).toRingHom y = y
      rw [finSuccEquiv_X_zero, Polynomial.map_X, Polynomial.eval₂_X]
    · change (Polynomial.map (uniqueAlgEquiv K (Fin 1)).toRingHom
        (finSuccEquiv K 1 (X (Fin.succ (0 : Fin 1))))).eval₂
          (Polynomial.aeval t).toRingHom y = t
      rw [finSuccEquiv_X_succ, Polynomial.map_C, Polynomial.eval₂_C]
      simp [uniqueAlgEquiv_apply]
  exact DFunLike.congr_fun he f
