    apply addressExpr_eval F hρ.valid
    · rw [regs baseA (by simp)]; exact h.words baseA (by simp)
    · rw [regs strideA (by simp)]; exact h.words strideA (by simp)
    · exact wi
    · rw [ea]; exact hleft
  have heB0 : (addressExpr baseB strideB).evalB B ρ=
      some (address F σ baseB strideB (ρ.vars index)) := by
    rw [←eb]
    apply addressExpr_eval F hρ.valid
    · rw [regs baseB (by simp)]; exact h.words baseB (by simp)
    · rw [regs strideB (by simp)]; exact h.words strideB (by simp)
    · exact wi
    · rw [eb]; exact hright
  have heB : (addressExpr baseB strideB).evalB B
      (ρ.setVar canonical.aBase (address F σ baseA strideA (ρ.vars index)))=
      some (address F σ baseB strideB (ρ.vars index)) := by
