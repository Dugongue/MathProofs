        exact hrows u hu j hj
      · subst hu
        have := hv1 j hj
        rw [Nat.add_zero] at this
        rw [this]
        apply gval_congr
        intro k hk
        have := htbl k (by rw [← hk]; exact List.getElem_mem _)
        exact hfr _ (by omega) (Or.inr (by omega))
    · intro s hs hs'
      simp only [vars_setVar, if_true] at hs'
      have hsucc : (tv + 1) * tbl.length = tv * tbl.length + tbl.length := Nat.succ_mul tv tbl.length
      rw [hsucc] at hs'
      rw [val_setVar F r htW, hfr1 s hs (by omega)]
      exact hfr s hs (by omega)
