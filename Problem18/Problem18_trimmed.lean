      or_false, not_or] at hnd ⊢
    tauto
  refine ⟨τ, hr, hSτ, ?_, ?_, ?_, hN, ?_, hf, hvars, harr, hi, ho⟩
  · have := ha 0 (by omega); rwa [Nat.add_zero] at this
  · apply bank_rows
    · intro a t; show val F r q.WS τ (bb + (rowStart (n + m) a.val + t.val)) = v a t
      rw [← Nat.add_assoc]; exact hd a t
    · intro a u; show val F r q.WS τ (bb + (rowStart (n + m) a.val + n + u.val)) = _
      rw [← Nat.add_assoc, ← Nat.add_assoc]; exact he a u
  · apply bank_query
    · intro t; show val F r q.WS τ (bb + (5 + t.val)) = x t
      rw [← Nat.add_assoc]; exact hbq t
    · intro u hu; show val F r q.WS τ (bb + (5 + n + u)) = 0
      rw [← Nat.add_assoc, ← Nat.add_assoc]; exact hc u hu
  · rw [hvars _ (hL.reg _ hbank) (hL.j _ hbank) (hL.N _ hbank) hbw, hb]
end Consumer
