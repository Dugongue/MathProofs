    apply Subtype.ext
    funext P
    change (boundedDivisor k K N f.val P.val).toNat=f.val P
    rw [boundedDivisor_apply,dif_pos P.property,Int.toNat_natCast]
  · intro D
    apply Subtype.ext
    exact boundedDivisor_reconstruct k K N D.val D.property.1
      (by rw [D.property.2]; exact_mod_cast hn)
