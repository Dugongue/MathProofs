theorem two_pow_big (n k : Nat) (hk : 41 ≤ k) : n + 40 < 2 ^ (n + k) :=
  (Nat.lt_two_pow_self (n := n + 40)).trans_le (Nat.pow_le_pow_right (by omega) (by omega))
theorem nonempty_queryProgram (br : BranchPrograms) (B : Nat) (hB : 8 ≤ B) :
    Nonempty (QueryProgram B) := by
  obtain ⟨wp, tp, h36⟩ := Mathproof.Problem18P36SourceAssembly20261004.sourceAssemblyClosed B
  let pb := br.boundary B hB
  let pl := br.large B hB
  let prog := host B (p34Program B) pb.program pl.program
  let Ph : Polynomial Nat := wp.comp (Polynomial.X + Polynomial.C 7) + p34Word B +
    pb.wordPolynomial + pl.wordPolynomial + Polynomial.C (B + 47)
  let Tb : Polynomial Nat := p34Time B + pb.timePolynomial + pl.timePolynomial
  let Th : Polynomial Nat := Polynomial.C 40 * Polynomial.X + Polynomial.C 1100 +
    Polynomial.C 7 * tp.comp (Polynomial.X + Polynomial.C 7) + Polynomial.C 7 * Tb
  refine ⟨⟨Mathproof.Problem18P34Machine20261002Layout.layout prog, prog, Ph, Th,
    Mathproof.Problem18P34Machine20261002Layout.layout_ok prog, ?_⟩⟩
  intro x
  classical
  obtain ⟨n, hn⟩ : ∃ n, n = bitSize (words x) := ⟨_, rfl⟩
  rw [← hn]
  obtain ⟨W, hWdef⟩ : ∃ W, W = 2 ^ (Ph.eval n + n + 1) := ⟨_, rfl⟩
  rw [← hWdef]
  obtain ⟨F, hF⟩ : ∃ y, y = x.fieldData.presentation := ⟨_, rfl⟩
  obtain ⟨modL, hmodL⟩ : ∃ y, y = (List.finRange F.e).map (fun i => (F.modulus i).val) := ⟨_, rfl⟩
  obtain ⟨cA, hcAdef⟩ : ∃ y, y = tensorCoordinates F x.source := ⟨_, rfl⟩
  obtain ⟨cT, hcTdef⟩ : ∃ y, y = tensorCoordinates F x.target := ⟨_, rfl⟩
  obtain ⟨rest, hrest⟩ : ∃ y, y = modL ++ cA ++ cT := ⟨_, rfl⟩
  obtain ⟨N, hNdef⟩ : ∃ y, y = F.e + x.a*x.b*x.c*F.e := ⟨_, rfl⟩
  subst hF
  have hwx : words x = 1 :: x.unitary.toNat :: x.q :: x.fieldData.presentation.p ::
      x.fieldData.presentation.e :: x.a :: x.b :: x.c :: rest := by
    rw [words_eq x, hrest, hmodL, hcAdef, hcTdef]
  have hmodLl : modL.length = x.fieldData.presentation.e := by rw [hmodL]; simp
  have hcAl : cA.length = x.a*x.b*x.c*x.fieldData.presentation.e := by
    rw [hcAdef]
    exact Mathproof.Problem18TensorGatherRefinement20261002.tensorCoordinates_length _ x.source
  have hcTl : cT.length = x.a*x.b*x.c*x.fieldData.presentation.e := by
    rw [hcTdef]
    exact Mathproof.Problem18TensorGatherRefinement20261002.tensorCoordinates_length _ x.target
  have hrestl : rest.length = N + x.a*x.b*x.c*x.fieldData.presentation.e := by
    rw [hrest, hNdef]; simp [hmodLl, hcAl, hcTl]; omega
  have htake : rest.take N = modL ++ cA := by
    rw [hrest, List.take_append_of_le_length (by simp [hmodLl, hcAl, hNdef])]
    exact List.take_of_length_le (by simp [hmodLl, hcAl, hNdef])
  have he : 0 < x.fieldData.presentation.e := x.fieldData.presentation.degree_pos
  have hwl : (words x).length = rest.length + 8 := by rw [hwx]; simp
  have hnl : (words x).length ≤ n := hn ▸ Lax51Proofs.Encoding.length_le_bitSize _
  have hPh : wp.eval (n + 7) + 7 + (p34Word B).eval n + pb.wordPolynomial.eval n +
      pl.wordPolynomial.eval n + (B + 40) ≤ Ph.eval n := by
    simp [Ph, Polynomial.eval_add, Polynomial.eval_comp]; omega
  have hWbig : n + 40 < W := by
    rw [hWdef, show Ph.eval n + n + 1 = n + (Ph.eval n + 1) by omega]
    exact two_pow_big n _ (by omega)
  have hBW : B < W := by
    have : B < 2 ^ B := Nat.lt_two_pow_self
    rw [hWdef]; exact this.trans_le (Nat.pow_le_pow_right (by omega) (by omega))
  have hval : ∀ v ∈ words x, v < W := fun v hv =>
    (Lax51Proofs.Encoding.mem_lt_two_pow_bitSize_add_one hv).trans_le
      (by rw [← hn, hWdef]; exact Nat.pow_le_pow_right (by omega) (by omega))
  have hrl : rest.length + 8 ≤ n := by omega
  letI : BEq x.fieldData.carrier := instBEqOfDecidableEq
  obtain ⟨res, hcan, hres⟩ := h36 x.fieldData.carrier x.fieldData.presentation x.unitary x.q
    x.a x.b x.c x.valid x.positiveA x.positiveB x.positiveC x.source
  have hacc : res = accepted B x := by rw [hres]; rfl
  obtain ⟨tauS, costS, hcostS, hrunS, houtS⟩ := hcan
  have hroute := Mathproof.Problem18IMPSourceDispatch20261001.routeWords_source B x.a x.b x.c
  have hord := Mathproof.Problem18IMPSourceDispatch20261001.orderCode_lt
    (Problem18TensorSorting20261001.sortOrder x.a x.b x.c)
  have hbr := Mathproof.Problem18EncodedSourceCheck20261001.branch_range B x.a x.b x.c
  have hL36 : [0, x.unitary.toNat, x.q, x.fieldData.presentation.p, x.fieldData.presentation.e,
        x.a, x.b, x.c] ++
      Mathproof.Problem18IMPSourceDispatch20261001.routeWords B 0 x.a x.b x.c ++
      (List.finRange x.fieldData.presentation.e).map
        (fun i => (x.fieldData.presentation.modulus i).val) ++
      tensorCoordinates x.fieldData.presentation x.source =
      [0, x.unitary.toNat, x.q, x.fieldData.presentation.p, x.fieldData.presentation.e,
        x.a, x.b, x.c] ++
      Mathproof.Problem18IMPSourceDispatch20261001.routeWords B 0 x.a x.b x.c ++ rest.take N := by
    rw [htake, hmodL, hcAdef, List.append_assoc]
  rw [hL36] at hrunS hcostS
  have hns : bitSize ([0, x.unitary.toNat, x.q, x.fieldData.presentation.p,
        x.fieldData.presentation.e, x.a, x.b, x.c] ++
      Mathproof.Problem18IMPSourceDispatch20261001.routeWords B 0 x.a x.b x.c ++ rest.take N)
      ≤ n + 7 := by
    rw [hn, hwx, htake, hroute, hrest]
    exact routed_bitSize_le _ _ _ _ _ _ _ _ _ (modL ++ cA) cT (by omega) (by omega)
  have hlen36 : ([0, x.unitary.toNat, x.q, x.fieldData.presentation.p,
        x.fieldData.presentation.e, x.a, x.b, x.c] ++
      Mathproof.Problem18IMPSourceDispatch20261001.routeWords B 0 x.a x.b x.c ++
        rest.take N).length = 10 + N := by
    rw [htake, hroute]; simp [hmodLl, hcAl, hNdef]; omega
  rw [hlen36] at hrunS
  have hS := Mathproof.Problem18P34Assembly20261003BoundMono.run (B' := W) (by
      rw [hWdef]
      apply Nat.pow_le_pow_right (by omega)
      have := poly_mono wp hns
      omega) hrunS
  rw [hNdef] at hS
  obtain ⟨extX, τX, hX⟩ : ∃ (extX : String → Nat) (τX : Env), res = true →
      Run W (selectBranch (Mathproof.Problem18EncodedSourceCheck20261001.branch B x.a x.b x.c)
          (p34Program B) pb.program pl.program)
        (initEnv extX ((rest.length + 8) :: 1 :: x.unitary.toNat :: x.q ::
          x.fieldData.presentation.p :: x.fieldData.presentation.e :: x.a :: x.b :: x.c :: rest))
        τX (Tb.eval n) ∧
      τX.out = Mathproof.Problem18RAMAnswerCodec20261001.answerWords (pairAnswer x) := by
    by_cases hr : res = true
    · have hacc' : accepted B x = true := hacc ▸ hr
      have hTb : (p34Time B).eval n + pb.timePolynomial.eval n + pl.timePolynomial.eval n =
          Tb.eval n := by simp [Tb, Polynomial.eval_add]
      have hin : (words x).length :: words x = (rest.length + 8) :: 1 :: x.unitary.toNat ::
          x.q :: x.fieldData.presentation.p :: x.fieldData.presentation.e :: x.a :: x.b :: x.c ::
          rest := by rw [hwl, hwx]
      rcases (show Mathproof.Problem18EncodedSourceCheck20261001.branch B x.a x.b x.c = 1 ∨
          Mathproof.Problem18EncodedSourceCheck20261001.branch B x.a x.b x.c = 2 ∨
          Mathproof.Problem18EncodedSourceCheck20261001.branch B x.a x.b x.c = 3 by omega)
        with hk | hk | hk
      · let x34 : Mathproof.Problem18P34Machine20261002.Query B :=
          ⟨x.fieldData, x.unitary, x.q, x.a, x.b, x.c, x.valid, x.positiveA, x.positiveB,
            x.positiveC,
            (Mathproof.Problem18EncodedSourceCheck20261001.branch_small B x.a x.b x.c).mp hk,
            x.source, x.target⟩
        obtain ⟨e34, σ34, hr34, ho34⟩ := p34_executes B x34
        refine ⟨e34, σ34, fun _ => ⟨?_, ho34⟩⟩
        rw [hk]
        have hw34 : Mathproof.Problem18P34Machine20261002.words x34 = words x := rfl
        rw [hw34, ← hn, hin] at hr34
        refine (Mathproof.Problem18P34Assembly20261003BoundMono.run ?_ hr34).mono ?_
        · rw [hWdef]; apply Nat.pow_le_pow_right (by omega); omega
        · omega
      · obtain ⟨eb, σb, hrb, hob⟩ := pb.run x hk hacc'
        refine ⟨eb, σb, fun _ => ⟨?_, hob⟩⟩
        rw [hk]
        rw [← hn, hin] at hrb
        refine (Mathproof.Problem18P34Assembly20261003BoundMono.run ?_ hrb).mono ?_
        · rw [hWdef]; apply Nat.pow_le_pow_right (by omega); omega
        · omega
      · obtain ⟨el, σl, hrl', hol⟩ := pl.run x hk hacc'
        refine ⟨el, σl, fun _ => ⟨?_, hol⟩⟩
        rw [hk]
        rw [← hn, hin] at hrl'
        refine (Mathproof.Problem18P34Assembly20261003BoundMono.run ?_ hrl').mono ?_
        · rw [hWdef]; apply Nat.pow_le_pow_right (by omega); omega
        · omega
    · exact ⟨fun _ => 0, initEnv (fun _ => 0) [], fun h => absurd h hr⟩
  obtain ⟨ext, τ, hrun, hout⟩ := host_run (W := W) (B := B) (p34Program B) pb.program
    pl.program (u := x.unitary.toNat) (q := x.q) (p := x.fieldData.presentation.p)
    (e := x.fieldData.presentation.e) (a := x.a) (b := x.b) (c := x.c) (rest := rest)
    (by rw [← hNdef]; omega) he x.positiveC (by rw [← hwx]; exact hval) (by omega) hBW
    hS houtS hX
  refine ⟨ext, τ, ?_, ?_⟩
  · rw [hwl, hwx]
    refine hrun.mono ?_
    have h1 : costS ≤ tp.eval (n + 7) := hcostS.trans (poly_mono tp hns)
    have h2 : Th.eval n = 40 * n + 1100 + 7 * tp.eval (n + 7) + 7 * Tb.eval n := by
      simp [Th, Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_comp]
    rw [h2]; omega
  · rw [hout, sourceAnswer_eq, ← hacc]
    cases res <;> simp [Mathproof.Problem18RAMAnswerCodec20261001.answerWords]
theorem p37_of_branchPrograms (br : BranchPrograms) :
