      queryBits F unitary q A B := rfl
theorem polynomial_query_bound (P : Polynomial ℕ) :
    ∃ C d : ℕ, 0 < C ∧ 0 < d ∧
      ∀ (K : Type) [Field K] [Fintype K]
        (F : FieldPresentation K) (unitary : Bool) (q a b c : ℕ),
        validSize K unitary q → 0<a → 0<b → 0<c →
        ∀ A B : RectTensor a b c K,
          ((P.eval (queryBits F unitary q A B).length : ℕ) : ℝ) ≤
            C * (((a*b*c+1)*(q.size+1)) : ℝ)^d := by
  refine ⟨P.eval 1 * 128^P.natDegree + 1, 2*P.natDegree+1,
    by omega, by omega, ?_⟩
  intro K _ _ F unitary q a b c hv ha hb hc A B
  let S := (a*b*c+1)*(q.size+1)
  have hS : 1 ≤ S := Nat.succ_le_of_lt (by dsimp [S]; positivity)
  have hlen := queryBits_length_le F unitary q a b c hv ha hb hc A B
  have hp := eval_le_monomial P (queryBits F unitary q A B).length S hS hlen
  have hpow : S^(2*P.natDegree) ≤ S^(2*P.natDegree+1) :=
    pow_le_pow_right₀ hS (by omega)
  have hbound : P.eval (queryBits F unitary q A B).length ≤
      (P.eval 1 * 128^P.natDegree+1)*S^(2*P.natDegree+1) :=
    hp.trans (Nat.mul_le_mul (by omega) hpow)
