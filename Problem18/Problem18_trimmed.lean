    (by rw [regs prod (by simp)]; exact h.leftSeparate _ hi prod (by simp))
    (by rw [regs prod (by simp)]; exact h.rightSeparate _ hi prod (by simp))
    (by rw [regs acc (by simp),regs prod (by simp)]; exact h.separated.1)
    (by rw [regs next (by simp),regs prod (by simp)]; exact h.separated.2.1)
    (by rw [regs next (by simp),regs acc (by simp)]; exact h.separated.2.2)
    (by rw [regs acc (by simp),regs canonical.modBase (by simp)]; exact sep acc (by simp))
    (by rw [regs prod (by simp),regs canonical.modBase (by simp)]; exact sep prod (by simp))
    (by rw [regs next (by simp),regs canonical.modBase (by simp)]; exact sep next (by simp))
    (by rw [regs canonical.exp (by simp)]; exact h.exponent)
  have ei : ξ.vars index=ρ.vars index:=hfr.1 _ (by decide)
  have heinc : (Expr.add (.var index) (.lit 1)).evalB B ξ=some (ρ.vars index+1) := by
    have hn:=h.words count (by simp)
    have hx:=evalB_bin (op:=Bop.add)
      (evalB_var (by rw [ei]; exact wi) : (Expr.var index).evalB B ξ=some (ξ.vars index))
      (evalB_lit (by omega) : (Expr.lit 1).evalB B ξ=some 1)
