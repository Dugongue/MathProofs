  have hcov : ∀ f, ¬Good f → ∃ i : I, Q i f := by
    intro f hf
    rcases bad_covered f hf with h | ⟨d,g,hg⟩
    · exact ⟨none,h⟩
    · exact ⟨some ⟨d,g⟩,hg⟩
  have hb := card_le_good_add_sum_bad Good Q hcov
  have hx : Nat.card {f : MonicDegree (K := K) n // X ∣ f.1}=Nat.card K^(n-1) := by
    simpa only [natDegree_X] using card_monic_divisible (X : K[X]) monic_X (by rw [natDegree_X]; omega)
  have hsum : (∑ i : I, Nat.card {f : MonicDegree (K := K) n // Q i f}) =
      Nat.card K^(n-1) + ∑ d : Fin (n+1),
        Nat.card (NonzeroIrreducibleDegree (K := K) d)*repeatCount (K := K) n d := by
    rw [Fintype.sum_option,Fintype.sum_sigma]
    simp only [Q,hx]
    simp_rw [card_repeat]
    simp only [Finset.sum_const,Finset.card_univ,smul_eq_mul,Nat.card_eq_fintype_card]
  rw [hsum] at hb
  simpa only [FiniteFieldOrthogonalUnitaryTI.card_monic_polynomials,← add_assoc] using hb
end Mathproof.Problem18SquarefreeSieveBoundary20260930
