theorem kron_facts {a b i : Nat} (ha : 0 < a) (hb : 0 < b) (hi : i < a * b * (a * b)) :
    i / (a * b) < a * b ∧ i / (a * b) * (a * b) ≤ i ∧
    i - i / (a * b) * (a * b) < a * b ∧
    (i - i / (a * b) * (a * b)) / b < a ∧
    (i - i / (a * b) * (a * b)) / b * b ≤ i - i / (a * b) * (a * b) ∧
    i / (a * b) / b < a ∧ i / (a * b) / b * b ≤ i / (a * b) ∧
    (i - i / (a * b) * (a * b)) / b * a + i / (a * b) / b < a * a ∧
    i - i / (a * b) * (a * b) - (i - i / (a * b) * (a * b)) / b * b < b ∧
    i / (a * b) - i / (a * b) / b * b < b ∧
    (i - i / (a * b) * (a * b) - (i - i / (a * b) * (a * b)) / b * b) * b +
      (i / (a * b) - i / (a * b) / b * b) < b * b := by
