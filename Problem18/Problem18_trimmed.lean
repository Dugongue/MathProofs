      intro j hj
      have h1 := hlt j hj
      have h2 : F.p < W := by
        have : F.p + 1 ≤ (F.p + 1) ^ 2 := Nat.le_self_pow (by norm_num) _
        have := hG.arith; omega
      omega) hB2
  have hregs : ∀ x ∈ [canonical.e, canonical.p, canonical.modBase], x ∉ wcRegs := by decide
  have hG' : Glob F W Sn bankLen τ := Glob.transfer F hG
