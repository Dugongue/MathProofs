namespace Mathproof.Problem18IMPFieldEquality20261001
open Lax13Proofs.Imp Lax13Proofs.Reasoning
open Problem18IMPFieldLayout20261001 Problem18IMPFieldAddition20261001
def entryA (σ : Env) (r : FieldNames) (j : Nat) : Nat:=
  (σ.arrs r.mem).getD (σ.vars r.aBase+j) 0
def entryB (σ : Env) (r : FieldNames) (j : Nat) : Nat:=
  (σ.arrs r.mem).getD (σ.vars r.bBase+j) 0
def prefixEqual (σ : Env) (r : FieldNames) (n : Nat) : Bool:=
  (List.range n).all fun j=>entryA σ r j==entryB σ r j
def eqState (σ : Env) (r : FieldNames) (j : Nat) : Env:=
  (σ.setVar r.i j).setVar r.flag (if prefixEqual σ r j then 1 else 0)
theorem prefixEqual_succ (σ : Env) (r : FieldNames) (j : Nat) :
    prefixEqual σ r (j+1)=(prefixEqual σ r j && (entryA σ r j==entryB σ r j)) := by
  simp [prefixEqual,List.range_succ,List.all_append]
theorem eqState_initial (σ : Env) (r : FieldNames) (hif : r.i≠r.flag) :
    (σ.setVar r.flag 1).setVar r.i 0=eqState σ r 0 := by
  cases σ
  simp only [eqState,Env.setVar]
  congr 1
  funext x
  by_cases hx:x=r.i <;> by_cases hy:x=r.flag <;> simp_all [prefixEqual]
theorem eqState_next_true (σ : Env) (r : FieldNames) (j : Nat) (hif : r.i≠r.flag)
    (h : entryA σ r j=entryB σ r j) :
    (eqState σ r j).setVar r.i (j+1)=eqState σ r (j+1) := by
  cases σ
  simp only [eqState,Env.setVar]
  congr 1
  funext x
  by_cases hx:x=r.i <;> by_cases hy:x=r.flag <;> simp_all [prefixEqual_succ]
theorem eqState_next_false (σ : Env) (r : FieldNames) (j : Nat) (hif : r.i≠r.flag)
    (h : entryA σ r j≠entryB σ r j) :
    ((eqState σ r j).setVar r.flag 0).setVar r.i (j+1)=eqState σ r (j+1) := by
  cases σ
  simp only [eqState,Env.setVar]
  congr 1
  funext x
  by_cases hx:x=r.i <;> by_cases hy:x=r.flag <;> simp_all [prefixEqual_succ]
theorem eqState_flag (σ : Env) (r : FieldNames) (n : Nat) :
    (eqState σ r n).vars r.flag=1 ↔ ∀j<n,entryA σ r j=entryB σ r j := by
  simp [eqState,prefixEqual,List.all_eq_true]
theorem eqRoutine_run (r : FieldNames) {B : Nat} (σ : Env)
    (hif : r.i≠r.flag)
    (hregs : ∀x∈[r.p,r.e,r.aBase,r.bBase],x≠r.i ∧ x≠r.flag)
    (he : σ.vars r.e<B) (hword : (σ.vars r.p+1)^2<B)
    (hmem : (σ.arrs r.mem).length<B)
    (ha : σ.vars r.aBase+σ.vars r.e ≤ (σ.arrs r.mem).length)
    (hb : σ.vars r.bBase+σ.vars r.e ≤ (σ.arrs r.mem).length)
    (hcoeff : ∀j<σ.vars r.e,entryA σ r j<σ.vars r.p ∧ entryB σ r j<σ.vars r.p) :
    Run B (eqRoutine r) σ (eqState σ r (σ.vars r.e)) (1000*(σ.vars r.e+1)) := by
  let states:=eqState σ r
  have hv (j : Nat) (x : String) (hx : x∈[r.p,r.e,r.aBase,r.bBase]) :
      (states j).vars x=σ.vars x := by
    simp [states,eqState,(hregs x hx).1,(hregs x hx).2]
  have hi (j : Nat) : (states j).vars r.i=j := by simp [states,eqState,hif]
  have hpB:σ.vars r.p<B:=by nlinarith
  have hone:1<B:=by nlinarith
  have hstep : ∀j<σ.vars r.e,Run B (eqBody r) (states j) (states (j+1)) 20 := by
    intro j hj
    have hjB:j<B:=by omega
    have hj1:j+1<B:=by omega
    have hjlenA:σ.vars r.aBase+j<(σ.arrs r.mem).length:=by omega
    have hjlenB:σ.vars r.bBase+j<(σ.arrs r.mem).length:=by omega
    have haddr (x : String) (hx : x∈[r.p,r.e,r.aBase,r.bBase]) (hxj : σ.vars x+j<B) :
        (address x r.i).evalB B (states j)=some (σ.vars x+j) := by
      have hxB:σ.vars x<B:=by omega
      have hx' : (Expr.var x).evalB B (states j)=some (σ.vars x) := by
        simpa only [hv j x hx] using evalB_var (σ:=states j) (x:=x) (by rw [hv j x hx]; exact hxB)
      have hi' : (Expr.var r.i).evalB B (states j)=some j := by
        simpa only [hi j] using evalB_var (σ:=states j) (x:=r.i) (by rw [hi]; exact hjB)
      exact evalB_bin (op:=Bop.add) hx' hi' hxj
    have hlookupA : ((states j).arrs r.mem)[σ.vars r.aBase+j]?=some (entryA σ r j) :=
      getElem_some_getD _ _ hjlenA
    have hlookupB : ((states j).arrs r.mem)[σ.vars r.bBase+j]?=some (entryB σ r j) :=
      getElem_some_getD _ _ hjlenB
    have hxa:=evalB_get (haddr r.aBase (by simp) (by omega)) hlookupA ((hcoeff j hj).1.trans hpB)
    have hxb:=evalB_get (haddr r.bBase (by simp) (by omega)) hlookupB ((hcoeff j hj).2.trans hpB)
    have hc:=evalB_condEq hxa hxb
    by_cases h : entryA σ r j=entryB σ r j
    · have ht : (Cond.eq (.get r.mem (address r.aBase r.i))
          (.get r.mem (address r.bBase r.i))).evalB B (states j)=some true := by
        simpa only [h,beq_self_eq_true] using hc
      have hfirst:=Run.ite_true (d:=.assign r.flag (.lit 0)) ht (Run.skip (B:=B))
      have hinc : (Expr.add (.var r.i) (.lit 1)).evalB B (states j)=some (j+1) := by
        have hv' : (Expr.var r.i).evalB B (states j)=some j := by
          simpa only [hi j] using evalB_var (σ:=states j) (x:=r.i) (by rw [hi]; exact hjB)
        exact evalB_bin (op:=Bop.add) hv' (evalB_lit hone) hj1
      have hr:=hfirst.seq (Run.assign (x:=r.i) hinc)
      apply (hr.congr (eqState_next_true σ r j hif h)).mono
      norm_num [address,Expr.size,Cond.size]
    · have ht : (Cond.eq (.get r.mem (address r.aBase r.i))
          (.get r.mem (address r.bBase r.i))).evalB B (states j)=some false := by
        simpa only [beq_eq_false_iff_ne.mpr h] using hc
      have hfirst:=Run.ite_false (c:=.skip) ht (Run.assign (x:=r.flag) (evalB_lit (by omega : 0<B)))
      have hτi : ((states j).setVar r.flag 0).vars r.i=j := by simp [hi,hif]
      have hinc : (Expr.add (.var r.i) (.lit 1)).evalB B ((states j).setVar r.flag 0)=some (j+1) := by
        have hv' : (Expr.var r.i).evalB B ((states j).setVar r.flag 0)=some j := by
          simpa only [hτi] using evalB_var (σ:=(states j).setVar r.flag 0) (x:=r.i) (by rw [hτi]; exact hjB)
        exact evalB_bin (op:=Bop.add) hv' (evalB_lit hone) hj1
      have hr:=hfirst.seq (Run.assign (x:=r.i) hinc)
      apply (hr.congr (eqState_next_false σ r j hif h)).mono
      norm_num [address,Expr.size,Cond.size]
  have hloop:=countedLoop_run r.i r.e (eqBody r) states
    (fun j _=>hi j) (fun j _=>hv j r.e (by simp)) he hstep
  have hflag:=Run.assign (σ:=σ) (x:=r.flag) (evalB_lit hone)
  have hidx:=Run.assign (σ:=σ.setVar r.flag 1) (x:=r.i) (evalB_lit (by omega : 0<B))
  have hinit:Run B (.seq (.assign r.flag (.lit 1)) (.assign r.i (.lit 0))) σ (states 0) 4 := by
    exact (hflag.seq hidx).congr (eqState_initial σ r hif)
  obtain ⟨k,hk,hstart⟩:=hflag
  obtain ⟨l,hl,hindex⟩:=hidx
  obtain ⟨t,ht,hloop'⟩:=hloop
  dsimp only [states] at hloop'
  rw [←eqState_initial σ r hif] at hloop'
  refine ⟨k+(l+t),?_,BigStepB.seq hstart (BigStepB.seq hindex hloop')⟩
  simp only [Expr.size] at hk hl
  omega
end Mathproof.Problem18IMPFieldEquality20261001
