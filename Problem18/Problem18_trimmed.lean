        (mulMod cs (mulMod cs (powP cs x (Q / 2)) (powP cs x (Q / 2))).1 x).1
      else (mulMod cs (powP cs x (Q / 2)) (powP cs x (Q / 2))).1 := by
  unfold powP
  rw [bits_of_ne_zero hQ]
  simp only [powBits]
  by_cases h : Q % 2 = 1 <;> simp [h]
