variable {A t : Type*} [Ring A] [Algebra K A]
theorem generated_algebra_le_of_left_closed
    (S : t → A) (V : Submodule K A) (h1 : (1 : A) ∈ V)
    (hclosed : ∀ a x, x ∈ V → S a * x ∈ V) :
    (Algebra.adjoin K (Set.range S)).toSubmodule ≤ V := by
  intro x hx
  have h : ∀ y, y ∈ V → x * y ∈ V := by
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨a,rfl⟩ := hx
      exact hclosed a
    | algebraMap r =>
      intro y hy
      simpa only [Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul] using V.smul_mem r hy
    | add x y hx hy ihx ihy =>
      intro z hz
      simpa only [add_mul] using V.add_mem (ihx z hz) (ihy z hz)
    | mul x y hx hy ihx ihy =>
      intro z hz
      simpa only [mul_assoc] using ihx (y*z) (ihy z hz)
  simpa only [mul_one] using h 1 h1
noncomputable def algebraWordSpace (S : t → A) : ℕ → Submodule K A
  | 0 => Submodule.span K {1}
  | k+1 => algebraWordSpace S k ⊔
      ⨆ a, (algebraWordSpace S k).map (LinearMap.mulLeft K (S a))
theorem algebraWordSpace_step (S : t → A) (k : ℕ) :
    algebraWordSpace (K := K) S k ≤ algebraWordSpace (K := K) S (k+1) := le_sup_left
theorem algebraWordSpace_mono (S : t → A) : Monotone (algebraWordSpace (K := K) S) :=
  monotone_nat_of_le_succ (algebraWordSpace_step (K := K) S)
theorem one_mem_algebraWordSpace (S : t → A) (k : ℕ) : (1 : A) ∈ algebraWordSpace (K := K) S k :=
  algebraWordSpace_mono (K := K) S (Nat.zero_le k) (Submodule.subset_span (by simp))
theorem generator_mul_mem_wordSpace (S : t → A) (k : ℕ) (a : t) (x : A)
    (hx : x ∈ algebraWordSpace (K := K) S k) : S a * x ∈ algebraWordSpace (K := K) S (k+1) := by
  apply (le_sup_right : (⨆ a, (algebraWordSpace (K := K) S k).map (LinearMap.mulLeft K (S a))) ≤ _)
  apply (le_iSup (fun a => (algebraWordSpace (K := K) S k).map (LinearMap.mulLeft K (S a))) a)
  exact ⟨x,hx,rfl⟩
theorem algebraWordSpace_le_adjoin (S : t → A) (k : ℕ) :
    algebraWordSpace (K := K) S k ≤ (Algebra.adjoin K (Set.range S)).toSubmodule := by
  induction k with
  | zero =>
    apply Submodule.span_le.mpr
    intro x hx
    obtain rfl := Set.mem_singleton_iff.mp hx
    exact (Algebra.adjoin K (Set.range S)).one_mem
  | succ k ih =>
    apply sup_le ih
    apply iSup_le
    intro a y hy
    obtain ⟨x,hx,rfl⟩ := hy
    exact (Algebra.adjoin K (Set.range S)).mul_mem (Algebra.subset_adjoin ⟨a,rfl⟩) (ih hx)
theorem algebraWordSpace_stable (S : t → A) (k : ℕ)
    (h : algebraWordSpace (K := K) S (k+1) = algebraWordSpace (K := K) S k) :
    algebraWordSpace (K := K) S k = (Algebra.adjoin K (Set.range S)).toSubmodule := by
  apply le_antisymm (algebraWordSpace_le_adjoin S k)
  apply generated_algebra_le_of_left_closed S _ (one_mem_algebraWordSpace (K := K) S k)
  intro a x hx
  rw [← h]
  exact generator_mul_mem_wordSpace (K := K) S k a x hx
variable [FiniteDimensional K A]
theorem algebraWordSpace_finrank_growth (S : t → A)
    (hgen : Algebra.adjoin K (Set.range S) = ⊤) (k : ℕ)
    (hk : algebraWordSpace (K := K) S k ≠ ⊤) : k ≤ Module.finrank K (algebraWordSpace (K := K) S k) := by
  induction k with
  | zero => omega
  | succ k ih =>
    have hprev : algebraWordSpace (K := K) S k ≠ ⊤ := by
      intro he
      apply hk
      exact top_unique (he ▸ algebraWordSpace_step (K := K) S k)
    have hstrict : algebraWordSpace (K := K) S k < algebraWordSpace (K := K) S (k+1) := by
      apply lt_of_le_of_ne (algebraWordSpace_step (K := K) S k)
      intro he
      have hs := algebraWordSpace_stable S k he.symm
      rw [hgen] at hs
      exact hprev hs
    have hr := Submodule.finrank_lt_finrank_of_lt hstrict
    have hi := ih hprev
    omega
theorem algebraWordSpace_full (S : t → A) (hgen : Algebra.adjoin K (Set.range S) = ⊤) :
    algebraWordSpace (K := K) S (Module.finrank K A + 1) = ⊤ := by
  by_contra h
  have hg := algebraWordSpace_finrank_growth S hgen _ h
  have hb := Submodule.finrank_le (algebraWordSpace (K := K) S (Module.finrank K A + 1))
  omega
end WordClosure
variable {i t : Type*} [Fintype i] [DecidableEq i]
theorem selectedWordSpan_cons (S : t → Matrix i i K) (w : List t) (ws : List (List t)) :
    selectedWordSpan S (w :: ws) = Submodule.span K {matrixWord S w} ⊔ selectedWordSpan S ws := by
  have he : matrixWord S '' {v | v ∈ w :: ws} = insert (matrixWord S w) (matrixWord S '' {v | v ∈ ws}) := by
    ext x
    simp [eq_comm]
  unfold selectedWordSpan
  rw [he, Submodule.span_insert]
theorem selectedWordSpan_step (S : t → Matrix i i K) (w : List t) (ws : List (List t)) :
    selectedWordSpan S (if matrixWord S w ∈ selectedWordSpan S ws then ws else w :: ws) =
      Submodule.span K {matrixWord S w} ⊔ selectedWordSpan S ws := by
  classical
  split_ifs with h
  · exact (sup_eq_right.mpr ((Submodule.span_singleton_le_iff_mem _ _).mpr h)).symm
  · exact selectedWordSpan_cons S w ws
theorem selectWords_span (S : t → Matrix i i K) (chosen candidates : List (List t)) :
    selectedWordSpan S (selectWords S chosen candidates) =
      selectedWordSpan S chosen ⊔ selectedWordSpan S candidates := by
  classical
  induction candidates generalizing chosen with
  | nil => simp [selectWords, selectedWordSpan]
  | cons w tail ih =>
    change selectedWordSpan S (selectWords S
      (if matrixWord S w ∈ selectedWordSpan S chosen then chosen else w :: chosen) tail) = _
    rw [ih, selectedWordSpan_step, selectedWordSpan_cons]
    ac_rfl
theorem matrixWordSpace_full (S : t → Matrix i i K)
    (hgen : Algebra.adjoin K (Set.range S) = ⊤) :
    algebraWordSpace (K := K) S ((Fintype.card i)^2 + 1) = ⊤ := by
  simpa only [Module.finrank_matrix, Module.finrank_self, mul_one, pow_two] using
    algebraWordSpace_full S hgen
theorem generatorWordCandidates_span (S : Fin m → Matrix i i K) (ws : List (List (Fin m))) :
    selectedWordSpan S (generatorWordCandidates ws) =
      ⨆ a, (selectedWordSpan S ws).map (LinearMap.mulLeft K (S a)) := by
  have he : matrixWord S '' {w | w ∈ generatorWordCandidates ws} =
      ⋃ a : Fin m, (LinearMap.mulLeft K (S a)) '' (matrixWord S '' {w | w ∈ ws}) := by
    ext X
    simp only [generatorWordCandidates, Set.mem_image, Set.mem_ofPred_eq, List.mem_flatMap,
      List.mem_ofFn, Set.mem_iUnion, LinearMap.mulLeft_apply]
    constructor
    · rintro ⟨w, ⟨v,hv,a,rfl⟩,rfl⟩
      exact ⟨a,matrixWord S v,⟨v,hv,rfl⟩,rfl⟩
    · rintro ⟨a,Y,⟨v,hv,rfl⟩,rfl⟩
      exact ⟨a::v,⟨v,hv,a,rfl⟩,rfl⟩
  unfold selectedWordSpan
  rw [he, Submodule.span_iUnion]
  congr 1
  funext a
  exact (Submodule.map_span _ _).symm
theorem wordBasisSearch_span (S : Fin m → Matrix i i K) (k : ℕ) :
    selectedWordSpan S (wordBasisSearch S k) = algebraWordSpace (K := K) S k := by
  induction k with
  | zero =>
    rw [wordBasisSearch, selectWords_span]
    simp [selectedWordSpan, matrixWord, algebraWordSpace]
  | succ k ih =>
    rw [wordBasisSearch, selectWords_span, generatorWordCandidates_span, ih, algebraWordSpace]
theorem wordBasisSearch_full (S : Fin m → Matrix i i K)
    (hgen : Algebra.adjoin K (Set.range S) = ⊤) :
    selectedWordSpan S (wordBasisSearch S ((Fintype.card i)^2+1)) = ⊤ := by
  rw [wordBasisSearch_span, matrixWordSpace_full S hgen]
end Problem18EliminationGeneration20260929
