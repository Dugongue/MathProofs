  · simpa only [program, cost, N, c, hlen, Nat.add_assoc] using
      hr0.seq (hr1.seq (hr2.seq (hr3.seq hr4)))
  · intro i
    let p := finProdFinEquiv.symm i
    have hi : i.val = p.1.val * boxSize n d + p.2.val := by
      have hh := congrArg Fin.val (finProdFinEquiv.apply_symm_apply i)
      simpa [finProdFinEquiv, p, Nat.add_comm, Nat.mul_comm] using hh.symm
    change val F canonical names.q.WS τ (5 + i.val) = rowData n d rows p.1 p.2
    rw [hi]
    simpa only [Nat.add_assoc] using hdata p.1 p.2
end
