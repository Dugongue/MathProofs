theorem queryWords_bounds {K : Type} [Field K] (F : FieldPresentation K) (u : Bool) (q : Nat)
    {a b c : Nat} (A T : RectTensor a b c K) (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) :
