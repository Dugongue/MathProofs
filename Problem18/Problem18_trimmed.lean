theorem addressExpr_eval {B x : Nat} (p : Parameters) (σ : Env)
    (hl : p.loaded σ) (hp : p.bounded B) (hx : σ.vars index=x)
    (hxB : x<B) (ha : p.at x<B) : addressExpr.evalB B σ=some (p.at x) := by
