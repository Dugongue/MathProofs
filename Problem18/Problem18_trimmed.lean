  have hdp : VarsIn [mn.t, mn.inB, mn.oB] (rgDst mn tbl.length) := by simp [VarsIn, rgDst, plus]
  let I : Env → Prop := fun τ =>
    Slots F r q.WS Sn B τ ∧ τ.vars mn.t ≤ R ∧
    (∀ x, x ∉ regNames r → x ≠ mn.t → τ.vars x = σ.vars x) ∧
    (∀ u < τ.vars mn.t, ∀ j (hj : j < tbl.length),
      val F r q.WS τ (ov + u * tbl.length + j) = gval (val F r q.WS σ) (iv + u * Ls) (tbl[j]'hj)) ∧
    (∀ s < Sn, (s < ov ∨ ov + τ.vars mn.t * tbl.length ≤ s) → val F r q.WS τ s = val F r q.WS σ s) ∧
    (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out
  have hI0 : I (σ.setVar mn.t 0) := by
    refine ⟨Slots.setVar F r hS htS htW 0, by simp, ?_, ?_, ?_, fun _ _ _ => rfl, rfl, rfl⟩
    · intro x _ hx; simp only [vars_setVar, if_neg hx]
    · intro u hu; simp at hu
    · intro s _ _; exact val_setVar F r htW σ 0 s
  have hRτ : ∀ τ, I τ → τ.vars mn.R = R := fun τ hτ => by rw [hτ.2.2.1 _ hRS hRt, hR]
  have hdef : ∀ τ, I τ → ∃ b, (Cond.lt (.var mn.t) (.var mn.R)).evalB B τ = some b := by
    intro τ hτ
    exact evalB_condLt_vars (by have := hτ.2.1; omega) (by rw [hRτ τ hτ]; omega)
  have hstep : ∀ τ, I τ → (Cond.lt (.var mn.t) (.var mn.R)).evalB B τ = some true →
      ∃ τ', Run B (rgBody M q mn Ls tbl) τ τ' (rgStep M mn Ls tbl) ∧ I τ' ∧
        R - τ'.vars mn.t < R - τ.vars mn.t := by
    intro τ hτ hc
    have hRτ' := hRτ τ hτ
    obtain ⟨hSτ, hle, hregs, hrows, hfr, harr, hinp, hout⟩ := hτ
    obtain ⟨tv, htv⟩ : ∃ tv, τ.vars mn.t = tv := ⟨_, rfl⟩
    rw [htv] at hle hrows hfr
    have htR : tv < R := by
      rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hRτ']; omega))] at hc
      simp only [Option.some.injEq, decide_eq_true_eq] at hc
      rw [hRτ', htv] at hc; exact hc
    have hmulO : tv * tbl.length + tbl.length ≤ R * tbl.length := by
      have := Nat.mul_le_mul_right tbl.length (Nat.succ_le_of_lt htR)
      rw [Nat.succ_mul] at this; exact this
    have hmulS : tv * Ls + Ls ≤ R * Ls := by
      have := Nat.mul_le_mul_right Ls (Nat.succ_le_of_lt htR)
      rw [Nat.succ_mul] at this; exact this
    have hiτ : τ.vars mn.inB = iv := by rw [hregs _ hiS hit, hi]
    have hoτ : τ.vars mn.oB = ov := by rw [hregs _ hoS hot, ho]
    have hsv := evalB_macSrc (B := B) (Ld := Ls) mn hiτ htv (by omega) (by omega) hLsB
    have hdv := evalB_rgDst (B := B) (Lo := tbl.length) mn htv hoτ (by omega) (by omega) hLoB hL1
    obtain ⟨τ1, hr1, hS1, hv1, hfr1, hreg1, harr1, hinp1, hout1⟩ :=
      gather_run M q [mn.t, mn.inB, mn.oB] hl (macSrc mn Ls) (rgDst mn tbl.length) hsp hdp tbl 0 τ hSτ hsv
        hdv (by rw [hfr 0 (by omega) (Or.inl (by omega))]; exact hz) (by omega)
        (by omega)
        (fun k hk => by
          have := htbl k hk
          constructor
          · omega
          · right; omega)
    have ht1 : τ1.vars mn.t = tv := by rw [hreg1 _ htS, htv]
    have hinc : (plus (.var mn.t) (.lit 1)).evalB B τ1 = some (tv + 1) := by
      unfold plus
      rw [← ht1]
      exact evalB_bin (evalB_var (by rw [ht1]; omega)) (evalB_lit (by omega))
        (by change τ1.vars mn.t + 1 < B; rw [ht1]; omega)
    refine ⟨τ1.setVar mn.t (tv + 1), ?_, ⟨Slots.setVar F r hS1 htS htW _, ?_, ?_, ?_, ?_, ?_, ?_,
      ?_⟩, ?_⟩
    · refine (hr1.seq (Run.assign hinc)).mono ?_
      unfold rgStep
      simp only [plus, Expr.size]
      omega
    · simp only [vars_setVar, if_true]; omega
    · intro x hx hxt
      simp only [vars_setVar, if_neg hxt]
      rw [hreg1 x hx]; exact hregs x hx hxt
    · intro u hu j hj
      simp only [vars_setVar, if_true] at hu
      rw [val_setVar F r htW]
      rcases Nat.lt_succ_iff_lt_or_eq.mp hu with hu | hu
      · have hlt : u * tbl.length + tbl.length ≤ tv * tbl.length := by
          have := Nat.mul_le_mul_right tbl.length (Nat.succ_le_of_lt hu)
          rw [Nat.succ_mul] at this; exact this
