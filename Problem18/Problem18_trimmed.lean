variable (K : Type*) [Field K] [Fintype K]
local instance : Fact (ringChar K).Prime := ⟨CharP.char_is_prime K (ringChar K)⟩
abbrev Extension (i : ℕ) := FiniteField.Extension K (ringChar K) (i+1)
local instance extensionAutFinite (i : ℕ) : Finite (Extension K i ≃+* Extension K i) :=
  Finite.of_injective (fun σ : Extension K i ≃+* Extension K i => (σ : _ → _))
    DFunLike.coe_injective
abbrev Twists (τ : K ≃+* K) (i : ℕ) :=
  {σ : Extension K i ≃+* Extension K i // Function.Involutive σ ∧
    ∀ a : K, σ (algebraMap K _ a) = algebraMap K _ (τ a)}
abbrev Degree (n : ℕ) := {i : Fin n // 0 < i.val}
abbrev Index (τ : K ≃+* K) (n : ℕ) := (i : Degree n) × Twists K τ i.val.val
theorem twists_card_le_two (τ : K ≃+* K) (i : ℕ) : Nat.card (Twists K τ i) ≤ 2 := by
  letI : Fintype (Extension K i) := Fintype.ofFinite _
  let f : Twists K τ i → {σ : Extension K i ≃+* Extension K i // Function.Involutive σ} :=
    fun σ => ⟨σ.val,σ.property.1⟩
  exact (Nat.card_le_card_of_injective f (by intro σ π h; exact Subtype.ext (show σ.val = π.val from congrArg (fun z : {σ : Extension K i ≃+* Extension K i // Function.Involutive σ} => z.val) h))).trans
    (ring_involution_card_le_two (Extension K i))
theorem index_card_le (τ : K ≃+* K) (n : ℕ) : Nat.card (Index K τ n) ≤ 2*n := by
  classical
  letI : Fintype (Degree n) := Fintype.ofFinite _
  have hi : Nat.card (Degree n) ≤ n := by
    simpa only [Nat.card_eq_fintype_card,Fintype.card_fin] using
      (Nat.card_le_card_of_injective (Subtype.val : Degree n → Fin n) Subtype.val_injective)
  calc
    _ = ∑ i : Degree n, Nat.card (Twists K τ i.val.val) := Nat.card_sigma
    _ ≤ ∑ _i : Degree n, 2 := Finset.sum_le_sum (fun i _ => twists_card_le_two K τ i.val.val)
    _ = 2*Nat.card (Degree n) := by simp [Nat.card_eq_fintype_card,Nat.mul_comm]
    _ ≤ 2*n := Nat.mul_le_mul_left 2 hi
theorem finite_union_probability_le {Ω I : Type*} [Fintype Ω] [Nonempty Ω] [Finite I]
    (P : I → Ω → Prop) (δ : ℝ)
    (h : ∀ i, (Nat.card {x : Ω // P i x} : ℝ)/Fintype.card Ω ≤ δ) :
    (Nat.card {x : Ω // ∃ i, P i x} : ℝ)/Fintype.card Ω ≤ Nat.card I*δ := by
  classical
  letI : Fintype I := Fintype.ofFinite _
  let A : I → Finset Ω := fun i => Finset.univ.filter (P i)
  have heq : Finset.univ.filter (fun x : Ω => ∃ i, P i x) = Finset.univ.biUnion A := by
    ext x
    simp [A]
  calc
    _ = ((Finset.univ.biUnion A).card : ℝ)/Fintype.card Ω := by
      simp only [Nat.card_eq_fintype_card,Fintype.card_subtype,heq]
    _ ≤ ∑ i : I, ((A i).card : ℝ)/Fintype.card Ω := family_union_probability_le A
    _ ≤ ∑ _i : I, δ := Finset.sum_le_sum (fun i _ => by
      simpa only [A,Nat.card_eq_fintype_card,Fintype.card_subtype] using h i)
    _ = _ := by simp [Nat.card_eq_fintype_card]
variable {K} {n r : ℕ}
end Mathproof.Problem18FieldInvolutionUnion20260930
