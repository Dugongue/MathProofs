  refine ⟨fun i => c i*(z i).val^2,fun i => mul_ne_zero (hc i) (pow_ne_zero _ (z i).ne_zero),?_⟩
  intro x y
  have he (x : ∀ i,AdjoinRoot (g i)) : E (T.val x)=e.val x := E.apply_symm_apply (e.val x)
  rw [← he x,← he y,hform,modelTraceForm_apply]
  apply Finset.sum_congr rfl
  intro i _
  rw [hsc,hsc]
  congr 1
  ring
