    { toFun := fun z => (⟨z.1.1, z.2⟩, z.1.2)
      invFun := fun z => ⟨(z.1.1, z.2), z.1.2⟩
      left_inv := by intro z; cases z; rfl
      right_inv := by intro z; cases z with | mk a b => cases a; rfl }
  have hEcard : Nat.card {z : Ω // P z} =
      Nat.card {N : A // E N} * Nat.card B := by
    calc
      _ = Nat.card ({N : A // E N} × B) := Nat.card_congr eFirst
      _ = _ := by simp only [Nat.card_prod]
  have hΩcard : Nat.card Ω = Nat.card A * Nat.card B := by
    simp only [Ω, Nat.card_prod]
  have hEraw : (Nat.card {N : A // E N} : ℝ) / Nat.card A ≤ R := by
    simpa only [A, E, R, Matrix, Nat.card_eq_fintype_card] using
      (Mathproof.Problem18IntersectionTail20260929.random_annihilator_intersection_tail
        (K := K) d u w hu)
