def macaulaySpan (F : Set (MvPolynomial (Fin N) K)) (E : Nat) :
    Submodule K (MvPolynomial (Fin N) K) :=
  Submodule.span K {z | ∃ f ∈ F, ∃ p : MvPolynomial (Fin N) K,
