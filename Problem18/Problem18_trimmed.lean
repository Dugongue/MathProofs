  have hmeanlo : Real.log (b:ℝ)-2*Real.log (1+Real.log (b:ℝ))-64 ≤
      Real.log (L+1:ℝ)-Real.log (D:ℝ)-13 := by
    rw [hlogD]
    linarith
  have hLb : L≤b := Nat.div_le_self _ _
  have hlogL : Real.log (L:ℝ)≤Real.log (b:ℝ) :=
    Real.log_le_log hLR (by exact_mod_cast hLb)
  refine ⟨hD2,hDL,?_,?_,hmass,hmeanlo,?_⟩
  · exact ⟨4*t,by dsimp [k]; omega⟩
  · change 8*Real.log (b:ℝ) ≤ ((8*t:ℕ):ℝ)
