def shiftTbl (n d E : ℕ) (a : FinExponent n) : List (Option ℕ) :=
  (boundedExponents n (d + E)).map fun b =>
    if a ≤ b then
      (if (boundedExponents n d).idxOf (subtractExponent b a) < (boundedExponents n d).length then
        some ((boundedExponents n d).idxOf (subtractExponent b a)) else none)
    else none
theorem shiftTbl_length (n d E : ℕ) (a : FinExponent n) :
    (shiftTbl n d E a).length = (boundedExponents n (d + E)).length := by
  simp [shiftTbl]
theorem shiftTbl_some_lt {n d E : ℕ} {a : FinExponent n} {k : ℕ} (h : some k ∈ shiftTbl n d E a) :
    k < (boundedExponents n d).length := by
  simp only [shiftTbl, List.mem_map] at h
  obtain ⟨b, _, hb⟩ := h
  split_ifs at hb with h1 h2
  · cases hb; exact h2
variable {K : Type} [Field K] [Fintype K] [DecidableEq K]
theorem shiftedRow_gval {n d E : ℕ} (v : DenseInput n d K) (a : FinExponent n) (g : ℕ → K)
    (sv : ℕ) (hg : ∀ k (hk : k < (boundedExponents n d).length), g (sv + k) = read v ⟨k, hk⟩)
    (i : Fin (boundedExponents n (d + E)).length) :
    read (shiftedRow d (d + E) v a) i =
      gval g sv ((shiftTbl n d E a)[i.val]'(by rw [shiftTbl_length]; exact i.isLt)) := by
  simp only [shiftedRow, read_ofFn, shiftTbl, List.getElem_map]
  split_ifs with h1 h2
  · simp only [gval, inputCoefficient, dif_pos h2]
    rw [hg _ h2]; rfl
  · simp only [gval, inputCoefficient, dif_neg h2]
  · rfl
theorem getElemOpt_flatMap_uniform {α β : Type*} (f : α → List β) (k : ℕ)
    (hk : ∀ x, (f x).length = k) :
    ∀ (l : List α) (t j : ℕ), j < k →
      (l.flatMap f)[t * k + j]? = (l[t]?).bind fun x => (f x)[j]?
  | [], t, j, _ => by simp
  | x :: l, t, j, hj => by
    rw [List.flatMap_cons]
    cases t with
    | zero =>
      rw [Nat.zero_mul, Nat.zero_add, List.getElem?_append_left (by rw [hk]; exact hj)]
      simp
    | succ t =>
      rw [List.getElem?_append_right (by rw [hk]; nlinarith), hk,
        show (t + 1) * k + j - k = t * k + j by rw [Nat.succ_mul]; omega]
      rw [getElemOpt_flatMap_uniform f k hk l t j hj]
      simp
omit [Fintype K] [DecidableEq K] in
theorem macaulayRows_getElemOpt {n d E : ℕ} (vs : List (DenseInput n d K)) (t j : ℕ)
    (hj : j < (multiplierExponents n E).length) :
    (macaulayRows d E vs)[t * (multiplierExponents n E).length + j]? =
      (vs[t]?).bind fun v => ((multiplierExponents n E).map (shiftedRow d (d + E) v))[j]? := by
  unfold macaulayRows
  exact getElemOpt_flatMap_uniform _ _ (fun x => by simp) vs t j hj
theorem restRows_of_rows {L : ℕ} (g : ℕ → K) (rows : List (Vector K L))
    (h : ∀ u (hu : u < rows.length) (i : Fin L), g (rowStart L u + i.val) = read rows[u] i) :
    restRows g L rows.length 0 = rows.map read := by
  rw [restRows_zero]
  apply List.ext_getElem
  · simp
  · intro t h1 _
    simp only [List.length_map, List.length_range] at h1
    simp only [List.getElem_map, List.getElem_range]
    funext i
    exact h t h1 i
end Mathproof.Problem18ClaudeIMPMacaulayMath20261001
