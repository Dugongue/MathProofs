    (wordPolynomial timePolynomial : Polynomial Nat)
    (hsmall : Problem18EncodedSourceCheck20261001.branch cutoff a b c = 1)
    (hwidth : let words := routedSourceWords F cutoff u q A
      let W := 2 ^ (wordPolynomial.eval
        (Lax51.BinaryWordEncoding.bitSize words) +
          Lax51.BinaryWordEncoding.bitSize words + 1)
