theorem bankL_le (n m : ℕ) : bankL n m ≤ 7 * ((n + m + 2) * (n + m + 2)) := by
  unfold bankL bankN
  have h := Nat.mul_le_mul (show m ≤ n + m + 2 by omega) (show n + 1 + m ≤ n + m + 2 by omega)
  have h2 : n + m + 2 ≤ (n + m + 2) * (n + m + 2) := Nat.le_mul_of_pos_right _ (by omega)
  omega
theorem constCost_le (S : Expr) (hS : S.size ≤ 20) : constCost S F.e ≤ 60 * macroBudget F := by
  have he := e_succ_le F
  unfold constCost
  obtain ⟨W, hWd⟩ : ∃ W, macroBudget F = W := ⟨_, rfl⟩
  obtain ⟨e, hed⟩ : ∃ e, F.e = e := ⟨_, rfl⟩
  rw [hWd, hed] at he; rw [hWd, hed]
  have : (4 + (S.size + 12)) * e ≤ 36 * e := Nat.mul_le_mul_right _ (by omega)
  omega
theorem zeroStep_le : 4 + zeroStep uw F.e ≤ 21 * macroBudget F := by
  have he := e_succ_le F
  have h : zeroStep uw F.e = 2 + (4 + (1 + 12)) * F.e + 4 + (1 + 6) + 4 := by
    unfold zeroStep constCost; rfl
  rw [h]; omega
theorem bodyCost_le (n : ℕ) :
    6 + bodyCost (fieldMacros F) uw n ≤ 300 * (macroBudget F * (n + 1)) := by
  have hW := one_le_budget F
  have hcp := costPoint_le F
  have hq := constCost_le F (qExpr uw) (by simp [qExpr, plus, Expr.size])
  have hE := constCost_le F (eExpr uw) (by simp [eExpr, plus, Expr.size])
  have hd := constCost_le F (dExpr uw) (by simp [dExpr, plus, Expr.size])
  have hcopy : copyCost (fieldMacros F) (.var uw.base) (.var uw.src) n =
      2 + (4 + (30 + 1 + 2 * 1 + (fieldMacros F).costPoint)) * n + 4 := by
    unfold copyCost copyStep; rfl
  unfold bodyCost
  rw [hcopy]
  obtain ⟨W, hWd⟩ : ∃ W, macroBudget F = W := ⟨_, rfl⟩
  obtain ⟨cp, hcpd⟩ : ∃ cp, (fieldMacros F).costPoint = cp := ⟨_, rfl⟩
  rw [hWd] at hW hq hE hd; rw [hWd, hcpd] at hcp; rw [hcpd, hWd]
  have h1 : (4 + (30 + 1 + 2 * 1 + cp)) * n ≤ (38 * W) * n := Nat.mul_le_mul_right _ (by omega)
  have r1 : 300 * (W * (n + 1)) = 300 * (W * n) + 300 * W := by ring
  have r2 : (38 * W) * n = 38 * (W * n) := by ring
  rw [r1]; rw [r2] at h1
  omega
theorem ubankCost_le (n m : ℕ) :
    ubankCost (fieldMacros F) uw n m ≤ 1000 * macroBudget F * (n + m + 2) ^ 3 := by
  have hW := one_le_budget F
  have hz := zeroStep_le F
  have hb := bodyCost_le F n
  have hL := bankL_le n m
  unfold ubankCost zeroCost
  obtain ⟨W, hWd⟩ : ∃ W, macroBudget F = W := ⟨_, rfl⟩
  obtain ⟨Z, hZd⟩ : ∃ Z, zeroStep uw F.e = Z := ⟨_, rfl⟩
  obtain ⟨Bd, hBd⟩ : ∃ Bd, bodyCost (fieldMacros F) uw n = Bd := ⟨_, rfl⟩
  obtain ⟨L, hLd⟩ : ∃ L, bankL n m = L := ⟨_, rfl⟩
  obtain ⟨P, hPd⟩ : ∃ P, n + m + 2 = P := ⟨_, rfl⟩
  rw [hWd] at hW hz hb; rw [hZd] at hz; rw [hBd] at hb; rw [hLd, hPd] at hL
  rw [hWd, hZd, hBd, hLd, hPd]
  have hmP : m ≤ P := by omega
  have hnP : n + 1 ≤ P := by omega
  have hb' : 6 + Bd ≤ 300 * (W * P) :=
    le_trans hb (Nat.mul_le_mul_left _ (Nat.mul_le_mul_left _ hnP))
  have T1 : (4 + Z) * (m * L) ≤ (21 * W) * (P * (7 * (P * P))) :=
    Nat.mul_le_mul hz (Nat.mul_le_mul hmP hL)
  have T2 : (6 + Bd) * (m * m) ≤ (300 * (W * P)) * (P * P) :=
    Nat.mul_le_mul hb' (Nat.mul_le_mul hmP hmP)
  have r1 : (21 * W) * (P * (7 * (P * P))) = 147 * (W * (P * (P * P))) := by ring
  have r2 : (300 * (W * P)) * (P * P) = 300 * (W * (P * (P * P))) := by ring
  have r3 : 1000 * W * P ^ 3 = 1000 * (W * (P * (P * P))) := by ring
  rw [r1] at T1; rw [r2] at T2; rw [r3]
  have hX : 1 ≤ W * (P * (P * P)) :=
    Nat.one_le_iff_ne_zero.mpr (Nat.mul_ne_zero (by omega)
      (Nat.mul_ne_zero (by omega) (Nat.mul_ne_zero (by omega) (by omega))))
  omega
