theorem even_power_tail_error (q : ℝ) (hq : 2 ≤ q) (m k : ℕ) (hm : 1 ≤ m) :
    |(∏ j∈Finset.range k,(1-(q^(2*(m+j+1)))⁻¹))-1| ≤ 2*(q^m)⁻¹ := by
  let r := q⁻¹
  have hq0 : 0<q := by linarith
  have hr : 0 ≤ r := inv_nonneg.mpr hq0.le
  have hh : r ≤ 1/2 := by
    dsimp only [r]
    rw [inv_eq_one_div]
    exact (div_le_iff₀ hq0).mpr (by linarith)
  have hb : r^m ≤ 1/2 := (pow_le_pow_of_le_one hr (by linarith) hm).trans (by simpa using hh)
  have hs : (∑ j∈Finset.range k,|-((q^(2*(m+j+1)))⁻¹)|) ≤ r^m := by
    calc
      _ = ∑ j∈Finset.range k,r^(2*(m+j+1)) := by
        apply Finset.sum_congr rfl
        intro j _
        rw [abs_neg,abs_of_nonneg (by positivity),inv_pow]
      _  ≤  ∑ j∈Finset.range k,r^(m+(j+1)) := Finset.sum_le_sum (fun j _ =>
        pow_le_pow_of_le_one hr (by linarith) (by omega))
      _ = r^m*(∑ j∈Finset.range k,r^(j+1)) := by simp_rw [pow_add]; rw [Finset.mul_sum]
      _  ≤  r^m*1 := mul_le_mul_of_nonneg_left (geometric_error_sum r hr hh k) (pow_nonneg hr m)
      _ = r^m := mul_one _
  simpa only [sub_eq_add_neg,r,inv_pow] using
    finite_product_error (Finset.range k) (fun j => -((q^(2*(m+j+1)))⁻¹))
      (r^m) (pow_nonneg hr m) hb hs
theorem even_power_product_split (q : ℝ) (m k : ℕ) :
    evenPowerProduct q (m+k)=evenPowerProduct q m*
      ∏ j∈Finset.range k,(1-(q^(2*(m+j+1)))⁻¹) := by
  simp only [evenPowerProduct,Finset.prod_range_add]
theorem corrected_ratio_error (δ a b t : ℝ) (hδ : 0 ≤ δ) (hh : δ ≤ 1/4)
    (ha : |a| ≤ δ) (hb : |b| ≤ δ) (ht : |t-1| ≤ 2*δ) :
    |(1+a)*t/(1+b)-1| ≤ 8*δ := by
  obtain ⟨ha0,ha1⟩ := abs_le.mp ha
  obtain ⟨hb0,hb1⟩ := abs_le.mp hb
  obtain ⟨ht0,ht1⟩ := abs_le.mp ht
  have hden : 0<1+b := by linarith
  have hamin : 0 ≤ 1-δ := by linarith
  have htmin : 0 ≤ 1-2*δ := by linarith
  have hmul0 : (1-δ)*(1-2*δ) ≤ (1+a)*t :=
    mul_le_mul (by linarith) (by linarith) htmin (by linarith)
  have hmul1 : (1+a)*t ≤ (1+δ)*(1+2*δ) :=
    mul_le_mul (by linarith) (by linarith) (by linarith) (by linarith)
  have hs : δ^2 ≤ δ/4 := by nlinarith [mul_le_mul_of_nonneg_left hh hδ]
  apply abs_le.mpr
  constructor
  · apply le_sub_iff_add_le.mpr
    apply (le_div_iff₀ hden).mpr
    nlinarith [mul_le_mul_of_nonneg_left hb1 hδ]
  · apply sub_le_iff_le_add.mpr
    apply (div_le_iff₀ hden).mpr
    nlinarith [mul_le_mul_of_nonneg_left hb0 hδ]
end
