def wordPolynomial (W : Nat) (P : Polynomial Nat) : Polynomial Nat :=
  Polynomial.C W+P+17+(32*(P+1)+3)*(2*Polynomial.X+2)^2+4
def timePolynomial (C : Nat) (P : Polynomial Nat) : Polynomial Nat :=
  Polynomial.C C*(P+2012004)*(2*Polynomial.X+1)^5
theorem word_polynomial_bound (W S x t : Nat) (P : Polynomial Nat)
    (hS : S ≤ P.eval x) (ht : t ≤ 2*x+1) :
    exponent (32*(S+1)) (W+S+17) t  ≤  (wordPolynomial W P).eval x := by
  have ht1:t+1 ≤ 2*x+2:=by omega
  norm_num [wordPolynomial,exponent]
  gcongr
theorem time_polynomial_bound (C S x t : Nat) (P : Polynomial Nat)
    (hS : S ≤ P.eval x) (ht : t ≤ 2*x+1) :
    C*(S+2012004)*t^5  ≤  (timePolynomial C P).eval x := by
  norm_num [timePolynomial]
  gcongr
