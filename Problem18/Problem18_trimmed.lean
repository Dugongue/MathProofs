  have hlt : τ.vars Problem18IMPBoundaryKrylov20261001.limitReg=n := (hvτ _ (by decide) (by decide) (by decide)).trans hl
  have hat : τ.vars Problem18IMPBoundaryKrylov20261001.matrixReg=F.e+1+matrix n*F.e := (hvτ _ (by decide) (by decide) (by decide)).trans ha
  have htt : τ.vars Problem18IMPBoundaryKrylov20261001.tableReg=F.e+1+orbit n*F.e := (hvτ _ (by decide) (by decide) (by decide)).trans ht
  have hwt : τ.vars Problem18IMPMatrixProductLoop20261001.workBase=F.e+1+orbitWork n*F.e :=
