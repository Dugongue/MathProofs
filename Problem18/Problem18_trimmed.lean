variable {L : Type*} [Field L] [IsAlgClosed L] {n : ℕ}
def PeelClaim (G : Finset (MvPolynomial (Fin n) L)) (d k : ℕ) : Prop :=
  (∀ P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes, n < rk P + k →
      ∀ (p : Fin n → L) (f : MvPolynomial (Fin n) L), f ∈ P → eval p f ≠ 0 →
        ∃ s ∈ P, s.totalDegree ≤ (peelAcc n d k).1 ∧ eval p s ≠ 0) ∧
  (∀ S : Finset (Ideal (MvPolynomial (Fin n) L)),
      (∀ P ∈ S, P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes ∧ n < rk P + k) →
        S.card ≤ (peelAcc n d k).2.1) ∧
  (∀ P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes, n < rk P + k →
      ∀ (κ : Fin (rk P) ↪ Fin n), AlgebraicIndependent L
        (fun i => Ideal.Quotient.mk P (X (κ i) : MvPolynomial (Fin n) L)) →
      ∀ f : MvPolynomial (Fin n) L, ∃ q : Polynomial (MvPolynomial (Fin (rk P)) L), q ≠ 0 ∧
        q.natDegree ≤ (peelAcc n d k).2.2 ∧
        Polynomial.eval₂ (rename κ : MvPolynomial (Fin (rk P)) L →ₐ[L] _).toRingHom f q ∈ P)
theorem peelClaim_zero (G : Finset (MvPolynomial (Fin n) L)) (d : ℕ) : PeelClaim G d 0 := by
  refine ⟨fun P hP hlt => ?_, fun S hS => ?_, fun P hP hlt => ?_⟩
  · haveI : P.IsPrime := hP.1.1
    have := rk_le P
    omega
  · rcases S.eq_empty_or_nonempty with hS0 | ⟨P, hP⟩
    · simp [hS0]
    · obtain ⟨hPmin, hlt⟩ := hS P hP
      haveI : P.IsPrime := hPmin.1.1
      have := rk_le P
      omega
  · haveI : P.IsPrime := hP.1.1
    have := rk_le P
    omega
