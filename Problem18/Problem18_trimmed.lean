        (τ1.arrs canonical.mem).getD (ρ.vars ws+L.base*F.e+k) 0 :=
      hf2 _ (by rw [hw1]; right; omega)
    have e1 : (τ1.arrs canonical.mem).getD (ρ.vars ws+L.base*F.e+k) 0=
        (ρ.arrs canonical.mem).getD (ρ.vars ws+L.base*F.e+k) 0 :=
      getD_frame (hl1 _) (fun _ => hf1 _ (by left; omega) (by left; omega))
