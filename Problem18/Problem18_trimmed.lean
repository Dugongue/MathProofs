      [(Mathproof.Problem18FiniteTransducer20261001.run
        totalDecoder q raw).headD false] := by
  induction raw generalizing q with
  | nil => cases q <;> rfl
  | cons a raw ih =>
      simp only [Mathproof.Problem18FiniteTransducer20261001.run,
        totalDecoder, List.nil_append]
      exact ih _
