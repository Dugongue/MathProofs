variable {K E' : Type*} [Field K] [Fintype K] [Field E']
theorem exists_good_coefficient (ι : K →+* E') (α β : E') (sf sg : Multiset E') (a b : Nat)
    (hf : Multiset.card sf ≤ a) (hg : Multiset.card sg ≤ b) (hq : a * b < Fintype.card K) :
    ∃ c : K, ∀ α' ∈ sf, ∀ β' ∈ sg, -(α' - α) / (β' - β) ≠ ι c := by
  classical
  let t : Multiset E' := sf.bind fun α' => sg.map fun β' => -(α' - α) / (β' - β)
  let s : Finset E' := t.toFinset
  let s' : Finset K := s.preimage ι (fun x _ y _ h => ι.injective h)
  have ht : Multiset.card t ≤ a * b := by
    have h1 : Multiset.card t = (sf.map fun α' =>
        Multiset.card (sg.map fun β' => -(α' - α) / (β' - β))).sum := Multiset.card_bind _ _
    rw [h1]
    have h2 : ∀ x ∈ sf.map (fun α' => Multiset.card (sg.map fun β' => -(α' - α) / (β' - β))),
        x ≤ b := by
      intro x hx
      obtain ⟨α', -, rfl⟩ := Multiset.mem_map.mp hx
      rw [Multiset.card_map]; exact hg
    have h3 := Multiset.sum_le_card_nsmul _ b h2
    rw [Multiset.card_map, smul_eq_mul] at h3
    exact h3.trans (Nat.mul_le_mul_right b hf)
  have hs : s.card ≤ a * b := (Multiset.toFinset_card_le t).trans ht
  have hs' : s'.card ≤ a * b := by
    rw [Finset.card_preimage]
    exact (Finset.card_filter_le _ _).trans hs
  by_contra hcon
  push_neg at hcon
  have hall : ∀ c : K, c ∈ s' := by
    intro c
    obtain ⟨α', hα', β', hβ', h⟩ := hcon c
    simp only [s', s, t, Finset.mem_preimage, Multiset.mem_toFinset, Multiset.mem_bind,
      Multiset.mem_map]
    exact ⟨α', hα', β', hβ', h⟩
  have huniv : (Finset.univ : Finset K) ⊆ s' := fun c _ => hall c
  have := Finset.card_le_card huniv
  rw [Finset.card_univ] at this
  omega
end Count
