      {s : Fin b → Slice K a c // ¬FullCross s} :=
    middleSliceEquiv.subtypeEquiv (fun A => not_congr (fullCross_middleSlice_iff A).symm)
  have h := full_cross_failure_all_shapes (K:=K) ha hac b
  rw [←Nat.card_congr e,←Nat.card_congr (middleSliceEquiv (K:=K) (a:=a) (b:=b) (c:=c))] at h
  exact h
theorem second_generation_failure_probability (ha : 2≤a) (hac : a≤ c) :
    (Nat.card {A : RectTensor a b c K //
      Algebra.adjoin K (Set.range (secondFamily A))≠⊤}:ℝ)/Nat.card (RectTensor a b c K) ≤
      (29/32:ℝ)^(b/5) := by
  have ht : (0:ℝ)<Nat.card (RectTensor a b c K) := by exact_mod_cast Nat.card_pos
  have hp : (0:ℝ)<(32:ℝ)^(b/5) := by positivity
  rw [div_pow]
  apply (div_le_div_iff₀ ht hp).mpr
  have h := second_generation_failure_card (K:=K) (b:=b) ha hac
  have h' : (32:ℝ)^(b/5)*Nat.card {A : RectTensor a b c K //
      Algebra.adjoin K (Set.range (secondFamily A))≠⊤} ≤
      (29:ℝ)^(b/5)*Nat.card (RectTensor a b c K) := by exact_mod_cast h
  simpa only [mul_comm] using h'
end
