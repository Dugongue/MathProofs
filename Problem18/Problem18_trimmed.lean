def saveLayoutProgram (bank count : String) : Com :=
  .seq (.store bank (.lit 0) (.var canonical.e))
    (.seq (.store bank (.lit 1) (.var canonical.p))
      (.seq (.store bank (.lit 2) (.var canonical.modBase))
        (.seq (.store bank (.lit 3) (.var canonical.exp))
          (.seq (.store bank (.lit 4) (.var names.q.WS))
            (.seq (.store bank (.lit 5) (.var names.qr))
              (.store bank (.lit 6) (.var count)))))))
def savedLayout (bank count : String) (σ : Env) : Env :=
  ((((((σ.setArr bank 0 (σ.vars canonical.e)).setArr bank 1 (σ.vars canonical.p)).setArr
    bank 2 (σ.vars canonical.modBase)).setArr bank 3 (σ.vars canonical.exp)).setArr
    bank 4 (σ.vars names.q.WS)).setArr bank 5 (σ.vars names.qr)).setArr
    bank 6 (σ.vars count)
theorem saveLayout_run (bank count : String) (B : Nat) (σ : Env)
    (hlen : (σ.arrs bank).length = 7)
    (hbound : ∀ v ∈ image count σ, v < B)
    (hindex : 7 < B) :
    Run B (saveLayoutProgram bank count) σ (savedLayout bank count σ) 21 ∧
      (savedLayout bank count σ).arrs bank = image count σ ∧
      (∀ a, a ≠ bank → (savedLayout bank count σ).arrs a = σ.arrs a) ∧
      (savedLayout bank count σ).vars = σ.vars ∧
      (savedLayout bank count σ).inp = σ.inp ∧
      (savedLayout bank count σ).out = σ.out := by
  let σ1 := σ.setArr bank 0 (σ.vars canonical.e)
  let σ2 := σ1.setArr bank 1 (σ.vars canonical.p)
  let σ3 := σ2.setArr bank 2 (σ.vars canonical.modBase)
  let σ4 := σ3.setArr bank 3 (σ.vars canonical.exp)
  let σ5 := σ4.setArr bank 4 (σ.vars names.q.WS)
  let σ6 := σ5.setArr bank 5 (σ.vars names.qr)
  have h0 := Run.store (a := bank) (σ := σ)
    (evalB_lit (by omega : 0 < B))
    (evalB_var (hbound (σ.vars canonical.e) (by simp [image]))) (by omega : 0 < (σ.arrs bank).length)
  have h1 := Run.store (a := bank) (σ := σ1)
    (evalB_lit (by omega : 1 < B))
    (evalB_var (by simpa [σ1, vars_setArr] using hbound (σ.vars canonical.p) (by simp [image])))
    (by simpa [σ1, arrs_setArr] using (show 1 < (σ.arrs bank).length by omega))
  have h2 := Run.store (a := bank) (σ := σ2)
    (evalB_lit (by omega : 2 < B))
    (evalB_var (by simpa [σ2, σ1, vars_setArr] using hbound (σ.vars canonical.modBase) (by simp [image])))
    (by simpa [σ2, σ1, arrs_setArr] using (show 2 < (σ.arrs bank).length by omega))
  have h3 := Run.store (a := bank) (σ := σ3)
    (evalB_lit (by omega : 3 < B))
    (evalB_var (by simpa [σ3, σ2, σ1, vars_setArr] using hbound (σ.vars canonical.exp) (by simp [image])))
    (by simpa [σ3, σ2, σ1, arrs_setArr] using (show 3 < (σ.arrs bank).length by omega))
  have h4 := Run.store (a := bank) (σ := σ4)
    (evalB_lit (by omega : 4 < B))
    (evalB_var (by simpa [σ4, σ3, σ2, σ1, vars_setArr] using hbound (σ.vars names.q.WS) (by simp [image])))
    (by simpa [σ4, σ3, σ2, σ1, arrs_setArr] using (show 4 < (σ.arrs bank).length by omega))
  have h5 := Run.store (a := bank) (σ := σ5)
    (evalB_lit (by omega : 5 < B))
    (evalB_var (by simpa [σ5, σ4, σ3, σ2, σ1, vars_setArr] using hbound (σ.vars names.qr) (by simp [image])))
    (by simpa [σ5, σ4, σ3, σ2, σ1, arrs_setArr] using (show 5 < (σ.arrs bank).length by omega))
  have h6 := Run.store (a := bank) (σ := σ6)
    (evalB_lit (by omega : 6 < B))
    (evalB_var (by simpa [σ6, σ5, σ4, σ3, σ2, σ1, vars_setArr] using hbound (σ.vars count) (by simp [image])))
    (by simpa [σ6, σ5, σ4, σ3, σ2, σ1, arrs_setArr] using (show 6 < (σ.arrs bank).length by omega))
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa only [saveLayoutProgram, savedLayout, σ1, σ2, σ3, σ4, σ5, σ6,
      Expr.size, Nat.reduceAdd, vars_setArr] using
      h0.seq (h1.seq (h2.seq (h3.seq (h4.seq (h5.seq h6)))))
  · apply List.ext_getElem?
    intro i
    by_cases hi : i < 7
    · interval_cases i <;> simp [savedLayout, image, hlen]
    · have hi' : 7 ≤ i := by omega
      have hl : ((savedLayout bank count σ).arrs bank).length = 7 := by
        simp [savedLayout, hlen]
      have hr : (image count σ).length = 7 := by simp [image]
      rw [List.getElem?_eq_none (by rw [hl]; exact hi'),
        List.getElem?_eq_none (by rw [hr]; exact hi')]
  · intro a ha
    simp [savedLayout, ha]
  · simp [savedLayout]
  · simp [savedLayout]
  · simp [savedLayout]
end
