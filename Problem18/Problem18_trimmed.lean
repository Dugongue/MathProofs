theorem zFlag_eq_one_iff {n d : ℕ} (x : Fin n → K) (rows : List (DenseInput n d K)) :
    zFlag x rows = 1 ↔ ∀ v ∈ rows, denseEval x (Problem18ArrayElimination20260929.read v) = 0 := by
  unfold zFlag
  split_ifs with h
  · exact ⟨fun _ => h, fun _ => rfl⟩
  · exact ⟨fun h01 => absurd h01 (by norm_num), fun hp => absurd hp h⟩
theorem zFlag_le_one {n d : ℕ} (x : Fin n → K) (rows : List (DenseInput n d K)) :
