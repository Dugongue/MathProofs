          (by show ρ.vars cD + ρ.vars cIdx < W; rw [hd']; omega)
        simpa [hd'] using this
      apply evalB_get eI
      · rw [hρa, hw3, List.getElem?_eq_getElem (by rw [hlen']; omega)]
        simp [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem
          (show dv + ρ.vars cIdx < (σ.arrs work).length by rw [hlen']; omega)]
      · have := vals_lt F hy (ρ.vars cIdx) (by omega); omega)
  refine ⟨τ, ?_, ?_, ?_, harr.trans hw3, hi, ho⟩
  · have hall := (Run.assign (x := cS) e1).seq ((Run.assign (x := cD) e2).seq
      ((Run.assign (x := cCnt) e3).seq hr))
    apply hall.mono
    simp only [cmpVCost, rhsPair, Expr.size]; omega
  · rw [hfl]
    have hflag : σ3.vars flag = σ.vars flag := by
      simp [σ3, σ2, σ1, hf'.2.1, hf'.2.2.1, hf'.2.2.2]
    rw [hflag, show σ3.arrs work = σ.arrs work from rfl]
    by_cases hall : ∀ i < nv, x i = y i
    · rw [if_pos hall, if_pos ((words_eq_iff_n F (σ := σ) hx hy).mpr hall)]
    · rw [if_neg hall, if_neg (fun h => hall ((words_eq_iff_n F (σ := σ) hx hy).mp h))]
  · intro z hz
    simp only [List.mem_cons, List.not_mem_nil, or_false, not_or] at hz
