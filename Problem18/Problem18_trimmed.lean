namespace Mathproof.Problem18WeightedDivisorSeries20260930
open Finset PowerSeries
open scoped PowerSeries Classical
variable {ι : Type*} [Fintype ι]
abbrev WeightedTuples (w : ι → Nat) (n : Nat) := {f : ι → Nat // ∑ i, w i*f i=n}
def geometricWeight (d : Nat) : ℤ⟦X⟧ :=
  PowerSeries.mk fun n => if d∣n then 1 else 0
def weightedAllocationEquiv (w : ι → Nat) (hw : ∀ i, 0<w i) (n : Nat) :
    WeightedTuples w n ≃
      ↥((Finset.univ.finsuppAntidiag n).filter (fun g : ι →₀ Nat => ∀ i, w i∣g i)) := by
  classical
  refine
    { toFun := fun f => ⟨Finsupp.equivFunOnFinite.symm (fun i => w i*f.val i),?_⟩
      invFun := fun g => ⟨fun i => g.val i/w i,?_⟩
      left_inv := ?_
      right_inv := ?_ }
  · apply Finset.mem_filter.mpr
    refine ⟨Finset.mem_finsuppAntidiag.mpr ⟨?_,Finset.subset_univ _⟩,?_⟩
    · exact f.property
    · intro i; exact dvd_mul_right _ _
  · have hg := Finset.mem_filter.mp g.property
    calc
      ∑ i, w i*(g.val i/w i) = ∑ i, g.val i := by
        apply Finset.sum_congr rfl
        intro i _
        exact Nat.mul_div_cancel' (hg.2 i)
      _ = n := (Finset.mem_finsuppAntidiag.mp hg.1).1
  · intro f
    apply Subtype.ext
    funext i
    exact Nat.mul_div_cancel_left (f.val i) (hw i)
  · intro g
    apply Subtype.ext
    ext i
    exact Nat.mul_div_cancel' ((Finset.mem_filter.mp g.property).2 i)
theorem coefficient_weighted_product (w : ι → Nat) (hw : ∀ i, 0<w i) (n : Nat) :
    PowerSeries.coeff n (∏ i, geometricWeight (w i))=(Nat.card (WeightedTuples w n):ℤ) := by
  classical
  rw [PowerSeries.coeff_prod]
  simp only [geometricWeight,PowerSeries.coeff_mk]
  simp_rw [Finset.prod_boole]
  simp only [Finset.mem_univ,true_implies]
  rw [Finset.sum_boole]
  have hc := Nat.card_congr (weightedAllocationEquiv w hw n)
  simp only [Nat.card_eq_finsetCard] at hc
  exact_mod_cast hc.symm
end Mathproof.Problem18WeightedDivisorSeries20260930
end
