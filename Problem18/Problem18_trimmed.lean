def rawGram (unitary : Bool) (q : ℕ) (F : Matrix (Fin c) (Fin b) K) :
    Matrix (Fin b) (Fin b) K :=
  if unitary then (F.map (fun x => x^q)).transpose*F else F.transpose*F
def RawGood (unitary : Bool) (q : ℕ) (F : Matrix (Fin c) (Fin b) K) : Prop :=
  (rawGram unitary q F).det≠0 ∧ Squarefree (rawGram unitary q F).charpoly
def OrientedRawGood (unitary : Bool) (q : ℕ) (F : Matrix (Fin c) (Fin b) K) : Prop :=
  if b≤ c then RawGood unitary q F else RawGood unitary q F.transpose
def FirstRawGood (unitary : Bool) (q : ℕ) (A : RectTensor 1 b c K) : Prop :=
  OrientedRawGood unitary q (matrixOf A)
def boundaryConstant : ℝ := min (Real.exp (-4)/72) (Real.exp (-72)/324)
theorem boundaryConstant_pos : 0<boundaryConstant := lt_min (by positivity) (by positivity)
theorem first_orthogonal_iff (q : ℕ) (A : RectTensor 1 b c K) :
    FirstRawGood false q A ↔ FirstGood A := Iff.rfl
theorem raw_unitary_iff [StarRing K] (q : ℕ) (hstar : ∀ x : K,star x=x^q)
    (F : Matrix (Fin c) (Fin b) K) : RawGood true q F ↔ UnitaryGood F := by
  have he : (F.map (fun x => x^q)).transpose=Fᴴ := by
    ext i j
    exact (hstar (F j i)).symm
  change ((F.map (fun x => x^q)).transpose*F).det≠0 ∧
    Squarefree ((F.map (fun x => x^q)).transpose*F).charpoly ↔ _
  rw [he]
  rfl
theorem first_unitary_iff [StarRing K] (q : ℕ) (hstar : ∀ x : K,star x=x^q)
    (A : RectTensor 1 b c K) : FirstRawGood true q A ↔
      Mathproof.Problem18UnitaryTensorBoundaryDensity20260930.FirstGood A := by
  unfold FirstRawGood Mathproof.Problem18UnitaryTensorBoundaryDensity20260930.FirstGood
    OrientedRawGood Mathproof.Problem18UnitaryTensorBoundaryDensity20260930.OrientedGood
  split_ifs <;> exact raw_unitary_iff q hstar _
theorem first_good_density (unitary : Bool) (q : ℕ) (hv : validSize K unitary q)
    (hb : 4≤b) (hc : 4≤ c) :
    boundaryConstant/(q:ℝ)≤density (FirstRawGood (K:=K) (b:=b) (c:=c) unitary q) := by
  cases unitary with
  | false =>
    have he : FirstRawGood (K:=K) (b:=b) (c:=c) false q=FirstGood :=
      funext (fun A => propext (first_orthogonal_iff q A))
    rw [he]
    change q=Fintype.card K at hv
    rw [hv,← Nat.card_eq_fintype_card]
    apply le_trans _ (Mathproof.Problem18OrthogonalTensorBoundaryDensity20260930.first_good_density hb hc)
    calc
      _ ≤ (Real.exp (-4)/72)/(Nat.card K:ℝ) :=
        div_le_div_of_nonneg_right (min_le_left _ _) (Nat.cast_nonneg _)
      _ = _ := by rw [div_div]
  | true =>
    let d := Classical.choice (exists_unitaryFieldData q hv)
    letI : StarRing K := d.starRing
    letI : Fintype (fixedField d.automorphism) := Fintype.ofFinite _
    have he : FirstRawGood (K:=K) (b:=b) (c:=c) true q=
        Mathproof.Problem18UnitaryTensorBoundaryDensity20260930.FirstGood :=
      funext (fun A => propext (first_unitary_iff q d.star_eq_power A))
    rw [he]
    have hq : (1:ℝ)≤q := by
      have hh : 1≤Nat.card (fixedField d.automorphism) := Nat.card_pos
      rw [d.fixed_card] at hh
      exact_mod_cast hh
    calc
      _ ≤ boundaryConstant := div_le_self boundaryConstant_pos.le hq
      _ ≤ Real.exp (-72)/324 := min_le_right _ _
      _ ≤ _ := Mathproof.Problem18UnitaryTensorBoundaryDensity20260930.first_good_density
        d.quadratic_card d.star_eq_fixed_card (by omega) (by omega)
end
end Mathproof.Problem18BoundaryUniformDensity20261001
