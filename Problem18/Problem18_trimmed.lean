    (matrix F*tests x ker) s t=(testExpr F ker s t).eval d x := by
  have he : (testExpr F ker s t).eval d x=(transformedMatrix x F*ᵥker t) s := by
    simp only [testExpr,sxSumPair_eval,StarExpr.eval,transformedExpr_eval,Matrix.mulVec,dotProduct]
  rw [he,transformedMatrix,←Matrix.mulVec_mulVec]
  change (F.submatrix id finProdFinEquiv.symm*ᵥ
    (((kronecker (pMatrix x) (rMatrix x)).transpose*ᵥker t) ∘ finProdFinEquiv.symm)) s=_
  simp only [Matrix.submatrix_mulVec_equiv,Function.comp_def,id_eq,Equiv.symm_symm,Equiv.symm_apply_apply]
theorem matrix_source (F : Matrix (Fin c) (Fin a × Fin b) K) :
    matrix (source F)=padded (matrix F) := by
  ext i j
  change padded (matrix F) i (finProdFinEquiv (finProdFinEquiv.symm j))=padded (matrix F) i j
  rw [Equiv.apply_symm_apply]
theorem kernel_zero (d : UnitaryFieldData (K:=K) q) (F G : Matrix (Fin c) (Fin a × Fin b) K)
    (x : OuterVar a b→K) :
    (∀s t,(testExpr (source F) (kernelFamily G) s t).eval d x=0) ↔
      ∀s t,(kernelExpr F G s t).eval d x=0 := by
  change (∀s t,(testExpr (source F) (kernelFamily G) s t).eval d x=0) ↔
    ∀s t,(testExpr F (kernelFamily G) s t).eval d x=0
  simp only [←entry d]
  have hz (A : Matrix (Fin c) (Fin (a*b)) K) :
      (∀s t,(A*tests x (kernelFamily G)) s t=0) ↔ A*tests x (kernelFamily G)=0 :=
    ⟨fun h=>by ext i j;exact h i j,fun h i j=>congrFun (congrFun h i) j⟩
  have hz' (A : Matrix (Fin (a*b)) (Fin (a*b)) K) :
      (∀s t,(A*tests x (kernelFamily G)) s t=0) ↔ A*tests x (kernelFamily G)=0 :=
    ⟨fun h=>by ext i j;exact h i j,fun h i j=>congrFun (congrFun h i) j⟩
  rw [hz,hz',matrix_source,right_zero]
def equations (d : UnitaryFieldData (K:=K) q) (F G : Matrix (Fin c) (Fin a × Fin b) K) :
    List (StarExpr (OuterVar a b) K) :=
  if ranksMatch F G then
    ((List.finRange a).flatMap fun i=>(List.finRange a).map fun j=>preserveP i j) ++
    ((List.finRange b).flatMap fun i=>(List.finRange b).map fun j=>preserveQ i j) ++
    ((List.finRange (a*b)).flatMap fun i=>(List.finRange (a*b)).map fun j=>testExpr (source F) (kernelFamily G) i j) ++
    ((List.finRange (a*b)).flatMap fun i=>(List.finRange (a*b)).map fun j=>
      gramExpr (gram d F) (gram d G) (finProdFinEquiv.symm i) (finProdFinEquiv.symm j))
  else [.const 1]
theorem zeros (d : UnitaryFieldData (K:=K) q) (F G : Matrix (Fin c) (Fin a × Fin b) K)
    (x : OuterVar a b→K) :
    (∀p∈equations d F G,p.eval d x=0) ↔
      ∀p∈Problem18BoundedUnitarySystem20261001.equations d F G,p.eval d x=0 := by
  unfold equations Problem18BoundedUnitarySystem20261001.equations
  split_ifs with h
  · simp only [List.forall_mem_append,List.forall_mem_flatMap,List.forall_mem_map,
      List.mem_finRange,forall_true_left]
    rw [kernel_zero]
  · rfl
theorem equivalence (d : UnitaryFieldData (K:=K) q) (F G : Matrix (Fin c) (Fin a × Fin b) K) :
    letI : StarRing K:=d.starRing
    (∃x:OuterVar a b→K,∀p∈equations d F G,p.eval d x=0) ↔
      Problem18Assembly.RectUnitaryEquivalent F G := by
  letI : StarRing K:=d.starRing
  simp_rw [zeros]
  exact equations_equivalence d F G
end
