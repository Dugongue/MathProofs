variable {K : Type*} [Field K] [DecidableEq K] {n m : ℕ}
def tableSpan (vs : List (Vector K (n*n))) : Submodule K (Matrix (Fin n) (Fin n) K) :=
  Submodule.span K {M | M∈vs.map unpack}
def products (S : Fin m→Matrix (Fin n) (Fin n) K) (vs : List (Vector K (n*n))) :=
  vs.flatMap fun v=>List.ofFn fun i=>pack (S i*unpack v)
def basisTable (S : Fin m→Matrix (Fin n) (Fin n) K) : ℕ→List (Vector K (n*n))
  | 0 => (compress [pack 1]).1
  | k+1 => let vs:=basisTable S k; (compress (vs++products S vs)).1
theorem tableSpan_map (vs : List (Vector K (n*n))) :
    tableSpan vs=(rowSpan (K:=K) (vs.map read)).map encoding.symm.toLinearMap := by
  rw [tableSpan,rowSpan,Submodule.map_span]
  congr 1
  ext M
  simp only [Set.mem_setOf_eq,List.mem_map,Set.mem_image,unpack]
  constructor
  · rintro ⟨v,hv,hM⟩; exact ⟨read v,⟨v,hv,rfl⟩,hM⟩
  · rintro ⟨x,⟨v,hv,rfl⟩,hM⟩; exact ⟨v,hv,hM⟩
theorem tableSpan_compress (vs : List (Vector K (n*n))) :
    tableSpan (compress vs).1=tableSpan vs := by
  rw [tableSpan_map,tableSpan_map,compress_span]
theorem tableSpan_append (vs ws : List (Vector K (n*n))) :
    tableSpan (vs++ws)=tableSpan vs⊔tableSpan ws := by
  unfold tableSpan
  rw [List.map_append]
  have he : {M | M∈vs.map unpack++ws.map unpack}={M | M∈vs.map unpack}∪{M | M∈ws.map unpack} := by ext M; simp
  rw [he,Submodule.span_union]
theorem products_span (S : Fin m→Matrix (Fin n) (Fin n) K) (vs : List (Vector K (n*n))) :
    tableSpan (products S vs)=⨆i,(tableSpan vs).map (LinearMap.mulLeft K (S i)) := by
  have he : {M | M∈(products S vs).map unpack}=
      ⋃i : Fin m,(LinearMap.mulLeft K (S i)) '' {M | M∈vs.map unpack} := by
    ext M
    simp only [products,Set.mem_setOf_eq,List.mem_map,List.mem_flatMap,List.mem_ofFn,
      Set.mem_iUnion,Set.mem_image,LinearMap.mulLeft_apply]
    constructor
    · rintro ⟨v,⟨w,hw,i,rfl⟩,rfl⟩
      exact ⟨i,unpack w,⟨w,hw,rfl⟩,(unpack_pack _).symm⟩
    · rintro ⟨i,M,⟨w,hw,rfl⟩,rfl⟩
      exact ⟨pack (S i*unpack w),⟨w,hw,i,rfl⟩,unpack_pack _⟩
  unfold tableSpan
  rw [he,Submodule.span_iUnion]
  congr 1
  funext i
  exact (Submodule.map_span _ _).symm
theorem basisTable_span (S : Fin m→Matrix (Fin n) (Fin n) K) (k : ℕ) :
    tableSpan (basisTable S k)=algebraWordSpace (K:=K) S k := by
  induction k with
  | zero =>
    rw [basisTable,tableSpan_compress]
    simp [tableSpan,algebraWordSpace,unpack_pack]
  | succ k ih => rw [basisTable,tableSpan_compress,tableSpan_append,products_span,ih,algebraWordSpace]
theorem basisTable_length (S : Fin m→Matrix (Fin n) (Fin n) K) (k : ℕ) :
    (basisTable S k).length≤ n*n := by
  cases k <;> exact compress_length _
theorem products_length (S : Fin m→Matrix (Fin n) (Fin n) K) (vs : List (Vector K (n*n))) :
    (products S vs).length=vs.length*m := by simp [products,List.length_flatMap]
theorem basisTable_exact (S : Fin m→Matrix (Fin n) (Fin n) K) :
    tableSpan (basisTable S (n^2+1))=(Algebra.adjoin K (Set.range S)).toSubmodule := by
  rw [basisTable_span]
  rw [←Problem18CountedAlgebra20261001.wordSearch_exact_span S,
    Problem18ExecutableAlgebra20261001.wordSearch_eq,wordBasisSearch_span]
