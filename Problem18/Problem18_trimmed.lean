attribute [-instance] FunLike.toDecidableEq CommSemiRingCat.FilteredColimits.colimitCommSemiring SemiRingCat.instSemiringObjForgetRingHomCarrier AddMonoidAlgebra.instHopfAlgebraStruct AddMonoidAlgebra.instBialgebra Bialgebra.toAlgebra
namespace Mathproof.Problem18RectangularKernelChecks20261001
open Matrix Problem18KernelBoolean20261001 Problem18MarkedRecovery20260929
variable {K ι : Type*} [Field K] [DecidableEq K] [Fintype ι] [DecidableEq ι] {r s n : ℕ}
def check (e : Fin n≃ι) (A : Matrix (Fin r) ι K) (B : Matrix (Fin s) ι K) : Bool :=
  kernelEqCheck (A.submatrix id e) (B.submatrix id e)
theorem submatrix_mulVec_coordinates (e : Fin n≃ι) (A : Matrix (Fin r) ι K) (x : ι→K) :
    (A.submatrix id e)*ᵥ(x ∘ e)=A*ᵥx := by
  rw [Matrix.submatrix_mulVec_equiv]
  simp [Function.comp_def]
theorem check_correct (e : Fin n≃ι) (A : Matrix (Fin r) ι K) (B : Matrix (Fin s) ι K) :
    check e A B=true ↔ LinearMap.ker A.toLin'=LinearMap.ker B.toLin' := by
  rw [check,kernelEqCheck_correct]
  constructor
  · intro h
    ext x
    have hh:=SetLike.ext_iff.mp h (x ∘ e)
    change (A.submatrix id e)*ᵥ(x ∘ e)=0 ↔ (B.submatrix id e)*ᵥ(x ∘ e)=0 at hh
    change A*ᵥx=0 ↔ B*ᵥx=0
    simpa only [submatrix_mulVec_coordinates] using hh
  · intro h
    ext x
    have hh:=SetLike.ext_iff.mp h (x ∘ e.symm)
    change A*ᵥ(x ∘ e.symm)=0 ↔ B*ᵥ(x ∘ e.symm)=0 at hh
    change (A.submatrix id e)*ᵥx=0 ↔ (B.submatrix id e)*ᵥx=0
    simpa only [Matrix.submatrix_mulVec_equiv,Function.comp_def,id_eq] using hh
def marked (A : Matrix (Fin r) ι K) (v : Fin r→K) : Matrix (Fin r) (ι⊕Fin 1) K :=
  fun i=>Sum.elim (A i) (fun _=>v i)
theorem marked_mulVec (A : Matrix (Fin r) ι K) (v : Fin r→K) (x : (ι⊕Fin 1)→K) :
    marked A v*ᵥx=augment A.toLin' v (x ∘ Sum.inl,x (Sum.inr 0)) := by
  ext i
  simp [marked,Matrix.mulVec,dotProduct,Fintype.sum_sum_type,augment_apply,
    Matrix.toLin'_apply,Fin.sum_univ_one,smul_eq_mul,mul_comm]
theorem marked_kernel_iff (A : Matrix (Fin r) ι K) (B : Matrix (Fin r) ι K) (v : Fin r→K) :
    LinearMap.ker (marked A v).toLin'=LinearMap.ker (marked B v).toLin' ↔
      LinearMap.ker (augment A.toLin' v)=LinearMap.ker (augment B.toLin' v) := by
  constructor
  · intro h
    ext x
    have hh:=SetLike.ext_iff.mp h (Sum.elim x.1 (fun _ : Fin 1=>x.2))
    change marked A v*ᵥ_=0 ↔ marked B v*ᵥ_=0 at hh
    change augment A.toLin' v x=0 ↔ augment B.toLin' v x=0
    simpa only [marked_mulVec,Function.comp_def,Sum.elim_inl,Sum.elim_inr] using hh
  · intro h
    ext x
    change marked A v*ᵥx=0 ↔ marked B v*ᵥx=0
    rw [marked_mulVec,marked_mulVec]
    exact SetLike.ext_iff.mp h _
def markedCheck (e : Fin n≃ι) (A B : Matrix (Fin r) ι K) (v : Fin r→K) : Bool :=
  check (finSumFinEquiv.symm.trans (Equiv.sumCongr e (Equiv.refl (Fin 1)))) (marked A v) (marked B v)
theorem markedCheck_correct (e : Fin n≃ι) (A B : Matrix (Fin r) ι K) (v : Fin r→K) :
    markedCheck e A B v=true ↔
      LinearMap.ker (augment A.toLin' v)=LinearMap.ker (augment B.toLin' v) := by
  rw [markedCheck,check_correct,marked_kernel_iff]
end Mathproof.Problem18RectangularKernelChecks20261001
