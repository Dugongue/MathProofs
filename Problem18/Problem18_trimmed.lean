  (Module.finBasis K (AdjoinRoot (g i))).equivFun.injective
theorem modelTraceForm_det {η : Type*} [Fintype η] [DecidableEq η]
    (b : Module.Basis η K (∀ i,AdjoinRoot (g i))) (c : ∀ i,AdjoinRoot (g i)) :
    ((modelTraceForm g c).toMatrix b).det =
      (∏ i,Algebra.norm K (c i))*((modelTraceForm g 1).toMatrix b).det := by
  have he : modelTraceForm g c=(modelTraceForm g 1).comp (LinearMap.mulLeft K c) LinearMap.id := by
    apply LinearMap.ext
    intro x
    apply LinearMap.ext
    intro y
    simp only [modelTraceForm_apply,LinearMap.BilinForm.comp_apply,LinearMap.id_apply,
      LinearMap.mulLeft_apply,Pi.mul_apply,Pi.one_apply,one_mul]
  rw [he,LinearMap.BilinForm.toMatrix_comp (b:=b) (c:=b),LinearMap.toMatrix_id,
    Matrix.mul_one,Matrix.det_mul,Matrix.det_transpose,LinearMap.det_toMatrix]
  change Algebra.norm K c*((modelTraceForm g 1).toMatrix b).det=_
  rw [norm_pi]
theorem representable_coefficients_card [Nonempty ι] (hodd : ringChar K≠2)
    (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hnB : B.Nondegenerate)
    (hdim : Module.finrank K V=∑ i,(g i).natDegree) :
    Nat.card {c : (∀ i,{z : AdjoinRoot (g i) // z≠0}) //
      ∃ e : (∀ i,AdjoinRoot (g i)) ≃ₗ[K] V,∀ x y,B (e x) (e y)=
        modelTraceForm g (fun i => (c i).val) x y}*2=
      ∏ i,(Nat.card K^(g i).natDegree-1) := by
  let E := ∀ i,AdjoinRoot (g i)
  have hd : Module.finrank K V=Module.finrank K E := by
    rw [Module.finrank_pi_fintype]
    have hgi (i : ι) : Module.finrank K (AdjoinRoot (g i))=(g i).natDegree := finrank_quotient_span_eq_natDegree
    simp_rw [hgi]
    exact hdim
  let bE := Module.finBasis K E
  let bV := (Module.finBasis K V).reindex (finCongr hd)
  let δ := ((modelTraceForm g 1).toMatrix bE).det
  let β := (B.toMatrix bV).det
  have hδ : δ≠0 := (LinearMap.BilinForm.nondegenerate_iff_det_ne_zero bE).mp
    (modelTraceForm_nondegenerate g 1 (fun _ => one_ne_zero))
  have hβ : β≠0 := (LinearMap.BilinForm.nondegenerate_iff_det_ne_zero bV).mp hnB
  let a : K := δ/β
  have ha : a≠0 := div_ne_zero hδ hβ
  let E₀ := fun i => AdjoinRoot (g i)
  let e₀ : (∀ i,(E₀ i)ˣ) ≃ (∀ i,{z : E₀ i // z≠0}) :=
    Equiv.piCongrRight fun i => unitsEquivNeZero (G₀:=E₀ i)
  have hi (z : ∀ i,(E₀ i)ˣ) :
      (∃ e : E ≃ₗ[K] V,∀ x y,B (e x) (e y)=modelTraceForm g (fun i => (e₀ z i).val) x y) ↔
      quadraticChar K (a*(productNormUnits E₀ z).val)=1 := by
    rw [isometry_iff_square_determinant_ratio hodd _ B bE bV
      (modelTraceForm_symmetric g _) hB
      (modelTraceForm_nondegenerate g _ (fun i => (e₀ z i).property)) hnB,modelTraceForm_det]
    have hn : (productNormUnits E₀ z).val=∏ i,Algebra.norm K (z i).val := by
      simp [productNormUnits]
    have he : (∏ i,Algebra.norm K (e₀ z i).val)*δ/β=a*(productNormUnits E₀ z).val := by
      rw [hn]
      change (∏ i,Algebra.norm K (z i).val)*δ/β=_
      dsimp [a]
      ring
    change IsSquare ((∏ i,Algebra.norm K (e₀ z i).val)*δ/β) ↔ _
    rw [he]
    exact (quadraticChar_one_iff_isSquare (mul_ne_zero ha (productNormUnits E₀ z).ne_zero)).symm
  let e : {z : (∀ i,(E₀ i)ˣ) // quadraticChar K (a*(productNormUnits E₀ z).val)=1} ≃
      {c : (∀ i,{z : E₀ i // z≠0}) // ∃ e : E ≃ₗ[K] V,∀ x y,
        B (e x) (e y)=modelTraceForm g (fun i => (c i).val) x y} :=
    e₀.subtypeEquiv (fun z => (hi z).symm)
  have hc := product_norm_squareclass_card E₀ hodd (Units.mk0 a ha)
  simp only [Units.val_mk0] at hc
  rw [Nat.card_congr e] at hc
  convert hc using 1
  apply Finset.prod_congr rfl
  intro i _
  rw [Mathproof.Problem18DistinctDegreeSquare20260930.adjoinRoot_card]
end
end Mathproof.Problem18SquarefreeTraceDeterminant20260930
