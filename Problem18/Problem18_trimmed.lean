def PointExistence (n : Nat) (threshold : Nat → Nat) : Prop :=
  ∀ (d : Nat) (rows : List (DenseInput n d K)) (fs : List (MvPolynomial (Fin n) K)),
    Represents rows fs → threshold d < Fintype.card K → HasFixedComponent L fs →
      ∃ x : Fin n → K, ∀ f ∈ fs, eval x f = 0
noncomputable def backend (n : Nat) (threshold : Nat → Nat) (hpt : PointExistence (K := K) L n threshold) :
    GeometryBackend (K := K) L n where
  fixedTest := fun d rows => fixedTest n d rows
  childDeg := fun d => collDeg n d
  child := fun d rows => child n d rows
  threshold := threshold
  fixedBudget := fun d r => fixedBudget n d r
  childBudget := fun d r => childBudget n d r
  childRows := fun d _ => childBox n d
  fixedTest_correct := fun d rows fs h => fixedTest_correct (L := L) n d rows fs h
  child_spec := fun d rows fs h hno => by
    obtain ⟨gs, hrep, hrad⟩ := child_spec (L := L) n d rows fs h
    exact ⟨gs, hrep, child_spec_of_radical_eq L fs gs hno hrad⟩
  pointExistence := hpt
  fixedTest_cost := fun d rows => fixedTest_cost n d rows
  child_cost := fun d rows => child_cost n d rows
  child_length := fun d rows => child_length n d rows
  fixedBudget_mono := fun d r r' h => fixedBudget_mono n d r r' h
  childBudget_mono := fun d r r' h => childBudget_mono n d r r' h
  childRows_mono := fun _ _ _ _ => le_rfl
noncomputable def runA (n : Nat) (threshold : Nat → Nat) (hpt : PointExistence (K := K) L n threshold)
    (F : FieldPresentation K) (d : Nat) (rows : List (DenseInput n d K)) : RunResult :=
  run (backend L n threshold hpt) F d rows
theorem runA_correct (n : Nat) (threshold : Nat → Nat) (hpt : PointExistence (K := K) L n threshold)
    (F : FieldPresentation K) (d : Nat) (rows : List (DenseInput n d K))
    (hv : ∀ v ∈ rows, ∃ p : MvPolynomial (Fin n) K, ValidDenseInput d v p)
    (hcard : Fintype.card K = F.p ^ F.e) :
    (runA L n threshold hpt F d rows).answer = true ↔
      ∃ x : Fin n → K, ∀ v ∈ rows, denseEval x (read v) = 0 :=
  run_correct (backend L n threshold hpt) F d rows hv hcard
end Mathproof.Problem18ClaudeBackendInstance20261001
