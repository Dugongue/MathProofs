@[simp] theorem modelTraceForm_apply (c x y : ∀ i,AdjoinRoot (g i)) :
    modelTraceForm g c x y=∑ i,Algebra.trace K (AdjoinRoot (g i)) (c i*x i*y i) := by
  simp only [modelTraceForm,LinearMap.sum_apply,LinearMap.BilinForm.comp_apply,
    LinearMap.proj_apply,scalarTraceForm_apply]
theorem modelTraceForm_single_right (c x : ∀ i,AdjoinRoot (g i))
    (i : ι) (y : AdjoinRoot (g i)) :
