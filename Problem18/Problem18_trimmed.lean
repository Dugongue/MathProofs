variable {K : Type} [Field K] (F : FieldPresentation K)
def gramF (ex c N : Nat) (v : Nat → K) (idx : Nat) : K :=
  ∑ k ∈ Finset.range c, v (k * N + idx / N) ^ ex * v (k * N + idx % N)
