  classical
  have hi : Function.Injective B := LinearMap.ker_eq_bot.mp
    ((LinearMap.separatingLeft_iff_ker_eq_bot (B := B)).mp hB)
  have hs : Function.Surjective B :=
    (Finite.injective_iff_surjective_of_equiv
      (Module.Basis.ofVectorSpace K V).toDualEquiv.toEquiv).mp hi
