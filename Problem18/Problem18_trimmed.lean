    (hdb : 64 * d ≤ b) (hu : 0 ≤ u) :
    b * r / 4 ≤ restrictionExponent a b d r u := by
  have ha0 : 0 ≤ a - 2 := by linarith
  have hbdr : 0 ≤ b - d := by linarith
  have hbr : 0 ≤ b - r := by linarith
  have hr0 : 0 ≤ r := by linarith
  by_cases hlow : 2 * u ≤ a * r
  · have hmax : max (a * r - 2 * u) 0 = a * r - 2 * u :=
      max_eq_left (by linarith)
    have hdiff : 0 ≤ (a - 2) * (r * (b - d) + u * (b - r)) :=
      mul_nonneg ha0 (add_nonneg (mul_nonneg hr0 hbdr) (mul_nonneg hu hbr))
    have hbase := phi_two_linear_branch b d r u hb hr hrb hd hdb hu
    unfold restrictionExponent
