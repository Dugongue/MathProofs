def rawAdjoint {i j : Type*} (u : Bool) (q : ℕ) (A : Matrix i j K) : Matrix j i K :=
  if u then (A.map (fun x=>x^q)).transpose else A.transpose
def rawFirst (u : Bool) (q : ℕ) (A : RectTensor a b c K) (t : Fin c) :
    Matrix (Fin b) (Fin b) K :=
  partialTraceRight ((rawAdjoint u q A*(A*rawAdjoint u q A)^t.val*A).transpose)
def rawSecond (u : Bool) (q : ℕ) (A : RectTensor a b c K) (kl : Fin b×Fin b) :
