theorem repeated_character_average_le (a b d : ℕ) (hd : d ≤ b*a)
    (A : selfAdjoint (Matrix (Fin b) (Fin b) K)) (ψ : AddChar F ℂ) (hψ : ψ ≠ 1) :
    (∑g : InjectiveSample K (Fin (b*a) → K) d,
      (‖(∑x : constraintSpace g.val,
        FiniteFieldOrthogonalUnitaryTI.hermitianTraceCharacter hstar ψ A (repeatedGram x.val)) /
        (Fintype.card (constraintSpace g.val) : ℂ)‖^2)^(b - d)) /
      Nat.card (InjectiveSample K (Fin (b*a) → K) d)  ≤
      rankWeight (Fintype.card K : ℝ) a b d A.val.rank := by
  simp_rw [character_repeatedGram]
  have h := averaged_moment_le hcard hstar ψ hψ (repeatedMatrix a A)
    (repeatedMatrix_hermitian a A) d hd (b - d)
