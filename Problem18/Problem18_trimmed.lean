variable {K : Type} [Field K] (F : FieldPresentation K)
theorem words_eq_iff_n {arr : String} {σ : Env} {s d n : Nat} {x y : Nat → K}
    (hx : Vals F arr σ s n x) (hy : Vals F arr σ d n y) :
    (∀ j < F.e * n, (σ.arrs arr).getD (s + j) 0 = (σ.arrs arr).getD (d + j) 0) ↔
      ∀ i < n, x i = y i := by
  constructor
  · intro h i hi
    apply (words_eq_iff F (vals_one F hx i hi) (vals_one F hy i hi)).mp
    intro j hj
    have := index_split (e := F.e) hj hi
    have h' := h (F.e * i + j) this
    rw [← Nat.add_assoc, ← Nat.add_assoc] at h'
    exact h'
  · intro h j hj
    have he := F.degree_pos
    have hi : j / F.e < n := by
      rw [Nat.div_lt_iff_lt_mul he]; rw [Nat.mul_comm] at hj; exact hj
    have ht : j % F.e < F.e := Nat.mod_lt _ he
    have hj' : j = F.e * (j / F.e) + j % F.e := (Nat.div_add_mod j F.e).symm
    have := (words_eq_iff F (vals_one F hx _ hi) (vals_one F hy _ hi)).mpr (h _ hi) (j % F.e) ht
    rw [hj', ← Nat.add_assoc, ← Nat.add_assoc]
    exact this
def cmpV (flag : String) (s d n : Expr) : Com :=
  .seq (.assign cS s) <| .seq (.assign cD d) <| .seq (.assign cCnt n) <|
