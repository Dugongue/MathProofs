open Problem18ClaudeFieldMacrosInstancePow20261001
open Problem18IMPPolynomialProductCall20261002 Problem18IMPPolynomialMultiplyAscending20261002
def output : String := "P18.poly.derivative"
def ci : String := "P18.poly.derivative.constantIndex"
def difference : Expr := .bin .sub (.var sizeReg) (.var q.j)
def factorExpr : Expr := .bin .sub difference (.bin .mul (.bin .div difference (.var canonical.p)) (.var canonical.p))
def sourceExpr : Expr := plus (.var tw.pS) (.bin .sub (.var q.j) (.lit 1))
def outputExpr : Expr := plus (.var output) (.var q.j)
def core : Com := .seq (constLoadE canonical q ci (.lit 2) factorExpr)
  (mcall canonical q Primitive.multiply.code (.lit 2) sourceExpr outputExpr)
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
def coreCost : Nat := constCostE (.lit 2) factorExpr F.e+24+10000*(F.e+1)^2
theorem core_run {B Sn N j ps ds : Nat} {σ : Env}
    (hS : Slots F canonical WS Sn B σ)
    (hN : σ.vars sizeReg=N) (hj : σ.vars q.j=j)
    (hp : σ.vars tw.pS=ps) (hd : σ.vars output=ds)
    (hj0 : 0<j) (hjN : j<N) (hp5 : 5 ≤ ps) (hd5 : 5 ≤ ds)
    (hpf : ps+N ≤ Sn) (hdf : ds+N ≤ Sn)
    (hsep : ps+N ≤ ds ∨ ds+N ≤ ps) :
    ∃τ,Run B core σ τ (coreCost F) ∧ Slots F canonical WS Sn B τ ∧
      val F canonical WS τ (ds+j)=((N-j:Nat):K)*val F canonical WS σ (ps+(j-1)) ∧
      (∀s<Sn,s≠2 → s≠ds+j → val F canonical WS τ s=val F canonical WS σ s) ∧
      (∀x,x∉regNames canonical → x≠ci → τ.vars x=σ.vars x) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  letI : CharP K F.p:=F.characteristic
  have hSB:=hS.slots_word
  have hpp:=hS.base.prime
  have hpB : F.p<B := by have hh:=hS.base.arithmetic_word;nlinarith
  have hmod : (N-j)%F.p<F.p := Nat.mod_lt _ F.prime.pos
  have en : (Expr.var sizeReg).evalB B σ=some N := by
    simpa only [hN] using evalB_var (σ:=σ) (B:=B) (x:=sizeReg) (by rw [hN];omega)
  have ej : (Expr.var q.j).evalB B σ=some j := by
    simpa only [hj] using evalB_var (σ:=σ) (B:=B) (x:=q.j) (by rw [hj];omega)
  have ep : (Expr.var canonical.p).evalB B σ=some F.p := by
    simpa only [hpp] using evalB_var (σ:=σ) (B:=B) (x:=canonical.p) (by rw [hpp];exact hpB)
  have es:=evalB_bin (op:=Bop.sub) en ej (by change N-j<B;omega)
  have eqt:=evalB_bin (op:=Bop.div) es ep (by change (N-j)/F.p<B;have:=Nat.div_le_self (N-j) F.p;omega)
  have em:=evalB_bin (op:=Bop.mul) eqt ep (by change (N-j)/F.p*F.p<B;have:=Nat.div_mul_le_self (N-j) F.p;omega)
  have ev : factorExpr.evalB B σ=some ((N-j)%F.p) := by
    simpa only [factorExpr,difference,Bop.apply,Nat.mod_eq_sub_div_mul] using
      evalB_bin (op:=Bop.sub) es em (by change (N-j)-(N-j)/F.p*F.p<B;omega)
  obtain ⟨ξ,hc,hs,hfactor,hm,hvars,_,hin,hout⟩ :=
    constE_run (F:=F) (r:=canonical) q ci (by decide) (by decide)
      [] (by simp) (.lit 2) trivial hS (evalB_lit (by omega : 2<B)) (by omega)
      factorExpr [sizeReg,q.j,canonical.p] (by decide) (by simp [factorExpr,difference,VarsIn]) ev hmod
  have ej' : (Expr.var q.j).evalB B ξ=some j := by
    rw [evalB_congr_varsIn (l:=[q.j]) (by intro x hx;simp only [List.mem_singleton] at hx;subst x;exact hvars _ (by decide)) (.var q.j) (by simp [VarsIn])]
    exact ej
  have hps' : ξ.vars tw.pS=ps := (hvars _ (by decide)).trans hp
  have hds' : ξ.vars output=ds := (hvars _ (by decide)).trans hd
  have esub:=evalB_bin (op:=Bop.sub) ej' (evalB_lit (by omega : 1<B)) (by change j-1<B;omega)
  have eps : (Expr.var tw.pS).evalB B ξ=some ps := by
    simpa only [hps'] using evalB_var (σ:=ξ) (B:=B) (x:=tw.pS) (by rw [hps'];omega)
  have eds : (Expr.var output).evalB B ξ=some ds := by
    simpa only [hds'] using evalB_var (σ:=ξ) (B:=B) (x:=output) (by rw [hds'];omega)
  have ea : sourceExpr.evalB B ξ=some (ps+(j-1)) :=
    evalB_bin (op:=Bop.add) eps esub (by change ps+(j-1)<B;omega)
  have eo : outputExpr.evalB B ξ=some (ds+j) :=
    evalB_bin (op:=Bop.add) eds ej' (by change ds+j<B;omega)
  obtain ⟨τ,hr,hvalue,hcall⟩ := slot_call F canonical (fieldMacros F).mul_spec hs
    (.lit 2) sourceExpr outputExpr (evalB_lit (by omega : 2<B)) ea eo
    (by simp [NoVar,sourceExpr,plus,q,tw,canonical])
    (by simp [NoVar,outputExpr,plus,output,q,canonical])
    (by simp [NoVar,outputExpr,plus,output,q,canonical]) (by omega) (by omega) (by omega) (by omega)
    (by rcases hsep with h|h <;> omega)
  have hall:=hc.seq hr
  refine ⟨τ,?_,hcall.slots,?_,?_,?_,?_,?_⟩
  · have hcost : 15+(Expr.lit 2).size+sourceExpr.size+outputExpr.size+(fieldMacros F).costMul=
        24+10000*(F.e+1)^2 := rfl
    change Run B core σ τ _ at hall
    apply hall.mono
    rw [hcost]
    unfold coreCost
    omega
  · change val F canonical q.WS τ (ds+j)=_
    rw [hvalue,hfactor,hm _ (by omega) (by omega),←CharP.cast_eq_mod K F.p (N-j)]
    rfl
  · intro s hsx hs2 hsd
    exact (call_val hcall hsx hsd).trans (hm s hsx hs2)
  · intro x hx hci
    exact (call_regs_all hcall x hx).trans (hvars x hci)
  · exact hcall.inp.trans hin
  · exact hcall.out.trans hout
end Mathproof.Problem18IMPPolynomialDerivative20261002
