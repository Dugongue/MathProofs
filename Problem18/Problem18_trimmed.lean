  rw [guardedRegularCheck,Bool.and_eq_true,beq_iff_eq,regularSquarefreeCheck_correct]
  constructor
  · rintro ⟨hd,hs,hc⟩
    rw [candidatePolynomial_correct A hd] at hs hc
    refine ⟨?_,hs⟩
    rw [Matrix.det_eq_sign_charpoly_coeff]
    exact mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)) hc
  · rintro ⟨hd,hs⟩
    have hn := candidateDegree_complete A hs
    refine ⟨hn,?_,?_⟩
    · simpa only [candidatePolynomial_correct A hn] using hs
    · rw [candidatePolynomial_correct A hn]
      intro hz
      apply hd
      rw [Matrix.det_eq_sign_charpoly_coeff,hz,mul_zero]
theorem guardedRegularCheck_eq (A : Matrix (Fin n) (Fin n) K) :
    guardedRegularCheck A=Problem18BoundaryBooleanChecks20260930.regularCheck A := by
  apply Bool.eq_iff_iff.mpr
  rw [guardedRegularCheck_correct,Problem18BoundaryBooleanChecks20260930.regularCheck_correct]
