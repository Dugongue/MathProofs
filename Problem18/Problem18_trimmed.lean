noncomputable def unitFrame (t : E) (S : Module.End K V) (e : Frames t S) (u : Eˣ) :
    Frames t S :=
  ⟨(u.mulLeftLinearEquiv K E).trans e.val,by
    intro x
    change e.val ((u:E)*(t*x))=S (e.val ((u:E)*x))
    rw [show (u:E)*(t*x)=t*((u:E)*x) by ring,e.property]⟩
noncomputable def unitsFrameEquiv (t : E) (ht : Algebra.adjoin K ({t}:Set E)=⊤)
    (S : Module.End K V) (e : Frames t S) : Eˣ ≃ Frames t S := by
  apply Equiv.ofBijective (unitFrame t S e)
  constructor
  · intro u v h
    have hh := congrArg (fun f : Frames t S => f.val 1) h
    have hh' : e.val (u:E)=e.val (v:E) := by
      simpa only [unitFrame,LinearEquiv.trans_apply,Units.mulLeftLinearEquiv_apply,mul_one] using hh
    exact Units.ext (e.val.injective hh')
  · intro f
    let T := f.val.trans e.val.symm
    have hT : ∀ x,T (t*x)=t*T x := by
      intro x
      apply e.val.injective
      change e.val (e.val.symm (f.val (t*x)))=e.val (t*e.val.symm (f.val x))
      rw [e.val.apply_symm_apply,f.property,e.property,e.val.apply_symm_apply]
    have hs (x : E) : T x=T 1*x := generator_commutant_scalar t ht T.toLinearMap hT x
    have hu : IsUnit (T 1) := IsUnit.isUnit_iff_mulLeft_bijective.mpr (by
      have heq : (fun x : E => T 1*x)=T := funext (fun x => (hs x).symm)
      rw [heq]
      exact T.bijective)
    refine ⟨hu.unit,?_⟩
    apply Subtype.ext
    apply LinearEquiv.ext
    intro x
    change e.val ((hu.unit:E)*x)=f.val x
    rw [hu.unit_spec,← hs]
    exact e.val.apply_symm_apply (f.val x)
