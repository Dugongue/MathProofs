theorem load_run {Sn B N ps gs : Nat} {P Q : K[X]} {σ : Env}
    (hS : Slots F canonical q.WS Sn B σ) (hn : σ.vars q.n=N)
    (hp : σ.vars pReg=ps) (hg : σ.vars gReg=gs)
    (hfit : 5+N+N+N+N ≤ Sn) (hps : 5+N+N+N+N ≤ ps) (hgs : 5+N+N+N+N ≤ gs)
    (hpf : ps+N ≤ Sn) (hgf : gs+N ≤ Sn)
    (hP : ∀i<N,val F canonical q.WS σ (ps+i)=P.coeff (N-1-i))
    (hQ : ∀i<N,val F canonical q.WS σ (gs+i)=Q.coeff (N-1-i))
    (hPd : P=0 ∨ P.natDegree<N) (hQd : Q=0 ∨ Q.natDegree<N) :
    ∃τ,Run B load σ τ (loadCost F N) ∧ Buffers F q Sn B N P Q τ ∧
