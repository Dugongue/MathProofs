      (∀s < Sn,s < σ.vars rightReg → (s < inStart (n*n) 0 ∨ inStart (n*n) (vs.length*(m+1)) ≤ s) →
        val F canonical q.WS τ s=val F canonical q.WS σ s) ∧
      (∀x∈controls,τ.vars x=σ.vars x) ∧ τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hN:σ.vars q.N=n*n:=by rw [h.dim,hn]
