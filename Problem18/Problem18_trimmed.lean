    Fintype.sum_equiv (Equiv.addLeft x) _ _ (fun _ => rfl)
  have hu (x : G) : f x * star (f x) = 1 := by
    simpa [Complex.normSq_eq_norm_sq, hf] using Complex.mul_conj (f x)
  calc
    _ = ∑ x, (∑ h, f (x+h)) * star (f x) := by
      simp_rw [he]; rw [Finset.mul_sum]
    _ = ∑ h, ∑ x, f (x+h) * star (f x) := by
      simp_rw [Finset.sum_mul]; rw [Finset.sum_comm]
    _ = _ := by
      apply Finset.sum_congr rfl
      intro h _
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro x _
      rw [hpol]
      calc
        _ = (f x * star (f x)) * (f h * β h x) := by ring
        _ = _ := by rw [hu, one_mul]
