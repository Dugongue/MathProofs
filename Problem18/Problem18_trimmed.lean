      (WrapperState (programArgumentBound p))) (stack : WrapperStack) :
    ((((totalStep (TM2.step
      (combinedProgram p (programArgumentBound p) le_rfl wordBound)))^[n]) c).stk
        stack).length ≤
      (c.stk stack).length + n *
        programPushBound
          (combinedProgram p (programArgumentBound p) le_rfl wordBound) := by
  induction n generalizing c with
  | zero => simp
  | succ n ih =>
      rw [Function.iterate_succ_apply, add_one_mul]
      exact (ih _).trans (by
        have h := totalStep_stack_length_le p wordBound c stack
        omega)
 theorem innerStart_stack_length_le
    (p : Program) (wordBound : Polynomial Nat) (x : List Nat)
    (stack : WrapperStack) :
    ((innerStart p wordBound (encode x)).stk stack).length ≤ bitSize x := by
  cases stack with
  | input => simp [innerStart, ramSimulationTM, Turing.initList, bitSize]
  | output => simp [innerStart, ramSimulationTM, Turing.initList]
  | core stack =>
      cases stack <;> simp [innerStart, ramSimulationTM, Turing.initList]
theorem status_cleanupCost_le
    (p : Program) (wordBound : Polynomial Nat) (x : List Nat) (fuel : Nat) :
    let d := (totalStep (TM2.step
      (combinedProgram p (programArgumentBound p) le_rfl wordBound)))^[fuel]
        (innerStart p wordBound (encode x))
    cleanupTotalCost (statusTapes d.stk d.l.isNone) ≤
      26 * (bitSize x + fuel *
        programPushBound
          (combinedProgram p (programArgumentBound p) le_rfl wordBound)) + 13 := by
  intro d
  have bound (stack : WrapperStack) :
      (d.stk stack).length ≤ bitSize x + fuel *
        programPushBound
          (combinedProgram p (programArgumentBound p) le_rfl wordBound) :=
    (totalIterate_stack_length_le p wordBound fuel
      (innerStart p wordBound (encode x)) stack).trans
      (Nat.add_le_add_right (innerStart_stack_length_le p wordBound x stack) _)
  have hinput := bound .input
  have hacc := bound (.core .accumulator)
  have hmem := bound (.core .memory)
  have hcin := bound (.core .input)
  have hcout := bound (.core .output)
  have h0 := bound (.core .work0)
  have h1 := bound (.core .work1)
  have h2 := bound (.core .work2)
  have h3 := bound (.core .work3)
  have h4 := bound (.core .work4)
  have h5 := bound (.core .work5)
  have h6 := bound (.core .work6)
  have h7 := bound (.core .work7)
  rw [cleanupTotalCost_statusTapes]
  unfold cleanupTotalCost
  omega
noncomputable def taggedTimePolynomial
    (p : Program) (wordBound timeBound : Polynomial Nat) : Polynomial Nat :=
  let q := clockPolynomial p wordBound timeBound
  let pushes := programPushBound
    (combinedProgram p (programArgumentBound p) le_rfl wordBound)
  C 26 * X + C (3 + 26 * pushes) * polynomialSimpleMajorant q + C 30
theorem tagged_haltList (p : Program) (wordBound : Polynomial Nat)
    (tapes : (k : WrapperStack) → List (WrapperAlphabet k)) :
    Turing.haltList (machine p wordBound) (tapes .output) =
      mapLabelCfg (embedCleanup (p := p) (wordBound := wordBound))
        (Mathproof.Problem18P36ClockCleanup20261004.cfg
          (⟨none, default, cleanedStacks tapes⟩ :
            TM2.Cfg WrapperAlphabet CleanupLabel
              (WrapperState (programArgumentBound p)))) := by
  simp only [Turing.haltList, machine, mapLabelCfg,
    Mathproof.Problem18P36ClockCleanup20261004.cfg, Option.map_none]
  congr 1
  funext k
  rcases k with k | b
  · cases k <;> simp [stackFn, cleanedStacks] <;> rfl
  · cases b <;> simp [stackFn] <;> rfl
theorem tagged_initList_map_refl (p : Program) (wordBound : Polynomial Nat)
    (input : List Symbol) :
    Turing.initList (machine p wordBound)
        (List.map (Equiv.refl Symbol).invFun input) =
      Turing.initList (machine p wordBound) input :=
  congrArg _ (Mathproof.Problem18P36ClockTagEmitter20261004.map_refl_invFun input)
theorem tagged_haltList_map_refl (p : Program) (wordBound : Polynomial Nat)
    (out : List Symbol) :
    Turing.haltList (machine p wordBound)
        (List.map (Equiv.refl Symbol).invFun out) =
      Turing.haltList (machine p wordBound) out :=
  congrArg _ (Mathproof.Problem18P36ClockTagEmitter20261004.map_refl_invFun out)
theorem tagged_total_run (fuel : Nat) (raw : List Symbol) :
    let c := innerStart p wordBound raw
    let d := (totalStep (TM2.step
      (combinedProgram p (programArgumentBound p) le_rfl wordBound)))^[fuel] c
    let tapes := statusTapes d.stk d.l.isNone
    ((fun o => o.bind (TM2.step (program p wordBound)))^[
        (fuel + 1) + (2*fuel + 2) + 1 + (cleanupTotalCost tapes + 1)])
        (some (start p wordBound
          (List.replicate fuel .one ++ .separator :: raw))) =
      some (Turing.haltList (machine p wordBound) (tapes .output)) := by
  intro c d tapes
  have hparse := parse_tagged_run p wordBound fuel raw
  have hclock := outer_prefix_execution p wordBound c fuel
  have hpublish :
      ((fun o => o.bind (TM2.step (program p wordBound)))^[1])
        (some (mapLabelCfg embedClock
          (phaseCfg WrapperAlphabet d.var d.stk (.exit d.l.isNone) [] []))) =
      some (cleanupStart p wordBound d.var d.stk d.l.isNone) :=
    publish_to_cleanup_step p wordBound d.var d.stk d.l.isNone
  have hclean₀ := Mathproof.Problem18P36ClockCleanup20261004.cleanup_run
    (N := programArgumentBound p) d.var tapes
  have hclean :
      ((fun o => o.bind (TM2.step (program p wordBound)))^[
          cleanupTotalCost tapes + 1])
        (some (cleanupStart p wordBound d.var d.stk d.l.isNone)) =
      some (mapLabelCfg (embedCleanup (p := p) (wordBound := wordBound))
        (Mathproof.Problem18P36ClockCleanup20261004.cfg
          ⟨none, default, cleanedStacks tapes⟩)) := by
    rw [cleanupStart, outer_cleanup_lift]
    exact congrArg (Option.map (mapLabelCfg
      (embedCleanup (p := p) (wordBound := wordBound)))) hclean₀
  have h := chain_iterations _ hparse hclock
  have h := chain_iterations _ h hpublish
  have h := chain_iterations _ h hclean
  rw [tagged_haltList p wordBound tapes]
  exact h
theorem taggedFormula_le_time
    (p : Program) (wordBound timeBound : Polynomial Nat) (x : List Nat) :
    let fuel := clockTokenCount p wordBound timeBound x
    let d := Mathproof.Problem18P36ClockedRAMSemantics20261004.simulationAfterFuel
      p wordBound timeBound x
    let tapes := statusTapes d.stk d.l.isNone
    (fuel + 1) + (2*fuel + 2) + 1 + (cleanupTotalCost tapes + 1) ≤
      (taggedTimePolynomial p wordBound timeBound).eval
        (taggedInput p wordBound timeBound x).length := by
  intro fuel d tapes
  have hcleanup : cleanupTotalCost tapes ≤
      26 * (bitSize x + fuel * programPushBound
        (combinedProgram p (programArgumentBound p) le_rfl wordBound)) + 13 :=
    status_cleanupCost_le p wordBound x fuel
  have hlen : bitSize x ≤ (taggedInput p wordBound timeBound x).length := by
    simp only [taggedInput, bitSize, List.length_append, List.length_replicate,
      List.length_cons]
    omega
  have hmono := polynomial_eval_mono
    (polynomialSimpleMajorant (clockPolynomial p wordBound timeBound)) hlen
  have hf : fuel =
      (polynomialSimpleMajorant (clockPolynomial p wordBound timeBound)).eval
        (bitSize x) := rfl
  rw [← hf] at hmono
  simp only [taggedTimePolynomial, Polynomial.eval_add,
    Polynomial.eval_mul, Polynomial.eval_C, Polynomial.eval_X]
  generalize programPushBound
    (combinedProgram p (programArgumentBound p) le_rfl wordBound) = P
    at hcleanup ⊢
  generalize (polynomialSimpleMajorant
    (clockPolynomial p wordBound timeBound)).eval
      (taggedInput p wordBound timeBound x).length = M at hmono ⊢
  generalize (taggedInput p wordBound timeBound x).length = L at hlen ⊢
  have hP : fuel * P ≤ M * P := Nat.mul_le_mul_right P hmono
  have hexp : (3 + 26 * P) * M = 3 * M + 26 * (M * P) := by ring
  omega
noncomputable def taggedMachine
    (p : Program) (wordBound timeBound : Polynomial Nat) :
    TM2ComputableInPolyTime
      (taggedInput p wordBound timeBound) id
      (statusOutput p wordBound timeBound) where
  tm := machine p wordBound
  inputAlphabet := Equiv.refl Symbol
  outputAlphabet := Equiv.refl Symbol
  time := taggedTimePolynomial p wordBound timeBound
  outputsFun := by
    intro x
    refine ⟨⟨_, ?_⟩, taggedFormula_le_time p wordBound timeBound x⟩
    have hrun := tagged_total_run p wordBound
      (clockTokenCount p wordBound timeBound x) (encode x)
    dsimp only at hrun
    rw [statusTapes_output, start] at hrun
    rw [← tagged_initList_map_refl, ← tagged_haltList_map_refl] at hrun
    exact hrun
noncomputable def clockedMachine
    (p : Program) (wordBound timeBound : Polynomial Nat) :
    TM2ComputableInPolyTime encode BitstringEncoding.bitEncode
      (Mathproof.Problem18P36ClockedRAMSemantics20261004.clockedDecision
        p wordBound timeBound) :=
  let first := TMComposition.computableInPolyTime
    (Mathproof.Problem18P36ClockTagEmitter20261004.emitterMachine
      p wordBound timeBound)
    (taggedMachine p wordBound timeBound)
  let second := TMComposition.computableInPolyTime first
    Mathproof.Problem18P36TotalAnswerCodec20261004.statusDecoderMachine
  { toTM2ComputableAux := second.toTM2ComputableAux
    time := second.time
    outputsFun := by
      intro x
      have hdecode :
          Mathproof.Problem18FiniteTransducer20261001.run
              Mathproof.Problem18P36TotalAnswerCodec20261004.statusDecoder .status
              (statusOutput p wordBound timeBound x) =
            BitstringEncoding.bitEncode
              (Mathproof.Problem18P36ClockedRAMSemantics20261004.clockedDecision
                p wordBound timeBound x) :=
        Mathproof.Problem18P36ClockedRAMSemantics20261004.status_decode_clockedDecision
          p wordBound timeBound x
      have h := second.outputsFun x
      try simp only [Function.comp_apply, id_eq] at h
      rw [hdecode] at h
      exact h }
end
end Mathproof.Problem18P36TaggedClockMachine20261004
end
