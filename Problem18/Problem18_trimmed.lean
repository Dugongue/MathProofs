  obtain ⟨-,-,hdA,hdB,hdC⟩ :=
    Mathproof.Problem18P36LargeGather20261004.installedState_loaded (a:=a) (b:=b) (c:=c)
      (e:=F.e) (d:=d) (sortOrder a b c) tau0
  have dimsA := (hgvars _ (by decide)).trans hdA
  have dimsB := (hgvars _ (by decide)).trans hdB
  have dimsC := (hgvars _ (by decide)).trans hdC
  have xa' : tau.vars "a" = a := (frame _ (by decide)).trans ta
  have xb' : tau.vars "b" = b := (frame _ (by decide)).trans tb
  have xc' : tau.vars "c" = c := (frame _ (by decide)).trans tc
  have xe' : tau.vars canonical.e = F.e := (frame _ (by decide)).trans te
  have xp' : tau.vars canonical.p = F.p := (frame _ (by decide)).trans tp
  have xu' : tau.vars "u" = u.toNat := (frame _ (by decide)).trans tu
  have xq' : tau.vars "q" = q := (frame _ (by decide)).trans tq
  have xmod : tau.vars canonical.modBase = 0 := (frame _ (by decide)).trans tmod
  have xtot : tau.vars Problem18IMPTensorGather20261002.total = a*b*c*F.e :=
