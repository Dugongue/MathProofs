theorem host_run {W B : Nat} (p34 bnd lrg : Com) {u q p e a b c : Nat} {rest : List Nat}
    (hN : e + a*b*c*e ≤ rest.length) (he : 0 < e) (hc : 0 < c)
    (hval : ∀ v ∈ 1 :: u :: q :: p :: e :: a :: b :: c :: rest, v < W)
    (hW : rest.length + 40 < W) (hB : B < W)
    {extS : String → Nat} {τS : Env} {TS : Nat} {r : Bool}
    (hS : Run W Mathproof.Problem18P36RoutedAssembly20261003.program
      (initEnv extS ((10 + (e + a*b*c*e)) :: ([0,u,q,p,e,a,b,c] ++
        Mathproof.Problem18IMPSourceDispatch20261001.routeWords B 0 a b c ++
        rest.take (e + a*b*c*e)))) τS TS)
    (hSout : τS.out = Mathproof.Problem18RAMAnswerCodec20261001.answerWords (some r))
    {extX : String → Nat} {τX : Env} {TX : Nat} {ans : List Nat}
    (hX : r = true → Run W (selectBranch (Mathproof.Problem18EncodedSourceCheck20261001.branch
        B a b c) p34 bnd lrg)
      (initEnv extX ((rest.length + 8) :: 1 :: u :: q :: p :: e :: a :: b :: c :: rest)) τX TX ∧
        τX.out = ans) :
    ∃ ext τ, Run W (host B p34 bnd lrg)
      (initEnv ext ((rest.length + 8) :: 1 :: u :: q :: p :: e :: a :: b :: c :: rest)) τ
      (40 * (rest.length + 10) + 700 + 7 * TS + 7 * TX) ∧
      τ.out = if r then ans else [] := by
  set N := e + a*b*c*e with hNdef
  set ws := 1 :: u :: q :: p :: e :: a :: b :: c :: rest with hws
  have hwl : ws.length = rest.length + 8 := by simp [ws]
  let base : String → Nat := fun y =>
    if y = qA then rest.length + 9 else if y = sA then 11 + N else if y = soA then 1 else 0
  let ext := mkExt base extS extX extX extX
  have eqA : ext qA = ws.length + 1 := by
    show mkExt base extS extX extX extX ("P37#" ++ "q") = _
    rw [mkExt_host]; simp [base, qA, hwl]
  have esA : ext sA = 11 + N := by
    show mkExt base extS extX extX extX ("P37#" ++ "s") = _
    rw [mkExt_host]; simp [base, qA, sA]
  have esoA : ext soA = 1 := by
    show mkExt base extS extX extX extX ("P37#" ++ "so") = _
    rw [mkExt_host]; simp [base, qA, sA, soA]
  obtain ⟨σ1, r1, hq1, hinp1, hout1, hv1, ha1⟩ := parse_run (W := W) ext ws eqA
    (by rw [hwl]; omega) hval
  rw [hwl] at r1 hq1
  have hval' : ∀ v ∈ (rest.length + 8) :: 1 :: u :: q :: p :: e :: a :: b :: c :: rest, v < W := by
    intro v hv; rcases List.mem_cons.mp hv with rfl | hv
    · omega
    · exact hval v hv
  have hhost1 : ∀ y, (∀ s, y ≠ "P37#" ++ s) → σ1.vars y = 0 ∧ σ1.arrs y = List.replicate (ext y) 0 :=
    fun y hy => ⟨hv1 y (hy "i") (hy "x") (hy "L"), ha1 y (hy "q")⟩
  have hs1 : σ1.arrs sA = List.replicate (11 + N) 0 := by rw [ha1 sA (by decide), esA]
  obtain ⟨σ2, r2, hs2, hq2, hinp2, hout2, hfr2⟩ := build_run (W := W) (B := B)
    (fun y => ext (pre "R" y)) hq1 hs1 hval' (by omega) hN he hc hB
    (fun y => (hhost1 _ (fun s => pre_ne_host "R" y s)).1)
    (fun y => (hhost1 _ (fun s => pre_ne_host "R" y s)).2)
    (hv1 _ (by decide) (by decide) (by decide))
  have hclean2 : ∀ y, (∀ s, y ≠ "P37#" ++ s) → (∀ z, y ≠ pre "R" z) →
      σ2.vars y = 0 ∧ σ2.arrs y = List.replicate (ext y) 0 := by
    intro y hy hR
    obtain ⟨h1, h2⟩ := hfr2 y (hy "s") (hy "i") (hy "n") (hy "pr") (hy "rin") hR
    rw [h1, h2]; exact hhost1 y hy
  have hhost2 : ∀ s, s ≠ "s" → s ≠ "i" → s ≠ "n" → s ≠ "pr" → s ≠ "rin" → s ≠ "x" → s ≠ "L" →
      s ≠ "q" → σ2.vars ("P37#" ++ s) = 0 ∧ σ2.arrs ("P37#" ++ s) =
        List.replicate (ext ("P37#" ++ s)) 0 := by
    intro s h1 h2 h3 h4 h5 h6 h7 h8
    have hne : ∀ t, t ≠ s → "P37#" ++ s ≠ "P37#" ++ t := by
      intro t ht h; apply ht
      have := congrArg String.toList h
      simp only [String.toList_append, List.append_cancel_left_eq] at this
      exact (String.toList_inj.mp this).symm
    obtain ⟨g1, g2⟩ := hfr2 ("P37#" ++ s) (hne "s" (Ne.symm h1)) (hne "i" (Ne.symm h2))
      (hne "n" (Ne.symm h3)) (hne "pr" (Ne.symm h4)) (hne "rin" (Ne.symm h5))
      (fun z => host_not_pre s "R" z)
    rw [g1, g2]
    exact ⟨hv1 _ (hne "i" (Ne.symm h2)) (hne "x" (Ne.symm h6)) (hne "L" (Ne.symm h7)),
      ha1 _ (hne "q" (Ne.symm h8))⟩
  have hroute := Mathproof.Problem18IMPSourceDispatch20261001.routeWords_source B a b c
  have hord := Mathproof.Problem18IMPSourceDispatch20261001.orderCode_lt
    (Problem18TensorSorting20261001.sortOrder a b c)
  have hbr := Mathproof.Problem18EncodedSourceCheck20261001.branch_range B a b c
  have hNr : (rest.take N).length = N := by simp; omega
  have hrestW : ∀ v ∈ rest, v < W := fun v hv => hval v (by simp [ws, hv])
  have hmemT : ∀ v ∈ rest.take N, v < W := fun v hv => hrestW v (List.mem_of_mem_take hv)
  have hsoA2 : σ2.arrs soA = [0] := by
    show σ2.arrs ("P37#" ++ "so") = [0]
    rw [(hhost2 "so" (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide)).2]
    show List.replicate (ext soA) 0 = [0]; rw [esoA]; rfl
  have hm : ∀ v ∈ ws, v < W := hval
  have hvu := hm u (by simp [ws]); have hvq := hm q (by simp [ws])
  have hvp := hm p (by simp [ws]); have hve := hm e (by simp [ws])
  have hva := hm a (by simp [ws]); have hvb := hm b (by simp [ws]); have hvc := hm c (by simp [ws])
  obtain ⟨σ3, r3, inv3, fr3⟩ := iso_run fresh_IS hS σ2 [] [0]
    (fun x => (hclean2 (pre "S" x) (pre_ne_host "S" x) (fun z => pre_R_ne_S x z)).1)
    (fun x => by
      show σ2.arrs (pre "S" x) = _
      rw [(hclean2 (pre "S" x) (pre_ne_host "S" x) (fun z => pre_R_ne_S x z)).2]
      show List.replicate (mkExt base extS extX extX extX (pre "S" x)) 0 = _
      rw [mkExt_S])
    ((hhost2 "ps" (by decide) (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide)).1)
    ⟨[], by show σ2.arrs sA = _; rw [hs2]; simp [hroute, hNdef]⟩
    (by show (σ2.arrs sA).length < W; rw [hs2]; simp [hroute]; omega)
    (by
      show ∀ v ∈ σ2.arrs sA, v < W
      rw [hs2]; intro v hv
      simp only [hroute, List.mem_cons, List.mem_append, List.mem_nil_iff, or_false] at hv
      rcases hv with h | h | h | h | h | h | h | h | h | (h | h) | h
      all_goals first | (subst h; omega) | exact hmemT v h)
    (fun h => by simp [IS] at h)
    (fun _ => (hhost2 "pso" (by decide) (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by decide)).1)
    (fun _ => by simp)
    (fun _ => by show (σ2.arrs soA).length = _; rw [hsoA2])
    (fun _ => by simp; omega)
    (fun _ => by show (σ2.arrs soA).drop 0 = _; rw [hsoA2]; rfl)
    (fun _ => by rw [hSout, answerWords_some]; simp)
  have hptr3 := inv3.outPtr rfl
  have harr3 := inv3.outArr rfl
  have hlen3 := inv3.outLen rfl
  simp only [IS] at hptr3 harr3 hlen3
  rw [hSout, answerWords_some] at hptr3 harr3
  simp at hptr3 harr3 hlen3
  have hso3 : σ3.arrs soA = [if r then 1 else 0] := by
    rw [hptr3] at harr3
    rw [← harr3, List.take_of_length_le (by omega)]
  have hsA3 : σ3.arrs sA = σ2.arrs sA :=
    fr3.arrs sA (fun z => host_not_pre "s" "S" z) (by decide)
  have hqA3 : σ3.arrs qA = σ2.arrs qA :=
    fr3.arrs qA (fun z => host_not_pre "q" "S" z) (by decide)
  have hout3 : σ3.out = [] := by
    rw [fr3.out rfl, hout2, hout1]
  have h10 : (σ3.arrs sA)[10]? =
      some (Mathproof.Problem18EncodedSourceCheck20261001.branch B a b c) := by
    rw [hsA3, hs2]; simp [hroute]
  have hrun3 : Run W (.seq parse (.seq (build B) check)) (initEnv ext ((rest.length + 8) :: ws))
      σ3 (20 * (rest.length + 8 + 2) + (20 * (rest.length + 2) + 500 + 7 * TS)) :=
    r1.seq (r2.seq r3)
  cases r with
  | false =>
      have hd := dispatch_false (W := W) p34 bnd lrg (σ := σ3) (by simpa using hso3) (by omega)
      refine ⟨ext, σ3, ?_, by simpa using hout3⟩
      have := r1.seq (r2.seq (r3.seq hd))
      exact this.mono (by omega)
  | true =>
      obtain ⟨hXr, hXo⟩ := hX rfl
      set k := Mathproof.Problem18EncodedSourceCheck20261001.branch B a b c with hk
      have hpins : ∀ s ∈ ["pP", "pB", "pL"], σ3.vars ("P37#" ++ s) = 0 := by
        intro s hs
        have hne : ∀ t, t ≠ s → "P37#" ++ s ≠ "P37#" ++ t := by
          intro t ht h; apply ht
          have := congrArg String.toList h
          simp only [String.toList_append, List.append_cancel_left_eq] at this
          exact (String.toList_inj.mp this).symm
        simp only [List.mem_cons, List.mem_nil_iff, or_false] at hs
        have hS1 : ∀ z, "P37#" ++ s ≠ pre "S" z := fun z => host_not_pre s "S" z
        rw [fr3.vars _ hS1 (hne "ps" (by rcases hs with rfl | rfl | rfl <;> decide))
          (hne "pso" (by rcases hs with rfl | rfl | rfl <;> decide))]
        rcases hs with rfl | rfl | rfl
        · exact (hhost2 "pP" (by decide) (by decide) (by decide) (by decide) (by decide)
            (by decide) (by decide) (by decide)).1
        · exact (hhost2 "pB" (by decide) (by decide) (by decide) (by decide) (by decide)
            (by decide) (by decide) (by decide)).1
        · exact (hhost2 "pL" (by decide) (by decide) (by decide) (by decide) (by decide)
            (by decide) (by decide) (by decide)).1
      have hcleanX : ∀ x, σ3.vars (pre (tagOf k) x) = 0 ∧
          σ3.arrs (pre (tagOf k) x) = List.replicate (extX x) 0 := by
        intro x
        have hS1 : ∀ z, pre (tagOf k) x ≠ pre "S" z := fun z => tagOf_ne_S k x z
        have g := hclean2 (pre (tagOf k) x) (pre_ne_host _ x) (fun z => tagOf_ne_R k x z)
        refine ⟨?_, ?_⟩
        · rw [fr3.vars _ hS1 (pre_ne_host _ x "ps") (pre_ne_host _ x "pso")]; exact g.1
        · rw [fr3.arrs _ hS1 (pre_ne_host _ x "so"), g.2]
