  have horder : (n : ℤ)+(q : ℤ)*d < (q : ℤ)*e := by nlinarith
  rw [map_mul,map_mul,map_pow,map_pow,hs,ht]
  calc
    v a * (WithZero.exp d)^q ≤ WithZero.exp (n : ℤ)*(WithZero.exp d)^q :=
      mul_le_mul_of_nonneg_right ha zero_le
    _ = WithZero.exp ((n : ℤ)+(q : ℤ)*d) := by
      rw [← WithZero.exp_nsmul,← WithZero.exp_add,nsmul_eq_mul]
    _ < WithZero.exp ((q : ℤ)*e) := WithZero.exp_lt_exp.mpr horder
