    have hn:=ht.fixed sizeReg (by simp [controls])
    have hc:=ht.fixed basisCount (by simp [controls])
    have hm:=ht.fixed generatorCount (by simp [controls])
    have hg:=ht.fixed generatorBase (by simp [controls])
