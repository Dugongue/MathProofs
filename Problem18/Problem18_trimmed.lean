    (.seq (rowsZeroCom M q cn zn rs n d)
      (.seq (.ite (.eq (.var zn.z) (.lit 1)) (.assign sn.ans (.lit 1)) .skip)
        (.assign sn.c (.bin .add (.var sn.c) (.lit 1)))))
def smallBodyCost (n d R e : ℕ) : ℕ := digitsSlotsCost n e + rowsZeroCost M n d R + 10
