  have h1 : 1 ≤ N^4 := Nat.one_le_pow _ _ hN
  have h40 : N^4 ≤ N^40 := Nat.pow_le_pow_right hN (by norm_num)
  have : 3 + (1000 + 12 + 210*(a*b*c*F.e+1)) ≤ 2000*N^40 := by omega
  exact this.trans (Nat.mul_le_mul_right _ (by norm_num))
