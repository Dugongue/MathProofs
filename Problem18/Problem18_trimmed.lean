    (haH : a ∉ H) (hbH : b ∉ H) :
    ∃ Q : V ≃ₗ[K] V,
      (∀ x y, B (Q x) (Q y) = B x y) ∧ Q a = b ∧
      ∀ h : H, Q h.val = h.val := by
