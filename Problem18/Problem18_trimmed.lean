noncomputable section
variable {K P V : Type} [Field K] [Fintype K] {q : Nat}
abbrev Params (P : Type) :=Fin 2 ⊕ (Fin 2 × P)
abbrev Pair (P V : Type) :=PolyExpr (Params P ⊕ (Fin 2 × V)) Int × PolyExpr (Params P ⊕ (Fin 2 × V)) Int
def specialize (z : P→K) : StarExpr (P ⊕ V) Int→StarExpr V K
  | .const c=>.const c
  | .var (.inl i)=>.const (z i)
  | .var (.inr i)=>.var i
  | .add a b=>.add (specialize z a) (specialize z b)
  | .mul a b=>.mul (specialize z a) (specialize z b)
  | .conj a=>.conj (specialize z a)
def compile : StarExpr (P ⊕ V) Int→Pair P V
  | .const c=>(.const c,.const 0)
  | .var (.inl i)=>(.var (.inl (.inr (0,i))),.var (.inl (.inr (1,i))))
  | .var (.inr i)=>(.var (.inr (0,i)),.var (.inr (1,i)))
  | .add a b=>let u:=compile a;let v:=compile b;(.add u.1 v.1,.add u.2 v.2)
  | .mul a b=>let u:=compile a;let v:=compile b
    (.add (.mul u.1 v.1) (.mul (.mul (.var (.inl (.inl 0))) u.2) v.2),
      .add (.add (.mul u.1 v.2) (.mul u.2 v.1)) (.mul (.mul (.var (.inl (.inl 1))) u.2) v.2))
  | .conj a=>let u:=compile a
    (.add u.1 (.mul (.var (.inl (.inl 1))) u.2),PolyExpr.neg u.2)
def values (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) (z : P→K) : Params P→fixedField d.automorphism :=
  Sum.elim (fun i=>Fin.cases (rootNegNorm F d) (fun _=>rootTrace F d) i)
    (fun i=>Fin.cases (rootCoordinates F d (z i.2)).1 (fun _=>(rootCoordinates F d (z i.2)).2) i.1)
def evaluate (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) (z : P→K)
    (x : V→K) (p : Pair P V) :=
  (interpret (Int.castRingHom (fixedField d.automorphism))
      (Sum.elim (values F d z) (coordinateAssignment F d x)) p.1,
   interpret (Int.castRingHom (fixedField d.automorphism))
      (Sum.elim (values F d z) (coordinateAssignment F d x)) p.2)
theorem coordinates_int (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) (c : Int) :
    rootCoordinates F d (c:K)=((c:fixedField d.automorphism),0) := by
  apply Prod.ext <;> apply Subtype.ext
  all_goals simp [rootCoordinates,coordinateEquiv,coordinates,coefficientA,coefficientB]
theorem correct (F : FieldPresentation K) (d : UnitaryFieldData (K:=K) q) (z : P→K)
    (x : V→K) (p : StarExpr (P ⊕ V) Int) :
    evaluate F d z x (compile p)=rootCoordinates F d ((specialize z p).eval d x) := by
  induction p with
  | const c=>simp [compile,evaluate,interpret,specialize,StarExpr.eval,coordinates_int]
  | var i=>cases i <;> rfl
  | add a b iha ihb=>
    rw [specialize,StarExpr.eval,rootCoordinates_add,←iha,←ihb]
    rfl
  | mul a b iha ihb=>
    rw [specialize,StarExpr.eval,coordinates_mul,←iha,←ihb]
    rfl
  | conj a iha=>
    rw [specialize,StarExpr.eval,coordinates_conjugate,←iha]
    simp [compile,evaluate,interpret,PolyExpr.neg,coordinateConj,values]
    left; rfl
end
end Mathproof.Problem18P34Frontend20261003StarTemplates
