universe u v w
variable {F : Type u} {E : Type v} {U : Type w}
  [Field F] [Field E] [Algebra F E]
  [FiniteDimensional F E] [Algebra.IsSeparable F E]
  [AddCommGroup U] [Module F U] [Module E U] [IsScalarTower F E U]
  {τ : F →+* F}
def rightTraceFunctional (B : U →ₛₗ[τ] U →ₗ[F] F) (u v : U) : Module.Dual F E where
  toFun a := B u (a • v)
  map_add' a b := by simp [add_smul]
  map_smul' c a := by simp [smul_assoc]
noncomputable def twistedTraceValue (B : U →ₛₗ[τ] U →ₗ[F] F) (u v : U) : E :=
  ((Algebra.traceForm F E).toDual (traceForm_nondegenerate F E)).symm
    (rightTraceFunctional B u v)
theorem traceForm_twistedTraceValue (B : U →ₛₗ[τ] U →ₗ[F] F) (u v : U) (a : E) :
    Algebra.traceForm F E (twistedTraceValue (E := E) B u v) a = B u (a • v) := by
  exact LinearMap.BilinForm.apply_toDual_symm_apply (rightTraceFunctional B u v) a
theorem trace_value_ext {x y : E}
    (h : ∀ a : E, Algebra.traceForm F E x a = Algebra.traceForm F E y a) : x = y := by
  apply ((Algebra.traceForm F E).toDual (traceForm_nondegenerate F E)).injective
  exact LinearMap.ext h
private theorem twistedTraceValue_add_left (B : U →ₛₗ[τ] U →ₗ[F] F) (u₁ u₂ v : U) :
    twistedTraceValue (E := E) B (u₁ + u₂) v =
      twistedTraceValue (E := E) B u₁ v + twistedTraceValue (E := E) B u₂ v := by
  apply trace_value_ext (F := F)
  intro a
  simp only [map_add, LinearMap.add_apply, traceForm_twistedTraceValue]
private theorem twistedTraceValue_add_right (B : U →ₛₗ[τ] U →ₗ[F] F) (u v₁ v₂ : U) :
    twistedTraceValue (E := E) B u (v₁ + v₂) =
      twistedTraceValue (E := E) B u v₁ + twistedTraceValue (E := E) B u v₂ := by
  apply trace_value_ext (F := F)
  intro a
  simp only [map_add, LinearMap.add_apply, traceForm_twistedTraceValue, smul_add]
private theorem twistedTraceValue_smul_right (B : U →ₛₗ[τ] U →ₗ[F] F)
    (c : E) (u v : U) :
    twistedTraceValue (E := E) B u (c • v) = c * twistedTraceValue (E := E) B u v := by
  apply trace_value_ext (F := F)
  intro a
  calc
    Algebra.traceForm F E (twistedTraceValue (E := E) B u (c • v)) a =
        B u ((a * c) • v) := by rw [traceForm_twistedTraceValue, smul_smul]
    _ = Algebra.traceForm F E (twistedTraceValue (E := E) B u v) (a * c) :=
      (traceForm_twistedTraceValue B u v (a * c)).symm
    _ = Algebra.traceForm F E (c * twistedTraceValue (E := E) B u v) a := by
      simp only [Algebra.traceForm_apply]
      congr 1
      ring
private theorem twistedTraceValue_smul_left (σ : E →+* E)
    (B : U →ₛₗ[τ] U →ₗ[F] F)
    (hbalance : ∀ (a : E) (u v : U), B (a • u) v = B u (σ a • v))
    (c : E) (u v : U) :
    twistedTraceValue (E := E) B (c • u) v = σ c * twistedTraceValue (E := E) B u v := by
  apply trace_value_ext (F := F)
  intro a
  calc
    Algebra.traceForm F E (twistedTraceValue (E := E) B (c • u) v) a =
        B (c • u) (a • v) := traceForm_twistedTraceValue B (c • u) v a
    _ = B u (σ c • (a • v)) := hbalance c u (a • v)
    _ = B u ((σ c * a) • v) := by rw [smul_smul]
    _ = Algebra.traceForm F E (twistedTraceValue (E := E) B u v) (σ c * a) :=
      (traceForm_twistedTraceValue B u v (σ c * a)).symm
    _ = Algebra.traceForm F E (σ c * twistedTraceValue (E := E) B u v) a := by
      simp only [Algebra.traceForm_apply]
      congr 1
      ring
noncomputable def twistedTraceForm (σ : E →+* E) (B : U →ₛₗ[τ] U →ₗ[F] F)
    (hbalance : ∀ (a : E) (u v : U), B (a • u) v = B u (σ a • v)) :
    U →ₛₗ[σ] U →ₗ[E] E :=
  LinearMap.mk₂'ₛₗ σ (RingHom.id E) (twistedTraceValue (E := E) B)
    (twistedTraceValue_add_left B)
    (by intro c u v; simpa only [smul_eq_mul] using twistedTraceValue_smul_left σ B hbalance c u v)
    (twistedTraceValue_add_right B)
    (by intro c u v; simpa only [RingHom.id_apply, smul_eq_mul] using twistedTraceValue_smul_right B c u v)
theorem traceForm_twistedTraceForm (σ : E →+* E) (B : U →ₛₗ[τ] U →ₗ[F] F)
    (hbalance : ∀ (a : E) (u v : U), B (a • u) v = B u (σ a • v))
    (u v : U) (a : E) :
    Algebra.traceForm F E (twistedTraceForm σ B hbalance u v) a = B u (a • v) :=
  traceForm_twistedTraceValue B u v a
theorem trace_twistedTraceForm (σ : E →+* E) (B : U →ₛₗ[τ] U →ₗ[F] F)
    (hbalance : ∀ (a : E) (u v : U), B (a • u) v = B u (σ a • v)) (u v : U) :
    Algebra.trace F E (twistedTraceForm σ B hbalance u v) = B u v := by
  simpa [Algebra.traceForm_apply] using traceForm_twistedTraceForm σ B hbalance u v 1
theorem twistedTraceForm_injective (σ : E →+* E)
    {B C : U →ₛₗ[τ] U →ₗ[F] F}
    (hB : ∀ (a : E) (u v : U), B (a • u) v = B u (σ a • v))
    (hC : ∀ (a : E) (u v : U), C (a • u) v = C u (σ a • v))
    (heq : twistedTraceForm σ B hB = twistedTraceForm σ C hC) : B = C := by
  ext u v
  rw [← trace_twistedTraceForm σ B hB, ← trace_twistedTraceForm σ C hC, heq]
end Mathproof.Problem18TwistedTraceLift20260930
