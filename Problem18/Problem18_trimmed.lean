  obtain ⟨L,hL,hd,hLH,hLT⟩ := hs
  obtain ⟨W,hW,hWL,hWH,hWT,hgeom⟩ :=
    exists_minimal_dichotomy (RingHom.id K) B H T hH hT L hL hLH hLT
  refine ⟨W,hW,?_,hWH,hWT,hgeom⟩
  have := Submodule.finrank_mono hWL
  omega
