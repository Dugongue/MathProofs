theorem adjoin_top_of_transpose {K : Type} [Field K] {n m : Nat}
    (S : Fin m → Matrix (Fin n) (Fin n) K)
    (h : Algebra.adjoin K (Set.range (fun i => (S i).transpose)) = ⊤) :
    Algebra.adjoin K (Set.range S) = ⊤ := by
  let A := Algebra.adjoin K (Set.range S)
  let T : Subalgebra K (Matrix (Fin n) (Fin n) K) :=
    { carrier := {x | x.transpose ∈ A}
      mul_mem' := by
        intro x y hx hy
        simp only [Set.mem_setOf_eq, Matrix.transpose_mul] at hx hy ⊢
        exact A.mul_mem hy hx
      add_mem' := by
        intro x y hx hy
        simp only [Set.mem_setOf_eq, Matrix.transpose_add] at hx hy ⊢
        exact A.add_mem hx hy
      algebraMap_mem' := by
        intro r
        simp only [Set.mem_setOf_eq]
        rw [Algebra.algebraMap_eq_smul_one, Matrix.transpose_smul, Matrix.transpose_one]
        exact A.smul_mem A.one_mem r }
  have hle : Algebra.adjoin K (Set.range (fun i => (S i).transpose)) ≤ T := by
    apply Algebra.adjoin_le
    rintro x ⟨i, rfl⟩
    show (S i).transpose.transpose ∈ A
    rw [Matrix.transpose_transpose]
    exact Algebra.subset_adjoin ⟨i, rfl⟩
  rw [h] at hle
  rw [eq_top_iff]
  intro y _
  have hy : y.transpose ∈ T := hle Algebra.mem_top
  have hy' : y.transpose.transpose ∈ A := hy
  rwa [Matrix.transpose_transpose] at hy'
theorem adjoin_transpose_top_iff {K : Type} [Field K] {n m : Nat}
    (S : Fin m → Matrix (Fin n) (Fin n) K) :
    Algebra.adjoin K (Set.range (fun i => (S i).transpose)) = ⊤ ↔
      Algebra.adjoin K (Set.range S) = ⊤ := by
  constructor
  · exact adjoin_top_of_transpose S
  · intro h
    apply adjoin_top_of_transpose (fun i => (S i).transpose)
    simpa [Matrix.transpose_transpose] using h
