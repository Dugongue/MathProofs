    (hs : Slots F canonical ws S B σ) : Good F L S B σ σ :=
  ⟨hv,hs,rfl,rfl,fun _ _ => rfl,fun _ _ => rfl,fun _ _ _ => rfl,fun _ => rfl,rfl,rfl⟩
def programCost (E n s : Nat) : Nat :=
  copyCost E n+(31*(n*n*E)+8)+((4+bodyCost E n)*s+4)
theorem input_outside {L : Layout} {S : Nat} (hok : L.Ok S) (W E k : Nat)
    (hk : k<L.n*L.n*E) : Outside L W E (W+L.input*E+k) := by
