theorem odd_squarefree_operator_card (hodd : ringChar K≠2)
    (hm : ∀ i,(g i).Monic) (hcop : Pairwise (fun i j => IsCoprime (g i) (g j)))
    (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hnB : B.Nondegenerate)
