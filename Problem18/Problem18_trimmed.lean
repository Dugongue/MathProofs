  .bin .add (.lit p.offset) (.bin .mul (.lit p.slope) (.var cv))
theorem eval {B c : Nat} (p : Affine) (cv : String) (σ : Env)
    (hc : σ.vars cv=c) (hpos : 0 < c) (hcb : c < B) (hb : p.value c < B) :
    (p.expr cv).evalB B σ=some (p.value c) := by
  have hv:p.offset+p.slope*c < B:=hb
  have hp:p.slope < B:=(Nat.le_mul_of_pos_right _ hpos).trans_lt (by omega : p.slope*c < B)
  have he:(Expr.var cv).evalB B σ=some c:=by
    simpa only [hc] using evalB_var (σ:=σ) (x:=cv) (by rw [hc];exact hcb)
  exact evalB_bin (op:=Bop.add) (evalB_lit (by omega))
    (evalB_bin (op:=Bop.mul) (evalB_lit hp) he (by change p.slope*c < B;omega)) hb
theorem noVar (p : Affine) (cv x : String) (hx : x≠cv) : NoVar x (p.expr cv) := by
  simp [expr,NoVar,Ne.symm hx]
end Affine
def address (R m : Nat) (k : Fin 11) : Affine :=
  let b : Affine:=⟨R+inStart m 0+5+m+m*m,m+(1+m)⟩
  let v : Affine:=⟨R+inStart m 0+(m+1)*(5+m+m*m),m+(m+1)*(1+m)⟩
  let t:=v.bump (m*m)
  let a:=t.add ⟨0,m⟩
  let g:=a.add ⟨0,m⟩
  let w:=g.bump (m*m)
  let t':=w.bump 3
  let a':=t'.add ⟨0,m⟩
  let g':=a'.add ⟨0,m⟩
  let w':=g'.bump (m*m)
  ![b,v,t,a,g,w,t',a',g',w',w'.bump 3] k
def location (r c m : Nat) : Fin 11 → Nat
  | 0=>banks r c m | 1=>kernel r c m | 2=>transpose r c m
  | 3=>target r c m | 4=>targetGram r c m | 5=>targetWork r c m
  | 6=>sourceTranspose r c m | 7=>source r c m | 8=>sourceGram r c m
  | 9=>sourceWork r c m | 10=>Problem18P34AssemblyMatrixLayout20261003.capacity r c m
theorem correct (R m c : Nat) (k : Fin 11) :
    (address R m k).value c=location (base R c m) c m k := by
  fin_cases k <;> simp [address,location,Affine.value,Affine.add,Affine.bump,
    banks,kernel,transpose,target,targetGram,targetWork,sourceTranspose,source,sourceGram,sourceWork,
    Problem18P34AssemblyMatrixLayout20261003.capacity,base,inStart,rowStart] <;> ring
def raw (R m : Nat) (cv : String) (k : Fin 11) : Expr :=
  .bin .add (.var Problem18P34AssemblyMatrixGramSetup20261003.ws)
    (.bin .mul ((address R m k).expr cv) (.var canonical.e))
