  degree_pos := by rw [h.degree]; exact F.degree_pos
  arithmetic_word := arith F h
  memory_word := h.memory_word
  modulus_word := h.memory_word
  scratch_word := h.scratch_word
  scratch_fit := by rw [h.degree]; have := h.scratch_fit; omega
  first_fit := by rw [h.degree]; exact h.first_fit
  second_fit := by rw [h.degree]; exact h.second_fit
  modulus_fit := by rw [h.degree]; have := h.modulus_fit; omega
  output_fit := by rw [h.degree]; exact h.output_fit
  first_separate := Or.inl canonical_mem_ne_scratch
  second_separate := Or.inl canonical_mem_ne_scratch
  modulus_separate := Or.inl canonical_mem_ne_scratch
  output_separate := Or.inl canonical_mem_ne_scratch
  coefficients := fun j hj => ⟨coeffA F h j hj, coeffB F h j hj, coeffMod F h j hj⟩
