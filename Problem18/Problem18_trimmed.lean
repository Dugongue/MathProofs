variable {K : Type} [Field K] [Fintype K] {F : FieldPresentation K} {r : FieldNames}
def stStart (N s : ℕ) : ℕ := rowStart N N + s * N
def inStart (N t : ℕ) : ℕ := rowStart N N + N * N + t * N
def nn (q : RNames) : Expr := .bin .mul (.var q.N) (.var q.N)
def stBase (q : RNames) (se : Expr) : Expr :=
  plus (plus (plus (.lit 5) (.var q.N)) (nn q)) (.bin .mul se (.var q.N))
def inBase (q : RNames) (te : Expr) : Expr :=
  plus (plus (plus (plus (.lit 5) (.var q.N)) (nn q)) (nn q)) (.bin .mul te (.var q.N))
theorem evalB_stBase {B : ℕ} {σ : Env} (q : RNames) {se : Expr} {sv Nv : ℕ}
    (hs : se.evalB B σ = some sv) (hN : σ.vars q.N = Nv) (hlt : stStart Nv sv < B) :
    (stBase q se).evalB B σ = some (stStart Nv sv) := by
  unfold stBase plus nn stStart rowStart at *
  have hNv : (Expr.var q.N).evalB B σ = some Nv := by
    rw [← hN]; exact evalB_var (by rw [hN]; nlinarith)
  have h1 : (Expr.bin .add (.lit 5) (.var q.N)).evalB B σ = some (5 + Nv) :=
    evalB_bin (evalB_lit (by omega)) hNv (by change 5 + Nv < B; nlinarith)
  have h2 : (Expr.bin .mul (.var q.N) (.var q.N)).evalB B σ = some (Nv * Nv) :=
    evalB_bin hNv hNv (by change Nv * Nv < B; nlinarith)
  have h3 : (Expr.bin .add (Expr.bin .add (.lit 5) (.var q.N))
      (Expr.bin .mul (.var q.N) (.var q.N))).evalB B σ = some (5 + Nv + Nv * Nv) :=
    evalB_bin h1 h2 (by change 5 + Nv + Nv * Nv < B; nlinarith)
  have h4 : (Expr.bin .mul se (.var q.N)).evalB B σ = some (sv * Nv) :=
    evalB_bin hs hNv (by change sv * Nv < B; nlinarith)
  exact evalB_bin h3 h4 (by change 5 + Nv + Nv * Nv + sv * Nv < B; nlinarith)
theorem evalB_inBase {B : ℕ} {σ : Env} (q : RNames) {te : Expr} {tv Nv : ℕ}
    (ht : te.evalB B σ = some tv) (hN : σ.vars q.N = Nv) (hlt : inStart Nv tv < B) :
    (inBase q te).evalB B σ = some (inStart Nv tv) := by
  unfold inBase plus nn inStart rowStart at *
  have hNv : (Expr.var q.N).evalB B σ = some Nv := by
    rw [← hN]; exact evalB_var (by rw [hN]; nlinarith)
  have h1 : (Expr.bin .add (.lit 5) (.var q.N)).evalB B σ = some (5 + Nv) :=
    evalB_bin (evalB_lit (by omega)) hNv (by change 5 + Nv < B; nlinarith)
  have h2 : (Expr.bin .mul (.var q.N) (.var q.N)).evalB B σ = some (Nv * Nv) :=
    evalB_bin hNv hNv (by change Nv * Nv < B; nlinarith)
  have h3 : (Expr.bin .add (Expr.bin .add (.lit 5) (.var q.N))
      (Expr.bin .mul (.var q.N) (.var q.N))).evalB B σ = some (5 + Nv + Nv * Nv) :=
    evalB_bin h1 h2 (by change 5 + Nv + Nv * Nv < B; nlinarith)
  have h3' : (Expr.bin .add (Expr.bin .add (Expr.bin .add (.lit 5) (.var q.N))
      (Expr.bin .mul (.var q.N) (.var q.N))) (Expr.bin .mul (.var q.N) (.var q.N))).evalB B σ =
      some (5 + Nv + Nv * Nv + Nv * Nv) :=
    evalB_bin h3 h2 (by change 5 + Nv + Nv * Nv + Nv * Nv < B; nlinarith)
  have h4 : (Expr.bin .mul te (.var q.N)).evalB B σ = some (tv * Nv) :=
    evalB_bin ht hNv (by change tv * Nv < B; nlinarith)
  exact evalB_bin h3' h4 (by change 5 + Nv + Nv * Nv + Nv * Nv + tv * Nv < B; nlinarith)
def revIdx (q : RNames) (cc : String) : Expr :=
  .bin .sub (.bin .sub (.var cc) (.lit 1)) (.var q.u)
def loadBody (M : FieldMacros F r) (q : RNames) (cc : String) : Com :=
  .seq (copyLoop M q (rowBase q (.var q.u)) (stBase q (revIdx q cc)))
    (.assign q.u (plus (.var q.u) (.lit 1)))
def loadChosen (M : FieldMacros F r) (q : RNames) (cc : String) : Com :=
  .seq (.assign q.u (.lit 0)) (.while (.lt (.var q.u) (.var cc)) (loadBody M q cc))
def loadStep (M : FieldMacros F r) (q : RNames) (cc : String) (Nv : ℕ) : ℕ :=
  copyCost M (rowBase q (.var q.u)) (stBase q (revIdx q cc)) Nv + 4
def loadCost (M : FieldMacros F r) (q : RNames) (cc : String) (Nv ccv : ℕ) : ℕ :=
  2 + (4 + loadStep M q cc Nv) * ccv + 4
theorem stStart_ge (N s : ℕ) : rowStart N N ≤ stStart N s := by unfold stStart; omega
theorem load_run (M : FieldMacros F r) (q : RNames) (hq : q.Valid r) (cc : String)
    (hcS : cc ∉ regNames r) (hcj : cc ≠ q.j) (hcu : cc ≠ q.u) (hcW : cc ≠ q.WS)
    {B Sn : ℕ} {σ : Env} (hS : Slots F r q.WS Sn B σ) {Nv ccv : ℕ} (hN : σ.vars q.N = Nv)
    (hcc : σ.vars cc = ccv) (hcN : ccv ≤ Nv) (hfit : stStart Nv Nv ≤ Sn) :
    ∃ τ, Run B (loadChosen M q cc) σ τ (loadCost M q cc Nv ccv) ∧ Slots F r q.WS Sn B τ ∧
      (∀ u < ccv, ∀ k < Nv, val F r q.WS τ (rowStart Nv u + k) =
        val F r q.WS σ (stStart Nv (ccv - 1 - u) + k)) ∧
      (∀ s < Sn, (s < rowStart Nv 0 ∨ rowStart Nv ccv ≤ s) → val F r q.WS τ s = val F r q.WS σ s) ∧
      (∀ x, x ∉ regNames r → x ≠ q.u → x ≠ q.j → τ.vars x = σ.vars x) ∧
      (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧
      τ.out = σ.out := by
  have hSB := hS.slots_word
  have huS : q.u ∉ regNames r := hq.2 _ (by simp [RNames.list])
  have huW : q.u ≠ q.WS := hq.ne_of (by intro h; simp [RNames.list, h])
  have huj : q.u ≠ q.j := hq.ne_of (by intro h; simp [RNames.list, h])
  have hNu : q.N ≠ q.u := hq.ne_of (by intro h; simp [RNames.list, h])
  have hNj : q.N ≠ q.j := hq.ne_of (by intro h; simp [RNames.list, h])
  have hNS : q.N ∉ regNames r := hq.2 _ q.N_mem
  have hrN : rowStart Nv Nv ≤ Sn := (stStart_ge Nv Nv).trans hfit
  have hNB : stStart Nv Nv < B := by omega
  have hNB2 : Nv < B := by have := hNB; unfold stStart rowStart at this; omega
  have hccB : ccv < B := by omega
  let l : List String := [q.N, q.u, cc]
  have hl : ∀ x ∈ l, x ∉ regNames r ∧ x ≠ q.j := by
    intro x hx
    simp only [l, List.mem_cons, List.not_mem_nil, or_false] at hx
    rcases hx with rfl | rfl | rfl
    · exact ⟨hNS, hNj⟩
    · exact ⟨huS, huj⟩
    · exact ⟨hcS, hcj⟩
  have hNl : q.N ∈ l := by simp [l]
  have hul : q.u ∈ l := by simp [l]
  have hcl : cc ∈ l := by simp [l]
  let J : Env → Prop := fun τ =>
    Slots F r q.WS Sn B τ ∧ τ.vars q.u ≤ ccv ∧
    (∀ x, x ∉ regNames r → x ≠ q.u → x ≠ q.j → τ.vars x = σ.vars x) ∧
    (∀ u < τ.vars q.u, ∀ k < Nv, val F r q.WS τ (rowStart Nv u + k) =
      val F r q.WS σ (stStart Nv (ccv - 1 - u) + k)) ∧
    (∀ s < Sn, (s < rowStart Nv 0 ∨ rowStart Nv (τ.vars q.u) ≤ s) →
      val F r q.WS τ s = val F r q.WS σ s) ∧
    (∀ a, a ≠ r.mem → a ≠ r.scratch → τ.arrs a = σ.arrs a) ∧ τ.inp = σ.inp ∧ τ.out = σ.out
  have hJ0 : J (σ.setVar q.u 0) := by
    refine ⟨Slots.setVar F r hS huS huW 0, by simp, ?_, ?_, ?_, fun _ _ _ => rfl, rfl, rfl⟩
    · intro x _ h1 _; simp only [vars_setVar, if_neg h1]
    · intro u hu; simp at hu
    · intro s _ _; exact val_setVar F r huW σ 0 s
  have hfix : ∀ τ, J τ → τ.vars q.N = Nv ∧ τ.vars cc = ccv := fun τ hτ =>
    ⟨by rw [hτ.2.2.1 q.N hNS hNu hNj, hN], by rw [hτ.2.2.1 cc hcS hcu hcj, hcc]⟩
  have hdef : ∀ τ, J τ → ∃ v, (Cond.lt (.var q.u) (.var cc)).evalB B τ = some v := by
    intro τ hτ
    exact evalB_condLt_vars (by have := hτ.2.1; omega)
      (by rw [(hfix τ hτ).2]; omega)
  have hstep : ∀ τ, J τ → (Cond.lt (.var q.u) (.var cc)).evalB B τ = some true →
      ∃ τ', Run B (loadBody M q cc) τ τ' (loadStep M q cc Nv) ∧ J τ' ∧
        ccv - τ'.vars q.u < ccv - τ.vars q.u := by
    intro τ hτ hc
    obtain ⟨hNτ, hcτ⟩ := hfix τ hτ
    obtain ⟨hSτ, hule, hregs, hdone, hrest, harr, hinp, hout⟩ := hτ
    have hult : τ.vars q.u < ccv := by
      rw [evalB_condLt (evalB_var (by omega)) (evalB_var (by rw [hcτ]; omega))] at hc
      simp only [Option.some.injEq, decide_eq_true_eq] at hc
      rw [hcτ] at hc; exact hc
    set uv := τ.vars q.u with huv
    have hsrc : stStart Nv (ccv - 1 - uv) + Nv ≤ stStart Nv Nv := by
      unfold stStart
      have := Nat.mul_le_mul_right Nv (show ccv - 1 - uv + 1 ≤ Nv by omega)
      rw [Nat.succ_mul] at this; omega
    have hdst : rowStart Nv uv + Nv ≤ rowStart Nv Nv := by
      unfold rowStart
      have := Nat.mul_le_mul_right Nv (show uv + 1 ≤ Nv by omega)
      rw [Nat.succ_mul] at this; omega
    have hD : (rowBase q (.var q.u)).evalB B τ = some (rowStart Nv uv) :=
      evalB_rowBase q (evalB_var (by omega)) hNτ (by omega)
    have hrev : (revIdx q cc).evalB B τ = some (ccv - 1 - uv) := by
      unfold revIdx
      have h1 : (Expr.bin .sub (.var cc) (.lit 1)).evalB B τ = some (ccv - 1) := by
        rw [← hcτ]; exact evalB_bin (evalB_var (by rw [hcτ]; omega))
          (evalB_lit (by omega)) (by change τ.vars cc - 1 < B; rw [hcτ]; omega)
      exact evalB_bin h1 (evalB_var (by omega))
        (by change ccv - 1 - uv < B; omega)
    have hSrc : (stBase q (revIdx q cc)).evalB B τ = some (stStart Nv (ccv - 1 - uv)) :=
      evalB_stBase q hrev hNτ (by omega)
    obtain ⟨τ1, hr1, hS1, hcp, hfr1, hregs1, -, harr1, hinp1, hout1⟩ :=
