theorem physN_le {e s t : Nat} (h : s ≤ t) : physN e s ≤ physN e t := by
  unfold physN; have := Nat.mul_le_mul_right e h; pomega
theorem physN_add (e s t : Nat) : physN e (s+t) = physN e s + t*e := by
  unfold physN; ring
theorem layout_chain (a b c : Nat) :
    sortedN a b c + a*b*c = poweredN a b c ∧
    poweredN a b c + a*b*c = transposedN a b c ∧
    transposedN a b c + a*b*c = firstGramN a b c ∧
    firstGramN a b c + (a+b+c)*(a+b+c)*((a+b+c)*(a+b+c)) = firstPowerN a b c ∧
    firstPowerN a b c + (2*(a+b+c))*((a+b+c)*(a+b+c)*((a+b+c)*(a+b+c))) =
      firstProductWorkN a b c ∧
    firstProductWorkN a b c + 3 = firstOneN a b c ∧
    firstOneN a b c + 1 = firstFamilyN a b c ∧
    firstFamilyN a b c + (a+b+c)*(a+b+c)*((a+b+c)*(a+b+c)) = firstScratchN a b c ∧
    firstScratchN a b c + 3 = firstRightN a b c ∧
    firstRightN a b c ≤ layoutEndN a b c := by
  refine ⟨?_,?_,?_,?_,?_,?_,?_,?_,?_,?_⟩ <;>
    simp only [sortedN, poweredN, transposedN, firstGramN, firstPowerN, firstProductWorkN,
      firstOneN, firstScratchN, firstFamilyN, firstRightN, firstOutputN, firstAlgScratchN,
      layoutEndN, tensorN, capSqN, capFlatN, capGenN, dimSumN, firstPowerCapN] <;> pomega
