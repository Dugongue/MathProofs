      (σ.vars canonical.outBase+F.e*(i.val*σ.vars columns+j.val))) =
      productEntry F σ (σ.vars canonical.aBase) (σ.vars canonical.bBase)
        (σ.vars columns) (σ.vars count) (i.val*σ.vars columns+j.val) at hv
