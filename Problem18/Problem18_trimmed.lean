namespace Mathproof.Problem18OddBooleanTrial20261001
open Matrix CompPoly
open Mathproof.Problem18ArrayBirdCharpoly20260930
open Mathproof.Problem18ArrayPolynomialEval20260930
open Mathproof.Problem18ArrayKrylov20261001
open Mathproof.Problem18ArrayBoundaryProducts20260930
open Mathproof.Problem18BoundaryTrialChecks20260930
open Mathproof.Problem18BoundaryBooleanChecks20260930
open Mathproof.Problem18DimensionOneBoundary20260930
variable {K : Type} [Field K] [Fintype K] [BEq K] [LawfulBEq K] [DecidableEq K]
variable {b c : ℕ}
def characteristicCheck (A B : Matrix (Fin c) (Fin b) K) : Bool :=
  matrixCharacteristic (A.transpose*A)==matrixCharacteristic (B.transpose*B)
theorem characteristicCheck_correct (A B : Matrix (Fin c) (Fin b) K) :
    characteristicCheck A B=true ↔ (A.transpose*A).charpoly=(B.transpose*B).charpoly := by
  rw [characteristicCheck,beq_iff_eq,← matrixCharacteristic_correct,← matrixCharacteristic_correct]
  exact CPolynomial.ringEquiv.injective.eq_iff.symm
theorem equivalent_charpoly (A B : Matrix (Fin c) (Fin b) K)
    (h : MatrixOrthogonalEquivalent A B) :
    (A.transpose*A).charpoly=(B.transpose*B).charpoly := by
  obtain ⟨Q,hQ,_,hG⟩ := (orthogonal_boundary_recovery A B).mp h
  rw [← hG,Matrix.mul_assoc,Matrix.charpoly_mul_comm]
  rw [Matrix.mul_assoc,show Q*Q.transpose=1 from mul_eq_one_comm.mp hQ,Matrix.mul_one]
def explicitCandidate (A B : Matrix (Fin c) (Fin b) K) (v w : Fin b→K) :
    Matrix (Fin b) (Fin b) K :=
  matrix b (candidate b (arrayOf (A.transpose*A)) (arrayOf (B.transpose*B)) v w)
theorem explicitCandidate_correct (A B : Matrix (Fin c) (Fin b) K) (v w : Fin b→K) :
    explicitCandidate A B v w=Mathproof.Problem18OddBoundaryDecision20260930.boundaryCandidate B A v w := by
  rw [explicitCandidate,candidate_correct,matrix_arrayOf,matrix_arrayOf]
  rfl
def passedCheck (q : ℕ) (A B : Matrix (Fin c) (Fin b) K) (v w : Fin b→K) : Bool :=
  let Q := explicitCandidate A B v w
  allChecks b (arrayOf (A.transpose*A)) (arrayOf (Q.transpose*Q))
    (matrixCharacteristic (A.transpose*A)) q
theorem passedCheck_correct (q : ℕ) (hq : q=Nat.card K) (hodd : ringChar K≠2) (A B : Matrix (Fin c) (Fin b) K)
    (hA : orthogonalSourceCheck A=true) (hχ : characteristicCheck A B=true)
    (v w : Fin b→K) (hv : cyclicCheck (A.transpose*A) v=true)
    (hw : cyclicCheck (B.transpose*B) w=true) :
    passedCheck q A B v w=true ↔ MatrixOrthogonalEquivalent A B := by
  have hAg := (orthogonalSourceCheck_correct A).mp hA
  rw [passedCheck,hq,allChecks_correct]
  · simp only [matrix_arrayOf,explicitCandidate_correct]
    exact (odd_source_trial_correct hodd A B hAg ((characteristicCheck_correct A B).mp hχ)
      v w ((cyclicCheck_correct _ _).mp hv) ((cyclicCheck_correct _ _).mp hw)).symm
  · simpa only [matrix_arrayOf] using matrixCharacteristic_correct (A.transpose*A)
  · simpa only [matrix_arrayOf] using hAg.2
def trial (q : ℕ) (A B : Matrix (Fin c) (Fin b) K) (v w : Fin b→K) : Option Bool :=
  if orthogonalSourceCheck B && characteristicCheck A B then
    if cyclicCheck (A.transpose*A) v && cyclicCheck (B.transpose*B) w then
      some (passedCheck q A B v w)
    else none
  else some false
theorem trial_zero_error (q : ℕ) (hq : q=Nat.card K) (hodd : ringChar K≠2) (A B : Matrix (Fin c) (Fin b) K)
    (hA : orthogonalSourceCheck A=true) (v w : Fin b→K) (answer : Bool)
    (h : trial q A B v w=some answer) :
    answer=true ↔ MatrixOrthogonalEquivalent A B := by
  unfold trial at h
  split_ifs at h with hg hc
  · have hg' : orthogonalSourceCheck B=true ∧ characteristicCheck A B=true := by
      simpa only [Bool.and_eq_true] using hg
    have hc' : cyclicCheck (A.transpose*A) v=true ∧ cyclicCheck (B.transpose*B) w=true := by
      simpa only [Bool.and_eq_true] using hc
    have ha := Option.some.inj h
    rw [← ha]
    exact passedCheck_correct q hq hodd A B hA hg'.2 v w hc'.1 hc'.2
  · have ha : answer=false := (Option.some.inj h).symm
    rw [ha]
    simp only [Bool.false_eq_true,false_iff]
    intro he
    apply hg
    simp only [Bool.and_eq_true]
    exact ⟨(orthogonalSourceCheck_correct B).mpr
      ((orthogonal_good_invariant A B he).mp ((orthogonalSourceCheck_correct A).mp hA)),
      (characteristicCheck_correct A B).mpr (equivalent_charpoly A B he)⟩
end Mathproof.Problem18OddBooleanTrial20261001
end
