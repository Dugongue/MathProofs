  have hnext : σ.vars q.pv+1<B := by have hh:=h.capacity;omega
  have einc : (plus (.var q.pv) (.lit 1)).evalB B η=some (σ.vars q.pv+1) := by
    unfold plus
    exact evalB_bin (by rw [←hidx];exact evalB_var (by omega)) (evalB_lit (by omega))
      (by change σ.vars q.pv+1<B;exact hnext)
  have hr2:=Run.assign (x:=q.pv) einc
  have hrall : Run B body σ (η.setVar q.pv (σ.vars q.pv+1)) (bodyCost F (σ.vars q.N)) := by
