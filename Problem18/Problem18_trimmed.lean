      apply top_unique
      intro x hx
      obtain ⟨y,rfl⟩ := σ.surjective x
      have hy : y∈V := by rw [htop]; trivial
      exact hy
    exact (Valuation.valuationSubring_eq_top_iff _).mp ht inferInstance
  have hS (s : S) : algebraMap S L s∈V := by
    change p.valuation L (σ (algebraMap S L s))≤1
    rw [hστ]
    exact p.valuation_le_one (τ s)
