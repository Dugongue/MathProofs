  have hseedξ : ∀j:Fin n,val F canonical workspaceName ξ (seed n+j.val)=
      ((Pi.single (⟨i,hi⟩:Fin n) (1:K)):Fin n→K) j := by
    intro j
    rw [hmemA _ (by have hh:=j.isLt;omega) (by omega) (Or.inr (by omega))]
    exact hseed j
