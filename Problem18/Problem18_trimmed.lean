theorem peelClaim_succ (G : Finset (MvPolynomial (Fin n) L)) (d : ℕ)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (k : ℕ) (hk : k ≤ n) (ih : PeelClaim G d k) :
    PeelClaim G d (k+1) := by
  classical
  obtain ⟨ihS, ihC, ihD⟩ := ih
  set acc := peelAcc n d k with hacc
  set r := n - k with hr
  have hnr : n - r + 1 = k + 1 := by omega
  set H := acc.2.1 * acc.1 with hH
  have hfinT := Ideal.finite_minimalPrimes_of_isNoetherianRing (MvPolynomial (Fin n) L)
    (Ideal.span (G : Set (MvPolynomial (Fin n) L)))
  set T := hfinT.toFinset with hT
  set W := T.filter fun Z => n < rk Z + k with hW
  set Lv := T.filter fun P => rk P = r with hLv
  have hWmem : ∀ Z ∈ W, Z ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes ∧
      n < rk Z + k := by
    intro Z hZ
    rw [hW, Finset.mem_filter, hT, Set.Finite.mem_toFinset] at hZ
    exact hZ
  have hWcard : W.card ≤ acc.2.1 := ihC W hWmem
  have hgP : ∀ P ∈ Lv, ∃ g : MvPolynomial (Fin n) L, g.totalDegree ≤ H ∧ (∀ Z ∈ W, g ∈ Z) ∧ g ∉ P := by
    intro P hP
    rw [hLv, Finset.mem_filter, hT, Set.Finite.mem_toFinset] at hP
    obtain ⟨hPmin, hPrk⟩ := hP
    haveI hPp : P.IsPrime := hPmin.1.1
    have hnotle : ¬ (∏ Z ∈ W, Z) ≤ P := by
      intro hle
      obtain ⟨Z, hZ, hZP⟩ := (Ideal.IsPrime.prod_le hPp).mp hle
      obtain ⟨hZmin, hZlt⟩ := hWmem Z hZ
      have hPZ : P ≤ Z := hPmin.2 ⟨hZmin.1.1, hZmin.1.2⟩ hZP
      have hEq : P = Z := le_antisymm hPZ hZP
      rw [hEq] at hPrk
      omega
    obtain ⟨g0, hg0, hg0P⟩ := Set.not_subset.mp hnotle
    have hrad : P = MvPolynomial.vanishingIdeal L (MvPolynomial.zeroLocus L P) := by
      rw [MvPolynomial.vanishingIdeal_zeroLocus_eq_radical, hPp.radical]
    have hq : ∃ q ∈ MvPolynomial.zeroLocus L P, eval q g0 ≠ 0 := by
      by_contra hall
      push Not at hall
      apply hg0P
      rw [hrad, SetLike.mem_coe, MvPolynomial.mem_vanishingIdeal_iff]
      intro q hq
      simpa using hall q hq
    obtain ⟨q, hqP, hqg⟩ := hq
    have hsepZ : ∀ Z ∈ W, ∃ s ∈ Z, s.totalDegree ≤ acc.1 ∧ eval q s ≠ 0 := by
      intro Z hZ
      obtain ⟨hZmin, hZlt⟩ := hWmem Z hZ
      have hg0Z : g0 ∈ Z := Ideal.prod_le_inf.trans (Finset.inf_le hZ) hg0
      exact ihS Z hZmin hZlt q g0 hg0Z hqg
    choose! s hsZ hsdeg hsq using hsepZ
    refine ⟨∏ Z ∈ W, s Z, ?_, ?_, ?_⟩
    · refine (totalDegree_finsetProd _ _).trans ?_
      calc ∑ Z ∈ W, (s Z).totalDegree ≤ ∑ _Z ∈ W, acc.1 := Finset.sum_le_sum fun Z hZ => hsdeg Z hZ
        _ = W.card * acc.1 := by simp
        _ ≤ H := Nat.mul_le_mul_right _ hWcard
    · intro Z hZ
      rw [← Finset.mul_prod_erase W s hZ]
      exact Ideal.mul_mem_right _ _ (hsZ Z hZ)
    · intro hmem
      have hz : eval q (∏ Z ∈ W, s Z) = 0 := by
        have hq0 := (MvPolynomial.mem_zeroLocus_iff.mp hqP) _ hmem
        simpa using hq0
      rw [map_prod] at hz
      obtain ⟨Z, hZ, hZ0⟩ := Finset.prod_eq_zero_iff.mp hz
      exact hsq Z hZ hZ0
  choose! gP hgPdeg hgPW hgPnot using hgP
  let V : Submodule L (MvPolynomial (Fin n) L) := Submodule.span L (gP '' (Lv : Set _))
  let WP : Lv → Submodule L V := fun P => (P.1.restrictScalars L).comap V.subtype
  have hWP : ∀ P, WP P ≠ ⊤ := by
    intro P htop
    have hmem : (⟨gP P.1, Submodule.subset_span ⟨P.1, P.2, rfl⟩⟩ : V) ∈ WP P := by
      rw [htop]
      trivial
    exact hgPnot P.1 P.2 hmem
  obtain ⟨v, hv⟩ := Submodule.exists_forall_notMem_of_forall_ne_top WP hWP
  set h := (v : MvPolynomial (Fin n) L) with hhdef
  have hVle : V ≤ (⨅ Z ∈ W, Z.restrictScalars L) ⊓ restrictTotalDegree (Fin n) L H := by
    rw [Submodule.span_le]
    rintro _ ⟨P, hP, rfl⟩
    refine ⟨?_, ?_⟩
    · simp only [Submodule.coe_iInf, Set.mem_iInter, SetLike.mem_coe, Submodule.restrictScalars_mem]
      intro Z hZ
      exact hgPW P hP Z hZ
    · rw [SetLike.mem_coe, mem_restrictTotalDegree]
      exact hgPdeg P hP
  have hhmem := hVle v.2
  have hhW : ∀ Z ∈ W, h ∈ Z := by
    intro Z hZ
    have h1 := (Submodule.mem_iInf _).mp hhmem.1 Z
    exact (Submodule.mem_iInf _).mp h1 hZ
  have hhdeg : h.totalDegree ≤ H := (mem_restrictTotalDegree _ _ _).mp hhmem.2
  have hhLv : ∀ P ∈ Lv, h ∉ P := fun P hP => hv ⟨P, hP⟩
  have hdim : DimLE G h r := by
    intro P hP hhP
    haveI : P.IsPrime := hP.1.1
    rw [← rk_cast P]
    by_contra hgt
    push Not at hgt
    have hlt : r < rk P := by exact_mod_cast hgt
    have hPW : P ∈ W := by
      rw [hW, Finset.mem_filter, hT, Set.Finite.mem_toFinset]
      exact ⟨hP, by omega⟩
    exact hhP (hhW P hPW)
  have hlevel : ∀ P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes,
      n < rk P + (k+1) → ¬ n < rk P + k → P ∈ Lv := by
    intro P hP h1 h2
    rw [hLv, Finset.mem_filter, hT, Set.Finite.mem_toFinset]
    exact ⟨hP, by omega⟩
  have hacc1 : (peelAcc n d (k+1)).1 = max acc.1 ((r + 1) * fiberBound (n - r + 1) (max d (H + 1))) := by
    rw [hnr]
    rfl
  have hacc2 : (peelAcc n d (k+1)).2.1 = acc.2.1 + n ^ r * fiberBound (n - r + 1) (max d (H + 1)) := by
    rw [hnr]
    rfl
  have hacc3 : (peelAcc n d (k+1)).2.2 = max acc.2.2 (fiberBound (n - r + 1) (max d (H + 1))) := by
    rw [hnr]
    rfl
  refine ⟨fun P hP hlt p f hfP hfp => ?_, fun S hS => ?_, fun P hP hlt κ hκ f => ?_⟩
  · by_cases hold : n < rk P + k
    · obtain ⟨s, hs, hsdeg, hsp⟩ := ihS P hP hold p f hfP hfp
      exact ⟨s, hs, hsdeg.trans (by rw [hacc1]; exact le_max_left _ _), hsp⟩
    · have hPL := hlevel P hP hlt hold
      haveI : P.IsPrime := hP.1.1
      have hrkP : rk P = r := by
        rw [hLv, Finset.mem_filter] at hPL
        exact hPL.2
      have hrcard : (r : Cardinal) ≤ Algebra.trdeg L (MvPolynomial (Fin n) L ⧸ P) := by
        rw [← rk_cast P, hrkP]
      obtain ⟨s, hs, hsdeg, hsp⟩ := exists_component_separator G h d H r hG hhdeg hdim P hP
        (hhLv P hPL) hrcard p f hfP hfp
      exact ⟨s, hs, hsdeg.trans (by rw [hacc1]; exact le_max_right _ _), hsp⟩
  · rw [hacc2]
    have hsplit : S ⊆ S.filter (fun P => n < rk P + k) ∪ S.filter (fun P => ¬ n < rk P + k) := by
      intro P hP
      by_cases hc : n < rk P + k
      · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨hP, hc⟩)
      · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨hP, hc⟩)
    refine (Finset.card_le_card hsplit).trans ((Finset.card_union_le _ _).trans
      (Nat.add_le_add ?_ ?_))
    · refine ihC _ fun P hP => ?_
      rw [Finset.mem_filter] at hP
      exact ⟨(hS P hP.1).1, hP.2⟩
    · refine card_level_le G h d H r hG hhdeg hdim _ fun P hP => ?_
      rw [Finset.mem_filter] at hP
      obtain ⟨hPmin, hlt⟩ := hS P hP.1
      have hPL := hlevel P hPmin hlt hP.2
      refine ⟨hPmin, hhLv P hPL, ?_⟩
      rw [hLv, Finset.mem_filter] at hPL
      exact hPL.2
  · by_cases hold : n < rk P + k
    · obtain ⟨q, hq0, hqdeg, hqmem⟩ := ihD P hP hold κ hκ f
      exact ⟨q, hq0, hqdeg.trans (by rw [hacc3]; exact le_max_left _ _), hqmem⟩
    · have hPL := hlevel P hP hlt hold
      have hrkP : rk P = r := by
        rw [hLv, Finset.mem_filter] at hPL
        exact hPL.2
      have hdim' : DimLE G h (rk P) := by rw [hrkP]; exact hdim
      obtain ⟨q, hq0, hqdeg, hqmem⟩ := exists_coordinate_relation G h d H hG hhdeg hdim' κ P hP
        (hhLv P hPL) hκ f
      refine ⟨q, hq0, hqdeg.trans ?_, hqmem⟩
      rw [hacc3, hrkP]
      exact le_max_right _ _
theorem peelClaim_all (G : Finset (MvPolynomial (Fin n) L)) (d : ℕ)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) : ∀ k, k ≤ n + 1 → PeelClaim G d k := by
  intro k
  induction k with
  | zero => intro _; exact peelClaim_zero G d
  | succ k ih =>
    intro hk
    exact peelClaim_succ G d hG k (by omega) (ih (by omega))
theorem minimalPrime_separator (G : Finset (MvPolynomial (Fin n) L)) (d : ℕ)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) (P : Ideal (MvPolynomial (Fin n) L))
    (hP : P ∈ (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes)
    (p : Fin n → L) (f : MvPolynomial (Fin n) L) (hfP : f ∈ P) (hfp : eval p f ≠ 0) :
    ∃ s ∈ P, s.totalDegree ≤ componentSep n d ∧ eval p s ≠ 0 :=
  (peelClaim_all G d hG (n+1) le_rfl).1 P hP (by omega) p f hfP hfp
theorem minimalPrimes_ncard_le (G : Finset (MvPolynomial (Fin n) L)) (d : ℕ)
    (hG : ∀ g ∈ G, g.totalDegree ≤ d) :
    (Ideal.span (G : Set (MvPolynomial (Fin n) L))).minimalPrimes.ncard ≤ componentCount n d := by
  classical
  have hfin := Ideal.finite_minimalPrimes_of_isNoetherianRing (MvPolynomial (Fin n) L)
    (Ideal.span (G : Set (MvPolynomial (Fin n) L)))
  rw [Set.ncard_eq_toFinset_card _ hfin]
  refine (peelClaim_all G d hG (n+1) le_rfl).2.1 _ fun P hP => ?_
  rw [Set.Finite.mem_toFinset] at hP
  exact ⟨hP, by omega⟩
end Descent
