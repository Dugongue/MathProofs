theorem subspace_card_ratio (E : Submodule K V) :
    (Fintype.card V : ℝ) / Fintype.card E =
      (Fintype.card K : ℝ)^(Module.finrank K V - Module.finrank K E) := by
  rw [Module.card_eq_pow_finrank (K := K) (V := V),
    Module.card_eq_pow_finrank (K := K) (V := E)]
  simp only [Nat.cast_pow, div_eq_mul_inv]
  have hq : (Fintype.card K : ℝ) ≠ 0 := by exact_mod_cast Fintype.card_ne_zero
  exact (pow_sub₀ _ hq E.finrank_le).symm
theorem restricted_twist_support_card (Q : QuadraticForm K V)
    (E : Submodule K V) (ψ : AddChar K ℂ) (hψ : ψ ≠ 1) :
