  have he : gramUnit (modelForm n c) (modelForm_nondegenerate n c)
      (Pi.basisFun K (Fin (n+1)))=representativeUnit c := by
    apply Units.ext
    change ((diagonalForm (modelCoefficients n c)).toMatrix (Pi.basisFun K (Fin (n+1)))).det=_
    rw [diagonal_gram_det,Fin.prod_univ_succ]
    simp [modelCoefficients]
  rw [determinantClass,he,representativeUnit_class]
theorem models_isometric_iff (hodd : ringChar K≠2) (n : ℕ) (c d : SquareClass K) :
    (∃ e : (Fin (n+1) → K) ≃ₗ[K] (Fin (n+1) → K),∀ x y,
      modelForm n d (e x) (e y)=modelForm n c x y) ↔ c=d := by
  rw [← determinantClass_eq_iff_isometry hodd (modelForm n c) (modelForm n d)
    (Pi.basisFun K _) (Pi.basisFun K _) (modelForm_symmetric n c) (modelForm_symmetric n d)
    (modelForm_nondegenerate n c) (modelForm_nondegenerate n d),
    modelForm_determinantClass,modelForm_determinantClass]
theorem model_index_card (hodd : ringChar K≠2) : Nat.card (SquareClass K)=2 := by
  rw [card_squareClass,if_neg (Ring.two_ne_zero hodd)]
end
