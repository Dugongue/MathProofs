def axisExp {n : ℕ} (i : Fin n) (j : ℕ) : FinExponent n :=
  functionToExponent (fun t => if t = i then j else 0)
theorem axisExp_self {n : ℕ} (i : Fin n) (j : ℕ) : axisExp i j i = j := by
  simp [axisExp, functionToExponent]
def frobTbl (n B D : ℕ) (i : Fin n) : List (Option ℕ) :=
  (boundedExponents n B).map fun a => if a = axisExp i (a i) ∧ a i < D then some (a i) else none
theorem frobTbl_length (n B D : ℕ) (i : Fin n) :
    (frobTbl n B D i).length = (boundedExponents n B).length := by
  simp [frobTbl]
theorem frobTbl_lt {n B D : ℕ} {i : Fin n} {j : ℕ} (h : some j ∈ frobTbl n B D i) : j < D := by
  obtain ⟨e, _, hje⟩ := List.mem_map.mp h
  split_ifs at hje with hc
  cases hje; exact hc.2
def axisPos (n B : ℕ) (i : Fin n) : ℕ := (boundedExponents n B).idxOf (axisExp i 1)
theorem getElem_eq_iff_idxOf {α : Type} [DecidableEq α] {l : List α} (hnd : l.Nodup) (x : α)
    {a : ℕ} (ha : a < l.length) : l[a] = x ↔ a = l.idxOf x := by
  constructor
  · intro h
    have hm : x ∈ l := h ▸ List.getElem_mem ha
    have hlt : l.idxOf x < l.length := List.idxOf_lt_length_iff.mpr hm
    have h2 : l[l.idxOf x] = l[a] := by rw [List.getElem_idxOf hlt, h]
    exact (hnd.getElem_inj_iff.mp h2).symm
  · intro h
    subst h
    exact List.getElem_idxOf ha
theorem sum_axis {K : Type} [Field K] [DecidableEq K] {n D : ℕ} (i : Fin n) (r : Vector K D)
    (e : FinExponent n) :
    (∑ j ∈ Finset.range D, vget r j * (if e = axisExp i j then (1 : K) else 0)) =
      if e = axisExp i (e i) ∧ e i < D then vget r (e i) else 0 := by
  by_cases h : e = axisExp i (e i) ∧ e i < D
  · rw [if_pos h, Finset.sum_eq_single (e i)]
    · rw [if_pos h.1, mul_one]
    · intro j _ hj
      have : e ≠ axisExp i j := fun he => hj (by rw [he, axisExp_self])
      rw [if_neg this, mul_zero]
    · intro hn; exact absurd (Finset.mem_range.mpr h.2) hn
  · rw [if_neg h]
    refine Finset.sum_eq_zero fun j hj => ?_
    have : e ≠ axisExp i j := by
      intro he
      have hj' : e i = j := by rw [he, axisExp_self]
      exact h ⟨by rw [hj']; exact he, by rw [hj']; exact Finset.mem_range.mp hj⟩
    rw [if_neg this, mul_zero]
theorem read_powerRow {K : Type} [Field K] [DecidableEq K] {n : ℕ} (B : ℕ) (i : Fin n) (j : ℕ)
    (a : Fin (boundedExponents n B).length) :
    read (powerRow (K := K) B i j) a =
      if (boundedExponents n B)[a.val] = axisExp i j then 1 else 0 := by
  rw [powerRow, read_ofFn]
  exact if_congr Iff.rfl rfl rfl
def rval {K : Type} [Field K] {D : ℕ} (r : Vector K D) : Option ℕ → K
  | some j => vget r j
  | none => 0
theorem frobeniusRow_read {K : Type} [Field K] [DecidableEq K] {n : ℕ} (B D : ℕ) (i : Fin n)
    (r : Vector K D) (a : Fin (boundedExponents n B).length) :
    read (frobeniusRow B D i r) a =
      rval r ((frobTbl n B D i)[a.val]'(by rw [frobTbl_length]; exact a.isLt)) -
        (if a.val = axisPos n B i then 1 else 0) := by
  rw [frobeniusRow, frobeniusRowCounted, countedOfFn_fst, read_ofFn]
  simp only [rowEntryLoop_value, read_powerRow, sum_axis]
  congr 1
  · simp only [frobTbl, List.getElem_map]
    split_ifs <;> rfl
  · have hiff := getElem_eq_iff_idxOf (boundedExponents_nodup n B) (axisExp i 1) a.isLt
    by_cases h : a.val = axisPos n B i
    · rw [if_pos (hiff.mpr h), if_pos h]
    · rw [if_neg (fun h' => h (hiff.mp h')), if_neg h]
variable {K : Type} [Field K] [Fintype K] [DecidableEq K] {F : FieldPresentation K}
