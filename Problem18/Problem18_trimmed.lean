    unfold findIdxRev?.find
    split
    next => tauto
    next _ j hj =>
      split
      · use .mk j (by omega)
      · obtain ⟨ k, hk : k < j + 1, hcond ⟩ := h'
        apply aux
        have : k.val ≠ j := by rintro rfl; contradiction
        have : k.val < j := by omega
        use k
