    have hh : ¬ τ.vars zj < N := by simpa using ht.symm
    omega
  have hrun : Run B zfill σ τ (20*N+6) := by
    have hh := (Run.assign (σ:=σ) (x:=zj) (evalB_lit (by omega : 0 < B))).seq hr
