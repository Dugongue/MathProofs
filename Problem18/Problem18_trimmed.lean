open Mathproof.Problem18TwistedTraceLift20260930
universe u v w
variable {F : Type u} {E : Type v} {U : Type w}
  [Field F] [Field E] [Algebra F E]
  [FiniteDimensional F E] [Algebra.IsSeparable F E]
  [AddCommGroup U] [Module F U] [Module E U] [IsScalarTower F E U]
theorem trace_intertwines (τ : F ≃+* F) (σ : E ≃+* E)
    (hcompat : (algebraMap F E).comp (τ : F →+* F) =
      (σ : E →+* E).comp (algebraMap F E)) (z : E) :
    Algebra.trace F E (σ z) = τ (Algebra.trace F E z) := by
  have h := Algebra.trace_eq_of_equiv_equiv τ σ hcompat z
  have h' := congrArg τ h
  simpa using h'.symm
theorem twistedTraceForm_symmetry (τ : F ≃+* F) (σ : E ≃+* E)
    (hcompat : (algebraMap F E).comp (τ : F →+* F) =
      (σ : E →+* E).comp (algebraMap F E))
    (hσ : Function.Involutive σ)
    (B : U →ₛₗ[(τ : F →+* F)] U →ₗ[F] F)
    (hbalance : ∀ (a : E) (u v : U), B (a • u) v = B u (σ a • v))
    (eps : F) (hsym : ∀ u v : U, B v u = eps * τ (B u v)) (u v : U) :
    twistedTraceForm (σ : E →+* E) B hbalance v u =
      algebraMap F E eps * σ (twistedTraceForm (σ : E →+* E) B hbalance u v) := by
  apply trace_value_ext (F := F)
  intro a
  calc
    Algebra.traceForm F E (twistedTraceForm (σ : E →+* E) B hbalance v u) a =
        B v (a • u) := traceForm_twistedTraceForm _ B hbalance v u a
    _ = eps * τ (B (a • u) v) := hsym (a • u) v
    _ = eps * τ (B u (σ a • v)) := by rw [hbalance]
    _ = eps * τ (Algebra.traceForm F E
        (twistedTraceForm (σ : E →+* E) B hbalance u v) (σ a)) := by
      exact congrArg (fun z : F => eps * τ z)
        (traceForm_twistedTraceForm (σ : E →+* E) B hbalance u v (σ a)).symm
    _ = eps * Algebra.trace F E
        (σ (twistedTraceForm (σ : E →+* E) B hbalance u v * σ a)) := by
      rw [Algebra.traceForm_apply, trace_intertwines τ σ hcompat]
    _ = Algebra.trace F E
        (eps • σ (twistedTraceForm (σ : E →+* E) B hbalance u v * σ a)) := by
      simp only [map_smul, smul_eq_mul]
    _ = Algebra.traceForm F E
        (algebraMap F E eps * σ (twistedTraceForm (σ : E →+* E) B hbalance u v)) a := by
      simp only [Algebra.smul_def, map_mul, Algebra.traceForm_apply, mul_assoc]
      rw [hσ a]
end Mathproof.Problem18TwistedTraceSymmetry20260930
