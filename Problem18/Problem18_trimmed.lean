    flag (rhsPair work) 0 (σ := σ3) hf'.1 hf'.2.2.2 hf'.2.1 (by simp [σ3, σ2, σ1, n1, n2])
    (by simp [σ3]) (by rw [hlen]; exact hsfit) (by rw [hlen]; exact hWw)
    (by intro j hj; have := vals_lt F hx j hj; show (σ.arrs work).getD (sv+j) 0 < W; omega)
    (by omega)
    (fun j => (σ.arrs work).getD (dv + j) 0) (by
      intro ρ hρa hρv hρi
      have hd' : ρ.vars cD = dv := by
        rw [hρv cD (by decide) (Ne.symm hf'.2.2.1)]; simp [σ3, σ2, n3]
