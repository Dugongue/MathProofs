section Helpers
variable {K : Type uK} [Field K]
private theorem split_pairing_m0175 {M : Type*} [AddCommGroup M] [Module K M]
    (B : LinearMap.BilinForm K M) (halt : B.IsAlt) {e f u v : M} (hef : B e f = 1)
    (hu : B e u = 0 ∧ B f u = 0) (hv : B e v = 0 ∧ B f v = 0) (a b c d : K) :
    B (a • e + b • f + u) (c • e + d • f + v) = a * d - b * c + B u v := by
  have hee : B e e = 0 := halt.self_eq_zero e
  have hff : B f f = 0 := halt.self_eq_zero f
  have hfe : B f e = -1 := by rw [← halt.neg_eq, hef]
  have hue : B u e = 0 := by rw [← halt.neg_eq, hu.1, neg_zero]
  have huf : B u f = 0 := by rw [← halt.neg_eq, hu.2, neg_zero]
  simp only [map_add, map_smul, LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul,
    hee, hff, hef, hfe, hue, huf, hv.1, hv.2]
  ring
private theorem hyperbolic_split {M : Type uV} [AddCommGroup M] [Module K M]
    [FiniteDimensional K M] (B : LinearMap.BilinForm K M) (halt : B.IsAlt)
    (hB : B.Nondegenerate) (hpos : 0 < finrank K M) :
    ∃ (e f : M) (U : Submodule K M) (ψ : ((K × K) × U) ≃ₗ[K] M),
      B e f = 1 ∧
      (∀ p, ψ p = p.1.1 • e + p.1.2 • f + (p.2 : M)) ∧
      (∀ u : U, B e u = 0 ∧ B f u = 0) ∧
      (B.restrict U).IsAlt ∧ (B.restrict U).Nondegenerate ∧
      finrank K U + 2 = finrank K M := by
  obtain ⟨e, he⟩ := (Module.finrank_pos_iff_exists_ne_zero (R := K) (M := M)).mp hpos
  have hex : ∃ f0, B e f0 ≠ 0 := by
    by_contra hcon
    push Not at hcon
    exact he (hB.1 e hcon)
  obtain ⟨f0, hf0⟩ := hex
  set f : M := (B e f0)⁻¹ • f0 with hfdef
  have hef : B e f = 1 := by
    rw [hfdef, map_smul, smul_eq_mul, inv_mul_cancel₀ hf0]
  have hee : B e e = 0 := halt.self_eq_zero e
  have hff : B f f = 0 := halt.self_eq_zero f
  have hfe : B f e = -1 := by rw [← halt.neg_eq, hef]
  let U : Submodule K M := LinearMap.ker (B e) ⊓ LinearMap.ker (B f)
  have hmemU : ∀ v : M, v ∈ U ↔ B e v = 0 ∧ B f v = 0 := by
    intro v
    simp [U, Submodule.mem_inf, LinearMap.mem_ker]
  have hUorth : ∀ u : U, B e u = 0 ∧ B f u = 0 := fun u => (hmemU u).mp u.2
  let φ : ((K × K) × U) →ₗ[K] M :=
    { toFun := fun p => p.1.1 • e + p.1.2 • f + (p.2 : M)
      map_add' := by
        intro p q
        simp only [Prod.fst_add, Prod.snd_add, Submodule.coe_add, add_smul]
        abel
      map_smul' := by
        intro c p
        simp only [Prod.smul_fst, Prod.smul_snd, Submodule.coe_smul, smul_eq_mul,
          RingHom.id_apply, smul_add, mul_smul] }
  have hφ : ∀ p, φ p = p.1.1 • e + p.1.2 • f + (p.2 : M) := fun _ => rfl
  have hinj : Function.Injective φ := by
    rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
    rintro ⟨⟨a, b⟩, u⟩ h
    rw [hφ] at h
    obtain ⟨hu1, hu2⟩ := hUorth u
    have h1 := congrArg (B e) h
    have h2 := congrArg (B f) h
    simp only [map_add, map_smul, smul_eq_mul, hee, hef, hu1, map_zero] at h1
    simp only [map_add, map_smul, smul_eq_mul, hff, hfe, hu2, map_zero] at h2
    have hb : b = 0 := by simpa using h1
    have ha : a = 0 := by simpa using h2
    subst ha hb
    have hu0 : (u : M) = 0 := by simpa using h
    have : u = 0 := Subtype.ext hu0
    simp [this]
  have hsurj : Function.Surjective φ := by
    intro x
    refine ⟨((-B f x, B e x), ⟨x - (-B f x) • e - (B e x) • f, ?_⟩), ?_⟩
    · rw [hmemU]
      constructor
      · simp only [map_sub, map_smul, smul_eq_mul, hee, hef]
        ring
      · simp only [map_sub, map_smul, smul_eq_mul, hff, hfe]
        ring
    · rw [hφ]
      simp only
      abel
  let ψ : ((K × K) × U) ≃ₗ[K] M := LinearEquiv.ofBijective φ ⟨hinj, hsurj⟩
  have hψ : ∀ p, ψ p = p.1.1 • e + p.1.2 • f + (p.2 : M) := fun _ => rfl
  have haltU : (B.restrict U).IsAlt := fun u => halt.self_eq_zero (u : M)
  have hnondegU : (B.restrict U).Nondegenerate := by
    refine (LinearMap.IsRefl.nondegenerate_iff_separatingLeft haltU.isRefl).mpr ?_
    intro u hu
    apply Subtype.ext
    apply hB.1
    intro y
    obtain ⟨⟨⟨a, b⟩, w⟩, rfl⟩ := ψ.surjective y
    rw [hψ]
    obtain ⟨hu1, hu2⟩ := hUorth u
    have hue : B u e = 0 := by rw [← halt.neg_eq, hu1, neg_zero]
    have huf : B u f = 0 := by rw [← halt.neg_eq, hu2, neg_zero]
    have huw : B u w = 0 := hu w
    simp only [map_add, map_smul, smul_eq_mul, hue, huf, huw, mul_zero, add_zero]
  have hdim : finrank K U + 2 = finrank K M := by
    have h := ψ.finrank_eq
    rw [Module.finrank_prod, Module.finrank_prod, Module.finrank_self] at h
    omega
  exact ⟨e, f, U, ψ, hef, hψ, hUorth, haltU, hnondegU, hdim⟩
private theorem even_aux (n : ℕ) :
    ∀ (M : Type uV) [AddCommGroup M] [Module K M] [FiniteDimensional K M]
      (B : LinearMap.BilinForm K M), B.IsAlt → B.Nondegenerate → finrank K M = n → Even n := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro M _ _ _ B halt hB hn
    rcases Nat.eq_zero_or_pos n with h0 | hpos
    · exact h0 ▸ ⟨0, rfl⟩
    · obtain ⟨e, f, U, ψ, -, -, -, haltU, hnondegU, hdim⟩ :=
        hyperbolic_split B halt hB (hn ▸ hpos)
      have hlt : finrank K U < n := by omega
      have hev := ih (finrank K U) hlt U (B.restrict U) haltU hnondegU rfl
      rw [← hn, ← hdim]
      exact hev.add (by decide)
private theorem iso_aux (n : ℕ) :
    ∀ (M : Type uV) [AddCommGroup M] [Module K M] [FiniteDimensional K M]
      (N : Type uW) [AddCommGroup N] [Module K N] [FiniteDimensional K N]
      (B : LinearMap.BilinForm K M) (C : LinearMap.BilinForm K N),
      B.IsAlt → C.IsAlt → B.Nondegenerate → C.Nondegenerate →
      finrank K M = n → finrank K N = n →
      ∃ i : M ≃ₗ[K] N, ∀ x y, C (i x) (i y) = B x y := by
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro M _ _ _ N _ _ _ B C hB hC hBn hCn hM hN
    rcases Nat.eq_zero_or_pos n with h0 | hpos
    · subst h0
      refine ⟨LinearEquiv.ofFinrankEq M N (hM.trans hN.symm), fun x y => ?_⟩
      have : Subsingleton M := Module.finrank_zero_iff.mp hM
      rw [Subsingleton.elim x 0]
      simp
    · obtain ⟨e, f, U, ψ, hef, hψ, hUo, haltU, hnU, hdimU⟩ :=
        hyperbolic_split B hB hBn (hM ▸ hpos)
      obtain ⟨e', f', U', ψ', hef', hψ', hUo', haltU', hnU', hdimU'⟩ :=
        hyperbolic_split C hC hCn (hN ▸ hpos)
      have hlt : finrank K U < n := by omega
      obtain ⟨j, hj⟩ := ih (finrank K U) hlt U U' (B.restrict U) (C.restrict U')
        haltU haltU' hnU hnU' rfl (by omega)
      let i : M ≃ₗ[K] N :=
        ψ.symm.trans (((LinearEquiv.refl K (K × K)).prodCongr j).trans ψ')
      have hi : ∀ r, i (ψ r) = ψ' (r.1, j r.2) := by
        intro r
        simp [i]
      refine ⟨i, fun x y => ?_⟩
      obtain ⟨p, rfl⟩ := ψ.surjective x
      obtain ⟨q, rfl⟩ := ψ.surjective y
      rw [hi, hi, hψ', hψ', hψ, hψ,
        split_pairing_m0175 C hC hef' (hUo' _) (hUo' _),
        split_pairing_m0175 B hB hef (hUo _) (hUo _)]
      have := hj p.2 q.2
      change C (j p.2 : N) (j q.2 : N) = B p.2 q.2 at this
      simp only
      rw [this]
end Helpers
variable {K V : Type*} [Field K] [AddCommGroup V] [Module K V]
variable [FiniteDimensional K V]
theorem even_finrank_of_nondegenerate_alt (B : LinearMap.BilinForm K V)
    (halt : B.IsAlt) (hB : B.Nondegenerate) : Even (finrank K V) :=
  even_aux (finrank K V) V B halt hB rfl
omit [FiniteDimensional K V] in
theorem pairing_add_orthogonal (B : LinearMap.BilinForm K V) (hrefl : B.IsRefl)
    (P : Submodule K V) (x y : P × B.orthogonal P) :
    B ((x.1 : V) + x.2) ((y.1 : V) + y.2) =
      B (x.1 : V) (y.1 : V) + B (x.2 : V) (y.2 : V) := by
  have h12 : B (x.1 : V) (y.2 : V) = 0 :=
    (LinearMap.BilinForm.mem_orthogonal_iff.mp y.2.2) _ x.1.2
  have h21 : B (x.2 : V) (y.1 : V) = 0 :=
    hrefl _ _ ((LinearMap.BilinForm.mem_orthogonal_iff.mp x.2.2) _ y.1.2)
  simp only [map_add, LinearMap.add_apply, h12, h21, add_zero, zero_add]
variable {W : Type*} [AddCommGroup W] [Module K W]
theorem alternating_isometry_of_finrank_eq [FiniteDimensional K W]
    (B : LinearMap.BilinForm K V) (C : LinearMap.BilinForm K W)
    (hB : B.IsAlt) (hC : C.IsAlt) (hBn : B.Nondegenerate) (hCn : C.Nondegenerate)
    (hdim : finrank K V = finrank K W) :
    ∃ i : V ≃ₗ[K] W, ∀ x y, C (i x) (i y) = B x y :=
  iso_aux (finrank K V) V W B C hB hC hBn hCn rfl hdim.symm
