  have heB : F.e+1<B := by
    have hh:=h.slots.fit
    have hm:=h.slots.base.memory_word
    rw [h.workspace] at hh
    omega
  let ξ:=σ.setVar gauss.WS (F.e+1)
  let ζ:=ξ.setVar gauss.N n
