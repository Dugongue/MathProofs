    (B : LinearMap.BilinForm K V) (hB : B.IsSymm) (hnB : B.Nondegenerate)
    (S : Module.End K V) (hf : S.charpoly=∏ i,g i)
    (hS : ∀ x y,B (S x) y=B x (S y)) (e : Frames g S) :
    ∃ c : ∀ i,AdjoinRoot (g i),(∀ i,c i≠0) ∧
      ∀ x y,B (e.val x) (e.val y)=modelTraceForm g c x y := by
  letI : DecidableEq ι := Classical.decEq _
  have hsq : Squarefree S.charpoly := by
    rw [hf]
    apply Finset.squarefree_prod_of_pairwise_isCoprime
    · intro i hi j hj hij
      exact (hcop hij).isRelPrime
    · intro i _
      exact (Fact.out : Irreducible (g i)).squarefree
