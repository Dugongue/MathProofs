      apply he.trans
      have h1 : (q^(c-1))⁻¹≤(q^(c/4))⁻¹ :=
        (inv_le_inv₀ (pow_pos hq0 _) (pow_pos hq0 _)).mpr (pow_le_pow_right₀ hq1 (by omega))
      have h2 : (q^c)⁻¹≤(q^(c/4))⁻¹ :=
        (inv_le_inv₀ (pow_pos hq0 _) (pow_pos hq0 _)).mpr (pow_le_pow_right₀ hq1 (Nat.div_le_self _ _))
      have hexp : Real.exp 2≤9 := by
        rw [show (2:ℝ)=1+1 by norm_num,Real.exp_add]
        nlinarith [Real.exp_one_lt_three,Real.exp_pos 1]
      have hmexp := mul_le_mul_of_nonneg_right hexp (show 0≤(q^c)⁻¹ by positivity)
      change 2*(q^(c-1))⁻¹+20*Nat.card ι/q^D+4*Real.exp 2*(q^c)⁻¹≤_
      simp only [div_eq_mul_inv]
      nlinarith [show 0≤(q^(c/4))⁻¹ by positivity]
  have hcount : Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) B //
      p∣S.val.charpoly ∧ IsCoprime p (S.val.charpoly/p)}=
      Nat.card {S : SelfAdjointOperators (RingEquiv.refl K) B //∀ i,PrimaryEvent (g i) S.val} := by
    apply Nat.card_congr
    exact Equiv.subtypeEquivRight (fun S=>Mathproof.Problem18SimpleProductEvent20261001.simple_product_iff
      g (fun i=>(hi i).ne_zero) hcop S.val.charpoly)
  have hweight : (∏ i,(Nat.card K:ℝ)^(g i).natDegree)=q^d := by
    rw [Finset.prod_pow_eq_pow_sum,←hdeg]
  rw [hcount] at herr
  rw [hweight]
  exact herr.trans (Mathproof.Problem18OrdinarySpectralJointError20261001.ordinary_error_small q (b:ℝ)
