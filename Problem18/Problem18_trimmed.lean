  let one:Fin F.e:=⟨1,by omega⟩
  rw [Finset.sum_eq_single one]
  · simp [generatorCoefficients_eq,one]
  · intro i hi hne
    have hh:i.val≠1:=by intro hh; exact hne (Fin.ext hh)
    simp [generatorCoefficients_eq,hh]
  · simp
