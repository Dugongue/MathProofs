variable {K : Type} [Field K] [Fintype K] [DecidableEq K] (F : FieldPresentation K)
theorem DegInv.setVar {B n q : Nat} {SA D : Matrix (Fin n) (Fin n) K} {σ0 σ : Env}
    (h : DegInv F B n q SA D σ0 σ) (x : String) (v : Nat)
    (hx : x∈[oddFlag,expR,degR]) : DegInv F B n q SA D σ0 (σ.setVar x v) := by
  have hr : x∉regNames canonical := by
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hx
    rcases hx with rfl|rfl|rfl <;> decide
  have hw : x≠wsR := by
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hx
    rcases hx with rfl|rfl|rfl <;> decide
  have hk : ∀y∈[wsR,canonical.modBase,colsR,"q"],y≠x := by
    intro y hy
    simp only [List.mem_cons,List.not_mem_nil,or_false] at hx hy
    rcases hx with rfl|rfl|rfl <;> rcases hy with rfl|rfl|rfl|rfl <;> decide
  refine ⟨Slots.setVar F canonical h.slots hr hw v,?_,?_,h.len,?_,?_,?_,?_,?_,?_,h.arrs,h.inp,h.out⟩
  · rw [vars_setVar,if_neg (hk _ (by simp))];exact h.ws
  · rw [vars_setVar,if_neg (hk _ (by simp))];exact h.mod
  · rw [vars_setVar,if_neg (hk _ (by simp))];exact h.cols
  · rw [val_setVar F canonical hw];exact h.z
  · rw [smat_setVar F hw];exact h.sa
  · rw [smat_setVar F hw];exact h.d
  · rw [smat_setVar F hw];exact h.i
  · rw [vars_setVar,if_neg (hk _ (by simp))];exact h.q
theorem degLoop_run {B n q : Nat} {SA D : Matrix (Fin n) (Fin n) K} {σ0 σ : Env}
    (h : DegInv F B n q SA D σ0 σ) (hn : 0<n) (hw : OddWords B n F.e q) :
    ∃τ t,Run B degLoop σ τ t ∧ t ≤ degLoopCost F n (Nat.size ((q+1)^(n+1))) ∧
      (τ.vars oddFlag=0 ∨ τ.vars oddFlag=1) ∧
      (τ.vars oddFlag=1 ↔ (List.range n).all (fun i=>rankTest SA D q (i+1))=true) ∧
      (∀a,a≠canonical.mem → a≠canonical.scratch → τ.arrs a=σ.arrs a) ∧
      τ.inp=σ.inp ∧ τ.out=σ.out := by
  have hnB : n<B := by
    have := F.degree_pos
    have : n ≤ (n+1)*F.e := by nlinarith
    have := hw.stride;omega
  have hB2 : 1<B := by
    have := F.degree_pos
    have : 1 ≤ (n+1)*F.e := by nlinarith
    have := hw.stride;omega
  let s1:=σ.setVar oddFlag 1
  let s2:=s1.setVar expR 1
  let s3:=s2.setVar degR 0
  have r1 : Run B (.assign oddFlag (.lit 1)) σ s1 2 := Run.assign (evalB_lit hB2)
  have r2 : Run B (.assign expR (.lit 1)) s1 s2 2 := Run.assign (evalB_lit hB2)
  have r3 : Run B (.assign degR (.lit 0)) s2 s3 2 := Run.assign (evalB_lit (by omega))
  have h3 : DegInv F B n q SA D σ0 s3 :=
    ((h.setVar F oddFlag 1 (by decide)).setVar F expR 1 (by decide)).setVar F degR 0 (by decide)
  let I : Env → Prop := fun ρ=>DegInv F B n q SA D σ0 ρ ∧ ρ.vars degR ≤ n ∧
    ρ.vars expR=q^(ρ.vars degR) ∧ (ρ.vars oddFlag=0 ∨ ρ.vars oddFlag=1) ∧
    (ρ.vars oddFlag=1 ↔ (List.range (ρ.vars degR)).all (fun i=>rankTest SA D q (i+1))=true)
  let V : Env → Nat := fun ρ=>n-ρ.vars degR
  have hdef : ∀ρ,I ρ → ∃v,(Cond.lt (.var degR) (.var colsR)).evalB B ρ=some v := by
    intro ρ hρ
    exact evalB_condLt_vars (by have:=hρ.2.1;omega) (by rw [hρ.1.cols];exact hnB)
  have hstep : ∀ρ,I ρ → (Cond.lt (.var degR) (.var colsR)).evalB B ρ=some true →
      ∃τ,Run B degBody ρ τ (degBodyCost F n (Nat.size ((q+1)^(n+1)))) ∧ I τ ∧ V τ<V ρ := by
    intro ρ hρ ht
    obtain ⟨hI,hle,hE,hbit,hiff⟩:=hρ
    have htest:=evalB_condLt (evalB_var (by omega : ρ.vars degR<B))
      (evalB_var (by rw [hI.cols];exact hnB : ρ.vars colsR<B))
    rw [ht,hI.cols] at htest
    have hd : ρ.vars degR<n := by simpa using htest.symm
    obtain ⟨τ,r,hτ,hEτ,hdτ,hfτ,_⟩:=degBody_run F hI hE rfl hd hn hw
    refine ⟨τ,r,⟨hτ,by omega,by rw [hEτ,hdτ],?_,?_⟩,by simp only [V];omega⟩
    · rw [hfτ];split
      · exact hbit
      · exact Or.inl rfl
    · rw [hfτ,hdτ,List.range_succ,List.all_append]
      simp only [List.all_cons,List.all_nil,Bool.and_true]
      split
      · rename_i ht';rw [ht',Bool.and_true];exact hiff
      · rename_i hf';simp [hf']
  have ne1 : expR≠degR := by decide
  have ne2 : oddFlag≠degR := by decide
  have ne3 : oddFlag≠expR := by decide
  have hI3 : I s3 := ⟨h3,by simp [s3],by simp [s3,s2,ne1],by simp [s3,s2,s1,ne2,ne3],
    by simp [s3,s2,s1,ne2,ne3]⟩
  obtain ⟨τ,hr,hτ,hfalse⟩:=Run.while_count I V (degBodyCost F n (Nat.size ((q+1)^(n+1))))
    hdef hstep hI3
  obtain ⟨hI,hle,hE,hbit,hiff⟩:=hτ
  have htest:=evalB_condLt (evalB_var (by omega : τ.vars degR<B))
    (evalB_var (by rw [hI.cols];exact hnB : τ.vars colsR<B))
  rw [hfalse,hI.cols] at htest
  have hdone : τ.vars degR=n := by
    have : ¬τ.vars degR<n := by simpa using htest.symm
    first | omega | nlinarith
  refine ⟨τ,_,r1.seq (r2.seq (r3.seq hr)),?_,hbit,by rwa [hdone] at hiff,?_,?_,?_⟩
  · simp only [V,s3,vars_setVar,if_true,ite_true,Nat.sub_zero,Cond.size,Expr.size,degLoopCost]
    nlinarith
  · intro a h1 h2;rw [hI.arrs a h1 h2,h.arrs a h1 h2]
  · rw [hI.inp,h.inp]
  · rw [hI.out,h.out]
end Mathproof.Problem18PairBoundaryOddRun20261004
end
