  have hps' : ξ.vars tw.pS=ps := by
    rw [(run_frame ha).1 tw.pS (by decide)];exact hps
  have hos' : ξ.vars outputReg=os := by
    rw [(run_frame ha).1 outputReg (by decide)];exact hos
  have hSB:=hs.slots_word
  have hnB : N< B := by omega
  let ξ' := ξ.setVar q.N N
  have hnrun : Run B (.assign q.N (.var sizeReg)) ξ ξ' 2 :=
    Run.assign (by simpa only [hsz] using evalB_var (σ:=ξ) (B:=B) (x:=sizeReg) (hsz.symm ▸ hnB))
  have eps : ξ'.vars tw.pS=ps := by change ξ.vars tw.pS=ps;exact hps'
  have eos : ξ'.vars outputReg=os := by change ξ.vars outputReg=os;exact hos'
  have hs' : Slots F canonical q.WS Sn B ξ' :=
    Slots.setVar F canonical hs (by decide) (by decide) N
  obtain ⟨τ,hr,ht,houtc,houtf,_,_,_,_,_⟩ :=
    rcopy_run (fieldMacros F) q names_valid [tw.pS,outputReg] (by decide)
      (.var tw.pS) (.var outputReg) (by simp [VarsIn]) (by simp [VarsIn]) hs' (dv:=ps) (sv:=os) (Nv:=N)
      (by simpa only [eps] using evalB_var (σ:=ξ') (B:=B) (x:=tw.pS) (by rw [eps];omega))
      (by simpa only [eos] using evalB_var (σ:=ξ') (B:=B) (x:=outputReg) (by rw [eos];omega))
      (by simp [ξ']) (by omega) (by omega) (Or.inl hpf)
  have hf : Run B finish ξ τ (2+rcopyCost (fieldMacros F) (.var tw.pS) (.var outputReg) N) :=
    hnrun.seq hr
  have hall:=ha.seq hf
  refine ⟨τ,?_,ht,?_,?_,(run_frame hall).1,
    (run_frame hall).2.2.2.1 (by repeat' constructor),
    (run_frame hall).2.2.2.2 (by repeat' constructor)⟩
  · simpa only [budget,program,Nat.add_assoc] using hall
  · intro i hi
    have hc:=houtc i hi
    change val F canonical WS τ (ps+i)=val F canonical WS ξ (os+(N-1-i)) at hc
    exact hc.trans (hcoeff ⟨N-1-i,by omega⟩)
  · intro s hsx hbs hso hsp
    have hc:=houtf s hsx hsp
    change val F canonical WS τ s=val F canonical WS ξ s at hc
    exact hc.trans (hframe s hsx hbs hso)
end
end Mathproof.Problem18IMPPolynomialMultiply20261002
