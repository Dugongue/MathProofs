    apply (div_le_iff₀ hΩ).mpr
    have hEraw' := (div_le_iff₀ hA).mp hEraw
    have hmult := mul_le_mul_of_nonneg_right hEraw' hB.le
    rw [hEcard, hΩcard]
    simpa only [Nat.cast_mul, mul_assoc] using hmult
  have hQcard : Nat.card {z : Ω // Q z} =
      Nat.card {M : Matrix (Fin d) (Fin (w + t)) K // M.rank = d} := by
    change Nat.card {z : A × B // (ambientEquiv d w t z).rank = d} = _
    exact Nat.card_congr (Equiv.subtypeEquivOfSubtype
      (p := fun M : Matrix (Fin d) (Fin (w + t)) K => M.rank = d)
      (ambientEquiv d w t))
  have hQmass : (1 / 4 : ℝ) ≤
      (Nat.card {z : Ω // Q z} : ℝ) / Nat.card Ω := by
    rw [hQcard]
    have he : Nat.card Ω = Nat.card (Matrix (Fin d) (Fin (w + t)) K) :=
      Nat.card_congr (ambientEquiv d w t)
    rw [he]
    exact Mathproof.Problem18RankDensity20260929.fullRowRank_density_ge_quarter
      (K := K) hd
  have hb := finite_conditioned_event_bound P Q R hΩ hR hEjoint hQmass
  change _ ≤ 16 * (Fintype.card K : ℝ) ^ (u * (d - u)) *
    ((Fintype.card K : ℝ) ^ (u * w))⁻¹
  dsimp [R] at hb
  nlinarith [hb]
end Mathproof.Problem18ConditionedTail20260929
