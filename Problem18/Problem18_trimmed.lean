def zeroSet (P : K[X][X]) : Finset (K × K) :=
  Finset.univ.filter fun ab => (specialize P ab.1).eval ab.2 = 0
theorem specialize_ne_zero (P : K[X][X]) (hP : P ≠ 0) (a : K)
