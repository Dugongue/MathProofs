+/* For all uint32_t x: first fold <= 3,149,820, second <= 6,402 < 2q.
+ * Each fold preserves x mod q since 4096 = 3 mod 4093. */
+static inline uint32_t reduce4093(uint32_t x) {
+  x=(x&4095u)+3u*(x>>12);
+  x=(x&4095u)+3u*(x>>12);
+  return x-4093u*(x>=4093u);
+}
 
