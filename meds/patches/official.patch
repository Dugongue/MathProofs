+/* Adaptation of our packed dot products to the published uint32_t ABI.
+ * Preserve the protocol and random-tape consumption; pack only within this kernel. */
+static inline uint32_t reduce_field(uint32_t x) {
+#if MEDS_p == 4093
+ x=(x&4095u)+3u*(x>>12);x=(x&4095u)+3u*(x>>12);return x-4093u*(x>=4093u);
+#else
+ return x%MEDS_p;
+#endif
+}
+static void packed_mul(pmod_mat_t *C, int C_r, int C_c, pmod_mat_t *A, int A_r, int A_c, pmod_mat_t *B, int B_r, int B_c, int inner)
+{
+  GFq_t tmp[C_r*C_c];
+  uint32_t bits=0;
+  for(int r=0;r<C_r;++r) for(int k=0;k<inner;++k) bits|=A[r*A_c+k];
+  for(int k=0;k<inner;++k) for(int c=0;c<C_c;++c) bits|=B[k*B_c+c];
+  if(inner<=256 && (bits>>12)==0) {
+    int stride=(inner+15)&~15;
+    uint16_t ap[C_r*stride],bt[C_c*stride];
+    for(int r=0;r<C_r;++r){for(int k=0;k<inner;k++)ap[r*stride+k]=(uint16_t)A[r*A_c+k];memset(ap+r*stride+inner,0,(stride-inner)*sizeof *ap);}
+    for(int c=0;c<C_c;++c){for(int k=0;k<inner;++k)bt[c*stride+k]=B[k*B_c+c];memset(bt+c*stride+inner,0,(stride-inner)*sizeof *bt);}
+    for(int r=0;r<C_r;++r)for(int c=0;c<C_c;++c){
+      __m256i acc=_mm256_setzero_si256();
+      for(int k=0;k<stride;k+=16){
+        __m256i aa=_mm256_loadu_si256((const __m256i*)(ap+r*stride+k));
+        __m256i bb=_mm256_loadu_si256((const __m256i*)(bt+c*stride+k));
+        acc=_mm256_add_epi32(acc,_mm256_madd_epi16(aa,bb));
+      }
+      __m128i sum=_mm_add_epi32(_mm256_castsi256_si128(acc),_mm256_extracti128_si256(acc,1));
+      sum=_mm_add_epi32(sum,_mm_srli_si128(sum,8));
+      sum=_mm_add_epi32(sum,_mm_srli_si128(sum,4));
+      tmp[r*C_c+c]=reduce_field((uint32_t)_mm_cvtsi128_si32(sum));
+    }
+  } else {
+    for(int r=0;r<C_r;++r)for(int c=0;c<C_c;++c){
+      uint64_t acc=0;
+      for(int k=0;k<inner;++k)acc+=(uint64_t)A[r*A_c+k]*B[k*B_c+c];
+      tmp[r*C_c+c]=acc%MEDS_p;
+    }
+  }
+  memcpy(C,tmp,sizeof tmp);
+}
+void pmod_mat_mul(pmod_mat_t*C,int Cr,int Cc,pmod_mat_t*A,int Ar,int Ac,pmod_mat_t*B,int Br,int Bc){packed_mul(C,Cr,Cc,A,Ar,Ac,B,Br,Bc,Ar);}
+void pmod_mat_mul_simd(pmod_mat_t*C,int Cr,int Cc,pmod_mat_t*A,int Ar,int Ac,pmod_mat_t*B,int Br,int Bc){packed_mul(C,Cr,Cc,A,Ar,Ac,B,Br,Bc,Ac);}
+
+int pmod_mat_syst_ct(pmod_mat_t *M, int M_r, int M_c)
+{
+  for (int r = 0; r < M_r; r++)
+  {
+    // swap
+    for (int r2 = r+1; r2 < M_r; r2++)
+    {
+      uint32_t Mrr = pmod_mat_entry(M, M_r, M_c, r, r);
+
+      for (int c = r; c < M_c; c++)
+      {
+        uint32_t val = pmod_mat_entry(M, M_r, M_c, r2, c);
+
+        uint32_t Mrc = pmod_mat_entry(M, M_r, M_c, r, c);
+
+        pmod_mat_set_entry(M, M_r, M_c, r, c, (Mrc + val * (Mrr == 0)) % MEDS_p);
+      }
+    }
+
+    uint32_t val = pmod_mat_entry(M, M_r, M_c, r, r);
+
+    if (val == 0)
+      return -1;
+
+    val = GF_inv(val);
+
+    // normalize
+    for (int c = r; c < M_c; c++)
+    {
+      uint32_t tmp = ((uint32_t)pmod_mat_entry(M, M_r, M_c, r, c) * val) % MEDS_p;
+      pmod_mat_set_entry(M, M_r, M_c, r, c, tmp);
+    }
+
+    // eliminate
+    for (int r2 = r+1; r2 < M_r; r2++)
+    {
+      uint32_t factor = pmod_mat_entry(M, M_r, M_c, r2, r);
+
+      for (int c = r; c < M_c; c++)
+      {
+        uint32_t tmp0 = pmod_mat_entry(M, M_r, M_c, r, c);
+        uint32_t tmp1 = pmod_mat_entry(M, M_r, M_c, r2, c);
+
+        int32_t val = (tmp0 * factor) % MEDS_p;
+
+        val = tmp1 - val;
+
+        val += MEDS_p * (val < 0);
+
+        pmod_mat_set_entry(M, M_r, M_c,  r2, c, val);
+      }
+    }
+  }
+
+  // back substitution
+  for (int r = M_r - 1; r >= 0; r--)
+    for (int r2 = 0; r2 < r; r2++)
+    {
+      uint32_t factor = pmod_mat_entry(M, M_r, M_c, r2, r);
+
+      uint32_t tmp0 = pmod_mat_entry(M, M_r, M_c, r, r);
+      uint32_t tmp1 = pmod_mat_entry(M, M_r, M_c, r2, r);
+
+      int32_t val = (tmp0 * factor) % MEDS_p;
+
+      val = tmp1 - val;
+
+      val += MEDS_p * (val < 0);
+
+      pmod_mat_set_entry(M, M_r, M_c,  r2, r, val);
+
+      for (int c = M_r; c < M_c; c++)
+      {
+        uint32_t tmp0 = pmod_mat_entry(M, M_r, M_c, r, c);
+        uint32_t tmp1 = pmod_mat_entry(M, M_r, M_c, r2, c);
+
+        int val = (tmp0 * factor) % MEDS_p;
+
+        val = tmp1 - val;
+
+        val += MEDS_p * (val < 0);
+
+        pmod_mat_set_entry(M, M_r, M_c,  r2, c, val);
+      }
+    }
+
+  return 0;
+}
+
+GFq_t GF_inv(GFq_t val)
+{
+  if (MEDS_p == 8191)
+  {
+    // Use optimal addition chain...
+    uint64_t tmp_0  = val;
+    uint64_t tmp_1  = (tmp_0 * tmp_0) % MEDS_p;
+    uint64_t tmp_2  = (tmp_1 * tmp_0) % MEDS_p;
+    uint64_t tmp_3  = (tmp_2 * tmp_1) % MEDS_p;
+    uint64_t tmp_4  = (tmp_3 * tmp_3) % MEDS_p;
+    uint64_t tmp_5  = (tmp_4 * tmp_3) % MEDS_p;
+    uint64_t tmp_6  = (tmp_5 * tmp_5) % MEDS_p;
+    uint64_t tmp_7  = (tmp_6 * tmp_6) % MEDS_p;
+    uint64_t tmp_8  = (tmp_7 * tmp_7) % MEDS_p;
+    uint64_t tmp_9  = (tmp_8 * tmp_8) % MEDS_p;
+    uint64_t tmp_10 = (tmp_9 * tmp_5) % MEDS_p;
+    uint64_t tmp_11 = (tmp_10 * tmp_10) % MEDS_p;
+    uint64_t tmp_12 = (tmp_11 * tmp_11) % MEDS_p;
+    uint64_t tmp_13 = (tmp_12 * tmp_2) % MEDS_p;
+    uint64_t tmp_14 = (tmp_13 * tmp_13) % MEDS_p;
+    uint64_t tmp_15 = (tmp_14 * tmp_14) % MEDS_p;
+    uint64_t tmp_16 = (tmp_15 * tmp_15) % MEDS_p;
+    uint64_t tmp_17 = (tmp_16 * tmp_3) % MEDS_p;
+
+    return tmp_17;
+  }
+  else
+  {
+    uint64_t exponent = MEDS_p - 2;
+    uint64_t t = 1;
+
+    while (exponent > 0)
+    {
+      if ((exponent & 1) != 0)
+        t = (t*(uint64_t)val) % MEDS_p;
+
+      val = ((uint64_t)val*(uint64_t)val) % MEDS_p;
+
+      exponent >>= 1;
+    }
+
+    return t;
+  }
+}
+
+int pmod_mat_inv(pmod_mat_t *B, pmod_mat_t *A, int A_r, int A_c)
+{
+  pmod_mat_t M[A_r * A_c*2];
+
+  for (int r = 0; r < A_r; r++)
+  {
+    memcpy(&M[r * A_c*2], &A[r * A_c], A_c * sizeof(GFq_t));
+
+    for (int c = 0; c < A_c; c++)
+      pmod_mat_set_entry(M, A_r, A_c*2, r, A_c + c, r==c ? 1 : 0);
+  }
+
+  int ret = pmod_mat_syst_ct(M, A_r, A_c*2);
+
+  if ((ret == 0) && B)
+    for (int r = 0; r < A_r; r++)
+      memcpy(&B[r * A_c], &M[r * A_c*2 + A_c], A_c * sizeof(GFq_t));
+
+  return ret;
+}
+
